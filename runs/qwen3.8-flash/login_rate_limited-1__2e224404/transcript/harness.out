ow slide\n+# time-based: patch now() to simulate lock expiry and client window slide\n+client.post(\"/api/auth/register\", json={\"username\": \"erin\", \"password\": \"pw-erin\"})\n+IP[0] = \"5.5.5.5\"\n+for i in range(5):\n+    post_login(\"erin\", \"bad\")\n+r = post_login(\"erin\", \"pw-erin\")\n+check(\"erin locked\", r.status_code == 429)\n real_now = appmod.now\n try:\n     appmod.now = lambda: real_now() + 16 * 60\n     r = client.post(\n@@ -156,10 +162,10 @@\n         json={\"username\": \"dave\", \"password\": \"x\"},\n         environ_base={\"REMOTE_ADDR\": \"9.9.9.9\"},\n     )\n     check(\"client window slides\", r.status_code == 401)\n-    r = post_login(\"alice\", \"pw-alice\")\n-    check(\"alice lock expires\", r.status_code == 200)\n+    r = post_login(\"erin\", \"pw-erin\")\n+    check(\"lock expires after 15 min\", r.status_code == 200)\n finally:\n     appmod.now = real_now\n \n # persistence across app restart (same DB file)\n","filediff":{"file":"/workspace/tests/test_app.py","patch":"Index: /workspace/tests/test_app.py\n===================================================================\n--- /workspace/tests/test_app.py\n+++ /workspace/tests/test_app.py\n@@ -146,9 +146,15 @@\n     environ_base={\"REMOTE_ADDR\": \"8.8.8.8\"},\n )\n check(\"other ip ok\", r.status_code == 401)\n \n-# time-based: patch now() to simulate expiry and window slide\n+# time-based: patch now() to simulate lock expiry and client window slide\n+client.post(\"/api/auth/register\", json={\"username\": \"erin\", \"password\": \"pw-erin\"})\n+IP[0] = \"5.5.5.5\"\n+for i in range(5):\n+    post_login(\"erin\", \"bad\")\n+r = post_login(\"erin\", \"pw-erin\")\n+check(\"erin locked\", r.status_code == 429)\n real_now = appmod.now\n try:\n     appmod.now = lambda: real_now() + 16 * 60\n     r = client.post(\n@@ -156,10 +162,10 @@\n         json={\"username\": \"dave\", \"password\": \"x\"},\n         environ_base={\"REMOTE_ADDR\": \"9.9.9.9\"},\n     )\n     check(\"client window slides\", r.status_code == 401)\n-    r = post_login(\"alice\", \"pw-alice\")\n-    check(\"alice lock expires\", r.status_code == 200)\n+    r = post_login(\"erin\", \"pw-erin\")\n+    check(\"lock expires after 15 min\", r.status_code == 200)\n finally:\n     appmod.now = real_now\n \n # persistence across app restart (same DB file)\n","additions":9,"deletions":3},"truncated":false},"title":"tests/test_app.py","time":{"start":1794340779180,"end":1794340779193}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c70b74a5001QtD419Epl09IbL","sessionID":"ses_e39001495ffeqL6SSEgdzERz2g","messageID":"msg_1c70b3e16001xtZILiKyuGXtJb"}}
