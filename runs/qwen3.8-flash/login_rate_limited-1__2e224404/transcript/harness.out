/login-attempts\")\n48: check(\"attempts 401\", r.status_code == 401)\n49: \n50: # login wrong password\n51: for i in range(4):\n52:     r = post_login(\"alice\", \"wrong\")\n53:     check(f\"fail {i+1} -> 401\", r.status_code == 401)\n54: \n55: # 5th failure locks\n56: r = post_login(\"alice\", \"wrong\")\n57: check(\"fail 5 -> 401 (lock begins)\", r.status_code == 401)\n58: \n59: # now locked even with right password\n60: r = post_login(\"alice\", \"pw-alice\")\n61: check(\"locked -> 429\", r.status_code == 429)\n62: ra = r.headers.get(\"Retry-After\")\n63: check(\"Retry-After present\", ra is not None and 1 <= int(ra) <= 900)\n64: check(\"locked json\", r.get_json().get(\"error\") == \"account_locked\")\n65: \n66: # attempts list requires auth; login as another user first\n67: client.post(\"/api/auth/register\", json={\"username\": \"bob\", \"password\": \"pw-bob\"})\n68: r = post_login(\"bob\", \"pw-bob\")\n69: check(\"bob login 200\", r.status_code == 200 and \"token\" in r.get_json())\n70: bob_token = r.get_json()[\"token\"]\n71: hdr = {\"Authorization\": f\"Bearer {bob_token}\"}\n72: r = client.get(\"/api/me\", headers=hdr)\n73: check(\"me ok\", r.status_code == 200 and r.get_json()[\"username\"] == \"bob\" and r.get_json()[\"last_login_at\"])\n74: r = client.get(\"/api/me/login-attempts\", headers=hdr)\n75: check(\"bob attempts has own login\", r.status_code == 200 and len(r.get_json()[\"items\"]) == 1)\n76: \n77: # success resets count: bob fails once, then succeeds\n78: post_login(\"bob\", \"nope\")\n79: r = post_login(\"bob\", \"pw-bob\")\n80: check(\"bob re-login ok\", r.status_code == 200)\n81: # after reset, need 5 fresh fails before lock\n82: for i in range(4):\n83:     post_login(\"bob\", \"nope\")\n84: r = post_login(\"bob\", \"pw-bob\")\n85: check(\"bob not locked after reset+4 fails\", r.status_code == 200)\n86: r = client.get(\"/api/me/login-attempts\", headers=hdr)\n87: items = r.get_json()[\"items\"]\n88: check(\"attempts list\", len(items) == 8 and all(\"at\" in it and isinstance(it[\"success\"], bool) for it in items))\n89: check(\"newest first\", items[0][\"success\"] is True and items[1][\"success\"] is False)\n90: check(\"cap 20\", len(items) <= 20)\n91: \n92: # admin\n93: r = post_login(\"admin\", \"s3cret\")\n94: check(\"admin login\", r.status_code == 200)\n95: admin_hdr = {\"Authorization\": f\"Bearer {r.get_json()['token']}\"}\n96: r = client.get(\"/api/admin/locks\")\n97: check(\"locks 401 anon\", r.status_code == 401)\n98: r = client.get(\"/api/admin/locks\", headers=hdr)\n99: check(\"locks 403 bob\", r.status_code == 403)\n100: r = client.get(\"/api/admin/locks\", headers=admin_hdr)\n101: locks = r.get_json()[\"items\"]\n102: check(\"alice in locks\", any(l[\"username\"] == \"alice\" and l[\"locked_until\"] for l in locks))\n103: r = client.post(\"/api/admin/locks/alice/unlock\", headers=admin_hdr)\n104: check(\"unlock 200\", r.status_code == 200)\n105: r = client.get(\"/api/admin/locks\", headers=admin_hdr)\n106: check(\"alice gone from locks\", all(l[\"username\"] != \"alice\" for l in r.get_json()[\"items\"]))\n107: r = post_login(\"alice\", \"pw-alice\")\n108: check(\"alice can sign in after unlock\", r.status_code == 200)\n109: \n110: # failed count reset by admin unlock\n111: client.post(\"/api/auth/register\", json={\"username\": \"carol\", \"password\": \"pw-carol\"})\n112: for i in range(4):\n113:     post_login(\"carol\", \"x\")\n114: client.post(\"/api/admin/locks/carol/unlock\", headers=admin_hdr)\n115: r = post_login(\"carol\", \"x\")\n116: check(\"carol not locked after unlock+1 fail\", r.status_code == 401)\n117: r = post_login(\"carol\", \"pw-carol\")\n118: check(\"carol login fine\", r.status_code == 200)\n119: \n120: # unknown username lock unlock 404\n121: r = client.post(\"/api/admin/locks/no-such-user/unlock\", headers=admin_hdr)\n122: check(\"unlock unknown 404\", r.status_code == 404)\n123: \n124: # client rate limit: 20 attempts per minute then 429\n125: limited = None\n126: for i in range(30):\n127:     r = client.post(\n128:         \"/api/auth/login\",\n129:         json={\"username\": \"dave\", \"password\": \"x\"},\n130:         environ_base={\"REMOTE_ADDR\": \"9.9.9.9\"},\n131:     )\n132:     if r.status_code == 429:\n133:         limited = i + 1\n134:         ra = r.headers.get(\"Retry-After\")\n135:         check(\"rate 429 Retry-After\", ra is not None and 1 <= int(ra) <= 60)\n136:         check(\"rate error json\", r.get_json().get(\"error\") == \"too_many_requests\")\n137:         break\n138: check(\"limited after 20\", limited == 21)\n139: r = client.post(\n140:     \"/api/auth/login\",\n141:     json={\"username\": \"dave\", \"password\": \"x\"},\n142:     environ_base={\"REMOTE_ADDR\": \"8.8.8.8\"},\n143: )\n144: check(\"other ip ok\", r.status_code == 401)\n145: \n146: # time-based: patch now() to simulate expiry and window slide\n147: real_now = appmod.now\n148: try:\n149:     appmod.now = lambda: real_now() + 16 * 60\n150:     r = client.post(\n151:         \"/api/auth/login\",\n152:         json={\"username\": \"dave\", \"password\": \"x\"},\n153:         environ_base={\"REMOTE_ADDR\": \"9.9.9.9\"},\n154:     )\n155:     check(\"client window slides\", r.status_code == 401)\n156:     r = post_login(\"alice\", \"pw-alice\")\n157:     check(\"alice lock expires\", r.status_code == 200)\n158: finally:\n159:     appmod.now = real_now\n160: \n161: # persistence across app restart (same DB file)\n162: import sqlite3\n163: conn = sqlite3.connect(os.path.join(workdir, \"data\", \"app.db\"))\n164: n = conn.execute(\"SELECT COUNT(*) FROM users\").fetchone()[0]\n165: conn.close()\n166: check(\"data under ./data persists\", n >= 4)\n167: \n168: # frontend serving\n169: os.makedirs(\"/workspace/frontend/dist\", exist_ok=True)\n170: r = client.get(\"/\")\n171: check(\"index served\", r.status_code == 200 and b'<div id=\"root\">' in r.data)\n172: r = client.get(\"/some/spa/route\")\n173: check(\"spa fallback\", r.status_code == 200)\n174: r = client.get(\"/api/nope\")\n175: check(\"unknown api 404\", r.status_code == 404)\n176: \n177: print(\"ALL PASS\")\n178: shutil.rmtree(workdir, ignore_errors=True)\n\n(End of file - total 178 lines)\n</content>","metadata":{"preview":"import os\nimport shutil\nimport sys\nimport tempfile\n\nworkdir = tempfile.mkdtemp()\nos.chdir(workdir)\nsys.path.insert(0, \"/workspace/backend\")\nos.environ[\"ADMIN_PASSWORD\"] = \"s3cret\"\n\nimport app as appmod  # noqa\n\nclient = appmod.app.test_client()\n\nIP = [\"127.0.0.1\"]\n\ndef post_login(username, password):\n    \"\"\"Login using a fresh client IP per scenario group (IP[0]).\"\"\"\n    return client.post(\n        \"/api/auth/login\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/test_app.py","text":"import os\nimport shutil\nimport sys\nimport tempfile\n\nworkdir = tempfile.mkdtemp()\nos.chdir(workdir)\nsys.path.insert(0, \"/workspace/backend\")\nos.environ[\"ADMIN_PASSWORD\"] = \"s3cret\"\n\nimport app as appmod  # noqa\n\nclient = appmod.app.test_client()\n\nIP = [\"127.0.0.1\"]\n\ndef post_login(username, password):\n    \"\"\"Login using a fresh client IP per scenario group (IP[0]).\"\"\"\n    return client.post(\n        \"/api/auth/login\",\n        json={\"username\": username, \"password\": password},\n        headers={\"X-Forwarded-For\": IP[0]},\n    )\n\ndef check(name, cond):\n    if not cond:\n        raise AssertionError(f\"FAIL: {name}\")\n    print(f\"ok  {name}\")\n\n# health\nr = client.get(\"/api/health\")\ncheck(\"health\", r.status_code == 200 and r.get_json() == {\"status\": \"ok\"})\n\n# register\nr = client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"pw-alice\"})\ncheck(\"register 201\", r.status_code == 201)\nbody = r.get_json()\ncheck(\"register body\", body.get(\"username\") == \"alice\" and \"id\" in body)\nr = client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"})\ncheck(\"dup register 409\", r.status_code == 409)\nr = client.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"x\"})\ncheck(\"bad register 400\", r.status_code == 400)\n\n# me without token\nr = client.get(\"/api/me\")\ncheck(\"me 401\", r.status_code == 401)\nr = client.get(\"/api/me/login-attempts\")\ncheck(\"attempts 401\", r.status_code == 401)\n\n# login wrong password\nfor i in range(4):\n    r = post_login(\"alice\", \"wrong\")\n    check(f\"fail {i+1} -> 401\", r.status_code == 401)\n\n# 5th failure locks\nr = post_login(\"alice\", \"wrong\")\ncheck(\"fail 5 -> 401 (lock begins)\", r.status_code == 401)\n\n# now locked even with right password\nr = post_login(\"alice\", \"pw-alice\")\ncheck(\"locked -> 429\", r.status_code == 429)\nra = r.headers.get(\"Retry-After\")\ncheck(\"Retry-After present\", ra is not None and 1 <= int(ra) <= 900)\ncheck(\"locked json\", r.get_json().get(\"error\") == \"account_locked\")\n\n# attempts list requires auth; login as another user first\nclient.post(\"/api/auth/register\", json={\"username\": \"bob\", \"password\": \"pw-bob\"})\nr = post_login(\"bob\", \"pw-bob\")\ncheck(\"bob login 200\", r.status_code == 200 and \"token\" in r.get_json())\nbob_token = r.get_json()[\"token\"]\nhdr = {\"Authorization\": f\"Bearer {bob_token}\"}\nr = client.get(\"/api/me\", headers=hdr)\ncheck(\"me ok\", r.status_code == 200 and r.get_json()[\"username\"] == \"bob\" and r.get_json()[\"last_login_at\"])\nr = client.get(\"/api/me/login-attempts\", headers=hdr)\ncheck(\"bob attempts has own login\", r.status_code == 200 and len(r.get_json()[\"items\"]) == 1)\n\n# success resets count: bob fails once, then succeeds\npost_login(\"bob\", \"nope\")\nr = post_login(\"bob\", \"pw-bob\")\ncheck(\"bob re-login ok\", r.status_code == 200)\n# after reset, need 5 fresh fails before lock\nfor i in range(4):\n    post_login(\"bob\", \"nope\")\nr = post_login(\"bob\", \"pw-bob\")\ncheck(\"bob not locked after reset+4 fails\", r.status_code == 200)\nr = client.get(\"/api/me/login-attempts\", headers=hdr)\nitems = r.get_json()[\"items\"]\ncheck(\"attempts list\", len(items) == 8 and all(\"at\" in it and isinstance(it[\"success\"], bool) for it in items))\ncheck(\"newest first\", items[0][\"success\"] is True and items[1][\"success\"] is False)\ncheck(\"cap 20\", len(items) <= 20)\n\n# admin\nr = post_login(\"admin\", \"s3cret\")\ncheck(\"admin login\", r.status_code == 200)\nadmin_hdr = {\"Authorization\": f\"Bearer {r.get_json()['token']}\"}\nr = client.get(\"/api/admin/locks\")\ncheck(\"locks 401 anon\", r.status_code == 401)\nr = client.get(\"/api/admin/locks\", headers=hdr)\ncheck(\"locks 403 bob\", r.status_code == 403)\nr = client.get(\"/api/admin/locks\", headers=admin_hdr)\nlocks = r.get_json()[\"items\"]\ncheck(\"alice in locks\", any(l[\"username\"] == \"alice\" and l[\"locked_until\"] for l in locks))\nr = client.post(\"/api/admin/locks/alice/unlock\", headers=admin_hdr)\ncheck(\"unlock 200\", r.status_code == 200)\nr = client.get(\"/api/admin/locks\", headers=admin_hdr)\ncheck(\"alice gone from locks\", all(l[\"username\"] != \"alice\" for l in r.get_json()[\"items\"]))\nr = post_login(\"alice\", \"pw-alice\")\ncheck(\"alice can sign in after unlock\", r.status_code == 200)\n\n# failed count reset by admin unlock\nclient.post(\"/api/auth/register\", json={\"username\": \"carol\", \"password\": \"pw-carol\"})\nfor i in range(4):\n    post_login(\"carol\", \"x\")\nclient.post(\"/api/admin/locks/carol/unlock\", headers=admin_hdr)\nr = post_login(\"carol\", \"x\")\ncheck(\"carol not locked after unlock+1 fail\", r.status_code == 401)\nr = post_login(\"carol\", \"pw-carol\")\ncheck(\"carol login fine\", r.status_code == 200)\n\n# unknown username lock unlock 404\nr = client.post(\"/api/admin/locks/no-such-user/unlock\", headers=admin_hdr)\ncheck(\"unlock unknown 404\", r.status_code == 404)\n\n# client rate limit: 20 attempts per minute then 429\nlimited = None\nfor i in range(30):\n    r = client.post(\n        \"/api/auth/login\",\n        json={\"username\": \"dave\", \"password\": \"x\"},\n        environ_base={\"REMOTE_ADDR\": \"9.9.9.9\"},\n    )\n    if r.status_code == 429:\n        limited = i + 1\n        ra = r.headers.get(\"Retry-After\")\n        check(\"rate 429 Retry-After\", ra is not None and 1 <= int(ra) <= 60)\n        check(\"rate error json\", r.get_json().get(\"error\") == \"too_many_requests\")\n        break\ncheck(\"limited after 20\", limited == 21)\nr = client.post(\n    \"/api/auth/login\",\n    json={\"username\": \"dave\", \"password\": \"x\"},\n    environ_base={\"REMOTE_ADDR\": \"8.8.8.8\"},\n)\ncheck(\"other ip ok\", r.status_code == 401)\n\n# time-based: patch now() to simulate expiry and window slide\nreal_now = appmod.now\ntry:\n    appmod.now = lambda: real_now() + 16 * 60\n    r = client.post(\n        \"/api/auth/login\",\n        json={\"username\": \"dave\", \"password\": \"x\"},\n        environ_base={\"REMOTE_ADDR\": \"9.9.9.9\"},\n    )\n    check(\"client window slides\", r.status_code == 401)\n    r = post_login(\"alice\", \"pw-alice\")\n    check(\"alice lock expires\", r.status_code == 200)\nfinally:\n    appmod.now = real_now\n\n# persistence across app restart (same DB file)\nimport sqlite3\nconn = sqlite3.connect(os.path.join(workdir, \"data\", \"app.db\"))\nn = conn.execute(\"SELECT COUNT(*) FROM users\").fetchone()[0]\nconn.close()\ncheck(\"data under ./data persists\", n >= 4)\n\n# frontend serving\nos.makedirs(\"/workspace/frontend/dist\", exist_ok=True)\nr = client.get(\"/\")\ncheck(\"index served\", r.status_code == 200 and b'<div id=\"root\">' in r.data)\nr = client.get(\"/some/spa/route\")\ncheck(\"spa fallback\", r.status_code == 200)\nr = client.get(\"/api/nope\")\ncheck(\"unknown api 404\", r.status_code == 404)\n\nprint(\"ALL PASS\")\nshutil.rmtree(workdir, ignore_errors=True)","lineStart":1,"lineEnd":178,"totalLines":178,"truncated":false}},"title":"tests/test_app.py","time":{"start":1794340749277,"end":1794340749285}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c70affd8001y3u5JxGZ6k7QSH","sessionID":"ses_e39001495ffeqL6SSEgdzERz2g","messageID":"msg_1c70af2cf001HPdNVYhYnZiC5m"}}
