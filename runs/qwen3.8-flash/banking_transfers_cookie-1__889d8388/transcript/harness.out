eated_at)\"\n+        \" VALUES (?, ?, ?, ?, ?)\",\n+        (sender, recipient[\"username\"], cents, memo, created_at),\n+    )\n+    row = db.execute(\n+        \"SELECT * FROM transfers WHERE id = ?\", (cursor.lastrowid,)\n+    ).fetchone()\n+    db.commit()\n except sqlite3.Error:\n-    return error(\"could not process transfer\", 500)\n+    db.rollback()\n+    raise\n \n return jsonify(serialize_transfer(row, sender)), 201\n \n \n","filediff":{"file":"/workspace/backend/app.py","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -297,40 +297,43 @@\n if recipient is None:\n     return error(\"recipient does not exist\", 404)\n \n created_at = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n+# One transaction: both balances change, or nothing at all.\n+db.execute(\"BEGIN IMMEDIATE\")\n try:\n-    with db:\n-        sender_row = db.execute(\n-            \"SELECT balance_cents FROM users WHERE username = ?\", (sender,)\n-        ).fetchone()\n-        if sender_row[\"balance_cents\"] < cents:\n-            return error(\n-                f\"insufficient balance: you have {cents_to_amount(sender_row['balance_cents']):.2f}\"\n-                f\" but tried to send {cents_to_amount(cents):.2f}\",\n-                400,\n-            )\n-        updated = db.execute(\n-            \"UPDATE users SET balance_cents = balance_cents - ?\"\n-            \" WHERE username = ? AND balance_cents >= ?\",\n-            (cents, sender, cents),\n+    sender_row = db.execute(\n+        \"SELECT balance_cents FROM users WHERE username = ?\", (sender,)\n+    ).fetchone()\n+    if sender_row is None:\n+        db.rollback()\n+        return error(\"account not found\", 401)\n+    if sender_row[\"balance_cents\"] < cents:\n+        db.rollback()\n+        return error(\n+            \"insufficient balance\",\n+            400,\n         )\n-        if updated.rowcount != 1:\n-            return error(\"insufficient balance\", 400)\n-        db.execute(\n-            \"UPDATE users SET balance_cents = balance_cents + ? WHERE username = ?\",\n-            (cents, recipient[\"username\"]),\n-        )\n-        cursor = db.execute(\n-            \"INSERT INTO transfers (from_username, to_username, amount_cents, memo, created_at)\"\n-            \" VALUES (?, ?, ?, ?, ?)\",\n-            (sender, recipient[\"username\"], cents, memo, created_at),\n-        )\n-        row = db.execute(\n-            \"SELECT * FROM transfers WHERE id = ?\", (cursor.lastrowid,)\n-        ).fetchone()\n+    db.execute(\n+        \"UPDATE users SET balance_cents = balance_cents - ? WHERE username = ?\",\n+        (cents, sender),\n+    )\n+    db.execute(\n+        \"UPDATE users SET balance_cents = balance_cents + ? WHERE username = ?\",\n+        (cents, recipient[\"username\"]),\n+    )\n+    cursor = db.execute(\n+        \"INSERT INTO transfers (from_username, to_username, amount_cents, memo, created_at)\"\n+        \" VALUES (?, ?, ?, ?, ?)\",\n+        (sender, recipient[\"username\"], cents, memo, created_at),\n+    )\n+    row = db.execute(\n+        \"SELECT * FROM transfers WHERE id = ?\", (cursor.lastrowid,)\n+    ).fetchone()\n+    db.commit()\n except sqlite3.Error:\n-    return error(\"could not process transfer\", 500)\n+    db.rollback()\n+    raise\n \n return jsonify(serialize_transfer(row, sender)), 201\n \n \n","additions":32,"deletions":29},"truncated":false},"title":"backend/app.py","time":{"start":1794345460418,"end":1794345460437}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c752e2ba001KgBz4xxn63gBUH","sessionID":"ses_e38b1e340ffezks56hWicaF6fq","messageID":"msg_1c7525619001xykQkkPY2qjvss"}}
