{"type":"tool_use","timestamp":1794357815675,"sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","part":{"type":"tool","tool":"write","callID":"call_f7ebef2573904583a9dd4b5e","state":{"status":"completed","input":{"content":"import type { Status } from \"./api\";\n\nexport interface DropTarget {\n  status: Status;\n  position: number;\n}\n\nexport interface DragState {\n  taskId: number;\n  source: DropTarget;\n  target: DropTarget | null;\n}\n\ntype Listener = (state: DragState | null) => void;\n\nlet current: DragState | null = null;\nlet commit: ((target: DropTarget) => void) | null = null;\nconst listeners = new Set<Listener>();\n\nfunction emit(): void {\n  for (const listener of listeners) listener(current);\n}\n\nexport function subscribeDrag(listener: Listener): () => void {\n  listeners.add(listener);\n  return () => {\n    listeners.delete(listener);\n  };\n}\n\nexport function getDragState(): DragState | null {\n  return current;\n}\n\nfunction computeTarget(x: number, y: number): DropTarget | null {\n  for (const element of document.elementsFromPoint(x, y)) {\n    const column = (element as HTMLElement).closest?.(\"[data-column]\") as HTMLElement | null;\n    if (!column) continue;\n    const status = column.dataset.column as Status;\n    const slots = Array.from(column.querySelectorAll<HTMLElement>(\"[data-slot]\"));\n    for (const slot of slots) {\n      const rect = slot.getBoundingClientRect();\n      if (y < rect.top + rect.height / 2) {\n        return { status, position: Number(slot.dataset.slot) };\n      }\n    }\n    return null;\n  }\n  return null;\n}\n\nfunction handlePointerMove(event: PointerEvent): void {\n  if (!current) return;\n  const target = computeTarget(event.clientX, event.clientY);\n  const same =\n    (target === null && current.target === null) ||\n    (target !== null &&\n      current.target !== null &&\n      target.status === current.target.status &&\n      target.position === current.target.position);\n  if (!same) {\n    current = { ...current, target };\n    emit();\n  }\n}\n\nfunction finish(): void {\n  window.removeEventListener(\"pointermove\", handlePointerMove);\n  window.removeEventListener(\"pointerup\", handlePointerUp);\n  window.removeEventListener(\"pointercancel\", cancel);\n  current = null;\n  commit = null;\n  emit();\n}\n\nfunction handlePointerUp(): void {\n  const state = current;\n  const save = commit;\n  if (state && state.target && save) save(state.target);\n  finish();\n}\n\nfunction cancel(): void {\n  finish();\n}\n\nexport function startDrag(\n  taskId: number,\n  source: DropTarget,\n  onCommit: (target: DropTarget) => void\n): void {\n  current = { taskId, source, target: null };\n  commit = onCommit;\n  emit();\n  window.addEventListener(\"pointermove\", handlePointerMove);\n  window.addEventListener(\"pointerup\", handlePointerUp);\n  window.addEventListener(\"pointercancel\", cancel);\n}\n","filePath":"/workspace/frontend/src/dnd.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/dnd.ts","exists":false,"truncated":false},"title":"frontend/src/dnd.ts","time":{"start":1794357815640,"end":1794357815650}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c80f6951001x4eJPzG3tircNr","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","messageID":"msg_1c80edaac0014W7cLM0ZB7XFx1"}}
