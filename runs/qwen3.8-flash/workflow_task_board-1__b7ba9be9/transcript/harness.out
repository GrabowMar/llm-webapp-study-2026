{"type":"tool_use","timestamp":1794356767454,"sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","part":{"type":"tool","tool":"write","callID":"call_b7b19649e22e4557a7801e40","state":{"status":"completed","input":{"content":"\"\"\"Shared error types and Flask error handlers.\"\"\"\n\nfrom flask import Flask, jsonify\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str, errors: dict[str, str] | None = None):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n        self.errors = errors or {}\n\n\ndef register_error_handlers(app: Flask) -> None:\n    @app.errorhandler(ApiError)\n    def handle_api_error(exc: ApiError):\n        body = {\"error\": exc.message}\n        if exc.errors:\n            body[\"errors\"] = exc.errors\n        return jsonify(body), exc.status\n\n    @app.errorhandler(404)\n    def handle_not_found(_exc):\n        return jsonify({\"error\": \"Not found\"}), 404\n\n    @app.errorhandler(405)\n    def handle_method_not_allowed(_exc):\n        return jsonify({\"error\": \"Method not allowed\"}), 405\n","filePath":"/workspace/backend/errors.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/errors.py","exists":false,"truncated":false},"title":"backend/errors.py","time":{"start":1794356767361,"end":1794356767376}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ff6a76001aoEUo9oa2YZ35R","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","messageID":"msg_1c7ff57eb001LYU2aFen2TsDoS"}}
