{"type":"tool_use","timestamp":1794356841611,"sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","part":{"type":"tool","tool":"write","callID":"call_c48f7cbbe9f7400ea3a2274f","state":{"status":"completed","input":{"content":"\"\"\"Task CRUD API.\"\"\"\n\nfrom datetime import datetime, timezone\n\nfrom flask import Blueprint, jsonify, request\n\nfrom auth import current_user_id\nfrom db import connect\nfrom errors import ApiError\n\ntasks_bp = Blueprint(\"tasks\", __name__, url_prefix=\"/api/tasks\")\n\nSTATUSES = [\"todo\", \"in_progress\", \"done\"]\nPRIORITIES = [\"low\", \"medium\", \"high\"]\nMAX_TITLE = 200\nMAX_DESCRIPTION = 5000\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef serialize(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"status\": row[\"status\"],\n        \"priority\": row[\"priority\"],\n        \"position\": row[\"position\"],\n        \"updated_at\": row[\"updated_at\"],\n    }\n\n\ndef _json_body(patch: bool = False) -> dict:\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    if patch and not body:\n        raise ApiError(400, \"No fields to update\")\n    return body\n\n\ndef _validate_title(value, required: bool) -> str | None:\n    if value is None:\n        if required:\n            raise ApiError(400, \"Validation failed\", {\"title\": \"Title is required\"})\n        return None\n    if not isinstance(value, str) or not value.strip():\n        raise ApiError(400, \"Validation failed\", {\"title\": \"Title is required\"})\n    if len(value.strip()) > MAX_TITLE:\n        raise ApiError(\n            400, \"Validation failed\", {\"title\": f\"Title must be at most {MAX_TITLE} characters\"}\n        )\n    return value.strip()\n\n\ndef _validate_description(value) -> str | None:\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        raise ApiError(400, \"Validation failed\", {\"description\": \"Description must be text\"})\n    if len(value) > MAX_DESCRIPTION:\n        raise ApiError(\n            400,\n            \"Validation failed\",\n            {\"description\": f\"Description must be at most {MAX_DESCRIPTION} characters\"},\n        )\n    return value\n\n\ndef _validate_status(value, required: bool) -> str | None:\n    if value is None:\n        if required:\n            raise ApiError(400, \"Validation failed\", {\"status\": \"Status must be one of: todo, in_progress, done\"})\n        return None\n    if not isinstance(value, str) or value not in STATUSES:\n        raise ApiError(\n            400, \"Validation failed\", {\"status\": \"Status must be one of: todo, in_progress, done\"}\n        )\n    return value\n\n\ndef _validate_priority(value, required: bool) -> str | None:\n    if value is None:\n        if required:\n            raise ApiError(\n                400, \"Validation failed\", {\"priority\": \"Priority must be one of: low, medium, high\"}\n            )\n        return None\n    if not isinstance(value, str) or value not in PRIORITIES:\n        raise ApiError(\n            400, \"Validation failed\", {\"priority\": \"Priority must be one of: low, medium, high\"}\n        )\n    return value\n\n\ndef _validate_position(value):\n    if isinstance(value, bool) or not isinstance(value, int):\n        raise ApiError(400, \"Validation failed\", {\"position\": \"Position must be a whole number\"})\n    if value < 1:\n        raise ApiError(400, \"Validation failed\", {\"position\": \"Position must be 1 or greater\"})\n    return value\n\n\ndef _rebalance(conn, status: str, start_from: int = 1) -> None:\n    \"\"\"Assign gap-free positions 1..n to the tasks of a column.\"\"\"\n    rows = conn.execute(\n        \"SELECT id FROM tasks WHERE status = ? ORDER BY position, id\", (status,)\n    ).fetchall()\n    for offset, row in enumerate(rows):\n        conn.execute(\n            \"UPDATE tasks SET position = ? WHERE id = ?\", (start_from + offset, row[\"id\"])\n        )\n\n\n@tasks_bp.get(\"\")\ndef list_tasks():\n    status_filter = request.args.get(\"status\")\n    priority_filter = request.args.get(\"priority\")\n    if status_filter is not None and status_filter != \"\":\n        if status_filter not in STATUSES:\n            raise ApiError(\n                400, \"Validation failed\", {\"status\": \"Status must be one of: todo, in_progress, done\"}\n            )\n    else:\n        status_filter = None\n    if priority_filter is not None and priority_filter != \"\":\n        if priority_filter not in PRIORITIES:\n            raise ApiError(\n                400,\n                \"Validation failed\",\n                {\"priority\": \"Priority must be one of: low, medium, high\"},\n            )\n    else:\n        priority_filter = None\n\n    sql = \"SELECT * FROM tasks WHERE 1=1\"\n    params: list = []\n    if status_filter:\n        sql += \" AND status = ?\"\n        params.append(status_filter)\n    if priority_filter:\n        sql += \" AND priority = ?\"\n        params.append(priority_filter)\n    order = \", \".join(f\"'{s}'\" for s in STATUSES)\n    sql += f\" ORDER BY CASE status WHEN {order.split(', ')[0]} \"\n    sql = \"SELECT * FROM tasks WHERE 1=1\"\n    where = \"\"\n    if status_filter:\n        where += \" AND status = ?\"\n    if priority_filter:\n        where += \" AND priority = ?\"\n    case = \"ORDER BY CASE status \"\n    for index, name in enumerate(STATUSES):\n        case += f\"WHEN '{name}' THEN {index} \"\n    case += \"ELSE 99 END, position, id\"\n\n    conn = connect()\n    try:\n        rows = conn.execute(sql + where + \" \" + case, params).fetchall()\n    finally:\n        conn.close()\n\n    items = [serialize(row) for row in rows]\n    counts = {name: 0 for name in STATUSES}\n    for item in items:\n        counts[item[\"status\"]] += 1\n    return jsonify({\"items\": items, \"total\": len(items), \"counts\": counts})\n\n\n@tasks_bp.post(\"\")\ndef create_task():\n    current_user_id()\n    body = _json_body()\n    title = _validate_title(body.get(\"title\"), required=True)\n    description = _validate_description(body.get(\"description\", \"\")) or \"\"\n    status = _validate_status(body.get(\"status\", \"todo\"), required=False) or \"todo\"\n    priority = _validate_priority(body.get(\"priority\", \"medium\"), required=False) or \"medium\"\n    stamp = now_iso()\n\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        last = conn.execute(\n            \"SELECT COALESCE(MAX(position), 0) AS p FROM tasks WHERE status = ?\", (status,)\n        ).fetchone()[\"p\"]\n        cur = conn.execute(\n            \"INSERT INTO tasks (title, description, status, priority, position, updated_at) \"\n            \"VALUES (?, ?, ?, ?, ?, ?)\",\n            (title, description, status, priority, last + 1, stamp),\n        )\n        task_id = cur.lastrowid\n        conn.commit()\n        row = conn.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    finally:\n        conn.close()\n    return jsonify(serialize(row)), 201\n\n\ndef _get_task_or_404(conn, task_id: int):\n    if isinstance(task_id, bool) or not isinstance(task_id, int):\n        raise ApiError(404, \"Task not found\")\n    row = conn.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    if row is None:\n        raise ApiError(404, \"Task not found\")\n    return row\n\n\n@tasks_bp.get(\"/<int:task_id>\")\ndef get_task(task_id: int):\n    conn = connect()\n    try:\n        row = _get_task_or_404(conn, task_id)\n    finally:\n        conn.close()\n    return jsonify(serialize(row))\n\n\n@tasks_bp.patch(\"/<int:task_id>\")\ndef update_task(task_id: int):\n    current_user_id()\n    body = _json_body(patch=True)\n\n    given = {k: body[k] for k in (\"title\", \"description\", \"status\", \"priority\", \"position\") if k in body}\n    if not given:\n        raise ApiError(400, \"No fields to update\")\n\n    title = _validate_title(given.get(\"title\"), required=False) if \"title\" in given else None\n    description = _validate_description(given.get(\"description\")) if \"description\" in given else None\n    status = _validate_status(given.get(\"status\"), required=False) if \"status\" in given else None\n    priority = _validate_priority(given.get(\"priority\"), required=False) if \"priority\" in given else None\n    position = _validate_position(given.get(\"position\")) if \"position\" in given else None\n\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        row = _get_task_or_404(conn, task_id)\n        source_status = row[\"status\"]\n        target_status = status or source_status\n\n        new_title = title if title is not None else row[\"title\"]\n        new_description = description if \"description\" in given else row[\"description\"]\n        if \"description\" in given and new_description is None:\n            new_description = \"\"\n        new_priority = priority if priority is not None else row[\"priority\"]\n\n        others = conn.execute(\n            \"SELECT id FROM tasks WHERE status = ? AND id != ? ORDER BY position, id\",\n            (target_status, task_id),\n        ).fetchall()\n        max_position = len(others) + 1\n        if position is not None and position > max_position:\n            conn.rollback()\n            raise ApiError(\n                400,\n                \"Validation failed\",\n                {\"position\": f\"Position must be between 1 and {max_position}\"},\n            )\n\n        if position is not None:\n            index = position - 1\n        elif status and status != source_status:\n            index = len(others)\n        else:\n            index = None\n\n        conn.execute(\n            \"UPDATE tasks SET title = ?, description = ?, status = ?, priority = ?, updated_at = ? \"\n            \"WHERE id = ?\",\n            (new_title, new_description, target_status, new_priority, now_iso(), task_id),\n        )\n\n        if index is not None:\n            ordered_ids = [r[\"id\"] for r in others]\n            ordered_ids.insert(index, task_id)\n            for offset, tid in enumerate(ordered_ids):\n                conn.execute(\n                    \"UPDATE tasks SET position = ? WHERE id = ?\", (offset + 1, tid)\n                )\n            if status and status != source_status:\n                _rebalance(conn, source_status)\n        elif status and status != source_status:\n            _rebalance(conn, source_status)\n            _rebalance(conn, target_status)\n\n        conn.commit()\n        row = conn.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    finally:\n        conn.close()\n    return jsonify(serialize(row))\n\n\n@tasks_bp.delete(\"/<int:task_id>\")\ndef delete_task(task_id: int):\n    current_user_id()\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        row = _get_task_or_404(conn, task_id)\n        conn.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\n        _rebalance(conn, row[\"status\"])\n        conn.commit()\n    finally:\n        conn.close()\n    return \"\", 204\n","filePath":"/workspace/backend/tasks.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/tasks.py","exists":false,"truncated":false},"title":"backend/tasks.py","time":{"start":1794356841579,"end":1794356841590}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8008c63001enb2jzzock7vnB","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","messageID":"msg_1c7ffc99a001RcnWUYGEM6jCqr"}}
