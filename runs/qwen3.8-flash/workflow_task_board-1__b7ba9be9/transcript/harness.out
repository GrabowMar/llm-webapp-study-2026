{"type":"step_start","timestamp":1794356782165,"sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","part":{"id":"prt_1c7ffa44500195yuO7foa3NMsT","messageID":"msg_1c7ff6ad4001VS5RgzDJfk27dM","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","type":"step-start"}}
{"type":"tool_use","timestamp":1794356782185,"sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","part":{"type":"tool","tool":"write","callID":"call_c1358038a6a9447388bbe534","state":{"status":"completed","input":{"content":"\"\"\"Accounts: registration, login and Bearer-token sessions.\"\"\"\n\nimport secrets\nfrom datetime import datetime, timezone\n\nfrom flask import Blueprint, g, jsonify, request\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import connect\nfrom errors import ApiError\n\nauth_bp = Blueprint(\"auth\", __name__, url_prefix=\"/api/auth\")\n\nMIN_PASSWORD = 8\nMAX_USERNAME = 64\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef _json_body() -> dict:\n    body = request.get_json(silent=True)\n    if body is None:\n        if request.data and not request.is_json:\n            raise ApiError(400, \"Request body must be JSON\")\n        body = {} if request.data else {}\n    if not isinstance(body, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return body\n\n\ndef _validate_credentials(body: dict) -> tuple[str, str]:\n    errors: dict[str, str] = {}\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    elif len(username.strip()) > MAX_USERNAME:\n        errors[\"username\"] = f\"Username must be at most {MAX_USERNAME} characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < MIN_PASSWORD:\n        errors[\"password\"] = f\"Password must be at least {MIN_PASSWORD} characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return username.strip(), password\n\n\n@auth_bp.post(\"/register\")\ndef register():\n    body = _json_body()\n    username, password = _validate_credentials(body)\n    conn = connect()\n    try:\n        try:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n        except Exception:\n            conn.rollback()\n            existing = conn.execute(\n                \"SELECT 1 FROM users WHERE username = ?\", (username,)\n            ).fetchone()\n            if existing:\n                raise ApiError(\n                    409,\n                    \"Validation failed\",\n                    {\"username\": \"Username is already taken\"},\n                ) from None\n            raise\n        conn.commit()\n    finally:\n        conn.close()\n    return jsonify({\"message\": \"Account created\", \"username\": username}), 201\n\n\n@auth_bp.post(\"/login\")\ndef login():\n    body = _json_body()\n    errors: dict[str, str] = {}\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n\n    conn = connect()\n    try:\n        user = conn.execute(\n            \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n        ).fetchone()\n        if user is None or not check_password_hash(user[\"password_hash\"], password):\n            raise ApiError(401, \"Invalid username or password\")\n        token = secrets.token_urlsafe(32)\n        conn.execute(\n            \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n            (token, user[\"id\"], now_iso()),\n        )\n        conn.commit()\n    finally:\n        conn.close()\n    return jsonify({\"token\": token}), 200\n\n\ndef current_user_id() -> int:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        raise ApiError(401, \"Authentication required\")\n    conn = connect()\n    try:\n        row = conn.execute(\n            \"SELECT s.user_id, u.username FROM sessions s \"\n            \"JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n            (token.strip(),),\n        ).fetchone()\n    finally:\n        conn.close()\n    if row is None:\n        raise ApiError(401, \"Invalid or expired token\")\n    g.user = {\"id\": row[\"user_id\"], \"username\": row[\"username\"]}\n    return row[\"user_id\"]\n","filePath":"/workspace/backend/auth.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/auth.py","exists":false,"truncated":false},"title":"backend/auth.py","time":{"start":1794356782160,"end":1794356782168}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ffa4480014eTokU188cI50c","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","messageID":"msg_1c7ff6ad4001VS5RgzDJfk27dM"}}
