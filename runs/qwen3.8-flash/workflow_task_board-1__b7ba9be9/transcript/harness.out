not isinstance(body, dict):\n         raise ApiError(400, \"Request body must be a JSON object\")\n     return body\n \n","additions":0,"deletions":4},"truncated":false},"title":"backend/auth.py","time":{"start":1794356791684,"end":1794356791695}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ffc97d001rGOcP2TMUqdCPt","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","messageID":"msg_1c7ffa464001qACcJIaHMkXPbg"}}
