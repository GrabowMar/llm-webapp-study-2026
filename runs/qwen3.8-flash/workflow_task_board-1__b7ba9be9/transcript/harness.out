{"type":"tool_use","timestamp":1794357906051,"sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","part":{"type":"tool","tool":"write","callID":"call_2cbc95dec64c403aaa5c897b","state":{"status":"completed","input":{"content":"import { useRef } from \"react\";\nimport type { PointerEvent as ReactPointerEvent } from \"react\";\n\nimport type { Task } from \"../api\";\nimport { startDrag, type DropTarget } from \"../dnd\";\nimport PriorityBadge from \"./PriorityBadge\";\n\ninterface Props {\n  task: Task;\n  canEdit: boolean;\n  dragging: boolean;\n  onEdit: (task: Task) => void;\n  onDelete: (task: Task) => void;\n  onMove: (taskId: number, target: DropTarget) => void;\n}\n\nconst DRAG_THRESHOLD = 5;\n\nexport default function TaskCard({ task, canEdit, dragging, onEdit, onDelete, onMove }: Props) {\n  const suppressClick = useRef(false);\n\n  function handlePointerDown(event: ReactPointerEvent<HTMLElement>) {\n    if (!canEdit || event.button !== 0 || event.pointerType === \"mouse\" === false) {\n      // still allow touch drags\n    }\n    if (!canEdit || event.button !== 0) return;\n    const startX = event.clientX;\n    const startY = event.clientY;\n    let dragStarted = false;\n\n    const onWindowMove = (moveEvent: PointerEvent) => {\n      if (dragStarted) return;\n      const dx = moveEvent.clientX - startX;\n      const dy = moveEvent.clientY - startY;\n      if (Math.hypot(dx, dy) < DRAG_THRESHOLD) return;\n      dragStarted = true;\n      suppressClick.current = true;\n      cleanup();\n      startDrag(task.id, { status: task.status, position: task.position }, (target) =>\n        onMove(task.id, target)\n      );\n    };\n    const cleanup = () => {\n      window.removeEventListener(\"pointermove\", onWindowMove);\n      window.removeEventListener(\"pointerup\", cleanup);\n      window.removeEventListener(\"pointercancel\", cleanup);\n    };\n    window.addEventListener(\"pointermove\", onWindowMove);\n    window.addEventListener(\"pointerup\", cleanup);\n    window.addEventListener(\"pointercancel\", cleanup);\n  }\n\n  return (\n    <article\n      className={`group rounded-lg border bg-white p-3 shadow-sm transition ${\n        dragging\n          ? \"border-blue-300 opacity-40\"\n          : \"border-slate-200 hover:border-slate-300 hover:shadow\"\n      } ${canEdit ? \"cursor-grab touch-none select-none active:cursor-grabbing\" : \"\"}`}\n      onPointerDown={handlePointerDown}\n      onClick={(event) => {\n        if (suppressClick.current) {\n          suppressClick.current = false;\n          event.preventDefault();\n          event.stopPropagation();\n        }\n      }}\n    >\n      <div className=\"flex items-start justify-between gap-2\">\n        <h4 className=\"min-w-0 break-words text-sm font-semibold text-slate-800\">\n          {task.title}\n        </h4>\n        <PriorityBadge priority={task.priority} />\n      </div>\n      {task.description ? (\n        <p className=\"mt-1 line-clamp-2 text-xs text-slate-500\">{task.description}</p>\n      ) : null}\n      <div className=\"mt-2 flex items-center justify-between\">\n        <span className=\"text-[11px] text-slate-400\">\n          #{task.id} · pos {task.position}\n        </span>\n        {canEdit ? (\n          <span className=\"flex gap-1 opacity-0 transition group-hover:opacity-100\">\n            <button\n              type=\"button\"\n              className=\"rounded px-1.5 py-0.5 text-xs font-medium text-blue-600 hover:bg-blue-50\"\n              onClick={(event) => {\n                event.stopPropagation();\n                onEdit(task);\n              }}\n            >\n              Edit\n            </button>\n            <button\n              type=\"button\"\n              className=\"rounded px-1.5 py-0.5 text-xs font-medium text-rose-600 hover:bg-rose-50\"\n              onClick={(event) => {\n                event.stopPropagation();\n                onDelete(task);\n              }}\n            >\n              Delete\n            </button>\n          </span>\n        ) : null}\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/components/TaskCard.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/TaskCard.tsx","exists":true,"truncated":false},"title":"frontend/src/components/TaskCard.tsx","time":{"start":1794357906025,"end":1794357906033}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c810ca64001mfBhAeEs3lLCka","sessionID":"ses_e38045b15ffejDFKnkcMhyDjwn","messageID":"msg_1c81093bf001xPrbLSw1LBJYyd"}}
