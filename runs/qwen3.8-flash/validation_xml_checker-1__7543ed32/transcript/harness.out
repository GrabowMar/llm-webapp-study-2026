{"type":"tool_use","timestamp":1794388865696,"sessionID":"ses_e3623210affe7uwGRHhJSYXsIc","part":{"type":"tool","tool":"write","callID":"call_a60b30a5414941249ad6b2f9","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: XML well-formedness API + frontend static server.\"\"\"\n\nimport re\nfrom pathlib import Path\n\nfrom flask import Flask, jsonify, request, send_from_directory\n\nimport auth\nfrom db import get_conn, init_db, now_iso\nfrom xmlcheck import check_xml\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nPREVIEW_LEN = 200\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.:@-]{3,64}$\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 10 * 1024 * 1024\n\ninit_db()\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef current_user() -> dict | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if header.startswith(\"Bearer \"):\n        return auth.user_for_token(header[7:].strip())\n    return None\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, (jsonify({\"error\": \"authentication required\"}), 401)\n    return user, None\n\n\ndef row_to_check(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = str(body.get(\"username\") or \"\").strip()\n    password = str(body.get(\"password\") or \"\")\n    if not USERNAME_RE.match(username):\n        return jsonify({\"error\": \"username must be 3-64 characters (letters, digits, _.:@-)\"}), 400\n    if len(password) < 6:\n        return jsonify({\"error\": \"password must be at least 6 characters\"}), 400\n    if auth.create_user(username, password) is None:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = str(body.get(\"username\") or \"\").strip()\n    password = str(body.get(\"password\") or \"\")\n    user_id = auth.verify_user(username, password)\n    if user_id is None:\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    return jsonify({\"token\": auth.issue_token(user_id)}), 200\n\n\n@app.post(\"/api/validate/xml\")\ndef validate_xml():\n    body = json_body()\n    if \"xml\" not in body or body[\"xml\"] is None:\n        return jsonify({\"error\": \"field 'xml' is required\"}), 400\n    xml = body[\"xml\"]\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"field 'xml' must be a string\"}), 400\n    return jsonify(check_xml(xml)), 200\n\n\n@app.post(\"/api/validations\")\ndef create_validation():\n    user, err = require_user()\n    if err:\n        return err\n    body = json_body()\n    if \"xml\" not in body or body[\"xml\"] is None:\n        return jsonify({\"error\": \"field 'xml' is required\"}), 400\n    xml = body[\"xml\"]\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"field 'xml' must be a string\"}), 400\n    result = check_xml(xml)\n    with get_conn() as conn:\n        cur = conn.execute(\n            \"INSERT INTO validations\"\n            \" (user_id, xml_preview, valid, error, line, \\\"column\\\", root_element, created_at)\"\n            \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (\n                user[\"id\"],\n                xml[:PREVIEW_LEN],\n                1 if result[\"valid\"] else 0,\n                result[\"error\"],\n                result[\"line\"],\n                result[\"column\"],\n                result[\"root_element\"],\n                now_iso(),\n            ),\n        )\n        row = conn.execute(\n            \"SELECT * FROM validations WHERE id = ?\", (cur.lastrowid,)\n        ).fetchone()\n    return jsonify(row_to_check(row)), 201\n\n\n@app.get(\"/api/validations\")\ndef list_validations():\n    user, err = require_user()\n    if err:\n        return err\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except ValueError:\n        return jsonify({\"error\": \"page must be an integer\"}), 400\n    try:\n        page_size = min(100, max(1, int(request.args.get(\"page_size\", 10))))\n    except ValueError:\n        return jsonify({\"error\": \"page_size must be an integer\"}), 400\n\n    where = [\"user_id = ?\"]\n    params: list = [user[\"id\"]]\n    valid = request.args.get(\"valid\")\n    if valid is not None and valid != \"\":\n        if valid.lower() in (\"true\", \"1\"):\n            where.append(\"valid = 1\")\n        elif valid.lower() in (\"false\", \"0\"):\n            where.append(\"valid = 0\")\n        else:\n            return jsonify({\"error\": \"valid must be true or false\"}), 400\n    clause = \" AND \".join(where)\n\n    with get_conn() as conn:\n        total = conn.execute(\n            f\"SELECT COUNT(*) AS n FROM validations WHERE {clause}\", params\n        ).fetchone()[\"n\"]\n        rows = conn.execute(\n            f\"SELECT * FROM validations WHERE {clause}\"\n            \" ORDER BY id DESC LIMIT ? OFFSET ?\",\n            (*params, page_size, (page - 1) * page_size),\n        ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [row_to_check(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.delete(\"/api/validations/<int:check_id>\")\ndef delete_validation(check_id: int):\n    user, err = require_user()\n    if err:\n        return err\n    with get_conn() as conn:\n        cur = conn.execute(\n            \"DELETE FROM validations WHERE id = ? AND user_id = ?\",\n            (check_id, user[\"id\"]),\n        )\n        if cur.rowcount == 0:\n            return jsonify({\"error\": \"not found\"}), 404\n    return jsonify({\"deleted\": check_id}), 200\n\n\n@app.errorhandler(404)\ndef api_not_found(e):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return e\n\n\n@app.errorhandler(413)\ndef too_large(e):\n    return jsonify({\"error\": \"document too large\"}), 413\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794388865668,"end":1794388865678}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9e9327f001yOflS4qyhvI03h","sessionID":"ses_e3623210affe7uwGRHhJSYXsIc","messageID":"msg_1c9e89110001q4fgtBi80ACMb3"}}
