\"valid\"] for it in l[\"items\"]))\ns,l2 = req(\"GET\",\"/validations\", None, tb[\"token\"]); print(\"bob sees\", l2[\"total\"], \"ids\", sorted(set(i[\"id\"] for i in l2[\"items\"]))==sorted(set(i[\"id\"] for i in l2[\"items\"])))\nalice_ids = set(i[\"id\"] for i in l[\"items\"]) if False else None\ns,l = req(\"GET\",\"/validations?page_size=100\", None, TOK); a_ids = set(i[\"id\"] for i in l[\"items\"])\ns,l2 = req(\"GET\",\"/validations?page_size=100\", None, tb[\"token\"]); b_ids = set(i[\"id\"] for i in l2[\"items\"])\nprint(\"disjoint\", s==200, not (a_ids & b_ids), len(a_ids), len(b_ids))\nfirst = min(a_ids)\ns,r = req(\"DELETE\", f\"/validations/{first}\", None, TOK); print(\"delete own\", s, r)\ns,r = req(\"DELETE\", f\"/validations/{first}\", None, TOK); print(\"delete again\", s, r)\nbob_first = min(b_ids)\ns,r = req(\"DELETE\", f\"/validations/{bob_first}\", None, TOK); print(\"alice delete bob's\", s, r)\ns,r = req(\"DELETE\", \"/validations/99999\", None, TOK); print(\"delete nonexistent\", s)\ns,r = req(\"DELETE\", f\"/validations/{bob_first}\"); print(\"delete no token\", s)\ns,l = req(\"GET\",\"/validations?page=99\", None, TOK); print(\"far page\", s, l[\"total\"], len(l[\"items\"]))\ns,l = req(\"GET\",\"/validations?page=0\", None, TOK); print(\"page0 clamps\", s, l[\"page\"])\ns,l = req(\"GET\",\"/validations?valid=maybe\", None, TOK); print(\"bad valid\", s)\nEOF","timeout":60000},"output":"register bob 201\nbob login 200\npage1 200 13 5 [False, True, False, True, False]\npage2 200 [14, 12, 10, 8, 6]\nvalid=true 200 6 True\nvalid=false 200 7 True\nbob sees 12 ids True\ndisjoint True True 13 12\ndelete own 200 {'deleted': 1}\ndelete again 404 {'error': 'not found'}\nalice delete bob's 404 {'error': 'not found'}\ndelete nonexistent 404\ndelete no token 401\nfar page 200 12 0\npage0 clamps 200 1\nbad valid 400\n","metadata":{"output":"register bob 201\nbob login 200\npage1 200 13 5 [False, True, False, True, False]\npage2 200 [14, 12, 10, 8, 6]\n