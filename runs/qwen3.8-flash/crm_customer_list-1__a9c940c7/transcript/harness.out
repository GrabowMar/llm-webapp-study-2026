{"type":"tool_use","timestamp":1794344464403,"sessionID":"ses_e38c37edbffe9PQJcZ1ussHvZe","part":{"type":"tool","tool":"write","callID":"call_75afc9135fe040c385268682","state":{"status":"completed","input":{"content":"const TOKEN_KEY = \"cd_token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nlet onUnauthorized: (() => void) | null = null;\nexport function setOnUnauthorized(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nasync function request<T>(path: string, options: RequestInit = {}, auth = true): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n    ...((options.headers as Record<string, string>) ?? {}),\n  };\n  if (auth && getToken()) headers[\"Authorization\"] = `Bearer ${getToken()}`;\n  const res = await fetch(`/api${path}`, { ...options, headers });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    /* non JSON body */\n  }\n  if (!res.ok) {\n    const err = (data as { error?: string }) ?? null;\n    if (res.status === 401 && auth && onUnauthorized) onUnauthorized();\n    throw new ApiError(res.status, err?.error ?? `Request failed (${res.status}).`);\n  }\n  return data as T;\n}\n\nexport interface CustomerQuery {\n  q?: string;\n  company?: string;\n  page?: number;\n  page_size?: number;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"/auth/register\", { method: \"POST\", body: JSON.stringify({ username, password }) }, false),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", { method: \"POST\", body: JSON.stringify({ username, password }) }, false),\n  listCustomers: (params: CustomerQuery) => {\n    const search = new URLSearchParams();\n    if (params.q) search.set(\"q\", params.q);\n    if (params.company) search.set(\"company\", params.company);\n    if (params.page) search.set(\"page\", String(params.page));\n    if (params.page_size) search.set(\"page_size\", String(params.page_size));\n    const qs = search.toString();\n    return request<import(\"./types\").CustomerPage>(`/customers${qs ? `?${qs}` : \"\"}`);\n  },\n  getCustomer: (id: number) => request<import(\"./types\").Customer>(`/customers/${id}`),\n  createCustomer: (input: import(\"./types\").CustomerInput) =>\n    request<import(\"./types\").Customer>(\"/customers\", { method: \"POST\", body: JSON.stringify(input) }),\n  updateCustomer: (id: number, input: import(\"./types\").CustomerInput) =>\n    request<import(\"./types\").Customer>(`/customers/${id}`, { method: \"PUT\", body: JSON.stringify(input) }),\n  deleteCustomer: (id: number) => request<void>(`/customers/${id}`, { method: \"DELETE\" }),\n  listInteractions: (id: number) =>\n    request<{ items: import(\"./types\").Interaction[] }>(`/customers/${id}/interactions`),\n  createInteraction: (id: number, input: import(\"./types\").InteractionInput) =>\n    request<import(\"./types\").Interaction>(`/customers/${id}/interactions`, {\n      method: \"POST\",\n      body: JSON.stringify(input),\n    }),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794344464358,"end":1794344464377}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c743afdf001dWzEtx41LPx79v","sessionID":"ses_e38c37edbffe9PQJcZ1ussHvZe","messageID":"msg_1c74341b600123RD70ZFRvSOuZ"}}
{"type":"tool_use","timestamp":1794344464403,"sessionID":"ses_e38c37edbffe9PQJcZ1ussHvZe","part":{"type":"tool","tool":"write","callID":"call_ff7bb1db67c443fc82c82e73","state":{"status":"completed","input":{"content":"import type { ReactNode } from \"react\";\n\nexport function navigate(to: string) {\n  window.location.hash = to.startsWith(\"#\") ? to : `#${to}`;\n}\n\nexport function useRoute(): string {\n  const hash = window.location.hash.replace(/^#/, \"\") || \"/\";\n  return hash;\n}\n\nexport function Link({\n  to,\n  className,\n  children,\n}: {\n  to: string;\n  className?: string;\n  children: ReactNode;\n}) {\n  const href = to.startsWith(\"#\") ? to : `#${to}`;\n  return (\n    <a href={href} className={className}>\n      {children}\n    </a>\n  );\n}\n\nexport function matchRoute(pattern: string, route: string): Record<string, string> | null {\n  const pp = pattern.split(\"/\").filter(Boolean);\n  const rp = route.split(\"?\")[0].split(\"/\").filter(Boolean);\n  if (pp.length !== rp.length) return null;\n  const params: Record<string, string> = {};\n  for (let i = 0; i < pp.length; i++) {\n    if (pp[i].startsWith(\":\")) params[pp[i].slice(1)] = decodeURIComponent(rp[i]);\n    else if (pp[i] !== rp[i]) return null;\n  }\n  return params;\n}\n","filePath":"/workspace/frontend/src/router.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/router.ts","exists":false,"truncated":false},"title":"frontend/src/router.ts","time":{"start":1794344464368,"end":1794344464384}},"id":"prt_1c743afe9001zt0RlUZ4Zueepu","sessionID":"ses_e38c37edbffe9PQJcZ1ussHvZe","messageID":"msg_1c74341b600123RD70ZFRvSOuZ"}}
