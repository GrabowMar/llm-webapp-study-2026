{"type":"tool_use","timestamp":1794353512898,"sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","part":{"type":"tool","tool":"write","callID":"call_45ca5b27c16d4271a864e822","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: JSON API under /api plus the frontend build.\"\"\"\n\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import get_connection\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1 * 1024 * 1024\n\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,64}$\")\n\nDT_RE = re.compile(\n    r\"^(\\d{4})-(\\d{2})-(\\d{2})\"\n    r\"[T ](\\d{2}):(\\d{2})(?::(\\d{2})(?:\\.\\d+)?)?\"\n    r\"(Z|z|[+-]\\d{2}:?\\d{2})?$\"\n)\n\nERR_MESSAGES: dict[int, str] = {\n    400: \"Bad request\",\n    401: \"Authentication required\",\n    404: \"Not found\",\n    405: \"Method not allowed\",\n    409: \"Conflict\",\n    413: \"Request entity too large\",\n    422: \"Unprocessable entity\",\n    500: \"Internal server error\",\n}\n\n\n# ---------------------------------------------------------------- helpers ---\n\n\ndef utc_now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef error(status: int, message: str, fields: dict[str, str] | None = None):\n    payload: dict[str, Any] = {\"error\": message, \"message\": message}\n    if fields:\n        payload[\"fields\"] = fields\n    return jsonify(payload), status\n\n\ndef parse_dt(value: Any, field: str) -> tuple[datetime | None, str | None]:\n    if not isinstance(value, str) or not value.strip():\n        return None, f\"{field} is required\"\n    match = DT_RE.match(value.strip())\n    if not match:\n        return None, (\n            f\"{field} must be an ISO 9601 date-time, e.g. 2024-01-31T14:30\"\n        )\n    year, month, day = int(match.group(1)), int(match.group(2)), int(match.group(3))\n    hour, minute = int(match.group(4)), int(match.group(5))\n    second = int(match.group(6) or 0)\n    frac = match.group(6)\n    micro = 0\n    if frac and \".\" in frac:\n        micro = int(frac.split(\".\", 1)[1][:6].ljust(6, \"0\"))\n    offset = match.group(7)\n    tzinfo: timezone | None = None\n    if offset is None:\n        tzinfo = timezone.utc\n    elif offset in (\"Z\", \"z\"):\n        tzinfo = timezone.utc\n    else:\n        sign = 1 if offset[0] == \"+\" else -1\n        digits = offset[1:].replace(\":\", \"\")\n        total = sign * (int(digits[:2]) * 3600 + int(digits[2:]) * 60)\n        if abs(total) > 24 * 3600 - 60:\n            return None, f\"{field} has an invalid UTC offset\"\n        tzinfo = timezone.utc\n        try:\n            tzinfo = timezone(datetime.fromisoformat(offset[0] + digits[:2] + \":\" + digits[2:]).utcoffset())\n        except ValueError:\n            return None, f\"{field} has an invalid UTC offset\"\n    try:\n        dt = datetime(year, month, day, hour, minute, second, micro, tzinfo)\n    except ValueError:\n        return None, f\"{field} is not a valid date-time\"\n    return dt.astimezone(timezone.utc), None\n\n\ndef to_z(dt: datetime) -> str:\n    out = dt.strftime(\"%Y-%m-%dT%H:%M:%S\")\n    if dt.microsecond:\n        out += f\".{dt.microsecond:06d}\".rstrip(\"0\")\n    return out + \"Z\"\n\n\ndef to_utc_string(value: str) -> str:\n    dt, _ = parse_dt(value, \"dt\")\n    return to_z(dt) if dt is not None else value\n\n\ndef clean_str(value: Any, max_len: int = 4000) -> tuple[str | None, str | None]:\n    if value is None:\n        return None, None\n    if isinstance(value, bool) or not isinstance(value, (str, int, float)):\n        return None, \"must be a string or null\"\n    text = str(value).strip()\n    if not text:\n        return None, None\n    if len(text) > max_len:\n        return None, f\"must be at most {max_len} characters\"\n    return text, None\n\n\ndef event_row_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": row[\"start_time\"],\n        \"end_time\": row[\"end_time\"],\n        \"created_at\": row[\"created_at\"],\n        \"created_by\": row[\"created_by\"],\n    }\n\n\n# ------------------------------------------------------------------ auth ---\n\n\ndef current_user() -> dict[str, Any] | None:\n    if \"eventcal_user\" in g:\n        return g.eventcal_user\n    header = request.headers.get(\"Authorization\", \"\")\n    user = None\n    if header.startswith(\"Bearer \"):\n        token = header[7:].strip()\n        if token:\n            conn = get_connection()\n            row = conn.execute(\n                \"SELECT u.id, u.username FROM tokens t \"\n                \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n                (token,),\n            ).fetchone()\n            if row is not None:\n                user = {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n    g.eventcal_user = user\n    return user\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, error(401, \"Authentication required\")\n    return user, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(400, \"Request body must be a JSON object\")\n    fields: dict[str, str] = {}\n    username = data.get(\"username\")\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        fields[\"username\"] = \"Username must be 3-64 characters: letters, digits, '_' , '-' or '.'\"\n    password = data.get(\"password\")\n    if not isinstance(password, str) or len(password) < 8:\n        fields[\"password\"] = \"Password must be at least 8 characters\"\n    if fields:\n        return error(422, \"Validation failed\", fields)\n    username = username.strip()\n    conn = get_connection()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utc_now_iso()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    return jsonify({\"message\": \"User registered\"}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(401, \"Invalid username or password\")\n    conn = get_connection()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"Invalid username or password\")\n    token = secrets.token_hex(32)\n    conn.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utc_now_iso()),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]}), 200\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    if header.startswith(\"Bearer \"):\n        conn = get_connection()\n        conn.execute(\"DELETE FROM tokens WHERE token = ?\", (header[7:].strip(),))\n        conn.commit()\n    return jsonify({\"ok\": True}), 200\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user, err = require_user()\n    if err is not None:\n        return err\n    return jsonify({\"username\": user[\"username\"]}), 200\n\n\n# ---------------------------------------------------------------- events ---\n\n\ndef filter_clauses(params) -> tuple[list[str], list[str], dict[str, str]]:\n    clauses: list[str] = []\n    args: list[str] = []\n    errors: dict[str, str] = {}\n    range_kind = params.get(\"range\")\n    if range_kind in (\"week\", \"day\") and \"start_date\" not in params:\n        anchor = params.get(\"date\") or params.get(\"start\") or utc_now_iso()\n        anchor_dt, anchor_err = parse_dt(anchor, \"date\")\n        if anchor_err is not None:\n            errors[\"range\"] = \"Invalid 'range' or 'date' parameter; provide an ISO date or date-time\"\n        else:\n            if range_kind == \"day\":\n                start = anchor_dt.replace(hour=0, minute=0, second=0, microsecond=0)\n                end = start + __import__(\"datetime\").timedelta(days=1)\n            else:\n                start = anchor_dt.replace(hour=0, minute=0, second=0, microsecond=0)\n                start = start - __import__(\"datetime\").timedelta(days=start.weekday())\n                end = start + __import__(\"datetime\").timedelta(days=7)\n            clauses.append(\"start_time < ? AND end_time > ?\")\n            args.extend([to_z(end), to_z(start)])\n    if \"start_date\" in params:\n        dt, err = parse_dt(params[\"start_date\"], \"start_date\")\n        if err:\n            errors[\"start_date\"] = (\n                \"start_date must be an ISO date (YYYY-MM-DD) or date-time\"\n            )\n        else:\n            clauses.append(\"end_time > ?\")\n            args.append(to_z(dt))\n    if \"end_date\" in params:\n        raw = params[\"end_date\"]\n        date_only = bool(re.match(r\"^\\d{4}-\\d{2}-\\d{2}$\", raw.strip()))\n        dt, err = parse_dt(raw, \"end_date\")\n        if err:\n            errors[\"end_date\"] = (\n                \"end_date must be an ISO date (YYYY-MM-DD) or date-time\"\n            )\n        else:\n            if date_only:\n                importer = __import__(\"datetime\")\n                dt = dt + importer.timedelta(days=1)\n            clauses.append(\"start_time < ?\")\n            args.append(to_z(dt))\n    return clauses, args, errors\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    clauses, args, errors = filter_clauses(request.args)\n    if errors:\n        return error(400, \"Invalid query parameters\", errors)\n    sql = \"SELECT * FROM events\"\n    if clauses:\n        sql += \" WHERE \" + \" AND \".join(clauses)\n    sql += \" ORDER BY start_time ASC, id ASC\"\n    conn = get_connection()\n    rows = conn.execute(sql, args).fetchall()\n    items = [event_row_to_dict(r) for r in rows]\n    return jsonify({\"items\": items, \"total\": len(items)}), 200\n\n\ndef validate_event_payload(data: dict, present: set[str]) -> tuple[dict | None, dict]:\n    fields: dict[str, str] = {}\n    values: dict[str, Any] = {}\n\n    title = data.get(\"title\")\n    if \"title\" not in present:\n        fields[\"title\"] = \"title is required\"\n    else:\n        if not isinstance(title, str) or not title.strip():\n            fields[\"title\"] = \"title is required and must not be empty\"\n        elif len(title.strip()) > 200:\n            fields[\"title\"] = \"title must be at most 200 characters\"\n        else:\n            values[\"title\"] = title.strip()\n\n    description, err = clean_str(data.get(\"description\"))\n    if err:\n        fields[\"description\"] = f\"description {err}\"\n    else:\n        values[\"description\"] = description\n\n    location, err = clean_str(data.get(\"location\"), max_len=500)\n    if err:\n        fields[\"location\"] = f\"location {err}\"\n    else:\n        values[\"location\"] = location\n\n    start, err = parse_dt(data.get(\"start_time\"), \"start_time\")\n    if err:\n        fields[\"start_time\"] = err\n    else:\n        values[\"start_dt\"] = start\n\n    end, err = parse_dt(data.get(\"end_time\"), \"end_time\")\n    if err:\n        fields[\"end_time\"] = err\n    else:\n        values[\"end_dt\"] = end\n\n    if not fields and values[\"end_dt\"] <= values[\"start_dt\"]:\n        fields[\"end_time\"] = \"end_time must be after start_time\"\n\n    if fields:\n        return None, fields\n\n    values[\"start_time\"] = to_z(values.pop(\"start_dt\"))\n    values[\"end_time\"] = to_z(values.pop(\"end_dt\"))\n    return values, {}\n\n\ndef coerce_scalar(value: Any) -> Any:\n    if isinstance(value, (bool, int, float)):\n        return str(value)\n    return value\n\n\n@app.post(\"/api/events\")\ndef create_event():\n    user, err = require_user()\n    if err is not None:\n        return err\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(400, \"Request body must be a JSON object\")\n    try:\n        values, fields = validate_event_payload(data, set(data.keys()))\n    except Exception:\n        return error(400, \"Request body must be a JSON object\")\n    if values is None:\n        return error(422, \"Validation failed\", fields)\n    conn = get_connection()\n    cur = conn.execute(\n        \"INSERT INTO events (title, description, location, start_time, end_time,\"\n        \" created_at, created_by) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            values[\"title\"],\n            values[\"description\"],\n            values[\"location\"],\n            values[\"start_time\"],\n            values[\"end_time\"],\n            utc_now_iso(),\n            user[\"username\"],\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM events WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(event_row_to_dict(row)), 201\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id: int):\n    conn = get_connection()\n    row = conn.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return error(404, \"Event not found\")\n    return jsonify(event_row_to_dict(row)), 200\n\n\n@app.put(\"/api/events/<int:event_id>\")\ndef update_event(event_id: int):\n    user, err = require_user()\n    if err is not None:\n        return err\n    conn = get_connection()\n    row = conn.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return error(404, \"Event not found\")\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(400, \"Request body must be a JSON object\")\n    try:\n        merged = dict(row)\n        for key, value in data.items():\n            merged[key] = coerce_scalar(value)\n        values, fields = validate_event_payload(merged, set(merged.keys()))\n    except Exception:\n        return error(400, \"Request body must be a JSON object\")\n    if values is None:\n        return error(422, \"Validation failed\", fields)\n    conn.execute(\n        \"UPDATE events SET title = ?, description = ?, location = ?,\"\n        \" start_time = ?, end_time = ? WHERE id = ?\",\n        (\n            values[\"title\"],\n            values[\"description\"],\n            values[\"location\"],\n            values[\"start_time\"],\n            values[\"end_time\"],\n            event_id,\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    return jsonify(event_row_to_dict(row)), 200\n\n\n@app.delete(\"/api/events/<int:event_id>\")\ndef delete_event(event_id: int):\n    user, err = require_user()\n    if err is not None:\n        return err\n    conn = get_connection()\n    cur = conn.execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    conn.commit()\n    if cur.rowcount == 0:\n        return error(404, \"Event not found\")\n    return jsonify({\"deleted\": event_id}), 200\n\n\n@app.get(\"/api/health\")\ndef health():\n    return jsonify({\"status\": \"ok\"}), 200\n\n\n# ------------------------------------------------------------- frontend ---\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n# ---------------------------------------------------------- error handlers --\n\n\n@app.errorhandler(404)\ndef handle_404(_e):\n    if request.path.startswith(\"/api/\"):\n        return error(404, \"Not found\")\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(405)\ndef handle_405(_e):\n    if request.path.startswith(\"/api/\"):\n        return error(405, \"Method not allowed\")\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(413)\ndef handle_413(_e):\n    return error(413, \"Request body too large\")\n\n\n@app.errorhandler(Exception)\ndef handle_exception(e):\n    from werkzeug.exceptions import HTTPException\n\n    if isinstance(e, HTTPException):\n        if request.path.startswith(\"/api/\"):\n            return error(e.code or 500, ERR_MESSAGES.get(e.code or 500, e.description))\n        return send_from_directory(DIST, \"index.html\")\n    app.logger.exception(\"Unhandled error\")\n    if request.path.startswith(\"/api/\"):\n        return error(500, \"Internal server error\")\n    return send_from_directory(DIST, \"index.html\"), 500\n\n\n@app.teardown_request\ndef close_conn(_exc):\n    conn = g.get(\"eventcal_conn\")\n    if conn is not None:\n        conn.close()\n        g.pop(\"eventcal_conn\", None)\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)), debug=True)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794353512804,"end":1794353512843}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7cdc15f001uijLdJgjdUyqko","sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","messageID":"msg_1c7ccf9c6001LhgCQilNvQf0uO"}}
