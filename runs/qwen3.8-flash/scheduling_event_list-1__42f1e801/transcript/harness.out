{"type":"text","timestamp":1794354157713,"sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","part":{"id":"prt_1c7d7987d001O9a2ceyfMPo4M9","messageID":"msg_1c7d6fd6b001beNS5Zyz6TAEt0","sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","type":"text","text":"Rewriting DayGrid with cleaner lane layout logic:\n\n","time":{"start":1794354157693,"end":1794354157708}}}
{"type":"tool_use","timestamp":1794354157819,"sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","part":{"type":"tool","tool":"write","callID":"call_58a591eabea14a89a89dacbc","state":{"status":"completed","input":{"content":"import { type Event } from \"../api\";\nimport {\n  HOUR_PX,\n  HOURS,\n  WEEKDAYS,\n  addDays,\n  formatTime,\n  isSameDayUTC,\n  overlapsDay,\n  parseAPI,\n  startOfDay,\n  startOfWeek,\n  todayUTC,\n} from \"../dates\";\n\ninterface Positioned {\n  event: Event;\n  start: Date;\n  top: number;\n  height: number;\n  lane: number;\n  lanes: number;\n  fromPrevDay: boolean;\n  toNextDay: boolean;\n}\n\nconst EVENT_COLORS = [\n  \"border-indigo-400 bg-indigo-50 hover:bg-indigo-100\",\n  \"border-emerald-400 bg-emerald-50 hover:bg-emerald-100\",\n  \"border-amber-400 bg-amber-50 hover:bg-amber-100\",\n  \"border-rose-400 bg-rose-50 hover:bg-rose-100\",\n  \"border-sky-400 bg-sky-50 hover:bg-sky-100\",\n  \"border-violet-400 bg-violet-50 hover:bg-violet-100\",\n];\n\nfunction colorClass(id: number): string {\n  return EVENT_COLORS[id % EVENT_COLORS.length];\n}\n\nconst DAY_MINUTES = 24 * 60;\n\nfunction minutesOf(d: Date): number {\n  return d.getUTCHours() * 60 + d.getUTCMinutes();\n}\n\nfunction layoutDay(dayStart: Date, events: Event[]): Positioned[] {\n  const dayEnd = addDays(dayStart, 1);\n  const items = events\n    .map((event) => ({ event, start: parseAPI(event.start_time), end: parseAPI(event.end_time) }))\n    .filter(({ start, end }) => overlapsDay(dayStart, start, end))\n    .sort(\n      (a, b) =>\n        a.start.getTime() - b.start.getTime() ||\n        b.end.getTime() - a.end.getTime() ||\n        a.event.id - b.event.id,\n    );\n\n  const positioned: Positioned[] = [];\n  let cluster: typeof items = [];\n  let clusterEnd = 0;\n  const laneEnds: number[] = [];\n\n  const flush = () => {\n    const lanes = laneEnds.length;\n    for (const p of positioned) {\n      if (cluster.some((it) => it.event.id === p.event.id && p.toNextDay === undefined)) {\n        // handled below\n      }\n    }\n    for (const it of cluster) {\n      const match = positioned.find((p) => p.event === it.event);\n      if (match) match.lanes = lanes;\n    }\n    cluster = [];\n    clusterEnd = 0;\n    laneEnds.length = 0;\n  };\n\n  for (const it of items) {\n    const s = Math.max(minutesOf(it.start), 0);\n    const continues = it.end > dayEnd;\n    const e = continues ? DAY_MINUTES : Math.max(minutesOf(it.end), s + 15);\n    if (cluster.length && s >= clusterEnd) flush();\n    let lane = laneEnds.findIndex((endAt) => endAt <= s);\n    if (lane === -1) {\n      lane = laneEnds.length;\n      laneEnds.push(0);\n    }\n    laneEnds[lane] = Math.max(laneEnds[lane], e);\n    clusterEnd = Math.max(clusterEnd, e);\n    cluster.push(it);\n    positioned.push({\n      event: it.event,\n      start: it.start,\n      top: (s / 60) * HOUR_PX,\n      height: Math.max(((e - s) / 60) * HOUR_PX, 22),\n      lane,\n      lanes: 1,\n      fromPrevDay: it.start < dayStart,\n      toNextDay: continues,\n    });\n  }\n  flush();\n  return positioned;\n}\n\nfunction EventBlock({\n  p,\n  compact,\n  onSelect,\n}: {\n  p: Positioned;\n  compact: boolean;\n  onSelect: (event: Event) => void;\n}) {\n  return (\n    <button\n      type=\"button\"\n      onClick={() => onSelect(p.event)}\n      style={{\n        top: p.top,\n        height: p.height,\n        left: `calc(${(p.lane * 100) / p.lanes}% + 2px)`,\n        width: `calc(${100 / p.lanes}% - 4px)`,\n      }}\n      title={`${p.event.title} · ${formatTime(p.start)} UTC`}\n      className={`absolute overflow-hidden rounded border-l-4 px-1.5 py-0.5 text-left text-[11px] leading-tight shadow-sm transition ${colorClass(\n        p.event.id,\n      )}`}\n    >\n      <span className=\"block truncate font-semibold text-slate-800\">\n        {p.fromPrevDay ? \"← \" : \"\"}\n        {p.event.title}\n      </span>\n      {!compact && (\n        <span className=\"block truncate text-slate-500\">\n          {formatTime(p.start)}\n          {p.toNextDay ? \" →\" : \"\"}\n        </span>\n      )}\n    </button>\n  );\n}\n\nfunction TimeGutter() {\n  return (\n    <div className=\"w-12 shrink-0 select-none\">\n      {HOURS.map((h) => (\n        <div\n          key={h}\n          style={{ height: HOUR_PX }}\n          className=\"relative border-b border-transparent\"\n        >\n          <span className=\"absolute -top-2 right-1.5 text-[10px] text-slate-400\">\n            {h.toString().padStart(2, \"0\")}:00\n          </span>\n        </div>\n      ))}\n    </div>\n  );\n}\n\nfunction DayColumn({\n  day,\n  events,\n  compact,\n  onSelect,\n  onCreateAt,\n}: {\n  day: Date;\n  events: Event[];\n  compact: boolean;\n  onSelect: (event: Event) => void;\n  onCreateAt: (start: Date, end: Date) => void;\n}) {\n  const positioned = layoutDay(day, events);\n  const isToday = isSameDayUTC(day, todayUTC());\n\n  return (\n    <div\n      className=\"relative min-w-0 flex-1 border-l border-slate-200\"\n      onClick={(e) => {\n        if (e.target !== e.currentTarget) return;\n        const rect = e.currentTarget.getBoundingClientRect();\n        const minutes = Math.floor(((e.clientY - rect.top) / HOUR_PX) * 60 / 30) * 30;\n        const clamped = Math.min(Math.max(minutes, 0), DAY_MINUTES - 60);\n        const start = new Date(day.getTime() + clamped * 60_000);\n        onCreateAt(start, new Date(start.getTime() + 60 * 60_000));\n      }}\n    >\n      <div className=\"pointer-events-none absolute inset-0\">\n        {HOURS.map((h) => (\n          <div key={h} style={{ height: HOUR_PX }} className=\"border-b border-slate-100\" />\n        ))}\n      </div>\n      {positioned.map((p) => (\n        <EventBlock key={p.event.id} p={p} compact={compact} onSelect={onSelect} />\n      ))}\n      {isToday && <NowLine />}\n    </div>\n  );\n}\n\nfunction NowLine() {\n  const now = new Date();\n  const top = ((now.getUTCHours() * 60 + now.getUTCMinutes()) / 60) * HOUR_PX;\n  return (\n    <div className=\"pointer-events-none absolute inset-x-0 z-10\" style={{ top }}>\n      <div className=\"relative\">\n        <div className=\"h-0.5 bg-red-500\" />\n        <div className=\"absolute -left-1 -top-[3px] h-2 w-2 rounded-full bg-red-500\" />\n      </div>\n    </div>\n  );\n}\n\nexport function TimeGrid({\n  days,\n  events,\n  compact = false,\n  onSelect,\n  onCreateAt,\n}: {\n  days: Date[];\n  events: Event[];\n  compact?: boolean;\n  onSelect: (event: Event) => void;\n  onCreateAt: (start: Date, end: Date) => void;\n}) {\n  return (\n    <div className=\"overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm\">\n      <div className=\"min-w-[560px]\">\n        <WeekHeaderRow days={days} />\n        <div className=\"flex\">\n          <TimeGutter />\n          {days.map((day) => (\n            <DayColumn\n              key={day.getTime()}\n              day={startOfDay(day)}\n              events={events}\n              compact={compact}\n              onSelect={onSelect}\n              onCreateAt={onCreateAt}\n            />\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction WeekHeaderRow({ days }: { days: Date[] }) {\n  const isToday = todayUTC();\n  return (\n    <div className=\"mb-1 flex border-b border-slate-200 pl-12\">\n      {days.map((day) => {\n        const today = isSameDayUTC(day, isToday);\n        return (\n          <div\n            key={day.getTime()}\n            className={`min-w-0 flex-1 border-l border-transparent px-1 pb-1 text-center text-xs ${\n              today ? \"font-bold text-indigo-600\" : \"font-medium text-slate-600\"\n            }`}\n          >\n            <span className=\"block truncate\">{WEEKDAYS[(day.getUTCDay() + 6) % 7]}</span>\n            <span className=\"block truncate font-normal text-slate-400\">\n              {day.getUTCDate()}/{day.getUTCMonth() + 1}\n            </span>\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\nexport function weekDays(anchor: Date): Date[] {\n  const monday = startOfWeek(anchor);\n  return Array.from({ length: 7 }, (_, i) => addDays(monday, i));\n}\n\nexport { TimeGrid as default };\n","filePath":"/workspace/frontend/src/components/DayGrid.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/DayGrid.tsx","exists":true,"truncated":false},"title":"frontend/src/components/DayGrid.tsx","time":{"start":1794354157703,"end":1794354157798}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7d79880001a3F5oeGP076UVw","sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","messageID":"msg_1c7d6fd6b001beNS5Zyz6TAEt0"}}
