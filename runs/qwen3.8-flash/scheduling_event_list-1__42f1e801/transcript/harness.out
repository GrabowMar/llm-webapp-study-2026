{"type":"tool_use","timestamp":1794354047412,"sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","part":{"type":"tool","tool":"write","callID":"call_11a84086a9cc4dffa3f47ba7","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { ApiError, api, setSession } from \"../api\";\n\ntype Tab = \"login\" | \"register\";\n\nexport default function AuthModal({\n  initialTab = \"login\",\n  onAuthed,\n  onClose,\n}: {\n  initialTab?: Tab;\n  onAuthed: (username: string) => void;\n  onClose: () => void;\n}) {\n  const [tab, setTab] = useState<Tab>(initialTab);\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [formError, setFormError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setErrors({});\n    setFormError(\"\");\n    try {\n      if (tab === \"register\") {\n        await api.register(username, password);\n        const res = await api.login(username, password);\n        setSession(res.token, username);\n        onAuthed(username);\n      } else {\n        const res = await api.login(username, password);\n        const name = res.username ?? username;\n        setSession(res.token, name);\n        onAuthed(name);\n      }\n      onClose();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.fields);\n        setFormError(err.message);\n      } else {\n        setFormError(\"Network error, please try again.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const fieldError = (name: string) =>\n    errors[name] ?? errors[tab === \"login\" ? \"username\" : \"username\"];\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-900/60 p-4 pt-20\">\n      <div className=\"w-full max-w-sm rounded-xl bg-white p-6 shadow-2xl\">\n        <div className=\"mb-4 flex rounded-lg bg-slate-100 p-1 text-sm font-medium\">\n          {([\"login\", \"register\"] as Tab[]).map((t) => (\n            <button\n              key={t}\n              type=\"button\"\n              onClick={() => {\n                setTab(t);\n                setErrors({});\n                setFormError(\"\");\n              }}\n              className={`flex-1 rounded-md px-3 py-1.5 capitalize transition ${\n                tab === t\n                  ? \"bg-white text-slate-900 shadow-sm\"\n                  : \"text-slate-500 hover:text-slate-700\"\n              }`}\n            >\n              {t === \"login\" ? \"Sign in\" : \"Register\"}\n            </button>\n          ))}\n        </div>\n        <form onSubmit={submit} className=\"space-y-4\">\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Username\n            </label>\n            <input\n              type=\"text\"\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              autoComplete=\"username\"\n              className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\"\n            />\n            {errors.username && (\n              <p className=\"mt-1 text-xs text-red-600\">{errors.username}</p>\n            )}\n          </div>\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Password\n            </label>\n            <input\n              type=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              autoComplete={tab === \"login\" ? \"current-password\" : \"new-password\"}\n              className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\"\n            />\n            {errors.password && (\n              <p className=\"mt-1 text-xs text-red-600\">{errors.password}</p>\n            )}\n          </div>\n          {formError && !fieldError(\"username\") && (\n            <p className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">\n              {formError}\n            </p>\n          )}\n          <div className=\"flex items-center justify-between pt-1\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"rounded-md px-3 py-2 text-sm font-medium text-slate-500 hover:bg-slate-100\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              disabled={busy}\n              className=\"rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-50\"\n            >\n              {busy ? \"Working…\" : tab === \"login\" ? \"Sign in\" : \"Create account\"}\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AuthModal.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AuthModal.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AuthModal.tsx","time":{"start":1794354047387,"end":1794354047395}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7d5e995001Lqw675KHOcN6bY","sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","messageID":"msg_1c7d5a3ec001qM04vmAe7JBD9I"}}
