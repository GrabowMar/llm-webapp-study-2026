{"type":"step_start","timestamp":1794354117980,"sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","part":{"id":"prt_1c7d6fd4c001Rq6MAtytSmVW8F","messageID":"msg_1c7d6836f001OTnlgZkE0k4aq4","sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","type":"step-start"}}
{"type":"tool_use","timestamp":1794354118000,"sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","part":{"type":"tool","tool":"write","callID":"call_7e58cc98ac724ed688adacf0","state":{"status":"completed","input":{"content":"import { type Event } from \"../api\";\nimport {\n  HOUR_PX,\n  HOURS,\n  WEEKDAYS,\n  addDays,\n  formatTime,\n  isSameDayUTC,\n  minutesUTC,\n  overlapsDay,\n  parseAPI,\n  startOfDay,\n  startOfWeek,\n  todayUTC,\n} from \"../dates\";\n\ninterface Positioned {\n  event: Event;\n  start: Date;\n  top: number;\n  height: number;\n  lane: number;\n  lanes: number;\n  clipped: boolean;\n}\n\nconst EVENT_COLORS = [\n  \"border-indigo-400 bg-indigo-50 hover:bg-indigo-100\",\n  \"border-emerald-400 bg-emerald-50 hover:bg-emerald-100\",\n  \"border-amber-400 bg-amber-50 hover:bg-amber-100\",\n  \"border-rose-400 bg-rose-50 hover:bg-rose-100\",\n  \"border-sky-400 bg-sky-50 hover:bg-sky-100\",\n  \"border-violet-400 bg-violet-50 hover:bg-violet-100\",\n];\n\nfunction colorClass(id: number): string {\n  return EVENT_COLORS[id % EVENT_COLORS.length];\n}\n\nfunction layoutDay(dayStart: Date, events: Event[]): Positioned[] {\n  const dayEnd = addDays(dayStart, 1);\n  const items = events\n    .map((event) => {\n      const start = parseAPI(event.start_time);\n      const end = parseAPI(event.end_time);\n      return { event, start, end };\n    })\n    .filter(({ start, end }) => overlapsDay(dayStart, start, end))\n    .sort((a, b) => a.start - b.start || a.end - b.end);\n\n  const positioned: Positioned[] = [];\n  let cluster: number[] = [];\n  let clusterEnd = -Infinity;\n\n  const flush = () => {\n    if (!cluster.length) return;\n    const laneEnds: number[] = [];\n    const assigned = cluster.map((idx) => {\n      const it = items[idx];\n      const s = Math.max(minutesUTC(it.start), 0);\n      const e = Math.min(\n        (it.end <= dayEnd ? minutesUTC(it.end) : 24 * 60) === 0 && it.end > dayEnd\n          ? 24 * 60\n          : Math.max(minutesUTC(it.end), 1),\n        24 * 60,\n      );\n      let lane = laneEnds.findIndex((endAt) => endAt <= s);\n      if (lane === -1) {\n        lane = laneEnds.length;\n        laneEnds.push(0);\n      }\n      laneEnds[lane] = Math.max(laneEnds[lane], e);\n      return { idx, s, e };\n    });\n    const lanes = laneEnds.length;\n    for (const { idx, s, e } of assigned) {\n      const it = items[idx];\n      const clipped = it.start < dayStart || it.end > dayEnd;\n      positioned.push({\n        event: it.event,\n        start: it.start,\n        top: (s / 60) * HOUR_PX,\n        height: Math.max(((e - s) / 60) * HOUR_PX, 20),\n        lane,\n        lanes,\n        clipped,\n      } as Positioned);\n    }\n    cluster = [];\n    clusterEnd = -Infinity;\n  };\n\n  items.forEach((_, idx) => {\n    const it = items[idx];\n    const s = Math.max(minutesUTC(it.start), 0);\n    const e = it.end > addDays(dayStart, 1) ? 24 * 60 : Math.max(minutesUTC(it.end), 1);\n    if (cluster.length && s >= clusterEnd) flush();\n    cluster.push(idx);\n    clusterEnd = Math.max(clusterEnd, e);\n  });\n  flush();\n\n  return positioned.map((p) => ({ ...p, lane: p.lane }));\n}\n\nfunction EventBlock({\n  p,\n  showTitleOnly,\n  onSelect,\n}: {\n  p: Positioned;\n  showTitleOnly: boolean;\n  onSelect: (event: Event) => void;\n}) {\n  const width = `calc(${100 / p.lanes}% - 3px)`;\n  const left = `calc(${(p.lane * 100) / p.lanes}% + 2px)`;\n  return (\n    <button\n      type=\"button\"\n      onClick={() => onSelect(p.event)}\n      style={{ top: p.top, height: p.height, width, left }}\n      title={`${p.event.title} · ${formatTime(p.start)}`}\n      className={`absolute overflow-hidden rounded border-l-4 px-1.5 py-0.5 text-left text-[11px] leading-tight shadow-sm transition ${colorClass(\n        p.event.id,\n      )}`}\n    >\n      <span className=\"block truncate font-semibold text-slate-800\">\n        {p.event.title}\n      </span>\n      {!showTitleOnly && (\n        <span className=\"block truncate text-slate-500\">\n          {p.clipped && \"↦ \"}\n          {formatTime(p.start)}\n        </span>\n      )}\n    </button>\n  );\n}\n\nexport function DayColumn({\n  day,\n  events,\n  onSelect,\n  onCreateAt,\n}: {\n  day: Date;\n  events: Event[];\n  onSelect: (event: Event) => void;\n  onCreateAt: (start: Date, end: Date) => void;\n}) {\n  const positioned = layoutDay(day, events);\n  const isToday = isSameDayUTC(day, todayUTC());\n\n  function slotTime(e: React.MouseEvent<HTMLDivElement>): Date | null {\n    const rect = e.currentTarget.getBoundingClientRect();\n    const y = e.clientY - rect.top;\n    const minutes = Math.floor((y / HOUR_PX) * 60 / 30) * 30;\n    return new Date(day.getTime() + minutes * 60_000);\n  }\n\n  return (\n    <div\n      className=\"relative min-w-0 flex-1 border-l border-slate-200\"\n      onClick={(e) => {\n        if (e.target !== e.currentTarget) return;\n        const t = slotTime(e);\n        if (t) onCreateAt(t, new Date(t.getTime() + 60 * 60_000));\n      }}\n    >\n      {HOURS.map((h) => (\n        <div\n          key={h}\n          style={{ height: HOUR_PX }}\n          className=\"border-b border-slate-100\"\n        />\n      ))}\n      {positioned.map((p) => (\n        <EventBlock key={`${p.event.id}-${p.top}`} p={p} showTitleOnly={false} onSelect={onSelect} />\n      ))}\n      {isToday && <TodayIndicator />}\n    </div>\n  );\n}\n\nfunction TodayIndicator() {\n  const now = new Date();\n  const minutes = now.getUTCHours() * 60 + now.getUTCMinutes();\n  const top = (minutes / 60) * HOUR_PX;\n  return (\n    <div className=\"pointer-events-none absolute inset-x-0 z-10\" style={{ top }}>\n      <div className=\"relative\">\n        <div className=\"h-0.5 bg-red-500\" />\n        <div className=\"absolute -left-1 -top-[3px] h-2 w-2 rounded-full bg-red-500\" />\n      </div>\n    </div>\n  );\n}\n\nexport function TimeGrid({\n  days,\n  events,\n  onSelect,\n  onCreateAt,\n}: {\n  days: Date[];\n  events: Event[];\n  onSelect: (event: Event) => void;\n  onCreateAt: (start: Date, end: Date) => void;\n}) {\n  return (\n    <div className=\"flex rounded-lg border border-slate-200 bg-white shadow-sm\">\n      <div className=\"w-12 shrink-0 select-none\">\n        {HOURS.map((h) => (\n          <div\n            key={h}\n            style={{ height: HOUR_PX }}\n            className=\"relative border-b border-slate-100 pr-1 text-right\"\n          >\n            <span className=\"absolute -top-2 right-1 text-[10px] text-slate-400\">\n              {h.toString().padStart(2, \"0\")}:00\n            </span>\n          </div>\n        ))}\n      </div>\n      <div className=\"flex flex-1 overflow-x-auto\">\n        {days.map((day) => (\n          <DayColumn\n            key={day.getTime()}\n            day={startOfDay(day)}\n            events={events}\n            onSelect={onSelect}\n            onCreateAt={onCreateAt}\n          />\n        ))}\n      </div>\n    </div>\n  );\n}\n\nexport function WeekHeader({ days, label }: { days: Date[]; label: (day: Date) => string }) {\n  const isToday = todayUTC();\n  return (\n    <div className=\"mb-1 flex pl-12 pr-1\">\n      {days.map((day) => {\n        const today = isSameDayUTC(day, isToday);\n        return (\n          <div\n            key={day.getTime()}\n            className={`min-w-0 flex-1 px-1 text-center text-xs font-semibold ${\n              today ? \"text-indigo-600\" : \"text-slate-600\"\n            }`}\n          >\n            <div className=\"truncate\">{WEEKDAYS[(day.getUTCDay() + 6) % 7]}</div>\n            <div className=\"truncate font-normal text-slate-400\">{label(day)}</div>\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\nexport function weekDays(anchor: Date): Date[] {\n  const monday = startOfWeek(anchor);\n  return Array.from({ length: 7 }, (_, i) => addDays(monday, i));\n}\n","filePath":"/workspace/frontend/src/components/DayGrid.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/DayGrid.tsx","exists":false,"truncated":false},"title":"frontend/src/components/DayGrid.tsx","time":{"start":1794354117974,"end":1794354117982}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7d6fd4f001gukZUUPXkDWvF0","sessionID":"ses_e3838aa55ffed5vxBj8prk7ZU1","messageID":"msg_1c7d6836f001OTnlgZkE0k4aq4"}}
