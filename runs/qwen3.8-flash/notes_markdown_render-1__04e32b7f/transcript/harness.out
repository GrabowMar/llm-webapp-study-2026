{"type":"tool_use","timestamp":1794376482347,"sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","part":{"type":"tool","tool":"write","callID":"call_a58cf30ca0ce458dbb70dd84","state":{"status":"completed","input":{"content":"export interface NoteSummary {\n  id: number;\n  title: string;\n  published: boolean;\n  updated_at: string;\n  author: string;\n}\n\nexport interface Note extends NoteSummary {\n  body: string;\n}\n","filePath":"/workspace/frontend/src/types.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/types.ts","exists":false,"truncated":false},"title":"frontend/src/types.ts","time":{"start":1794376482308,"end":1794376482322}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c92c3dff0012nKiOGEyFCd2yb","sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","messageID":"msg_1c92bcf77001TcTiHFDIPC7xiu"}}
{"type":"tool_use","timestamp":1794376482347,"sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","part":{"type":"tool","tool":"write","callID":"call_45676fc3f7bc46079427485b","state":{"status":"completed","input":{"content":"const TOKEN_KEY = \"mdnotes.token\";\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nlet onUnauthorized: (() => void) | null = null;\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\ninterface RequestOptions {\n  method?: string;\n  body?: unknown;\n  accept?: string;\n}\n\nasync function request<T>(path: string, opts: RequestOptions = {}): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (opts.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const res = await fetch(path, {\n    method: opts.method ?? \"GET\",\n    headers,\n    body: opts.body === undefined ? undefined : JSON.stringify(opts.body),\n  });\n\n  if (res.status === 401 && token) {\n    setToken(null);\n    onUnauthorized?.();\n  }\n  if (!res.ok) {\n    let message = res.statusText;\n    try {\n      const data = await res.json();\n      if (data && typeof data.error === \"string\") message = data.error;\n    } catch {\n      /* non-JSON error body */\n    }\n    throw new ApiError(res.status, message);\n  }\n  if (res.status === 204) return undefined as T;\n  const text = await res.text();\n  if ((opts.accept ?? \"json\") === \"html\") return text as unknown as T;\n  return (text ? JSON.parse(text) : undefined) as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ token: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n    }),\n  logout: () => request<void>(\"/api/auth/logout\", { method: \"POST\" }),\n  me: () => request<{ username: string }>(\"/api/auth/me\"),\n\n  listNotes: () => request<{ items: NoteSummary[] }>(\"/api/notes\"),\n  getNote: (id: number) => request<Note>(`/api/notes/${id}`),\n  createNote: (body: { title?: string; body?: string }) =>\n    request<Note>(\"/api/notes\", { method: \"POST\", body }),\n  updateNote: (\n    id: number,\n    patch: { title?: string; body?: string; published?: boolean },\n  ) => request<Note>(`/api/notes/${id}`, { method: \"PATCH\", body: patch }),\n  deleteNote: (id: number) => request<void>(`/api/notes/${id}`, { method: \"DELETE\" }),\n\n  renderHtml: (body: string) =>\n    request<string>(\"/api/render\", { method: \"POST\", body: { body }, accept: \"html\" }),\n  noteHtml: (id: number) =>\n    request<string>(`/api/notes/${id}/html`, { accept: \"html\" }),\n  publicNote: (id: number) => request<NoteSummary>(`/api/public/notes/${id}`),\n  publicNoteHtml: (id: number) =>\n    request<string>(`/api/public/notes/${id}/html`, { accept: \"html\" }),\n};\n\nexport function publicUrl(id: number): string {\n  return `${window.location.origin}/public/${id}`;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794376482315,"end":1794376482327}},"id":"prt_1c92c3e06001IA7yqLPsncawWG","sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","messageID":"msg_1c92bcf77001TcTiHFDIPC7xiu"}}
