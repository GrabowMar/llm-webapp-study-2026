{"type":"tool_use","timestamp":1794376539649,"sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","part":{"type":"tool","tool":"write","callID":"call_3b9890843e134d73b1beb52d","state":{"status":"completed","input":{"content":"import { useEffect, useRef, useState } from \"react\";\nimport { api, publicUrl } from \"../api\";\nimport type { Note } from \"../types\";\n\nexport default function NoteEditor({\n  note,\n  onChange,\n  onDelete,\n}: {\n  note: Note | null;\n  onChange: (note: Note) => void;\n  onDelete: (id: number) => void;\n}) {\n  const [title, setTitle] = useState(\"\");\n  const [body, setBody] = useState(\"\");\n  const [published, setPublished] = useState(false);\n  const [preview, setPreview] = useState(\"\");\n  const [saving, setSaving] = useState<\"idle\" | \"saving\" | \"saved\">(\"idle\");\n  const [copyState, setCopyState] = useState<\"idle\" | \"copied\">(\"idle\");\n\n  const noteIdRef = useRef<number | null>(null);\n  const draftRef = useRef({ title: \"\", body: \"\", published: false });\n  const previewTimer = useRef<number | null>(null);\n  const saveTimer = useRef<number | null>(null);\n\n  useEffect(() => {\n    // switching notes: adopt the incoming note (or a blank draft)\n    const id = note?.id ?? null;\n    noteIdRef.current = id;\n    const next = note\n      ? { title: note.title, body: note.body, published: note.published }\n      : { title: \"\", body: \"\", published: false };\n    draftRef.current = next;\n    setTitle(next.title);\n    setBody(next.body);\n    setPublished(next.published);\n    if (note) refreshPreview(note.body);\n    else setPreview(\"\");\n  }, [note?.id]);\n\n  function refreshPreview(text: string) {\n    if (previewTimer.current) window.clearTimeout(previewTimer.current);\n    previewTimer.current = window.setTimeout(async () => {\n      try {\n        setPreview(await api.renderHtml(text));\n      } catch {\n        /* keep last preview on error */\n      }\n    }, 250);\n  }\n\n  function scheduleSave() {\n    if (saveTimer.current) window.clearTimeout(saveTimer.current);\n    setSaving(\"saving\");\n    saveTimer.current = window.setTimeout(persist, 500);\n  }\n\n  async function persist() {\n    const { title: t, body: b, published: p } = draftRef.current;\n    try {\n      const id = noteIdRef.current;\n      const saved =\n        id === null\n          ? await api.createNote({ title: t, body: b })\n          : await api.updateNote(id, { title: t, body: b, published: p });\n      if (id === null && saved.published !== p) {\n        const again = await api.updateNote(saved.id, { published: p });\n        noteIdRef.current = again.id;\n        onChange(again);\n      } else {\n        noteIdRef.current = saved.id;\n        onChange(saved);\n      }\n      setSaving(\"saved\");\n    } catch {\n      setSaving(\"idle\");\n    }\n  }\n\n  function editTitle(value: string) {\n    draftRef.current = { ...draftRef.current, title: value };\n    setTitle(value);\n    scheduleSave();\n  }\n\n  function editBody(value: string) {\n    draftRef.current = { ...draftRef.current, body: value };\n    setBody(value);\n    refreshPreview(value);\n    scheduleSave();\n  }\n\n  async function togglePublished(value: boolean) {\n    draftRef.current = { ...draftRef.current, published: value };\n    setPublished(value);\n    const id = noteIdRef.current;\n    if (id === null) {\n      await persist();\n      return;\n    }\n    setSaving(\"saving\");\n    try {\n      const saved = await api.updateNote(id, { ...draftRef.current });\n      onChange(saved);\n      setSaving(\"saved\");\n    } catch {\n      setSaving(\"idle\");\n    }\n  }\n\n  async function copyLink() {\n    const id = noteIdRef.current;\n    if (id === null) return;\n    try {\n      await navigator.clipboard.writeText(publicUrl(id));\n      setCopyState(\"copied\");\n      window.setTimeout(() => setCopyState(\"idle\"), 1500);\n    } catch {\n      /* clipboard unavailable */\n    }\n  }\n\n  if (note === null && noteIdRef.current === null && title === \"\" && body === \"\") {\n    // empty editor for a brand-new note\n  }\n\n  const link =\n    noteIdRef.current !== null && published ? publicUrl(noteIdRef.current) : null;\n\n  return (\n    <div className=\"flex h-full min-h-0 flex-col\">\n      <div className=\"flex flex-wrap items-center gap-3 border-b border-slate-200 px-4 py-3\">\n        <input\n          value={title}\n          onChange={(e) => editTitle(e.target.value)}\n          placeholder=\"Untitled\"\n          className=\"min-w-40 flex-1 rounded-lg border border-transparent bg-transparent px-2 py-1 text-lg font-semibold text-slate-900 outline-none hover:border-slate-200 focus:border-indigo-400\"\n        />\n        <span className=\"text-xs text-slate-400\">\n          {saving === \"saving\" ? \"Saving…\" : saving === \"saved\" ? \"Saved\" : \"\"}\n        </span>\n        <label className=\"flex cursor-pointer items-center gap-2 text-sm text-slate-600\">\n          <span>Published</span>\n          <button\n            type=\"button\"\n            role=\"switch\"\n            aria-checked={published}\n            onClick={() => togglePublished(!published)}\n            className={`relative h-6 w-11 rounded-full transition-colors ${\n              published ? \"bg-emerald-500\" : \"bg-slate-300\"\n            }`}\n          >\n            <span\n              className={`absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform ${\n                published ? \"translate-x-5.5\" : \"translate-x-0.5\"\n              }`}\n            />\n          </button>\n        </label>\n        <button\n          onClick={() => {\n            const id = noteIdRef.current;\n            if (id !== null) onDelete(id);\n          }}\n          disabled={noteIdRef.current === null}\n          className=\"rounded-lg border border-red-200 px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 disabled:opacity-40\"\n        >\n          Delete\n        </button>\n      </div>\n\n      {published && link && (\n        <div className=\"flex items-center gap-2 border-b border-slate-200 bg-emerald-50 px-4 py-2 text-sm\">\n          <span className=\"font-medium text-emerald-800\">Public link:</span>\n          <code className=\"flex-1 truncate rounded bg-white px-2 py-1 text-xs text-emerald-900\">\n            {link}\n          </code>\n          <button\n            onClick={copyLink}\n            className=\"rounded-lg bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-emerald-700\"\n          >\n            {copyState === \"copied\" ? \"Copied!\" : \"Copy\"}\n          </button>\n        </div>\n      )}\n\n      <div className=\"grid min-h-0 flex-1 grid-cols-1 divide-slate-200 lg:grid-cols-2 lg:divide-x\">\n        <textarea\n          value={body}\n          onChange={(e) => editBody(e.target.value)}\n          placeholder=\"# Start writing in Markdown…\"\n          spellCheck={false}\n          className=\"min-h-56 w-full resize-none bg-white p-4 font-mono text-sm text-slate-800 outline-none\"\n        />\n        <div className=\"min-h-56 overflow-y-auto bg-slate-50 p-4\">\n          <div className=\"mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400\">\n            Preview\n          </div>\n          {preview ? (\n            <article\n              className=\"prose prose-sm max-w-none text-slate-800\"\n              dangerouslySetInnerHTML={{ __html: preview }}\n            />\n          ) : (\n            <p className=\"text-sm text-slate-400\">Nothing to preview yet.</p>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/NoteEditor.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/NoteEditor.tsx","exists":false,"truncated":false},"title":"frontend/src/components/NoteEditor.tsx","time":{"start":1794376539617,"end":1794376539627}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c92d1ddb001jxrAtGj5A8Ga9d","sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","messageID":"msg_1c92cc336001NHk026EPkB6kjD"}}
