{"type":"text","timestamp":1794376154972,"sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","part":{"id":"prt_1c9273f46001rOhDUXabwzNJgF","messageID":"msg_1c9240b9d001fK23GpPjm4wGOL","sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","type":"text","text":"Environment looks good. Now writing the backend.\n\n","time":{"start":1794376154950,"end":1794376154968}}}
{"type":"tool_use","timestamp":1794376155035,"sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","part":{"type":"tool","tool":"write","callID":"call_a20e01c1cf9a408aa9cdbbf5","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the Markdown notes app.\"\"\"\n\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nimport markdown as md\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"notes.db\"\n\nMARKDOWN_EXTENSIONS = [\"extra\", \"sane_lists\", \"nl2br\"]\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 2 * 1024 * 1024\n\n\n# --------------------------------------------------------------------------- db\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc=None):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db():\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id            INTEGER PRIMARY KEY AUTOINCREMENT,\n            username      TEXT    NOT NULL UNIQUE COLLATE NOCASE,\n            password_hash TEXT    NOT NULL,\n            created_at    TEXT    NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS auth_tokens (\n            token      TEXT    PRIMARY KEY,\n            user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT    NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS notes (\n            id         INTEGER PRIMARY KEY AUTOINCREMENT,\n            user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            title      TEXT    NOT NULL DEFAULT '',\n            body       TEXT    NOT NULL DEFAULT '',\n            published  INTEGER NOT NULL DEFAULT 0,\n            created_at TEXT    NOT NULL,\n            updated_at TEXT    NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_notes_user_updated\n            ON notes (user_id, updated_at DESC);\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ninit_db()\n\n\n# ----------------------------------------------------------------- auth helpers\n\n\ndef json_error(message: str, status: int) -> Response:\n    return jsonify({\"error\": message}), status\n\n\ndef body_json() -> dict:\n    if not request.is_json:\n        return {}\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    row = get_db().execute(\n        \"SELECT u.* FROM auth_tokens t JOIN users u ON u.id = t.user_id \"\n        \"WHERE t.token = ?\",\n        (token.strip(),),\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return json_error(\"authentication required\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO auth_tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, now_iso()),\n    )\n    db.commit()\n    return token\n\n\n# ------------------------------------------------------------------ serialising\n\n\nNOTE_SELECT = (\n    \"SELECT n.id, n.title, n.body, n.published, n.created_at, n.updated_at, \"\n    \"u.username AS author FROM notes n JOIN users u ON u.id = n.user_id \"\n)\n\n\ndef note_fields(row, with_body: bool) -> dict:\n    data = {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"published\": bool(row[\"published\"]),\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n    }\n    if with_body:\n        data[\"body\"] = row[\"body\"]\n    return data\n\n\ndef get_owned_note(note_id: int):\n    row = get_db().execute(\n        NOTE_SELECT + \"WHERE n.id = ? AND n.user_id = ?\",\n        (note_id, g.user[\"id\"]),\n    ).fetchone()\n    return row\n\n\ndef render_markdown(text: str) -> str:\n    return md.markdown(text or \"\", extensions=MARKDOWN_EXTENSIONS)\n\n\ndef html_fragment(text: str) -> Response:\n    return Response(render_markdown(text), content_type=\"text/html; charset=utf-8\")\n\n\n# ------------------------------------------------------------------- auth routes\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body_json()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not (username := username.strip()):\n        return json_error(\"username is required\", 400)\n    if len(username) > 64:\n        return json_error(\"username is too long\", 400)\n    if not isinstance(password, str) or not password:\n        return json_error(\"password is required\", 400)\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return json_error(\"username already taken\", 409)\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": issue_token(cur.lastrowid)}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body_json()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return json_error(\"invalid username or password\", 401)\n    return jsonify({\"token\": issue_token(row[\"id\"])}), 200\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    _, _, token = header.partition(\" \")\n    db = get_db()\n    db.execute(\"DELETE FROM auth_tokens WHERE token = ?\", (token.strip(),))\n    db.commit()\n    return jsonify({\"ok\": True}), 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return jsonify({\"username\": g.user[\"username\"]}), 200\n\n\n# ------------------------------------------------------------------ note routes\n\n\n@app.get(\"/api/notes\")\n@login_required\ndef list_notes():\n    rows = get_db().execute(\n        NOTE_SELECT + \"WHERE n.user_id = ? ORDER BY n.updated_at DESC, n.id DESC\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [note_fields(r, with_body=False) for r in rows]}), 200\n\n\n@app.post(\"/api/notes\")\n@login_required\ndef create_note():\n    data = body_json()\n    title = data.get(\"title\", \"\")\n    body = data.get(\"body\", \"\")\n    published = bool(data.get(\"published\", False))\n    if not isinstance(title, str) or not isinstance(body, str):\n        return json_error(\"title and body must be strings\", 400)\n    stamp = now_iso()\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notes (user_id, title, body, published, created_at, updated_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?)\",\n        (g.user[\"id\"], title, body, int(published), stamp, stamp),\n    )\n    db.commit()\n    row = get_db().execute(NOTE_SELECT + \"WHERE n.id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(note_fields(row, with_body=True)), 201\n\n\ndef get_note_or_404(note_id: int):\n    row = get_owned_note(note_id)\n    if row is None:\n        return json_error(\"note not found\", 404)\n    return row\n\n\n@app.get(\"/api/notes/<int:note_id>\")\n@login_required\ndef get_note(note_id: int):\n    row = get_note_or_404(note_id)\n    if isinstance(row, Response):\n        return row\n    return jsonify(note_fields(row, with_body=True)), 200\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\n@login_required\ndef update_note(note_id: int):\n    row = get_note_or_404(note_id)\n    if isinstance(row, Response):\n        return row\n    data = body_json()\n    title = row[\"title\"]\n    body = row[\"body\"]\n    published = bool(row[\"published\"])\n    if \"title\" in data:\n        if not isinstance(data[\"title\"], str):\n            return json_error(\"title must be a string\", 400)\n        title = data[\"title\"]\n    if \"body\" in data:\n        if not isinstance(data[\"body\"], str):\n            return json_error(\"body must be a string\", 400)\n        body = data[\"body\"]\n    if \"published\" in data:\n        published = bool(data[\"published\"])\n    db = get_db()\n    db.execute(\n        \"UPDATE notes SET title = ?, body = ?, published = ?, updated_at = ? \"\n        \"WHERE id = ?\",\n        (title, body, int(published), now_iso(), note_id),\n    )\n    db.commit()\n    row = get_db().execute(NOTE_SELECT + \"WHERE n.id = ?\", (note_id,)).fetchone()\n    return jsonify(note_fields(row, with_body=True)), 200\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\n@login_required\ndef delete_note(note_id: int):\n    row = get_note_or_404(note_id)\n    if isinstance(row, Response):\n        return row\n    db = get_db()\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (note_id,))\n    db.commit()\n    return Response(status=204)\n\n\n@app.get(\"/api/notes/<int:note_id>/html\")\n@login_required\ndef note_html(note_id: int):\n    row = get_note_or_404(note_id)\n    if isinstance(row, Response):\n        return row\n    return html_fragment(row[\"body\"])\n\n\n@app.post(\"/api/render\")\n@login_required\ndef render_preview():\n    data = body_json()\n    body = data.get(\"body\", \"\")\n    if not isinstance(body, str):\n        return json_error(\"body must be a string\", 400)\n    return html_fragment(body)\n\n\n# ---------------------------------------------------------------- public routes\n\n\ndef get_published_note(note_id: int):\n    row = get_db().execute(\n        NOTE_SELECT + \"WHERE n.id = ? AND n.published = 1\", (note_id,)\n    ).fetchone()\n    if row is None:\n        return json_error(\"note not found\", 404)\n    return row\n\n\n@app.get(\"/api/public/notes/<int:note_id>\")\ndef public_note(note_id: int):\n    row = get_published_note(note_id)\n    if isinstance(row, Response):\n        return row\n    return jsonify(note_fields(row, with_body=False)), 200\n\n\n@app.get(\"/api/public/notes/<int:note_id>/html\")\ndef public_note_html(note_id: int):\n    row = get_published_note(note_id)\n    if isinstance(row, Response):\n        return row\n    return html_fragment(row[\"body\"])\n\n\n# ------------------------------------------------------------------- misc / spa\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return json_error(\"not found\", 404)\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000, debug=True)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794376154963,"end":1794376154986}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9273f4a001PqFSTl31sOi7tv","sessionID":"ses_e36de0481ffeotF4fqf3lBvT43","messageID":"msg_1c9240b9d001fK23GpPjm4wGOL"}}
