loaded by{\" \"}\n-    {image.uploader}\n+    {image.filename} · {formatBytes(image.size_bytes)} · uploaded by {image.uploader}\n   </p>\n </div>\n <button\n   type=\"button\"\n","additions":1,"deletions":2},"truncated":false},"title":"frontend/src/components/Lightbox.tsx","time":{"start":1794341182063,"end":1794341182083}},"id":"prt_1c7119a6a0011hqqN9PYQvqSk6","sessionID":"ses_e38f68d64ffePY30olDTJzj46C","messageID":"msg_1c7117d77001dOgW4CKAau24q2"}}
