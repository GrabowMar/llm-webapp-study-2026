{"type":"tool_use","timestamp":1794341174652,"sessionID":"ses_e38f68d64ffePY30olDTJzj46C","part":{"type":"tool","tool":"write","callID":"call_a6064ecfc99a4cefaa2f5552","state":{"status":"completed","input":{"content":"import type { Image } from \"../api\";\n\ninterface Props {\n  image: Image;\n  onClose: () => void;\n  onDelete: (id: number) => Promise<void>;\n  canDelete: boolean;\n}\n\nexport default function Lightbox({ image, onClose, onDelete, canDelete }: Props) {\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label={image.title ?? image.filename}\n      onClick={onClose}\n    >\n      <div\n        className=\"flex max-h-full w-full max-w-4xl flex-col overflow-hidden rounded-xl bg-white shadow-2xl\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <div className=\"flex items-start justify-between gap-4 border-b border-slate-100 px-5 py-4\">\n          <div className=\"min-w-0\">\n            {image.title && (\n              <h3 className=\"truncate text-lg font-semibold text-slate-800\">{image.title}</h3>\n            )}\n            <p className=\"truncate text-sm text-slate-500\">\n              {image.filename} · {(image.size_bytes / 1024).toFixed(1)} KB · uploaded by{\" \"}\n              {image.uploader}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Close\"\n            className=\"shrink-0 rounded-full p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600\"\n          >\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n              strokeLinecap=\"round\"\n              className=\"h-5 w-5\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M6 6l12 12M18 6L6 18\" />\n            </svg>\n          </button>\n        </div>\n        <div className=\"flex-1 overflow-auto bg-slate-900/5 p-4\">\n          <img\n            src={image.url}\n            alt={image.title ?? image.filename}\n            className=\"mx-auto max-h-[70vh] max-w-full rounded object-contain\"\n          />\n        </div>\n        {canDelete && (\n          <div className=\"flex justify-end border-t border-slate-100 px-5 py-3\">\n            <DeleteButton\n              onDelete={async () => {\n                await onDelete(image.id);\n                onClose();\n              }}\n              label={image.title ?? image.filename}\n            />\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n\nexport function DeleteButton({\n  onDelete,\n  label,\n}: {\n  onDelete: () => Promise<void>;\n  label: string;\n}) {\n  return (\n    <button\n      type=\"button\"\n      onClick={() => {\n        if (window.confirm(`Delete “${label}”? This cannot be undone.`)) {\n          void onDelete();\n        }\n      }}\n      className=\"rounded-lg border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50\"\n    >\n      Delete\n    </button>\n  );\n}\n","filePath":"/workspace/frontend/src/components/Lightbox.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Lightbox.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Lightbox.tsx","time":{"start":1794341174627,"end":1794341174634}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7117d5e0012OF15elB4Sc71r","sessionID":"ses_e38f68d64ffePY30olDTJzj46C","messageID":"msg_1c71146c4001NEmADBmPBTIpgE"}}
