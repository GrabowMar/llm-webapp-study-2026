ame\": \"bob\", \"password\": \"pw456\"})\ntok_b = r.json[\"token\"]\n\nHA = {\"Authorization\": f\"Bearer {tok_a}\"}\nHB = {\"Authorization\": f\"Bearer {tok_b}\"}\n\n# upload requires auth\npng_b64 = base64.b64encode(png_bytes()).decode()\njpeg_b64 = base64.b64encode(jpeg_bytes()).decode()\nr = client.post(\"/api/images\", json={\"filename\": \"a.png\", \"data\": png_b64})\nassert r.status_code == 401\n\n# upload png\nr = client.post(\"/api/images\", headers=HA, json={\"filename\": \"a.png\", \"data\": png_b64, \"title\": \"First\"})\nassert r.status_code == 201, r.json\nimg1 = r.json\nfor k in (\"id\",\"filename\",\"title\",\"content_type\",\"size_bytes\",\"uploaded_at\",\"url\",\"uploader\"):\n    assert k in img1, k\nassert img1[\"content_type\"] == \"image/png\" and img1[\"uploader\"] == \"alice\"\nassert img1[\"url\"] == f\"/api/images/{img1['id']}/file\"\nassert img1[\"size_bytes\"] == len(png_bytes())\n\n# same filename twice -> separate images\nr = client.post(\"/api/images\", headers=HA, json={\"filename\": \"a.png\", \"data\": jpeg_b64})\nassert r.status_code == 201\nimg2 = r.json\nassert img2[\"id\"] != img1[\"id\"] and img2[\"content_type\"] == \"image/jpeg\"\nassert img2[\"title\"] is None\n\n# format from content, not name\nr = client.post(\"/api/images\", headers=HA, json={\"filename\": \"fake.gif\", \"data\": png_b64})\nassert r.status_code == 201 and r.json[\"content_type\"] == \"image/png\"\n\n# invalid content\nr = client.post(\"/api/images\", headers=HA, json={\"filename\": \"x.png\", \"data\": base64.b64encode(b\"hello world\").decode()})\nassert r.status_code == 400, r.json\nr = client.post(\"/api/images\", headers=HA, json={\"filename\": \"x.png\", \"data\": \"not-base64!!!\"})\nassert r.status_code == 400\n\n# bad base64 with png magic but invalid\nr = client.post(\"/api/images\", headers=HA, json={\"filename\": \"x.png\"})\nassert r.status_code == 400\n\n# file endpoint\nr = client.get(img1[\"url\"])\nassert r.status_code == 200 and r.data == png_bytes()\nassert r.content_type == \"image/png\"\n\n# GET one\nr = client.get(f\"/api/images/{img1['id']}\")\nassert r.status_code == 200 and r.json[\"filename\"] == \"a.png\"\nr = client.get(\"/api/images/999999\")\nassert r.status_code == 404\n\n# listing newest first + paging\nr = client.get(\"/api/images\")\nassert r.status_code == 200\nlst = r.json\nassert set(lst.keys()) == {\"items\",\"total\",\"page\",\"page_size\"}\nassert lst[\"total\"] == 4\nids = [i[\"id\"] for i in lst[\"items\"]]\nassert ids == sorted(ids, reverse=True), ids\nr = client.get(\"/api/images?page=2&page_size=2\")\nassert len(r.json[\"items\"]) == 2 and r.json[\"page\"] == 2 and r.json[\"page_size\"] == 2\nr = client.get(\"/api/images?page=0\")\nassert r.status_code == 400\nr = client.get(\"/api/images?page=abc\")\nassert r.status_code == 400\n\n# delete permissions\nr = client.delete(f\"/api/images/{img1['id']}\", headers=HB)\nassert r.status_code == 403\nr = client.delete(f\"/api/images/{img1['id']}\")\nassert r.status_code == 401\nr = client.delete(f\"/api/images/{img1['id']}\", headers=HA)\nassert r.status_code == 200\nr = client.get(f\"/api/images/{img1['id']}\")\nassert r.status_code == 404\nr = client.get(f\"/api/images/{img1['id']}/file\")\nassert r.status_code == 404\nassert not os.path.exists(img1_file := os.path.join(\"/tmp/gallery_data/uploads\", str(img1[\"id\"])))\n\n# invalid token\nr = client.post(\"/api/images\", headers={\"Authorization\": \"Bearer nonsense\"}, json={\"filename\": \"a.png\", \"data\": png_b64})\nassert r.status_code == 401\n\n# persistence across app restart: re-import with same DATA_DIR\nimport importlib\nimportlib.reload(appmod)\nc2 = appmod.app.test_client()\nr = c2.get(\"/api/images\")\nassert r.json[\"total\"] == 3, r.json\nr = c2.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"pw123\"})\nassert r.status_code == 200\n\n# frontend fallback\nr = c2.get(\"/\")  # dist may not exist yet; skip if missing\nprint(\"ALL API TES