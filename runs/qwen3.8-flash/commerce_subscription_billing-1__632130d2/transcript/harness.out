{"type":"tool_use","timestamp":1794325100855,"sessionID":"ses_e39e9359effeWA5cX0gsHGHelx","part":{"type":"tool","tool":"read","callID":"call_42cddebfcc48434b9c4c7eeb","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","offset":400},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n400: \n401: \n402: @app.get(\"/api/subscriptions/<subscription_id>/invoices\")\n403: @require_auth\n404: def list_invoices(subscription_id):\n405:     db = get_db()\n406:     row, err = get_subscription_or_404(db, subscription_id)\n407:     if err:\n408:         return err\n409:     rows = db.execute(\n410:         \"SELECT * FROM invoices WHERE subscription_id = ? ORDER BY id DESC\",\n411:         (row[\"id\"],),\n412:     ).fetchall()\n413:     return jsonify({\"items\": [invoice_row_to_dict(r) for r in rows]})\n414: \n415: \n416: @app.post(\"/api/subscriptions/<subscription_id>/invoices\")\n417: @require_auth\n418: def create_invoice(subscription_id):\n419:     db = get_db()\n420:     row, err = get_subscription_or_404(db, subscription_id)\n421:     if err:\n422:         return err\n423:     data = request.get_json(silent=True) or {}\n424:     unknown = set(data) - {\"amount_due\", \"due_date\"}\n425:     if unknown:\n426:         return error(f\"unknown fields: {', '.join(sorted(unknown))}\")\n427:     amount = row[\"monthly_amount\"]\n428:     if \"amount_due\" in data:\n429:         try:\n430:             amount = money(data[\"amount_due\"])\n431:         except (TypeError, ValueError):\n432:             return error(\"amount_due must be a number\")\n433:         if amount < 0:\n434:             return error(\"amount_due must not be negative\")\n435:     due_date = row[\"renewal_date\"]\n436:     if \"due_date\" in data:\n437:         value = str(data[\"due_date\"] or \"\").strip()\n438:         if not DATE_RE.match(value):\n439:             return error(\"due_date must be YYYY-MM-DD\")\n440:         due_date = value\n441:     cur = db.execute(\n442:         \"INSERT INTO invoices (subscription_id, amount_due, due_date, status, paid_at) \"\n443:         \"VALUES (?, ?, ?, 'open', NULL)\",\n444:         (row[\"id\"], amount, due_date),\n445:     )\n446:     db.commit()\n447:     inv = db.execute(\"SELECT * FROM invoices WHERE id = ?\", (cur.lastrowid,)).fetchone()\n448:     return jsonify(invoice_row_to_dict(inv)), 201\n449: \n450: \n451: @app.post(\"/api/subscriptions/<subscription_id>/collections\")\n452: @require_auth\n453: def record_collection(subscription_id):\n454:     db = get_db()\n455:     row, err = get_subscription_or_404(db, subscription_id)\n456:     if err:\n457:         return err\n458:     data = request.get_json(silent=True) or {}\n459:     outcome = str(data.get(\"outcome\") or \"\").strip()\n460:     if outcome not in (\"failed\", \"succeeded\"):\n461:         return error(\"outcome must be 'failed' or 'succeeded'\")\n462:     open_invoices = db.execute(\n463:         \"SELECT id FROM invoices WHERE subscription_id = ? AND status = 'open'\",\n464:         (row[\"id\"],),\n465:     ).fetchall()\n466:     if outcome == \"succeeded\":\n467:         stamp = now_iso()\n468:         for inv in open_invoices:\n469:             db.execute(\n470:                 \"UPDATE invoices SET status = 'paid', paid_at = ? WHERE id = ?\",\n471:                 (stamp, inv[\"id\"]),\n472:             )\n473:         db.execute(\n474:             \"UPDATE subscriptions SET failed_payment_count = 0, \"\n475:             \"status = CASE WHEN status = 'past_due' THEN 'active' ELSE status END \"\n476:             \"WHERE id = ?\",\n477:             (row[\"id\"],),\n478:         )\n479:     else:\n480:         db.execute(\n481:             \"UPDATE subscriptions SET failed_payment_count = failed_payment_count + 1, \"\n482:             \"status = CASE WHEN status = 'active' THEN 'past_due' ELSE status END \"\n483:             \"WHERE id = ?\",\n484:             (row[\"id\"],),\n485:         )\n486:     db.commit()\n487:     row = db.execute(\"SELECT * FROM subscriptions WHERE id = ?\", (row[\"id\"],)).fetchone()\n488:     count = db.execute(\n489:         \"SELECT COUNT(*) FROM invoices WHERE subscription_id = ? AND status = 'open'\",\n490:         (row[\"id\"],),\n491:     ).fetchone()[0]\n492:     return jsonify(\n493:         {\n494:             \"outcome\": outcome,\n495:             \"processed_invoices\": len(open_invoices),\n496:             \"open_invoices\": count,\n497:             \"subscription\": subscription_row_to_dict(row),\n498:         }\n499:     ), 201\n500: \n501: \n502: # ------------------------------------------------------------------ stats\n503: \n504: \n505: @app.get(\"/api/public/stats\")\n506: def public_stats():\n507:     db = get_db()\n508:     mrr = db.execute(\n509:         \"SELECT COALESCE(SUM(monthly_amount), 0) FROM subscriptions \"\n510:         \"WHERE status IN ('active', 'past_due')\"\n511:     ).fetchone()[0]\n512:     counts = {status: 0 for status in STATUSES}\n513:     for row in db.execute(\n514:         \"SELECT status, COUNT(*) AS n FROM subscriptions GROUP BY status\"\n515:     ):\n516:         counts[row[\"status\"]] = row[\"n\"]\n517:     return jsonify({\"mrr\": money(mrr), \"counts\": counts})\n518: \n519: \n520: # --------------------------------------------------------------- frontend\n521: \n522: \n523: @app.get(\"/\")\n524: @app.get(\"/<path:path>\")\n525: def frontend(path: str = \"index.html\"):\n526:     if path.startswith(\"api/\"):\n527:         return error(\"not found\", 404)\n528:     if DIST.is_dir() and (DIST / path).is_file():\n529:         return send_from_directory(DIST, path)\n530:     return send_from_directory(DIST, \"index.html\")\n531: \n532: \n533: init_db()\n534: \n535: \n536: if __name__ == \"__main__\":\n537:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)), debug=True)\n\n(End of file - total 537 lines)\n</content>","metadata":{"preview":"\n\n@app.get(\"/api/subscriptions/<subscription_id>/invoices\")\n@require_auth\ndef list_invoices(subscription_id):\n    db = get_db()\n    row, err = get_subscription_or_404(db, subscription_id)\n    if err:\n        return err\n    rows = db.execute(\n        \"SELECT * FROM invoices WHERE subscription_id = ? ORDER BY id DESC\",\n        (row[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [invoice_row_to_dict(r) for r in rows]})\n\n\n@app.post(\"/api/subscriptions/<subscription_id>/invoices\")\n@require_auth\ndef create_invoice(subscription_id):\n    db = get_db()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\n\n@app.get(\"/api/subscriptions/<subscription_id>/invoices\")\n@require_auth\ndef list_invoices(subscription_id):\n    db = get_db()\n    row, err = get_subscription_or_404(db, subscription_id)\n    if err:\n        return err\n    rows = db.execute(\n        \"SELECT * FROM invoices WHERE subscription_id = ? ORDER BY id DESC\",\n        (row[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [invoice_row_to_dict(r) for r in rows]})\n\n\n@app.post(\"/api/subscriptions/<subscription_id>/invoices\")\n@require_auth\ndef create_invoice(subscription_id):\n    db = get_db()\n    row, err = get_subscription_or_404(db, subscription_id)\n    if err:\n        return err\n    data = request.get_json(silent=True) or {}\n    unknown = set(data) - {\"amount_due\", \"due_date\"}\n    if unknown:\n        return error(f\"unknown fields: {', '.join(sorted(unknown))}\")\n    amount = row[\"monthly_amount\"]\n    if \"amount_due\" in data:\n        try:\n            amount = money(data[\"amount_due\"])\n        except (TypeError, ValueError):\n            return error(\"amount_due must be a number\")\n        if amount < 0:\n            return error(\"amount_due must not be negative\")\n    due_date = row[\"renewal_date\"]\n    if \"due_date\" in data:\n        value = str(data[\"due_date\"] or \"\").strip()\n        if not DATE_RE.match(value):\n            return error(\"due_date must be YYYY-MM-DD\")\n        due_date = value\n    cur = db.execute(\n        \"INSERT INTO invoices (subscription_id, amount_due, due_date, status, paid_at) \"\n        \"VALUES (?, ?, ?, 'open', NULL)\",\n        (row[\"id\"], amount, due_date),\n    )\n    db.commit()\n    inv = db.execute(\"SELECT * FROM invoices WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(invoice_row_to_dict(inv)), 201\n\n\n@app.post(\"/api/subscriptions/<subscription_id>/collections\")\n@require_auth\ndef record_collection(subscription_id):\n    db = get_db()\n    row, err = get_subscription_or_404(db, subscription_id)\n    if err:\n        return err\n    data = request.get_json(silent=True) or {}\n    outcome = str(data.get(\"outcome\") or \"\").strip()\n    if outcome not in (\"failed\", \"succeeded\"):\n        return error(\"outcome must be 'failed' or 'succeeded'\")\n    open_invoices = db.execute(\n        \"SELECT id FROM invoices WHERE subscription_id = ? AND status = 'open'\",\n        (row[\"id\"],),\n    ).fetchall()\n    if outcome == \"succeeded\":\n        stamp = now_iso()\n        for inv in open_invoices:\n            db.execute(\n                \"UPDATE invoices SET status = 'paid', paid_at = ? WHERE id = ?\",\n                (stamp, inv[\"id\"]),\n            )\n        db.execute(\n            \"UPDATE subscriptions SET failed_payment_count = 0, \"\n            \"status = CASE WHEN status = 'past_due' THEN 'active' ELSE status END \"\n            \"WHERE id = ?\",\n            (row[\"id\"],),\n        )\n    else:\n        db.execute(\n            \"UPDATE subscriptions SET failed_payment_count = failed_payment_count + 1, \"\n            \"status = CASE WHEN status = 'active' THEN 'past_due' ELSE status END \"\n            \"WHERE id = ?\",\n            (row[\"id\"],),\n        )\n    db.commit()\n    row = db.execute(\"SELECT * FROM subscriptions WHERE id = ?\", (row[\"id\"],)).fetchone()\n    count = db.execute(\n        \"SELECT COUNT(*) FROM invoices WHERE subscription_id = ? AND status = 'open'\",\n        (row[\"id\"],),\n    ).fetchone()[0]\n    return jsonify(\n        {\n            \"outcome\": outcome,\n            \"processed_invoices\": len(open_invoices),\n            \"open_invoices\": count,\n            \"subscription\": subscription_row_to_dict(row),\n        }\n    ), 201\n\n\n# ------------------------------------------------------------------ stats\n\n\n@app.get(\"/api/public/stats\")\ndef public_stats():\n    db = get_db()\n    mrr = db.execute(\n        \"SELECT COALESCE(SUM(monthly_amount), 0) FROM subscriptions \"\n        \"WHERE status IN ('active', 'past_due')\"\n    ).fetchone()[0]\n    counts = {status: 0 for status in STATUSES}\n    for row in db.execute(\n        \"SELECT status, COUNT(*) AS n FROM subscriptions GROUP BY status\"\n    ):\n        counts[row[\"status\"]] = row[\"n\"]\n    return jsonify({\"mrr\": money(mrr), \"counts\": counts})\n\n\n# --------------------------------------------------------------- frontend\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if DIST.is_dir() and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)), debug=True)","lineStart":400,"lineEnd":537,"totalLines":537,"truncated":false}},"title":"backend/app.py","time":{"start":1794325100824,"end":1794325100839}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61c3912001L4JWLfF6tmBiMP","sessionID":"ses_e39e9359effeWA5cX0gsHGHelx","messageID":"msg_1c61c2f35001YtZrwKSXg6WPtO"}}
