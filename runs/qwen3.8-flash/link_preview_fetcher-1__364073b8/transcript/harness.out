{"type":"step_start","timestamp":1794364373216,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"id":"prt_1c87378d4001X3XPQTKZnuEyNj","messageID":"msg_1c87336dc001jPpVBDDoRhm6fQ","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","type":"step-start"}}
{"type":"tool_use","timestamp":1794364373236,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"type":"tool","tool":"write","callID":"call_47a5e1b771f94a5fa346943c","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, getToken } from \"./api\";\nimport type { Preview } from \"./types\";\nimport Header from \"./components/Header\";\nimport AddBar from \"./components/AddBar\";\nimport PreviewCard from \"./components/PreviewCard\";\nimport Pager from \"./components/Pager\";\n\nconst PAGE_SIZE = 10;\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(\n    getToken() ? localStorage.getItem(\"lp.username\") : null,\n  );\n  const [items, setItems] = useState<Preview[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [loading, setLoading] = useState(false);\n  const [adding, setAdding] = useState(false);\n  const [addError, setAddError] = useState<string | null>(null);\n  const [listError, setListError] = useState<string | null>(null);\n  const [busyId, setBusyId] = useState<number | null>(null);\n\n  const load = useCallback(async (p: number) => {\n    setLoading(true);\n    setListError(null);\n    try {\n      const data = await api.listPreviews(p, PAGE_SIZE);\n      setItems(data.items);\n      setTotal(data.total);\n      setPage(data.page);\n    } catch (err) {\n      setListError(err instanceof Error ? err.message : \"Failed to load links\");\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    if (username) load(page);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [username, page]);\n\n  function handleAuthed(name: string) {\n    localStorage.setItem(\"lp.username\", name);\n    setUsername(name);\n    setPage(1);\n  }\n\n  function handleSignOut() {\n    localStorage.removeItem(\"lp.username\");\n    setUsername(null);\n    setItems([]);\n    setTotal(0);\n    setPage(1);\n  }\n\n  async function handleAdd(url: string) {\n    setAdding(true);\n    setAddError(null);\n    try {\n      const preview = await api.createPreview(url);\n      if (page === 1) {\n        setItems((prev) => [preview, ...prev].slice(0, PAGE_SIZE));\n        setTotal((t) => t + 1);\n      } else {\n        load(1);\n        setPage(1);\n      }\n    } catch (err) {\n      setAddError(err instanceof Error ? err.message : \"Failed to add link\");\n    } finally {\n      setAdding(false);\n    }\n  }\n\n  async function handleRefresh(id: number) {\n    setBusyId(id);\n    try {\n      const updated = await api.refreshPreview(id);\n      setItems((prev) => prev.map((p) => (p.id === id ? updated : p)));\n    } catch (err) {\n      setListError(err instanceof Error ? err.message : \"Failed to refresh link\");\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  async function handleDelete(id: number) {\n    setBusyId(id);\n    try {\n      await api.deletePreview(id);\n      setItems((prev) => prev.filter((p) => p.id !== id));\n      setTotal((t) => Math.max(0, t - 1));\n      if (items.length === 1 && page > 1) {\n        setPage((p) => p - 1);\n      }\n    } catch (err) {\n      setListError(err instanceof Error ? err.message : \"Failed to delete link\");\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <Header username={username} onAuthed={handleAuthed} onSignOut={handleSignOut} />\n      <main className=\"mx-auto max-w-3xl px-4 py-6\">\n        {username ? (\n          <>\n            <AddBar busy={adding} error={addError} onSubmit={handleAdd} />\n            <div className=\"mt-6 flex flex-col gap-4\">\n              {listError && <p className=\"text-sm text-red-600\">{listError}</p>}\n              {loading && items.length === 0 && (\n                <p className=\"py-8 text-center text-sm text-slate-500\">Loading…</p>\n              )}\n              {!loading && items.length === 0 && !listError && (\n                <p className=\"py-8 text-center text-sm text-slate-500\">\n                  No links yet. Paste one above to get started.\n                </p>\n              )}\n              {items.map((preview) => (\n                <PreviewCard\n                  key={preview.id}\n                  preview={preview}\n                  busy={busyId === preview.id}\n                  onRefresh={handleRefresh}\n                  onDelete={handleDelete}\n                />\n              ))}\n            </div>\n            <Pager page={page} pageSize={PAGE_SIZE} total={total} onChange={setPage} />\n          </>\n        ) : (\n          <p className=\"py-16 text-center text-sm text-slate-500\">\n            Sign in or register above to save your first link.\n          </p>\n        )}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794364373212,"end":1794364373220}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c87378d7001WVroCi5fwfujZd","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","messageID":"msg_1c87336dc001jPpVBDDoRhm6fQ"}}
