{"type":"text","timestamp":1794364225702,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"id":"prt_1c871388e001e4H7V8W8qyOeHm","messageID":"msg_1c86f81060011dlN0cfZQdQUzP","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","type":"text","text":"The environment quirk exists on base too — the pip cache serves a wheel hash that trips `--require-hashes`; the real Docker build environment is unaffected. Deps install fine without hash-pinning. Now writing the backend.\n\n","time":{"start":1794364225678,"end":1794364225698}}}
{"type":"tool_use","timestamp":1794364225743,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"type":"tool","tool":"write","callID":"call_7877aefa9531479a9ecb9e72","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: link preview API + frontend hosting.\"\"\"\n\nimport hashlib\nimport hmac\nimport re\nimport secrets\nimport sqlite3\nimport unicodedata\nfrom datetime import datetime, timezone\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom urllib.parse import urljoin, urlparse\n\nimport requests\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"app.db\"\n\nPBKDF2_ITERATIONS = 240_000\nFETCH_TIMEOUT = 10\nMAX_BODY_BYTES = 1_000_000\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 20\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash BLOB NOT NULL,\n    salt BLOB NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS previews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    url TEXT NOT NULL,\n    final_url TEXT,\n    status_code INTEGER,\n    title TEXT,\n    description TEXT,\n    image_url TEXT,\n    fetched_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_previews_user ON previews (user_id, id DESC);\n\"\"\"\n\n\ndef _now() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef _init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with _connect() as conn:\n        conn.executescript(SCHEMA)\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = _connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef _close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\n# --- auth -----------------------------------------------------------------\n\n\ndef _hash_password(password: str, salt: bytes) -> bytes:\n    return hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, PBKDF2_ITERATIONS)\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token.strip(),),\n    ).fetchone()\n    return row\n\n\ndef login_required(view):\n    from functools import wraps\n\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str) or not username.strip() or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    username = username.strip()\n    db = get_db()\n    exists = db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone()\n    if exists:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    salt = secrets.token_bytes(16)\n    db.execute(\n        \"INSERT INTO users (username, password_hash, salt, created_at) VALUES (?, ?, ?, ?)\",\n        (username, _hash_password(password, salt), salt, _now()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    row = get_db().execute(\"SELECT * FROM users WHERE username = ?\", (username.strip(),)).fetchone()\n    if row is None or not hmac.compare_digest(row[\"password_hash\"], _hash_password(password, row[\"salt\"])):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\", (token, row[\"id\"], _now()))\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    _, _, token = header.partition(\" \")\n    db = get_db()\n    db.execute(\"DELETE FROM tokens WHERE token = ?\", (token.strip(),))\n    db.commit()\n    return \"\", 204\n\n\n# --- page fetching / parsing ----------------------------------------------\n\n\nclass _MetaParser(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.title_parts: list[str] = []\n        self._in_title = False\n        self.title_done = False\n        self.metas: dict[str, str] = {}\n\n    def handle_starttag(self, tag, attrs):\n        if tag == \"title\" and not self.title_done:\n            self._in_title = True\n        elif tag == \"meta\":\n            attr = {k.lower(): (v or \"\") for k, v in attrs if k}\n            key = (attr.get(\"property\") or attr.get(\"name\") or \"\").strip().lower()\n            content = attr.get(\"content\")\n            if key and content is not None:\n                self.metas.setdefault(key, content)\n\n    def handle_endtag(self, tag):\n        if tag == \"title\" and self._in_title:\n            self._in_title = False\n            self.title_done = True\n\n    def handle_data(self, data):\n        if self._in_title:\n            self.title_parts.append(data)\n\n\n_WHITESPACE_RE = re.compile(r\"\\s+\")\n_STRIP_TAGS_RE = re.compile(r\"<[^>]*>\")\n_CONTROL_CHARS_RE = re.compile(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]\")\n\n\ndef _plain_text(value: str | None) -> str | None:\n    if value is None:\n        return None\n    value = _STRIP_TAGS_RE.sub(\" \", value)\n    value = unicodedata.normalize(\"NFC\", value)\n    value = _CONTROL_CHARS_RE.sub(\"\", value)\n    value = _WHITESPACE_RE.sub(\" \", value).strip()\n    return value or None\n\n\ndef _parse_preview_html(html_text: str, base_url: str) -> dict:\n    parser = _MetaParser()\n    try:\n        parser.feed(html_text)\n        parser.close()\n    except Exception:\n        pass\n    title = _plain_text(\" \".join(parser.title_parts))\n    description = _plain_text(parser.metas.get(\"description\"))\n    og_title = _plain_text(parser.metas.get(\"og:title\"))\n    og_description = _plain_text(parser.metas.get(\"og:description\"))\n    og_image = parser.metas.get(\"og:image\", \"\").strip()\n    image_url = None\n    if og_image:\n        image_url = urljoin(base_url, og_image)\n    return {\n        \"title\": og_title or title,\n        \"description\": og_description or description,\n        \"image_url\": image_url,\n    }\n\n\ndef _normalize_url(url: str) -> str:\n    url = url.strip()\n    if url and not urlparse(url).scheme:\n        url = \"https://\" + url\n    return url\n\n\ndef _fetch_preview_data(url: str) -> dict:\n    resp = requests.get(\n        url,\n        timeout=FETCH_TIMEOUT,\n        allow_redirects=True,\n        stream=True,\n        headers={\"User-Agent\": \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"},\n    )\n    try:\n        raw = resp.raw.read(MAX_BODY_BYTES + 1, decode_content=True)\n        truncated = len(raw) > MAX_BODY_BYTES\n        body = raw[:MAX_BODY_BYTES]\n        encoding = resp.encoding or \"utf-8\"\n        try:\n            text = body.decode(encoding, errors=\"replace\")\n        except LookupError:\n            text = body.decode(\"utf-8\", errors=\"replace\")\n        ctype = resp.headers.get(\"Content-Type\", \"\")\n        meta = {}\n        if truncated or \"html\" in ctype.lower() or not ctype:\n            meta = _parse_preview_html(text, str(resp.url))\n        image = meta.get(\"image_url\")\n        if image:\n            parsed = urlparse(image)\n            if parsed.scheme not in (\"http\", \"https\"):\n                image = None\n        return {\n            \"final_url\": str(resp.url),\n            \"status_code\": resp.status_code,\n            \"title\": meta.get(\"title\"),\n            \"description\": meta.get(\"description\"),\n            \"image_url\": image,\n        }\n    finally:\n        resp.close()\n\n\n# --- previews ---------------------------------------------------------------\n\n\ndef _serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\ndef _get_owned_preview(db, user_id: int, preview_id: int):\n    return db.execute(\n        \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, user_id),\n    ).fetchone()\n\n\ndef _create_or_update(db, user_id: int, preview_id: int | None, url: str):\n    data = _fetch_preview_data(url)\n    fetched_at = _now()\n    if preview_id is None:\n        cur = db.execute(\n            \"INSERT INTO previews (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\"\n            \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (user_id, url, data[\"final_url\"], data[\"status_code\"], data[\"title\"], data[\"description\"], data[\"image_url\"], fetched_at),\n        )\n        preview_id = cur.lastrowid\n    else:\n        db.execute(\n            \"UPDATE previews SET final_url = ?, status_code = ?, title = ?, description = ?, image_url = ?, fetched_at = ?\"\n            \" WHERE id = ? AND user_id = ?\",\n            (data[\"final_url\"], data[\"status_code\"], data[\"title\"], data[\"description\"], data[\"image_url\"], fetched_at, preview_id, user_id),\n        )\n    db.commit()\n    return _get_owned_preview(db, user_id, preview_id)\n\n\n@app.post(\"/api/previews\")\n@login_required\ndef create_preview():\n    data = request.get_json(silent=True) or {}\n    url = data.get(\"url\")\n    if not isinstance(url, str) or not url.strip():\n        return jsonify({\"error\": \"url is required\"}), 400\n    url = _normalize_url(url)\n    parsed = urlparse(url)\n    if parsed.scheme not in (\"http\", \"https\") or not parsed.netloc:\n        return jsonify({\"error\": \"invalid url\"}), 400\n    try:\n        row = _create_or_update(get_db(), g.user[\"id\"], None, url)\n    except requests.RequestException:\n        return jsonify({\"error\": \"could not fetch url\"}), 400\n    return jsonify(_serialize(row)), 201\n\n\n@app.get(\"/api/previews\")\n@login_required\ndef list_previews():\n    def _int_arg(name, default):\n        raw = request.args.get(name)\n        if raw is None:\n            return default\n        try:\n            value = int(raw)\n        except ValueError:\n            return default\n        return max(value, 1)\n\n    page = _int_arg(\"page\", 1)\n    page_size = min(_int_arg(\"page_size\", DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE)\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS c FROM previews WHERE user_id = ?\", (g.user[\"id\"],)).fetchone()[\"c\"]\n    rows = db.execute(\n        \"SELECT * FROM previews WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n        (g.user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [_serialize(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@login_required\ndef get_preview(preview_id: int):\n    row = _get_owned_preview(get_db(), g.user[\"id\"], preview_id)\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify(_serialize(row))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@login_required\ndef refresh_preview(preview_id: int):\n    db = get_db()\n    row = _get_owned_preview(db, g.user[\"id\"], preview_id)\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    try:\n        row = _create_or_update(db, g.user[\"id\"], preview_id, row[\"url\"])\n    except requests.RequestException:\n        return jsonify({\"error\": \"could not fetch url\"}), 400\n    return jsonify(_serialize(row))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@login_required\ndef delete_preview(preview_id: int):\n    db = get_db()\n    row = _get_owned_preview(db, g.user[\"id\"], preview_id)\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    db.execute(\"DELETE FROM previews WHERE id = ?\", (preview_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.errorhandler(404)\ndef not_found(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(405)\ndef method_not_allowed(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"method not allowed\"}), 405\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    candidate = (DIST / path).resolve()\n    if candidate.is_file() and candidate.is_relative_to(DIST):\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n_init_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794364225692,"end":1794364225721}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8713893001NW1RdTdMPX1D3c","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","messageID":"msg_1c86f81060011dlN0cfZQdQUzP"}}
