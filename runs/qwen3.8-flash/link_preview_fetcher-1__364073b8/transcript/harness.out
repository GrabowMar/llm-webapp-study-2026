{"type":"step_start","timestamp":1794364301173,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"id":"prt_1c8725f62001XTMRQNCcva2kal","messageID":"msg_1c87239e900165RB2fHfw0WISq","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","type":"step-start"}}
{"type":"tool_use","timestamp":1794364301203,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"type":"tool","tool":"write","callID":"call_c21c8c994a5d4727851833c7","state":{"status":"completed","input":{"content":"import type { Preview, PreviewPage } from \"./types\";\n\nconst TOKEN_KEY = \"lp.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(`/api${path}`, { ...options, headers });\n  if (res.status === 204) return undefined as T;\n  let payload: unknown = null;\n  try {\n    payload = await res.json();\n  } catch {\n    /* non-json body */\n  }\n  if (!res.ok) {\n    if (res.status === 401 && path !== \"/auth/login\") setToken(null);\n    const message =\n      payload && typeof payload === \"object\" && \"error\" in payload\n        ? String((payload as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new Error(message);\n  }\n  return payload as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<void>(\"/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  logout: () => request<void>(\"/auth/logout\", { method: \"POST\" }),\n  listPreviews: (page: number, pageSize: number) =>\n    request<PreviewPage>(`/previews?page=${page}&page_size=${pageSize}`),\n  createPreview: (url: string) =>\n    request<Preview>(\"/previews\", {\n      method: \"POST\",\n      body: JSON.stringify({ url }),\n    }),\n  refreshPreview: (id: number) =>\n    request<Preview>(`/previews/${id}/refresh`, { method: \"POST\" }),\n  deletePreview: (id: number) =>\n    request<void>(`/previews/${id}`, { method: \"DELETE\" }),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794364301166,"end":1794364301177}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8725f65001myuhHGEyP2jKaS","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","messageID":"msg_1c87239e900165RB2fHfw0WISq"}}
