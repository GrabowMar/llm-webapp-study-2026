{"type":"step_start","timestamp":1794364350998,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"id":"prt_1c873220a001LO0IP8Fcwncg3H","messageID":"msg_1c872eec4001QkR1Wd3O1UFAax","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","type":"step-start"}}
{"type":"tool_use","timestamp":1794364351021,"sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","part":{"type":"tool","tool":"write","callID":"call_d50c5d5f0f3d4f91afc46461","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport type { Preview } from \"../types\";\n\ninterface Props {\n  preview: Preview;\n  busy: boolean;\n  onRefresh: (id: number) => void;\n  onDelete: (id: number) => void;\n}\n\nfunction hostOf(preview: Preview): string {\n  try {\n    return new URL(preview.final_url || preview.url).host;\n  } catch {\n    return \"\";\n  }\n}\n\nexport default function PreviewCard({ preview, busy, onRefresh, onDelete }: Props) {\n  const [imageFailed, setImageFailed] = useState(false);\n  const host = hostOf(preview);\n  const title = preview.title || host || preview.url;\n\n  return (\n    <article className=\"flex overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm\">\n      <div className=\"flex min-w-0 flex-1 flex-col gap-1 p-4\">\n        <a\n          href={preview.final_url || preview.url}\n          target=\"_blank\"\n          rel=\"noreferrer\"\n          className=\"truncate text-base font-semibold text-blue-700 hover:underline\"\n        >\n          {title}\n        </a>\n        {host && (\n          <p className=\"flex items-center gap-1 text-xs text-slate-500\">\n            {preview.status_code != null && preview.status_code >= 400 && (\n              <span className=\"rounded bg-amber-100 px-1.5 py-0.5 font-medium text-amber-700\">\n                HTTP {preview.status_code}\n              </span>\n            )}\n            {host}\n          </p>\n        )}\n        {preview.description && (\n          <p className=\"line-clamp-3 text-sm text-slate-600\">{preview.description}</p>\n        )}\n        <div className=\"mt-auto flex items-center justify-between pt-3\">\n          <span className=\"text-xs text-slate-400\">\n            {new Date(preview.fetched_at).toLocaleString()}\n          </span>\n          <div className=\"flex gap-2\">\n            <button\n              onClick={() => onRefresh(preview.id)}\n              disabled={busy}\n              className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-50\"\n            >\n              {busy && (\n                <span className=\"h-3 w-3 animate-spin rounded-full border-2 border-slate-400 border-t-slate-700\" />\n              )}\n              Refresh\n            </button>\n            <button\n              onClick={() => onDelete(preview.id)}\n              disabled={busy}\n              className=\"rounded-md border border-red-200 px-3 py-1 text-xs font-medium text-red-600 hover:bg-red-50 disabled:opacity-50\"\n            >\n              Delete\n            </button>\n          </div>\n        </div>\n      </div>\n      {preview.image_url && !imageFailed && (\n        <a\n          href={preview.final_url || preview.url}\n          target=\"_blank\"\n          rel=\"noreferrer\"\n          className=\"hidden w-40 shrink-0 sm:block\"\n        >\n          <img\n            src={preview.image_url}\n            alt=\"\"\n            onError={() => setImageFailed(true)}\n            className=\"h-full w-full object-cover\"\n          />\n        </a>\n      )}\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/components/PreviewCard.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/PreviewCard.tsx","exists":false,"truncated":false},"title":"frontend/src/components/PreviewCard.tsx","time":{"start":1794364350994,"end":1794364351000}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c873220d001GSS22NnQ0Fu8qv","sessionID":"ses_e37993df6ffeDue0pJSjzMGtzF","messageID":"msg_1c872eec4001QkR1Wd3O1UFAax"}}
