{"type":"step_start","timestamp":1794372568803,"sessionID":"ses_e37157e4affeEPRNvCLhSpWA1r","part":{"id":"prt_1c8f086d1001EDmCeIDbY3GXYn","messageID":"msg_1c8f06cd0001u1Gob6eKdwkyb1","sessionID":"ses_e37157e4affeEPRNvCLhSpWA1r","type":"step-start"}}
{"type":"tool_use","timestamp":1794372568831,"sessionID":"ses_e37157e4affeEPRNvCLhSpWA1r","part":{"type":"tool","tool":"write","callID":"call_fda0a6d93f3c43b2abb31dd9","state":{"status":"completed","input":{"content":"export function timeAgo(iso: string | null, now = Date.now()): string {\n  if (!iso) return \"never\";\n  const then = Date.parse(iso);\n  if (Number.isNaN(then)) return \"unknown\";\n  const seconds = Math.max(0, Math.round((now - then) / 1000));\n  if (seconds < 5) return \"just now\";\n  if (seconds < 60) return `${seconds} seconds ago`;\n  const minutes = Math.floor(seconds / 60);\n  if (minutes === 1) return \"1 minute ago\";\n  if (minutes < 60) return `${minutes} minutes ago`;\n  const hours = Math.floor(minutes / 60);\n  if (hours === 1) return \"1 hour ago\";\n  if (hours < 24) return `${hours} hours ago`;\n  const days = Math.floor(hours / 24);\n  if (days === 1) return \"1 day ago\";\n  return `${days} days ago`;\n}\n\nexport function formatTime(iso: string): string {\n  const date = new Date(iso);\n  if (Number.isNaN(date.getTime())) return iso;\n  return date.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\",\n  });\n}\n\nexport function formatValue(value: number | null, unit: string): string {\n  if (value === null || Number.isNaN(value)) return \"—\";\n  return unit ? `${value} ${unit}` : `${value}`;\n}\n","filePath":"/workspace/frontend/src/format.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/format.ts","exists":false,"truncated":false},"title":"frontend/src/format.ts","time":{"start":1794372568797,"end":1794372568807}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8f086d6001ZCJr1LutM50r5S","sessionID":"ses_e37157e4affeEPRNvCLhSpWA1r","messageID":"msg_1c8f06cd0001u1Gob6eKdwkyb1"}}
