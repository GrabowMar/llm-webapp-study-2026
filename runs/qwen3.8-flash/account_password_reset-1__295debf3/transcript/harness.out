{"type":"tool_use","timestamp":1794313521973,"sessionID":"ses_e3a97d427ffefPZhBH6L7NNlLk","part":{"type":"tool","tool":"write","callID":"call_d25f7de08e9543bba5fd40a8","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: accounts, password reset and a fake email outbox.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\n\nTOKEN_TTL_SECONDS = 3600\nPBKDF2_ITERATIONS = 120_000\n\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"JSON_SORT_KEYS\"] = False\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n        g.db.execute(\"PRAGMA journal_mode = WAL\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            email TEXT UNIQUE COLLATE NOCASE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS sessions (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS reset_tokens (\n            token_hash TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            expires_at REAL NOT NULL,\n            used_at TEXT,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS outbox (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            recipient TEXT NOT NULL,\n            subject TEXT NOT NULL,\n            body TEXT NOT NULL,\n            sent_at TEXT NOT NULL\n        );\n        \"\"\"\n    )\n    db.commit()\n    db.close()\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(), bytes.fromhex(salt), PBKDF2_ITERATIONS\n    ).hex()\n    return f\"pbkdf2_sha256${PBKDF2_ITERATIONS}${salt}${digest}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        algo, iterations, salt, digest = stored.split(\"$\")\n    except ValueError:\n        return False\n    check = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(), bytes.fromhex(salt), int(iterations)\n    ).hex()\n    return algo == \"pbkdf2_sha256\" and secrets.compare_digest(check, digest)\n\n\ndef valid_password(password) -> bool:\n    return isinstance(password, str) and len(password) >= 8\n\n\ndef valid_email(email) -> bool:\n    return isinstance(email, str) and bool(EMAIL_RE.match(email.strip()))\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef user_public(row: sqlite3.Row) -> dict:\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"email\": row[\"email\"]}\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header.removeprefix(\"Bearer \").strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.* FROM users u JOIN sessions s ON s.user_id = u.id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, error(\"Authentication required\", 401)\n    return user, None\n\n\ndef send_message(db: sqlite3.Connection, to: str, subject: str, body: str) -> dict:\n    cur = db.execute(\n        \"INSERT INTO outbox (recipient, subject, body, sent_at) VALUES (?, ?, ?, ?)\",\n        (to, subject, body, utcnow()),\n    )\n    return {\n        \"id\": cur.lastrowid,\n        \"to\": to,\n        \"subject\": subject,\n        \"body\": body,\n        \"sent_at\": None,\n    }\n\n\ndef message_from_row(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"to\": row[\"recipient\"],\n        \"subject\": row[\"subject\"],\n        \"body\": row[\"body\"],\n        \"sent_at\": row[\"sent_at\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    email = body.get(\"email\")\n\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\", 400)\n    username = username.strip()\n    if not valid_password(password):\n        return error(\"Password must be at least 8 characters\", 400)\n    if email is not None and email != \"\" and not valid_email(email):\n        return error(\"Email address is not valid\", 400)\n    email = email.strip() if isinstance(email, str) and email.strip() else None\n\n    db = get_db()\n    if db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone():\n        return error(\"Username is already taken\", 409)\n    if email is not None and db.execute(\n        \"SELECT 1 FROM users WHERE email = ?\", (email,)\n    ).fetchone():\n        return error(\"Email address is already in use\", 409)\n\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, email, created_at) VALUES (?, ?, ?, ?)\",\n        (username, hash_password(password), email, utcnow()),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM users WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(user_public(row)), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\", 400)\n\n    row = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/me\")\ndef me():\n    user, err = require_user()\n    if err:\n        return err\n    return jsonify(user_public(user))\n\n\n@app.patch(\"/api/me\")\ndef update_me():\n    user, err = require_user()\n    if err:\n        return err\n\n    body = json_body()\n    if \"email\" not in body:\n        return error(\"Email is required\", 400)\n    email = body[\"email\"]\n    if email is None or (isinstance(email, str) and not email.strip()):\n        email = None\n    elif not valid_email(email):\n        return error(\"Email address is not valid\", 400)\n    else:\n        email = email.strip()\n\n    db = get_db()\n    if email is not None and db.execute(\n        \"SELECT 1 FROM users WHERE email = ? AND id != ?\", (email, user[\"id\"])\n    ).fetchone():\n        return error(\"Email address is already in use\", 409)\n    db.execute(\"UPDATE users SET email = ? WHERE id = ?\", (email, user[\"id\"]))\n    db.commit()\n    row = db.execute(\"SELECT * FROM users WHERE id = ?\", (user[\"id\"],)).fetchone()\n    return jsonify(user_public(row))\n\n\n@app.post(\"/api/me/password\")\ndef change_password():\n    user, err = require_user()\n    if err:\n        return err\n\n    body = json_body()\n    current = body.get(\"current_password\")\n    new = body.get(\"new_password\")\n    if not isinstance(current, str) or not verify_password(current, user[\"password_hash\"]):\n        return error(\"Current password is incorrect\", 401)\n    if not valid_password(new):\n        return error(\"New password must be at least 8 characters\", 400)\n\n    db = get_db()\n    db.execute(\n        \"UPDATE users SET password_hash = ? WHERE id = ?\",\n        (hash_password(new), user[\"id\"]),\n    )\n    db.execute(\"DELETE FROM reset_tokens WHERE user_id = ?\", (user[\"id\"],))\n    db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.post(\"/api/auth/password-reset\")\ndef request_password_reset():\n    body = json_body()\n    username = body.get(\"username\")\n    email = body.get(\"email\")\n\n    user = None\n    db = get_db()\n    if isinstance(username, str) and username.strip():\n        user = db.execute(\n            \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n        ).fetchone()\n    elif isinstance(email, str) and email.strip():\n        user = db.execute(\n            \"SELECT * FROM users WHERE email = ?\", (email.strip(),)\n        ).fetchone()\n\n    if user is not None and user[\"email\"]:\n        token = secrets.token_urlsafe(32)\n        db.execute(\n            \"INSERT INTO reset_tokens (token_hash, user_id, expires_at, created_at) VALUES (?, ?, ?, ?)\",\n            (\n                hashlib.sha256(token.encode()).hexdigest(),\n                user[\"id\"],\n                time.time() + TOKEN_TTL_SECONDS,\n                utcnow(),\n            ),\n        )\n        link = f\"{request.url_root.rstrip('/')}/reset?token={token}\"\n        body_text = (\n            \"You asked to reset your password.\\n\\n\"\n            f\"Use this single-use link to choose a new password:\\n{link}\\n\\n\"\n            \"If you did not request this, you can ignore this message.\"\n        )\n        db.execute(\n            \"INSERT INTO outbox (recipient, subject, body, sent_at) VALUES (?, ?, ?, ?)\",\n            (user[\"email\"], \"Reset your password\", body_text, utcnow()),\n        )\n        db.commit()\n\n    return jsonify(\n        {\"message\": \"If the account exists, a reset link is on its way\"}\n    )\n\n\n@app.post(\"/api/auth/password-reset/confirm\")\ndef confirm_password_reset():\n    body = json_body()\n    token = body.get(\"token\")\n    new_password = body.get(\"new_password\")\n\n    if not isinstance(token, str) or not token:\n        return error(\"Token is required\", 400)\n    if not valid_password(new_password):\n        return error(\"New password must be at least 8 characters\", 400)\n\n    db = get_db()\n    token_hash = hashlib.sha256(token.encode()).hexdigest()\n    row = db.execute(\n        \"SELECT * FROM reset_tokens WHERE token_hash = ?\", (token_hash,)\n    ).fetchone()\n    if row is None or row[\"used_at\"] is not None or row[\"expires_at\"] < time.time():\n        return error(\"Reset link is invalid or has expired\", 400)\n\n    db.execute(\n        \"UPDATE users SET password_hash = ? WHERE id = ?\",\n        (hash_password(new_password), row[\"user_id\"]),\n    )\n    db.execute(\n        \"UPDATE reset_tokens SET used_at = ? WHERE token_hash = ?\",\n        (utcnow(), token_hash),\n    )\n    db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (row[\"user_id\"],))\n    db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/outbox\")\ndef list_outbox():\n    to = request.args.get(\"to\")\n    if not to:\n        return error(\"Query parameter 'to' is required\", 400)\n    rows = get_db().execute(\n        \"SELECT * FROM outbox WHERE recipient = ? COLLATE NOCASE ORDER BY id DESC\",\n        (to.strip(),),\n    ).fetchall()\n    return jsonify({\"items\": [message_from_row(r) for r in rows]})\n\n\n@app.errorhandler(404)\ndef not_found(_err):\n    if request.path.startswith(\"/api\"):\n        return error(\"Not found\", 404)\n    return serve_frontend(\"index.html\")\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_err):\n    if request.path.startswith(\"/api\"):\n        return error(\"Method not allowed\", 405)\n    return serve_frontend(\"index.html\")\n\n\ndef serve_frontend(path: str):\n    if DIST.is_dir() and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    return serve_frontend(path)\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794313521917,"end":1794313521956}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c56b8af7001hIJKoBFlzmcO3A","sessionID":"ses_e3a97d427ffefPZhBH6L7NNlLk","messageID":"msg_1c56a7ced001qNJemHjq4cCRwi"}}
