Error(res.status, obj.error ?? `request failed (${res.status})`, obj.details ?? null);\n   }\n   return data as T;\n }\n","additions":3,"deletions":0},"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794356069167,"end":1794356069195}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7f4c328001FA3DoM3k6uNbwR","sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","messageID":"msg_1c7f48d610011iG5akc4j6zFEe"}}
