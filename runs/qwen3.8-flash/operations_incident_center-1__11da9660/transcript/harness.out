{"type":"tool_use","timestamp":1794355916389,"sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","part":{"type":"tool","tool":"write","callID":"call_7fbcead41dcc4e77bf3dabed","state":{"status":"completed","input":{"content":"export type Severity = \"sev1\" | \"sev2\" | \"sev3\" | \"sev4\";\nexport type IncidentStatus =\n  | \"investigating\"\n  | \"identified\"\n  | \"mitigated\"\n  | \"resolved\";\n\nexport interface Incident {\n  id: number;\n  title: string;\n  service: string;\n  severity: Severity;\n  status: IncidentStatus;\n  commander: string;\n  impact_summary: string;\n  opened_at: string;\n  resolved_at: string | null;\n  reopen_count: number;\n  opened_by: string;\n  sla_due_at: string;\n  sla_breached: boolean;\n}\n\nexport interface TimelineEvent {\n  id: number;\n  type: string;\n  message: string;\n  created_at: string;\n  author: string;\n}\n\nexport interface IncidentList {\n  items: Incident[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface TimelineList {\n  items: TimelineEvent[];\n}\n\nexport interface PublicStats {\n  open_total: number;\n  open_by_severity: Record<Severity, number>;\n  sla_breached_open: number;\n  resolved_last_30_days: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  details: Record<string, string> | null;\n\n  constructor(status: number, message: string, details: Record<string, string> | null) {\n    super(message);\n    this.status = status;\n    this.details = details;\n  }\n}\n\nconst TOKEN_KEY = \"ic_token\";\nconst USER_KEY = \"ic_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USER_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USER_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {}\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token && options.auth !== false) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const res = await fetch(`/api${path}`, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n  });\n\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    /* non-json body */\n  }\n\n  if (!res.ok) {\n    const obj = (data ?? {}) as { error?: string; details?: Record<string, string> };\n    throw new ApiError(res.status, obj.error ?? `request failed (${res.status})`, obj.details ?? null);\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    }),\n  listIncidents: (params: Record<string, string | number | undefined>) => {\n    const qs = new URLSearchParams();\n    for (const [k, v] of Object.entries(params)) {\n      if (v !== undefined && v !== \"\") qs.set(k, String(v));\n    }\n    const suffix = qs.toString();\n    return request<IncidentList>(`/incidents${suffix ? `?${suffix}` : \"\"}`);\n  },\n  createIncident: (body: Record<string, string>) =>\n    request<Incident>(\"/incidents\", { method: \"POST\", body }),\n  getIncident: (id: number | string) => request<Incident>(`/incidents/${id}`),\n  patchIncident: (id: number | string, body: Record<string, string>) =>\n    request<Incident>(`/incidents/${id}`, { method: \"PATCH\", body }),\n  getTimeline: (id: number | string) =>\n    request<TimelineList>(`/incidents/${id}/timeline`),\n  postEvent: (id: number | string, message: string, type?: string) =>\n    request<TimelineEvent>(`/incidents/${id}/timeline`, {\n      method: \"POST\",\n      body: type ? { message, type } : { message },\n    }),\n  stats: () => request<PublicStats>(\"/public/stats\", { auth: false }),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794355916329,"end":1794355916353}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7f26e23001ZanIiW9m2lss0W","sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","messageID":"msg_1c7f22419001MGRreRDeLfla3L"}}
{"type":"tool_use","timestamp":1794355916390,"sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","part":{"type":"tool","tool":"write","callID":"call_be9f81b78e21410c98556a7b","state":{"status":"completed","input":{"content":"export function formatTime(iso: string | null): string {\n  if (!iso) return \"—\";\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return iso;\n  return d.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"2-digit\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n  });\n}\n\nexport function timeUntil(iso: string): string {\n  const ms = new Date(iso).getTime() - Date.now();\n  const abs = Math.abs(ms);\n  const mins = Math.floor(abs / 60000);\n  const h = Math.floor(mins / 60);\n  const m = mins % 60;\n  const text = h > 0 ? `${h}h ${m}m` : `${m}m`;\n  return ms >= 0 ? `${text} left` : `${text} overdue`;\n}\n","filePath":"/workspace/frontend/src/format.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/format.ts","exists":false,"truncated":false},"title":"frontend/src/format.ts","time":{"start":1794355916340,"end":1794355916360}},"id":"prt_1c7f26e2d001rIAOJ1O1UGXzeM","sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","messageID":"msg_1c7f22419001MGRreRDeLfla3L"}}
