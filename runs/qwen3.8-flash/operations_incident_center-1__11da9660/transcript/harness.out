{"type":"text","timestamp":1794356112916,"sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","part":{"id":"prt_1c7f56e06001GMAr1dnMH7ICZh","messageID":"msg_1c7f52a9a001eMEdGJzkl4NvV2","sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","type":"text","text":"Now rewriting App.tsx to use the shared auth module and persist sessions:\n\n","time":{"start":1794356112902,"end":1794356112913}}}
{"type":"tool_use","timestamp":1794356112938,"sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","part":{"type":"tool","tool":"write","callID":"call_c317d465cd65433e8c09860d","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { Link, Navigate, Route, Routes, useNavigate } from \"react-router-dom\";\nimport { clearSession, getToken, getUsername, setSession } from \"./api\";\nimport { AuthContext, useAuth } from \"./auth\";\nimport IncidentDetail from \"./pages/IncidentDetail\";\nimport IncidentListPage from \"./pages/IncidentList\";\nimport Login from \"./pages/Login\";\nimport NewIncident from \"./pages/NewIncident\";\nimport PublicPage from \"./pages/PublicPage\";\n\nfunction Header() {\n  const auth = useAuth();\n  const navigate = useNavigate();\n  return (\n    <header className=\"border-b border-gray-200 bg-white\">\n      <div className=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-3\">\n        <div className=\"flex items-center gap-6\">\n          <Link to=\"/\" className=\"text-lg font-bold text-indigo-700\">\n            🚨 Incident Center\n          </Link>\n          <nav className=\"flex items-center gap-4 text-sm font-medium text-gray-600\">\n            <Link to=\"/public\" className=\"hover:text-gray-900\">\n              Public overview\n            </Link>\n            {auth.token && (\n              <>\n                <Link to=\"/incidents\" className=\"hover:text-gray-900\">\n                  Incidents\n                </Link>\n                <Link to=\"/incidents/new\" className=\"hover:text-gray-900\">\n                  Open incident\n                </Link>\n              </>\n            )}\n          </nav>\n        </div>\n        {auth.token ? (\n          <div className=\"flex items-center gap-3 text-sm\">\n            <span className=\"text-gray-600\">\n              Signed in as <strong className=\"text-gray-900\">{auth.username}</strong>\n            </span>\n            <button\n              onClick={() => {\n                auth.signOut();\n                navigate(\"/login\");\n              }}\n              className=\"rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-50\"\n            >\n              Sign out\n            </button>\n          </div>\n        ) : (\n          <Link\n            to=\"/login\"\n            className=\"rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-500\"\n          >\n            Sign in\n          </Link>\n        )}\n      </div>\n    </header>\n  );\n}\n\nfunction RequireAuth({ children }: { children: React.ReactElement }) {\n  const auth = useAuth();\n  if (!auth.token) return <Navigate to=\"/login\" replace />;\n  return children;\n}\n\nexport default function App() {\n  const [token, setToken] = useState<string | null>(() => getToken());\n  const [username, setUsername] = useState<string | null>(() => getUsername());\n\n  const signIn = useCallback((t: string, u: string) => {\n    setSession(t, u);\n    setToken(t);\n    setUsername(u);\n  }, []);\n\n  const signOut = useCallback(() => {\n    clearSession();\n    setToken(null);\n    setUsername(null);\n  }, []);\n\n  useEffect(() => {\n    const handler = () => {\n      clearSession();\n      setToken(null);\n      setUsername(null);\n    };\n    window.addEventListener(\"ic:unauthorized\", handler);\n    return () => window.removeEventListener(\"ic:unauthorized\", handler);\n  }, []);\n\n  return (\n    <AuthContext.Provider value={{ username, token, signIn, signOut }}>\n      <div className=\"min-h-screen bg-gray-100\">\n        <Header />\n        <main className=\"mx-auto max-w-6xl px-4 py-8\">\n          <Routes>\n            <Route path=\"/\" element={<Navigate to=\"/public\" replace />} />\n            <Route path=\"/public\" element={<PublicPage />} />\n            <Route path=\"/login\" element={<Login />} />\n            <Route\n              path=\"/incidents\"\n              element={\n                <RequireAuth>\n                  <IncidentListPage />\n                </RequireAuth>\n              }\n            />\n            <Route\n              path=\"/incidents/new\"\n              element={\n                <RequireAuth>\n                  <NewIncident />\n                </RequireAuth>\n              }\n            />\n            <Route\n              path=\"/incidents/:id\"\n              element={\n                <RequireAuth>\n                  <IncidentDetail />\n                </RequireAuth>\n              }\n            />\n            <Route path=\"*\" element={<Navigate to=\"/public\" replace />} />\n          </Routes>\n        </main>\n      </div>\n    </AuthContext.Provider>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794356112910,"end":1794356112920}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7f56e09001trYrNtE7fhjlq6","sessionID":"ses_e3816ec78ffeUZLbHUPZhWFlYI","messageID":"msg_1c7f52a9a001eMEdGJzkl4NvV2"}}
