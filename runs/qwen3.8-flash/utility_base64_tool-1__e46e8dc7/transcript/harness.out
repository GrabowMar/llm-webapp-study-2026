{"type":"text","timestamp":1794358980111,"sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","part":{"id":"prt_1c8212dfa001qvaMQPQMDyjH01","messageID":"msg_1c8208ec5001r8IdMFQnunu0Ju","sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","type":"text","text":"Now writing the backend.\n\n","time":{"start":1794358980090,"end":1794358980107}}}
{"type":"tool_use","timestamp":1794358980149,"sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","part":{"type":"tool","tool":"write","callID":"call_1050dddac1d242408a80a72d","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the base64 converter API and frontend.\"\"\"\n\nimport base64\nimport binascii\nimport json\nimport sqlite3\nimport uuid\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"./data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\napp = Flask(__name__, static_folder=None)\n\nPREVIEW_CHARS = 100\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    db = getattr(g, \"_db\", None)\n    if db is None:\n        db = g._db = sqlite3.connect(DB_PATH)\n        db.row_factory = sqlite3.Row\n    return db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = getattr(g, \"_db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS conversions (\n            id TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            direction TEXT NOT NULL,\n            input TEXT NOT NULL,\n            output TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_conversions_user ON conversions (user_id, created_at);\n        \"\"\"\n    )\n    db.commit()\n    db.close()\n\n\ndef signin_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        auth = request.headers.get(\"Authorization\", \"\")\n        token = None\n        if auth.startswith(\"Bearer \"):\n            token = auth[len(\"Bearer \"):].strip()\n        user = None\n        if token:\n            row = get_db().execute(\n                \"SELECT u.id, u.username FROM tokens t\"\n                \" JOIN users u ON u.id = t.user_id\"\n                \" WHERE t.token = ?\",\n                (token,),\n            ).fetchone()\n            if row is not None:\n                user = {\"id\": row[\"id\"], \"username\": row[\"username\"], \"token\": token}\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if isinstance(data, dict):\n        return data\n    return {}\n\n\ndef encode_base64(text: str) -> str:\n    return base64.b64encode(text.encode(\"utf-8\")).decode(\"ascii\")\n\n\ndef decode_base64(data: str) -> str:\n    cleaned = \"\".join(data.split())\n    try:\n        decoded = base64.b64decode(cleaned, validate=True)\n    except (binascii.Error, ValueError):\n        raise ValueError(\"input is not valid base64\")\n    try:\n        return decoded.decode(\"utf-8\")\n    except UnicodeDecodeError:\n        raise ValueError(\"base64 decodes to bytes that are not valid UTF-8\")\n\n\ndef convert(direction: str, value: str) -> str:\n    if direction == \"encode\":\n        if not isinstance(value, str):\n            raise ValueError(\"'input' must be a string\")\n        return encode_base64(value)\n    if not isinstance(value, str):\n        raise ValueError(\"'input' must be a string\")\n    return decode_base64(value)\n\n\ndef preview(text: str) -> str:\n    return text[:PREVIEW_CHARS]\n\n\ndef conversion_row(row: sqlite3.Row, output: str | None = None) -> dict:\n    item = {\n        \"id\": row[\"id\"],\n        \"direction\": row[\"direction\"],\n        \"input_preview\": preview(row[\"input\"]),\n        \"output_preview\": preview(row[\"output\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n    if output is not None:\n        item[\"output\"] = output\n    return item\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"'username' is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"'password' is required\"}), 400\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utcnow()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already exists\"}), 409\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"'username' and 'password' are required\"}), 400\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    token = uuid.uuid4().hex\n    get_db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    get_db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/base64/encode\")\ndef api_encode():\n    body = json_body()\n    text = body.get(\"text\", \"\")\n    if not isinstance(text, str):\n        return jsonify({\"error\": \"'text' must be a string\"}), 400\n    return jsonify({\"encoded\": encode_base64(text)})\n\n\n@app.post(\"/api/base64/decode\")\ndef api_decode():\n    body = json_body()\n    encoded = body.get(\"encoded\")\n    if not isinstance(encoded, str):\n        return jsonify({\"error\": \"'encoded' is required\"}), 400\n    try:\n        text = decode_base64(encoded)\n    except ValueError as exc:\n        return jsonify({\"error\": str(exc)}), 400\n    return jsonify({\"text\": text})\n\n\n@app.post(\"/api/conversions\")\n@signin_required\ndef create_conversion():\n    body = json_body()\n    direction = body.get(\"direction\")\n    value = body.get(\"input\")\n    if direction not in (\"encode\", \"decode\"):\n        return jsonify({\"error\": \"'direction' must be 'encode' or 'decode'\"}), 400\n    try:\n        output = convert(direction, value)\n    except ValueError as exc:\n        return jsonify({\"error\": str(exc)}), 400\n    conv_id = uuid.uuid4().hex\n    now = utcnow()\n    get_db().execute(\n        \"INSERT INTO conversions (id, user_id, direction, input, output, created_at)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (conv_id, g.user[\"id\"], direction, value, output, now),\n    )\n    get_db().commit()\n    return jsonify(\n        {\n            \"id\": conv_id,\n            \"direction\": direction,\n            \"input_preview\": preview(value),\n            \"output_preview\": preview(output),\n            \"created_at\": now,\n            \"output\": output,\n        }\n    ), 201\n\n\n@app.get(\"/api/conversions\")\n@signin_required\ndef list_conversions():\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 10))\n    except ValueError:\n        return jsonify({\"error\": \"'page' and 'page_size' must be integers\"}), 400\n    if page < 1:\n        page = 1\n    if page_size < 1:\n        page_size = 1\n    if page_size > 100:\n        page_size = 100\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS c FROM conversions WHERE user_id = ?\", (g.user[\"id\"],)\n    ).fetchone()[\"c\"]\n    rows = db.execute(\n        \"SELECT * FROM conversions WHERE user_id = ?\"\n        \" ORDER BY created_at DESC, rowid DESC LIMIT ? OFFSET ?\",\n        (g.user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    items = [conversion_row(r) for r in rows]\n    return jsonify({\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size})\n\n\n@app.delete(\"/api/conversions/<conv_id>\")\n@signin_required\ndef delete_conversion(conv_id: str):\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM conversions WHERE id = ? AND user_id = ?\", (conv_id, g.user[\"id\"])\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        return jsonify({\"error\": \"conversion not found\"}), 404\n    return \"\", 204\n\n\n@app.errorhandler(404)\ndef not_found(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return err\n\n\n@app.errorhandler(405)\ndef method_not_allowed(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"method not allowed\"}), 405\n    return err\n\n\n@app.errorhandler(500)\ndef server_error(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"internal server error\"}), 500\n    return err\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794358980102,"end":1794358980125}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8212dfe00107GDTfqvvH712m","sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","messageID":"msg_1c8208ec5001r8IdMFQnunu0Ju"}}
