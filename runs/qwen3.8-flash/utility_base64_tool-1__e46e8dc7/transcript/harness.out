{"type":"tool_use","timestamp":1794359102960,"sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","part":{"type":"tool","tool":"write","callID":"call_39e75cf5d8aa4c2c9ace6620","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { ApiError, decodeText, encodeText, saveConversion } from \"./api\";\n\ninterface Props {\n  token: string | null;\n  onSave: () => void;\n}\n\nexport default function Converter({ token, onSave }: Props) {\n  const [input, setInput] = useState(\"\");\n  const [output, setOutput] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [saved, setSaved] = useState<string | null>(null);\n  const [saveToHistory, setSaveToHistory] = useState(true);\n  const [busy, setBusy] = useState(false);\n  const [copied, setCopied] = useState(false);\n\n  async function run(direction: \"encode\" | \"decode\") {\n    setBusy(true);\n    setError(null);\n    setSaved(null);\n    setCopied(false);\n    try {\n      let result: string;\n      if (token && saveToHistory) {\n        const conv = await saveConversion(token, direction, input);\n        result = conv.output ?? \"\";\n        setSaved(direction === \"encode\" ? conv.id : conv.id);\n        onSave();\n      } else if (direction === \"encode\") {\n        result = (await encodeText(input)).encoded;\n      } else {\n        result = (await decodeText(input)).text;\n      }\n      setOutput(result);\n    } catch (err) {\n      setOutput(\"\");\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function copy() {\n    try {\n      await navigator.clipboard.writeText(output);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 1500);\n    } catch {\n      setError(\"Could not copy to clipboard\");\n    }\n  }\n\n  return (\n    <section className=\"rounded-xl border border-slate-200 bg-white p-4 shadow-sm space-y-4\">\n      <div className=\"grid gap-4 md:grid-cols-2\">\n        <label className=\"block space-y-1.5\">\n          <span className=\"text-sm font-medium text-slate-700\">Input</span>\n          <textarea\n            value={input}\n            onChange={(e) => setInput(e.target.value)}\n            placeholder=\"Text or base64…\"\n            rows={6}\n            className=\"w-full resize-y rounded-lg border border-slate-300 p-3 font-mono text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\"\n          />\n        </label>\n        <label className=\"block space-y-1.5\">\n          <span className=\"text-sm font-medium text-slate-700\">Output</span>\n          <textarea\n            value={output}\n            readOnly\n            rows={6}\n            placeholder=\"Result appears here\"\n            className=\"w-full resize-y rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-sm text-slate-800\"\n          />\n        </label>\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-2\">\n        <button\n          onClick={() => run(\"encode\")}\n          disabled={busy}\n          className=\"rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50\"\n        >\n          Encode\n        </button>\n        <button\n          onClick={() => run(\"decode\")}\n          disabled={busy}\n          className=\"rounded-lg bg-slate-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:opacity-50\"\n        >\n          Decode\n        </button>\n        <button\n          onClick={copy}\n          disabled={busy || !output}\n          className=\"rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:opacity-50\"\n        >\n          {copied ? \"Copied!\" : \"Copy\"}\n        </button>\n\n        {token && (\n          <label className=\"ml-auto flex cursor-pointer select-none items-center gap-2 text-sm text-slate-600\">\n            Save to history\n            <button\n              type=\"button\"\n              role=\"switch\"\n              aria-checked={saveToHistory}\n              onClick={() => setSaveToHistory((v) => !v)}\n              className={`relative h-6 w-11 rounded-full transition ${\n                saveToHistory ? \"bg-indigo-600\" : \"bg-slate-300\"\n              }`}\n            >\n              <span\n                className={`absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition-all ${\n                  saveToHistory ? \"left-[22px]\" : \"left-0.5\"\n                }`}\n              />\n            </button>\n          </label>\n        )}\n      </div>\n\n      {error && (\n        <p role=\"alert\" className=\"rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n      {saved && !error && (\n        <p className=\"rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700\">\n          Saved to history.\n        </p>\n      )}\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/Converter.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Converter.tsx","exists":false,"truncated":false},"title":"frontend/src/Converter.tsx","time":{"start":1794359102936,"end":1794359102943}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8230dd2001jShpAp5L20Nu37","sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","messageID":"msg_1c822bc770016OTc6jAk1YSpgU"}}
