{"type":"tool_use","timestamp":1794359060148,"sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","part":{"type":"tool","tool":"write","callID":"call_19996f69264942ba8163205b","state":{"status":"completed","input":{"content":"export interface Conversion {\n  id: string;\n  direction: \"encode\" | \"decode\";\n  input_preview: string;\n  output_preview: string;\n  created_at: string;\n  output?: string;\n}\n\nexport interface ConversionPage {\n  items: Conversion[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport class ApiError extends Error {}\n\nasync function request<T>(\n  path: string,\n  options: { method?: string; body?: unknown; token?: string | null } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.token) headers[\"Authorization\"] = `Bearer ${options.token}`;\n\n  const res = await fetch(path, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body === undefined ? undefined : JSON.stringify(options.body),\n  });\n\n  if (res.status === 204) return undefined as T;\n\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n\n  if (!res.ok) {\n    const message =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(message);\n  }\n  return data as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ username: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: { username, password },\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: { username, password },\n  });\n}\n\nexport function encodeText(text: string) {\n  return request<{ encoded: string }>(\"/api/base64/encode\", {\n    method: \"POST\",\n    body: { text },\n  });\n}\n\nexport function decodeText(encoded: string) {\n  return request<{ text: string }>(\"/api/base64/decode\", {\n    method: \"POST\",\n    body: { encoded },\n  });\n}\n\nexport function saveConversion(\n  token: string,\n  direction: \"encode\" | \"decode\",\n  input: string,\n) {\n  return request<Conversion>(\"/api/conversions\", {\n    method: \"POST\",\n    token,\n    body: { direction, input },\n  });\n}\n\nexport function listConversions(token: string, page: number, pageSize: number) {\n  return request<ConversionPage>(\n    `/api/conversions?page=${page}&page_size=${pageSize}`,\n    { token },\n  );\n}\n\nexport function deleteConversion(token: string, id: string) {\n  return request<void>(`/api/conversions/${id}`, { method: \"DELETE\", token });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794359060123,"end":1794359060131}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8226694001nL9ui35CSjJJxJ","sessionID":"ses_e37dfdf0cffexbd0N5A13aSTGn","messageID":"msg_1c8224160001IOg77swEuo4D9l"}}
