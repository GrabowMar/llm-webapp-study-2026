{"type":"tool_use","timestamp":1794302159183,"sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","part":{"type":"tool","tool":"write","callID":"call_db63e418189e4352b4eee12f","state":{"status":"completed","input":{"content":"import { createContext, useContext, useEffect, useState } from \"react\";\nimport type { ReactNode } from \"react\";\nimport { api } from \"./api\";\nimport type { Auth } from \"./api\";\n\ninterface AuthContextValue {\n  auth: Auth | null;\n  isAdmin: boolean;\n  ready: boolean;\n  signIn: (username: string, password: string) => Promise<void>;\n  signUp: (username: string, password: string) => Promise<void>;\n  signOut: () => void;\n}\n\nconst AuthContext = createContext<AuthContextValue | null>(null);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [auth, setAuth] = useState<Auth | null>(() => {\n    try {\n      const raw = localStorage.getItem(\"quiz_auth\");\n      return raw ? (JSON.parse(raw) as Auth) : null;\n    } catch {\n      return null;\n    }\n  });\n  const [ready, setReady] = useState(false);\n\n  useEffect(() => {\n    if (!auth) {\n      setReady(true);\n      return;\n    }\n    let cancelled = false;\n    api\n      .me(auth.token)\n      .then((me) => {\n        if (!cancelled) setAuth({ username: me.username, token: auth.token, role: me.role });\n      })\n      .catch(() => {\n        if (!cancelled) setAuth(null);\n      })\n      .finally(() => {\n        if (!cancelled) setReady(true);\n      });\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  useEffect(() => {\n    if (auth) localStorage.setItem(\"quiz_auth\", JSON.stringify(auth));\n    else localStorage.removeItem(\"quiz_auth\");\n  }, [auth]);\n\n  const signIn = async (username: string, password: string) => {\n    const { token } = await api.login(username, password);\n    const me = await api.me(token);\n    setAuth({ username: me.username, token, role: me.role });\n  };\n\n  const signUp = async (username: string, password: string) => {\n    const { token } = await api.register(username, password);\n    setAuth({ username, token, role: \"user\" });\n  };\n\n  const value: AuthContextValue = {\n    auth,\n    isAdmin: auth?.role === \"admin\",\n    ready,\n    signIn,\n    signUp,\n    signOut: () => setAuth(null),\n  };\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n}\n\nexport function useAuth(): AuthContextValue {\n  const ctx = useContext(AuthContext);\n  if (!ctx) throw new Error(\"useAuth must be used within AuthProvider\");\n  return ctx;\n}\n","filePath":"/workspace/frontend/src/AuthContext.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AuthContext.tsx","exists":true,"truncated":false},"title":"frontend/src/AuthContext.tsx","time":{"start":1794302159160,"end":1794302159166}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4be2932001jaBHgQ1l6hS2PF","sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","messageID":"msg_1c4be0a69001H4eg7in7v6WUPz"}}
