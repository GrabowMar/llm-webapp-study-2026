{"type":"tool_use","timestamp":1794301412286,"sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","part":{"type":"tool","tool":"write","callID":"call_4a9a15159ac44c74b124055d","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point.\"\"\"\n\nimport json\nimport random\nimport re\nimport secrets\nfrom pathlib import Path\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\n\nimport db\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\n\nUSERNAME_RE = re.compile(r\"^[a-zA-Z0-9_.-]{3,64}$\")\nOPTION_LETTERS = (\"A\", \"B\", \"C\", \"D\")\nOPTION_KEYS = {\n    \"A\": \"option_a\",\n    \"B\": \"option_b\",\n    \"C\": \"option_c\",\n    \"D\": \"option_d\",\n}\n\n\ndef row_to_question(row, include_correct: bool):\n    q = {\n        \"id\": row[\"id\"],\n        \"text\": row[\"text\"],\n        \"option_a\": row[\"option_a\"],\n        \"option_b\": row[\"option_b\"],\n        \"option_c\": row[\"option_c\"],\n        \"option_d\": row[\"option_d\"],\n    }\n    if include_correct:\n        q[\"correct_option\"] = row[\"correct_option\"]\n    return q\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef current_user():\n    if \"user\" not in g:\n        header = request.headers.get(\"Authorization\", \"\")\n        g.user = None\n        if header.startswith(\"Bearer \"):\n            g.user = db.lookup_token(db.get_conn(), header[7:].strip())\n    return g.user\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        abort(jsonify({\"error\": \"Sign-in required\"}), 401)\n    return user\n\n\ndef require_admin():\n    user = require_user()\n    if user[\"role\"] != \"admin\":\n        abort(jsonify({\"error\": \"Admin access required\"}), 403)\n    return user\n\n\n@app.before_request\ndef _ensure_db():\n    db.init_db()\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = str(body.get(\"username\", \"\")).strip()\n    password = str(body.get(\"password\", \"\"))\n    errors = {}\n    if not USERNAME_RE.match(username):\n        errors[\"username\"] = \"Username must be 3-64 characters using letters, numbers, '.', '-' or '_'.\"\n    if username.lower() == \"admin\":\n        errors[\"username\"] = \"This username is reserved.\"\n    if len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters.\"\n    if errors:\n        return jsonify({\"error\": \"Validation failed\", \"fields\": errors}), 400\n    conn = db.get_conn()\n    if conn.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        conn.close()\n        return jsonify({\"error\": \"Username is already taken\"}), 409\n    user_id = secrets.token_hex(16)\n    with conn:\n        conn.execute(\n            \"INSERT INTO users (id, username, password_hash, role, created_at)\"\n            \" VALUES (?, ?, ?, 'user', ?)\",\n            (user_id, username, db.hash_password(password), db.now_iso()),\n        )\n    conn.close()\n    return jsonify({\"username\": username, \"token\": db.issue_token(user_id, db.hash_password(password))}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = str(body.get(\"username\", \"\")).strip()\n    password = str(body.get(\"password\", \"\"))\n    conn = db.get_conn()\n    row = conn.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    conn.close()\n    if row is None or not db.verify_password(password, row[\"password_hash\"]):\n        return jsonify({\"error\": \"Invalid username or password\"}), 401\n    return jsonify({\"username\": row[\"username\"], \"token\": db.issue_token(row[\"id\"], row[\"password_hash\"])}), 200\n\n\n@app.get(\"/api/quiz\")\ndef quiz():\n    raw = request.args.get(\"count\", \"5\")\n    try:\n        count = int(raw)\n    except (TypeError, ValueError):\n        return jsonify({\"error\": \"count must be an integer\"}), 400\n    count = max(1, min(count, 20))\n    conn = db.get_conn()\n    rows = conn.execute(\n        \"SELECT * FROM questions WHERE active = 1\"\n    ).fetchall()\n    conn.close()\n    if count > len(rows):\n        return jsonify({\"error\": f\"Only {len(rows)} questions are available\"}), 400\n    picked = random.sample(rows, count)\n    return jsonify({\"items\": [row_to_question(r, False) for r in picked]})\n\n\n@app.post(\"/api/attempts\")\ndef submit_attempt():\n    body = json_body()\n    answers = body.get(\"answers\")\n    if not isinstance(answers, list) or not answers:\n        return jsonify({\"error\": \"Provide a non-empty list of answers\"}), 400\n    seen: set[int] = set()\n    cleaned = []\n    for entry in answers:\n        if not isinstance(entry, dict):\n            return jsonify({\"error\": \"Each answer needs question_id and selected\"}), 400\n        try:\n            qid = int(entry.get(\"question_id\"))\n        except (TypeError, ValueError):\n            return jsonify({\"error\": \"Each answer needs question_id and selected\"}), 400\n        selected = str(entry.get(\"selected\", \"\")).strip().upper()\n        if selected not in OPTION_LETTERS:\n            return jsonify({\"error\": f\"Invalid answer for question {qid}\"}), 400\n        if qid in seen:\n            continue\n        seen.add(qid)\n        cleaned.append((qid, selected))\n    conn = db.get_conn()\n    rows = {}\n    for qid, _ in cleaned:\n        row = conn.execute(\"SELECT * FROM questions WHERE id = ?\", (qid,)).fetchone()\n        if row is None:\n            conn.close()\n            return jsonify({\"error\": f\"Question {qid} does not exist\"}), 400\n        rows[qid] = row\n    review = []\n    correct_count = 0\n    for qid, selected in cleaned:\n        row = rows[qid]\n        is_correct = selected == row[\"correct_option\"]\n        if is_correct:\n            correct_count += 1\n        item = row_to_question(row, True)\n        item[\"selected\"] = selected\n        item[\"is_correct\"] = is_correct\n        review.append(item)\n    total = len(review)\n    score = round(correct_count / total * 100, 1)\n    attempt = {\n        \"id\": None,\n        \"score\": score,\n        \"correct\": correct_count,\n        \"total_questions\": total,\n        \"submitted_at\": db.now_iso(),\n        \"answers\": review,\n    }\n    user = current_user()\n    if user is not None:\n        with conn:\n            cur = conn.execute(\n                \"INSERT INTO attempts (user_id, score, correct, total_questions, submitted_at, review)\"\n                \" VALUES (?, ?, ?, ?, ?, ?)\",\n                (user[\"id\"], score, correct_count, total, attempt[\"submitted_at\"], json.dumps(review)),\n            )\n            attempt[\"id\"] = cur.lastrowid\n    conn.close()\n    return jsonify(attempt), 201\n\n\ndef attempt_to_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"correct\": row[\"correct\"],\n        \"total_questions\": row[\"total_questions\"],\n        \"submitted_at\": row[\"submitted_at\"],\n        \"answers\": json.loads(row[\"review\"]),\n    }\n\n\n@app.get(\"/api/attempts\")\ndef list_attempts():\n    user = require_user()\n    conn = db.get_conn()\n    rows = conn.execute(\n        \"SELECT * FROM attempts WHERE user_id = ? ORDER BY submitted_at DESC, id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    conn.close()\n    return jsonify({\"items\": [attempt_to_json(r) for r in rows]})\n\n\n@app.get(\"/api/attempts/<int:attempt_id>\")\ndef get_attempt(attempt_id: int):\n    user = require_user()\n    conn = db.get_conn()\n    row = conn.execute(\n        \"SELECT * FROM attempts WHERE id = ? AND user_id = ?\", (attempt_id, user[\"id\"])\n    ).fetchone()\n    conn.close()\n    if row is None:\n        return jsonify({\"error\": \"Attempt not found\"}), 404\n    return jsonify(attempt_to_json(row))\n\n\n@app.post(\"/api/admin/questions\")\ndef admin_add_question():\n    require_admin()\n    body = json_body()\n    errors = {}\n    fields = {}\n    for name in (\"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\"):\n        value = str(body.get(name, \"\")).strip()\n        fields[name] = value\n        if not value:\n            errors[name] = \"This field is required.\"\n    correct = str(body.get(\"correct_option\", \"\")).strip().upper()\n    if correct not in OPTION_LETTERS:\n        errors[\"correct_option\"] = \"correct_option must be one of A, B, C or D.\"\n    if errors:\n        return jsonify({\"error\": \"Validation failed\", \"fields\": errors}), 400\n    conn = db.get_conn()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO questions (text, option_a, option_b, option_c, option_d,\"\n            \" correct_option, active, created_at) VALUES (?, ?, ?, ?, ?, ?, 1, ?)\",\n            (fields[\"text\"], fields[\"option_a\"], fields[\"option_b\"], fields[\"option_c\"],\n             fields[\"option_d\"], correct, db.now_iso()),\n        )\n        row = conn.execute(\"SELECT * FROM questions WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    conn.close()\n    return jsonify(row_to_question(row, True)), 201\n\n\n@app.get(\"/api/admin/questions\")\ndef admin_list_questions():\n    require_admin()\n    try:\n        page = int(request.args.get(\"page\", \"1\"))\n        page_size = int(request.args.get(\"page_size\", \"20\"))\n    except (TypeError, ValueError):\n        return jsonify({\"error\": \"page and page_size must be integers\"}), 400\n    page = max(1, page)\n    page_size = max(1, min(page_size, 100))\n    conn = db.get_conn()\n    total = conn.execute(\"SELECT COUNT(*) AS c FROM questions\").fetchone()[\"c\"]\n    rows = conn.execute(\n        \"SELECT * FROM questions ORDER BY id LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    conn.close()\n    return jsonify({\n        \"items\": [row_to_question(r, True) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    })\n\n\n@app.errorhandler(404)\ndef api_not_found(e):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"Not found\"}), 404\n    return e\n\n\n@app.errorhandler(405)\ndef api_not_allowed(e):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"Method not allowed\"}), 405\n    return e\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"Not found\"}), 404\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ndb.init_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(__import__(\"os\").environ.get(\"PORT\", \"8000\")), debug=False)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794301412257,"end":1794301412269}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4b2c39c001WPga7awtyklXYO","sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","messageID":"msg_1c4b21ef70016mk88940ZN5WpL"}}
