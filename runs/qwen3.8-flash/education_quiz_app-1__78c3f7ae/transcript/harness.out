{"type":"tool_use","timestamp":1794302145986,"sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","part":{"type":"tool","tool":"write","callID":"call_e4c56249a0444733b45078d2","state":{"status":"completed","input":{"content":"import { createContext, useContext, useEffect, useState } from \"react\";\nimport type { ReactNode } from \"react\";\nimport { api } from \"./api\";\nimport type { Auth } from \"./api\";\n\ninterface AuthContextValue {\n  auth: Auth | null;\n  isAdmin: boolean;\n  signIn: (username: string, password: string) => Promise<void>;\n  signUp: (username: string, password: string) => Promise<void>;\n  signOut: () => void;\n}\n\nconst AuthContext = createContext<AuthContextValue | null>(null);\nconst STORAGE_KEY = \"quiz_auth\";\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [auth, setAuth] = useState<Auth | null>(() => {\n    try {\n      const raw = localStorage.getItem(STORAGE_KEY);\n      return raw ? (JSON.parse(raw) as Auth) : null;\n    } catch {\n      return null;\n    }\n  });\n\n  useEffect(() => {\n    if (auth) localStorage.setItem(STORAGE_KEY, JSON.stringify(auth));\n    else localStorage.removeItem(STORAGE_KEY);\n  }, [auth]);\n\n  const signIn = async (username: string, password: string) => {\n    const res = await api.login(username, password);\n    setAuth({ username, token: res.token });\n  };\n\n  const signUp = async (username: string, password: string) => {\n    const res = await api.register(username, password);\n    setAuth({ username, token: res.token });\n  };\n\n  const value: AuthContextValue = {\n    auth,\n    isAdmin: auth?.username === \"admin\",\n    signIn,\n    signUp,\n    signOut: () => setAuth(null),\n  };\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n}\n\nexport function useAuth(): AuthContextValue {\n  const ctx = useContext(AuthContext);\n  if (!ctx) throw new Error(\"useAuth must be used within AuthProvider\");\n  return ctx;\n}\n","filePath":"/workspace/frontend/src/AuthContext.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AuthContext.tsx","exists":false,"truncated":false},"title":"frontend/src/AuthContext.tsx","time":{"start":1794302145958,"end":1794302145965}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4bdf59f001X0dotf4oAlaQcr","sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","messageID":"msg_1c4bddc0d001WZSOMhcw1Y4x2c"}}
