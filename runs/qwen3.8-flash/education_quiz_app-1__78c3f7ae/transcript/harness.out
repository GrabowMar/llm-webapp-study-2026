   return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":23,"totalLines":23,"truncated":false}},"title":"backend/app.py","time":{"start":1794301168129,"end":1794301168141}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4af09fa001lRv4qQb1aFMUm8","sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","messageID":"msg_1c4aef7f7001VbZ14MY553dIyB"}}
