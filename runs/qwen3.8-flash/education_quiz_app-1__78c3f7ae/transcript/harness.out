{"type":"tool_use","timestamp":1794301317473,"sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","part":{"type":"tool","tool":"write","callID":"call_f4132e10960543ab85b00bf8","state":{"status":"completed","input":{"filePath":"/workspace/backend/db.py","content":"\"\"\"SQLite access and seeding.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom itsdangerous import BadSignature, SignatureExpired, URLSafeTimedSerializer\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"./data\")).resolve()\nDB_PATH = DATA_DIR / \"quiz.db\"\nSECRET_PATH = DATA_DIR / \"secret.key\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id TEXT PRIMARY KEY,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS questions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    text TEXT NOT NULL,\n    option_a TEXT NOT NULL,\n    option_b TEXT NOT NULL,\n    option_c TEXT NOT NULL,\n    option_d TEXT NOT NULL,\n    correct_option TEXT NOT NULL CHECK (correct_option IN ('A','B','C','D')),\n    active INTEGER NOT NULL DEFAULT 1,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS attempts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id TEXT NOT NULL,\n    score REAL NOT NULL,\n    correct INTEGER NOT NULL,\n    total_questions INTEGER NOT NULL,\n    submitted_at TEXT NOT NULL,\n    review TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_attempts_user ON attempts (user_id, submitted_at DESC);\n\"\"\"\n\nSEED_QUESTIONS = [\n    (\"What is the capital of France?\", \"Berlin\", \"Madrid\", \"Paris\", \"Rome\", \"C\"),\n    (\"Which planet is known as the Red Planet?\", \"Venus\", \"Mars\", \"Jupiter\", \"Saturn\", \"B\"),\n    (\"How many continents are there on Earth?\", \"5\", \"6\", \"7\", \"8\", \"C\"),\n    (\"What is the largest ocean on Earth?\", \"Atlantic\", \"Indian\", \"Arctic\", \"Pacific\", \"D\"),\n    (\"Who wrote the play 'Romeo and Juliet'?\", \"Charles Dickens\", \"William Shakespeare\", \"Mark Twain\", \"Jane Austen\", \"B\"),\n    (\"What is the chemical symbol for gold?\", \"Go\", \"Gd\", \"Au\", \"Ag\", \"C\"),\n    (\"Which country is home to the kangaroo?\", \"New Zealand\", \"Australia\", \"South Africa\", \"Brazil\", \"B\"),\n    (\"What is the tallest mountain in the world?\", \"K2\", \"Kangchenjunga\", \"Mount Everest\", \"Lhotse\", \"C\"),\n    (\"How many sides does a hexagon have?\", \"5\", \"6\", \"7\", \"8\", \"B\"),\n    (\"What is the boiling point of water at sea level in Celsius?\", \"90\", \"95\", \"100\", \"110\", \"C\"),\n    (\"Which gas do plants primarily absorb for photosynthesis?\", \"Oxygen\", \"Nitrogen\", \"Carbon dioxide\", \"Hydrogen\", \"C\"),\n    (\"What is the smallest prime number?\", \"0\", \"1\", \"2\", \"3\", \"C\"),\n    (\"In which year did the First World War end?\", \"1916\", \"1917\", \"1918\", \"1920\", \"C\"),\n    (\"What is the longest river in Africa?\", \"Amazon\", \"Nile\", \"Mississippi\", \"Ganges\", \"B\"),\n    (\"How many players are on a basketball team on the court?\", \"4\", \"5\", \"6\", \"7\", \"B\"),\n    (\"What is the currency of Japan?\", \"Won\", \"Yuan\", \"Yen\", \"Ringgit\", \"C\"),\n    (\"Which organ in the human body pumps blood?\", \"Liver\", \"Heart\", \"Lungs\", \"Kidney\", \"B\"),\n    (\"What is the largest desert in the world?\", \"Sahara\", \"Gobi\", \"Antarctic\", \"Kalahari\", \"C\"),\n    (\"How many strings does a standard guitar have?\", \"4\", \"5\", \"6\", \"7\", \"C\"),\n    (\"Which element has the atomic number 1?\", \"Helium\", \"Oxygen\", \"Carbon\", \"Hydrogen\", \"D\"),\n    (\"What is the capital of Canada?\", \"Toronto\", \"Ottawa\", \"Vancouver\", \"Montreal\", \"B\"),\n    (\"Who painted the Mona Lisa?\", \"Vincent van Gogh\", \"Pablo Picasso\", \"Leonardo da Vinci\", \"Michelangelo\", \"C\"),\n]\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _get_secret() -> str:\n    env = os.environ.get(\"SECRET_KEY\", \"\").strip()\n    if env:\n        return env\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    if SECRET_PATH.exists():\n        return SECRET_PATH.read_text().strip()\n    secret = secrets.token_hex(32)\n    SECRET_PATH.write_text(secret)\n    return secret\n\n\ndef get_secret() -> str:\n    return _get_secret()\n\n\ndef get_conn() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    with get_conn() as conn:\n        conn.executescript(SCHEMA)\n        count = conn.execute(\"SELECT COUNT(*) AS c FROM questions\").fetchone()[\"c\"]\n        if count == 0:\n            ts = now_iso()\n            conn.executemany(\n                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option, active, created_at)\"\n                \" VALUES (?, ?, ?, ?, ?, ?, 1, ?)\",\n                SEED_QUESTIONS_TS(ts),\n            )\n\n\ndef SEED_QUESTIONS_TS(ts: str):\n    return [row + (ts,) for row in SEED_QUESTIONS]\n\n\ndef make_serializer() -> URLSafeTimedSerializer:\n    return URLSafeTimedSerializer(get_secret(), salt=\"quiz-auth\")\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib_pbkdf2(password, salt)\n    return f\"{salt}${digest}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt, digest = stored.split(\"$\", 1)\n    except ValueError:\n        return False\n    return secrets.compare_digest(digest, hashlib_pbkdf2(password, salt))\n\n\ndef hashlib_pbkdf2(password: str, salt: str) -> str:\n    import hashlib\n\n    dk = hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt.encode(), 200_000)\n    return dk.hex()\n\n\ndef issue_token(user_id: str) -> str:\n    return make_serializer().dumps({\"uid\": user_id})\n\n\ndef lookup_user(token: str) -> str | None:\n    try:\n        data = make_serializer().loads(token, max_age=60 * 60 * 24 * 30)\n    except (BadSignature, SignatureExpired):\n        return None\n    if not isinstance(data, dict):\n        return None\n    return data.get(\"uid\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/db.py","exists":false,"truncated":false},"title":"backend/db.py","time":{"start":1794301317441,"end":1794301317455}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4b1513a001IqHa8rx7ksaq5h","sessionID":"ses_e3b522ba6ffemzClIGyyzFrLmZ","messageID":"msg_1c4b0b8ef001WCSGn3q50BMMhQ"}}
