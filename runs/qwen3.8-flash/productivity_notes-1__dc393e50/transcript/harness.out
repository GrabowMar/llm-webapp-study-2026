le>\\n<h1>Internal Server Error</h1>\\n<p>The server encountered an internal error and was unable to complete your request. Either the server is overloaded or there is an error in the application.</p>\\n')\nFAIL duplicate username 422 (500, b'<!doctype html>\\n<html lang=en>\\n<title>500 Internal Server Error</title>\\n<h1>Internal Server Error</h1>\\n<p>The server encountered an internal error and was unable to complete your request. Either the server is overloaded or there is an error in the application.</p>\\n')\nPASS bad login 401\nFAIL login alice 200+token (401, {'error': 'invalid username or password'})\nTraceback (most recent call last):\n  File \"/workspace/apitest.py\", line 58, in <module>\n    ta = b[\"token\"]\n         ~^^^^^^^^^\nKeyError: 'token'\n","exit":0,"truncated":false},"title":"cd /workspace && python3 apitest.py 2>&1 | tail -15","time":{"start":1794370934378,"end":1794370934547}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8d79663001YD3dGsLFNoH1da","sessionID":"ses_e3735c97dffe23yhVjmp2SDNBR","messageID":"msg_1c8d78720001aviCT2m7qA6W0a"}}
