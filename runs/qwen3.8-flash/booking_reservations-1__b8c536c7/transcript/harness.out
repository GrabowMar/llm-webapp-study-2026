{"type":"tool_use","timestamp":1794326502056,"sessionID":"ses_e39d791dbffedR0nf9BbB726GN","part":{"type":"tool","tool":"write","callID":"call_6976c24e94c9409b80b0e2da","state":{"status":"completed","input":{"content":"import { FormEvent, useState } from \"react\";\nimport { ApiError, api } from \"../api\";\n\nexport default function AuthPanel({\n  onSignedIn,\n}: {\n  onSignedIn: (username: string, token: string) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [info, setInfo] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setInfo(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api.register(username, password);\n        setInfo(\"Account created — you can sign in now.\");\n        setMode(\"login\");\n      } else {\n        const { token } = await api.login(username, password);\n        onSignedIn(username, token);\n      }\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto mt-10 max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"text-lg font-semibold text-slate-800\">\n        {mode === \"login\" ? \"Sign in\" : \"Create an account\"}\n      </h2>\n      <p className=\"mt-1 text-sm text-slate-500\">\n        {mode === \"login\"\n          ? \"Book, change and cancel your table reservations.\"\n          : \"Pick a username and password to start booking tables.\"}\n      </p>\n      <form onSubmit={submit} className=\"mt-4 space-y-3\">\n        <input\n          className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none\"\n          placeholder=\"Username\"\n          value={username}\n          onChange={(e) => setUsername(e.target.value)}\n          required\n        />\n        <input\n          type=\"password\"\n          className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none\"\n          placeholder=\"Password\"\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          required\n        />\n        {error && (\n          <p className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">{error}</p>\n        )}\n        {info && (\n          <p className=\"rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-700\">\n            {info}\n          </p>\n        )}\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50\"\n        >\n          {busy ? \"Working…\" : mode === \"login\" ? \"Sign in\" : \"Register\"}\n        </button>\n      </form>\n      <p className=\"mt-3 text-center text-sm text-slate-500\">\n        {mode === \"login\" ? (\n          <>\n            No account?{\" \"}\n            <button\n              className=\"font-medium text-indigo-600 hover:underline\"\n              onClick={() => {\n                setMode(\"register\");\n                setError(null);\n              }}\n            >\n              Register\n            </button>\n          </>\n        ) : (\n          <>\n            Already registered?{\" \"}\n            <button\n              className=\"font-medium text-indigo-600 hover:underline\"\n              onClick={() => {\n                setMode(\"login\");\n                setError(null);\n              }}\n            >\n              Sign in\n            </button>\n          </>\n        )}\n      </p>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AuthPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AuthPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AuthPanel.tsx","time":{"start":1794326502019,"end":1794326502030}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6319a7c0017MMCqGXSLwZkeG","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","messageID":"msg_1c6316134001YgzP7a4ILWw1fJ"}}
