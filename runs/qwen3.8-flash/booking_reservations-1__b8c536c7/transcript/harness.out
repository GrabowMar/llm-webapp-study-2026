{"type":"tool_use","timestamp":1794326546184,"sessionID":"ses_e39d791dbffedR0nf9BbB726GN","part":{"type":"tool","tool":"write","callID":"call_e97d854eb6424d2b9655b240","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { Reservation } from \"../api\";\n\nexport default function MyReservations({\n  groups,\n  loading,\n  error,\n  onEdit,\n  onCancel,\n  editingId,\n}: {\n  groups: [string, Reservation[]][];\n  loading: boolean;\n  error: string | null;\n  onEdit: (r: Reservation) => void;\n  onCancel: (r: Reservation) => Promise<void>;\n  editingId: number | null;\n}) {\n  const [confirming, setConfirming] = useState<Reservation | null>(null);\n  const [cancelError, setCancelError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function confirmCancel() {\n    if (!confirming) return;\n    setBusy(true);\n    setCancelError(null);\n    try {\n      await onCancel(confirming);\n      setConfirming(null);\n    } catch (err) {\n      setCancelError(err instanceof Error ? err.message : \"Could not cancel.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\">\n      <h2 className=\"text-lg font-semibold text-slate-800\">My reservations</h2>\n      {error && (\n        <p className=\"mt-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">{error}</p>\n      )}\n      {loading && <p className=\"mt-3 text-sm text-slate-500\">Loading…</p>}\n      {!loading && groups.length === 0 && !error && (\n        <p className=\"mt-3 text-sm text-slate-500\">\n          You have no reservations yet. Book a table using the form above.\n        </p>\n      )}\n      {!loading &&\n        groups.map(([date, items]) => (\n          <div key={date} className=\"mt-4\">\n            <h3 className=\"text-sm font-semibold uppercase tracking-wide text-slate-500\">\n              {date}\n            </h3>\n            <ul className=\"mt-2 space-y-2\">\n              {items.map((r) => (\n                <li\n                  key={r.id}\n                  className={`rounded-lg border p-3 text-sm ${\n                    editingId === r.id\n                      ? \"border-indigo-400 bg-indigo-50\"\n                      : \"border-slate-200 bg-slate-50\"\n                  }`}\n                >\n                  <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                    <div>\n                      <span className=\"font-semibold text-slate-800\">{r.time}</span>\n                      <span className=\"ml-2 text-slate-600\">\n                        {r.party_size} guest{r.party_size === 1 ? \"\" : \"s\"}\n                      </span>\n                      <p className=\"text-slate-500\">\n                        {r.name} · {r.email}\n                      </p>\n                      {r.notes && <p className=\"italic text-slate-400\">“{r.notes}”</p>}\n                    </div>\n                    <div className=\"flex gap-2\">\n                      <button\n                        onClick={() => onEdit(r)}\n                        className=\"rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-white\"\n                      >\n                        {editingId === r.id ? \"Editing\" : \"Edit\"}\n                      </button>\n                      <button\n                        onClick={() => {\n                          setConfirming(r);\n                          setCancelError(null);\n                        }}\n                        className=\"rounded-md border border-red-200 px-3 py-1 text-xs font-medium text-red-600 hover:bg-red-50\"\n                      >\n                        Cancel\n                      </button>\n                    </div>\n                  </div>\n                </li>\n              ))}\n            </ul>\n          </div>\n        ))}\n\n      {confirming && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4\">\n          <div className=\"w-full max-w-sm rounded-xl bg-white p-5 shadow-lg\">\n            <h3 className=\"text-base font-semibold text-slate-800\">\n              Cancel this reservation?\n            </h3>\n            <p className=\"mt-2 text-sm text-slate-600\">\n              {confirming.party_size} guest{confirming.party_size === 1 ? \"\" : \"s\"} on{\" \"}\n              {confirming.date} at {confirming.time}. The seats will be freed.\n            </p>\n            {cancelError && (\n              <p className=\"mt-2 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">\n                {cancelError}\n              </p>\n            )}\n            <div className=\"mt-4 flex justify-end gap-2\">\n              <button\n                onClick={() => setConfirming(null)}\n                className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50\"\n              >\n                Keep it\n              </button>\n              <button\n                onClick={confirmCancel}\n                disabled={busy}\n                className=\"rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50\"\n              >\n                {busy ? \"Cancelling…\" : \"Yes, cancel\"}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/MyReservations.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/MyReservations.tsx","exists":false,"truncated":false},"title":"frontend/src/components/MyReservations.tsx","time":{"start":1794326546160,"end":1794326546167}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c63246ea001LM8vu9WZvPstVM","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","messageID":"msg_1c631fa5