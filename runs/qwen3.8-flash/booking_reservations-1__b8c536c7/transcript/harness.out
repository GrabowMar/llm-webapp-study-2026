s', headers=h); print('list', r.status_code, r.get_json()['total'])\nr = c.get('/api/reservations?date=2026-01-01', headers=h); print('list filtered', r.get_json()['total'])\nr = c.get(f'/api/reservations/{rid}', headers=h); print('get', r.status_code, r.get_json())\nr = c.get('/api/availability?date=2026-01-01'); print('avail anon', r.status_code, r.get_json())\nr = c.post('/api/auth/login', json={'username':'bob','password':'pw2'}); btok = r.get_json()['token']; bh={'Authorization':f'Bearer {btok}'}\nr = c.get(f'/api/reservations/{rid}', headers=bh); print('bob get alice', r.status_code)\nr = c.put(f'/api/reservations/{rid}', json={'name':'B','email':'b@x.com','date':'2026-01-01','time':'18:00','party_size':1}, headers=bh); print('bob put alice', r.status_code)\nr = c.delete(f'/api/reservations/{rid}', headers=bh); print('bob del alice', r.status_code)\nr = c.post('/api/reservations', json={'name':'Bob','email':'b@x.com','date':'2026-01-01','time':'18:00','party_size':16}, headers=bh); print('16 fits', r.status_code)\nbid = r.get_json()['id']\nr = c.post('/api/reservations', json={'name':'Bob','email':'b@x.com','date':'2026-01-01','time':'18:00','party_size':1}, headers=bh); print('over', r.status_code, r.get_json())\nr = c.get('/api/availability?date=2026-01-01'); print('avail', r.get_json())\nr = c.put(f'/api/reservations/{rid}', json={'name':'Alice','email':'a@x.com','date':'2026-01-01','time':'18:00','party_size':4}, headers=h); print('put shrink', r.status_code, r.get_json()['party_size'])\nr = c.put(f'/api/reservations/{rid}', json={'name':'Alice','email':'a@x.com','date':'2026-01-01','time':'18:00','party_size':5}, headers=h); print('put no double count', r.status_code)\nr = c.put(f'/api/reservations/{rid}', json={'name':'Alice','email':'a@x.com','date':'2026-01-01','time':'18:00','party_size':7}, headers=h); print('put over', r.status_code, r.get_json()['message'])\nr = c.put(f'/api/reservations/{rid}', json={'name':'Alice2','email':'a@x.com','date':'2026-01-02','time':'12:00','party_size':2}, headers=h); print('put move+clear notes', r.status_code, r.get_json()['notes']=='' )\nr = c.delete(f'/api/reservations/{bid}', headers=bh); print('del', r.status_code, r.get_json())\nr = c.get('/api/availability?date=2026-01-01'); print('avail after del', r.get_json())\nr = c.get('/api/admin/reservations', headers=h); print('admin as alice', r.status_code)\nr = c.get('/api/admin/reservations', headers=bh); print('admin as bob', r.status_code)\nr = c.get('/api/reservations/9999', headers=h); print('missing', r.status_code)\nr = c.get('/api/availability'); print('avail nodate', r.status_code)\nr = c.post('/api/reservations', json={'name':'Bob','email':'bad','date':'2026-1-1','time':'25:00','party_size':0}, headers=bh); print('invalid', r.status_code, r.get_json())\n\"\n"},"error":"The user has specified a rule which prevents you from using this specific tool call. Here are some of the relevant rules [{\"permission\":\"*\",\"action\":\"allow\",\"pattern\":\"*\"},{\"permission\":\"external_directory\",\"pattern\":\"*\",\"action\":\"ask\"},{\"permission\":\"external_directory\",\"pattern\":\"/run/home/.local/share/opencode/tool-output/*\",\"action\":\"allow\"},{\"permission\":\"external_directory\",\"pattern\":\"/tmp/opencode/*\",\"action\":\"allow\"},{\"permission\":\"external_directory\",\"action\":\"deny\",\"pattern\":\"*\"},{\"permission\":\"external_directory\",\"pattern\":\"/run/home/.local/share/opencode/tool-output/*\",\"action\":\"allow\"}]","time":{"start":1794326353238,"end":1794326353244}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c62f554e0015X850gwgfW3UrO","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","messageID":"msg_1c62f06f4001fVX6mXnwgT6hu7"}}
