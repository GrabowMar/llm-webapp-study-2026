{"type":"step_start","timestamp":1794326563898,"sessionID":"ses_e39d791dbffedR0nf9BbB726GN","part":{"id":"prt_1c6328c26001aFT5QtRkzdsvB0","messageID":"msg_1c6324703001o3oxiYYoE67QyW","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","type":"step-start"}}
{"type":"tool_use","timestamp":1794326563920,"sessionID":"ses_e39d791dbffedR0nf9BbB726GN","part":{"type":"tool","tool":"write","callID":"call_23d1fb8cd70942e19f7687a8","state":{"status":"completed","input":{"content":"import { Reservation } from \"../api\";\n\nexport default function AdminPanel({\n  date,\n  items,\n  total,\n  page,\n  pageSize,\n  loading,\n  error,\n  onPage,\n}: {\n  date: string;\n  items: Reservation[];\n  total: number;\n  page: number;\n  pageSize: number;\n  loading: boolean;\n  error: string | null;\n  onPage: (p: number) => void;\n}) {\n  const guests = items.reduce((sum, r) => sum + r.party_size, 0);\n  const pages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <div className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\">\n      <div className=\"flex flex-wrap items-baseline justify-between gap-2\">\n        <h2 className=\"text-lg font-semibold text-slate-800\">\n          Admin · all reservations on {date}\n        </h2>\n        <p className=\"text-sm text-slate-500\">\n          <span className=\"font-semibold text-slate-700\">{total}</span> reservation\n          {total === 1 ? \"\" : \"s\"} ·{\" \"}\n          <span className=\"font-semibold text-slate-700\">{guests}</span> guest\n          {guests === 1 ? \"\" : \"s\"} (this page)\n        </p>\n      </div>\n      {error && (\n        <p className=\"mt-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">{error}</p>\n      )}\n      {loading && <p className=\"mt-3 text-sm text-slate-500\">Loading…</p>}\n      {!loading && items.length === 0 && !error && (\n        <p className=\"mt-3 text-sm text-slate-500\">No reservations on this day.</p>\n      )}\n      {!loading && items.length > 0 && (\n        <div className=\"mt-3 overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead>\n              <tr className=\"border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500\">\n                <th className=\"py-2 pr-4\">Time</th>\n                <th className=\"py-2 pr-4\">Name</th>\n                <th className=\"py-2 pr-4\">Email</th>\n                <th className=\"py-2 pr-4\">User</th>\n                <th className=\"py-2 pr-4\">Guests</th>\n                <th className=\"py-2 pr-4\">Notes</th>\n                <th className=\"py-2 pr-4\">Booked</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {items.map((r) => (\n                <tr key={r.id}>\n                  <td className=\"py-2 pr-4 font-medium text-slate-700\">{r.time}</td>\n                  <td className=\"py-2 pr-4\">{r.name}</td>\n                  <td className=\"py-2 pr-4 text-slate-500\">{r.email}</td>\n                  <td className=\"py-2 pr-4 text-slate-500\">#{r.id}</td>\n                  <td className=\"py-2 pr-4\">{r.party_size}</td>\n                  <td className=\"py-2 pr-4 italic text-slate-400\">{r.notes || \"—\"}</td>\n                  <td className=\"py-2 pr-4 text-xs text-slate-400\">{r.created_at}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n      {pages > 1 && (\n        <div className=\"mt-3 flex items-center justify-end gap-2 text-sm\">\n          <button\n            disabled={page <= 1}\n            onClick={() => onPage(page - 1)}\n            className=\"rounded-md border border-slate-300 px-3 py-1 disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <span className=\"text-slate-500\">\n            Page {page} of {pages}\n          </span>\n          <button\n            disabled={page >= pages}\n            onClick={() => onPage(page + 1)}\n            className=\"rounded-md border border-slate-300 px-3 py-1 disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AdminPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AdminPanel.tsx","time":{"start":1794326563891,"end":1794326563902}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6328c29001ZCJnpQL8zhfqUE","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","messageID":"msg_1c6324703001o3oxiYYoE67QyW"}}
