{"type":"tool_use","timestamp":1794326478718,"sessionID":"ses_e39d791dbffedR0nf9BbB726GN","part":{"type":"tool","tool":"write","callID":"call_fb1eb534caaa4d4ebcb7968b","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\n\nexport type Reservation = {\n  id: number;\n  name: string;\n  email: string;\n  date: string;\n  time: string;\n  party_size: number;\n  notes: string;\n  created_at: string;\n};\n\nexport type Slot = { time: string; booked: number; remaining: number };\n\nconst TOKEN_KEY = \"reservations.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nexport class ApiError extends Error {}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string>),\n  };\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(`/api${path}`, { ...options, headers });\n  let body: any = null;\n  try {\n    body = await res.json();\n  } catch {\n    /* empty body */\n  }\n  if (!res.ok) {\n    if (res.status === 401) setToken(null);\n    const message =\n      (body && (body.message || body.error)) || `Request failed (${res.status}).`;\n    throw new ApiError(message);\n  }\n  return body as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ message?: string }>(\"/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  createReservation: (data: Partial<Reservation>) =>\n    request<Reservation>(\"/reservations\", {\n      method: \"POST\",\n      body: JSON.stringify(data),\n    }),\n  listReservations: (date?: string) =>\n    request<{ items: Reservation[]; total: number }>(\n      `/reservations${date ? `?date=${encodeURIComponent(date)}` : \"\"}`\n    ),\n  updateReservation: (id: number, data: Partial<Reservation>) =>\n    request<Reservation>(`/reservations/${id}`, {\n      method: \"PUT\",\n      body: JSON.stringify(data),\n    }),\n  deleteReservation: (id: number) =>\n    request<{ message: string }>(`/reservations/${id}`, { method: \"DELETE\" }),\n  availability: (date: string) =>\n    request<{ items: Slot[] }>(`/availability?date=${encodeURIComponent(date)}`),\n  adminReservations: (date: string, page = 1, pageSize = 20) =>\n    request<{ items: Reservation[]; total: number; page: number; page_size: number }>(\n      `/admin/reservations?date=${encodeURIComponent(date)}&page=${page}&page_size=${pageSize}`\n    ),\n};\n\nexport function useSession() {\n  const [username, setUsername] = useState<string | null>(() => {\n    return localStorage.getItem(\"reservations.username\");\n  });\n  useEffect(() => {\n    if (!getToken() && username) setUsername(null);\n  }, []);\n  const signIn = (user: string, token: string) => {\n    setToken(token);\n    localStorage.setItem(\"reservations.username\", user);\n    setUsername(user);\n  };\n  const signOut = () => {\n    setToken(null);\n    localStorage.removeItem(\"reservations.username\");\n    setUsername(null);\n  };\n  return { username, isAdmin: username === \"admin\", signIn, signOut };\n}\n\nexport function today(): string {\n  return new Date().toISOString().slice(0, 10);\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794326478675,"end":1794326478692}},"id":"prt_1c6313f4e001v3O5Hiowqe7zJp","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","messageID":"msg_1c630f640001ScAkpxioSMcto8"}}
{"type":"tool_use","timestamp":1794326478718,"sessionID":"ses_e39d791dbffedR0nf9BbB726GN","part":{"type":"tool","tool":"write","callID":"call_a742d52efcf94d3c8cd59124","state":{"status":"completed","input":{"content":"import tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\n","filePath":"/workspace/frontend/vite.config.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/vite.config.ts","exists":true,"truncated":false},"title":"frontend/vite.config.ts","time":{"start":1794326478660,"end":1794326478697}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6313f3e001tQZix4Py7cwp4w","sessionID":"ses_e39d791dbffedR0nf9BbB726GN","messageID":"msg_1c630f640001ScAkpxioSMcto8"}}
