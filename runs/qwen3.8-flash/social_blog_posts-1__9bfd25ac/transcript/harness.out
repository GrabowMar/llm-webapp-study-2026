{"type":"tool_use","timestamp":1794367244291,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"type":"tool","tool":"write","callID":"call_4fe93d367b2d4befa02bb50a","state":{"status":"completed","input":{"content":"import { useAuth } from \"../auth\";\n\nexport function TagPill({\n  tag,\n  onClick,\n  active,\n}: {\n  tag: string;\n  onClick?: () => void;\n  active?: boolean;\n}) {\n  const base =\n    \"inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium \" +\n    (active\n      ? \"border-emerald-600 bg-emerald-600 text-white\"\n      : \"border-emerald-200 bg-emerald-50 text-emerald-700\");\n  if (onClick) {\n    return (\n      <button type=\"button\" onClick={onClick} className={`${base} hover:bg-emerald-100`}>\n        #{tag}\n      </button>\n    );\n  }\n  return <span className={base}>#{tag}</span>;\n}\n\nexport function formatDate(iso: string): string {\n  const date = new Date(iso);\n  if (Number.isNaN(date.getTime())) return iso;\n  return date.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n  });\n}\n\nexport function ErrorBanner({ message, onDismiss }: { message: string; onDismiss?: () => void }) {\n  if (!message) return null;\n  return (\n    <div className=\"flex items-center justify-between gap-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\">\n      <span>{message}</span>\n      {onDismiss && (\n        <button type=\"button\" onClick={onDismiss} className=\"text-red-400 hover:text-red-600\">\n          ✕\n        </button>\n      )}\n    </div>\n  );\n}\n\nconst inputClass =\n  \"w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm outline-none placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200\";\n\nexport { inputClass };\n\nexport function Header({ onNavigate }: { onNavigate: (to: string) => void }) {\n  const { user, signOut } = useAuth();\n  return (\n    <header className=\"sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur\">\n      <div className=\"mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3\">\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\"/\")}\n          className=\"text-lg font-bold tracking-tight text-slate-900\"\n        >\n          Multi<span className=\"text-emerald-600\">Blog</span>\n        </button>\n        <nav className=\"flex items-center gap-2 text-sm\">\n          {user ? (\n            <>\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\"/new\")}\n                className=\"rounded-md bg-emerald-600 px-3 py-1.5 font-medium text-white shadow-sm hover:bg-emerald-700\"\n              >\n                New post\n              </button>\n              <span className=\"hidden font-medium text-slate-500 sm:inline\">\n                {user.username}\n                {user.is_admin && (\n                  <span className=\"ml-1 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-semibold text-amber-700\">\n                    admin\n                  </span>\n                )}\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  signOut();\n                  onNavigate(\"/\");\n                }}\n                className=\"rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-50\"\n              >\n                Sign out\n              </button>\n            </>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\"/login\")}\n              className=\"rounded-md bg-emerald-600 px-3 py-1.5 font-medium text-white shadow-sm hover:bg-emerald-700\"\n            >\n              Sign in\n            </button>\n          )}\n        </nav>\n      </div>\n    </header>\n  );\n}\n","filePath":"/workspace/frontend/src/components/ui.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/ui.tsx","exists":false,"truncated":false},"title":"frontend/src/components/ui.tsx","time":{"start":1794367244253,"end":1794367244266}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c89f47d6001PO7PaUrEdRxu6h","sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","messageID":"msg_1c89eefe1001J5ke7sms9u4Akf"}}
