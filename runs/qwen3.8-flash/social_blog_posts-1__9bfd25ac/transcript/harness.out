{"type":"tool_use","timestamp":1794366932458,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"type":"tool","tool":"bash","callID":"call_a0b85a637dae4c3387d635b3","state":{"status":"completed","input":{"command":"cat > /tmp/apitest.sh <<'EOF'\nset -e\nB=http://localhost:8000/api\npass=0; fail=0\ncheck() { # desc expected actual\n  if [ \"$2\" == \"$3\" ]; then pass=$((pass+1)); echo \"PASS: $1\"; else fail=$((fail+1)); echo \"FAIL: $1 (expected $2, got $3)\"; fi\n}\n\n# register\nR=$(curl -s -w '\\n%{http_code}' -X POST $B/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"secret123\"}')\ncheck \"register alice 201\" \"201\" \"$(echo \"$R\"|tail -1)\"\nR=$(curl -s -w '\\n%{http_code}' -X POST $B/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"secret123\"}')\ncheck \"duplicate register 409\" \"409\" \"$(echo \"$R\"|tail -1)\"\nR=$(curl -s -w '\\n%{http_code}' -X POST $B/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"ab\",\"password\":\"secret123\"}')\ncheck \"short username 400\" \"400\" \"$(echo \"$R\"|tail -1)\"\nR=$(curl -s -w '\\n%{http_code}' -X POST $B/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"bob\",\"password\":\"123\"}')\ncheck \"short password 400\" \"400\" \"$(echo \"$R\"|tail -1)\"\n\n# login\nTOK=$(curl -s -X POST $B/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"secret123\"}' | python3 -c 'import sys,json;print(json.load(sys.stdin).get(\"token\",\"\"))')\n[ -n \"$TOK\" ] && check \"alice login token\" \"y\" \"y\" || check \"alice login token\" \"y\" \"n\"\nTOKB=$(curl -s -X POST $B/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"bob\",\"password\":\"secret123\"}' | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get(\"token\") or \"\")')\ncurl -s -X POST $B/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"bob\",\"password\":\"secret123\"}' >/dev/null\nTOKB=$(curl -s -X POST $B/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"bob\",\"password\":\"secret123\"}' | python3 -c 'import sys,json;print(json.load(sys.stdin).get(\"token\",\"\"))')\nATOK=$(curl -s -X POST $B/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"adminpw\"}' | python3 -c 'import sys,json;print(json.load(sys.stdin).get(\"token\",\"\"))')\n[ -n \"$ATOK\" ] && check \"admin login\" \"y\" \"y\" || check \"admin login\" \"y\" \"n\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"wrong\"}')\ncheck \"admin bad pw 401\" \"401\" \"$CODE\"\n\n# create without auth\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/posts -H 'Content-Type: application/json' -d '{\"title\":\"t\",\"content\":\"c\"}')\ncheck \"create unauth 401\" \"401\" \"$CODE\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/posts -H \"Authorization: Bearer garbage\" -H 'Content-Type: application/json' -d '{\"title\":\"t\",\"content\":\"c\"}')\ncheck \"create bad token 401\" \"401\" \"$CODE\"\n\n# validation\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/posts -H \"Authorization: Bearer $TOK\" -H 'Content-Type: application/json' -d '{\"title\":\"\",\"content\":\"c\"}')\ncheck \"empty title 400\" \"400\" \"$CODE\"\n\n# create posts\nP1=$(curl -s -X POST $B/posts -H \"Authorization: Bearer $TOK\" -H 'Content-Type: application/json' -d '{\"title\":\"First post\",\"content\":\"line one\\nline two is here and some more content padding padding padding to exceed two hundred characters for excerpt testing purposes indeed we keep going and going and going to make sure it is long enough yes\",\"tags\":[\"python\",\"web\"]}')\nID1=$(echo \"$P1\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"id\"])')\nEX=$(echo \"$P1\"|python3 -c 'import sys,json;print(len(json.load(sys.stdin)[\"excerpt\"]))')\ncheck \"excerpt 200 chars\" \"200\" \"$EX\"\nNL=$(echo \"$P1\"|python3 -c 'import sys,json;print(\"\\n\" in json.load(sys.stdin)[\"excerpt\"])')\ncheck \"excerpt no newlines\" \"False\" \"$NL\"\ncurl -s -X POST $B/posts -H \"Authorization: Bearer $TOKB\" -H 'Content-Type: application/json' -d '{\"title\":\"Second post\",\"content\":\"bob wrote this about cooking\",\"tags\":[\"food\"]}' >/dev/null\n\n# list\nL=$(curl -s \"$B/posts\")\nORDER=$(echo \"$L\"|python3 -c 'import sys,json;print(\",\".join(i[\"title\"] for i in json.load(sys.stdin)[\"items\"]))')\ncheck \"newest first\" \"Second post,First post\" \"$ORDER\"\nTOTAL=$(echo \"$L\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"total\"])')\ncheck \"total 2\" \"2\" \"$TOTAL\"\nKEYS=$(echo \"$L\"|python3 -c 'import sys,json;print(sorted(json.load(sys.stdin).keys()))')\ncheck \"list keys\" \"['items', 'page', 'page_size', 'total']\" \"$KEYS\"\n\n# filters\nQ=$(curl -s \"$B/posts?q=bob\"|python3 -c 'import sys,json;print(len(json.load(sys.stdin)[\"items\"]))')\ncheck \"q filter\" \"1\" \"$Q\"\nTG=$(curl -s \"$B/posts?tag=Python\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"items\"][0][\"title\"])')\ncheck \"tag filter case-insensitive\" \"First post\" \"$TG\"\nAU=$(curl -s \"$B/posts?author=bob\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"total\"])')\ncheck \"author filter\" \"1\" \"$AU\"\nPG=$(curl -s \"$B/posts?page=2&page_size=1\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"items\"][0][\"title\"])')\ncheck \"paging page 2\" \"First post\" \"$PG\"\n\n# get one\nG=$(curl -s \"$B/posts/$ID1\")\nAU2=$(echo \"$G\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"author\"])')\ncheck \"author in post\" \"alice\" \"$AU2\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' \"$B/posts/99999\")\ncheck \"missing post 404\" \"404\" \"$CODE\"\n\n# update by non-author\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X PUT \"$B/posts/$ID1\" -H \"Authorization: Bearer $TOKB\" -H 'Content-Type: application/json' -d '{\"title\":\"hack\",\"content\":\"nope\",\"tags\":[]}')\ncheck \"edit others post 403\" \"403\" \"$CODE\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X DELETE \"$B/posts/$ID1\" -H \"Authorization: Bearer $TOKB\")\ncheck \"delete others post 403\" \"403\" \"$CODE\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X PUT \"$B/posts/$ID1\" -H 'Content-Type: application/json' -d '{\"title\":\"t\",\"content\":\"c\"}')\ncheck \"edit unauth 401\" \"401\" \"$CODE\"\n\n# update by author, omitted tags cleared\nU1=$(curl -s -X PUT \"$B/posts/$ID1\" -H \"Authorization: Bearer $TOK\" -H 'Content-Type: application/json' -d '{\"title\":\"First post v2\",\"content\":\"new content\"}')\nTAGS=$(echo \"$U1\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"tags\"])')\ncheck \"omitted tags cleared\" \"[]\" \"$TAGS\"\nUPD1=$(echo \"$U1\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"updated_at\"])')\nCRE=$(echo \"$P1\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"created_at\"])')\nsleep 1\nU2=$(curl -s -X PUT \"$B/posts/$ID1\" -H \"Authorization: Bearer $TOK\" -H 'Content-Type: application/json' -d '{\"title\":\"First post v3\",\"content\":\"new content\",\"tags\":[\"a\"]}')\nUPD2=$(echo \"$U2\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"updated_at\"])')\nif [ \"$UPD1\" != \"$UPD2\" ]; then check \"updated_at changes\" \"y\" \"y\"; else check \"updated_at changes\" \"y\" \"n\"; fi\ncheck \"created_at stable\" \"$CRE\" \"$(echo \"$U2\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"created_at\"])')\"\n\n# admin toggle\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST \"$B/admin/posts/$ID1/toggle\" -H \"Authorization: Bearer $TOK\")\ncheck \"toggle non-admin 403\" \"403\" \"$CODE\"\ncurl -s -X POST \"$B/admin/posts/$ID1/toggle\" -H \"Authorization: Bearer $ATOK\" >/dev/null\nCNT=$(curl -s \"$B/posts?author=alice\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"total\"])')\ncheck \"taken-down hidden from list\" \"0\" \"$CNT\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' \"$B/posts/$ID1\")\ncheck \"taken-down 404 anonymous\" \"404\" \"$CODE\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' \"$B/posts/$ID1\" -H \"Authorization: Bearer $TOK\")\ncheck \"taken-down 404 for author\" \"404\" \"$CODE\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' \"$B/posts/$ID1\" -H \"Authorization: Bearer $ATOK\")\ncheck \"taken-down visible to admin\" \"200\" \"$CODE\"\n# restore\ncurl -s -X POST \"$B/admin/posts/$ID1/toggle\" -H \"Authorization: Bearer $ATOK\" >/dev/null\nCNT=$(curl -s \"$B/posts?author=alice\"|python3 -c 'import sys,json;print(json.load(sys.stdin)[\"total\"])')\ncheck \"restored in list\" \"1\" \"$CNT\"\n\n# delete own\ncurl -s -X POST $B/posts -H \"Authorization: Bearer $TOK\" -H 'Content-Type: application/json' -d '{\"title\":\"to delete\",\"content\":\"x\",\"tags\":[\"t\"]}' >/tmp/todel.json\nIDDEL=$(python3 -c 'import json;print(json.load(open(\"/tmp/todel.json\"))[\"id\"])')\nCODE=$(curl -s -o /dev/null -w '%{http_code}' -X DELETE \"$B/posts/$IDDEL\" -H \"Authorization: Bearer $TOK\")\ncheck \"delete own 204\" \"204\" \"$CODE\"\nCODE=$(curl -s -o /dev/null -w '%{http_code}' \"$B/posts/$IDDEL\")\ncheck \"deleted 404\" \"404\" \"$CODE\"\n\necho \"=== $pass passed, $fail failed ===\"\nEOF\nbash /tmp/apitest.sh 2>&1 | tail -60","timeout":120000},"output":"PASS: register alice 201\nPASS: duplicate register 409\nPASS: short username 400\nPASS: short password 400\nPASS: alice login token\nPASS: admin login\nPASS: admin bad pw 401\nPASS: create unauth 401\nPASS: create bad token 401\nPASS: empty title 400\nPASS: excerpt 200 chars\nPASS: excerpt no newlines\nPASS: newest first\nPASS: total 2\nPASS: list keys\nPASS: q filter\nPASS: tag filter case-insensitive\nPASS: author filter\nPASS: paging page 2\nPASS: author in post\nPASS: missing post 404\nPASS: edit others post 403\nPASS: delete others post 403\nPASS: edit unauth 401\nPAS