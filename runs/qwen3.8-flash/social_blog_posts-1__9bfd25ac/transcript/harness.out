{"type":"tool_use","timestamp":1794367283852,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"type":"tool","tool":"write","callID":"call_a9fbec0ce3fc4952ab3fae51","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport type { Post } from \"../types\";\nimport { ErrorBanner, TagPill, formatDate, inputClass } from \"./ui\";\n\nconst PAGE_SIZE = 10;\n\nexport function PostList({\n  onOpenPost,\n  onNavigate,\n}: {\n  onOpenPost: (id: number) => void;\n  onNavigate: (to: string) => void;\n}) {\n  const { user } = useAuth();\n  const [posts, setPosts] = useState<Post[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [pages, setPages] = useState(1);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n\n  const [searchInput, setSearchInput] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [tag, setTag] = useState(\"\");\n  const [author, setAuthor] = useState(\"\");\n\n  useEffect(() => {\n    const timer = setTimeout(() => {\n      setQ(searchInput.trim());\n      setPage(1);\n    }, 300);\n    return () => clearTimeout(timer);\n  }, [searchInput]);\n\n  const load = useCallback(() => {\n    setLoading(true);\n    api\n      .listPosts({ q, tag, author, page, page_size: PAGE_SIZE })\n      .then((data) => {\n        setPosts(data.items);\n        setTotal(data.total);\n        setPages(Math.max(1, Math.ceil(data.total / data.page_size)));\n        setError(\"\");\n      })\n      .catch((err) => setError(err instanceof Error ? err.message : \"Failed to load posts\"))\n      .finally(() => setLoading(false));\n  }, [q, tag, author, page]);\n\n  useEffect(load, [load]);\n\n  const toggleAdmin = async (post: Post) => {\n    try {\n      const updated = await api.togglePost(post.id);\n      if (updated.taken_down) {\n        setPosts((prev) => prev.filter((p) => p.id !== post.id));\n        setTotal((t) => Math.max(0, t - 1));\n      }\n      setError(\"\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to update post\");\n    }\n  };\n\n  const clearFilters = () => {\n    setSearchInput(\"\");\n    setQ(\"\");\n    setTag(\"\");\n    setAuthor(\"\");\n    setPage(1);\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      <div className=\"space-y-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm\">\n        <div className=\"flex flex-col gap-3 sm:flex-row\">\n          <input\n            value={searchInput}\n            onChange={(e) => setSearchInput(e.target.value)}\n            placeholder=\"Search posts…\"\n            className={`${inputClass} flex-1`}\n            aria-label=\"Search posts\"\n          />\n          <div className=\"flex gap-3\">\n            <input\n              value={tag}\n              onChange={(e) => {\n                setTag(e.target.value.trim());\n                setPage(1);\n              }}\n              placeholder=\"Filter by tag\"\n              className={`${inputClass} sm:w-36`}\n              aria-label=\"Filter by tag\"\n            />\n            <input\n              value={author}\n              onChange={(e) => {\n                setAuthor(e.target.value.trim());\n                setPage(1);\n              }}\n              placeholder=\"Filter by author\"\n              className={`${inputClass} sm:w-36`}\n              aria-label=\"Filter by author\"\n            />\n          </div>\n          <button\n            type=\"button\"\n            onClick={clearFilters}\n            className=\"rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50\"\n          >\n            Clear\n          </button>\n        </div>\n        <p className=\"text-xs text-slate-500\">\n          {loading ? \"Loading…\" : `${total} post${total === 1 ? \"\" : \"s\"}`}\n        </p>\n      </div>\n\n      {error && <ErrorBanner message={error} onDismiss={() => setError(\"\")} />}\n\n      {user?.is_admin && (\n        <p className=\"rounded-md bg-amber-50 px-4 py-2 text-sm text-amber-800\">\n          Signed in as admin — you can take posts down from the list below.\n        </p>\n      )}\n\n      <ul className=\"space-y-3\">\n        {posts.map((post) => (\n          <li\n            key={post.id}\n            className=\"rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition hover:border-emerald-300 hover:shadow\"\n          >\n            <div className=\"flex items-start justify-between gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => onOpenPost(post.id)}\n                className=\"text-left\"\n              >\n                <h2 className=\"text-base font-semibold text-slate-900 hover:text-emerald-700\">\n                  {post.title}\n                </h2>\n              </button>\n              {user?.is_admin && (\n                <button\n                  type=\"button\"\n                  onClick={() => toggleAdmin(post)}\n                  className=\"shrink-0 rounded-md border border-red-200 px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50\"\n                  title=\"Take this post down\"\n                >\n                  Take down\n                </button>\n              )}\n            </div>\n            <p className=\"mt-1 text-xs text-slate-500\">\n              by{\" \"}\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setAuthor(post.author);\n                  setPage(1);\n                }}\n                className=\"font-medium text-emerald-700 hover:underline\"\n              >\n                {post.author}\n              </button>{\" \"}\n              · {formatDate(post.created_at)}\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => onOpenPost(post.id)}\n              className=\"mt-2 block w-full text-left text-sm text-slate-600\"\n            >\n              {post.excerpt}\n              {post.content.length > post.excerpt.length && \"…\"}\n            </button>\n            {post.tags.length > 0 && (\n              <div className=\"mt-3 flex flex-wrap gap-1.5\">\n                {post.tags.map((t) => (\n                  <TagPill\n                    key={t}\n                    tag={t}\n                    active={tag.toLowerCase() === t.toLowerCase()}\n                    onClick={() => {\n                      setTag(t);\n                      setPage(1);\n                    }}\n                  />\n                ))}\n              </div>\n            )}\n          </li>\n        ))}\n        {!loading && posts.length === 0 && (\n          <li className=\"rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500\">\n            No posts found.\n            {!user && (\n              <>\n                {\" \"}\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\"/new\")}\n                  className=\"font-medium text-emerald-700 hover:underline\"\n                >\n                  Sign in\n                </button>{\" \"}\n                to write the first one.\n              </>\n            )}\n          </li>\n        )}\n      </ul>\n\n      {pages > 1 && (\n        <div className=\"flex items-center justify-center gap-3 text-sm\">\n          <button\n            type=\"button\"\n            disabled={page <= 1}\n            onClick={() => setPage((p) => Math.max(1, p - 1))}\n            className=\"rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-50 disabled:opacity-40\"\n          >\n            ← Previous\n          </button>\n          <span className=\"text-slate-500\">\n            Page {page} of {pages}\n          </span>\n          <button\n            type=\"button\"\n            disabled={page >= pages}\n            onClick={() => setPage((p) => Math.min(pages, p + 1))}\n            className=\"rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-50 disabled:opacity-40\"\n          >\n            Next →\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/PostList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/PostList.tsx","exists":false,"truncated":false},"title":"frontend/src/components/PostList.tsx","time":{"start":1794367283826,"end":1794367283834}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c89fe26d001Au3Smv1IJNp6a7","sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","messageID":"msg_1c89f7dd0001sHl7T6MAawS4IM"}}
