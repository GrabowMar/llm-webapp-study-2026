{"type":"step_start","timestamp":1794367332905,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"id":"prt_1c8a0a21d001bX44oSFwolDPx7","messageID":"msg_1c8a04452001z0wIvzHFjFSNrG","sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","type":"step-start"}}
{"type":"tool_use","timestamp":1794367332924,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"type":"tool","tool":"write","callID":"call_61f8e9bb901447fc96e27ee3","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport type { Post } from \"../types\";\nimport { ErrorBanner, TagPill, formatDate } from \"./ui\";\n\nexport function PostPage({\n  postId,\n  onNavigate,\n}: {\n  postId: number;\n  onNavigate: (to: string) => void;\n}) {\n  const { user } = useAuth();\n  const [post, setPost] = useState<Post | null>(null);\n  const [missing, setMissing] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(() => {\n    setMissing(false);\n    api\n      .getPost(postId)\n      .then((p) => {\n        setPost(p);\n        setError(\"\");\n      })\n      .catch((err) => {\n        if (err instanceof ApiError && err.status === 404) setMissing(true);\n        else setError(err instanceof Error ? err.message : \"Failed to load post\");\n      });\n  }, [postId]);\n\n  useEffect(load, [load]);\n\n  const toggle = async () => {\n    if (!post) return;\n    setBusy(true);\n    try {\n      setPost(await api.togglePost(post.id));\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to update post\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const remove = async () => {\n    if (!post || !window.confirm(`Delete “${post.title}”? This cannot be undone.`)) return;\n    setBusy(true);\n    try {\n      await api.deletePost(post.id);\n      onNavigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete post\");\n      setBusy(false);\n    }\n  };\n\n  if (missing) {\n    return (\n      <div className=\"rounded-lg border border-dashed border-slate-300 bg-white p-10 text-center\">\n        <p className=\"text-lg font-semibold text-slate-700\">Post not found</p>\n        <p className=\"mt-1 text-sm text-slate-500\">\n          It may have been deleted or taken down.\n        </p>\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\"/\")}\n          className=\"mt-4 rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700\"\n        >\n          Back to posts\n        </button>\n      </div>\n    );\n  }\n\n  if (!post) {\n    return <p className=\"text-sm text-slate-500\">Loading…</p>;\n  }\n\n  const isAuthor = user !== null && user.username === post.author;\n\n  return (\n    <article className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <div className=\"flex flex-wrap items-start justify-between gap-3\">\n        <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">{post.title}</h1>\n        {post.taken_down && (\n          <span className=\"rounded bg-red-100 px-2 py-1 text-xs font-semibold text-red-700\">\n            Taken down\n          </span>\n        )}\n      </div>\n      <p className=\"mt-1 text-sm text-slate-500\">\n        by <span className=\"font-medium text-slate-700\">{post.author}</span> ·{\" \"}\n        {formatDate(post.created_at)}\n        {post.updated_at !== post.created_at && (\n          <> · updated {formatDate(post.updated_at)}</>\n        )}\n      </p>\n\n      {post.tags.length > 0 && (\n        <div className=\"mt-3 flex flex-wrap gap-1.5\">\n          {post.tags.map((t) => (\n            <TagPill key={t} tag={t} />\n          ))}\n        </div>\n      )}\n\n      <div className=\"mt-6 text-[15px] leading-7 text-slate-700\">\n        {post.content.split(/\\r?\\n/).map((paragraph, i) =>\n          paragraph.trim() ? (\n            <p key={i} className=\"mb-4 last:mb-0\">\n              {paragraph}\n            </p>\n          ) : null,\n        )}\n      </div>\n\n      {error && (\n        <div className=\"mt-6\">\n          <ErrorBanner message={error} onDismiss={() => setError(\"\")} />\n        </div>\n      )}\n\n      <div className=\"mt-8 flex flex-wrap gap-2 border-t border-slate-100 pt-4\">\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\"/\")}\n          className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50\"\n        >\n          ← Back to posts\n        </button>\n        {isAuthor && (\n          <>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(`/posts/${post.id}/edit`)}\n              className=\"rounded-md border border-emerald-300 px-3 py-1.5 text-sm font-medium text-emerald-700 hover:bg-emerald-50\"\n            >\n              Edit\n            </button>\n            <button\n              type=\"button\"\n              onClick={remove}\n              disabled={busy}\n              className=\"rounded-md border border-red-300 px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 disabled:opacity-50\"\n            >\n              Delete\n            </button>\n          </>\n        )}\n        {user?.is_admin && (\n          <button\n            type=\"button\"\n            onClick={toggle}\n            disabled={busy}\n            className={`rounded-md px-3 py-1.5 text-sm font-medium text-white disabled:opacity-50 ${\n              post.taken_down ? \"bg-emerald-600 hover:bg-emerald-700\" : \"bg-red-600 hover:bg-red-700\"\n            }`}\n          >\n            {post.taken_down ? \"Restore post\" : \"Take down\"}\n          </button>\n        )}\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/components/PostPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/PostPage.tsx","exists":false,"truncated":false},"title":"frontend/src/components/PostPage.tsx","time":{"start":1794367332901,"end":1794367332908}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8a0a220001J7f94RfxRmd1bu","sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","messageID":"msg_1c8a04452001z0wIvzHFjFSNrG"}}
