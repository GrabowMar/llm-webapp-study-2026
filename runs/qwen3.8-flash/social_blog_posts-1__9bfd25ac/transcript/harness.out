{"type":"step_start","timestamp":1794367352148,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"id":"prt_1c8a0ed440016X48pTJCY2PMpt","messageID":"msg_1c8a0a2370010nenk6sd0D6r5t","sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","type":"step-start"}}
{"type":"tool_use","timestamp":1794367352174,"sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","part":{"type":"tool","tool":"write","callID":"call_32a70564cbc74f1890238d6f","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport type { Post } from \"../types\";\nimport { ErrorBanner, inputClass } from \"./ui\";\n\nfunction parseTags(raw: string): string[] {\n  const seen = new Map<string, string>();\n  for (const part of raw.split(\",\")) {\n    const tag = part.trim();\n    if (!tag) continue;\n    const key = tag.toLowerCase();\n    if (!seen.has(key)) seen.set(key, tag);\n  }\n  return [...seen.values()];\n}\n\nexport function PostEditor({\n  postId,\n  onSaved,\n  onNavigate,\n}: {\n  postId: number | null;\n  onSaved: (post: Post) => void;\n  onNavigate: (to: string) => void;\n}) {\n  const { user } = useAuth();\n  const [title, setTitle] = useState(\"\");\n  const [content, setContent] = useState(\"\");\n  const [tagsRaw, setTagsRaw] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [loadError, setLoadError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const [existing, setExisting] = useState<Post | null>(null);\n  const [loaded, setLoaded] = useState(postId === null);\n\n  useEffect(() => {\n    if (postId === null) return;\n    api\n      .getPost(postId)\n      .then((post) => {\n        if (post.author !== user?.username) {\n          setLoadError(\"You can only edit your own posts.\");\n          return;\n        }\n        setExisting(post);\n        setTitle(post.title);\n        setContent(post.content);\n        setTagsRaw(post.tags.join(\", \"));\n      })\n      .catch((err) => setLoadError(err instanceof Error ? err.message : \"Failed to load post\"))\n      .finally(() => setLoaded(true));\n  }, [postId, user]);\n\n  const submit = async (event: FormEvent) => {\n    event.preventDefault();\n    setError(\"\");\n    setBusy(true);\n    const input = { title, content, tags: parseTags(tagsRaw) };\n    try {\n      const saved =\n        existing !== null\n          ? await api.updatePost(existing.id, input)\n          : await api.createPost(input);\n      onSaved(saved);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Could not save the post\");\n      setBusy(false);\n    }\n  };\n\n  const remove = async () => {\n    if (existing === null) return;\n    if (!window.confirm(`Delete “${existing.title}”? This cannot be undone.`)) return;\n    setBusy(true);\n    try {\n      await api.deletePost(existing.id);\n      onNavigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete post\");\n      setBusy(false);\n    }\n  };\n\n  if (!loaded) return <p className=\"text-sm text-slate-500\">Loading…</p>;\n\n  if (loadError) {\n    return (\n      <div className=\"space-y-4\">\n        <ErrorBanner message={loadError} />\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\"/\")}\n          className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50\"\n        >\n          ← Back to posts\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"mx-auto max-w-2xl\">\n      <div className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n        <h1 className=\"mb-5 text-xl font-bold text-slate-900\">\n          {existing ? \"Edit post\" : \"New post\"}\n        </h1>\n        <form onSubmit={submit} className=\"space-y-4\">\n          <div>\n            <label htmlFor=\"title\" className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Title\n            </label>\n            <input\n              id=\"title\"\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              className={inputClass}\n              placeholder=\"A catchy title\"\n              required\n            />\n          </div>\n          <div>\n            <label htmlFor=\"content\" className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Content\n            </label>\n            <textarea\n              id=\"content\"\n              value={content}\n              onChange={(e) => setContent(e.target.value)}\n              rows={12}\n              className={`${inputClass} resize-y font-mono text-sm`}\n              placeholder=\"Write your post. Blank lines separate paragraphs.\"\n              required\n            />\n          </div>\n          <div>\n            <label htmlFor=\"tags\" className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Tags\n            </label>\n            <input\n              id=\"tags\"\n              value={tagsRaw}\n              onChange={(e) => setTagsRaw(e.target.value)}\n              className={inputClass}\n              placeholder=\"python, web, tips (comma separated)\"\n            />\n            {parseTags(tagsRaw).length > 0 && (\n              <div className=\"mt-2 flex flex-wrap gap-1.5\">\n                {parseTags(tagsRaw).map((t) => (\n                  <span\n                    key={t}\n                    className=\"rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700\"\n                  >\n                    #{t}\n                  </span>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {error && <ErrorBanner message={error} onDismiss={() => setError(\"\")} />}\n\n          <div className=\"flex flex-wrap items-center gap-2 pt-2\">\n            <button\n              type=\"submit\"\n              disabled={busy}\n              className=\"rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 disabled:opacity-50\"\n            >\n              {busy ? \"Saving…\" : existing ? \"Save changes\" : \"Publish\"}\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(existing ? `/posts/${existing.id}` : \"/\")}\n              className=\"rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50\"\n            >\n              Cancel\n            </button>\n            {existing && (\n              <button\n                type=\"button\"\n                onClick={remove}\n                disabled={busy}\n                className=\"ml-auto rounded-md border border-red-300 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 disabled:opacity-50\"\n              >\n                Delete post\n              </button>\n            )}\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/PostEditor.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/PostEditor.tsx","exists":false,"truncated":false},"title":"frontend/src/components/PostEditor.tsx","time":{"start":1794367352142,"end":1794367352151}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8a0ed470012i6mmQahm7Idhv","sessionID":"ses_e376fef36ffeXo28NQ9dXYJdTR","messageID":"msg_1c8a0a2370010nenk6sd0D6r5t"}}
