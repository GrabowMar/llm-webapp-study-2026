{"type":"tool_use","timestamp":1794351451850,"sessionID":"ses_e3855e53fffeIUEfdSrshjh8xm","part":{"type":"tool","tool":"write","callID":"call_71a12e20c9dd431ebb380a92","state":{"status":"completed","input":{"content":"export interface Item {\n  id: number;\n  name: string;\n  sku: string;\n  location: string;\n  quantity: number;\n  reorder_level: number;\n  low_stock: boolean;\n}\n\nexport interface Movement {\n  id: number;\n  item_id: number;\n  delta: number;\n  reason: string;\n  quantity_after: number;\n  created_at: string;\n  username: string;\n}\n\nexport interface ItemsPage {\n  items: Item[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface ItemParams {\n  q?: string;\n  location?: string;\n  low_stock?: boolean;\n  page?: number;\n  page_size?: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nconst TOKEN_KEY = \"inventory_token\";\nconst USER_KEY = \"inventory_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USER_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USER_KEY);\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    ...((options.headers as Record<string, string>) || {}),\n  };\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(path, { ...options, headers });\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const err = data as { error?: string } | null;\n    throw new ApiError(res.status, err?.error || `Request failed (${res.status})`);\n  }\n  return data as T;\n}\n\nexport function listItems(params: ItemParams): Promise<ItemsPage> {\n  const query = new URLSearchParams();\n  if (params.q) query.set(\"q\", params.q);\n  if (params.location) query.set(\"location\", params.location);\n  if (params.low_stock) query.set(\"low_stock\", \"true\");\n  if (params.page) query.set(\"page\", String(params.page));\n  if (params.page_size) query.set(\"page_size\", String(params.page_size));\n  const qs = query.toString();\n  return request(`/api/items${qs ? `?${qs}` : \"\"}`);\n}\n\nexport function getItem(id: number): Promise<Item> {\n  return request(`/api/items/${id}`);\n}\n\nexport interface ItemInput {\n  name: string;\n  sku: string;\n  location: string;\n  quantity?: number;\n  reorder_level: number;\n}\n\nexport function createItem(input: ItemInput): Promise<Item> {\n  return request(\"/api/items\", { method: \"POST\", body: JSON.stringify(input) });\n}\n\nexport function updateItem(id: number, input: ItemInput): Promise<Item> {\n  return request(`/api/items/${id}`, { method: \"PUT\", body: JSON.stringify(input) });\n}\n\nexport function deleteItem(id: number): Promise<{ ok: boolean }> {\n  return request(`/api/items/${id}`, { method: \"DELETE\" });\n}\n\nexport function listMovements(id: number): Promise<{ items: Movement[] }> {\n  return request(`/api/items/${id}/movements`);\n}\n\nexport function createMovement(\n  id: number,\n  delta: number,\n  reason: string,\n): Promise<Movement> {\n  return request(`/api/items/${id}/movements`, {\n    method: \"POST\",\n    body: JSON.stringify({ delta, reason }),\n  });\n}\n\nexport function register(username: string, password: string): Promise<unknown> {\n  return request(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport async function login(username: string, password: string): Promise<string> {\n  const data = await request<{ token: string; username: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n  setSession(data.token, data.username);\n  return data.username;\n}\n\nexport async function logout(): Promise<void> {\n  try {\n    await request(\"/api/auth/logout\", { method: \"POST\" });\n  } catch {\n    /* ignore */\n  }\n  clearSession();\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794351451818,"end":1794351451829}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ae4ea3001ZMdzAv8THxr1ZB","sessionID":"ses_e3855e53fffeIUEfdSrshjh8xm","messageID":"msg_1c7ae1c29001nmxa2eWT1b9fuT"}}
