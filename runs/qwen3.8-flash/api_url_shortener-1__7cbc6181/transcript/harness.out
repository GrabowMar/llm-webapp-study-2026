{"type":"tool_use","timestamp":1794382208704,"sessionID":"ses_e368d1d2affeYlxFBJL2iz5sI0","part":{"type":"tool","tool":"read","callID":"call_3251b54007db418097976622","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point for the URL shortener.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import hashlib\n6: import os\n7: import secrets\n8: import sqlite3\n9: from datetime import datetime, timezone\n10: from pathlib import Path\n11: from urllib.parse import urlparse\n12: \n13: from flask import Flask, g, jsonify, redirect, request, send_from_directory\n14: from werkzeug.exceptions import HTTPException, NotFound\n15: \n16: ROOT = Path(__file__).resolve().parent.parent\n17: DIST = ROOT / \"frontend\" / \"dist\"\n18: DATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (ROOT / \"data\"))\n19: DB_PATH = DATA_DIR / \"urlshortener.db\"\n20: \n21: CODE_ALPHABET = \"abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789\"\n22: CODE_LENGTH = 7\n23: PBKDF2_ROUNDS = 120_000\n24: DEFAULT_PAGE_SIZE = 10\n25: MAX_PAGE_SIZE = 100\n26: \n27: app = Flask(__name__, static_folder=None)\n28: \n29: \n30: # ---------------------------------------------------------------------------\n31: # helpers\n32: \n33: def now_iso() -> str:\n34:     return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n35: \n36: \n37: def err(message: str, status: int):\n38:     return jsonify({\"error\": message}), status\n39: \n40: \n41: def get_db() -> sqlite3.Connection:\n42:     db = getattr(g, \"db\", None)\n43:     if db is None:\n44:         db = g.db = sqlite3.connect(DB_PATH)\n45:         db.row_factory = sqlite3.Row\n46:         db.execute(\"PRAGMA foreign_keys = ON\")\n47:         db.execute(\"PRAGMA busy_timeout = 5000\")\n48:     return db\n49: \n50: \n51: @app.teardown_appcontext\n52: def close_db(_exc):\n53:     db = g.pop(\"db\", None)\n54:     if db is not None:\n55:         db.close()\n56: \n57: \n58: SCHEMA = \"\"\"\n59: CREATE TABLE IF NOT EXISTS users (\n60:     id            INTEGER PRIMARY KEY AUTOINCREMENT,\n61:     username      TEXT    NOT NULL UNIQUE,\n62:     password_hash TEXT    NOT NULL,\n63:     created_at    TEXT    NOT NULL\n64: );\n65: CREATE TABLE IF NOT EXISTS tokens (\n66:     token      TEXT    PRIMARY KEY,\n67:     user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n68:     created_at TEXT    NOT NULL\n69: );\n70: CREATE TABLE IF NOT EXISTS links (\n71:     id           INTEGER PRIMARY KEY AUTOINCREMENT,\n72:     original_url TEXT    NOT NULL,\n73:     short_code   TEXT    NOT NULL UNIQUE,\n74:     click_count  INTEGER NOT NULL DEFAULT 0,\n75:     created_at   TEXT    NOT NULL,\n76:     owner_id     INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n77:     active       INTEGER NOT NULL DEFAULT 1\n78: );\n79: CREATE INDEX IF NOT EXISTS idx_links_created_at ON links (created_at DESC, id DESC);\n80: \"\"\"\n81: \n82: \n83: def init_db() -> None:\n84:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n85:     db = sqlite3.connect(DB_PATH)\n86:     db.execute(\"PRAGMA journal_mode=WAL\")\n87:     db.executescript(SCHEMA)\n88:     db.commit()\n89:     db.close()\n90: \n91: \n92: # ---------------------------------------------------------------------------\n93: # passwords / admin\n94: \n95: def admin_password() -> str:\n96:     return os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n97: \n98: \n99: def hash_password(password: str) -> str:\n100:     salt = secrets.token_hex(16)\n101:     digest = hashlib.pbkdf2_hmac(\n102:         \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ROUNDS\n103:     )\n104:     return f\"pbkdf2_sha256${salt}${digest.hex()}\"\n105: \n106: \n107: def verify_password(password: str, stored: str) -> bool:\n108:     try:\n109:         _algo, salt, digest = stored.split(\"$\", 2)\n110:         check = hashlib.pbkdf2_hmac(\n111:             \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ROUNDS\n112:         )\n113:     except ValueError:\n114:         return False\n115:     return secrets.compare_digest(check.hex(), digest)\n116: \n117: \n118: def ensure_admin() -> None:\n119:     password = admin_password()\n120:     if not password:\n121:         return\n122:     db = sqlite3.connect(DB_PATH)\n123:     db.execute(\n124:         \"INSERT OR IGNORE INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n125:         (\"admin\", hash_password(password), now_iso()),\n126:     )\n127:     db.commit()\n128:     db.close()\n129: \n130: \n131: # ---------------------------------------------------------------------------\n132: # auth / sessions\n133: \n134: def current_user() -> sqlite3.Row | None:\n135:     header = request.headers.get(\"Authorization\", \"\")\n136:     if not header.startswith(\"Bearer \"):\n137:         return None\n138:     token = header[len(\"Bearer \"):].strip()\n139:     if not token:\n140:         return None\n141:     return get_db().execute(\n142:         \"SELECT u.id, u.username FROM tokens t \"\n143:         \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n144:         (token,),\n145:     ).fetchone()\n146: \n147: \n148: def issue_token(user_id: int) -> str:\n149:     token = secrets.token_urlsafe(32)\n150:     db = get_db()\n151:     db.execute(\n152:         \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n153:         (token, user_id, now_iso()),\n154:     )\n155:     db.commit()\n156:     return token\n157: \n158: \n159: def require_user():\n160:     user = current_user()\n161:     if user is None:\n162:         return None, err(\"Authentication required\", 401)\n163:     return user, None\n164: \n165: \n166: def require_admin():\n167:     user = current_user()\n168:     if user is None:\n169:         return None, err(\"Authentication required\", 401)\n170:     if user[\"username\"] != \"admin\":\n171:         return None, err(\"Admin access required\", 403)\n172:     return user, None\n173: \n174: \n175: # ---------------------------------------------------------------------------\n176: # links\n177: \n178: LINK_SELECT = (\n179:     \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n180:     \"l.active, u.username AS owner, l.owner_id \"\n181:     \"FROM links l JOIN users u ON u.id = l.owner_id\"\n182: )\n183: \n184: \n185: def serialize_link(row: sqlite3.Row) -> dict:\n186:     return {\n187:         \"id\": row[\"id\"],\n188:         \"original_url\": row[\"original_url\"],\n189:         \"short_code\": row[\"short_code\"],\n190:         \"click_count\": row[\"click_count\"],\n191:         \"created_at\": row[\"created_at\"],\n192:         \"short_url\": f\"/r/{row['short_code']}\",\n193:         \"owner\": row[\"owner\"],\n194:         \"active\": bool(row[\"active\"]),\n195:     }\n196: \n197: \n198: def fetch_link(link_id: int) -> sqlite3.Row | None:\n199:     return get_db().execute(LINK_SELECT + \" WHERE l.id = ?\", (link_id,)).fetchone()\n200: \n201: \n202: def generate_code(db: sqlite3.Connection) -> str:\n203:     while True:\n204:         code = \"\".join(secrets.choice(CODE_ALPHABET) for _ in range(CODE_LENGTH))\n205:         if not db.execute(\"SELECT 1 FROM links WHERE short_code = ?\", (code,)).fetchone():\n206:             return code\n207: \n208: \n209: def clean_url(raw) -> str | None:\n210:     if not isinstance(raw, str):\n211:         return None\n212:     url = raw.strip()\n213:     if not url or len(url) > 2048:\n214:         return None\n215:     try:\n216:         parsed = urlparse(url)\n217:     except ValueError:\n218:         return None\n219:     if parsed.scheme not in (\"http\", \"https\"):\n220:         return None\n221:     if not parsed.netloc or not parsed.hostname:\n222:         return None\n223:     return url\n224: \n225: \n226: def paginate() -> tuple[int, int]:\n227:     try:\n228:         page = int(request.args.get(\"page\", 1))\n229:     except (TypeError, ValueError):\n230:         page = 1\n231:     try:\n232:         page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n233:     except (TypeError, ValueError):\n234:         page_size = DEFAULT_PAGE_SIZE\n235:     return max(1, page), min(max(1, page_size), MAX_PAGE_SIZE)\n236: \n237: \n238: # ---------------------------------------------------------------------------\n239: # auth endpoints\n240: \n241: @app.post(\"/api/auth/register\")\n242: def register():\n243:     data = request.get_json(silent=True)\n244:     if not isinstance(data, dict):\n245:         return err(\"Request body must be a JSON object\", 400)\n246:     username = data.get(\"username\")\n247:     password = data.get(\"password\")\n248:     if not isinstance(username, str) or not username.strip():\n249:         return err(\"username is required\", 400)\n250:     if not isinstance(password, str) or not password:\n251:         return err(\"password is required\", 400)\n252:     username = username.strip()\n253:     if len(username) > 64:\n254:         return err(\"username must be at most 64 characters\", 400)\n255:     if len(password) > 128:\n256:         return err(\"password must be at most 128 characters\", 400)\n257:     if username == \"admin\":\n258:         return err(\"This username is reserved\", 409)\n259:     db = get_db()\n260:     try:\n261:         db.execute(\n262:             \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n263:             (username, hash_password(password), now_iso()),\n264:         )\n265:         db.commit()\n266:     except sqlite3.IntegrityError:\n267:         return err(\"Username already taken\", 409)\n268:     return jsonify({\"username\": username}), 201\n269: \n270: \n271: @app.post(\"/api/auth/login\")\n272: def login():\n273:     data = request.get_json(silent=True)\n274:     if not isinstance(data, dict):\n275:         return err(\"Request body must be a JSON object\", 400)\n276:     username = data.get(\"username\")\n277:     password = data.get(\"password\")\n278:     if not isinstance(username, str) or not isinstance(password, str):\n279:         return err(\"username and password are required\", 400)\n280:     username = username.strip()\n281: \n282:     db = get_db()\n283:     row = db.execute(\n284:         \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n285:     ).fetchone()\n286: \n287:     if username == \"admin\":\n288:         env_password = admin_password()\n289:         if not env_password or not secrets.compare_digest(password, env_password):\n290:             return err(\"Invalid username or password\", 401)\n291:         if row is None:\n292:             db.execute(\n293:                 \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n294:                 (\"admin\", hash_password(env_password), now_iso()),\n295:             )\n296:             db.commit()\n297:             row = db.execute(\n298:                 \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n299:             ).fetchone()\n300:     else:\n301:         if row is None or not verify_password(password, row[\"password_hash\"]):\n302:             return err(\"Invalid username or password\", 401)\n303: \n304:     token = issue_token(row[\"id\"])\n305:     return jsonify({\"token\": token}), 200\n306: \n307: \n308: # ---------------------------------------------------------------------------\n309: # link endpoints\n310: \n311: @app.get(\"/api/health\")\n312: def health():\n313:     return {\"status\": \"ok\"}\n314: \n315: \n316: @app.post(\"/api/links\")\n317: def create_link():\n318:     user, error = require_user()\n319:     if error:\n320:         return error\n321:     data = request.get_json(silent=True)\n322:     if not isinstance(data, dict):\n323:         return err(\"Request body must be a JSON object\", 400)\n324:     url = clean_url(data.get(\"original_url\", data.get(\"url\")))\n325:     if url is None:\n326:         return err(\"Only http and https addresses are accepted\", 400)\n327:     db = get_db()\n328:     for _attempt in range(5):\n329:         code = generate_code(db)\n330:         try:\n331:             cur = db.execute(\n332:                 \"INSERT INTO links (original_url, short_code, created_at, owner_id, active) \"\n333:                 \"VALUES (?, ?, ?, ?, 1)\",\n334:                 (url, code, now_iso(), user[\"id\"]),\n335:             )\n336:             db.commit()\n337:             break\n338:         except sqlite3.IntegrityError:\n339:             db.rollback()\n340:     else:\n341:         return err(\"Could not allocate a short code, try again\", 500)\n342:     return jsonify(serialize_link(fetch_link(cur.lastrowid))), 201\n343: \n344: \n345: @app.get(\"/api/links\")\n346: def list_links():\n347:     page, page_size = paginate()\n348:     db = get_db()\n349:     total = db.execute(\"SELECT COUNT(*) AS n FROM links WHERE active = 1\").fetchone()[\"n\"]\n350:     rows = db.execute(\n351:         LINK_SELECT + \" WHERE l.active = 1 ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n352:         (page_size, (page - 1) * page_size),\n353:     ).fetchall()\n354:     return jsonify(\n355:         {\n356:             \"items\": [serialize_link(r) for r in rows],\n357:             \"total\": total,\n358:             \"page\": page,\n359:             \"page_size\": page_size,\n360:         }\n361:     )\n362: \n363: \n364: @app.get(\"/api/links/<int:link_id>\")\n365: def get_link(link_id: int):\n366:     row = fetch_link(link_id)\n367:     if row is None or not row[\"active\"]:\n368:         return err(\"Link not found\", 404)\n369:     return jsonify(serialize_link(row))\n370: \n371: \n372: @app.delete(\"/api/links/<int:link_id>\")\n373: def delete_link(link_id: int):\n374:     user, error = require_user()\n375:     if error:\n376:         return error\n377:     row = fetch_link(link_id)\n378:     if row is None or not row[\"active\"]:\n379:         return err(\"Link not found\", 404)\n380:     if row[\"owner_id\"] != user[\"id\"]:\n381:         return err(\"You can only delete your own links\", 403)\n382:     db = get_db()\n383:     db.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n384:     db.commit()\n385:     return jsonify(serialize_link(row))\n386: \n387: \n388: # ---------------------------------------------------------------------------\n389: # admin endpoints\n390: \n391: @app.get(\"/api/admin/links\")\n392: def admin_links():\n393:     _user, error = require_admin()\n394:     if error:\n395:         return error\n396:     page, page_size = paginate()\n397:     db = get_db()\n398:     total = db.execute(\"SELECT COUNT(*) AS n FROM links\").fetchone()[\"n\"]\n399:     rows = db.execute(\n400:         LINK_SELECT + \" ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n401:         (page_size, (page - 1) * page_size),\n402:     ).fetchall()\n403:     return jsonify(\n404:         {\n405:             \"items\": [serialize_link(r) for r in rows],\n406:             \"total\": total,\n407:             \"page\": page,\n408:             \"page_size\": page_size,\n409:         }\n410:     )\n411: \n412: \n413: @app.post(\"/api/admin/links/<int:link_id>/toggle\")\n414: def admin_toggle_link(link_id: int):\n415:     _user, error = require_admin()\n416:     if error:\n417:         return error\n418:     row = fetch_link(link_id)\n419:     if row is None:\n420:         return err(\"Link not found\", 404)\n421:     db = get_db()\n422:     db.execute(\n423:         \"UPDATE links SET active = ? WHERE id = ?\", (0 if row[\"active\"] else 1, link_id)\n424:     )\n425:     db.commit()\n426:     return jsonify(serialize_link(fetch_link(link_id)))\n427: \n428: \n429: # ---------------------------------------------------------------------------\n430: # redirects (must win over the frontend catch-all below)\n431: \n432: @app.get(\"/r/<code>\")\n433: def follow(code: str):\n434:     db = get_db()\n435:     row = db.execute(LINK_SELECT + \" WHERE l.short_code = ?\", (code,)).fetchone()\n436:     if row is None or not row[\"active\"]:\n437:         return err(\"Link not found\", 404)\n438:     db.execute(\"UPDATE links SET click_count = click_count + 1 WHERE id = ?\", (row[\"id\"],))\n439:     db.commit()\n440:     return redirect(row[\"original_url\"], code=302)\n441: \n442: \n443: # ---------------------------------------------------------------------------\n444: # frontend\n445: \n446: @app.errorhandler(HTTPException)\n447: def handle_http_exception(exc: HTTPException):\n448:     return jsonify({\"error\": exc.description or exc.name}), exc.code\n449: \n450: \n451: @app.get(\"/\")\n452: @app.get(\"/<path:path>\")\n453: def frontend(path: str = \"index.html\"):\n454:     if path == \"api\" or path.startswith(\"api/\") or path == \"r\" or path.startswith(\"r/\"):\n455:         return err(\"Not found\", 404)\n456:     if path:\n457:         try:\n458:             return send_from_directory(DIST, path)\n459:         except NotFound:\n460:             pass\n461:     try:\n462:         return send_from_directory(DIST, \"index.html\")\n463:     except NotFound:\n464:         return err(\"Not found\", 404)\n465: \n466: \n467: init_db()\n468: ensure_admin()\n\n(End of file - total 468 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point for the URL shortener.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException, NotFound\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (ROOT / \"data\"))\nDB_PATH = DATA_DIR / \"urlshortener.db\"\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point for the URL shortener.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException, NotFound\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (ROOT / \"data\"))\nDB_PATH = DATA_DIR / \"urlshortener.db\"\n\nCODE_ALPHABET = \"abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789\"\nCODE_LENGTH = 7\nPBKDF2_ROUNDS = 120_000\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# helpers\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef err(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef get_db() -> sqlite3.Connection:\n    db = getattr(g, \"db\", None)\n    if db is None:\n        db = g.db = sqlite3.connect(DB_PATH)\n        db.row_factory = sqlite3.Row\n        db.execute(\"PRAGMA foreign_keys = ON\")\n        db.execute(\"PRAGMA busy_timeout = 5000\")\n    return db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id            INTEGER PRIMARY KEY AUTOINCREMENT,\n    username      TEXT    NOT NULL UNIQUE,\n    password_hash TEXT    NOT NULL,\n    created_at    TEXT    NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token      TEXT    PRIMARY KEY,\n    user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT    NOT NULL\n);\nCREATE TABLE IF NOT EXISTS links (\n    id           INTEGER PRIMARY KEY AUTOINCREMENT,\n    original_url TEXT    NOT NULL,\n    short_code   TEXT    NOT NULL UNIQUE,\n    click_count  INTEGER NOT NULL DEFAULT 0,\n    created_at   TEXT    NOT NULL,\n    owner_id     INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    active       INTEGER NOT NULL DEFAULT 1\n);\nCREATE INDEX IF NOT EXISTS idx_links_created_at ON links (created_at DESC, id DESC);\n\"\"\"\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.execute(\"PRAGMA journal_mode=WAL\")\n    db.executescript(SCHEMA)\n    db.commit()\n    db.close()\n\n\n# ---------------------------------------------------------------------------\n# passwords / admin\n\ndef admin_password() -> str:\n    return os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ROUNDS\n    )\n    return f\"pbkdf2_sha256${salt}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        _algo, salt, digest = stored.split(\"$\", 2)\n        check = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ROUNDS\n        )\n    except ValueError:\n        return False\n    return secrets.compare_digest(check.hex(), digest)\n\n\ndef ensure_admin() -> None:\n    password = admin_password()\n    if not password:\n        return\n    db = sqlite3.connect(DB_PATH)\n    db.execute(\n        \"INSERT OR IGNORE INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (\"admin\", hash_password(password), now_iso()),\n    )\n    db.commit()\n    db.close()\n\n\n# ---------------------------------------------------------------------------\n# auth / sessions\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    return get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, now_iso()),\n    )\n    db.commit()\n    return token\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, err(\"Authentication required\", 401)\n    return user, None\n\n\ndef require_admin():\n    user = current_user()\n    if user is None:\n        return None, err(\"Authentication required\", 401)\n    if user[\"username\"] != \"admin\":\n        return None, err(\"Admin access required\", 403)\n    return user, None\n\n\n# ---------------------------------------------------------------------------\n# links\n\nLINK_SELECT = (\n    \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n    \"l.active, u.username AS owner, l.owner_id \"\n    \"FROM links l JOIN users u ON u.id = l.owner_id\"\n)\n\n\ndef serialize_link(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"],\n        \"active\": bool(row[\"active\"]),\n    }\n\n\ndef fetch_link(link_id: int) -> sqlite3.Row | None:\n    return get_db().execute(LINK_SELECT + \" WHERE l.id = ?\", (link_id,)).fetchone()\n\n\ndef generate_code(db: sqlite3.Connection) -> str:\n    while True:\n        code = \"\".join(secrets.choice(CODE_ALPHABET) for _ in range(CODE_LENGTH))\n        if not db.execute(\"SELECT 1 FROM links WHERE short_code = ?\", (code,)).fetchone():\n            return code\n\n\ndef clean_url(raw) -> str | None:\n    if not isinstance(raw, str):\n        return None\n    url = raw.strip()\n    if not url or len(url) > 2048:\n        return None\n    try:\n        parsed = urlparse(url)\n    except ValueError:\n        return None\n    if parsed.scheme not in (\"http\", \"https\"):\n        return None\n    if not parsed.netloc or not parsed.hostname:\n        return None\n    return url\n\n\ndef paginate() -> tuple[int, int]:\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n    except (TypeError, ValueError):\n        page_size = DEFAULT_PAGE_SIZE\n    return max(1, page), min(max(1, page_size), MAX_PAGE_SIZE)\n\n\n# ---------------------------------------------------------------------------\n# auth endpoints\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return err(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return err(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return err(\"password is required\", 400)\n    username = username.strip()\n    if len(username) > 64:\n        return err(\"username must be at most 64 characters\", 400)\n    if len(password) > 128:\n        return err(\"password must be at most 128 characters\", 400)\n    if username == \"admin\":\n        return err(\"This username is reserved\", 409)\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, hash_password(password), now_iso()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return err(\"Username already taken\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return err(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return err(\"username and password are required\", 400)\n    username = username.strip()\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n\n    if username == \"admin\":\n        env_password = admin_password()\n        if not env_password or not secrets.compare_digest(password, env_password):\n            return err(\"Invalid username or password\", 401)\n        if row is None:\n            db.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (\"admin\", hash_password(env_password), now_iso()),\n            )\n            db.commit()\n            row = db.execute(\n                \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n            ).fetchone()\n    else:\n        if row is None or not verify_password(password, row[\"password_hash\"]):\n            return err(\"Invalid username or password\", 401)\n\n    token = issue_token(row[\"id\"])\n    return jsonify({\"token\": token}), 200\n\n\n# ---------------------------------------------------------------------------\n# link endpoints\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/links\")\ndef create_link():\n    user, error = require_user()\n    if error:\n        return error\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return err(\"Request body must be a JSON object\", 400)\n    url = clean_url(data.get(\"original_url\", data.get(\"url\")))\n    if url is None:\n        return err(\"Only http and https addresses are accepted\", 400)\n    db = get_db()\n    for _attempt in range(5):\n        code = generate_code(db)\n        try:\n            cur = db.execute(\n                \"INSERT INTO links (original_url, short_code, created_at, owner_id, active) \"\n                \"VALUES (?, ?, ?, ?, 1)\",\n                (url, code, now_iso(), user[\"id\"]),\n            )\n            db.commit()\n            break\n        except sqlite3.IntegrityError:\n            db.rollback()\n    else:\n        return err(\"Could not allocate a short code, try again\", 500)\n    return jsonify(serialize_link(fetch_link(cur.lastrowid))), 201\n\n\n@app.get(\"/api/links\")\ndef list_links():\n    page, page_size = paginate()\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS n FROM links WHERE active = 1\").fetchone()[\"n\"]\n    rows = db.execute(\n        LINK_SELECT + \" WHERE l.active = 1 ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_link(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/links/<int:link_id>\")\ndef get_link(link_id: int):\n    row = fetch_link(link_id)\n    if row is None or not row[\"active\"]:\n        return err(\"Link not found\", 404)\n    return jsonify(serialize_link(row))\n\n\n@app.delete(\"/api/links/<int:link_id>\")\ndef delete_link(link_id: int):\n    user, error = require_user()\n    if error:\n        return error\n    row = fetch_link(link_id)\n    if row is None or not row[\"active\"]:\n        return err(\"Link not found\", 404)\n    if row[\"owner_id\"] != user[\"id\"]:\n        return err(\"You can only delete your own links\", 403)\n    db = get_db()\n    db.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n    db.commit()\n    return jsonify(serialize_link(row))\n\n\n# ---------------------------------------------------------------------------\n# admin endpoints\n\n@app.get(\"/api/admin/links\")\ndef admin_links():\n    _user, error = require_admin()\n    if error:\n        return error\n    page, page_size = paginate()\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS n FROM links\").fetchone()[\"n\"]\n    rows = db.execute(\n        LINK_SELECT + \" ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_link(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/links/<int:link_id>/toggle\")\ndef admin_toggle_link(link_id: int):\n    _user, error = require_admin()\n    if error:\n        return error\n    row = fetch_link(link_id)\n    if row is None:\n        return err(\"Link not found\", 404)\n    db = get_db()\n    db.execute(\n        \"UPDATE links SET active = ? WHERE id = ?\", (0 if row[\"active\"] else 1, link_id)\n    )\n    db.commit()\n    return jsonify(serialize_link(fetch_link(link_id)))\n\n\n# ---------------------------------------------------------------------------\n# redirects (must win over the frontend catch-all below)\n\n@app.get(\"/r/<code>\")\ndef follow(code: str):\n    db = get_db()\n    row = db.execute(LINK_SELECT + \" WHERE l.short_code = ?\", (code,)).fetchone()\n    if row is None or not row[\"active\"]:\n        return err(\"Link not found\", 404)\n    db.execute(\"UPDATE links SET click_count = click_count + 1 WHERE id = ?\", (row[\"id\"],))\n    db.commit()\n    return redirect(row[\"original_url\"], code=302)\n\n\n# ---------------------------------------------------------------------------\n# frontend\n\n@app.errorhandler(HTTPException)\ndef handle_http_exception(exc: HTTPException):\n    return jsonify({\"error\": exc.description or exc.name}), exc.code\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\") or path == \"r\" or path.startswith(\"r/\"):\n        return err(\"Not found\", 404)\n    if path:\n        try:\n            return send_from_directory(DIST, path)\n        except NotFound:\n            pass\n    try:\n        return send_from_directory(DIST, \"index.html\")\n    except NotFound:\n        return err(\"Not found\", 404)\n\n\ninit_db()\nensure_admin()","lineStart":1,"lineEnd":468,"totalLines":468,"truncated":false}},"title":"backend/app.py","time":{"start":1794382208674,"end":1794382208685}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9839e9c001DWrQZ8nnupwg3f","sessionID":"ses_e368d1d2affeYlxFBJL2iz5sI0","messageID":"msg_1c98378dd001JcY8pbOc2AqWb6"}}
