{"type":"tool_use","timestamp":1794382033037,"sessionID":"ses_e368d1d2affeYlxFBJL2iz5sI0","part":{"type":"tool","tool":"write","callID":"call_2e9a440b65ea4f6e8618f7cd","state":{"status":"completed","input":{"content":"import type { Link } from \"../types\";\n\nexport function copyText(text: string) {\n  if (navigator.clipboard?.writeText) {\n    navigator.clipboard.writeText(text).catch(() => fallback(text));\n  } else {\n    fallback(text);\n  }\n}\n\nfunction fallback(text: string) {\n  const el = document.createElement(\"textarea\");\n  el.value = text;\n  document.body.appendChild(el);\n  el.select();\n  document.execCommand(\"copy\");\n  el.remove();\n}\n\ninterface RowProps {\n  link: Link;\n  absolute: string;\n  showOwner?: boolean;\n  canDelete?: boolean;\n  canToggle?: boolean;\n  busy?: boolean;\n  onDelete?: (link: Link) => void;\n  onToggle?: (link: Link) => void;\n}\n\nexport default function LinkRow({\n  link,\n  absolute,\n  showOwner = false,\n  canDelete = false,\n  canToggle = false,\n  busy = false,\n  onDelete,\n  onToggle,\n}: RowProps) {\n  const truncated =\n    link.original_url.length > 60 ? `${link.original_url.slice(0, 60)}…` : link.original_url;\n  const date = new Date(link.created_at).toLocaleString(undefined, {\n    dateStyle: \"medium\",\n    timeStyle: \"short\",\n  });\n\n  return (\n    <div\n      className={`flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between ${\n        link.active === false ? \"bg-slate-50\" : \"\"\n      }`}\n    >\n      <div className=\"min-w-0 flex-1\">\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <a\n            href={absolute}\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            className=\"font-mono text-sm font-semibold text-indigo-700 hover:underline\"\n          >\n            {absolute}\n          </a>\n          <button\n            type=\"button\"\n            onClick={() => copyText(absolute)}\n            className=\"rounded border border-slate-300 bg-white px-1.5 py-0.5 text-xs font-medium text-slate-600 hover:bg-slate-100\"\n          >\n            Copy\n          </button>\n          {showOwner && (\n            <span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600\">\n              {link.owner}\n            </span>\n          )}\n          {link.active === false && (\n            <span className=\"rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800\">\n              Disabled\n            </span>\n          )}\n        </div>\n        <p className=\"mt-1 truncate text-xs text-slate-500\" title={link.original_url}>\n          {truncated}\n        </p>\n      </div>\n      <div className=\"flex shrink-0 items-center gap-4 text-xs text-slate-500\">\n        <span className=\"tabular-nums\">\n          {link.click_count} click{link.click_count === 1 ? \"\" : \"s\"}\n        </span>\n        <span className=\"tabular-nums\">{date}</span>\n        {canToggle && (\n          <button\n            type=\"button\"\n            onClick={() => onToggle?.(link)}\n            disabled={busy}\n            className={`rounded-md px-3 py-1.5 text-xs font-semibold text-white shadow-sm disabled:opacity-50 ${\n              link.active === false\n                ? \"bg-emerald-600 hover:bg-emerald-500\"\n                : \"bg-amber-600 hover:bg-amber-500\"\n            }`}\n          >\n            {link.active === false ? \"Enable\" : \"Disable\"}\n          </button>\n        )}\n        {canDelete && (\n          <button\n            type=\"button\"\n            onClick={() => onDelete?.(link)}\n            disabled={busy}\n            className=\"rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-red-500 disabled:opacity-50\"\n          >\n            Delete\n          </button>\n        )}\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/LinkRow.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/LinkRow.tsx","exists":false,"truncated":false},"title":"frontend/src/components/LinkRow.tsx","time":{"start":1794382032996,"end":1794382033013}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c980f05d001oGCASnVgxtTYCF","sessionID":"ses_e368d1d2affeYlxFBJL2iz5sI0","messageID":"msg_1c980a9fc001zI68dLh7zWYdcw"}}
