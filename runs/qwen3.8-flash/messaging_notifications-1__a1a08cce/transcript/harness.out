{"type":"tool_use","timestamp":1794348061336,"sessionID":"ses_e388961eaffeiZr8Qz2wf5T8Hw","part":{"type":"tool","tool":"write","callID":"call_12aa9a2c7c0248be998bcb0a","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the notification center.\"\"\"\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"notifications.db\"\n\nADMIN_USERNAME = \"admin\"\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------- database\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.execute(\"PRAGMA foreign_keys=ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    db = get_db()\n    db.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS notifications (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            message TEXT NOT NULL,\n            type TEXT NOT NULL,\n            read INTEGER NOT NULL DEFAULT 0,\n            created_at TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_notifications_user\n            ON notifications(user_id, created_at DESC, id DESC);\n        \"\"\"\n    )\n    db.commit()\n\n\n# ---------------------------------------------------------------- passwords\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), 120_000\n    )\n    return f\"{salt}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt, digest = stored.split(\"$\", 1)\n        check = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), 120_000\n        ).hex()\n    except ValueError:\n        return False\n    return secrets.compare_digest(check, digest)\n\n\ndef ensure_admin():\n    \"\"\"Create/update the admin account from ADMIN_PASSWORD at startup.\"\"\"\n    password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n    # When unset/empty admin sign-in must be impossible: hash a random value.\n    stored = hash_password(password) if password else hash_password(secrets.token_hex(32))\n    db = get_db()\n    row = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n    ).fetchone()\n    if row is None:\n        db.execute(\n            \"INSERT INTO users(username, password_hash, created_at) VALUES(?, ?, ?)\",\n            (ADMIN_USERNAME, stored, now_iso()),\n        )\n    else:\n        db.execute(\n            \"UPDATE users SET password_hash = ? WHERE id = ?\", (stored, row[\"id\"])\n        )\n    db.commit()\n\n\n@app.before_request\ndef prepare():\n    db = get_db()\n    if not getattr(app, \"_db_ready\", False):\n        init_db()\n        ensure_admin()\n        app._db_ready = True\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\n# ---------------------------------------------------------------- auth\n\n\ndef create_token(user_id: int) -> str:\n    token = secrets.token_hex(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens(token, user_id, created_at) VALUES(?, ?, ?)\",\n        (token, user_id, now_iso()),\n    )\n    db.commit()\n    return token\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.* FROM users u JOIN tokens t ON t.user_id = u.id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user(f):\n    @wraps(f)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            abort(401, description=\"authentication required\")\n        g.user = user\n        return f(*args, **kwargs)\n\n    return wrapper\n\n\ndef body_json() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        abort(400, description=\"request body must be a JSON object\")\n    return data\n\n\ndef clean_credentials(data: dict) -> tuple[str, str]:\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        abort(400, description=\"username is required\")\n    if not isinstance(password, str) or not password:\n        abort(400, description=\"password is required\")\n    return username.strip(), password\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = clean_credentials(body_json())\n    if username.lower() == ADMIN_USERNAME:\n        abort(409, description=\"username not available\")\n    db = get_db()\n    exists = db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if exists:\n        abort(409, description=\"username already taken\")\n    db.execute(\n        \"INSERT INTO users(username, password_hash, created_at) VALUES(?, ?, ?)\",\n        (username, hash_password(password), now_iso()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = clean_credentials(body_json())\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        abort(401, description=\"invalid credentials\")\n    if username == ADMIN_USERNAME and not os.environ.get(\"ADMIN_PASSWORD\", \"\"):\n        abort(401, description=\"invalid credentials\")\n    return jsonify({\"token\": create_token(row[\"id\"])})\n\n\n@app.get(\"/api/auth/me\")\n@require_user\ndef me():\n    return jsonify(\n        {\n            \"username\": g.user[\"username\"],\n            \"is_admin\": g.user[\"username\"] == ADMIN_USERNAME,\n        }\n    )\n\n\n# ---------------------------------------------------------------- notifications\n\n\ndef notification_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef parse_bool(value, name: str):\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, str):\n        lowered = value.strip().lower()\n        if lowered in (\"true\", \"1\"):\n            return True\n        if lowered in (\"false\", \"0\"):\n            return False\n    abort(400, description=f\"{name} must be a boolean\")\n\n\ndef parse_int(value, name: str, default: int) -> int:\n    if value is None or value == \"\":\n        return default\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        abort(400, description=f\"{name} must be an integer\")\n\n\n@app.get(\"/api/notifications\")\n@require_user\ndef list_notifications():\n    db = get_db()\n    user_id = g.user[\"id\"]\n\n    where = [\"user_id = ?\"]\n    params: list = [user_id]\n\n    read_raw = request.args.get(\"read\")\n    if read_raw not in (None, \"\"):\n        where.append(\"read = ?\")\n        params.append(1 if parse_bool(read_raw, \"read\") else 0)\n\n    type_raw = request.args.get(\"type\")\n    if type_raw not in (None, \"\"):\n        where.append(\"type = ?\")\n        params.append(type_raw)\n\n    clause = \" AND \".join(where)\n    total = db.execute(\n        f\"SELECT COUNT(*) AS n FROM notifications WHERE {clause}\", params\n    ).fetchone()[\"n\"]\n\n    unread_count = db.execute(\n        \"SELECT COUNT(*) AS n FROM notifications WHERE user_id = ? AND read = 0\",\n        (user_id,),\n    ).fetchone()[\"n\"]\n\n    page = parse_int(request.args.get(\"page\"), \"page\", 1)\n    page_size = parse_int(request.args.get(\"page_size\"), \"page_size\", DEFAULT_PAGE_SIZE)\n    if page < 1:\n        abort(400, description=\"page must be >= 1\")\n    if page_size < 1 or page_size > MAX_PAGE_SIZE:\n        abort(400, description=f\"page_size must be between 1 and {MAX_PAGE_SIZE}\")\n\n    rows = db.execute(\n        f\"SELECT * FROM notifications WHERE {clause} \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        (*params, page_size, (page - 1) * page_size),\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [notification_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread_count,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@require_user\ndef create_notification():\n    data = body_json()\n    message = data.get(\"message\")\n    if not isinstance(message, str) or not message.strip():\n        abort(400, description=\"message is required\")\n    ntype = data.get(\"type\")\n    if ntype is None:\n        ntype = \"general\"\n    if not isinstance(ntype, str) or not ntype.strip():\n        abort(400, description=\"type must be a non-empty string\")\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notifications(user_id, message, type, read, created_at) \"\n        \"VALUES(?, ?, ?, 0, ?)\",\n        (g.user[\"id\"], message, ntype.strip(), now_iso()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(notification_to_dict(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@require_user\ndef read_all():\n    db = get_db()\n    cur = db.execute(\n        \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\",\n        (g.user[\"id\"],),\n    )\n    db.commit()\n    return jsonify({\"updated\": cur.rowcount})\n\n\ndef get_owned_notification(notification_id: int) -> sqlite3.Row:\n    row = get_db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        abort(404, description=\"notification not found\")\n    return row\n\n\n@app.get(\"/api/notifications/<int:notification_id>\")\n@require_user\ndef get_notification(notification_id: int):\n    return jsonify(notification_to_dict(get_owned_notification(notification_id)))\n\n\n@app.patch(\"/api/notifications/<int:notification_id>\")\n@require_user\ndef patch_notification(notification_id: int):\n    row = get_owned_notification(notification_id)\n    read = parse_bool(body_json().get(\"read\"), \"read\")\n    db = get_db()\n    db.execute(\n        \"UPDATE notifications SET read = ? WHERE id = ?\", (1 if read else 0, row[\"id\"])\n    )\n    db.commit()\n    return jsonify(notification_to_dict(get_owned_notification(notification_id)))\n\n\n@app.delete(\"/api/notifications/<int:notification_id>\")\n@require_user\ndef delete_notification(notification_id: int):\n    row = get_owned_notification(notification_id)\n    db = get_db()\n    db.execute(\"DELETE FROM notifications WHERE id = ?\", (row[\"id\"],))\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------- admin\n\n\n@app.post(\"/api/admin/broadcast\")\n@require_user\ndef broadcast():\n    if g.user[\"username\"] != ADMIN_USERNAME:\n        abort(403, description=\"admin only\")\n    data = body_json()\n    message = data.get(\"message\")\n    if not isinstance(message, str) or not message.strip():\n        abort(400, description=\"message is required\")\n    ntype = data.get(\"type\")\n    if ntype is None:\n        ntype = \"announcement\"\n    if not isinstance(ntype, str) or not ntype.strip():\n        abort(400, description=\"type must be a non-empty string\")\n    db = get_db()\n    created = now_iso()\n    ntype = ntype.strip()\n    users = db.execute(\"SELECT id FROM users\").fetchall()\n    db.executemany(\n        \"INSERT INTO notifications(user_id, message, type, read, created_at) \"\n        \"VALUES(?, ?, ?, 0, ?)\",\n        [(u[\"id\"], message, ntype, created) for u in users],\n    )\n    db.commit()\n    return jsonify({\"delivered\": len(users)})\n\n\n# ---------------------------------------------------------------- errors\n\n\n@app.errorhandler(400)\n@app.errorhandler(401)\n@app.errorhandler(403)\n@app.errorhandler(404)\n@app.errorhandler(409)\ndef handle_error(err):\n    return jsonify({\"error\": getattr(err, \"description\", \"error\")}), err.code\n\n\n@app.route(\"/api/<path:_rest>\", methods=[\"GET\", \"POST\", \"PATCH\", \"PUT\", \"DELETE\"])\ndef unknown_api(_rest):\n    abort(404, description=\"not found\")\n\n\n# ---------------------------------------------------------------- frontend\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794348061298,"end":1794348061318}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c77a926b001bncsayjyQIGwQ6","sessionID":"ses_e388961eaffeiZr8Qz2wf5T8Hw","messageID":"msg_1c779389b0011WiMZSgc3nG03I"}}
