{"type":"tool_use","timestamp":1794348298483,"sessionID":"ses_e388961eaffeiZr8Qz2wf5T8Hw","part":{"type":"tool","tool":"write","callID":"call_c420385b3c454bf19e2d483d","state":{"status":"completed","input":{"content":"import json\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8015\"\nFAILS = []\n\n\ndef req(method, path, body=None, token=None, expect=None):\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(BASE + path, data=data, method=method)\n    r.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        r.add_header(\"Authorization\", f\"Bearer {token}\")\n    try:\n        resp = urllib.request.urlopen(r)\n        status, payload = resp.status, resp.read()\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, e.read()\n    parsed = json.loads(payload) if payload else None\n    if expect is not None and status != expect:\n        FAILS.append(f\"{method} {path} -> {status} (expected {expect}) {payload[:200]}\")\n    return status, parsed\n\n\ndef check(name, cond):\n    print((\"PASS \" if cond else \"FAIL \") + name)\n    if not cond:\n        FAILS.append(name)\n\n\n# health\nreq(\"GET\", \"/api/health\", expect=200)\n_, h = req(\"GET\", \"/api/health\")\ncheck(\"health\", h == {\"status\": \"ok\"})\n\n# register two users\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw1\"}, expect=201)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw2\"}, expect=201)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"}, expect=400)\n\n# login\n_, la = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw1\"}, expect=200)\n_, lb = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw2\"}, expect=200)\nta, tb = la[\"token\"], lb[\"token\"]\nreq(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"bad\"}, expect=401)\n\n# admin login with ADMIN_PASSWORD\n_, lam = req(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"s3cret\"}, expect=200)\ntm = lam[\"token\"]\nreq(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"wrong\"}, expect=401)\n\n# unauth\nreq(\"GET\", \"/api/notifications\", expect=401)\nreq(\"GET\", \"/api/notifications\", token=\"nope\", expect=401)\n\n# create\nst, n1 = req(\"POST\", \"/api/notifications\", {\"message\": \"hello\", \"type\": \"info\"}, ta, expect=201)\ncheck(\"create shape\", set(n1) == {\"id\", \"message\", \"type\", \"read\", \"created_at\"} and n1[\"read\"] is False)\nst, n2 = req(\"POST\", \"/api/notifications\", {\"message\": \"second\"}, ta, expect=201)\ncheck(\"default type\", n2[\"type\"] == \"general\")\nreq(\"POST\", \"/api/notifications\", {\"message\": \"\"}, ta, expect=400)\n_, n3 = req(\"POST\", \"/api/notifications\", {\"message\": \"bob one\", \"type\": \"warning\"}, tb, expect=201)\n\n# list newest first\n_, lst = req(\"GET\", \"/api/notifications\", token=ta, expect=200)\ncheck(\"list keys\", set(lst) == {\"items\", \"total\", \"page\", \"page_size\", \"unread_count\"})\ncheck(\"newest first\", [i[\"id\"] for i in lst[\"items\"]] == [n2[\"id\"], n1[\"id\"]])\ncheck(\"unread_count\", lst[\"unread_count\"] == 2 and lst[\"total\"] == 2)\ncheck(\"isolation\", all(i[\"id\"] != n3[\"id\"] for i in lst[\"items\"]))\n\n# filters\n_, lf = req(\"GET\", \"/api/notifications?read=false\", token=ta, expect=200)\ncheck(\"filter read=false\", lf[\"total\"] == 2)\n_, lt = req(\"GET\", \"/api/notifications?type=info\", token=ta, expect=200)\ncheck(\"filter type\", lt[\"total\"] == 1 and lt[\"items\"][0][\"id\"] == n1[\"id\"])\ncheck(\"unread_count ignores filters\", lt[\"unread_count\"] == 2)\n\n# patch read\n_, pr = req(\"PATCH\", f\"/api/notifications/{n1['id']}\", {\"read\": True}, ta, expect=200)\ncheck(\"patch read true\", pr[\"read\"] is True)\n_, pr = req(\"PATCH\", f\"/api/notifications/{n1['id']}\", {\"read\": False}, ta, expect=200)\ncheck(\"patch read false\", pr[\"read\"] is False)\n_, pr = req(\"PATCH\", f\"/api/notifications/{n1['id']}\", {\"read\": True}, ta, expect=200)\n_, lst = req(\"GET\", \"/api/notifications\", token=ta)\ncheck(\"unread after patch\", lst[\"unread_count\"] == 1)\n\n# cross-user isolation\nreq(\"GET\", f\"/api/notifications/{n1['id']}\", token=tb, expect=404)\nreq(\"PATCH\", f\"/api/notifications/{n1['id']}\", {\"read\": True}, tb, expect=404)\nreq(\"DELETE\", f\"/api/notifications/{n1['id']}\", token=tb, expect=404)\n\n# get one\n_, g1 = req(\"GET\", f\"/api/notifications/{n1['id']}\", ta, expect=200)\ncheck(\"get one\", g1[\"id\"] == n1[\"id\"])\n\n# read-all\n_, ra = req(\"POST\", \"/api/notifications/read-all\", token=ta, expect=200)\ncheck(\"read-all updated\", ra[\"updated\"] == 1)\n_, ra2 = req(\"POST\", \"/api/notifications/read-all\", token=ta, expect=200)\ncheck(\"read-all idempotent\", ra2[\"updated\"] == 0)\n\n# paging: alice adds many\nids = []\nfor i in range(15):\n    _, nn = req(\"POST\", \"/api/notifications\", {\"message\": f\"m{i}\", \"type\": \"info\"}, ta, expect=201)\n    ids.append(nn[\"id\"])\n_, p1 = req(\"GET\", \"/api/notifications?page=1&page_size=5\", ta, expect=200)\n_, p2 = req(\"GET\", \"/api/notifications?page=2&page_size=5\", ta, expect=200)\ncheck(\"paging\", p1[\"page\"] == 1 and len(p1[\"items\"]) == 5 and p1[\"total\"] == 17\n      and {i[\"id\"] for i in p1[\"items\"]} != {i[\"id\"] for i in p2[\"items\"]})\ncheck(\"paging desc\", p1[\"items\"][0][\"id\"] > p2[\"items\"][-1][\"id\"])\nreq(\"GET\", \"/api/notifications?page=0\", ta, expect=400)\nreq(\"GET\", \"/api/notifications?page_size=0\", ta, expect=400)\n\n# delete\n_, d = req(\"DELETE\", f\"/api/notifications/{ids[0]}\", token=ta, expect=204)\nreq(\"GET\", f\"/api/notifications/{ids[0]}\", ta, expect=404)\n_, lst = req(\"GET\", \"/api/notifications\", ta)\ncheck(\"delete total\", lst[\"total\"] == 16)\n\n# broadcast\nids_b = []\nfor i in range(3):\n    _, nn = req(\"POST\", \"/api/notifications\", {\"message\": f\"b{i}\"}, tb, expect=201)\n    ids_b.append(nn[\"id\"])\n_, bc = req(\"POST\", \"/api/admin/broadcast\", {\"message\": \"Party time\", \"type\": \"announcement\"}, tm, expect=200)\ncheck(\"broadcast delivered\", bc[\"delivered\"] == 3)\n_, bl = req(\"GET\", \"/api/notifications?read=false\", tb)\ncheck(\"broadcast in bob inbox\", any(i[\"message\"] == \"Party time\" for i in bl[\"items\"]))\n_, al = req(\"GET\", \"/api/notifications\", ta)\ncheck(\"broadcast in alice inbox\", any(i[\"message\"] == \"Party time\" for i in al[\"items\"]))\nreq(\"POST\", \"/api/admin/broadcast\", {\"message\": \"x\"}, tb, expect=403)\nreq(\"POST\", \"/api/admin/broadcast\", {\"message\": \"x\"}, expect=401)\nreq(\"POST\", \"/api/admin/broadcast\", {\"message\": \"\"}, tm, expect=400)\n\n# frontend served\nr = urllib.request.urlopen(BASE + \"/\")\nhtml = r.read().decode()\ncheck(\"frontend html\", \"Notification\" in html or \"<div id=\\\"root\\\">\" in html)\nr = urllib.request.urlopen(BASE + \"/some/spa/route\")\ncheck(\"spa fallback\", \"<div id=\\\"root\\\">\" in r.read().decode())\nimport urllib.parse\nassets = [p for p in __import__(\"re\").findall(r'src=\"(/assets/[^\"]+)\"', html)]\nif assets:\n    r = urllib.request.urlopen(BASE + assets[0])\n    check(\"asset served\", r.status == 200)\n\n# unknown api 404\nreq(\"GET\", \"/api/nope\", expect=404)\n\nprint()\nif FAILS:\n    print(\"FAILURES:\")\n    for f in FAILS:\n        print(\" -\", f)\n    sys.exit(1)\nprint(f\"ALL TESTS PASSED ({len(FAILS)} failures)\")\n","filePath":"/workspace/.tmp_apitest.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.tmp_apitest.py","exists":false,"truncated":false},"title":".tmp_apitest.py","time":{"start":1794348298450,"end":1794348298460}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c77e30cb00165gZwap7CR482l","sessionID":"ses_e388961eaffeiZr8Qz2wf5T8Hw","messageID":"msg_1c77dc98b001b7aHTA5P2mh4VB"}}
