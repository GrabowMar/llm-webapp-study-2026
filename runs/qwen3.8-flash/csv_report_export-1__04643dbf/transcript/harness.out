{"type":"tool_use","timestamp":1794360411377,"sessionID":"ses_e37d33a11ffeMHgC95qw7U4JLZ","part":{"type":"tool","tool":"write","callID":"call_7bfc9ea7c5a04feb87c29f04","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { api } from \"../api\";\nimport type { Entry } from \"../types\";\n\ninterface Props {\n  items: Entry[];\n  total: number;\n  page: number;\n  pageSize: number;\n  loading: boolean;\n  error: string | null;\n  onPage: (page: number) => void;\n  onPageSize: (size: number) => void;\n  onChanged: () => void;\n  onUnauthorized: () => void;\n}\n\ninterface Draft {\n  project: string;\n  description: string;\n  hours: string;\n  date: string;\n}\n\nfunction toDraft(entry: Entry): Draft {\n  return {\n    project: entry.project,\n    description: entry.description,\n    hours: String(entry.hours),\n    date: entry.date,\n  };\n}\n\nfunction draftError(draft: Draft): string | null {\n  if (!draft.project.trim()) return \"Project must not be empty.\";\n  const hours = Number(draft.hours);\n  if (!draft.hours.trim() || !Number.isFinite(hours) || hours <= 0 || hours > 24) {\n    return \"Hours must be a number between 0 and 24.\";\n  }\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(draft.date)) return \"Date must be YYYY-MM-DD.\";\n  return null;\n}\n\nconst input =\n  \"w-full rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\";\n\nexport default function EntryList({\n  items,\n  total,\n  page,\n  pageSize,\n  loading,\n  error,\n  onPage,\n  onPageSize,\n  onChanged,\n  onUnauthorized,\n}: Props) {\n  const [editingId, setEditingId] = useState<number | null>(null);\n  const [draft, setDraft] = useState<Draft | null>(null);\n  const [inlineError, setInlineError] = useState<string | null>(null);\n  const [confirmId, setConfirmId] = useState<number | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  function startEdit(entry: Entry) {\n    setEditingId(entry.id);\n    setConfirmId(null);\n    setInlineError(null);\n    setDraft(toDraft(entry));\n  }\n\n  function cancelEdit() {\n    setEditingId(null);\n    setDraft(null);\n    setInlineError(null);\n  }\n\n  function handleError(err: unknown) {\n    if (err && typeof err === \"object\" && \"status\" in err && err.status === 401) {\n      onUnauthorized();\n      return;\n    }\n    setInlineError(err instanceof Error ? err.message : \"Request failed.\");\n  }\n\n  async function save(entry: Entry) {\n    if (!draft || busy) return;\n    const invalid = draftError(draft);\n    if (invalid) {\n      setInlineError(invalid);\n      return;\n    }\n    setBusy(true);\n    setInlineError(null);\n    try {\n      await api.updateEntry(entry.id, {\n        project: draft.project.trim(),\n        description: draft.description,\n        hours: Number(draft.hours),\n        date: draft.date,\n      });\n      cancelEdit();\n      onChanged();\n    } catch (err) {\n      handleError(err);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function remove(entry: Entry) {\n    if (busy) return;\n    setBusy(true);\n    setInlineError(null);\n    try {\n      await api.deleteEntry(entry.id);\n      setConfirmId(null);\n      if (editingId === entry.id) cancelEdit();\n      onChanged();\n    } catch (err) {\n      handleError(err);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const pages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <div className=\"rounded-xl bg-white shadow-sm ring-1 ring-slate-200\">\n      <div className=\"flex items-center justify-between border-b border-slate-100 px-5 py-4\">\n        <h2 className=\"text-sm font-semibold uppercase tracking-wide text-slate-500\">\n          Entries\n        </h2>\n        <div className=\"flex items-center gap-3 text-sm text-slate-500\">\n          <label htmlFor=\"page-size\">\n            Rows\n            <select\n              id=\"page-size\"\n              value={pageSize}\n              onChange={(e) => onPageSize(Number(e.target.value))}\n              className=\"ml-2 rounded-md border border-slate-300 px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-200\"\n            >\n              {[10, 25, 50].map((n) => (\n                <option key={n} value={n}>\n                  {n}\n                </option>\n              ))}\n            </select>\n          </label>\n          <span>\n            {total} {total === 1 ? \"entry\" : \"entries\"}\n          </span>\n        </div>\n      </div>\n\n      {error && (\n        <p role=\"alert\" className=\"m-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n      {inlineError && (\n        <p role=\"alert\" className=\"m-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {inlineError}\n        </p>\n      )}\n      {loading && items.length === 0 ? (\n        <p className=\"px-5 py-10 text-center text-sm text-slate-400\">Loading…</p>\n      ) : items.length === 0 ? (\n        <p className=\"px-5 py-10 text-center text-sm text-slate-400\">\n          No entries for these filters. Log some time above to get started.\n        </p>\n      ) : (\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead>\n              <tr className=\"border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400\">\n                <th className=\"px-5 py-2 font-medium\">Date</th>\n                <th className=\"px-3 py-2 font-medium\">Project</th>\n                <th className=\"px-3 py-2 font-medium\">Description</th>\n                <th className=\"px-3 py-2 text-right font-medium\">Hours</th>\n                <th className=\"px-5 py-2 text-right font-medium\">Actions</th>\n              </tr>\n            </thead>\n            <tbody>\n              {items.map((entry) => {\n                const editing = editingId === entry.id && draft !== null;\n                return (\n                  <tr key={entry.id} className=\"border-b border-slate-50 align-top\">\n                    <td className=\"whitespace-nowrap px-5 py-3 text-slate-600\">\n                      {editing ? (\n                        <input\n                          type=\"date\"\n                          value={draft.date}\n                          onChange={(e) => setDraft({ ...draft, date: e.target.value })}\n                          className={input}\n                        />\n                      ) : (\n                        entry.date\n                      )}\n                    </td>\n                    <td className=\"px-3 py-3\">\n                      {editing ? (\n                        <input\n                          value={draft.project}\n                          onChange={(e) => setDraft({ ...draft, project: e.target.value })}\n                          className={input}\n                        />\n                      ) : (\n                        <span className=\"inline-block rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700\">\n                          {entry.project}\n                        </span>\n                      )}\n                    </td>\n                    <td className=\"max-w-md px-3 py-3 text-slate-600\">\n                      {editing ? (\n                        <textarea\n                          rows={2}\n                          value={draft.description}\n                          onChange={(e) =>\n                            setDraft({ ...draft, description: e.target.value })\n                          }\n                          className={input}\n                        />\n                      ) : entry.description ? (\n                        <span className=\"whitespace-pre-wrap break-words\">\n                          {entry.description}\n                        </span>\n                      ) : (\n                        <span className=\"text-slate-300\">—</span>\n                      )}\n                    </td>\n                    <td className=\"px-3 py-3 text-right font-medium tabular-nums text-slate-700\">\n                      {editing ? (\n                        <input\n                          type=\"number\"\n                          min=\"0.01\"\n                          max=\"24\"\n                          step=\"0.05\"\n                          value={draft.hours}\n                          onChange={(e) => setDraft({ ...draft, hours: e.target.value })}\n                          className={`${input} text-right`}\n                        />\n                      ) : (\n                        entry.hours\n                      )}\n                    </td>\n                    <td className=\"whitespace-nowrap px-5 py-3 text-right\">\n                      {editing ? (\n                        <span className=\"inline-flex gap-2\">\n                          <button\n                            onClick={() => save(entry)}\n                            disabled={busy}\n                            className=\"rounded-md bg-indigo-600 px-3 py-1 text-xs font-semibold text-white hover:bg-indigo-500 disabled:opacity-60\"\n                          >\n                            Save\n                          </button>\n                          <button\n                            onClick={cancelEdit}\n                            disabled={busy}\n                            className=\"rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50\"\n                          >\n                            Cancel\n                          </button>\n                        </span>\n                      ) : confirmId === entry.id ? (\n                        <span className=\"inline-flex items-center gap-2\">\n                          <span className=\"text-xs text-slate-500\">Delete?</span>\n                          <button\n                            onClick={() => remove(entry)}\n                            disabled={busy}\n                            className=\"rounded-md bg-red-600 px-3 py-1 text-xs font-semibold text-white hover:bg-red-500 disabled:opacity-60\"\n                          >\n                            Yes, delete\n                          </button>\n                          <button\n                            onClick={() => setConfirmId(null)}\n                            disabled={busy}\n                            className=\"rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50\"\n                          >\n                            Keep\n                          </button>\n                        </span>\n                      ) : (\n                        <span className=\"inline-flex gap-2\">\n                          <button\n                            onClick={() => startEdit(entry)}\n                            className=\"rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50\"\n                          >\n                            Edit\n                          </button>\n                          <button\n                            onClick={() => {\n                              setEditingId(null);\n                              setDraft(null);\n                              setConfirmId(entry.id);\n                            }}\n                            className=\"rounded-md border border-red-200 px-3 py-1 text-xs font-medium text-red-600 hover:bg-red-50\"\n                          >\n                            Delete\n                          </button>\n                        </span>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      <div className=\"flex items-center justify-between px-5 py-3 text-sm text-slate-500\">\n        <span>\n          Page {page} of {pages}\n        </span>\n        <span className=\"inline-flex gap-2\">\n          <button\n            onClick={() => onPage(page - 1)}\n            disabled={page <= 1 || loading}\n            className=\"rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <button\n            onClick={() => onPage(page + 1)}\n            disabled={page >= pages || loading}\n            className=\"rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </span>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/EntryList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/EntryList.tsx","exists":false,"truncated":false},"title":"frontend/src/components/EntryList.tsx","time":{"start":1794360411294,"end":1794360411306}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8370492001I3ihl3Kf6LFpna","sessionID":"ses_e37d33a11ffeMHgC95qw7U4JLZ","messageID":"msg_1c83681fc001duqxg8O4syRD7N"}}
