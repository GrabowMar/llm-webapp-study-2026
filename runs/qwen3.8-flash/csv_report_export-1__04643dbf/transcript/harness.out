(\n+            str(round(row[\"hours\"], 2))\n+        )\n+    projects = sorted(totals)\n+    return jsonify(\n+        {\n+            \"items\": [\n+                {\"project\": p, \"hours\": _hours_number(float(totals[p]))} for p in projects\n+            ],\n+            \"total_hours\": _hours_number(float(sum(totals.values(), Decimal(0)))),\n+        }\n+    )\n+\n+\n @app.get(\"/api/exports/entries.csv\")\n @login_required\n def export_entries():\n     try:\n","filediff":{"file":"/workspace/backend/app.py","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -473,8 +473,34 @@\n     response.headers[\"Cache-Control\"] = \"no-store\"\n     return response\n \n \n+@app.get(\"/api/summary\")\n+@login_required\n+def summary_json():\n+    try:\n+        where, params = _build_filter(allow_project=True)\n+    except ValueError as exc:\n+        return error(str(exc))\n+    rows = get_db().execute(\n+        f\"SELECT project, hours FROM entries WHERE {where}\", params\n+    ).fetchall()\n+    totals: dict[str, Decimal] = {}\n+    for row in rows:\n+        totals[row[\"project\"]] = totals.get(row[\"project\"], Decimal(0)) + Decimal(\n+            str(round(row[\"hours\"], 2))\n+        )\n+    projects = sorted(totals)\n+    return jsonify(\n+        {\n+            \"items\": [\n+                {\"project\": p, \"hours\": _hours_number(float(totals[p]))} for p in projects\n+            ],\n+            \"total_hours\": _hours_number(float(sum(totals.values(), Decimal(0)))),\n+        }\n+    )\n+\n+\n @app.get(\"/api/exports/entries.csv\")\n @login_required\n def export_entries():\n     try:\n","additions":26,"deletions":0},"truncated":false},"title":"backend/app.py","time":{"start":1794360238450,"end":1794360238464}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8346169001Zn5oUKAie16TAT","sessionID":"ses_e37d33a11ffeMHgC