{"type":"tool_use","timestamp":1794360370622,"sessionID":"ses_e37d33a11ffeMHgC95qw7U4JLZ","part":{"type":"tool","tool":"write","callID":"call_706d53866f834268b467008e","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { downloadCsv, api } from \"../api\";\nimport type { Filters } from \"../types\";\n\ninterface Props {\n  filters: Filters;\n  projects: string[];\n  onChange: (filters: Filters) => void;\n}\n\nconst field =\n  \"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\";\n\nexport default function FiltersBar({ filters, projects, onChange }: Props) {\n  const [draft, setDraft] = useState<Filters>(filters);\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => setDraft(filters), [filters]);\n\n  function apply() {\n    onChange({\n      start_date: draft.start_date.trim(),\n      end_date: draft.end_date.trim(),\n      project: draft.project.trim(),\n    });\n  }\n\n  function clear() {\n    const empty: Filters = { start_date: \"\", end_date: \"\", project: \"\" };\n    setDraft(empty);\n    onChange(empty);\n  }\n\n  async function exportCsv(kind: \"entries\" | \"summary\") {\n    if (busy) return;\n    setBusy(true);\n    setError(null);\n    try {\n      await downloadCsv(kind, filters);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Export failed.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200\">\n      <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n        <div>\n          <label className=\"block text-sm font-medium text-slate-700\" htmlFor=\"f-start\">\n            From\n          </label>\n          <input\n            id=\"f-start\"\n            type=\"date\"\n            value={draft.start_date}\n            onChange={(e) => setDraft({ ...draft, start_date: e.target.value })}\n            className={`${field} mt-1`}\n          />\n        </div>\n        <div>\n          <label className=\"block text-sm font-medium text-slate-700\" htmlFor=\"f-end\">\n            To\n          </label>\n          <input\n            id=\"f-end\"\n            type=\"date\"\n            value={draft.end_date}\n            onChange={(e) => setDraft({ ...draft, end_date: e.target.value })}\n            className={`${field} mt-1`}\n          />\n        </div>\n        <div>\n          <label className=\"block text-sm font-medium text-slate-700\" htmlFor=\"f-project\">\n            Project\n          </label>\n          <select\n            id=\"f-project\"\n            value={draft.project}\n            onChange={(e) => setDraft({ ...draft, project: e.target.value })}\n            className={`${field} mt-1`}\n          >\n            <option value=\"\">All projects</option>\n            {projects.map((p) => (\n              <option key={p} value={p}>\n                {p}\n              </option>\n            ))}\n          </select>\n        </div>\n        <div className=\"flex items-end gap-2\">\n          <button\n            onClick={apply}\n            className=\"rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700\"\n          >\n            Apply\n          </button>\n          <button\n            onClick={clear}\n            className=\"rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50\"\n          >\n            Clear\n          </button>\n        </div>\n      </div>\n      <div className=\"mt-4 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4\">\n        <button\n          onClick={() => exportCsv(\"entries\")}\n          disabled={busy}\n          className=\"inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 disabled:opacity-60\"\n        >\n          <DownloadIcon /> Export CSV\n        </button>\n        <button\n          onClick={() => exportCsv(\"summary\")}\n          disabled={busy}\n          className=\"inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 disabled:opacity-60\"\n        >\n          <DownloadIcon /> Export totals\n        </button>\n        {error && <span className=\"text-sm text-red-600\">{error}</span>}\n        <button\n          onClick={() => {\n            api.logout().catch(() => undefined);\n          }}\n          className=\"hidden\"\n        />\n      </div>\n    </div>\n  );\n}\n\nfunction DownloadIcon() {\n  return (\n    <svg className=\"h-4 w-4\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\">\n      <path d=\"M10 3a1 1 0 0 1 1 1v6.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L9 10.586V4a1 1 0 0 1 1-1Z\" />\n      <path d=\"M4 14a1 1 0 0 1 1 1v1h10v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z\" />\n    </svg>\n  );\n}\n","filePath":"/workspace/frontend/src/components/FiltersBar.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/FiltersBar.tsx","exists":false,"truncated":false},"title":"frontend/src/components/FiltersBar.tsx","time":{"start":1794360370569,"end":1794360370595}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8366582001Z3h21WfO465XJe","sessionID":"ses_e37d33a11ffeMHgC95qw7U4JLZ","messageID":"msg_1c8361bd6001xmd9cEHqaB4blL"}}
