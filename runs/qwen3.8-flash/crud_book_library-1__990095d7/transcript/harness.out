e);\n try {\n   if (mode === \"register\") {\n     await register(username, password);\n-    const res = await login(username, password);\n-    onAuthed(res.token);\n-  } else {\n-    const res = await login(username, password);\n-    onAuthed(res.token);\n   }\n+  const res = await login(username, password);\n+  onAuthed(res.token, username.trim());\n } catch (err) {\n   setError(err instanceof ApiError ? err.message : \"Network error, please try again.\");\n } finally {\n   setBusy(false);\n","additions":2,"deletions":5},"truncated":false},"title":"frontend/src/components/AuthPage.tsx","time":{"start":1794305114565,"end":1794305114575}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4eb41c0001QHx99KlZI0ps0C","sessionID":"ses_e3b1d6d7affej9AbTtVkNRSTe2","messageID":"msg_1c4eb31b7001cjbwX8SJJykGQE"}}
