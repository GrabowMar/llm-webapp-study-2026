{"type":"tool_use","timestamp":1794304980985,"sessionID":"ses_e3b1d6d7affej9AbTtVkNRSTe2","part":{"type":"tool","tool":"write","callID":"call_969c28f845244924b43c31ad","state":{"status":"completed","input":{"content":"export interface Book {\n  id: number;\n  title: string;\n  author: string;\n  year: number | null;\n  isbn: string | null;\n  created_at: string;\n  review_count: number;\n  average_rating: number | null;\n}\n\nexport interface Review {\n  id: number;\n  book_id: number;\n  rating: number;\n  comment: string | null;\n  created_at: string;\n  username: string;\n}\n\nexport interface BookPage {\n  items: Book[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nconst TOKEN_KEY = \"booklib.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const res = await fetch(path, { ...options, headers });\n  let body: unknown = null;\n  try {\n    body = await res.json();\n  } catch {\n    body = null;\n  }\n  if (!res.ok) {\n    const msg =\n      body && typeof body === \"object\" && \"error\" in body\n        ? String((body as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, msg);\n  }\n  return body as T;\n}\n\nexport function listBooks(q: string, page: number, pageSize: number) {\n  const params = new URLSearchParams({ page: String(page), page_size: String(pageSize) });\n  if (q.trim()) params.set(\"q\", q.trim());\n  return request<BookPage>(`/api/books?${params}`);\n}\n\nexport function getBook(id: number) {\n  return request<Book>(`/api/books/${id}`);\n}\n\nexport function createBook(data: Record<string, unknown>) {\n  return request<Book>(\"/api/books\", { method: \"POST\", body: JSON.stringify(data) });\n}\n\nexport function updateBook(id: number, data: Record<string, unknown>) {\n  return request<Book>(`/api/books/${id}`, { method: \"PUT\", body: JSON.stringify(data) });\n}\n\nexport function deleteBook(id: number) {\n  return request<{ message: string }>(`/api/books/${id}`, { method: \"DELETE\" });\n}\n\nexport function listReviews(bookId: number) {\n  return request<{ items: Review[] }>(`/api/books/${bookId}/reviews`);\n}\n\nexport function createReview(bookId: number, rating: number, comment: string) {\n  return request<Review>(`/api/books/${bookId}/reviews`, {\n    method: \"POST\",\n    body: JSON.stringify({ rating, comment }),\n  });\n}\n\nexport function register(username: string, password: string) {\n  return request<{ message: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794304980947,"end":1794304980962}},"id":"prt_1c4e937cf001BY2xPcWQH2Nhrm","sessionID":"ses_e3b1d6d7affej9AbTtVkNRSTe2","messageID":"msg_1c4e8f566001alo9F3aOPef12u"}}
