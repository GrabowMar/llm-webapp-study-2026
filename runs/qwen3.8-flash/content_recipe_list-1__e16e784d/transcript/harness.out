{"type":"tool_use","timestamp":1794322822426,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"type":"tool","tool":"write","callID":"call_ef0fb52f443042d8a91a9f46","state":{"status":"completed","input":{"content":"export interface RecipeListItem {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number;\n  author: string;\n}\n\nexport interface Recipe extends RecipeListItem {\n  ingredients: string[];\n  instructions: string;\n  servings: number;\n  created_at: string;\n}\n\nexport interface RecipePayload {\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: number;\n  servings: number;\n}\n\nexport interface Page<T> {\n  items: T[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nconst TOKEN_KEY = \"recipebook.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {}\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.auth !== false) {\n    const token = getToken();\n    if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(`/api${path}`, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n  });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    /* empty or non-JSON body */\n  }\n  if (!res.ok) {\n    const obj = data as { error?: string } | null;\n    throw new ApiError(obj?.error ?? `Request failed (${res.status})`, res.status);\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string; token: string }>(\"/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    }),\n  me: () => request<{ username: string }>(\"/auth/me\"),\n  logout: () => request<{ message: string }>(\"/auth/logout\", { method: \"POST\" }),\n\n  listRecipes: (params: {\n    category?: string;\n    q?: string;\n    page?: number;\n    page_size?: number;\n  }) => {\n    const qs = new URLSearchParams();\n    if (params.category) qs.set(\"category\", params.category);\n    if (params.q) qs.set(\"q\", params.q);\n    if (params.page) qs.set(\"page\", String(params.page));\n    if (params.page_size) qs.set(\"page_size\", String(params.page_size));\n    const suffix = qs.toString() ? `?${qs.toString()}` : \"\";\n    return request<Page<RecipeListItem>>(`/recipes${suffix}`);\n  },\n  getRecipe: (id: number) => request<Recipe>(`/recipes/${id}`),\n  createRecipe: (payload: RecipePayload) =>\n    request<Recipe>(\"/recipes\", { method: \"POST\", body: payload }),\n  updateRecipe: (id: number, payload: RecipePayload) =>\n    request<Recipe>(`/recipes/${id}`, { method: \"PUT\", body: payload }),\n  deleteRecipe: (id: number) =>\n    request<void>(`/recipes/${id}`, { method: \"DELETE\" }),\n  categories: () => request<{ categories: string[] }>(\"/categories\"),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794322822400,"end":1794322822408}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f974fb001pkLlhQ0fisaSY7","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","messageID":"msg_1c5f92b7b0019YIgM722c513ql"}}
