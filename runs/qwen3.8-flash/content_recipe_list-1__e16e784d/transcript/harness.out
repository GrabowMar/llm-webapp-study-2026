{"type":"tool_use","timestamp":1794322852617,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"type":"tool","tool":"write","callID":"call_123d95cfa24240ebbdcedfdc","state":{"status":"completed","input":{"content":"import { useState, type FormEvent } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { LogIn, UserPlus } from \"lucide-react\";\nimport { useAuth } from \"../AuthContext\";\nimport { ErrorBanner } from \"../components\";\n\nconst inputClass =\n  \"w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/30\";\n\nexport default function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const { signIn, signUp } = useAuth();\n  const navigate = useNavigate();\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const isLogin = mode === \"login\";\n\n  async function onSubmit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      if (isLogin) await signIn(username, password);\n      else await signUp(username, password);\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto mt-12 w-full max-w-md\">\n      <div className=\"rounded-2xl border border-slate-200 bg-white p-8 shadow-sm\">\n        <div className=\"mb-6 flex items-center gap-3\">\n          <span className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-700\">\n            {isLogin ? <LogIn className=\"h-5 w-5\" /> : <UserPlus className=\"h-5 w-5\" />}\n          </span>\n          <h1 className=\"text-xl font-bold text-slate-900\">\n            {isLogin ? \"Sign in\" : \"Create an account\"}\n          </h1>\n        </div>\n\n        <form onSubmit={onSubmit} className=\"space-y-4\">\n          <div>\n            <label className=\"mb-1.5 block text-sm font-medium text-slate-700\">\n              Username\n            </label>\n            <input\n              className={inputClass}\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              placeholder=\"e.g. alice\"\n              autoComplete=\"username\"\n              required\n            />\n          </div>\n          <div>\n            <label className=\"mb-1.5 block text-sm font-medium text-slate-700\">\n              Password\n            </label>\n            <input\n              type=\"password\"\n              className={inputClass}\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              placeholder=\"Your password\"\n              autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n              required\n            />\n          </div>\n          <ErrorBanner message={error} />\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"w-full rounded-lg bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-amber-700 disabled:opacity-60\"\n          >\n            {busy ? \"Please wait…\" : isLogin ? \"Sign in\" : \"Register\"}\n          </button>\n        </form>\n\n        <p className=\"mt-5 text-center text-sm text-slate-500\">\n          {isLogin ? (\n            <>\n              No account yet?{\" \"}\n              <Link\n                to=\"/register\"\n                className=\"font-semibold text-amber-700 hover:underline\"\n              >\n                Register\n              </Link>\n            </>\n          ) : (\n            <>\n              Already have an account?{\" \"}\n              <Link\n                to=\"/login\"\n                className=\"font-semibold text-amber-700 hover:underline\"\n              >\n                Sign in\n              </Link>\n            </>\n          )}\n        </p>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/AuthPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/AuthPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/AuthPage.tsx","time":{"start":1794322852593,"end":1794322852601}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f9eaed001aauyYHJOSomdPn","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","messageID":"msg_1c5f9b83f0014FGb9HGL5kYaQF"}}
{"type":"step_finish","timestamp":1794322852618,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5f9eafc001wywlo9r94477V7","reason":"tool-calls","messageID":"msg_1c5f9b83f0014FGb9HGL5kYaQF","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-finish","tokens":{"total":36212,"input":295,"output":1057,"reasoning":44,"cache":{"write":0,"read":34816}},"cost":0}}
{"type":"step_start","timestamp":1794322878510,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5fa5021001DfGknX6iy7TFpV","messageID":"msg_1c5f9eb05001w6MFKf8G7odvxm","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-start"}}
{"type":"tool_use","timestamp":1794322878531,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"type":"tool","tool":"write","callID":"call_f23f8aca617447f5811b9021","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { ChefHat, Clock, Plus, Search, User } from \"lucide-react\";\nimport { api, ApiError, type Page, type RecipeListItem } from \"../api\";\nimport { useAuth } from \"../AuthContext\";\nimport { ErrorBanner, Spinner } from \"../components\";\n\nconst PAGE_SIZE = 9;\n\nexport default function RecipeList() {\n  const { username } = useAuth();\n  const [params, setParams] = useSearchParams();\n  const category = params.get(\"category\") ?? \"\";\n  const q = params.get(\"q\") ?? \"\";\n  const page = Math.max(1, Number(params.get(\"page\") ?? \"1\") || 1);\n\n  const [categories, setCategories] = useState<string[]>([]);\n  const [data, setData] = useState<Page<RecipeListItem> | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [searchDraft, setSearchDraft] = useState(q);\n\n  useEffect(() => {\n    api\n      .categories()\n      .then((res) => setCategories(res.categories))\n      .catch(() => {});\n  }, []);\n\n  const load = useCallback(() => {\n    setLoading(true);\n    setError(null);\n    api\n      .listRecipes({ category, q, page, page_size: PAGE_SIZE })\n      .then(setData)\n      .catch((err) =>\n        setError(err instanceof ApiError ? err.message : \"Failed to load recipes.\")\n      )\n      .finally(() => setLoading(false));\n  }, [category, q, page]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  function updateParams(next: Record<string, string>) {\n    const merged = { category, q, page: \"1\", ...next };\n    const sp = new URLSearchParams();\n    if (merged.category) sp.set(\"category\", merged.category);\n    if (merged.q) sp.set(\"q\", merged.q);\n    if (Number(merged.page) > 1) sp.set(\"page\", merged.page);\n    setParams(sp);\n  }\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / PAGE_SIZE)) : 1;\n\n  return (\n    <div className=\"mx-auto max-w-6xl px-4 py-8\">\n      <div className=\"mb-6 flex flex-wrap items-center gap-3\">\n        <form\n          className=\"relative min-w-52 flex-1\"\n          onSubmit={(e) => {\n            e.preventDefault();\n            updateParams({ q: searchDraft.trim(), page: \"1\" });\n          }}\n        >\n          <Search className=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400\" />\n          <input\n            value={searchDraft}\n            onChange={(e) => setSearchDraft(e.target.value)}\n            placeholder=\"Search by title…\"\n            className=\"w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-9 pr-3 text-sm placeholder:text-slate-400 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/30\"\n          />\n        </form>\n        <select\n          value={category}\n          onChange={(e) => updateParams({ category: e.target.value, page: \"1\" })}\n          className=\"rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/30\"\n        >\n          <option value=\"\">All categories</option>\n          {categories.map((c) => (\n            <option key={c} value={c}>\n              {c}\n            </option>\n          ))}\n        </select>\n        {username && (\n          <Link\n            to=\"/recipes/new\"\n            className=\"inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-amber-700\"\n          >\n            <Plus className=\"h-4 w-4\" /> Add recipe\n          </Link>\n        )}\n      </div>\n\n      {(category || q) && (\n        <p className=\"mb-4 text-sm text-slate-500\">\n          Filters active:{\" \"}\n          {q && <span className=\"mr-2 rounded bg-slate-100 px-2 py-0.5\">“{q}”</span>}\n          {category && (\n            <span className=\"rounded bg-slate-100 px-2 py-0.5\">{category}</span>\n          )}{\" \"}\n          <button\n            className=\"font-medium text-amber-700 hover:underline\"\n            onClick={() => {\n              setSearchDraft(\"\");\n              setParams(new URLSearchParams());\n            }}\n          >\n            Clear\n          </button>\n        </p>\n      )}\n\n      <ErrorBanner message={error} />\n\n      {loading && !data ? (\n        <Spinner />\n      ) : (\n        data && (\n          <>\n            {data.items.length === 0 ? (\n              <div className=\"rounded-2xl border border-dashed border-slate-300 bg-white py-16 text-center\">\n                <ChefHat className=\"mx-auto mb-3 h-10 w-10 text-slate-300\" />\n                <p className=\"text-slate-500\">No recipes found.</p>\n              </div>\n            ) : (\n              <div\n                className={`grid gap-5 sm:grid-cols-2 lg:grid-cols-3 ${loading ? \"opacity-50\" : \"\"}`}\n              >\n                {data.items.map((r) => (\n                  <Link\n                    key={r.id}\n                    to={`/recipes/${r.id}`}\n                    className=\"group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md\"\n                  >\n                    <span className=\"mb-2 self-start rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800\">\n                      {r.category}\n                    </span>\n                    <h2 className=\"mb-3 text-lg font-bold leading-snug text-slate-900 group-hover:text-amber-700\">\n                      {r.title}\n                    </h2>\n                    <div className=\"mt-auto flex items-center gap-4 text-sm text-slate-500\">\n                      <span className=\"inline-flex items-center gap-1.5\">\n                        <Clock className=\"h-4 w-4\" /> {r.prep_minutes} min\n                      </span>\n                      <span className=\"inline-flex items-center gap-1.5\">\n                        <User className=\"h-4 w-4\" /> {r.author}\n                      </span>\n                    </div>\n                  </Link>\n                ))}\n              </div>\n            )}\n\n            <div className=\"mt-8 flex items-center justify-between\">\n              <p className=\"text-sm text-slate-500\">\n                {data.total} recipe{data.total === 1 ? \"\" : \"s\"} · page {data.page} of{\" \"}\n                {totalPages}\n              </p>\n              <div className=\"flex gap-2\">\n                <button\n                  disabled={page <= 1}\n                  onClick={() => updateParams({ page: String(page - 1) })}\n                  className=\"rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:opacity-40\"\n                >\n                  Previous\n                </button>\n                <button\n                  disabled={page >= totalPages}\n                  onClick={() => updateParams({ page: String(page + 1) })}\n                  className=\"rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:opacity-40\"\n                >\n                  Next\n                </button>\n              </div>\n            </div>\n          </>\n        )\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipeList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipeList.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipeList.tsx","time":{"start":1794322878505,"end":1794322878514}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5fa5024001oaFDLQpuLXcRkB","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","messageID":"msg_1c5f9eb05001w6MFKf8G7odvxm"}}
{"type":"step_finish","timestamp":1794322878532,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5fa50350013ZVVEnBEJStxmQ","reason":"tool-calls","messageID":"msg_1c5f9eb05001w6MFKf8G7odvxm","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-finish","tokens":{"total":38261,"input":1372,"output":2001,"reasoning":72,"cache":{"write":0,"read":34816}},"cost":0}}
{"type":"step_start","timestamp":1794322899714,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5faa2f7001i5AJGP673NFO9K","messageID":"msg_1c5fa503f001jHGrY8hpjs0YvS","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-start"}}
{"type":"tool_use","timestamp":1794322899738,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"type":"tool","tool":"write","callID":"call_314d2fceaae14d37bf135c13","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport {\n  ArrowLeft,\n  Clock,\n  ListChecks,\n  Pencil,\n  Trash2,\n  User,\n  Users,\n} from \"lucide-react\";\nimport { api, ApiError, type Recipe } from \"../api\";\nimport { useAuth } from \"../AuthContext\";\nimport { ErrorBanner, Spinner } from \"../components\";\n\nexport default function RecipeDetail() {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const { username } = useAuth();\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [notFound, setNotFound] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(() => {\n    setLoading(true);\n    api\n      .getRecipe(Number(id))\n      .then((r) => {\n        setRecipe(r);\n        setError(null);\n      })\n      .catch((err) => {\n        if (err instanceof ApiError && err.status === 404) setNotFound(true);\n        else setError(err instanceof Error ? err.message : \"Failed to load recipe.\");\n      })\n      .finally(() => setLoading(false));\n  }, [id]);\n\n  const [loading, setLoading] = useState(true);\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function onDelete() {\n    if (!recipe) return;\n    if (!window.confirm(`Delete “${recipe.title}”? This cannot be undone.`)) return;\n    setBusy(true);\n    try {\n      await api.deleteRecipe(recipe.id);\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete recipe.\");\n      setBusy(false);\n    }\n  }\n\n  if (loading) return <Spinner />;\n  if (notFound)\n    return (\n      <div className=\"mx-auto max-w-3xl px-4 py-16 text-center\">\n        <h1 className=\"text-xl font-bold text-slate-900\">Recipe not found</h1>\n        <Link to=\"/\" className=\"mt-4 inline-block font-medium text-amber-700 hover:underline\">\n          Back to all recipes\n        </Link>\n      </div>\n    );\n  if (!recipe)\n    return <div className=\"mx-auto max-w-3xl px-4 py-8\"><ErrorBanner message={error} /></div>;\n\n  const isAuthor = username !== null && username === recipe.author;\n\n  return (\n    <div className=\"mx-auto max-w-3xl px-4 py-8\">\n      <Link\n        to=\"/\"\n        className=\"mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-amber-700\"\n      >\n        <ArrowLeft className=\"h-4 w-4\" /> All recipes\n      </Link>\n\n      <div className=\"rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8\">\n        <div className=\"mb-2 flex items-center gap-2\">\n          <span className=\"rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800\">\n            {recipe.category}\n          </span>\n        </div>\n        <h1 className=\"text-2xl font-bold text-slate-900 sm:text-3xl\">{recipe.title}</h1>\n\n        <div className=\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500\">\n          <span className=\"inline-flex items-center gap-1.5\">\n            <User className=\"h-4 w-4\" /> {recipe.author}\n          </span>\n          <span className=\"inline-flex items-center gap-1.5\">\n            <Clock className=\"h-4 w-4\" /> {recipe.prep_minutes} min\n          </span>\n          <span className=\"inline-flex items-center gap-1.5\">\n            <Users className=\"h-4 w-4\" /> Serves {recipe.servings}\n          </span>\n        </div>\n\n        <hr className=\"my-6 border-slate-100\" />\n\n        <section className=\"mb-8\">\n          <h2 className=\"mb-3 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-700\">\n            <ListChecks className=\"h-4 w-4 text-amber-600\" /> Ingredients\n          </h2>\n          {recipe.ingredients.length === 0 ? (\n            <p className=\"text-sm italic text-slate-400\">No ingredients listed.</p>\n          ) : (\n            <ul className=\"list-disc space-y-1.5 pl-6 marker:text-amber-500\">\n              {recipe.ingredients.map((ing, i) => (\n                <li key={i} className=\"text-slate-700\">\n                  {ing}\n                </li>\n              ))}\n            </ul>\n          )}\n        </section>\n\n        <section>\n          <h2 className=\"mb-3 text-sm font-bold uppercase tracking-wide text-slate-700\">\n            Instructions\n          </h2>\n          <p className=\"whitespace-pre-line leading-relaxed text-slate-700\">\n            {recipe.instructions}\n          </p>\n        </section>\n\n        {isAuthor && (\n          <div className=\"mt-8 flex gap-3 border-t border-slate-100 pt-6\">\n            <Link\n              to={`/recipes/${recipe.id}/edit`}\n              className=\"inline-flex items-center gap-2 rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-700\"\n            >\n              <Pencil className=\"h-4 w-4\" /> Edit\n            </Link>\n            <button\n              onClick={onDelete}\n              disabled={busy}\n              className=\"inline-flex items-center gap-2 rounded-lg border border-red-300 px-4 py-2 text-sm font-semibold text-red-600 transition hover:bg-red-50 disabled:opacity-60\"\n            >\n              <Trash2 className=\"h-4 w-4\" /> Delete\n            </button>\n          </div>\n        )}\n      </div>\n\n      <div className=\"mt-6\">\n        <ErrorBanner message={error} />\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipeDetail.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipeDetail.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipeDetail.tsx","time":{"start":1794322899710,"end":1794322899717}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5faa2f9001gNTeUcqTrmRObV","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","messageID":"msg_1c5fa503f001jHGrY8hpjs0YvS"}}
{"type":"step_finish","timestamp":1794322899738,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5faa308001tnOuW3slDQ1BV8","reason":"tool-calls","messageID":"msg_1c5fa503f001jHGrY8hpjs0YvS","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-finish","tokens":{"total":39881,"input":2369,"output":1581,"reasoning":91,"cache":{"write":0,"read":35840}},"cost":0}}
{"type":"step_start","timestamp":1794322926994,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5fb0d86001eAxsePwLCuP1Ou","messageID":"msg_1c5faa312001EUlBxodxtA9Owf","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-start"}}
{"type":"tool_use","timestamp":1794322927016,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"type":"tool","tool":"write","callID":"call_46ff04cb31b14a668e45ec4f","state":{"status":"completed","input":{"content":"import { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ArrowLeft, Plus, Trash2 } from \"lucide-react\";\nimport { api, ApiError, type RecipePayload } from \"../api\";\nimport { ErrorBanner, Spinner } from \"../components\";\n\nconst inputClass =\n  \"w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/30\";\nconst labelClass = \"mb-1.5 block text-sm font-medium text-slate-700\";\n\nexport default function RecipeForm() {\n  const { id } = useParams();\n  const isEdit = id !== undefined;\n  const navigate = useNavigate();\n\n  const [loading, setLoading] = useState(isEdit);\n  const [loadError, setLoadError] = useState<string | null>(null);\n  const [categories, setCategories] = useState<string[]>([]);\n\n  const [title, setTitle] = useState(\"\");\n  const [category, setCategory] = useState(\"\");\n  const [ingredients, setIngredients] = useState<string[]>([\"\"]);\n  const [instructions, setInstructions] = useState(\"\");\n  const [prepMinutes, setPrepMinutes] = useState(\"15\");\n  const [servings, setServings] = useState(\"4\");\n\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    api.categories().then((r) => setCategories(r.categories)).catch(() => {});\n  }, []);\n\n  useEffect(() => {\n    if (!isEdit) return;\n    api\n      .getRecipe(Number(id))\n      .then((r) => {\n        setTitle(r.title);\n        setCategory(r.category);\n        setIngredients(r.ingredients.length ? r.ingredients : [\"\"]);\n        setInstructions(r.instructions);\n        setPrepMinutes(String(r.prep_minutes));\n        setServings(String(r.servings));\n      })\n      .catch((err) =>\n        setLoadError(err instanceof Error ? err.message : \"Failed to load recipe.\")\n      )\n      .finally(() => setLoading(false));\n  }, [id, isEdit]);\n\n  function setIngredient(index: number, value: string) {\n    setIngredients((prev) => prev.map((v, i) => (i === index ? value : v)));\n  }\n\n  async function onSubmit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    const payload: RecipePayload = {\n      title,\n      category,\n      ingredients: ingredients.map((s) => s.trim()).filter((s) => s.length > 0),\n      instructions,\n      prep_minutes: Number(prepMinutes),\n      servings: Number(servings),\n    };\n    setBusy(true);\n    try {\n      if (isEdit) await api.updateRecipe(Number(id), payload);\n      else await api.createRecipe(payload);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) setError(err.message);\n      else setError(\"Something went wrong. Please try again.\");\n      setBusy(false);\n    }\n  }\n\n  if (loading) return <Spinner />;\n  if (loadError)\n    return (\n      <div className=\"mx-auto max-w-2xl px-4 py-8\">\n        <ErrorBanner message={loadError} />\n      </div>\n    );\n\n  return (\n    <div className=\"mx-auto max-w-2xl px-4 py-8\">\n      <Link\n        to={isEdit ? `/recipes/${id}` : \"/\"}\n        className=\"mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-amber-700\"\n      >\n        <ArrowLeft className=\"h-4 w-4\" /> Back\n      </Link>\n\n      <h1 className=\"mb-6 text-2xl font-bold text-slate-900\">\n        {isEdit ? \"Edit recipe\" : \"Add a recipe\"}\n      </h1>\n\n      <form\n        onSubmit={onSubmit}\n        className=\"space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8\"\n      >\n        <div>\n          <label className={labelClass}>Title</label>\n          <input\n            className={inputClass}\n            value={title}\n            onChange={(e) => setTitle(e.target.value)}\n            placeholder=\"e.g. Chicken Tikka Masala\"\n            required\n          />\n        </div>\n\n        <div>\n          <label className={labelClass}>Category</label>\n          <input\n            className={inputClass}\n            list=\"category-options\"\n            value={category}\n            onChange={(e) => setCategory(e.target.value)}\n            placeholder=\"e.g. Dinner\"\n            required\n          />\n          <datalist id=\"category-options\">\n            {categories.map((c) => (\n              <option key={c} value={c} />\n            ))}\n          </datalist>\n        </div>\n\n        <div>\n          <div className=\"mb-1.5 flex items-center justify-between\">\n            <label className={labelClass + \" mb-0\"}>Ingredients</label>\n            <button\n              type=\"button\"\n              onClick={() => setIngredients((prev) => [...prev, \"\"])}\n              className=\"inline-flex items-center gap-1 rounded-lg border border-amber-300 px-2.5 py-1 text-xs font-semibold text-amber-700 transition hover:bg-amber-50\"\n            >\n              <Plus className=\"h-3.5 w-3.5\" /> Add ingredient\n            </button>\n          </div>\n          <div className=\"space-y-2\">\n            {ingredients.map((value, i) => (\n              <div key={i} className=\"flex items-center gap-2\">\n                <span className=\"w-5 text-right text-xs text-slate-400\">{i + 1}</span>\n                <input\n                  className={inputClass}\n                  value={value}\n                  onChange={(e) => setIngredient(i, e.target.value)}\n                  placeholder={`Ingredient ${i + 1}`}\n                />\n                <button\n                  type=\"button\"\n                  title=\"Remove ingredient\"\n                  disabled={ingredients.length === 1}\n                  onClick={() =>\n                    setIngredients((prev) => prev.filter((_, j) => j !== i))\n                  }\n                  className=\"rounded-lg p-2 text-slate-400 transition hover:bg-red-50 hover:text-red-600 disabled:opacity-30 disabled:hover:bg-transparent\"\n                >\n                  <Trash2 className=\"h-4 w-4\" />\n                </button>\n              </div>\n            ))}\n          </div>\n          <p className=\"mt-1.5 text-xs text-slate-400\">\n            Empty ingredient rows are ignored.\n          </p>\n        </div>\n\n        <div>\n          <label className={labelClass}>Instructions</label>\n          <textarea\n            className={inputClass + \" min-h-40 resize-y\"}\n            value={instructions}\n            onChange={(e) => setInstructions(e.target.value)}\n            placeholder=\"One step per line — line breaks are kept.\"\n            required\n          />\n        </div>\n\n        <div className=\"grid grid-cols-2 gap-4\">\n          <div>\n            <label className={labelClass}>Prep time (minutes)</label>\n            <input\n              type=\"number\"\n              min={0}\n              className={inputClass}\n              value={prepMinutes}\n              onChange={(e) => setPrepMinutes(e.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={labelClass}>Servings</label>\n            <input\n              type=\"number\"\n              min={1}\n              className={inputClass}\n              value={servings}\n              onChange={(e) => setServings(e.target.value)}\n              required\n            />\n          </div>\n        </div>\n\n        <ErrorBanner message={error} />\n\n        <div className=\"flex gap-3\">\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-amber-700 disabled:opacity-60\"\n          >\n            {busy ? \"Saving…\" : isEdit ? \"Save changes\" : \"Create recipe\"}\n          </button>\n          <Link\n            to={isEdit ? `/recipes/${id}` : \"/\"}\n            className=\"rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50\"\n          >\n            Cancel\n          </Link>\n        </div>\n      </form>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipeForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipeForm.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipeForm.tsx","time":{"start":1794322926989,"end":1794322926997}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5fb0d88001dHBAlb5j1I60Lg","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","messageID":"msg_1c5faa312001EUlBxodxtA9Owf"}}
{"type":"step_finish","timestamp":1794322927016,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5fb0d980015CnvFehgmq0HeN","reason":"tool-calls","messageID":"msg_1c5faa312001EUlBxodxtA9Owf","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-finish","tokens":{"total":42008,"input":1922,"output":2142,"reasoning":56,"cache":{"write":0,"read":37888}},"cost":0}}
{"type":"step_start","timestamp":1794322942217,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"id":"prt_1c5fb48fb00171TGXRS3M1zR3H","messageID":"msg_1c5fb0da3001l4jatsKV3dbX1T","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","type":"step-start"}}
{"type":"tool_use","timestamp":1794322942243,"sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","part":{"type":"tool","tool":"write","callID":"call_091eb753bf6d41aca5a39b70","state":{"status":"completed","input":{"content":"import { Link, Route, Routes, useNavigate } from \"react-router-dom\";\nimport { ChefHat, LogOut, Plus } from \"lucide-react\";\nimport { AuthProvider, useAuth } from \"./AuthContext\";\nimport AuthPage from \"./pages/AuthPage\";\nimport RecipeList from \"./pages/RecipeList\";\nimport RecipeDetail from \"./pages/RecipeDetail\";\nimport RecipeForm from \"./pages/RecipeForm\";\n\nfunction Header() {\n  const { username, signOut } = useAuth();\n  const navigate = useNavigate();\n\n  return (\n    <header className=\"sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur\">\n      <div className=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-3\">\n        <Link to=\"/\" className=\"flex items-center gap-2 text-lg font-bold text-slate-900\">\n          <span className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-700\">\n            <ChefHat className=\"h-5 w-5\" />\n          </span>\n          Recipe Book\n        </Link>\n        <nav className=\"flex items-center gap-3\">\n          {username ? (\n            <>\n              <span className=\"hidden text-sm text-slate-600 sm:inline\">\n                Signed in as <strong className=\"font-semibold text-slate-900\">{username}</strong>\n              </span>\n              <Link\n                to=\"/recipes/new\"\n                className=\"inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-amber-700\"\n              >\n                <Plus className=\"h-4 w-4\" /> <span className=\"hidden sm:inline\">Add recipe</span>\n              </Link>\n              <button\n                onClick={async () => {\n                  await signOut();\n                  navigate(\"/\");\n                }}\n                className=\"inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50\"\n              >\n                <LogOut className=\"h-4 w-4\" /> Sign out\n              </button>\n            </>\n          ) : (\n            <>\n              <Link\n                to=\"/login\"\n                className=\"rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100\"\n              >\n                Sign in\n              </Link>\n              <Link\n                to=\"/register\"\n                className=\"rounded-lg bg-amber-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-amber-700\"\n              >\n                Register\n              </Link>\n            </>\n          )}\n        </nav>\n      </div>\n    </header>\n  );\n}\n\nfunction Protected({ children }: { children: React.ReactNode }) {\n  const { username } = useAuth();\n  if (!username) return <AuthPage mode=\"login\" />;\n  return <>{children}</>;\n}\n\nexport default function App() {\n  return (\n    <AuthProvider>\n      <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n        <Header />\n        <Routes>\n          <Route path=\"/\" element={<RecipeList />} />\n          <Route path=\"/login\" element={<AuthPage mode=\"login\" />} />\n          <Route path=\"/register\" element={<AuthPage mode=\"register\" />} />\n          <Route path=\"/recipes/new\" element={<Protected><RecipeForm /></Protected>} />\n          <Route path=\"/recipes/:id\" element={<RecipeDetail />} />\n          <Route\n            path=\"/recipes/:id/edit\"\n            element={\n              <Protected>\n                <RecipeForm />\n              </Protected>\n            }\n          />\n          <Route\n            path=\"*\"\n            element={\n              <div className=\"mx-auto max-w-3xl px-4 py-16 text-center\">\n                <h1 className=\"text-xl font-bold\">Page not found</h1>\n                <Link to=\"/\" className=\"mt-4 inline-block font-medium text-amber-700 hover:underline\">\n                  Back to recipes\n                </Link>\n              </div>\n            }\n          />\n        </Routes>\n      </div>\n    </AuthProvider>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794322942213,"end":1794322942222}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5fb48fe001N5tZB3t3L0iO0M","sessionID":"ses_e3a1761d2ffehEJCiYfCuhlelG","messageID":"msg_1c5fb0da3001l4jatsKV3dbX1T"}}
