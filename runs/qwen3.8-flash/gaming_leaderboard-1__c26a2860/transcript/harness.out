{"type":"tool_use","timestamp":1794369273107,"sessionID":"ses_e374767baffe1WKNZ2mDzAagKz","part":{"type":"tool","tool":"write","callID":"call_bc1253ad6b6b4afd963425ee","state":{"status":"completed","input":{"content":"export type Score = {\n  id: number;\n  score: number;\n  achieved_at: string;\n  is_hidden: boolean;\n  player: string;\n};\n\nexport type LeaderboardItem = {\n  rank: number;\n  player: string;\n  score: number;\n  achieved_at: string;\n};\n\nexport type ScoreWithRank = Score & { rank: number | null; personal_best: boolean };\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nconst TOKEN_KEY = \"leaderboard.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(path, { ...options, headers });\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    /* no body */\n  }\n  if (!res.ok) {\n    const msg =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, msg);\n  }\n  return data as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ username: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport type Period = \"all\" | \"week\" | \"day\";\n\nexport function getLeaderboard(period: Period, limit = 50, player?: string) {\n  const params = new URLSearchParams({ period, limit: String(limit) });\n  if (player) params.set(\"player\", player);\n  return request<{ items: LeaderboardItem[]; total: number }>(`/api/leaderboard?${params}`);\n}\n\nexport function submitScore(score: number) {\n  return request<ScoreWithRank>(\"/api/scores\", {\n    method: \"POST\",\n    body: JSON.stringify({ score }),\n  });\n}\n\nexport function getMyScores() {\n  return request<{ items: Score[]; best_score: number | null }>(\"/api/scores\");\n}\n\nexport function getAdminScores(page: number, pageSize: number) {\n  return request<{ items: Score[]; total: number; page: number; page_size: number }>(\n    `/api/admin/scores?page=${page}&page_size=${pageSize}`,\n  );\n}\n\nexport function toggleAdminScore(id: number) {\n  return request<Score>(`/api/admin/scores/${id}/toggle`, { method: \"POST\" });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794369273045,"end":1794369273059}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8be3ccc0017dDsZ3rZ8PIydX","sessionID":"ses_e374767baffe1WKNZ2mDzAagKz","messageID":"msg_1c8bdfefa001MY3AE9TNxSGJXw"}}
