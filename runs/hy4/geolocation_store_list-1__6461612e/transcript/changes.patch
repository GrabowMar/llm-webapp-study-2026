index 0000000..d128a8d
--- /dev/null
+++ b/frontend/src/Plot.tsx
@@ -0,0 +1,79 @@
+import type { Store } from "./api";
+
+type Props = {
+  stores: Store[];
+  visitor: { lat: number; lng: number } | null;
+};
+
+const W = 640;
+const H = 420;
+const PAD = 44;
+
+export default function Plot({ stores, visitor }: Props) {
+  const points = stores.map((s) => ({ lat: s.latitude, lng: s.longitude, store: s }));
+  const all = points.map((p) => ({ lat: p.lat, lng: p.lng }));
+  if (visitor) all.push({ lat: visitor.lat, lng: visitor.lng });
+
+  if (all.length === 0) {
+    return (
+      <div className="flex h-64 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-500">
+        No locations to plot yet.
+      </div>
+    );
+  }
+
+  const lats = all.map((p) => p.lat);
+  const lngs = all.map((p) => p.lng);
+  let minLat = Math.min(...lats), maxLat = Math.max(...lats);
+  let minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
+  if (maxLat - minLat < 0.02) { minLat -= 0.01; maxLat += 0.01; }
+  if (maxLng - minLng < 0.02) { minLng -= 0.01; maxLng += 0.01; }
+  const spanLat = maxLat - minLat;
+  const spanLng = maxLng - minLng;
+
+  const x = (lng: number) => PAD + ((lng - minLng) / spanLng) * (W - 2 * PAD);
+  const y = (lat: number) => H - PAD - ((lat - minLat) / spanLat) * (H - 2 * PAD);
+
+  const xTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => minLng + f * spanLng);
+  const yTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => minLat + f * spanLat);
+
+  return (
+    <div>
+      <svg viewBox={`0 0 ${W} ${H}`} className="h-auto w-full rounded-lg border border-slate-200 bg-white" role="img" aria-label="Map of listed stores by latitude and longitude">
+        <rect x={PAD} y={PAD} width={W - 2 * PAD} height={H - 2 * PAD} fill="#f8fafc" stroke="#e2e8f0" />
+        {xTicks.map((lng, i) => (
+          <g key={`x${i}`}>
+            <line x1={x(lng)} y1={PAD} x2={x(lng)} y2={H - PAD} stroke="#e2e8f0" strokeDasharray="3 4" />
+            <text x={x(lng)} y={H - PAD + 16} textAnchor="middle" fontSize="10" fill="#64748b">{lng.toFixed(2)}°</text>
+          </g>
+        ))}
+        {yTicks.map((lat, i) => (
+          <g key={`y${i}`}>
+            <line x1={PAD} y1={y(lat)} x2={W - PAD} y2={y(lat)} stroke="#e2e8f0" strokeDasharray="3 4" />
+            <text x={PAD - 8} y={y(lat) + 3} textAnchor="end" fontSize="10" fill="#64748b">{lat.toFixed(2)}°</text>
+          </g>
+        ))}
+        <text x={W / 2} y={H - 6} textAnchor="middle" fontSize="11" fill="#94a3b8">longitude →</text>
+        <text x={12} y={H / 2} textAnchor="middle" fontSize="11" fill="#94a3b8" transform={`rotate(-90 12 ${H / 2})`}>latitude →</text>
+        {visitor && (
+          <g>
+            <circle cx={x(visitor.lng)} cy={y(visitor.lat)} r="12" fill="#3b82f6" opacity="0.15" />
+            <circle cx={x(visitor.lng)} cy={y(visitor.lat)} r="6" fill="#2563eb" stroke="white" strokeWidth="2" />
+            <text x={x(visitor.lng) + 10} y={y(visitor.lat) + 4} fontSize="11" fontWeight="600" fill="#1d4ed8">You</text>
+          </g>
+        )}
+        {points.map((p) => (
+          <g key={p.store.id}>
+            <circle cx={x(p.lng)} cy={y(p.lat)} r="6" fill="#e11d48" stroke="white" strokeWidth="2" />
+            <title>{p.store.name} ({p.lat.toFixed(3)}, {p.lng.toFixed(3)})</title>
+          </g>
+        ))}
+      </svg>
+      <div className="mt-2 flex flex-wrap gap-4 text-xs text-slate-600">
+        <span className="inline-flex items-center gap-1.5"><span className="h-2.5 w-2.5 rounded-full bg-rose-600" /> Store</span>
+        {visitor && <span className="inline-flex items-center gap-1.5"><span className="h-2.5 w-2.5 rounded-full bg-blue-600" /> Your location</span>}
+        <span className="text-slate-400">Positions are plotted directly from latitude / longitude.</span>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/StoreForm.tsx b/frontend/src/StoreForm.tsx
new file mode 100644
index 0000000..90e3c82
--- /dev/null
+++ b/frontend/src/StoreForm.tsx
@@ -0,0 +1,94 @@
+import { useState } from "react";
+import { api, draftToPayload, type ApiError, type StoreDraft } from "./api";
+
+type Props = {
+  token: string;
+  initial: StoreDraft;
+  storeId?: number;
+  title: string;
+  submitLabel: string;
+  onSaved: () => void;
+  onCancel: () => void;
+};
+
+function FieldError({ message }: { message?: string }) {
+  if (!message) return null;
+  return <p className="mt-1 text-sm text-rose-600">{message}</p>;
+}
+
+export default function StoreForm({ token, initial, storeId, title, submitLabel, onSaved, onCancel }: Props) {
+  const [draft, setDraft] = useState<StoreDraft>(initial);
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const [formError, setFormError] = useState("");
+  const [saving, setSaving] = useState(false);
+
+  const set = (key: keyof StoreDraft, value: string) => {
+    setDraft((d) => ({ ...d, [key]: value }));
+    setErrors((e) => ({ ...e, [key]: "" }));
+  };
+
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    setSaving(true);
+    setErrors({});
+    setFormError("");
+    try {
+      await api(
+        storeId ? `/api/admin/stores/${storeId}` : "/api/admin/stores",
+        { method: storeId ? "PUT" : "POST", body: JSON.stringify(draftToPayload(draft)) },
+        token,
+      );
+      onSaved();
+    } catch (err) {
+      const e = err as ApiError;
+      if (e.errors) setErrors(e.errors);
+      else setFormError(e.error ?? "Could not save the store. Please try again.");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  const inputClass = (field: string) =>
+    `w-full rounded-md border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-indigo-500 ${errors[field] ? "border-rose-400" : "border-slate-300"}`;
+
+  return (
+    <form onSubmit={submit} className="space-y-3 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
+      <h3 className="text-lg font-semibold text-slate-800">{title}</h3>
+      {formError && <p className="rounded-md bg-rose-50 px-3 py-2 text-sm text-rose-700">{formError}</p>}
+      <div>
+        <label className="mb-1 block text-sm font-medium text-slate-700" htmlFor="f-name">Name</label>
+        <input id="f-name" className={inputClass("name")} value={draft.name} onChange={(e) => set("name", e.target.value)} />
+        <FieldError message={errors.name} />
+      </div>
+      <div>
+        <label className="mb-1 block text-sm font-medium text-slate-700" htmlFor="f-address">Address</label>
+        <input id="f-address" className={inputClass("address")} value={draft.address} onChange={(e) => set("address", e.target.value)} />
+        <FieldError message={errors.address} />
+      </div>
+      <div>
+        <label className="mb-1 block text-sm font-medium text-slate-700" htmlFor="f-phone">Phone</label>
+        <input id="f-phone" className={inputClass("phone")} value={draft.phone} onChange={(e) => set("phone", e.target.value)} placeholder="Optional" />
+        <FieldError message={errors.phone} />
+      </div>
+      <div className="grid grid-cols-2 gap-3">
+        <div>
+          <label className="mb-1 block text-sm font-medium text-slate-700" htmlFor="f-lat">Latitude</label>
+          <input id="f-lat" className={inputClass("latitude")} value={draft.latitude} onChange={(e) => set("latitude", e.target.value)} placeholder="e.g. 51.5074" />
+          <FieldError message={errors.latitude} />
+        </div>
+        <div>
+          <label className="mb-1 block text-sm font-medium text-slate-700" htmlFor="f-lng">Longitude</label>
+          <input id="f-lng" className={inputClass("longitude")} value={draft.longitude} onChange={(e) => set("longitude", e.target.value)} placeholder="e.g. -0.1278" />
+          <FieldError message={errors.longitude} />
+        </div>
+      </div>
+      <FieldError message={errors.body} />
+      <div className="flex gap-2 pt-1">
+        <button type="submit" disabled={saving} className="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50">
+          {saving ? "Saving…" : submitLabel}
+        </button>
+        <button type="button" onClick={onCancel} className="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
+      </div>
+    </form>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..686534f
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,90 @@
+export type Store = {
+  id: number;
+  name: string;
+  address: string;
+  phone: string;
+  latitude: number;
+  longitude: number;
+  distance_km: number | null;
+};
+
+export type StoreDraft = {
+  name: string;
+  address: string;
+  phone: string;
+  latitude: string;
+  longitude: string;
+};
+
+export const emptyDraft: StoreDraft = {
+  name: "",
+  address: "",
+  phone: "",
+  latitude: "",
+  longitude: "",
+};
+
+export type ApiError = {
+  errors?: Record<string, string>;
+  error?: string;
+};
+
+export async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {
+  const headers = new Headers(options.headers);
+  headers.set("Accept", "application/json");
+  if (options.body !== undefined) headers.set("Content-Type", "application/json");
+  if (token) headers.set("Authorization", `Bearer ${token}`);
+  const response = await fetch(path, { ...options, headers });
+  const text = await response.text();
+  let data: unknown = null;
+  if (text) {
+    try {
+      data = JSON.parse(text);
+    } catch {
+      data = null;
+    }
+  }
+  if (!response.ok) {
+    const err: ApiError = (data as ApiError) ?? {};
+    throw { status: response.status, ...err } as ApiError & { status: number };
+  }
+  return data as T;
+}
+
+export async function getStores(params: {
+  q?: string;
+  lat?: number;
+  lng?: number;
+  radius?: number;
+}): Promise<Store[]> {
+  const search = new URLSearchParams();
+  if (params.q) search.set("q", params.q);
+  if (params.lat !== undefined && params.lng !== undefined) {
+    search.set("lat", String(params.lat));
+    search.set("lng", String(params.lng));
+    if (params.radius !== undefined) search.set("radius", String(params.radius));
+  }
+  const suffix = search.toString();
+  const result = await api<{ items: Store[] }>(`/api/stores${suffix ? `?${suffix}` : ""}`);
+  return result.items;
+}
+
+export function draftToPayload(draft: StoreDraft) {
+  return {
+    name: draft.name,
+    address: draft.address,
+    phone: draft.phone,
+    latitude: draft.latitude.trim() === "" ? null : Number(draft.latitude),
+    longitude: draft.longitude.trim() === "" ? null : Number(draft.longitude),
+  };
+}
+
+export function storeToDraft(store: Store): StoreDraft {
+  return {
+    name: store.name,
+    address: store.address,
+    phone: store.phone,
+    latitude: String(store.latitude),
+    longitude: String(store.longitude),
+  };
+}
