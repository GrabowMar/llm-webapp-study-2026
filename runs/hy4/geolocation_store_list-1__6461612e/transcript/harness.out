{"type":"tool_use","timestamp":1794385159124,"sessionID":"ses_e3651ea06ffejCbwMEiK3BtEML","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8f23bf474d549b98","state":{"status":"completed","input":{"content":"import importlib\nimport os\nimport sys\nimport tempfile\n\nos.environ[\"ADMIN_PASSWORD\"] = \"s3cret\"\nsys.path.insert(0, \"/workspace/backend\")\nimport app as mod\n\nmod.DB_PATH = __import__(\"pathlib\").Path(tempfile.mkdtemp()) / \"test.sqlite3\"\nmod.DATA_DIR = mod.DB_PATH.parent\nwith mod.app.app_context():\n    mod.init_db()\n    row = mod.get_db().execute(\"SELECT 1 FROM users WHERE username='admin'\").fetchone()\n    if row is None:\n        mod.get_db().execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (\"admin\", mod.hash_password(\"s3cret\")),\n        )\n        mod.get_db().commit()\n\nc = mod.app.test_client()\n\ndef check(cond, msg):\n    if not cond:\n        raise AssertionError(msg)\n    print(\"ok -\", msg)\n\nr = c.get(\"/api/health\")\ncheck(r.status_code == 200 and r.json == {\"status\": \"ok\"}, \"health\")\n\nr = c.get(\"/api/stores\")\ncheck(r.status_code == 200 and len(r.json[\"items\"]) == 8, \"8 sample stores\")\ncheck([i[\"name\"] for i in r.json[\"items\"]] == sorted(i[\"name\"] for i in r.json[\"items\"]), \"sorted by name\")\ncheck(all(set(i) == {\"id\", \"name\", \"address\", \"phone\", \"latitude\", \"longitude\", \"distance_km\"} for i in r.json[\"items\"]), \"store shape\")\ncheck(all(i[\"distance_km\"] is None for i in r.json[\"items\"]), \"distance null without coords\")\n\nr = c.get(\"/api/stores?q=books\")\ncheck(len(r.json[\"items\"]) == 1 and r.json[\"items\"][0][\"name\"] == \"Central Books\", \"q search\")\n\nr = c.get(\"/api/stores?lat=51.5074&lng=-0.1278&radius=5\")\ncheck(r.status_code == 200, \"nearby 200\")\ncheck(all(i[\"distance_km\"] <= 5 for i in r.json[\"items\"]), \"within radius\")\ncheck(r.json[\"items\"][0][\"distance_km\"] == 0, \"nearest first\")\ncheck(len(r.json[\"items\"]) == 2, \"radius filters london to 2\")\n\nr = c.get(\"/api/stores?lat=51.5&lng=-0.12\")\ncheck(r.status_code == 200 and \"distance_km\" in r.json[\"items\"][0], \"default radius\")\n\nr = c.get(\"/api/stores?lat=abc&lng=1\")\ncheck(r.status_code == 400 and \"errors\" in r.json, \"bad lat -> 400 with errors\")\n\nr = c.get(\"/api/stores/1\")\ncheck(r.status_code == 200 and r.json[\"name\"] == \"Central Books\", \"get one\")\ncheck(c.get(\"/api/stores/9999\").status_code == 404, \"get missing -> 404\")\n\nr = c.post(\"/api/auth/register\", json={\"username\": \"bob\", \"password\": \"pw\"})\ncheck(r.status_code == 201, \"register 201\")\ncheck(c.post(\"/api/auth/register\", json={\"username\": \"bob\", \"password\": \"pw\"}).status_code == 409, \"duplicate 409\")\ncheck(c.post(\"/api/auth/register\", json={\"username\": \"\"}).status_code == 400, \"register validation\")\n\nr = c.post(\"/api/auth/login\", json={\"username\": \"bob\", \"password\": \"pw\"})\ncheck(r.status_code == 200 and \"token\" in r.json, \"login 200 token\")\nbob_token = r.json[\"token\"]\ncheck(c.post(\"/api/auth/login\", json={\"username\": \"bob\", \"password\": \"bad\"}).status_code == 401, \"bad password 401\")\n\nr = c.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"s3cret\"})\ncheck(r.status_code == 200 and \"token\" in r.json, \"admin login\")\nadmin_token = r.json[\"token\"]\ncheck(c.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"wrong\"}).status_code == 401, \"admin wrong pw\")\n\nA = {\"Authorization\": \"Bearer \" + admin_token}\nB = {\"Authorization\": \"Bearer \" + bob_token}\n\ncheck(c.post(\"/api/admin/stores\", json={\"name\": \"X\"}).status_code == 401, \"admin create no token 401\")\ncheck(c.post(\"/api/admin/stores\", json={\"name\": \"X\"}, headers=B).status_code == 403, \"non-admin 403\")\ncheck(c.post(\"/api/admin/stores\", json={\"name\": \"X\"}, headers=A).status_code == 400, \"admin create validation 400\")\n\nr = c.post(\"/api/admin/stores\", json={\"name\": \"New Store\", \"address\": \"1 A St\", \"phone\": \"123\", \"latitude\": 48.85, \"longitude\": 2.35}, headers=A)\ncheck(r.status_code == 201 and r.json[\"name\"] == \"New Store\", \"admin create 201\")\nnew_id = r.json[\"id\"]\n\nr = c.put(f\"/api/admin/stores/{new_id}\", json={\"name\": \"Edited\", \"address\": \"2 B St\", \"latitude\": 48.86, \"longitude\": 2.36}, headers=A)\ncheck(r.status_code == 200 and r.json[\"phone\"] == \"\", \"PUT omitted phone cleared\")\ncheck(r.json[\"name\"] == \"Edited\", \"PUT replaced fields\")\n\ncheck(c.put(f\"/api/admin/stores/{new_id}\", json={\"name\": \"E\", \"address\": \"A\", \"latitude\": 200, \"longitude\": 2}, headers=A).status_code == 400, \"PUT validation\")\ncheck(c.put(\"/api/admin/stores/9999\", json={\"name\": \"E\"}, headers=A).status_code == 404, \"PUT missing 404\")\n\ncheck(c.delete(f\"/api/admin/stores/{new_id}\", headers=B).status_code == 403, \"delete non-admin 403\")\nr = c.delete(f\"/api/admin/stores/{new_id}\", headers=A)\ncheck(r.status_code == 200, \"delete 200\")\ncheck(c.get(f\"/api/stores/{new_id}\").status_code == 404, \"deleted gone\")\ncheck(c.delete(f\"/api/admin/stores/{new_id}\", headers=A).status_code == 404, \"delete missing 404\")\n\ncheck(c.get(\"/api/stores\").status_code == 200 and len(c.get(\"/api/stores\").json[\"items\"]) == 8, \"back to 8 stores\")\n\nprint(\"\\nALL PASSED\")\n","filePath":"/workspace/.venv/test_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.venv/test_api.py","exists":false,"truncated":false},"title":".venv/test_api.py","time":{"start":1794385159092,"end":1794385159106}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9b0a3ad001HxSFTM7D7mimZt","sessionID":"ses_e3651ea06ffejCbwMEiK3BtEML","messageID":"msg_1c9b06dbe001JnFUnRbOTUsNMT"}}
