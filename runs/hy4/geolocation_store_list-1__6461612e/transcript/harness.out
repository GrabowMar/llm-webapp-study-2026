{"type":"tool_use","timestamp":1794385239327,"sessionID":"ses_e3651ea06ffejCbwMEiK3BtEML","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8be6bb898c78a0ac","state":{"status":"completed","input":{"content":"export type Store = {\n  id: number;\n  name: string;\n  address: string;\n  phone: string;\n  latitude: number;\n  longitude: number;\n  distance_km: number | null;\n};\n\nexport type StoreDraft = {\n  name: string;\n  address: string;\n  phone: string;\n  latitude: string;\n  longitude: string;\n};\n\nexport const emptyDraft: StoreDraft = {\n  name: \"\",\n  address: \"\",\n  phone: \"\",\n  latitude: \"\",\n  longitude: \"\",\n};\n\nexport type ApiError = {\n  errors?: Record<string, string>;\n  error?: string;\n};\n\nexport async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {\n  const headers = new Headers(options.headers);\n  headers.set(\"Accept\", \"application/json\");\n  if (options.body !== undefined) headers.set(\"Content-Type\", \"application/json\");\n  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  const response = await fetch(path, { ...options, headers });\n  const text = await response.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n  if (!response.ok) {\n    const err: ApiError = (data as ApiError) ?? {};\n    throw { status: response.status, ...err } as ApiError & { status: number };\n  }\n  return data as T;\n}\n\nexport async function getStores(params: {\n  q?: string;\n  lat?: number;\n  lng?: number;\n  radius?: number;\n}): Promise<Store[]> {\n  const search = new URLSearchParams();\n  if (params.q) search.set(\"q\", params.q);\n  if (params.lat !== undefined && params.lng !== undefined) {\n    search.set(\"lat\", String(params.lat));\n    search.set(\"lng\", String(params.lng));\n    if (params.radius !== undefined) search.set(\"radius\", String(params.radius));\n  }\n  const suffix = search.toString();\n  const result = await api<{ items: Store[] }>(`/api/stores${suffix ? `?${suffix}` : \"\"}`);\n  return result.items;\n}\n\nexport function draftToPayload(draft: StoreDraft) {\n  return {\n    name: draft.name,\n    address: draft.address,\n    phone: draft.phone,\n    latitude: draft.latitude.trim() === \"\" ? null : Number(draft.latitude),\n    longitude: draft.longitude.trim() === \"\" ? null : Number(draft.longitude),\n  };\n}\n\nexport function storeToDraft(store: Store): StoreDraft {\n  return {\n    name: store.name,\n    address: store.address,\n    phone: store.phone,\n    latitude: String(store.latitude),\n    longitude: String(store.longitude),\n  };\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794385239295,"end":1794385239306}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9b1dcfa001rxjgb86XP9lxqZ","sessionID":"ses_e3651ea06ffejCbwMEiK3BtEML","messageID":"msg_1c9b1ba650013yas70YWB129Db"}}
