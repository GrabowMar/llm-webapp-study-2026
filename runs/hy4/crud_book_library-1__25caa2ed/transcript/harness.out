{"type":"tool_use","timestamp":1794304931724,"sessionID":"ses_e3b22ae5dffemdZd3tQ7H9eZOA","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-af8fa33414cecd4c","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, ApiError } from \"./api\";\nimport type { Navigate, Session } from \"./App\";\nimport {\n  Alert,\n  Button,\n  Field,\n  formatDate,\n  Stars,\n} from \"./components\";\nimport type { FieldErrors } from \"./types\";\n\nexport default function BookDetail({\n  bookId,\n  session,\n  navigate,\n}: {\n  bookId: number;\n  session: Session | null;\n  navigate: Navigate;\n}) {\n  const [book, setBook] = useState<Book | null>(null);\n  const [reviews, setReviews] = useState<Review[]>([]);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [confirmDelete, setConfirmDelete] = useState(false);\n  const [deleting, setDeleting] = useState(false);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    setError(\"\");\n    try {\n      const [bookData, reviewData] = await Promise.all([\n        api.book(bookId),\n        api.reviews(bookId),\n      ]);\n      setBook(bookData);\n      setReviews(reviewData.items);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Could not load the book.\");\n    } finally {\n      setLoading(false);\n    }\n  }, [bookId]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  const onDelete = async () => {\n    setDeleting(true);\n    try {\n      await api.deleteBook(bookId);\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Could not delete the book.\");\n      setConfirmDelete(false);\n      setDeleting(false);\n    }\n  };\n\n  if (loading && !book) {\n    return <p className=\"text-center text-slate-500\">Loading…</p>;\n  }\n  if (!book) {\n    return (\n      <div className=\"space-y-4\">\n        <Alert message={error || \"Book not found.\"} />\n        <Button variant=\"secondary\" onClick={() => navigate(\"/\")}>\n          Back to books\n        </Button>\n      </div>\n    );\n  }\n\n  const alreadyReviewed = !!(\n    session &&\n    reviews.some((r) => r.username === session.username)\n  );\n\n  return (\n    <div className=\"space-y-8\">\n      <Button variant=\"ghost\" onClick={() => navigate(\"/\")}>\n        ← Back to books\n      </Button>\n\n      <section className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n        <div className=\"flex flex-wrap items-start justify-between gap-4\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-slate-900\">{book.title}</h1>\n            <p className=\"mt-1 text-slate-600\">by {book.author}</p>\n          </div>\n          <div className=\"text-right\">\n            <div className=\"text-3xl font-bold text-indigo-700\">\n              {book.average_rating === null\n                ? \"—\"\n                : book.average_rating.toFixed(1)}\n            </div>\n            <div className=\"text-xs text-slate-500\">\n              {book.review_count}{\" \"}\n              {book.review_count === 1 ? \"review\" : \"reviews\"}\n            </div>\n            {book.average_rating !== null && (\n              <Stars rating={Math.round(book.average_rating)} />\n            )}\n          </div>\n        </div>\n\n        <dl className=\"mt-6 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4 text-sm sm:grid-cols-3\">\n          <Detail label=\"Year\" value={book.year === null ? \"—\" : String(book.year)} />\n          <Detail label=\"ISBN\" value={book.isbn || \"—\"} />\n          <Detail label=\"Added\" value={formatDate(book.created_at)} />\n        </dl>\n\n        {session && (\n          <div className=\"mt-6 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4\">\n            <Button variant=\"secondary\" onClick={() => navigate(`/books/${book.id}/edit`)}>\n              Edit\n            </Button>\n            {confirmDelete ? (\n              <span className=\"flex items-center gap-2\">\n                <span className=\"text-sm text-slate-600\">\n                  Delete this book and its reviews?\n                </span>\n                <Button variant=\"danger\" disabled={deleting} onClick={onDelete}>\n                  {deleting ? \"Deleting…\" : \"Yes, delete\"}\n                </Button>\n                <Button\n                  variant=\"secondary\"\n                  onClick={() => setConfirmDelete(false)}\n                >\n                  Cancel\n                </Button>\n              </span>\n            ) : (\n              <Button variant=\"danger\" onClick={() => setConfirmDelete(true)}>\n                Delete\n              </Button>\n            )}\n          </div>\n        )}\n\n        {error && (\n          <div className=\"mt-4\">\n            <Alert message={error} />\n          </div>\n        )}\n      </section>\n\n      <section className=\"space-y-4\">\n        <h2 className=\"text-xl font-semibold text-slate-900\">\n          Reviews ({reviews.length})\n        </h2>\n\n        {session && !alreadyReviewed && (\n          <ReviewForm bookId={bookId} onAdded={load} />\n        )}\n        {session && alreadyReviewed && (\n          <p className=\"rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600\">\n            You have already reviewed this book.\n          </p>\n        )}\n        {!session && (\n          <p className=\"rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600\">\n            Want to add a review?{\" \"}\n            <button\n              type=\"button\"\n              onClick={() => navigate(\"/login\")}\n              className=\"font-medium text-indigo-600 hover:underline\"\n            >\n              Sign in\n            </button>\n            .\n          </p>\n        )}\n\n        {reviews.length === 0 ? (\n          <p className=\"rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-slate-500\">\n            No reviews yet. Be the first to review this book.\n          </p>\n        ) : (\n          <ul className=\"space-y-3\">\n            {reviews.map((review) => (\n              <li\n                key={review.id}\n                className=\"rounded-lg border border-slate-200 bg-white p-5 shadow-sm\"\n              >\n                <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                  <span className=\"font-semibold text-slate-800\">\n                    {review.username}\n                  </span>\n                  <span className=\"text-xs text-slate-400\">\n                    {formatDate(review.created_at)}\n                  </span>\n                </div>\n                <div className=\"mt-1 text-sm\">\n                  <Stars rating={review.rating} />\n                  <span className=\"ml-2 text-slate-500\">\n                    {review.rating}/5\n                  </span>\n                </div>\n                {review.comment && (\n                  <p className=\"mt-3 whitespace-pre-wrap text-sm text-slate-700\">\n                    {review.comment}\n                  </p>\n                )}\n              </li>\n            ))}\n          </ul>\n        )}\n      </section>\n    </div>\n  );\n}\n\nfunction Detail({ label, value }: { label: string; value: string }) {\n  return (\n    <div>\n      <dt className=\"text-xs font-semibold uppercase tracking-wide text-slate-400\">\n        {label}\n      </dt>\n      <dd className=\"mt-1 text-slate-700\">{value}</dd>\n    </div>\n  );\n}\n\nfunction ReviewForm({\n  bookId,\n  onAdded,\n}: {\n  bookId: number;\n  onAdded: () => void;\n}) {\n  const [rating, setRating] = useState(5);\n  const [comment, setComment] = useState(\"\");\n  const [errors, setErrors] = useState<FieldErrors>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (event: FormEvent) => {\n    event.preventDefault();\n    setErrors({});\n    setMessage(\"\");\n    setBusy(true);\n    try {\n      await api.createReview(bookId, Number(rating), comment);\n      setComment(\"\");\n      setRating(5);\n      onAdded();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.errors);\n        setMessage(err.message);\n      } else {\n        setMessage(\"Could not submit your review.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"space-y-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm\"\n    >\n      <h3 className=\"font-semibold text-slate-800\">Write a review</h3>\n      {message && <Alert message={message} />}\n      <Field label=\"Rating\" name=\"rating\" error={errors.rating}>\n        <select\n          id=\"rating\"\n          value={rating}\n          onChange={(e) => setRating(Number(e.target.value))}\n          className=\"w-40 rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n        >\n          {[1, 2, 3, 4, 5].map((n) => (\n            <option key={n} value={n}>\n              {n} {n === 1 ? \"star\" : \"stars\"}\n            </option>\n          ))}\n        </select>\n      </Field>\n      <Field label=\"Comment (optional)\" name=\"comment\" error={errors.comment}>\n        <textarea\n          id=\"comment\"\n          rows={3}\n          value={comment}\n          onChange={(e) => setComment(e.target.value)}\n          placeholder=\"What did you think?\"\n          className=\"block w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n        />\n      </Field>\n      <Button type=\"submit\" disabled={busy}>\n        {busy ? \"Submitting…\" : \"Submit review\"}\n      </Button>\n    </form>\n  );\n}\n","filePath":"/workspace/frontend/src/BookDetail.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/BookDetail.tsx","exists":false,"truncated":false},"title":"frontend/src/BookDetail.tsx","time":{"start":1794304931682,"end":1794304931698}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4e877570013oY3sWFV7BcJxE","sessionID":"ses_e3b22ae5dffemdZd3tQ7H9eZOA","messageID":"msg_1c4e83218001l4DcTnXt6kV8i4"}}
