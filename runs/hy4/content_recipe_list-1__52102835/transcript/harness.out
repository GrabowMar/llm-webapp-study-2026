{"type":"text","timestamp":1794321507940,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"id":"prt_1c5e56651001QRxFwFqJsRGSjY","messageID":"msg_1c5e5318d001cxpgntwnKRRkPA","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","type":"text","text":"Now the recipe detail view:","time":{"start":1794321507921,"end":1794321507936}}}
{"type":"tool_use","timestamp":1794321507960,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-89418adbb9270280","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { api, ApiError, type Recipe } from \"./api\";\nimport {\n  Banner,\n  ConfirmDialog,\n  dangerBtn,\n  secondaryBtn,\n  Spinner,\n} from \"./ui\";\n\nfunction formatDate(value: string): string {\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return value;\n  return date.toLocaleDateString(undefined, {\n    year: \"numeric\",\n    month: \"long\",\n    day: \"numeric\",\n  });\n}\n\nexport function RecipeView({\n  id,\n  username,\n  onBack,\n  onEdit,\n  onDeleted,\n  onSignIn,\n}: {\n  id: number;\n  username: string | null;\n  onBack: () => void;\n  onEdit: (id: number) => void;\n  onDeleted: () => void;\n  onSignIn: () => void;\n}) {\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n  const [deleting, setDeleting] = useState(false);\n  const [deleteError, setDeleteError] = useState(\"\");\n\n  useEffect(() => {\n    setLoading(true);\n    setError(\"\");\n    api\n      .getRecipe(id)\n      .then(setRecipe)\n      .catch((err: unknown) => {\n        setError(err instanceof ApiError ? err.message : \"Could not load the recipe.\");\n      })\n      .finally(() => setLoading(false));\n  }, [id]);\n\n  async function handleDelete() {\n    setDeleting(true);\n    setDeleteError(\"\");\n    try {\n      await api.deleteRecipe(id);\n      onDeleted();\n    } catch (err) {\n      setDeleteError(err instanceof ApiError ? err.message : \"Could not delete the recipe.\");\n      setDeleting(false);\n      setConfirming(false);\n    }\n  }\n\n  if (loading) return <Spinner label=\"Loading recipe…\" />;\n\n  if (error || !recipe) {\n    return (\n      <div className=\"mx-auto max-w-xl space-y-4 py-10\">\n        <Banner>{error || \"Recipe not found.\"}</Banner>\n        <button type=\"button\" className={secondaryBtn} onClick={onBack}>\n          ← Back to recipes\n        </button>\n      </div>\n    );\n  }\n\n  const isAuthor = username !== null && username.toLowerCase() === recipe.author.toLowerCase();\n\n  return (\n    <>\n      <article className=\"mx-auto max-w-3xl\">\n        <button\n          type=\"button\"\n          onClick={onBack}\n          className=\"mb-5 text-sm font-semibold text-amber-700 hover:underline\"\n        >\n          ← Back to recipes\n        </button>\n\n        <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-9\">\n          <span className=\"inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800\">\n            {recipe.category}\n          </span>\n          <h1 className=\"mt-4 text-3xl font-extrabold leading-tight text-stone-900\">\n            {recipe.title}\n          </h1>\n          <div className=\"mt-4 flex flex-wrap gap-x-6 gap-y-2 border-b border-stone-100 pb-6 text-sm text-stone-500\">\n            <span>\n              By <span className=\"font-semibold text-stone-700\">{recipe.author}</span>\n            </span>\n            <span>⏱ {recipe.prep_minutes} min prep</span>\n            <span>🍽 Serves {recipe.servings}</span>\n            <span>{formatDate(recipe.created_at)}</span>\n          </div>\n\n          <div className=\"mt-7\">\n            <h2 className=\"text-xl font-bold text-stone-900\">Ingredients</h2>\n            <ul className=\"mt-3 space-y-2\">\n              {recipe.ingredients.map((ingredient, index) => (\n                <li key={`${index}-${ingredient}`} className=\"flex items-start gap-3 text-stone-700\">\n                  <span\n                    aria-hidden=\"true\"\n                    className=\"mt-1.5 h-2 w-2 shrink-0 rounded-full bg-amber-500\"\n                  />\n                  <span>{ingredient}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"mt-9\">\n            <h2 className=\"text-xl font-bold text-stone-900\">Instructions</h2>\n            <div className=\"mt-3 space-y-3 leading-relaxed text-stone-700\">\n              {recipe.instructions.split(\"\\n\").map((line, index) => (\n                <p key={index} className={line.trim() ? \"\" : \"h-2\"}>\n                  {line || \"\\u00A0\"}\n                </p>\n              ))}\n            </div>\n          </div>\n\n          {isAuthor && (\n            <div className=\"mt-9 flex flex-wrap gap-2 border-t border-stone-100 pt-6\">\n              <button\n                type=\"button\"\n                className={secondaryBtn}\n                onClick={() => onEdit(recipe.id)}\n              >\n                Edit recipe\n              </button>\n              <button\n                type=\"button\"\n                className={dangerBtn}\n                onClick={() => setConfirming(true)}\n              >\n                Delete recipe\n              </button>\n            </div>\n          )}\n          {!username && (\n            <p className=\"mt-8 border-t border-stone-100 pt-5 text-sm text-stone-500\">\n              Want to share a recipe of your own?{\" \"}\n              <button\n                type=\"button\"\n                onClick={onSignIn}\n                className=\"font-semibold text-amber-700 underline-offset-2 hover:underline\"\n              >\n                Sign in\n              </button>\n            </p>\n          )}\n        </div>\n      </article>\n\n      {deleteError && (\n        <div className=\"mx-auto mt-4 max-w-3xl\">\n          <Banner>{deleteError}</Banner>\n        </div>\n      )}\n\n      {confirming && (\n        <ConfirmDialog\n          title=\"Delete this recipe?\"\n          message={`“${recipe.title}” will be permanently removed. This cannot be undone.`}\n          busy={deleting}\n          onConfirm={handleDelete}\n          onCancel={() => setConfirming(false)}\n        />\n      )}\n    </>\n  );\n}\n","filePath":"/workspace/frontend/src/RecipeView.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/RecipeView.tsx","exists":false,"truncated":false},"title":"frontend/src/RecipeView.tsx","time":{"start":1794321507933,"end":1794321507942}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e56654001PMM67kAEg9Cm9d","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","messageID":"msg_1c5e5318d001cxpgntwnKRRkPA"}}
