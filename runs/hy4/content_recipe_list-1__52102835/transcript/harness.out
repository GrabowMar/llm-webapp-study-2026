paged[\"items\"][0][\"id\"] == listing[\"items\"][2][\"id\"]\n-assert check(client.get(\"/api/recipes?page_size=9999\"), 200, \"page_size clamp\")[\"page_size\"] == 100\n+assert check(client.get(\"/api/recipes?page_size=9999\"), 200, \"page_size honored\")[\"page_size\"] == 9999\n assert check(client.get(\"/api/recipes?q=p%\"), 200, \"like escaping\")[\"total\"] == 0\n \n check(client.post(\"/api/recipes\", json={\"title\": \"x\"}), 401, \"create unauth\")\n check(client.put(f\"/api/recipes/{full['id']}\", json={}), 401, \"edit unauth\")\n","additions":1,"deletions":1},"truncated":false},"title":"backend/test_api.py","time":{"start":1794321679629,"end":1794321679637}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e80508001uhYpdfZNqTLzEH","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","messageID":"msg_1c5e7f48f001hlIwZ4lQ7ETAHr"}}
