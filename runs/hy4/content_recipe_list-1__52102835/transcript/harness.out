{"type":"tool_use","timestamp":1794321404245,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8f3990d407eb13ce","state":{"status":"completed","input":{"content":"export type ListItem = {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number;\n  author: string;\n};\n\nexport type Recipe = {\n  id: number;\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: number;\n  servings: number;\n  created_at: string;\n  author: string;\n};\n\nexport type PagedRecipes = {\n  items: ListItem[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type RecipeInput = {\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: number;\n  servings: number;\n};\n\nexport type ApiErrors = Record<string, string> & { general?: string };\n\nexport class ApiError extends Error {\n  status: number;\n  errors: ApiErrors;\n\n  constructor(status: number, message: string, errors: ApiErrors = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"recipe-book-token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null): void {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n  authenticated = false,\n): Promise<T> {\n  const headers = new Headers(options.headers);\n  if (options.body !== undefined) headers.set(\"Content-Type\", \"application/json\");\n  if (authenticated) {\n    const token = getToken();\n    if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  }\n\n  let response: Response;\n  try {\n    response = await fetch(`/api${path}`, { ...options, headers });\n  } catch {\n    throw new ApiError(0, \"Cannot reach the server. Please try again.\");\n  }\n\n  let data: unknown = null;\n  const text = await response.text();\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n\n  if (!response.ok) {\n    const body = (data ?? {}) as {\n      message?: string;\n      error?: string;\n      errors?: Record<string, string>;\n    };\n    const message =\n      body.message ??\n      body.error ??\n      (response.status === 401\n        ? \"Please sign in to continue.\"\n        : \"Something went wrong. Please try again.\");\n    const errors: ApiErrors = { ...(body.errors ?? {}) };\n    throw new ApiError(response.status, message, errors);\n  }\n  return data as T;\n}\n\nexport const api = {\n  health: () => request<{ status: string }>(\"/health\"),\n\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n\n  me: () => request<{ id: number; username: string }>(\"/auth/me\", {}, true),\n\n  categories: () => request<string[]>(\"/categories\"),\n\n  listRecipes: (params: {\n    category?: string;\n    q?: string;\n    page?: number;\n    page_size?: number;\n  }) => {\n    const search = new URLSearchParams();\n    if (params.category) search.set(\"category\", params.category);\n    if (params.q) search.set(\"q\", params.q);\n    if (params.page) search.set(\"page\", String(params.page));\n    if (params.page_size) search.set(\"page_size\", String(params.page_size));\n    const query = search.toString();\n    return request<PagedRecipes>(`/recipes${query ? `?${query}` : \"\"}`);\n  },\n\n  getRecipe: (id: number) => request<Recipe>(`/recipes/${id}`),\n\n  createRecipe: (input: RecipeInput) =>\n    request<Recipe>(\n      \"/recipes\",\n      { method: \"POST\", body: JSON.stringify(input) },\n      true,\n    ),\n\n  updateRecipe: (id: number, input: RecipeInput) =>\n    request<Recipe>(\n      `/recipes/${id}`,\n      { method: \"PUT\", body: JSON.stringify(input) },\n      true,\n    ),\n\n  deleteRecipe: (id: number) =>\n    request<{ id: number }>(`/recipes/${id}`, { method: \"DELETE\" }, true),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794321404218,"end":1794321404227}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e3d134001l3DcyRlyuvhD3E","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","messageID":"msg_1c5e3a72c001wDVSNozHYf57wy"}}
