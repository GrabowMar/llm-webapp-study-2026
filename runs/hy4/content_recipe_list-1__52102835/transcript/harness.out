{"type":"text","timestamp":1794321540598,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"id":"prt_1c5e5e5e90013E8BZg0eD9h0gX","messageID":"msg_1c5e5ae850012NfHg9fLdJRZRa","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","type":"text","text":"Now the main App component tying everything together:","time":{"start":1794321540585,"end":1794321540596}}}
{"type":"tool_use","timestamp":1794321540620,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-ac52727e98e5bf80","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, getToken, setToken } from \"./api\";\nimport { AuthPanel } from \"./AuthPanel\";\nimport { BrowseView } from \"./BrowseView\";\nimport { RecipeForm } from \"./RecipeForm\";\nimport { RecipeView } from \"./RecipeView\";\nimport { primaryBtn } from \"./ui\";\n\ntype View =\n  | { name: \"browse\" }\n  | { name: \"recipe\"; id: number }\n  | { name: \"add\" }\n  | { name: \"edit\"; id: number };\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(null);\n  const [authReady, setAuthReady] = useState(false);\n  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n  const [view, setView] = useState<View>({ name: \"browse\" });\n  const [refreshKey, setRefreshKey] = useState(0);\n  const [categories, setCategories] = useState<string[]>([]);\n\n  useEffect(() => {\n    if (!getToken()) {\n      setAuthReady(true);\n      return;\n    }\n    api\n      .me()\n      .then((user) => setUsername(user.username))\n      .catch((err: unknown) => {\n        if (err instanceof ApiError && err.status === 401) setToken(null);\n      })\n      .finally(() => setAuthReady(true));\n  }, []);\n\n  useEffect(() => {\n    api\n      .categories()\n      .then(setCategories)\n      .catch(() => setCategories([]));\n  }, [refreshKey]);\n\n  useEffect(() => {\n    window.scrollTo({ top: 0, behavior: \"smooth\" });\n  }, [view]);\n\n  const refresh = useCallback(() => setRefreshKey((key) => key + 1), []);\n\n  function openRecipe(id: number) {\n    setView({ name: \"recipe\", id });\n  }\n\n  function requireAuth(action: () => void) {\n    if (username) {\n      action();\n    } else {\n      setAuthMode(\"login\");\n    }\n  }\n\n  function handleSignOut() {\n    setToken(null);\n    setUsername(null);\n    if (view.name === \"add\" || view.name === \"edit\") setView({ name: \"browse\" });\n  }\n\n  function handleDeleted() {\n    refresh();\n    setView({ name: \"browse\" });\n  }\n\n  return (\n    <div className=\"min-h-screen bg-amber-50\">\n      <header className=\"sticky top-0 z-30 border-b border-stone-200 bg-white/90 shadow-sm backdrop-blur\">\n        <div className=\"mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-4 py-3 sm:px-6\">\n          <button\n            type=\"button\"\n            onClick={() => setView({ name: \"browse\" })}\n            className=\"flex items-center gap-2 text-left\"\n          >\n            <span\n              aria-hidden=\"true\"\n              className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-amber-600 text-lg text-white shadow-sm\"\n            >\n              🍳\n            </span>\n            <span className=\"text-lg font-extrabold tracking-tight text-stone-900\">\n              Recipe Book\n            </span>\n          </button>\n\n          <div className=\"ml-auto flex flex-wrap items-center gap-2\">\n            {username && (\n              <button\n                type=\"button\"\n                className={primaryBtn}\n                onClick={() => setView({ name: \"add\" })}\n              >\n                + Add recipe\n              </button>\n            )}\n            {!username && !authReady ? (\n              <span className=\"h-9 w-24 animate-pulse rounded-lg bg-stone-100\" />\n            ) : username ? (\n              <>\n                <span className=\"hidden text-sm text-stone-500 sm:inline\">\n                  Signed in as{\" \"}\n                  <span className=\"font-semibold text-stone-800\">{username}</span>\n                </span>\n                <span className=\"rounded-full bg-amber-100 px-3 py-1.5 text-sm font-semibold text-amber-800 sm:hidden\">\n                  {username}\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={handleSignOut}\n                  className=\"rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-semibold text-stone-700 shadow-sm transition hover:bg-stone-100\"\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  type=\"button\"\n                  onClick={() => setAuthMode(\"login\")}\n                  className=\"rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-semibold text-stone-700 shadow-sm transition hover:bg-stone-100\"\n                >\n                  Sign in\n                </button>\n                <button\n                  type=\"button\"\n                  className={primaryBtn}\n                  onClick={() => setAuthMode(\"register\")}\n                >\n                  Register\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-8 sm:px-6\">\n        {view.name === \"browse\" && (\n          <>\n            <div className=\"mb-8 flex flex-wrap items-end justify-between gap-4\">\n              <div>\n                <h1 className=\"text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl\">\n                  Find your next favourite dish\n                </h1>\n                <p className=\"mt-2 text-stone-500\">\n                  Browse recipes shared by our community of cooks.\n                </p>\n              </div>\n              {!username && (\n                <button\n                  type=\"button\"\n                  className={primaryBtn}\n                  onClick={() => requireAuth(() => setView({ name: \"add\" }))}\n                >\n                  + Share a recipe\n                </button>\n              )}\n            </div>\n            <BrowseView onOpenRecipe={openRecipe} refreshKey={refreshKey} />\n          </>\n        )}\n\n        {view.name === \"recipe\" && (\n          <RecipeView\n            id={view.id}\n            username={username}\n            onBack={() => setView({ name: \"browse\" })}\n            onEdit={(id) => setView({ name: \"edit\", id })}\n            onDeleted={handleDeleted}\n            onSignIn={() => setAuthMode(\"login\")}\n          />\n        )}\n\n        {(view.name === \"add\" || view.name === \"edit\") && (\n          <RecipeForm\n            recipeId={view.name === \"edit\" ? view.id : null}\n            categories={categories}\n            onCancel={() =>\n              setView(\n                view.name === \"edit\"\n                  ? { name: \"recipe\", id: view.id }\n                  : { name: \"browse\" },\n              )\n            }\n            onSaved={(id) => {\n              refresh();\n              setView({ name: \"recipe\", id });\n            }}\n          />\n        )}\n      </main>\n\n      <footer className=\"border-t border-stone-200 py-6 text-center text-xs text-stone-400\">\n        Recipe Book · Cook something wonderful today\n      </footer>\n\n      {authMode && (\n        <AuthPanel\n          mode={authMode}\n          onSwitchMode={setAuthMode}\n          onClose={() => setAuthMode(null)}\n          onAuthenticated={(name) => {\n            setUsername(name);\n            setAuthMode(null);\n          }}\n        />\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794321540592,"end":1794321540602}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e5e5ec001rNyrljW3r3dtSN","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","messageID":"msg_1c5e5ae850012NfHg9fLdJRZRa"}}
