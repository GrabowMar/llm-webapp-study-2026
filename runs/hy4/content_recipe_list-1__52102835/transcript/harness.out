{"type":"tool_use","timestamp":1794321494418,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-813d2ecaa131152b","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, type ListItem } from \"./api\";\nimport { Banner, inputClass, secondaryBtn, Spinner } from \"./ui\";\n\nconst PAGE_SIZE = 9;\n\nfunction RecipeCard({ recipe, onOpen }: { recipe: ListItem; onOpen: (id: number) => void }) {\n  return (\n    <button\n      type=\"button\"\n      onClick={() => onOpen(recipe.id)}\n      className=\"group flex h-full w-full flex-col rounded-2xl border border-stone-200 bg-white p-5 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-amber-400\"\n    >\n      <span className=\"inline-flex w-fit rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800\">\n        {recipe.category}\n      </span>\n      <h3 className=\"mt-3 text-lg font-bold leading-snug text-stone-900 group-hover:text-amber-800\">\n        {recipe.title}\n      </h3>\n      <div className=\"mt-auto flex items-center justify-between gap-2 pt-5 text-xs text-stone-500\">\n        <span className=\"inline-flex items-center gap-1\">\n          <span aria-hidden=\"true\">⏱</span> {recipe.prep_minutes} min\n        </span>\n        <span className=\"truncate\">by {recipe.author}</span>\n      </div>\n    </button>\n  );\n}\n\nexport function BrowseView({\n  onOpenRecipe,\n  refreshKey,\n}: {\n  onOpenRecipe: (id: number) => void;\n  refreshKey: number;\n}) {\n  const [category, setCategory] = useState(\"\");\n  const [searchInput, setSearchInput] = useState(\"\");\n  const [query, setQuery] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [categories, setCategories] = useState<string[]>([]);\n  const [items, setItems] = useState<ListItem[]>([]);\n  const [total, setTotal] = useState(0);\n  const [pageSize, setPageSize] = useState(PAGE_SIZE);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    api\n      .categories()\n      .then(setCategories)\n      .catch(() => setCategories([]));\n  }, [refreshKey]);\n\n  useEffect(() => {\n    const timer = window.setTimeout(() => {\n      setQuery(searchInput.trim());\n      setPage(1);\n    }, 300);\n    return () => window.clearTimeout(timer);\n  }, [searchInput]);\n\n  const load = useCallback(() => {\n    setLoading(true);\n    setError(\"\");\n    api\n      .listRecipes({ category, q: query, page, page_size: PAGE_SIZE })\n      .then((result) => {\n        setItems(result.items);\n        setTotal(result.total);\n        setPageSize(result.page_size);\n      })\n      .catch((err: unknown) => {\n        setError(err instanceof ApiError ? err.message : \"Could not load recipes.\");\n      })\n      .finally(() => setLoading(false));\n  }, [category, query, page, refreshKey]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  const totalPages = Math.max(1, Math.ceil(total / pageSize));\n\n  function changeCategory(value: string) {\n    setCategory(value);\n    setPage(1);\n  }\n\n  return (\n    <section>\n      <div className=\"mb-6 flex flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center\">\n        <div className=\"flex-1\">\n          <label className=\"sr-only\" htmlFor=\"search\">\n            Search recipes by title\n          </label>\n          <input\n            id=\"search\"\n            className={inputClass}\n            type=\"search\"\n            value={searchInput}\n            onChange={(event) => setSearchInput(event.target.value)}\n            placeholder=\"Search recipes by title…\"\n          />\n        </div>\n        <div className=\"sm:w-56\">\n          <label className=\"sr-only\" htmlFor=\"category\">\n            Filter by category\n          </label>\n          <select\n            id=\"category\"\n            className={inputClass}\n            value={category}\n            onChange={(event) => changeCategory(event.target.value)}\n          >\n            <option value=\"\">All categories</option>\n            {categories.map((name) => (\n              <option key={name} value={name}>\n                {name}\n              </option>\n            ))}\n          </select>\n        </div>\n        {(category || query) && (\n          <button\n            type=\"button\"\n            className={secondaryBtn}\n            onClick={() => {\n              setCategory(\"\");\n              setSearchInput(\"\");\n              setQuery(\"\");\n              setPage(1);\n            }}\n          >\n            Clear\n          </button>\n        )}\n      </div>\n\n      <div className=\"mb-4 flex items-baseline justify-between\">\n        <h2 className=\"text-xl font-bold text-stone-900\">\n          {query ? `Results for “${query}”` : \"All recipes\"}\n        </h2>\n        <span className=\"text-sm text-stone-500\">\n          {total} {total === 1 ? \"recipe\" : \"recipes\"}\n        </span>\n      </div>\n\n      {error && <Banner>{error}</Banner>}\n\n      {loading ? (\n        <Spinner label=\"Loading recipes…\" />\n      ) : items.length === 0 ? (\n        <div className=\"rounded-2xl border border-dashed border-stone-300 bg-white py-16 text-center\">\n          <p className=\"text-lg font-semibold text-stone-700\">No recipes found</p>\n          <p className=\"mt-1 text-sm text-stone-500\">\n            Try a different search or category.\n          </p>\n        </div>\n      ) : (\n        <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {items.map((recipe) => (\n            <RecipeCard key={recipe.id} recipe={recipe} onOpen={onOpenRecipe} />\n          ))}\n        </div>\n      )}\n\n      {totalPages > 1 && !loading && (\n        <nav className=\"mt-8 flex items-center justify-center gap-3\" aria-label=\"Recipe pages\">\n          <button\n            type=\"button\"\n            className={secondaryBtn}\n            disabled={page <= 1}\n            onClick={() => setPage((current) => Math.max(1, current - 1))}\n          >\n            Previous\n          </button>\n          <span className=\"text-sm font-medium text-stone-600\">\n            Page {page} of {totalPages}\n          </span>\n          <button\n            type=\"button\"\n            className={secondaryBtn}\n            disabled={page >= totalPages}\n            onClick={() => setPage((current) => Math.min(totalPages, current + 1))}\n          >\n            Next\n          </button>\n        </nav>\n      )}\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/BrowseView.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/BrowseView.tsx","exists":false,"truncated":false},"title":"frontend/src/BrowseView.tsx","time":{"start":1794321494389,"end":1794321494400}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e5316f0012pRMCqNTBl5Rdo","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","messageID":"msg_1c5e4fc250011NZVMQGPzjKX7N"}}
{"type":"step_finish","timestamp":1794321494418,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"id":"prt_1c5e53183001aXfxGW3OfxxHmC","reason":"tool-calls","messageID":"msg_1c5e4fc250011NZVMQGPzjKX7N","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","type":"step-finish","tokens":{"total":47422,"input":1006,"output":1616,"reasoning":0,"cache":{"write":0,"read":44800}},"cost":0}}
