{"type":"text","timestamp":1794321526412,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"id":"prt_1c5e5ae62001r0YVbdJdOQWJzy","messageID":"msg_1c5e56672001Lv3UVJ9qspzqeq","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","type":"text","text":"Now the add/edit form with dynamic ingredient rows:","time":{"start":1794321526370,"end":1794321526382}}}
{"type":"tool_use","timestamp":1794321526412,"sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-95f9c2bc67b2738d","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, type ApiErrors, type Recipe } from \"./api\";\nimport {\n  Banner,\n  FieldError,\n  inputClass,\n  labelClass,\n  primaryBtn,\n  secondaryBtn,\n  Spinner,\n} from \"./ui\";\n\ntype FormState = {\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: string;\n  servings: string;\n};\n\nconst emptyForm: FormState = {\n  title: \"\",\n  ingredients: [\"\"],\n  instructions: \"\",\n  category: \"\",\n  prep_minutes: \"0\",\n  servings: \"1\",\n};\n\nfunction toForm(recipe: Recipe): FormState {\n  return {\n    title: recipe.title,\n    ingredients: recipe.ingredients.length ? [...recipe.ingredients] : [\"\"],\n    instructions: recipe.instructions,\n    category: recipe.category,\n    prep_minutes: String(recipe.prep_minutes),\n    servings: String(recipe.servings),\n  };\n}\n\nexport function RecipeForm({\n  recipeId,\n  categories,\n  onCancel,\n  onSaved,\n}: {\n  recipeId: number | null;\n  categories: string[];\n  onCancel: () => void;\n  onSaved: (id: number) => void;\n}) {\n  const isEdit = recipeId !== null;\n  const [form, setForm] = useState<FormState>(emptyForm);\n  const [loading, setLoading] = useState(isEdit);\n  const [loadError, setLoadError] = useState(\"\");\n  const [errors, setErrors] = useState<ApiErrors>({});\n  const [general, setGeneral] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (recipeId === null) {\n      setForm(emptyForm);\n      return;\n    }\n    setLoading(true);\n    api\n      .getRecipe(recipeId)\n      .then((recipe) => setForm(toForm(recipe)))\n      .catch((err: unknown) => {\n        setLoadError(err instanceof ApiError ? err.message : \"Could not load the recipe.\");\n      })\n      .finally(() => setLoading(false));\n  }, [recipeId]);\n\n  const update = useCallback(\n    <K extends keyof FormState>(field: K, value: FormState[K]) => {\n      setForm((current) => ({ ...current, [field]: value }));\n      setErrors((current) => {\n        if (!(field in current)) return current;\n        const next = { ...current };\n        delete next[field as string];\n        return next;\n      });\n    },\n    [],\n  );\n\n  function setIngredient(index: number, value: string) {\n    setForm((current) => ({\n      ...current,\n      ingredients: current.ingredients.map((item, i) => (i === index ? value : item)),\n    }));\n    setErrors((current) => {\n      if (!current.ingredients) return current;\n      const next = { ...current };\n      delete next.ingredients;\n      return next;\n    });\n  }\n\n  function addIngredient() {\n    setForm((current) => ({ ...current, ingredients: [...current.ingredients, \"\"] }));\n  }\n\n  function removeIngredient(index: number) {\n    setForm((current) => ({\n      ...current,\n      ingredients:\n        current.ingredients.length > 1\n          ? current.ingredients.filter((_, i) => i !== index)\n          : [\"\"],\n    }));\n  }\n\n  async function handleSubmit(event: React.FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setErrors({});\n    setGeneral(\"\");\n    const payload = {\n      title: form.title,\n      ingredients: form.ingredients,\n      instructions: form.instructions,\n      category: form.category,\n      prep_minutes: Number(form.prep_minutes),\n      servings: Number(form.servings),\n    };\n    try {\n      const saved =\n        recipeId === null\n          ? await api.createRecipe(payload)\n          : await api.updateRecipe(recipeId, payload);\n      onSaved(saved.id);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.errors);\n        setGeneral(err.message);\n        if (err.status === 401) setGeneral(\"Your session has expired. Please sign in again.\");\n      } else {\n        setGeneral(\"Something went wrong. Please try again.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  if (loading) return <Spinner label=\"Loading form…\" />;\n\n  if (loadError) {\n    return (\n      <div className=\"mx-auto max-w-2xl space-y-4 py-10\">\n        <Banner>{loadError}</Banner>\n        <button type=\"button\" className={secondaryBtn} onClick={onCancel}>\n          ← Back to recipes\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <section className=\"mx-auto max-w-2xl\">\n      <button\n        type=\"button\"\n        onClick={onCancel}\n        className=\"mb-5 text-sm font-semibold text-amber-700 hover:underline\"\n      >\n        ← Back to recipes\n      </button>\n      <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8\">\n        <h1 className=\"text-2xl font-bold text-stone-900\">\n          {isEdit ? \"Edit recipe\" : \"Add a recipe\"}\n        </h1>\n        <p className=\"mt-1 text-sm text-stone-500\">\n          {isEdit\n            ? \"Update the details below and save your changes.\"\n            : \"Share something delicious with everyone.\"}\n        </p>\n\n        <form onSubmit={handleSubmit} className=\"mt-6 space-y-5\" noValidate>\n          {general && <Banner>{general}</Banner>}\n\n          <div>\n            <label className={labelClass} htmlFor=\"title\">\n              Title\n            </label>\n            <input\n              id=\"title\"\n              className={inputClass}\n              value={form.title}\n              onChange={(event) => update(\"title\", event.target.value)}\n              placeholder=\"e.g. Grandma's apple pie\"\n            />\n            <FieldError message={errors.title} />\n          </div>\n\n          <div className=\"grid gap-4 sm:grid-cols-2\">\n            <div>\n              <label className={labelClass} htmlFor=\"category\">\n                Category\n              </label>\n              <input\n                id=\"category\"\n                className={inputClass}\n                list=\"category-options\"\n                value={form.category}\n                onChange={(event) => update(\"category\", event.target.value)}\n                placeholder=\"e.g. Dessert\"\n              />\n              <datalist id=\"category-options\">\n                {categories.map((name) => (\n                  <option key={name} value={name} />\n                ))}\n              </datalist>\n              <FieldError message={errors.category} />\n            </div>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className={labelClass} htmlFor=\"prep_minutes\">\n                  Prep (min)\n                </label>\n                <input\n                  id=\"prep_minutes\"\n                  type=\"number\"\n                  min=\"0\"\n                  step=\"1\"\n                  className={inputClass}\n                  value={form.prep_minutes}\n                  onChange={(event) => update(\"prep_minutes\", event.target.value)}\n                />\n                <FieldError message={errors.prep_minutes} />\n              </div>\n              <div>\n                <label className={labelClass} htmlFor=\"servings\">\n                  Servings\n                </label>\n                <input\n                  id=\"servings\"\n                  type=\"number\"\n                  min=\"0\"\n                  step=\"1\"\n                  className={inputClass}\n                  value={form.servings}\n                  onChange={(event) => update(\"servings\", event.target.value)}\n                />\n                <FieldError message={errors.servings} />\n              </div>\n            </div>\n          </div>\n\n          <div>\n            <div className=\"mb-1.5 flex items-center justify-between\">\n              <span className={labelClass + \" mb-0\"}>Ingredients</span>\n              <button\n                type=\"button\"\n                onClick={addIngredient}\n                className=\"text-sm font-semibold text-amber-700 hover:underline\"\n              >\n                + Add ingredient\n              </button>\n            </div>\n            <p className=\"mb-2 text-xs text-stone-400\">\n              Ingredients are kept in the order you enter them.\n            </p>\n            <div className=\"space-y-2\">\n              {form.ingredients.map((ingredient, index) => (\n                <div key={index} className=\"flex items-center gap-2\">\n                  <span className=\"w-6 shrink-0 text-center text-xs font-semibold text-stone-400\">\n                    {index + 1}\n                  </span>\n                  <input\n                    className={inputClass}\n                    value={ingredient}\n                    onChange={(event) => setIngredient(index, event.target.value)}\n                    placeholder={`Ingredient ${index + 1}`}\n                    aria-label={`Ingredient ${index + 1}`}\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => removeIngredient(index)}\n                    aria-label={`Remove ingredient ${index + 1}`}\n                    className=\"shrink-0 rounded-lg border border-stone-200 px-2.5 py-2 text-sm font-bold text-stone-500 transition hover:border-red-300 hover:bg-red-50 hover:text-red-700\"\n                  >\n                    ×\n                  </button>\n                </div>\n              ))}\n            </div>\n            <FieldError message={errors.ingredients} />\n          </div>\n\n          <div>\n            <label className={labelClass} htmlFor=\"instructions\">\n              Instructions\n            </label>\n            <textarea\n              id=\"instructions\"\n              rows={7}\n              className={`${inputClass} resize-y leading-relaxed`}\n              value={form.instructions}\n              onChange={(event) => update(\"instructions\", event.target.value)}\n              placeholder={\"One step per line.\\nLine breaks are preserved.\"}\n            />\n            <p className=\"mt-1 text-xs text-stone-400\">Line breaks will be kept.</p>\n            <FieldError message={errors.instructions} />\n          </div>\n\n          <div className=\"flex flex-wrap justify-end gap-2 border-t border-stone-100 pt-5\">\n            <button type=\"button\" className={secondaryBtn} onClick={onCancel} disabled={busy}>\n              Cancel\n            </button>\n            <button type=\"submit\" className={primaryBtn} disabled={busy}>\n              {busy ? \"Saving…\" : isEdit ? \"Save changes\" : \"Add recipe\"}\n            </button>\n          </div>\n        </form>\n      </div>\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/RecipeForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/RecipeForm.tsx","exists":false,"truncated":false},"title":"frontend/src/RecipeForm.tsx","time":{"start":1794321526377,"end":1794321526391}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e5ae65001F66qdHbpq8bQ4B","sessionID":"ses_e3a24f8a8ffewDaFyhVRsmWlM5","messageID":"msg_1c5e56672001Lv3UVJ9qspzqeq"}}
