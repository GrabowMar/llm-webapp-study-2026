nn is not None:\n        conn.close()\n\n\ndef api_error(message: str, status: int, errors: dict | None = None):\n    payload = {\"message\": message, \"error\": message}\n    if errors:\n        payload[\"errors\"] = errors\n    return jsonify(payload), status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_exception(exc: HTTPException):\n    if request.path.startswith(\"/api\"):\n        return api_error(exc.description or exc.name, exc.code or 500)\n    return exc\n\n\n@app.after_request\ndef add_cors(response):\n    response.headers[\"Access-Control-Allow-Origin\"] = \"*\"\n    response.headers[\"Access-Control-Allow-Headers\"] = \"Authorization, Content-Type\"\n    response.headers[\"Access-Control-Allow-Methods\"] = \"GET, POST, PUT, DELETE, OPTIONS\"\n    return response\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"OPTIONS\"])\n@app.route(\"/api/health\", methods=[\"OPTIONS\"])\ndef api_options(_path: str = \"\"):\n    return \"\", 204\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split()\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    return get_db().execute(\n        \"\"\"SELECT u.id, u.username FROM tokens t\n           JOIN users u ON u.id = t.user_id WHERE t.token = ?\"\"\",\n        (parts[1],),\n    ).fetchone()\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    get_db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, _now()),\n    )\n    get_db().commit()\n    return token\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return api_error(\"A JSON body with username and password is required.\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\