{"type":"tool_use","timestamp":1794344993627,"sessionID":"ses_e38c37ee5ffe8pSYjeWr4ASxi7","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-9dc4af23b52d2963","state":{"status":"completed","input":{"content":"import { ApiError } from \"./api\";\nimport type { FieldErrors } from \"./types\";\n\nexport function formatDate(value: string | null): string {\n  if (!value) return \"—\";\n  const d = new Date(value);\n  if (isNaN(d.getTime())) return value;\n  return d.toLocaleDateString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n  });\n}\n\nexport function formatDateTime(value: string | null): string {\n  if (!value) return \"—\";\n  const d = new Date(value);\n  if (isNaN(d.getTime())) return value;\n  return d.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n  });\n}\n\nexport function errorParts(err: unknown): {\n  message: string;\n  errors: FieldErrors;\n} {\n  if (err instanceof ApiError) {\n    return { message: err.message, errors: err.errors };\n  }\n  return { message: \"Something went wrong. Please try again.\", errors: {} };\n}\n","filePath":"/workspace/frontend/src/utils.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/utils.ts","exists":false,"truncated":false},"title":"frontend/src/utils.ts","time":{"start":1794344993563,"end":1794344993575}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c74bc313001kOyGVYSEMs9Md1","sessionID":"ses_e38c37ee5ffe8pSYjeWr4ASxi7","messageID":"msg_1c74bae42001iq2J697sExVJ2v"}}
