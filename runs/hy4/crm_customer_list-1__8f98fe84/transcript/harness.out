{"type":"tool_use","timestamp":1794344988232,"sessionID":"ses_e38c37ee5ffe8pSYjeWr4ASxi7","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8ea6e325996db7b4","state":{"status":"completed","input":{"content":"export type FieldErrors = { [field: string]: string };\n\nexport interface ApiErrorShape {\n  message: string;\n  errors?: FieldErrors;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  errors: FieldErrors;\n\n  constructor(status: number, body: ApiErrorShape) {\n    super(body?.message || `Request failed (${status})`);\n    this.status = status;\n    this.errors = body?.errors || {};\n  }\n}\n\nlet token: string | null = localStorage.getItem(\"directory_token\");\n\nexport function getToken(): string | null {\n  return token;\n}\n\nexport function setToken(value: string | null): void {\n  token = value;\n  if (value) localStorage.setItem(\"directory_token\", value);\n  else localStorage.removeItem(\"directory_token\");\n}\n\ninterface RequestOptions {\n  method?: string;\n  body?: unknown;\n  auth?: boolean;\n}\n\nasync function api<T>(\n  path: string,\n  { method = \"GET\", body, auth = true }: RequestOptions = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (auth && token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  let response: Response;\n  try {\n    response = await fetch(path, {\n      method,\n      headers,\n      body: body !== undefined ? JSON.stringify(body) : undefined,\n    });\n  } catch {\n    throw new ApiError(0, { message: \"Cannot reach the server. Please try again.\" });\n  }\n\n  let payload: unknown = null;\n  const text = await response.text();\n  if (text) {\n    try {\n      payload = JSON.parse(text);\n    } catch {\n      payload = null;\n    }\n  }\n\n  if (!response.ok) {\n    const shape: ApiErrorShape =\n      payload && typeof payload === \"object\"\n        ? (payload as ApiErrorShape)\n        : { message: `Request failed (${response.status})` };\n    throw new ApiError(response.status, shape);\n  }\n  return payload as T;\n}\n\nexport async function register(\n  username: string,\n  password: string,\n): Promise<{ token: string }> {\n  return api<{ token: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: { username, password },\n    auth: false,\n  });\n}\n\nexport async function login(\n  username: string,\n  password: string,\n): Promise<{ token: string }> {\n  return api<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: { username, password },\n    auth: false,\n  });\n}\n\nexport async function listCustomers(params: {\n  q?: string;\n  company?: string;\n  page?: number;\n  page_size?: number;\n}): Promise<CustomerListResponse> {\n  const query = new URLSearchParams();\n  if (params.q) query.set(\"q\", params.q);\n  if (params.company) query.set(\"company\", params.company);\n  if (params.page) query.set(\"page\", String(params.page));\n  if (params.page_size) query.set(\"page_size\", String(params.page_size));\n  const suffix = query.toString() ? `?${query}` : \"\";\n  return api<CustomerListResponse>(`/api/customers${suffix}`);\n}\n\nexport function getCustomer(id: number): Promise<Customer> {\n  return api<Customer>(`/api/customers/${id}`);\n}\n\nexport function createCustomer(input: CustomerInput): Promise<Customer> {\n  return api<Customer>(\"/api/customers\", { method: \"POST\", body: input });\n}\n\nexport function updateCustomer(\n  id: number,\n  input: CustomerInput,\n): Promise<Customer> {\n  return api<Customer>(`/api/customers/${id}`, { method: \"PUT\", body: input });\n}\n\nexport function deleteCustomer(id: number): Promise<unknown> {\n  return api<unknown>(`/api/customers/${id}`, { method: \"DELETE\" });\n}\n\nexport function listInteractions(\n  id: number,\n): Promise<InteractionListResponse> {\n  return api<InteractionListResponse>(`/api/customers/${id}/interactions`);\n}\n\nexport function createInteraction(\n  id: number,\n  input: InteractionInput,\n): Promise<Interaction> {\n  return api<Interaction>(`/api/customers/${id}/interactions`, {\n    method: \"POST\",\n    body: input,\n  });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794344988204,"end":1794344988212}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c74bae27001OJHqgkl7V5kvAI","sessionID":"ses_e38c37ee5ffe8pSYjeWr4ASxi7","messageID":"msg_1c74b8a45001zLdtyKTY6VTzv3"}}
