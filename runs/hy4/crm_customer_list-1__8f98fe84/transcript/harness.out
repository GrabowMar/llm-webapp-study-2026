{"type":"tool_use","timestamp":1794345065593,"sessionID":"ses_e38c37ee5ffe8pSYjeWr4ASxi7","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a4ddef0fd332a615","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport * as api from \"./api\";\nimport {\n  Button,\n  ErrorBanner,\n  Field,\n  Spinner,\n  TextArea,\n  TextInput,\n} from \"./components\";\nimport CustomerForm from \"./CustomerForm\";\nimport type {\n  Customer,\n  FieldErrors,\n  Interaction,\n  InteractionListResponse,\n} from \"./types\";\nimport { errorParts, formatDate, formatDateTime } from \"./utils\";\n\nconst kindStyles: Record<string, string> = {\n  call: \"bg-sky-100 text-sky-700\",\n  email: \"bg-amber-100 text-amber-700\",\n  meeting: \"bg-violet-100 text-violet-700\",\n};\n\nfunction KindBadge({ kind }: { kind: string }) {\n  const style = kindStyles[kind] || \"bg-slate-100 text-slate-700\";\n  return (\n    <span\n      className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${style}`}\n    >\n      {kind}\n    </span>\n  );\n}\n\nexport default function CustomerDetail({\n  id,\n  onBack,\n  onDeleted,\n}: {\n  id: number;\n  onBack: () => void;\n  onDeleted: () => void;\n}) {\n  const [customer, setCustomer] = useState<Customer | null>(null);\n  const [interactions, setInteractions] = useState<Interaction[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [message, setMessage] = useState(\"\");\n  const [editing, setEditing] = useState(false);\n  const [confirmDelete, setConfirmDelete] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const [kind, setKind] = useState(\"call\");\n  const [summary, setSummary] = useState(\"\");\n  const [occurredAt, setOccurredAt] = useState(\"\");\n  const [logErrors, setLogErrors] = useState<FieldErrors>({});\n  const [logMessage, setLogMessage] = useState(\"\");\n  const [logBusy, setLogBusy] = useState(false);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    setMessage(\"\");\n    try {\n      const [c, i] = await Promise.all([\n        api.getCustomer(id),\n        api.listInteractions(id),\n      ]);\n      setCustomer(c);\n      setInteractions((i as InteractionListResponse).items);\n    } catch (err) {\n      setMessage(errorParts(err).message);\n    } finally {\n      setLoading(false);\n    }\n  }, [id]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function remove() {\n    setBusy(true);\n    setMessage(\"\");\n    try {\n      await api.deleteCustomer(id);\n      onDeleted();\n    } catch (err) {\n      setMessage(errorParts(err).message);\n      setBusy(false);\n    }\n  }\n\n  async function logInteraction(e: React.FormEvent) {\n    e.preventDefault();\n    setLogBusy(true);\n    setLogMessage(\"\");\n    setLogErrors({});\n    try {\n      await api.createInteraction(id, {\n        kind,\n        summary,\n        occurred_at: occurredAt || undefined,\n      });\n      setSummary(\"\");\n      setOccurredAt(\"\");\n      setKind(\"call\");\n      await load();\n    } catch (err) {\n      const parts = errorParts(err);\n      setLogMessage(parts.message);\n      setLogErrors(parts.errors);\n    } finally {\n      setLogBusy(false);\n    }\n  }\n\n  if (loading && !customer) {\n    return (\n      <div>\n        <ErrorBanner message={message} />\n        <Spinner />\n      </div>\n    );\n  }\n\n  if (!customer) {\n    return (\n      <div>\n        <ErrorBanner message={message} />\n        <Button variant=\"secondary\" onClick={onBack}>\n          ← Back to customers\n        </Button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <button\n        onClick={onBack}\n        className=\"text-sm font-medium text-indigo-600 hover:underline\"\n      >\n        ← Back to customers\n      </button>\n\n      <ErrorBanner message={message} />\n\n      <div className=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\">\n        <div className=\"flex flex-wrap items-start justify-between gap-4\">\n          <div>\n            <h1 className=\"text-2xl font-bold text-slate-900\">\n              {customer.name}\n            </h1>\n            <p className=\"mt-1 text-sm text-slate-500\">{customer.company || \"—\"}</p>\n          </div>\n          <div className=\"flex gap-2\">\n            <Button variant=\"secondary\" onClick={() => setEditing((v) => !v)}>\n              {editing ? \"Close editor\" : \"Edit\"}\n            </Button>\n            <Button\n              variant=\"danger\"\n              onClick={() => setConfirmDelete((v) => !v)}\n            >\n              Delete\n            </Button>\n          </div>\n        </div>\n\n        {confirmDelete && (\n          <div className=\"mt-4 flex flex-wrap items-center gap-3 rounded-lg border border-red-200 bg-red-50 p-4\">\n            <span className=\"text-sm text-red-700\">\n              Delete {customer.name} and all their interactions? This cannot be\n              undone.\n            </span>\n            <div className=\"ml-auto flex gap-2\">\n              <Button\n                variant=\"secondary\"\n                onClick={() => setConfirmDelete(false)}\n              >\n                Cancel\n              </Button>\n              <Button variant=\"danger\" disabled={busy} onClick={remove}>\n                {busy ? \"Deleting…\" : \"Yes, delete\"}\n              </Button>\n            </div>\n          </div>\n        )}\n\n        {editing ? (\n          <div className=\"mt-6 border-t border-slate-100 pt-6\">\n            <CustomerForm\n              customer={customer}\n              onSaved={() => {\n                setEditing(false);\n                load();\n              }}\n              onCancel={() => setEditing(false)}\n            />\n          </div>\n        ) : (\n          <dl className=\"mt-6 grid gap-4 border-t border-slate-100 pt-6 sm:grid-cols-2\">\n            <div>\n              <dt className=\"text-xs font-semibold uppercase tracking-wide text-slate-400\">\n                Email\n              </dt>\n              <dd className=\"mt-1 text-sm text-slate-800\">\n                {customer.email}\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-xs font-semibold uppercase tracking-wide text-slate-400\">\n                Phone\n              </dt>\n              <dd className=\"mt-1 text-sm text-slate-800\">\n                {customer.phone || \"—\"}\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-xs font-semibold uppercase tracking-wide text-slate-400\">\n                Last contacted\n              </dt>\n              <dd className=\"mt-1 text-sm text-slate-800\">\n                {formatDate(customer.last_contacted_at)}\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-xs font-semibold uppercase tracking-wide text-slate-400\">\n                Added\n              </dt>\n              <dd className=\"mt-1 text-sm text-slate-800\">\n                {formatDate(customer.created_at)}\n              </dd>\n            </div>\n            <div className=\"sm:col-span-2\">\n              <dt className=\"text-xs font-semibold uppercase tracking-wide text-slate-400\">\n                Notes\n              </dt>\n              <dd className=\"mt-1 whitespace-pre-wrap text-sm text-slate-800\">\n                {customer.notes || \"—\"}\n              </dd>\n            </div>\n          </dl>\n        )}\n      </div>\n\n      <div className=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\">\n        <h2 className=\"text-lg font-semibold text-slate-900\">\n          Interactions\n          <span className=\"ml-2 text-sm font-normal text-slate-400\">\n            ({customer.interaction_count})\n          </span>\n        </h2>\n\n        {interactions.length === 0 ? (\n          <p className=\"mt-4 text-sm text-slate-500\">\n            No interactions logged yet.\n          </p>\n        ) : (\n          <ul className=\"mt-4 divide-y divide-slate-100\">\n            {interactions.map((i) => (\n              <li key={i.id} className=\"flex flex-wrap gap-3 py-4\">\n                <div className=\"pt-0.5\">\n                  <KindBadge kind={i.kind} />\n                </div>\n                <div className=\"min-w-[200px] flex-1\">\n                  <p className=\"text-sm font-medium text-slate-800\">\n                    {i.summary || \"No summary\"}\n                  </p>\n                  <p className=\"mt-1 text-xs text-slate-500\">\n                    {formatDateTime(i.occurred_at)} · logged by{\" \"}\n                    <span className=\"font-medium text-slate-700\">\n                      {i.logged_by}\n                    </span>\n                  </p>\n                </div>\n              </li>\n            ))}\n          </ul>\n        )}\n\n        <form\n          onSubmit={logInteraction}\n          className=\"mt-6 grid gap-4 border-t border-slate-100 pt-6 sm:grid-cols-2\"\n        >\n          <h3 className=\"sm:col-span-2 text-sm font-semibold text-slate-700\">\n            Log a new interaction\n          </h3>\n          <div className=\"sm:col-span-2\">\n            <ErrorBanner message={logMessage} />\n          </div>\n          <Field label=\"Kind\" name=\"kind\" errors={logErrors}>\n            <select\n              id=\"kind\"\n              value={kind}\n              onChange={(e) => setKind(e.target.value)}\n              className=\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\"\n            >\n              <option value=\"call\">Call</option>\n              <option value=\"email\">Email</option>\n              <option value=\"meeting\">Meeting</option>\n            </select>\n          </Field>\n          <Field label=\"Date & time\" name=\"occurred_at\" errors={logErrors}>\n            <TextInput\n              id=\"occurred_at\"\n              type=\"datetime-local\"\n              value={occurredAt}\n              onChange={(e) => setOccurredAt(e.target.value)}\n              invalid={!!logErrors.occurred_at}\n            />\n          </Field>\n          <div className=\"sm:col-span-2\">\n            <Field label=\"Summary\" name=\"summary\" errors={logErrors}>\n              <TextArea\n                id=\"summary\"\n                rows={2}\n                value={summary}\n                onChange={(e) => setSummary(e.target.value)}\n                invalid={!!logErrors.summary}\n                placeholder=\"What happened?\"\n              />\n            </Field>\n          </div>\n          <div className=\"sm:col-span-2 flex justify-end\">\n            <Button type=\"submit\" disabled={logBusy}>\n              {logBusy ? \"Logging…\" : \"Log interaction\"}\n            </Button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/CustomerDetail.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/CustomerDetail.tsx","exists":false,"truncated":false},"title":"frontend/src/CustomerDetail.tsx","time":{"start":1794345065563,"end":1794345065574}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c74cdc56001844tjrpopjUO2v","sessionID":"ses_e38c37ee5ffe8pSYjeWr4ASxi7","messageID":"msg_1c74c9390001Rh6g73IIvpNPMC"}}
