EATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token_hash TEXT PRIMARY KEY,\n                username TEXT NOT NULL COLLATE NOCASE,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                admin_key TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS posts (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                title TEXT NOT NULL,\n                content TEXT NOT NULL,","lineStart":60,"lineEnd":104,"totalLines":538,"truncated":true}},"title":"backend/app.py","time":{"start":1794368950587,"end":1794368950605}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b9513400139SqEvZhCZxJXC","sessionID":"ses_e375be557ffeoNs5nHG0c9mm2j","messageID":"msg_1c8b85c4e001d7hG6m7k4rWQfF"}}
