thod=\"GET\", body=None):\n    req = urllib.request.Request(\"http://127.0.0.1:8011\" + path, method=method)\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    with urllib.request.urlopen(req, data=data, timeout=5) as r:\n        return r.status, r.headers.get_content_type(), r.read()\n\nstatus, _, raw = get(\"/api/health\")\nprint(\"health:\", status, raw.decode())\nstatus, ctype, raw = get(\"/\")\nprint(\"index:\", status, ctype, b\"Inkwell\" in raw)\nimport re\nassets = re.findall(rb'/assets/[^\"]+', raw)\nprint(\"assets referenced:\", [a.decode() for a in assets])\nfor a in assets:\n    status, ctype, raw = get(a.decode())\n    print(\"asset:\", status, ctype, len(raw), \"bytes\")\nstatus, _, raw = get(\"/api/posts\")\nprint(\"api list:\", status, json.loads(raw)[\"total\"])\nstatus, _, raw = get(\"/posts/1\")\nprint(\"SPA fallback for /posts/1:\", status, b\"Inkwell\" in raw)\nstatus, _, raw = get(\"/api/nonexistent\")\nprint(\"api 404:\", status, raw.decode())\nserver.shutdown()\nPY","time":{"start":1794368887011,"end":1794368887868}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b858db0015FzvFp2nsjwPR6","sessionID":"ses_e375be557ffeoNs5nHG0c9mm2j","messageID":"msg_1c8b83a3300127bddtYZGa0Cfj"}}
