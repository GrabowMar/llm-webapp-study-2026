lth', c.get('/api/health').json)\nprint('encode', c.post('/api/base64/encode', json={'text':'héllo 🌍'}).json)\nprint('encode empty', c.post('/api/base64/encode', json={'text':''}).json)\nenc = c.post('/api/base64/encode', json={'text':'héllo 🌍'}).json['encoded']\nprint('decode', c.post('/api/base64/decode', json={'encoded':enc}).json)\nprint('bad decode', c.post('/api/base64/decode', json={'encoded':'!!!'}).status_code, c.post('/api/base64/decode', json={'encoded':'!!!'}).json)\nprint('register', c.post('/api/auth/register', json={'username':'alice','password':'pw'}).status_code)\nprint('dup', c.post('/api/auth/register', json={'username':'alice','password':'pw'}).status_code)\ntok = c.post('/api/auth/login', json={'username':'alice','password':'pw'}).json['token']\nprint('bad login', c.post('/api/auth/login', json={'username':'alice','password':'x'}).status_code)\nh = {'Authorization':'Bearer '+tok}\nprint('noauth list', c.get('/api/conversions').status_code)\nr = c.post('/api/conversions', headers=h, json={'direction':'encode','input':'hello world'})\nprint('create', r.status_code, r.json)\nprint('create decode', c.post('/api/conversions', headers=h, json={'direction':'decode','input':enc}).status_code)\nprint('list', c.get('/api/conversions?page=1&page_size=1').get_json())\nprint('list headers', json.dumps(c.get('/api/conversions', headers=h).get_json(), ensure_ascii=False))\nprint('del', c.delete('/api/conversions/'+str(r.json['id']), headers=h).status_code)\nprint('del again', c.delete('/api/conversions/'+str(r.json['id']), headers=h).status_code)\n\"","time":{"start":1794359371968,"end":1794359372632}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c82728b8001m2mqL5Tkk14VpF","sessionID":"ses_e37ddf413ffevYpMDlGQN6cfWY","messageID":"msg_1c8270e46001021ZoJ551WnkUc"}}
