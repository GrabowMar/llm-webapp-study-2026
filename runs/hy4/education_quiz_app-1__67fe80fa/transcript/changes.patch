+def error(message: str, status: int = 400, errors=None):
+    payload = {"message": message}
+    if errors is not None:
+        payload["errors"] = errors
+    return jsonify(payload), status
+
+
+def json_body():
+    return request.get_json(force=True, silent=True)
+
+
+def clean_text(value, max_length: int):
+    if not isinstance(value, str):
+        return None
+    value = value.strip()
+    if not value or len(value) > max_length:
+        return None
+    return value
+
+
+def current_user():
+    header = request.headers.get("Authorization", "")
+    if not header.startswith("Bearer "):
+        return None
+    token = header[7:].strip()
+    if not token:
+        return None
+    return get_db().execute(
+        "SELECT u.* FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token = ?",
+        (token,),
+    ).fetchone()
+
+
+def require_auth(view):
+    @wraps(view)
+    def wrapper(*args, **kwargs):
+        user = current_user()
+        if user is None:
+            return error("Authentication required.", 401)
+        return view(user, *args, **kwargs)
+
+    return wrapper
+
+
+def require_admin(view):
+    @wraps(view)
+    def wrapper(*args, **kwargs):
+        user = current_user()
+        if user is None:
+            return error("Authentication required.", 401)
+        if not user["is_admin"] or not ADMIN_ENABLED:
+            return error("Administrator access required.", 403)
+        return view(user, *args, **kwargs)
+
+    return wrapper
+
+
+def issue_token(user_id: int) -> str:
+    token = secrets.token_urlsafe(32)
+    get_db().execute(
+        "INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)",
+        (token, user_id, now_iso()),
+    )
+    get_db().commit()
+    return token
+
+
+def user_json(row):
+    return {"id": row["id"], "username": row["username"], "is_admin": bool(row["is_admin"])}
+
+
+def question_json(row):
+    return {
+        "id": row["id"],
+        "text": row["text"],
+        "option_a": row["option_a"],
+        "option_b": row["option_b"],
+        "option_c": row["option_c"],
+        "option_d": row["option_d"],
+        "correct_option": row["correct_option"],
+    }
+
+
+def review_item(question, selected):
+    return {
+        "question_id": question["id"],
+        "text": question["text"],
+        "option_a": question["option_a"],
+        "option_b": question["option_b"],
+        "option_c": question["option_c"],
+        "option_d": question["option_d"],
+        "correct_option": question["correct_option"],
+        "selected": selected,
+        "is_correct": selected == question["correct_option"],
+    }
+
+
+def attempt_json(conn, row):
+    answers = conn.execute(
+        "SELECT * FROM attempt_answers WHERE attempt_id = ? ORDER BY id ASC",
+        (row["id"],),
+    ).fetchall()
+    return {
+        "id": row["id"],
+        "score": row["score"],
+        "correct": row["correct"],
+        "total_questions": row["total_questions"],
+        "submitted_at": row["submitted_at"],
+        "answers": [
+            {
+                "question_id": answer["question_id"],
+                "text": answer["text"],
+                "option_a": answer["option_a"],
+                "option_b": answer["option_b"],
+                "option_c": answer["option_c"],
+                "option_d": answer["option_d"],
+                "correct_option": answer["correct_option"],
+                "selected": answer["selected"],
+                "is_correct": bool(answer["is_correct"]),
+            }
+            for answer in answers
+        ],
+    }
+
+
+def positive_int(value, default: int, maximum: int = 100):
+    if value is None or value == "":
+        return default
+    try:
+        parsed = int(value)
+    except (TypeError, ValueError):
+        return None
+    if parsed < 1:
+        return None
+    return min(parsed, maximum)
+
 
