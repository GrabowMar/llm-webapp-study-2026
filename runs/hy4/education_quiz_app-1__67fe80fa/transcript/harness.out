{"type":"tool_use","timestamp":1794303782790,"sessionID":"ses_e3b315188ffeAbvt7HKYTj4uhs","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a0e30719583b9d99","state":{"status":"completed","input":{"content":"export type Option = \"A\" | \"B\" | \"C\" | \"D\";\n\nexport interface QuizQuestion {\n  id: number;\n  text: string;\n  option_a: string;\n  option_b: string;\n  option_c: string;\n  option_d: string;\n}\n\nexport interface Question extends QuizQuestion {\n  correct_option: Option;\n}\n\nexport interface ReviewAnswer extends Question {\n  question_id: number;\n  selected: Option | null;\n  is_correct: boolean;\n}\n\nexport interface Attempt {\n  id: number;\n  score: number;\n  correct: number;\n  total_questions: number;\n  submitted_at: string;\n  answers: ReviewAnswer[];\n}\n\nexport interface Me {\n  id: number;\n  username: string;\n  is_admin: boolean;\n}\n\nexport interface ApiError {\n  message: string;\n  errors?: Record<string, string>;\n}\n\nconst TOKEN_KEY = \"quiz.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null): void {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(path: string, init: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = { ...(init.headers as Record<string, string>) };\n  if (init.body) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const response = await fetch(path, { ...init, headers });\n  let data: unknown = null;\n  try {\n    data = await response.json();\n  } catch {\n    // non-JSON response\n  }\n  if (!response.ok) {\n    const err: ApiError =\n      data && typeof data === \"object\"\n        ? (data as ApiError)\n        : { message: `Request failed (${response.status})` };\n    throw err;\n  }\n  return data as T;\n}\n\nexport function errorMessage(err: unknown): string {\n  if (typeof err === \"object\" && err !== null && \"message\" in err) {\n    return String((err as ApiError).message);\n  }\n  return \"Something went wrong. Please try again.\";\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<Me & { token: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  me: () => request<Me>(\"/api/auth/me\"),\n  quiz: (count: number) => request<{ items: QuizQuestion[] }>(`/api/quiz?count=${count}`),\n  submit: (answers: { question_id: number; selected: Option | null }[]) =>\n    request<Attempt>(\"/api/attempts\", {\n      method: \"POST\",\n      body: JSON.stringify({ answers }),\n    }),\n  attempts: () => request<{ items: Attempt[] }>(\"/api/attempts\"),\n  attempt: (id: number) => request<Attempt>(`/api/attempts/${id}`),\n  addQuestion: (question: {\n    text: string;\n    option_a: string;\n    option_b: string;\n    option_c: string;\n    option_d: string;\n    correct_option: Option;\n  }) =>\n    request<Question>(\"/api/admin/questions\", {\n      method: \"POST\",\n      body: JSON.stringify(question),\n    }),\n  questions: (page: number, pageSize: number) =>\n    request<{ items: Question[]; total: number; page: number; page_size: number }>(\n      `/api/admin/questions?page=${page}&page_size=${pageSize}`,\n    ),\n};\n\nexport const optionLabels: Option[] = [\"A\", \"B\", \"C\", \"D\"];\n\nexport function optionText(question: QuizQuestion, option: Option): string {\n  return question[\n    ({ A: \"option_a\", B: \"option_b\", C: \"option_c\", D: \"option_d\" } as const)[option]\n  ];\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794303782750,"end":1794303782760}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4d6ef55001XRt60nVa9AGuv9","sessionID":"ses_e3b315188ffeAbvt7HKYTj4uhs","messageID":"msg_1c4d6c9c9001P5I5hlpuUcHnF4"}}
