;\n  }\n\n  function signOut() {\n    clearSession();\n    setUsername(null);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"  useEffect(() => {\n    const target =\n      view.kind === \"detail\" ? `#/items/${view.id}` : \"\";\n    if (window.location.hash !== target) {\n      if (target) window.location.hash = target;\n      else if (window.location.hash) history.replaceState(null, \"\", \" \");\n    }\n  }, [view]);\n\n  function openItem(id: number) {\n    setView({ kind: \"detail\", id });\n  }\n\n  function showList() {\n    setView({ kind: \"list\" });\n  }\n\n  function signOut() {\n    clearSession();\n    setUsername(null);\n    showList();\n  }\n\n  const signedIn = username !== null;\n\n  return (\n    <div className=\"min-h-screen bg-slate-100\">      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n          <button\n            type=\"button\"\n            onClick={showList}\n            className=\"flex items-center gap-2 text-lg font-bold text-slate-900\"\n          >\n            <span className=\"rounded-md bg-indigo-600 px-2 py-1 text-sm font-bold text-white\">\n              W\n            </span>\n            Warehouse Inventory\n          </button>\n          <div className=\"flex items-center gap-3\">\n            {signedIn ? (\n              <>\n                <span className=\"text-sm text-slate-600\">\n                  Signed in as <strong className=\"text-slate-900\">{username}</strong>\n                </span>\n                <Button variant=\"secondary\" onClick={signOut}>\n                  Sign out\n                </Button>\n              </>\n            ) : (\n              <Button\n                variant={authShown ? \"ghost\" : \"secondary\"}\n                onClick={() => {\n                  setAuthError(\"\");\n                  setAuthShown(true);\n                }}\n              >\n                Sign in / Register\n              </Button>\n            )}\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-8\">\n        {authShown && !signedIn ? (\n          <AuthPanel\n            mode={authShown === true ? \"login\" : authShown}\n            onSignedIn={(name) => {\n              setUsername(name);\n              setAuthShown(false);\n              setAuthError(\"\");\n            }}\n            onSwitch={(mode) => {\n              if (mode === \"browse\") {\n                setAuthShown(false);\n                setAuthError(\"\");\n              } else {\n                setAuthShown(mode);\n              }\n            }}\n          />\n        ) : (\n          <>\n            {!signedIn && (\n              <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-800\">\n                <span>You are browsing as a guest. Anyone can read items and movements.</span>\n                <Button\n                  variant=\"secondary\"\n                  onClick={() => {\n                    setAuthError(\"\");\n                    setAuthShown(\"login\");\n                  }}\n                >\n                  Sign in to manage\n                </Button>\n              </div>\n            )}\n            <ErrorBanner message={authError} />\n\n            {view.kind === \"list\" && (\n              <InventoryList\n                signedIn={signedIn}\n                onOpen={openItem}\n                onAdd={() =>\n                  signedIn ? setView({ kind: \"add\" }) : setAuthShown(\"login\")\n                }\n              />\n            )}\n\n            {view.kind === \"detail\" && (\n              <ItemDetail\n                itemId={view.id}\n                signedIn={signedIn}\n                onBack={showList}\n                onEdit={(item) => setView({ kind: \"edit\", item })}\n                onDeleted={showList}\n              />\n            )}\n\n            {(view.kind === \"add\" || view.kind === \"edit\") && (\n              <div className=\"mx-auto max-w-2xl\">\n                <Card title={view.kind === \"add\" ? \"Add an item\" : `Edit ${view.item.name}`}>\n                  <ItemForm\n                    item={view.kind === \"edit\" ? view.item : null}\n                    onSaved={(item) => setView({ kind: \"detail\", id: item.id })}\n                    onCancel={showList}\n                  />\n                </Card>\n              </div>\n            )}\n          </>\n        )}\n      </main>\n    </div>\n  );\n}","lineStart":44,"lineEnd":179,"totalLines":179,"truncated":false}},"title":"frontend/src/App.tsx","time":{"start":1794349576765,"end":1794349576808}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c791b235001Fas9kmKN7e3FTi","sessionID":"ses_e387623c7ffecpQELB4X3arCbI","messageID":"msg_1c791a3ea0010y2gglfL3Q16CN"}}
