{"type":"tool_use","timestamp":1794349469170,"sessionID":"ses_e387623c7ffecpQELB4X3arCbI","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b6d47b92999cb05b","state":{"status":"completed","input":{"content":"export type Item = {\n  id: number;\n  name: string;\n  sku: string;\n  location: string;\n  quantity: number;\n  reorder_level: number;\n  low_stock: boolean;\n};\n\nexport type Movement = {\n  id: number;\n  item_id: number;\n  delta: number;\n  reason: string;\n  quantity_after: number;\n  created_at: string;\n  username: string;\n};\n\nexport type ItemList = {\n  items: Item[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type MovementList = { items: Movement[] };\n\nexport type ApiErrors = Record<string, string>;\n\nexport class ApiError extends Error {\n  status: number;\n  errors: ApiErrors;\n\n  constructor(message: string, status: number, errors: ApiErrors = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nexport const TOKEN_KEY = \"warehouse_token\";\nexport const USER_KEY = \"warehouse_username\";\n\nlet token: string | null = localStorage.getItem(TOKEN_KEY);\n\nexport function getToken(): string | null {\n  return token;\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setSession(newToken: string, username: string) {\n  token = newToken;\n  localStorage.setItem(TOKEN_KEY, newToken);\n  localStorage.setItem(USER_KEY, username);\n}\n\nexport function clearSession() {\n  token = null;\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USER_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.auth && token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  let response: Response;\n  try {\n    response = await fetch(`/api${path}`, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body === undefined ? undefined : JSON.stringify(options.body),\n    });\n  } catch {\n    throw new ApiError(\"Could not reach the server. Please try again.\", 0);\n  }\n\n  if (response.status === 204) return undefined as T;\n\n  let payload: unknown = null;\n  try {\n    payload = await response.json();\n  } catch {\n    payload = null;\n  }\n\n  if (!response.ok) {\n    const data = payload as { error?: string; errors?: ApiErrors } | null;\n    throw new ApiError(\n      data?.error ?? `Request failed (${response.status}).`,\n      response.status,\n      data?.errors ?? {},\n    );\n  }\n  return payload as T;\n}\n\nexport const api = {\n  async register(username: string, password: string): Promise<void> {\n    await request(\"/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n    });\n  },\n  async login(username: string, password: string): Promise<string> {\n    const result = await request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n    });\n    return result.token;\n  },\n  async me(): Promise<{ username: string }> {\n    return request(\"/auth/me\", { auth: true });\n  },\n  async listItems(params: {\n    q?: string;\n    location?: string;\n    low_stock?: boolean;\n    page?: number;\n    page_size?: number;\n  }): Promise<ItemList> {\n    const query = new URLSearchParams();\n    if (params.q) query.set(\"q\", params.q);\n    if (params.location) query.set(\"location\", params.location);\n    if (params.low_stock) query.set(\"low_stock\", \"true\");\n    query.set(\"page\", String(params.page ?? 1));\n    query.set(\"page_size\", String(params.page_size ?? 10));\n    return request(`/items?${query.toString()}`);\n  },\n  async getItem(id: number): Promise<Item> {\n    return request(`/items/${id}`);\n  },\n  async createItem(data: {\n    name: string;\n    sku: string;\n    location: string;\n    quantity: number;\n    reorder_level: number;\n  }): Promise<Item> {\n    return request(\"/items\", { method: \"POST\", body: data, auth: true });\n  },\n  async updateItem(\n    id: number,\n    data: {\n      name: string;\n      sku: string;\n      location: string;\n      reorder_level: number;\n    },\n  ): Promise<Item> {\n    return request(`/items/${id}`, { method: \"PUT\", body: data, auth: true });\n  },\n  async deleteItem(id: number): Promise<void> {\n    return request(`/items/${id}`, { method: \"DELETE\", auth: true });\n  },\n  async listMovements(id: number): Promise<MovementList> {\n    return request(`/items/${id}/movements`);\n  },\n  async createMovement(\n    id: number,\n    data: { delta: number; reason?: string },\n  ): Promise<Movement> {\n    return request(`/items/${id}/movements`, {\n      method: \"POST\",\n      body: data,\n      auth: true,\n    });\n  },\n};\n\nexport function errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : \"Something went wrong.\";\n}\n\nexport function errorFields(error: unknown): ApiErrors {\n  return error instanceof ApiError ? error.errors : {};\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794349469141,"end":1794349469150}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7900dcf0018vfSWOcM3Ocomq","sessionID":"ses_e387623c7ffecpQELB4X3arCbI","messageID":"msg_1c78fdf6f001u3o9st6p8CzoCe"}}
