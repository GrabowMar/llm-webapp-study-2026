{"type":"tool_use","timestamp":1794349479360,"sessionID":"ses_e387623c7ffecpQELB4X3arCbI","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-af6df3b732d75ae1","state":{"status":"completed","input":{"content":"import type { FormEvent, InputHTMLAttributes, ReactNode } from \"react\";\nimport type { ApiErrors } from \"./api\";\n\nexport const inputClass =\n  \"w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 disabled:bg-slate-100\";\n\nexport function Button({\n  variant = \"primary\",\n  className = \"\",\n  ...props\n}: InputHTMLAttributes<HTMLButtonElement> & {\n  variant?: \"primary\" | \"secondary\" | \"danger\" | \"ghost\";\n}) {\n  const styles: Record<string, string> = {\n    primary:\n      \"bg-indigo-600 text-white hover:bg-indigo-700 focus:ring-indigo-300 disabled:bg-indigo-300\",\n    secondary:\n      \"border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 focus:ring-slate-200\",\n    danger:\n      \"bg-red-600 text-white hover:bg-red-700 focus:ring-red-300 disabled:bg-red-300\",\n    ghost: \"text-slate-600 hover:bg-slate-100 focus:ring-slate-200\",\n  };\n  return (\n    <button\n      {...props}\n      className={`inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium shadow-sm transition focus:outline-none focus:ring-2 disabled:cursor-not-allowed ${styles[variant]} ${className}`}\n    />\n  );\n}\n\nexport function Field({\n  label,\n  name,\n  error,\n  children,\n}: {\n  label: string;\n  name: string;\n  error?: string;\n  children?: ReactNode;\n}) {\n  return (\n    <label className=\"block\" htmlFor={name}>\n      <span className=\"mb-1 block text-sm font-medium text-slate-700\">{label}</span>\n      {children}\n      {error && <span className=\"mt-1 block text-sm text-red-600\">{error}</span>}\n    </label>\n  );\n}\n\nexport function ErrorBanner({ message }: { message: string }) {\n  if (!message) return null;\n  return (\n    <div\n      role=\"alert\"\n      className=\"rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\"\n    >\n      {message}\n    </div>\n  );\n}\n\nexport function FormErrors({\n  errors,\n  exclude = [],\n}: {\n  errors: ApiErrors;\n  exclude?: string[];\n}) {\n  const messages = Object.entries(errors).filter(\n    ([field]) => !exclude.includes(field),\n  );\n  if (messages.length === 0) return null;\n  return (\n    <div className=\"space-y-1 text-sm text-red-600\">\n      {messages.map(([field, message]) => (\n        <div key={field}>{message}</div>\n      ))}\n    </div>\n  );\n}\n\nexport function Card({\n  title,\n  children,\n  actions,\n}: {\n  title?: string;\n  children: ReactNode;\n  actions?: ReactNode;\n}) {\n  return (\n    <section className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\">\n      {(title || actions) && (\n        <div className=\"mb-4 flex items-center justify-between gap-3\">\n          {title && <h2 className=\"text-lg font-semibold text-slate-900\">{title}</h2>}\n          {actions}\n        </div>\n      )}\n      {children}\n    </section>\n  );\n}\n\nexport function Spinner() {\n  return (\n    <div className=\"flex items-center justify-center py-12 text-sm text-slate-500\">\n      <span className=\"mr-3 h-5 w-5 animate-spin rounded-full border-2 border-slate-300 border-t-indigo-600\" />\n      Loading…\n    </div>\n  );\n}\n\nexport function prevent(fn: () => void) {\n  return (event: FormEvent) => {\n    event.preventDefault();\n    fn();\n  };\n}\n","filePath":"/workspace/frontend/src/ui.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/ui.tsx","exists":false,"truncated":false},"title":"frontend/src/ui.tsx","time":{"start":1794349479348,"end":1794349479357}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c79035ae001H2hkBqGVmpqe4B","sessionID":"ses_e38762