{"type":"tool_use","timestamp":1794349490067,"sessionID":"ses_e387623c7ffecpQELB4X3arCbI","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-99716913515eb081","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { api, errorMessage, errorFields, setSession } from \"./api\";\nimport type { ApiErrors } from \"./api\";\nimport { Button, ErrorBanner, Field, FormErrors, inputClass, prevent } from \"./ui\";\n\nexport default function AuthPanel({\n  mode,\n  onSignedIn,\n  onSwitch,\n}: {\n  mode: \"login\" | \"register\";\n  onSignedIn: (username: string) => void;\n  onSwitch: (mode: \"login\" | \"register\") => void;\n}) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [errors, setErrors] = useState<ApiErrors>({});\n  const [busy, setBusy] = useState(false);\n  const [notice, setNotice] = useState(\"\");\n\n  useEffect(() => {\n    setError(\"\");\n    setErrors({});\n    setPassword(\"\");\n  }, [mode]);\n\n  async function submit() {\n    setBusy(true);\n    setError(\"\");\n    setErrors({});\n    setNotice(\"\");\n    try {\n      if (mode === \"register\") {\n        await api.register(username, password);\n        setNotice(\"Account created. Signing you in…\");\n      }\n      const token = await api.login(username, password);\n      const normalized = username.trim();\n      setSession(token, normalized);\n      onSignedIn(normalized);\n    } catch (err) {\n      setError(errorMessage(err));\n      setErrors(errorFields(err));\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const isLogin = mode === \"login\";\n\n  return (\n    <div className=\"mx-auto flex min-h-[70vh] max-w-md flex-col justify-center\">\n      <div className=\"rounded-xl border border-slate-200 bg-white p-8 shadow-sm\">\n        <h1 className=\"text-2xl font-bold text-slate-900\">Warehouse Inventory</h1>\n        <p className=\"mt-1 text-sm text-slate-500\">\n          {isLogin\n            ? \"Sign in to manage items and record stock movements.\"\n            : \"Create an account to manage inventory.\"}\n        </p>\n\n        <form onSubmit={prevent(submit)} className=\"mt-6 space-y-4\" noValidate>\n          <Field label=\"Username\" name=\"username\" error={errors.username}>\n            <input\n              id=\"username\"\n              name=\"username\"\n              autoComplete=\"username\"\n              className={inputClass}\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n            />\n          </Field>\n          <Field label=\"Password\" name=\"password\" error={errors.password}>\n            <input\n              id=\"password\"\n              name=\"password\"\n              type=\"password\"\n              autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n              className={inputClass}\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </Field>\n\n          <ErrorBanner message={error && Object.keys(errors).length === 0 ? error : \"\"} />\n          <FormErrors errors={errors} exclude={[\"username\", \"password\"]} />\n          {notice && (\n            <div className=\"rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700\">\n              {notice}\n            </div>\n          )}\n\n          <Button type=\"submit\" disabled={busy} className=\"w-full\">\n            {busy ? \"Please wait…\" : isLogin ? \"Sign in\" : \"Create account\"}\n          </Button>\n        </form>\n\n        <div className=\"mt-6 text-center text-sm text-slate-600\">\n          {isLogin ? \"Need an account?\" : \"Already have an account?\"}{\" \"}\n          <button\n            type=\"button\"\n            className=\"font-medium text-indigo-600 hover:underline\"\n            onClick={() => onSwitch(isLogin ? \"register\" : \"login\")}\n          >\n            {isLogin ? \"Register\" : \"Sign in\"}\n          </button>\n        </div>\n      </div>\n\n      <div className=\"mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600\">\n        <strong className=\"font-semibold text-slate-700\">Just browsing?</strong>{\" \"}\n        <button\n          type=\"button\"\n          className=\"font-medium text-indigo-600 hover:underline\"\n          onClick={() => onSwitch(\"browse\")}\n        >\n          View the inventory without signing in\n        </button>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/AuthPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AuthPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/AuthPanel.tsx","time":{"start":1794349490035,"end":1794349490043}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7905f6e001B7w0ylOeUZBPvG","sessionID":"ses_e387623c7ffecpQELB4X3arCbI","messageID":"msg_1c7903676001313ZQoXI9Im2as"}}
