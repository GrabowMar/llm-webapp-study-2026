+            )}
+          </div>
+        </div>
+
+        {!signedIn && (
+          <div className="mb-4 rounded-lg border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm text-indigo-800">
+            You are browsing as a guest.{" "}
+            <button
+              type="button"
+              onClick={() => setAuthMode("login")}
+              className="font-semibold underline"
