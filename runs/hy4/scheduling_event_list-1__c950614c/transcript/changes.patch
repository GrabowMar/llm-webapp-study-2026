+                  onClick={() => setMode(option)}
+                  className={`rounded-md px-3 py-1.5 text-sm font-medium capitalize transition ${
+                    mode === option
+                      ? "bg-indigo-600 text-white shadow-sm"
+                      : "text-slate-600 hover:bg-slate-100"
