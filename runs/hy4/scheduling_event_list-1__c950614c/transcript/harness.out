{"type":"tool_use","timestamp":1794352388998,"sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8d5408d975c1e7db","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  clearSession,\n  fetchEvents,\n  fetchMe,\n  getStoredUsername,\n  getToken,\n  login,\n  logout,\n  register,\n  storeSession,\n  type CalendarEvent,\n} from \"./api\";\nimport AuthForm from \"./components/AuthForm\";\nimport { DayView, MonthView, WeekView } from \"./components/CalendarViews\";\nimport EventDetails from \"./components/EventDetails\";\nimport EventForm from \"./components/EventForm\";\nimport Modal from \"./components/Modal\";\nimport {\n  dateKey,\n  eventOverlapsPeriod,\n  getPeriod,\n  periodTitle,\n  shiftPeriod,\n  type ViewMode,\n} from \"./date\";\n\nconst MODES: ViewMode[] = [\"month\", \"week\", \"day\"];\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(null);\n  const [authReady, setAuthReady] = useState(false);\n  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n  const [mode, setMode] = useState<ViewMode>(\"month\");\n  const [anchor, setAnchor] = useState(() => new Date());\n  const [events, setEvents] = useState<CalendarEvent[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [loadError, setLoadError] = useState(\"\");\n  const [selected, setSelected] = useState<CalendarEvent | null>(null);\n  const [formState, setFormState] = useState<{\n    event: CalendarEvent | null;\n    defaultStart?: Date;\n  } | null>(null);\n  const [confirmSignOut, setConfirmSignOut] = useState(false);\n  const [toast, setToast] = useState(\"\");\n\n  const loadEvents = useCallback(async () => {\n    const period = getPeriod(anchor, mode);\n    const startDate = dateKey(period.start);\n    const endDate = dateKey(period.end);\n    setLoading(true);\n    setLoadError(\"\");\n    try {\n      const result = await fetchEvents(startDate, endDate);\n      setEvents(\n        result.items.filter((item) => eventOverlapsPeriod(item, period)),\n      );\n    } catch (error) {\n      setLoadError(\n        error instanceof ApiError\n          ? error.message\n          : \"Could not load events. Please try again.\",\n      );\n    } finally {\n      setLoading(false);\n    }\n  }, [anchor, mode]);\n\n  useEffect(() => {\n    loadEvents();\n  }, [loadEvents]);\n\n  useEffect(() => {\n    const token = getToken();\n    if (!token) {\n      setAuthReady(true);\n      return;\n    }\n    fetchMe()\n      .then((result) => setUsername(result.username))\n      .catch(() => {\n        clearSession();\n        setUsername(null);\n      })\n      .finally(() => setAuthReady(true));\n  }, []);\n\n  useEffect(() => {\n    if (!toast) return;\n    const timer = window.setTimeout(() => setToast(\"\"), 3500);\n    return () => window.clearTimeout(timer);\n  }, [toast]);\n\n  const handleAuthenticated = (token: string, name: string) => {\n    storeSession(token, name);\n    setUsername(name);\n    setAuthMode(null);\n    setToast(`Welcome, ${name}!`);\n  };\n\n  const handleSignOut = async () => {\n    try {\n      await logout();\n    } catch {\n      // clearing locally is enough even if the server request fails\n    }\n    clearSession();\n    setUsername(null);\n    setConfirmSignOut(false);\n    setSelected(null);\n    setFormState(null);\n    setToast(\"Signed out.\");\n  };\n\n  const handleSaved = () => {\n    setFormState(null);\n    setSelected(null);\n    loadEvents();\n    setToast(formState?.event ? \"Event updated.\" : \"Event created.\");\n  };\n\n  const handleDeleted = () => {\n    setSelected(null);\n    loadEvents();\n    setToast(\"Event deleted.\");\n  };\n\n  if (!authReady) {\n    return (\n      <div className=\"flex min-h-screen items-center justify-center text-slate-500\">\n        Loading…\n      </div>\n    );\n  }\n\n  if (authMode && !username) {\n    return (\n      <AuthForm\n        mode={authMode}\n        submit={authMode === \"login\" ? login : register}\n        onSuccess={handleAuthenticated}\n        onSwitchMode={setAuthMode}\n        onCancel={() => setAuthMode(null)}\n      />\n    );\n  }\n\n  const period = getPeriod(anchor, mode);\n  const signedIn = username !== null;\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm\">\n              <svg\n                className=\"h-5 w-5\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2\"\n              >\n                <rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\" />\n                <path d=\"M3 10h18M8 3v4M16 3v4\" strokeLinecap=\"round\" />\n              </svg>\n            </div>\n            <span className=\"text-lg font-bold tracking-tight\">\n              Event Calendar\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {username ? (\n              <>\n                <span className=\"hidden text-sm text-slate-500 sm:inline\">\n                  Signed in as\n                </span>\n                <span className=\"rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700\">\n                  {username}\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => setConfirmSignOut(true)}\n                  className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50\"\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  type=\"button\"\n                  onClick={() => setAuthMode(\"login\")}\n                  className=\"rounded-lg px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100\"\n                >\n                  Sign in\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setAuthMode(\"register\")}\n                  className=\"rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-indigo-700\"\n                >\n                  Register\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-7xl px-4 py-6 sm:px-6\">\n        <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              aria-label=\"Previous period\"\n              onClick={() => setAnchor(shiftPeriod(anchor, mode, -1))}\n              className=\"rounded-lg border border-slate-300 bg-white p-2 text-slate-600 transition hover:bg-slate-100\"\n            >\n              <svg className=\"h-4 w-4\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <path d=\"M12 4l-6 6 6 6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              aria-label=\"Next period\"\n              onClick={() => setAnchor(shiftPeriod(anchor, mode, 1))}\n              className=\"rounded-lg border border-slate-300 bg-white p-2 text-slate-600 transition hover:bg-slate-100\"\n            >\n              <svg className=\"h-4 w-4\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <path d=\"M8 4l6 6-6 6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n              </svg>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setAnchor(new Date())}\n              className=\"rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100\"\n            >\n              Today\n            </button>\n            <h2 className=\"ml-2 text-lg font-semibold text-slate-900 sm:text-xl\">\n              {periodTitle(anchor, mode)}\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <div className=\"flex rounded-lg border border-slate-300 bg-white p-0.5\">\n              {MODES.map((option) => (\n                <button\n                  key={option}\n                  type=\"button\"\n                  onClick={() => setMode(option)}\n                  className={`rounded-md px-3 py-1.5 text-sm font-medium capitalize transition ${\n                    mode === option\n                      ? \"bg-indigo-600 text-white shadow-sm\"\n                      : \"text-slate-600 hover:bg-slate-100\"\n                  }`}\n                >\n                  {option}\n                </button>\n              ))}\n            </div>\n            {signedIn && (\n              <button\n                type=\"button\"\n                onClick={() =>\n                  setFormState({ event: null, defaultStart: new Date() })\n                }\n                className=\"flex items-center gap-1 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700\"\n              >\n                <svg className=\"h-4 w-4\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                  <path d=\"M10 4v12M4 10h12\" strokeLinecap=\"round\" />\n                </svg>\n                New event\n              </button>\n            )}\n          </div>\n        </div>\n\n        {!signedIn && (\n          <div className=\"mb-4 rounded-lg border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm text-indigo-800\">\n            You are browsing as a guest.{\" \"}\n            <button\n              type=\"button\"\n              onClick={() => setAuthMode(\"login\")}\n              className=\"font-semibold underline\"\n            >\n              Sign in\n            </button>{\" \"}\n            to create, edit or delete events.\n          </div>\n        )}\n\n        {loadError && (\n          <div className=\"mb-4 flex items-center justify-between rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\">\n            <span>{loadError}</span>\n            <button\n              type=\"button\"\n              onClick={loadEvents}\n              className=\"font-semibold underline\"\n            >\n              Retry\n            </button>\n          </div>\n        )}\n\n        {loading ? (\n          <div className=\"rounded-xl border border-slate-200 bg-white py-20 text-center text-slate-400\">\n            Loading events…\n          </div>\n        ) : (\n          <>\n            {mode === \"month\" && (\n              <MonthView\n                anchor={anchor}\n                events={events}\n                signedIn={signedIn}\n                onSelect={setSelected}\n                onCreateAt={(day) =>\n                  setFormState({ event: null, defaultStart: new Date(day.getTime() + 9 * 3_600_000) })\n                }\n                onShowDay={(day) => {\n                  setAnchor(day);\n                  setMode(\"day\");\n                }}\n              />\n            )}\n            {mode === \"week\" && (\n              <WeekView\n                anchor={anchor}\n                events={events}\n                signedIn={signedIn}\n                onSelect={setSelected}\n                onCreateAt={(date) =>\n                  setFormState({ event: null, defaultStart: date })\n                }\n                onShowDay={(day) => {\n                  setAnchor(day);\n                  setMode(\"day\");\n                }}\n              />\n            )}\n            {mode === \"day\" && (\n              <DayView\n                anchor={anchor}\n                events={events}\n                signedIn={signedIn}\n                onSelect={setSelected}\n                onCreateAt={(date) =>\n                  setFormState({ event: null, defaultStart: date })\n                }\n                onShowDay={(day) => setAnchor(day)}\n              />\n            )}\n            {events.length === 0 && !loadError && (\n              <p className=\"mt-3 text-center text-sm text-slate-400\">\n                No events in this {mode}.\n              </p>\n            )}\n          </>\n        )}\n      </main>\n\n      <footer className=\"mx-auto max-w-7xl px-4 pb-8 text-center text-xs text-slate-400 sm:px-6\">\n        All times shown in UTC.\n      </footer>\n\n      {selected && (\n        <EventDetails\n          event={selected}\n          signedIn={signedIn}\n          onEdit={() => setFormState({ event: selected })}\n          onDeleted={handleDeleted}\n          onClose={() => setSelected(null)}\n        />\n      )}\n\n      {formState && (\n        <EventForm\n          key={formState.event?.id ?? `new-${formState.defaultStart?.getTime() ?? 0}`}\n          event={formState.event}\n          defaultStart={formState.defaultStart}\n          onSaved={handleSaved}\n          onClose={() => setFormState(null)}\n        />\n      )}\n\n      {confirmSignOut && (\n        <Modal\n          title=\"Sign out\"\n          onClose={() => setConfirmSignOut(false)}\n          footer={\n            <>\n              <button\n                type=\"button\"\n                onClick={() => setConfirmSignOut(false)}\n                className=\"rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleSignOut}\n                className=\"rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700\"\n              >\n                Sign out\n              </button>\n            </>\n          }\n        >\n          <p className=\"text-sm text-slate-600\">\n            Are you sure you want to sign out, {username}?\n          </p>\n        </Modal>\n      )}\n\n      {toast && (\n        <div className=\"fixed bottom-5 right-5 z-[60] rounded-xl bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow-lg\">\n          {toast}\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794352388968,"end":1794352388979}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7bc9b63001puy7cCWO1TfZfp","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","messageID":"msg_1c7bc390e0017QmCzbyZoNrzdI"}}
