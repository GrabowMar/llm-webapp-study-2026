{"type":"text","timestamp":1794352093345,"sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","part":{"id":"prt_1c7b81890001HY1uEhTuOgPqD4","messageID":"msg_1c7b697bc001gs2Jr5I7Pa6XFc","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","type":"text","text":"Now I'll write the backend API.","time":{"start":1794352093328,"end":1794352093341}}}
{"type":"tool_use","timestamp":1794352093418,"sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b455973c89a14ebe","state":{"status":"completed","input":{"content":"\"\"\"Shared event calendar: Flask API + static frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import date, datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"calendar.db\"\n\napp = Flask(__name__, static_folder=None)\napp.url_map.strict_slashes = False\nEPOCH = datetime(1970, 1, 1, tzinfo=timezone.utc)\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str, errors: dict | None = None):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n        self.errors = errors or {}\n\n    def payload(self) -> dict:\n        body: dict = {\"message\": self.message}\n        if self.errors:\n            body[\"errors\"] = self.errors\n        return body\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(exc: ApiError):\n    return jsonify(exc.payload()), exc.status\n\n\n@app.errorhandler(404)\ndef handle_404(_exc):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"message\": \"Not found.\"}), 404\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(405)\ndef handle_405(_exc):\n    return jsonify({\"message\": \"Method not allowed.\"}), 405\n\n\n@app.after_request\ndef add_cors(response):\n    response.headers.setdefault(\"Access-Control-Allow-Origin\", \"*\")\n    response.headers.setdefault(\"Access-Control-Allow-Headers\", \"Authorization, Content-Type\")\n    response.headers.setdefault(\"Access-Control-Allow-Methods\", \"GET, POST, PUT, DELETE, OPTIONS\")\n    return response\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 10000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                username TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS events (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                title TEXT NOT NULL,\n                description TEXT NOT NULL DEFAULT '',\n                location TEXT NOT NULL DEFAULT '',\n                start_time TEXT NOT NULL,\n                end_time TEXT NOT NULL,\n                start_ts INTEGER NOT NULL,\n                end_ts INTEGER NOT NULL,\n                created_at TEXT NOT NULL,\n                created_by TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_events_start_ts ON events(start_ts);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef to_micros(moment: datetime) -> int:\n    delta = moment.astimezone(timezone.utc) - EPOCH\n    return (delta.days * 86400 + delta.seconds) * 1_000_000 + delta.microseconds\n\n\ndef format_utc(moment: datetime) -> str:\n    moment = moment.astimezone(timezone.utc)\n    text = moment.strftime(\"%Y-%m-%dT%H:%M:%S\")\n    if moment.microsecond:\n        text += f\".{moment.microsecond:06d}\".rstrip(\"0\")\n    return text + \"Z\"\n\n\ndef parse_datetime(value: object, field: str) -> datetime:\n    if not isinstance(value, str) or not value.strip():\n        raise ApiError(400, \"Invalid event data.\", {field: f\"{field} is required.\"})\n    text = value.strip()\n    if text.endswith((\"Z\", \"z\")):\n        text = text[:-1] + \"+00:00\"\n    try:\n        moment = datetime.fromisoformat(text)\n    except ValueError:\n        raise ApiError(\n            400, \"Invalid event data.\", {field: f\"{field} must be a valid ISO 8601 date-time.\"}\n        )\n    if moment.tzinfo is None:\n        moment = moment.replace(tzinfo=timezone.utc)\n    return moment.astimezone(timezone.utc)\n\n\ndef parse_bound(value: str, field: str, is_end: bool) -> int:\n    try:\n        day = date.fromisoformat(value.strip())\n    except ValueError:\n        return to_micros(parse_datetime(value, field))\n    moment = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)\n    if is_end:\n        moment = moment.replace(hour=23, minute=59, second=59, microsecond=999999)\n    return to_micros(moment)\n\n\ndef event_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": row[\"start_time\"],\n        \"end_time\": row[\"end_time\"],\n        \"created_at\": row[\"created_at\"],\n        \"created_by\": row[\"created_by\"],\n    }\n\n\ndef body_object() -> dict:\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        raise ApiError(400, \"A JSON object is required.\")\n    return body\n\n\ndef optional_text(body: dict, field: str) -> str:\n    value = body.get(field)\n    if value is None:\n        return \"\"\n    if not isinstance(value, str):\n        raise ApiError(400, \"Invalid event data.\", {field: f\"{field} must be a string.\"})\n    return value\n\n\ndef require_auth(view):\n    @functools.wraps(view)\n    def wrapped(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        parts = header.split()\n        if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1]:\n            raise ApiError(401, \"Authentication required.\")\n        row = db().execute(\n            \"SELECT user_id, username FROM tokens WHERE token = ?\", (parts[1],)\n        ).fetchone()\n        if row is None:\n            raise ApiError(401, \"Invalid or expired token.\")\n        g.username = row[\"username\"]\n        g.user_id = row[\"user_id\"]\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef validate_credentials(body: dict) -> tuple[str, str]:\n    errors: dict = {}\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required.\"\n    elif len(username.strip()) > 150:\n        errors[\"username\"] = \"Username must be 150 characters or fewer.\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required.\"\n    if errors:\n        raise ApiError(400, \"Invalid account data.\", errors)\n    return username.strip(), password\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = body_object()\n    username, password = validate_credentials(body)\n    conn = db()\n    if conn.execute(\n        \"SELECT 1 FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone():\n        raise ApiError(409, \"Username is already taken.\", {\"username\": \"Username is already taken.\"})\n    cur = conn.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    token = secrets.token_urlsafe(32)\n    conn.execute(\n        \"INSERT INTO tokens (token, user_id, username) VALUES (?, ?, ?)\",\n        (token, cur.lastrowid, username),\n    )\n    conn.commit()\n    return jsonify({\"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = body_object()\n    username, password = validate_credentials(body)\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n        (username,),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password.\")\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\n        \"INSERT INTO tokens (token, user_id, username) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], row[\"username\"]),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]}), 200\n\n\n@app.get(\"/api/auth/me\")\n@require_auth\ndef me():\n    return jsonify({\"username\": g.username})\n\n\n@app.post(\"/api/auth/logout\")\n@require_auth\ndef logout():\n    token = request.headers.get(\"Authorization\", \"\").split()[1]\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    conn.commit()\n    return jsonify({\"message\": \"Signed out.\"})\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    clauses: list[str] = []\n    params: list = []\n    if request.args.get(\"start_date\"):\n        clauses.append(\"start_ts >= ?\")\n        params.append(parse_bound(request.args[\"start_date\"], \"start_date\", False))\n    if request.args.get(\"end_date\"):\n        clauses.append(\"start_ts <= ?\")\n        params.append(parse_bound(request.args[\"end_date\"], \"end_date\", True))\n    where = \" WHERE \" + \" AND \".join(clauses) if clauses else \"\"\n    conn = db()\n    rows = conn.execute(\n        f\"SELECT * FROM events{where} ORDER BY start_ts ASC, id ASC\", params\n    ).fetchall()\n    items = [event_dict(row) for row in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id: int):\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        raise ApiError(404, \"Event not found.\")\n    return jsonify(event_dict(row))\n\n\ndef event_fields(body: dict, *, update: bool, existing: sqlite3.Row | None = None) -> dict:\n    errors: dict = {}\n\n    def required(name: str):\n        if name in body:\n            return body[name]\n        if update and existing is not None:\n            return existing[name]\n        return None\n\n    title = required(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required.\"\n    elif len(title) > 255:\n        errors[\"title\"] = \"Title must be 255 characters or fewer.\"\n\n    start_value = required(\"start_time\")\n    end_value = required(\"end_time\")\n    start = end = None\n    try:\n        start = parse_datetime(start_value, \"start_time\")\n    except ApiError as exc:\n        errors.update(exc.errors)\n    try:\n        end = parse_datetime(end_value, \"end_time\")\n    except ApiError as exc:\n        errors.update(exc.errors)\n\n    description = optional_text(body, \"description\") if not update or \"description\" in body or existing is None else existing[\"description\"]\n    location = optional_text(body, \"location\") if not update or \"location\" in body or existing is None else existing[\"location\"]\n\n    if errors:\n        raise ApiError(400, \"Invalid event data.\", errors)\n    if end < start:\n        raise ApiError(\n            400, \"Invalid event data.\", {\"end_time\": \"End time must not be before start time.\"}\n        )\n    return {\n        \"title\": title.strip(),\n        \"description\": description,\n        \"location\": location,\n        \"start_time\": format_utc(start),\n        \"end_time\": format_utc(end),\n        \"start_ts\": to_micros(start),\n        \"end_ts\": to_micros(end),\n    }\n\n\n@app.post(\"/api/events\")\n@require_auth\ndef create_event():\n    fields = event_fields(body_object(), update=False)\n    conn = db()\n    cur = conn.execute(\n        \"\"\"INSERT INTO events\n           (title, description, location, start_time, end_time, start_ts, end_ts, created_at, created_by)\n           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            fields[\"start_ts\"],\n            fields[\"end_ts\"],\n            format_utc(datetime.now(timezone.utc)),\n            g.username,\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM events WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(event_dict(row)), 201\n\n\n@app.put(\"/api/events/<int:event_id>\")\n@require_auth\ndef update_event(event_id: int):\n    conn = db()\n    existing = conn.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if existing is None:\n        raise ApiError(404, \"Event not found.\")\n    fields = event_fields(body_object(), update=True, existing=existing)\n    conn.execute(\n        \"\"\"UPDATE events SET title = ?, description = ?, location = ?,\n           start_time = ?, end_time = ?, start_ts = ?, end_ts = ? WHERE id = ?\"\"\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            fields[\"start_ts\"],\n            fields[\"end_ts\"],\n            event_id,\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    return jsonify(event_dict(row))\n\n\n@app.delete(\"/api/events/<int:event_id>\")\n@require_auth\ndef delete_event(event_id: int):\n    conn = db()\n    cur = conn.execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    conn.commit()\n    if cur.rowcount == 0:\n        raise ApiError(404, \"Event not found.\")\n    return \"\", 204\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"GET\", \"POST\", \"PUT\", \"DELETE\", \"PATCH\"])\ndef api_not_found(_path: str):\n    raise ApiError(404, \"Not found.\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794352093337,"end":1794352093392}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7b81893001GkP51n2xC4QSan","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","messageID":"msg_1c7b697bc001gs2Jr5I7Pa6XFc"}}
