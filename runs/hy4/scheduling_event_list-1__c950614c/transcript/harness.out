{"type":"step_start","timestamp":1794352256509,"sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","part":{"id":"prt_1c7ba95ee001jXjw102Kpv4JtQ","messageID":"msg_1c7ba3a58001XkV5zr6DSWuRJZ","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","type":"step-start"}}
{"type":"tool_use","timestamp":1794352256531,"sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b68e79c7df2e3754","state":{"status":"completed","input":{"content":"export type ViewMode = \"month\" | \"week\" | \"day\";\n\nexport const WEEKDAY_LABELS = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"];\n\nconst pad = (value: number) => String(value).padStart(2, \"0\");\n\nexport function dateKey(value: Date | string): string {\n  const date = typeof value === \"string\" ? new Date(value) : value;\n  return `${date.getUTCFullYear()}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;\n}\n\nexport function addDays(date: Date, amount: number): Date {\n  return new Date(date.getTime() + amount * 86_400_000);\n}\n\nexport function startOfDay(date: Date): Date {\n  return new Date(\n    Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()),\n  );\n}\n\nexport function startOfWeek(date: Date): Date {\n  const day = startOfDay(date).getUTCDay();\n  return addDays(startOfDay(date), -(day === 0 ? 6 : day - 1));\n}\n\nexport function startOfMonth(date: Date): Date {\n  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1));\n}\n\nexport interface Period {\n  start: Date;\n  end: Date;\n}\n\nexport function getPeriod(anchor: Date, mode: ViewMode): Period {\n  if (mode === \"day\") {\n    const start = startOfDay(anchor);\n    return { start, end: new Date(start.getTime() + 86_400_000 - 1) };\n  }\n  if (mode === \"week\") {\n    const start = startOfWeek(anchor);\n    return { start, end: new Date(start.getTime() + 7 * 86_400_000 - 1) };\n  }\n  const start = startOfMonth(anchor);\n  const end = new Date(\n    Date.UTC(anchor.getUTCFullYear(), anchor.getUTCMonth() + 1, 1) - 1,\n  );\n  return { start, end };\n}\n\nexport function shiftPeriod(anchor: Date, mode: ViewMode, delta: number): Date {\n  if (mode === \"day\") return addDays(anchor, delta);\n  if (mode === \"week\") return addDays(anchor, 7 * delta);\n  return new Date(Date.UTC(anchor.getUTCFullYear(), anchor.getUTCMonth() + delta, 1));\n}\n\nexport function periodTitle(anchor: Date, mode: ViewMode): string {\n  if (mode === \"day\") {\n    return anchor.toLocaleDateString(undefined, {\n      timeZone: \"UTC\",\n      weekday: \"long\",\n      year: \"numeric\",\n      month: \"long\",\n      day: \"numeric\",\n    });\n  }\n  if (mode === \"week\") {\n    const { start, end } = getPeriod(anchor, \"week\");\n    const sameMonth = start.getUTCMonth() === end.getUTCMonth();\n    const startText = start.toLocaleDateString(undefined, {\n      timeZone: \"UTC\",\n      month: \"short\",\n      day: \"numeric\",\n    });\n    const endText = end.toLocaleDateString(undefined, {\n      timeZone: \"UTC\",\n      month: sameMonth ? undefined : \"short\",\n      day: \"numeric\",\n      year: \"numeric\",\n    });\n    return `${startText} – ${endText}`;\n  }\n  return anchor.toLocaleDateString(undefined, {\n    timeZone: \"UTC\",\n    year: \"numeric\",\n    month: \"long\",\n  });\n}\n\nexport function monthGridDays(anchor: Date): Date[] {\n  const first = startOfWeek(startOfMonth(anchor));\n  return Array.from({ length: 42 }, (_, index) => addDays(first, index));\n}\n\nexport function weekDays(anchor: Date): Date[] {\n  const start = startOfWeek(anchor);\n  return Array.from({ length: 7 }, (_, index) => addDays(start, index));\n}\n\nexport function toInputValue(isoUtc: string): string {\n  const date = new Date(isoUtc);\n  if (Number.isNaN(date.getTime())) return \"\";\n  return `${dateKey(date)}T${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}`;\n}\n\nexport function fromInputValue(value: string): string {\n  if (!value) return \"\";\n  return value.length === 16 ? `${value}:00` : value;\n}\n\nexport function formatTime(isoUtc: string): string {\n  const date = new Date(isoUtc);\n  return `${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}`;\n}\n\nexport function formatDateTime(isoUtc: string): string {\n  const date = new Date(isoUtc);\n  return `${date.toLocaleDateString(undefined, {\n    timeZone: \"UTC\",\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n  })} at ${formatTime(isoUtc)} UTC`;\n}\n\nexport function eventOverlapsPeriod(\n  event: { start_time: string; end_time: string },\n  period: Period,\n): boolean {\n  const start = new Date(event.start_time).getTime();\n  const end = new Date(event.end_time).getTime();\n  return start <= period.end.getTime() && end >= period.start.getTime();\n}\n\nexport function eventsOnDay<T extends { start_time: string; end_time: string }>(\n  events: T[],\n  day: Date,\n): T[] {\n  const start = startOfDay(day).getTime();\n  const end = start + 86_400_000;\n  return events.filter((event) => {\n    const eventStart = new Date(event.start_time).getTime();\n    const eventEnd = new Date(event.end_time).getTime();\n    return eventStart < end && eventEnd > start;\n  });\n}\n\nexport function isToday(day: Date): boolean {\n  return dateKey(day) === dateKey(new Date());\n}\n","filePath":"/workspace/frontend/src/date.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/date.ts","exists":false,"truncated":false},"title":"frontend/src/date.ts","time":{"start":1794352256504,"end":1794352256513}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ba95f200150sU6D53Xuxtk9","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","messageID":"msg_1c7ba3a58001XkV5zr6DSWuRJZ"}}
