\"\");\n const [startTime, setStartTime] = useState(initialStart);\n const [endTime, setEndTime] = useState(\n-  event ? toInputValue(event.end_time) : defaultInputDate(new Date(new Date(initialStart + \"Z\").getTime() + 3_600_000)),\n+  event ? toInputValue(event.end_time) : defaultInputDate(endSeed),\n );\n const [errors, setErrors] = useState<Record<string, string>>({});\n const [message, setMessage] = useState(\"\");\n const [busy, setBusy] = useState(false);\n","additions":1,"deletions":1},"truncated":false},"title":"frontend/src/components/EventForm.tsx","time":{"start":1794352312293,"end":1794352312302}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7bb6fdf0010jZryR3X3Kb5sM","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","messageID":"msg_1c7bb5f19001c2HjlUgvaf6kJ3"}}
