{"type":"tool_use","timestamp":1794352298369,"sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b6af6a05608cf39a","state":{"status":"completed","input":{"content":"import { useState, type FormEvent } from \"react\";\nimport {\n  ApiError,\n  createEvent,\n  updateEvent,\n  type CalendarEvent,\n  type EventInput,\n} from \"../api\";\nimport { fromInputValue, toInputValue } from \"../date\";\nimport Modal from \"./Modal\";\n\ninterface EventFormProps {\n  event: CalendarEvent | null;\n  defaultStart?: Date;\n  onSaved: () => void;\n  onClose: () => void;\n}\n\nfunction defaultInputDate(value?: Date): string {\n  const date = value ?? new Date();\n  const hours = value ? date.getUTCHours() : 9;\n  const key = `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, \"0\")}-${String(date.getUTCDate()).padStart(2, \"0\")}`;\n  return `${key}T${String(hours).padStart(2, \"0\")}:00`;\n}\n\nexport default function EventForm({\n  event,\n  defaultStart,\n  onSaved,\n  onClose,\n}: EventFormProps) {\n  const initialStart = event\n    ? toInputValue(event.start_time)\n    : defaultInputDate(defaultStart);\n  const [title, setTitle] = useState(event?.title ?? \"\");\n  const [description, setDescription] = useState(event?.description ?? \"\");\n  const [location, setLocation] = useState(event?.location ?? \"\");\n  const [startTime, setStartTime] = useState(initialStart);\n  const [endTime, setEndTime] = useState(\n    event ? toInputValue(event.end_time) : defaultInputDate(new Date(new Date(initialStart + \"Z\").getTime() + 3_600_000)),\n  );\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const handleSubmit = async (submitEvent: FormEvent) => {\n    submitEvent.preventDefault();\n    setErrors({});\n    setMessage(\"\");\n    setBusy(true);\n    const input: EventInput = {\n      title: title.trim(),\n      description,\n      location,\n      start_time: fromInputValue(startTime),\n      end_time: fromInputValue(endTime),\n    };\n    try {\n      if (event) {\n        await updateEvent(event.id, input);\n      } else {\n        await createEvent(input);\n      }\n      onSaved();\n    } catch (error) {\n      if (error instanceof ApiError) {\n        setErrors(error.errors);\n        setMessage(error.message);\n      } else {\n        setMessage(\"Something went wrong. Please try again.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const fieldError = (name: string) =>\n    errors[name] ? (\n      <p className=\"mt-1 text-xs text-red-600\">{errors[name]}</p>\n    ) : null;\n\n  const inputClass =\n    \"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\";\n  const labelClass = \"mb-1 block text-sm font-medium text-slate-700\";\n\n  return (\n    <Modal\n      title={event ? \"Edit event\" : \"New event\"}\n      onClose={onClose}\n      footer={\n        <>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50\"\n          >\n            Cancel\n          </button>\n          <button\n            type=\"submit\"\n            form=\"event-form\"\n            disabled={busy}\n            className=\"rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60\"\n          >\n            {busy ? \"Saving…\" : event ? \"Save changes\" : \"Create event\"}\n          </button>\n        </>\n      }\n    >\n      {message && (\n        <div className=\"mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\">\n          {message}\n        </div>\n      )}\n      <form id=\"event-form\" onSubmit={handleSubmit} className=\"space-y-4\">\n        <div>\n          <label htmlFor=\"event-title\" className={labelClass}>\n            Title\n          </label>\n          <input\n            id=\"event-title\"\n            type=\"text\"\n            value={title}\n            onChange={(change) => setTitle(change.target.value)}\n            className={inputClass}\n            placeholder=\"Event title\"\n          />\n          {fieldError(\"title\")}\n        </div>\n        <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n          <div>\n            <label htmlFor=\"event-start\" className={labelClass}>\n              Start (UTC)\n            </label>\n            <input\n              id=\"event-start\"\n              type=\"datetime-local\"\n              value={startTime}\n              onChange={(change) => setStartTime(change.target.value)}\n              className={inputClass}\n            />\n            {fieldError(\"start_time\")}\n          </div>\n          <div>\n            <label htmlFor=\"event-end\" className={labelClass}>\n              End (UTC)\n            </label>\n            <input\n              id=\"event-end\"\n              type=\"datetime-local\"\n              value={endTime}\n              onChange={(change) => setEndTime(change.target.value)}\n              className={inputClass}\n            />\n            {fieldError(\"end_time\")}\n          </div>\n        </div>\n        <div>\n          <label htmlFor=\"event-location\" className={labelClass}>\n            Location\n          </label>\n          <input\n            id=\"event-location\"\n            type=\"text\"\n            value={location}\n            onChange={(change) => setLocation(change.target.value)}\n            className={inputClass}\n            placeholder=\"Optional\"\n          />\n          {fieldError(\"location\")}\n        </div>\n        <div>\n          <label htmlFor=\"event-description\" className={labelClass}>\n            Description\n          </label>\n          <textarea\n            id=\"event-description\"\n            rows={4}\n            value={description}\n            onChange={(change) => setDescription(change.target.value)}\n            className={inputClass}\n            placeholder=\"Optional\"\n          />\n          {fieldError(\"description\")}\n        </div>\n        <p className=\"text-xs text-slate-400\">\n          Date-times are interpreted as UTC.\n        </p>\n      </form>\n    </Modal>\n  );\n}\n","filePath":"/workspace/frontend/src/components/EventForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/EventForm.tsx","exists":false,"truncated":false},"title":"frontend/src/components/EventForm.tsx","time":{"start":1794352298343,"end":1794352298353}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7bb3962001Bcu06WZSJB09b0","sessionID":"ses_e384ec77fffej89Mu67UFrzJFG","messageID":"msg_1c7bb08cf001OmfEzVJh6VdWfH"}}
