{"type":"tool_use","timestamp":1794372520958,"sessionID":"ses_e37145559ffetVKrfk7MW4vWAq","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a1196017020611ef","state":{"status":"completed","input":{"content":"export type Sensor = {\n  id: number;\n  name: string;\n  unit: string;\n  location: string;\n  last_value: number | null;\n  last_updated: string | null;\n  owner: string;\n};\n\nexport type Reading = {\n  id: number;\n  sensor_id: number;\n  value: number;\n  recorded_at: string;\n};\n\nexport type Auth = { token: string; username: string };\n\nconst TOKEN_KEY = \"sensor-dashboard-token\";\n\nexport function getToken(): string | null {\n  return window.localStorage.getItem(TOKEN_KEY);\n}\n\nexport class ApiError extends Error {\n  constructor(\n    message: string,\n    public status: number,\n  ) {\n    super(message);\n  }\n}\n\nexport async function api<T>(\n  path: string,\n  init: RequestInit = {},\n): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(init.headers as Record<string, string> | undefined),\n  };\n  if (init.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const response = await fetch(path, { ...init, headers });\n  if (!response.ok) {\n    let message = `Request failed (${response.status})`;\n    try {\n      const data = await response.json();\n      if (data && typeof data.error === \"string\") message = data.error;\n    } catch {\n      // keep the default message\n    }\n    throw new ApiError(message, response.status);\n  }\n  if (response.status === 204) return undefined as T;\n  return (await response.json()) as T;\n}\n\nexport async function register(\n  username: string,\n  password: string,\n): Promise<Auth> {\n  await api<{ id: number; username: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n  return login(username, password);\n}\n\nexport async function login(\n  username: string,\n  password: string,\n): Promise<Auth> {\n  const auth = await api<Auth>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n  window.localStorage.setItem(TOKEN_KEY, auth.token);\n  return auth;\n}\n\nexport function logout(): void {\n  window.localStorage.removeItem(TOKEN_KEY);\n}\n\nexport async function currentUser(): Promise<string | null> {\n  if (!getToken()) return null;\n  try {\n    const me = await api<{ id: number; username: string }>(\"/api/auth/me\");\n    return me.username;\n  } catch {\n    logout();\n    return null;\n  }\n}\n\nexport const listSensors = () => api<{ items: Sensor[] }>(\"/api/sensors\");\n\nexport const getSensor = (id: number) => api<Sensor>(`/api/sensors/${id}`);\n\nexport const createSensor = (data: {\n  name: string;\n  unit: string;\n  location: string;\n}) =>\n  api<Sensor>(\"/api/sensors\", { method: \"POST\", body: JSON.stringify(data) });\n\nexport const deleteSensor = (id: number) =>\n  api<void>(`/api/sensors/${id}`, { method: \"DELETE\" });\n\nexport const listReadings = (id: number, limit = 50) =>\n  api<{ items: Reading[]; total: number }>(\n    `/api/sensors/${id}/readings?limit=${limit}`,\n  );\n\nexport const createReading = (id: number, value: number) =>\n  api<Reading>(`/api/sensors/${id}/readings`, {\n    method: \"POST\",\n    body: JSON.stringify({ value }),\n  });\n\nexport function formatTime(value: string): string {\n  return new Date(value).toLocaleString();\n}\n\nexport function timeAgo(value: string | null, now: number): string {\n  if (!value) return \"never\";\n  const seconds = Math.max(0, Math.floor((now - new Date(value).getTime()) / 1000));\n  if (seconds < 5) return \"just now\";\n  if (seconds < 60) return `${seconds}s ago`;\n  const minutes = Math.floor(seconds / 60);\n  if (minutes < 60) return `${minutes}m ago`;\n  const hours = Math.floor(minutes / 60);\n  if (hours < 24) return `${hours}h ago`;\n  const days = Math.floor(hours / 24);\n  return `${days}d ago`;\n}\n\nexport function formatValue(value: number | null, unit: string): string {\n  if (value === null) return \"no readings yet\";\n  const label = Number.isInteger(value) ? String(value) : String(Number(value.toFixed(4)));\n  return unit ? `${label} ${unit}` : label;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794372520930,"end":1794372520937}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8efcbdc001skkKMIVO5haqMu","sessionID":"ses_e37145559ffetVKrfk7MW4vWAq","messageID":"msg_1c8ef6bb5001XtiPrm5w2gcQwq"}}
