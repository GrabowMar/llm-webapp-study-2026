{"type":"tool_use","timestamp":1794372375051,"sessionID":"ses_e37145559ffetVKrfk7MW4vWAq","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-990024043e0df1a9","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point for the sensor dashboard.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"sensors.db\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\n\nCREATE TABLE IF NOT EXISTS sensors (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    unit TEXT NOT NULL DEFAULT '',\n    location TEXT NOT NULL DEFAULT '',\n    owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    last_value REAL,\n    last_updated TEXT\n);\n\nCREATE TABLE IF NOT EXISTS readings (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n    value REAL NOT NULL,\n    recorded_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS readings_sensor_idx\n    ON readings(sensor_id, recorded_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS sensors_name_idx ON sensors(name);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 30000\")\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    return db().execute(\n        \"SELECT u.id, u.username FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef clean_text(value, default: str = \"\") -> str:\n    if value is None:\n        return default\n    return str(value).strip()\n\n\nSENSOR_QUERY = \"\"\"\nSELECT s.id, s.name, s.unit, s.location, s.last_value, s.last_updated,\n       u.username AS owner, s.owner_id\nFROM sensors s JOIN users u ON u.id = s.owner_id\n\"\"\"\n\n\ndef sensor_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"last_value\": row[\"last_value\"],\n        \"last_updated\": row[\"last_updated\"],\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef reading_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"sensor_id\": row[\"sensor_id\"],\n        \"value\": row[\"value\"],\n        \"recorded_at\": row[\"recorded_at\"],\n    }\n\n\ndef get_sensor(sensor_id: int):\n    return db().execute(SENSOR_QUERY + \" WHERE s.id = ?\", (sensor_id,)).fetchone()\n\n\ndef parse_value(value):\n    if isinstance(value, bool) or value is None:\n        return None\n    if isinstance(value, (int, float)):\n        number = float(value)\n    elif isinstance(value, str):\n        try:\n            number = float(value.strip())\n        except ValueError:\n            return None\n    else:\n        return None\n    if not math.isfinite(number):\n        return None\n    return number\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    if data is None:\n        return error(\"expected a JSON object\", 400)\n    username = clean_text(data.get(\"username\"))\n    password = data.get(\"password\")\n    if not username:\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    if db().execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return error(\"username already taken\", 409)\n    cur = db().execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    db().commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    if data is None:\n        return error(\"expected a JSON object\", 400)\n    username = clean_text(data.get(\"username\"))\n    password = data.get(\"password\")\n    if not username or not isinstance(password, str):\n        return error(\"invalid username or password\", 401)\n    user = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db().execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n    db().commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]}), 200\n\n\n@app.get(\"/api/auth/me\")\n@require_auth\ndef me():\n    return jsonify({\"id\": g.user[\"id\"], \"username\": g.user[\"username\"]})\n\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = db().execute(SENSOR_QUERY + \" ORDER BY s.name COLLATE NOCASE, s.id\").fetchall()\n    return jsonify({\"items\": [sensor_json(row) for row in rows]})\n\n\n@app.post(\"/api/sensors\")\n@require_auth\ndef create_sensor():\n    data = body()\n    if data is None:\n        return error(\"expected a JSON object\", 400)\n    name = clean_text(data.get(\"name\"))\n    if not name:\n        return error(\"name is required\", 400)\n    unit = clean_text(data.get(\"unit\"))\n    location = clean_text(data.get(\"location\"))\n    cur = db().execute(\n        \"INSERT INTO sensors (name, unit, location, owner_id) VALUES (?, ?, ?, ?)\",\n        (name, unit, location, g.user[\"id\"]),\n    )\n    db().commit()\n    return jsonify(sensor_json(get_sensor(cur.lastrowid))), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef read_sensor(sensor_id: int):\n    row = get_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    return jsonify(sensor_json(row))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\n@require_auth\ndef delete_sensor(sensor_id: int):\n    row = get_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    if row[\"owner_id\"] != g.user[\"id\"]:\n        return error(\"only the owner can delete this sensor\", 403)\n    db().execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n    db().commit()\n    return \"\", 204\n\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id: int):\n    if get_sensor(sensor_id) is None:\n        return error(\"sensor not found\", 404)\n    raw = request.args.get(\"limit\")\n    if raw is None:\n        limit = 50\n    else:\n        try:\n            limit = int(raw)\n        except ValueError:\n            return error(\"limit must be an integer\", 400)\n        if limit < 0:\n            return error(\"limit must not be negative\", 400)\n        limit = min(limit, 1000)\n    total = db().execute(\n        \"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[0]\n    rows = db().execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings \"\n        \"WHERE sensor_id = ? ORDER BY recorded_at DESC, id DESC LIMIT ?\",\n        (sensor_id, limit),\n    ).fetchall()\n    return jsonify({\"items\": [reading_json(row) for row in rows], \"total\": total})\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\n@require_auth\ndef create_reading(sensor_id: int):\n    sensor = get_sensor(sensor_id)\n    if sensor is None:\n        return error(\"sensor not found\", 404)\n    if sensor[\"owner_id\"] != g.user[\"id\"]:\n        return error(\"only the owner can post readings\", 403)\n    data = body()\n    if data is None:\n        return error(\"expected a JSON object\", 400)\n    value = parse_value(data.get(\"value\"))\n    if value is None:\n        return error(\"value must be a number\", 400)\n    recorded_at = now()\n    cur = db().execute(\n        \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n        (sensor_id, value, recorded_at),\n    )\n    db().execute(\n        \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n        (value, recorded_at, sensor_id),\n    )\n    db().commit()\n    row = db().execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings WHERE id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(reading_json(row)), 201\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api\"):\n        return error(\"not found\", 404)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_error):\n    if request.path.startswith(\"/api\"):\n        return error(\"method not allowed\", 405)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path == \"api\":\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794372374965,"end":1794372374990}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8ed91aa001VZe4lgrZOHDA22","sessionID":"ses_e37145559ffetVKrfk7MW4vWAq","messageID":"msg_1c8ec88fa001gDAVMOBh921yc9"}}
