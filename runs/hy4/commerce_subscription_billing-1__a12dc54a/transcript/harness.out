{"type":"tool_use","timestamp":1794327262946,"sessionID":"ses_e39ceee80ffe04SMT4Ng9vOWGY","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a8dc6aab65bd718a","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { ApiError, subscriptionsApi } from \"./api\";\nimport {\n  Alert,\n  Badge,\n  Button,\n  Card,\n  Field,\n  Spinner,\n  inputClass,\n} from \"./components\";\nimport {\n  STATUSES,\n  formatDate,\n  formatMoney,\n  statusLabel,\n} from \"./types\";\nimport type { PagedSubscriptions, SubscriptionInput } from \"./types\";\n\nconst PAGE_SIZE = 10;\n\ninterface Filters {\n  q: string;\n  status: string;\n  plan: string;\n  page: number;\n}\n\nconst emptyForm = {\n  customer_name: \"\",\n  plan: \"\",\n  monthly_amount: \"\",\n  renewal_date: \"\",\n  status: \"active\",\n};\n\nexport default function SubscriptionsView({\n  onOpen,\n}: {\n  onOpen: (id: number) => void;\n}) {\n  const [filters, setFilters] = useState<Filters>({\n    q: \"\",\n    status: \"\",\n    plan: \"\",\n    page: 1,\n  });\n  const [data, setData] = useState<PagedSubscriptions | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n  const [showCreate, setShowCreate] = useState(false);\n  const [form, setForm] = useState({ ...emptyForm });\n  const [formError, setFormError] = useState(\"\");\n  const [saving, setSaving] = useState(false);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const result = await subscriptionsApi.list({\n        q: filters.q,\n        status: filters.status,\n        plan: filters.plan,\n        page: filters.page,\n        page_size: PAGE_SIZE,\n      });\n      setData(result);\n      setError(\"\");\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Could not load subscriptions\");\n    } finally {\n      setLoading(false);\n    }\n  }, [filters.q, filters.status, filters.plan, filters.page]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  function updateFilter<K extends keyof Filters>(key: K, value: Filters[K]) {\n    setFilters((current) => ({ ...current, [key]: value, page: key === \"page\" ? Number(value) : 1 }));\n  }\n\n  async function create(event: React.FormEvent) {\n    event.preventDefault();\n    setFormError(\"\");\n    setSaving(true);\n    const input: SubscriptionInput = {\n      customer_name: form.customer_name.trim(),\n      plan: form.plan.trim(),\n      monthly_amount: form.monthly_amount === \"\" ? 0 : Number(form.monthly_amount),\n      status: form.status,\n    };\n    if (form.renewal_date) input.renewal_date = form.renewal_date;\n    try {\n      await subscriptionsApi.create(input);\n      setForm({ ...emptyForm });\n      setShowCreate(false);\n      setFilters((current) => ({ ...current, page: 1 }));\n      await load();\n    } catch (err) {\n      setFormError(err instanceof ApiError ? err.message : \"Could not create subscription\");\n    } finally {\n      setSaving(false);\n    }\n  }\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / PAGE_SIZE)) : 1;\n\n  return (\n    <div className=\"mx-auto max-w-6xl space-y-5 px-4 py-8\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-slate-900\">\n            Subscriptions\n          </h1>\n          <p className=\"mt-1 text-sm text-slate-500\">\n            {data ? `${data.total} subscription${data.total === 1 ? \"\" : \"s\"}` : \"Manage billing\"}\n          </p>\n        </div>\n        <Button onClick={() => setShowCreate((value) => !value)}>\n          {showCreate ? \"Cancel\" : \"+ New subscription\"}\n        </Button>\n      </div>\n\n      {showCreate && (\n        <Card>\n          <h2 className=\"mb-4 text-sm font-semibold text-slate-800\">\n            New subscription\n          </h2>\n          <form onSubmit={create} className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {formError && <Alert>{formError}</Alert>}\n            <Field label=\"Customer name\">\n              <input\n                className={inputClass}\n                value={form.customer_name}\n                onChange={(event) => setForm({ ...form, customer_name: event.target.value })}\n                required\n                placeholder=\"Acme Inc.\"\n              />\n            </Field>\n            <Field label=\"Plan\">\n              <input\n                className={inputClass}\n                value={form.plan}\n                onChange={(event) => setForm({ ...form, plan: event.target.value })}\n                placeholder=\"pro\"\n              />\n            </Field>\n            <Field label=\"Monthly amount\">\n              <input\n                className={inputClass}\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                value={form.monthly_amount}\n                onChange={(event) => setForm({ ...form, monthly_amount: event.target.value })}\n                placeholder=\"29.00\"\n              />\n            </Field>\n            <Field label=\"Renewal date\">\n              <input\n                className={inputClass}\n                type=\"date\"\n                value={form.renewal_date}\n                onChange={(event) => setForm({ ...form, renewal_date: event.target.value })}\n              />\n            </Field>\n            <Field label=\"Status\">\n              <select\n                className={inputClass}\n                value={form.status}\n                onChange={(event) => setForm({ ...form, status: event.target.value })}\n              >\n                {STATUSES.map((status) => (\n                  <option key={status} value={status}>{statusLabel(status)}</option>\n                ))}\n              </select>\n            </Field>\n            <div className=\"flex items-end\">\n              <Button type=\"submit\" disabled={saving} className=\"w-full sm:w-auto\">\n                {saving ? \"Creating…\" : \"Create subscription\"}\n              </Button>\n            </div>\n          </form>\n        </Card>\n      )}\n\n      <div className=\"flex flex-wrap items-center gap-2 border-b border-slate-200\">\n        <button\n          onClick={() => updateFilter(\"status\", \"\")}\n          className={`border-b-2 px-3 py-2 text-sm font-semibold transition ${\n            filters.status === \"\"\n              ? \"border-indigo-600 text-indigo-700\"\n              : \"border-transparent text-slate-500 hover:text-slate-800\"\n          }`}\n        >\n          All\n        </button>\n        {STATUSES.map((status) => (\n          <button\n            key={status}\n            onClick={() => updateFilter(\"status\", status)}\n            className={`border-b-2 px-3 py-2 text-sm font-semibold transition ${\n              filters.status === status\n                ? \"border-indigo-600 text-indigo-700\"\n                : \"border-transparent text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            {statusLabel(status)}\n          </button>\n        ))}\n      </div>\n\n      <Card className=\"p-0\">\n        <div className=\"flex flex-wrap gap-3 border-b border-slate-200 p-4\">\n          <input\n            className={`${inputClass} sm:max-w-xs`}\n            value={filters.q}\n            onChange={(event) => updateFilter(\"q\", event.target.value)}\n            placeholder=\"Search customers…\"\n            aria-label=\"Search customers\"\n          />\n          <input\n            className={`${inputClass} sm:max-w-[10rem]`}\n            value={filters.plan}\n            onChange={(event) => updateFilter(\"plan\", event.target.value)}\n            placeholder=\"Filter by plan…\"\n            aria-label=\"Filter by plan\"\n            list=\"plan-options\"\n          />\n          <datalist id=\"plan-options\">\n            {Array.from(new Set(data?.items.map((item) => item.plan) ?? []))\n              .filter(Boolean)\n              .map((plan) => <option key={plan} value={plan} />)}\n          </datalist>\n          {(filters.q || filters.plan || filters.status) && (\n            <Button\n              variant=\"secondary\"\n              onClick={() => setFilters({ q: \"\", status: \"\", plan: \"\", page: 1 })}\n            >\n              Clear\n            </Button>\n          )}\n        </div>\n\n        {error && <div className=\"p-4\"><Alert>{error}</Alert></div>}\n        {loading && !data && <Spinner />}\n        {data && (\n          <>\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-sm\">\n                <thead className=\"bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500\">\n                  <tr>\n                    <th className=\"px-4 py-3\">Customer</th>\n                    <th className=\"px-4 py-3\">Plan</th>\n                    <th className=\"px-4 py-3 text-right\">Monthly</th>\n                    <th className=\"px-4 py-3\">Renewal</th>\n                    <th className=\"px-4 py-3\">Status</th>\n                    <th className=\"px-4 py-3 text-right\">Failed runs</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100\">\n                  {data.items.map((item) => (\n                    <tr\n                      key={item.id}\n                      onClick={() => onOpen(item.id)}\n                      className=\"cursor-pointer transition hover:bg-indigo-50/60\"\n                    >\n                      <td className=\"px-4 py-3 font-medium text-slate-900\">\n                        {item.customer_name || \"—\"}\n                      </td>\n                      <td className=\"px-4 py-3 text-slate-600\">{item.plan || \"—\"}</td>\n                      <td className=\"px-4 py-3 text-right tabular-nums text-slate-700\">\n                        {formatMoney(item.monthly_amount)}\n                      </td>\n                      <td className=\"px-4 py-3 text-slate-600\">\n                        {formatDate(item.renewal_date)}\n                      </td>\n                      <td className=\"px-4 py-3\"><Badge status={item.status} /></td>\n                      <td className=\"px-4 py-3 text-right tabular-nums text-slate-600\">\n                        {item.failed_payment_count}\n                      </td>\n                    </tr>\n                  ))}\n                  {data.items.length === 0 && (\n                    <tr>\n                      <td colSpan={6} className=\"px-4 py-10 text-center text-slate-500\">\n                        No subscriptions match these filters.\n                      </td>\n                    </tr>\n                  )}\n                </tbody>\n              </table>\n            </div>\n            <div className=\"flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-4 py-3 text-sm text-slate-600\">\n              <span>\n                {data.total === 0\n                  ? \"No results\"\n                  : `Page ${data.page} of ${totalPages}`}\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <Button\n                  variant=\"secondary\"\n                  disabled={data.page <= 1 || loading}\n                  onClick={() => updateFilter(\"page\", data.page - 1)}\n                >\n                  Previous\n                </Button>\n                <Button\n                  variant=\"secondary\"\n                  disabled={data.page >= totalPages || loading}\n                  onClick={() => updateFilter(\"page\", data.page + 1)}\n                >\n                  Next\n                </Button>\n              </div>\n            </div>\n          </>\n        )}\n      </Card>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/SubscriptionsView.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/SubscriptionsView.tsx","exists":false,"truncated":false},"title":"frontend/src/SubscriptionsView.tsx","time":{"start":1794327262911,"end":1794327262922}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c63d36b90012DG3Pj6zBVnccx","sessionID":"ses_e39ceee80ffe04SMT4Ng9vOWGY","messageID":"msg_1c63ce8a0001Gqp6YKQ6yU7lHD"}}
