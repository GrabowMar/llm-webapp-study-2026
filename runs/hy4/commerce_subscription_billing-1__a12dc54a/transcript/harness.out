{"type":"tool_use","timestamp":1794327182496,"sessionID":"ses_e39ceee80ffe04SMT4Ng9vOWGY","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a62947e8600015ff","state":{"status":"completed","input":{"content":"export type SubscriptionStatus = \"active\" | \"past_due\" | \"trial\" | \"cancelled\";\n\nexport interface Subscription {\n  id: number;\n  customer_name: string;\n  plan: string;\n  monthly_amount: number;\n  renewal_date: string;\n  status: string;\n  failed_payment_count: number;\n  created_at: string;\n}\n\nexport interface Invoice {\n  id: number;\n  subscription_id: number;\n  amount_due: number;\n  due_date: string;\n  status: string;\n  paid_at: string | null;\n}\n\nexport interface Stats {\n  mrr: number;\n  counts: Record<string, number>;\n}\n\nexport interface PagedSubscriptions {\n  items: Subscription[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface SubscriptionInput {\n  customer_name?: string;\n  plan?: string;\n  monthly_amount?: number | string;\n  renewal_date?: string;\n  status?: string;\n  failed_payment_count?: number | string;\n}\n\nexport const STATUSES: SubscriptionStatus[] = [\n  \"active\",\n  \"past_due\",\n  \"trial\",\n  \"cancelled\",\n];\n\nexport function statusLabel(status: string): string {\n  switch (status) {\n    case \"past_due\":\n      return \"Past due\";\n    case \"trial\":\n      return \"Trial\";\n    case \"cancelled\":\n      return \"Cancelled\";\n    case \"active\":\n      return \"Active\";\n    default:\n      return status\n        .replace(/_/g, \" \")\n        .replace(/-/g, \" \")\n        .replace(/\\b\\w/g, (c) => c.toUpperCase());\n  }\n}\n\nexport function statusClasses(status: string): string {\n  switch (status) {\n    case \"active\":\n      return \"bg-emerald-100 text-emerald-800 ring-emerald-200\";\n    case \"past_due\":\n      return \"bg-amber-100 text-amber-800 ring-amber-200\";\n    case \"trial\":\n      return \"bg-sky-100 text-sky-800 ring-sky-200\";\n    case \"cancelled\":\n      return \"bg-slate-200 text-slate-600 ring-slate-300\";\n    default:\n      return \"bg-slate-100 text-slate-700 ring-slate-200\";\n  }\n}\n\nexport function formatMoney(value: number): string {\n  return `$${Number(value || 0).toFixed(2)}`;\n}\n\nexport function formatDate(value: string | null): string {\n  return value ? value.slice(0, 10) : \"—\";\n}\n","filePath":"/workspace/frontend/src/types.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/types.ts","exists":false,"truncated":false},"title":"frontend/src/types.ts","time":{"start":1794327182471,"end":1794327182479}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c63bfc82001x32rdgv6iTo3nn","sessionID":"ses_e39ceee80ffe04SMT4Ng9vOWGY","messageID":"msg_1c63be01c001ZQTjTyFUSsf58J"}}
