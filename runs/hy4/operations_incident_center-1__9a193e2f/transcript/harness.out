{"type":"step_start","timestamp":1794356091865,"sessionID":"ses_e3821fd4dffe681Iz1R8dCpOi8","part":{"id":"prt_1c7f51bcc001Ib36fvMReSK6hx","messageID":"msg_1c7f4e4fe001DI6Iu09VXMGzaD","sessionID":"ses_e3821fd4dffe681Iz1R8dCpOi8","type":"step-start"}}
{"type":"tool_use","timestamp":1794356091887,"sessionID":"ses_e3821fd4dffe681Iz1R8dCpOi8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b2b7d26b5a58fe40","state":{"status":"completed","input":{"content":"import type { AuthResult, Incident, IncidentPage, Stats, TimelineEvent, TimelinePage } from \"./types\";\n\nexport const SEVERITIES = [\"sev1\", \"sev2\", \"sev3\", \"sev4\"] as const;\nexport const STATUSES = [\"investigating\", \"identified\", \"monitoring\", \"resolved\"] as const;\n\nconst TOKEN_KEY = \"incident-center-token\";\nconst USERNAME_KEY = \"incident-center-username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function saveSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = { ...(options.headers as Record<string, string>) };\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  let response: Response;\n  try {\n    response = await fetch(path, { ...options, headers });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server. Please try again.\");\n  }\n\n  let data: unknown = null;\n  if (response.status !== 204) {\n    try {\n      data = await response.json();\n    } catch {\n      data = null;\n    }\n  }\n  if (!response.ok) {\n    const body = (data || {}) as { message?: string; error?: string; errors?: Record<string, string> };\n    throw new ApiError(\n      response.status,\n      body.message || body.error || `Request failed (${response.status})`,\n      body.errors || {},\n    );\n  }\n  return data as T;\n}\n\nfunction json(method: string, body: unknown): RequestInit {\n  return { method, body: JSON.stringify(body) };\n}\n\nexport const api = {\n  register(username: string, password: string) {\n    return request<AuthResult>(\"/api/auth/register\", json(\"POST\", { username, password }));\n  },\n  login(username: string, password: string) {\n    return request<AuthResult>(\"/api/auth/login\", json(\"POST\", { username, password }));\n  },\n  me() {\n    return request<{ username: string }>(\"/api/auth/me\");\n  },\n  getStats() {\n    return request<Stats>(\"/api/public/stats\");\n  },\n  listIncidents(params: {\n    severity?: string;\n    status?: string;\n    open?: boolean;\n    q?: string;\n    page: number;\n    page_size: number;\n  }) {\n    const query = new URLSearchParams();\n    if (params.severity) query.set(\"severity\", params.severity);\n    if (params.status) query.set(\"status\", params.status);\n    if (params.open) query.set(\"open\", \"true\");\n    if (params.q) query.set(\"q\", params.q);\n    query.set(\"page\", String(params.page));\n    query.set(\"page_size\", String(params.page_size));\n    return request<IncidentPage>(`/api/incidents?${query.toString()}`);\n  },\n  getIncident(id: number) {\n    return request<Incident>(`/api/incidents/${id}`);\n  },\n  createIncident(body: {\n    title: string;\n    service: string;\n    severity: string;\n    commander: string;\n    impact_summary: string;\n  }) {\n    return request<Incident>(\"/api/incidents\", json(\"POST\", body));\n  },\n  patchIncident(id: number, body: Record<string, unknown>) {\n    return request<Incident>(`/api/incidents/${id}`, json(\"PATCH\", body));\n  },\n  getTimeline(id: number) {\n    return request<TimelinePage>(`/api/incidents/${id}/timeline`);\n  },\n  postTimeline(id: number, body: { message: string; type?: string }) {\n    return request<TimelineEvent>(`/api/incidents/${id}/timeline`, json(\"POST\", body));\n  },\n};\n\nexport function formatDate(value: string | null): string {\n  if (!value) return \"—\";\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return value;\n  return date.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n  });\n}\n\nexport function severityLabel(severity: string): string {\n  return `SEV ${severity.replace(\"sev\", \"\")}`;\n}\n\nexport function severityBadge(severity: string): string {\n  switch (severity) {\n    case \"sev1\":\n      return \"bg-red-100 text-red-800 ring-red-200\";\n    case \"sev2\":\n      return \"bg-orange-100 text-orange-800 ring-orange-200\";\n    case \"sev3\":\n      return \"bg-amber-100 text-amber-800 ring-amber-200\";\n    case \"sev4\":\n      return \"bg-sky-100 text-sky-800 ring-sky-200\";\n    default:\n      return \"bg-slate-100 text-slate-700 ring-slate-200\";\n  }\n}\n\nexport function statusLabel(status: string): string {\n  return status.charAt(0).toUpperCase() + status.slice(1).replace(/_/g, \" \");\n}\n\nexport function statusBadge(status: string): string {\n  switch (status.toLowerCase()) {\n    case \"resolved\":\n      return \"bg-emerald-100 text-emerald-800 ring-emerald-200\";\n    case \"monitoring\":\n      return \"bg-blue-100 text-blue-800 ring-blue-200\";\n    case \"identified\":\n      return \"bg-violet-100 text-violet-800 ring-violet-200\";\n    case \"investigating\":\n      return \"bg-yellow-100 text-yellow-800 ring-yellow-200\";\n    default:\n      return \"bg-slate-100 text-slate-700 ring-slate-200\";\n  }\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794356091860,"end":1794356091868}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7f51bcf0016LNUTYQszYAI7F","sessionID":"ses_e3821fd4dffe681Iz1R8dCpOi8","messageID":"msg_1c7f4e4fe001DI6Iu09VXMGzaD"}}
