{"type":"tool_use","timestamp":1794312888874,"sessionID":"ses_e3aa442efffeiFRsQ6EM7ielYC","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-bd61516e515c05aa","state":{"status":"completed","input":{"content":"\"\"\"Account service with password reset: Flask API + static frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE = Path(__file__).resolve().parent.parent\nDIST = BASE / \"frontend\" / \"dist\"\nDATA_DIR = BASE / \"data\"\nDB_PATH = DATA_DIR / \"app.sqlite3\"\n\nMIN_PASSWORD_LENGTH = 8\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error=None):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS accounts (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                email TEXT,\n                email_key TEXT UNIQUE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS reset_tokens (\n                token_hash TEXT PRIMARY KEY,\n                account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL,\n                expires_at TEXT NOT NULL,\n                used_at TEXT\n            );\n            CREATE TABLE IF NOT EXISTS outbox (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                recipient TEXT NOT NULL,\n                subject TEXT NOT NULL,\n                body TEXT NOT NULL,\n                sent_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_outbox_recipient\n                ON outbox (recipient COLLATE NOCASE, id DESC);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef json_error(message: str, status: int):\n    return jsonify(error=message), status\n\n\ndef body() -> dict:\n    value = request.get_json(silent=True)\n    return value if isinstance(value, dict) else {}\n\n\ndef valid_password(password) -> bool:\n    return isinstance(password, str) and len(password) >= MIN_PASSWORD_LENGTH\n\n\ndef normalize_email(email) -> str | None:\n    if not isinstance(email, str):\n        return None\n    email = email.strip()\n    if not EMAIL_RE.fullmatch(email):\n        return None\n    return email\n\n\ndef token_hash(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef public_account(row: sqlite3.Row) -> dict:\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"email\": row[\"email\"]}\n\n\ndef current_account() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    return db().execute(\n        \"\"\"SELECT a.* FROM sessions s\n           JOIN accounts a ON a.id = s.account_id\n           WHERE s.token = ?\"\"\",\n        (token,),\n    ).fetchone()\n\n\ndef require_account():\n    account = current_account()\n    if account is None:\n        return None, json_error(\"Authentication required\", 401)\n    return account, None\n\n\ndef find_account(identifier: str) -> sqlite3.Row | None:\n    if not isinstance(identifier, str) or not identifier.strip():\n        return None\n    value = identifier.strip()\n    return db().execute(\n        \"SELECT * FROM accounts WHERE username = ? OR email_key = ?\",\n        (value, value.lower()),\n    ).fetchone()\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return json_error(\"Username is required\", 400)\n    username = username.strip()\n    if not valid_password(password):\n        return json_error(\n            f\"Password must be at least {MIN_PASSWORD_LENGTH} characters\", 400\n        )\n    email_value = data.get(\"email\")\n    if email_value in (None, \"\"):\n        email = None\n    else:\n        email = normalize_email(email_value)\n        if email is None:\n            return json_error(\"Invalid email address\", 400)\n\n    conn = db()\n    if conn.execute(\n        \"SELECT 1 FROM accounts WHERE username = ?\", (username,)\n    ).fetchone():\n        return json_error(\"Username already taken\", 409)\n    if email is not None and conn.execute(\n        \"SELECT 1 FROM accounts WHERE email_key = ?\", (email.lower(),)\n    ).fetchone():\n        return json_error(\"Email address already in use\", 409)\n\n    cur = conn.execute(\n        \"\"\"INSERT INTO accounts (username, password_hash, email, email_key, created_at)\n           VALUES (?, ?, ?, ?, ?)\"\"\",\n        (username, generate_password_hash(password), email,\n         email.lower() if email else None, utcnow()),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM accounts WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(public_account(row)), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"Invalid username or password\", 401)\n    row = db().execute(\n        \"SELECT * FROM accounts WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return json_error(\"Invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\n        \"INSERT INTO sessions (token, account_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    conn.commit()\n    return jsonify(token=token)\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    account, error = require_account()\n    if error:\n        return error\n    token = request.headers.get(\"Authorization\", \"\")[7:].strip()\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n    conn.commit()\n    return jsonify(status=\"ok\")\n\n\n@app.get(\"/api/me\")\ndef get_me():\n    account, error = require_account()\n    if error:\n        return error\n    return jsonify(public_account(account))\n\n\n@app.patch(\"/api/me\")\ndef patch_me():\n    account, error = require_account()\n    if error:\n        return error\n    data = body()\n    if \"email\" not in data:\n        return json_error(\"email is required\", 400)\n    raw = data[\"email\"]\n    if raw in (None, \"\"):\n        email = None\n    else:\n        email = normalize_email(raw)\n        if email is None:\n            return json_error(\"Invalid email address\", 400)\n\n    conn = db()\n    if email is not None and conn.execute(\n        \"SELECT 1 FROM accounts WHERE email_key = ? AND id != ?\",\n        (email.lower(), account[\"id\"]),\n    ).fetchone():\n        return json_error(\"Email address already in use\", 409)\n    conn.execute(\n        \"UPDATE accounts SET email = ?, email_key = ? WHERE id = ?\",\n        (email, email.lower() if email else None, account[\"id\"]),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM accounts WHERE id = ?\", (account[\"id\"],)).fetchone()\n    return jsonify(public_account(row))\n\n\n@app.post(\"/api/me/password\")\ndef change_password():\n    account, error = require_account()\n    if error:\n        return error\n    data = body()\n    current_password = data.get(\"current_password\")\n    new_password = data.get(\"new_password\")\n    if not isinstance(current_password, str) or not check_password_hash(\n        account[\"password_hash\"], current_password\n    ):\n        return json_error(\"Current password is incorrect\", 400)\n    if not valid_password(new_password):\n        return json_error(\n            f\"Password must be at least {MIN_PASSWORD_LENGTH} characters\", 400\n        )\n    conn = db()\n    conn.execute(\n        \"UPDATE accounts SET password_hash = ? WHERE id = ?\",\n        (generate_password_hash(new_password), account[\"id\"]),\n    )\n    conn.commit()\n    return jsonify(status=\"ok\")\n\n\n@app.post(\"/api/auth/password-reset\")\ndef password_reset():\n    data = body()\n    identifier = data.get(\"username\") or data.get(\"email\")\n    account = find_account(identifier) if identifier else None\n    if account is not None and account[\"email\"]:\n        token = secrets.token_urlsafe(32)\n        link = f\"/reset?token={token}\"\n        conn = db()\n        conn.execute(\n            \"INSERT INTO reset_tokens (token_hash, account_id, created_at, expires_at) \"\n            \"VALUES (?, ?, ?, ?)\",\n            (\n                token_hash(token),\n                account[\"id\"],\n                utcnow(),\n                datetime.fromtimestamp(\n                    datetime.now(timezone.utc).timestamp() + 3600, timezone.utc\n                ).isoformat(timespec=\"microseconds\"),\n            ),\n        )\n        conn.execute(\n            \"\"\"INSERT INTO outbox (recipient, subject, body, sent_at)\n               VALUES (?, ?, ?, ?)\"\"\",\n            (\n                account[\"email\"],\n                \"Reset your password\",\n                f\"Hello {account['username']},\\n\\n\"\n                f\"Use this single-use link to set a new password:\\n{link}\\n\\n\"\n                \"If you did not request this, you can ignore this message.\\n\",\n                utcnow(),\n            ),\n        )\n        conn.commit()\n    return jsonify(\n        message=\"If the account exists, a reset link is on its way\"\n    )\n\n\n@app.post(\"/api/auth/password-reset/confirm\")\ndef password_reset_confirm():\n    data = body()\n    token = data.get(\"token\")\n    new_password = data.get(\"new_password\")\n    if not isinstance(token, str) or not token:\n        return json_error(\"Invalid or expired token\", 400)\n    if not valid_password(new_password):\n        return json_error(\n            f\"Password must be at least {MIN_PASSWORD_LENGTH} characters\", 400\n        )\n    conn = db()\n    row = conn.execute(\n        \"SELECT * FROM reset_tokens WHERE token_hash = ?\", (token_hash(token),)\n    ).fetchone()\n    valid = (\n        row is not None\n        and row[\"used_at\"] is None\n        and hmac.compare_digest(row[\"expires_at\"], row[\"expires_at\"])\n        and datetime.fromisoformat(row[\"expires_at\"])\n        > datetime.now(timezone.utc)\n    )\n    if not valid:\n        return json_error(\"Invalid or expired token\", 400)\n    conn.execute(\n        \"UPDATE accounts SET password_hash = ? WHERE id = ?\",\n        (generate_password_hash(new_password), row[\"account_id\"]),\n    )\n    conn.execute(\n        \"UPDATE reset_tokens SET used_at = ? WHERE token_hash = ? AND used_at IS NULL\",\n        (utcnow(), row[\"token_hash\"]),\n    )\n    conn.execute(\n        \"DELETE FROM sessions WHERE account_id = ?\", (row[\"account_id\"],)\n    )\n    conn.commit()\n    return jsonify(status=\"ok\")\n\n\n@app.get(\"/api/outbox\")\ndef outbox():\n    to = request.args.get(\"to\")\n    if not to:\n        return jsonify(items=[])\n    rows = db().execute(\n        \"\"\"SELECT id, recipient AS \"to\", subject, body, sent_at\n           FROM outbox WHERE recipient = ? COLLATE NOCASE\n           ORDER BY id DESC\"\"\",\n        (to.strip(),),\n    ).fetchall()\n    return jsonify(items=[dict(row) for row in rows])\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if \"..\" in path.split(\"/\"):\n        return json_error(\"Not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794312888829,"end":1794312888851}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c561e1f6001NrdincuZ4ZYVCr","sessionID":"ses_e3aa442efffeiFRsQ6EM7ielYC","messageID":"msg_1c5618faa001hKklk6DuPXb10w"}}
