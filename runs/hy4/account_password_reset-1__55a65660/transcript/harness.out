{"type":"tool_use","timestamp":1794313106751,"sessionID":"ses_e3aa442efffeiFRsQ6EM7ielYC","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-88bd5711bc80ed74","state":{"status":"completed","input":{"content":"import type { ReactNode } from \"react\";\n\nexport type Account = {\n  id: number;\n  username: string;\n  email: string | null;\n};\n\nexport type OutboxMessage = {\n  id: number;\n  to: string;\n  subject: string;\n  body: string;\n  sent_at: string;\n};\n\nexport type ApiError = Error & { status: number };\n\nconst TOKEN_KEY = \"account_token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null): void {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.auth) {\n    const token = getToken();\n    if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n\n  const response = await fetch(path, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body === undefined ? undefined : JSON.stringify(options.body),\n  });\n\n  let payload: unknown = null;\n  try {\n    payload = await response.json();\n  } catch {\n    payload = null;\n  }\n\n  if (!response.ok) {\n    const message =\n      payload && typeof payload === \"object\" && \"error\" in payload\n        ? String((payload as { error: unknown }).error)\n        : `Request failed (${response.status})`;\n    const error = new Error(message) as ApiError;\n    error.status = response.status;\n    throw error;\n  }\n  return payload as T;\n}\n\nexport const api = {\n  register: (username: string, password: string, email: string) =>\n    request<Account>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: { username, password, email: email || null },\n    }),\n\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n    }),\n\n  logout: () =>\n    request<{ status: string }>(\"/api/auth/logout\", {\n      method: \"POST\",\n      auth: true,\n    }),\n\n  me: () => request<Account>(\"/api/me\", { auth: true }),\n\n  updateEmail: (email: string | null) =>\n    request<Account>(\"/api/me\", {\n      method: \"PATCH\",\n      auth: true,\n      body: { email },\n    }),\n\n  changePassword: (current_password: string, new_password: string) =>\n    request<{ status: string }>(\"/api/me/password\", {\n      method: \"POST\",\n      auth: true,\n      body: { current_password, new_password },\n    }),\n\n  requestReset: (identifier: string) =>\n    request<{ message: string }>(\"/api/auth/password-reset\", {\n      method: \"POST\",\n      body: { username: identifier },\n    }),\n\n  confirmReset: (token: string, new_password: string) =>\n    request<{ status: string }>(\"/api/auth/password-reset/confirm\", {\n      method: \"POST\",\n      body: { token, new_password },\n    }),\n\n  outbox: (to: string) =>\n    request<{ items: OutboxMessage[] }>(\n      `/api/outbox?to=${encodeURIComponent(to)}`,\n    ),\n};\n\nexport function errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : \"Something went wrong\";\n}\n\nexport function isReactNode(value: unknown): value is ReactNode {\n  return (\n    value === null ||\n    value === undefined ||\n    typeof value === \"string\" ||\n    typeof value === \"number\" ||\n    typeof value === \"boolean\"\n  );\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794313106707,"end":1794313106734}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c565350a001UHPtscSMuv3JNf","sessionID":"ses_e3aa442efffeiFRsQ6EM7ielYC","messageID":"msg_1c565111e001uNKR0So9HZLAHr"}}
