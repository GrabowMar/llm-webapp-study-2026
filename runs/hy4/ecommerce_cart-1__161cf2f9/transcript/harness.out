{"type":"text","timestamp":1794381323602,"sessionID":"ses_e3692dd26ffeFUVIJ5GoNcDUdt","part":{"id":"prt_1c9761d3c001i5udgQnBLM0MZ8","messageID":"msg_1c972ca4e001i5qsWHaIO1L4hU","sessionID":"ses_e3692dd26ffeFUVIJ5GoNcDUdt","type":"text","text":"Now the backend. I'll write the full Flask API with SQLite.","time":{"start":1794381323580,"end":1794381323598}}}
{"type":"tool_use","timestamp":1794381323674,"sessionID":"ses_e3692dd26ffeFUVIJ5GoNcDUdt","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a1dcefe52fec998c","state":{"status":"completed","input":{"content":"\"\"\"Shop API: accounts, catalogue, carts and administration.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE = Path(__file__).resolve().parent.parent\nDIST = BASE / \"frontend\" / \"dist\"\nDB_PATH = Path(os.environ.get(\"SHOP_DB\") or (BASE / \"data\" / \"shop.sqlite3\"))\n\nSEED_PRODUCTS = [\n    (1, \"Alpine Water Bottle\", \"Insulated stainless steel bottle, 750 ml.\", \"14.99\", 40),\n    (2, \"Bamboo Cutting Board\", \"Durable, knife-friendly bamboo board.\", \"24.50\", 25),\n    (3, \"Ceramic Coffee Mug\", \"Hand-glazed mug, holds 350 ml.\", \"9.75\", 60),\n    (4, \"Cotton Tote Bag\", \"Reusable heavyweight cotton tote.\", \"12\", 35),\n    (5, \"Desk Lamp\", \"Adjustable LED lamp with warm light.\", \"39.95\", 18),\n    (6, \"Espresso Beans 1kg\", \"Medium roast whole beans.\", \"22\", 30),\n    (7, \"Linen Notebook\", \"Hardcover, 200 dotted pages.\", \"8.50\", 50),\n    (8, \"Olive Wood Spoon\", \"Hand-carved serving spoon.\", \"7.25\", 45),\n    (9, \"Stainless Steel Pen\", \"Refillable ballpoint with gift box.\", \"16\", 22),\n    (10, \"Wireless Mouse\", \"Ergonomic, silent-click wireless mouse.\", \"29.99\", 15),\n]\n\napp = Flask(__name__, static_folder=None)\napp.url_map.strict_slashes = False\napp.config[\"JSON_SORT_KEYS\"] = False\n\n\ndef db_connect() -> sqlite3.Connection:\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(str(DB_PATH), timeout=10)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 10000\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = db_connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\nCREATE TABLE IF NOT EXISTS products (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    price TEXT NOT NULL DEFAULT '0',\n    stock INTEGER NOT NULL DEFAULT 0,\n    is_active INTEGER NOT NULL DEFAULT 1,\n    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\nCREATE TABLE IF NOT EXISTS cart_items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id),\n    product_id INTEGER NOT NULL REFERENCES products(id),\n    quantity INTEGER NOT NULL,\n    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    UNIQUE (user_id, product_id)\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id),\n    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\"\"\"\n\n\ndef initialise() -> None:\n    conn = db_connect()\n    try:\n        conn.executescript(SCHEMA)\n        for pid, name, description, price, stock in SEED_PRODUCTS:\n            conn.execute(\n                \"INSERT OR IGNORE INTO products (id, name, description, price, stock, is_active) \"\n                \"VALUES (?, ?, ?, ?, ?, 1)\",\n                (pid, name, description, price, stock),\n            )\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n        secret = admin_password if admin_password else secrets.token_urlsafe(48)\n        admin_hash = generate_password_hash(secret)\n        row = conn.execute(\n            \"SELECT id FROM users WHERE username = 'admin' COLLATE NOCASE\"\n        ).fetchone()\n        if row is None:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n                (admin_hash,),\n            )\n        else:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (admin_hash, row[\"id\"]),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninitialise()\n\n\ndef api_error(status: int, message: str):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\ndef body() -> dict:\n    data = request.get_json(force=True, silent=True)\n    if not isinstance(data, dict):\n        raise ValueError(\"A JSON object is required\")\n    return data\n\n\ndef first_present(data: dict, *keys: str):\n    for key in keys:\n        if key in data and data[key] is not None:\n            return data[key]\n    return None\n\n\ndef parse_id(value) -> int:\n    if isinstance(value, bool):\n        raise ValueError(\"A valid id is required\")\n    try:\n        result = int(value)\n    except (TypeError, ValueError):\n        raise ValueError(\"A valid id is required\")\n    if result < 1:\n        raise ValueError(\"A valid id is required\")\n    return result\n\n\ndef parse_quantity(value) -> int:\n    if value is None:\n        raise ValueError(\"quantity must be a positive integer\")\n    if isinstance(value, bool):\n        raise ValueError(\"quantity must be a positive integer\")\n    if isinstance(value, int):\n        result = value\n    elif isinstance(value, float):\n        if not value.is_integer():\n            raise ValueError(\"quantity must be a positive integer\")\n        result = int(value)\n    elif isinstance(value, str):\n        try:\n            result = int(value.strip())\n        except ValueError:\n            raise ValueError(\"quantity must be a positive integer\")\n    else:\n        raise ValueError(\"quantity must be a positive integer\")\n    if result < 1:\n        raise ValueError(\"quantity must be a positive integer\")\n    if result > 1_000_000:\n        raise ValueError(\"quantity is too large\")\n    return result\n\n\ndef parse_price(value) -> str:\n    if isinstance(value, bool) or not isinstance(value, (int, float, str)):\n        raise ValueError(\"price must be a non-negative number\")\n    try:\n        number = Decimal(str(value).strip())\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"price must be a non-negative number\")\n    if not number.is_finite() or number < 0:\n        raise ValueError(\"price must be a non-negative number\")\n    return str(number)\n\n\ndef parse_stock(value) -> int:\n    if isinstance(value, bool) or not isinstance(value, (int, float, str)):\n        raise ValueError(\"stock must be a non-negative integer\")\n    try:\n        number = Decimal(str(value).strip())\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"stock must be a non-negative integer\")\n    if not number.is_finite() or number < 0 or number != number.to_integral_value():\n        raise ValueError(\"stock must be a non-negative integer\")\n    return int(number)\n\n\ndef parse_bool(value, field: str = \"is_active\") -> int:\n    if isinstance(value, bool):\n        return int(value)\n    if isinstance(value, int) and value in (0, 1):\n        return value\n    if isinstance(value, str):\n        lowered = value.strip().lower()\n        if lowered in (\"true\", \"1\", \"yes\", \"on\"):\n            return 1\n        if lowered in (\"false\", \"0\", \"no\", \"off\"):\n            return 0\n    raise ValueError(f\"{field} must be a boolean\")\n\n\ndef parse_positive_arg(value, default: int, maximum: int = 200) -> int:\n    if value is None:\n        return default\n    try:\n        result = int(value)\n    except (TypeError, ValueError):\n        return default\n    if result < 1:\n        return default\n    return min(result, maximum)\n\n\ndef price_number(text: str):\n    number = Decimal(text)\n    if number == number.to_integral_value():\n        return int(number)\n    return float(number)\n\n\ndef product_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": price_number(row[\"price\"]),\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\ndef cart_payload(user_id: int) -> dict:\n    rows = get_db().execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price \"\n        \"FROM cart_items ci JOIN products p ON p.id = ci.product_id \"\n        \"WHERE ci.user_id = ? AND p.is_active = 1 ORDER BY ci.id ASC\",\n        (user_id,),\n    ).fetchall()\n    items = []\n    for row in rows:\n        unit_price = price_number(row[\"price\"])\n        items.append(\n            {\n                \"id\": row[\"id\"],\n                \"product_id\": row[\"product_id\"],\n                \"quantity\": row[\"quantity\"],\n                \"name\": row[\"name\"],\n                \"unit_price\": unit_price,\n                \"line_total\": unit_price * row[\"quantity\"],\n            }\n        )\n    return {\"items\": items, \"subtotal\": sum(item[\"line_total\"] for item in items)}\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    return get_db().execute(\n        \"SELECT u.id, u.username, u.is_admin FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(36)\n    get_db().execute(\n        \"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id)\n    )\n    get_db().commit()\n    return token\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, api_error(401, \"Authentication required\")\n    return user, None\n\n\ndef require_admin():\n    user, failure = require_user()\n    if failure is not None:\n        return None, failure\n    if not user[\"is_admin\"]:\n        return None, api_error(403, \"Administrator access required\")\n    return user, None\n\n\n@app.after_request\ndef add_cors(response):\n    response.headers[\"Access-Control-Allow-Origin\"] = \"*\"\n    response.headers[\"Access-Control-Allow-Headers\"] = \"Authorization, Content-Type\"\n    response.headers[\"Access-Control-Allow-Methods\"] = \"GET, POST, PATCH, DELETE, OPTIONS\"\n    return response\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"OPTIONS\"])\n@app.route(\"/api\", methods=[\"OPTIONS\"])\ndef api_options(_path: str = \"\"):\n    return jsonify({})\n\n\n@app.get(\"/api/health\")\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    try:\n        data = body()\n        username = str(data.get(\"username\") or \"\").strip()\n        password = data.get(\"password\")\n        if not username:\n            return api_error(400, \"username is required\")\n        if len(username) > 100:\n            return api_error(400, \"username is too long\")\n        if not isinstance(password, str) or not password:\n            return api_error(400, \"password is required\")\n        if username.lower() == \"admin\":\n            return api_error(409, \"That username is reserved\")\n    except ValueError as exc:\n        return api_error(400, str(exc))\n\n    db = get_db()\n    if db.execute(\n        \"SELECT 1 FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone():\n        return api_error(409, \"Username already taken\")\n    cursor = db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n        (username, generate_password_hash(password)),\n    )\n    user_id = cursor.lastrowid\n    token = issue_token(user_id)\n    return (\n        jsonify(\n            {\n                \"id\": user_id,\n                \"username\": username,\n                \"is_admin\": False,\n                \"token\": token,\n            }\n        ),\n        201,\n    )\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    try:\n        data = body()\n        username = str(data.get(\"username\") or \"\").strip()\n        password = data.get(\"password\")\n        if not isinstance(password, str):\n            password = \"\"\n    except ValueError as exc:\n        return api_error(400, str(exc))\n\n    row = get_db().execute(\n        \"SELECT id, username, password_hash, is_admin FROM users \"\n        \"WHERE username = ? COLLATE NOCASE\",\n        (username,),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return api_error(401, \"Invalid username or password\")\n    token = issue_token(row[\"id\"])\n    return jsonify(\n        {\n            \"token\": token,\n            \"username\": row[\"username\"],\n            \"is_admin\": bool(row[\"is_admin\"]),\n        }\n    )\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    return jsonify(\n        {\n            \"id\": user[\"id\"],\n            \"username\": user[\"username\"],\n            \"is_admin\": bool(user[\"is_admin\"]),\n        }\n    )\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    token = request.headers.get(\"Authorization\", \"\")[7:].strip()\n    get_db().execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    get_db().commit()\n    return jsonify({\"username\": user[\"username\"], \"signed_out\": True})\n\n\n@app.get(\"/api/products\")\ndef list_products():\n    db = get_db()\n    query = (request.args.get(\"q\") or \"\").strip()\n    page = parse_positive_arg(request.args.get(\"page\"), 1)\n    page_size = parse_positive_arg(request.args.get(\"page_size\"), 20)\n    where = \"is_active = 1\"\n    params: list = []\n    if query:\n        escaped = query.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        where += \" AND name LIKE ? ESCAPE '\\\\'\"\n        params.append(f\"%{escaped}%\")\n    total = db.execute(\n        f\"SELECT COUNT(*) AS n FROM products WHERE {where}\", params\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        f\"SELECT * FROM products WHERE {where} ORDER BY name ASC, id ASC \"\n        \"LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [product_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef get_product(product_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return api_error(404, \"Product not found\")\n    return jsonify(product_dict(row))\n\n\n@app.get(\"/api/admin/products\")\ndef admin_list_products():\n    _, failure = require_admin()\n    if failure is not None:\n        return failure\n    rows = get_db().execute(\n        \"SELECT * FROM products ORDER BY name ASC, id ASC\"\n    ).fetchall()\n    items = [product_dict(row) for row in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\n@app.post(\"/api/admin/products\")\ndef admin_create_product():\n    _, failure = require_admin()\n    if failure is not None:\n        return failure\n    try:\n        data = body()\n        name = str(data.get(\"name\") or \"\").strip()\n        if not name:\n            return api_error(400, \"name is required\")\n        description = str(data.get(\"description\") or \"\")\n        price = parse_price(data.get(\"price\", 0))\n        stock = parse_stock(data.get(\"stock\", 0))\n        active_value = first_present(data, \"is_active\", \"active\")\n        is_active = parse_bool(active_value) if active_value is not None else 1\n    except ValueError as exc:\n        return api_error(400, str(exc))\n\n    cursor = get_db().execute(\n        \"INSERT INTO products (name, description, price, stock, is_active) \"\n        \"VALUES (?, ?, ?, ?, ?)\",\n        (name, description, price, stock, is_active),\n    )\n    get_db().commit()\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(product_dict(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\ndef admin_update_product(product_id: int):\n    _, failure = require_admin()\n    if failure is not None:\n        return failure\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM products WHERE id = ?\", (product_id,)).fetchone() is None:\n        return api_error(404, \"Product not found\")\n    try:\n        data = body()\n        updates: list[str] = []\n        values: list = []\n        if \"name\" in data:\n            name = str(data.get(\"name\") or \"\").strip()\n            if not name:\n                return api_error(400, \"name is required\")\n            updates.append(\"name = ?\")\n            values.append(name)\n        if \"description\" in data:\n            updates.append(\"description = ?\")\n            values.append(str(data.get(\"description\") or \"\"))\n        if \"price\" in data:\n            updates.append(\"price = ?\")\n            values.append(parse_price(data[\"price\"]))\n        if \"stock\" in data:\n            updates.append(\"stock = ?\")\n            values.append(parse_stock(data[\"stock\"]))\n        active_value = first_present(data, \"is_active\", \"active\")\n        if active_value is not None:\n            updates.append(\"is_active = ?\")\n            values.append(parse_bool(active_value))\n    except ValueError as exc:\n        return api_error(400, str(exc))\n\n    if updates:\n        values.append(product_id)\n        db.execute(f\"UPDATE products SET {', '.join(updates)} WHERE id = ?\", values)\n        db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return jsonify(product_dict(row))\n\n\n@app.get(\"/api/cart\")\ndef get_cart():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    return jsonify(cart_payload(user[\"id\"]))\n\n\n@app.post(\"/api/cart\")\ndef add_to_cart():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    try:\n        data = body()\n        product_id = parse_id(first_present(data, \"product_id\", \"productId\", \"product\", \"id\"))\n        quantity = parse_quantity(first_present(data, \"quantity\", \"qty\") or 1)\n    except ValueError as exc:\n        return api_error(400, str(exc))\n\n    db = get_db()\n    if db.execute(\n        \"SELECT 1 FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone() is None:\n        return api_error(404, \"Product not found\")\n    existing = db.execute(\n        \"SELECT id FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (user[\"id\"], product_id),\n    ).fetchone()\n    if existing is None:\n        db.execute(\n            \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n            (user[\"id\"], product_id, quantity),\n        )\n    else:\n        db.execute(\n            \"UPDATE cart_items SET quantity = quantity + ? WHERE id = ?\",\n            (quantity, existing[\"id\"]),\n        )\n    db.commit()\n    return jsonify(cart_payload(user[\"id\"]))\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\ndef update_cart_item(item_id: int):\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    try:\n        data = body()\n        quantity = parse_quantity(first_present(data, \"quantity\", \"qty\"))\n    except ValueError as exc:\n        return api_error(400, str(exc))\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id FROM cart_items WHERE id = ? AND user_id = ?\",\n        (item_id, user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return api_error(404, \"Cart item not found\")\n    db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n    db.commit()\n    return jsonify(cart_payload(user[\"id\"]))\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\ndef delete_cart_item(item_id: int):\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    db = get_db()\n    row = db.execute(\n        \"SELECT id FROM cart_items WHERE id = ? AND user_id = ?\",\n        (item_id, user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return api_error(404, \"Cart item not found\")\n    db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    db.commit()\n    return jsonify(cart_payload(user[\"id\"]))\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return api_error(404, \"Not found\")\n    parts = Path(path).parts\n    candidate = path if parts and \"..\" not in parts else \"\"\n    if candidate and (DIST / candidate).is_file():\n        return send_from_directory(DIST, candidate)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return \"<!doctype html><title>Shop</title><p>Frontend build not found.</p>\", 404\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794381323592,"end":1794381323625}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9761d40001WECzHyyBJjwkNN","sessionID":"ses_e3692dd26ffeFUVIJ5GoNcDUdt","messageID":"msg_1c972ca4e001i5qsWHaIO1L4hU"}}
