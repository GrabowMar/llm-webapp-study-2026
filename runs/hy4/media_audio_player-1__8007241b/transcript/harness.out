': 'Artist B', 'url': 'http://example.com/b.mp3', 'duration': '3:45', 'play_count': 0, 'created_at': '2026-11-11T06:09:52.425611Z', 'added_by': 'alice'}, {'id': 2, 'title': 'Song A', 'artist': 'Artist A', 'url': 'https://example.com/a.mp3', 'duration': 123, 'play_count': 0, 'created_at': '2026-11-11T06:09:52.422640Z', 'added_by': 'alice'}], 'total': 3, 'page': 1, 'page_size': 20}\nbad token: 401 {'error': 'Authentication required'}\n","exit":0,"truncated":false},"title":"cd /workspace && python3 - <<'PY'\nimport os, tempfile\nos.environ[\"DATA_DIR\"] = tempfile.mkdtemp()\nfrom backend import app as m\nc = m.app.test_client()\n\ndef show(label, r):\n    print(f\"{label}: {r.status_code} {r.get_json(silent=True)}\")\n\nshow(\"health\", c.get(\"/api/health\"))\nshow(\"register bad\", c.post(\"/api/auth/register\", json={\"username\":\"\",\"password\":\"\"}))\nshow(\"register\", c.post(\"/api/auth/register\", json={\"username\":\"alice\",\"password\":\"pw1\"}))\nshow(\"duplicate\", c.post(\"/api/auth/register\", json={\"username\":\"alice\",\"password\":\"pw1\"}))\nshow(\"login bad\", c.post(\"/api/auth/login\", json={\"username\":\"alice\",\"password\":\"nope\"}))\nlogin = c.post(\"/api/auth/login\", json={\"username\":\"alice\",\"password\":\"pw1\"})\nshow(\"login\", login)\ntoken = login.get_json()[\"token\"]\nauth = {\"Authorization\": f\"Bearer {token}\"}\nshow(\"no auth add\", c.post(\"/api/tracks\", json={\"title\":\"t\",\"artist\":\"a\",\"url\":\"https://x/y.mp3\"}))\nshow(\"bad url\", c.post(\"/api/tracks\", headers=auth, json={\"title\":\"t\",\"artist\":\"a\",\"url\":\"ftp://x/y.mp3\"}))\nshow(\"bad duration\", c.post(\"/api/tracks\", headers=auth, json={\"title\":\"t\",\"artist\":\"a\",\"url\":\"https://x/y.mp3\",\"duration\":\"abc\"}))\nshow(\"add num\", c.post(\"/api/tracks\", headers=auth, json={\"title\":\"Song A\",\"artist\":\"Artist A\",\"url\":\"https://example.com/a.mp3\",\"duration\":123}))\nshow(\"add str\", c.post(\"/api/tracks\", headers=auth, json={\"title\":\"Song B\",\"artist\":\"Artist B\",\"url\":\"http://example.com/b.mp3\",\"duration\":\"3:45\"}))\nshow(\"add float\", c.post(\"/api/tracks\", headers=auth, json={\"title\":\"Song C\",\"artist\":\"Artist C\",\"url\":\"https://example.com/c.mp3\",\"duration\":201.5}))\nshow(\"list\", c.get(\"/api/tracks\"))\nshow(\"list q\", c.get(\"/api/tracks?q=Song+B\"))\nshow(\"list paged\", c.get(\"/api/tracks?page=1&page_size=2\"))\nshow(\"get one\", c.get(\"/api/tracks/1\"))\nshow(\"get missing\", c.get(\"/api/tracks/999\"))\nshow(\"play\", c.post(\"/api/tracks/1/plays\"))\nshow(\"play again\", c.post(\"/api/tracks/1/plays\"))\nshow(\"play missing\", c.post(\"/api/tracks/999/plays\"))\nshow(\"register bob\", c.post(\"/api/auth/register\", json={\"username\":\"bob\",\"password\":\"pw2\"}))\nbob = c.post(\"/api/auth/login\", json={\"username\":\"bob\",\"password\":\"pw2\"}).get_json()[\"token\"]\nbob_auth = {\"Authorization\": f\"Bearer {bob}\"}\nshow(\"bob delete alice\", c.delete(\"/api/tracks/1\", headers=bob_auth))\nshow(\"anon delete\", c.delete(\"/api/tracks/1\"))\nshow(\"alice delete\", c.delete(\"/api/tracks/1\", headers=auth))\nshow(\"delete missing\", c.delete(\"/api/tracks/1\", headers=auth))\nshow(\"list after\", c.get(\"/api/tracks\"))\nshow(\"bad token\", c.post(\"/api/tracks\", headers={\"Authorization\":\"Bearer junk\"}, json={\"title\":\"t\",\"artist\":\"a\",\"url\":\"https://x/y.mp3\"}))\nPY","time":{"start":1794377391779,"end":1794377392717}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c93a1e9a001dgCrXgdJng16B6","sessionID":"ses_e36ca42c9ffez4qxwG6AyUIxIX","messageID":"msg_1c939ef7a001hOQlzlVA50ceqM"}}
