lueError:\n        return error(\"invalid pagination\", 400)\n    if page < 1 or page_size < 1:\n        return error(\"invalid pagination\", 400)\n    page_size = min(page_size, MAX_PAGE_SIZE)\n\n    clause = \" AND \".join(where)\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM notifications WHERE {clause}\", params\n    ).fetchone()[0]\n    unread_count = conn.execute(\n        \"SELECT COUNT(*) FROM notifications WHERE user_id = ? AND read = 0\", (user_id,)\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM notifications WHERE {clause} \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",","lineStart":245,"lineEnd":289,"totalLines":414,"truncated":true}},"title":"backend/app.py","time":{"start":1794349618096,"end":1794349618110}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c79253a8001cShSWKs02KgvCK","sessionID":"ses_e38784a86ffeHKjslskyGLBfNt","messageID":"msg_1c79114e1001YO6Ky3Gjim1ZwR"}}
