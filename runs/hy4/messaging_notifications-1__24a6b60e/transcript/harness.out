{"type":"tool_use","timestamp":1794349194710,"sessionID":"ses_e38784a86ffeHKjslskyGLBfNt","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-881267280919de73","state":{"status":"completed","input":{"content":"\"\"\"Notification center: Flask API, SQLite storage and static frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"notifications.db\"\n\nDEFAULT_TYPE = \"info\"\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=10)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 10000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exception=None):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=10)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id            INTEGER PRIMARY KEY AUTOINCREMENT,\n                username      TEXT NOT NULL UNIQUE,\n                password_hash TEXT,\n                is_admin      INTEGER NOT NULL DEFAULT 0\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token   TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n            );\n\n            CREATE TABLE IF NOT EXISTS notifications (\n                id         INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                message    TEXT NOT NULL,\n                type       TEXT NOT NULL,\n                read       INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_notifications_user\n                ON notifications (user_id, created_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_notifications_unread\n                ON notifications (user_id, read);\n            \"\"\"\n        )\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        admin_hash = generate_password_hash(admin_password) if admin_password else None\n        conn.execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, is_admin)\n            VALUES ('admin', ?, 1)\n            ON CONFLICT(username) DO UPDATE\n                SET password_hash = excluded.password_hash, is_admin = 1\n            \"\"\",\n            (admin_hash,),\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    response = jsonify({\"error\": message})\n    if status == 401:\n        response.headers[\"WWW-Authenticate\"] = \"Bearer\"\n    return response, status\n\n\ndef body() -> dict | None:\n    data = request.get_json(force=True, silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef parse_bool(value) -> bool | None:\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    if isinstance(value, str):\n        lowered = value.strip().lower()\n        if lowered in (\"true\", \"1\", \"yes\", \"on\"):\n            return True\n        if lowered in (\"false\", \"0\", \"no\", \"off\"):\n            return False\n    return None\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    return db().execute(\n        \"\"\"\n        SELECT u.id, u.username, u.is_admin, u.password_hash\n        FROM tokens t JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return error(\"admin only\", 403)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef notification_fields(data: dict):\n    message = data.get(\"message\")\n    if not isinstance(message, str) or message == \"\":\n        return None\n    notification_type = data.get(\"type\", DEFAULT_TYPE)\n    if notification_type is None:\n        notification_type = DEFAULT_TYPE\n    if not isinstance(notification_type, str) or notification_type == \"\":\n        notification_type = DEFAULT_TYPE\n    return message, notification_type\n\n\n@app.get(\"/api/health\")\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip() or len(username) > 150:\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or password == \"\":\n        return error(\"password is required\", 400)\n    if username.strip().lower() == \"admin\":\n        return error(\"username is reserved\", 409)\n    conn = db()\n    try:\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n            (username, generate_password_hash(password)),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"invalid credentials\", 401)\n    conn = db()\n    user = conn.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    if user is None or not user[\"password_hash\"] or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    conn.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    token = request.headers[\"Authorization\"][7:].strip()\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    conn.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/notifications\")\n@login_required\ndef list_notifications():\n    conn = db()\n    user_id = g.user[\"id\"]\n    where = [\"user_id = ?\"]\n    params: list = [user_id]\n\n    read_value = request.args.get(\"read\")\n    if read_value is not None and read_value.strip().lower() not in (\"\", \"all\"):\n        read = parse_bool(read_value)\n        if read is None:\n            return error(\"invalid read filter\", 400)\n        where.append(\"read = ?\")\n        params.append(int(read))\n\n    type_value = request.args.get(\"type\")\n    if type_value is not None and type_value != \"\":\n        where.append(\"type = ?\")\n        params.append(type_value)\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n    except ValueError:\n        return error(\"invalid pagination\", 400)\n    if page < 1 or page_size < 1:\n        return error(\"invalid pagination\", 400)\n    page_size = min(page_size, MAX_PAGE_SIZE)\n\n    clause = \" AND \".join(where)\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM notifications WHERE {clause}\", params\n    ).fetchone()[0]\n    unread_count = conn.execute(\n        \"SELECT COUNT(*) FROM notifications WHERE user_id = ? AND read = 0\", (user_id,)\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM notifications WHERE {clause} \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread_count,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@login_required\ndef create_notification():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    fields = notification_fields(data)\n    if fields is None:\n        return error(\"message is required\", 400)\n    message, notification_type = fields\n    conn = db()\n    cursor = conn.execute(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n        \"VALUES (?, ?, ?, 0, ?)\",\n        (g.user[\"id\"], message, notification_type, utc_now()),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@login_required\ndef read_all():\n    conn = db()\n    cursor = conn.execute(\n        \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\", (g.user[\"id\"],)\n    )\n    conn.commit()\n    return jsonify({\"updated\": cursor.rowcount})\n\n\ndef owned_notification(notification_id: int):\n    return db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, g.user[\"id\"]),\n    ).fetchone()\n\n\n@app.get(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef get_notification(notification_id: int):\n    row = owned_notification(notification_id)\n    if row is None:\n        return error(\"notification not found\", 404)\n    return jsonify(serialize(row))\n\n\n@app.patch(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef patch_notification(notification_id: int):\n    row = owned_notification(notification_id)\n    if row is None:\n        return error(\"notification not found\", 404)\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    read = parse_bool(data.get(\"read\"))\n    if read is None:\n        return error(\"read must be a boolean\", 400)\n    conn = db()\n    conn.execute(\"UPDATE notifications SET read = ? WHERE id = ?\", (int(read), row[\"id\"]))\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (row[\"id\"],)).fetchone()\n    return jsonify(serialize(row))\n\n\n@app.delete(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef delete_notification(notification_id: int):\n    row = owned_notification(notification_id)\n    if row is None:\n        return error(\"notification not found\", 404)\n    conn = db()\n    conn.execute(\"DELETE FROM notifications WHERE id = ?\", (row[\"id\"],))\n    conn.commit()\n    return jsonify({\"deleted\": True, \"id\": row[\"id\"]})\n\n\n@app.post(\"/api/admin/broadcast\")\n@admin_required\ndef broadcast():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    fields = notification_fields(data)\n    if fields is None:\n        return error(\"message is required\", 400)\n    message, notification_type = fields\n    conn = db()\n    users = conn.execute(\"SELECT id FROM users WHERE is_admin = 0 ORDER BY id\").fetchall()\n    created_at = utc_now()\n    conn.executemany(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n        \"VALUES (?, ?, ?, 0, ?)\",\n        [(row[\"id\"], message, notification_type, created_at) for row in users],\n    )\n    conn.commit()\n    return jsonify({\"delivered\": len(users)})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794349194681,"end":1794349194692}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c78bddb3001uDO0PaO0C0VOSM","sessionID":"ses_e38784a86ffeHKjslskyGLBfNt","messageID":"msg_1c78a3b55001hRg29XZl3M6VxP"}}
