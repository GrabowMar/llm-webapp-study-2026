ssion(next);\n    setPage(1);\n    setData(null);\n    setError(\"\");\n  }\n\n  async function signOut() {\n    if (session) {\n      try {\n        await api.logout(session.token);\n      } catch {\n        // best effort; local sign-out always proceeds\n      }\n    }\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USERNAME_KEY);\n    setSession(null);\n    setData(null);\n  }\n\n  async function runAction(id: number, action: () => Promise<unknown>, extra?: () => void) {\n    if (!session) return;\n    setBusyId(id);\n    setActionError(\"\");\n    try {\n      await action();\n      extra?.();\n      await refresh();\n    } catch (err) {\n      setActionError(messageOf(err));\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  async function addNotification(message: string, type: string) {\n    if (session) {\n      await api.create(message, type, session.token);\n      setPage(1);\n      await refresh();\n    }\n  }\n\n  async function broadcast(message: string, type: string) {\n    if (session) await api.broadcast(message, type, session.token);\n  }\n","lineStart":283,"lineEnd":352,"totalLines":590,"truncated":true}},"title":"frontend/src/App.tsx","time":{"start":1794349454309,"end":1794349454332}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c78fd3df001PNTlBUzvn5fK5g","sessionID":"ses_e38784a86ffeHKjslskyGLBfNt","messageID":"msg_1c78fbc78001kU7mx4xL7DGc73"}}
