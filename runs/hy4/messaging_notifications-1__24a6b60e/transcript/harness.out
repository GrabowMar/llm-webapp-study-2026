{"type":"tool_use","timestamp":1794349630259,"sessionID":"ses_e38784a86ffeHKjslskyGLBfNt","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-97a0606ca63512dd","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Notification center: Flask API, SQLite storage and static frontend serving.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import secrets\n7: import sqlite3\n8: from datetime import datetime, timezone\n9: from functools import wraps\n10: from pathlib import Path\n11: \n12: from flask import Flask, g, jsonify, request, send_from_directory\n13: from werkzeug.security import check_password_hash, generate_password_hash\n14: \n15: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n16: DATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\n17: DB_PATH = DATA_DIR / \"notifications.db\"\n18: \n19: DEFAULT_TYPE = \"info\"\n20: DEFAULT_PAGE_SIZE = 20\n21: \n22: app = Flask(__name__, static_folder=None)\n23: app.json.sort_keys = False\n24: \n25: \n26: def db() -> sqlite3.Connection:\n27:     if \"db\" not in g:\n28:         DATA_DIR.mkdir(parents=True, exist_ok=True)\n29:         conn = sqlite3.connect(DB_PATH, timeout=10)\n30:         conn.row_factory = sqlite3.Row\n31:         conn.execute(\"PRAGMA foreign_keys = ON\")\n32:         conn.execute(\"PRAGMA busy_timeout = 10000\")\n33:         g.db = conn\n34:     return g.db\n35: \n36: \n37: @app.teardown_appcontext\n38: def close_db(_exception=None):\n39:     conn = g.pop(\"db\", None)\n40:     if conn is not None:\n41:         conn.close()\n42: \n43: \n44: def init_db() -> None:\n45:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n46:     conn = sqlite3.connect(DB_PATH, timeout=10)\n47:     try:\n48:         conn.execute(\"PRAGMA journal_mode = WAL\")\n49:         conn.execute(\"PRAGMA foreign_keys = ON\")\n50:         conn.executescript(\n51:             \"\"\"\n52:             CREATE TABLE IF NOT EXISTS users (\n53:                 id            INTEGER PRIMARY KEY AUTOINCREMENT,\n54:                 username      TEXT NOT NULL UNIQUE,\n55:                 password_hash TEXT,\n56:                 is_admin      INTEGER NOT NULL DEFAULT 0\n57:             );\n58: \n59:             CREATE TABLE IF NOT EXISTS tokens (\n60:                 token   TEXT PRIMARY KEY,\n61:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n62:             );\n63: \n64:             CREATE TABLE IF NOT EXISTS notifications (\n65:                 id         INTEGER PRIMARY KEY AUTOINCREMENT,\n66:                 user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n67:                 message    TEXT NOT NULL,\n68:                 type       TEXT NOT NULL,\n69:                 read       INTEGER NOT NULL DEFAULT 0,\n70:                 created_at TEXT NOT NULL\n71:             );\n72: \n73:             CREATE INDEX IF NOT EXISTS idx_notifications_user\n74:                 ON notifications (user_id, created_at DESC, id DESC);\n75:             CREATE INDEX IF NOT EXISTS idx_notifications_unread\n76:                 ON notifications (user_id, read);\n77:             \"\"\"\n78:         )\n79:         admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n80:         admin_hash = generate_password_hash(admin_password) if admin_password else None\n81:         conn.execute(\n82:             \"\"\"\n83:             INSERT INTO users (username, password_hash, is_admin)\n84:             VALUES ('admin', ?, 1)\n85:             ON CONFLICT(username) DO UPDATE\n86:                 SET password_hash = excluded.password_hash, is_admin = 1\n87:             \"\"\",\n88:             (admin_hash,),\n89:         )\n90:         conn.commit()\n91:     finally:\n92:         conn.close()\n93: \n94: \n95: def error(message: str, status: int):\n96:     response = jsonify({\"error\": message})\n97:     if status == 401:\n98:         response.headers[\"WWW-Authenticate\"] = \"Bearer\"\n99:     return response, status\n100: \n101: \n102: def body() -> dict | None:\n103:     data = request.get_json(force=True, silent=True)\n104:     return data if isinstance(data, dict) else None\n105: \n106: \n107: def utc_now() -> str:\n108:     return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n109: \n110: \n111: def serialize(row: sqlite3.Row) -> dict:\n112:     return {\n113:         \"id\": row[\"id\"],\n114:         \"message\": row[\"message\"],\n115:         \"type\": row[\"type\"],\n116:         \"read\": bool(row[\"read\"]),\n117:         \"created_at\": row[\"created_at\"],\n118:     }\n119: \n120: \n121: def parse_bool(value) -> bool | None:\n122:     if isinstance(value, bool):\n123:         return value\n124:     if isinstance(value, int) and value in (0, 1):\n125:         return bool(value)\n126:     if isinstance(value, str):\n127:         lowered = value.strip().lower()\n128:         if lowered in (\"true\", \"1\", \"yes\", \"on\"):\n129:             return True\n130:         if lowered in (\"false\", \"0\", \"no\", \"off\"):\n131:             return False\n132:     return None\n133: \n134: \n135: def current_user() -> sqlite3.Row | None:\n136:     header = request.headers.get(\"Authorization\", \"\")\n137:     if not header.startswith(\"Bearer \"):\n138:         return None\n139:     token = header[7:].strip()\n140:     if not token:\n141:         return None\n142:     return db().execute(\n143:         \"\"\"\n144:         SELECT u.id, u.username, u.is_admin, u.password_hash\n145:         FROM tokens t JOIN users u ON u.id = t.user_id\n146:         WHERE t.token = ?\n147:         \"\"\",\n148:         (token,),\n149:     ).fetchone()\n150: \n151: \n152: def login_required(view):\n153:     @wraps(view)\n154:     def wrapper(*args, **kwargs):\n155:         user = current_user()\n156:         if user is None:\n157:             return error(\"authentication required\", 401)\n158:         g.user = user\n159:         return view(*args, **kwargs)\n160: \n161:     return wrapper\n162: \n163: \n164: def admin_required(view):\n165:     @wraps(view)\n166:     def wrapper(*args, **kwargs):\n167:         user = current_user()\n168:         if user is None:\n169:             return error(\"authentication required\", 401)\n170:         if not user[\"is_admin\"]:\n171:             return error(\"admin only\", 403)\n172:         g.user = user\n173:         return view(*args, **kwargs)\n174: \n175:     return wrapper\n176: \n177: \n178: def notification_fields(data: dict):\n179:     message = data.get(\"message\")\n180:     if not isinstance(message, str) or message == \"\":\n181:         return None\n182:     notification_type = data.get(\"type\", DEFAULT_TYPE)\n183:     if notification_type is None:\n184:         notification_type = DEFAULT_TYPE\n185:     if not isinstance(notification_type, str) or notification_type == \"\":\n186:         notification_type = DEFAULT_TYPE\n187:     return message, notification_type\n188: \n189: \n190: @app.get(\"/api/health\")\n191: def health():\n192:     return jsonify({\"status\": \"ok\"})\n193: \n194: \n195: @app.post(\"/api/auth/register\")\n196: def register():\n197:     data = body()\n198:     if data is None:\n199:         return error(\"invalid JSON body\", 400)\n200:     username = data.get(\"username\")\n201:     password = data.get(\"password\")\n202:     if not isinstance(username, str) or not username.strip() or len(username) > 150:\n203:         return error(\"username is required\", 400)\n204:     if not isinstance(password, str) or password == \"\":\n205:         return error(\"password is required\", 400)\n206:     if username.strip().lower() == \"admin\":\n207:         return error(\"username is reserved\", 409)\n208:     conn = db()\n209:     try:\n210:         cursor = conn.execute(\n211:             \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n212:             (username, generate_password_hash(password)),\n213:         )\n214:         conn.commit()\n215:     except sqlite3.IntegrityError:\n216:         return error(\"username already exists\", 409)\n217:     return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n218: \n219: \n220: @app.post(\"/api/auth/login\")\n221: def login():\n222:     data = body()\n223:     if data is None:\n224:         return error(\"invalid JSON body\", 400)\n225:     username = data.get(\"username\")\n226:     password = data.get(\"password\")\n227:     if not isinstance(username, str) or not isinstance(password, str):\n228:         return error(\"invalid credentials\", 401)\n229:     conn = db()\n230:     user = conn.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n231:     if user is None or not user[\"password_hash\"] or not check_password_hash(user[\"password_hash\"], password):\n232:         return error(\"invalid credentials\", 401)\n233:     token = secrets.token_urlsafe(32)\n234:     conn.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n235:     conn.commit()\n236:     return jsonify({\"token\": token})\n237: \n238: \n239: @app.post(\"/api/auth/logout\")\n240: @login_required\n241: def logout():\n242:     token = request.headers[\"Authorization\"][7:].strip()\n243:     conn = db()\n244:     conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n245:     conn.commit()\n246:     return jsonify({\"status\": \"ok\"})\n247: \n248: \n249: @app.get(\"/api/notifications\")\n250: @login_required\n251: def list_notifications():\n252:     conn = db()\n253:     user_id = g.user[\"id\"]\n254:     where = [\"user_id = ?\"]\n255:     params: list = [user_id]\n256: \n257:     read_value = request.args.get(\"read\")\n258:     if read_value is not None and read_value.strip().lower() not in (\"\", \"all\"):\n259:         read = parse_bool(read_value)\n260:         if read is None:\n261:             return error(\"invalid read filter\", 400)\n262:         where.append(\"read = ?\")\n263:         params.append(int(read))\n264: \n265:     type_value = request.args.get(\"type\")\n266:     if type_value is not None and type_value != \"\":\n267:         where.append(\"type = ?\")\n268:         params.append(type_value)\n269: \n270:     try:\n271:         page = int(request.args.get(\"page\", 1))\n272:         page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n273:     except ValueError:\n274:         return error(\"invalid pagination\", 400)\n275:     if page < 1 or page_size < 1:\n276:         return error(\"invalid pagination\", 400)\n277: \n278:     clause = \" AND \".join(where)\n279:     total = conn.execute(\n280:         f\"SELECT COUNT(*) FROM notifications WHERE {clause}\", params\n281:     ).fetchone()[0]\n282:     unread_count = conn.execute(\n283:         \"SELECT COUNT(*) FROM notifications WHERE user_id = ? AND read = 0\", (user_id,)\n284:     ).fetchone()[0]\n285:     rows = conn.execute(\n286:         f\"SELECT * FROM notifications WHERE {clause} \"\n287:         \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n288:         [*params, page_size, (page - 1) * page_size],\n289:     ).fetchall()\n290:     return jsonify(\n291:         {\n292:             \"items\": [serialize(row) for row in rows],\n293:             \"total\": total,\n294:             \"page\": page,\n295:             \"page_size\": page_size,\n296:             \"unread_count\": unread_count,\n297:         }\n298:     )\n299: \n300: \n301: @app.post(\"/api/notifications\")\n302: @login_required\n303: def create_notification():\n304:     data = body()\n305:     if data is None:\n306:         return error(\"invalid JSON body\", 400)\n307:     fields = notification_fields(data)\n308:     if fields is None:\n309:         return error(\"message is required\", 400)\n310:     message, notification_type = fields\n311:     conn = db()\n312:     cursor = conn.execute(\n313:         \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n314:         \"VALUES (?, ?, ?, 0, ?)\",\n315:         (g.user[\"id\"], message, notification_type, utc_now()),\n316:     )\n317:     conn.commit()\n318:     row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n319:     return jsonify(serialize(row)), 201\n320: \n321: \n322: @app.post(\"/api/notifications/read-all\")\n323: @login_required\n324: def read_all():\n325:     conn = db()\n326:     cursor = conn.execute(\n327:         \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\", (g.user[\"id\"],)\n328:     )\n329:     conn.commit()\n330:     return jsonify({\"updated\": cursor.rowcount})\n331: \n332: \n333: def owned_notification(notification_id: int):\n334:     return db().execute(\n335:         \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n336:         (notification_id, g.user[\"id\"]),\n337:     ).fetchone()\n338: \n339: \n340: @app.get(\"/api/notifications/<int:notification_id>\")\n341: @login_required\n342: def get_notification(notification_id: int):\n343:     row = owned_notification(notification_id)\n344:     if row is None:\n345:         return error(\"notification not found\", 404)\n346:     return jsonify(serialize(row))\n347: \n348: \n349: @app.patch(\"/api/notifications/<int:notification_id>\")\n350: @login_required\n351: def patch_notification(notification_id: int):\n352:     row = owned_notification(notification_id)\n353:     if row is None:\n354:         return error(\"notification not found\", 404)\n355:     data = body()\n356:     if data is None:\n357:         return error(\"invalid JSON body\", 400)\n358:     read = parse_bool(data.get(\"read\"))\n359:     if read is None:\n360:         return error(\"read must be a boolean\", 400)\n361:     conn = db()\n362:     conn.execute(\"UPDATE notifications SET read = ? WHERE id = ?\", (int(read), row[\"id\"]))\n363:     conn.commit()\n364:     row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (row[\"id\"],)).fetchone()\n365:     return jsonify(serialize(row))\n366: \n367: \n368: @app.delete(\"/api/notifications/<int:notification_id>\")\n369: @login_required\n370: def delete_notification(notification_id: int):\n371:     row = owned_notification(notification_id)\n372:     if row is None:\n373:         return error(\"notification not found\", 404)\n374:     conn = db()\n375:     conn.execute(\"DELETE FROM notifications WHERE id = ?\", (row[\"id\"],))\n376:     conn.commit()\n377:     return jsonify({\"deleted\": True, \"id\": row[\"id\"]})\n378: \n379: \n380: @app.post(\"/api/admin/broadcast\")\n381: @admin_required\n382: def broadcast():\n383:     data = body()\n384:     if data is None:\n385:         return error(\"invalid JSON body\", 400)\n386:     fields = notification_fields(data)\n387:     if fields is None:\n388:         return error(\"message is required\", 400)\n389:     message, notification_type = fields\n390:     conn = db()\n391:     users = conn.execute(\"SELECT id FROM users WHERE is_admin = 0 ORDER BY id\").fetchall()\n392:     created_at = utc_now()\n393:     conn.executemany(\n394:         \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n395:         \"VALUES (?, ?, ?, 0, ?)\",\n396:         [(row[\"id\"], message, notification_type, created_at) for row in users],\n397:     )\n398:     conn.commit()\n399:     return jsonify({\"delivered\": len(users)})\n400: \n401: \n402: @app.get(\"/\")\n403: @app.get(\"/<path:path>\")\n404: def frontend(path: str = \"index.html\"):\n405:     if path.startswith(\"api/\"):\n406:         return error(\"not found\", 404)\n407:     if (DIST / path).is_file():\n408:         return send_from_directory(DIST, path)\n409:     return send_from_directory(DIST, \"index.html\")\n410: \n411: \n412: init_db()\n\n(End of file - total 412 lines)\n</content>","metadata":{"preview":"\"\"\"Notification center: Flask API, SQLite storage and static frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"notifications.db\"\n\nDEFAULT_TYPE = \"info\"\nDEFAULT_PAGE_SIZE = 20","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Notification center: Flask API, SQLite storage and static frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"notifications.db\"\n\nDEFAULT_TYPE = \"info\"\nDEFAULT_PAGE_SIZE = 20\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=10)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 10000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exception=None):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=10)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id            INTEGER PRIMARY KEY AUTOINCREMENT,\n                username      TEXT NOT NULL UNIQUE,\n                password_hash TEXT,\n                is_admin      INTEGER NOT NULL DEFAULT 0\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token   TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n            );\n\n            CREATE TABLE IF NOT EXISTS notifications (\n                id         INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                message    TEXT NOT NULL,\n                type       TEXT NOT NULL,\n                read       INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_notifications_user\n                ON notifications (user_id, created_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_notifications_unread\n                ON notifications (user_id, read);\n            \"\"\"\n        )\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        admin_hash = generate_password_hash(admin_password) if admin_password else None\n        conn.execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, is_admin)\n            VALUES ('admin', ?, 1)\n            ON CONFLICT(username) DO UPDATE\n                SET password_hash = excluded.password_hash, is_admin = 1\n            \"\"\",\n            (admin_hash,),\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    response = jsonify({\"error\": message})\n    if status == 401:\n        response.headers[\"WWW-Authenticate\"] = \"Bearer\"\n    return response, status\n\n\ndef body() -> dict | None:\n    data = request.get_json(force=True, silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef parse_bool(value) -> bool | None:\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    if isinstance(value, str):\n        lowered = value.strip().lower()\n        if lowered in (\"true\", \"1\", \"yes\", \"on\"):\n            return True\n        if lowered in (\"false\", \"0\", \"no\", \"off\"):\n            return False\n    return None\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    return db().execute(\n        \"\"\"\n        SELECT u.id, u.username, u.is_admin, u.password_hash\n        FROM tokens t JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return error(\"admin only\", 403)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef notification_fields(data: dict):\n    message = data.get(\"message\")\n    if not isinstance(message, str) or message == \"\":\n        return None\n    notification_type = data.get(\"type\", DEFAULT_TYPE)\n    if notification_type is None:\n        notification_type = DEFAULT_TYPE\n    if not isinstance(notification_type, str) or notification_type == \"\":\n        notification_type = DEFAULT_TYPE\n    return message, notification_type\n\n\n@app.get(\"/api/health\")\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip() or len(username) > 150:\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or password == \"\":\n        return error(\"password is required\", 400)\n    if username.strip().lower() == \"admin\":\n        return error(\"username is reserved\", 409)\n    conn = db()\n    try:\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n            (username, generate_password_hash(password)),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"invalid credentials\", 401)\n    conn = db()\n    user = conn.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    if user is None or not user[\"password_hash\"] or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    conn.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    token = request.headers[\"Authorization\"][7:].strip()\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    conn.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/notifications\")\n@login_required\ndef list_notifications():\n    conn = db()\n    user_id = g.user[\"id\"]\n    where = [\"user_id = ?\"]\n    params: list = [user_id]\n\n    read_value = request.args.get(\"read\")\n    if read_value is not None and read_value.strip().lower() not in (\"\", \"all\"):\n        read = parse_bool(read_value)\n        if read is None:\n            return error(\"invalid read filter\", 400)\n        where.append(\"read = ?\")\n        params.append(int(read))\n\n    type_value = request.args.get(\"type\")\n    if type_value is not None and type_value != \"\":\n        where.append(\"type = ?\")\n        params.append(type_value)\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n    except ValueError:\n        return error(\"invalid pagination\", 400)\n    if page < 1 or page_size < 1:\n        return error(\"invalid pagination\", 400)\n\n    clause = \" AND \".join(where)\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM notifications WHERE {clause}\", params\n    ).fetchone()[0]\n    unread_count = conn.execute(\n        \"SELECT COUNT(*) FROM notifications WHERE user_id = ? AND read = 0\", (user_id,)\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM notifications WHERE {clause} \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread_count,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@login_required\ndef create_notification():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    fields = notification_fields(data)\n    if fields is None:\n        return error(\"message is required\", 400)\n    message, notification_type = fields\n    conn = db()\n    cursor = conn.execute(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n        \"VALUES (?, ?, ?, 0, ?)\",\n        (g.user[\"id\"], message, notification_type, utc_now()),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@login_required\ndef read_all():\n    conn = db()\n    cursor = conn.execute(\n        \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\", (g.user[\"id\"],)\n    )\n    conn.commit()\n    return jsonify({\"updated\": cursor.rowcount})\n\n\ndef owned_notification(notification_id: int):\n    return db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, g.user[\"id\"]),\n    ).fetchone()\n\n\n@app.get(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef get_notification(notification_id: int):\n    row = owned_notification(notification_id)\n    if row is None:\n        return error(\"notification not found\", 404)\n    return jsonify(serialize(row))\n\n\n@app.patch(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef patch_notification(notification_id: int):\n    row = owned_notification(notification_id)\n    if row is None:\n        return error(\"notification not found\", 404)\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    read = parse_bool(data.get(\"read\"))\n    if read is None:\n        return error(\"read must be a boolean\", 400)\n    conn = db()\n    conn.execute(\"UPDATE notifications SET read = ? WHERE id = ?\", (int(read), row[\"id\"]))\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (row[\"id\"],)).fetchone()\n    return jsonify(serialize(row))\n\n\n@app.delete(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef delete_notification(notification_id: int):\n    row = owned_notification(notification_id)\n    if row is None:\n        return error(\"notification not found\", 404)\n    conn = db()\n    conn.execute(\"DELETE FROM notifications WHERE id = ?\", (row[\"id\"],))\n    conn.commit()\n    return jsonify({\"deleted\": True, \"id\": row[\"id\"]})\n\n\n@app.post(\"/api/admin/broadcast\")\n@admin_required\ndef broadcast():\n    data = body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    fields = notification_fields(data)\n    if fields is None:\n        return error(\"message is required\", 400)\n    message, notification_type = fields\n    conn = db()\n    users = conn.execute(\"SELECT id FROM users WHERE is_admin = 0 ORDER BY id\").fetchall()\n    created_at = utc_now()\n    conn.executemany(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n        \"VALUES (?, ?, ?, 0, ?)\",\n        [(row[\"id\"], message, notification_type, created_at) for row in users],\n    )\n    conn.commit()\n    return jsonify({\"delivered\": len(users)})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()","lineStart":1,"lineEnd":412,"totalLines":412,"truncated":false}},"title":"backend/app.py","time":{"start":1794349630209,"end":1794349630224}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c79282fc001WC5tCXueAs2OZd","sessionID":"ses_e38784a86ffeHKjslskyGLBfNt","messageID":"msg_1c79273ba001CQxCaymvySfusJ"}}
