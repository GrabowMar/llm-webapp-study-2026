{"type":"text","timestamp":1794342002411,"sessionID":"ses_e38e4e537ffeL0U73kYTrTM5Wk","part":{"id":"prt_1c71e1edd00162VimSNuUhCYnE","messageID":"msg_1c71d316c001GyWqKkZfxeDo0O","sessionID":"ses_e38e4e537ffeL0U73kYTrTM5Wk","type":"text","text":"Now writing the backend.","time":{"start":1794342002397,"end":1794342002409}}}
{"type":"tool_use","timestamp":1794342002441,"sessionID":"ses_e38e4e537ffeL0U73kYTrTM5Wk","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a646a3c8af96e880","state":{"status":"completed","input":{"content":"\"\"\"Image gallery: JSON API, SQLite storage, and the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom contextlib import closing\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom uuid import uuid4\n\nfrom flask import Flask, g, jsonify, request, send_file, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = Path(os.environ.get(\"GALLERY_DATA_DIR\", str(BASE_DIR / \"data\")))\nDB_PATH = DATA_DIR / \"gallery.sqlite3\"\nFILES_DIR = DATA_DIR / \"files\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024 * 1024\n\nPNG_SIGNATURE = b\"\\x89PNG\\r\\n\\x1a\\n\"\nJPEG_SIGNATURE = b\"\\xff\\xd8\\xff\"\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    FILES_DIR.mkdir(parents=True, exist_ok=True)\n    with closing(get_db()) as conn:\n        with conn:\n            conn.executescript(\n                \"\"\"\n                CREATE TABLE IF NOT EXISTS users (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    username TEXT NOT NULL UNIQUE,\n                    password_hash TEXT NOT NULL\n                );\n                CREATE TABLE IF NOT EXISTS tokens (\n                    token TEXT PRIMARY KEY,\n                    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                    created_at TEXT NOT NULL\n                );\n                CREATE TABLE IF NOT EXISTS images (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    filename TEXT NOT NULL,\n                    title TEXT,\n                    content_type TEXT NOT NULL,\n                    size_bytes INTEGER NOT NULL,\n                    uploaded_at TEXT NOT NULL,\n                    uploader TEXT NOT NULL,\n                    file_name TEXT NOT NULL\n                );\n                \"\"\"\n            )\n\n\ndef get_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef api_error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef hash_password(password: str, salt: bytes | None = None) -> str:\n    salt = salt if salt is not None else secrets.token_bytes(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, 200_000)\n    return f\"{salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt_hex, digest_hex = stored.split(\"$\", 1)\n        expected = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt_hex), 200_000\n        )\n        return hmac.compare_digest(expected.hex(), digest_hex)\n    except (ValueError, TypeError):\n        return False\n\n\ndef json_body():\n    body = request.get_json(silent=True)\n    return body if isinstance(body, dict) else None\n\n\ndef credentials(body):\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return None, None, api_error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return None, None, api_error(\"password is required\", 400)\n    return username.strip(), password, None\n\n\ndef issue_token(conn, user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    conn.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, now_iso()),\n    )\n    return token\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        if not header.startswith(\"Bearer \"):\n            return api_error(\"authentication required\", 401)\n        token = header[len(\"Bearer \") :].strip()\n        if not token:\n            return api_error(\"authentication required\", 401)\n        with closing(get_db()) as conn:\n            row = conn.execute(\n                \"\"\"SELECT u.id AS id, u.username AS username\n                   FROM tokens t JOIN users u ON u.id = t.user_id\n                   WHERE t.token = ?\"\"\",\n                (token,),\n            ).fetchone()\n        if row is None:\n            return api_error(\"invalid or expired token\", 401)\n        g.user = {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef image_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"filename\": row[\"filename\"],\n        \"title\": row[\"title\"],\n        \"content_type\": row[\"content_type\"],\n        \"size_bytes\": row[\"size_bytes\"],\n        \"uploaded_at\": row[\"uploaded_at\"],\n        \"url\": f\"/api/images/{row['id']}/file\",\n        \"uploader\": row[\"uploader\"],\n    }\n\n\ndef detect_content_type(blob: bytes) -> tuple[str, str] | None:\n    if blob.startswith(PNG_SIGNATURE):\n        return \"image/png\", \".png\"\n    if blob.startswith(JPEG_SIGNATURE):\n        return \"image/jpeg\", \".jpg\"\n    return None\n\n\ndef decode_base64(value: str) -> bytes | None:\n    encoded = re.sub(r\"\\s+\", \"\", value.strip())\n    if encoded.lower().startswith(\"data:\"):\n        _, _, encoded = encoded.partition(\",\")\n        if not encoded:\n            return None\n    try:\n        return base64.b64decode(encoded, validate=True)\n    except (binascii.Error, ValueError):\n        try:\n            return base64.urlsafe_b64decode(encoded + \"=\" * (-len(encoded) % 4))\n        except (binascii.Error, ValueError):\n            return None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    if body is None:\n        return api_error(\"expected a JSON object\", 400)\n    username, password, err = credentials(body)\n    if err:\n        return err\n    with closing(get_db()) as conn:\n        if conn.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n            return api_error(\"username already taken\", 409)\n        with conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                (username, hash_password(password)),\n            )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    if body is None:\n        return api_error(\"expected a JSON object\", 400)\n    username, password, err = credentials(body)\n    if err:\n        return err\n    with closing(get_db()) as conn:\n        row = conn.execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n        if row is None or not verify_password(password, row[\"password_hash\"]):\n            return api_error(\"invalid username or password\", 401)\n        with conn:\n            token = issue_token(conn, row[\"id\"])\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@require_auth\ndef logout():\n    token = request.headers.get(\"Authorization\", \"\")[len(\"Bearer \") :].strip()\n    with closing(get_db()) as conn:\n        with conn:\n            conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/images\")\ndef list_images():\n    def positive_int(name: str, default: int, maximum: int | None = None) -> int:\n        try:\n            value = int(request.args.get(name, default))\n        except (TypeError, ValueError):\n            return default\n        if value < 1:\n            return default\n        return min(value, maximum) if maximum is not None else value\n\n    page = positive_int(\"page\", 1)\n    page_size = positive_int(\"page_size\", 20, 100)\n    with closing(get_db()) as conn:\n        total = conn.execute(\"SELECT COUNT(*) FROM images\").fetchone()[0]\n        rows = conn.execute(\n            \"SELECT * FROM images ORDER BY uploaded_at DESC, id DESC LIMIT ? OFFSET ?\",\n            (page_size, (page - 1) * page_size),\n        ).fetchall()\n    return jsonify(\n        {\n            \"items\": [image_json(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/images\")\n@require_auth\ndef upload_image():\n    body = json_body()\n    if body is None:\n        return api_error(\"expected a JSON object\", 400)\n    filename = body.get(\"filename\")\n    if not isinstance(filename, str) or not filename.strip():\n        return api_error(\"filename is required\", 400)\n    raw_data = body.get(\"data\")\n    if not isinstance(raw_data, str) or not raw_data.strip():\n        return api_error(\"data is required\", 400)\n    title = body.get(\"title\")\n    if title is not None and not isinstance(title, str):\n        return api_error(\"title must be a string\", 400)\n\n    blob = decode_base64(raw_data)\n    if not blob:\n        return api_error(\"data must be valid base64 image data\", 400)\n    detected = detect_content_type(blob)\n    if detected is None:\n        return api_error(\"only PNG and JPEG images are supported\", 400)\n    content_type, extension = detected\n\n    file_name = f\"{uuid4().hex}{extension}\"\n    file_path = FILES_DIR / file_name\n    try:\n        file_path.write_bytes(blob)\n        with closing(get_db()) as conn:\n            with conn:\n                cursor = conn.execute(\n                    \"\"\"INSERT INTO images\n                       (filename, title, content_type, size_bytes, uploaded_at, uploader, file_name)\n                       VALUES (?, ?, ?, ?, ?, ?, ?)\"\"\",\n                    (\n                        filename.strip()[:255],\n                        title.strip() or None if isinstance(title, str) else None,\n                        content_type,\n                        len(blob),\n                        now_iso(),\n                        g.user[\"username\"],\n                        file_name,\n                    ),\n                )\n                row = conn.execute(\"SELECT * FROM images WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    except Exception:\n        file_path.unlink(missing_ok=True)\n        raise\n    return jsonify(image_json(row)), 201\n\n\n@app.get(\"/api/images/<int:image_id>\")\ndef get_image(image_id: int):\n    with closing(get_db()) as conn:\n        row = conn.execute(\"SELECT * FROM images WHERE id = ?\", (image_id,)).fetchone()\n    if row is None:\n        return api_error(\"image not found\", 404)\n    return jsonify(image_json(row))\n\n\n@app.get(\"/api/images/<int:image_id>/file\")\ndef get_image_file(image_id: int):\n    with closing(get_db()) as conn:\n        row = conn.execute(\"SELECT * FROM images WHERE id = ?\", (image_id,)).fetchone()\n    if row is None:\n        return api_error(\"image not found\", 404)\n    file_path = FILES_DIR / row[\"file_name\"]\n    if not file_path.is_file():\n        return api_error(\"image file not found\", 404)\n    response = send_file(\n        file_path,\n        mimetype=row[\"content_type\"],\n        as_attachment=False,\n        download_name=row[\"filename\"],\n    )\n    response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n    return response\n\n\n@app.delete(\"/api/images/<int:image_id>\")\n@require_auth\ndef delete_image(image_id: int):\n    with closing(get_db()) as conn:\n        row = conn.execute(\"SELECT * FROM images WHERE id = ?\", (image_id,)).fetchone()\n        if row is None:\n            return api_error(\"image not found\", 404)\n        if row[\"uploader\"] != g.user[\"username\"]:\n            return api_error(\"only the uploader may delete this image\", 403)\n        with conn:\n            conn.execute(\"DELETE FROM images WHERE id = ?\", (image_id,))\n    (FILES_DIR / row[\"file_name\"]).unlink(missing_ok=True)\n    return jsonify({\"ok\": True})\n\n\n@app.errorhandler(413)\ndef too_large(_error):\n    return api_error(\"request body too large\", 413)\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return api_error(\"not found\", 404)\n    return frontend(\"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return api_error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794342002405,"end":1794342002424}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c71e1edf001kKnel6fOns3ma3","sessionID":"ses_e38e4e537ffeL0U73kYTrTM5Wk","messageID":"msg_1c71d316c001GyWqKkZfxeDo0O"}}
