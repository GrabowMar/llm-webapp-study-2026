ort_url': '/r/l0jCgL6n'}\ndelete: 200 {'status': 'ok'}\n--- paging: create 12 ---\npage2 2 5 12 items 5 ids [8, 7, 6, 5, 4]\n","exit":0,"truncated":false},"title":"python3 - <<'PY'\nimport os, sys, pathlib, tempfile\nos.environ[\"ADMIN_PASSWORD\"] = \"secret123\"\nsys.path.insert(0, \"backend\")\nimport app as A\nA.DB_PATH = pathlib.Path(tempfile.mkdtemp()) / \"t.sqlite3\"; A.DATA_DIR = A.DB_PATH.parent\nA.init_db()\nc = A.app.test_client()\ndef s(l,r):\n    try: b=r.get_json()\n    except: b=r.data[:120].decode(errors='replace')\n    print(f\"{l}: {r.status_code} {b}\")\ns(\"health\", c.get(\"/api/health\"))\ns(\"reg\", c.post(\"/api/auth/register\", json={\"username\":\"alice\",\"password\":\"password1\"}))\ntok=c.post(\"/api/auth/login\",json={\"username\":\"alice\",\"password\":\"password1\"}).get_json()[\"token\"]\nH={\"Authorization\":f\"Bearer {tok}\"}\nlk=c.post(\"/api/links\",json={\"original_url\":\"https://a.co/x\"},headers=H).get_json()\nprint(\"public fields:\", sorted(lk.keys()))\nr=c.get(lk[\"short_url\"]); print(\"redirect\", r.status_code, r.headers.get(\"Location\"))\ns(\"get\", c.get(f\"/api/links/{lk['id']}\"))\ns(\"list\", c.get(\"/api/links\"))\nAH={\"Authorization\":f\"Bearer {c.post('/api/auth/login',json={'username':'admin','password':'secret123'}).get_json()['token']}\"}\ns(\"admin list\", c.get(\"/api/admin/links\",headers=AH))\nprint(\"admin fields:\", sorted(c.get(\"/api/admin/links\",headers=AH).get_json()[\"items\"][0].keys()))\ns(\"toggle\", c.post(f\"/api/admin/links/{lk['id']}/toggle\",headers=AH))\ns(\"disabled get\", c.get(f\"/api/links/{lk['id']}\"))\ns(\"disabled redirect\", c.get(lk[\"short_url\"]))\ns(\"admin still sees\", c.get(\"/api/admin/links\",headers=AH))\ns(\"toggle back\", c.post(f\"/api/admin/links/{lk['id']}/toggle\",headers=AH))\ns(\"delete\", c.delete(f\"/api/links/{lk['id']}\",headers=H))\nprint(\"--- paging: create 12 ---\")\nfor i in range(12): c.post(\"/api/links\",json={\"original_url\":f\"https://x.co/{i}\"},headers=H)\np=c.get(\"/api/links?page=2&page_size=5\").get_json()\nprint(\"page2\", p[\"page\"], p[\"page_size\"], p[\"total\"], \"items\", len(p[\"items\"]), \"ids\", [x[\"id\"] for x in p[\"items\"]])\nPY","time":{"start":1794383111417,"end":1794383112307}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c99164f4001fg37dkTFGYNE9D","sessionID":"ses_e367638caffewcXcusTiMoC75h","messageID":"msg_1c991477c001L7aTdFi73Z2Yg3"}}
