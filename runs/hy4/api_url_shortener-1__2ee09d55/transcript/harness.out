{"type":"step_start","timestamp":1794383021735,"sessionID":"ses_e367638caffewcXcusTiMoC75h","part":{"id":"prt_1c9900692001UrhkBcbRpglU3P","messageID":"msg_1c98ff0e30011Edy761L1cPnhj","sessionID":"ses_e367638caffewcXcusTiMoC75h","type":"step-start"}}
{"type":"text","timestamp":1794383021735,"sessionID":"ses_e367638caffewcXcusTiMoC75h","part":{"id":"prt_1c99006950010U1llQhWEYv7bE","messageID":"msg_1c98ff0e30011Edy761L1cPnhj","sessionID":"ses_e367638caffewcXcusTiMoC75h","type":"text","text":"Backend works well. One concern: `init_db()` runs at import time, so gunicorn workers each initialize. WAL + `CREATE TABLE IF NOT EXISTS` is idempotent, but concurrent writes during admin sync could race. Let me make init robust with a retry and use `BEGIN IMMEDIATE` for the admin sync. Also I should consider that `DB_PATH` is derived from `BASE_DIR` (which is `/app` in the container) — good, that's under `/app/data`. Let me check the data dir actually resolved correctly in local test (it wrote to `/workspace/data`).\n\nLet me verify the current state of the app.py file fully.","time":{"start":1794383021717,"end":1794383021732}}}
{"type":"tool_use","timestamp":1794383021767,"sessionID":"ses_e367638caffewcXcusTiMoC75h","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a75ed3876d978044","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"URL shortener: JSON API, redirect endpoint and static frontend.\"\"\"\n2: \n3: import os\n4: import re\n5: import secrets\n6: import sqlite3\n7: from datetime import datetime, timezone\n8: from functools import wraps\n9: from pathlib import Path\n10: from urllib.parse import urlparse\n11: \n12: from flask import Flask, g, jsonify, redirect, request, send_from_directory\n13: from werkzeug.security import check_password_hash, generate_password_hash\n14: \n15: BASE_DIR = Path(__file__).resolve().parent.parent\n16: DATA_DIR = BASE_DIR / \"data\"\n17: DB_PATH = DATA_DIR / \"links.sqlite3\"\n18: DIST = BASE_DIR / \"frontend\" / \"dist\"\n19: \n20: CODE_RE = re.compile(r\"^[A-Za-z0-9]{4,32}$\")\n21: USERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{1,64}$\")\n22: \n23: app = Flask(__name__, static_folder=None)\n24: \n25: \n26: def db():\n27:     if \"db\" not in g:\n28:         g.db = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n29:         g.db.row_factory = sqlite3.Row\n30:         g.db.execute(\"PRAGMA foreign_keys = ON\")\n31:         g.db.execute(\"PRAGMA busy_timeout = 30000\")\n32:     return g.db\n33: \n34: \n35: @app.teardown_appcontext\n36: def close_db(_exc):\n37:     conn = g.pop(\"db\", None)\n38:     if conn is not None:\n39:         conn.close()\n40: \n41: \n42: def init_db():\n43:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n44:     conn = sqlite3.connect(DB_PATH, timeout=30)\n45:     try:\n46:         conn.execute(\"PRAGMA journal_mode = WAL\")\n47:         conn.executescript(\n48:             \"\"\"\n49:             CREATE TABLE IF NOT EXISTS users (\n50:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n51:                 username TEXT NOT NULL UNIQUE,\n52:                 password_hash TEXT NOT NULL,\n53:                 is_admin INTEGER NOT NULL DEFAULT 0\n54:             );\n55:             CREATE TABLE IF NOT EXISTS tokens (\n56:                 token TEXT PRIMARY KEY,\n57:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n58:                 created_at TEXT NOT NULL\n59:             );\n60:             CREATE TABLE IF NOT EXISTS links (\n61:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n62:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n63:                 original_url TEXT NOT NULL,\n64:                 short_code TEXT NOT NULL UNIQUE,\n65:                 click_count INTEGER NOT NULL DEFAULT 0,\n66:                 is_active INTEGER NOT NULL DEFAULT 1,\n67:                 created_at TEXT NOT NULL\n68:             );\n69:             CREATE INDEX IF NOT EXISTS idx_links_created ON links(created_at DESC, id DESC);\n70:             CREATE INDEX IF NOT EXISTS idx_links_code ON links(short_code);\n71:             \"\"\"\n72:         )\n73:         conn.commit()\n74:     finally:\n75:         conn.close()\n76: \n77:     admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n78:     with app.app_context():\n79:         conn = db()\n80:         row = conn.execute(\"SELECT id FROM users WHERE username = ?\", (\"admin\",)).fetchone()\n81:         if admin_password:\n82:             password_hash = generate_password_hash(admin_password)\n83:             if row is None:\n84:                 conn.execute(\n85:                     \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1)\",\n86:                     (\"admin\", password_hash),\n87:                 )\n88:             else:\n89:                 conn.execute(\n90:                     \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE username = ?\",\n91:                     (password_hash, \"admin\"),\n92:                 )\n93:         elif row is not None:\n94:             conn.execute(\"DELETE FROM tokens WHERE user_id = ?\", (row[\"id\"],))\n95:             conn.execute(\"DELETE FROM users WHERE id = ?\", (row[\"id\"],))\n96: \n97: \n98: init_db()\n99: \n100: \n101: def now_iso():\n102:     return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n103: \n104: \n105: def json_error(message, status):\n106:     return jsonify({\"error\": message}), status\n107: \n108: \n109: def body():\n110:     data = request.get_json(silent=True)\n111:     return data if isinstance(data, dict) else {}\n112: \n113: \n114: def current_user():\n115:     header = request.headers.get(\"Authorization\", \"\")\n116:     if not header.startswith(\"Bearer \"):\n117:         return None\n118:     token = header[7:].strip()\n119:     if not token:\n120:         return None\n121:     return (\n122:         db()\n123:         .execute(\n124:             \"\"\"\n125:             SELECT u.id, u.username, u.is_admin\n126:             FROM tokens t JOIN users u ON u.id = t.user_id\n127:             WHERE t.token = ?\n128:             \"\"\",\n129:             (token,),\n130:         )\n131:         .fetchone()\n132:     )\n133: \n134: \n135: def require_user(fn):\n136:     @wraps(fn)\n137:     def wrapper(*args, **kwargs):\n138:         user = current_user()\n139:         if user is None:\n140:             return json_error(\"Authentication required.\", 401)\n141:         return fn(user, *args, **kwargs)\n142: \n143:     return wrapper\n144: \n145: \n146: def require_admin(fn):\n147:     @wraps(fn)\n148:     def wrapper(*args, **kwargs):\n149:         user = current_user()\n150:         if user is None:\n151:             return json_error(\"Authentication required.\", 401)\n152:         if not user[\"is_admin\"]:\n153:             return json_error(\"Administrator access required.\", 403)\n154:         return fn(user, *args, **kwargs)\n155: \n156:     return wrapper\n157: \n158: \n159: def serialize_link(row):\n160:     return {\n161:         \"id\": row[\"id\"],\n162:         \"original_url\": row[\"original_url\"],\n163:         \"short_code\": row[\"short_code\"],\n164:         \"click_count\": row[\"click_count\"],\n165:         \"created_at\": row[\"created_at\"],\n166:         \"short_url\": f\"/r/{row['short_code']}\",\n167:         \"owner\": row[\"owner\"],\n168:         \"is_active\": bool(row[\"is_active\"]),\n169:     }\n170: \n171: \n172: LINK_SELECT = \"\"\"\n173:     SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at,\n174:            l.is_active, u.username AS owner\n175:     FROM links l JOIN users u ON u.id = l.user_id\n176: \"\"\"\n177: \n178: \n179: def pagination():\n180:     try:\n181:         page = int(request.args.get(\"page\", 1))\n182:     except (TypeError, ValueError):\n183:         page = 1\n184:     try:\n185:         page_size = int(request.args.get(\"page_size\", 10))\n186:     except (TypeError, ValueError):\n187:         page_size = 10\n188:     page = max(1, page)\n189:     page_size = max(1, min(100, page_size))\n190:     return page, page_size\n191: \n192: \n193: def validate_url(url):\n194:     if not isinstance(url, str):\n195:         return None\n196:     url = url.strip()\n197:     if not url or len(url) > 2048 or any(c.isspace() for c in url):\n198:         return None\n199:     try:\n200:         parsed = urlparse(url)\n201:     except ValueError:\n202:         return None\n203:     if parsed.scheme.lower() not in (\"http\", \"https\") or not parsed.netloc:\n204:         return None\n205:     return url\n206: \n207: \n208: @app.get(\"/api/health\")\n209: def health():\n210:     return {\"status\": \"ok\"}\n211: \n212: \n213: @app.post(\"/api/auth/register\")\n214: def register():\n215:     data = body()\n216:     username = data.get(\"username\")\n217:     password = data.get(\"password\")\n218:     if not isinstance(username, str) or not USERNAME_RE.fullmatch(username):\n219:         return json_error(\n220:             \"Username must be 1-64 characters: letters, digits, '.', '_' or '-'.\", 400\n221:         )\n222:     if username.lower() == \"admin\":\n223:         return json_error(\"That username is reserved.\", 400)\n224:     if not isinstance(password, str) or len(password) < 8 or len(password) > 256:\n225:         return json_error(\"Password must be between 8 and 256 characters.\", 400)\n226:     conn = db()\n227:     try:\n228:         conn.execute(\n229:             \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n230:             (username, generate_password_hash(password)),\n231:         )\n232:     except sqlite3.IntegrityError:\n233:         return json_error(\"Username is already taken.\", 409)\n234:     return jsonify({\"username\": username}), 201\n235: \n236: \n237: @app.post(\"/api/auth/login\")\n238: def login():\n239:     data = body()\n240:     username = data.get(\"username\")\n241:     password = data.get(\"password\")\n242:     if not isinstance(username, str) or not isinstance(password, str):\n243:         return json_error(\"Invalid username or password.\", 401)\n244:     user = db().execute(\n245:         \"SELECT id, username, password_hash, is_admin FROM users WHERE username = ?\",\n246:         (username,),\n247:     ).fetchone()\n248:     if user is None or not check_password_hash(user[\"password_hash\"], password):\n249:         return json_error(\"Invalid username or password.\", 401)\n250:     if user[\"is_admin\"] and not os.environ.get(\"ADMIN_PASSWORD\", \"\"):\n251:         return json_error(\"Invalid username or password.\", 401)\n252:     token = secrets.token_urlsafe(32)\n253:     db().execute(\n254:         \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n255:         (token, user[\"id\"], now_iso()),\n256:     )\n257:     return jsonify({\"token\": token, \"username\": username, \"is_admin\": bool(user[\"is_admin\"])})\n258: \n259: \n260: @app.post(\"/api/auth/logout\")\n261: def logout():\n262:     header = request.headers.get(\"Authorization\", \"\")\n263:     if header.startswith(\"Bearer \"):\n264:         db().execute(\"DELETE FROM tokens WHERE token = ?\", (header[7:].strip(),))\n265:     return jsonify({\"status\": \"ok\"})\n266: \n267: \n268: @app.get(\"/api/me\")\n269: @require_user\n270: def me(user):\n271:     return jsonify(\n272:         {\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}\n273:     )\n274: \n275: \n276: @app.post(\"/api/links\")\n277: @require_user\n278: def create_link(user):\n279:     url = validate_url(body().get(\"original_url\"))\n280:     if url is None:\n281:         return json_error(\"Enter a valid http or https address.\", 400)\n282:     conn = db()\n283:     for _ in range(10):\n284:         code = secrets.token_urlsafe(6).replace(\"-\", \"a\").replace(\"_\", \"b\")\n285:         try:\n286:             cursor = conn.execute(\n287:                 \"\"\"\n288:                 INSERT INTO links (user_id, original_url, short_code, created_at)\n289:                 VALUES (?, ?, ?, ?)\n290:                 \"\"\",\n291:                 (user[\"id\"], url, code, now_iso()),\n292:             )\n293:             break\n294:         except sqlite3.IntegrityError:\n295:             continue\n296:     else:\n297:         return json_error(\"Could not generate a short code, please retry.\", 500)\n298:     row = conn.execute(LINK_SELECT + \" WHERE l.id = ?\", (cursor.lastrowid,)).fetchone()\n299:     return jsonify(serialize_link(row)), 201\n300: \n301: \n302: @app.get(\"/api/links\")\n303: def list_links():\n304:     page, page_size = pagination()\n305:     conn = db()\n306:     total = conn.execute(\n307:         \"SELECT COUNT(*) FROM links WHERE is_active = 1\"\n308:     ).fetchone()[0]\n309:     rows = conn.execute(\n310:         LINK_SELECT\n311:         + \" WHERE l.is_active = 1 ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n312:         (page_size, (page - 1) * page_size),\n313:     ).fetchall()\n314:     return jsonify(\n315:         {\n316:             \"items\": [serialize_link(r) for r in rows],\n317:             \"total\": total,\n318:             \"page\": page,\n319:             \"page_size\": page_size,\n320:         }\n321:     )\n322: \n323: \n324: @app.get(\"/api/links/<int:link_id>\")\n325: def get_link(link_id):\n326:     row = db().execute(\n327:         LINK_SELECT + \" WHERE l.id = ? AND l.is_active = 1\", (link_id,)\n328:     ).fetchone()\n329:     if row is None:\n330:         return json_error(\"Link not found.\", 404)\n331:     return jsonify(serialize_link(row))\n332: \n333: \n334: @app.delete(\"/api/links/<int:link_id>\")\n335: @require_user\n336: def delete_link(user, link_id):\n337:     conn = db()\n338:     row = conn.execute(\n339:         \"SELECT user_id FROM links WHERE id = ?\", (link_id,)\n340:     ).fetchone()\n341:     if row is None or row[\"user_id\"] != user[\"id\"]:\n342:         return json_error(\"Link not found.\", 404)\n343:     conn.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n344:     return jsonify({\"status\": \"ok\"})\n345: \n346: \n347: @app.get(\"/api/admin/links\")\n348: @require_admin\n349: def admin_list_links(admin):\n350:     page, page_size = pagination()\n351:     conn = db()\n352:     total = conn.execute(\"SELECT COUNT(*) FROM links\").fetchone()[0]\n353:     rows = conn.execute(\n354:         LINK_SELECT\n355:         + \" ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n356:         (page_size, (page - 1) * page_size),\n357:     ).fetchall()\n358:     return jsonify(\n359:         {\n360:             \"items\": [serialize_link(r) for r in rows],\n361:             \"total\": total,\n362:             \"page\": page,\n363:             \"page_size\": page_size,\n364:         }\n365:     )\n366: \n367: \n368: @app.post(\"/api/admin/links/<int:link_id>/toggle\")\n369: @require_admin\n370: def admin_toggle_link(admin, link_id):\n371:     conn = db()\n372:     row = conn.execute(\n373:         \"SELECT is_active FROM links WHERE id = ?\", (link_id,)\n374:     ).fetchone()\n375:     if row is None:\n376:         return json_error(\"Link not found.\", 404)\n377:     conn.execute(\n378:         \"UPDATE links SET is_active = ? WHERE id = ?\",\n379:         (0 if row[\"is_active\"] else 1, link_id),\n380:     )\n381:     updated = conn.execute(LINK_SELECT + \" WHERE l.id = ?\", (link_id,)).fetchone()\n382:     return jsonify(serialize_link(updated))\n383: \n384: \n385: @app.get(\"/r/<code>\")\n386: def follow_link(code):\n387:     if not CODE_RE.fullmatch(code):\n388:         return json_error(\"Link not found.\", 404)\n389:     conn = db()\n390:     row = conn.execute(\n391:         \"SELECT original_url FROM links WHERE short_code = ? AND is_active = 1\",\n392:         (code,),\n393:     ).fetchone()\n394:     if row is None:\n395:         return json_error(\"Link not found.\", 404)\n396:     conn.execute(\n397:         \"UPDATE links SET click_count = click_count + 1 WHERE short_code = ?\",\n398:         (code,),\n399:     )\n400:     return redirect(row[\"original_url\"], code=302)\n401: \n402: \n403: @app.get(\"/\")\n404: @app.get(\"/<path:path>\")\n405: def frontend(path: str = \"index.html\"):\n406:     if path.startswith(\"api/\") or path == \"api\" or path.startswith(\"r/\"):\n407:         return json_error(\"Not found.\", 404)\n408:     if (DIST / path).is_file():\n409:         return send_from_directory(DIST, path)\n410:     return send_from_directory(DIST, \"index.html\")\n\n(End of file - total 410 lines)\n</content>","metadata":{"preview":"\"\"\"URL shortener: JSON API, redirect endpoint and static frontend.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"links.sqlite3\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nCODE_RE = re.compile(r\"^[A-Za-z0-9]{4,32}$\")","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"URL shortener: JSON API, redirect endpoint and static frontend.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"links.sqlite3\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nCODE_RE = re.compile(r\"^[A-Za-z0-9]{4,32}$\")\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{1,64}$\")\n\napp = Flask(__name__, static_folder=None)\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n        g.db.execute(\"PRAGMA busy_timeout = 30000\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS links (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                original_url TEXT NOT NULL,\n                short_code TEXT NOT NULL UNIQUE,\n                click_count INTEGER NOT NULL DEFAULT 0,\n                is_active INTEGER NOT NULL DEFAULT 1,\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_links_created ON links(created_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_links_code ON links(short_code);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n    admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n    with app.app_context():\n        conn = db()\n        row = conn.execute(\"SELECT id FROM users WHERE username = ?\", (\"admin\",)).fetchone()\n        if admin_password:\n            password_hash = generate_password_hash(admin_password)\n            if row is None:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1)\",\n                    (\"admin\", password_hash),\n                )\n            else:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE username = ?\",\n                    (password_hash, \"admin\"),\n                )\n        elif row is not None:\n            conn.execute(\"DELETE FROM tokens WHERE user_id = ?\", (row[\"id\"],))\n            conn.execute(\"DELETE FROM users WHERE id = ?\", (row[\"id\"],))\n\n\ninit_db()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef json_error(message, status):\n    return jsonify({\"error\": message}), status\n\n\ndef body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    return (\n        db()\n        .execute(\n            \"\"\"\n            SELECT u.id, u.username, u.is_admin\n            FROM tokens t JOIN users u ON u.id = t.user_id\n            WHERE t.token = ?\n            \"\"\",\n            (token,),\n        )\n        .fetchone()\n    )\n\n\ndef require_user(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return json_error(\"Authentication required.\", 401)\n        return fn(user, *args, **kwargs)\n\n    return wrapper\n\n\ndef require_admin(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return json_error(\"Authentication required.\", 401)\n        if not user[\"is_admin\"]:\n            return json_error(\"Administrator access required.\", 403)\n        return fn(user, *args, **kwargs)\n\n    return wrapper\n\n\ndef serialize_link(row):\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\nLINK_SELECT = \"\"\"\n    SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at,\n           l.is_active, u.username AS owner\n    FROM links l JOIN users u ON u.id = l.user_id\n\"\"\"\n\n\ndef pagination():\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        page_size = 10\n    page = max(1, page)\n    page_size = max(1, min(100, page_size))\n    return page, page_size\n\n\ndef validate_url(url):\n    if not isinstance(url, str):\n        return None\n    url = url.strip()\n    if not url or len(url) > 2048 or any(c.isspace() for c in url):\n        return None\n    try:\n        parsed = urlparse(url)\n    except ValueError:\n        return None\n    if parsed.scheme.lower() not in (\"http\", \"https\") or not parsed.netloc:\n        return None\n    return url\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not USERNAME_RE.fullmatch(username):\n        return json_error(\n            \"Username must be 1-64 characters: letters, digits, '.', '_' or '-'.\", 400\n        )\n    if username.lower() == \"admin\":\n        return json_error(\"That username is reserved.\", 400)\n    if not isinstance(password, str) or len(password) < 8 or len(password) > 256:\n        return json_error(\"Password must be between 8 and 256 characters.\", 400)\n    conn = db()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n    except sqlite3.IntegrityError:\n        return json_error(\"Username is already taken.\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"Invalid username or password.\", 401)\n    user = db().execute(\n        \"SELECT id, username, password_hash, is_admin FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return json_error(\"Invalid username or password.\", 401)\n    if user[\"is_admin\"] and not os.environ.get(\"ADMIN_PASSWORD\", \"\"):\n        return json_error(\"Invalid username or password.\", 401)\n    token = secrets.token_urlsafe(32)\n    db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], now_iso()),\n    )\n    return jsonify({\"token\": token, \"username\": username, \"is_admin\": bool(user[\"is_admin\"])})\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    if header.startswith(\"Bearer \"):\n        db().execute(\"DELETE FROM tokens WHERE token = ?\", (header[7:].strip(),))\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/me\")\n@require_user\ndef me(user):\n    return jsonify(\n        {\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}\n    )\n\n\n@app.post(\"/api/links\")\n@require_user\ndef create_link(user):\n    url = validate_url(body().get(\"original_url\"))\n    if url is None:\n        return json_error(\"Enter a valid http or https address.\", 400)\n    conn = db()\n    for _ in range(10):\n        code = secrets.token_urlsafe(6).replace(\"-\", \"a\").replace(\"_\", \"b\")\n        try:\n            cursor = conn.execute(\n                \"\"\"\n                INSERT INTO links (user_id, original_url, short_code, created_at)\n                VALUES (?, ?, ?, ?)\n                \"\"\",\n                (user[\"id\"], url, code, now_iso()),\n            )\n            break\n        except sqlite3.IntegrityError:\n            continue\n    else:\n        return json_error(\"Could not generate a short code, please retry.\", 500)\n    row = conn.execute(LINK_SELECT + \" WHERE l.id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(serialize_link(row)), 201\n\n\n@app.get(\"/api/links\")\ndef list_links():\n    page, page_size = pagination()\n    conn = db()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM links WHERE is_active = 1\"\n    ).fetchone()[0]\n    rows = conn.execute(\n        LINK_SELECT\n        + \" WHERE l.is_active = 1 ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_link(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/links/<int:link_id>\")\ndef get_link(link_id):\n    row = db().execute(\n        LINK_SELECT + \" WHERE l.id = ? AND l.is_active = 1\", (link_id,)\n    ).fetchone()\n    if row is None:\n        return json_error(\"Link not found.\", 404)\n    return jsonify(serialize_link(row))\n\n\n@app.delete(\"/api/links/<int:link_id>\")\n@require_user\ndef delete_link(user, link_id):\n    conn = db()\n    row = conn.execute(\n        \"SELECT user_id FROM links WHERE id = ?\", (link_id,)\n    ).fetchone()\n    if row is None or row[\"user_id\"] != user[\"id\"]:\n        return json_error(\"Link not found.\", 404)\n    conn.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/admin/links\")\n@require_admin\ndef admin_list_links(admin):\n    page, page_size = pagination()\n    conn = db()\n    total = conn.execute(\"SELECT COUNT(*) FROM links\").fetchone()[0]\n    rows = conn.execute(\n        LINK_SELECT\n        + \" ORDER BY l.created_at DESC, l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_link(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/links/<int:link_id>/toggle\")\n@require_admin\ndef admin_toggle_link(admin, link_id):\n    conn = db()\n    row = conn.execute(\n        \"SELECT is_active FROM links WHERE id = ?\", (link_id,)\n    ).fetchone()\n    if row is None:\n        return json_error(\"Link not found.\", 404)\n    conn.execute(\n        \"UPDATE links SET is_active = ? WHERE id = ?\",\n        (0 if row[\"is_active\"] else 1, link_id),\n    )\n    updated = conn.execute(LINK_SELECT + \" WHERE l.id = ?\", (link_id,)).fetchone()\n    return jsonify(serialize_link(updated))\n\n\n@app.get(\"/r/<code>\")\ndef follow_link(code):\n    if not CODE_RE.fullmatch(code):\n        return json_error(\"Link not found.\", 404)\n    conn = db()\n    row = conn.execute(\n        \"SELECT original_url FROM links WHERE short_code = ? AND is_active = 1\",\n        (code,),\n    ).fetchone()\n    if row is None:\n        return json_error(\"Link not found.\", 404)\n    conn.execute(\n        \"UPDATE links SET click_count = click_count + 1 WHERE short_code = ?\",\n        (code,),\n    )\n    return redirect(row[\"original_url\"], code=302)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path == \"api\" or path.startswith(\"r/\"):\n        return json_error(\"Not found.\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":410,"totalLines":410,"truncated":false}},"title":"backend/app.py","time":{"start":1794383021728,"end":1794383021741}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c990069a001RCf1aLA2CKld5T","sessionID":"ses_e367638caffewcXcusTiMoC75h","messageID":"msg_1c98ff0e30011Edy761L1cPnhj"}}
