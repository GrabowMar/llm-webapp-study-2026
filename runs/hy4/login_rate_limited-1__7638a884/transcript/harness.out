{"type":"text","timestamp":1794339516166,"sessionID":"ses_e390f5eccffefM8ufSZS8nnpc4","part":{"id":"prt_1c6f82ef3001CJ2p5lt2RZWUth","messageID":"msg_1c6f62995001wTdax72ONfgP8k","sessionID":"ses_e390f5eccffefM8ufSZS8nnpc4","type":"text","text":"Now I'll implement the backend API.","time":{"start":1794339516147,"end":1794339516163}}}
{"type":"tool_use","timestamp":1794339516208,"sessionID":"ses_e390f5eccffefM8ufSZS8nnpc4","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b835a77555d77409","state":{"status":"completed","input":{"content":"\"\"\"Account service: JSON API under /api plus the built web frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport math\nimport os\nimport secrets\nimport sqlite3\nimport threading\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.sqlite3\"\n\nLOCK_SECONDS = 15 * 60\nMAX_FAILURES = 5\nRATE_WINDOW = 60\nRATE_LIMIT = 20\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\napp = Flask(__name__, static_folder=None)\n\n_login_lock = threading.Lock()\n\n\ndef iso(ts: float | None = None) -> str:\n    if ts is None:\n        return datetime.now(timezone.utc).isoformat()\n    return datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA journal_mode=WAL\")\n    conn.execute(\"PRAGMA foreign_keys=ON\")\n    conn.execute(\"PRAGMA busy_timeout=30000\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id             INTEGER PRIMARY KEY AUTOINCREMENT,\n                username       TEXT NOT NULL UNIQUE,\n                password_hash  TEXT,\n                is_admin       INTEGER NOT NULL DEFAULT 0,\n                last_login_at  TEXT,\n                created_at     TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token_hash  TEXT PRIMARY KEY,\n                user_id     INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at  TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS login_attempts (\n                id          INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id     INTEGER REFERENCES users(id) ON DELETE SET NULL,\n                username    TEXT NOT NULL,\n                client_key  TEXT NOT NULL,\n                at          TEXT NOT NULL,\n                at_ts       REAL NOT NULL,\n                success     INTEGER NOT NULL,\n                outcome     TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_attempts_user\n                ON login_attempts (user_id, id DESC);\n\n            CREATE TABLE IF NOT EXISTS username_state (\n                username              TEXT PRIMARY KEY,\n                consecutive_failures  INTEGER NOT NULL DEFAULT 0,\n                locked_until          REAL\n            );\n\n            CREATE TABLE IF NOT EXISTS rate_events (\n                id          INTEGER PRIMARY KEY AUTOINCREMENT,\n                client_key  TEXT NOT NULL,\n                at_ts       REAL NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_rate_events\n                ON rate_events (client_key, at_ts);\n            \"\"\"\n        )\n        conn.execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, is_admin, created_at)\n            VALUES (?, ?, 1, ?)\n            ON CONFLICT(username) DO UPDATE SET\n                password_hash = excluded.password_hash,\n                is_admin = 1\n            \"\"\",\n            (\n                ADMIN_USERNAME,\n                generate_password_hash(ADMIN_PASSWORD) if ADMIN_PASSWORD else None,\n                iso(),\n            ),\n        )\n        if not ADMIN_PASSWORD:\n            conn.execute(\n                \"DELETE FROM tokens WHERE user_id = \"\n                \"(SELECT id FROM users WHERE username = ?)\",\n                (ADMIN_USERNAME,),\n            )\n        conn.commit()\n    except Exception:\n        conn.rollback()\n        raise\n    finally:\n        conn.close()\n\n\ndef client_key() -> str:\n    forwarded = request.headers.get(\"X-Forwarded-For\")\n    if forwarded and forwarded.split(\",\")[0].strip():\n        return \"xff:\" + forwarded.split(\",\")[0].strip()\n    client_id = request.headers.get(\"X-Client-Id\")\n    if client_id and client_id.strip():\n        return \"cid:\" + client_id.strip()\n    return \"ip:\" + (request.remote_addr or \"unknown\")\n\n\ndef error(status: int, code: str, message: str, **extra):\n    payload = {\"error\": code, \"message\": message, **extra}\n    response = jsonify(payload)\n    response.status_code = status\n    return response\n\n\ndef too_many(status_wait: float, code: str, message: str, **extra):\n    retry = max(1, math.ceil(status_wait))\n    response = error(\n        429, code, message, retry_after=retry, **extra\n    )\n    response.headers[\"Retry-After\"] = str(retry)\n    return response\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    digest = hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n    return get_db().execute(\n        \"\"\"\n        SELECT u.id, u.username, u.is_admin, u.last_login_at\n        FROM tokens t JOIN users u ON u.id = t.user_id\n        WHERE t.token_hash = ?\n        \"\"\",\n        (digest,),\n    ).fetchone()\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, error(401, \"unauthorized\", \"A valid bearer token is required.\")\n    return user, None\n\n\ndef require_admin():\n    user, failure = require_user()\n    if failure is not None:\n        return None, failure\n    if not user[\"is_admin\"]:\n        return None, error(403, \"forbidden\", \"Admin access is required.\")\n    return user, None\n\n\ndef record_attempt(conn, username, user_id, client, now, outcome):\n    conn.execute(\n        \"\"\"\n        INSERT INTO login_attempts\n            (user_id, username, client_key, at, at_ts, success, outcome)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            user_id,\n            username,\n            client,\n            iso(now),\n            now,\n            1 if outcome == \"success\" else 0,\n            outcome,\n        ),\n    )\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return error(400, \"invalid_request\", \"A JSON object is required.\")\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if (\n        not isinstance(username, str)\n        or not isinstance(password, str)\n        or not username.strip()\n        or not password\n    ):\n        return error(400, \"invalid_request\", \"username and password are required.\")\n    username = username.strip()\n    if username == ADMIN_USERNAME:\n        return error(409, \"username_taken\", \"That username is reserved.\")\n    if len(username) > 150:\n        return error(400, \"invalid_request\", \"username is too long.\")\n\n    conn = get_db()\n    try:\n        with _login_lock:\n            conn.execute(\"BEGIN IMMEDIATE\")\n            cursor = conn.execute(\n                \"\"\"\n                INSERT INTO users (username, password_hash, is_admin, created_at)\n                VALUES (?, ?, 0, ?)\n                \"\"\",\n                (username, generate_password_hash(password), iso()),\n            )\n            conn.commit()\n    except sqlite3.IntegrityError:\n        conn.rollback()\n        return error(409, \"username_taken\", \"That username is already taken.\")\n    except Exception:\n        conn.rollback()\n        raise\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return error(400, \"invalid_request\", \"A JSON object is required.\")\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if (\n        not isinstance(username, str)\n        or not isinstance(password, str)\n        or not username\n        or not password\n    ):\n        return error(400, \"invalid_request\", \"username and password are required.\")\n\n    client = client_key()\n    now = time.time()\n    conn = get_db()\n    with _login_lock:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        try:\n            recent = conn.execute(\n                \"\"\"\n                SELECT at_ts FROM rate_events\n                WHERE client_key = ? AND at_ts > ?\n                ORDER BY at_ts ASC\n                \"\"\",\n                (client, now - RATE_WINDOW),\n            ).fetchall()\n            if len(recent) >= RATE_LIMIT:\n                wait = recent[0][\"at_ts\"] + RATE_WINDOW - now\n                user = conn.execute(\n                    \"SELECT id FROM users WHERE username = ?\", (username,)\n                ).fetchone()\n                record_attempt(\n                    conn, username, user[\"id\"] if user else None,\n                    client, now, \"rate_limited\",\n                )\n                conn.commit()\n                return too_many(\n                    wait,\n                    \"too_many_attempts\",\n                    \"Too many sign-in attempts. Please try again later.\",\n                )\n            conn.execute(\n                \"INSERT INTO rate_events (client_key, at_ts) VALUES (?, ?)\",\n                (client, now),\n            )\n\n            user = conn.execute(\n                \"\"\"\n                SELECT id, username, password_hash, is_admin\n                FROM users WHERE username = ?\n                \"\"\",\n                (username,),\n            ).fetchone()\n            user_id = user[\"id\"] if user else None\n\n            state = conn.execute(\n                \"\"\"\n                SELECT consecutive_failures, locked_until\n                FROM username_state WHERE username = ?\n                \"\"\",\n                (username,),\n            ).fetchone()\n            failures = state[\"consecutive_failures\"] if state else 0\n            locked_until = state[\"locked_until\"] if state else None\n\n            if locked_until is not None and locked_until <= now:\n                locked_until = None\n                failures = 0\n                conn.execute(\n                    \"\"\"\n                    UPDATE username_state\n                    SET consecutive_failures = 0, locked_until = NULL\n                    WHERE username = ?\n                    \"\"\",\n                    (username,),\n                )\n\n            if locked_until is not None and locked_until > now:\n                wait = locked_until - now\n                record_attempt(conn, username, user_id, client, now, \"locked\")\n                conn.commit()\n                return too_many(\n                    wait,\n                    \"account_locked\",\n                    \"This username is locked after too many failed sign-ins.\",\n                    locked_until=iso(locked_until),\n                )\n\n            stored_hash = user[\"password_hash\"] if user else None\n            if stored_hash and check_password_hash(stored_hash, password):\n                token = secrets.token_urlsafe(32)\n                digest = hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n                conn.execute(\n                    \"INSERT INTO tokens (token_hash, user_id, created_at) VALUES (?, ?, ?)\",\n                    (digest, user_id, iso(now)),\n                )\n                conn.execute(\n                    \"UPDATE users SET last_login_at = ? WHERE id = ?\",\n                    (iso(now), user_id),\n                )\n                conn.execute(\n                    \"\"\"\n                    INSERT INTO username_state\n                        (username, consecutive_failures, locked_until)\n                    VALUES (?, 0, NULL)\n                    ON CONFLICT(username) DO UPDATE SET\n                        consecutive_failures = 0, locked_until = NULL\n                    \"\"\",\n                    (username,),\n                )\n                record_attempt(conn, username, user_id, client, now, \"success\")\n                conn.commit()\n                return jsonify({\"token\": token}), 200\n\n            failures += 1\n            if failures >= MAX_FAILURES:\n                locked_until = now + LOCK_SECONDS\n            conn.execute(\n                \"\"\"\n                INSERT INTO username_state\n                    (username, consecutive_failures, locked_until)\n                VALUES (?, ?, ?)\n                ON CONFLICT(username) DO UPDATE SET\n                    consecutive_failures = excluded.consecutive_failures,\n                    locked_until = excluded.locked_until\n                \"\"\",\n                (username, failures, locked_until),\n            )\n            record_attempt(conn, username, user_id, client, now, \"invalid\")\n            conn.commit()\n            return error(401, \"invalid_credentials\", \"Invalid username or password.\")\n        except Exception:\n            conn.rollback()\n            raise\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    header = request.headers.get(\"Authorization\", \"\")\n    token = header[len(\"Bearer \") :].strip()\n    digest = hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n    conn = get_db()\n    conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (digest,))\n    return jsonify({\"signed_out\": True})\n\n\n@app.get(\"/api/me\")\ndef me():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    return jsonify(\n        {\n            \"id\": user[\"id\"],\n            \"username\": user[\"username\"],\n            \"last_login_at\": user[\"last_login_at\"],\n        }\n    )\n\n\n@app.get(\"/api/me/login-attempts\")\ndef login_attempts():\n    user, failure = require_user()\n    if failure is not None:\n        return failure\n    rows = get_db().execute(\n        \"\"\"\n        SELECT at, success FROM login_attempts\n        WHERE user_id = ?\n        ORDER BY id DESC\n        LIMIT 20\n        \"\"\",\n        (user[\"id\"],),\n    ).fetchall()\n    return jsonify(\n        {\"items\": [{\"at\": row[\"at\"], \"success\": bool(row[\"success\"])} for row in rows]}\n    )\n\n\n@app.get(\"/api/admin/locks\")\ndef admin_locks():\n    _user, failure = require_admin()\n    if failure is not None:\n        return failure\n    now = time.time()\n    rows = get_db().execute(\n        \"\"\"\n        SELECT username, locked_until FROM username_state\n        WHERE locked_until IS NOT NULL AND locked_until > ?\n        ORDER BY username ASC\n        \"\"\",\n        (now,),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\"username\": row[\"username\"], \"locked_until\": iso(row[\"locked_until\"])}\n                for row in rows\n            ]\n        }\n    )\n\n\n@app.post(\"/api/admin/locks/<path:username>/unlock\")\ndef admin_unlock(username: str):\n    _user, failure = require_admin()\n    if failure is not None:\n        return failure\n    conn = get_db()\n    conn.execute(\n        \"\"\"\n        INSERT INTO username_state (username, consecutive_failures, locked_until)\n        VALUES (?, 0, NULL)\n        ON CONFLICT(username) DO UPDATE SET\n            consecutive_failures = 0, locked_until = NULL\n        \"\"\",\n        (username,),\n    )\n    return jsonify({\"username\": username, \"locked\": False})\n\n\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    return error(404, \"not_found\", \"No such API endpoint.\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794339516159,"end":1794339516185}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6f82ef7001g3FAqjtdJr2093","sessionID":"ses_e390f5eccffefM8ufSZS8nnpc4","messageID":"msg_1c6f62995001wTdax72ONfgP8k"}}
