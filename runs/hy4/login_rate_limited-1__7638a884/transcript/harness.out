nt>","metadata":{"preview":"    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id             INTEGER PRIMARY KEY AUTOINCREMENT,\n                username       TEXT NOT NULL UNIQUE,\n                password_hash  TEXT,\n                is_admin       INTEGER NOT NULL DEFAULT 0,\n                last_login_at  TEXT,\n                created_at     TEXT NOT NULL\n            );\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id             INTEGER PRIMARY KEY AUTOINCREMENT,\n                username       TEXT NOT NULL UNIQUE,\n                password_hash  TEXT,\n                is_admin       INTEGER NOT NULL DEFAULT 0,\n                last_login_at  TEXT,\n                created_at     TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token_hash  TEXT PRIMARY KEY,\n                user_id     INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at  TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS login_attempts (\n                id          INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id     INTEGER REFERENCES users(id) ON DELETE SET NULL,\n                username    TEXT NOT NULL,\n                client_key  TEXT NOT NULL,\n                at          TEXT NOT NULL,\n                at_ts       REAL NOT NULL,\n                success     INTEGER NOT NULL,\n                outcome     TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_attempts_user\n                ON login_attempts (user_id, id DESC);\n\n            CREATE TABLE IF NOT EXISTS username_state (\n                username              TEXT PRIMARY KEY,\n                consecutive_failures  INTEGER NOT NULL DEFAULT 0,\n                locked_until          REAL\n            );\n\n            CREATE TABLE IF NOT EXISTS rate_events (\n                id          INTEGER PRIMARY KEY AUTOINCREMENT,\n                client_key  TEXT NOT NULL,\n                at_ts       REAL NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_rate_events\n                ON rate_events (client_key, at_ts);\n            \"\"\"\n        )\n        conn.execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, is_admin, created_at)\n            VALUES (?, ?, 1, ?)\n            ON CONFLICT(username) DO UPDATE SET\n                password_hash = excluded.password_hash,\n                is_admin = 1\n            \"\"\",\n            (\n                ADMIN_USERNAME,\n                generate_password_hash(ADMIN_PASSWORD) if ADMIN_PASSWORD else None,\n                iso(),\n            ),\n        )\n        if not ADMIN_PASSWORD:\n            conn.execute(\n                \"DELETE FROM tokens WHERE user_id = \"\n                \"(SELECT id FROM users WHERE username = ?)\",\n                (ADMIN_USERNAME,),\n            )\n        conn.commit()\n    except Exception:\n        conn.rollback()\n        raise\n    finally:\n        conn.close()\n\n\ndef init_admin() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        conn.execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, is_admin, created_at)\n            VALUES (?, ?, 1, ?)","lineStart":60,"lineEnd":149,"totalLines":543,"truncated":true}},"title":"backend/app.