O_FIELDS = (\"title\", \"description\", \"priority\", \"due_date\", \"completed\")\n\n\ndef validate_todo_payload(data: dict, *, partial: bool) -> dict:\n    values: dict = {}\n    errors: dict = {}\n\n    if not partial and \"title\" not in data:\n        errors[\"title\"] = \"title is required.\"\n    elif \"title\" in data:\n        try:\n            values[\"title\"] = parse_text(data[\"title\"], \"title\", max_length=255)\n        except ValueError as exc:\n            errors[\"title\"] = str(exc)\n\n    if \"description\" in data:\n        value = data[\"description\"]\n        if value is None:\n            values[\"description\"] = None\n        elif not isinstance(value, str):\n            errors[\"description\"] = \"description must be a string or null.\"\n        elif len(value.strip()) > 2000:\n            errors[\"description\"] = \"description must be at most 2000 characters.\"\n        else:\n            values[\"description\"] = value.strip() or None\n    check(\"priority\", parse_priority)\n    if \"due_date\" in data: = set(data) - set(TODO_FIELDS)\n    if unknown:\n        errors[\"_body\"] = f\"Unknown field(s): {', '.join(sorted(unknown))}.\"\n\n    if errors:\n        raise ApiError(400, \"Validation failed.\", errors)\n    return values\n\n\n# --------------------------------------------------------------------------- #\n# Auth\n# --------------------------------------------------------------------------- #\n\n@app.post(\"/api/auth/register\")\ndef register():","lineStart":200,"lineEnd":254,"totalLines":438,"truncated":true}},"title":"backend/app.py","time":{"start":1794318509137,"end":1794318509147}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5b7a44c001QordmUGZGo3c7s","sessionID":"ses_e3a4b6a28ffe0d79gNiquwJxpB","messageID":"msg_1c5b79857001a0uziusNKygMe8"}}
