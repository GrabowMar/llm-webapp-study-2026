"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"import { useCallback, useEffect, useMemo, useState } from \"react\";\nimport { ApiError, getToken, getUsername, listTodos, logout } from \"./api\";\nimport AddTodoForm from \"./AddTodoForm\";\nimport AuthScreen from \"./AuthScreen\";\nimport TodoRow, { isOverdue } from \"./TodoRow\";\nimport type { Tab, Todo } from \"./types\";\n\nconst PAGE_SIZE = 10;\nconst tabs: { value: Tab; label: string }[] = [\n  { value: \"all\", label: \"All\" },\n  { value: \"open\", label: \"Open\" },\n  { value: \"completed\", label: \"Completed\" },\n];\nconst priorities = [\n  { value: \"\", label: \"All priorities\" },\n  { value: \"low\", label: \"Low\" },\n  { value: \"medium\", label: \"Medium\" },\n  { value: \"high\", label: \"High\" },\n];\n\nexport default function App() {\n  const [signedIn, setSignedIn] = useState(!!getToken());\n  const [username, setUsername] = useState(getUsername() ?? \"\");\n  const [sessionMessage, setSessionMessage] = useState(\"\");\n\n  function handleUnauthorized() {\n    logout();\n    setSignedIn(false);\n    setUsername(\"\");\n    setSessionMessage(\"Your session has expired. Please sign in again.\");\n  }\n\n  useEffect(() => {\n    window.addEventListener(\"todo:unauthorized\", handleUnauthorized);\n    return () => window.removeEventListener(\"todo:unauthorized\", handleUnauthorized);\n  }, []);\n\n  if (!signedIn) {\n    return (\n      <>\n        <AuthScreen\n          onSignedIn={(name) => {\n            setUsername(name);\n            setSessionMessage(\"\");\n            setSignedIn(true);\n          }}\n        />\n        {sessionMessage && (\n          <div className=\"fixed bottom-4 left-1/2 -translate-x-1/2 rounded-lg bg-slate-800 px-4 py-2 text-sm text-white shadow-lg\">\n            {sessionMessage}\n          </div>\n        )}\n      </>\n    );\n  }\n\n  return <TodoApp username={username} onSignedOut={handleUnauthorized} />;\n}\n\nfunction TodoApp({ username, onSignedOut }: { username: string; onSignedOut: () => void }) {\n  const [tab, setTab] = useState<Tab>(\"all\");\n  const [priority, setPriority] = useState(\"\");\n  const [items, setItems] = useState<Todo[]>([]);\n  const [loadedPages, setLoadedPages] = useState(0);\n  const [total, setTotal] = useState(0);\n  const [remaining, setRemaining] = useState(0);\n  const [openCount, setOpenCount] = useState<number | null>(null);\n  const [loading, setLoading] = useState(false);\n  const [loadingMore, setLoadingMore] = useState(false);\n  const [error, setError] = useState(\"\");","lineStart":1,"lineEnd":70,"totalLines":259,"truncated":true}},"title":"frontend/src/App.tsx","time":{"start":1794318776781,"end":1794318776794}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5bbb9c70018I9X4bv43pYjsA","sessionID":"ses_e3a4b6a28ffe0d79gNiquwJxpB","messageID":"msg_1c5bbab20001kKrO2aEPHDykpL"}}
