{"type":"text","timestamp":1794365073905,"sessionID":"ses_e3787ceceffeB33UjHzxSHKFAG","part":{"id":"prt_1c87e29e2001ClHlumr4sZd3J8","messageID":"msg_1c87bc2c00010C7uhuQJ7SaHxm","sessionID":"ses_e3787ceceffeB33UjHzxSHKFAG","type":"text","text":"Environment works. Now implementing the backend with stdlib-only dependencies (keeps the pinned lock files valid).","time":{"start":1794365073890,"end":1794365073902}}}
{"type":"tool_use","timestamp":1794365073952,"sessionID":"ses_e3787ceceffeB33UjHzxSHKFAG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a4cdb552e8b598b8","state":{"status":"completed","input":{"content":"\"\"\"Link previews: Flask JSON API and static frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport html\nimport json\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom contextlib import closing\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom urllib.error import HTTPError, URLError\nfrom urllib.parse import urljoin, urlsplit\nfrom urllib.request import Request, urlopen\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", str(BASE_DIR / \"data\")))\nDB_PATH = DATA_DIR / \"previews.db\"\n\nMAX_BODY_BYTES = 2 * 1024 * 1024\nFETCH_TIMEOUT = 10\nUSER_AGENT = \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"\n\nPREVIEW_FIELDS = (\n    \"id\",\n    \"url\",\n    \"final_url\",\n    \"status_code\",\n    \"title\",\n    \"description\",\n    \"image_url\",\n    \"fetched_at\",\n)\nPREVIEW_COLUMNS = \", \".join(PREVIEW_FIELDS)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id            INTEGER PRIMARY KEY AUTOINCREMENT,\n    username      TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at    TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS previews (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id     INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    url         TEXT NOT NULL,\n    final_url   TEXT,\n    status_code INTEGER,\n    title       TEXT,\n    description TEXT,\n    image_url   TEXT,\n    fetched_at  TEXT NOT NULL,\n    created_at  TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_previews_user_id ON previews(user_id, id DESC);\nCREATE INDEX IF NOT EXISTS idx_tokens_user_id ON tokens(user_id);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=15)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 10000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef request_body() -> dict:\n    data = request.get_json(silent=True)\n    if isinstance(data, dict):\n        return data\n    if request.form:\n        return request.form.to_dict()\n    try:\n        parsed = json.loads(request.get_data(as_text=True))\n        if isinstance(parsed, dict):\n            return parsed\n    except (ValueError, TypeError):\n        pass\n    return {}\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_bytes(16)\n    rounds = 180_000\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, rounds)\n    return f\"pbkdf2_sha256${rounds}${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        algorithm, rounds, salt_hex, digest_hex = stored.split(\"$\")\n        if algorithm != \"pbkdf2_sha256\":\n            return False\n        digest = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt_hex), int(rounds)\n        )\n        return hmac.compare_digest(digest.hex(), digest_hex)\n    except (AttributeError, TypeError, ValueError):\n        return False\n\n\ndef token_hash(token: str) -> str:\n    return hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n\n\ndef current_user_id():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.lower().startswith(\"bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT user_id FROM tokens WHERE token_hash = ?\", (token_hash(token),)\n    ).fetchone()\n    return row[\"user_id\"] if row else None\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user_id = current_user_id()\n        if user_id is None:\n            return error(\"unauthorized\", 401)\n        g.user_id = user_id\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {field: row[field] for field in PREVIEW_FIELDS}\n\n\ndef owned_preview(preview_id: int):\n    return get_db().execute(\n        f\"SELECT {PREVIEW_COLUMNS} FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, g.user_id),\n    ).fetchone()\n\n\ndef normalize_url(value) -> str | None:\n    if not isinstance(value, str):\n        return None\n    url = value.strip()\n    if not url or any(char.isspace() for char in url):\n        return None\n    if not re.match(r\"^https?://\", url, re.I):\n        return None\n    parts = urlsplit(url)\n    if parts.scheme.lower() not in (\"http\", \"https\") or not parts.hostname:\n        return None\n    return url\n\n\nclass FetchError(Exception):\n    pass\n\n\ndef decode_body(raw: bytes, content_type: str) -> str:\n    match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w.-]+)\", content_type, re.I)\n    encoding = match.group(1) if match else None\n    if not encoding:\n        head = raw[:4096].decode(\"ascii\", errors=\"ignore\")\n        match = re.search(r\"<meta[^>]+charset\\s*=\\s*[\\\"']?\\s*([\\w.-]+)\", head, re.I)\n        encoding = match.group(1) if match else \"utf-8\"\n    try:\n        return raw.decode(encoding, errors=\"replace\")\n    except LookupError:\n        return raw.decode(\"utf-8\", errors=\"replace\")\n\n\nclass MetadataParser(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.meta: dict[str, str] = {}\n        self.title_chunks: list[str] = []\n        self._in_title = False\n\n    def handle_starttag(self, tag, attrs):\n        tag = tag.lower()\n        if tag == \"title\":\n            self._in_title = True\n            return\n        if tag not in (\"meta\", \"link\"):\n            return\n        attributes: dict[str, str] = {}\n        for name, value in attrs:\n            if name is not None and value is not None:\n                attributes.setdefault(name.lower(), value)\n        if tag == \"meta\":\n            key = (attributes.get(\"property\") or attributes.get(\"name\") or \"\").strip().lower()\n            value = attributes.get(\"content\")\n        else:\n            if \"image_src\" not in attributes.get(\"rel\", \"\").lower():\n                return\n            key, value = \"image_src\", attributes.get(\"href\")\n        if key and value is not None:\n            self.meta.setdefault(key, value)\n\n    def handle_startendtag(self, tag, attrs):\n        self.handle_starttag(tag, attrs)\n        self.handle_endtag(tag)\n\n    def handle_data(self, data):\n        if self._in_title:\n            self.title_chunks.append(data)\n\n    def handle_endtag(self, tag):\n        if tag.lower() == \"title\":\n            self._in_title = False\n\n\ndef plain_text(value) -> str | None:\n    if value is None:\n        return None\n    text = re.sub(r\"<[^>]*>\", \" \", value)\n    text = re.sub(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]\", \" \", text)\n    text = html.unescape(text)\n    return \" \".join(text.split()) or None\n\n\ndef extract_metadata(document: str, final_url: str) -> dict:\n    parser = MetadataParser()\n    try:\n        parser.feed(document)\n        parser.close()\n    except (AssertionError, ValueError):\n        pass\n    meta = parser.meta\n    title = plain_text(meta.get(\"og:title\")) or plain_text(\"\".join(parser.title_chunks))\n    description = plain_text(meta.get(\"og:description\")) or plain_text(meta.get(\"description\"))\n    image = None\n    for key in (\"og:image\", \"og:image:url\", \"og:image:secure_url\", \"twitter:image\", \"image_src\"):\n        candidate = plain_text(meta.get(key))\n        if candidate:\n            image = candidate\n            break\n    if image:\n        image = urljoin(final_url, image)\n    return {\"title\": title, \"description\": description, \"image_url\": image}\n\n\ndef fetch_preview(url: str) -> dict:\n    req = Request(\n        url,\n        headers={\n            \"User-Agent\": USER_AGENT,\n            \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n            \"Accept-Language\": \"en-US,en;q=0.9\",\n        },\n    )\n    try:\n        response = urlopen(req, timeout=FETCH_TIMEOUT)\n    except HTTPError as exc:\n        response = exc\n    except (URLError, OSError, ValueError) as exc:\n        raise FetchError(str(exc)) from exc\n\n    with closing(response):\n        status = getattr(response, \"status\", None) or getattr(response, \"code\", None) or 200\n        final_url = response.geturl() or url\n        headers = response.headers\n        content_type = headers.get(\"Content-Type\", \"\") if headers else \"\"\n        raw = response.read(MAX_BODY_BYTES + 1)\n\n    metadata = extract_metadata(decode_body(raw, content_type), final_url)\n    return {\n        \"final_url\": final_url,\n        \"status_code\": int(status),\n        \"title\": metadata[\"title\"],\n        \"description\": metadata[\"description\"],\n        \"image_url\": metadata[\"image_url\"],\n        \"fetched_at\": utc_now(),\n    }\n\n\n@app.after_request\ndef add_cors(response):\n    response.headers[\"Access-Control-Allow-Origin\"] = \"*\"\n    response.headers[\"Access-Control-Allow-Headers\"] = \"Content-Type, Authorization\"\n    response.headers[\"Access-Control-Allow-Methods\"] = \"GET, POST, DELETE, OPTIONS\"\n    return response\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request_body()\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or len(username) > 80 or not password or len(password) > 1024:\n        return error(\"invalid username or password\", 400)\n    conn = get_db()\n    try:\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, hash_password(password), utc_now()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request_body()\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        return error(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    conn = get_db()\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, created_at) VALUES (?, ?, ?)\",\n        (token_hash(token), row[\"id\"], utc_now()),\n    )\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\n@require_auth\ndef me():\n    row = get_db().execute(\"SELECT username FROM users WHERE id = ?\", (g.user_id,)).fetchone()\n    return jsonify({\"id\": g.user_id, \"username\": row[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@require_auth\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    get_db().execute(\n        \"DELETE FROM tokens WHERE token_hash = ?\", (token_hash(header[7:].strip()),)\n    )\n    get_db().commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/previews\")\n@require_auth\ndef create_preview():\n    url = normalize_url(request_body().get(\"url\"))\n    if url is None:\n        return error(\"a valid http(s) url is required\", 400)\n    try:\n        fetched = fetch_preview(url)\n    except FetchError as exc:\n        return error(f\"could not fetch url: {exc}\", 502)\n    conn = get_db()\n    cursor = conn.execute(\n        \"INSERT INTO previews \"\n        \"(user_id, url, final_url, status_code, title, description, image_url, fetched_at, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            g.user_id,\n            url,\n            fetched[\"final_url\"],\n            fetched[\"status_code\"],\n            fetched[\"title\"],\n            fetched[\"description\"],\n            fetched[\"image_url\"],\n            fetched[\"fetched_at\"],\n            fetched[\"fetched_at\"],\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\n        f\"SELECT {PREVIEW_COLUMNS} FROM previews WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(serialize(row))\n\n\ndef positive_int(value, default: int, maximum: int | None = None) -> int:\n    try:\n        number = int(value)\n    except (TypeError, ValueError):\n        return default\n    if number < 1:\n        return default\n    return min(number, maximum) if maximum else number\n\n\n@app.get(\"/api/previews\")\n@require_auth\ndef list_previews():\n    page = positive_int(request.args.get(\"page\"), 1)\n    page_size = positive_int(request.args.get(\"page_size\"), 20, 100)\n    conn = get_db()\n    total = conn.execute(\n        \"SELECT COUNT(*) AS n FROM previews WHERE user_id = ?\", (g.user_id,)\n    ).fetchone()[\"n\"]\n    rows = conn.execute(\n        f\"SELECT {PREVIEW_COLUMNS} FROM previews WHERE user_id = ? \"\n        \"ORDER BY id DESC LIMIT ? OFFSET ?\",\n        (g.user_id, page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@require_auth\ndef get_preview(preview_id: int):\n    row = owned_preview(preview_id)\n    if row is None:\n        return error(\"not found\", 404)\n    return jsonify(serialize(row))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@require_auth\ndef refresh_preview(preview_id: int):\n    row = owned_preview(preview_id)\n    if row is None:\n        return error(\"not found\", 404)\n    try:\n        fetched = fetch_preview(row[\"url\"])\n    except FetchError as exc:\n        return error(f\"could not fetch url: {exc}\", 502)\n    conn = get_db()\n    conn.execute(\n        \"UPDATE previews SET final_url = ?, status_code = ?, title = ?, \"\n        \"description = ?, image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n        (\n            fetched[\"final_url\"],\n            fetched[\"status_code\"],\n            fetched[\"title\"],\n            fetched[\"description\"],\n            fetched[\"image_url\"],\n            fetched[\"fetched_at\"],\n            preview_id,\n            g.user_id,\n        ),\n    )\n    conn.commit()\n    return jsonify(serialize(owned_preview(preview_id)))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@require_auth\ndef delete_preview(preview_id: int):\n    if owned_preview(preview_id) is None:\n        return error(\"not found\", 404)\n    conn = get_db()\n    conn.execute(\n        \"DELETE FROM previews WHERE id = ? AND user_id = ?\", (preview_id, g.user_id)\n    )\n    conn.commit()\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")), debug=False)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794365073899,"end":1794365073936}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c87e29e5001Ctd4vOXbc3T4Vo","sessionID":"ses_e3787ceceffeB33UjHzxSHKFAG","messageID":"msg_1c87bc2c00010C7uhuQJ7SaHxm"}}
