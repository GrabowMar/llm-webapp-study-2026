45:     } catch (error) {\n546:       setBoardError(errorMessages(error).join(\" \"));\n547:       await load();\n548:     }\n549:   }\n550: \n551:   async function signOut() {\n552:     try {\n553:       await api(\"/auth/logout\", { method: \"POST\" });\n554:     } catch {\n555:       /* local sign-out regardless */\n556:     }\n557:     clearSession();\n\n(Showing lines 458-557 of 773. Use offset=558 to continue.)\n</content>","metadata":{"preview":"\n  useEffect(() => {\n    if (username && !getToken()) setUsername(null);\n  }, [username]);\n\n  const byColumn = useMemo(() => {\n    const grouped: Record<Status, Task[]> = { todo: [], in_progress: [], done: [] };\n    for (const task of tasks) grouped[task.status].push(task);\n    for (const status of Object.keys(grouped) as Status[]) {\n      grouped[status].sort((a, b) => a.position - b.position);\n    }\n    return grouped;\n  }, [tasks]);\n\n  function setDrop(status: Status, position: number) {\n    const next = { status, position };\n    const current = dropRef.current;\n    if (!current || current.status !== status || current.position !== position) {\n      dropRef.current = next;\n      setDropTarget(next);","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"\n  useEffect(() => {\n    if (username && !getToken()) setUsername(null);\n  }, [username]);\n\n  const byColumn = useMemo(() => {\n    const grouped: Record<Status, Task[]> = { todo: [], in_progress: [], done: [] };\n    for (const task of tasks) grouped[task.status].push(task);\n    for (const status of Object.keys(grouped) as Status[]) {\n      grouped[status].sort((a, b) => a.position - b.position);\n    }\n    return grouped;\n  }, [tasks]);\n\n  function setDrop(status: Status, position: number) {\n    const next = { status, position };\n    const current = dropRef.current;\n    if (!current || current.status !== status || current.position !== position) {\n      dropRef.current = next;\n      setDropTarget(next);\n    }\n  }\n\n  function clearDrop() {\n    dropRef.current = null;\n    setDropTarget(null);\n  }\n\n  function handleDragStart(event: DragEvent<HTMLDivElement>, task: Task) {\n    dragIdRef.current = task.id;\n    setDraggingId(task.id);\n    event.dataTransfer.setData(DRAG_TYPE, String(task.id));\n    event.dataTransfer.setData(\"text/plain\", String(task.id));\n    event.dataTransfer.effectAllowed = \"move\";\n  }\n\n  function handleDragEnd() {\n    dragIdRef.current = null;\n    setDraggingId(null);\n    clearDrop();\n  }\n\n  function targetIdFromEvent(event: DragEvent): number | null {\n    if (dragIdRef.current !== null) return dragIdRef.current;\n    const raw = event.dataTransfer.types.includes(DRAG_TYPE) ? null : null;\n    void raw;\n    return null;\n  }\n\n  function handleDragOverCard(event: DragEvent<HTMLDivElement>, task: Task) {\n    if (!signedIn || dragIdRef.current === null) return;\n    event.preventDefault();\n    event.stopPropagation();\n    event.dataTransfer.dropEffect = \"move\";\n    const rect = event.currentTarget.getBoundingClientRect();\n    const after = event.clientY > rect.top + rect.height / 2;\n    setDrop(task.status, task.position + (after ? 1 : 0));\n  }\n\n  function handleDragOverColumn(event: DragEvent<HTMLElement>, status: Status) {\n    if (!signedIn || dragIdRef.current === null) return;\n    event.preventDefault();\n    event.dataTransfer.dropEffect = \"move\";\n    setDrop(status, byColumn[status].length + 1);\n  }\n\n  async function handleDrop(event: DragEvent<HTMLElement>, status: Status) {\n    event.preventDefault();\n    const id = dragIdRef.current ?? targetIdFromEvent(event);\n    const target = dropRef.current;\n    clearDrop();\n    dragIdRef.current = null;\n    setDraggingId(null);\n    if (!signedIn || id === null || !target) return;\n    const task = tasks.find((item) => item.id === id);\n    if (!task) return;\n    let position = target.status === status ? target.position : byColumn[status].length + 1;\n    if (task.status === status) {\n      const others = byColumn[status].filter((item) => item.id !== id);\n      position = Math.min(Math.max(position, 1), others.length + 1);\n    } else {\n      position = Math.min(Math.max(position, 1), byColumn[status].length + 1);\n    }\n    if (task.status === status && task.position === position) return;\n    try {\n      await api<Task>(`/tasks/${id}`, { method: \"PATCH\" }, { status, position });\n      await load();\n    } catch (error) {\n      setBoardError(errorMessages(error).join(\" \"));\n      await load();\n    }\n  }\n\n  async function signOut() {\n    try {\n      await api(\"/auth/logout\", { method: \"POST\" });\n    } catch {\n      /* local sign-out regardless */\n    }\n    clearSession();","lineStart":458,"lineEnd":557,"totalLines":773,"truncated":true}},"title":"frontend/src/App.tsx","time":{"start":1794356916784,"end":1794356916800}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c801b22a001ThvJRwcqSsxtXS","sessionID":"ses_e380696a2ffeWSq0p0ymcAOEDb","messageID":"msg_1c801a258001hQXzuvW7SXReJm"}}
