8edfc67aabac33708941f26f22a7b8e9f81429bc0cf249fcf7d66b23af8d19 \\\n    --hash=sha256:fa95848c929b6a75f6848d3c9793e59db365ee436776e57db835cdbfa79ba977 \\\n    --hash=sha256:fd9f8797427910198f95bced71ddfed61130d7e349213bfb8466c9c99e2c46a8 \\\n    --hash=sha256:fdb4ca07ab75ffadab4a8b135ad59cdbb3156b99310f3d565370da74a15d6bd3\n    # via\n    #   flask\n    #   jinja2\n    #   werkzeug\nwerkzeug==3.1.9 \\\n    --hash=sha256:55ca7c70a75689be937aa27f8ff4b018f06ff4838fc73045560bf0f5a1291060 \\\n    --hash=sha256:6392e50c78460ba618e5b21f08a71f59c99ce99cdc6cf6e3dd7e6ccca8754fab\n    # via flask\n===== backend/app.py =====\n\"\"\"Flask entry point.\"\"\"\n\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n===== frontend/package.json =====\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"vite\": \"8.3.5\"\n  }\n}\n===== frontend/index.html =====\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>App</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n===== frontend/vite.config.ts =====\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\n===== frontend/src/main.tsx =====\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\n===== frontend/src/App.tsx =====\nexport default function App() {\n  return <h1>App</h1>;\n}\n","metadata":{"output":"===== Dockerfile =====\nFROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\nWORKDIR /app\nCOPY frontend/package.json frontend/package-lock.json* frontend/\nRUN cd frontend \\\n    && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\nCOPY frontend/ frontend/\nRUN cd frontend && npm run build\n\nFROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\nENV PYTHONDONTWRITEBYTECODE=1 \\\n    PYTHONUNBUFFERED=1 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    PORT=8000\nWORKDIR /app\nCOPY backend/requirements.txt backend/requirements.lock* backend/\nRUN if [ -f backend/requirements.lock ]; then \\\n      pip install --no-cache-dir -r backend/requirements.txt -c backend/requirements.lock; \\\n    else \\\n      pip install --no-cache-dir -r backend/requirements.txt; \\\n    fi\nCOPY backend/ backend/\nCOPY --from=frontend /app/frontend/dist frontend/dist\nRUN mkdir -p data\nEXPOSE 8000\nCMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]\n===== .dockerignore =====\n**/node_modules\n**/.venv\n**/venv\n**/__pycache__\n**/*.pyc\n**/.git\nfrontend/dist\ndata/*.db\ndata/*.sqlite\ndata/*.sqlite3\n===== backend/requirements.txt =====\nflask==3.1.3\ngunicorn==26.2.0\n===== backend/requirements.lock =====\nblinker==1.9.0 \\\n    --hash=sha256:b4ce2265a7abece45e7cc896e98dbebe6cead56bcf805a3d23136d145f5445bf \\\n    --hash=sha256:ba0efaa9080b619ff2f3459d1d500c57b