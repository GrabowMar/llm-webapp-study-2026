{"type":"tool_use","timestamp":1794375630417,"sessionID":"ses_e36f19058ffeXfAI4v8uekZO02","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b0c3a0736ab5c7be","state":{"status":"completed","input":{"content":"\"\"\"Flask application: private Markdown notes with a JSON API and a SPA frontend.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nimport bleach\nimport markdown\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"notes.sqlite3\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    try:\n        db.execute(\"PRAGMA journal_mode = WAL\")\n        db.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS notes (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                title TEXT NOT NULL DEFAULT '',\n                body TEXT NOT NULL DEFAULT '',\n                published INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_notes_user_updated\n                ON notes(user_id, updated_at DESC);\n            \"\"\"\n        )\n        db.commit()\n    finally:\n        db.close()\n\n\ninit_db()\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(error: ApiError):\n    return jsonify({\"error\": error.message}), error.status\n\n\n@app.errorhandler(404)\ndef handle_not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return serve_frontend(\"index.html\")\n\n\n@app.errorhandler(405)\ndef handle_method_not_allowed(_error):\n    return jsonify({\"error\": \"method not allowed\"}), 405\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"expected a JSON object\")\n    return data\n\n\ndef require_string(data: dict, key: str) -> str:\n    value = data.get(key)\n    if not isinstance(value, str):\n        raise ApiError(400, f\"{key} must be a string\")\n    return value\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"\"\"SELECT u.id, u.username FROM tokens t\n           JOIN users u ON u.id = t.user_id WHERE t.token = ?\"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        raise ApiError(401, \"authentication required\")\n    return user\n\n\ndef note_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"body\": row[\"body\"],\n        \"published\": bool(row[\"published\"]),\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\nNOTE_QUERY = \"\"\"\n    SELECT n.id, n.title, n.body, n.published, n.updated_at, u.username AS author\n    FROM notes n JOIN users u ON u.id = n.user_id\n\"\"\"\n\n\ndef own_note(note_id: int, user_id: int):\n    row = get_db().execute(\n        NOTE_QUERY + \" WHERE n.id = ? AND n.user_id = ?\", (note_id, user_id)\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"note not found\")\n    return row\n\n\nALLOWED_TAGS = [\n    \"p\", \"br\", \"hr\", \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", \"h6\", \"ul\", \"ol\", \"li\",\n    \"dl\", \"dt\", \"dd\", \"blockquote\", \"pre\", \"code\", \"strong\", \"em\", \"b\", \"i\",\n    \"a\", \"img\", \"del\", \"ins\", \"sup\", \"sub\", \"table\", \"thead\", \"tbody\", \"tfoot\",\n    \"tr\", \"th\", \"td\", \"div\", \"span\", \"abbr\", \"kbd\", \"s\", \"q\", \"input\",\n]\nALLOWED_ATTRS = {\n    \"*\": [\"class\", \"id\", \"title\"],\n    \"a\": [\"href\", \"title\", \"rel\", \"target\"],\n    \"img\": [\"src\", \"alt\", \"title\", \"width\", \"height\"],\n    \"th\": [\"align\", \"colspan\", \"rowspan\", \"scope\"],\n    \"td\": [\"align\", \"colspan\", \"rowspan\"],\n    \"ol\": [\"start\"],\n    \"code\": [\"class\"],\n    \"pre\": [\"class\"],\n    \"input\": [\"type\", \"checked\", \"disabled\"],\n}\n\n\ndef render_markdown(body: str) -> str:\n    raw = markdown.markdown(body, extensions=[\"extra\", \"sane_lists\"])\n    return bleach.clean(\n        raw,\n        tags=ALLOWED_TAGS,\n        attributes=ALLOWED_ATTRS,\n        protocols=[\"http\", \"https\", \"mailto\"],\n        strip=True,\n    )\n\n\ndef html_response(html: str) -> Response:\n    return Response(html, status=200, content_type=\"text/html; charset=utf-8\")\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{1,64}$\")\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = require_string(data, \"username\").strip()\n    password = require_string(data, \"password\")\n    if not USERNAME_RE.fullmatch(username):\n        raise ApiError(400, \"username must be 1-64 letters, digits, _, . or -\")\n    if not password:\n        raise ApiError(400, \"password must not be empty\")\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        raise ApiError(409, \"username already taken\")\n    db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), utc_now()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = require_string(data, \"username\").strip()\n    password = require_string(data, \"password\")\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        raise ApiError(401, \"invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], utc_now()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    if header.startswith(\"Bearer \"):\n        token = header[len(\"Bearer \") :].strip()\n        db = get_db()\n        db.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n        db.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    user = require_user()\n    rows = get_db().execute(\n        \"\"\"SELECT n.id, n.title, n.published, n.updated_at\n           FROM notes n WHERE n.user_id = ?\n           ORDER BY n.updated_at DESC, n.id DESC\"\"\",\n        (user[\"id\"],),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\n                    \"id\": row[\"id\"],\n                    \"title\": row[\"title\"],\n                    \"published\": bool(row[\"published\"]),\n                    \"updated_at\": row[\"updated_at\"],\n                }\n                for row in rows\n            ]\n        }\n    )\n\n\ndef note_fields_for_create(data: dict) -> tuple:\n    title = data.get(\"title\", \"\")\n    body = data.get(\"body\", \"\")\n    published = data.get(\"published\", False)\n    if not isinstance(title, str):\n        raise ApiError(400, \"title must be a string\")\n    if not isinstance(body, str):\n        raise ApiError(400, \"body must be a string\")\n    if not isinstance(published, bool):\n        raise ApiError(400, \"published must be a boolean\")\n    return title, body, published\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = require_user()\n    title, body, published = note_fields_for_create(json_body())\n    db = get_db()\n    now = utc_now()\n    cursor = db.execute(\n        \"\"\"INSERT INTO notes (user_id, title, body, published, created_at, updated_at)\n           VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (user[\"id\"], title, body, int(published), now, now),\n    )\n    db.commit()\n    row = own_note(cursor.lastrowid, user[\"id\"])\n    return jsonify(note_dict(row)), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    user = require_user()\n    return jsonify(note_dict(own_note(note_id, user[\"id\"])))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\ndef update_note(note_id: int):\n    user = require_user()\n    own_note(note_id, user[\"id\"])\n    data = json_body()\n    allowed = {\"title\", \"body\", \"published\"}\n    if not any(key in data for key in allowed):\n        raise ApiError(400, \"no updatable fields provided\")\n    updates = {}\n    if \"title\" in data:\n        if not isinstance(data[\"title\"], str):\n            raise ApiError(400, \"title must be a string\")\n        updates[\"title\"] = data[\"title\"]\n    if \"body\" in data:\n        if not isinstance(data[\"body\"], str):\n            raise ApiError(400, \"body must be a string\")\n        updates[\"body\"] = data[\"body\"]\n    if \"published\" in data:\n        if not isinstance(data[\"published\"], bool):\n            raise ApiError(400, \"published must be a boolean\")\n        updates[\"published\"] = int(data[\"published\"])\n    updates[\"updated_at\"] = utc_now()\n    assignments = \", \".join(f\"{key} = ?\" for key in updates)\n    values = list(updates.values()) + [note_id, user[\"id\"]]\n    db = get_db()\n    db.execute(\n        f\"UPDATE notes SET {assignments} WHERE id = ? AND user_id = ?\", values\n    )\n    db.commit()\n    return jsonify(note_dict(own_note(note_id, user[\"id\"])))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\ndef delete_note(note_id: int):\n    user = require_user()\n    own_note(note_id, user[\"id\"])\n    db = get_db()\n    db.execute(\"DELETE FROM notes WHERE id = ? AND user_id = ?\", (note_id, user[\"id\"]))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/notes/<int:note_id>/html\")\ndef note_html(note_id: int):\n    user = require_user()\n    row = own_note(note_id, user[\"id\"])\n    return html_response(render_markdown(row[\"body\"]))\n\n\n@app.get(\"/api/public/notes/<int:note_id>/html\")\ndef public_note_html(note_id: int):\n    row = get_db().execute(\n        NOTE_QUERY + \" WHERE n.id = ? AND n.published = 1\", (note_id,)\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"note not found\")\n    return html_response(render_markdown(row[\"body\"]))\n\n\n@app.get(\"/api/public/notes/<int:note_id>\")\ndef public_note(note_id: int):\n    row = get_db().execute(\n        \"\"\"SELECT n.id, n.title, n.published, n.updated_at, u.username AS author\n           FROM notes n JOIN users u ON u.id = n.user_id\n           WHERE n.id = ? AND n.published = 1\"\"\",\n        (note_id,),\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"note not found\")\n    return jsonify(\n        {\n            \"id\": row[\"id\"],\n            \"title\": row[\"title\"],\n            \"published\": True,\n            \"updated_at\": row[\"updated_at\"],\n            \"author\": row[\"author\"],\n        }\n    )\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"GET\", \"POST\", \"PATCH\", \"PUT\", \"DELETE\"])\ndef api_fallback(_path):\n    raise ApiError(404, \"not found\")\n\n\ndef serve_frontend(path: str = \"index.html\"):\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    return serve_frontend(path)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794375630373,"end":1794375630398}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c91f3e1c001bAJiUofOL5Wkk4","sessionID":"ses_e36f19058ffeXfAI4v8uekZO02","messageID":"msg_1c91ede3c001pyzWeie1Vam7gJ"}}
