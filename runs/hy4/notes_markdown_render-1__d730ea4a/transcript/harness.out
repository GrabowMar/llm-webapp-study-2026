not isinstance(data[\"body\"], str):\n342:             raise ApiError(400, \"body must be a string\")\n343:         updates[\"body\"] = data[\"body\"]\n344:     if \"published\" in data:\n345:         if not isinstance(data[\"published\"], bool):\n346:             raise ApiError(400, \"published must be a boolean\")\n347:         updates[\"published\"] = int(data[\"published\"])\n348:     updates[\"updated_at\"] = utc_now()\n349:     assignments = \", \".join(f\"{key} = ?\" for key in updates)\n350:     values = list(updates.values()) + [note_id, user[\"id\"]]\n351:     db = get_db()\n352:     db.execute(f\"UPDATE notes SET {assignments} WHERE id = ? AND user_id = ?\", values)\n353:     db.commit()\n354:     return jsonify(note_dict(own_note(note_id, user[\"id\"])))\n355: \n356: \n357: @app.delete(\"/api/notes/<int:note_id>\")\n358: def delete_note(note_id: int):\n359:     user = require_user()\n\n(Showing lines 300-359 of 421. Use offset=360 to continue.)\n</content>","metadata":{"preview":"        raise ApiError(400, \"body must be a string\")\n    if not isinstance(published, bool):\n        raise ApiError(400, \"published must be a boolean\")\n    return title, body, published\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = require_user()\n    title, body, published = note_fields_for_create(json_body())\n    db = get_db()\n    now = utc_now()\n    cursor = db.execute(\n        \"\"\"INSERT INTO notes (user_id, title, body, published, created_at, updated_at)\n           VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (user[\"id\"], title, body, int(published), now, now),\n    )\n    db.commit()\n    return jsonify(note_dict(own_note(cursor.lastrowid, user[\"id\"]))), 201\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"        raise ApiError(400, \"body must be a string\")\n    if not isinstance(published, bool):\n        raise ApiError(400, \"published must be a boolean\")\n    return title, body, published\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = require_user()\n    title, body, published = note_fields_for_create(json_body())\n    db = get_db()\n    now = utc_now()\n    cursor = db.execute(\n        \"\"\"INSERT INTO notes (user_id, title, body, published, created_at, updated_at)\n           VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (user[\"id\"], title, body, int(published), now, now),\n    )\n    db.commit()\n    return jsonify(note_dict(own_note(cursor.lastrowid, user[\"id\"]))), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    user = require_user()\n    return jsonify(note_dict(own_note(note_id, user[\"id\"])))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\ndef update_note(note_id: int):\n    user = require_user()\n    own_note(note_id, user[\"id\"])\n    data = json_body()\n    allowed = {\"title\", \"body\", \"published\"}\n    if not any(key in data for key in allowed):\n        raise ApiError(400, \"no updatable fields provided\")\n    updates = {}\n    if \"title\" in data:\n        if not isinstance(data[\"title\"], str):\n            raise ApiError(400, \"title must be a string\")\n        updates[\"title\"] = data[\"title\"]\n    if \"body\" in data:\n        if not isinstance(data[\"body\"], str):\n            raise ApiError(400, \"body must be a string\")\n        updates[\"body\"] = data[\"body\"]\n    if \"published\" in data:\n        if not isinstance(data[\"published\"], bool):\n            raise ApiError(400, \"published must be a boolean\")\n        updates[\"published\"] = int(data[\"published\"])\n    updates[\"updated_at\"] = utc_now()\n    assignments = \", \".join(f\"{key} = ?\" for key in updates)\n    values = list(updates.values()) + [note_id, user[\"id\"]]\n    db = get_db()\n    db.execute(f\"UPDATE notes SET {assignments} WHERE id = ? AND user_id = ?\", values)\n    db.commit()\n    return jsonify(note_dict(own_note(note_id, user[\"id\"])))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\ndef delete_note(note_id: int):\n    user = require_user()","lineStart":300,"lineEnd":359,"totalLines":421,"truncated":true}},"title":"backend/app.py","time":{"start":1794375958902,"end":1794375958926}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c924416c0019dbZw63VCb9VYN","sessionID":"ses_e36f19058ffeXfAI4v8uekZO02","messageID":"msg_1c9230be500143BuFI1fMWVRzU"}}
