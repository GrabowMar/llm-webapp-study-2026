{"type":"tool_use","timestamp":1794312800674,"sessionID":"ses_e3aa4d1dbffeZWAjA1G1VHOklk","part":{"type":"tool","tool":"write","callID":"call_7d23ef629e7646d7b0323ada","state":{"status":"completed","input":{"content":"\"\"\"Account service: registration, sign-in, password reset and an outbox.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport hashlib\nimport hmac\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"app.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nMIN_PASSWORD_LENGTH = 8\nPBKDF2_ITERATIONS = 200_000\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS accounts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    email TEXT,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE UNIQUE INDEX IF NOT EXISTS idx_accounts_email\n    ON accounts (lower(email)) WHERE email IS NOT NULL;\nCREATE TABLE IF NOT EXISTS auth_tokens (\n    token TEXT PRIMARY KEY,\n    account_id INTEGER NOT NULL REFERENCES accounts(id),\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS reset_tokens (\n    token TEXT PRIMARY KEY,\n    account_id INTEGER NOT NULL REFERENCES accounts(id),\n    created_at TEXT NOT NULL,\n    used_at TEXT\n);\nCREATE TABLE IF NOT EXISTS outbox (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    recipient TEXT NOT NULL,\n    subject TEXT NOT NULL,\n    body TEXT NOT NULL,\n    sent_at TEXT NOT NULL\n);\n\"\"\"\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc=None):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Passwords and tokens\n# ---------------------------------------------------------------------------\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_bytes(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), salt, PBKDF2_ITERATIONS\n    )\n    return \"pbkdf2_sha256${}${}${}\".format(\n        PBKDF2_ITERATIONS,\n        base64.b64encode(salt).decode(\"ascii\"),\n        base64.b64encode(digest).decode(\"ascii\"),\n    )\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        algorithm, iterations, salt_b64, digest_b64 = stored.split(\"$\")\n        if algorithm != \"pbkdf2_sha256\":\n            return False\n        salt = base64.b64decode(salt_b64)\n        expected = base64.b64decode(digest_b64)\n    except (ValueError, TypeError):\n        return False\n    candidate = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), salt, int(iterations)\n    )\n    return hmac.compare_digest(candidate, expected)\n\n\ndef new_token() -> str:\n    return secrets.token_urlsafe(32)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef check_password(password) -> str | None:\n    if not isinstance(password, str):\n        return \"password is required\"\n    if len(password) < MIN_PASSWORD_LENGTH:\n        return f\"password must be at least {MIN_PASSWORD_LENGTH} characters\"\n    return None\n\n\ndef check_email(email) -> str | None:\n    if email is None:\n        return None\n    if not isinstance(email, str) or not EMAIL_RE.match(email):\n        return \"invalid email address\"\n    return None\n\n\ndef account_json(row: sqlite3.Row) -> dict:\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"email\": row[\"email\"]}\n\n\ndef get_account_by_token(token: str):\n    row = get_db().execute(\n        \"\"\"\n        SELECT a.* FROM auth_tokens t\n        JOIN accounts a ON a.id = t.account_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        if not header.startswith(\"Bearer \"):\n            return error(\"authentication required\", 401)\n        account = get_account_by_token(header[len(\"Bearer \"):].strip())\n        if account is None:\n            return error(\"invalid or expired token\", 401)\n        g.account = account\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef json_body():\n    return request.get_json(silent=True) or {}\n\n\n# ---------------------------------------------------------------------------\n# Auth\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    email = body.get(\"email\")\n\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    username = username.strip()\n    problem = check_password(password)\n    if problem:\n        return error(problem, 400)\n    if email is not None and not isinstance(email, str):\n        return error(\"invalid email address\", 400)\n    if isinstance(email, str):\n        email = email.strip() or None\n    problem = check_email(email)\n    if problem:\n        return error(problem, 400)\n\n    db = get_db()\n    if db.execute(\n        \"SELECT 1 FROM accounts WHERE username = ?\", (username,)\n    ).fetchone():\n        return error(\"username already taken\", 400)\n    if email is not None and db.execute(\n        \"SELECT 1 FROM accounts WHERE lower(email) = lower(?)\", (email,)\n    ).fetchone():\n        return error(\"email address already in use\", 400)\n\n    cur = db.execute(\n        \"INSERT INTO accounts (username, email, password_hash, created_at)\"\n        \" VALUES (?, ?, ?, ?)\",\n        (username, email, hash_password(password), utcnow()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT id, username, email FROM accounts WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(account_json(row)), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM accounts WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        return error(\"invalid username or password\", 401)\n\n    token = new_token()\n    db.execute(\n        \"INSERT INTO auth_tokens (token, account_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    token = header[len(\"Bearer \"):].strip()\n    db = get_db()\n    db.execute(\"DELETE FROM auth_tokens WHERE token = ?\", (token,))\n    db.commit()\n    return jsonify({\"message\": \"signed out\"})\n\n\n# ---------------------------------------------------------------------------\n# Account\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/me\")\n@login_required\ndef me():\n    return jsonify(account_json(g.account))\n\n\n@app.patch(\"/api/me\")\n@login_required\ndef update_me():\n    body = json_body()\n    if \"email\" not in body:\n        return error(\"email is required\", 400)\n    email = body.get(\"email\")\n    if email is not None and not isinstance(email, str):\n        return error(\"invalid email address\", 400)\n    if isinstance(email, str):\n        email = email.strip() or None\n    problem = check_email(email)\n    if problem:\n        return error(problem, 400)\n\n    db = get_db()\n    if email is not None and db.execute(\n        \"SELECT 1 FROM accounts WHERE lower(email) = lower(?) AND id != ?\",\n        (email, g.account[\"id\"]),\n    ).fetchone():\n        return error(\"email address already in use\", 400)\n\n    db.execute(\n        \"UPDATE accounts SET email = ? WHERE id = ?\", (email, g.account[\"id\"])\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT id, username, email FROM accounts WHERE id = ?\", (g.account[\"id\"],)\n    ).fetchone()\n    return jsonify(account_json(row))\n\n\n@app.post(\"/api/me/password\")\n@login_required\ndef change_password():\n    body = json_body()\n    current = body.get(\"current_password\")\n    new = body.get(\"new_password\")\n    if not isinstance(current, str):\n        return error(\"current_password is required\", 400)\n    problem = check_password(new)\n    if problem:\n        return error(problem, 400)\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT password_hash FROM accounts WHERE id = ?\", (g.account[\"id\"],)\n    ).fetchone()\n    if not verify_password(current, row[\"password_hash\"]):\n        return error(\"current password is incorrect\", 400)\n\n    db.execute(\n        \"UPDATE accounts SET password_hash = ? WHERE id = ?\",\n        (hash_password(new), g.account[\"id\"]),\n    )\n    db.execute(\n        \"DELETE FROM reset_tokens WHERE account_id = ? AND used_at IS NULL\",\n        (g.account[\"id\"],),\n    )\n    db.commit()\n    return jsonify({\"message\": \"password updated\"})\n\n\n# ---------------------------------------------------------------------------\n# Password reset\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/password-reset\")\ndef password_reset():\n    body = json_body()\n    email = body.get(\"email\")\n    username = body.get(\"username\")\n\n    db = get_db()\n    account = None\n    if isinstance(email, str) and email.strip():\n        account = db.execute(\n            \"SELECT * FROM accounts WHERE lower(email) = lower(?)\", (email.strip(),)\n        ).fetchone()\n    if account is None and isinstance(username, str) and username.strip():\n        account = db.execute(\n            \"SELECT * FROM accounts WHERE username = ?\", (username.strip(),)\n        ).fetchone()\n\n    if account is not None and account[\"email\"]:\n        token = new_token()\n        db.execute(\n            \"INSERT INTO reset_tokens (token, account_id, created_at)\"\n            \" VALUES (?, ?, ?)\",\n            (token, account[\"id\"], utcnow()),\n        )\n        link = f\"/reset?token={token}\"\n        body_text = (\n            f\"Hello {account['username']},\\n\\n\"\n            \"A password reset was requested for your account.\\n\"\n            \"Open the link below to choose a new password. It can be used once:\\n\\n\"\n            f\"{link}\\n\\n\"\n            \"If you did not request this, you can ignore this message.\\n\"\n        )\n        db.execute(\n            \"INSERT INTO outbox (recipient, subject, body, sent_at)\"\n            \" VALUES (?, ?, ?, ?)\",\n            (account[\"email\"], \"Password reset\", body_text, utcnow()),\n        )\n        db.commit()\n\n    return jsonify({\"message\": \"If the account exists, a reset link is on its way\"})\n\n\n@app.post(\"/api/auth/password-reset/confirm\")\ndef password_reset_confirm():\n    body = json_body()\n    token = body.get(\"token\")\n    new = body.get(\"new_password\")\n    if not isinstance(token, str) or not token.strip():\n        return error(\"token is required\", 400)\n    problem = check_password(new)\n    if problem:\n        return error(problem, 400)\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM reset_tokens WHERE token = ?\", (token.strip(),)\n    ).fetchone()\n    if row is None or row[\"used_at\"] is not None:\n        return error(\"invalid or used reset token\", 400)\n\n    db.execute(\n        \"UPDATE accounts SET password_hash = ? WHERE id = ?\",\n        (hash_password(new), row[\"account_id\"]),\n    )\n    db.execute(\n        \"UPDATE reset_tokens SET used_at = ? WHERE token = ?\", (utcnow(), row[\"token\"])\n    )\n    db.execute(\"DELETE FROM auth_tokens WHERE account_id = ?\", (row[\"account_id\"],))\n    db.commit()\n    return jsonify({\"message\": \"password updated\"})\n\n\n# ---------------------------------------------------------------------------\n# Outbox\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/outbox\")\ndef outbox():\n    recipient = request.args.get(\"to\")\n    db = get_db()\n    if recipient is not None and recipient.strip():\n        rows = db.execute(\n            \"SELECT * FROM outbox WHERE lower(recipient) = lower(?)\"\n            \" ORDER BY sent_at DESC, id DESC\",\n            (recipient.strip(),),\n        ).fetchall()\n    else:\n        rows = db.execute(\n            \"SELECT * FROM outbox ORDER BY sent_at DESC, id DESC\"\n        ).fetchall()\n    items = [\n        {\n            \"id\": row[\"id\"],\n            \"to\": row[\"recipient\"],\n            \"subject\": row[\"subject\"],\n            \"body\": row[\"body\"],\n            \"sent_at\": row[\"sent_at\"],\n        }\n        for row in rows\n    ]\n    return jsonify({\"items\": items})\n\n\n# ---------------------------------------------------------------------------\n# Frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794312800612,"end":1794312800649}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c560895d001gFOHiBnk4l3lM3","sessionID":"ses_e3aa4d1dbffeZWAjA1G1VHOklk","messageID":"msg_1c55ff987001fFxFsF7APLifUE"}}
