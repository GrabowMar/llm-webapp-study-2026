{"type":"tool_use","timestamp":1794386058309,"sessionID":"ses_e365a7a00ffe4jKUd0U6YSpHcr","part":{"type":"tool","tool":"read","callID":"call_5bd177c42f3c40e792d103f5","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Store finder: JSON API under /api plus serving the frontend build.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import math\n6: import os\n7: import secrets\n8: import sqlite3\n9: from pathlib import Path\n10: \n11: from flask import Flask\n12: from flask import g\n13: from flask import jsonify\n14: from flask import request\n15: from flask import send_from_directory\n16: from werkzeug.security import check_password_hash\n17: from werkzeug.security import generate_password_hash\n18: \n19: DATA_DIR = Path(\"data\")\n20: DB_PATH = DATA_DIR / \"stores.db\"\n21: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n22: \n23: ADMIN_USERNAME = \"admin\"\n24: ADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n25: \n26: DEFAULT_RADIUS_KM = 50.0\n27: EARTH_RADIUS_KM = 6371.0088\n28: \n29: SAMPLE_STORES = [\n30:     (1, \"Canal Square Store\", \"Damrak 45, 1012 LK Amsterdam\", \"+31 20 555 0101\", 52.3765, 4.8975),\n31:     (2, \"Vondelpark Store\", \"Overtoom 140, 1054 HD Amsterdam\", \"+31 20 555 0102\", 52.3622, 4.8735),\n32:     (3, \"Market Hall Store\", \"Domplein 21, 3512 JE Utrecht\", \"+31 30 555 0201\", 52.0907, 5.1214),\n33:     (4, \"Harbour Front Store\", \"Wilhelminakade 66, 3072 AR Rotterdam\", \"+31 10 555 0301\", 51.9036, 4.4868),\n34:     (5, \"Riverside Store\", \"Blaak 12, 3011 TA Rotterdam\", \"+31 10 555 0302\", 51.9200, 4.4830),\n35:     (6, \"Old Town Store\", \"Grote Markt 8, 2511 BH Den Haag\", \"+31 70 555 0401\", 52.0777, 4.3143),\n36:     (7, \"Alexanderplatz Store\", \"Karl-Liebknecht-Str. 5, 10178 Berlin\", \"+49 30 555 0501\", 52.5219, 13.4132),\n37:     (8, \"Rivoli Store\", \"Rue de Rivoli 72, 75001 Paris\", \"+33 1 55 55 06 01\", 48.8606, 2.3487),\n38: ]\n39: \n40: SCHEMA = \"\"\"\n41: CREATE TABLE IF NOT EXISTS users (\n42:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n43:     username TEXT NOT NULL UNIQUE,\n44:     password_hash TEXT NOT NULL\n45: );\n46: CREATE TABLE IF NOT EXISTS tokens (\n47:     token TEXT PRIMARY KEY,\n48:     username TEXT NOT NULL,\n49:     created_at TEXT NOT NULL DEFAULT (datetime('now'))\n50: );\n51: CREATE TABLE IF NOT EXISTS stores (\n52:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n53:     name TEXT NOT NULL,\n54:     address TEXT NOT NULL,\n55:     phone TEXT,\n56:     latitude REAL NOT NULL,\n57:     longitude REAL NOT NULL\n58: );\n59: \"\"\"\n60: \n61: app = Flask(__name__, static_folder=None)\n62: \n63: \n64: def connect_db() -> sqlite3.Connection:\n65:     conn = sqlite3.connect(DB_PATH)\n66:     conn.row_factory = sqlite3.Row\n67:     return conn\n68: \n69: \n70: def get_db() -> sqlite3.Connection:\n71:     if \"db\" not in g:\n72:         g.db = connect_db()\n73:     return g.db\n74: \n75: \n76: @app.teardown_appcontext\n77: def close_db(_exc=None) -> None:\n78:     db = g.pop(\"db\", None)\n79:     if db is not None:\n80:         db.close()\n81: \n82: \n83: def init_db() -> None:\n84:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n85:     fresh = not DB_PATH.exists()\n86:     db = connect_db()\n87:     try:\n88:         db.executescript(SCHEMA)\n89:         if fresh:\n90:             db.executemany(\n91:                 \"INSERT OR IGNORE INTO stores (id, name, address, phone, latitude, longitude)\"\n92:                 \" VALUES (?, ?, ?, ?, ?, ?)\",\n93:                 SAMPLE_STORES,\n94:             )\n95:         db.commit()\n96:     finally:\n97:         db.close()\n98: \n99: \n100: init_db()\n101: \n102: \n103: def json_error(message: str, status: int, fields: dict | None = None):\n104:     body: dict = {\"error\": message}\n105:     if fields:\n106:         body[\"fields\"] = fields\n107:     return jsonify(body), status\n108: \n109: \n110: def store_dict(row: sqlite3.Row, distance_km: float | None = None) -> dict:\n111:     return {\n112:         \"id\": row[\"id\"],\n113:         \"name\": row[\"name\"],\n114:         \"address\": row[\"address\"],\n115:         \"phone\": row[\"phone\"],\n116:         \"latitude\": row[\"latitude\"],\n117:         \"longitude\": row[\"longitude\"],\n118:         \"distance_km\": distance_km,\n119:     }\n120: \n121: \n122: def haversine_km(lat1: float, lng1: float, lat2: float, lng2: float) -> float:\n123:     phi1 = math.radians(lat1)\n124:     phi2 = math.radians(lat2)\n125:     d_phi = math.radians(lat2 - lat1)\n126:     d_lambda = math.radians(lng2 - lng1)\n127:     a = math.sin(d_phi / 2) ** 2 + math.cos(phi1) * math.cos(phi2) * math.sin(d_lambda / 2) ** 2\n128:     return 2 * EARTH_RADIUS_KM * math.asin(math.sqrt(min(1.0, a)))\n129: \n130: \n131: def bearer_username() -> str | None:\n132:     header = request.headers.get(\"Authorization\", \"\")\n133:     if not header.startswith(\"Bearer \"):\n134:         return None\n135:     token = header[len(\"Bearer \") :].strip()\n136:     if not token:\n137:         return None\n138:     row = get_db().execute(\"SELECT username FROM tokens WHERE token = ?\", (token,)).fetchone()\n139:     return row[\"username\"] if row is not None else None\n140: \n141: \n142: def require_admin():\n143:     username = bearer_username()\n144:     if username is None:\n145:         return None, json_error(\"authentication required\", 401)\n146:     if username != ADMIN_USERNAME:\n147:         return None, json_error(\"admin access required\", 403)\n148:     return username, None\n149: \n150: \n151: def parse_coord(value, name: str, lo: float, hi: float, fields: dict):\n152:     out_of_range = f\"{name} must be a number between {lo:g} and {hi:g}\"\n153:     if value is None:\n154:         fields[name] = f\"{name} is required\"\n155:         return None\n156:     if isinstance(value, bool):\n157:         fields[name] = out_of_range\n158:         return None\n159:     if isinstance(value, str):\n160:         try:\n161:             value = float(value.strip())\n162:         except ValueError:\n163:             fields[name] = out_of_range\n164:             return None\n165:     if not isinstance(value, (int, float)) or not math.isfinite(value):\n166:         fields[name] = out_of_range\n167:         return None\n168:     if not lo <= value <= hi:\n169:         fields[name] = out_of_range\n170:         return None\n171:     return float(value)\n172: \n173: \n174: def validate_store(data: dict):\n175:     fields: dict = {}\n176:     name = data.get(\"name\")\n177:     address = data.get(\"address\")\n178:     if not isinstance(name, str) or not name.strip():\n179:         fields[\"name\"] = \"name is required\"\n180:     if not isinstance(address, str) or not address.strip():\n181:         fields[\"address\"] = \"address is required\"\n182:     phone = data.get(\"phone\")\n183:     if phone is not None:\n184:         if not isinstance(phone, str):\n185:             fields[\"phone\"] = \"phone must be a string\"\n186:         else:\n187:             phone = phone.strip() or None\n188:     lat = parse_coord(data.get(\"latitude\"), \"latitude\", -90, 90, fields)\n189:     lng = parse_coord(data.get(\"longitude\"), \"longitude\", -180, 180, fields)\n190:     if fields:\n191:         return None, json_error(\"; \".join(fields.values()), 400, fields)\n192:     return {\n193:         \"name\": name.strip(),\n194:         \"address\": address.strip(),\n195:         \"phone\": phone,\n196:         \"latitude\": lat,\n197:         \"longitude\": lng,\n198:     }, None\n199: \n200: \n201: def body_dict():\n202:     data = request.get_json(silent=True, force=True)\n203:     if not isinstance(data, dict):\n204:         return None, json_error(\"a JSON body is required\", 400)\n205:     return data, None\n206: \n207: \n208: @app.get(\"/api/health\")\n209: def health():\n210:     return {\"status\": \"ok\"}\n211: \n212: \n213: @app.post(\"/api/auth/register\")\n214: def register():\n215:     data, err = body_dict()\n216:     if err:\n217:         return err\n218:     fields: dict = {}\n219:     username = data.get(\"username\")\n220:     password = data.get(\"password\")\n221:     if not isinstance(username, str) or not username.strip():\n222:         fields[\"username\"] = \"username is required\"\n223:     elif username.strip().lower() == ADMIN_USERNAME:\n224:         fields[\"username\"] = \"username 'admin' is reserved\"\n225:     if not isinstance(password, str) or not password:\n226:         fields[\"password\"] = \"password is required\"\n227:     if fields:\n228:         return json_error(\"; \".join(fields.values()), 400, fields)\n229:     username = username.strip()\n230:     db = get_db()\n231:     taken = db.execute(\n232:         \"SELECT id FROM users WHERE lower(username) = lower(?)\", (username,)\n233:     ).fetchone()\n234:     if taken is not None:\n235:         return json_error(\"username already taken\", 409, {\"username\": \"username already taken\"})\n236:     cur = db.execute(\n237:         \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n238:         (username, generate_password_hash(password)),\n239:     )\n240:     db.commit()\n241:     return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n242: \n243: \n244: @app.post(\"/api/auth/login\")\n245: def login():\n246:     data, err = body_dict()\n247:     if err:\n248:         return err\n249:     username = data.get(\"username\")\n250:     password = data.get(\"password\")\n251:     fields: dict = {}\n252:     if not isinstance(username, str) or not username.strip():\n253:         fields[\"username\"] = \"username is required\"\n254:     if not isinstance(password, str) or not password:\n255:         fields[\"password\"] = \"password is required\"\n256:     if fields:\n257:         return json_error(\"; \".join(fields.values()), 400, fields)\n258:     username = username.strip()\n259:     db = get_db()\n260:     if username.lower() == ADMIN_USERNAME:\n261:         if not ADMIN_PASSWORD:\n262:             return json_error(\"admin sign-in is disabled\", 401)\n263:         if not secrets.compare_digest(password, ADMIN_PASSWORD):\n264:             return json_error(\"invalid username or password\", 401)\n265:         account = ADMIN_USERNAME\n266:     else:\n267:         row = db.execute(\n268:             \"SELECT * FROM users WHERE lower(username) = lower(?)\", (username,)\n269:         ).fetchone()\n270:         if row is None or not check_password_hash(row[\"password_hash\"], password):\n271:             return json_error(\"invalid username or password\", 401)\n272:         account = row[\"username\"]\n273:     token = secrets.token_urlsafe(32)\n274:     db.execute(\"INSERT INTO tokens (token, username) VALUES (?, ?)\", (token, account))\n275:     db.commit()\n276:     return jsonify({\"token\": token})\n277: \n278: \n279: @app.get(\"/api/stores\")\n280: def list_stores():\n281:     q = (request.args.get(\"q\") or \"\").strip().lower()\n282:     use_geo = \"lat\" in request.args or \"lng\" in request.args\n283:     lat = lng = radius = None\n284:     if use_geo:\n285:         fields: dict = {}\n286:         lat = parse_coord(request.args.get(\"lat\"), \"latitude\", -90, 90, fields)\n287:         lng = parse_coord(request.args.get(\"lng\"), \"longitude\", -180, 180, fields)\n288:         raw_radius = request.args.get(\"radius\")\n289:         if raw_radius is None or raw_radius == \"\":\n290:             radius = DEFAULT_RADIUS_KM\n291:         else:\n292:             try:\n293:                 radius = float(raw_radius)\n294:             except ValueError:\n295:                 radius = None\n296:             if radius is None or not math.isfinite(radius) or radius <= 0:\n297:                 fields[\"radius\"] = \"radius must be a positive number\"\n298:         if fields:\n299:             return json_error(\"; \".join(fields.values()), 400, fields)\n300: \n301:     rows = get_db().execute(\"SELECT * FROM stores\").fetchall()\n302:     results: list[tuple[sqlite3.Row, float | None]] = []\n303:     for row in rows:\n304:         if q and q not in f\"{row['name']} {row['address']} {row['phone'] or ''}\".lower():\n305:             continue\n306:         distance = None\n307:         if use_geo:\n308:             distance = round(haversine_km(lat, lng, row[\"latitude\"], row[\"longitude\"]), 2)\n309:             if distance > radius:\n310:                 continue\n311:         results.append((row, distance))\n312:     if use_geo:\n313:         results.sort(key=lambda item: (item[1], item[0][\"name\"].lower()))\n314:     else:\n315:         results.sort(key=lambda item: item[0][\"name\"].lower())\n316:     return jsonify({\"items\": [store_dict(row, distance) for row, distance in results]})\n317: \n318: \n319: @app.get(\"/api/stores/<int:store_id>\")\n320: def get_store(store_id: int):\n321:     row = get_db().execute(\"SELECT * FROM stores WHERE id = ?\", (store_id,)).fetchone()\n322:     if row is None:\n323:         return json_error(\"store not found\", 404)\n324:     return jsonify(store_dict(row))\n325: \n326: \n327: @app.post(\"/api/admin/stores\")\n328: def create_store():\n329:     _, err = require_admin()\n330:     if err:\n331:         return err\n332:     data, err = body_dict()\n333:     if err:\n334:         return err\n335:     payload, err = validate_store(data)\n336:     if err:\n337:         return err\n338:     db = get_db()\n339:     cur = db.execute(\n340:         \"INSERT INTO stores (name, address, phone, latitude, longitude) VALUES (?, ?, ?, ?, ?)\",\n341:         (payload[\"name\"], payload[\"address\"], payload[\"phone\"], payload[\"latitude\"], payload[\"longitude\"]),\n342:     )\n343:     db.commit()\n344:     row = db.execute(\"SELECT * FROM stores WHERE id = ?\", (cur.lastrowid,)).fetchone()\n345:     return jsonify(store_dict(row)), 201\n346: \n347: \n348: @app.put(\"/api/admin/stores/<int:store_id>\")\n349: def update_store(store_id: int):\n350:     _, err = require_admin()\n351:     if err:\n352:         return err\n353:     data, err = body_dict()\n354:     if err:\n355:         return err\n356:     payload, err = validate_store(data)\n357:     if err:\n358:         return err\n359:     db = get_db()\n360:     existing = db.execute(\"SELECT id FROM stores WHERE id = ?\", (store_id,)).fetchone()\n361:     if existing is None:\n362:         return json_error(\"store not found\", 404)\n363:     db.execute(\n364:         \"UPDATE stores SET name = ?, address = ?, phone = ?, latitude = ?, longitude = ? WHERE id = ?\",\n365:         (payload[\"name\"], payload[\"address\"], payload[\"phone\"], payload[\"latitude\"], payload[\"longitude\"], store_id),\n366:     )\n367:     db.commit()\n368:     row = db.execute(\"SELECT * FROM stores WHERE id = ?\", (store_id,)).fetchone()\n369:     return jsonify(store_dict(row))\n370: \n371: \n372: @app.delete(\"/api/admin/stores/<int:store_id>\")\n373: def delete_store(store_id: int):\n374:     _, err = require_admin()\n375:     if err:\n376:         return err\n377:     db = get_db()\n378:     existing = db.execute(\"SELECT id FROM stores WHERE id = ?\", (store_id,)).fetchone()\n379:     if existing is None:\n380:         return json_error(\"store not found\", 404)\n381:     db.execute(\"DELETE FROM stores WHERE id = ?\", (store_id,))\n382:     db.commit()\n383:     return \"\", 204\n384: \n385: \n386: @app.get(\"/\")\n387: @app.get(\"/<path:path>\")\n388: def frontend(path: str = \"index.html\"):\n389:     if path.startswith(\"api/\"):\n390:         return json_error(\"not found\", 404)\n391:     if (DIST / path).is_file():\n392:         return send_from_directory(DIST, path)\n393:     return send_from_directory(DIST, \"index.html\")\n394: \n395: \n396: if __name__ == \"__main__\":\n397:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n\n(End of file - total 397 lines)\n</content>","metadata":{"preview":"\"\"\"Store finder: JSON API under /api plus serving the frontend build.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"stores.db\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Store finder: JSON API under /api plus serving the frontend build.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"stores.db\"\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\nDEFAULT_RADIUS_KM = 50.0\nEARTH_RADIUS_KM = 6371.0088\n\nSAMPLE_STORES = [\n    (1, \"Canal Square Store\", \"Damrak 45, 1012 LK Amsterdam\", \"+31 20 555 0101\", 52.3765, 4.8975),\n    (2, \"Vondelpark Store\", \"Overtoom 140, 1054 HD Amsterdam\", \"+31 20 555 0102\", 52.3622, 4.8735),\n    (3, \"Market Hall Store\", \"Domplein 21, 3512 JE Utrecht\", \"+31 30 555 0201\", 52.0907, 5.1214),\n    (4, \"Harbour Front Store\", \"Wilhelminakade 66, 3072 AR Rotterdam\", \"+31 10 555 0301\", 51.9036, 4.4868),\n    (5, \"Riverside Store\", \"Blaak 12, 3011 TA Rotterdam\", \"+31 10 555 0302\", 51.9200, 4.4830),\n    (6, \"Old Town Store\", \"Grote Markt 8, 2511 BH Den Haag\", \"+31 70 555 0401\", 52.0777, 4.3143),\n    (7, \"Alexanderplatz Store\", \"Karl-Liebknecht-Str. 5, 10178 Berlin\", \"+49 30 555 0501\", 52.5219, 13.4132),\n    (8, \"Rivoli Store\", \"Rue de Rivoli 72, 75001 Paris\", \"+33 1 55 55 06 01\", 48.8606, 2.3487),\n]\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    username TEXT NOT NULL,\n    created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\nCREATE TABLE IF NOT EXISTS stores (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    address TEXT NOT NULL,\n    phone TEXT,\n    latitude REAL NOT NULL,\n    longitude REAL NOT NULL\n);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef connect_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc=None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    fresh = not DB_PATH.exists()\n    db = connect_db()\n    try:\n        db.executescript(SCHEMA)\n        if fresh:\n            db.executemany(\n                \"INSERT OR IGNORE INTO stores (id, name, address, phone, latitude, longitude)\"\n                \" VALUES (?, ?, ?, ?, ?, ?)\",\n                SAMPLE_STORES,\n            )\n        db.commit()\n    finally:\n        db.close()\n\n\ninit_db()\n\n\ndef json_error(message: str, status: int, fields: dict | None = None):\n    body: dict = {\"error\": message}\n    if fields:\n        body[\"fields\"] = fields\n    return jsonify(body), status\n\n\ndef store_dict(row: sqlite3.Row, distance_km: float | None = None) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"address\": row[\"address\"],\n        \"phone\": row[\"phone\"],\n        \"latitude\": row[\"latitude\"],\n        \"longitude\": row[\"longitude\"],\n        \"distance_km\": distance_km,\n    }\n\n\ndef haversine_km(lat1: float, lng1: float, lat2: float, lng2: float) -> float:\n    phi1 = math.radians(lat1)\n    phi2 = math.radians(lat2)\n    d_phi = math.radians(lat2 - lat1)\n    d_lambda = math.radians(lng2 - lng1)\n    a = math.sin(d_phi / 2) ** 2 + math.cos(phi1) * math.cos(phi2) * math.sin(d_lambda / 2) ** 2\n    return 2 * EARTH_RADIUS_KM * math.asin(math.sqrt(min(1.0, a)))\n\n\ndef bearer_username() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    row = get_db().execute(\"SELECT username FROM tokens WHERE token = ?\", (token,)).fetchone()\n    return row[\"username\"] if row is not None else None\n\n\ndef require_admin():\n    username = bearer_username()\n    if username is None:\n        return None, json_error(\"authentication required\", 401)\n    if username != ADMIN_USERNAME:\n        return None, json_error(\"admin access required\", 403)\n    return username, None\n\n\ndef parse_coord(value, name: str, lo: float, hi: float, fields: dict):\n    out_of_range = f\"{name} must be a number between {lo:g} and {hi:g}\"\n    if value is None:\n        fields[name] = f\"{name} is required\"\n        return None\n    if isinstance(value, bool):\n        fields[name] = out_of_range\n        return None\n    if isinstance(value, str):\n        try:\n            value = float(value.strip())\n        except ValueError:\n            fields[name] = out_of_range\n            return None\n    if not isinstance(value, (int, float)) or not math.isfinite(value):\n        fields[name] = out_of_range\n        return None\n    if not lo <= value <= hi:\n        fields[name] = out_of_range\n        return None\n    return float(value)\n\n\ndef validate_store(data: dict):\n    fields: dict = {}\n    name = data.get(\"name\")\n    address = data.get(\"address\")\n    if not isinstance(name, str) or not name.strip():\n        fields[\"name\"] = \"name is required\"\n    if not isinstance(address, str) or not address.strip():\n        fields[\"address\"] = \"address is required\"\n    phone = data.get(\"phone\")\n    if phone is not None:\n        if not isinstance(phone, str):\n            fields[\"phone\"] = \"phone must be a string\"\n        else:\n            phone = phone.strip() or None\n    lat = parse_coord(data.get(\"latitude\"), \"latitude\", -90, 90, fields)\n    lng = parse_coord(data.get(\"longitude\"), \"longitude\", -180, 180, fields)\n    if fields:\n        return None, json_error(\"; \".join(fields.values()), 400, fields)\n    return {\n        \"name\": name.strip(),\n        \"address\": address.strip(),\n        \"phone\": phone,\n        \"latitude\": lat,\n        \"longitude\": lng,\n    }, None\n\n\ndef body_dict():\n    data = request.get_json(silent=True, force=True)\n    if not isinstance(data, dict):\n        return None, json_error(\"a JSON body is required\", 400)\n    return data, None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data, err = body_dict()\n    if err:\n        return err\n    fields: dict = {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        fields[\"username\"] = \"username is required\"\n    elif username.strip().lower() == ADMIN_USERNAME:\n        fields[\"username\"] = \"username 'admin' is reserved\"\n    if not isinstance(password, str) or not password:\n        fields[\"password\"] = \"password is required\"\n    if fields:\n        return json_error(\"; \".join(fields.values()), 400, fields)\n    username = username.strip()\n    db = get_db()\n    taken = db.execute(\n        \"SELECT id FROM users WHERE lower(username) = lower(?)\", (username,)\n    ).fetchone()\n    if taken is not None:\n        return json_error(\"username already taken\", 409, {\"username\": \"username already taken\"})\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data, err = body_dict()\n    if err:\n        return err\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    fields: dict = {}\n    if not isinstance(username, str) or not username.strip():\n        fields[\"username\"] = \"username is required\"\n    if not isinstance(password, str) or not password:\n        fields[\"password\"] = \"password is required\"\n    if fields:\n        return json_error(\"; \".join(fields.values()), 400, fields)\n    username = username.strip()\n    db = get_db()\n    if username.lower() == ADMIN_USERNAME:\n        if not ADMIN_PASSWORD:\n            return json_error(\"admin sign-in is disabled\", 401)\n        if not secrets.compare_digest(password, ADMIN_PASSWORD):\n            return json_error(\"invalid username or password\", 401)\n        account = ADMIN_USERNAME\n    else:\n        row = db.execute(\n            \"SELECT * FROM users WHERE lower(username) = lower(?)\", (username,)\n        ).fetchone()\n        if row is None or not check_password_hash(row[\"password_hash\"], password):\n            return json_error(\"invalid username or password\", 401)\n        account = row[\"username\"]\n    token = secrets.token_urlsafe(32)\n    db.execute(\"INSERT INTO tokens (token, username) VALUES (?, ?)\", (token, account))\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/stores\")\ndef list_stores():\n    q = (request.args.get(\"q\") or \"\").strip().lower()\n    use_geo = \"lat\" in request.args or \"lng\" in request.args\n    lat = lng = radius = None\n    if use_geo:\n        fields: dict = {}\n        lat = parse_coord(request.args.get(\"lat\"), \"latitude\", -90, 90, fields)\n        lng = parse_coord(request.args.get(\"lng\"), \"longitude\", -180, 180, fields)\n        raw_radius = request.args.get(\"radius\")\n        if raw_radius is None or raw_radius == \"\":\n            radius = DEFAULT_RADIUS_KM\n        else:\n            try:\n                radius = float(raw_radius)\n            except ValueError:\n                radius = None\n            if radius is None or not math.isfinite(radius) or radius <= 0:\n                fields[\"radius\"] = \"radius must be a positive number\"\n        if fields:\n            return json_error(\"; \".join(fields.values()), 400, fields)\n\n    rows = get_db().execute(\"SELECT * FROM stores\").fetchall()\n    results: list[tuple[sqlite3.Row, float | None]] = []\n    for row in rows:\n        if q and q not in f\"{row['name']} {row['address']} {row['phone'] or ''}\".lower():\n            continue\n        distance = None\n        if use_geo:\n            distance = round(haversine_km(lat, lng, row[\"latitude\"], row[\"longitude\"]), 2)\n            if distance > radius:\n                continue\n        results.append((row, distance))\n    if use_geo:\n        results.sort(key=lambda item: (item[1], item[0][\"name\"].lower()))\n    else:\n        results.sort(key=lambda item: item[0][\"name\"].lower())\n    return jsonify({\"items\": [store_dict(row, distance) for row, distance in results]})\n\n\n@app.get(\"/api/stores/<int:store_id>\")\ndef get_store(store_id: int):\n    row = get_db().execute(\"SELECT * FROM stores WHERE id = ?\", (store_id,)).fetchone()\n    if row is None:\n        return json_error(\"store not found\", 404)\n    return jsonify(store_dict(row))\n\n\n@app.post(\"/api/admin/stores\")\ndef create_store():\n    _, err = require_admin()\n    if err:\n        return err\n    data, err = body_dict()\n    if err:\n        return err\n    payload, err = validate_store(data)\n    if err:\n        return err\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO stores (name, address, phone, latitude, longitude) VALUES (?, ?, ?, ?, ?)\",\n        (payload[\"name\"], payload[\"address\"], payload[\"phone\"], payload[\"latitude\"], payload[\"longitude\"]),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM stores WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(store_dict(row)), 201\n\n\n@app.put(\"/api/admin/stores/<int:store_id>\")\ndef update_store(store_id: int):\n    _, err = require_admin()\n    if err:\n        return err\n    data, err = body_dict()\n    if err:\n        return err\n    payload, err = validate_store(data)\n    if err:\n        return err\n    db = get_db()\n    existing = db.execute(\"SELECT id FROM stores WHERE id = ?\", (store_id,)).fetchone()\n    if existing is None:\n        return json_error(\"store not found\", 404)\n    db.execute(\n        \"UPDATE stores SET name = ?, address = ?, phone = ?, latitude = ?, longitude = ? WHERE id = ?\",\n        (payload[\"name\"], payload[\"address\"], payload[\"phone\"], payload[\"latitude\"], payload[\"longitude\"], store_id),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM stores WHERE id = ?\", (store_id,)).fetchone()\n    return jsonify(store_dict(row))\n\n\n@app.delete(\"/api/admin/stores/<int:store_id>\")\ndef delete_store(store_id: int):\n    _, err = require_admin()\n    if err:\n        return err\n    db = get_db()\n    existing = db.execute(\"SELECT id FROM stores WHERE id = ?\", (store_id,)).fetchone()\n    if existing is None:\n        return json_error(\"store not found\", 404)\n    db.execute(\"DELETE FROM stores WHERE id = ?\", (store_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return json_error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))","lineStart":1,"lineEnd":397,"totalLines":397,"truncated":false}},"title":"backend/app.py","time":{"start":1794386058260,"end":1794386058282}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9be5c0d001hxhdTUnFSP5oVN","sessionID":"ses_e365a7a00ffe4jKUd0U6YSpHcr","messageID":"msg_1c9be4ca0001HTLoqy6HG23VJT"}}
