tion, ValueError):\n         raise ValueError(\"amount must be a number\") from None\n+    if not amount.is_finite() or amount <= 0:\n+        raise ValueError(\"amount must be a positive number\")\n+    if amount > Decimal(\"100000000000\"):\n+        raise ValueError(\"amount is too large\")\n     try:\n-        if not amount.is_finite() or amount <= 0:\n-            raise ValueError(\"amount must be a positive number\")\n         if amount != amount.quantize(Decimal(\"0.01\")):\n             raise ValueError(\"amount must have at most two decimal places\")\n-        if amount > Decimal(\"100000000000\"):\n-            raise ValueError(\"amount is too large\")\n         cents = int(amount * 100)\n-    except (InvalidOperation, ValueError):\n-        raise ValueError(\"amount must be a positive number\") from None\n+    except (InvalidOperation, OverflowError):\n+        raise ValueError(\"amount is too large\") from None\n     return cents\n \n \n def money(cents: int) -> float:\n","filediff":{"file":"/workspace/backend/app.py","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -96,18 +96,18 @@\n     try:\n         amount = Decimal(str(value).strip())\n     except (InvalidOperation, ValueError):\n         raise ValueError(\"amount must be a number\") from None\n+    if not amount.is_finite() or amount <= 0:\n+        raise ValueError(\"amount must be a positive number\")\n+    if amount > Decimal(\"100000000000\"):\n+        raise ValueError(\"amount is too large\")\n     try:\n-        if not amount.is_finite() or amount <= 0:\n-            raise ValueError(\"amount must be a positive number\")\n         if amount != amount.quantize(Decimal(\"0.01\")):\n             raise ValueError(\"amount must have at most two decimal places\")\n-        if amount > Decimal(\"100000000000\"):\n-            raise ValueError(\"amount is too large\")\n    