{"type":"tool_use","timestamp":1794346884346,"sessionID":"ses_e389ffff4ffeQO8d0rGkbz4lhh","part":{"type":"tool","tool":"write","callID":"call_6300f74b4e0d49989c2e5a9b","state":{"status":"completed","input":{"content":"import json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://localhost:8000\"\nPASSED = 0\nFAILED = 0\n\n\ndef call(method, path, body=None, token=None, csrf=None, raw_body=None):\n    headers = {\"Accept\": \"application/json\"}\n    data = raw_body\n    if body is not None:\n        data = json.dumps(body).encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    if csrf:\n        headers[\"X-CSRF-Token\"] = csrf\n    req = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req) as res:\n            status, payload = res.status, res.read().decode()\n    except urllib.error.HTTPError as err:\n        status, payload = err.code, err.read().decode()\n    try:\n        parsed = json.loads(payload) if payload else None\n    except json.JSONDecodeError:\n        parsed = payload\n    return status, parsed\n\n\ndef check(name, condition, detail=\"\"):\n    global PASSED, FAILED\n    if condition:\n        PASSED += 1\n        print(f\"PASS  {name}\")\n    else:\n        FAILED += 1\n        print(f\"FAIL  {name}  {detail}\")\n\n\n# health + frontend\ns, p = call(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and p == {\"status\": \"ok\"}, (s, p))\ns, p = call(\"GET\", \"/\")\ncheck(\"frontend index served\", s == 200 and \"<div id=\\\"root\\\">\" in p, s)\ns, p = call(\"GET\", \"/some/spa/route\")\ncheck(\"SPA fallback\", s == 200 and \"<div id=\\\"root\\\">\" in p, s)\ns, p = call(\"GET\", \"/api/nope\")\ncheck(\"unknown api path -> 404\", s == 404, (s, p))\n\n# register\ns, p = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"register alice 201\", s == 201, (s, p))\ncheck(\"register returns balance 1000\", isinstance(p, dict) and p.get(\"balance\") == 1000, p)\ns, p = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"secret2\"})\ncheck(\"register bob 201\", s == 201, (s, p))\ns, p = call(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"secret3\"})\ncheck(\"register carol 201\", s == 201, (s, p))\ns, p = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"})\ncheck(\"duplicate username 409\", s == 409, (s, p))\ns, p = call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"empty username 400\", s == 400, (s, p))\ns, p = call(\"POST\", \"/api/auth/register\", {\"username\": \"dave\"})\ncheck(\"missing password 400\", s == 400, (s, p))\ns, p = call(\"POST\", \"/api/auth/register\", raw_body=b\"not json\")\ncheck(\"bad json 400\", s == 400, (s, p))\n\n# login\ns, p = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"wrong password 401\", s == 401, (s, p))\ns, p = call(\"POST\", \"/api/auth/login\", {\"username\": \"ghost\", \"password\": \"x\"})\ncheck(\"unknown user 401\", s == 401, (s, p))\ns, p = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"login ok 200 + token\", s == 200 and isinstance(p, dict) and p.get(\"token\"), (s, p))\nalice = p[\"token\"]\ns, p = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"secret2\"})\nbob = p[\"token\"]\ns, p = call(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"secret3\"})\ncarol = p[\"token\"]\n\n# auth guard\ns, p = call(\"GET\", \"/api/account\")\ncheck(\"account without token 401\", s == 401, (s, p))\ns, p = call(\"GET\", \"/api/account\", token=\"bogus\")\ncheck(\"account bad token 401\", s == 401, (s, p))\ns, p = call(\"GET\", \"/api/account\", token=alice)\ncheck(\"account 200\", s == 200 and p == {\"username\": \"alice\", \"balance\": 1000}, (s, p))\n\n# csrf\ns, p = call(\"GET\", \"/api/auth/csrf\")\ncheck(\"csrf without token 401\", s == 401, (s, p))\ns, p = call(\"GET\", \"/api/auth/csrf\", token=alice)\ncheck(\"csrf token\", s == 200 and isinstance(p, dict) and len(p.get(\"csrf_token\", \"\")) > 10, (s, p))\nalice_csrf = p[\"csrf_token\"]\n\n# transfers\ns, p = call(\"GET\", \"/api/transfers\", token=alice)\ncheck(\"list without token 401\", s == 401, (s, p))\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 250.5, \"memo\": \"lunch\"}, token=alice)\ncheck(\"transfer ok 201\", s == 201, (s, p))\ncheck(\n    \"transfer shape\",\n    s == 201\n    and p.get(\"from_username\") == \"alice\"\n    and p.get(\"to_username\") == \"bob\"\n    and p.get(\"amount\") == 250.5\n    and p.get(\"memo\") == \"lunch\"\n    and p.get(\"direction\") == \"out\"\n    and isinstance(p.get(\"id\"), int)\n    and isinstance(p.get(\"created_at\"), str),\n    p,\n)\nt1 = p[\"id\"]\ns, p = call(\"GET\", \"/api/account\", token=alice)\ncheck(\"alice balance after transfer\", s == 200 and p[\"balance\"] == 749.5, (s, p))\ns, p = call(\"GET\", \"/api/account\", token=bob)\ncheck(\"bob balance after transfer\", s == 200 and p[\"balance\"] == 1250.5, (s, p))\n\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 99999}, token=alice)\ncheck(\"insufficient balance 400\", s == 400, (s, p))\ncheck(\"insufficient message\", \"insufficient\" in json.dumps(p).lower(), p)\ns, p = call(\"GET\", \"/api/account\", token=alice)\ncheck(\"balance unchanged after failure\", p[\"balance\"] == 749.5, p)\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"nobody\", \"amount\": 1}, token=alice)\ncheck(\"unknown recipient 404\", s == 404, (s, p))\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"alice\", \"amount\": 1}, token=alice)\ncheck(\"self transfer 400\", s == 400, (s, p))\nfor bad in [0, -5, \"abc\", 0.001, None]:\n    s, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": bad}, token=alice)\n    check(f\"bad amount {bad!r} 400\", s == 400, (s, p))\ns, p = call(\"POST\", \"/api/transfers\", {\"amount\": 5}, token=alice)\ncheck(\"missing recipient 400\", s == 400, (s, p))\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 1}, token=\"bad\")\ncheck(\"transfer without auth 401\", s == 401, (s, p))\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 1}, token=alice, csrf=\"wrong\")\ncheck(\"bad csrf header 403\", s == 403, (s, p))\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 1}, token=alice, csrf=alice_csrf)\ncheck(\"good csrf header 201\", s == 201, (s, p))\nt2 = p[\"id\"]\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"carol\", \"amount\": \"20.00\", \"memo\": \"gift\"}, token=alice)\ncheck(\"string amount 201\", s == 201, (s, p))\nt3 = p[\"id\"]\n\n# visibility\ns, p = call(\"GET\", f\"/api/transfers/{t1}\", token=alice)\ncheck(\"get own transfer\", s == 200 and p[\"direction\"] == \"out\", (s, p))\ns, p = call(\"GET\", f\"/api/transfers/{t1}\", token=bob)\ncheck(\"get received transfer\", s == 200 and p[\"direction\"] == \"in\", (s, p))\ns, p = call(\"GET\", f\"/api/transfers/{t1}\", token=carol)\ncheck(\"other user cannot see 404\", s == 404, (s, p))\ns, p = call(\"GET\", \"/api/transfers/999999\", token=alice)\ncheck(\"missing transfer 404\", s == 404, (s, p))\n\n# bob sends money back -> more history for alice\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"alice\", \"amount\": 10, \"memo\": \"payback\"}, token=bob)\nt4 = p[\"id\"]\ns, p = call(\"POST\", \"/api/transfers\", {\"to_username\": \"alice\", \"amount\": 20}, token=bob)\nt5 = p[\"id\"]\n\n# listing + paging (alice: t5, t4, t3, t2, t1 newest first)\ns, p = call(\"GET\", \"/api/transfers\", token=alice)\ncheck(\"list shape\", s == 200 and set(p.keys()) == {\"items\", \"total\", \"page\", \"page_size\"}, p)\ncheck(\"alice total 5\", p[\"total\"] == 5, p)\ncheck(\"newest first\", [i[\"id\"] for i in p[\"items\"]] == [t5, t4, t3, t2, t1], p)\ncheck(\"directions\", [i[\"direction\"] for i in p[\"items\"]] == [\"in\", \"in\", \"out\", \"out\", \"out\"], p)\ns, p = call(\"GET\", \"/api/transfers?page=1&page_size=2\", token=alice)\ncheck(\"page 1 size 2\", s == 200 and [i[\"id\"] for i in p[\"items\"]] == [t5, t4] and p[\"total\"] == 5 and p[\"page\"] == 1 and p[\"page_size\"] == 2, p)\ns, p = call(\"GET\", \"/api/transfers?page=2&page_size=2\", token=alice)\ncheck(\"page 2 size 2\", [i[\"id\"] for i in p[\"items\"]] == [t3, t2] and p[\"page\"] == 2, p)\ns, p = call(\"GET\", \"/api/transfers?page=3&page_size=2\", token=alice)\ncheck(\"page 3 size 2\", [i[\"id\"] for i in p[\"items\"]] == [t1] and p[\"page\"] == 3, p)\ns, p = call(\"GET\", \"/api/transfers?page=9&page_size=2\", token=alice)\ncheck(\"out of range page empty\", p[\"items\"] == [] and p[\"total\"] == 5, p)\ns, p = call(\"GET\", \"/api/transfers?page=abc\", token=alice)\ncheck(\"bad page 400\", s == 400, (s, p))\ns, p = call(\"GET\", \"/api/transfers?page_size=0\", token=alice)\ncheck(\"bad page_size 400\", s == 400, (s, p))\ns, p = call(\"GET\", \"/api/transfers\", token=carol)\ncheck(\"carol sees only hers\", p[\"total\"] == 1 and p[\"items\"][0][\"id\"] == t3 and p[\"items\"][0][\"direction\"] == \"in\", p)\n\n# memo preserved / null\ns, p = call(\"GET\", f\"/api/transfers/{t5}\", token=alice)\ncheck(\"memo null when omitted\", p[\"memo\"] is None, p)\n\n# logout\ns, p = call(\"POST\", \"/api/auth/logout\")\ncheck(\"logout without token 401\", s == 401, (s, p))\ns, p = call(\"POST\", \"/api/auth/logout\", token=alice)\ncheck(\"logout 200\", s == 200, (s, p))\ns, p = call(\"GET\", \"/api/account\", token=alice)\ncheck(\"old token invalid after logout\", s == 401, (s, p))\n\nprint(f\"\\n{PASSED} passed, {FAILED} failed\")\nraise SystemExit(1 if FAILED else 0)\n","filePath":"/workspace/.api_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.api_test.py","exists":false,"truncated":false},"title":".api_test.py","time":{"start":1794346884322,"end":1794346884330}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7689cdd001T4jw4GXgyfd3gP","sessionID":"ses_e389ffff4ffeQO8d0rGkbz4lhh","messageID":"msg_1c7681312001DJ82xUKISakW7x"}}
