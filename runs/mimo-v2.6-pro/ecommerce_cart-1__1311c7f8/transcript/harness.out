{"type":"tool_use","timestamp":1794380837113,"sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","part":{"type":"tool","tool":"read","callID":"call_1b843ca81e1e428296ae84f8","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: shop JSON API plus frontend hosting.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import secrets\n7: import sqlite3\n8: from functools import wraps\n9: from pathlib import Path\n10: \n11: from flask import Flask\n12: from flask import g\n13: from flask import jsonify\n14: from flask import request\n15: from flask import send_from_directory\n16: from werkzeug.security import check_password_hash\n17: from werkzeug.security import generate_password_hash\n18: \n19: DATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\n20: DB_PATH = DATA_DIR / \"shop.db\"\n21: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n22: \n23: ADMIN_USERNAME = \"admin\"\n24: ADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n25: \n26: SEED_PRODUCTS = [\n27:     (\"Aurora Desk Lamp\", \"LED desk lamp with a dimmable, adjustable arm.\", 34.99, 25),\n28:     (\"Bamboo Cutting Board\", \"Large end-grain bamboo board with juice groove.\", 24.50, 40),\n29:     (\"Ceramic Pour-Over Set\", \"Hand-glazed dripper, carafe and two cups.\", 48.00, 15),\n30:     (\"Cotton Throw Blanket\", \"Soft woven throw, machine washable, 130x170 cm.\", 39.99, 30),\n31:     (\"Espresso Hand Grinder\", \"Conical burr grinder with 30 click settings.\", 79.00, 12),\n32:     (\"Linen Apron\", \"Stonewashed linen apron with cross-back straps.\", 28.75, 22),\n33:     (\"Maple Serving Bowl\", \"Turned maple bowl, finished with food-safe oil.\", 44.00, 18),\n34:     (\"Stoneware Mug\", \"Stackable 350 ml stoneware mug, dishwasher safe.\", 16.99, 50),\n35:     (\"Walnut Picture Frame\", \"Solid walnut frame for 13x18 cm photos.\", 22.00, 35),\n36:     (\"Wool Felt Coasters\", \"Set of six merino felt coasters in mixed colours.\", 12.99, 10),\n37: ]\n38: \n39: SCHEMA = \"\"\"\n40: CREATE TABLE IF NOT EXISTS users (\n41:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n42:     username TEXT NOT NULL UNIQUE,\n43:     password_hash TEXT NOT NULL,\n44:     created_at TEXT NOT NULL DEFAULT (datetime('now'))\n45: );\n46: CREATE TABLE IF NOT EXISTS tokens (\n47:     token TEXT PRIMARY KEY,\n48:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n49:     created_at TEXT NOT NULL DEFAULT (datetime('now'))\n50: );\n51: CREATE TABLE IF NOT EXISTS products (\n52:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n53:     name TEXT NOT NULL,\n54:     description TEXT NOT NULL DEFAULT '',\n55:     price REAL NOT NULL,\n56:     stock INTEGER NOT NULL DEFAULT 0,\n57:     is_active INTEGER NOT NULL DEFAULT 1\n58: );\n59: CREATE TABLE IF NOT EXISTS cart_items (\n60:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n61:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n62:     product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n63:     quantity INTEGER NOT NULL,\n64:     UNIQUE (user_id, product_id)\n65: );\n66: \"\"\"\n67: \n68: app = Flask(__name__, static_folder=None)\n69: \n70: \n71: # --------------------------------------------------------------------------\n72: # Database helpers\n73: # --------------------------------------------------------------------------\n74: \n75: def get_db() -> sqlite3.Connection:\n76:     if \"db\" not in g:\n77:         g.db = sqlite3.connect(DB_PATH)\n78:         g.db.row_factory = sqlite3.Row\n79:         g.db.execute(\"PRAGMA foreign_keys = ON\")\n80:     return g.db\n81: \n82: \n83: @app.teardown_appcontext\n84: def close_db(exc=None):\n85:     db = g.pop(\"db\", None)\n86:     if db is not None:\n87:         db.close()\n88: \n89: \n90: def init_db() -> None:\n91:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n92:     conn = sqlite3.connect(DB_PATH)\n93:     conn.row_factory = sqlite3.Row\n94:     try:\n95:         conn.execute(\"PRAGMA journal_mode = WAL\")\n96:         conn.executescript(SCHEMA)\n97:         if conn.execute(\"SELECT COUNT(*) AS n FROM products\").fetchone()[\"n\"] == 0:\n98:             conn.executemany(\n99:                 \"INSERT INTO products (name, description, price, stock, is_active)\"\n100:                 \" VALUES (?, ?, ?, ?, 1)\",\n101:                 SEED_PRODUCTS,\n102:             )\n103:         if ADMIN_PASSWORD:\n104:             pw_hash = generate_password_hash(ADMIN_PASSWORD)\n105:             row = conn.execute(\n106:                 \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n107:             ).fetchone()\n108:             if row:\n109:                 conn.execute(\n110:                     \"UPDATE users SET password_hash = ? WHERE id = ?\",\n111:                     (pw_hash, row[\"id\"]),\n112:                 )\n113:             else:\n114:                 conn.execute(\n115:                     \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n116:                     (ADMIN_USERNAME, pw_hash),\n117:                 )\n118:         else:\n119:             conn.execute(\n120:                 \"UPDATE users SET password_hash = '' WHERE username = ?\",\n121:                 (ADMIN_USERNAME,),\n122:             )\n123:         conn.commit()\n124:     finally:\n125:         conn.close()\n126: \n127: \n128: # --------------------------------------------------------------------------\n129: # Serialisation\n130: # --------------------------------------------------------------------------\n131: \n132: def product_dict(row: sqlite3.Row) -> dict:\n133:     return {\n134:         \"id\": row[\"id\"],\n135:         \"name\": row[\"name\"],\n136:         \"description\": row[\"description\"],\n137:         \"price\": float(row[\"price\"]),\n138:         \"stock\": row[\"stock\"],\n139:         \"is_active\": bool(row[\"is_active\"]),\n140:     }\n141: \n142: \n143: def cart_item_dict(row: sqlite3.Row) -> dict:\n144:     unit_price = float(row[\"price\"])\n145:     quantity = row[\"quantity\"]\n146:     return {\n147:         \"id\": row[\"id\"],\n148:         \"product_id\": row[\"product_id\"],\n149:         \"quantity\": quantity,\n150:         \"name\": row[\"name\"],\n151:         \"unit_price\": unit_price,\n152:         \"line_total\": unit_price * quantity,\n153:     }\n154: \n155: \n156: def error(message: str, status: int):\n157:     return jsonify({\"error\": message, \"message\": message}), status\n158: \n159: \n160: # --------------------------------------------------------------------------\n161: # Request parsing\n162: # --------------------------------------------------------------------------\n163: \n164: def json_body():\n165:     return request.get_json(silent=True)\n166: \n167: \n168: def as_number(value):\n169:     if isinstance(value, bool):\n170:         return None\n171:     if isinstance(value, (int, float)):\n172:         return value\n173:     if isinstance(value, str):\n174:         try:\n175:             return float(value.strip())\n176:         except ValueError:\n177:             return None\n178:     return None\n179: \n180: \n181: def as_int(value):\n182:     number = as_number(value)\n183:     if number is None:\n184:         return None\n185:     if isinstance(number, float) and not number.is_integer():\n186:         return None\n187:     return int(number)\n188: \n189: \n190: def as_bool(value):\n191:     if isinstance(value, bool):\n192:         return value\n193:     if isinstance(value, int) and value in (0, 1):\n194:         return bool(value)\n195:     return None\n196: \n197: \n198: def as_price(value):\n199:     number = as_number(value)\n200:     if number is None or number < 0:\n201:         return None\n202:     return float(number)\n203: \n204: \n205: def as_stock(value):\n206:     number = as_int(value)\n207:     if number is None or number < 0:\n208:         return None\n209:     return number\n210: \n211: \n212: # --------------------------------------------------------------------------\n213: # Authentication\n214: # --------------------------------------------------------------------------\n215: \n216: def current_user():\n217:     header = request.headers.get(\"Authorization\", \"\")\n218:     scheme, _, token = header.partition(\" \")\n219:     if scheme.lower() != \"bearer\":\n220:         return None\n221:     token = token.strip()\n222:     if not token:\n223:         return None\n224:     return (\n225:         get_db()\n226:         .execute(\n227:             \"SELECT u.* FROM tokens t JOIN users u ON u.id = t.user_id\"\n228:             \" WHERE t.token = ?\",\n229:             (token,),\n230:         )\n231:         .fetchone()\n232:     )\n233: \n234: \n235: def login_required(view):\n236:     @wraps(view)\n237:     def wrapped(*args, **kwargs):\n238:         user = current_user()\n239:         if user is None:\n240:             return error(\"authentication required\", 401)\n241:         g.user = user\n242:         return view(*args, **kwargs)\n243: \n244:     return wrapped\n245: \n246: \n247: def admin_required(view):\n248:     @wraps(view)\n249:     def wrapped(*args, **kwargs):\n250:         user = current_user()\n251:         if user is None:\n252:             return error(\"authentication required\", 401)\n253:         if user[\"username\"] != ADMIN_USERNAME:\n254:             return error(\"admin access required\", 403)\n255:         g.user = user\n256:         return view(*args, **kwargs)\n257: \n258:     return wrapped\n259: \n260: \n261: # --------------------------------------------------------------------------\n262: # Auth routes\n263: # --------------------------------------------------------------------------\n264: \n265: @app.post(\"/api/auth/register\")\n266: def register():\n267:     body = json_body()\n268:     if not isinstance(body, dict):\n269:         return error(\"a JSON body is required\", 400)\n270:     username = body.get(\"username\")\n271:     password = body.get(\"password\")\n272:     if not isinstance(username, str) or not username.strip():\n273:         return error(\"username is required\", 400)\n274:     if not isinstance(password, str) or not password:\n275:         return error(\"password is required\", 400)\n276:     username = username.strip()\n277:     if username.lower() == ADMIN_USERNAME:\n278:         return error(\"username is reserved\", 400)\n279:     db = get_db()\n280:     if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n281:         return error(\"username already taken\", 409)\n282:     cur = db.execute(\n283:         \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n284:         (username, generate_password_hash(password)),\n285:     )\n286:     user_id = cur.lastrowid\n287:     token = secrets.token_urlsafe(32)\n288:     db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id))\n289:     db.commit()\n290:     return jsonify({\"id\": user_id, \"username\": username, \"token\": token}), 201\n291: \n292: \n293: @app.post(\"/api/auth/login\")\n294: def login():\n295:     body = json_body()\n296:     if not isinstance(body, dict):\n297:         return error(\"a JSON body is required\", 400)\n298:     username = body.get(\"username\")\n299:     password = body.get(\"password\")\n300:     if not isinstance(username, str) or not isinstance(password, str):\n301:         return error(\"username and password are required\", 400)\n302:     user = get_db().execute(\n303:         \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n304:     ).fetchone()\n305:     if user is None or not user[\"password_hash\"]:\n306:         return error(\"invalid credentials\", 401)\n307:     if not check_password_hash(user[\"password_hash\"], password):\n308:         return error(\"invalid credentials\", 401)\n309:     token = secrets.token_urlsafe(32)\n310:     db = get_db()\n311:     db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n312:     db.commit()\n313:     return jsonify({\"token\": token}), 200\n314: \n315: \n316: # --------------------------------------------------------------------------\n317: # Catalogue routes\n318: # --------------------------------------------------------------------------\n319: \n320: def list_products(include_inactive: bool):\n321:     db = get_db()\n322:     where = []\n323:     params = []\n324:     if not include_inactive:\n325:         where.append(\"is_active = 1\")\n326:     q = request.args.get(\"q\")\n327:     if q:\n328:         pattern = (\n329:             \"%\" + q.lower().replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n330:         )\n331:         where.append(\"LOWER(name) LIKE ? ESCAPE '\\\\'\")\n332:         params.append(pattern)\n333:     where_sql = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n334: \n335:     try:\n336:         page = int(request.args.get(\"page\", 1))\n337:         page_size = int(request.args.get(\"page_size\", 20))\n338:     except ValueError:\n339:         return None, error(\"page and page_size must be integers\", 400)\n340:     if page < 1:\n341:         return None, error(\"page must be at least 1\", 400)\n342:     if page_size < 1:\n343:         return None, error(\"page_size must be at least 1\", 400)\n344: \n345:     total = db.execute(\n346:         \"SELECT COUNT(*) AS n FROM products\" + where_sql, params\n347:     ).fetchone()[\"n\"]\n348:     rows = db.execute(\n349:         \"SELECT * FROM products\"\n350:         + where_sql\n351:         + \" ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n352:         params + [page_size, (page - 1) * page_size],\n353:     ).fetchall()\n354:     payload = {\n355:         \"items\": [product_dict(row) for row in rows],\n356:         \"total\": total,\n357:         \"page\": page,\n358:         \"page_size\": page_size,\n359:     }\n360:     return payload, None\n361: \n362: \n363: @app.get(\"/api/products\")\n364: def products_index():\n365:     payload, err = list_products(include_inactive=False)\n366:     return err if err else jsonify(payload)\n367: \n368: \n369: @app.get(\"/api/products/<int:product_id>\")\n370: def products_show(product_id: int):\n371:     row = get_db().execute(\n372:         \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n373:     ).fetchone()\n374:     if row is None:\n375:         return error(\"product not found\", 404)\n376:     return jsonify(product_dict(row))\n377: \n378: \n379: # --------------------------------------------------------------------------\n380: # Cart routes\n381: # --------------------------------------------------------------------------\n382: \n383: @app.get(\"/api/cart\")\n384: @login_required\n385: def cart_index():\n386:     rows = get_db().execute(\n387:         \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n388:         \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n389:         \" WHERE ci.user_id = ? AND p.is_active = 1 ORDER BY ci.id\",\n390:         (g.user[\"id\"],),\n391:     ).fetchall()\n392:     items = [cart_item_dict(row) for row in rows]\n393:     subtotal = sum(item[\"line_total\"] for item in items)\n394:     return jsonify({\"items\": items, \"subtotal\": subtotal})\n395: \n396: \n397: @app.post(\"/api/cart\")\n398: @login_required\n399: def cart_add():\n400:     body = json_body()\n401:     if not isinstance(body, dict):\n402:         return error(\"a JSON body is required\", 400)\n403:     raw_id = body.get(\"product_id\", body.get(\"id\"))\n404:     product_id = as_int(raw_id)\n405:     if product_id is None:\n406:         return error(\"product_id is required\", 400)\n407:     if \"quantity\" in body:\n408:         quantity = as_int(body.get(\"quantity\"))\n409:         if quantity is None or quantity < 1:\n410:             return error(\"quantity must be a positive integer\", 400)\n411:     else:\n412:         quantity = 1\n413:     db = get_db()\n414:     product = db.execute(\n415:         \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n416:     ).fetchone()\n417:     if product is None:\n418:         return error(\"product not found\", 404)\n419:     existing = db.execute(\n420:         \"SELECT id, quantity FROM cart_items WHERE user_id = ? AND product_id = ?\",\n421:         (g.user[\"id\"], product_id),\n422:     ).fetchone()\n423:     if existing:\n424:         new_quantity = existing[\"quantity\"] + quantity\n425:         db.execute(\n426:             \"UPDATE cart_items SET quantity = ? WHERE id = ?\",\n427:             (new_quantity, existing[\"id\"]),\n428:         )\n429:         item_id = existing[\"id\"]\n430:     else:\n431:         cur = db.execute(\n432:             \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n433:             (g.user[\"id\"], product_id, quantity),\n434:         )\n435:         item_id = cur.lastrowid\n436:     db.commit()\n437:     row = db.execute(\n438:         \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n439:         \" FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.id = ?\",\n440:         (item_id,),\n441:     ).fetchone()\n442:     return jsonify(cart_item_dict(row)), 201\n443: \n444: \n445: @app.patch(\"/api/cart/<int:item_id>\")\n446: @login_required\n447: def cart_update(item_id: int):\n448:     body = json_body()\n449:     if not isinstance(body, dict):\n450:         return error(\"a JSON body is required\", 400)\n451:     quantity = as_int(body.get(\"quantity\"))\n452:     if quantity is None or quantity < 1:\n453:         return error(\"quantity must be a positive integer\", 400)\n454:     db = get_db()\n455:     row = db.execute(\n456:         \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n457:         \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n458:         \" WHERE ci.id = ? AND ci.user_id = ?\",\n459:         (item_id, g.user[\"id\"]),\n460:     ).fetchone()\n461:     if row is None:\n462:         return error(\"cart item not found\", 404)\n463:     db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n464:     db.commit()\n465:     row = db.execute(\n466:         \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n467:         \" FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.id = ?\",\n468:         (item_id,),\n469:     ).fetchone()\n470:     return jsonify(cart_item_dict(row))\n471: \n472: \n473: @app.delete(\"/api/cart/<int:item_id>\")\n474: @login_required\n475: def cart_delete(item_id: int):\n476:     db = get_db()\n477:     row = db.execute(\n478:         \"SELECT id FROM cart_items WHERE id = ? AND user_id = ?\",\n479:         (item_id, g.user[\"id\"]),\n480:     ).fetchone()\n481:     if row is None:\n482:         return error(\"cart item not found\", 404)\n483:     db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n484:     db.commit()\n485:     return \"\", 204\n486: \n487: \n488: # --------------------------------------------------------------------------\n489: # Admin routes\n490: # --------------------------------------------------------------------------\n491: \n492: def validate_product_fields(body: dict, partial: bool):\n493:     fields = {}\n494:     if \"name\" in body:\n495:         name = body.get(\"name\")\n496:         if not isinstance(name, str) or not name.strip():\n497:             return None, \"name must be a non-empty string\"\n498:         fields[\"name\"] = name.strip()\n499:     if \"description\" in body:\n500:         description = body.get(\"description\")\n501:         if not isinstance(description, str):\n502:             return None, \"description must be a string\"\n503:         fields[\"description\"] = description\n504:     if \"price\" in body:\n505:         price = as_price(body.get(\"price\"))\n506:         if price is None:\n507:             return None, \"price must be a non-negative number\"\n508:         fields[\"price\"] = price\n509:     if \"stock\" in body:\n510:         stock = as_stock(body.get(\"stock\"))\n511:         if stock is None:\n512:             return None, \"stock must be a non-negative integer\"\n513:         fields[\"stock\"] = stock\n514:     if \"is_active\" in body:\n515:         is_active = as_bool(body.get(\"is_active\"))\n516:         if is_active is None:\n517:             return None, \"is_active must be a boolean\"\n518:         fields[\"is_active\"] = is_active\n519:     if not partial:\n520:         if \"name\" not in fields:\n521:             return None, \"name is required\"\n522:         if \"price\" not in fields:\n523:             return None, \"price is required\"\n524:         fields.setdefault(\"description\", \"\")\n525:         fields.setdefault(\"stock\", 0)\n526:         fields.setdefault(\"is_active\", True)\n527:     return fields, None\n528: \n529: \n530: @app.get(\"/api/admin/products\")\n531: @admin_required\n532: def admin_products_index():\n533:     payload, err = list_products(include_inactive=True)\n534:     return err if err else jsonify(payload)\n535: \n536: \n537: @app.post(\"/api/admin/products\")\n538: @admin_required\n539: def admin_products_create():\n540:     body = json_body()\n541:     if not isinstance(body, dict):\n542:         return error(\"a JSON body is required\", 400)\n543:     fields, err = validate_product_fields(body, partial=False)\n544:     if err:\n545:         return error(err, 400)\n546:     db = get_db()\n547:     cur = db.execute(\n548:         \"INSERT INTO products (name, description, price, stock, is_active)\"\n549:         \" VALUES (:name, :description, :price, :stock, :is_active)\",\n550:         fields,\n551:     )\n552:     db.commit()\n553:     row = db.execute(\n554:         \"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)\n555:     ).fetchone()\n556:     return jsonify(product_dict(row)), 201\n557: \n558: \n559: @app.patch(\"/api/admin/products/<int:product_id>\")\n560: @admin_required\n561: def admin_products_update(product_id: int):\n562:     body = json_body()\n563:     if not isinstance(body, dict):\n564:         return error(\"a JSON body is required\", 400)\n565:     fields, err = validate_product_fields(body, partial=True)\n566:     if err:\n567:         return error(err, 400)\n568:     if not fields:\n569:         return error(\"no valid fields to update\", 400)\n570:     db = get_db()\n571:     row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n572:     if row is None:\n573:         return error(\"product not found\", 404)\n574:     assignments = \", \".join(f\"{key} = :{key}\" for key in fields)\n575:     db.execute(\n576:         f\"UPDATE products SET {assignments} WHERE id = :id\",\n577:         {**fields, \"id\": product_id},\n578:     )\n579:     db.commit()\n580:     row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n581:     return jsonify(product_dict(row))\n582: \n583: \n584: # --------------------------------------------------------------------------\n585: # Errors and frontend\n586: # --------------------------------------------------------------------------\n587: \n588: @app.errorhandler(404)\n589: def handle_not_found(exc):\n590:     if request.path.startswith(\"/api/\"):\n591:         return error(\"not found\", 404)\n592:     return frontend()\n593: \n594: \n595: @app.errorhandler(405)\n596: def handle_method_not_allowed(exc):\n597:     if request.path.startswith(\"/api/\"):\n598:         return error(\"method not allowed\", 405)\n599:     return error(\"method not allowed\", 405)\n600: \n601: \n602: @app.errorhandler(500)\n603: def handle_internal_error(exc):\n604:     return error(\"internal server error\", 500)\n605: \n606: \n607: @app.get(\"/api/health\")\n608: def health():\n609:     return {\"status\": \"ok\"}\n610: \n611: \n612: @app.get(\"/\")\n613: @app.get(\"/<path:path>\")\n614: def frontend(path: str = \"index.html\"):\n615:     if path == \"api\" or path.startswith(\"api/\"):\n616:         return error(\"not found\", 404)\n617:     if (DIST / path).is_file():\n618:         return send_from_directory(DIST, path)\n619:     return send_from_directory(DIST, \"index.html\")\n620: \n621: \n622: init_db()\n623: \n624: if __name__ == \"__main__\":\n625:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n\n(End of file - total 625 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: shop JSON API plus frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"shop.db\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: shop JSON API plus frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"shop.db\"\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\nSEED_PRODUCTS = [\n    (\"Aurora Desk Lamp\", \"LED desk lamp with a dimmable, adjustable arm.\", 34.99, 25),\n    (\"Bamboo Cutting Board\", \"Large end-grain bamboo board with juice groove.\", 24.50, 40),\n    (\"Ceramic Pour-Over Set\", \"Hand-glazed dripper, carafe and two cups.\", 48.00, 15),\n    (\"Cotton Throw Blanket\", \"Soft woven throw, machine washable, 130x170 cm.\", 39.99, 30),\n    (\"Espresso Hand Grinder\", \"Conical burr grinder with 30 click settings.\", 79.00, 12),\n    (\"Linen Apron\", \"Stonewashed linen apron with cross-back straps.\", 28.75, 22),\n    (\"Maple Serving Bowl\", \"Turned maple bowl, finished with food-safe oil.\", 44.00, 18),\n    (\"Stoneware Mug\", \"Stackable 350 ml stoneware mug, dishwasher safe.\", 16.99, 50),\n    (\"Walnut Picture Frame\", \"Solid walnut frame for 13x18 cm photos.\", 22.00, 35),\n    (\"Wool Felt Coasters\", \"Set of six merino felt coasters in mixed colours.\", 12.99, 10),\n]\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\nCREATE TABLE IF NOT EXISTS products (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    price REAL NOT NULL,\n    stock INTEGER NOT NULL DEFAULT 0,\n    is_active INTEGER NOT NULL DEFAULT 1\n);\nCREATE TABLE IF NOT EXISTS cart_items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n    quantity INTEGER NOT NULL,\n    UNIQUE (user_id, product_id)\n);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# Database helpers\n# --------------------------------------------------------------------------\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        if conn.execute(\"SELECT COUNT(*) AS n FROM products\").fetchone()[\"n\"] == 0:\n            conn.executemany(\n                \"INSERT INTO products (name, description, price, stock, is_active)\"\n                \" VALUES (?, ?, ?, ?, 1)\",\n                SEED_PRODUCTS,\n            )\n        if ADMIN_PASSWORD:\n            pw_hash = generate_password_hash(ADMIN_PASSWORD)\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n            if row:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ? WHERE id = ?\",\n                    (pw_hash, row[\"id\"]),\n                )\n            else:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                    (ADMIN_USERNAME, pw_hash),\n                )\n        else:\n            conn.execute(\n                \"UPDATE users SET password_hash = '' WHERE username = ?\",\n                (ADMIN_USERNAME,),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\n# --------------------------------------------------------------------------\n# Serialisation\n# --------------------------------------------------------------------------\n\ndef product_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": float(row[\"price\"]),\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\ndef cart_item_dict(row: sqlite3.Row) -> dict:\n    unit_price = float(row[\"price\"])\n    quantity = row[\"quantity\"]\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": quantity,\n        \"name\": row[\"name\"],\n        \"unit_price\": unit_price,\n        \"line_total\": unit_price * quantity,\n    }\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\n# --------------------------------------------------------------------------\n# Request parsing\n# --------------------------------------------------------------------------\n\ndef json_body():\n    return request.get_json(silent=True)\n\n\ndef as_number(value):\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, (int, float)):\n        return value\n    if isinstance(value, str):\n        try:\n            return float(value.strip())\n        except ValueError:\n            return None\n    return None\n\n\ndef as_int(value):\n    number = as_number(value)\n    if number is None:\n        return None\n    if isinstance(number, float) and not number.is_integer():\n        return None\n    return int(number)\n\n\ndef as_bool(value):\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    return None\n\n\ndef as_price(value):\n    number = as_number(value)\n    if number is None or number < 0:\n        return None\n    return float(number)\n\n\ndef as_stock(value):\n    number = as_int(value)\n    if number is None or number < 0:\n        return None\n    return number\n\n\n# --------------------------------------------------------------------------\n# Authentication\n# --------------------------------------------------------------------------\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\":\n        return None\n    token = token.strip()\n    if not token:\n        return None\n    return (\n        get_db()\n        .execute(\n            \"SELECT u.* FROM tokens t JOIN users u ON u.id = t.user_id\"\n            \" WHERE t.token = ?\",\n            (token,),\n        )\n        .fetchone()\n    )\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        if user[\"username\"] != ADMIN_USERNAME:\n            return error(\"admin access required\", 403)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n# --------------------------------------------------------------------------\n# Auth routes\n# --------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        return error(\"username is reserved\", 400)\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return error(\"username already taken\", 409)\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    user_id = cur.lastrowid\n    token = secrets.token_urlsafe(32)\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id))\n    db.commit()\n    return jsonify({\"id\": user_id, \"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    user = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if user is None or not user[\"password_hash\"]:\n        return error(\"invalid credentials\", 401)\n    if not check_password_hash(user[\"password_hash\"], password):\n        return error(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n# --------------------------------------------------------------------------\n# Catalogue routes\n# --------------------------------------------------------------------------\n\ndef list_products(include_inactive: bool):\n    db = get_db()\n    where = []\n    params = []\n    if not include_inactive:\n        where.append(\"is_active = 1\")\n    q = request.args.get(\"q\")\n    if q:\n        pattern = (\n            \"%\" + q.lower().replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n        )\n        where.append(\"LOWER(name) LIKE ? ESCAPE '\\\\'\")\n        params.append(pattern)\n    where_sql = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 20))\n    except ValueError:\n        return None, error(\"page and page_size must be integers\", 400)\n    if page < 1:\n        return None, error(\"page must be at least 1\", 400)\n    if page_size < 1:\n        return None, error(\"page_size must be at least 1\", 400)\n\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM products\" + where_sql, params\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM products\"\n        + where_sql\n        + \" ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    payload = {\n        \"items\": [product_dict(row) for row in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n    return payload, None\n\n\n@app.get(\"/api/products\")\ndef products_index():\n    payload, err = list_products(include_inactive=False)\n    return err if err else jsonify(payload)\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef products_show(product_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"product not found\", 404)\n    return jsonify(product_dict(row))\n\n\n# --------------------------------------------------------------------------\n# Cart routes\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/cart\")\n@login_required\ndef cart_index():\n    rows = get_db().execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n        \" WHERE ci.user_id = ? AND p.is_active = 1 ORDER BY ci.id\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    items = [cart_item_dict(row) for row in rows]\n    subtotal = sum(item[\"line_total\"] for item in items)\n    return jsonify({\"items\": items, \"subtotal\": subtotal})\n\n\n@app.post(\"/api/cart\")\n@login_required\ndef cart_add():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    raw_id = body.get(\"product_id\", body.get(\"id\"))\n    product_id = as_int(raw_id)\n    if product_id is None:\n        return error(\"product_id is required\", 400)\n    if \"quantity\" in body:\n        quantity = as_int(body.get(\"quantity\"))\n        if quantity is None or quantity < 1:\n            return error(\"quantity must be a positive integer\", 400)\n    else:\n        quantity = 1\n    db = get_db()\n    product = db.execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if product is None:\n        return error(\"product not found\", 404)\n    existing = db.execute(\n        \"SELECT id, quantity FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (g.user[\"id\"], product_id),\n    ).fetchone()\n    if existing:\n        new_quantity = existing[\"quantity\"] + quantity\n        db.execute(\n            \"UPDATE cart_items SET quantity = ? WHERE id = ?\",\n            (new_quantity, existing[\"id\"]),\n        )\n        item_id = existing[\"id\"]\n    else:\n        cur = db.execute(\n            \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n            (g.user[\"id\"], product_id, quantity),\n        )\n        item_id = cur.lastrowid\n    db.commit()\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.id = ?\",\n        (item_id,),\n    ).fetchone()\n    return jsonify(cart_item_dict(row)), 201\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\n@login_required\ndef cart_update(item_id: int):\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    quantity = as_int(body.get(\"quantity\"))\n    if quantity is None or quantity < 1:\n        return error(\"quantity must be a positive integer\", 400)\n    db = get_db()\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n        \" WHERE ci.id = ? AND ci.user_id = ?\",\n        (item_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return error(\"cart item not found\", 404)\n    db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n    db.commit()\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.id = ?\",\n        (item_id,),\n    ).fetchone()\n    return jsonify(cart_item_dict(row))\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\n@login_required\ndef cart_delete(item_id: int):\n    db = get_db()\n    row = db.execute(\n        \"SELECT id FROM cart_items WHERE id = ? AND user_id = ?\",\n        (item_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return error(\"cart item not found\", 404)\n    db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    db.commit()\n    return \"\", 204\n\n\n# --------------------------------------------------------------------------\n# Admin routes\n# --------------------------------------------------------------------------\n\ndef validate_product_fields(body: dict, partial: bool):\n    fields = {}\n    if \"name\" in body:\n        name = body.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return None, \"name must be a non-empty string\"\n        fields[\"name\"] = name.strip()\n    if \"description\" in body:\n        description = body.get(\"description\")\n        if not isinstance(description, str):\n            return None, \"description must be a string\"\n        fields[\"description\"] = description\n    if \"price\" in body:\n        price = as_price(body.get(\"price\"))\n        if price is None:\n            return None, \"price must be a non-negative number\"\n        fields[\"price\"] = price\n    if \"stock\" in body:\n        stock = as_stock(body.get(\"stock\"))\n        if stock is None:\n            return None, \"stock must be a non-negative integer\"\n        fields[\"stock\"] = stock\n    if \"is_active\" in body:\n        is_active = as_bool(body.get(\"is_active\"))\n        if is_active is None:\n            return None, \"is_active must be a boolean\"\n        fields[\"is_active\"] = is_active\n    if not partial:\n        if \"name\" not in fields:\n            return None, \"name is required\"\n        if \"price\" not in fields:\n            return None, \"price is required\"\n        fields.setdefault(\"description\", \"\")\n        fields.setdefault(\"stock\", 0)\n        fields.setdefault(\"is_active\", True)\n    return fields, None\n\n\n@app.get(\"/api/admin/products\")\n@admin_required\ndef admin_products_index():\n    payload, err = list_products(include_inactive=True)\n    return err if err else jsonify(payload)\n\n\n@app.post(\"/api/admin/products\")\n@admin_required\ndef admin_products_create():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    fields, err = validate_product_fields(body, partial=False)\n    if err:\n        return error(err, 400)\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO products (name, description, price, stock, is_active)\"\n        \" VALUES (:name, :description, :price, :stock, :is_active)\",\n        fields,\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(product_dict(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\n@admin_required\ndef admin_products_update(product_id: int):\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    fields, err = validate_product_fields(body, partial=True)\n    if err:\n        return error(err, 400)\n    if not fields:\n        return error(\"no valid fields to update\", 400)\n    db = get_db()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    if row is None:\n        return error(\"product not found\", 404)\n    assignments = \", \".join(f\"{key} = :{key}\" for key in fields)\n    db.execute(\n        f\"UPDATE products SET {assignments} WHERE id = :id\",\n        {**fields, \"id\": product_id},\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return jsonify(product_dict(row))\n\n\n# --------------------------------------------------------------------------\n# Errors and frontend\n# --------------------------------------------------------------------------\n\n@app.errorhandler(404)\ndef handle_not_found(exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"not found\", 404)\n    return frontend()\n\n\n@app.errorhandler(405)\ndef handle_method_not_allowed(exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"method not allowed\", 405)\n    return error(\"method not allowed\", 405)\n\n\n@app.errorhandler(500)\ndef handle_internal_error(exc):\n    return error(\"internal server error\", 500)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))","lineStart":1,"lineEnd":625,"totalLines":625,"truncated":false}},"title":"backend/app.py","time":{"start":1794380837080,"end":1794380837094}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c96eb0d2001ta3kT4HMxRGFdh","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","messageID":"msg_1c96e9954001oHX51vwuwogxav"}}
