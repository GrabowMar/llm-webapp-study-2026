 if scheme.lower() != \"bearer\":\n         return None\n-    token = header[len(\"Bearer \"):].strip()\n+    token = token.strip()\n     if not token:\n         return None\n     return (\n         get_db()\n","additions":3,"deletions":2},"truncated":false},"title":"backend/app.py","time":{"start":1794380823102,"end":1794380823150}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c96e7a38001gbdHS3A4kMSTET","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","messageID":"msg_1c96e5efd001Xar241a11K49sJ"}}
