{"type":"tool_use","timestamp":1794379886222,"sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","part":{"type":"tool","tool":"write","callID":"call_65f32ea500aa48288fae57f1","state":{"status":"completed","input":{"content":"import json\nimport urllib.request\nimport urllib.error\n\nBASE = \"http://localhost:8000\"\nPASS = FAIL = 0\n\ndef req(method, path, body=None, token=None, raw=False):\n    headers = {\"Content-Type\": \"application/json\"}\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status, payload = resp.status, resp.read()\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, e.read()\n    if raw:\n        return status, payload\n    if not payload:\n        return status, None\n    return status, json.loads(payload)\n\ndef check(name, cond, extra=\"\"):\n    global PASS, FAIL\n    if cond:\n        PASS += 1\n        print(f\"ok   {name}\")\n    else:\n        FAIL += 1\n        print(f\"FAIL {name} {extra}\")\n\ns, d = req(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and d == {\"status\": \"ok\"}, (s, d))\n\n# products listing\ns, d = req(\"GET\", \"/api/products\")\ncheck(\"products list\", s == 200 and d[\"total\"] >= 8 and d[\"page\"] == 1 and d[\"page_size\"] == 20, (s, d and d[\"total\"]))\nnames = [p[\"name\"] for p in d[\"items\"]]\ncheck(\"sorted by name\", names == sorted(names, key=str.lower), names)\ncheck(\"all stock >= 10\", all(p[\"stock\"] >= 10 for p in d[\"items\"]))\ncheck(\"product shape\", set(d[\"items\"][0]) == {\"id\", \"name\", \"description\", \"price\", \"stock\", \"is_active\"}, d[\"items\"][0])\npid = d[\"items\"][0][\"id\"]\n\ns, d = req(\"GET\", f\"/api/products/{pid}\")\ncheck(\"product show\", s == 200 and d[\"id\"] == pid, (s, d))\ns, d = req(\"GET\", \"/api/products/99999\")\ncheck(\"product missing 404\", s == 404 and \"error\" in d, (s, d))\ns, d = req(\"GET\", \"/api/products/notanint\")\ncheck(\"product bad id 404\", s == 404, (s, d))\n\n# paging + q\ns, d = req(\"GET\", \"/api/products?page=1&page_size=3\")\ncheck(\"paging size\", s == 200 and len(d[\"items\"]) == 3 and d[\"total\"] >= 8, (s, len(d[\"items\"]) if d else None, d and d[\"total\"]))\ns, d2 = req(\"GET\", \"/api/products?page=2&page_size=3\")\ncheck(\"paging page2\", s == 200 and d2[\"items\"] != d[\"items\"] and d2[\"page\"] == 2, (s, d2))\ns, d = req(\"GET\", \"/api/products?q=stoneware\")\ncheck(\"search q\", s == 200 and d[\"total\"] == 1 and d[\"items\"][0][\"name\"] == \"Stoneware Mug\", (s, d and [(p[\"name\"]) for p in d[\"items\"]]))\ns, d = req(\"GET\", \"/api/products?q=zzzznothing\")\ncheck(\"search empty\", s == 200 and d[\"total\"] == 0 and d[\"items\"] == [], (s, d))\ns, d = req(\"GET\", \"/api/products?page=0\")\ncheck(\"bad page 400\", s == 400 and \"error\" in d, (s, d))\ns, d = req(\"GET\", \"/api/products?page_size=abc\")\ncheck(\"bad page_size 400\", s == 400, (s, d))\n\n# auth\ns, d = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123\"})\ncheck(\"register 201\", s == 201 and d[\"username\"] == \"alice\", (s, d))\ns, d = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123\"})\ncheck(\"register dup 409\", s == 409 and \"error\" in d, (s, d))\ns, d = req(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"x\"})\ncheck(\"register admin reserved\", s == 400, (s, d))\ns, d = req(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty name 400\", s == 400, (s, d))\ns, d = req(\"POST\", \"/api/auth/register\", {\"username\": \"bob\"})\ncheck(\"register no pw 400\", s == 400, (s, d))\n\ns, d = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw123\"})\ncheck(\"login 200 token\", s == 200 and isinstance(d.get(\"token\"), str) and d[\"token\"], (s, d))\nalice = d[\"token\"]\ns, d = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong pw 401\", s == 401, (s, d))\ns, d = req(\"POST\", \"/api/auth/login\", {\"username\": \"nobody\", \"password\": \"x\"})\ncheck(\"login no user 401\", s == 401, (s, d))\ns, d = req(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"secret123\"})\ncheck(\"admin login\", s == 200 and d.get(\"token\"), (s, d))\nadmin = d[\"token\"]\ns, d = req(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"nope\"})\ncheck(\"admin wrong pw 401\", s == 401, (s, d))\n\n# cart without auth\ns, d = req(\"GET\", \"/api/cart\")\ncheck(\"cart unauth 401\", s == 401 and \"error\" in d, (s, d))\ns, d = req(\"GET\", \"/api/cart\", token=\"garbage\")\ncheck(\"cart bad token 401\", s == 401, (s, d))\n\n# register bob for isolation\ns, d = req(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw123\"})\nbob_token = d[\"token\"]\n\n# cart ops\ns, d = req(\"GET\", \"/api/cart\", token=alice)\ncheck(\"cart empty\", s == 200 and d == {\"items\": [], \"subtotal\": 0.0} and d[\"subtotal\"] == 0, (s, d))\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": pid, \"quantity\": 2}, token=alice)\ncheck(\"cart add 201\", s == 201 and d[\"quantity\"] == 2 and d[\"product_id\"] == pid and d[\"line_total\"] == d[\"unit_price\"] * 2, (s, d))\nitem1 = d[\"id\"]\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": pid, \"quantity\": 3}, token=alice)\ncheck(\"cart add again merges\", s == 201 and d[\"quantity\"] == 5 and d[\"id\"] == item1, (s, d))\npid2 = req(\"GET\", \"/api/products?page_size=100\")[1][\"items\"][1][\"id\"]\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": pid2, \"quantity\": 1}, token=alice)\ncheck(\"cart add second\", s == 201 and d[\"quantity\"] == 1, (s, d))\nitem2 = d[\"id\"]\n\ns, d = req(\"GET\", \"/api/cart\", token=alice)\ncheck(\"cart items\", s == 200 and len(d[\"items\"]) == 2 and d[\"items\"][0][\"id\"] == item1 and d[\"items\"][1][\"id\"] == item2, (s, d))\ncheck(\"cart item shape\", set(d[\"items\"][0]) == {\"id\", \"product_id\", \"quantity\", \"name\", \"unit_price\", \"line_total\"}, d[\"items\"][0])\nsub = sum(i[\"line_total\"] for i in d[\"items\"])\ncheck(\"cart subtotal\", d[\"subtotal\"] == sub, (d[\"subtotal\"], sub))\n\n# prices come from catalogue: client price ignored\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": pid, \"quantity\": 1, \"unit_price\": 0.01, \"price\": 0.01}, token=alice)\ncheck(\"client price ignored\", s == 201 and d[\"unit_price\"] == req(\"GET\", f\"/api/products/{pid}\")[1][\"price\"], (s, d))\n\n# patch + delete\ns, d = req(\"PATCH\", f\"/api/cart/{item2}\", {\"quantity\": 7}, token=alice)\ncheck(\"cart patch\", s == 200 and d[\"quantity\"] == 7 and d[\"line_total\"] == d[\"unit_price\"] * 7, (s, d))\ns, d = req(\"PATCH\", f\"/api/cart/{item2}\", {\"quantity\": 0}, token=alice)\ncheck(\"cart patch qty 0 rejected\", s == 400 and \"error\" in d, (s, d))\ns, d = req(\"PATCH\", f\"/api/cart/{item2}\", {\"quantity\": -2}, token=alice)\ncheck(\"cart patch neg rejected\", s == 400, (s, d))\ns, d = req(\"PATCH\", f\"/api/cart/{item2}\", {\"quantity\": \"3\"}, token=alice)\ncheck(\"cart patch string qty ok\", s == 200 and d[\"quantity\"] == 3, (s, d))\n\n# isolation\ns, d = req(\"GET\", \"/api/cart\", token=bob_token)\ncheck(\"bob empty cart\", s == 200 and d[\"items\"] == [] and d[\"subtotal\"] == 0, (s, d))\ns, d = req(\"PATCH\", f\"/api/cart/{item2}\", {\"quantity\": 2}, token=bob_token)\ncheck(\"bob patch alice item 404\", s == 404, (s, d))\ns, d = req(\"DELETE\", f\"/api/cart/{item2}\", token=bob_token)\ncheck(\"bob delete alice item 404\", s == 404, (s, d))\ns, d = req(\"GET\", \"/api/cart\", token=alice)\ncheck(\"alice cart intact\", len(d[\"items\"]) == 2, (s, d))\n\ns, d = req(\"DELETE\", f\"/api/cart/{item2}\", token=alice)\ncheck(\"cart delete 204\", s == 204 and d is None, (s, d))\ns, d = req(\"GET\", \"/api/cart\", token=alice)\ncheck(\"cart after delete\", len(d[\"items\"]) == 1 and d[\"items\"][0][\"id\"] == item1, (s, d))\n\n# admin auth\ns, d = req(\"POST\", \"/api/admin/products\", {\"name\": \"X\", \"price\": 1})\ncheck(\"admin unauth 401\", s == 401, (s, d))\ns, d = req(\"POST\", \"/api/admin/products\", {\"name\": \"X\", \"price\": 1}, token=alice)\ncheck(\"admin as user 403\", s == 403 and \"error\" in d, (s, d))\n\ns, d = req(\"POST\", \"/api/admin/products\", {\"name\": \"Test Widget\", \"description\": \"A widget\", \"price\": 19.99, \"stock\": 7, \"is_active\": True}, token=admin)\ncheck(\"admin create 201\", s == 201 and d[\"name\"] == \"Test Widget\" and d[\"price\"] == 19.99 and d[\"stock\"] == 7 and d[\"is_active\"] is True, (s, d))\nwid = d[\"id\"]\ns, d = req(\"POST\", \"/api/admin/products\", {\"name\": \"NoPrice\"}, token=admin)\ncheck(\"admin create no price 400\", s == 400, (s, d))\ns, d = req(\"POST\", \"/api/admin/products\", {\"price\": 5}, token=admin)\ncheck(\"admin create no name 400\", s == 400, (s, d))\n\ns, d = req(\"PATCH\", f\"/api/admin/products/{wid}\", {\"price\": 24.5, \"stock\": 3, \"is_active\": False}, token=admin)\ncheck(\"admin patch\", s == 200 and d[\"price\"] == 24.5 and d[\"stock\"] == 3 and d[\"is_active\"] is False, (s, d))\ns, d = req(\"GET\", f\"/api/products/{wid}\")\ncheck(\"inactive hidden from catalogue\", s == 404, (s, d))\ns, d = req(\"GET\", \"/api/products\")\ncheck(\"inactive not listed\", all(p[\"id\"] != wid for p in d[\"items\"]) and all(p[\"is_active\"] for p in d[\"items\"]), (s, d))\ns, d = req(\"GET\", \"/api/admin/products\", token=admin)\ncheck(\"admin sees inactive\", any(p[\"id\"] == wid and p[\"is_active\"] is False for p in d[\"items\"]), (s, d))\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": wid, \"quantity\": 1}, token=alice)\ncheck(\"add inactive 404\", s == 404, (s, d))\n\n# inactive product excluded from cart\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": wid, \"quantity\": 2}, token=bob_token) if False else (None, None)\ns, d = req(\"PATCH\", f\"/api/admin/products/{wid}\", {\"is_active\": True}, token=admin)\nreq(\"POST\", \"/api/cart\", {\"product_id\": wid, \"quantity\": 2}, token=alice)\nreq(\"PATCH\", f\"/api/admin/products/{wid}\", {\"is_active\": False}, token=admin)\ns, d = req(\"GET\", \"/api/cart\", token=alice)\ncheck(\"inactive items left out of cart\", all(i[\"product_id\"] != wid for i in d[\"items\"]) and d[\"subtotal\"] == sum(i[\"line_total\"] for i in d[\"items\"]), (s, d))\ns, d = req(\"GET\", \"/api/cart\", token=alice)\nbefore = d[\"subtotal\"]\ns, d = req(\"PATCH\", f\"/api/admin/products/{item1 and wid}\", {\"is_active\": True}, token=admin)\nreq(\"PATCH\", f\"/api/admin/products/{wid}\", {\"is_active\": False}, token=admin)\ns, d = req(\"GET\", \"/api/cart\", token=alice)\ncheck(\"subtotal excludes inactive\", d[\"subtotal\"] == before or all(i[\"product_id\"] != wid for i in d[\"items\"]), (d, before))\n\n# stock: add to cart does not change stock\ns, d = req(\"GET\", f\"/api/products/{pid}\")\nstock_before = d[\"stock\"]\nreq(\"POST\", \"/api/cart\", {\"product_id\": pid, \"quantity\": 5}, token=bob_token)\ns, d = req(\"GET\", f\"/api/products/{pid}\")\ncheck(\"add does not change stock\", d[\"stock\"] == stock_before, (stock_before, d[\"stock\"]))\n\n# price change reflects in cart\ns, d = req(\"GET\", \"/api/cart\", token=alice)\nalice_first = [i for i in d[\"items\"] if i[\"product_id\"] == pid][0]\nreq(\"PATCH\", f\"/api/admin/products/{pid}\", {\"price\": 2.0}, token=admin)\ns, d = req(\"GET\", \"/api/cart\", token=alice)\nrow = [i for i in d[\"items\"] if i[\"product_id\"] == pid][0]\ncheck(\"cart uses current price\", row[\"unit_price\"] == 2.0 and row[\"line_total\"] == 2.0 * row[\"quantity\"], (row, alice_first))\nreq(\"PATCH\", f\"/api/admin/products/{pid}\", {\"price\": alice_first[\"unit_price\"]}, token=admin)\n\n# patch product validation\ns, d = req(\"PATCH\", f\"/api/admin/products/{wid}\", {\"price\": -1}, token=admin)\ncheck(\"admin patch neg price 400\", s == 400 and \"error\" in d, (s, d))\ns, d = req(\"PATCH\", f\"/api/admin/products/{wid}\", {\"stock\": 1.5}, token=admin)\ncheck(\"admin patch float stock 400\", s == 400, (s, d))\ns, d = req(\"PATCH\", f\"/api/admin/products/{wid}\", {\"name\": \"\"}, token=admin)\ncheck(\"admin patch empty name 400\", s == 400, (s, d))\ns, d = req(\"PATCH\", \"/api/admin/products/99999\", {\"price\": 1}, token=admin)\ncheck(\"admin patch missing 404\", s == 404, (s, d))\ns, d = req(\"PATCH\", f\"/api/admin/products/{wid}\", {\"stock\": \"12\"}, token=admin)\ncheck(\"admin patch string stock ok\", s == 200 and d[\"stock\"] == 12, (s, d))\n\n# cart default quantity\ns, d = req(\"POST\", \"/api/cart\", {\"product_id\": pid2}, token=bob_token)\ncheck(\"cart add default qty 1\", s == 201 and d[\"quantity\"] == 1, (s, d))\n\nprint(f\"\\n{PASS} passed, {FAIL} failed\")\n","filePath":"/workspace/.venv/run/smoke.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.venv/run/smoke.py","exists":false,"truncated":false},"title":".venv/run/smoke.py","time":{"start":1794379886185,"end":1794379886197}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9602e61001wWPAFeh8nYNM4t","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","messageID":"msg_1c95f7e31001bXzuXblKhEIHsb"}}
