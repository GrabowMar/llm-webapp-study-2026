{"type":"tool_use","timestamp":1794379817537,"sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","part":{"type":"tool","tool":"write","callID":"call_1e283e72c5934a22ad574198","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: shop JSON API plus frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"shop.db\"\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\nSEED_PRODUCTS = [\n    (\"Aurora Desk Lamp\", \"LED desk lamp with a dimmable, adjustable arm.\", 34.99, 25),\n    (\"Bamboo Cutting Board\", \"Large end-grain bamboo board with juice groove.\", 24.50, 40),\n    (\"Ceramic Pour-Over Set\", \"Hand-glazed dripper, carafe and two cups.\", 48.00, 15),\n    (\"Cotton Throw Blanket\", \"Soft woven throw, machine washable, 130x170 cm.\", 39.99, 30),\n    (\"Espresso Hand Grinder\", \"Conical burr grinder with 30 click settings.\", 79.00, 12),\n    (\"Linen Apron\", \"Stonewashed linen apron with cross-back straps.\", 28.75, 22),\n    (\"Maple Serving Bowl\", \"Turned maple bowl, finished with food-safe oil.\", 44.00, 18),\n    (\"Stoneware Mug\", \"Stackable 350 ml stoneware mug, dishwasher safe.\", 16.99, 50),\n    (\"Walnut Picture Frame\", \"Solid walnut frame for 13x18 cm photos.\", 22.00, 35),\n    (\"Wool Felt Coasters\", \"Set of six merino felt coasters in mixed colours.\", 12.99, 10),\n]\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\nCREATE TABLE IF NOT EXISTS products (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    price REAL NOT NULL,\n    stock INTEGER NOT NULL DEFAULT 0,\n    is_active INTEGER NOT NULL DEFAULT 1\n);\nCREATE TABLE IF NOT EXISTS cart_items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n    quantity INTEGER NOT NULL,\n    UNIQUE (user_id, product_id)\n);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# Database helpers\n# --------------------------------------------------------------------------\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        if conn.execute(\"SELECT COUNT(*) AS n FROM products\").fetchone()[\"n\"] == 0:\n            conn.executemany(\n                \"INSERT INTO products (name, description, price, stock, is_active)\"\n                \" VALUES (?, ?, ?, ?, 1)\",\n                SEED_PRODUCTS,\n            )\n        if ADMIN_PASSWORD:\n            pw_hash = generate_password_hash(ADMIN_PASSWORD)\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n            if row:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ? WHERE id = ?\",\n                    (pw_hash, row[\"id\"]),\n                )\n            else:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                    (ADMIN_USERNAME, pw_hash),\n                )\n        else:\n            conn.execute(\n                \"UPDATE users SET password_hash = '' WHERE username = ?\",\n                (ADMIN_USERNAME,),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\n# --------------------------------------------------------------------------\n# Serialisation\n# --------------------------------------------------------------------------\n\ndef product_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": float(row[\"price\"]),\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\ndef cart_item_dict(row: sqlite3.Row) -> dict:\n    unit_price = float(row[\"price\"])\n    quantity = row[\"quantity\"]\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": quantity,\n        \"name\": row[\"name\"],\n        \"unit_price\": unit_price,\n        \"line_total\": unit_price * quantity,\n    }\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\n# --------------------------------------------------------------------------\n# Request parsing\n# --------------------------------------------------------------------------\n\ndef json_body():\n    return request.get_json(silent=True)\n\n\ndef as_number(value):\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, (int, float)):\n        return value\n    if isinstance(value, str):\n        try:\n            return float(value.strip())\n        except ValueError:\n            return None\n    return None\n\n\ndef as_int(value):\n    number = as_number(value)\n    if number is None:\n        return None\n    if isinstance(number, float) and not number.is_integer():\n        return None\n    return int(number)\n\n\ndef as_bool(value):\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    return None\n\n\ndef as_price(value):\n    number = as_number(value)\n    if number is None or number < 0:\n        return None\n    return float(number)\n\n\ndef as_stock(value):\n    number = as_int(value)\n    if number is None or number < 0:\n        return None\n    return number\n\n\n# --------------------------------------------------------------------------\n# Authentication\n# --------------------------------------------------------------------------\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    return (\n        get_db()\n        .execute(\n            \"SELECT u.* FROM tokens t JOIN users u ON u.id = t.user_id\"\n            \" WHERE t.token = ?\",\n            (token,),\n        )\n        .fetchone()\n    )\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        if user[\"username\"] != ADMIN_USERNAME:\n            return error(\"admin access required\", 403)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n# --------------------------------------------------------------------------\n# Auth routes\n# --------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        return error(\"username is reserved\", 400)\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return error(\"username already taken\", 409)\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    user_id = cur.lastrowid\n    token = secrets.token_urlsafe(32)\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id))\n    db.commit()\n    return jsonify({\"id\": user_id, \"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    user = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not user[\"password_hash\"]:\n        return error(\"invalid credentials\", 401)\n    if not check_password_hash(user[\"password_hash\"], password):\n        return error(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user[\"id\"]))\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n# --------------------------------------------------------------------------\n# Catalogue routes\n# --------------------------------------------------------------------------\n\ndef list_products(include_inactive: bool):\n    db = get_db()\n    where = []\n    params = []\n    if not include_inactive:\n        where.append(\"is_active = 1\")\n    q = request.args.get(\"q\")\n    if q:\n        pattern = (\n            \"%\" + q.lower().replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n        )\n        where.append(\"LOWER(name) LIKE ? ESCAPE '\\\\'\")\n        params.append(pattern)\n    where_sql = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 20))\n    except ValueError:\n        return None, error(\"page and page_size must be integers\", 400)\n    if page < 1:\n        return None, error(\"page must be at least 1\", 400)\n    if page_size < 1:\n        return None, error(\"page_size must be at least 1\", 400)\n\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM products\" + where_sql, params\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM products\"\n        + where_sql\n        + \" ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    payload = {\n        \"items\": [product_dict(row) for row in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n    return payload, None\n\n\n@app.get(\"/api/products\")\ndef products_index():\n    payload, err = list_products(include_inactive=False)\n    return err if err else jsonify(payload)\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef products_show(product_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"product not found\", 404)\n    return jsonify(product_dict(row))\n\n\n# --------------------------------------------------------------------------\n# Cart routes\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/cart\")\ndef cart_index():\n    rows = get_db().execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n        \" WHERE ci.user_id = ? AND p.is_active = 1 ORDER BY ci.id\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    items = [cart_item_dict(row) for row in rows]\n    subtotal = sum(item[\"line_total\"] for item in items)\n    return jsonify({\"items\": items, \"subtotal\": subtotal})\n\n\n@app.post(\"/api/cart\")\ndef cart_add():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    raw_id = body.get(\"product_id\", body.get(\"id\"))\n    product_id = as_int(raw_id)\n    if product_id is None:\n        return error(\"product_id is required\", 400)\n    if \"quantity\" in body:\n        quantity = as_int(body.get(\"quantity\"))\n        if quantity is None or quantity < 1:\n            return error(\"quantity must be a positive integer\", 400)\n    else:\n        quantity = 1\n    db = get_db()\n    product = db.execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if product is None:\n        return error(\"product not found\", 404)\n    existing = db.execute(\n        \"SELECT id, quantity FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (g.user[\"id\"], product_id),\n    ).fetchone()\n    if existing:\n        new_quantity = existing[\"quantity\"] + quantity\n        db.execute(\n            \"UPDATE cart_items SET quantity = ? WHERE id = ?\",\n            (new_quantity, existing[\"id\"]),\n        )\n        item_id = existing[\"id\"]\n    else:\n        cur = db.execute(\n            \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n            (g.user[\"id\"], product_id, quantity),\n        )\n        item_id = cur.lastrowid\n    db.commit()\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.id = ?\",\n        (item_id,),\n    ).fetchone()\n    return jsonify(cart_item_dict(row)), 201\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\ndef cart_update(item_id: int):\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    quantity = as_int(body.get(\"quantity\"))\n    if quantity is None or quantity < 1:\n        return error(\"quantity must be a positive integer\", 400)\n    db = get_db()\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n        \" WHERE ci.id = ? AND ci.user_id = ?\",\n        (item_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return error(\"cart item not found\", 404)\n    db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n    db.commit()\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.id = ?\",\n        (item_id,),\n    ).fetchone()\n    return jsonify(cart_item_dict(row))\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\ndef cart_delete(item_id: int):\n    db = get_db()\n    row = db.execute(\n        \"SELECT id FROM cart_items WHERE id = ? AND user_id = ?\",\n        (item_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return error(\"cart item not found\", 404)\n    db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    db.commit()\n    return \"\", 204\n\n\n# --------------------------------------------------------------------------\n# Admin routes\n# --------------------------------------------------------------------------\n\ndef validate_product_fields(body: dict, partial: bool):\n    fields = {}\n    if \"name\" in body:\n        name = body.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return None, \"name must be a non-empty string\"\n        fields[\"name\"] = name.strip()\n    if \"description\" in body:\n        description = body.get(\"description\")\n        if not isinstance(description, str):\n            return None, \"description must be a string\"\n        fields[\"description\"] = description\n    if \"price\" in body:\n        price = as_price(body.get(\"price\"))\n        if price is None:\n            return None, \"price must be a non-negative number\"\n        fields[\"price\"] = price\n    if \"stock\" in body:\n        stock = as_stock(body.get(\"stock\"))\n        if stock is None:\n            return None, \"stock must be a non-negative integer\"\n        fields[\"stock\"] = stock\n    if \"is_active\" in body:\n        is_active = as_bool(body.get(\"is_active\"))\n        if is_active is None:\n            return None, \"is_active must be a boolean\"\n        fields[\"is_active\"] = is_active\n    if not partial:\n        if \"name\" not in fields:\n            return None, \"name is required\"\n        if \"price\" not in fields:\n            return None, \"price is required\"\n        fields.setdefault(\"description\", \"\")\n        fields.setdefault(\"stock\", 0)\n        fields.setdefault(\"is_active\", True)\n    return fields, None\n\n\n@app.get(\"/api/admin/products\")\n@admin_required\ndef admin_products_index():\n    payload, err = list_products(include_inactive=True)\n    return err if err else jsonify(payload)\n\n\n@app.post(\"/api/admin/products\")\n@admin_required\ndef admin_products_create():\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    fields, err = validate_product_fields(body, partial=False)\n    if err:\n        return error(err, 400)\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO products (name, description, price, stock, is_active)\"\n        \" VALUES (:name, :description, :price, :stock, :is_active)\",\n        fields,\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(product_dict(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\n@admin_required\ndef admin_products_update(product_id: int):\n    body = json_body()\n    if not isinstance(body, dict):\n        return error(\"a JSON body is required\", 400)\n    fields, err = validate_product_fields(body, partial=True)\n    if err:\n        return error(err, 400)\n    if not fields:\n        return error(\"no valid fields to update\", 400)\n    db = get_db()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    if row is None:\n        return error(\"product not found\", 404)\n    assignments = \", \".join(f\"{key} = :{key}\" for key in fields)\n    db.execute(\n        f\"UPDATE products SET {assignments} WHERE id = :id\",\n        {**fields, \"id\": product_id},\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return jsonify(product_dict(row))\n\n\n# --------------------------------------------------------------------------\n# Errors and frontend\n# --------------------------------------------------------------------------\n\n@app.errorhandler(404)\ndef handle_not_found(exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"not found\", 404)\n    return frontend()\n\n\n@app.errorhandler(405)\ndef handle_method_not_allowed(exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"method not allowed\", 405)\n    return error(\"method not allowed\", 405)\n\n\n@app.errorhandler(500)\ndef handle_internal_error(exc):\n    return error(\"internal server error\", 500)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794379817481,"end":1794379817507}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c95f21fd001oEulm8CfPICR4B","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","messageID":"msg_1c95e6317001ai7wajAHWZ21zv"}}
