stance(username, str) or not isinstance(password, str):\n     return error(\"username and password are required\", 400)\n user = get_db().execute(\n-    \"SELECT * FROM users WHERE username = ?\", (username,)\n+    \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n ).fetchone()\n if user is None or not user[\"password_hash\"]:\n     return error(\"invalid credentials\", 401)\n if not check_password_hash(user[\"password_hash\"], password):\n","additions":1,"deletions":1},"truncated":false},"title":"backend/app.py","time":{"start":1794380823111,"end":1794380823175}},"id":"prt_1c96e7a41001MN1sAsk8mX00VW","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","messageID":"msg_1c96e5efd001Xar241a11K49sJ"}}
