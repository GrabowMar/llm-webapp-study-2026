{"type":"step_start","timestamp":1794380598866,"sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","part":{"id":"prt_1c96b0e2f001LP26thx5fqQDLQ","messageID":"msg_1c96a997e001sD0fRaRMV31ZQc","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","type":"step-start"}}
{"type":"tool_use","timestamp":1794380598930,"sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","part":{"type":"tool","tool":"write","callID":"call_cd78392ddc1b4df997f53b28","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport type { Product, ProductPage } from \"../lib/api\";\nimport { api, errorMessage, money } from \"../lib/api\";\n\ninterface Draft {\n  price: string;\n  stock: string;\n  is_active: boolean;\n}\n\nfunction draftOf(product: Product): Draft {\n  return {\n    price: product.price.toFixed(2),\n    stock: String(product.stock),\n    is_active: product.is_active,\n  };\n}\n\nexport default function AdminPanel() {\n  const [products, setProducts] = useState<Product[]>([]);\n  const [drafts, setDrafts] = useState<Record<number, Draft>>({});\n  const [form, setForm] = useState({\n    name: \"\",\n    description: \"\",\n    price: \"\",\n    stock: \"10\",\n    is_active: true,\n  });\n  const [error, setError] = useState<string | null>(null);\n  const [flash, setFlash] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function refresh() {\n    try {\n      const res = await api<ProductPage>(\"/admin/products?page_size=500\");\n      setProducts(res.items);\n      const next: Record<number, Draft> = {};\n      for (const product of res.items) next[product.id] = draftOf(product);\n      setDrafts(next);\n    } catch (err) {\n      setError(errorMessage(err));\n    }\n  }\n\n  useEffect(() => {\n    refresh();\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  function setDraft(id: number, patch: Partial<Draft>) {\n    setDrafts((prev) => ({ ...prev, [id]: { ...prev[id], ...patch } }));\n  }\n\n  async function createProduct(event: FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFlash(null);\n    try {\n      const created = await api<Product>(\"/admin/products\", {\n        method: \"POST\",\n        body: {\n          name: form.name,\n          description: form.description,\n          price: Number(form.price),\n          stock: Number(form.stock),\n          is_active: form.is_active,\n        },\n      });\n      setFlash(`Added “${created.name}”`);\n      setForm({ name: \"\", description: \"\", price: \"\", stock: \"10\", is_active: true });\n      await refresh();\n    } catch (err) {\n      setError(errorMessage(err));\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function saveProduct(product: Product) {\n    const draft = drafts[product.id];\n    setBusy(true);\n    setError(null);\n    setFlash(null);\n    try {\n      const updated = await api<Product>(`/admin/products/${product.id}`, {\n        method: \"PATCH\",\n        body: {\n          price: Number(draft.price),\n          stock: Number(draft.stock),\n          is_active: draft.is_active,\n        },\n      });\n      setFlash(`Saved “${updated.name}”`);\n      await refresh();\n    } catch (err) {\n      setError(errorMessage(err));\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <section className=\"space-y-8\">\n      <div>\n        <h2 className=\"mb-4 text-xl font-semibold text-slate-900\">Add a product</h2>\n        <form\n          onSubmit={createProduct}\n          className=\"grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-2\"\n        >\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">Name</label>\n            <input\n              value={form.name}\n              onChange={(e) => setForm({ ...form, name: e.target.value })}\n              required\n              className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\"\n            />\n          </div>\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">Price</label>\n            <input\n              type=\"number\"\n              min=\"0\"\n              step=\"0.01\"\n              value={form.price}\n              onChange={(e) => setForm({ ...form, price: e.target.value })}\n              required\n              className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\"\n            />\n          </div>\n          <div className=\"md:col-span-2\">\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">Description</label>\n            <textarea\n              value={form.description}\n              onChange={(e) => setForm({ ...form, description: e.target.value })}\n              rows={2}\n              className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\"\n            />\n          </div>\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">Stock</label>\n            <input\n              type=\"number\"\n              min=\"0\"\n              step=\"1\"\n              value={form.stock}\n              onChange={(e) => setForm({ ...form, stock: e.target.value })}\n              required\n              className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\"\n            />\n          </div>\n          <div className=\"flex items-end\">\n            <label className=\"flex items-center gap-2 text-sm text-slate-700\">\n              <input\n                type=\"checkbox\"\n                checked={form.is_active}\n                onChange={(e) => setForm({ ...form, is_active: e.target.checked })}\n                className=\"h-4 w-4 rounded border-slate-300 text-indigo-600\"\n              />\n              Active (visible in the catalogue)\n            </label>\n          </div>\n          <div className=\"md:col-span-2\">\n            <button\n              type=\"submit\"\n              disabled={busy}\n              className=\"rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50\"\n            >\n              Add product\n            </button>\n          </div>\n        </form>\n      </div>\n\n      <div>\n        <h2 className=\"mb-4 text-xl font-semibold text-slate-900\">Edit products</h2>\n        {error && (\n          <p className=\"mb-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700\">{error}</p>\n        )}\n        {flash && (\n          <p className=\"mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700\">\n            {flash}\n          </p>\n        )}\n        <div className=\"overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm\">\n          <table className=\"w-full text-left text-sm\">\n            <thead>\n              <tr className=\"border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500\">\n                <th className=\"px-4 py-3\">Product</th>\n                <th className=\"px-4 py-3\">Price</th>\n                <th className=\"px-4 py-3\">Stock</th>\n                <th className=\"px-4 py-3\">Active</th>\n                <th className=\"px-4 py-3\" />\n              </tr>\n            </thead>\n            <tbody>\n              {products.map((product) => {\n                const draft = drafts[product.id] ?? draftOf(product);\n                return (\n                  <tr key={product.id} className=\"border-b border-slate-100 last:border-0\">\n                    <td className=\"px-4 py-3\">\n                      <p className=\"font-medium text-slate-900\">{product.name}</p>\n                      <p className=\"line-clamp-1 text-xs text-slate-500\">{product.description}</p>\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <input\n                        type=\"number\"\n                        min=\"0\"\n                        step=\"0.01\"\n                        value={draft.price}\n                        onChange={(e) => setDraft(product.id, { price: e.target.value })}\n                        className=\"w-24 rounded-lg border border-slate-300 px-2 py-1.5 text-sm outline-none focus:border-indigo-500\"\n                      />\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <input\n                        type=\"number\"\n                        min=\"0\"\n                        step=\"1\"\n                        value={draft.stock}\n                        onChange={(e) => setDraft(product.id, { stock: e.target.value })}\n                        className=\"w-20 rounded-lg border border-slate-300 px-2 py-1.5 text-sm outline-none focus:border-indigo-500\"\n                      />\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <input\n                        type=\"checkbox\"\n                        checked={draft.is_active}\n                        onChange={(e) =>\n                          setDraft(product.id, { is_active: e.target.checked })\n                        }\n                        aria-label={`${product.name} is active`}\n                        className=\"h-4 w-4 rounded border-slate-300 text-indigo-600\"\n                      />\n                    </td>\n                    <td className=\"px-4 py-3 text-right\">\n                      <button\n                        onClick={() => saveProduct(product)}\n                        disabled={busy}\n                        className=\"rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700 disabled:opacity-50\"\n                      >\n                        Save\n                      </button>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n        <p className=\"mt-2 text-xs text-slate-400\">\n          Current catalogue price is {money(0)}-based; prices shown in the store update\n          immediately after saving.\n        </p>\n      </div>\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AdminPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AdminPanel.tsx","time":{"start":1794380598854,"end":1794380598878}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c96b0e34001cfUFxqotv4KxzK","sessionID":"ses_e36a9edd3ffe2D97w6ZxQHahDz","messageID":"msg_1c96a997e001sD0fRaRMV31ZQc"}}
