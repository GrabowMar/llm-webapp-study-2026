{"type":"tool_use","timestamp":1794354744447,"sessionID":"ses_e382cb72effeBs8aZMlNgwK2bM","part":{"type":"tool","tool":"write","callID":"call_7d8ac62f4c7841468f82606f","state":{"status":"completed","input":{"content":"import { readdirSync } from \"node:fs\";\nimport { Window } from \"happy-dom\";\n\nconst assets = readdirSync(new URL(\"./dist/assets/\", import.meta.url));\nconst bundle = assets.find((f) => f.endsWith(\".js\"));\n\nconst window = new Window({ url: \"http://127.0.0.1:8000/\" });\nconst { document } = window;\ndocument.body.innerHTML = '<div id=\"root\"></div>';\n\nglobal.window = window;\nglobal.document = document;\nglobal.localStorage = window.localStorage;\nglobal.location = window.location;\nglobal.history = window.history;\nglobal.navigator = window.navigator;\nglobal.HTMLElement = window.HTMLElement;\nglobal.HTMLInputElement = window.HTMLInputElement;\nglobal.HTMLTextAreaElement = window.HTMLTextAreaElement;\nglobal.HTMLSelectElement = window.HTMLSelectElement;\nglobal.Element = window.Element;\nglobal.Node = window.Node;\nglobal.Event = window.Event;\nglobal.CustomEvent = window.CustomEvent;\nglobal.MutationObserver = window.MutationObserver;\nglobal.getComputedStyle = window.getComputedStyle.bind(window);\nglobal.requestAnimationFrame = (cb) => setTimeout(cb, 0);\nglobal.cancelAnimationFrame = (id) => clearTimeout(id);\nglobal.fetch = window.fetch.bind(window);\nglobal.Headers = window.Headers;\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nconst results = [];\nconst check = (name, cond, extra = \"\") => {\n  results.push([name, !!cond]);\n  console.log(`${cond ? \"PASS\" : \"FAIL\"} ${name}${cond ? \"\" : \" \" + extra}`);\n};\n\nfunction setValue(el, value) {\n  const proto = el instanceof window.HTMLTextAreaElement ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;\n  Object.getOwnPropertyDescriptor(proto, \"value\").set.call(el, value);\n  el.dispatchEvent(new window.Event(\"input\", { bubbles: true }));\n}\n\nfunction fireSubmit(form) {\n  form.dispatchEvent(new window.Event(\"submit\", { bubbles: true, cancelable: true }));\n}\n\nfunction click(el) {\n  el.dispatchEvent(new window.Event(\"click\", { bubbles: true, cancelable: true }));\n}\n\nfunction navigate(path) {\n  window.happyDOM.waitUntilComplete;\n  window.history.pushState({}, \"\", path);\n  window.dispatchEvent(new window.Event(\"popstate\"));\n}\n\nasync function waitFor(predicate, label, timeout = 8000) {\n  const start = Date.now();\n  while (Date.now() - start < timeout) {\n    const text = document.body.textContent || \"\";\n    if (predicate(text)) return true;\n    await sleep(50);\n  }\n  console.log(`TIMEOUT waiting for: ${label}`);\n  console.log((document.body.textContent || \"\").slice(0, 600));\n  return false;\n}\n\nawait import(`./dist/assets/${bundle}`);\nawait sleep(300);\n\n// 1. public stats page at /\nawait waitFor((t) => t.includes(\"Public status\"), \"public stats page\");\ncheck(\"public page renders\", (document.body.textContent || \"\").includes(\"Public status\"));\ncheck(\"public page shows severity counts\", [\"sev1\", \"sev2\", \"sev3\", \"sev4\"].every((s) => (document.body.textContent || \"\").includes(s)));\ncheck(\"public page shows breach figure\", (document.body.textContent || \"\").includes(\"Open past target\"));\ncheck(\"public page has no incident details\", !(document.body.textContent || \"\").includes(\"Cache miss storm\"));\n\n// 2. protected list redirects to login when signed out\nnavigate(\"/incidents\");\nawait waitFor((t) => t.includes(\"Sign in\"), \"redirect to login\");\ncheck(\"signed-out /incidents redirects to login\", (document.body.textContent || \"\").includes(\"Sign in to open and update incidents\"));\n\n// 3. register form shows API validation errors\nnavigate(\"/register\");\nawait waitFor((t) => t.includes(\"Register\"), \"register page\");\ncheck(\"register page renders\", (document.body.textContent || \"\").includes(\"Create an account for the operations team\"));\nconst regForm = document.querySelector(\"form\");\nsetValue(document.querySelector(\"#register-username\"), \"e2e_user\");\nsetValue(document.querySelector(\"#register-password\"), \"e2e_pass\");\nfireSubmit(regForm);\nconst signedIn = await waitFor((t) => t.includes(\"Signed in as e2e_user\"), \"auto sign-in after register\");\ncheck(\"register + auto sign-in works\", signedIn);\ncheck(\"lands on incident list\", (document.body.textContent || \"\").includes(\"Newest incidents first\"));\n\n// 4. list shows seeded incidents with breach flag, filters and paging\nconst hasList = await waitFor((t) => t.includes(\"Cache miss storm\"), \"list data\");\ncheck(\"list shows incidents\", hasList);\ncheck(\"list shows breach flag\", (document.body.textContent || \"\").includes(\"SLA breached\"));\ncheck(\"list has open only switch\", !!Array.from(document.querySelectorAll(\"label\")).find((l) => l.textContent.trim() === \"Open only\"));\n\nconst sevSelect = document.querySelector(\"#filter-severity\");\nObject.getOwnPropertyDescriptor(window.HTMLSelectElement.prototype, \"value\").set.call(sevSelect, \"sev3\");\nsevSelect.dispatchEvent(new window.Event(\"change\", { bubbles: true }));\nawait sleep(400);\ncheck(\"severity filter narrows list\", (document.body.textContent || \"\").includes(\"Cache miss storm\") && !(document.body.textContent || \"\").includes(\"Login errors\"));\n\nsetValue(document.querySelector(\"#filter-q\"), \"Login\");\nawait waitFor((t) => t.includes(\"Login errors\"), \"search results\");\ncheck(\"search box filters\", (document.body.textContent || \"\").includes(\"Login errors\"));\n\n// 5. open incident form shows API validation messages\nnavigate(\"/incidents/new\");\nawait waitFor((t) => t.includes(\"Open incident\"), \"open incident form\");\ncheck(\"open form renders\", !!document.querySelector(\"#incident-title\"));\nsetValue(document.querySelector(\"#incident-title\"), \"   \");\nsetValue(document.querySelector(\"#incident-service\"), \"payments\");\nfireSubmit(document.querySelector(\"form\"));\nawait sleep(500);\ncheck(\"open form shows API validation message\", (document.body.textContent || \"\").includes(\"title is required\"));\n\n// now submit a valid one\nsetValue(document.querySelector(\"#incident-title\"), \"E2E payments outage\");\nsetValue(document.querySelector(\"#incident-service\"), \"payments\");\nfireSubmit(document.querySelector(\"form\"));\nconst detailShown = await waitFor((t) => t.includes(\"E2E payments outage\") && t.includes(\"Timeline\"), \"incident detail page\");\ncheck(\"open incident navigates to detail\", detailShown);\ncheck(\"detail shows status buttons\", [\"investigating\", \"identified\", \"monitoring\", \"resolved\"].every((s) => (document.body.textContent || \"\").includes(s)));\ncheck(\"detail shows sla target field\", (document.body.textContent || \"\").includes(\"Resolution target\"));\n\n// 6. status change appends timeline event\nconst resolvedBtn = Array.from(document.querySelectorAll(\"button\")).find((b) => b.textContent.trim() === \"resolved\");\nclick(resolvedBtn);\nconst statusEvent = await waitFor((t) => t.includes(\"Status changed from investigating to resolved\"), \"status_change timeline event\");\ncheck(\"status change appends status_change event\", statusEvent);\ncheck(\"resolved_at shown\", (document.body.textContent || \"\").includes(\"Resolved at\"));\n\n// 7. post timeline event\nsetValue(document.querySelector(\"#event-message\"), \"Rollback deployed\");\nfireSubmit(document.querySelectorAll(\"form\")[document.querySelectorAll(\"form\").length - 1]);\nconst eventShown = await waitFor((t) => t.includes(\"Rollback deployed\"), \"posted timeline event\");\ncheck(\"posting timeline event works\", eventShown);\n\n// 8. sign out\nconst signOutBtn = Array.from(document.querySelectorAll(\"button\")).find((b) => b.textContent.trim() === \"Sign out\");\nclick(signOutBtn);\nawait sleep(300);\ncheck(\"sign out clears session\", (document.body.textContent || \"\").includes(\"Sign in\") && !(document.body.textContent || \"\").includes(\"Signed in as\"));\n\nconst failed = results.filter(([, ok]) => !ok);\nconsole.log(failed.length === 0 ? \"ALL UI CHECKS PASSED\" : `UI CHECK FAILURES: ${failed.map(([n]) => n).join(\", \")}`);\nprocess.exit(failed.length === 0 ? 0 : 1);\n","filePath":"/workspace/frontend/ui-smoke.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/ui-smoke.mjs","exists":false,"truncated":false},"title":"frontend/ui-smoke.mjs","time":{"start":1794354744421,"end":1794354744429}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7e08c5d0011wyTXXF489oEX7","sessionID":"ses_e382cb72effeBs8aZMlNgwK2bM","messageID":"msg_1c7e02320001XK4gvVsjrDmYIL"}}
