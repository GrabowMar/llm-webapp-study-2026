{"type":"step_start","timestamp":1794354393969,"sessionID":"ses_e382cb72effeBs8aZMlNgwK2bM","part":{"id":"prt_1c7db3363001UeaZgdXyMzgQXl","messageID":"msg_1c7daa7c8001r7N4MQSdN3MOih","sessionID":"ses_e382cb72effeBs8aZMlNgwK2bM","type":"step-start"}}
{"type":"tool_use","timestamp":1794354393994,"sessionID":"ses_e382cb72effeBs8aZMlNgwK2bM","part":{"type":"tool","tool":"write","callID":"call_bd3b7c8cfc4e40069ffd0cb7","state":{"status":"completed","input":{"content":"import json\nimport urllib.request\nimport urllib.error\n\nBASE = \"http://127.0.0.1:8000\"\nfails = []\n\n\ndef call(method, path, body=None, token=None, expect=None, label=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(req, data=data) as res:\n            status, payload = res.status, json.loads(res.read().decode() or \"null\")\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, json.loads(e.read().decode() or \"null\")\n    ok = expect is None or status == expect\n    tag = label or f\"{method} {path}\"\n    if ok:\n        print(f\"PASS {tag} -> {status}\")\n    else:\n        print(f\"FAIL {tag} -> {status} (expected {expect}) {payload}\")\n        fails.append(tag)\n    return status, payload\n\n\n# health\ncall(\"GET\", \"/api/health\", expect=200, label=\"health\")\n\n# auth: validation + register + duplicate\ncall(\"POST\", \"/api/auth/register\", {}, expect=400, label=\"register empty body fields\")\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"alice\"}, expect=400, label=\"register missing password\")\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret\"}, expect=201, label=\"register alice\")\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret\"}, expect=409, label=\"register duplicate\")\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"hunter2\"}, expect=201, label=\"register bob\")\n\n# login\ncall(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401, label=\"login wrong password\")\ncall(\"POST\", \"/api/auth/login\", {\"username\": \"nobody\", \"password\": \"x\"}, expect=401, label=\"login unknown user\")\n_, login = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret\"}, expect=200, label=\"login alice\")\ntok = login[\"token\"]\n_, login_bob = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"hunter2\"}, expect=200, label=\"login bob\")\ntok_bob = login_bob[\"token\"]\n\n# auth gating\ncall(\"GET\", \"/api/incidents\", expect=401, label=\"list without token\")\ncall(\"GET\", \"/api/incidents\", token=\"bogus\", expect=401, label=\"list bad token\")\ncall(\"POST\", \"/api/incidents\", {\"title\": \"x\", \"service\": \"y\", \"severity\": \"sev1\"}, expect=401, label=\"create without token\")\n\n# create incidents\ncall(\"POST\", \"/api/incidents\", {\"service\": \"s\", \"severity\": \"sev1\"}, token=tok, expect=400, label=\"create missing title\")\ncall(\"POST\", \"/api/incidents\", {\"title\": \"t\", \"service\": \"s\", \"severity\": \"sev9\"}, token=tok, expect=400, label=\"create bad severity\")\nst, inc1 = call(\n    \"POST\", \"/api/incidents\",\n    {\"title\": \"API latency\", \"service\": \"checkout\", \"severity\": \"sev1\", \"commander\": \"alice\", \"impact_summary\": \"checkout slow\"},\n    token=tok, expect=201, label=\"create inc1\",\n)\nassert inc1[\"status\"] == \"investigating\", inc1\nassert inc1[\"opened_by\"] == \"alice\", inc1\nassert inc1[\"resolved_at\"] is None and inc1[\"reopen_count\"] == 0\nassert inc1[\"sla_breached\"] is False\nfrom datetime import datetime, timedelta\n\ndue = datetime.fromisoformat(inc1[\"sla_due_at\"])\nopened = datetime.fromisoformat(inc1[\"opened_at\"])\nassert due - opened == timedelta(minutes=60), (opened, due)\nid1 = inc1[\"id\"]\n\n_, inc2 = call(\"POST\", \"/api/incidents\", {\"title\": \"Cache miss storm\", \"service\": \"catalog\", \"severity\": \"sev3\"},\n               token=tok_bob, expect=201, label=\"create inc2\")\nid2 = inc2[\"id\"]\nassert inc2[\"opened_by\"] == \"bob\"\nassert datetime.fromisoformat(inc2[\"sla_due_at\"]) - datetime.fromisoformat(inc2[\"opened_at\"]) == timedelta(minutes=1440)\n\n_, inc3 = call(\"POST\", \"/api/incidents\", {\"title\": \"Login errors\", \"service\": \"auth\", \"severity\": \"sev2\"},\n               token=tok, expect=201, label=\"create inc3\")\nid3 = inc3[\"id\"]\n\n# list + paging + filters\n_, page = call(\"GET\", \"/api/incidents\", token=tok, expect=200, label=\"list all\")\nassert page[\"total\"] == 3, page\nassert [i[\"id\"] for i in page[\"items\"]] == [id3, id2, id1], \"newest opened first\"\nassert page[\"page\"] == 1 and page[\"page_size\"] == 20\n\n_, page = call(\"GET\", \"/api/incidents?page=2&page_size=2\", token=tok, expect=200, label=\"list paging\")\nassert page[\"total\"] == 3 and len(page[\"items\"]) == 1 and page[\"page\"] == 2 and page[\"page_size\"] == 2\nassert page[\"items\"][0][\"id\"] == id1\n\ncall(\"GET\", \"/api/incidents?severity=sev2\", token=tok, expect=200, label=\"filter severity\")\n_, page = call(\"GET\", \"/api/incidents?severity=sev2\", token=tok, expect=200, label=\"filter severity2\")\nassert page[\"total\"] == 1 and page[\"items\"][0][\"id\"] == id3\ncall(\"GET\", \"/api/incidents?severity=bogus\", token=tok, expect=400, label=\"filter bad severity\")\ncall(\"GET\", \"/api/incidents?status=bogus\", token=tok, expect=400, label=\"filter bad status\")\ncall(\"GET\", \"/api/incidents?page=abc\", token=tok, expect=400, label=\"bad page\")\n_, page = call(\"GET\", \"/api/incidents?q=catalog\", token=tok, expect=200, label=\"search q\")\nassert page[\"total\"] == 1 and page[\"items\"][0][\"id\"] == id2\n_, page = call(\"GET\", \"/api/incidents?q=zzzznothing\", token=tok, expect=200, label=\"search q empty result\")\nassert page[\"total\"] == 0 and page[\"items\"] == []\n\n# detail\ncall(\"GET\", \"/api/incidents/999999\", token=tok, expect=404, label=\"detail missing\")\n_, got = call(\"GET\", f\"/api/incidents/{id1}\", token=tok, expect=200, label=\"detail ok\")\nassert got[\"title\"] == \"API latency\"\n\n# timeline: empty at first\n_, tl = call(\"GET\", f\"/api/incidents/{id1}/timeline\", token=tok, expect=200, label=\"timeline initial\")\nassert tl[\"items\"] == [], tl\n\n# post timeline event\ncall(\"POST\", f\"/api/incidents/{id1}/timeline\", {\"message\": \"\"}, token=tok, expect=400, label=\"timeline empty message\")\nst, ev = call(\"POST\", f\"/api/incidents/{id1}/timeline\", {\"message\": \"Investigating db pool\"}, token=tok, expect=201, label=\"timeline post\")\nassert ev[\"type\"] == \"note\" and ev[\"author\"] == \"alice\", ev\nst, ev2 = call(\"POST\", f\"/api/incidents/{id1}/timeline\", {\"message\": \"Scaled up\", \"type\": \"update\"}, token=tok_bob, expect=201, label=\"timeline post typed\")\nassert ev2[\"type\"] == \"update\" and ev2[\"author\"] == \"bob\"\n\n# posting event does not change status\n_, got = call(\"GET\", f\"/api/incidents/{id1}\", token=tok, expect=200, label=\"status unchanged after event\")\nassert got[\"status\"] == \"investigating\"\n\n# patch: only given fields\nst, got = call(\"PATCH\", f\"/api/incidents/{id1}\", {\"commander\": \"carol\"}, token=tok, expect=200, label=\"patch commander only\")\nassert got[\"commander\"] == \"carol\" and got[\"title\"] == \"API latency\" and got[\"severity\"] == \"sev1\"\n\n# patch status: event appended\n_, tl = call(\"GET\", f\"/api/incidents/{id1}/timeline\", token=tok, expect=200, label=\"timeline before status change\")\nassert len(tl[\"items\"]) == 2\nst, got = call(\"PATCH\", f\"/api/incidents/{id1}\", {\"status\": \"identified\"}, token=tok_bob, expect=200, label=\"patch status investigating->identified\")\nassert got[\"status\"] == \"identified\"\n_, tl = call(\"GET\", f\"/api/incidents/{id1}/timeline\", token=tok, expect=200, label=\"timeline after status change\")\nassert len(tl[\"items\"]) == 3\nlast = tl[\"items\"][-1]\nassert last[\"type\"] == \"status_change\" and \"investigating\" in last[\"message\"] and \"identified\" in last[\"message\"], last\nassert last[\"author\"] == \"bob\"\n# same status again -> no new event\ncall(\"PATCH\", f\"/api/incidents/{id1}\", {\"status\": \"identified\"}, token=tok, expect=200, label=\"patch same status\")\n_, tl = call(\"GET\", f\"/api/incidents/{id1}/timeline\", token=tok, expect=200, label=\"timeline unchanged\")\nassert len(tl[\"items\"]) == 3\n\n# resolve\nst, got = call(\"PATCH\", f\"/api/incidents/{id1}\", {\"status\": \"resolved\"}, token=tok, expect=200, label=\"patch resolved\")\nassert got[\"status\"] == \"resolved\" and got[\"resolved_at\"] is not None, got\nassert got[\"sla_breached\"] is False  # resolved before due\n\n# reopen -> resolved_at cleared, reopen_count incremented\nst, got = call(\"PATCH\", f\"/api/incidents/{id1}\", {\"status\": \"investigating\"}, token=tok, expect=200, label=\"patch reopen\")\nassert got[\"status\"] == \"investigating\" and got[\"resolved_at\"] is None, got\nassert got[\"reopen_count\"] == 1, got\n\n# severity change recomputes sla_due_at\nst, got = call(\"PATCH\", f\"/api/incidents/{id1}\", {\"severity\": \"sev4\"}, token=tok, expect=200, label=\"patch severity\")\ndue = datetime.fromisoformat(got[\"sla_due_at\"])\nopened = datetime.fromisoformat(got[\"opened_at\"])\nassert due - opened == timedelta(minutes=4320), (opened, due)\nassert got[\"severity\"] == \"sev4\"\n\n# validation on patch\ncall(\"PATCH\", f\"/api/incidents/{id1}\", {\"severity\": \"x\"}, token=tok, expect=400, label=\"patch bad severity\")\ncall(\"PATCH\", f\"/api/incidents/{id1}\", {\"status\": \"x\"}, token=tok, expect=400, label=\"patch bad status\")\ncall(\"PATCH\", f\"/api/incidents/{id1}\", {\"title\": \"  \"}, token=tok, expect=400, label=\"patch blank title\")\n\n# open filter semantics\n_, page = call(\"GET\", \"/api/incidents?open=true\", token=tok, expect=200, label=\"open=true\")\nassert all(i[\"status\"] != \"resolved\" for i in page[\"items\"]) and page[\"total\"] == 3\nst, got = call(\"PATCH\", f\"/api/incidents/{id2}\", {\"status\": \"resolved\"}, token=tok, expect=200, label=\"resolve inc2\")\n_, page = call(\"GET\", \"/api/incidents?open=true\", token=tok, expect=200, label=\"open=true after resolve\")\nassert page[\"total\"] == 2 and all(i[\"status\"] != \"resolved\" for i in page[\"items\"])\n_, page = call(\"GET\", \"/api/incidents?open=false\", token=tok, expect=200, label=\"open=false\")\nassert page[\"total\"] == 1 and all(i[\"status\"] == \"resolved\" for i in page[\"items\"])\n_, page = call(\"GET\", \"/api/incidents\", token=tok, expect=200, label=\"no open filter\")\nassert page[\"total\"] == 3\n\n# stats\ncall(\"GET\", \"/api/public/stats\", expect=200, label=\"stats public (no auth)\")\nst, stats = call(\"GET\", \"/api/public/stats\", expect=200, label=\"stats values\")\nassert stats[\"open_total\"] == 2, stats\nassert sum(stats[\"open_by_severity\"].values()) == 2\nassert set(stats[\"open_by_severity\"]) == {\"sev1\", \"sev2\", \"sev3\", \"sev4\"}\nassert isinstance(stats[\"sla_breached_open\"], int)\nassert stats[\"resolved_last_30_days\"] == 1, stats\n\n# breached: backdate inc3 (sev2, 240min) opened_at way past\ndb_path = \"/workspace/data/incidents.db\"\nimport sqlite3\ncon = sqlite3.connect(db_path)\ncon.execute(\"UPDATE incidents SET opened_at = ?, sla_due_at = ? WHERE id = ?\",\n            (\"2026-11-01T00:00:00+00:00\", \"2026-11-01T04:00:00+00:00\", id3))\ncon.commit(); con.close()\nst, got = call(\"GET\", f\"/api/incidents/{id3}\", token=tok, expect=200, label=\"backdated incident\")\nassert got[\"sla_breached\"] is True, got\nst, stats = call(\"GET\", \"/api/public/stats\", expect=200, label=\"stats after breach\")\nassert stats[\"sla_breached_open\"] == 1, stats\n_, page = call(\"GET\", \"/api/incidents?open=true\", token=tok, expect=200, label=\"breached flag in list\")\nassert any(i[\"sla_breached\"] for i in page[\"items\"])\n\n# resolved late -> breached\nst, got = call(\"PATCH\", f\"/api/incidents/{id3}\", {\"status\": \"resolved\"}, token=tok, expect=200, label=\"resolve late inc3\")\nassert got[\"sla_breached\"] is True, got\n\n# reopen cleared resolved_at -> still breached (unresolved past due)\nst, got = call(\"PATCH\", f\"/api/incidents/{id3}\", {\"status\": \"investigating\"}, token=tok, expect=200, label=\"reopen inc3\")\nassert got[\"sla_breached\"] is True, got\n\nprint()\nprint(\"FAILURES:\", fails if fails else \"none\")\n","filePath":"/workspace/.venv/smoke.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.venv/smoke.py","exists":false,"truncated":false},"title":".venv/smoke.py","time":{"start":1794354393963,"end":1794354393972}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7db3366001oRG7MfW5ncxRcQ","sessionID":"ses_e382cb72effeBs8aZMlNgwK2bM","messageID":"msg_1c7daa7c8001r7N4MQSdN3MOih"}}
