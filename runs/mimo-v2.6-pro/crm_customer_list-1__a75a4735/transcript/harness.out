{"type":"tool_use","timestamp":1794346939776,"sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","part":{"type":"tool","tool":"read","callID":"call_6fe213464b7f4626977447bb","state":{"status":"completed","input":{"filePath":"/workspace/backend/db.py"},"output":"<path>/workspace/backend/db.py</path>\n<type>file</type>\n<content>\n1: \"\"\"SQLite database helpers for the customer directory.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import sqlite3\n7: from pathlib import Path\n8: \n9: DATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\n10: DB_PATH = DATA_DIR / \"directory.db\"\n11: \n12: SCHEMA = \"\"\"\n13: CREATE TABLE IF NOT EXISTS users (\n14:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n15:     username TEXT NOT NULL UNIQUE,\n16:     password_hash TEXT NOT NULL,\n17:     created_at TEXT NOT NULL\n18: );\n19: \n20: CREATE TABLE IF NOT EXISTS tokens (\n21:     token TEXT PRIMARY KEY,\n22:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n23:     created_at TEXT NOT NULL\n24: );\n25: \n26: CREATE TABLE IF NOT EXISTS customers (\n27:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n28:     name TEXT NOT NULL,\n29:     email TEXT,\n30:     phone TEXT,\n31:     company TEXT,\n32:     notes TEXT,\n33:     created_at TEXT NOT NULL\n34: );\n35: \n36: CREATE UNIQUE INDEX IF NOT EXISTS idx_customers_email\n37:     ON customers(email COLLATE NOCASE) WHERE email IS NOT NULL;\n38: \n39: CREATE TABLE IF NOT EXISTS interactions (\n40:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n41:     customer_id INTEGER NOT NULL REFERENCES customers(id) ON DELETE CASCADE,\n42:     kind TEXT NOT NULL,\n43:     summary TEXT NOT NULL,\n44:     occurred_at TEXT NOT NULL,\n45:     occurred_epoch REAL NOT NULL,\n46:     logged_by TEXT NOT NULL,\n47:     created_at TEXT NOT NULL\n48: );\n49: \n50: CREATE INDEX IF NOT EXISTS idx_interactions_customer\n51:     ON interactions(customer_id, occurred_epoch);\n52: \"\"\"\n53: \n54: \n55: def get_db() -> sqlite3.Connection:\n56:     \"\"\"Return a connection to the application database.\"\"\"\n57:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n58:     conn = sqlite3.connect(DB_PATH, timeout=30)\n59:     conn.row_factory = sqlite3.Row\n60:     conn.execute(\"PRAGMA foreign_keys = ON\")\n61:     conn.execute(\"PRAGMA journal_mode = WAL\")\n62:     return conn\n63: \n64: \n65: def init_db() -> None:\n66:     \"\"\"Create the schema if it does not exist yet.\"\"\"\n67:     with get_db() as conn:\n68:         conn.executescript(SCHEMA)\n\n(End of file - total 68 lines)\n</content>","metadata":{"preview":"\"\"\"SQLite database helpers for the customer directory.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sqlite3\nfrom pathlib import Path\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\nDB_PATH = DATA_DIR / \"directory.db\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/db.py","text":"\"\"\"SQLite database helpers for the customer directory.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sqlite3\nfrom pathlib import Path\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\nDB_PATH = DATA_DIR / \"directory.db\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS customers (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    email TEXT,\n    phone TEXT,\n    company TEXT,\n    notes TEXT,\n    created_at TEXT NOT NULL\n);\n\nCREATE UNIQUE INDEX IF NOT EXISTS idx_customers_email\n    ON customers(email COLLATE NOCASE) WHERE email IS NOT NULL;\n\nCREATE TABLE IF NOT EXISTS interactions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    customer_id INTEGER NOT NULL REFERENCES customers(id) ON DELETE CASCADE,\n    kind TEXT NOT NULL,\n    summary TEXT NOT NULL,\n    occurred_at TEXT NOT NULL,\n    occurred_epoch REAL NOT NULL,\n    logged_by TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_interactions_customer\n    ON interactions(customer_id, occurred_epoch);\n\"\"\"\n\n\ndef get_db() -> sqlite3.Connection:\n    \"\"\"Return a connection to the application database.\"\"\"\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    return conn\n\n\ndef init_db() -> None:\n    \"\"\"Create the schema if it does not exist yet.\"\"\"\n    with get_db() as conn:\n        conn.executescript(SCHEMA)","lineStart":1,"lineEnd":68,"totalLines":68,"truncated":false}},"title":"backend/db.py","time":{"start":1794346939733,"end":1794346939754}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7697550001im3NmzIXm1SdWt","sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","messageID":"msg_1c7695ce90013pFnKKfn4w8ILe"}}
