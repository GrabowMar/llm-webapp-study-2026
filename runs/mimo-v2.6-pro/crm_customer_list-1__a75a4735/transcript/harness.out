 <Alert>{formError.message}</Alert> : null}\n92:           <Field label=\"Name\" error={formError?.fields.name}>\n93:             <TextInput\n94:               value={name}\n95:               onChange={(e) => setName(e.target.value)}\n96:               placeholder=\"Full name\"\n97:               required\n98:             />\n99:           </Field>\n100:           <div className=\"grid gap-5 sm:grid-cols-2\">\n101:             <Field label=\"Email\" error={formError?.fields.email}>\n102:               <TextInput\n103:                 type=\"email\"\n104:                 value={email}\n105:                 onChange={(e) => setEmail(e.target.value)}\n106:                 placeholder=\"name@example.com\"\n107:               />\n108:             </Field>\n109:             <Field label=\"Phone\" error={formError?.fields.phone}>\n110:               <TextInput\n111:                 value={phone}\n112:                 onChange={(e) => setPhone(e.target.value)}\n113:                 placeholder=\"+1 555 0100\"\n114:               />\n115:             </Field>\n116:           </div>\n117:           <Field label=\"Company\" error={formError?.fields.company}>\n118:             <TextInput\n119:               value={company}\n120:               onChange={(e) => setCompany(e.target.value)}\n121:               placeholder=\"Company name\"\n122:             />\n123:           </Field>\n124:           <Field label=\"Notes\" error={formError?.fields.notes}>\n125:             <TextArea\n126:               value={notes}\n127:               onChange={(e) => setNotes(e.target.value)}\n128:               placeholder=\"Anything the team should know about this customer\"\n129:             />\n130:           </Field>\n131:           <div className=\"flex items-center gap-3\">\n132:             <Button type=\"submit\" disabled={saving}>\n133:               {saving ? \"Saving…\" : editing ? \"Save changes\" : \"Add customer\"}\n134:             </Button>\n135:             <Button\n136:               type=\"button\"\n137:               variant=\"secondary\"\n138:               onClick={() => navigate(editing ? `/customers/${customerId}` : \"/customers\")}\n139:             >\n140:               Cancel\n141:             </Button>\n142:           </div>\n143:         </form>\n144:       </Card>\n145:     </div>\n146:   );\n147: }\n\n(End of file - total 147 lines)\n</content>","metadata":{"preview":"import { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ApiError, createCustomer, getCustomer, updateCustomer } from \"../api\";\nimport type { CustomerPayload } from \"../types\";\nimport { Alert, Button, Card, Field, Spinner, TextArea, TextInput } from \"../ui\";\n\nexport default function CustomerFormPage() {\n  const { id } = useParams();\n  const customerId = id ? Number(id) : null;\n  const editing = customerId !== null;\n  const navigate = useNavigate();\n\n  const [name, setName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [company, setCompany] = useState(\"\");\n  const [notes, setNotes] = useState(\"\");\n  const [loading, setLoading] = useState(editing);\n  const [loadError, setLoadError] = useState<string | null>(null);\n  const [saving, setSaving] = useState(false);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/pages/CustomerFormPage.tsx","text":"import { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ApiError, createCustomer, getCustomer, updateCustomer } from \"../api\";\nimport type { CustomerPayload } from \"../types\";\nimport { Alert, Button, Card, Field, Spinner, TextArea, TextInput } from \"../ui\";\n\nexport default function CustomerFormPage() {\n  const { id } = useParams();\n  const customerId = id ? Number(id) : null;\n  const editing = customerId !== null;\n  const navigate = useNavigate();\n\n  const [name, setName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [company, setCompany] = useState(\"\");\n  const [notes, setNotes] = useState(\"\");\n  const [loading, setLoading] = useState(editing);\n  const [loadError, setLoadError] = useState<string | null>(null);\n  const [saving, setSaving] = useState(false);\n  const [formError, setFormError] = useState<ApiError | null>(null);\n\n  useEffect(() => {\n    if (!editing) return;\n    let cancelled = false;\n    setLoading(true);\n    getCustomer(customerId)\n      .then((customer) => {\n        if (cancelled) return;\n        setName(customer.name);\n        setEmail(customer.email ?? \"\");\n        setPhone(customer.phone ?? \"\");\n        setCompany(customer.company ?? \"\");\n        setNotes(customer.notes ?? \"\");\n        setLoading(false);\n      })\n      .catch((err: unknown) => {\n        if (cancelled) return;\n        setLoadError(err instanceof Error ? err.message : \"Failed to load customer\");\n        setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [customerId, editing]);\n\n  async function handleSubmit(event: FormEvent) {\n    event.preventDefault();\n    setFormError(null);\n    setSaving(true);\n    const payload: CustomerPayload = {\n      name,\n      email: email.trim() || null,\n      phone: phone.trim() || null,\n      company: company.trim() || null,\n      notes: notes.trim() || null,\n    };\n    try {\n      const saved = editing\n        ? await updateCustomer(customerId, payload)\n        : await createCustomer(payload);\n      navigate(`/customers/${saved.id}`);\n    } catch (err) {\n      setFormError(err instanceof ApiError ? err : new ApiError(0, \"Saving failed\"));\n      setSaving(false);\n    }\n  }\n\n  if (loading) return <Spinner />;\n\n  return (\n    <div className=\"mx-auto max-w-2xl\">\n      <div className=\"mb-6\">\n        <Link to={editing ? `/customers/${customerId}` : \"/customers\"} className=\"text-sm text-indigo-600 hover:underline\">\n          &larr; Back\n        </Link>\n        <h1 className=\"mt-2 text-2xl font-bold text-slate-900\">\n          {editing ? \"Edit customer\" : \"Add customer\"}\n        </h1>\n        <p className=\"mt-1 text-sm text-slate-600\">\n          {editing\n            ? \"Update the customer's details. Fields left empty are cleared.\"\n            : \"Add a new customer to the shared directory. Only the name is required.\"}\n        </p>\n      </div>\n\n      {loadError ? <Alert>{loadError}</Alert> : null}\n\n      <Card>\n        <form onSubmit={handleSubmit} className=\"space-y-5\">\n          {formError ? <Alert>{formError.message}</Alert> : null}\n          <Field label=\"Name\" error={formError?.fields.name}>\n            <TextInput\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              placeholder=\"Full name\"\n              required\n            />\n          </Field>\n          <div className=\"grid gap-5 sm:grid-cols-2\">\n            <Field label=\"Email\" error={formError?.fields.email}>\n              <TextInput\n                type=\"email\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                placeholder=\"name@example.com\"\n              />\n            </Field>\n            <Field label=\"Phone\" error={formError?.fields.phone}>\n              <TextInput\n                value={phone}\n                onChange={(e) => setPhone(e.target.value)}\n                placeholder=\"+1 555 0100\"\n              />\n            </Field>\n          </div>\n          <Field label=\"Company\" error={formError?.fields.company}>\n            <TextInput\n              value={company}\n              onChange={(e) => setCompany(e.target.value)}\n              placeholder=\"Company name\"\n            />\n          </Field>\n          <Field label=\"Notes\" error={formError?.fields.notes}>\n            <TextArea\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              placeholder=\"Anything the team should know about this customer\"\n            />\n          </Field>\n          <div className=\"flex items-center gap-3\">\n            <Button type=\"submit\" disabled={saving}>\n              {saving ? \"Saving…\" : editing ? \"Save changes\" : \"Add customer\"}\n            </Button>\n            <Button\n              type=\"button\"\n              variant=\"secondary\"\n              onClick={() => navigate(editing ? `/customers/${customerId}` : \"/customers\")}\n            >\n              Cancel\n            </Button>\n          </div>\n        </form>\n      </Card>\n    </div>\n  );\n}","lineStart":1,"lineEnd":147,"totalLines":147,"truncated":false}},"title":"frontend/src/pages/CustomerFormPage.tsx","time":{"start":1794346933448,"end":1794346933466}},"id":"prt_1c7695cc4001Jp7H1Xrn6XzSKZ","sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","messageID":"msg_1c7693006001rJoJDszKD3VGr8"}}
