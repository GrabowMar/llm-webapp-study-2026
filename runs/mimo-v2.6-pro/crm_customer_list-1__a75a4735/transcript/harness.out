\"], values[\"company\"], values[\"notes\"], created_at),\n+        )\n+    except sqlite3.IntegrityError:\n+        duplicate = f\"Duplicate email: a customer with the email '{values['email']}' already exists.\"\n+        return error(400, duplicate, {\"email\": duplicate})\n     db.commit()\n     row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (cur.lastrowid,)).fetchone()\n finally:\n     db.close()\n","additions":8,"deletions":4},"truncated":false},"title":"backend/app.py","time":{"start":1794346747419,"end":1794346747468}},"id":"prt_1c7668617001zKMiSn2fTIZq8q","sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","messageID":"msg_1c76594e60010AemNvDipBUjIU"}}
