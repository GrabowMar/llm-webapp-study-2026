{"type":"tool_use","timestamp":1794346916666,"sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","part":{"type":"tool","tool":"read","callID":"call_ba6bf59fafb84df5a1835e92","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/auth.tsx"},"output":"<path>/workspace/frontend/src/auth.tsx</path>\n<type>file</type>\n<content>\n1: import {\n2:   createContext,\n3:   useCallback,\n4:   useContext,\n5:   useEffect,\n6:   useMemo,\n7:   useState,\n8:   type ReactNode,\n9: } from \"react\";\n10: import { Navigate, Outlet } from \"react-router-dom\";\n11: import { fetchMe, getToken, login, register, setToken } from \"./api\";\n12: \n13: interface AuthContextValue {\n14:   token: string | null;\n15:   username: string | null;\n16:   ready: boolean;\n17:   signIn: (username: string, password: string) => Promise<void>;\n18:   signUp: (username: string, password: string) => Promise<void>;\n19:   signOut: () => void;\n20: }\n21: \n22: const AuthContext = createContext<AuthContextValue | null>(null);\n23: \n24: export function AuthProvider({ children }: { children: ReactNode }) {\n25:   const [token, setTokenState] = useState<string | null>(() => getToken());\n26:   const [username, setUsername] = useState<string | null>(null);\n27:   const [ready, setReady] = useState(false);\n28: \n29:   useEffect(() => {\n30:     let cancelled = false;\n31:     if (!token) {\n32:       setUsername(null);\n33:       setReady(true);\n34:       return;\n35:     }\n36:     setReady(false);\n37:     fetchMe()\n38:       .then((user) => {\n39:         if (!cancelled) {\n40:           setUsername(user.username);\n41:           setReady(true);\n42:         }\n43:       })\n44:       .catch(() => {\n45:         if (!cancelled) {\n46:           setToken(null);\n47:           setTokenState(null);\n48:           setUsername(null);\n49:           setReady(true);\n50:         }\n51:       });\n52:     return () => {\n53:       cancelled = true;\n54:     };\n55:   }, [token]);\n56: \n57:   useEffect(() => {\n58:     const onExpired = () => {\n59:       setTokenState(null);\n60:       setUsername(null);\n61:     };\n62:     window.addEventListener(\"auth-expired\", onExpired);\n63:     return () => window.removeEventListener(\"auth-expired\", onExpired);\n64:   }, []);\n65: \n66:   const signIn = useCallback(async (name: string, password: string) => {\n67:     const { token: newToken } = await login(name, password);\n68:     setToken(newToken);\n69:     setTokenState(newToken);\n70:     setUsername(name);\n71:   }, []);\n72: \n73:   const signUp = useCallback(async (name: string, password: string) => {\n74:     const result = await register(name, password);\n75:     setToken(result.token);\n76:     setTokenState(result.token);\n77:     setUsername(result.username);\n78:   }, []);\n79: \n80:   const signOut = useCallback(() => {\n81:     setToken(null);\n82:     setTokenState(null);\n83:     setUsername(null);\n84:   }, []);\n85: \n86:   const value = useMemo(\n87:     () => ({ token, username, ready, signIn, signUp, signOut }),\n88:     [token, username, ready, signIn, signUp, signOut],\n89:   );\n90: \n91:   return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n92: }\n93: \n94: export function useAuth(): AuthContextValue {\n95:   const ctx = useContext(AuthContext);\n96:   if (!ctx) throw new Error(\"useAuth must be used inside AuthProvider\");\n97:   return ctx;\n98: }\n99: \n100: export function RequireAuth() {\n101:   const { token } = useAuth();\n102:   if (!token) return <Navigate to=\"/\" replace />;\n103:   return <Outlet />;\n104: }\n\n(End of file - total 104 lines)\n</content>","metadata":{"preview":"import {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useState,\n  type ReactNode,\n} from \"react\";\nimport { Navigate, Outlet } from \"react-router-dom\";\nimport { fetchMe, getToken, login, register, setToken } from \"./api\";\n\ninterface AuthContextValue {\n  token: string | null;\n  username: string | null;\n  ready: boolean;\n  signIn: (username: string, password: string) => Promise<void>;\n  signUp: (username: string, password: string) => Promise<void>;\n  signOut: () => void;\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/auth.tsx","text":"import {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useState,\n  type ReactNode,\n} from \"react\";\nimport { Navigate, Outlet } from \"react-router-dom\";\nimport { fetchMe, getToken, login, register, setToken } from \"./api\";\n\ninterface AuthContextValue {\n  token: string | null;\n  username: string | null;\n  ready: boolean;\n  signIn: (username: string, password: string) => Promise<void>;\n  signUp: (username: string, password: string) => Promise<void>;\n  signOut: () => void;\n}\n\nconst AuthContext = createContext<AuthContextValue | null>(null);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [token, setTokenState] = useState<string | null>(() => getToken());\n  const [username, setUsername] = useState<string | null>(null);\n  const [ready, setReady] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    if (!token) {\n      setUsername(null);\n      setReady(true);\n      return;\n    }\n    setReady(false);\n    fetchMe()\n      .then((user) => {\n        if (!cancelled) {\n          setUsername(user.username);\n          setReady(true);\n        }\n      })\n      .catch(() => {\n        if (!cancelled) {\n          setToken(null);\n          setTokenState(null);\n          setUsername(null);\n          setReady(true);\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [token]);\n\n  useEffect(() => {\n    const onExpired = () => {\n      setTokenState(null);\n      setUsername(null);\n    };\n    window.addEventListener(\"auth-expired\", onExpired);\n    return () => window.removeEventListener(\"auth-expired\", onExpired);\n  }, []);\n\n  const signIn = useCallback(async (name: string, password: string) => {\n    const { token: newToken } = await login(name, password);\n    setToken(newToken);\n    setTokenState(newToken);\n    setUsername(name);\n  }, []);\n\n  const signUp = useCallback(async (name: string, password: string) => {\n    const result = await register(name, password);\n    setToken(result.token);\n    setTokenState(result.token);\n    setUsername(result.username);\n  }, []);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setTokenState(null);\n    setUsername(null);\n  }, []);\n\n  const value = useMemo(\n    () => ({ token, username, ready, signIn, signUp, signOut }),\n    [token, username, ready, signIn, signUp, signOut],\n  );\n\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n}\n\nexport function useAuth(): AuthContextValue {\n  const ctx = useContext(AuthContext);\n  if (!ctx) throw new Error(\"useAuth must be used inside AuthProvider\");\n  return ctx;\n}\n\nexport function RequireAuth() {\n  const { token } = useAuth();\n  if (!token) return <Navigate to=\"/\" replace />;\n  return <Outlet />;\n}","lineStart":1,"lineEnd":104,"totalLines":104,"truncated":false}},"title":"frontend/src/auth.tsx","time":{"start":1794346916644,"end":1794346916660}},"id":"prt_1c7691b200015RgYviopFHA5qw","sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","messageID":"msg_1c768ffe4001OiT7RhcUe1ZAW1"}}
