{"type":"tool_use","timestamp":1794346685675,"sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","part":{"type":"tool","tool":"read","callID":"call_fc85767a6c9a4a238361e2a1","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Customer directory: Flask application serving the JSON API and the frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import re\n6: import secrets\n7: import sqlite3\n8: from datetime import datetime, timezone\n9: from functools import wraps\n10: from pathlib import Path\n11: from typing import Any, Callable\n12: \n13: from flask import Flask, g, jsonify, request, send_from_directory\n14: from werkzeug.security import check_password_hash, generate_password_hash\n15: \n16: from db import get_db, init_db\n17: \n18: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n19: \n20: INTERACTION_KINDS = {\"call\": \"call\", \"calls\": \"call\", \"email\": \"email\", \"emails\": \"email\",\n21:                      \"meeting\": \"meeting\", \"meetings\": \"meeting\"}\n22: EMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\n23: \n24: CUSTOMER_COLUMNS = (\"name\", \"email\", \"phone\", \"company\", \"notes\")\n25: \n26: app = Flask(__name__, static_folder=None)\n27: \n28: \n29: # --------------------------------------------------------------------------\n30: # helpers\n31: # --------------------------------------------------------------------------\n32: \n33: def now_utc() -> datetime:\n34:     return datetime.now(timezone.utc)\n35: \n36: \n37: def iso_z(dt: datetime) -> str:\n38:     return dt.isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n39: \n40: \n41: def error(status: int, message: str, fields: dict[str, str] | None = None):\n42:     body: dict[str, Any] = {\"error\": message, \"message\": message}\n43:     if fields:\n44:         body[\"errors\"] = fields\n45:     return jsonify(body), status\n46: \n47: \n48: def json_body() -> dict[str, Any]:\n49:     if not request.data:\n50:         return {}\n51:     data = request.get_json(silent=True)\n52:     if data is None:\n53:         raise BadRequest(\"Request body must be valid JSON\")\n54:     if not isinstance(data, dict):\n55:         raise BadRequest(\"Request body must be a JSON object\")\n56:     return data\n57: \n58: \n59: class BadRequest(Exception):\n60:     def __init__(self, message: str, fields: dict[str, str] | None = None):\n61:         super().__init__(message)\n62:         self.message = message\n63:         self.fields = fields\n64: \n65: \n66: @app.errorhandler(BadRequest)\n67: def handle_bad_request(exc: BadRequest):\n68:     return error(400, exc.message, exc.fields)\n69: \n70: \n71: @app.errorhandler(404)\n72: def handle_not_found(exc):\n73:     if request.path.startswith(\"/api/\"):\n74:         return error(404, \"Not found\")\n75:     return exc.get_response()\n76: \n77: \n78: def parse_datetime(raw: str) -> float:\n79:     \"\"\"Parse an ISO 8601 date-time and return its epoch seconds.\"\"\"\n80:     try:\n81:         dt = datetime.fromisoformat(raw.replace(\"Z\", \"+00:00\"))\n82:     except ValueError as exc:\n83:         raise BadRequest(\"occurred_at must be a valid ISO 8601 date and time\") from exc\n84:     if dt.tzinfo is None:\n85:         dt = dt.replace(tzinfo=timezone.utc)\n86:     return dt.timestamp()\n87: \n88: \n89: def clean_str(payload: dict[str, Any], key: str, fields: dict[str, str], required: bool = False) -> str | None:\n90:     \"\"\"Read an optional string field, normalising empty values to None.\"\"\"\n91:     value = payload.get(key)\n92:     if value is None:\n93:         if required:\n94:             fields[key] = f\"{key} is required\"\n95:         return None\n96:     if not isinstance(value, str):\n97:         fields[key] = f\"{key} must be a string\"\n98:         return None\n99:     value = value.strip()\n100:     if not value:\n101:         if required:\n102:             fields[key] = f\"{key} is required\"\n103:         return None\n104:     return value\n105: \n106: \n107: def customer_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n108:     return {\n109:         \"id\": row[\"id\"],\n110:         \"name\": row[\"name\"],\n111:         \"email\": row[\"email\"],\n112:         \"phone\": row[\"phone\"],\n113:         \"company\": row[\"company\"],\n114:         \"notes\": row[\"notes\"],\n115:         \"created_at\": row[\"created_at\"],\n116:         \"interaction_count\": row[\"interaction_count\"],\n117:         \"last_contacted_at\": row[\"last_contacted_at\"],\n118:     }\n119: \n120: \n121: def interaction_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n122:     return {\n123:         \"id\": row[\"id\"],\n124:         \"customer_id\": row[\"customer_id\"],\n125:         \"kind\": row[\"kind\"],\n126:         \"summary\": row[\"summary\"],\n127:         \"occurred_at\": row[\"occurred_at\"],\n128:         \"logged_by\": row[\"logged_by\"],\n129:     }\n130: \n131: \n132: CUSTOMER_SELECT = \"\"\"\n133: SELECT c.*,\n134:        (SELECT COUNT(*) FROM interactions i WHERE i.customer_id = c.id) AS interaction_count,\n135:        (SELECT i.occurred_at FROM interactions i WHERE i.customer_id = c.id\n136:         ORDER BY i.occurred_epoch DESC, i.id DESC LIMIT 1) AS last_contacted_at\n137: FROM customers c\n138: \"\"\"\n139: \n140: \n141: # --------------------------------------------------------------------------\n142: # authentication\n143: # --------------------------------------------------------------------------\n144: \n145: def current_user() -> sqlite3.Row | None:\n146:     auth = request.headers.get(\"Authorization\", \"\")\n147:     if not auth.startswith(\"Bearer \"):\n148:         return None\n149:     token = auth[len(\"Bearer \"):].strip()\n150:     if not token:\n151:         return None\n152:     db = get_db()\n153:     try:\n154:         return db.execute(\n155:             \"SELECT u.id, u.username FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n156:             (token,),\n157:         ).fetchone()\n158:     finally:\n159:         db.close()\n160: \n161: \n162: def login_required(view: Callable) -> Callable:\n163:     @wraps(view)\n164:     def wrapped(*args, **kwargs):\n165:         user = current_user()\n166:         if user is None:\n167:             return error(401, \"Authentication required\")\n168:         g.user = user\n169:         return view(*args, **kwargs)\n170: \n171:     return wrapped\n172: \n173: \n174: @app.post(\"/api/auth/register\")\n175: def register():\n176:     payload = json_body()\n177:     fields: dict[str, str] = {}\n178:     username = clean_str(payload, \"username\", fields, required=True)\n179:     password = payload.get(\"password\")\n180:     if not isinstance(password, str) or not password:\n181:         fields[\"password\"] = \"password is required\"\n182:     elif len(password) < 4:\n183:         fields[\"password\"] = \"password must be at least 4 characters\"\n184:     if fields:\n185:         return error(400, next(iter(fields.values())), fields)\n186:     assert username is not None and isinstance(password, str)\n187: \n188:     db = get_db()\n189:     try:\n190:         existing = db.execute(\"SELECT id FROM users WHERE username = ?\", (username,)).fetchone()\n191:         if existing:\n192:             message = f\"Duplicate username: an account with the username '{username}' already exists.\"\n193:             return error(400, message, {\"username\": message})\n194:         created_at = iso_z(now_utc())\n195:         cur = db.execute(\n196:             \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n197:             (username, generate_password_hash(password), created_at),\n198:         )\n199:         user_id = cur.lastrowid\n200:         token = secrets.token_urlsafe(32)\n201:         db.execute(\"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\", (token, user_id, created_at))\n202:         db.commit()\n203:     finally:\n204:         db.close()\n205:     return jsonify({\"id\": user_id, \"username\": username, \"token\": token}), 201\n206: \n207: \n208: @app.post(\"/api/auth/login\")\n209: def login():\n210:     payload = json_body()\n211:     fields: dict[str, str] = {}\n212:     username = clean_str(payload, \"username\", fields, required=True)\n213:     password = payload.get(\"password\")\n214:     if not isinstance(password, str) or not password:\n215:         fields[\"password\"] = \"password is required\"\n216:     if fields:\n217:         return error(400, next(iter(fields.values())), fields)\n218:     assert username is not None and isinstance(password, str)\n219: \n220:     db = get_db()\n221:     try:\n222:         user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n223:         if user is None or not check_password_hash(user[\"password_hash\"], password):\n224:             return error(401, \"Invalid username or password\")\n225:         token = secrets.token_urlsafe(32)\n226:         db.execute(\"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\", (token, user[\"id\"], iso_z(now_utc())))\n227:         db.commit()\n228:     finally:\n229:         db.close()\n230:     return jsonify({\"token\": token}), 200\n231: \n232: \n233: @app.get(\"/api/auth/me\")\n234: @login_required\n235: def me():\n236:     return jsonify({\"id\": g.user[\"id\"], \"username\": g.user[\"username\"]})\n237: \n238: \n239: # --------------------------------------------------------------------------\n240: # customers\n241: # --------------------------------------------------------------------------\n242: \n243: def read_customer_fields(payload: dict[str, Any]) -> dict[str, str | None]:\n244:     fields: dict[str, str] = {}\n245:     name = clean_str(payload, \"name\", fields, required=True)\n246:     values = {\"name\": name}\n247:     for key in (\"email\", \"phone\", \"company\", \"notes\"):\n248:         values[key] = clean_str(payload, key, fields)\n249:     email = values[\"email\"]\n250:     if email is not None and not EMAIL_RE.match(email):\n251:         fields[\"email\"] = \"email must be a valid email address\"\n252:     if fields:\n253:         raise BadRequest(next(iter(fields.values())), fields)\n254:     return values\n255: \n256: \n257: def find_customer_or_404(customer_id: int) -> sqlite3.Row:\n258:     db = get_db()\n259:     try:\n260:         row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (customer_id,)).fetchone()\n261:     finally:\n262:         db.close()\n263:     if row is None:\n264:         raise NotFound(f\"Customer {customer_id} not found\")\n265:     return row\n266: \n267: \n268: class NotFound(Exception):\n269:     pass\n270: \n271: \n272: @app.errorhandler(NotFound)\n273: def handle_customer_missing(exc: NotFound):\n274:     return error(404, str(exc))\n275: \n276: \n277: def check_email_available(db: sqlite3.Connection, email: str | None, exclude_id: int | None = None) -> str | None:\n278:     if email is None:\n279:         return None\n280:     query = \"SELECT id FROM customers WHERE email = ? COLLATE NOCASE\"\n281:     params: list[Any] = [email]\n282:     if exclude_id is not None:\n283:         query += \" AND id != ?\"\n284:         params.append(exclude_id)\n285:     if db.execute(query, params).fetchone() is not None:\n286:         return f\"Duplicate email: a customer with the email '{email}' already exists.\"\n287:     return None\n288: \n289: \n290: @app.get(\"/api/customers\")\n291: @login_required\n292: def list_customers():\n293:     fields: dict[str, str] = {}\n294: \n295:     def int_arg(name: str, default: int) -> int:\n296:         raw = request.args.get(name)\n297:         if raw is None or raw == \"\":\n298:             return default\n299:         try:\n300:             value = int(raw)\n301:         except ValueError:\n302:             fields[name] = f\"{name} must be an integer\"\n303:             return default\n304:         if value < 1:\n305:             fields[name] = f\"{name} must be at least 1\"\n306:             return default\n307:         return value\n308: \n309:     page = int_arg(\"page\", 1)\n310:     page_size = int_arg(\"page_size\", 20)\n311:     if fields:\n312:         return error(400, next(iter(fields.values())), fields)\n313: \n314:     q = (request.args.get(\"q\") or \"\").strip()\n315:     company = (request.args.get(\"company\") or \"\").strip()\n316: \n317:     where = []\n318:     params: list[Any] = []\n319:     if q:\n320:         like = \"%\" + re.sub(r\"([\\\\%_])\", r\"\\\\\\1\", q) + \"%\"\n321:         where.append(\n322:             r\"(c.name LIKE ? ESCAPE '\\'\"\n323:             r\" OR c.email LIKE ? ESCAPE '\\'\"\n324:             r\" OR c.phone LIKE ? ESCAPE '\\'\"\n325:             r\" OR c.company LIKE ? ESCAPE '\\'\"\n326:             r\" OR c.notes LIKE ? ESCAPE '\\')\"\n327:         )\n328:         params.extend([like] * 5)\n329:     if company:\n330:         where.append(\"c.company = ? COLLATE NOCASE\")\n331:         params.append(company)\n332: \n333:     clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n334: \n335:     db = get_db()\n336:     try:\n337:         total = db.execute(\"SELECT COUNT(*) AS n FROM customers c\" + clause, params).fetchone()[\"n\"]\n338:         rows = db.execute(\n339:             CUSTOMER_SELECT + clause + \" ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n340:             params + [page_size, (page - 1) * page_size],\n341:         ).fetchall()\n342:     finally:\n343:         db.close()\n344:     return jsonify({\n345:         \"items\": [customer_to_dict(r) for r in rows],\n346:         \"total\": total,\n347:         \"page\": page,\n348:         \"page_size\": page_size,\n349:     })\n350: \n351: \n352: @app.post(\"/api/customers\")\n353: @login_required\n354: def create_customer():\n355:     try:\n356:         values = read_customer_fields(json_body())\n357:     except BadRequest as exc:\n358:         return error(400, exc.message, exc.fields)\n359: \n360:     db = get_db()\n361:     try:\n362:         duplicate = check_email_available(db, values[\"email\"])\n363:         if duplicate:\n364:             return error(400, duplicate, {\"email\": duplicate})\n365:         created_at = iso_z(now_utc())\n366:         cur = db.execute(\n367:             \"INSERT INTO customers (name, email, phone, company, notes, created_at) VALUES (?, ?, ?, ?, ?, ?)\",\n368:             (values[\"name\"], values[\"email\"], values[\"phone\"], values[\"company\"], values[\"notes\"], created_at),\n369:         )\n370:         db.commit()\n371:         row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (cur.lastrowid,)).fetchone()\n372:     finally:\n373:         db.close()\n374:     return jsonify(customer_to_dict(row)), 201\n375: \n376: \n377: @app.get(\"/api/customers/<int:customer_id>\")\n378: @login_required\n379: def get_customer(customer_id: int):\n380:     return jsonify(customer_to_dict(find_customer_or_404(customer_id)))\n381: \n382: \n383: @app.put(\"/api/customers/<int:customer_id>\")\n384: @login_required\n385: def replace_customer(customer_id: int):\n386:     find_customer_or_404(customer_id)\n387:     try:\n388:         values = read_customer_fields(json_body())\n389:     except BadRequest as exc:\n390:         return error(400, exc.message, exc.fields)\n391: \n392:     db = get_db()\n393:     try:\n394:         duplicate = check_email_available(db, values[\"email\"], exclude_id=customer_id)\n395:         if duplicate:\n396:             return error(400, duplicate, {\"email\": duplicate})\n397:         db.execute(\n398:             \"UPDATE customers SET name = ?, email = ?, phone = ?, company = ?, notes = ? WHERE id = ?\",\n399:             (values[\"name\"], values[\"email\"], values[\"phone\"], values[\"company\"], values[\"notes\"], customer_id),\n400:         )\n401:         db.commit()\n402:         row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (customer_id,)).fetchone()\n403:     finally:\n404:         db.close()\n405:     return jsonify(customer_to_dict(row))\n406: \n407: \n408: @app.delete(\"/api/customers/<int:customer_id>\")\n409: @login_required\n410: def delete_customer(customer_id: int):\n411:     find_customer_or_404(customer_id)\n412:     db = get_db()\n413:     try:\n414:         db.execute(\"DELETE FROM interactions WHERE customer_id = ?\", (customer_id,))\n415:         db.execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n416:         db.commit()\n417:     finally:\n418:         db.close()\n419:     return \"\", 204\n420: \n421: \n422: # --------------------------------------------------------------------------\n423: # interactions\n424: # --------------------------------------------------------------------------\n425: \n426: @app.get(\"/api/customers/<int:customer_id>/interactions\")\n427: @login_required\n428: def list_interactions(customer_id: int):\n429:     find_customer_or_404(customer_id)\n430:     db = get_db()\n431:     try:\n432:         rows = db.execute(\n433:             \"SELECT * FROM interactions WHERE customer_id = ? ORDER BY occurred_epoch DESC, id DESC\",\n434:             (customer_id,),\n435:         ).fetchall()\n436:     finally:\n437:         db.close()\n438:     return jsonify({\"items\": [interaction_to_dict(r) for r in rows]})\n439: \n440: \n441: @app.post(\"/api/customers/<int:customer_id>/interactions\")\n442: @login_required\n443: def create_interaction(customer_id: int):\n444:     find_customer_or_404(customer_id)\n445:     payload = json_body()\n446:     fields: dict[str, str] = {}\n447: \n448:     kind_raw = clean_str(payload, \"kind\", fields, required=True)\n449:     kind = INTERACTION_KINDS.get(kind_raw.lower()) if kind_raw else None\n450:     if kind_raw and kind is None:\n451:         fields[\"kind\"] = \"kind must be one of: call, email, meeting\"\n452: \n453:     summary = clean_str(payload, \"summary\", fields, required=True)\n454: \n455:     occurred_raw = payload.get(\"occurred_at\")\n456:     occurred_at: str\n457:     occurred_epoch: float\n458:     if occurred_raw is None or occurred_raw == \"\":\n459:         occurred_at = iso_z(now_utc())\n460:         occurred_epoch = parse_datetime(occurred_at)\n461:     elif isinstance(occurred_raw, str):\n462:         occurred_at = occurred_raw.strip()\n463:         occurred_epoch = parse_datetime(occurred_at)\n464:     else:\n465:         fields[\"occurred_at\"] = \"occurred_at must be a valid ISO 8601 date and time\"\n466: \n467:     if fields:\n468:         return error(400, next(iter(fields.values())), fields)\n469: \n470:     db = get_db()\n471:     try:\n472:         cur = db.execute(\n473:             \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, occurred_epoch, logged_by, created_at)\"\n474:             \" VALUES (?, ?, ?, ?, ?, ?, ?)\",\n475:             (customer_id, kind, summary, occurred_at, occurred_epoch, g.user[\"username\"], iso_z(now_utc())),\n476:         )\n477:         db.commit()\n478:         row = db.execute(\"SELECT * FROM interactions WHERE id = ?\", (cur.lastrowid,)).fetchone()\n479:     finally:\n480:         db.close()\n481:     return jsonify(interaction_to_dict(row)), 201\n482: \n483: \n484: # --------------------------------------------------------------------------\n485: # health & frontend\n486: # --------------------------------------------------------------------------\n487: \n488: @app.get(\"/api/health\")\n489: def health():\n490:     return {\"status\": \"ok\"}\n491: \n492: \n493: @app.get(\"/\")\n494: @app.get(\"/<path:path>\")\n495: def frontend(path: str = \"index.html\"):\n496:     if path.startswith(\"api/\"):\n497:         return error(404, \"Not found\")\n498:     if (DIST / path).is_file():\n499:         return send_from_directory(DIST, path)\n500:     return send_from_directory(DIST, \"index.html\")\n501: \n502: \n503: init_db()\n504: \n505: if __name__ == \"__main__\":\n506:     app.run(host=\"127.0.0.1\", port=8000, debug=True)\n\n(End of file - total 506 lines)\n</content>","metadata":{"preview":"\"\"\"Customer directory: Flask application serving the JSON API and the frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import get_db, init_db\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nINTERACTION_KINDS = {\"call\": \"call\", \"calls\": \"call\", \"email\": \"email\", \"emails\": \"email\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Customer directory: Flask application serving the JSON API and the frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import get_db, init_db\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nINTERACTION_KINDS = {\"call\": \"call\", \"calls\": \"call\", \"email\": \"email\", \"emails\": \"email\",\n                     \"meeting\": \"meeting\", \"meetings\": \"meeting\"}\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\n\nCUSTOMER_COLUMNS = (\"name\", \"email\", \"phone\", \"company\", \"notes\")\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\n\ndef now_utc() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso_z(dt: datetime) -> str:\n    return dt.isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef error(status: int, message: str, fields: dict[str, str] | None = None):\n    body: dict[str, Any] = {\"error\": message, \"message\": message}\n    if fields:\n        body[\"errors\"] = fields\n    return jsonify(body), status\n\n\ndef json_body() -> dict[str, Any]:\n    if not request.data:\n        return {}\n    data = request.get_json(silent=True)\n    if data is None:\n        raise BadRequest(\"Request body must be valid JSON\")\n    if not isinstance(data, dict):\n        raise BadRequest(\"Request body must be a JSON object\")\n    return data\n\n\nclass BadRequest(Exception):\n    def __init__(self, message: str, fields: dict[str, str] | None = None):\n        super().__init__(message)\n        self.message = message\n        self.fields = fields\n\n\n@app.errorhandler(BadRequest)\ndef handle_bad_request(exc: BadRequest):\n    return error(400, exc.message, exc.fields)\n\n\n@app.errorhandler(404)\ndef handle_not_found(exc):\n    if request.path.startswith(\"/api/\"):\n        return error(404, \"Not found\")\n    return exc.get_response()\n\n\ndef parse_datetime(raw: str) -> float:\n    \"\"\"Parse an ISO 8601 date-time and return its epoch seconds.\"\"\"\n    try:\n        dt = datetime.fromisoformat(raw.replace(\"Z\", \"+00:00\"))\n    except ValueError as exc:\n        raise BadRequest(\"occurred_at must be a valid ISO 8601 date and time\") from exc\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt.timestamp()\n\n\ndef clean_str(payload: dict[str, Any], key: str, fields: dict[str, str], required: bool = False) -> str | None:\n    \"\"\"Read an optional string field, normalising empty values to None.\"\"\"\n    value = payload.get(key)\n    if value is None:\n        if required:\n            fields[key] = f\"{key} is required\"\n        return None\n    if not isinstance(value, str):\n        fields[key] = f\"{key} must be a string\"\n        return None\n    value = value.strip()\n    if not value:\n        if required:\n            fields[key] = f\"{key} is required\"\n        return None\n    return value\n\n\ndef customer_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"email\": row[\"email\"],\n        \"phone\": row[\"phone\"],\n        \"company\": row[\"company\"],\n        \"notes\": row[\"notes\"],\n        \"created_at\": row[\"created_at\"],\n        \"interaction_count\": row[\"interaction_count\"],\n        \"last_contacted_at\": row[\"last_contacted_at\"],\n    }\n\n\ndef interaction_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"customer_id\": row[\"customer_id\"],\n        \"kind\": row[\"kind\"],\n        \"summary\": row[\"summary\"],\n        \"occurred_at\": row[\"occurred_at\"],\n        \"logged_by\": row[\"logged_by\"],\n    }\n\n\nCUSTOMER_SELECT = \"\"\"\nSELECT c.*,\n       (SELECT COUNT(*) FROM interactions i WHERE i.customer_id = c.id) AS interaction_count,\n       (SELECT i.occurred_at FROM interactions i WHERE i.customer_id = c.id\n        ORDER BY i.occurred_epoch DESC, i.id DESC LIMIT 1) AS last_contacted_at\nFROM customers c\n\"\"\"\n\n\n# --------------------------------------------------------------------------\n# authentication\n# --------------------------------------------------------------------------\n\ndef current_user() -> sqlite3.Row | None:\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    try:\n        return db.execute(\n            \"SELECT u.id, u.username FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n            (token,),\n        ).fetchone()\n    finally:\n        db.close()\n\n\ndef login_required(view: Callable) -> Callable:\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(401, \"Authentication required\")\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    payload = json_body()\n    fields: dict[str, str] = {}\n    username = clean_str(payload, \"username\", fields, required=True)\n    password = payload.get(\"password\")\n    if not isinstance(password, str) or not password:\n        fields[\"password\"] = \"password is required\"\n    elif len(password) < 4:\n        fields[\"password\"] = \"password must be at least 4 characters\"\n    if fields:\n        return error(400, next(iter(fields.values())), fields)\n    assert username is not None and isinstance(password, str)\n\n    db = get_db()\n    try:\n        existing = db.execute(\"SELECT id FROM users WHERE username = ?\", (username,)).fetchone()\n        if existing:\n            message = f\"Duplicate username: an account with the username '{username}' already exists.\"\n            return error(400, message, {\"username\": message})\n        created_at = iso_z(now_utc())\n        cur = db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), created_at),\n        )\n        user_id = cur.lastrowid\n        token = secrets.token_urlsafe(32)\n        db.execute(\"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\", (token, user_id, created_at))\n        db.commit()\n    finally:\n        db.close()\n    return jsonify({\"id\": user_id, \"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    payload = json_body()\n    fields: dict[str, str] = {}\n    username = clean_str(payload, \"username\", fields, required=True)\n    password = payload.get(\"password\")\n    if not isinstance(password, str) or not password:\n        fields[\"password\"] = \"password is required\"\n    if fields:\n        return error(400, next(iter(fields.values())), fields)\n    assert username is not None and isinstance(password, str)\n\n    db = get_db()\n    try:\n        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n        if user is None or not check_password_hash(user[\"password_hash\"], password):\n            return error(401, \"Invalid username or password\")\n        token = secrets.token_urlsafe(32)\n        db.execute(\"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\", (token, user[\"id\"], iso_z(now_utc())))\n        db.commit()\n    finally:\n        db.close()\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return jsonify({\"id\": g.user[\"id\"], \"username\": g.user[\"username\"]})\n\n\n# --------------------------------------------------------------------------\n# customers\n# --------------------------------------------------------------------------\n\ndef read_customer_fields(payload: dict[str, Any]) -> dict[str, str | None]:\n    fields: dict[str, str] = {}\n    name = clean_str(payload, \"name\", fields, required=True)\n    values = {\"name\": name}\n    for key in (\"email\", \"phone\", \"company\", \"notes\"):\n        values[key] = clean_str(payload, key, fields)\n    email = values[\"email\"]\n    if email is not None and not EMAIL_RE.match(email):\n        fields[\"email\"] = \"email must be a valid email address\"\n    if fields:\n        raise BadRequest(next(iter(fields.values())), fields)\n    return values\n\n\ndef find_customer_or_404(customer_id: int) -> sqlite3.Row:\n    db = get_db()\n    try:\n        row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (customer_id,)).fetchone()\n    finally:\n        db.close()\n    if row is None:\n        raise NotFound(f\"Customer {customer_id} not found\")\n    return row\n\n\nclass NotFound(Exception):\n    pass\n\n\n@app.errorhandler(NotFound)\ndef handle_customer_missing(exc: NotFound):\n    return error(404, str(exc))\n\n\ndef check_email_available(db: sqlite3.Connection, email: str | None, exclude_id: int | None = None) -> str | None:\n    if email is None:\n        return None\n    query = \"SELECT id FROM customers WHERE email = ? COLLATE NOCASE\"\n    params: list[Any] = [email]\n    if exclude_id is not None:\n        query += \" AND id != ?\"\n        params.append(exclude_id)\n    if db.execute(query, params).fetchone() is not None:\n        return f\"Duplicate email: a customer with the email '{email}' already exists.\"\n    return None\n\n\n@app.get(\"/api/customers\")\n@login_required\ndef list_customers():\n    fields: dict[str, str] = {}\n\n    def int_arg(name: str, default: int) -> int:\n        raw = request.args.get(name)\n        if raw is None or raw == \"\":\n            return default\n        try:\n            value = int(raw)\n        except ValueError:\n            fields[name] = f\"{name} must be an integer\"\n            return default\n        if value < 1:\n            fields[name] = f\"{name} must be at least 1\"\n            return default\n        return value\n\n    page = int_arg(\"page\", 1)\n    page_size = int_arg(\"page_size\", 20)\n    if fields:\n        return error(400, next(iter(fields.values())), fields)\n\n    q = (request.args.get(\"q\") or \"\").strip()\n    company = (request.args.get(\"company\") or \"\").strip()\n\n    where = []\n    params: list[Any] = []\n    if q:\n        like = \"%\" + re.sub(r\"([\\\\%_])\", r\"\\\\\\1\", q) + \"%\"\n        where.append(\n            r\"(c.name LIKE ? ESCAPE '\\'\"\n            r\" OR c.email LIKE ? ESCAPE '\\'\"\n            r\" OR c.phone LIKE ? ESCAPE '\\'\"\n            r\" OR c.company LIKE ? ESCAPE '\\'\"\n            r\" OR c.notes LIKE ? ESCAPE '\\')\"\n        )\n        params.extend([like] * 5)\n    if company:\n        where.append(\"c.company = ? COLLATE NOCASE\")\n        params.append(company)\n\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    db = get_db()\n    try:\n        total = db.execute(\"SELECT COUNT(*) AS n FROM customers c\" + clause, params).fetchone()[\"n\"]\n        rows = db.execute(\n            CUSTOMER_SELECT + clause + \" ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n            params + [page_size, (page - 1) * page_size],\n        ).fetchall()\n    finally:\n        db.close()\n    return jsonify({\n        \"items\": [customer_to_dict(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    })\n\n\n@app.post(\"/api/customers\")\n@login_required\ndef create_customer():\n    try:\n        values = read_customer_fields(json_body())\n    except BadRequest as exc:\n        return error(400, exc.message, exc.fields)\n\n    db = get_db()\n    try:\n        duplicate = check_email_available(db, values[\"email\"])\n        if duplicate:\n            return error(400, duplicate, {\"email\": duplicate})\n        created_at = iso_z(now_utc())\n        cur = db.execute(\n            \"INSERT INTO customers (name, email, phone, company, notes, created_at) VALUES (?, ?, ?, ?, ?, ?)\",\n            (values[\"name\"], values[\"email\"], values[\"phone\"], values[\"company\"], values[\"notes\"], created_at),\n        )\n        db.commit()\n        row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (cur.lastrowid,)).fetchone()\n    finally:\n        db.close()\n    return jsonify(customer_to_dict(row)), 201\n\n\n@app.get(\"/api/customers/<int:customer_id>\")\n@login_required\ndef get_customer(customer_id: int):\n    return jsonify(customer_to_dict(find_customer_or_404(customer_id)))\n\n\n@app.put(\"/api/customers/<int:customer_id>\")\n@login_required\ndef replace_customer(customer_id: int):\n    find_customer_or_404(customer_id)\n    try:\n        values = read_customer_fields(json_body())\n    except BadRequest as exc:\n        return error(400, exc.message, exc.fields)\n\n    db = get_db()\n    try:\n        duplicate = check_email_available(db, values[\"email\"], exclude_id=customer_id)\n        if duplicate:\n            return error(400, duplicate, {\"email\": duplicate})\n        db.execute(\n            \"UPDATE customers SET name = ?, email = ?, phone = ?, company = ?, notes = ? WHERE id = ?\",\n            (values[\"name\"], values[\"email\"], values[\"phone\"], values[\"company\"], values[\"notes\"], customer_id),\n        )\n        db.commit()\n        row = db.execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (customer_id,)).fetchone()\n    finally:\n        db.close()\n    return jsonify(customer_to_dict(row))\n\n\n@app.delete(\"/api/customers/<int:customer_id>\")\n@login_required\ndef delete_customer(customer_id: int):\n    find_customer_or_404(customer_id)\n    db = get_db()\n    try:\n        db.execute(\"DELETE FROM interactions WHERE customer_id = ?\", (customer_id,))\n        db.execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n        db.commit()\n    finally:\n        db.close()\n    return \"\", 204\n\n\n# --------------------------------------------------------------------------\n# interactions\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/customers/<int:customer_id>/interactions\")\n@login_required\ndef list_interactions(customer_id: int):\n    find_customer_or_404(customer_id)\n    db = get_db()\n    try:\n        rows = db.execute(\n            \"SELECT * FROM interactions WHERE customer_id = ? ORDER BY occurred_epoch DESC, id DESC\",\n            (customer_id,),\n        ).fetchall()\n    finally:\n        db.close()\n    return jsonify({\"items\": [interaction_to_dict(r) for r in rows]})\n\n\n@app.post(\"/api/customers/<int:customer_id>/interactions\")\n@login_required\ndef create_interaction(customer_id: int):\n    find_customer_or_404(customer_id)\n    payload = json_body()\n    fields: dict[str, str] = {}\n\n    kind_raw = clean_str(payload, \"kind\", fields, required=True)\n    kind = INTERACTION_KINDS.get(kind_raw.lower()) if kind_raw else None\n    if kind_raw and kind is None:\n        fields[\"kind\"] = \"kind must be one of: call, email, meeting\"\n\n    summary = clean_str(payload, \"summary\", fields, required=True)\n\n    occurred_raw = payload.get(\"occurred_at\")\n    occurred_at: str\n    occurred_epoch: float\n    if occurred_raw is None or occurred_raw == \"\":\n        occurred_at = iso_z(now_utc())\n        occurred_epoch = parse_datetime(occurred_at)\n    elif isinstance(occurred_raw, str):\n        occurred_at = occurred_raw.strip()\n        occurred_epoch = parse_datetime(occurred_at)\n    else:\n        fields[\"occurred_at\"] = \"occurred_at must be a valid ISO 8601 date and time\"\n\n    if fields:\n        return error(400, next(iter(fields.values())), fields)\n\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, occurred_epoch, logged_by, created_at)\"\n            \" VALUES (?, ?, ?, ?, ?, ?, ?)\",\n            (customer_id, kind, summary, occurred_at, occurred_epoch, g.user[\"username\"], iso_z(now_utc())),\n        )\n        db.commit()\n        row = db.execute(\"SELECT * FROM interactions WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    finally:\n        db.close()\n    return jsonify(interaction_to_dict(row)), 201\n\n\n# --------------------------------------------------------------------------\n# health & frontend\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"127.0.0.1\", port=8000, debug=True)","lineStart":1,"lineEnd":506,"totalLines":506,"truncated":false}},"title":"backend/app.py","time":{"start":1794346685560,"end":1794346685604}},"id":"prt_1c7659470001p9yLcr6bshiQtA","sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","messageID":"msg_1c7653ddf0010xJdDN0YBPpTlQ"}}
