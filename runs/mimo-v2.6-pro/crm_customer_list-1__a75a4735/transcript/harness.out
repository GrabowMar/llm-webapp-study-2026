{"type":"tool_use","timestamp":1794345506554,"sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","part":{"type":"tool","tool":"write","callID":"call_5d52c891829248d88faadcb0","state":{"status":"completed","input":{"content":"\"\"\"API smoke tests for the customer directory.\"\"\"\n\nimport json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nTOKEN = None\nFAILS = []\n\n\ndef req(method, path, body=None, token=TOKEN, raw_body=None):\n    data = None\n    headers = {}\n    if raw_body is not None:\n        data = raw_body.encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    elif body is not None:\n        data = json.dumps(body).encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    r = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            payload = resp.read().decode()\n            return resp.status, (json.loads(payload) if payload else None)\n    except urllib.error.HTTPError as e:\n        payload = e.read().decode()\n        try:\n            return e.code, (json.loads(payload) if payload else None)\n        except json.JSONDecodeError:\n            return e.code, payload\n\n\ndef check(name, cond, detail=\"\"):\n    print((\"PASS \" if cond else \"FAIL \") + name + (f\"  [{detail}]\" if not cond else \"\"))\n    if not cond:\n        FAILS.append(name)\n\n\nst, body = req(\"GET\", \"/api/health\")\ncheck(\"health\", st == 200 and body == {\"status\": \"ok\"}, f\"{st} {body}\")\n\nst, body = req(\"GET\", \"/api/customers\")\ncheck(\"unauth list -> 401\", st == 401, f\"{st} {body}\")\nst, body = req(\"POST\", \"/api/customers\", {\"name\": \"X\"})\ncheck(\"unauth create -> 401\", st == 401, f\"{st} {body}\")\n\nst, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"register -> 201\", st == 201 and body.get(\"username\") == \"alice\", f\"{st} {body}\")\ntok = body.get(\"token\")\n\nst, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"duplicate username -> error\", st >= 400 and \"email\" not in str(body).lower(), f\"{st} {body}\")\nst, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"hunter2\"})\ncheck(\"register bob -> 201\", st == 201, f\"{st} {body}\")\nbob_tok = body.get(\"token\")\n\nst, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"\"})\ncheck(\"register validation\", st == 400 and body.get(\"error\"), f\"{st} {body}\")\n\nst, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong -> 401\", st == 401, f\"{st} {body}\")\nst, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"login ok -> 200 + token\", st == 200 and isinstance(body.get(\"token\"), str), f\"{st} {body}\")\nTOKEN = body[\"token\"]\n\nst, body = req(\"GET\", \"/api/auth/me\", token=TOKEN)\ncheck(\"me\", st == 200 and body[\"username\"] == \"alice\", f\"{st} {body}\")\n\n# --- customers ---\nst, body = req(\"POST\", \"/api/customers\", {\"name\": \"Ada Lovelace\", \"email\": \"ada@example.com\",\n                                          \"phone\": \"555-0100\", \"company\": \"Analytical Engines\",\n                                          \"notes\": \"Pioneer\"}, token=TOKEN)\ncheck(\"create customer -> 201\", st == 201 and body[\"id\"] and body[\"interaction_count\"] == 0\n      and body[\"last_contacted_at\"] is None and body[\"created_at\"], f\"{st} {body}\")\nada_id = body[\"id\"]\n\nst, body = req(\"POST\", \"/api/customers\", {\"name\": \"Grace Hopper\", \"email\": \"grace@example.com\",\n                                          \"company\": \"Navy\"}, token=TOKEN)\ncheck(\"create customer 2 -> 201\", st == 201, f\"{st} {body}\")\ngrace_id = body[\"id\"]\n\nst, body = req(\"POST\", \"/api/customers\", {\"name\": \"alan turing\", \"company\": \"Analytical Engines\"}, token=TOKEN)\ncheck(\"create customer 3 (no email)\", st == 201 and body[\"email\"] is None, f\"{st} {body}\")\nalan_id = body[\"id\"]\n\nst, body = req(\"POST\", \"/api/customers\", {\"name\": \"Duplicate Email\", \"email\": \"ADA@example.com\"}, token=TOKEN)\ncheck(\"duplicate email -> 400\", st == 400, f\"{st} {body}\")\ncheck(\"duplicate email message\", body and \"email\" in body.get(\"error\", \"\").lower()\n      and \"already exists\" in body.get(\"error\", \"\").lower(), f\"{body}\")\ncheck(\"duplicate email field error\", body and body.get(\"errors\", {}).get(\"email\"), f\"{body}\")\n\nst, body = req(\"POST\", \"/api/customers\", {\"email\": \"x@y.com\"}, token=TOKEN)\ncheck(\"missing name -> 400\", st == 400 and \"name\" in body.get(\"error\", \"\"), f\"{st} {body}\")\nst, body = req(\"POST\", \"/api/customers\", {\"name\": \"Bad Email\", \"email\": \"not-an-email\"}, token=TOKEN)\ncheck(\"bad email -> 400\", st == 400, f\"{st} {body}\")\nst, body = req(\"POST\", \"/api/customers\", raw_body=\"{not json\", token=TOKEN)\ncheck(\"bad json -> 400\", st == 400, f\"{st} {body}\")\n\nst, body = req(\"GET\", \"/api/customers\", token=TOKEN)\ncheck(\"list shape\", st == 200 and set(body) == {\"items\", \"total\", \"page\", \"page_size\"}\n      and body[\"total\"] == 3 and body[\"page\"] == 1 and body[\"page_size\"] == 20, f\"{st} {body}\")\ncheck(\"list sorted by name\", [c[\"name\"] for c in body[\"items\"]] == [\"Ada Lovelace\", \"alan turing\", \"Grace Hopper\"],\n      f\"{[c['name'] for c in body['items']]}\")\n\nst, body = req(\"GET\", \"/api/customers?q=hopper\", token=TOKEN)\ncheck(\"search q\", st == 200 and body[\"total\"] == 1 and body[\"items\"][0][\"name\"] == \"Grace Hopper\", f\"{st} {body}\")\nst, body = req(\"GET\", \"/api/customers?q=555\", token=TOKEN)\ncheck(\"search q phone\", body[\"total\"] == 1 and body[\"items\"][0][\"name\"] == \"Ada Lovelace\", f\"{body}\")\nst, body = req(\"GET\", \"/api/customers?company=analytical engines\", token=TOKEN)\ncheck(\"company filter ci\", body[\"total\"] == 2, f\"{body}\")\nst, body = req(\"GET\", \"/api/customers?company=Navy\", token=TOKEN)\ncheck(\"company filter exact\", body[\"total\"] == 1 and body[\"items\"][0][\"company\"] == \"Navy\", f\"{body}\")\nst, body = req(\"GET\", \"/api/customers?page=2&page_size=2\", token=TOKEN)\ncheck(\"paging\", body[\"total\"] == 3 and body[\"page\"] == 2 and body[\"page_size\"] == 2\n      and len(body[\"items\"]) == 1 and body[\"items\"][0][\"name\"] == \"Grace Hopper\", f\"{body}\")\nst, body = req(\"GET\", \"/api/customers?page=3&page_size=2\", token=TOKEN)\ncheck(\"paging past end\", body[\"items\"] == [] and body[\"total\"] == 3, f\"{body}\")\nst, body = req(\"GET\", \"/api/customers?page=0\", token=TOKEN)\ncheck(\"bad page -> 400\", st == 400, f\"{st} {body}\")\nst, body = req(\"GET\", \"/api/customers?page_size=abc\", token=TOKEN)\ncheck(\"bad page_size -> 400\", st == 400, f\"{st} {body}\")\n\nst, body = req(\"GET\", f\"/api/customers/{ada_id}\", token=TOKEN)\ncheck(\"get one\", st == 200 and body[\"email\"] == \"ada@example.com\" and body[\"notes\"] == \"Pioneer\", f\"{st} {body}\")\nst, body = req(\"GET\", \"/api/customers/9999\", token=TOKEN)\ncheck(\"get missing -> 404\", st == 404, f\"{st} {body}\")\nst, body = req(\"GET\", \"/api/customers/abc\", token=TOKEN)\ncheck(\"get bad id -> 404\", st == 404, f\"{st} {body}\")\n\nst, body = req(\"PUT\", f\"/api/customers/{ada_id}\", {\"name\": \"Ada L.\", \"email\": \"ada@example.com\"}, token=TOKEN)\ncheck(\"put clears optionals\", st == 200 and body[\"name\"] == \"Ada L.\" and body[\"phone\"] is None\n      and body[\"company\"] is None and body[\"notes\"] is None, f\"{st} {body}\")\nst, body = req(\"PUT\", f\"/api/customers/{grace_id}\", {\"name\": \"Grace Hopper\", \"email\": \"ada@example.com\"}, token=TOKEN)\ncheck(\"put duplicate email -> 400\", st == 400 and \"already exists\" in body[\"error\"].lower(), f\"{st} {body}\")\nst, body = req(\"PUT\", f\"/api/customers/{ada_id}\", {\"email\": \"ada@example.com\"}, token=TOKEN)\ncheck(\"put missing name -> 400\", st == 400, f\"{st} {body}\")\n\n# --- interactions ---\nst, body = req(\"POST\", f\"/api/customers/{ada_id}/interactions\",\n               {\"kind\": \"call\", \"summary\": \"Kickoff call\", \"occurred_at\": \"2026-01-01T12:00:00Z\"}, token=TOKEN)\ncheck(\"interaction -> 201\", st == 201 and body[\"kind\"] == \"call\" and body[\"logged_by\"] == \"alice\"\n      and body[\"occurred_at\"] == \"2026-01-01T12:00:00Z\" and body[\"customer_id\"] == ada_id, f\"{st} {body}\")\ni1 = body[\"id\"]\n\nst, body = req(\"POST\", f\"/api/customers/{ada_id}/interactions\",\n               {\"kind\": \"Emails\", \"summary\": \"Sent pricing\", \"occurred_at\": \"2026-02-01T09:30:00+00:00\"}, token=bob_tok)\ncheck(\"interaction plural kind + bob\", st == 201 and body[\"kind\"] == \"email\" and body[\"logged_by\"] == \"bob\"\n      and body[\"occurred_at\"] == \"2026-02-01T09:30:00+00:00\", f\"{st} {body}\")\n\nst, body = req(\"POST\", f\"/api/customers/{ada_id}/interactions\", {\"kind\": \"meeting\", \"summary\": \"Onsite\"}, token=TOKEN)\ncheck(\"interaction default occurred_at\", st == 201 and body[\"occurred_at\"].endswith(\"Z\"), f\"{st} {body}\")\n\nst, body = req(\"POST\", f\"/api/customers/{ada_id}/interactions\", {\"kind\": \"fax\", \"summary\": \"x\"}, token=TOKEN)\ncheck(\"bad kind -> 400\", st == 400 and \"kind\" in body.get(\"error\", \"\"), f\"{st} {body}\")\nst, body = req(\"POST\", f\"/api/customers/{ada_id}/interactions\", {\"kind\": \"call\", \"summary\": \"\"}, token=TOKEN)\ncheck(\"missing summary -> 400\", st == 400, f\"{st} {body}\")\nst, body = req(\"POST\", f\"/api/customers/{ada_id}/interactions\",\n               {\"kind\": \"call\", \"summary\": \"x\", \"occurred_at\": \"yesterday\"}, token=TOKEN)\ncheck(\"bad occurred_at -> 400\", st == 400 and \"occurred_at\" in body.get(\"error\", \"\"), f\"{st} {body}\")\nst, body = req(\"POST\", \"/api/customers/9999/interactions\", {\"kind\": \"call\", \"summary\": \"x\"}, token=TOKEN)\ncheck(\"interaction missing customer -> 404\", st == 404, f\"{st} {body}\")\n\nst, body = req(\"GET\", f\"/api/customers/{ada_id}/interactions\", token=TOKEN)\ncheck(\"interactions shape\", st == 200 and set(body) == {\"items\"}, f\"{st} {body}\")\ncheck(\"interactions newest first\", [i[\"summary\"] for i in body[\"items\"]] == [\"Onsite\", \"Sent pricing\", \"Kickoff call\"],\n      f\"{[i['summary'] for i in body['items']]}\")\n\nst, body = req(\"GET\", f\"/api/customers/{ada_id}\", token=TOKEN)\ncheck(\"counts + last_contacted\", body[\"interaction_count\"] == 3 and body[\"last_contacted_at\"] == body[\"last_contacted_at\"],\n      f\"{body}\")\nlatest = body[\"last_contacted_at\"]\nst, ib = req(\"GET\", f\"/api/customers/{ada_id}/interactions\", token=TOKEN)\ncheck(\"last_contacted = newest occurred_at\", latest == ib[\"items\"][0][\"occurred_at\"], f\"{latest} {ib['items'][0]}\")\n\nst, body = req(\"DELETE\", f\"/api/customers/{ada_id}\", token=TOKEN)\ncheck(\"delete -> 204\", st == 204, f\"{st} {body}\")\nst, body = req(\"GET\", f\"/api/customers/{ada_id}\", token=TOKEN)\ncheck(\"deleted gone\", st == 404, f\"{st} {body}\")\nst, body = req(\"GET\", f\"/api/customers/{ada_id}/interactions\", token=TOKEN)\ncheck(\"interactions cascade\", st == 404, f\"{st} {body}\")\n\nst, body = req(\"GET\", \"/api/customers\", token=TOKEN)\ncheck(\"total after delete\", body[\"total\"] == 2, f\"{body}\")\n\nst, body = req(\"GET\", \"/api/customers\", token=bob_tok)\ncheck(\"other user can read\", st == 200 and body[\"total\"] == 2, f\"{st} {body}\")\nst, body = req(\"GET\", \"/api/customers\", token=\"bogus\")\ncheck(\"bogus token -> 401\", st == 401, f\"{st} {body}\")\nst, body = req(\"DELETE\", f\"/api/customers/{grace_id}\", token=bob_tok)\ncheck(\"other user can delete\", st == 204, f\"{st} {body}\")\n\nst, body = req(\"GET\", \"/api/nope\")\ncheck(\"unknown api -> 404 json\", st == 404 and isinstance(body, dict), f\"{st} {body}\")\n\nprint()\nprint(\"FAILURES:\", FAILS if FAILS else \"none\")\n","filePath":"/workspace/.venv/smoke.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.venv/smoke.py","exists":false,"truncated":false},"title":".venv/smoke.py","time":{"start":1794345506518,"end":1794345506531}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c75396cf001IWuopDtdi726ZP","sessionID":"ses_e38b9aa43ffeVjX0mj3j3mxKOi","messageID":"msg_1c752ab02001ECN1k0l96qEqlE"}}
