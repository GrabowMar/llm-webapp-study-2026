{"type":"tool_use","timestamp":1794301911427,"sessionID":"ses_e3b522a38ffeEVYwABoCGjwNuP","part":{"type":"tool","tool":"write","callID":"call_ce0aefe7cbb24f75a8cccdc8","state":{"status":"completed","input":{"content":"import json\nimport time\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nPASS = 0\nFAIL = 0\n\n\ndef call(method, path, body=None, token=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(req, data=data) as res:\n            return res.status, json.loads(res.read().decode() or \"null\")\n    except urllib.error.HTTPError as e:\n        raw = e.read().decode()\n        try:\n            return e.code, json.loads(raw or \"null\")\n        except json.JSONDecodeError:\n            return e.code, raw\n\n\ndef check(name, cond, detail=\"\"):\n    global PASS, FAIL\n    if cond:\n        PASS += 1\n        print(f\"  ok  {name}\")\n    else:\n        FAIL += 1\n        print(f\"FAIL  {name} {detail}\")\n\n\ns, b = call(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and b == {\"status\": \"ok\"}, (s, b))\n\ns, b = call(\"GET\", \"/api/quiz?count=5\")\nitems = b[\"items\"]\ncheck(\"quiz count=5\", s == 200 and len(items) == 5, (s, len(items)))\ncheck(\"quiz unique ids\", len({i[\"id\"] for i in items}) == 5)\ncheck(\"quiz hides correct_option\", all(\"correct_option\" not in i for i in items), items[0].keys())\ncheck(\n    \"quiz item shape\",\n    all(set(i) == {\"id\", \"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\"} for i in items),\n    items[0].keys(),\n)\ns, b = call(\"GET\", \"/api/quiz\")\ncheck(\"quiz default count\", s == 200 and len(b[\"items\"]) == 5, (s, len(b.get(\"items\", []))))\ns, b = call(\"GET\", \"/api/quiz?count=abc\")\ncheck(\"quiz bad count\", s == 400, s)\ns, b = call(\"GET\", \"/api/quiz?count=1000\")\ncheck(\"quiz huge count clamps\", s == 200 and len(b[\"items\"]) >= 20, (s, len(b[\"items\"])))\n\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123\"})\ncheck(\"register 201\", s == 201, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123\"})\ncheck(\"register duplicate 409\", s == 409, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"x\"})\ncheck(\"register admin blocked\", s in (409, 400), (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\"})\ncheck(\"register missing password\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw123\"})\ncheck(\"register bob\", s == 201, (s, b))\n\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong password\", s == 401, (s, b))\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw123\"})\ncheck(\"login ok\", s == 200 and \"token\" in b, (s, b))\nalice = b[\"token\"]\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"s3cret\"})\ncheck(\"admin login\", s == 200 and \"token\" in b, (s, b))\nadmin = b.get(\"token\")\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"nope\"})\ncheck(\"admin bad password\", s == 401, (s, b))\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"x\"})\ncheck(\"login unknown user\", s == 401, (s, b))\n\ns, quiz = call(\"GET\", \"/api/quiz?count=3\")\nanswers = [{\"question_id\": q[\"id\"], \"selected\": \"A\"} for q in quiz[\"items\"]]\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": answers})\ncheck(\"anonymous attempt 201\", s == 201, (s, b))\ncheck(\"anonymous attempt id null\", b[\"id\"] is None, b.get(\"id\"))\ncheck(\n    \"attempt shape\",\n    set(b) == {\"id\", \"score\", \"correct\", \"total_questions\", \"submitted_at\", \"answers\"},\n    b.keys(),\n)\ncheck(\"attempt totals\", b[\"total_questions\"] == 3 and len(b[\"answers\"]) == 3, b)\ncheck(\"attempt score range\", 0 <= b[\"score\"] <= 100, b[\"score\"])\ncheck(\"attempt score consistent\", abs(b[\"score\"] - b[\"correct\"] / 3 * 100) < 0.01, b[\"score\"])\nans0 = b[\"answers\"][0]\ncheck(\n    \"answer shape\",\n    {\"id\", \"question_id\", \"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\",\n     \"correct_option\", \"selected\", \"is_correct\"} <= set(ans0),\n    ans0.keys(),\n)\ncheck(\"answer selected\", ans0[\"selected\"] == \"A\", ans0)\ncheck(\"answer is_correct matches\", ans0[\"is_correct\"] == (ans0[\"selected\"] == ans0[\"correct_option\"]))\n\ns, b = call(\"POST\", \"/api/attempts\", {})\ncheck(\"attempt no answers\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": []})\ncheck(\"attempt empty answers\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": [{\"question_id\": 1, \"selected\": \"Z\"}]})\ncheck(\"attempt bad selected\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": [{\"question_id\": 999999, \"selected\": \"A\"}]})\ncheck(\"attempt unknown question\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": [{\"question_id\": \"x\", \"selected\": \"A\"}]})\ncheck(\"attempt bad question id\", s == 400, (s, b))\n\ns, b = call(\"GET\", \"/api/attempts\")\ncheck(\"list attempts no token\", s == 401, s)\ns, b = call(\"GET\", \"/api/attempts/1\")\ncheck(\"get attempt no token\", s == 401, s)\ns, b = call(\"GET\", \"/api/attempts\")\ncheck(\"list attempts empty\", s == 200 and b[\"items\"] == [], (s, b))\n\ns, quiz = call(\"GET\", \"/api/quiz?count=4\")\nanswers = [{\"question_id\": q[\"id\"], \"selected\": \"B\"} for q in quiz[\"items\"]]\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": answers}, token=alice)\ncheck(\"signed attempt saved\", s == 201 and isinstance(b[\"id\"], int), (s, b))\nsaved_id = b[\"id\"]\ns, b = call(\"GET\", \"/api/attempts\", token=alice)\ncheck(\"alice has 1 attempt\", s == 200 and len(b[\"items\"]) == 1, (s, b))\nitem = b[\"items\"][0]\ncheck(\n    \"list item attempt shape\",\n    {\"id\", \"score\", \"correct\", \"total_questions\", \"submitted_at\", \"answers\"} <= set(item),\n    item.keys(),\n)\ns, b2 = call(\"GET\", f\"/api/attempts/{saved_id}\", token=alice)\ncheck(\"get attempt ok\", s == 200 and b2[\"id\"] == saved_id, (s, b2))\ncheck(\"detail review size\", len(b2[\"answers\"]) == 4, b2[\"answers\"])\ncheck(\"detail has review\", all(\"correct_option\" in a and \"is_correct\" in a for a in b2[\"answers\"]))\n\ntime.sleep(1.1)\ns, quiz = call(\"GET\", \"/api/quiz?count=2\")\nanswers = [{\"question_id\": q[\"id\"], \"selected\": \"C\"} for q in quiz[\"items\"]]\ns, b = call(\"POST\", \"/api/attempts\", {\"answers\": answers}, token=alice)\nsecond_id = b[\"id\"]\ns, b = call(\"GET\", \"/api/attempts\", token=alice)\ncheck(\"alice has 2 attempts\", s == 200 and len(b[\"items\"]) == 2, (s, b))\ncheck(\"newest first\", b[\"items\"][0][\"id\"] == second_id, [i[\"id\"] for i in b[\"items\"]])\n\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw123\"})\nbob = b[\"token\"]\ns, b = call(\"GET\", \"/api/attempts\", token=bob)\ncheck(\"bob sees no attempts\", s == 200 and b[\"items\"] == [], (s, b))\ns, b = call(\"GET\", f\"/api/attempts/{saved_id}\", token=bob)\ncheck(\"bob cannot see alice attempt\", s == 404, (s, b))\n\ns, b = call(\"GET\", \"/api/admin/questions\")\ncheck(\"admin list anonymous\", s == 401, s)\ns, b = call(\"GET\", \"/api/admin/questions\", token=alice)\ncheck(\"admin list non-admin\", s == 403, s)\ns, b = call(\"GET\", \"/api/admin/questions\", token=admin)\ncheck(\"admin list ok\", s == 200, (s, b))\ncheck(\"admin list shape\", set(b) == {\"items\", \"total\", \"page\", \"page_size\"}, b.keys())\ncheck(\"admin sees correct_option\", all(\"correct_option\" in i for i in b[\"items\"]))\ncheck(\"admin total >= 20\", b[\"total\"] >= 20, b[\"total\"])\ns, b2 = call(\"GET\", \"/api/admin/questions?page=2&page_size=5\", token=admin)\ncheck(\"admin pagination\", b2[\"page\"] == 2 and b2[\"page_size\"] == 5 and len(b2[\"items\"]) == 5, b2)\ns, b2 = call(\"GET\", \"/api/admin/questions?page=0\", token=admin)\ncheck(\"admin bad page\", s == 400, s)\n\nq = {\n    \"text\": \"What is 2 + 2?\",\n    \"option_a\": \"3\",\n    \"option_b\": \"4\",\n    \"option_c\": \"5\",\n    \"option_d\": \"22\",\n    \"correct_option\": \"B\",\n}\ns, b = call(\"POST\", \"/api/admin/questions\", q, token=alice)\ncheck(\"create question non-admin\", s == 403, s)\ns, b = call(\"POST\", \"/api/admin/questions\", q)\ncheck(\"create question anonymous\", s == 401, s)\ns, b = call(\"POST\", \"/api/admin/questions\", q, token=admin)\ncheck(\"create question ok\", s == 201 and b[\"correct_option\"] == \"B\", (s, b))\nnew_id = b[\"id\"]\nbad = dict(q)\ndel bad[\"text\"]\ns, b = call(\"POST\", \"/api/admin/questions\", bad, token=admin)\ncheck(\"create missing text\", s == 400 and \"text\" in b[\"error\"], (s, b))\nbad = dict(q, correct_option=\"E\")\ns, b = call(\"POST\", \"/api/admin/questions\", bad, token=admin)\ncheck(\"create bad correct_option\", s == 400 and \"correct_option\" in b[\"error\"], (s, b))\nbad = dict(q, option_b=\"\")\ns, b = call(\"POST\", \"/api/admin/questions\", bad, token=admin)\ncheck(\"create empty option\", s == 400 and \"option_b\" in b[\"error\"], (s, b))\n\nseen = set()\nfor _ in range(40):\n    s, b = call(\"GET\", \"/api/quiz?count=50\")\n    seen |= {i[\"id\"] for i in b[\"items\"]}\ncheck(\"new question in pool\", new_id in seen, (new_id, len(seen)))\n\nprint(f\"\\n{PASS} passed, {FAIL} failed\")\nraise SystemExit(1 if FAIL else 0)\n","filePath":"/workspace/smoke_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/smoke_test.py","exists":false,"truncated":false},"title":"smoke_test.py","time":{"start":1794301911398,"end":1794301911407}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4ba6160001X46dU1EjgYxsCU","sessionID":"ses_e3b522a38ffeEVYwABoCGjwNuP","messageID":"msg_1c4b9e85d001G3cw3t48G2Hi7W"}}
