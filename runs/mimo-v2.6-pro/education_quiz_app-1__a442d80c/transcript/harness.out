_a, option_b, option_c, option_d, correct_option)\"\n-            \" VALUES (?, ?, ?, ?, ?, ?)\",\n-            [q for q in SEED_QUESTIONS if q[0] not in existing],\n-        )\n-        ensure_admin(db)\n-        db.commit()\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        try:\n+            existing = {\n+                row[0] for row in db.execute(\"SELECT text FROM questions\").fetchall()\n+            }\n+            db.executemany(\n+                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option)\"\n+                \" VALUES (?, ?, ?, ?, ?, ?)\",\n+                [q for q in SEED_QUESTIONS if q[0] not in existing],\n+            )\n+            ensure_admin(db)\n+            db.execute(\"COMMIT\")\n+        except Exception:\n+            db.execute(\"ROLLBACK\")\n+            raise\n     finally:\n         db.close()\n \n \n","additions":16,"deletions":10},"truncated":false},"title":"backend/app.py","time":{"start":1794302289178,"end":1794302289191}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4c02515001DJmVcj22KJLAFv","sessionID":"ses_e3b522a38ffeEVYwABoCGjwNuP","messageID":"msg_1c4bf6225001p3OrM0tnmBG69P"}}
