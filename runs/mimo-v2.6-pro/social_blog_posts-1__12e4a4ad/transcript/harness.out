encodeURIComponent(post.author)}`}\n     className=\"font-medium text-slate-700 hover:underline\"\n   >\n     {post.author}\n   </Link>\n@@ -105,14 +101,15 @@\n \n {post.tags.length > 0 && (\n   <div className=\"mt-3 flex flex-wrap gap-2\">\n     {post.tags.map((tag) => (\n-      <span\n+      <Link\n         key={tag}\n-        className=\"rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700\"\n+        to={`/?tag=${encodeURIComponent(tag)}`}\n+        className=\"rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 hover:bg-slate-200\"\n       >\n         #{tag}\n-      </span>\n+      </Link>\n     ))}\n   </div>\n )}\n \n","additions":5,"deletions":8},"truncated":false},"title":"frontend/src/pages/PostPage.tsx","time":{"start":1794367834174,"end":1794367834194}},"id":"prt_1c8a8483900167a7KUTur8s1V6","sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","messageID":"msg_1c8a812a5001X5rU78XGlb1Q0A"}}
