] = useState({ q: \"\", tag: \"\", author: \"\", page: 1 });\n@@ -18,8 +18,23 @@\n \n   const isAdmin = auth?.username === \"admin\";\n \n   useEffect(() => {\n+    const params = new URLSearchParams(search);\n+    const page = Math.max(1, Number(params.get(\"page\") ?? \"1\") || 1);\n+    const next = {\n+      q: params.get(\"q\") ?? \"\",\n+      tag: params.get(\"tag\") ?? \"\",\n+      author: params.get(\"author\") ?? \"\",\n+      page,\n+    };\n+    setQ(next.q);\n+    setTag(next.tag);\n+    setAuthor(next.author);\n+    setFilters(next);\n+  }, [search]);\n+\n+  useEffect(() => {\n     let cancelled = false;\n     setLoading(true);\n     const params = new URLSearchParams();\n     if (filters.q) params.set(\"q\", filters.q);\n","additions":16,"deletions":1},"truncated":false},"title":"frontend/src/pages/PostList.tsx","time":{"start":1794367834167,"end":1794367834185}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8a84831001LcMOQUUhTP3B2m","sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","messageID":"msg_1c8a812a5001X5rU78XGlb1Q0A"}}
{"type":"tool_use","timestamp":1794367834214,"sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","part":{"type":"tool","tool":"edit","callID":"call_0fac80766cc94da7b4aeb570","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/pages/PostPage.tsx","newString":"      <p className=\"mt-2 text-sm text-slate-500\">\n        by{\" \"}\n        <Link\n          to={`/?author=${encodeURIComponent(post.author)}`}\n          className=\"font-medium text-slate-700 hover:underline\"\n        >\n          {post.author}\n        </Link>\n        {\" · \"}\n        {formatDate(post.created_at)}\n        {post.updated_at !== post.created_at && <> · updated {formatDate(post.updated_at)}</>}\n      </p>\n\n      {post.tags.length > 0 && (\n        <div className=\"mt-3 flex flex-wrap gap-2\">\n          {post.tags.map((tag) => (\n            <Link\n              key={tag}\n              to={`/?tag=${encodeURIComponent(tag)}`}\n              className=\"rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 hover:bg-slate-200\"\n            >\n              #{tag}\n            </Link>\n          ))}\n        </div>\n      )}","oldString":"      <p className=\"mt-2 text-sm text-slate-500\">\n        by{\" \"}\n        <Link\n          to=\"/\"\n          onClick={(e) => {\n            e.preventDefault();\n            navigate(`/?author=${encodeURIComponent(post.author)}`);\n          }}\n          className=\"font-medium text-slate-700 hover:underline\"\n        >\n          {post.author}\n        </Link>\n        {\" · \"}\n        {formatDate(post.created_at)}\n        {post.updated_at !== post.created_at && <> · updated {formatDate(post.updated_at)}</>}\n      </p>\n\n      {post.tags.length > 0 && (\n        <div className=\"mt-3 flex flex-wrap gap-2\">\n          {post.tags.map((tag) => (\n            <span\n              key={tag}\n              className=\"rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700\"\n           