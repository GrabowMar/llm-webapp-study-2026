{"type":"step_start","timestamp":1794367776676,"sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","part":{"id":"prt_1c8a76790001ey1Mo4ec2yhcH7","messageID":"msg_1c8a71b10001znauDp0CYLspI0","sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","type":"step-start"}}
{"type":"tool_use","timestamp":1794367776746,"sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","part":{"type":"tool","tool":"write","callID":"call_fde8876b8b2c4830a540b2dd","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, formatDate } from \"../api\";\nimport type { Auth, Post } from \"../api\";\nimport { Link, navigate } from \"../router\";\n\nfunction paragraphs(content: string): string[] {\n  return content.split(/\\n\\s*\\n/);\n}\n\nexport default function PostPage({ auth, postId }: { auth: Auth | null; postId: number }) {\n  const [post, setPost] = useState<Post | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const isAdmin = auth?.username === \"admin\";\n\n  const load = useCallback(() => {\n    api<Post>(`/api/posts/${postId}`, { token: auth?.token ?? null })\n      .then((result) => {\n        setPost(result);\n        setError(null);\n      })\n      .catch((err: unknown) => {\n        setPost(null);\n        setError(err instanceof Error ? err.message : \"Failed to load post\");\n      });\n  }, [postId, auth]);\n\n  useEffect(() => {\n    setPost(null);\n    setError(null);\n    setNotice(null);\n    load();\n  }, [load]);\n\n  const isOwner = Boolean(auth && post && auth.username === post.author);\n\n  const onDelete = async () => {\n    if (!auth || !post) return;\n    if (!window.confirm(\"Delete this post? This cannot be undone.\")) return;\n    setBusy(true);\n    setError(null);\n    try {\n      await api(`/api/posts/${post.id}`, { method: \"DELETE\", token: auth.token });\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete post\");\n      setBusy(false);\n    }\n  };\n\n  const onToggle = async () => {\n    if (!auth || !post) return;\n    setBusy(true);\n    setError(null);\n    try {\n      const result = await api<{ taken_down: boolean }>(\n        `/api/admin/posts/${post.id}/toggle`,\n        { method: \"POST\", token: auth.token },\n      );\n      setNotice(result.taken_down ? \"This post has been taken down.\" : \"This post has been restored.\");\n      load();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to toggle post\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  if (error && !post) {\n    return (\n      <div className=\"rounded-lg border border-red-200 bg-red-50 p-6 text-red-700\">\n        <p className=\"font-medium\">{error}</p>\n        <Link to=\"/\" className=\"mt-2 inline-block font-medium text-indigo-700 hover:underline\">\n          Back to all posts\n        </Link>\n      </div>\n    );\n  }\n\n  if (!post) {\n    return <p className=\"text-slate-600\">Loading…</p>;\n  }\n\n  return (\n    <article>\n      <h1 className=\"text-3xl font-bold tracking-tight\">{post.title}</h1>\n      <p className=\"mt-2 text-sm text-slate-500\">\n        by{\" \"}\n        <Link\n          to=\"/\"\n          onClick={(e) => {\n            e.preventDefault();\n            navigate(`/?author=${encodeURIComponent(post.author)}`);\n          }}\n          className=\"font-medium text-slate-700 hover:underline\"\n        >\n          {post.author}\n        </Link>\n        {\" · \"}\n        {formatDate(post.created_at)}\n        {post.updated_at !== post.created_at && <> · updated {formatDate(post.updated_at)}</>}\n      </p>\n\n      {post.tags.length > 0 && (\n        <div className=\"mt-3 flex flex-wrap gap-2\">\n          {post.tags.map((tag) => (\n            <span\n              key={tag}\n              className=\"rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700\"\n            >\n              #{tag}\n            </span>\n          ))}\n        </div>\n      )}\n\n      {notice && (\n        <div className=\"mt-4 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800\">\n          {notice}\n        </div>\n      )}\n      {error && (\n        <div className=\"mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </div>\n      )}\n\n      <div className=\"mt-6 space-y-4 text-lg leading-relaxed text-slate-800\">\n        {paragraphs(post.content).map((paragraph, index) => (\n          <p key={index} className=\"whitespace-pre-line\">\n            {paragraph}\n          </p>\n        ))}\n      </div>\n\n      {(isOwner || isAdmin) && (\n        <div className=\"mt-8 flex flex-wrap gap-3 border-t border-slate-200 pt-4\">\n          {isOwner && (\n            <>\n              <Link\n                to={`/posts/${post.id}/edit`}\n                className=\"rounded bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700\"\n              >\n                Edit\n              </Link>\n              <button\n                type=\"button\"\n                onClick={onDelete}\n                disabled={busy}\n                className=\"rounded border border-red-300 bg-red-50 px-4 py-2 font-medium text-red-700 hover:bg-red-100 disabled:opacity-50\"\n              >\n                Delete\n              </button>\n            </>\n          )}\n          {isAdmin && (\n            <button\n              type=\"button\"\n              onClick={onToggle}\n              disabled={busy}\n              className=\"rounded border border-amber-300 bg-amber-50 px-4 py-2 font-medium text-amber-800 hover:bg-amber-100 disabled:opacity-50\"\n            >\n              Take down / restore\n            </button>\n          )}\n        </div>\n      )}\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/PostPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/PostPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/PostPage.tsx","time":{"start":1794367776668,"end":1794367776680}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8a76794001jEd9NhhmynrCwD","sessionID":"ses_e3779b549ffe1s1drsWQiTMkd6","messageID":"msg_1c8a71b10001znauDp0CYLspI0"}}
