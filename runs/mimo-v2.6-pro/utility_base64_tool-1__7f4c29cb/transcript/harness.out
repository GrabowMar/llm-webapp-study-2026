{"type":"tool_use","timestamp":1794359612472,"sessionID":"ses_e37d7c906ffexH7bihwr6ciXQY","part":{"type":"tool","tool":"write","callID":"call_0b3b6cae0038485ebf440888","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: base64 converter API + frontend serving.\"\"\"\n\nimport base64\nimport binascii\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\nPREVIEW_LEN = 80\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------- database\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS conversions (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            direction TEXT NOT NULL,\n            input TEXT NOT NULL,\n            output TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_conversions_user\n            ON conversions (user_id, id);\n        \"\"\"\n    )\n    db.commit()\n    db.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\n# ------------------------------------------------------------------ helpers\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef preview(value: str) -> str:\n    if len(value) <= PREVIEW_LEN:\n        return value\n    return value[: PREVIEW_LEN - 3] + \"...\"\n\n\ndef encode_text(text: str) -> str:\n    return base64.b64encode(text.encode(\"utf-8\")).decode(\"ascii\")\n\n\ndef decode_text(encoded: str) -> str:\n    raw = base64.b64decode(encoded, validate=True)\n    return raw.decode(\"utf-8\")\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t\"\n        \" JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        return view(user, *args, **kwargs)\n\n    return wrapped\n\n\ndef convert(direction: str, value: str):\n    \"\"\"Return (output, error_response).\"\"\"\n    if direction == \"encode\":\n        return encode_text(value), None\n    try:\n        return decode_text(value), None\n    except (binascii.Error, ValueError):\n        return None, error(\"invalid base64 input\", 400)\n    except UnicodeDecodeError:\n        return None, error(\"decoded data is not valid UTF-8\", 400)\n\n\ndef conversion_dict(row: sqlite3.Row, with_output: bool = False) -> dict:\n    item = {\n        \"id\": row[\"id\"],\n        \"direction\": row[\"direction\"],\n        \"input_preview\": preview(row[\"input\"]),\n        \"output_preview\": preview(row[\"output\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n    if with_output:\n        item[\"output\"] = row[\"output\"]\n    return item\n\n\n# -------------------------------------------------------------------- auth\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return error(\"username already taken\", 409)\n\n    created_at = now_iso()\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), created_at),\n    )\n    user_id = cur.lastrowid\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, created_at),\n    )\n    db.commit()\n    return jsonify({\"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    get_db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    get_db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n# ------------------------------------------------------------------ base64\n\n\n@app.post(\"/api/base64/encode\")\ndef encode_endpoint():\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    text = data.get(\"text\")\n    if not isinstance(text, str):\n        return error(\"text is required\", 400)\n    return jsonify({\"encoded\": encode_text(text)}), 200\n\n\n@app.post(\"/api/base64/decode\")\ndef decode_endpoint():\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    encoded = data.get(\"encoded\")\n    if not isinstance(encoded, str):\n        return error(\"encoded is required\", 400)\n    text, err = convert(\"decode\", encoded)\n    if err is not None:\n        return err\n    return jsonify({\"text\": text}), 200\n\n\n# ------------------------------------------------------------- conversions\n\n\n@app.post(\"/api/conversions\")\n@require_auth\ndef create_conversion(user):\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    direction = data.get(\"direction\")\n    value = data.get(\"input\")\n    if direction not in (\"encode\", \"decode\"):\n        return error(\"direction must be 'encode' or 'decode'\", 400)\n    if not isinstance(value, str):\n        return error(\"input is required\", 400)\n\n    output, err = convert(direction, value)\n    if err is not None:\n        return err\n\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO conversions (user_id, direction, input, output, created_at)\"\n        \" VALUES (?, ?, ?, ?, ?)\",\n        (user[\"id\"], direction, value, output, now_iso()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM conversions WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(conversion_dict(row, with_output=True)), 201\n\n\n@app.get(\"/api/conversions\")\n@require_auth\ndef list_conversions(user):\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n    except ValueError:\n        return error(\"page and page_size must be integers\", 400)\n    if page < 1:\n        return error(\"page must be >= 1\", 400)\n    if page_size < 1 or page_size > MAX_PAGE_SIZE:\n        return error(\"page_size must be between 1 and %d\" % MAX_PAGE_SIZE, 400)\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM conversions WHERE user_id = ?\", (user[\"id\"],)\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM conversions WHERE user_id = ?\"\n        \" ORDER BY id DESC LIMIT ? OFFSET ?\",\n        (user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [conversion_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    ), 200\n\n\n@app.delete(\"/api/conversions/<int:conversion_id>\")\n@require_auth\ndef delete_conversion(user, conversion_id: int):\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM conversions WHERE id = ? AND user_id = ?\",\n        (conversion_id, user[\"id\"]),\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        return error(\"conversion not found\", 404)\n    return jsonify({\"ok\": True}), 200\n\n\n# ----------------------------------------------------------------- health\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n# ---------------------------------------------------------------- frontend\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path == \"api\":\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794359612361,"end":1794359612441}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c82ad3c000107Ua9qY3ZMgKvq","sessionID":"ses_e37d7c906ffexH7bihwr6ciXQY","messageID":"msg_1c82a80e0001pJwbfZfPE3rvMz"}}
