e, error(\"decoded data is not valid UTF-8\", 400)\n    except (binascii.Error, ValueError):\n        return None, error(\"invalid base64 input\", 400)\n\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        return view(user, *args, **kwargs)\n\n    return wrapped\n\n\ndef convert(direction: str, value: str):\n    \"\"\"Return (output, error_response).\"\"\"\n    if direction == \"encode\":\n        return encode_text(value), None\n    try:\n        return decode_text(value), None\n    except UnicodeDecodeError:\n        return None, error(\"decoded data is not valid UTF-8\", 400)\n    except (binascii.Error, ValueError):\n        return None, error(\"invalid base64 input\", 400)\n\n\ndef conversion_dict(row: sqlite3.Row, with_output: bool = False) -> dict:\n    item = {\n        \"id\": row[\"id\"],\n        \"direction\": row[\"direction\"],\n        \"input_preview\": preview(row[\"input\"]),\n        \"output_preview\": preview(row[\"output\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n    if with_output:\n        item[\"output\"] = row[\"output\"]\n    return item\n\n\n# -------------------------------------------------------------------- auth\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return error(\"username already taken\", 409)\n\n    created_at = now_iso()\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), created_at),\n    )\n    user_id = cur.lastrowid\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, created_at),\n    )\n    db.commit()\n    return jsonify({\"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"JSON body required\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)","lineStart":130,"lineEnd":209,"totalLines":358,"truncated":true}},"title":"backend/app.py","time":{"start":1794360694709,"end":1794360694731}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c83b57b1001R4T0hNacwwKmXv","sessionID":"ses_e37d7c906ffexH7bihwr6ciXQY","messageID":"msg_1c83b4128001bAaZx7lixWcXAx"}}
