{"type":"tool_use","timestamp":1794359688570,"sessionID":"ses_e37d7c906ffexH7bihwr6ciXQY","part":{"type":"tool","tool":"write","callID":"call_3376fbb649ca4e1da478cbd5","state":{"status":"completed","input":{"content":"export type Direction = \"encode\" | \"decode\";\n\nexport interface Conversion {\n  id: number;\n  direction: Direction;\n  input_preview: string;\n  output_preview: string;\n  created_at: string;\n  output?: string;\n}\n\nexport interface ConversionPage {\n  items: Conversion[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n  token?: string | null,\n): Promise<T> {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...((options.headers as Record<string, string>) ?? {}),\n  };\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(path, { ...options, headers });\n  let body: unknown = null;\n  try {\n    body = await res.json();\n  } catch {\n    body = null;\n  }\n  if (!res.ok) {\n    const message =\n      body && typeof body === \"object\" && typeof (body as { error?: unknown }).error === \"string\"\n        ? (body as { error: string }).error\n        : `request failed with status ${res.status}`;\n    throw new ApiError(message, res.status);\n  }\n  return body as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ username: string; token: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function encodeText(text: string) {\n  return request<{ encoded: string }>(\"/api/base64/encode\", {\n    method: \"POST\",\n    body: JSON.stringify({ text }),\n  });\n}\n\nexport function decodeText(encoded: string) {\n  return request<{ text: string }>(\"/api/base64/decode\", {\n    method: \"POST\",\n    body: JSON.stringify({ encoded }),\n  });\n}\n\nexport function createConversion(\n  direction: Direction,\n  input: string,\n  token: string,\n) {\n  return request<Conversion>(\n    \"/api/conversions\",\n    {\n      method: \"POST\",\n      body: JSON.stringify({ direction, input }),\n    },\n    token,\n  );\n}\n\nexport function listConversions(\n  page: number,\n  pageSize: number,\n  token: string,\n) {\n  return request<ConversionPage>(\n    `/api/conversions?page=${page}&page_size=${pageSize}`,\n    {},\n    token,\n  );\n}\n\nexport function deleteConversion(id: number, token: string) {\n  return request<{ ok: boolean }>(\n    `/api/conversions/${id}`,\n    { method: \"DELETE\" },\n    token,\n  );\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794359688544,"end":1794359688552}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c82bfd5a001QIKlWLoxAQhmmT","sessionID":"ses_e37d7c906ffexH7bihwr6ciXQY","messageID":"msg_1c82bdd49001YC7bJTSM66vFaC"}}
