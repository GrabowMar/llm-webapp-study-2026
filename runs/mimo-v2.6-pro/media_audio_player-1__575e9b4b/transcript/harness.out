{"type":"tool_use","timestamp":1794378033828,"sessionID":"ses_e36c0300cffeuhOocOqdZKOL18","part":{"type":"tool","tool":"write","callID":"call_398ccbbd9afc4deb872b7680","state":{"status":"completed","input":{"content":"\"\"\"Throwaway smoke tests for the backend API (Flask test client).\"\"\"\nimport sys\n\nsys.path.insert(0, \"backend\")\n\nfrom app import app, DB_PATH  # noqa: E402\n\nc = app.test_client()\nfails = []\n\n\ndef check(name, cond, extra=\"\"):\n    if cond:\n        print(f\"ok   {name}\")\n    else:\n        print(f\"FAIL {name} {extra}\")\n        fails.append(name)\n\n\n# health\nr = c.get(\"/api/health\")\ncheck(\"health\", r.status_code == 200 and r.get_json() == {\"status\": \"ok\"}, r.data)\n\n# register\nr = c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"register 201\", r.status_code == 201, r.data)\nr = c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"})\ncheck(\"register dup 409\", r.status_code == 409, r.data)\nr = c.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", r.status_code == 400, r.data)\nr = c.post(\"/api/auth/register\", json={\"username\": \"bob\"})\ncheck(\"register no password 400\", r.status_code == 400, r.data)\nr = c.post(\"/api/auth/register\", json={\"username\": \"bob\", \"password\": \"hunter2\"})\ncheck(\"register bob 201\", r.status_code == 201, r.data)\n\n# login\nr = c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"login 200\", r.status_code == 200 and \"token\" in r.get_json(), r.data)\ntok = r.get_json()[\"token\"]\ncheck(\"login body exact\", set(r.get_json()) == {\"token\"}, r.data)\nr = c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong 401\", r.status_code == 401, r.data)\nr = c.post(\"/api/auth/login\", json={\"username\": \"nobody\", \"password\": \"x\"})\ncheck(\"login unknown 401\", r.status_code == 401, r.data)\nrtok = c.post(\"/api/auth/login\", json={\"username\": \"bob\", \"password\": \"hunter2\"}).get_json()[\"token\"]\nAUTH = {\"Authorization\": f\"Bearer {tok}\"}\nBOB = {\"Authorization\": f\"Bearer {rtok}\"}\nBAD = {\"Authorization\": \"Bearer nonsense\"}\n\n# me\nr = c.get(\"/api/auth/me\", headers=AUTH)\ncheck(\"me 200\", r.status_code == 200 and r.get_json() == {\"username\": \"alice\"}, r.data)\nr = c.get(\"/api/auth/me\")\ncheck(\"me no token 401\", r.status_code == 401, r.data)\nr = c.get(\"/api/auth/me\", headers=BAD)\ncheck(\"me bad token 401\", r.status_code == 401, r.data)\n\n# create tracks unauth\nr = c.post(\"/api/tracks\", json={\"title\": \"t\", \"url\": \"https://x/a.mp3\"})\ncheck(\"add unauth 401\", r.status_code == 401, r.data)\nr = c.post(\"/api/tracks\", json={\"title\": \"t\", \"url\": \"https://x/a.mp3\"}, headers=BAD)\ncheck(\"add bad token 401\", r.status_code == 401, r.data)\n\n# validation\nbad_cases = [\n    ({\"title\": \"t\", \"url\": \"ftp://x/a.mp3\"}, \"ftp url\"),\n    ({\"title\": \"t\", \"url\": \"file:///etc/passwd\"}, \"file url\"),\n    ({\"title\": \"t\", \"url\": \"javascript:alert(1)\"}, \"js url\"),\n    ({\"title\": \"t\", \"url\": \"not a url\"}, \"no scheme\"),\n    ({\"title\": \"t\", \"url\": \"\"}, \"empty url\"),\n    ({\"title\": \"t\"}, \"missing url\"),\n    ({\"url\": \"https://x/a.mp3\"}, \"missing title\"),\n    ({\"title\": \"\", \"url\": \"https://x/a.mp3\"}, \"empty title\"),\n    ({\"title\": \"t\", \"url\": \"https://x/a.mp3\", \"duration\": -3}, \"negative duration\"),\n    ({\"title\": \"t\", \"url\": \"https://x/a.mp3\", \"duration\": \"abc\"}, \"bad duration\"),\n]\nfor body, name in bad_cases:\n    r = c.post(\"/api/tracks\", json=body, headers=AUTH)\n    check(f\"add invalid: {name} -> 400\", r.status_code == 400, f\"{r.status_code} {r.data}\")\n    check(f\"add invalid: {name} has error\", \"error\" in r.get_json(), r.data)\n\nr = c.post(\"/api/tracks\", json={\"title\": \"Song A\", \"artist\": \"Band\", \"url\": \"https://cdn.example.com/a.mp3\", \"duration\": 210}, headers=AUTH)\ncheck(\"add track 201\", r.status_code == 201, r.data)\nt1 = r.get_json()\ncheck(\"track fields\", set(t1) == {\"id\", \"title\", \"artist\", \"url\", \"duration\", \"play_count\", \"created_at\", \"added_by\"}, t1)\ncheck(\"track values\", t1[\"title\"] == \"Song A\" and t1[\"artist\"] == \"Band\" and t1[\"url\"] == \"https://cdn.example.com/a.mp3\" and t1[\"play_count\"] == 0 and t1[\"added_by\"] == \"alice\" and t1[\"duration\"] == 210, t1)\ncheck(\"track id int\", isinstance(t1[\"id\"], int), t1)\ncheck(\"track created_at str\", isinstance(t1[\"created_at\"], str) and t1[\"created_at\"], t1)\n\nr = c.post(\"/api/tracks\", json={\"title\": \"Song B\", \"artist\": \"Other\", \"url\": \"http://cdn.example.com/b.ogg\", \"duration\": 100.5}, headers=AUTH)\nt2 = r.get_json()\ncheck(\"add track 2 float duration\", r.status_code == 201 and t2[\"duration\"] == 100.5, r.data)\nr = c.post(\"/api/tracks\", json={\"title\": \"Search Me\", \"artist\": \"Solo\", \"url\": \"https://cdn.example.com/c.mp3\"}, headers=BOB)\nt3 = r.get_json()\ncheck(\"add track by bob (no duration)\", r.status_code == 201 and t3[\"added_by\"] == \"bob\" and t3[\"duration\"] == 0, r.data)\n\n# get one\nr = c.get(f\"/api/tracks/{t1['id']}\")\ncheck(\"get track\", r.status_code == 200 and r.get_json() == t1, r.data)\nr = c.get(\"/api/tracks/999999\")\ncheck(\"get missing 404\", r.status_code == 404, r.data)\nr = c.get(\"/api/tracks/abc\")\ncheck(\"get non-int 404 json\", r.status_code == 404 and r.is_json, (r.status_code, r.content_type, r.data[:80]))\nr = c.get(\"/api/whatever\")\ncheck(\"unknown api 404 json\", r.status_code == 404 and r.is_json, (r.status_code, r.content_type))\n\n# list: newest first, paging\nr = c.get(\"/api/tracks\")\nd = r.get_json()\ncheck(\"list shape\", set(d) == {\"items\", \"total\", \"page\", \"page_size\"}, d)\ncheck(\"list newest first\", [i[\"id\"] for i in d[\"items\"]] == [t3[\"id\"], t2[\"id\"], t1[\"id\"]], d)\ncheck(\"list totals\", d[\"total\"] == 3 and d[\"page\"] == 1 and d[\"page_size\"] == 10, d)\nr = c.get(\"/api/tracks?page=2&page_size=2\")\nd = r.get_json()\ncheck(\"list page 2 size 2\", [i[\"id\"] for i in d[\"items\"]] == [t1[\"id\"]] and d[\"total\"] == 3 and d[\"page\"] == 2 and d[\"page_size\"] == 2, d)\nr = c.get(\"/api/tracks?page=0&page_size=0\")\nd = r.get_json()\ncheck(\"list clamp paging\", d[\"page\"] == 1 and d[\"page_size\"] == 1, d)\nr = c.get(\"/api/tracks?q=search\")\ncheck(\"list q title\", r.get_json()[\"total\"] == 1 and r.get_json()[\"items\"][0][\"id\"] == t3[\"id\"], r.data)\nr = c.get(\"/api/tracks?q=OTHER\")\ncheck(\"list q artist ci\", r.get_json()[\"total\"] == 1 and r.get_json()[\"items\"][0][\"id\"] == t2[\"id\"], r.data)\nr = c.get(\"/api/tracks?q=zzz\")\ncheck(\"list q empty\", r.get_json() == {\"items\": [], \"total\": 0, \"page\": 1, \"page_size\": 10}, r.data)\nr = c.get(\"/api/tracks?q=%\")\ncheck(\"list q wildcard escaped\", r.get_json()[\"total\"] == 0, r.data)\n\n# plays\nr = c.post(f\"/api/tracks/{t1['id']}/plays\")\ncheck(\"play 200\", r.status_code == 200 and r.get_json()[\"play_count\"] == 1, r.data)\nr = c.post(f\"/api/tracks/{t1['id']}/plays\")\ncheck(\"play increments\", r.get_json()[\"play_count\"] == 2, r.data)\ncheck(\"play returns track\", r.get_json() == c.get(f\"/api/tracks/{t1['id']}\").get_json(), r.data)\nr = c.post(\"/api/tracks/999999/plays\")\ncheck(\"play missing 404\", r.status_code == 404, r.data)\n\n# delete\nr = c.delete(f\"/api/tracks/{t1['id']}\", headers=BOB)\ncheck(\"delete other's 403\", r.status_code == 403, r.data)\nr = c.delete(f\"/api/tracks/{t1['id']}\")\ncheck(\"delete unauth 401\", r.status_code == 401, r.data)\nr = c.delete(f\"/api/tracks/{t1['id']}\", headers=BAD)\ncheck(\"delete bad token 401\", r.status_code == 401, r.data)\nr = c.delete(\"/api/tracks/999999\", headers=AUTH)\ncheck(\"delete missing 404\", r.status_code == 404, r.data)\nr = c.delete(f\"/api/tracks/{t1['id']}\", headers=AUTH)\ncheck(\"delete own 204\", r.status_code == 204, r.data)\nr = c.get(f\"/api/tracks/{t1['id']}\")\ncheck(\"deleted gone\", r.status_code == 404, r.data)\n\n# raw body / weird inputs\nr = c.post(\"/api/auth/register\", data=\"not json\", content_type=\"text/plain\")\ncheck(\"register bad body 400\", r.status_code == 400, r.data)\nr = c.post(\"/api/tracks\", headers=AUTH, content_type=\"application/json\", data='{\"title\": \"x\", \"url\": \"https://a/b.mp3\", \"duration\": \"42\"}')\ncheck(\"duration numeric string ok\", r.status_code == 201 and r.get_json()[\"duration\"] == 42, r.data)\n\nprint()\nif fails:\n    print(\"FAILURES:\", fails)\n    sys.exit(1)\nprint(\"all good\")\n","filePath":"/workspace/_api_smoke.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/_api_smoke.py","exists":false,"truncated":false},"title":"_api_smoke.py","time":{"start":1794378033714,"end":1794378033730}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c943ea25001UPbupK02EOr7vO","sessionID":"ses_e36c0300cffeuhOocOqdZKOL18","messageID":"msg_1c943857a001pUFgUZWeuD71XB"}}
