{"type":"text","timestamp":1794372593555,"sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","part":{"id":"prt_1c8f0e77700114g89bDiLIavxS","messageID":"msg_1c8f08656001kTq7xvdsb5QM6H","sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","type":"text","text":"Now writing the Flask backend:","time":{"start":1794372593527,"end":1794372593550}}}
{"type":"tool_use","timestamp":1794372593595,"sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","part":{"type":"tool","tool":"write","callID":"call_3517b83c743145b1bb373ee5","state":{"status":"completed","input":{"content":"\"\"\"Sensor dashboard: JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"app.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS sensors (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    unit TEXT NOT NULL DEFAULT '',\n    location TEXT NOT NULL DEFAULT '',\n    owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    last_value REAL,\n    last_updated TEXT\n);\nCREATE TABLE IF NOT EXISTS readings (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n    value REAL NOT NULL,\n    recorded_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_readings_sensor_id ON readings (sensor_id, id);\n\"\"\"\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef sensor_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"last_value\": row[\"last_value\"],\n        \"last_updated\": row[\"last_updated\"],\n        \"owner\": row[\"username\"],\n    }\n\n\ndef reading_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"sensor_id\": row[\"sensor_id\"],\n        \"value\": row[\"value\"],\n        \"recorded_at\": row[\"recorded_at\"],\n    }\n\n\nSENSOR_SELECT = \"\"\"\nSELECT s.*, u.username AS username\nFROM sensors s JOIN users u ON u.id = s.owner_id\n\"\"\"\n\n\ndef get_sensor(sensor_id: int):\n    row = get_db().execute(SENSOR_SELECT + \" WHERE s.id = ?\", (sensor_id,)).fetchone()\n    return row\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef require_str(data: dict, field: str, required: bool = True):\n    value = data.get(field)\n    if value is None:\n        if required:\n            return None\n        return \"\"\n    if not isinstance(value, str) or (required and not value.strip()):\n        return None\n    return value\n\n\ndef current_user():\n    \"\"\"Return the user row for the Bearer token, or None.\"\"\"\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    token_hash = hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n    return (\n        get_db()\n        .execute(\n            \"SELECT u.* FROM users u JOIN tokens t ON t.user_id = u.id\"\n            \" WHERE t.token_hash = ?\",\n            (token_hash,),\n        )\n        .fetchone()\n    )\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n# ---------------------------------------------------------------- accounts\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = require_str(data, \"username\")\n    password = require_str(data, \"password\")\n    if username is None or password is None:\n        return error(\"username and password are required\", 400)\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already taken\", 400)\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = require_str(data, \"username\")\n    password = require_str(data, \"password\")\n    if username is None or password is None:\n        return error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token_hash, user_id) VALUES (?, ?)\",\n        (hashlib.sha256(token.encode(\"utf-8\")).hexdigest(), row[\"id\"]),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n# ---------------------------------------------------------------- sensors\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = get_db().execute(SENSOR_SELECT + \" ORDER BY s.name\").fetchall()\n    return jsonify({\"items\": [sensor_dict(r) for r in rows]})\n\n\n@app.post(\"/api/sensors\")\n@login_required\ndef create_sensor():\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    name = require_str(data, \"name\")\n    if name is None:\n        return error(\"name is required\", 400)\n    unit = require_str(data, \"unit\", required=False)\n    location = require_str(data, \"location\", required=False)\n    if unit is None or location is None:\n        return error(\"unit and location must be strings\", 400)\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO sensors (name, unit, location, owner_id) VALUES (?, ?, ?, ?)\",\n        (name, unit, location, g.user[\"id\"]),\n    )\n    db.commit()\n    row = get_sensor(cur.lastrowid)\n    return jsonify(sensor_dict(row)), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef get_sensor_route(sensor_id: int):\n    row = get_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    return jsonify(sensor_dict(row))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\n@login_required\ndef delete_sensor(sensor_id: int):\n    row = get_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    if row[\"owner_id\"] != g.user[\"id\"]:\n        return error(\"you do not own this sensor\", 403)\n    db = get_db()\n    db.execute(\"DELETE FROM readings WHERE sensor_id = ?\", (sensor_id,))\n    db.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------- readings\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id: int):\n    if get_sensor(sensor_id) is None:\n        return error(\"sensor not found\", 404)\n    limit_raw = request.args.get(\"limit\")\n    limit = None\n    if limit_raw is not None:\n        try:\n            limit = int(limit_raw)\n        except ValueError:\n            return error(\"limit must be an integer\", 400)\n        if limit < 0:\n            return error(\"limit must be non-negative\", 400)\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[\"n\"]\n    sql = \"SELECT * FROM readings WHERE sensor_id = ? ORDER BY recorded_at DESC, id DESC\"\n    params = [sensor_id]\n    if limit is not None:\n        sql += \" LIMIT ?\"\n        params.append(limit)\n    rows = db.execute(sql, params).fetchall()\n    return jsonify({\"items\": [reading_dict(r) for r in rows], \"total\": total})\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\n@login_required\ndef create_reading(sensor_id: int):\n    row = get_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    if row[\"owner_id\"] != g.user[\"id\"]:\n        return error(\"you do not own this sensor\", 403)\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    value = data.get(\"value\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return error(\"value must be a number\", 400)\n    recorded_at = now_iso()\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n        (sensor_id, float(value), recorded_at),\n    )\n    db.execute(\n        \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n        (float(value), recorded_at, sensor_id),\n    )\n    db.commit()\n    reading = db.execute(\n        \"SELECT * FROM readings WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(reading_dict(reading)), 201\n\n\n# ---------------------------------------------------------------- frontend\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794372593544,"end":1794372593577}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8f0e77a0010GDFGmKYwcWMxM","sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","messageID":"msg_1c8f08656001kTq7xvdsb5QM6H"}}
