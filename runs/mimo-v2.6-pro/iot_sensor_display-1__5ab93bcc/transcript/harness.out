{"type":"tool_use","timestamp":1794372773563,"sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","part":{"type":"tool","tool":"write","callID":"call_6313ad59b147487e986d5268","state":{"status":"completed","input":{"content":"export function timeAgo(iso: string | null): string {\n  if (!iso) return \"never\";\n  const then = new Date(iso).getTime();\n  if (Number.isNaN(then)) return \"unknown\";\n  const seconds = Math.max(0, Math.round((Date.now() - then) / 1000));\n  if (seconds < 5) return \"just now\";\n  if (seconds < 60) return `${seconds} seconds ago`;\n  const minutes = Math.round(seconds / 60);\n  if (minutes < 60) return `${minutes} minute${minutes === 1 ? \"\" : \"s\"} ago`;\n  const hours = Math.round(minutes / 60);\n  if (hours < 24) return `${hours} hour${hours === 1 ? \"\" : \"s\"} ago`;\n  const days = Math.round(hours / 24);\n  return `${days} day${days === 1 ? \"\" : \"s\"} ago`;\n}\n\nexport function formatValue(value: number | null, unit: string): string {\n  if (value === null) return \"—\";\n  return unit ? `${value} ${unit}` : String(value);\n}\n\nexport function formatTimestamp(iso: string): string {\n  const date = new Date(iso);\n  return Number.isNaN(date.getTime()) ? iso : date.toLocaleString();\n}\n","filePath":"/workspace/frontend/src/format.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/format.ts","exists":false,"truncated":false},"title":"frontend/src/format.ts","time":{"start":1794372773534,"end":1794372773558}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8f3a695001w2RLEMO0NfE0kl","sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","messageID":"msg_1c8f36223001xOlSAr7lcRGPfE"}}
{"type":"tool_use","timestamp":1794372773657,"sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","part":{"type":"tool","tool":"write","callID":"call_a117fcb14aff48d389defa57","state":{"status":"completed","input":{"content":"import { formatTimestamp } from \"../format\";\n\ninterface Point {\n  t: number;\n  v: number;\n}\n\nexport default function LineChart({ points, unit }: { points: Point[]; unit: string }) {\n  if (points.length === 0) {\n    return (\n      <div className=\"flex h-64 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-500\">\n        No readings to chart yet.\n      </div>\n    );\n  }\n\n  const width = 640;\n  const height = 240;\n  const padX = 56;\n  const padY = 28;\n  const values = points.map((p) => p.v);\n  let min = Math.min(...values);\n  let max = Math.max(...values);\n  if (min === max) {\n    min -= 1;\n    max += 1;\n  }\n  const times = points.map((p) => p.t);\n  const tMin = Math.min(...times);\n  const tMax = Math.max(...times);\n  const spanT = tMax - tMin || 1;\n\n  const x = (t: number) => padX + ((t - tMin) / spanT) * (width - 2 * padX);\n  const y = (v: number) => height - padY - ((v - min) / (max - min)) * (height - 2 * padY);\n\n  const coords = points.map((p) => `${x(p.t).toFixed(1)},${y(p.v).toFixed(1)}`);\n  const line = coords.join(\" \");\n\n  return (\n    <div className=\"rounded-lg border border-slate-200 bg-white p-4\">\n      <svg\n        viewBox={`0 0 ${width} ${height}`}\n        className=\"h-64 w-full\"\n        role=\"img\"\n        aria-label=\"Recent readings line chart\"\n      >\n        <line x1={padX} y1={height - padY} x2={width - padX} y2={height - padY} stroke=\"#cbd5e1\" />\n        <line x1={padX} y1={padY} x2={padX} y2={height - padY} stroke=\"#cbd5e1\" />\n        <text x={padX - 8} y={padY + 4} textAnchor=\"end\" className=\"fill-slate-500 text-xs\">\n          {Number(max.toFixed(2))}\n        </text>\n        <text x={padX - 8} y={height - padY + 4} textAnchor=\"end\" className=\"fill-slate-500 text-xs\">\n          {Number(min.toFixed(2))}\n        </text>\n        <text x={padX} y={height - 8} textAnchor=\"start\" className=\"fill-slate-500 text-xs\">\n          {formatTimestamp(new Date(tMin).toISOString())}\n        </text>\n        <text x={width - padX} y={height - 8} textAnchor=\"end\" className=\"fill-slate-500 text-xs\">\n          {formatTimestamp(new Date(tMax).toISOString())}\n        </text>\n        {points.length > 1 ? (\n          <polyline points={line} fill=\"none\" stroke=\"#4f46e5\" strokeWidth={2} />\n        ) : null}\n        {points.map((p, i) => (\n          <circle key={i} cx={x(p.t)} cy={y(p.v)} r={3} fill=\"#4f46e5\" />\n        ))}\n        {unit ? (\n          <text x={width - padX} y={padY + 4} textAnchor=\"end\" className=\"fill-slate-500 text-xs\">\n            {unit}\n          </text>\n        ) : null}\n      </svg>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/LineChart.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/LineChart.tsx","exists":false,"truncated":false},"title":"frontend/src/components/LineChart.tsx","time":{"start":1794372773547,"end":1794372773585}},"id":"prt_1c8f3a6a2001M1jQ87Tc43gwKi","sessionID":"ses_e3712c741ffef0xKKCekpEHVuO","messageID":"msg_1c8f36223001xOlSAr7lcRGPfE"}}
