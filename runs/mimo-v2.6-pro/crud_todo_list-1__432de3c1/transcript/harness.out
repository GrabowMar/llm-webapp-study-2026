{"type":"tool_use","timestamp":1794320581634,"sessionID":"ses_e3a3844d8ffehoyD00R8Nc4Z4v","part":{"type":"tool","tool":"write","callID":"call_e1594435e7314e5ba72b9743","state":{"status":"completed","input":{"content":"\"\"\"End-to-end API checks for the todo app (stdlib only).\"\"\"\n\nimport json\nimport sys\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nFAILURES = []\n\n\ndef req(method, path, body=None, token=None):\n    r = urllib.request.Request(BASE + path, method=method)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        r.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        r.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(r, data=data) as resp:\n            raw = resp.read()\n            status = resp.status\n    except urllib.error.HTTPError as e:\n        raw = e.read()\n        status = e.code\n    try:\n        parsed = json.loads(raw) if raw else None\n    except ValueError:\n        parsed = raw.decode() if raw else None\n    return status, parsed\n\n\ndef check(name, cond, extra=\"\"):\n    if cond:\n        print(f\"ok   {name}\")\n    else:\n        print(f\"FAIL {name} {extra}\")\n        FAILURES.append(name)\n\n\n# health\nstatus, body = req(\"GET\", \"/api/health\")\ncheck(\"health\", status == 200 and body == {\"status\": \"ok\"}, f\"{status} {body}\")\n\n# auth required\nstatus, body = req(\"GET\", \"/api/todos\")\ncheck(\"todos needs auth\", status == 401, status)\nstatus, _ = req(\"POST\", \"/api/todos\", {\"title\": \"x\"})\ncheck(\"create needs auth\", status == 401, status)\nstatus, _ = req(\"GET\", \"/api/todos/1\", token=\"bogus\")\ncheck(\"bad token 401\", status == 401, status)\n\n# register validation\nstatus, body = req(\"POST\", \"/api/auth/register\", {})\ncheck(\"register empty 400\", status == 400 and \"fields\" in body, f\"{status} {body}\")\nstatus, body = req(\"POST\", \"/api/auth/register\", {\"username\": \" \", \"password\": \"\"})\ncheck(\"register blank 400\", status == 400 and body.get(\"fields\", {}).get(\"username\"), f\"{status} {body}\")\nstatus, _ = req(\"POST\", \"/api/auth/register\", \"not an object\")\ncheck(\"register non-object 400\", status == 400, status)\n\n# register ok\nstatus, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret\"})\ncheck(\"register alice 201\", status == 201 and body.get(\"username\") == \"alice\", f\"{status} {body}\")\nstatus, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret\"})\ncheck(\"duplicate register fails\", status in (400, 409), f\"{status} {body}\")\nstatus, _ = req(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"hunter2\"})\ncheck(\"register bob 201\", status == 201, status)\n\n# login\nstatus, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong password 401\", status == 401, status)\nstatus, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"nobody\", \"password\": \"x\"})\ncheck(\"login unknown user 401\", status == 401, status)\nstatus, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret\"})\ncheck(\"login ok\", status == 200 and isinstance(body.get(\"token\"), str), f\"{status} {body}\")\nalice = body[\"token\"]\nstatus, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"hunter2\"})\nbob = body[\"token\"]\ncheck(\"login bob\", status == 200 and bool(bob), status)\n\n# create validation\nstatus, body = req(\"POST\", \"/api/todos\", {\"title\": \"\"}, alice)\ncheck(\"empty title 400\", status == 400 and body.get(\"fields\", {}).get(\"title\"), f\"{status} {body}\")\nstatus, body = req(\"POST\", \"/api/todos\", {\"title\": \"x\", \"priority\": \"banana\"}, alice)\ncheck(\"bad priority 400\", status == 400 and body.get(\"fields\", {}).get(\"priority\"), f\"{status} {body}\")\nstatus, body = req(\"POST\", \"/api/todos\", {\"title\": \"x\", \"due_date\": \"soon\"}, alice)\ncheck(\"bad due_date 400\", status == 400 and body.get(\"fields\", {}).get(\"due_date\"), f\"{status} {body}\")\nstatus, body = req(\"POST\", \"/api/todos\", {\"title\": \"x\", \"completed\": \"yes\"}, alice)\ncheck(\"bad completed 400\", status == 400 and body.get(\"fields\", {}).get(\"completed\"), f\"{status} {body}\")\n\n# create ok (full + minimal)\nstatus, full = req(\n    \"POST\",\n    \"/api/todos\",\n    {\n        \"title\": \"Plan trip\",\n        \"description\": \"Book trains\",\n        \"priority\": \"high\",\n        \"due_date\": \"2026-03-01\",\n    },\n    alice,\n)\ncheck(\"create full 201\", status == 201, f\"{status} {full}\")\nexpected_keys = {\"id\", \"title\", \"description\", \"priority\", \"due_date\", \"completed\", \"completed_at\", \"created_at\"}\ncheck(\"todo shape\", set(full) == expected_keys, sorted(full))\ncheck(\"todo values\", full[\"description\"] == \"Book trains\" and full[\"priority\"] == \"high\" and full[\"due_date\"] == \"2026-03-01\", full)\ncheck(\"completed false on create\", full[\"completed\"] is False and full[\"completed_at\"] is None, full)\n\nstatus, minimal = req(\"POST\", \"/api/todos\", {\"title\": \"Minimal\"}, alice)\ncheck(\"create minimal 201\", status == 201, f\"{status} {minimal}\")\ncheck(\"minimal defaults\", minimal[\"priority\"] == \"medium\" and minimal[\"description\"] is None and minimal[\"due_date\"] is None, minimal)\n\n# more todos for sorting: due date ordering, null due dates last, open first\nstatus, t2 = req(\"POST\", \"/api/todos\", {\"title\": \"Due earlier\", \"due_date\": \"2026-01-15\"}, alice)\nstatus, t3 = req(\"POST\", \"/api/todos\", {\"title\": \"No due date\"}, alice)\nstatus, t4 = req(\"POST\", \"/api/todos\", {\"title\": \"Already done\", \"due_date\": \"2025-12-01\", \"completed\": True}, alice)\ncheck(\"completed create sets completed_at\", t4[\"completed\"] is True and t4[\"completed_at\"], t4)\n\n# list ordering\nstatus, body = req(\"GET\", \"/api/todos\", token=alice)\ntitles = [i[\"title\"] for i in body[\"items\"]]\ncheck(\"list shape\", set(body) == {\"items\", \"total\", \"page\", \"page_size\", \"remaining\"}, body.keys())\ncheck(\n    \"list ordering\",\n    titles\n    == [\"Due earlier\", \"Plan trip\", \"Minimal\", \"No due date\", \"Already done\"],\n    titles,\n)\ncheck(\"list total\", body[\"total\"] == 5, body)\n\n# filters\nstatus, body = req(\"GET\", \"/api/todos?completed=false\", token=alice)\ncheck(\"open filter\", body[\"total\"] == 4 and all(not i[\"completed\"] for i in body[\"items\"]), body[\"total\"])\nstatus, body = req(\"GET\", \"/api/todos?completed=true\", token=alice)\ncheck(\"done filter\", body[\"total\"] == 1 and body[\"items\"][0][\"title\"] == \"Already done\", body[\"total\"])\nstatus, body = req(\"GET\", \"/api/todos?priority=high\", token=alice)\ncheck(\"priority filter\", body[\"total\"] == 1 and body[\"items\"][0][\"title\"] == \"Plan trip\", body[\"total\"])\nstatus, body = req(\"GET\", \"/api/todos?priority=banana\", token=alice)\ncheck(\"bad priority filter 400\", status == 400, status)\nstatus, body = req(\"GET\", \"/api/todos?completed=banana\", token=alice)\ncheck(\"bad completed filter 400\", status == 400, status)\n\n# paging\nstatus, body = req(\"GET\", \"/api/todos?page=1&page_size=2\", token=alice)\ncheck(\"page 1\", [i[\"title\"] for i in body[\"items\"]] == [\"Due earlier\", \"Plan trip\"], body[\"items\"])\ncheck(\"paging meta\", body[\"page\"] == 1 and body[\"page_size\"] == 2 and body[\"total\"] == 5 and body[\"remaining\"] == 3, body)\nstatus, body = req(\"GET\", \"/api/todos?page=3&page_size=2\", token=alice)\ncheck(\"page 3\", len(body[\"items\"]) == 1 and body[\"remaining\"] == 0, body)\nstatus, body = req(\"GET\", \"/api/todos?page=0&page_size=2\", token=alice)\ncheck(\"bad page 400\", status == 400, status)\n\n# get one\nstatus, one = req(\"GET\", f\"/api/todos/{full['id']}\", token=alice)\ncheck(\"get one\", status == 200 and one == full, one)\n\n# patch: only given fields change\nstatus, patched = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"title\": \"Plan trip!\"}, alice)\ncheck(\"patch title\", status == 200 and patched[\"title\"] == \"Plan trip!\", patched)\ncheck(\n    \"patch keeps rest\",\n    patched[\"description\"] == \"Book trains\"\n    and patched[\"priority\"] == \"high\"\n    and patched[\"due_date\"] == \"2026-03-01\"\n    and patched[\"completed\"] is False,\n    patched,\n)\n\n# completed_at lifecycle\nstatus, patched = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"completed\": True}, alice)\ncheck(\"complete sets completed_at\", patched[\"completed\"] is True and patched[\"completed_at\"] is not None, patched)\nstatus, patched = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"completed\": False}, alice)\ncheck(\"reopen clears completed_at\", patched[\"completed\"] is False and patched[\"completed_at\"] is None, patched)\n\n# patch misc fields\nstatus, patched = req(\n    \"PATCH\",\n    f\"/api/todos/{full['id']}\",\n    {\"description\": None, \"due_date\": None, \"priority\": \"low\"},\n    alice,\n)\ncheck(\"patch clear + priority\", status == 200 and patched[\"description\"] is None and patched[\"due_date\"] is None and patched[\"priority\"] == \"low\", patched)\nstatus, patched = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"due_date\": \"\"}, alice)\ncheck(\"empty due date clears\", patched[\"due_date\"] is None, patched)\nstatus, body = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"title\": \"\"}, alice)\ncheck(\"patch empty title 400\", status == 400 and body.get(\"fields\", {}).get(\"title\"), f\"{status} {body}\")\nstatus, patched = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"unknown_field\": 1}, alice)\ncheck(\"patch ignores unknown\", status == 200, status)\nstatus, patched = req(\"PATCH\", f\"/api/todos/{full['id']}\", {}, alice)\ncheck(\"patch empty ok\", status == 200 and patched[\"title\"] == \"Plan trip!\", patched)\n\n# isolation between users\nstatus, _ = req(\"GET\", f\"/api/todos/{full['id']}\", token=bob)\ncheck(\"other user get 404\", status == 404, status)\nstatus, _ = req(\"PATCH\", f\"/api/todos/{full['id']}\", {\"title\": \"stolen\"}, bob)\ncheck(\"other user patch 404\", status == 404, status)\nstatus, _ = req(\"DELETE\", f\"/api/todos/{full['id']}\", token=bob)\ncheck(\"other user delete 404\", status == 404, status)\nstatus, body = req(\"GET\", \"/api/todos\", token=bob)\ncheck(\"other user list empty\", status == 200 and body[\"items\"] == [] and body[\"total\"] == 0, body)\n\n# delete\nstatus, _ = req(\"DELETE\", f\"/api/todos/{t3['id']}\", token=alice)\ncheck(\"delete 204\", status == 204, status)\nstatus, _ = req(\"GET\", f\"/api/todos/{t3['id']}\", token=alice)\ncheck(\"deleted gone 404\", status == 404, status)\nstatus, body = req(\"GET\", \"/api/todos\", token=alice)\ncheck(\"total after delete\", body[\"total\"] == 4, body[\"total\"])\n\n# frontend served\nreq_path = urllib.request.Request(BASE + \"/\")\nwith urllib.request.urlopen(req_path) as resp:\n    html = resp.read().decode()\ncheck(\"index served\", resp.status == 200 and \"<div id=\\\"root\\\">\" in html, html[:80])\nstatus, body = req(\"GET\", \"/api/nope\")\ncheck(\"unknown api 404 json\", status == 404 and isinstance(body, dict), f\"{status} {body}\")\n\nprint()\nif FAILURES:\n    print(f\"{len(FAILURES)} FAILURES: {FAILURES}\")\n    sys.exit(1)\nprint(\"all checks passed\")\n","filePath":"/workspace/api_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/api_test.py","exists":false,"truncated":false},"title":"api_test.py","time":{"start":1794320581618,"end":1794320581631}},"id":"prt_1c5d743ed0014fUIp15CYUWLvK","sessionID":"ses_e3a3844d8ffehoyD00R8Nc4Z4v","messageID":"msg_1c5d67221001zisBaVBPoARVNO"}}
