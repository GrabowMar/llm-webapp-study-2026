{"type":"step_start","timestamp":1794322962796,"sessionID":"ses_e3a15e872fferShHubfyy4fOxe","part":{"id":"prt_1c5fb9948001jRycFu5GNhdj7o","messageID":"msg_1c5fb47a2001hVjaT3wMH07SH2","sessionID":"ses_e3a15e872fferShHubfyy4fOxe","type":"step-start"}}
{"type":"tool_use","timestamp":1794322962856,"sessionID":"ses_e3a15e872fferShHubfyy4fOxe","part":{"type":"tool","tool":"write","callID":"call_1a66993e6c0f4e859c9c562d","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport type { Recipe } from \"../types\";\n\nexport default function RecipeDetail() {\n  const { id } = useParams();\n  const recipeId = Number(id);\n  const { username } = useAuth();\n  const navigate = useNavigate();\n\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n  const [deleting, setDeleting] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(\"\");\n    setConfirming(false);\n    api.getRecipe(recipeId)\n      .then((r) => {\n        if (!cancelled) {\n          setRecipe(r);\n          setLoading(false);\n        }\n      })\n      .catch((err: unknown) => {\n        if (!cancelled) {\n          setError(err instanceof Error ? err.message : \"Could not load the recipe\");\n          setLoading(false);\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [recipeId]);\n\n  const performDelete = useCallback(async () => {\n    setDeleting(true);\n    setError(\"\");\n    try {\n      await api.deleteRecipe(recipeId);\n      navigate(\"/\");\n    } catch (err: unknown) {\n      setError(err instanceof Error ? err.message : \"Could not delete the recipe\");\n      setDeleting(false);\n      setConfirming(false);\n    }\n  }, [recipeId, navigate]);\n\n  function onDeleteClick() {\n    if (window.confirm(\"Delete this recipe? This cannot be undone.\")) {\n      void performDelete();\n    } else {\n      setConfirming(true);\n    }\n  }\n\n  if (loading) {\n    return <p className=\"py-10 text-center text-stone-500\">Loading recipe...</p>;\n  }\n\n  if (error && !recipe) {\n    return (\n      <div className=\"rounded-lg border border-stone-200 bg-white p-10 text-center\">\n        <p className=\"text-lg font-semibold text-stone-800\">{error}</p>\n        <Link\n          to=\"/\"\n          className=\"mt-4 inline-block rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700\"\n        >\n          Back to recipes\n        </Link>\n      </div>\n    );\n  }\n\n  if (!recipe) {\n    return null;\n  }\n\n  const isAuthor = username === recipe.author;\n\n  return (\n    <article>\n      <Link to=\"/\" className=\"text-sm font-medium text-emerald-700 hover:underline\">\n        &larr; Back to recipes\n      </Link>\n\n      <div className=\"mt-3 rounded-lg border border-stone-200 bg-white p-6 shadow-sm sm:p-8\">\n        <div className=\"flex flex-wrap items-start justify-between gap-4\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-stone-900\">{recipe.title}</h1>\n            <div className=\"mt-3 flex flex-wrap items-center gap-2 text-sm text-stone-600\">\n              <span className=\"rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800\">\n                {recipe.category}\n              </span>\n              <span>{recipe.prep_minutes} min prep</span>\n              <span>&middot;</span>\n              <span>\n                {recipe.servings} serving{recipe.servings === 1 ? \"\" : \"s\"}\n              </span>\n              <span>&middot;</span>\n              <span>\n                by <span className=\"font-medium text-stone-800\">{recipe.author}</span>\n              </span>\n            </div>\n          </div>\n          {isAuthor && (\n            <div className=\"flex flex-wrap items-center gap-2\">\n              <Link\n                to={`/recipes/${recipe.id}/edit`}\n                className=\"rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100\"\n              >\n                Edit\n              </Link>\n              <button\n                type=\"button\"\n                onClick={onDeleteClick}\n                className=\"rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700\"\n              >\n                Delete\n              </button>\n            </div>\n          )}\n        </div>\n\n        {confirming && (\n          <div className=\"mt-4 flex flex-wrap items-center gap-3 rounded-md border border-rose-200 bg-rose-50 px-4 py-3\">\n            <p className=\"text-sm font-medium text-rose-800\">\n              Really delete &ldquo;{recipe.title}&rdquo;? This cannot be undone.\n            </p>\n            <div className=\"ml-auto flex items-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => setConfirming(false)}\n                className=\"rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-100\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"button\"\n                disabled={deleting}\n                onClick={() => void performDelete()}\n                className=\"rounded-md bg-rose-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-rose-700 disabled:opacity-50\"\n              >\n                {deleting ? \"Deleting...\" : \"Yes, delete\"}\n              </button>\n            </div>\n          </div>\n        )}\n\n        {error && (\n          <div className=\"mt-4 rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700\">\n            {error}\n          </div>\n        )}\n\n        <div className=\"mt-8 grid gap-8 lg:grid-cols-[1fr_2fr]\">\n          <section>\n            <h2 className=\"text-lg font-semibold text-stone-900\">Ingredients</h2>\n            <ul className=\"mt-3 list-disc space-y-2 pl-5 text-stone-700\">\n              {recipe.ingredients.map((ingredient, index) => (\n                <li key={`${index}-${ingredient}`}>{ingredient}</li>\n              ))}\n            </ul>\n          </section>\n          <section>\n            <h2 className=\"text-lg font-semibold text-stone-900\">Instructions</h2>\n            <div className=\"mt-3 whitespace-pre-line leading-7 text-stone-700\">\n              {recipe.instructions}\n            </div>\n          </section>\n        </div>\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipeDetail.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipeDetail.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipeDetail.tsx","time":{"start":1794322962785,"end":1794322962804}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5fb994e001nr643zyFhIYLK3","sessionID":"ses_e3a15e872fferShHubfyy4fOxe","messageID":"msg_1c5fb47a2001hVjaT3wMH07SH2"}}
