{"type":"tool_use","timestamp":1794322891991,"sessionID":"ses_e3a15e872fferShHubfyy4fOxe","part":{"type":"tool","tool":"write","callID":"call_4e7121144eed48c5a60d4252","state":{"status":"completed","input":{"content":"export type RecipeSummary = {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number;\n  author: string;\n};\n\nexport type Recipe = {\n  id: number;\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: number;\n  servings: number;\n  created_at: string;\n  author: string;\n};\n\nexport type RecipePage = {\n  items: RecipeSummary[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type RecipeInput = {\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: number;\n  servings: number;\n};\n","filePath":"/workspace/frontend/src/types.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/types.ts","exists":false,"truncated":false},"title":"frontend/src/types.ts","time":{"start":1794322891938,"end":1794322891959}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5fa849d001GLAXg6ZCRNqERD","sessionID":"ses_e3a15e872fferShHubfyy4fOxe","messageID":"msg_1c5fa3e59001xsLxiU90wqzDgH"}}
{"type":"tool_use","timestamp":1794322891991,"sessionID":"ses_e3a15e872fferShHubfyy4fOxe","part":{"type":"tool","tool":"write","callID":"call_4addd3b208654847a2226617","state":{"status":"completed","input":{"content":"import type { Recipe, RecipeInput, RecipePage } from \"./types\";\n\nconst TOKEN_KEY = \"recipe_book_token\";\nconst USERNAME_KEY = \"recipe_book_username\";\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n\n  constructor(message: string, status: number, errors: Record<string, string> = {}) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function storeSession(token: string, username: string): void {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession(): void {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    ...((options.headers as Record<string, string>) ?? {}),\n  };\n  if (options.body) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n\n  const res = await fetch(path, { ...options, headers });\n  const text = await res.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n\n  if (!res.ok) {\n    const body = (data ?? {}) as { error?: string; errors?: Record<string, string> };\n    throw new ApiError(\n      body.error ?? `Request failed with status ${res.status}`,\n      res.status,\n      body.errors ?? {},\n    );\n  }\n  return data as T;\n}\n\nexport type ListParams = {\n  category?: string;\n  q?: string;\n  page?: number;\n  page_size?: number;\n};\n\nexport const api = {\n  register(username: string, password: string) {\n    return request<{ token: string; username: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    });\n  },\n\n  login(username: string, password: string) {\n    return request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    });\n  },\n\n  listRecipes(params: ListParams) {\n    const sp = new URLSearchParams();\n    if (params.category) sp.set(\"category\", params.category);\n    if (params.q) sp.set(\"q\", params.q);\n    if (params.page !== undefined) sp.set(\"page\", String(params.page));\n    if (params.page_size !== undefined) sp.set(\"page_size\", String(params.page_size));\n    const qs = sp.toString();\n    return request<RecipePage>(`/api/recipes${qs ? `?${qs}` : \"\"}`);\n  },\n\n  listCategories() {\n    return request<{ categories: string[] }>(\"/api/categories\");\n  },\n\n  getRecipe(id: number) {\n    return request<Recipe>(`/api/recipes/${id}`);\n  },\n\n  createRecipe(input: RecipeInput) {\n    return request<Recipe>(\"/api/recipes\", {\n      method: \"POST\",\n      body: JSON.stringify(input),\n    });\n  },\n\n  updateRecipe(id: number, input: RecipeInput) {\n    return request<Recipe>(`/api/recipes/${id}`, {\n      method: \"PUT\",\n      body: JSON.stringify(input),\n    });\n  },\n\n  deleteRecipe(id: number) {\n    return request<void>(`/api/recipes/${id}`, { method: \"DELETE\" });\n  },\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794322891945,"end":1794322891965}},"id":"prt_1c5fa84a4001RA7iEa34e6rjfx","sessionID":"ses_e3a15e872fferShHubfyy4fOxe","messageID":"msg_1c5fa3e59001xsLxiU90wqzDgH"}}
{"type":"tool_use","timestamp":1794322891991,"sessionID":"ses_e3a15e872fferShHubfyy4fOxe","part":{"type":"tool","tool":"write","callID":"call_dee6dce9db9f40dbb6d74c5c","state":{"status":"completed","input":{"content":"import {\n  createContext,\n  useCallback,\n  useContext,\n  useMemo,\n  useState,\n  type ReactNode,\n} from \"react\";\nimport { clearSession, getStoredUsername, getToken, storeSession } from \"./api\";\n\ntype AuthValue = {\n  token: string | null;\n  username: string | null;\n  signedIn: boolean;\n  signIn: (token: string, username: string) => void;\n  signOut: () => void;\n};\n\nconst AuthContext = createContext<AuthValue | null>(null);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [token, setToken] = useState<string | null>(() => getToken());\n  const [username, setUsername] = useState<string | null>(() => getStoredUsername());\n\n  const signIn = useCallback((newToken: string, newUsername: string) => {\n    storeSession(newToken, newUsername);\n    setToken(newToken);\n    setUsername(newUsername);\n  }, []);\n\n  const signOut = useCallback(() => {\n    clearSession();\n    setToken(null);\n    setUsername(null);\n  }, []);\n\n  const value = useMemo<AuthValue>(\n    () => ({ token, username, signedIn: token !== null, signIn, signOut }),\n    [token, username, signIn, signOut],\n  );\n\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n}\n\nexport function useAuth(): AuthValue {\n  const ctx = useContext(AuthContext);\n  if (!ctx) {\n    throw new Error(\"useAuth must be used within an AuthProvider\");\n  }\n  return ctx;\n}\n","filePath":"/workspace/frontend/src/auth.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/auth.tsx","exists":false,"truncated":false},"title":"frontend/src/auth.tsx","time":{"start":1794322891951,"end":1794322891970}},"id":"prt_1c5fa84ab001ec9KdrEdYpHKgl","sessionID":"ses_e3a15e872fferShHubfyy4fOxe","messageID":"msg_1c5fa3e59001xsLxiU90wqzDgH"}}
