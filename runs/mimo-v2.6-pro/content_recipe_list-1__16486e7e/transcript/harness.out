{"type":"tool_use","timestamp":1794322767445,"sessionID":"ses_e3a15e872fferShHubfyy4fOxe","part":{"type":"tool","tool":"write","callID":"call_039964a3d82041ff8ffd0cb4","state":{"status":"completed","input":{"content":"import json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nPASS = 0\nFAIL = 0\n\n\ndef call(method, path, body=None, token=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(req, data=data, timeout=10) as resp:\n            raw = resp.read()\n            return resp.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        raw = e.read()\n        try:\n            return e.code, (json.loads(raw) if raw else None)\n        except Exception:\n            return e.code, raw.decode(errors=\"replace\")\n\n\ndef check(name, cond, detail=\"\"):\n    global PASS, FAIL\n    if cond:\n        PASS += 1\n        print(f\"  ok  {name}\")\n    else:\n        FAIL += 1\n        print(f\"FAIL  {name} {detail}\")\n\n\n# health\ns, b = call(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and b == {\"status\": \"ok\"}, f\"{s} {b}\")\n\n# register\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret123\"})\ncheck(\"register 201\", s == 201, f\"{s} {b}\")\ntok_a = b[\"token\"]\ncheck(\"register token\", isinstance(tok_a, str) and len(tok_a) > 10)\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"})\ncheck(\"register duplicate 409\", s == 409, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", s == 400 and \"error\" in b, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\"})\ncheck(\"register missing password 400\", s == 400 and \"error\" in b, f\"{s} {b}\")\n\n# login\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret123\"})\ncheck(\"login 200\", s == 200 and set(b.keys()) == {\"token\"}, f\"{s} {b}\")\ntok_a2 = b[\"token\"]\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong password 401\", s == 401, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"nobody\", \"password\": \"x\"})\ncheck(\"login unknown user 401\", s == 401, f\"{s} {b}\")\n\n# register bob\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"bobpass\"})\ntok_b = b[\"token\"]\n\n# seed data\ns, b = call(\"GET\", \"/api/recipes\")\ncheck(\"list 200\", s == 200, f\"{s} {b}\")\ncheck(\"list keys\", set(b.keys()) == {\"items\", \"total\", \"page\", \"page_size\"}, f\"{b.keys()}\")\ncheck(\"seeds 3..5\", 3 <= b[\"total\"] <= 5, f\"total={b['total']}\")\nitems = b[\"items\"]\ncheck(\"item keys\", all(set(i.keys()) == {\"id\", \"title\", \"category\", \"prep_minutes\", \"author\"} for i in items), f\"{items}\")\ncats = {i[\"category\"] for i in items}\ncheck(\">=2 categories\", len(cats) >= 2, f\"{cats}\")\ncheck(\"no ingredients/instructions in items\", all(\"ingredients\" not in i and \"instructions\" not in i for i in items))\n\n# newest first\ns, b = call(\"GET\", \"/api/recipes\")\ndetails = [call(\"GET\", f\"/api/recipes/{i['id']}\")[1] for i in b[\"items\"]]\nts = [d[\"created_at\"] for d in details]\ncheck(\"newest first\", ts == sorted(ts, reverse=True), f\"{ts}\")\n\n# detail of a seed\nd = details[0]\ncheck(\"detail keys\", set(d.keys()) == {\"id\", \"title\", \"ingredients\", \"instructions\", \"category\", \"prep_minutes\", \"servings\", \"created_at\", \"author\"}, f\"{d.keys()}\")\ncheck(\"ingredients is list\", isinstance(d[\"ingredients\"], list) and len(d[\"ingredients\"]) > 1)\ncheck(\"instructions str\", isinstance(d[\"instructions\"], str) and \"\\n\" in d[\"instructions\"])\ncheck(\"author str\", isinstance(d[\"author\"], str))\n\n# 404\ns, b = call(\"GET\", \"/api/recipes/99999\")\ncheck(\"missing recipe 404\", s == 404 and \"error\" in b, f\"{s} {b}\")\ns, b = call(\"GET\", \"/api/recipes/abc\")\ncheck(\"bad id 404\", s == 404, f\"{s} {b}\")\n\n# create unauth\ns, b = call(\"POST\", \"/api/recipes\", {\"title\": \"x\"})\ncheck(\"create unauth 401\", s == 401, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/recipes\", {\"title\": \"x\"}, token=\"garbage\")\ncheck(\"create bad token 401\", s == 401, f\"{s} {b}\")\n\n# create\npayload = {\n    \"title\": \"  Grandma's Apple Pie  \",\n    \"ingredients\": [\"third cup\", \"second cup\", \"first cup\"],\n    \"instructions\": \"Line one\\nLine two\\n\\nLine four\",\n    \"category\": \"Dessert\",\n    \"prep_minutes\": 20,\n    \"servings\": 8,\n}\ns, b = call(\"POST\", \"/api/recipes\", payload, token=tok_a)\ncheck(\"create 201\", s == 201, f\"{s} {b}\")\npie = b\ncheck(\"create keys\", set(b.keys()) == {\"id\", \"title\", \"ingredients\", \"instructions\", \"category\", \"prep_minutes\", \"servings\", \"created_at\", \"author\"}, f\"{b.keys()}\")\ncheck(\"title stripped\", b[\"title\"] == \"Grandma's Apple Pie\", b[\"title\"])\ncheck(\"ingredient order kept\", b[\"ingredients\"] == payload[\"ingredients\"], b[\"ingredients\"])\ncheck(\"author is username\", b[\"author\"] == \"alice\", b[\"author\"])\ncheck(\"created_at present\", isinstance(b[\"created_at\"], str) and b[\"created_at\"])\npid = b[\"id\"]\n\n# validation errors\ns, b = call(\"POST\", \"/api/recipes\", {\"title\": \"\", \"ingredients\": [], \"instructions\": \"\", \"category\": \"\", \"prep_minutes\": -1, \"servings\": 0}, token=tok_a)\ncheck(\"create invalid 400\", s == 400 and \"error\" in b and \"errors\" in b, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/recipes\", {\"title\": \"t\", \"ingredients\": [\"\"], \"instructions\": \"i\", \"category\": \"c\", \"prep_minutes\": 1, \"servings\": 1}, token=tok_a)\ncheck(\"create empty ingredient 400\", s == 400, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/recipes\", {\"title\": \"t\", \"instructions\": \"i\", \"category\": \"c\", \"prep_minutes\": 1, \"servings\": 1}, token=tok_a)\ncheck(\"create missing ingredients 400\", s == 400, f\"{s} {b}\")\ns, b = call(\"POST\", \"/api/recipes\", {}, token=tok_a)\ncheck(\"create empty body 400\", s == 400, f\"{s} {b}\")\n\n# listing now has pie newest first\ns, b = call(\"GET\", \"/api/recipes\")\ncheck(\"total now 5\", b[\"total\"] == 5, f\"total={b['total']}\")\ncheck(\"new item first\", b[\"items\"][0][\"id\"] == pid, f\"{b['items'][0]}\")\n\n# filters\ns, b = call(\"GET\", \"/api/recipes?category=Dessert\")\ncheck(\"category filter\", b[\"total\"] == 2 and all(i[\"category\"] == \"Dessert\" for i in b[\"items\"]), f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?category=dessert\")\ncheck(\"category filter case-insensitive\", b[\"total\"] == 2, f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?category=Nope\")\ncheck(\"category no match\", b[\"total\"] == 0 and b[\"items\"] == [], f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?q=pie\")\ncheck(\"q filter\", b[\"total\"] == 1 and b[\"items\"][0][\"id\"] == pid, f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?q=PIE\")\ncheck(\"q case-insensitive\", b[\"total\"] == 1, f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?q=pie&category=Dessert\")\ncheck(\"q + category\", b[\"total\"] == 1, f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?q=zzz\")\ncheck(\"q no match\", b[\"total\"] == 0, f\"{b}\")\n\n# paging\ns, b = call(\"GET\", \"/api/recipes?page=1&page_size=2\")\ncheck(\"page_size respected\", len(b[\"items\"]) == 2 and b[\"page_size\"] == 2 and b[\"page\"] == 1 and b[\"total\"] == 5, f\"{b}\")\nfirst_ids = [i[\"id\"] for i in b[\"items\"]]\ns, b = call(\"GET\", \"/api/recipes?page=2&page_size=2\")\ncheck(\"page 2\", len(b[\"items\"]) == 2 and b[\"page\"] == 2, f\"{b}\")\ncheck(\"page 2 differs\", [i[\"id\"] for i in b[\"items\"]] != first_ids)\ns, b = call(\"GET\", \"/api/recipes?page=3&page_size=2\")\ncheck(\"page 3 partial\", len(b[\"items\"]) == 1, f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?page=10&page_size=2\")\ncheck(\"page beyond range\", b[\"items\"] == [] and b[\"total\"] == 5, f\"{b}\")\ns, b = call(\"GET\", \"/api/recipes?page=0\")\ncheck(\"page 0 -> 400\", s == 400, f\"{s} {b}\")\ns, b = call(\"GET\", \"/api/recipes?page=abc\")\ncheck(\"page abc -> 400\", s == 400, f\"{s} {b}\")\n\n# update: non-author\nnewp = dict(payload, title=\"Hacked\", ingredients=[\"only\"])\ns, b = call(\"PUT\", f\"/api/recipes/{pid}\", newp, token=tok_b)\ncheck(\"update non-author 403\", s == 403, f\"{s} {b}\")\ns, b = call(\"PUT\", f\"/api/recipes/{pid}\", newp)\ncheck(\"update unauth 401\", s == 401, f\"{s} {b}\")\ns, b = call(\"PUT\", \"/api/recipes/99999\", newp, token=tok_a)\ncheck(\"update missing 404\", s == 404, f\"{s} {b}\")\n\n# update invalid\ns, b = call(\"PUT\", f\"/api/recipes/{pid}\", dict(newp, title=\"\"), token=tok_a)\ncheck(\"update invalid 400\", s == 400 and \"error\" in b, f\"{s} {b}\")\n\n# update ok\nupd = {\n    \"title\": \"Apple Pie v2\",\n    \"ingredients\": [\"only one\"],\n    \"instructions\": \"New instructions\",\n    \"category\": \"Baking\",\n    \"prep_minutes\": 30,\n    \"servings\": 6,\n}\ns, b = call(\"PUT\", f\"/api/recipes/{pid}\", upd, token=tok_a)\ncheck(\"update 200\", s == 200, f\"{s} {b}\")\ncheck(\"update replaced\", b[\"title\"] == \"Apple Pie v2\" and b[\"ingredients\"] == [\"only one\"] and b[\"category\"] == \"Baking\" and b[\"prep_minutes\"] == 30 and b[\"servings\"] == 6 and b[\"instructions\"] == \"New instructions\", f\"{b}\")\ncheck(\"update keeps id/author/created_at\", b[\"id\"] == pid and b[\"author\"] == \"alice\" and b[\"created_at\"] == pie[\"created_at\"], f\"{b}\")\n\n# delete\ns, b = call(\"DELETE\", f\"/api/recipes/{pid}\", token=tok_b)\ncheck(\"delete non-author 403\", s == 403, f\"{s} {b}\")\ns, b = call(\"DELETE\", f\"/api/recipes/{pid}\")\ncheck(\"delete unauth 401\", s == 401, f\"{s} {b}\")\ns, b = call(\"DELETE\", f\"/api/recipes/{pid}\", token=tok_a)\ncheck(\"delete 204\", s == 204, f\"{s} {b}\")\ns, b = call(\"GET\", f\"/api/recipes/{pid}\")\ncheck(\"deleted -> 404\", s == 404, f\"{s} {b}\")\ns, b = call(\"GET\", \"/api/recipes\")\ncheck(\"total back to 4\", b[\"total\"] == 4, f\"{b['total']}\")\n\n# tokens: login again token also works\ns, b = call(\"GET\", \"/api/recipes\", token=tok_a2)\ncheck(\"second token works\", s == 200)\n\n# unknown api path\ns, b = call(\"GET\", \"/api/nope\")\ncheck(\"unknown api 404 json\", s == 404 and isinstance(b, dict), f\"{s} {b}\")\ns, b = call(\"GET\", \"/api/recipes/\")\ncheck(\"trailing slash recipes -> 404/200?\", s in (200, 404), f\"{s}\")\n\nprint(f\"\\n{PASS} passed, {FAIL} failed\")\nraise SystemExit(1 if FAIL else 0)\n","filePath":"/workspace/.smoke.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.smoke.py","exists":false,"truncated":false},"title":".smoke.py","time":{"start":1794322767420,"end":1794322767429}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f89e37001WulqgkEuX64lMi","sessionID":"ses_e3a15e872fferShHubfyy4fOxe","messageID":"msg_1c5f7cf10001rd0Z14GtwnRpP5"}}
