\"location\": \"HQ\", \"start_time\": \"2025-01-15T10:00:00\", \"end_time\": \"2025-01-15T10:30:00\"}, headers=auth)\neq(\"create ok\", r.status_code, 201)\nev1 = r.get_json()\neq(\"create id\", ev1[\"id\"], 1)\neq(\"create title\", ev1[\"title\"], \"Standup\")\neq(\"create description\", ev1[\"description\"], \"daily\")\neq(\"create location\", ev1[\"location\"], \"HQ\")\neq(\"create start UTC\", ev1[\"start_time\"], \"2025-01-15T10:00:00Z\")\neq(\"create end UTC\", ev1[\"end_time\"], \"2025-01-15T10:30:00Z\")\neq(\"create by\", ev1[\"created_by\"], \"alice\")\ncheck(\"create created_at Z\", ev1[\"created_at\"].endswith(\"Z\"), ev1[\"created_at\"])\n\n# offset conversion\nr = c.post(\"/api/events\", json={\"title\": \"Offset\", \"start_time\": \"2025-01-15T12:00:00+02:00\"}, headers=auth2)\nev2 = r.get_json()\neq(\"offset converted\", ev2[\"start_time\"], \"2025-01-15T10:00:00Z\")\neq(\"offset end cleared\", ev2[\"end_time\"], None)\neq(\"offset description cleared\", ev2[\"description\"], None)\neq(\"offset created_by\", ev2[\"created_by\"], \"bob\")\n\n# multi-day + later event for range tests\nr = c.post(\"/api/events\", json={\"title\": \"Conference\", \"start_time\": \"2025-02-01T09:00:00Z\", \"end_time\": \"2025-02-03T17:00:00Z\"}, headers=auth)\nev3 = r.get_json()\nr = c.post(\"/api/events\", json={\"title\": \"Late\", \"start_time\": \"2025-01-15T18:00:00Z\"}, headers=auth)\nev4 = r.get_json()\n\n# list\nr = c.get(\"/api/events\")\neq(\"list status\", r.status_code, 200)\nbody = r.get_json()\neq(\"list keys\", sorted(body.keys()), [\"items\", \"total\"])\neq(\"list total\", body[\"total\"], len(body[\"items\"]))\neq(\"list count\", body[\"total\"], 4)\ntitles = [e[\"title\"] for e in body[\"items\"]]\neq(\"list sorted\", titles, [\"Standup\", \"Offset\", \"Late\", \"Conference\"])\nitem_keys = {\"id\", \"title\", \"description\", \"location\", \"start_time\", \"end_time\", \"created_at\", \"created_by\"}\neq(\"item keys\", set(body[\"items\"][0].keys()), item_keys)\n\n# range filters\nr = c.get(\"/api/events?start_date=2025-01-15&end_date=2025-01-15\")\neq(\"range same day\", [e[\"title\"] for e in r.get_json()[\"items\"]], [\"Standup\", \"Offset\", \"Late\"])\nr = c.get(\"/api/events?start_date=2025-01-16&end_date=2025-01-20\")\neq(\"range empty\", r.get_json()[\"items\"], [])\nr = c.get(\"/api/events?start_date=2025-02-02&end_date=2025-02-02\")\neq(\"range mid multi-day\", [e[\"title\"] for e in r.get_json()[\"items\"]], [\"Conference\"])\nr = c.get(\"/api/events?start_date=2025-01-15T12:00:00Z&end_date=2025-01-15T23:59:59Z\")\neq(\"range datetime params\", [e[\"title\"] for e in r.get_json()[\"items\"]], [\"Late\"])\nr = c.get(\"/api/events?start_date=2025-01-10\")\neq(\"range only start\", [e[\"title\"] for e in r.get_json()[\"items\"]], [\"Standup\", \"Offset\", \"Late\", \"Conference\"])\nr = c.get(\"/api/events?end_date=2025-01-01\")\neq(\"range only end\", r.get_json()[\"items\"], [])\neq(\"range bad param\", c.get(\"/api/events?start_date=nope\").status_code, 400)\n\n# get one\nr = c.get(f\"/api/events/{ev1['id']}\")\neq(\"get one\", r.status_code, 200)\neq(\"get one body\", r.get_json()[\"title\"], \"Standup\")\neq(\"get missing\", c.get(\"/api/events/9999\").status_code, 404)\n\n# update\neq(\"update no auth\", c.put(f\"/api/events/{ev1['id']}\", json={\"title\": \"x\", \"start_time\": \"2025-01-15T10:00:00Z\"}).status_code, 401)\neq(\"update missing\", c.put(\"/api/events/9999\", json={\"title\": \"x\", \"start_time\": \"2025-01-15T10:00:00Z\"}, headers=auth).status_code, 404)\nr = c.put(f\"/api/events/{ev1['id']}\", json={\"title\": \"Standup v2\", \"start_time\": \"2025-01-16T11:00:00Z\", \"end_time\": \"2025-01-16T11:45:00Z\"}, headers=auth2)\neq(\"update ok\", r.status_code, 200)\nupd = r.get_json()\neq(\"update title\", upd[\"title\"], \"Standup v2\")\neq(\"update start\", upd[\"start_time\"], \"2025-01-16T11:00:00Z\")\neq(\"update end\", upd[\"end_time\"], \"2025-01-16T11:45:00Z\")\neq(\"update clears omitted\", upd[\"description\"], None)\neq(\"update clears location\", upd[\"location\"], None)\neq(\"update keeps created_by\", upd[\"created_by\"], \"alice\")\neq(\"update keeps created_at\", upd[\"created_at\"], ev1[\"created_at\"])\neq(\"update validation\", c.put(f\"/api/events/{ev1['id']}\", json={\"title\": \"\"}, headers=auth).status_code, 400)\n\n# delete\neq(\"delete no auth\", c.delete(f\"/api/events/{ev2['id']}\").status_code, 401)\neq(\"delete missing\", c.delete(\"/api/events/9999\", headers=auth).status_code, 404)\nr = c.delete(f\"/api/events/{ev2['id']}\", headers=auth)\ncheck(\"delete ok\", r.status_code in (200, 204), r.status_code)\neq(\"delete gone\", c.get(f\"/api/events/{ev2['id']}\").status_code, 404)\n\n# list without auth still public\neq(\"list public\", c.get(\"/api/events\").status_code, 200)\n\n# frontend fallbacks\neq(\"api 404 json\", c.get(\"/api/nope\").status_code, 404)\neq(\"root serves html\", c.get(\"/\").status_code, 200)\neq(\"spa fallback\", c.get(\"/some/route\").status_code, 200)\n\nprint()\nprint(\"FAILURES:\", fails if fails else \"none\")\nsys.exit(1 if fails else 0)\n","filePath":"/workspace/smoke_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/smoke_test.py","exists":false,"truncated":false},"title":"smoke_test.py","time":{"start":1794352703669,"end":1794352703678}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7c168b0001mZvVSzJ3kEsKlc","sessionID":"ses_e3845b02affe0w178ZlGocyT3G","messageID":"msg_1c7c11dd5001cFnf3uvX4bHckp"}}
