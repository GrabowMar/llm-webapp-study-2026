)\n    ~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/lib/python3/dist-packages/pip/_internal/utils/misc.py\", line 105, in ensure_dir\n    os.makedirs(path)\n    ~~~~~~~~~~~^^^^^^\n  File \"<frozen os>\", line 228, in makedirs\nPermissionError: [Errno 13] Permission denied: '/tmp/opencode/piptest'\nnpm notice PING http://172.30.98.2:4873/\nnpm notice PONG 30ms\n","exit":0,"truncated":false},"title":"pip download --no-deps -d /tmp/opencode/piptest flask==3.1.3 -q && ls /tmp/opencode/piptest; npm ping 2>&1 | tail -2","time":{"start":1794352327552,"end":1794352328407}},"id":"prt_1c7bbab7a001YZR03j85vi1UfX","sessionID":"ses_e3845b02affe0w178ZlGocyT3G","messageID":"msg_1c7bb91bd001rLusfw0HqL1o68"}}
