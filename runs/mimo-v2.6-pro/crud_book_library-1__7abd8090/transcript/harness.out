{"type":"step_start","timestamp":1794306195208,"sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","part":{"id":"prt_1c4fbbefa001c8DwXc7GHVRQ0t","messageID":"msg_1c4fb6bf4001Aq6162DWCG8jUs","sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","type":"step-start"}}
{"type":"tool_use","timestamp":1794306195229,"sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","part":{"type":"tool","tool":"write","callID":"call_8a9ae2b26c024ae2a89c63af","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\n\nimport { listBooks } from \"../api\";\nimport {\n  ErrorBox,\n  primaryButtonClass,\n  secondaryButtonClass,\n  inputClass,\n} from \"../components/ui\";\nimport type { Auth, Route } from \"../route\";\nimport type { Book } from \"../types\";\n\nconst PAGE_SIZE = 10;\n\nexport default function BookList({\n  auth,\n  navigate,\n}: {\n  auth: Auth | null;\n  navigate: (route: Route) => void;\n}) {\n  const [items, setItems] = useState<Book[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [pageSize, setPageSize] = useState(PAGE_SIZE);\n  const [query, setQuery] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    listBooks({ q: search || undefined, page, pageSize })\n      .then((data) => {\n        if (cancelled) return;\n        setItems(data.items);\n        setTotal(data.total);\n        setPageSize(data.page_size);\n        setError(null);\n      })\n      .catch((err: unknown) => {\n        if (!cancelled) setError(err instanceof Error ? err.message : \"Failed to load books\");\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [search, page, pageSize]);\n\n  const pageCount = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <div>\n      <div className=\"mb-4 flex flex-wrap items-center justify-between gap-3\">\n        <h1 className=\"text-2xl font-bold text-slate-900\">Books</h1>\n        {auth ? (\n          <button className={primaryButtonClass} onClick={() => navigate({ name: \"add\" })}>\n            Add book\n          </button>\n        ) : null}\n      </div>\n\n      <form\n        className=\"mb-4 flex flex-wrap items-center gap-2\"\n        onSubmit={(e) => {\n          e.preventDefault();\n          setPage(1);\n          setSearch(query.trim());\n        }}\n      >\n        <input\n          className={`${inputClass} flex-1 min-w-48`}\n          type=\"search\"\n          value={query}\n          placeholder=\"Search by title, author or ISBN\"\n          aria-label=\"Search books\"\n          onChange={(e) => setQuery(e.target.value)}\n        />\n        <button type=\"submit\" className={secondaryButtonClass}>\n          Search\n        </button>\n        {search ? (\n          <button\n            type=\"button\"\n            className={secondaryButtonClass}\n            onClick={() => {\n              setQuery(\"\");\n              setSearch(\"\");\n              setPage(1);\n            }}\n          >\n            Clear\n          </button>\n        ) : null}\n      </form>\n\n      <ErrorBox message={error} />\n\n      <div className=\"overflow-x-auto rounded-lg bg-white shadow\">\n        <table className=\"w-full border-collapse text-left\">\n          <thead>\n            <tr className=\"border-b border-slate-200 bg-slate-50 text-sm uppercase tracking-wide text-slate-500\">\n              <th className=\"px-4 py-3\">Title</th>\n              <th className=\"px-4 py-3\">Author</th>\n              <th className=\"px-4 py-3\">Year</th>\n              <th className=\"px-4 py-3\">Average rating</th>\n            </tr>\n          </thead>\n          <tbody>\n            {items.map((book) => (\n              <tr key={book.id} className=\"border-b border-slate-100 last:border-0 hover:bg-slate-50\">\n                <td className=\"px-4 py-3\">\n                  <button\n                    className=\"font-medium text-indigo-700 hover:underline\"\n                    onClick={() => navigate({ name: \"book\", id: book.id })}\n                  >\n                    {book.title}\n                  </button>\n                </td>\n                <td className=\"px-4 py-3 text-slate-700\">{book.author}</td>\n                <td className=\"px-4 py-3 text-slate-700\">{book.year ?? \"—\"}</td>\n                <td className=\"px-4 py-3 text-slate-700\">\n                  {book.average_rating === null ? \"No reviews\" : book.average_rating.toFixed(1)}\n                </td>\n              </tr>\n            ))}\n            {!loading && items.length === 0 ? (\n              <tr>\n                <td colSpan={4} className=\"px-4 py-8 text-center text-slate-500\">\n                  No books found.\n                </td>\n              </tr>\n            ) : null}\n          </tbody>\n        </table>\n      </div>\n\n      <div className=\"mt-4 flex items-center justify-between\">\n        <button\n          className={secondaryButtonClass}\n          disabled={page <= 1}\n          onClick={() => setPage((p) => Math.max(1, p - 1))}\n        >\n          Previous\n        </button>\n        <span className=\"text-sm text-slate-600\">\n          Page {page} of {pageCount} ({total} {total === 1 ? \"book\" : \"books\"})\n        </span>\n        <button\n          className={secondaryButtonClass}\n          disabled={page >= pageCount}\n          onClick={() => setPage((p) => p + 1)}\n        >\n          Next\n        </button>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/BookList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/BookList.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/BookList.tsx","time":{"start":1794306195202,"end":1794306195212}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4fbbefd001xrRQQxWAKNZUc7","sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","messageID":"msg_1c4fb6bf4001Aq6162DWCG8jUs"}}
