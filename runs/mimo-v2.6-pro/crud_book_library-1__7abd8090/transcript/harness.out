{"type":"text","timestamp":1794305704878,"sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","part":{"id":"prt_1c4f4439b001Mvg08huW9C6iOi","messageID":"msg_1c4f3be37001u9fZPLhDgqYPVc","sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","type":"text","text":"Now I'll write the backend:","time":{"start":1794305704859,"end":1794305704875}}}
{"type":"tool_use","timestamp":1794305704937,"sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","part":{"type":"tool","tool":"write","callID":"call_3c384610624b452f96975173","state":{"status":"completed","input":{"content":"\"\"\"Book library: JSON API under /api plus the frontend build.\"\"\"\n\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom decimal import ROUND_HALF_UP, Decimal\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"library.db\"\n\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Errors\n# ---------------------------------------------------------------------------\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n\n\ndef error_response(status: int, message: str):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(exc: ApiError):\n    return error_response(exc.status, exc.message)\n\n\n@app.errorhandler(404)\ndef handle_not_found(_exc):\n    return error_response(404, \"Not found\")\n\n\n@app.errorhandler(405)\ndef handle_method_not_allowed(_exc):\n    return error_response(405, \"Method not allowed\")\n\n\n@app.errorhandler(400)\ndef handle_bad_request(_exc):\n    return error_response(400, \"Bad request\")\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS books (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    author TEXT NOT NULL,\n    year INTEGER,\n    isbn TEXT,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS reviews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    rating INTEGER NOT NULL,\n    comment TEXT NOT NULL DEFAULT '',\n    created_at TEXT NOT NULL,\n    UNIQUE (book_id, user_id)\n);\n\"\"\"\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, check_same_thread=False)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.executescript(SCHEMA)\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Validation helpers\n# ---------------------------------------------------------------------------\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef require_str(data: dict, field: str, *, allow_empty: bool = False) -> str:\n    if field not in data or data[field] is None:\n        raise ApiError(400, f\"{field} is required\")\n    value = data[field]\n    if not isinstance(value, str):\n        raise ApiError(400, f\"{field} must be a string\")\n    value = value.strip()\n    if not allow_empty and not value:\n        raise ApiError(400, f\"{field} is required\")\n    return value\n\n\ndef optional_str(data: dict, field: str):\n    if field not in data or data[field] is None:\n        return None\n    value = data[field]\n    if not isinstance(value, str):\n        raise ApiError(400, f\"{field} must be a string\")\n    value = value.strip()\n    return value or None\n\n\ndef optional_int(data: dict, field: str, lo: int, hi: int):\n    if field not in data or data[field] is None:\n        return None\n    value = data[field]\n    if isinstance(value, bool):\n        raise ApiError(400, f\"{field} must be an integer\")\n    if isinstance(value, str):\n        if not re.fullmatch(r\"-?\\d+\", value.strip()):\n            raise ApiError(400, f\"{field} must be an integer\")\n        value = int(value.strip())\n    if isinstance(value, float):\n        if not value.is_integer():\n            raise ApiError(400, f\"{field} must be an integer\")\n        value = int(value)\n    if not isinstance(value, int):\n        raise ApiError(400, f\"{field} must be an integer\")\n    if value < lo or value > hi:\n        raise ApiError(400, f\"{field} must be between {lo} and {hi}\")\n    return value\n\n\n# ---------------------------------------------------------------------------\n# Auth\n# ---------------------------------------------------------------------------\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    match = re.fullmatch(r\"Bearer\\s+(.+)\", auth.strip(), re.IGNORECASE)\n    if not match:\n        raise ApiError(401, \"Authentication required\")\n    token = match.group(1).strip()\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t\"\n        \" JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    if row is None:\n        raise ApiError(401, \"Invalid or expired token\")\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = require_str(data, \"username\")\n    password = require_str(data, \"password\")\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        raise ApiError(400, \"Username already taken\")\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), utcnow()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = require_str(data, \"username\")\n    password = require_str(data, \"password\")\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n# ---------------------------------------------------------------------------\n# Books\n# ---------------------------------------------------------------------------\n\nBOOK_AGGREGATE = \"\"\"\nSELECT b.id, b.title, b.author, b.year, b.isbn, b.created_at,\n       COUNT(r.id) AS review_count,\n       AVG(r.rating) AS avg_rating\nFROM books b\nLEFT JOIN reviews r ON r.book_id = b.id\n\"\"\"\n\n\ndef serialize_book(row) -> dict:\n    count = row[\"review_count\"] or 0\n    avg = row[\"avg_rating\"]\n    if avg is None:\n        average_rating = None\n    else:\n        average_rating = float(\n            Decimal(str(avg)).quantize(Decimal(\"0.1\"), rounding=ROUND_HALF_UP)\n        )\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"author\": row[\"author\"],\n        \"year\": row[\"year\"],\n        \"isbn\": row[\"isbn\"],\n        \"created_at\": row[\"created_at\"],\n        \"review_count\": count,\n        \"average_rating\": average_rating,\n    }\n\n\ndef fetch_book(book_id: int) -> dict:\n    row = get_db().execute(\n        BOOK_AGGREGATE + \" WHERE b.id = ? GROUP BY b.id\", (book_id,)\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"Book not found\")\n    return serialize_book(row)\n\n\ndef parse_book_fields(data: dict) -> tuple:\n    title = require_str(data, \"title\")\n    author = require_str(data, \"author\")\n    year = optional_int(data, \"year\", 0, 9999)\n    isbn = optional_str(data, \"isbn\")\n    return title, author, year, isbn\n\n\n@app.get(\"/api/books\")\ndef list_books():\n    try:\n        page = int(request.args.get(\"page\", \"1\"))\n        page_size = int(request.args.get(\"page_size\", str(DEFAULT_PAGE_SIZE)))\n    except ValueError:\n        raise ApiError(400, \"page and page_size must be integers\")\n    if page < 1:\n        raise ApiError(400, \"page must be at least 1\")\n    if page_size < 1:\n        raise ApiError(400, \"page_size must be at least 1\")\n\n    q = request.args.get(\"q\", \"\").strip()\n    where = \"\"\n    params = []\n    if q:\n        where = \" WHERE b.title LIKE ? OR b.author LIKE ? OR b.isbn LIKE ?\"\n        like = f\"%{q}%\"\n        params = [like, like, like]\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM books b\" + where, params\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        BOOK_AGGREGATE\n        + where\n        + \" GROUP BY b.id ORDER BY b.created_at DESC, b.id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_book(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/books\")\ndef create_book():\n    current_user()\n    data = json_body()\n    title, author, year, isbn = parse_book_fields(data)\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO books (title, author, year, isbn, created_at) VALUES (?, ?, ?, ?, ?)\",\n        (title, author, year, isbn, utcnow()),\n    )\n    db.commit()\n    return jsonify(fetch_book(cur.lastrowid)), 201\n\n\n@app.get(\"/api/books/<int:book_id>\")\ndef get_book(book_id: int):\n    return jsonify(fetch_book(book_id))\n\n\n@app.put(\"/api/books/<int:book_id>\")\ndef replace_book(book_id: int):\n    current_user()\n    fetch_book(book_id)\n    data = json_body()\n    title, author, year, isbn = parse_book_fields(data)\n    db = get_db()\n    db.execute(\n        \"UPDATE books SET title = ?, author = ?, year = ?, isbn = ? WHERE id = ?\",\n        (title, author, year, isbn, book_id),\n    )\n    db.commit()\n    return jsonify(fetch_book(book_id))\n\n\n@app.delete(\"/api/books/<int:book_id>\")\ndef delete_book(book_id: int):\n    current_user()\n    db = get_db()\n    cur = db.execute(\"DELETE FROM books WHERE id = ?\", (book_id,))\n    db.commit()\n    if cur.rowcount == 0:\n        raise ApiError(404, \"Book not found\")\n    return jsonify({\"ok\": True})\n\n\n# ---------------------------------------------------------------------------\n# Reviews\n# ---------------------------------------------------------------------------\n\n\ndef serialize_review(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"book_id\": row[\"book_id\"],\n        \"rating\": row[\"rating\"],\n        \"comment\": row[\"comment\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": row[\"username\"],\n    }\n\n\n@app.get(\"/api/books/<int:book_id>/reviews\")\ndef list_reviews(book_id: int):\n    db = get_db()\n    exists = db.execute(\"SELECT id FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if exists is None:\n        raise ApiError(404, \"Book not found\")\n    rows = db.execute(\n        \"SELECT r.id, r.book_id, r.rating, r.comment, r.created_at, u.username\"\n        \" FROM reviews r JOIN users u ON u.id = r.user_id\"\n        \" WHERE r.book_id = ?\"\n        \" ORDER BY r.created_at DESC, r.id DESC\",\n        (book_id,),\n    ).fetchall()\n    return jsonify({\"items\": [serialize_review(row) for row in rows]})\n\n\n@app.post(\"/api/books/<int:book_id>/reviews\")\ndef create_review(book_id: int):\n    user = current_user()\n    db = get_db()\n    exists = db.execute(\"SELECT id FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if exists is None:\n        raise ApiError(404, \"Book not found\")\n    data = json_body()\n    rating = optional_int(data, \"rating\", 1, 5)\n    if rating is None:\n        raise ApiError(400, \"rating is required\")\n    comment = optional_str(data, \"comment\") or \"\"\n    duplicate = db.execute(\n        \"SELECT id FROM reviews WHERE book_id = ? AND user_id = ?\",\n        (book_id, user[\"id\"]),\n    ).fetchone()\n    if duplicate is not None:\n        raise ApiError(400, \"You have already reviewed this book\")\n    cur = db.execute(\n        \"INSERT INTO reviews (book_id, user_id, rating, comment, created_at)\"\n        \" VALUES (?, ?, ?, ?, ?)\",\n        (book_id, user[\"id\"], rating, comment, utcnow()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT r.id, r.book_id, r.rating, r.comment, r.created_at, u.username\"\n        \" FROM reviews r JOIN users u ON u.id = r.user_id WHERE r.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(serialize_review(row)), 201\n\n\n# ---------------------------------------------------------------------------\n# Health and frontend\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error_response(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794305704871,"end":1794305704919}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4f4439f0015d1D4twDRnIqbi","sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","messageID":"msg_1c4f3be37001u9fZPLhDgqYPVc"}}
