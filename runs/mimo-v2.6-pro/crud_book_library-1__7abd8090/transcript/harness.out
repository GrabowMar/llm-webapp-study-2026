import react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>App</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nexport default function App() {\n  return <h1>App</h1>;\n}\n**/node_modules\n**/.venv\n**/venv\n**/__pycache__\n**/*.pyc\n**/.git\nfrontend/dist\ndata/*.db\ndata/*.sqlite\ndata/*.sqlite3\n","exit":0,"truncated":false},"title":"cat /workspace/frontend/package.json /workspace/frontend/vite.config.ts /workspace/frontend/index.html /workspace/frontend/src/main.tsx /workspace/frontend/src/App.tsx /workspace/.dockerignore","time":{"start":1794305500895,"end":1794305501031}},"id":"prt_1c4f126c9001LyJNgcjL0FF5SW","sessionID":"ses_e3b0efd89ffeAYD3w6ttov37XP","messageID":"msg_1c4f11ba3001R7mwh1kwac9kvP"}}
