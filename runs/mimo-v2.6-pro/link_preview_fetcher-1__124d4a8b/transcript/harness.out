{"type":"tool_use","timestamp":1794365637205,"sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","part":{"type":"tool","tool":"read","callID":"call_8aa6a2824c2f4824b3b716eb","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Link bookmarking app with page previews.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import ipaddress\n6: import json\n7: import re\n8: import secrets\n9: import sqlite3\n10: import urllib.error\n11: import urllib.parse\n12: import urllib.request\n13: from datetime import datetime, timezone\n14: from functools import wraps\n15: from html.parser import HTMLParser\n16: from pathlib import Path\n17: from typing import Any, Callable\n18: \n19: from flask import Flask, Response, g, jsonify, request, send_from_directory\n20: from werkzeug.security import check_password_hash, generate_password_hash\n21: \n22: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n23: DATA_DIR = Path(\"data\")\n24: DB_PATH = DATA_DIR / \"app.db\"\n25: \n26: FETCH_TIMEOUT = 15\n27: MAX_BODY_BYTES = 5 * 1024 * 1024\n28: DEFAULT_PAGE_SIZE = 20\n29: MAX_PAGE_SIZE = 100\n30: USER_AGENT = \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"\n31: \n32: SCHEMA = \"\"\"\n33: CREATE TABLE IF NOT EXISTS users (\n34:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n35:     username TEXT NOT NULL UNIQUE,\n36:     password_hash TEXT NOT NULL\n37: );\n38: CREATE TABLE IF NOT EXISTS tokens (\n39:     token TEXT PRIMARY KEY,\n40:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n41: );\n42: CREATE TABLE IF NOT EXISTS previews (\n43:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n44:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n45:     url TEXT NOT NULL,\n46:     final_url TEXT NOT NULL DEFAULT '',\n47:     status_code INTEGER NOT NULL DEFAULT 0,\n48:     title TEXT NOT NULL DEFAULT '',\n49:     description TEXT NOT NULL DEFAULT '',\n50:     image_url TEXT NOT NULL DEFAULT '',\n51:     fetched_at TEXT NOT NULL\n52: );\n53: CREATE INDEX IF NOT EXISTS idx_previews_user ON previews(user_id, id);\n54: \"\"\"\n55: \n56: app = Flask(__name__, static_folder=None)\n57: \n58: \n59: # --------------------------------------------------------------------------\n60: # database\n61: # --------------------------------------------------------------------------\n62: \n63: \n64: def init_db() -> None:\n65:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n66:     with sqlite3.connect(DB_PATH) as conn:\n67:         conn.executescript(SCHEMA)\n68: \n69: \n70: def get_db() -> sqlite3.Connection:\n71:     if \"db\" not in g:\n72:         conn = sqlite3.connect(DB_PATH)\n73:         conn.row_factory = sqlite3.Row\n74:         conn.execute(\"PRAGMA foreign_keys = ON\")\n75:         g.db = conn\n76:     return g.db\n77: \n78: \n79: @app.teardown_appcontext\n80: def close_db(_exc: BaseException | None) -> None:\n81:     conn = g.pop(\"db\", None)\n82:     if conn is not None:\n83:         conn.close()\n84: \n85: \n86: # --------------------------------------------------------------------------\n87: # helpers\n88: # --------------------------------------------------------------------------\n89: \n90: \n91: def utcnow() -> str:\n92:     return datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n93: \n94: \n95: def clean_text(value: str) -> str:\n96:     \"\"\"Turn text taken from a fetched page into plain text.\"\"\"\n97:     value = re.sub(r\"<[^>]*>\", \" \", value)\n98:     value = re.sub(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]\", \" \", value)\n99:     return re.sub(r\"\\s+\", \" \", value).strip()\n100: \n101: \n102: def preview_dict(row: sqlite3.Row) -> dict[str, Any]:\n103:     return {\n104:         \"id\": row[\"id\"],\n105:         \"url\": row[\"url\"],\n106:         \"final_url\": row[\"final_url\"],\n107:         \"status_code\": row[\"status_code\"],\n108:         \"title\": row[\"title\"],\n109:         \"description\": row[\"description\"],\n110:         \"image_url\": row[\"image_url\"],\n111:         \"fetched_at\": row[\"fetched_at\"],\n112:     }\n113: \n114: \n115: def error(message: str, status: int) -> tuple[Response, int]:\n116:     return jsonify({\"error\": message}), status\n117: \n118: \n119: def get_json_body() -> dict[str, Any]:\n120:     data = request.get_json(silent=True)\n121:     if isinstance(data, dict):\n122:         return data\n123:     if request.data:\n124:         try:\n125:             parsed = json.loads(request.data)\n126:         except ValueError:\n127:             parsed = None\n128:         if isinstance(parsed, dict):\n129:             return parsed\n130:     return {}\n131: \n132: \n133: class PageParser(HTMLParser):\n134:     \"\"\"Extracts <title> and interesting <meta> values from an HTML page.\"\"\"\n135: \n136:     def __init__(self) -> None:\n137:         super().__init__(convert_charrefs=True)\n138:         self._in_title = False\n139:         self._title_parts: list[str] = []\n140:         self.meta: dict[str, str] = {}\n141: \n142:     def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:\n143:         tag = tag.lower()\n144:         if tag == \"title\":\n145:             self._in_title = True\n146:             return\n147:         if tag != \"meta\":\n148:             return\n149:         data = {key.lower(): value for key, value in attrs if value is not None}\n150:         name = (data.get(\"property\") or data.get(\"name\") or \"\").strip().lower()\n151:         content = data.get(\"content\")\n152:         if name and content is not None and name not in self.meta:\n153:             self.meta[name] = content\n154: \n155:     def handle_endtag(self, tag: str) -> None:\n156:         if tag.lower() == \"title\":\n157:             self._in_title = False\n158: \n159:     def handle_data(self, data: str) -> None:\n160:         if self._in_title:\n161:             self._title_parts.append(data)\n162: \n163:     @property\n164:     def title(self) -> str:\n165:         return clean_text(\"\".join(self._title_parts))\n166: \n167: \n168: def decode_body(body: bytes, charset: str | None) -> str:\n169:     candidates: list[str] = []\n170:     if charset:\n171:         candidates.append(charset)\n172:     head = body[:4096].decode(\"ascii\", errors=\"replace\")\n173:     match = re.search(r\"charset=[\\\"']?([\\w.:-]+)\", head, re.IGNORECASE)\n174:     if match:\n175:         candidates.append(match.group(1))\n176:     candidates.append(\"utf-8\")\n177:     for encoding in candidates:\n178:         try:\n179:             return body.decode(encoding)\n180:         except (LookupError, UnicodeDecodeError):\n181:             continue\n182:     return body.decode(\"utf-8\", errors=\"replace\")\n183: \n184: \n185: def is_loopback(host: str) -> bool:\n186:     if host == \"localhost\":\n187:         return True\n188:     try:\n189:         return ipaddress.ip_address(host).is_loopback\n190:     except ValueError:\n191:         return False\n192: \n193: \n194: def fetch_page(url: str) -> dict[str, Any]:\n195:     \"\"\"Fetch ``url`` and build preview values from the returned page.\"\"\"\n196:     parts = urllib.parse.urlsplit(url)\n197:     if parts.scheme not in (\"http\", \"https\") or not parts.netloc:\n198:         raise ValueError(\"url must be an absolute http(s) URL\")\n199: \n200:     request_ = urllib.request.Request(\n201:         url,\n202:         headers={\n203:             \"User-Agent\": USER_AGENT,\n204:             \"Accept\": \"text/html,application/xhtml+xml;q=0.9,*/*;q=0.8\",\n205:         },\n206:     )\n207:     if is_loopback(parts.hostname or \"\"):\n208:         opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))\n209:     else:\n210:         opener = urllib.request.build_opener()\n211: \n212:     charset: str | None = None\n213:     try:\n214:         with opener.open(request_, timeout=FETCH_TIMEOUT) as response:\n215:             body = response.read(MAX_BODY_BYTES)\n216:             status_code = response.status\n217:             final_url = response.geturl()\n218:             charset = response.headers.get_content_charset()\n219:     except urllib.error.HTTPError as exc:\n220:         body = exc.read(MAX_BODY_BYTES)\n221:         status_code = exc.code\n222:         final_url = exc.geturl() or url\n223:         if exc.headers is not None:\n224:             charset = exc.headers.get_content_charset()\n225: \n226:     parser = PageParser()\n227:     try:\n228:         parser.feed(decode_body(body, charset))\n229:         parser.close()\n230:     except Exception:\n231:         pass\n232: \n233:     title = clean_text(parser.meta.get(\"og:title\", \"\")) or parser.title\n234:     description = clean_text(\n235:         parser.meta.get(\"og:description\", \"\") or parser.meta.get(\"description\", \"\")\n236:     )\n237:     image = clean_text(parser.meta.get(\"og:image\", \"\"))\n238:     image_url = urllib.parse.urljoin(final_url, image) if image else \"\"\n239: \n240:     return {\n241:         \"final_url\": final_url,\n242:         \"status_code\": status_code,\n243:         \"title\": title,\n244:         \"description\": description,\n245:         \"image_url\": image_url,\n246:         \"fetched_at\": utcnow(),\n247:     }\n248: \n249: \n250: # --------------------------------------------------------------------------\n251: # auth\n252: # --------------------------------------------------------------------------\n253: \n254: \n255: def current_user() -> sqlite3.Row | None:\n256:     header = request.headers.get(\"Authorization\", \"\")\n257:     scheme, _, token = header.partition(\" \")\n258:     if scheme.lower() != \"bearer\" or not token.strip():\n259:         return None\n260:     return (\n261:         get_db()\n262:         .execute(\n263:             \"SELECT u.id, u.username FROM tokens t\"\n264:             \" JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n265:             (token.strip(),),\n266:         )\n267:         .fetchone()\n268:     )\n269: \n270: \n271: def login_required(view: Callable[..., Any]) -> Callable[..., Any]:\n272:     @wraps(view)\n273:     def wrapped(*args: Any, **kwargs: Any) -> Any:\n274:         user = current_user()\n275:         if user is None:\n276:             return error(\"authentication required\", 401)\n277:         return view(user, *args, **kwargs)\n278: \n279:     return wrapped\n280: \n281: \n282: @app.post(\"/api/auth/register\")\n283: def register():\n284:     data = get_json_body()\n285:     username = data.get(\"username\")\n286:     password = data.get(\"password\")\n287:     if not isinstance(username, str) or not isinstance(password, str):\n288:         return error(\"username and password are required\", 400)\n289:     username = username.strip()\n290:     if not username or not password:\n291:         return error(\"username and password are required\", 400)\n292:     db = get_db()\n293:     try:\n294:         db.execute(\n295:             \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n296:             (username, generate_password_hash(password)),\n297:         )\n298:         db.commit()\n299:     except sqlite3.IntegrityError:\n300:         return error(\"username already taken\", 409)\n301:     return jsonify({\"username\": username}), 201\n302: \n303: \n304: @app.post(\"/api/auth/login\")\n305: def login():\n306:     data = get_json_body()\n307:     username = data.get(\"username\")\n308:     password = data.get(\"password\")\n309:     if not isinstance(username, str) or not isinstance(password, str):\n310:         return error(\"username and password are required\", 400)\n311:     row = get_db().execute(\n312:         \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n313:     ).fetchone()\n314:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n315:         return error(\"invalid credentials\", 401)\n316:     token = secrets.token_urlsafe(32)\n317:     db = get_db()\n318:     db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, row[\"id\"]))\n319:     db.commit()\n320:     return jsonify({\"token\": token})\n321: \n322: \n323: # --------------------------------------------------------------------------\n324: # previews\n325: # --------------------------------------------------------------------------\n326: \n327: \n328: def get_user_preview(user_id: int, preview_id: int) -> sqlite3.Row | None:\n329:     return (\n330:         get_db()\n331:         .execute(\n332:             \"SELECT * FROM previews WHERE id = ? AND user_id = ?\", (preview_id, user_id)\n333:         )\n334:         .fetchone()\n335:     )\n336: \n337: \n338: def store_preview(user_id: int, url: str, fetched: dict[str, Any], preview_id: int | None = None) -> sqlite3.Row:\n339:     db = get_db()\n340:     if preview_id is None:\n341:         cursor = db.execute(\n342:             \"INSERT INTO previews\"\n343:             \" (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\"\n344:             \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n345:             (\n346:                 user_id,\n347:                 url,\n348:                 fetched[\"final_url\"],\n349:                 fetched[\"status_code\"],\n350:                 fetched[\"title\"],\n351:                 fetched[\"description\"],\n352:                 fetched[\"image_url\"],\n353:                 fetched[\"fetched_at\"],\n354:             ),\n355:         )\n356:         preview_id = cursor.lastrowid\n357:     else:\n358:         db.execute(\n359:             \"UPDATE previews SET final_url = ?, status_code = ?, title = ?,\"\n360:             \" description = ?, image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n361:             (\n362:                 fetched[\"final_url\"],\n363:                 fetched[\"status_code\"],\n364:                 fetched[\"title\"],\n365:                 fetched[\"description\"],\n366:                 fetched[\"image_url\"],\n367:                 fetched[\"fetched_at\"],\n368:                 preview_id,\n369:                 user_id,\n370:             ),\n371:         )\n372:     db.commit()\n373:     return db.execute(\"SELECT * FROM previews WHERE id = ?\", (preview_id,)).fetchone()\n374: \n375: \n376: @app.post(\"/api/previews\")\n377: @login_required\n378: def create_preview(user: sqlite3.Row):\n379:     data = get_json_body()\n380:     url = data.get(\"url\")\n381:     if not isinstance(url, str) or not url.strip():\n382:         return error(\"url is required\", 400)\n383:     url = url.strip()\n384:     try:\n385:         fetched = fetch_page(url)\n386:     except ValueError:\n387:         return error(\"url must be an absolute http(s) URL\", 400)\n388:     except Exception:\n389:         return error(\"could not fetch url\", 502)\n390:     row = store_preview(user[\"id\"], url, fetched)\n391:     return jsonify(preview_dict(row)), 201\n392: \n393: \n394: @app.get(\"/api/previews\")\n395: @login_required\n396: def list_previews(user: sqlite3.Row):\n397:     try:\n398:         page = int(request.args.get(\"page\", \"1\"))\n399:     except ValueError:\n400:         page = 1\n401:     try:\n402:         page_size = int(request.args.get(\"page_size\", str(DEFAULT_PAGE_SIZE)))\n403:     except ValueError:\n404:         page_size = DEFAULT_PAGE_SIZE\n405:     page = max(page, 1)\n406:     page_size = min(max(page_size, 1), MAX_PAGE_SIZE)\n407: \n408:     db = get_db()\n409:     total = db.execute(\n410:         \"SELECT COUNT(*) AS c FROM previews WHERE user_id = ?\", (user[\"id\"],)\n411:     ).fetchone()[\"c\"]\n412:     rows = db.execute(\n413:         \"SELECT * FROM previews WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n414:         (user[\"id\"], page_size, (page - 1) * page_size),\n415:     ).fetchall()\n416:     return jsonify(\n417:         {\n418:             \"items\": [preview_dict(row) for row in rows],\n419:             \"total\": total,\n420:             \"page\": page,\n421:             \"page_size\": page_size,\n422:         }\n423:     )\n424: \n425: \n426: @app.get(\"/api/previews/<int:preview_id>\")\n427: @login_required\n428: def get_preview(user: sqlite3.Row, preview_id: int):\n429:     row = get_user_preview(user[\"id\"], preview_id)\n430:     if row is None:\n431:         return error(\"preview not found\", 404)\n432:     return jsonify(preview_dict(row))\n433: \n434: \n435: @app.post(\"/api/previews/<int:preview_id>/refresh\")\n436: @login_required\n437: def refresh_preview(user: sqlite3.Row, preview_id: int):\n438:     row = get_user_preview(user[\"id\"], preview_id)\n439:     if row is None:\n440:         return error(\"preview not found\", 404)\n441:     try:\n442:         fetched = fetch_page(row[\"url\"])\n443:     except ValueError:\n444:         return error(\"url must be an absolute http(s) URL\", 400)\n445:     except Exception:\n446:         return error(\"could not fetch url\", 502)\n447:     row = store_preview(user[\"id\"], row[\"url\"], fetched, preview_id=preview_id)\n448:     return jsonify(preview_dict(row))\n449: \n450: \n451: @app.delete(\"/api/previews/<int:preview_id>\")\n452: @login_required\n453: def delete_preview(user: sqlite3.Row, preview_id: int):\n454:     db = get_db()\n455:     cursor = db.execute(\n456:         \"DELETE FROM previews WHERE id = ? AND user_id = ?\", (preview_id, user[\"id\"])\n457:     )\n458:     db.commit()\n459:     if cursor.rowcount == 0:\n460:         return error(\"preview not found\", 404)\n461:     return \"\", 204\n462: \n463: \n464: # --------------------------------------------------------------------------\n465: # health + frontend\n466: # --------------------------------------------------------------------------\n467: \n468: \n469: @app.get(\"/api/health\")\n470: def health():\n471:     return {\"status\": \"ok\"}\n472: \n473: \n474: @app.get(\"/\")\n475: @app.get(\"/<path:path>\")\n476: def frontend(path: str = \"index.html\"):\n477:     if path.startswith(\"api/\"):\n478:         return error(\"not found\", 404)\n479:     if (DIST / path).is_file():\n480:         return send_from_directory(DIST, path)\n481:     return send_from_directory(DIST, \"index.html\")\n482: \n483: \n484: init_db()\n\n(End of file - total 484 lines)\n</content>","metadata":{"preview":"\"\"\"Link bookmarking app with page previews.\"\"\"\n\nfrom __future__ import annotations\n\nimport ipaddress\nimport json\nimport re\nimport secrets\nimport sqlite3\nimport urllib.error\nimport urllib.parse\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Link bookmarking app with page previews.\"\"\"\n\nfrom __future__ import annotations\n\nimport ipaddress\nimport json\nimport re\nimport secrets\nimport sqlite3\nimport urllib.error\nimport urllib.parse\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\nFETCH_TIMEOUT = 15\nMAX_BODY_BYTES = 5 * 1024 * 1024\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\nUSER_AGENT = \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS previews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    url TEXT NOT NULL,\n    final_url TEXT NOT NULL DEFAULT '',\n    status_code INTEGER NOT NULL DEFAULT 0,\n    title TEXT NOT NULL DEFAULT '',\n    description TEXT NOT NULL DEFAULT '',\n    image_url TEXT NOT NULL DEFAULT '',\n    fetched_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_previews_user ON previews(user_id, id);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# database\n# --------------------------------------------------------------------------\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with sqlite3.connect(DB_PATH) as conn:\n        conn.executescript(SCHEMA)\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n\n\ndef clean_text(value: str) -> str:\n    \"\"\"Turn text taken from a fetched page into plain text.\"\"\"\n    value = re.sub(r\"<[^>]*>\", \" \", value)\n    value = re.sub(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]\", \" \", value)\n    return re.sub(r\"\\s+\", \" \", value).strip()\n\n\ndef preview_dict(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\ndef error(message: str, status: int) -> tuple[Response, int]:\n    return jsonify({\"error\": message}), status\n\n\ndef get_json_body() -> dict[str, Any]:\n    data = request.get_json(silent=True)\n    if isinstance(data, dict):\n        return data\n    if request.data:\n        try:\n            parsed = json.loads(request.data)\n        except ValueError:\n            parsed = None\n        if isinstance(parsed, dict):\n            return parsed\n    return {}\n\n\nclass PageParser(HTMLParser):\n    \"\"\"Extracts <title> and interesting <meta> values from an HTML page.\"\"\"\n\n    def __init__(self) -> None:\n        super().__init__(convert_charrefs=True)\n        self._in_title = False\n        self._title_parts: list[str] = []\n        self.meta: dict[str, str] = {}\n\n    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:\n        tag = tag.lower()\n        if tag == \"title\":\n            self._in_title = True\n            return\n        if tag != \"meta\":\n            return\n        data = {key.lower(): value for key, value in attrs if value is not None}\n        name = (data.get(\"property\") or data.get(\"name\") or \"\").strip().lower()\n        content = data.get(\"content\")\n        if name and content is not None and name not in self.meta:\n            self.meta[name] = content\n\n    def handle_endtag(self, tag: str) -> None:\n        if tag.lower() == \"title\":\n            self._in_title = False\n\n    def handle_data(self, data: str) -> None:\n        if self._in_title:\n            self._title_parts.append(data)\n\n    @property\n    def title(self) -> str:\n        return clean_text(\"\".join(self._title_parts))\n\n\ndef decode_body(body: bytes, charset: str | None) -> str:\n    candidates: list[str] = []\n    if charset:\n        candidates.append(charset)\n    head = body[:4096].decode(\"ascii\", errors=\"replace\")\n    match = re.search(r\"charset=[\\\"']?([\\w.:-]+)\", head, re.IGNORECASE)\n    if match:\n        candidates.append(match.group(1))\n    candidates.append(\"utf-8\")\n    for encoding in candidates:\n        try:\n            return body.decode(encoding)\n        except (LookupError, UnicodeDecodeError):\n            continue\n    return body.decode(\"utf-8\", errors=\"replace\")\n\n\ndef is_loopback(host: str) -> bool:\n    if host == \"localhost\":\n        return True\n    try:\n        return ipaddress.ip_address(host).is_loopback\n    except ValueError:\n        return False\n\n\ndef fetch_page(url: str) -> dict[str, Any]:\n    \"\"\"Fetch ``url`` and build preview values from the returned page.\"\"\"\n    parts = urllib.parse.urlsplit(url)\n    if parts.scheme not in (\"http\", \"https\") or not parts.netloc:\n        raise ValueError(\"url must be an absolute http(s) URL\")\n\n    request_ = urllib.request.Request(\n        url,\n        headers={\n            \"User-Agent\": USER_AGENT,\n            \"Accept\": \"text/html,application/xhtml+xml;q=0.9,*/*;q=0.8\",\n        },\n    )\n    if is_loopback(parts.hostname or \"\"):\n        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))\n    else:\n        opener = urllib.request.build_opener()\n\n    charset: str | None = None\n    try:\n        with opener.open(request_, timeout=FETCH_TIMEOUT) as response:\n            body = response.read(MAX_BODY_BYTES)\n            status_code = response.status\n            final_url = response.geturl()\n            charset = response.headers.get_content_charset()\n    except urllib.error.HTTPError as exc:\n        body = exc.read(MAX_BODY_BYTES)\n        status_code = exc.code\n        final_url = exc.geturl() or url\n        if exc.headers is not None:\n            charset = exc.headers.get_content_charset()\n\n    parser = PageParser()\n    try:\n        parser.feed(decode_body(body, charset))\n        parser.close()\n    except Exception:\n        pass\n\n    title = clean_text(parser.meta.get(\"og:title\", \"\")) or parser.title\n    description = clean_text(\n        parser.meta.get(\"og:description\", \"\") or parser.meta.get(\"description\", \"\")\n    )\n    image = clean_text(parser.meta.get(\"og:image\", \"\"))\n    image_url = urllib.parse.urljoin(final_url, image) if image else \"\"\n\n    return {\n        \"final_url\": final_url,\n        \"status_code\": status_code,\n        \"title\": title,\n        \"description\": description,\n        \"image_url\": image_url,\n        \"fetched_at\": utcnow(),\n    }\n\n\n# --------------------------------------------------------------------------\n# auth\n# --------------------------------------------------------------------------\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    return (\n        get_db()\n        .execute(\n            \"SELECT u.id, u.username FROM tokens t\"\n            \" JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n            (token.strip(),),\n        )\n        .fetchone()\n    )\n\n\ndef login_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any) -> Any:\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        return view(user, *args, **kwargs)\n\n    return wrapped\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = get_json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return error(\"username and password are required\", 400)\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already taken\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = get_json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, row[\"id\"]))\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n# --------------------------------------------------------------------------\n# previews\n# --------------------------------------------------------------------------\n\n\ndef get_user_preview(user_id: int, preview_id: int) -> sqlite3.Row | None:\n    return (\n        get_db()\n        .execute(\n            \"SELECT * FROM previews WHERE id = ? AND user_id = ?\", (preview_id, user_id)\n        )\n        .fetchone()\n    )\n\n\ndef store_preview(user_id: int, url: str, fetched: dict[str, Any], preview_id: int | None = None) -> sqlite3.Row:\n    db = get_db()\n    if preview_id is None:\n        cursor = db.execute(\n            \"INSERT INTO previews\"\n            \" (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\"\n            \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (\n                user_id,\n                url,\n                fetched[\"final_url\"],\n                fetched[\"status_code\"],\n                fetched[\"title\"],\n                fetched[\"description\"],\n                fetched[\"image_url\"],\n                fetched[\"fetched_at\"],\n            ),\n        )\n        preview_id = cursor.lastrowid\n    else:\n        db.execute(\n            \"UPDATE previews SET final_url = ?, status_code = ?, title = ?,\"\n            \" description = ?, image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n            (\n                fetched[\"final_url\"],\n                fetched[\"status_code\"],\n                fetched[\"title\"],\n                fetched[\"description\"],\n                fetched[\"image_url\"],\n                fetched[\"fetched_at\"],\n                preview_id,\n                user_id,\n            ),\n        )\n    db.commit()\n    return db.execute(\"SELECT * FROM previews WHERE id = ?\", (preview_id,)).fetchone()\n\n\n@app.post(\"/api/previews\")\n@login_required\ndef create_preview(user: sqlite3.Row):\n    data = get_json_body()\n    url = data.get(\"url\")\n    if not isinstance(url, str) or not url.strip():\n        return error(\"url is required\", 400)\n    url = url.strip()\n    try:\n        fetched = fetch_page(url)\n    except ValueError:\n        return error(\"url must be an absolute http(s) URL\", 400)\n    except Exception:\n        return error(\"could not fetch url\", 502)\n    row = store_preview(user[\"id\"], url, fetched)\n    return jsonify(preview_dict(row)), 201\n\n\n@app.get(\"/api/previews\")\n@login_required\ndef list_previews(user: sqlite3.Row):\n    try:\n        page = int(request.args.get(\"page\", \"1\"))\n    except ValueError:\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", str(DEFAULT_PAGE_SIZE)))\n    except ValueError:\n        page_size = DEFAULT_PAGE_SIZE\n    page = max(page, 1)\n    page_size = min(max(page_size, 1), MAX_PAGE_SIZE)\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS c FROM previews WHERE user_id = ?\", (user[\"id\"],)\n    ).fetchone()[\"c\"]\n    rows = db.execute(\n        \"SELECT * FROM previews WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n        (user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [preview_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@login_required\ndef get_preview(user: sqlite3.Row, preview_id: int):\n    row = get_user_preview(user[\"id\"], preview_id)\n    if row is None:\n        return error(\"preview not found\", 404)\n    return jsonify(preview_dict(row))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@login_required\ndef refresh_preview(user: sqlite3.Row, preview_id: int):\n    row = get_user_preview(user[\"id\"], preview_id)\n    if row is None:\n        return error(\"preview not found\", 404)\n    try:\n        fetched = fetch_page(row[\"url\"])\n    except ValueError:\n        return error(\"url must be an absolute http(s) URL\", 400)\n    except Exception:\n        return error(\"could not fetch url\", 502)\n    row = store_preview(user[\"id\"], row[\"url\"], fetched, preview_id=preview_id)\n    return jsonify(preview_dict(row))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@login_required\ndef delete_preview(user: sqlite3.Row, preview_id: int):\n    db = get_db()\n    cursor = db.execute(\n        \"DELETE FROM previews WHERE id = ? AND user_id = ?\", (preview_id, user[\"id\"])\n    )\n    db.commit()\n    if cursor.rowcount == 0:\n        return error(\"preview not found\", 404)\n    return \"\", 204\n\n\n# --------------------------------------------------------------------------\n# health + frontend\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()","lineStart":1,"lineEnd":484,"totalLines":484,"truncated":false}},"title":"backend/app.py","time":{"start":1794365637092,"end":1794365637107}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c886c1df001U7rRMO7gx2eSZC","sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","messageID":"msg_1c8864e70001rIZOMRTdra8wWL"}}
{"type":"step_finish","timestamp":1794365637205,"sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","part":{"id":"prt_1c886c1f7001vCAioukQEb3frA","reason":"tool-calls","messageID":"msg_1c8864e70001rIZOMRTdra8wWL","sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","type":"step-finish","tokens":{"total":96121,"input":948,"output":66,"reasoning":2307,"cache":{"write":0,"read":92800}},"cost":0}}
