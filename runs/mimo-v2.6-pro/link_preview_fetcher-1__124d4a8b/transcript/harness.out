{"type":"tool_use","timestamp":1794365208917,"sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","part":{"type":"tool","tool":"write","callID":"call_8e0e5c897b8f4c2783290c81","state":{"status":"completed","input":{"content":"\"\"\"Throwaway smoke test for the backend API (run from /workspace).\"\"\"\n\nimport json\nimport re\nimport sys\nimport threading\nimport urllib.request\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nsys.path.insert(0, \"backend\")\n\nFIXTURES = {\n    \"/full\": (\n        200,\n        b\"\"\"<html><head>\n        <title>Simple &amp; Plain Title</title>\n        <meta name=\"description\" content=\"Simple description\">\n        <meta property=\"og:title\" content=\"OG &lt;b&gt;Title&lt;/b&gt; &amp; more\">\n        <meta property=\"og:description\" content=\"OG  desc\\n with   spacing\">\n        <meta property=\"og:image\" content=\"/img/pic.png\">\n        </head><body>hi</body></html>\"\"\",\n    ),\n    \"/basic\": (\n        200,\n        b\"\"\"<html><head><title>  Just \\n a   Title </title>\n        <meta content=\"The fallback description\" name=\"DESCRIPTION\">\n        </head></html>\"\"\",\n    ),\n    \"/redirect\": (302, b\"\", \"/basic\"),\n    \"/missing\": (404, b\"<html><head><title>Not Found</title></head></html>\"),\n}\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        code, body, *redir = FIXTURES.get(self.path, (200, b\"<html><head><title>Fixture &amp; Page</title></head><body>x</body></html>\"))\n        if redir:\n            self.send_response(code)\n            self.send_header(\"Location\", redir[0])\n            self.end_headers()\n            return\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"text/html; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def log_message(self, *a):\n        pass\n\n\ndef req(method, path, token=None, body=None):\n    r = urllib.request.Request(\"http://127.0.0.1:8765\" + path, method=method)\n    if body is not None:\n        r.data = json.dumps(body).encode()\n        r.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        r.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            return resp.status, json.loads(resp.read() or b\"null\")\n    except urllib.error.HTTPError as e:\n        return e.code, json.loads(e.read() or b\"null\")\n\n\nhttpd = HTTPServer((\"127.0.0.1\", 8765), Handler)\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\n\nfrom app import app  # noqa: E402\n\napp.config[\"TESTING\"] = True\nc = app.test_client()\n\ndef check(cond, msg):\n    assert cond, msg\n    print(\"ok:\", msg)\n\n# health\ncheck(c.get(\"/api/health\").json == {\"status\": \"ok\"}, \"health\")\n\n# unauthenticated\ncheck(c.get(\"/api/previews\").status_code == 401, \"list unauth 401\")\ncheck(c.post(\"/api/previews\", json={\"url\": \"x\"}).status_code == 401, \"create unauth 401\")\ncheck(c.post(\"/api/auth/register\", json={}).status_code == 400, \"register bad body 400\")\ncheck(c.post(\"/api/auth/login\", json={\"username\": \"a\", \"password\": \"b\"}).status_code == 401, \"login wrong 401\")\n\n# register + dup + login\ncheck(c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"pw1\"}).status_code == 201, \"register 201\")\ncheck(c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"}).status_code == 409, \"register dup 409\")\nr = c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"pw1\"})\ncheck(r.status_code == 200 and r.json.get(\"token\"), \"login 200 token\")\ntok_a = r.json[\"token\"]\nc.post(\"/api/auth/register\", json={\"username\": \"bob\", \"password\": \"pw2\"})\ntok_b = c.post(\"/api/auth/login\", json={\"username\": \"bob\", \"password\": \"pw2\"}).json[\"token\"]\n\nH = {\"Authorization\": \"Bearer \" + tok_a}\n\n# create full preview\nr = c.post(\"/api/previews\", json={\"url\": \"http://127.0.0.1:8765/full\"}, headers=H)\ncheck(r.status_code == 201, \"create 201\")\np = r.json\nprint(json.dumps(p, indent=1))\ncheck(p[\"url\"] == \"http://127.0.0.1:8765/full\", \"url kept\")\ncheck(p[\"status_code\"] == 200, \"status_code 200\")\ncheck(p[\"title\"] == \"OG <b>Title</b> & more\", f\"og title plain text: {p['title']!r}\")\ncheck(p[\"description\"] == \"OG desc with spacing\", f\"og description plain text: {p['description']!r}\")\ncheck(p[\"image_url\"] == \"http://127.0.0.1:8765/img/pic.png\", f\"image resolved: {p['image_url']!r}\")\ncheck(re.match(r\"^\\d{4}-\\d{2}-\\d{2}T.*Z$\", p[\"fetched_at\"]), f\"fetched_at {p['fetched_at']!r}\")\npid = p[\"id\"]\n\n# basic fallback\np2 = c.post(\"/api/previews\", json={\"url\": \"http://127.0.0.1:8765/basic\"}, headers=H).json\ncheck(p2[\"title\"] == \"Just a Title\", f\"title fallback: {p2['title']!r}\")\ncheck(p2[\"description\"] == \"The fallback description\", \"desc fallback (case-insensitive name)\")\ncheck(p2[\"image_url\"] == \"\", f\"empty image: {p2['image_url']!r}\")\n\n# redirect -> final_url\np3 = c.post(\"/api/previews\", json={\"url\": \"http://127.0.0.1:8765/redirect\"}, headers=H).json\ncheck(p3[\"final_url\"] == \"http://127.0.0.1:8765/basic\", f\"final_url after redirect: {p3['final_url']!r}\")\ncheck(p3[\"title\"] == \"Just a Title\", \"redirect target parsed\")\n\n# http error page stored with status\np4 = c.post(\"/api/previews\", json={\"url\": \"http://127.0.0.1:8765/missing\"}, headers=H).json\ncheck(p4[\"status_code\"] == 404 and p4[\"title\"] == \"Not Found\", \"404 page stored\")\n\n# invalid urls\ncheck(c.post(\"/api/previews\", json={}, headers=H).status_code == 400, \"no url 400\")\ncheck(c.post(\"/api/previews\", json={\"url\": \"nota url\"}, headers=H).status_code == 400, \"bad url 400\")\ncheck(c.post(\"/api/previews\", json={\"url\": \"ftp://x/y\"}, headers=H).status_code == 400, \"ftp 400\")\ncheck(c.post(\"/api/previews\", json={\"url\": \"http://127.0.0.1:1/nope\"}, headers=H).status_code == 502, \"unreachable 502\")\n\n# list: newest first + paging\nr = c.get(\"/api/previews?page=1&page_size=2\", headers=H)\nd = r.json\ncheck(d[\"page\"] == 1 and d[\"page_size\"] == 2, \"page echo\")\ncheck(d[\"total\"] == 4, f\"total 4: {d['total']}\")\ncheck([i[\"id\"] for i in d[\"items\"]] == sorted([i[\"id\"] for i in d[\"items\"]], reverse=True), \"newest first\")\ncheck(d[\"items\"][0][\"id\"] == p4[\"id\"], \"first is newest\")\nr2 = c.get(\"/api/previews?page=3&page_size=2\", headers=H).json\ncheck(r2[\"items\"] == [] and r2[\"total\"] == 4, \"empty page beyond range\")\nr3 = c.get(\"/api/previews\", headers=H).json\ncheck(len(r3[\"items\"]) == 4 and r3[\"page_size\"] == 20, f\"defaults: {r3['page_size']}\")\n\n# get one + other user isolation\ng = c.get(f\"/api/previews/{pid}\", headers=H)\ncheck(g.status_code == 200 and g.json[\"id\"] == pid, \"get one\")\ncheck(c.get(f\"/api/previews/{pid}\", headers={\"Authorization\": \"Bearer \" + tok_b}).status_code == 404, \"other user 404\")\ncheck(c.get(\"/api/previews\", headers={\"Authorization\": \"Bearer \" + tok_b}).json[\"total\"] == 0, \"other user empty list\")\ncheck(c.delete(f\"/api/previews/{pid}\", headers={\"Authorization\": \"Bearer \" + tok_b}).status_code == 404, \"other user delete 404\")\ncheck(c.get(\"/api/previews/99999\", headers=H).status_code == 404, \"missing 404\")\n\n# refresh\nr = c.post(f\"/api/previews/{pid}/refresh\", headers=H)\ncheck(r.status_code == 200, \"refresh 200\")\ncheck(r.json[\"id\"] == pid and r.json[\"title\"] == \"OG <b>Title</b> & more\", \"refresh updates in place\")\n\n# delete\ncheck(c.delete(f\"/api/previews/{pid}\", headers=H).status_code == 204, \"delete 204\")\ncheck(c.get(f\"/api/previews/{pid}\", headers=H).status_code == 404, \"deleted gone\")\ncheck(c.delete(f\"/api/previews/{pid}\", headers=H).status_code == 404, \"delete again 404\")\n\nprint(\"ALL SMOKE TESTS PASSED\")\n","filePath":"/workspace/.smoke_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.smoke_test.py","exists":false,"truncated":false},"title":".smoke_test.py","time":{"start":1794365208885,"end":1794365208898}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c880392f001M9ZtVwS4gvZMIg","sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","messageID":"msg_1c87fcdeb001ZmLnoO1MkMKyyf"}}
