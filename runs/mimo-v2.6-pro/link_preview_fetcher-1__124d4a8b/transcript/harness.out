{"type":"text","timestamp":1794365437644,"sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","part":{"id":"prt_1c883b6bd001Bv9AkKvEaQ2Wto","messageID":"msg_1c88351c0001NBsi4whD4a8FI7","sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","type":"text","text":"Frontend is solid. Now full end-to-end over real HTTP with gunicorn (same invocation as the Docker CMD), including persistence across restart:","time":{"start":1794365437629,"end":1794365437640}}}
{"type":"tool_use","timestamp":1794365437672,"sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","part":{"type":"tool","tool":"write","callID":"call_844c0e02fa5c4473a92c6ac9","state":{"status":"completed","input":{"content":"\"\"\"Throwaway end-to-end test: gunicorn on :8000 + fixture pages on :8765.\"\"\"\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nimport threading\n\nBASE = \"http://127.0.0.1:8000\"\nFIX = \"http://127.0.0.1:8765\"\n\nPAGES = {\n    \"/full\": b\"\"\"<html><head>\n        <title>Fallback Title</title>\n        <meta name=\"description\" content=\"Fallback description\">\n        <meta property=\"og:title\" content=\"OG Title &amp; Co\">\n        <meta property=\"og:description\" content=\"OG   description\">\n        <meta property=\"og:image\" content=\"/img/pic.png\">\n        </head><body>hi</body></html>\"\"\",\n    \"/plain\": b\"\"\"<html><head><title>Plain Page</title>\n        <meta name=\"description\" content=\"Plain description\"></head></html>\"\"\",\n}\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        if self.path == \"/redirect\":\n            self.send_response(302)\n            self.send_header(\"Location\", \"/plain\")\n            self.end_headers()\n            return\n        body = PAGES.get(\n            self.path,\n            b\"<html><head><title>Fixture &amp; Page</title></head><body>x</body></html>\",\n        )\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/html; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def log_message(self, *a):\n        pass\n\n\ndef start_gunicorn():\n    return subprocess.Popen(\n        [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"],\n        cwd=os.getcwd(),\n        stdout=subprocess.DEVNULL,\n        stderr=subprocess.DEVNULL,\n    )\n\n\ndef wait_up():\n    for _ in range(100):\n        try:\n            with urllib.request.urlopen(BASE + \"/api/health\", timeout=1) as r:\n                if r.status == 200:\n                    return\n        except Exception:\n            time.sleep(0.15)\n    raise SystemExit(\"gunicorn did not come up\")\n\n\ndef req(method, path, token=None, body=None, base=BASE, raw=False):\n    r = urllib.request.Request(base + path, method=method)\n    if body is not None:\n        r.data = json.dumps(body).encode()\n        r.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        r.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(r, timeout=30) as resp:\n            data = resp.read()\n            return resp.status, data if raw else json.loads(data or b\"null\"), dict(resp.headers)\n    except urllib.error.HTTPError as e:\n        data = e.read()\n        return e.code, data if raw else json.loads(data or b\"null\"), dict(e.headers)\n\n\ndef check(cond, msg):\n    assert cond, msg\n    print(\"ok:\", msg)\n\n\nhttpd = HTTPServer((\"127.0.0.1\", 8765), Handler)\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\n\nproc = start_gunicorn()\ntry:\n    wait_up()\n    check(req(\"GET\", \"/api/health\")[0:2] == (200, {\"status\": \"ok\"}), \"health\")\n\n    # --- frontend serving ---\n    st, body, hdr = req(\"GET\", \"/\", raw=True)\n    check(st == 200 and b\"<div id=\\\"root\\\">\" in body and b\"assets/\" in body, \"GET / serves index.html\")\n    st, body, hdr = req(\"GET\", \"/anything/else\", raw=True)\n    check(st == 200 and b\"<div id=\\\"root\\\">\" in body, \"SPA fallback\")\n    import re\n    m = re.search(rb'src=\"(/assets/[^\"]+\\.js)\"', req(\"GET\", \"/\", raw=True)[1])\n    st, body, hdr = req(\"GET\", m.group(1).decode(), raw=True)\n    check(st == 200 and len(body) > 1000, \"asset served\")\n    st, body, _ = req(\"GET\", \"/assets/index-CeukBU-G.css\", raw=True)\n    check(st == 200 and b\"line-clamp\" in body, \"css served\")\n    st, body, _ = req(\"GET\", \"/api/whatever\", raw=True)\n    check(st == 404 and json.loads(body) == {\"error\": \"not found\"}, \"unknown api path 404 JSON\")\n\n    # --- auth ---\n    check(req(\"GET\", \"/api/previews\")[0] == 401, \"401 without token\")\n    check(req(\"GET\", \"/api/previews\", token=\"bogus\")[0] == 401, \"401 bad token\")\n    check(req(\"POST\", \"/api/auth/register\", body={\"username\": \"u1\", \"password\": \"p1\"})[0] == 201, \"register 201\")\n    check(req(\"POST\", \"/api/auth/register\", body={\"username\": \"u1\", \"password\": \"x\"})[0] == 409, \"dup 409\")\n    st, body, _ = req(\"POST\", \"/api/auth/login\", body={\"username\": \"u1\", \"password\": \"wrong\"})\n    check(st == 401, \"bad login 401\")\n    st, body, _ = req(\"POST\", \"/api/auth/login\", body={\"username\": \"u1\", \"password\": \"p1\"})\n    check(st == 200 and body[\"token\"], \"login 200 token\")\n    t1 = body[\"token\"]\n    req(\"POST\", \"/api/auth/register\", body={\"username\": \"u2\", \"password\": \"p2\"})\n    t2 = req(\"POST\", \"/api/auth/login\", body={\"username\": \"u2\", \"password\": \"p2\"})[1][\"token\"]\n\n    # --- previews ---\n    st, p, _ = req(\"POST\", \"/api/previews\", t1, {\"url\": FIX + \"/full\"})\n    check(st == 201, \"create 201\")\n    check(p[\"title\"] == \"OG Title & Co\", \"og title\")\n    check(p[\"description\"] == \"OG description\", \"og desc\")\n    check(p[\"image_url\"] == FIX + \"/img/pic.png\", \"og image resolved\")\n    check(p[\"status_code\"] == 200 and p[\"url\"] == FIX + \"/full\", \"url+status\")\n    check(p[\"final_url\"] == FIX + \"/full\" and p[\"fetched_at\"].endswith(\"Z\"), \"final_url+fetched_at\")\n    ids = [p[\"id\"]]\n    for path in (\"/plain\", \"/redirect\", \"/full\", \"/plain\"):\n        st, p2, _ = req(\"POST\", \"/api/previews\", t1, {\"url\": FIX + path})\n        check(st == 201, f\"create {path}\")\n        ids.append(p2[\"id\"])\n    r1 = req(\"POST\", \"/api/previews\", t1, {\"url\": FIX + \"/redirect\"})[1]\n    check(r1[\"final_url\"] == FIX + \"/plain\", \"final_url after redirect\")\n\n    st, page1, _ = req(\"GET\", \"/api/previews?page=1&page_size=2\", t1)\n    d = page1\n    check(d[\"total\"] == 6 and len(d[\"items\"]) == 2 and d[\"page\"] == 1 and d[\"page_size\"] == 2, \"list page 1\")\n    check(d[\"items\"][0][\"id\"] > d[\"items\"][1][\"id\"], \"newest first\")\n    st, page3, _ = req(\"GET\", \"/api/previews?page=3&page_size=2\", t1)\n    check(len(page3[\"items\"]) == 2 and page3[\"total\"] == 6, \"list page 3\")\n    st, page4, _ = req(\"GET\", \"/api/previews?page=4&page_size=2\", t1)\n    check(page4[\"items\"] == [] and page4[\"total\"] == 6, \"page past end\")\n\n    one = req(\"GET\", f\"/api/previews/{ids[0]}\", t1)[1]\n    check(one[\"id\"] == ids[0] and one[\"title\"] == \"OG Title & Co\", \"get one\")\n    check(req(\"GET\", f\"/api/previews/{ids[0]}\", t2)[0] == 404, \"cross-user get 404\")\n    check(req(\"POST\", f\"/api/previews/{ids[0]}/refresh\", t2)[0] == 404, \"cross-user refresh 404\")\n    check(req(\"DELETE\", f\"/api/previews/{ids[0]}\", t2)[0] == 404, \"cross-user delete 404\")\n    check(req(\"GET\", \"/api/previews\", t2)[1][\"total\"] == 0, \"cross-user list empty\")\n\n    st, ref, _ = req(\"POST\", f\"/api/previews/{ids[0]}/refresh\", t1)\n    check(st == 200 and ref[\"id\"] == ids[0], \"refresh 200 same id\")\n\n    st, _, _ = req(\"DELETE\", f\"/api/previews/{ids[0]}\", t1)\n    check(st == 204, \"delete 204\")\n    check(req(\"GET\", f\"/api/previews/{ids[0]}\", t1)[0] == 404, \"gone after delete\")\n\n    print(\"--- restarting gunicorn for persistence ---\")\n    proc.send_signal(signal.SIGTERM)\n    proc.wait(timeout=15)\n    proc = start_gunicorn()\n    wait_up()\n    t1b = req(\"POST\", \"/api/auth/login\", body={\"username\": \"u1\", \"password\": \"p1\"})[1][\"token\"]\n    st, d, _ = req(\"GET\", \"/api/previews?page=1&page_size=50\", t1b)\n    check(d[\"total\"] == 5, f\"data survived restart: total={d['total']}\")\n\n    print(\"ALL E2E TESTS PASSED\")\nfinally:\n    proc.send_signal(signal.SIGTERM)\n    proc.wait(timeout=15)\n","filePath":"/workspace/.e2e_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.e2e_test.py","exists":false,"truncated":false},"title":".e2e_test.py","time":{"start":1794365437637,"end":1794365437647}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c883b6c00018bkQbud6CjtTd4","sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","messageID":"msg_1c88351c0001NBsi4whD4a8FI7"}}
