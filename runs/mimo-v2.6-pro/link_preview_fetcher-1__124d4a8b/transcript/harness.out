\"\", \"image_url\": \"\", \"fetched_at\": \"2026-01-01T00:00:00Z\"}\nr = c.post(\"/api/previews\", json={\"url\": \"http://x.test/abs\"}, headers={\"Authorization\": \"Bearer \" + tok})\nprint(\"create:\", r.status_code, r.json)\nEOF","time":{"start":1794365607007,"end":1794365607524}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8864c57001AIJzFzH1xuIrDD","sessionID":"ses_e37882224ffeyu2W3Z5F9Fod7t","messageID":"msg_1c8861e02001miEeym7ZtITMVa"}}
