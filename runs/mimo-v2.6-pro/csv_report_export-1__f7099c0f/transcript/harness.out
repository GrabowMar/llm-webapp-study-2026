{"type":"text","timestamp":1794361551372,"sessionID":"ses_e37c55911ffecavHBT653S80bE","part":{"id":"prt_1c84869fd0018dmgiwXL2R052p","messageID":"msg_1c848272f001hli93CptwLVUBM","sessionID":"ses_e37c55911ffecavHBT653S80bE","type":"text","text":"Now the main Timesheet component (filters, totals, exports, paging):","time":{"start":1794361551357,"end":1794361551368}}}
{"type":"tool_use","timestamp":1794361551391,"sessionID":"ses_e37c55911ffecavHBT653S80bE","part":{"type":"tool","tool":"write","callID":"call_7af3f4b8eb4b46aeba69ac16","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  EntryPage,\n  Filters,\n  downloadCsv,\n  errorMessage,\n  listEntries,\n} from \"../api\";\nimport EntryForm from \"./EntryForm\";\nimport EntryTable from \"./EntryTable\";\n\nconst PAGE_SIZE = 10;\nconst FETCH_ALL = 1000;\n\ninterface Props {\n  onSessionExpired: () => void;\n}\n\ninterface ProjectTotal {\n  project: string;\n  hours: number;\n}\n\nconst EMPTY_PAGE: EntryPage = { items: [], total: 0, page: 1, page_size: PAGE_SIZE };\n\nexport default function Timesheet({ onSessionExpired }: Props) {\n  const [filters, setFilters] = useState<Filters>({\n    start_date: \"\",\n    end_date: \"\",\n    project: \"\",\n  });\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<EntryPage>(EMPTY_PAGE);\n  const [totals, setTotals] = useState<ProjectTotal[]>([]);\n  const [projects, setProjects] = useState<string[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  const handleError = useCallback(\n    (err: unknown) => {\n      if (err instanceof ApiError && err.status === 401) {\n        onSessionExpired();\n        return;\n      }\n      setError(errorMessage(err));\n    },\n    [onSessionExpired],\n  );\n\n  const refresh = useCallback(() => {\n    setError(null);\n    setRefreshKey((key) => key + 1);\n  }, []);\n\n  const setFilter = (name: keyof Filters, value: string) => {\n    setFilters((current) => ({ ...current, [name]: value }));\n    setPage(1);\n  };\n\n  useEffect(() => {\n    let cancelled = false;\n    listEntries({ ...filters, page, page_size: PAGE_SIZE })\n      .then((result) => {\n        if (cancelled) return;\n        setData(result);\n        const lastPage = Math.max(1, Math.ceil(result.total / PAGE_SIZE));\n        if (result.items.length === 0 && result.total > 0 && page > lastPage) {\n          setPage(lastPage);\n        }\n      })\n      .catch((err) => {\n        if (!cancelled) handleError(err);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [filters, page, refreshKey, handleError]);\n\n  useEffect(() => {\n    let cancelled = false;\n    listEntries({ ...filters, page: 1, page_size: FETCH_ALL })\n      .then((result) => {\n        if (cancelled) return;\n        const sums = new Map<string, number>();\n        for (const entry of result.items) {\n          sums.set(entry.project, (sums.get(entry.project) ?? 0) + entry.hours);\n        }\n        const next = [...sums.entries()]\n          .map(([project, hours]) => ({ project, hours }))\n          .sort((a, b) => a.project.localeCompare(b.project));\n        setTotals(next);\n      })\n      .catch((err) => {\n        if (!cancelled) handleError(err);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [filters, refreshKey, handleError]);\n\n  useEffect(() => {\n    let cancelled = false;\n    listEntries({ page: 1, page_size: FETCH_ALL })\n      .then((result) => {\n        if (cancelled) return;\n        const names = [...new Set(result.items.map((entry) => entry.project))];\n        names.sort((a, b) => a.localeCompare(b));\n        setProjects(names);\n      })\n      .catch((err) => {\n        if (!cancelled) handleError(err);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [refreshKey, handleError]);\n\n  async function exportEntries() {\n    setError(null);\n    try {\n      await downloadCsv(\n        \"/api/exports/entries.csv\",\n        {\n          start_date: filters.start_date,\n          end_date: filters.end_date,\n          project: filters.project,\n        },\n        \"entries.csv\",\n      );\n    } catch (err) {\n      handleError(err);\n    }\n  }\n\n  async function exportTotals() {\n    setError(null);\n    try {\n      await downloadCsv(\n        \"/api/exports/summary.csv\",\n        { start_date: filters.start_date, end_date: filters.end_date },\n        \"summary.csv\",\n      );\n    } catch (err) {\n      handleError(err);\n    }\n  }\n\n  const totalPages = Math.max(1, Math.ceil(data.total / PAGE_SIZE));\n  const totalHours = totals.reduce((sum, item) => sum + item.hours, 0);\n  const fieldClass =\n    \"rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\n\n  return (\n    <div className=\"space-y-6\">\n      <EntryForm projects={projects} onCreated={refresh} />\n\n      {error && (\n        <p className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">{error}</p>\n      )}\n\n      <section className=\"rounded-xl bg-white p-6 shadow-sm\">\n        <div className=\"flex flex-wrap items-end justify-between gap-4\">\n          <div className=\"flex flex-wrap items-end gap-3\">\n            <div>\n              <label htmlFor=\"filter-start\" className=\"block text-sm font-medium text-slate-700\">\n                From\n              </label>\n              <input\n                id=\"filter-start\"\n                type=\"date\"\n                value={filters.start_date}\n                onChange={(e) => setFilter(\"start_date\", e.target.value)}\n                className={`mt-1 ${fieldClass}`}\n              />\n            </div>\n            <div>\n              <label htmlFor=\"filter-end\" className=\"block text-sm font-medium text-slate-700\">\n                To\n              </label>\n              <input\n                id=\"filter-end\"\n                type=\"date\"\n                value={filters.end_date}\n                onChange={(e) => setFilter(\"end_date\", e.target.value)}\n                className={`mt-1 ${fieldClass}`}\n              />\n            </div>\n            <div>\n              <label htmlFor=\"filter-project\" className=\"block text-sm font-medium text-slate-700\">\n                Project\n              </label>\n              <select\n                id=\"filter-project\"\n                value={filters.project}\n                onChange={(e) => setFilter(\"project\", e.target.value)}\n                className={`mt-1 ${fieldClass}`}\n              >\n                <option value=\"\">All projects</option>\n                {projects.map((name) => (\n                  <option key={name} value={name}>\n                    {name}\n                  </option>\n                ))}\n              </select>\n            </div>\n          </div>\n          <div className=\"flex gap-2\">\n            <button\n              type=\"button\"\n              onClick={exportEntries}\n              className=\"rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n            >\n              Export CSV\n            </button>\n            <button\n              type=\"button\"\n              onClick={exportTotals}\n              className=\"rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n            >\n              Export totals\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section className=\"rounded-xl bg-white p-6 shadow-sm\">\n        <h2 className=\"text-base font-semibold text-slate-900\">Entries</h2>\n        <div className=\"mt-4\">\n          <EntryTable entries={data.items} projects={projects} onChanged={refresh} />\n        </div>\n        <div className=\"mt-4 flex flex-wrap items-center justify-between gap-3\">\n          <p className=\"text-sm text-slate-500\">\n            {data.total} {data.total === 1 ? \"entry\" : \"entries\"} · Page {data.page} of{\" \"}\n            {totalPages}\n          </p>\n          <div className=\"flex gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => setPage((current) => Math.max(1, current - 1))}\n              disabled={page <= 1}\n              className=\"rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50\"\n            >\n              Previous\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setPage((current) => current + 1)}\n              disabled={page >= totalPages}\n              className=\"rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50\"\n            >\n              Next\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section className=\"rounded-xl bg-white p-6 shadow-sm\">\n        <h2 className=\"text-base font-semibold text-slate-900\">Per-project totals</h2>\n        {totals.length === 0 ? (\n          <p className=\"mt-3 text-sm text-slate-500\">No time logged for the current filters.</p>\n        ) : (\n          <ul className=\"mt-3 divide-y divide-slate-100\">\n            {totals.map((item) => (\n              <li key={item.project} className=\"flex items-center justify-between py-2 text-sm\">\n                <span className=\"font-medium text-slate-900\">{item.project}</span>\n                <span className=\"text-slate-700\">{item.hours} h</span>\n              </li>\n            ))}\n            <li className=\"flex items-center justify-between py-2 text-sm font-semibold text-slate-900\">\n              <span>Total</span>\n              <span>{totalHours} h</span>\n            </li>\n          </ul>\n        )}\n      </section>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/Timesheet.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Timesheet.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Timesheet.tsx","time":{"start":1794361551365,"end":1794361551374}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8486a00001aL0ujaR4qI6Fzx","sessionID":"ses_e37c55911ffecavHBT653S80bE","messageID":"msg_1c848272f001hli93CptwLVUBM"}}
