@@ -0,0 +1,122 @@
+import { FormEvent, useState } from "react";
+import { createEntry, errorMessage } from "../api";
+
+function today(): string {
+  const now = new Date();
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
+}
+
+interface Props {
+  projects: string[];
+  onCreated: () => void;
+}
+
+export default function EntryForm({ projects, onCreated }: Props) {
+  const [project, setProject] = useState("");
+  const [description, setDescription] = useState("");
+  const [hours, setHours] = useState("");
+  const [date, setDate] = useState(today);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  async function submit(event: FormEvent) {
+    event.preventDefault();
+    setError(null);
+    setBusy(true);
+    try {
+      await createEntry({
+        project,
+        description,
+        hours: hours.trim(),
+        date,
+      });
+      setProject("");
+      setDescription("");
+      setHours("");
+      onCreated();
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section className="rounded-xl bg-white p-6 shadow-sm">
+      <h2 className="text-base font-semibold text-slate-900">Log time</h2>
+      <form onSubmit={submit} className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-[2fr_3fr_1fr_1.5fr_auto]">
+        <div>
+          <label htmlFor="entry-project" className="block text-sm font-medium text-slate-700">
+            Project
+          </label>
+          <input
+            id="entry-project"
+            list="project-suggestions"
+            value={project}
+            onChange={(e) => setProject(e.target.value)}
+            placeholder="e.g. Acme"
+            required
+            className="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
+          />
+          <datalist id="project-suggestions">
+            {projects.map((name) => (
+              <option key={name} value={name} />
+            ))}
+          </datalist>
+        </div>
+        <div>
+          <label htmlFor="entry-description" className="block text-sm font-medium text-slate-700">
+            Description
+          </label>
+          <input
+            id="entry-description"
+            value={description}
+            onChange={(e) => setDescription(e.target.value)}
+            placeholder="What did you work on?"
+            className="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
+          />
+        </div>
+        <div>
+          <label htmlFor="entry-hours" className="block text-sm font-medium text-slate-700">
+            Hours
+          </label>
+          <input
+            id="entry-hours"
+            value={hours}
+            onChange={(e) => setHours(e.target.value)}
+            placeholder="e.g. 1.5"
+            inputMode="decimal"
+            required
+            className="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
+          />
+        </div>
+        <div>
+          <label htmlFor="entry-date" className="block text-sm font-medium text-slate-700">
+            Date
+          </label>
+          <input
+            id="entry-date"
+            type="date"
+            value={date}
+            onChange={(e) => setDate(e.target.value)}
+            required
+            className="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
+          />
+        </div>
+        <div className="flex items-end">
+          <button
+            type="submit"
+            disabled={busy}
+            className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50 sm:w-auto"
+          >
+            {busy ? "Saving\u2026" : "Log time"}
+          </button>
+        </div>
+      </form>
+      {error && (
+        <p className="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/src/components/EntryTable.tsx b/frontend/src/components/EntryTable.tsx
new file mode 100644
index 0000000..2a01fc4
--- /dev/null
+++ b/frontend/src/components/EntryTable.tsx
@@ -0,0 +1,209 @@
+import { useState } from "react";
+import { Entry, deleteEntry, errorMessage, updateEntry } from "../api";
+
+interface Props {
+  entries: Entry[];
+  projects: string[];
+  onChanged: () => void;
+}
+
+interface Draft {
+  project: string;
+  description: string;
+  hours: string;
+  date: string;
+}
+
+function toDraft(entry: Entry): Draft {
+  return {
+    project: entry.project,
+    description: entry.description,
+    hours: String(entry.hours),
+    date: entry.date,
+  };
+}
+
+export default function EntryTable({ entries, projects, onChanged }: Props) {
+  const [editingId, setEditingId] = useState<number | null>(null);
+  const [draft, setDraft] = useState<Draft | null>(null);
+  const [editError, setEditError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  function startEdit(entry: Entry) {
+    setEditingId(entry.id);
+    setDraft(toDraft(entry));
+    setEditError(null);
+  }
+
+  function cancelEdit() {
+    setEditingId(null);
+    setDraft(null);
+    setEditError(null);
+  }
+
+  async function saveEdit(id: number) {
+    if (!draft) return;
+    setBusy(true);
+    setEditError(null);
+    try {
+      await updateEntry(id, {
+        project: draft.project,
+        description: draft.description,
+        hours: draft.hours.trim(),
+        date: draft.date,
+      });
+      cancelEdit();
+      onChanged();
+    } catch (err) {
+      setEditError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function remove(entry: Entry) {
+    const confirmed = window.confirm(
+      `Delete the entry "${entry.project}" on ${entry.date} (${entry.hours} h)?`,
+    );
+    if (!confirmed) return;
+    setBusy(true);
+    setEditError(null);
+    try {
+      await deleteEntry(entry.id);
+      if (editingId === entry.id) cancelEdit();
+      onChanged();
+    } catch (err) {
+      setEditError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const inputClass =
+    "w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500";
+
+  return (
+    <div>
+      {editError && (
+        <p className="mb-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{editError}</p>
+      )}
+      <div className="overflow-x-auto">
+      <datalist id="entry-table-projects">
+        {projects.map((name) => (
+          <option key={name} value={name} />
+        ))}
+      </datalist>
+      <table className="w-full text-left text-sm">
+        <thead>
+          <tr className="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
+            <th className="py-2 pr-3 font-medium">Date</th>
+            <th className="py-2 pr-3 font-medium">Project</th>
+            <th className="py-2 pr-3 font-medium">Description</th>
+            <th className="py-2 pr-3 font-medium">Hours</th>
+            <th className="py-2 font-medium">Actions</th>
+          </tr>
+        </thead>
+        <tbody>
+          {entries.length === 0 && (
+            <tr>
+              <td colSpan={5} className="py-8 text-center text-slate-500">
+                No entries match the current filters.
+              </td>
+            </tr>
+          )}
+          {entries.map((entry) => {
+            const editing = editingId === entry.id && draft !== null;
+            return (
+              <tr key={entry.id} className="border-b border-slate-100 align-middle">
+                {editing ? (
+                  <>
+                    <td className="py-2 pr-3">
+                      <input
+                        type="date"
+                        aria-label="Date"
+                        value={draft.date}
+                        onChange={(e) => setDraft({ ...draft, date: e.target.value })}
+                        className={inputClass}
+                      />
+                    </td>
+                    <td className="py-2 pr-3">
+                      <input
+                        list="entry-table-projects"
+                        aria-label="Project"
+                        value={draft.project}
+                        onChange={(e) => setDraft({ ...draft, project: e.target.value })}
+                        className={inputClass}
+                      />
+                    </td>
+                    <td className="py-2 pr-3">
+                      <input
+                        aria-label="Description"
+                        value={draft.description}
+                        onChange={(e) => setDraft({ ...draft, description: e.target.value })}
+                        className={inputClass}
+                      />
+                    </td>
+                    <td className="py-2 pr-3">
+                      <input
+                        aria-label="Hours"
+                        value={draft.hours}
+                        onChange={(e) => setDraft({ ...draft, hours: e.target.value })}
+                        className={inputClass}
+                      />
+                    </td>
+                    <td className="py-2">
+                      <div className="flex gap-2">
+                        <button
+                          type="button"
+                          onClick={() => saveEdit(entry.id)}
+                          disabled={busy}
+                          className="rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-700 disabled:opacity-50"
+                        >
+                          Save
+                        </button>
+                        <button
+                          type="button"
+                          onClick={cancelEdit}
+                          disabled={busy}
+                          className="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50"
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    </td>
+                  </>
+                ) : (
+                  <>
+                    <td className="py-2 pr-3 whitespace-nowrap text-slate-700">{entry.date}</td>
+                    <td className="py-2 pr-3 font-medium text-slate-900">{entry.project}</td>
+                    <td className="py-2 pr-3 text-slate-700">{entry.description}</td>
+                    <td className="py-2 pr-3 whitespace-nowrap text-slate-700">{entry.hours}</td>
+                    <td className="py-2">
+                      <div className="flex gap-2">
+                        <button
+                          type="button"
+                          onClick={() => startEdit(entry)}
+                          className="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
+                        >
+                          Edit
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => remove(entry)}
+                          className="rounded-md border border-red-200 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50"
+                        >
+                          Delete
+                        </button>
+                      </div>
+                    </td>
+                  </>
+                )}
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/Timesheet.tsx b/frontend/src/components/Timesheet.tsx
new file mode 100644
index 0000000..d82d0ac
--- /dev/null
+++ b/frontend/src/components/Timesheet.tsx
@@ -0,0 +1,279 @@
+import { useCallback, useEffect, useState } from "react";
+import {
+  ApiError,
+  EntryPage,
+  Filters,
+  downloadCsv,
+  errorMessage,
+  listEntries,
+} from "../api";
+import EntryForm from "./EntryForm";
+import EntryTable from "./EntryTable";
+
+const PAGE_SIZE = 10;
+const FETCH_ALL = 1000;
+
+interface Props {
+  onSessionExpired: () => void;
+}
+
+interface ProjectTotal {
+  project: string;
+  hours: number;
+}
+
+const EMPTY_PAGE: EntryPage = { items: [], total: 0, page: 1, page_size: PAGE_SIZE };
+
+export default function Timesheet({ onSessionExpired }: Props) {
+  const [filters, setFilters] = useState<Filters>({
+    start_date: "",
+    end_date: "",
+    project: "",
+  });
+  const [page, setPage] = useState(1);
+  const [data, setData] = useState<EntryPage>(EMPTY_PAGE);
+  const [totals, setTotals] = useState<ProjectTotal[]>([]);
+  const [projects, setProjects] = useState<string[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [refreshKey, setRefreshKey] = useState(0);
+
+  const handleError = useCallback(
+    (err: unknown) => {
+      if (err instanceof ApiError && err.status === 401) {
+        onSessionExpired();
+        return;
+      }
+      setError(errorMessage(err));
+    },
+    [onSessionExpired],
+  );
+
+  const refresh = useCallback(() => {
+    setError(null);
+    setRefreshKey((key) => key + 1);
+  }, []);
+
+  const setFilter = (name: keyof Filters, value: string) => {
+    setFilters((current) => ({ ...current, [name]: value }));
+    setPage(1);
+  };
+
+  useEffect(() => {
+    let cancelled = false;
+    listEntries({ ...filters, page, page_size: PAGE_SIZE })
+      .then((result) => {
+        if (cancelled) return;
+        setData(result);
+        const lastPage = Math.max(1, Math.ceil(result.total / PAGE_SIZE));
+        if (result.items.length === 0 && result.total > 0 && page > lastPage) {
+          setPage(lastPage);
+        }
+      })
+      .catch((err) => {
+        if (!cancelled) handleError(err);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [filters, page, refreshKey, handleError]);
+
+  useEffect(() => {
+    let cancelled = false;
+    listEntries({ ...filters, page: 1, page_size: FETCH_ALL })
+      .then((result) => {
+        if (cancelled) return;
+        const sums = new Map<string, number>();
+        for (const entry of result.items) {
+          sums.set(entry.project, (sums.get(entry.project) ?? 0) + entry.hours);
+        }
+        const next = [...sums.entries()]
+          .map(([project, hours]) => ({ project, hours }))
+          .sort((a, b) => a.project.localeCompare(b.project));
+        setTotals(next);
+      })
+      .catch((err) => {
+        if (!cancelled) handleError(err);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [filters, refreshKey, handleError]);
+
+  useEffect(() => {
+    let cancelled = false;
+    listEntries({ page: 1, page_size: FETCH_ALL })
+      .then((result) => {
+        if (cancelled) return;
+        const names = [...new Set(result.items.map((entry) => entry.project))];
+        names.sort((a, b) => a.localeCompare(b));
+        setProjects(names);
+      })
+      .catch((err) => {
+        if (!cancelled) handleError(err);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [refreshKey, handleError]);
+
+  async function exportEntries() {
+    setError(null);
+    try {
+      await downloadCsv(
+        "/api/exports/entries.csv",
+        {
+          start_date: filters.start_date,
+          end_date: filters.end_date,
+          project: filters.project,
+        },
+        "entries.csv",
+      );
+    } catch (err) {
+      handleError(err);
+    }
+  }
+
+  async function exportTotals() {
+    setError(null);
+    try {
+      await downloadCsv(
+        "/api/exports/summary.csv",
+        { start_date: filters.start_date, end_date: filters.end_date },
+        "summary.csv",
+      );
+    } catch (err) {
+      handleError(err);
+    }
+  }
+
+  const totalPages = Math.max(1, Math.ceil(data.total / PAGE_SIZE));
+  const totalHours = totals.reduce((sum, item) => sum + item.hours, 0);
+  const fieldClass =
+    "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500";
+
+  return (
+    <div className="space-y-6">
+      <EntryForm projects={projects} onCreated={refresh} />
+
+      {error && (
+        <p className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>
+      )}
+
+      <section className="rounded-xl bg-white p-6 shadow-sm">
+        <div className="flex flex-wrap items-end justify-between gap-4">
+          <div className="flex flex-wrap items-end gap-3">
+            <div>
+              <label htmlFor="filter-start" className="block text-sm font-medium text-slate-700">
+                From
+              </label>
+              <input
+                id="filter-start"
+                type="date"
+                value={filters.start_date}
+                onChange={(e) => setFilter("start_date", e.target.value)}
+                className={`mt-1 ${fieldClass}`}
+              />
+            </div>
+            <div>
+              <label htmlFor="filter-end" className="block text-sm font-medium text-slate-700">
+                To
+              </label>
+              <input
+                id="filter-end"
+                type="date"
+                value={filters.end_date}
+                onChange={(e) => setFilter("end_date", e.target.value)}
+                className={`mt-1 ${fieldClass}`}
+              />
+            </div>
+            <div>
+              <label htmlFor="filter-project" className="block text-sm font-medium text-slate-700">
+                Project
+              </label>
+              <select
+                id="filter-project"
+                value={filters.project}
+                onChange={(e) => setFilter("project", e.target.value)}
+                className={`mt-1 ${fieldClass}`}
+              >
+                <option value="">All projects</option>
+                {projects.map((name) => (
+                  <option key={name} value={name}>
+                    {name}
+                  </option>
+                ))}
+              </select>
+            </div>
+          </div>
+          <div className="flex gap-2">
+            <button
+              type="button"
+              onClick={exportEntries}
+              className="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
+            >
+              Export CSV
+            </button>
+            <button
+              type="button"
+              onClick={exportTotals}
+              className="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
+            >
+              Export totals
+            </button>
+          </div>
+        </div>
+      </section>
+
+      <section className="rounded-xl bg-white p-6 shadow-sm">
+        <h2 className="text-base font-semibold text-slate-900">Entries</h2>
+        <div className="mt-4">
+          <EntryTable entries={data.items} projects={projects} onChanged={refresh} />
+        </div>
+        <div className="mt-4 flex flex-wrap items-center justify-between gap-3">
+          <p className="text-sm text-slate-500">
+            {data.total} {data.total === 1 ? "entry" : "entries"} · Page {data.page} of{" "}
+            {totalPages}
+          </p>
+          <div className="flex gap-2">
+            <button
+              type="button"
+              onClick={() => setPage((current) => Math.max(1, current - 1))}
+              disabled={page <= 1}
+              className="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50"
+            >
+              Previous
+            </button>
+            <button
+              type="button"
+              onClick={() => setPage((current) => current + 1)}
+              disabled={page >= totalPages}
+              className="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50"
+            >
+              Next
+            </button>
+          </div>
+        </div>
+      </section>
+
+      <section className="rounded-xl bg-white p-6 shadow-sm">
+        <h2 className="text-base font-semibold text-slate-900">Per-project totals</h2>
+        {totals.length === 0 ? (
+          <p className="mt-3 text-sm text-slate-500">No time logged for the current filters.</p>
+        ) : (
+          <ul className="mt-3 divide-y divide-slate-100">
+            {totals.map((item) => (
+              <li key={item.project} className="flex items-center justify-between py-2 text-sm">
+                <span className="font-medium text-slate-900">{item.project}</span>
+                <span className="text-slate-700">{item.hours} h</span>
+              </li>
+            ))}
+            <li className="flex items-center justify-between py-2 text-sm font-semibold text-slate-900">
+              <span>Total</span>
+              <span>{totalHours} h</span>
+            </li>
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
