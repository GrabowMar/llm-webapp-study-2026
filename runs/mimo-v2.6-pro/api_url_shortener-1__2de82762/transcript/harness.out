{"type":"text","timestamp":1794382047852,"sessionID":"ses_e36838f2effeqEiG70H21bo895","part":{"id":"prt_1c9812a51001F1EdYvoGWKz60b","messageID":"msg_1c980cb740016eEtavflAAWUSf","sessionID":"ses_e36838f2effeqEiG70H21bo895","type":"text","text":"Now writing the backend:","time":{"start":1794382047825,"end":1794382047847}}}
{"type":"tool_use","timestamp":1794382047892,"sessionID":"ses_e36838f2effeqEiG70H21bo895","part":{"type":"tool","tool":"write","callID":"call_fcda7b7842c6487b8a56ff66","state":{"status":"completed","input":{"content":"\"\"\"URL shortener: JSON API under /api, redirect endpoint, frontend serving.\"\"\"\n\nimport hmac\nimport os\nimport secrets\nimport sqlite3\nimport string\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import redirect\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\nDEFAULT_PAGE_SIZE = 10\nCODE_ALPHABET = string.ascii_letters + string.digits\nCODE_LENGTH = 7\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    username TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS links (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    original_url TEXT NOT NULL,\n    short_code TEXT NOT NULL UNIQUE,\n    click_count INTEGER NOT NULL DEFAULT 0,\n    is_active INTEGER NOT NULL DEFAULT 1,\n    owner TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_links_created_at ON links (created_at);\nCREATE INDEX IF NOT EXISTS idx_links_short_code ON links (short_code);\n\"\"\"\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with sqlite3.connect(DB_PATH) as conn:\n        conn.executescript(SCHEMA)\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef serialize_link(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Authentication\n# ---------------------------------------------------------------------------\n\ndef token_username():\n    \"\"\"Return the username for the Bearer token on the request, or None.\"\"\"\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT username FROM tokens WHERE token = ?\", (token,)\n    ).fetchone()\n    if row is None:\n        return None\n    username = row[\"username\"]\n    if username == ADMIN_USERNAME and not ADMIN_PASSWORD:\n        return None\n    return username\n\n\ndef require_user():\n    username = token_username()\n    if username is None:\n        return None, (jsonify({\"error\": \"Authentication required\"}), 401)\n    return username, None\n\n\ndef require_admin():\n    username = token_username()\n    if username is None:\n        return None, (jsonify({\"error\": \"Authentication required\"}), 401)\n    if username != ADMIN_USERNAME:\n        return None, (jsonify({\"error\": \"Admin privileges required\"}), 403)\n    return username, None\n\n\ndef issue_token(username: str) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, username, created_at) VALUES (?, ?, ?)\",\n        (token, username, now_iso()),\n    )\n    db.commit()\n    return token\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"Username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"Password is required\"}), 400\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        return jsonify({\"error\": \"Username is reserved\"}), 409\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"Username already taken\"}), 409\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"Username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"Password is required\"}), 400\n    username = username.strip()\n\n    if username == ADMIN_USERNAME:\n        if not ADMIN_PASSWORD:\n            return jsonify({\"error\": \"Admin sign-in is disabled\"}), 401\n        if not hmac.compare_digest(password, ADMIN_PASSWORD):\n            return jsonify({\"error\": \"Invalid username or password\"}), 401\n    else:\n        row = get_db().execute(\n            \"SELECT password_hash FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n        if row is None or not check_password_hash(row[\"password_hash\"], password):\n            return jsonify({\"error\": \"Invalid username or password\"}), 401\n\n    return jsonify({\"token\": issue_token(username)})\n\n\n# ---------------------------------------------------------------------------\n# Links\n# ---------------------------------------------------------------------------\n\ndef parse_pagination():\n    raw_page = request.args.get(\"page\", \"1\")\n    raw_size = request.args.get(\"page_size\", str(DEFAULT_PAGE_SIZE))\n    try:\n        page = int(raw_page)\n        page_size = int(raw_size)\n    except (TypeError, ValueError):\n        return None, None, (jsonify({\"error\": \"Invalid pagination parameters\"}), 400)\n    if page < 1 or page_size < 1:\n        return None, None, (jsonify({\"error\": \"Invalid pagination parameters\"}), 400)\n    return page, page_size, None\n\n\ndef paged_response(rows, total: int, page: int, page_size: int):\n    return jsonify(\n        {\n            \"items\": [serialize_link(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\ndef find_link(link_id: str, active_only: bool = True):\n    try:\n        link_id = int(link_id)\n    except (TypeError, ValueError):\n        return None\n    query = \"SELECT * FROM links WHERE id = ?\"\n    if active_only:\n        query += \" AND is_active = 1\"\n    return get_db().execute(query, (link_id,)).fetchone()\n\n\ndef validate_url(url):\n    if not isinstance(url, str) or not url.strip():\n        return None, (jsonify({\"error\": \"URL is required\"}), 400)\n    url = url.strip()\n    parsed = urlparse(url)\n    if parsed.scheme.lower() not in (\"http\", \"https\") or not parsed.netloc:\n        return None, (\n            jsonify({\"error\": \"Invalid URL: only http and https addresses are accepted\"}),\n            400,\n        )\n    return url, None\n\n\ndef generate_short_code(db) -> str:\n    for _ in range(16):\n        code = \"\".join(secrets.choice(CODE_ALPHABET) for _ in range(CODE_LENGTH))\n        exists = db.execute(\n            \"SELECT 1 FROM links WHERE short_code = ?\", (code,)\n        ).fetchone()\n        if exists is None:\n            return code\n    raise RuntimeError(\"Could not generate a unique short code\")\n\n\n@app.post(\"/api/links\")\ndef create_link():\n    username, err = require_user()\n    if err:\n        return err\n    data = request.get_json(silent=True) or {}\n    url, err = validate_url(data.get(\"url\") or data.get(\"original_url\"))\n    if err:\n        return err\n    db = get_db()\n    code = generate_short_code(db)\n    db.execute(\n        \"INSERT INTO links (original_url, short_code, click_count, is_active, owner, created_at)\"\n        \" VALUES (?, ?, 0, 1, ?, ?)\",\n        (url, code, username, now_iso()),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM links WHERE short_code = ?\", (code,)).fetchone()\n    return jsonify(serialize_link(row)), 201\n\n\n@app.get(\"/api/links\")\ndef list_links():\n    page, page_size, err = parse_pagination()\n    if err:\n        return err\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM links WHERE is_active = 1\"\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM links WHERE is_active = 1\"\n        \" ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return paged_response(rows, total, page, page_size)\n\n\n@app.get(\"/api/links/<link_id>\")\ndef get_link(link_id: str):\n    row = find_link(link_id, active_only=True)\n    if row is None:\n        return jsonify({\"error\": \"Link not found\"}), 404\n    return jsonify(serialize_link(row))\n\n\n@app.delete(\"/api/links/<link_id>\")\ndef delete_link(link_id: str):\n    username, err = require_user()\n    if err:\n        return err\n    row = find_link(link_id, active_only=True)\n    if row is None:\n        return jsonify({\"error\": \"Link not found\"}), 404\n    if row[\"owner\"] != username:\n        return jsonify({\"error\": \"You may only delete your own links\"}), 403\n    db = get_db()\n    db.execute(\"DELETE FROM links WHERE id = ?\", (row[\"id\"],))\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# Admin\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/admin/links\")\ndef admin_list_links():\n    _, err = require_admin()\n    if err:\n        return err\n    page, page_size, err = parse_pagination()\n    if err:\n        return err\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS n FROM links\").fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM links ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return paged_response(rows, total, page, page_size)\n\n\n@app.post(\"/api/admin/links/<link_id>/toggle\")\ndef admin_toggle_link(link_id: str):\n    _, err = require_admin()\n    if err:\n        return err\n    row = find_link(link_id, active_only=False)\n    if row is None:\n        return jsonify({\"error\": \"Link not found\"}), 404\n    db = get_db()\n    db.execute(\n        \"UPDATE links SET is_active = CASE WHEN is_active = 1 THEN 0 ELSE 1 END WHERE id = ?\",\n        (row[\"id\"],),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM links WHERE id = ?\", (row[\"id\"],)).fetchone()\n    return jsonify(serialize_link(row))\n\n\n# ---------------------------------------------------------------------------\n# Redirect\n# ---------------------------------------------------------------------------\n\n@app.get(\"/r/<code>\")\ndef follow_link(code: str):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM links WHERE short_code = ? AND is_active = 1\", (code,)\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Link not found\"}), 404\n    db.execute(\n        \"UPDATE links SET click_count = click_count + 1 WHERE id = ?\", (row[\"id\"],)\n    )\n    db.commit()\n    return redirect(row[\"original_url\"], code=302)\n\n\n# ---------------------------------------------------------------------------\n# Health + frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/api/<path:rest>\")\ndef api_not_found(rest: str):\n    return jsonify({\"error\": \"Not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794382047838,"end":1794382047869}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9812a55001vE4qIxHB96xHsz","sessionID":"ses_e36838f2effeqEiG70H21bo895","messageID":"msg_1c980cb740016eEtavflAAWUSf"}}
