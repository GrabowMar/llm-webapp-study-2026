{"type":"tool_use","timestamp":1794341093890,"sessionID":"ses_e38fd0ea3ffegexy6alSPt6nKt","part":{"type":"tool","tool":"write","callID":"call_851a845b60c64f14b91c3c75","state":{"status":"completed","input":{"content":"#!/usr/bin/env bash\n# End-to-end API test against a running server (BASE url as $1, default localhost:8123).\nset -u\nBASE=\"${1:-http://localhost:8123}\"\nPASS=0\nFAIL=0\nTMP=\"$(mktemp -d)\"\n\ncheck() { # check <name> <expected> <actual>\n  if [ \"$2\" = \"$3\" ]; then PASS=$((PASS + 1)); echo \"ok   $1\";\n  else FAIL=$((FAIL + 1)); echo \"FAIL $1\"; echo \"     expected: $2\"; echo \"     actual:   $3\"; fi\n}\n\njqget() { python3 -c \"import json,sys; d=json.load(sys.stdin); print(d$1)\" 2>/dev/null; }\n\n# tiny PNG (1x1 red) and JPEG (1x1) built with python\npython3 - \"$TMP\" <<'EOF'\nimport base64, struct, sys, zlib\nd = sys.argv[1]\ndef png():\n    sig = b\"\\x89PNG\\r\\n\\x1a\\n\"\n    def chunk(t, data):\n        return struct.pack(\">I\", len(data)) + t + data + struct.pack(\">I\", zlib.crc32(t + data))\n    ihdr = chunk(b\"IHDR\", struct.pack(\">IIBBBBB\", 1, 1, 8, 2, 0, 0, 0))\n    idat = chunk(b\"IDAT\", zlib.compress(b\"\\x00\\xff\\x00\\x00\"))\n    return sig + ihdr + idat + chunk(b\"IEND\", b\"\")\njpeg = bytes.fromhex(\"ffd8ffe000104a46494600010100000100010000ffd9\")\nopen(d + \"/t.png\", \"wb\").write(png())\nopen(d + \"/t.jpg\", \"wb\").write(jpeg())\nopen(d + \"/t.gif\", \"wb\").write(b\"GIF89a\" + b\"\\x00\" * 10)\nopen(d + \"/png.b64\", \"w\").write(base64.b64encode(png()).decode())\nopen(d + \"/jpg.b64\", \"w\").write(base64.b64encode(jpeg()).decode())\nopen(d + \"/gif.b64\", \"w\").write(base64.b64encode(b\"GIF89a\" + b\"\\x00\" * 10).decode())\nEOF\n\nPNG_B64=$(cat \"$TMP/png.b64\")\nJPG_B64=$(cat \"$TMP/jpg.b64\")\nGIF_B64=$(cat \"$TMP/gif.b64\")\n\necho \"== health ==\"\ncheck \"health body\" '{\"status\": \"ok\"}' \"$(curl -s $BASE/api/health)\"\n\necho \"== auth: register ==\"\ncheck \"register 201\" 201 \"$(curl -s -o $TMP/r1 -w '%{http_code}' -X POST $BASE/api/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"secret1\"}')\"\ncheck \"register body\" '{\"username\": \"alice\"}' \"$(cat $TMP/r1)\"\ncheck \"register dup 409\" 409 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"x\"}')\"\ncheck \"register bad body 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"\"}' )\"\ncheck \"register non-json 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/auth/register -d 'username=alice')\"\ncheck \"register bob 201\" 201 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"bob\",\"password\":\"secret2\"}')\"\n\necho \"== auth: login ==\"\ncheck \"login wrong pass 401\" 401 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"nope\"}')\"\ncheck \"login unknown 401\" 401 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"nobody\",\"password\":\"x\"}')\"\nALICE=$(curl -s -X POST $BASE/api/api 2>/dev/null; curl -s -X POST $BASE/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"secret1\"}' | jqget \"['token']\")\nBOB=$(curl -s -X POST $BASE/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"bob\",\"password\":\"secret2\"}' | jqget \"['token']\")\ncheck \"login alice token len\" 43 \"${#ALICE}\"\ncheck \"login bob token len\" 43 \"${#BOB}\"\n\necho \"== images: empty list ==\"\ncheck \"empty list\" '{\"items\": [], \"total\": 0, \"page\": 1, \"page_size\": 20}' \"$(curl -s $BASE/api/images)\"\n\necho \"== images: upload ==\"\ncheck \"upload no auth 401\" 401 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/images -H 'Content-Type: application/json' -d \"{\\\"filename\\\":\\\"a.png\\\",\\\"data\\\":\\\"$PNG_B64\\\"}\")\"\ncheck \"upload bad token 401\" 401 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/images -H 'Authorization: Bearer bogus' -H 'Content-Type: application/json' -d \"{\\\"filename\\\":\\\"a.png\\\",\\\"data\\\":\\\"$PNG_B64\\\"}\")\"\ncheck \"upload gif 400\" 400 \"$(curl -s -o $TMP/e1 -w '%{http_code}' -X POST $BASE/api/images -H \"Authorization: Bearer $ALICE\" -H 'Content-Type: application/json' -d \"{\\\"filename\\\":\\\"a.png\\\",\\\"data\\\":\\\"$GIF_B64\\\"}\")\"\necho \"     gif error message: $(jqget \"['error']\" < $TMP/e1)\"\ncheck \"upload bad base64 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/images -H \"Authorization: Bearer $ALICE\" -H 'Content-Type: application/json' -d '{\"filename\":\"a.png\",\"data\":\"!!!notbase64!!!\"}')\"\ncheck \"upload missing filename 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/images -H \"Authorization: Bearer $ALICE\" -H 'Content-Type: application/json' -d \"{\\\"data\\\":\\\"$PNG_B64\\\"}\")\"\ncheck \"upload jpeg as wrong name 201\" 201 \"$(curl -s -o $TMP/img1 -w '%{http_code}' -X POST $BASE/api/images -H \"Authorization: Bearer $ALICE\" -H 'Content-Type: application/json' -d \"{\\\"filename\\\":\\\"photo.png\\\",\\\"data\\\":\\\"$JPG_B64\\\",\\\"title\\\":\\\"Sunset\\\"}\")\"\n\nIMG1=$(python3 -c \"import json;print(json.load(open('$TMP/img1'))['id'])\")\ncheck \"image1 content_type from content\" \"image/jpeg\" \"$(jqget \"['content_type']\" < $TMP/img1)\"\ncheck \"image1 filename kept\" \"photo.png\" \"$(jqget \"['filename']\" < $TMP/img1)\"\ncheck \"image1 title\" \"Sunset\" \"$(jqget \"['title']\" < $TMP/img1)\"\ncheck \"image1 uploader\" \"alice\" \"$(jqget \"['uploader']\" < $TMP/img1)\"\ncheck \"image1 url\" \"/api/images/$IMG1/file\" \"$(jqget \"['url']\" < $TMP/img1)\"\ncheck \"image1 size\" 19 \"$(jqget \"['size_bytes']\" < $TMP/img1)\"\ncheck \"image1 has id\" \"True\" \"$(python3 -c \"import json;print(isinstance(json.load(open('$TMP/img1'))['id'], int))\")\"\ncheck \"image1 has uploaded_at\" \"True\" \"$(python3 -c \"import json;print(bool(json.load(open('$TMP/img1'))['uploaded_at']))\")\"\n\ncheck \"upload same filename again 201\" 201 \"$(curl -s -o $TMP/img2 -w '%{http_code}' -X POST $BASE/api/images -H \"Authorization: Bearer $ALICE\" -H 'Content-Type: application/json' -d \"{\\\"filename\\\":\\\"photo.png\\\",\\\"data\\\":\\\"$PNG_B64\\\"}\")\"\nIMG2=$(python3 -c \"import json;print(json.load(open('$TMP/img2'))['id'])\")\ncheck \"dup filename is separate image\" \"True\" \"$([ \"$IMG1\" != \"$IMG2\" ] && echo True)\"\ncheck \"image2 content_type\" \"image/png\" \"$(jqget \"['content_type']\" < $TMP/img2)\"\ncheck \"image2 title null\" \"None\" \"$(jqget \"['title']\" < $TMP/img2)\"\n\ncheck \"bob uploads 201\" 201 \"$(curl -s -o $TMP/img3 -w '%{http_code}' -X POST $BASE/api/images -H \"Authorization: Bearer $BOB\" -H 'Content-Type: application/json' -d \"{\\\"filename\\\":\\\"bob.jpg\\\",\\\"data\\\":\\\"$JPG_B64\\\"}\")\"\nIMG3=$(python3 -c \"import json;print(json.load(open('$TMP/img3'))['id'])\")\n\necho \"== images: list ==\"\nLIST=$(curl -s \"$BASE/api/images\")\ncheck \"list total\" 3 \"$(jqget \"['total']\" <<< \"$LIST\")\"\ncheck \"list page\" 1 \"$(jqget \"['page']\" <<< \"$LIST\")\"\ncheck \"list page_size\" 20 \"$(jqget \"['page_size']\" <<< \"$LIST\")\"\ncheck \"list newest first\" \"$IMG3 $IMG2 $IMG1\" \"$(python3 -c \"import json,sys;print(' '.join(str(i['id']) for i in json.load(sys.stdin)['items']))\" <<< \"$LIST\")\"\ncheck \"list item keys\" \"content_type,filename,id,size_bytes,title,uploaded_at,uploader,url\" \"$(python3 -c \"\nimport json,sys\nprint(','.join(sorted(json.load(sys.stdin)['items'][0].keys())))\" <<< \"$LIST\")\"\ncheck \"paging page_size=2\" 2 \"$(curl -s \"$BASE/api/images?page=1&page_size=2\" | jqget \"['items'].__len__()\")\"\ncheck \"paging page=2 size=2\" 1 \"$(curl -s \"$BASE/api/images?page=2&page_size=2\" | jqget \"['items'].__len__()\")\"\ncheck \"paging page=3 size=2 empty\" \"[]\" \"$(curl -s \"$BASE/api/images?page=3&page_size=2\" | jqget \"['items']\")\"\ncheck \"paging preserves total\" 3 \"$(curl -s \"$BASE/api/images?page=9&page_size=2\" | jqget \"['total']\")\"\ncheck \"paging bad page 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' \"$BASE/api/images?page=abc\")\"\ncheck \"paging page=0 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' \"$BASE/api/images?page=0\")\"\ncheck \"paging page_size=0 400\" 400 \"$(curl -s -o /dev/null -w '%{http_code}' \"$BASE/api/images?page_size=0\")\"\n\necho \"== images: get one ==\"\ncheck \"get image 200\" 200 \"$(curl -s -o /dev/null -w '%{http_code}' $BASE/api/images/$IMG1)\"\ncheck \"get matches upload\" \"$(cat $TMP/img1)\" \"$(curl -s $BASE/api/images/$IMG1)\"\ncheck \"get missing 404\" 404 \"$(curl -s -o $dev/null -w '%{http_code}' $BASE/api/images/999999 2>/dev/null; curl -s -o /dev/null -w '%{http_code}' $BASE/api/images/999999)\"\ncheck \"get non-int 404\" 404 \"$(curl -s -o /dev/null -w '%{http_code}' $BASE/api/images/abc)\"\n\necho \"== images: file ==\"\ncheck \"file png status\" 200 \"$(curl -s -o $TMP/f2 -w '%{http_code}' $BASE/api/images/$IMG2/file)\"\ncheck \"file png type\" \"image/png\" \"$(curl -s -o /dev/null -w '%{content_type}' $BASE/api/images/$IMG2/file)\"\ncheck \"file png bytes unchanged\" \"True\" \"$(cmp -s $TMP/f2 $TMP/t.png && echo True)\"\ncheck \"file jpeg type\" \"image/jpeg\" \"$(curl -s -o /dev/null -w '%{content_type}' $BASE/api/images/$IMG1/file)\"\ncheck \"file jpeg bytes unchanged\" \"True\" \"$(curl -s $BASE/api/images/$IMG1/file | cmp -s - $TMP/t.jpg && echo True)\"\ncheck \"file missing 404\" 404 \"$(curl -s -o /dev/null -w '%{http_code}' $BASE/api/images/999999/file)\"\n\necho \"== images: delete ==\"\ncheck \"delete no auth 401\" 401 \"$(curl -s -o /dev/null -w '%{http_code}' -X DELETE $BASE/api/images/$IMG1)\"\ncheck \"delete wrong user 403\" 403 \"$(curl -s -o $TMP/e2 -w '%{http_code}' -X DELETE -H \"Authorization: Bearer $BOB\" $BASE/api/images/$IMG1)\"\necho \"     forbidden message: $(jqget \"['error']\" < $TMP/e2)\"\ncheck \"delete missing 404\" 404 \"$(curl -s -o /dev/null -w '%{http_code}' -X DELETE -H \"Authorization: Bearer $ALICE\" $BASE/api/images/999999)\"\ncheck \"delete own 204\" 204 \"$(curl -s -o /dev/null -w '%{http_code}' -X DELETE -H \"Authorization: Bearer $ALICE\" $BASE/api/images/$IMG1)\"\ncheck \"deleted image 404\" 404 \"$(curl -s -o /dev/null -w '%{http_code}' $BASE/api/images/$IMG1)\"\ncheck \"deleted file 404\" 404 \"$(curl -s -o /dev/null -w '%{http_code}' $BASE/api/images/$IMG1/file)\"\ncheck \"total after delete\" 2 \"$(curl -s $BASE/api/images | jqget \"['total']\")\"\n\necho \"== misc ==\"\ncheck \"unknown api 404 json\" 404 \"$(curl -s -o /dev/null -w '%{http_code}' $BASE/api/nope)\"\ncheck \"api method not allowed\" 405 \"$(curl -s -o /dev/null -w '%{http_code}' -X POST $BASE/api/images/$IMG2/file)\"\n\necho\necho \"PASS=$PASS FAIL=$FAIL\"\nrm -rf \"$TMP\"\n[ \"$FAIL\" = 0 ]\n","filePath":"/workspace/.scratch/apitest.sh"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.scratch/apitest.sh","exists":false,"truncated":false},"title":".scratch/apitest.sh","time":{"start":1794341093875,"end":1794341093887}},"id":"prt_1c71041ed001MQwh1xr0r8Or0q","sessionID":"ses_e38fd0ea3ffegexy6alSPt6nKt","messageID":"msg_1c70f893e001lk14hB6HNd6IBC"}}
