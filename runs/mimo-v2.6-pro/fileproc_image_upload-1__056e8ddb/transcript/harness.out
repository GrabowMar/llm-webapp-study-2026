{"type":"tool_use","timestamp":1794341735855,"sessionID":"ses_e38fd0ea3ffegexy6alSPt6nKt","part":{"type":"tool","tool":"read","callID":"call_84d0d314a6074fcba9b44fed","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","limit":80},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask image gallery: JSON API under /api and the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import base64\n6: import binascii\n7: import secrets\n8: import sqlite3\n9: import uuid\n10: from datetime import datetime, timezone\n11: from functools import wraps\n12: from pathlib import Path\n13: \n14: from flask import Flask\n15: from flask import Response\n16: from flask import g\n17: from flask import request\n18: from flask import send_from_directory\n19: from werkzeug.security import check_password_hash\n20: from werkzeug.security import generate_password_hash\n21: \n22: BASE_DIR = Path(__file__).resolve().parent.parent\n23: DATA_DIR = BASE_DIR / \"data\"\n24: IMAGE_DIR = DATA_DIR / \"images\"\n25: DB_PATH = DATA_DIR / \"gallery.db\"\n26: DIST = BASE_DIR / \"frontend\" / \"dist\"\n27: \n28: DEFAULT_PAGE_SIZE = 20\n29: \n30: PNG_MAGIC = b\"\\x89PNG\\r\\n\\x1a\\n\"\n31: JPEG_MAGIC = b\"\\xff\\xd8\\xff\"\n32: \n33: SCHEMA = \"\"\"\n34: CREATE TABLE IF NOT EXISTS users (\n35:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n36:     username TEXT NOT NULL UNIQUE,\n37:     password_hash TEXT NOT NULL,\n38:     created_at TEXT NOT NULL\n39: );\n40: CREATE TABLE IF NOT EXISTS tokens (\n41:     token TEXT PRIMARY KEY,\n42:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n43:     created_at TEXT NOT NULL\n44: );\n45: CREATE TABLE IF NOT EXISTS images (\n46:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n47:     filename TEXT NOT NULL,\n48:     title TEXT,\n49:     content_type TEXT NOT NULL,\n50:     size_bytes INTEGER NOT NULL,\n51:     uploaded_at TEXT NOT NULL,\n52:     storage_name TEXT NOT NULL,\n53:     uploader_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n54: );\n55: \"\"\"\n56: \n57: app = Flask(__name__, static_folder=None)\n58: app.json.sort_keys = False\n59: \n60: \n61: def now_iso() -> str:\n62:     return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n63: \n64: \n65: def init_db() -> None:\n66:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n67:     IMAGE_DIR.mkdir(parents=True, exist_ok=True)\n68:     with sqlite3.connect(DB_PATH) as db:\n69:         db.executescript(SCHEMA)\n70: \n71: \n72: init_db()\n73: \n74: \n75: def get_db() -> sqlite3.Connection:\n76:     if \"db\" not in g:\n77:         g.db = sqlite3.connect(DB_PATH)\n78:         g.db.row_factory = sqlite3.Row\n79:         g.db.execute(\"PRAGMA foreign_keys = ON\")\n80:     return g.db\n\n(Showing lines 1-80 of 351. Use offset=81 to continue.)\n</content>","metadata":{"preview":"\"\"\"Flask image gallery: JSON API under /api and the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport secrets\nimport sqlite3\nimport uuid\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import Response\nfrom flask import g\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask image gallery: JSON API under /api and the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport secrets\nimport sqlite3\nimport uuid\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import Response\nfrom flask import g\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nIMAGE_DIR = DATA_DIR / \"images\"\nDB_PATH = DATA_DIR / \"gallery.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nDEFAULT_PAGE_SIZE = 20\n\nPNG_MAGIC = b\"\\x89PNG\\r\\n\\x1a\\n\"\nJPEG_MAGIC = b\"\\xff\\xd8\\xff\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS images (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    filename TEXT NOT NULL,\n    title TEXT,\n    content_type TEXT NOT NULL,\n    size_bytes INTEGER NOT NULL,\n    uploaded_at TEXT NOT NULL,\n    storage_name TEXT NOT NULL,\n    uploader_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    IMAGE_DIR.mkdir(parents=True, exist_ok=True)\n    with sqlite3.connect(DB_PATH) as db:\n        db.executescript(SCHEMA)\n\n\ninit_db()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db","lineStart":1,"lineEnd":80,"totalLines":351,"truncated":true}},"title":"backend/app.py","time":{"start":1794341735739,"end":1794341735800}},"id":"prt_1c71a0d31001cgrFAbYbwTw6J8","sessionID":"ses_e38fd0ea3ffegexy6alSPt6nKt","messageID":"msg_1c719efd1001fOAg7rj3NSS8J9"}}
