ckend/app.py","status":"in_progress","priority":"high"},{"content":"Set up Tailwind + Vite React TS frontend structure","status":"pending","priority":"high"},{"content":"Implement frontend UI (auth, leaderboard, score form, my scores, admin panel)","status":"pending","priority":"high"},{"content":"Test API end-to-end with curl/scripts","status":"pending","priority":"high"},{"content":"Build frontend and verify Docker image runs on port 8000","status":"pending","priority":"high"}],"truncated":false},"title":"5 todos","time":{"start":1794369453471,"end":1794369453481}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8c0fd970016mbLe8l0Kl1XKW","sessionID":"ses_e3745a4cfffehTIBSvqZ4jZ3EV","messageID":"msg_1c8c09bd7001wsQfTZYsg6Af4H"}}
{"type":"tool_use","timestamp":1794369453524,"sessionID":"ses_e3745a4cfffehTIBSvqZ4jZ3EV","part":{"type":"tool","tool":"write","callID":"call_730d99a98795428ab84bd20b","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Game leaderboard: JSON API under /api and the built web frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, time, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (BASE_DIR / \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nADMIN_USERNAME = \"admin\"\nRESERVED_USERNAMES = {ADMIN_USERNAME}\n\nPERIOD_ALIASES = {\n    \"all\": \"all\",\n    \"all-time\": \"all\",\n    \"alltime\": \"all\",\n    \"all_time\": \"all\",\n    \"week\": \"week\",\n    \"weekly\": \"week\",\n    \"this-week\": \"week\",\n    \"this_week\": \"week\",\n    \"today\": \"today\",\n    \"daily\": \"today\",\n    \"day\": \"today\",\n}\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS scores (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    player_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    score NUMERIC NOT NULL,\n    achieved_at TEXT NOT NULL,\n    is_hidden INTEGER NOT NULL DEFAULT 0\n);\nCREATE INDEX IF NOT EXISTS idx_scores_player ON scores (player_id);\nCREATE INDEX IF NOT EXISTS idx_scores_achieved ON scores (achieved_at);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database helpers\n# ---------------------------------------------------------------------------\n\ndef utcnow() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(value: datetime) -> str:\n    return value.isoformat(timespec=\"microseconds\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        db = sqlite3.connect(DB_PATH)\n        db.row_factory = sqlite3.Row\n        db.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = db\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    try:\n        db.executescript(SCHEMA)\n        db.commit()\n        ensure_admin(db)\n    finally:\n        db.close()\n\n\ndef ensure_admin(db: sqlite3.Connection) -> bool:\n    \"\"\"Create/update the admin account when ADMIN_PASSWORD is set.\"\"\"\n    password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n    if not password:\n        return False\n    password_hash = generate_password_hash(password)\n    row = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n    ).fetchone()\n    if row:\n        db.execute(\n            \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n            (password_hash, row[\"id\"]),\n        )\n    else:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n            \" VALUES (?, ?, 1, ?)\",\n            (ADMIN_USERNAME, password_hash, iso(utcnow())),\n        )\n    db.commit()\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Auth helpers\n# ---------------------------------------------------------------------------\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n\n\ndef issue_token(db: sqlite3.Connection, user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token_hash, user_id, created_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user_id, iso(utcnow())),\n    )\n    db.commit()\n    return token\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    db = get_db()\n    return db.execute(\n        \"SELECT u.id, u.username, u.is_admin FROM tokens t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token.strip()),),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return {\"error\": \"authentication required\"}, 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None or not user[\"is_admin\"]:\n            return {\"error\": \"admin access required\"}, 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n# ---------------------------------------------------------------------------\n# Domain helpers\n# ---------------------------------------------------------------------------\n\ndef score_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"achieved_at\": row[\"achieved_at\"],\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n\n\ndef fetch_score(db: sqlite3.Connection, score_id: int) -> sqlite3.Row | None:\n    return db.execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, u.username\"\n        \" FROM scores s JOIN users u ON u.id = s.player_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n\n\ndef compute_leaderboard(db: sqlite3.Connection, since: str | None = None) -> list[dict]:\n    \"\"\"Rank players by their best visible score (competition ranking).\"\"\"\n    sql = (\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, u.username\"\n        \" FROM scores s JOIN users u ON u.id = s.player_id\"\n        \" WHERE s.is_hidden = 0\"\n    )\n    params: list = []\n    if since is not None:\n        sql += \" AND s.achieved_at >= ?\"\n        params.append(since)\n    sql += \" ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\"\n    best: dict[str, dict] = {}\n    for row in db.execute(sql, params):\n        best.setdefault(\n            row[\"username\"],\n            {\n                \"player\": row[\"username\"],\n                \"score\": row[\"score\"],\n                \"achieved_at\": row[\"achieved_at\"],\n            },\n        )\n    ranked: list[dict] = []\n    previous_score = object()\n    rank = 0\n    for position, item in enumerate(best.values(), start=1):\n        if item[\"score\"] != previous_score:\n            rank = position\n            previous_score = item[\"score\"]\n        ranked.append({\"rank\": rank, **item})\n    return ranked\n\n\ndef period_start(period: str) -> str | None:\n    now = utcnow()\n    if period == \"today\":\n        start = datetime.combine(now.date(), time.min, tzinfo=timezone.utc)\n        return iso(start)\n    if period == \"week\":\n        monday = now.date() - timedelta(days=now.weekday())\n        start = datetime.combine(monday, time.min, tzinfo=timezone.utc)\n        return iso(start)\n    return None\n\n\ndef parse_int(raw: str | None) -> int | None:\n    if raw is None:\n        return None\n    try:\n        return int(raw)\n    except (TypeError, ValueError):\n        return None\n\n\ndef parse_score_value(raw) -> int | float | None:\n    if isinstance(raw, bool):\n        return None\n    if isinstance(raw, int):\n        return raw\n    if isinstance(raw, float):\n        return raw if math.isfinite(raw) else None\n    if isinstance(raw, str):\n        text = raw.strip()\n        try:\n            return int(text)\n        except ValueError:\n            pass\n        try:\n            value = float(text)\n        except ValueError:\n            return None\n        return value if math.isfinite(value) else None\n    return None\n\n\ndef json_body() -> dict:\n    body = request.get_json(silent=True)\n    return body if isinstance(body, dict) else {}\n\n\n# ---------------------------------------------------------------------------\n# Auth routes\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return {\"error\": \"username and password are required\"}, 400\n    username = username.strip()\n    if not username or not password:\n        return {\"error\": \"username and password are required\"}, 400\n    if username.lower() in RESERVED_USERNAMES:\n        return {\"error\": \"username is reserved\"}, 400\n    db = get_db()\n    if db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone():\n        return {\"error\": \"username already taken\"}, 409\n    cursor = db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n        \" VALUES (?, ?, 0, ?)\",\n        (username, generate_password_hash(password), iso(utcnow())),\n    )\n    db.commit()\n    user_id = cursor.lastrowid\n    token = issue_token(db, user_id)\n    return {\"id\": user_id, \"username\": username, \"token\": token}, 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return {\"error\": \"username and password are required\"}, 400\n    username = username.strip()\n    db = get_db()\n    if username == ADMIN_USERNAME:\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n        if not admin_password:\n            return {\"error\": \"admin sign-in is disabled\"}, 401\n        if password != admin_password:\n            return {\"error\": \"invalid credentials\"}, 401\n        ensure_admin(db)\n    else:\n        user = db.execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n        if user is None or not check_password_hash(user[\"password_hash\"], password):\n            return {\"error\": \"invalid credentials\"}, 401\n    user = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    token = issue_token(db, user[\"id\"])\n    return {\"token\": token}\n\n\n# ---------------------------------------------------------------------------\n# Score routes\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/scores\")\n@login_required\ndef create_score():\n    body = json_body()\n    score = parse_score_value(body.get(\"score\"))\n    if score is None:\n        return {\"error\": \"score must be a number\"}, 400\n    db = get_db()\n    user = g.user\n    achieved_at = iso(utcnow())\n    cursor = db.execute(\n        \"INSERT INTO scores (player_id, score, achieved_at, is_hidden)\"\n        \" VALUES (?, ?, ?, 0)\",\n        (user[\"id\"], score, achieved_at),\n    )\n    db.commit()\n    score_id = cursor.lastrowid\n    row = fetch_score(db, score_id)\n    previous_best = db.execute(\n        \"SELECT MAX(score) AS best FROM scores\"\n        \" WHERE player_id = ? AND is_hidden = 0 AND id != ?\",\n        (user[\"id\"], score_id),\n    ).fetchone()[\"best\"]\n    personal_best = previous_best is None or score >= previous_best\n    rank = next(\n        (\n            item[\"rank\"]\n            for item in compute_leaderboard(db)\n            if item[\"player\"] == user[\"username\"]\n        ),\n        None,\n    )\n    return {\n        **score_to_dict(row),\n        \"rank\": rank,\n        \"personal_best\": bool(personal_best),\n    }, 201\n\n\n@app.get(\"/api/scores\")\n@login_required\ndef list_my_scores():\n    db = get_db()\n    user = g.user\n    rows = db.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username\"\n        \" FROM scores s JOIN users u ON u.id = s.player_id\"\n        \" WHERE s.player_id = ?\"\n        \" ORDER BY s.achieved_at DESC, s.id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    best = db.execute(\n        \"SELECT MAX(score) AS best FROM scores\"\n        \" WHERE player_id = ? AND is_hidden = 0\",\n        (user[\"id\"],),\n    ).fetchone()[\"best\"]\n    return {\n        \"items\": [score_to_dict(row) for row in rows],\n        \"best_score\": best,\n    }\n\n\n# ---------------------------------------------------------------------------\n# Leaderboard\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    db = get_db()\n    raw_period = (request.args.get(\"period\") or \"all\").strip().lower()\n    period = PERIOD_ALIASES.get(raw_period, \"all\")\n    ranked = compute_leaderboard(db, period_start(period))\n    player = (request.args.get(\"player\") or \"\").strip().lower()\n    if player:\n        ranked = [item for item in ranked if player in item[\"player\"].lower()]\n    total = len(ranked)\n    limit = parse_int(request.args.get(\"limit\"))\n    if limit is not None and limit >= 1:\n        ranked = ranked[:limit]\n    return {\"items\": ranked, \"total\": total}\n\n\n# ---------------------------------------------------------------------------\n# Admin routes\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/admin/scores\")\n@admin_required\ndef admin_list_scores():\n    db = get_db()\n    page = parse_int(request.args.get(\"page\")) or 1\n    page = max(page, 1)\n    page_size = parse_int(request.args.get(\"page_size\")) or 100\n    page_size = max(page_size, 1)\n    total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username\"\n        \" FROM scores s JOIN users u ON u.id = s.player_id\"\n        \" ORDER BY s.achieved_at DESC, s.id DESC\"\n        \" LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return {\n        \"items\": [score_to_dict(row) for row in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n@admin_required\ndef admin_toggle_score(score_id: int):\n    db = get_db()\n    row = fetch_score(db, score_id)\n    if row is None:\n        return {\"error\": \"score not found\"}, 404\n    hidden = 0 if row[\"is_hidden\"] else 1\n    db.execute(\"UPDATE scores SET is_hidden = ? WHERE id = ?\", (hidden, score_id))\n    db.commit()\n    return score_to_dict(fetch_score(db, score_id))\n\n\n# ---------------------------------------------------------------------------\n# Health and frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return {\"error\": \"not found\"}, 404\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(404)\ndef not_found(error):\n    if request.path.startswith(\"/api/\"):\n        return {\"error\": \"not found\"}, 404\n    if (DIST / \"index.html\").is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return {\"error\": \"not found\"}, 404\n\n\n@app.errorhandler(405)\ndef method_not_allowed(error):\n    return {\"error\": \"method not allowed\"}, 405\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794369453486,"end":1794369453507}},"id":"prt_1c8c0fda20013ADvHMEgLa2W2p","sessionID":"ses_e3745a4cfffehTIBSvqZ4jZ3EV","messageID":"msg_1c8c09bd7001wsQfTZYsg6Af4H"}}
