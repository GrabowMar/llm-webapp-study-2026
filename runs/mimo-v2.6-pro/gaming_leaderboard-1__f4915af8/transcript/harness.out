{"type":"tool_use","timestamp":1794369690847,"sessionID":"ses_e3745a4cfffehTIBSvqZ4jZ3EV","part":{"type":"tool","tool":"write","callID":"call_0dbcc2a3572c42b8aeb6980c","state":{"status":"completed","input":{"content":"\"\"\"Smoke test for the game leaderboard API.\"\"\"\nimport sqlite3\nimport sys\n\nimport requests\n\nBASE = \"http://127.0.0.1:8000\"\nDB = \"/workspace/data/app.db\"\npassed = []\nfailed = []\n\n\ndef check(name, condition, detail=\"\"):\n    if condition:\n        passed.append(name)\n    else:\n        failed.append((name, detail))\n        print(f\"FAIL: {name} {detail}\")\n\n\ndef eq(name, got, want):\n    check(name, got == want, f\"got={got!r} want={want!r}\")\n\n\n# health\neq(\"health\", requests.get(f\"{BASE}/api/health\").json(), {\"status\": \"ok\"})\n\n# register\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"alice\", \"password\": \"pw1\"})\neq(\"register 201\", r.status_code, 201)\nbody = r.json()\neq(\"register username\", body[\"username\"], \"alice\")\ncheck(\"register token\", isinstance(body.get(\"token\"), str) and len(body[\"token\"]) > 10)\n\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"})\neq(\"duplicate register 409\", r.status_code, 409)\n\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"admin\", \"password\": \"x\"})\ncheck(\"reserve admin\", r.status_code in (400, 403), f\"got {r.status_code}\")\ncheck(\"reserve Admin\", requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"Admin\", \"password\": \"x\"}).status_code in (400, 403))\n\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"bob\"})\neq(\"register missing password 400\", r.status_code, 400)\n\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"  \", \"password\": \"x\"})\ncheck(\"register blank username\", r.status_code in (400, 422), f\"got {r.status_code}\")\n\n# login\nr = requests.post(f\"{BASE}/api/auth/login\", json={\"username\": \"alice\", \"password\": \"pw1\"})\neq(\"login 200\", r.status_code, 200)\ntok_alice = r.json()[\"token\"]\neq(\"login body keys\", set(r.json()), {\"token\"})\n\nr = requests.post(f\"{BASE}/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"})\neq(\"login wrong password 401\", r.status_code, 401)\n\nr = requests.post(f\"{BASE}/api/auth/login\", json={\"username\": \"ghost\", \"password\": \"x\"})\neq(\"login unknown user 401\", r.status_code, 401)\n\nr = requests.post(f\"{BASE}/api/auth/login\", json={\"username\": \"admin\", \"password\": \"secret123\"})\neq(\"admin login 200\", r.status_code, 200)\ntok_admin = r.json()[\"token\"]\n\nr = requests.post(f\"{BASE}/api/auth/login\", json={\"username\": \"admin\", \"password\": \"nope\"})\neq(\"admin login wrong 401\", r.status_code, 401)\n\n# register bob + carol\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"bob\", \"password\": \"pw2\"})\ntok_bob = r.json()[\"token\"]\nr = requests.post(f\"{BASE}/api/auth/register\", json={\"username\": \"carol\", \"password\": \"pw3\"})\ntok_carol = r.json()[\"token\"]\nH_ALICE = {\"Authorization\": f\"Bearer {tok_alice}\"}\nH_BOB = {\"Authorization\": f\"Bearer {tok_bob}\"}\nH_CAROL = {\"Authorization\": f\"Bearer {tok_carol}\"}\nH_ADMIN = {\"Authorization\": f\"Bearer {tok_admin}\"}\n\n# auth required\neq(\"scores no token 401\", requests.get(f\"{BASE}/api/scores\").status_code, 401)\neq(\"scores bad token 401\", requests.get(f\"{BASE}/api/scores\", headers={\"Authorization\": \"Bearer zzz\"}).status_code, 401)\neq(\"admin no token 401\", requests.get(f\"{BASE}/api/admin/scores\").status_code, 401)\neq(\"leaderboard public\", requests.get(f\"{BASE}/api/leaderboard\").status_code, 200)\n\n# submit scores\nr = requests.post(f\"{BASE}/api/scores\", json={\"score\": 100}, headers=H_ALICE)\neq(\"post score 201\", r.status_code, 201)\ns = r.json()\neq(\"score shape keys\", set(s), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\", \"rank\", \"personal_best\"})\neq(\"score player\", s[\"player\"], \"alice\")\neq(\"score value\", s[\"score\"], 100)\neq(\"score is_hidden\", s[\"is_hidden\"], False)\neq(\"score personal_best first\", s[\"personal_best\"], True)\neq(\"score rank first\", s[\"rank\"], 1)\ncheck(\"score achieved_at set\", isinstance(s[\"achieved_at\"], str) and s[\"achieved_at\"])\n\nr = requests.post(f\"{BASE}/api/scores\", json={\"score\": 250}, headers=H_ALICE)\ns = r.json()\neq(\"alice 250 pb\", s[\"personal_best\"], True)\neq(\"alice 250 rank\", s[\"rank\"], 1)\n\nr = requests.post(f\"{BASE}/api/scores\", json={\"score\": 150}, headers=H_BOB)\ns = r.json()\neq(\"bob 150 pb\", s[\"personal_best\"], True)\neq(\"bob 150 rank\", s[\"rank\"], 2)\n\nr = requests.post(f\"{BASE}/api/scores\", json={\"score\": 175}, headers=H_CAROL)\ns = r.json()\neq(\"carol 175 rank\", s[\"rank\"], 2)\n\nr = requests.post(f\"{BASE}/api/scores\", json={\"score\": 20}, headers=H_ALICE)\ns = r.json()\neq(\"alice 20 pb false\", s[\"personal_best\"], False)\neq(\"alice 20 rank still 1\", s[\"rank\"], 1)\n\nr = requests.post(f\"{BASE}/api/scores\", headers=H_ALICE)\neq(\"post score no body 400\", r.status_code, 400)\nr = requests.post(f\"{BASE}/api/scores\", json={\"score\": \"abc\"}, headers=H_ALICE)\neq(\"post score bad value 400\", r.status_code, 400)\n\n# my scores\nr = requests.get(f\"{BASE}/api/scores\", headers=H_ALICE)\nd = r.json()\neq(\"my scores keys\", set(d), {\"items\", \"best_score\"})\neq(\"my scores count\", len(d[\"items\"]), 3)\neq(\"my scores best\", d[\"best_score\"], 250)\ncheck(\"my scores newest first\", d[\"items\"][0][\"score\"] == 20 and d[\"items\"][-1][\"score\"] == 100,\n      f\"got {[i['score'] for i in d['items']]}\")\neq(\"my scores all alice\", {i[\"player\"] for i in d[\"items\"]}, {\"alice\"})\n\n# leaderboard\nr = requests.get(f\"{BASE}/api/leaderboard\")\nd = r.json()\neq(\"leaderboard keys\", set(d), {\"items\", \"total\"})\neq(\"leaderboard total\", d[\"total\"], 3)\neq(\"leaderboard names\", [i[\"player\"] for i in d[\"items\"]], [\"alice\", \"carol\", \"bob\"])\neq(\"leaderboard ranks\", [i[\"rank\"] for i in d[\"items\"]], [1, 2, 3])\neq(\"leaderboard scores\", [i[\"score\"] for i in d[\"items\"]], [250, 175, 150])\ncheck(\"leaderboard item keys\", set(d[\"items\"][0]) == {\"rank\", \"player\", \"score\", \"achieved_at\"})\n\neq(\"leaderboard today\", requests.get(f\"{BASE}/api/leaderboard?period=today\").json()[\"total\"], 3)\neq(\"leaderboard week\", requests.get(f\"{BASE}/api/leaderboard?period=week\").json()[\"total\"], 3)\n\nd = requests.get(f\"{BASE}/api/leaderboard?limit=2\").json()\neq(\"leaderboard limit items\", len(d[\"items\"]), 2)\neq(\"leaderboard limit total\", d[\"total\"], 3)\n\nd = requests.get(f\"{BASE}/api/leaderboard?player=bo\").json()\neq(\"leaderboard player filter\", [i[\"player\"] for i in d[\"items\"]], [\"bob\"])\neq(\"leaderboard player filter rank\", d[\"items\"][0][\"rank\"], 3)\neq(\"leaderboard player filter total\", d[\"total\"], 1)\n\nd = requests.get(f\"{BASE}/api/leaderboard?player=zzz\").json()\neq(\"leaderboard no match\", (d[\"items\"], d[\"total\"]), ([], 0))\n\n# backdate a score to test periods (directly in sqlite)\nconn = sqlite3.connect(DB)\nconn.execute(\n    \"INSERT INTO scores (player_id, score, achieved_at, is_hidden)\"\n    \" SELECT id, 999, '2020-01-01T00:00:00.000000+00:00', 0 FROM users WHERE username='bob'\"\n)\nconn.commit()\nconn.close()\nd = requests.get(f\"{BASE}/api/leaderboard?period=today\").json()\neq(\"today excludes backdated\", d[\"total\"], 3)\nd = requests.get(f\"{BASE}/api/leaderboard\").json()\neq(\"all includes backdated\", d[\"total\"], 3)\neq(\"all backdated rank 1\", d[\"items\"][0][\"player\"], \"bob\")\neq(\"all backdated score\", d[\"items\"][0][\"score\"], 999)\n\n# admin endpoints\neq(\"admin list as player 401\", requests.get(f\"{BASE}/api/admin/scores\", headers=H_ALICE).status_code, 401)\neq(\"toggle as player 401\", requests.post(f\"{BASE}/api/admin/scores/1/toggle\", headers=H_ALICE).status_code, 401)\n\nr = requests.get(f\"{BASE}/api/admin/scores\", headers=H_ADMIN)\nd = r.json()\neq(\"admin keys\", set(d), {\"items\", \"total\", \"page\", \"page_size\"})\neq(\"admin total\", d[\"total\"], 5)\neq(\"admin page\", d[\"page\"], 1)\ncheck(\"admin newest first\", d[\"items\"][0][\"id\"] > d[\"items\"][1][\"id\"])\ncheck(\"admin includes all\", len(d[\"items\"]) == 5)\n\nd = requests.get(f\"{BASE}/api/admin/scores?page=2&page_size=2\", headers=H_ADMIN).json()\neq(\"admin pagination items\", len(d[\"items\"]), 2)\neq(\"admin pagination page\", d[\"page\"], 2)\neq(\"admin pagination size\", d[\"page_size\"], 2)\neq(\"admin pagination total\", d[\"total\"], 5)\nfirst_ids = [i[\"id\"] for i in requests.get(f\"{BASE}/api/admin/scores?limit=2\", headers=H_ADMIN).json()[\"items\"]]\n\n# toggle hidden\nalice_best_id = None\nfor item in requests.get(f\"{BASE}/api/admin/scores\", headers=H_ADMIN).json()[\"items\"]:\n    if item[\"player\"] == \"alice\" and item[\"score\"] == 250:\n        alice_best_id = item[\"id\"]\ncheck(\"found alice best id\", alice_best_id is not None)\n\nr = requests.post(f\"{BASE}/api/admin/scores/{alice_best_id}/toggle\", headers=H_ADMIN)\neq(\"toggle 200\", r.status_code, 200)\neq(\"toggle hidden now\", r.json()[\"is_hidden\"], True)\neq(\"toggle returns score\", r.json()[\"id\"], alice_best_id)\n\nd = requests.get(f\"{BASE}/api/leaderboard\").json()\neq(\"hidden excluded from board\", d[\"items\"][0][\"score\"], 999)\neq(\"hidden excluded total\", d[\"total\"], 3)\nd = requests.get(f\"{BASE}/api/scores\", headers=H_ALICE).json()\neq(\"hidden excluded best_score\", d[\"best_score\"], 150)\ncheck(\"hidden still listed for owner\", len(d[\"items\"]) == 3)\n\nr = requests.post(f\"{BASE}/api/admin/scores/{alice_best_id}/toggle\", headers=H_ADMIN)\neq(\"untoggle\", r.json()[\"is_hidden\"], False)\nd = requests.get(f\"{BASE}/api/leaderboard\").json()\neq(\"visible again\", d[\"items\"][1][\"score\"], 250)\n\neq(\"toggle missing 404\", requests.post(f\"{BASE}/api/admin/scores/9999/toggle\", headers=H_ADMIN).status_code, 404)\n\n# frontend served\nr = requests.get(f\"{BASE}/\")\ncheck(\"serves index\", r.status_code == 200 and \"<div id=\\\"root\\\">\" in r.text)\nr = requests.get(f\"{BASE}/some/spa/route\")\ncheck(\"spa fallback\", r.status_code == 200 and \"<div id=\\\"root\\\">\" in r.text)\ncheck(\"api 404 json\", requests.get(f\"{BASE}/api/nope\").status_code == 404)\n\nprint(f\"\\n{len(passed)} passed, {len(failed)} failed\")\nsys.exit(1 if failed else 0)\n","filePath":"/workspace/.smoketest.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.smoketest.py","exists":false,"truncated":false},"title":".smoketest.py","time":{"start":1794369690819,"end":1794369690827}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8c49cbe001tL75MY9223ukuW","sessionID":"ses_e3745a4cfffehTIBSvqZ4jZ3EV","messageID":"msg_1c8c43ca4001QBNli30tlBJTvw"}}
