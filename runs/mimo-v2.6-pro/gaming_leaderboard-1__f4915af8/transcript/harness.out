   \"@types/react-dom\": \"^19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"tailwindcss\": \"^4.3.5\",\n    \"typescript\": \"^7.0.2\",\n    \"vite\": \"8.3.5\"\n  }\n}","lineStart":1,"lineEnd":22,"totalLines":22,"truncated":false}},"title":"frontend/package.json","time":{"start":1794369609398,"end":1794369609418}},"id":"prt_1c8c35eaf001MuVc6OUoTu9wDx","sessionID":"ses_e3745a4cfffehTIBSvqZ4jZ3EV","messageID":"msg_1c8c34e410016ipq3jVfqmxE8a"}}
