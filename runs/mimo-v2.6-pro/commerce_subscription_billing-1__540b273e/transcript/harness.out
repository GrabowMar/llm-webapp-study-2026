2026-11-10T16:15:42.316061+00:00\", \"customer_name\": \"Delta\", \"failed_payment_count\": 0, \"id\": 4, \"monthly_amount\": 5.0, \"plan\": \"basic\", \"renewal_date\": \"2026-12-01\", \"status\": \"cancelled\"}], \"page\": 1, \"page_size\": 2, \"total\": 5}\nlen 2\n--- list page 4\n200 {\"items\": [], \"page\": 4, \"page_size\": 2, \"total\": 5}\n--- list bad page\n400 {\"error\": \"page and page_size must be integers\"}\n--- get 1\n200 {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 49.99, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"active\"}\n--- get 999\n404 {\"error\": \"subscription not found\"}\n--- patch partial\n200 {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 49.99, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"active\"}\n--- patch status past_due\n200 {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 49.99, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"past_due\"}\n--- patch money\n200 {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 12.35, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"past_due\"}\n--- patch unknown field\n200 {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 12.35, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"past_due\"}\n--- patch bad status\n400 {\"error\": \"status must be one of: trial, active, past_due, cancelled\"}\n--- invoices empty\n200 {\"items\": []}\n--- issue invoice default\n201 {\"amount_due\": 12.35, \"due_date\": \"2026-11-10\", \"id\": 1, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}\n--- issue invoice explicit\n201 {\"amount_due\": 12.5, \"due_date\": \"2026-12-15\", \"id\": 2, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}\n--- invoices list\n200 {\"items\": [{\"amount_due\": 12.5, \"due_date\": \"2026-12-15\", \"id\": 2, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}, {\"amount_due\": 12.35, \"due_date\": \"2026-11-10\", \"id\": 1, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}]}\n--- collection bad\n400 {\"error\": \"outcome must be 'failed' or 'succeeded'\"}\n--- collection failed\n201 {\"invoices\": [{\"amount_due\": 12.5, \"due_date\": \"2026-12-15\", \"id\": 2, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}, {\"amount_due\": 12.35, \"due_date\": \"2026-11-10\", \"id\": 1, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}], \"run\": {\"created_at\": \"2026-11-10T16:15:42.348330+00:00\", \"id\": 1, \"outcome\": \"failed\", \"subscription_id\": 1}, \"subscription\": {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 1, \"id\": 1, \"monthly_amount\": 12.35, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"past_due\"}}\n--- collection failed 2\n201 {\"invoices\": [{\"amount_due\": 12.5, \"due_date\": \"2026-12-15\", \"id\": 2, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}, {\"amount_due\": 12.35, \"due_date\": \"2026-11-10\", \"id\": 1, \"paid_at\": null, \"status\": \"open\", \"subscription_id\": 1}], \"run\": {\"created_at\": \"2026-11-10T16:15:42.350704+00:00\", \"id\": 2, \"outcome\": \"failed\", \"subscription_id\": 1}, \"subscription\": {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 2, \"id\": 1, \"monthly_amount\": 12.35, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"past_due\"}}\n--- collection succeeded\n201 {\"invoices\": [{\"amount_due\": 12.5, \"due_date\": \"2026-12-15\", \"id\": 2, \"paid_at\": \"2026-11-10T16:15:42.352818+00:00\", \"status\": \"paid\", \"subscription_id\": 1}, {\"amount_due\": 12.35, \"due_date\": \"2026-11-10\", \"id\": 1, \"paid_at\": \"2026-11-10T16:15:42.352818+00:00\", \"status\": \"paid\", \"subscription_id\": 1}], \"run\": {\"created_at\": \"2026-11-10T16:15:42.352818+00:00\", \"id\": 3, \"outcome\": \"succeeded\", \"subscription_id\": 1}, \"subscription\": {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 12.35, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"active\"}}\n--- invoices after\n200 {\"items\": [{\"amount_due\": 12.5, \"due_date\": \"2026-12-15\", \"id\": 2, \"paid_at\": \"2026-11-10T16:15:42.352818+00:00\", \"status\": \"paid\", \"subscription_id\": 1}, {\"amount_due\": 12.35, \"due_date\": \"2026-11-10\", \"id\": 1, \"paid_at\": \"2026-11-10T16:15:42.352818+00:00\", \"status\": \"paid\", \"subscription_id\": 1}]}\n--- sub after\n200 {\"created_at\": \"2026-11-10T16:15:42.307202+00:00\", \"customer_name\": \"Acme Inc\", \"failed_payment_count\": 0, \"id\": 1, \"monthly_amount\": 12.35, \"plan\": \"pro\", \"renewal_date\": \"2026-12-01\", \"status\": \"active\"}\n--- public stats\n200 {\"counts\": {\"active\": 2, \"cancelled\": 1, \"past_due\": 1, \"trial\": 1}, \"mrr\": 162.85}\n--- mrr expected: 212.83\n","exit":0,"truncated":false},"title":"rm -rf data && python3 - <<'EOF'\nimport json\nimport sys\n\nsys.path.insert(0, \"/workspace/backend\")\nimport app as backend\n\ndef show(resp):\n    body = resp.get_json()\n    print(resp.status_code, json.dumps(body))\n    return body\n\nc = backend.app.test_client()\nprint(\"--- health\"); show(c.get(\"/api/health\"))\nprint(\"--- register\"); show(c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"pw123\"}))\nprint(\"--- register dup\"); show(c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"pw123\"}))\nprint(\"--- register bad\"); show(c.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"x\"}))\nprint(\"--- login bad\"); show(c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"nope\"}))\nprint(\"--- login\"); r = show(c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"pw123\"}))\ntok = r[\"token\"]\nH = {\"Authorization\": f\"Bearer {tok}\"}\nprint(\"--- unauth list\"); show(c.get(\"/api/subscriptions\"))\nprint(\"--- bad token\"); show(c.get(\"/api/subscriptions\", headers={\"Authorization\": \"Bearer zzz\"}))\nprint(\"--- create sub\"); show(c.post(\"/api/subscriptions\", json={\"customer_name\": \"Acme\", \"plan\": \"pro\", \"monthly_amount\": 49.99, \"renewal_date\": \"2026-12-01\", \"status\": \"active\"}, headers=H))\nprint(\"--- create trial\"); show(c.post(\"/api/subscriptions\", json={\"customer_name\": \"Beta\", \"plan\": \"basic\", \"monthly_amount\": 10, \"renewal_date\": \"2026-12-01\", \"status\": \"trial\"}, headers=H))\nprint(\"--- create past-due variant\"); show(c.post(\"/api/subscriptions\", json={\"customer_name\": \"Gamma\", \"plan\": \"pro\", \"monthly_amount\": 100.5, \"renewal_date\": \"2026-12-01\", \"status\": \"past-due\"}, headers=H))\nprint(\"--- create cancelled\"); show(c.post(\"/api/subscriptions\", json={\"customer_name\": \"Delta\", \"plan\": \"basic\", \"monthly_amount\": 5, \"renewal_date\": \"2026-12-01\", \"status\": \"cancelled\"}, headers=H))\nprint(\"--- create invalid status\"); show(c.post(\"/api/subscriptions\", json={\"customer_name\": \"X\", \"plan\": \"p\", \"monthly_amount\": 1, \"status\": \"bogus\"}, headers=H))\nprint(\"--- create missing\"); show(c.post(\"/api/subscriptions\", json={\"plan\": \"p\"}, headers=H))\nprint(\"--- create round amount\"); show(c.post(\"/api/subscriptions\", json={\"customer_name\": \"Rounded\", \"plan\": \"pro\", \"monthly_amount\": 49.999, \"renewal_date\": \"2026-12-01\"}, headers=H))\nprint(\"--- list default\"); b = show(c.get(\"/api/subscriptions\", headers=H)); print(\"order:\", [i[\"customer_name\"] for i in b[\"items\"]])\nprint(\"--- list q=ac\"); show(c.get(\"/api/subscriptions?q=Ac\", headers=H))\nprint(\"--- list status=active\"); b = show(c.get(\"/api/subscriptions?status=active\", headers=H)); print(\"names:\", [i[\"customer_name\"] for i in b[\"items\"]])\nprint(\"--- list status=past_due\"); b = show(c.get(\"/api/subscriptions?status=past_due\", headers=H)); print(\"names:\", [i[\"customer_name\"] for i in b[\"items\"]])\nprint(\"--- list plan=basic\"); b = show(c.get(\"/api/subscriptions?plan=basic\", headers=H)); print(\"names:\", [i[\"customer_name\"] for i in b[\"items\"]])\nprint(\"--- list paging\"); b = show(c.get(\"/api/subscriptions?page=1&page_size=2\", headers=H)); print(\"len\", len(b[\"items\"]))\nprint(\"--- list page 4\"); show(c.get(\"/api/subscriptions?page=4&page_size=2\", headers=H))\nprint(\"--- list bad page\"); show(c.get(\"/api/subscriptions?page=abc\", headers=H))\nprint(\"--- get 1\"); show(c.get(\"/api/subscriptions/1\", headers=H))\nprint(\"--- get 999\"); show(c.get(\"/api/subscriptions/999\", headers=H))\nprint(\"--- patch partial\"); show(c.patch(\"/api/subscriptions/1\", json={\"customer_name\": \"Acme Inc\"}, headers=H))\nprint(\"--- patch status past_due\"); show(c.patch(\"/api/subscriptions/1\", json={\"status\": \"past_due\"}, headers=H))\nprint(\"--- patch money\"); show(c.patch(\"/api/subscriptions/1\", json={\"monthly_amount\": \"12.345\"}, headers=H))\nprint(\"--- patch unknown field\"); show(c.patch(\"/api/subscriptions/1\", json={\"bogus\": 1}, headers=H))\nprint(\"--- patch bad status\"); show(c.patch(\"/api/subscriptions/1\", json={\"status\": \"zzz\"}, headers=H))\nprint(\"--- invoices empty\"); show(c.get(\"/api/subscriptions/1/invoices\", headers=H))\nprint(\"--- issue invoice default\"); show(c.post(\"/api/subscriptions/1/invoices\", json={}, headers=H))\nprint(\"--- issue invoice explicit\"); show(c.post(\"/api/subscriptions/1/invoices\", json={\"amount_due\": 12.5, \"due_date\": \"2026-12-15\"}, headers=H))\nprint(\"--- invoices list\"); show(c.get(\"/api/subscriptions/1/invoices\", headers=H))\nprint(\"--- collection bad\"); show(c.post(\"/api/subscriptions/1/collections\", json={\"outcome\": \"weird\"}, headers=H))\nprint(\"--- collection failed\"); show(c.post(\"/api/subscriptions/1/collections\", json={\"outcome\": \"failed\"}, headers=H))\nprint(\"--- collection failed 2\"); b = show(c.post(\"/api/subscriptions/1/collections\", json={\"outcome\": \"failed\"}, headers=H))\nprint(\"--- collection succeeded\"); b = show(c.post(\"/api/subscriptions/1/collections\", json={\"outcome\": \"succeeded\"}, headers=H))\nprint(\"--- invoices after\"); show(c.get(\"/api/subscriptions/1/invoices\", headers=H))\nprint(\"--- sub after\"); show(c.get(\"/api/subscriptions/1\", headers=H))\nprint(\"--- public stats\"); show(c.get(\"/api/public/stats\"))\nprint(\"--- mrr expected:\", round(49.99 + 12.345 + 100.5 + 49.999, 2))\nEOF","time":{"start":1794327341717,"end":1794327342422}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c63e6a81001h9dGl6YAfV80wJ","sessionID":"ses_e39d61a2affeOe5EiBnQQKyKl8","messageID":"msg_1c63e096f001vlb6CrS4ui9DgU"}}
