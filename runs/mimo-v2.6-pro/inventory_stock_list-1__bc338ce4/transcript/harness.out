{"type":"tool_use","timestamp":1794350947879,"sessionID":"ses_e386d783fffeaDLoAZQNXyWTbi","part":{"type":"tool","tool":"read","callID":"call_d36876c4b0c4462684e2fba4","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Warehouse inventory: JSON API under /api plus the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import re\n7: import secrets\n8: import sqlite3\n9: from datetime import datetime, timezone\n10: from functools import wraps\n11: from pathlib import Path\n12: \n13: from flask import Flask\n14: from flask import g\n15: from flask import jsonify\n16: from flask import request\n17: from flask import send_from_directory\n18: from itsdangerous import BadSignature\n19: from itsdangerous import URLSafeSerializer\n20: from werkzeug.security import check_password_hash\n21: from werkzeug.security import generate_password_hash\n22: \n23: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n24: DATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\n25: DB_PATH = DATA_DIR / \"inventory.db\"\n26: \n27: DEFAULT_PAGE_SIZE = 20\n28: MAX_PAGE_SIZE = 100\n29: \n30: SCHEMA = \"\"\"\n31: CREATE TABLE IF NOT EXISTS users (\n32:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n33:     username TEXT NOT NULL UNIQUE,\n34:     password_hash TEXT NOT NULL\n35: );\n36: CREATE TABLE IF NOT EXISTS items (\n37:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n38:     name TEXT NOT NULL,\n39:     sku TEXT NOT NULL UNIQUE,\n40:     location TEXT NOT NULL DEFAULT '',\n41:     quantity INTEGER NOT NULL DEFAULT 0,\n42:     reorder_level INTEGER NOT NULL DEFAULT 0\n43: );\n44: CREATE TABLE IF NOT EXISTS movements (\n45:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n46:     item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,\n47:     delta INTEGER NOT NULL,\n48:     reason TEXT NOT NULL DEFAULT '',\n49:     quantity_after INTEGER NOT NULL,\n50:     created_at TEXT NOT NULL,\n51:     username TEXT NOT NULL\n52: );\n53: CREATE INDEX IF NOT EXISTS idx_movements_item ON movements (item_id);\n54: \"\"\"\n55: \n56: app = Flask(__name__, static_folder=None)\n57: \n58: \n59: # ---------------------------------------------------------------- database\n60: \n61: def get_db() -> sqlite3.Connection:\n62:     conn = g.get(\"db\")\n63:     if conn is None:\n64:         DATA_DIR.mkdir(parents=True, exist_ok=True)\n65:         conn = sqlite3.connect(DB_PATH)\n66:         conn.row_factory = sqlite3.Row\n67:         conn.execute(\"PRAGMA foreign_keys = ON\")\n68:         g.db = conn\n69:     return conn\n70: \n71: \n72: @app.teardown_appcontext\n73: def close_db(_exc):\n74:     conn = g.pop(\"db\", None)\n75:     if conn is not None:\n76:         conn.close()\n77: \n78: \n79: def init_db() -> None:\n80:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n81:     with sqlite3.connect(DB_PATH) as conn:\n82:         conn.executescript(SCHEMA)\n83: \n84: \n85: def get_serializer() -> URLSafeSerializer:\n86:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n87:     key_file = DATA_DIR / \"secret_key\"\n88:     if key_file.is_file():\n89:         secret = key_file.read_bytes()\n90:     else:\n91:         secret = secrets.token_bytes(32)\n92:         key_file.write_bytes(secret)\n93:     return URLSafeSerializer(secret, salt=\"inventory-auth\")\n94: \n95: \n96: init_db()\n97: serializer = get_serializer()\n98: \n99: \n100: # ---------------------------------------------------------------- helpers\n101: \n102: def error(message: str, status: int):\n103:     return jsonify({\"error\": message}), status\n104: \n105: \n106: def body() -> dict:\n107:     data = request.get_json(silent=True)\n108:     return data if isinstance(data, dict) else {}\n109: \n110: \n111: def as_int(value):\n112:     \"\"\"Return an int or None; accepts integral floats and numeric strings.\"\"\"\n113:     if isinstance(value, bool):\n114:         return None\n115:     if isinstance(value, int):\n116:         return value\n117:     if isinstance(value, float):\n118:         return int(value) if value.is_integer() else None\n119:     if isinstance(value, str):\n120:         text = value.strip()\n121:         if re.fullmatch(r\"-?\\d+\", text):\n122:             return int(text)\n123:     return None\n124: \n125: \n126: def text_field(data: dict, field: str, errors: list[str], required: bool = True):\n127:     value = data.get(field)\n128:     if value is None:\n129:         value = \"\"\n130:     if not isinstance(value, str):\n131:         errors.append(f\"{field} must be text\")\n132:         return None\n133:     value = value.strip()\n134:     if required and not value:\n135:         errors.append(f\"{field} is required\")\n136:         return None\n137:     return value\n138: \n139: \n140: def int_field(data: dict, field: str, errors: list[str], default: int = 0, minimum: int = 0):\n141:     value = data.get(field)\n142:     if value is None or value == \"\":\n143:         return default\n144:     value = as_int(value)\n145:     if value is None:\n146:         errors.append(f\"{field} must be a whole number\")\n147:         return None\n148:     if value < minimum:\n149:         errors.append(f\"{field} must be at least {minimum}\")\n150:         return None\n151:     return value\n152: \n153: \n154: def item_json(row: sqlite3.Row) -> dict:\n155:     return {\n156:         \"id\": row[\"id\"],\n157:         \"name\": row[\"name\"],\n158:         \"sku\": row[\"sku\"],\n159:         \"location\": row[\"location\"],\n160:         \"quantity\": row[\"quantity\"],\n161:         \"reorder_level\": row[\"reorder_level\"],\n162:         \"low_stock\": row[\"quantity\"] <= row[\"reorder_level\"],\n163:     }\n164: \n165: \n166: def movement_json(row: sqlite3.Row) -> dict:\n167:     return {\n168:         \"id\": row[\"id\"],\n169:         \"item_id\": row[\"item_id\"],\n170:         \"delta\": row[\"delta\"],\n171:         \"reason\": row[\"reason\"],\n172:         \"quantity_after\": row[\"quantity_after\"],\n173:         \"created_at\": row[\"created_at\"],\n174:         \"username\": row[\"username\"],\n175:     }\n176: \n177: \n178: def find_item(item_id):\n179:     return get_db().execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n180: \n181: \n182: # ---------------------------------------------------------------- auth\n183: \n184: def current_user():\n185:     header = request.headers.get(\"Authorization\", \"\")\n186:     scheme, _, token = header.partition(\" \")\n187:     if scheme.lower() != \"bearer\" or not token:\n188:         return None\n189:     try:\n190:         payload = serializer.loads(token.strip())\n191:     except BadSignature:\n192:         return None\n193:     user_id = payload.get(\"uid\") if isinstance(payload, dict) else None\n194:     if not isinstance(user_id, int):\n195:         return None\n196:     return get_db().execute(\n197:         \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n198:     ).fetchone()\n199: \n200: \n201: def login_required(view):\n202:     @wraps(view)\n203:     def wrapped(*args, **kwargs):\n204:         user = current_user()\n205:         if user is None:\n206:             return error(\"authentication required\", 401)\n207:         g.user = user\n208:         return view(*args, **kwargs)\n209: \n210:     return wrapped\n211: \n212: \n213: @app.post(\"/api/auth/register\")\n214: def register():\n215:     data = body()\n216:     errors: list[str] = []\n217:     username = text_field(data, \"username\", errors)\n218:     password = data.get(\"password\")\n219:     if password is None or password == \"\":\n220:         errors.append(\"password is required\")\n221:         password = None\n222:     elif not isinstance(password, str):\n223:         errors.append(\"password must be text\")\n224:         password = None\n225:     if errors:\n226:         return error(\"; \".join(errors), 400)\n227:     conn = get_db()\n228:     try:\n229:         conn.execute(\n230:             \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n231:             (username, generate_password_hash(password)),\n232:         )\n233:         conn.commit()\n234:     except sqlite3.IntegrityError:\n235:         return error(f\"username '{username}' is already taken\", 409)\n236:     return jsonify({\"username\": username}), 201\n237: \n238: \n239: @app.post(\"/api/auth/login\")\n240: def login():\n241:     data = body()\n242:     username = data.get(\"username\")\n243:     password = data.get(\"password\")\n244:     row = None\n245:     if isinstance(username, str) and isinstance(password, str):\n246:         row = get_db().execute(\n247:             \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n248:         ).fetchone()\n249:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n250:         return error(\"invalid username or password\", 401)\n251:     token = serializer.dumps({\"uid\": row[\"id\"]})\n252:     return jsonify({\"token\": token}), 200\n253: \n254: \n255: # ---------------------------------------------------------------- items\n256: \n257: @app.get(\"/api/items\")\n258: def list_items():\n259:     q = request.args.get(\"q\", \"\").strip()\n260:     location = request.args.get(\"location\", \"\").strip()\n261:     low_stock = request.args.get(\"low_stock\", \"\").strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}\n262: \n263:     page = as_int(request.args.get(\"page\")) or 1\n264:     page = max(page, 1)\n265:     page_size = as_int(request.args.get(\"page_size\")) or DEFAULT_PAGE_SIZE\n266:     page_size = min(max(page_size, 1), MAX_PAGE_SIZE)\n267: \n268:     clauses = []\n269:     params: list = []\n270:     if q:\n271:         clauses.append(\"(name LIKE ? COLLATE NOCASE OR sku LIKE ? COLLATE NOCASE)\")\n272:         params += [f\"%{q}%\", f\"%{q}%\"]\n273:     if location:\n274:         clauses.append(\"location = ? COLLATE NOCASE\")\n275:         params.append(location)\n276:     if low_stock:\n277:         clauses.append(\"quantity <= reorder_level\")\n278:     where = (\" WHERE \" + \" AND \".join(clauses)) if clauses else \"\"\n279: \n280:     conn = get_db()\n281:     total = conn.execute(f\"SELECT COUNT(*) FROM items{where}\", params).fetchone()[0]\n282:     rows = conn.execute(\n283:         f\"SELECT * FROM items{where} ORDER BY name COLLATE NOCASE ASC, id ASC LIMIT ? OFFSET ?\",\n284:         params + [page_size, (page - 1) * page_size],\n285:     ).fetchall()\n286:     return jsonify(\n287:         {\n288:             \"items\": [item_json(row) for row in rows],\n289:             \"total\": total,\n290:             \"page\": page,\n291:             \"page_size\": page_size,\n292:         }\n293:     )\n294: \n295: \n296: @app.post(\"/api/items\")\n297: @login_required\n298: def create_item():\n299:     data = body()\n300:     errors: list[str] = []\n301:     name = text_field(data, \"name\", errors)\n302:     sku = text_field(data, \"sku\", errors)\n303:     location = text_field(data, \"location\", errors, required=False) or \"\"\n304:     reorder_level = int_field(data, \"reorder_level\", errors)\n305:     quantity = int_field(data, \"quantity\", errors)\n306:     if errors:\n307:         return error(\"; \".join(errors), 400)\n308:     conn = get_db()\n309:     try:\n310:         cur = conn.execute(\n311:             \"INSERT INTO items (name, sku, location, quantity, reorder_level) VALUES (?, ?, ?, ?, ?)\",\n312:             (name, sku, location, quantity, reorder_level),\n313:         )\n314:         conn.commit()\n315:     except sqlite3.IntegrityError:\n316:         return error(f\"duplicate sku '{sku}': an item with this sku already exists\", 409)\n317:     return jsonify(item_json(find_item(cur.lastrowid))), 201\n318: \n319: \n320: @app.get(\"/api/items/<int:item_id>\")\n321: def get_item(item_id: int):\n322:     row = find_item(item_id)\n323:     if row is None:\n324:         return error(\"item not found\", 404)\n325:     return jsonify(item_json(row))\n326: \n327: \n328: @app.put(\"/api/items/<int:item_id>\")\n329: @login_required\n330: def update_item(item_id: int):\n331:     row = find_item(item_id)\n332:     if row is None:\n333:         return error(\"item not found\", 404)\n334:     data = body()\n335:     errors: list[str] = []\n336:     name = text_field(data, \"name\", errors)\n337:     sku = text_field(data, \"sku\", errors)\n338:     location = text_field(data, \"location\", errors, required=False) or \"\"\n339:     reorder_level = int_field(data, \"reorder_level\", errors)\n340:     if errors:\n341:         return error(\"; \".join(errors), 400)\n342:     conn = get_db()\n343:     try:\n344:         conn.execute(\n345:             \"UPDATE items SET name = ?, sku = ?, location = ?, reorder_level = ? WHERE id = ?\",\n346:             (name, sku, location, reorder_level, item_id),\n347:         )\n348:         conn.commit()\n349:     except sqlite3.IntegrityError:\n350:         return error(f\"duplicate sku '{sku}': an item with this sku already exists\", 409)\n351:     return jsonify(item_json(find_item(item_id)))\n352: \n353: \n354: @app.delete(\"/api/items/<int:item_id>\")\n355: @login_required\n356: def delete_item(item_id: int):\n357:     conn = get_db()\n358:     row = find_item(item_id)\n359:     if row is None:\n360:         return error(\"item not found\", 404)\n361:     with conn:\n362:         conn.execute(\"DELETE FROM movements WHERE item_id = ?\", (item_id,))\n363:         conn.execute(\"DELETE FROM items WHERE id = ?\", (item_id,))\n364:     return \"\", 204\n365: \n366: \n367: # ---------------------------------------------------------------- movements\n368: \n369: @app.get(\"/api/items/<int:item_id>/movements\")\n370: def list_movements(item_id: int):\n371:     if find_item(item_id) is None:\n372:         return error(\"item not found\", 404)\n373:     rows = get_db().execute(\n374:         \"SELECT * FROM movements WHERE item_id = ? ORDER BY id DESC\", (item_id,)\n375:     ).fetchall()\n376:     return jsonify({\"items\": [movement_json(row) for row in rows]})\n377: \n378: \n379: @app.post(\"/api/items/<int:item_id>/movements\")\n380: @login_required\n381: def create_movement(item_id: int):\n382:     if find_item(item_id) is None:\n383:         return error(\"item not found\", 404)\n384:     data = body()\n385:     errors: list[str] = []\n386:     if \"delta\" not in data or data[\"delta\"] is None:\n387:         errors.append(\"delta is required\")\n388:         delta = None\n389:     else:\n390:         delta = as_int(data[\"delta\"])\n391:         if delta is None:\n392:             errors.append(\"delta must be a whole number\")\n393:         elif delta == 0:\n394:             errors.append(\"delta must not be zero\")\n395:     reason = text_field(data, \"reason\", errors, required=False) or \"\"\n396:     if errors:\n397:         return error(\"; \".join(errors), 400)\n398: \n399:     conn = get_db()\n400:     with conn:\n401:         cur = conn.execute(\n402:             \"UPDATE items SET quantity = quantity + ? WHERE id = ? AND quantity + ? >= 0\",\n403:             (delta, item_id, delta),\n404:         )\n405:         if cur.rowcount == 0:\n406:             return error(\"movement would take stock below zero\", 400)\n407:         quantity_after = conn.execute(\n408:             \"SELECT quantity FROM items WHERE id = ?\", (item_id,)\n409:         ).fetchone()[0]\n410:         cur = conn.execute(\n411:             \"INSERT INTO movements (item_id, delta, reason, quantity_after, created_at, username)\"\n412:             \" VALUES (?, ?, ?, ?, ?, ?)\",\n413:             (\n414:                 item_id,\n415:                 delta,\n416:                 reason,\n417:                 quantity_after,\n418:                 datetime.now(timezone.utc).isoformat(),\n419:                 g.user[\"username\"],\n420:             ),\n421:         )\n422:     row = conn.execute(\"SELECT * FROM movements WHERE id = ?\", (cur.lastrowid,)).fetchone()\n423:     return jsonify(movement_json(row)), 201\n424: \n425: \n426: # ---------------------------------------------------------------- frontend\n427: \n428: @app.get(\"/api/health\")\n429: def health():\n430:     return {\"status\": \"ok\"}\n431: \n432: \n433: @app.get(\"/\")\n434: @app.get(\"/<path:path>\")\n435: def frontend(path: str = \"index.html\"):\n436:     if path.startswith(\"api/\"):\n437:         return error(\"not found\", 404)\n438:     if (DIST / path).is_file():\n439:         return send_from_directory(DIST, path)\n440:     return send_from_directory(DIST, \"index.html\")\n\n(End of file - total 440 lines)\n</content>","metadata":{"preview":"\"\"\"Warehouse inventory: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom itsdangerous import BadSignature\nfrom itsdangerous import URLSafeSerializer\nfrom werkzeug.security import check_password_hash","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Warehouse inventory: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom itsdangerous import BadSignature\nfrom itsdangerous import URLSafeSerializer\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"inventory.db\"\n\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    sku TEXT NOT NULL UNIQUE,\n    location TEXT NOT NULL DEFAULT '',\n    quantity INTEGER NOT NULL DEFAULT 0,\n    reorder_level INTEGER NOT NULL DEFAULT 0\n);\nCREATE TABLE IF NOT EXISTS movements (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,\n    delta INTEGER NOT NULL,\n    reason TEXT NOT NULL DEFAULT '',\n    quantity_after INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    username TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_movements_item ON movements (item_id);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------- database\n\ndef get_db() -> sqlite3.Connection:\n    conn = g.get(\"db\")\n    if conn is None:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return conn\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with sqlite3.connect(DB_PATH) as conn:\n        conn.executescript(SCHEMA)\n\n\ndef get_serializer() -> URLSafeSerializer:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    key_file = DATA_DIR / \"secret_key\"\n    if key_file.is_file():\n        secret = key_file.read_bytes()\n    else:\n        secret = secrets.token_bytes(32)\n        key_file.write_bytes(secret)\n    return URLSafeSerializer(secret, salt=\"inventory-auth\")\n\n\ninit_db()\nserializer = get_serializer()\n\n\n# ---------------------------------------------------------------- helpers\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef as_int(value):\n    \"\"\"Return an int or None; accepts integral floats and numeric strings.\"\"\"\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float):\n        return int(value) if value.is_integer() else None\n    if isinstance(value, str):\n        text = value.strip()\n        if re.fullmatch(r\"-?\\d+\", text):\n            return int(text)\n    return None\n\n\ndef text_field(data: dict, field: str, errors: list[str], required: bool = True):\n    value = data.get(field)\n    if value is None:\n        value = \"\"\n    if not isinstance(value, str):\n        errors.append(f\"{field} must be text\")\n        return None\n    value = value.strip()\n    if required and not value:\n        errors.append(f\"{field} is required\")\n        return None\n    return value\n\n\ndef int_field(data: dict, field: str, errors: list[str], default: int = 0, minimum: int = 0):\n    value = data.get(field)\n    if value is None or value == \"\":\n        return default\n    value = as_int(value)\n    if value is None:\n        errors.append(f\"{field} must be a whole number\")\n        return None\n    if value < minimum:\n        errors.append(f\"{field} must be at least {minimum}\")\n        return None\n    return value\n\n\ndef item_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"sku\": row[\"sku\"],\n        \"location\": row[\"location\"],\n        \"quantity\": row[\"quantity\"],\n        \"reorder_level\": row[\"reorder_level\"],\n        \"low_stock\": row[\"quantity\"] <= row[\"reorder_level\"],\n    }\n\n\ndef movement_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"item_id\": row[\"item_id\"],\n        \"delta\": row[\"delta\"],\n        \"reason\": row[\"reason\"],\n        \"quantity_after\": row[\"quantity_after\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": row[\"username\"],\n    }\n\n\ndef find_item(item_id):\n    return get_db().execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n\n\n# ---------------------------------------------------------------- auth\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token:\n        return None\n    try:\n        payload = serializer.loads(token.strip())\n    except BadSignature:\n        return None\n    user_id = payload.get(\"uid\") if isinstance(payload, dict) else None\n    if not isinstance(user_id, int):\n        return None\n    return get_db().execute(\n        \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    errors: list[str] = []\n    username = text_field(data, \"username\", errors)\n    password = data.get(\"password\")\n    if password is None or password == \"\":\n        errors.append(\"password is required\")\n        password = None\n    elif not isinstance(password, str):\n        errors.append(\"password must be text\")\n        password = None\n    if errors:\n        return error(\"; \".join(errors), 400)\n    conn = get_db()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(f\"username '{username}' is already taken\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    row = None\n    if isinstance(username, str) and isinstance(password, str):\n        row = get_db().execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n        ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = serializer.dumps({\"uid\": row[\"id\"]})\n    return jsonify({\"token\": token}), 200\n\n\n# ---------------------------------------------------------------- items\n\n@app.get(\"/api/items\")\ndef list_items():\n    q = request.args.get(\"q\", \"\").strip()\n    location = request.args.get(\"location\", \"\").strip()\n    low_stock = request.args.get(\"low_stock\", \"\").strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}\n\n    page = as_int(request.args.get(\"page\")) or 1\n    page = max(page, 1)\n    page_size = as_int(request.args.get(\"page_size\")) or DEFAULT_PAGE_SIZE\n    page_size = min(max(page_size, 1), MAX_PAGE_SIZE)\n\n    clauses = []\n    params: list = []\n    if q:\n        clauses.append(\"(name LIKE ? COLLATE NOCASE OR sku LIKE ? COLLATE NOCASE)\")\n        params += [f\"%{q}%\", f\"%{q}%\"]\n    if location:\n        clauses.append(\"location = ? COLLATE NOCASE\")\n        params.append(location)\n    if low_stock:\n        clauses.append(\"quantity <= reorder_level\")\n    where = (\" WHERE \" + \" AND \".join(clauses)) if clauses else \"\"\n\n    conn = get_db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM items{where}\", params).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM items{where} ORDER BY name COLLATE NOCASE ASC, id ASC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [item_json(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/items\")\n@login_required\ndef create_item():\n    data = body()\n    errors: list[str] = []\n    name = text_field(data, \"name\", errors)\n    sku = text_field(data, \"sku\", errors)\n    location = text_field(data, \"location\", errors, required=False) or \"\"\n    reorder_level = int_field(data, \"reorder_level\", errors)\n    quantity = int_field(data, \"quantity\", errors)\n    if errors:\n        return error(\"; \".join(errors), 400)\n    conn = get_db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO items (name, sku, location, quantity, reorder_level) VALUES (?, ?, ?, ?, ?)\",\n            (name, sku, location, quantity, reorder_level),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(f\"duplicate sku '{sku}': an item with this sku already exists\", 409)\n    return jsonify(item_json(find_item(cur.lastrowid))), 201\n\n\n@app.get(\"/api/items/<int:item_id>\")\ndef get_item(item_id: int):\n    row = find_item(item_id)\n    if row is None:\n        return error(\"item not found\", 404)\n    return jsonify(item_json(row))\n\n\n@app.put(\"/api/items/<int:item_id>\")\n@login_required\ndef update_item(item_id: int):\n    row = find_item(item_id)\n    if row is None:\n        return error(\"item not found\", 404)\n    data = body()\n    errors: list[str] = []\n    name = text_field(data, \"name\", errors)\n    sku = text_field(data, \"sku\", errors)\n    location = text_field(data, \"location\", errors, required=False) or \"\"\n    reorder_level = int_field(data, \"reorder_level\", errors)\n    if errors:\n        return error(\"; \".join(errors), 400)\n    conn = get_db()\n    try:\n        conn.execute(\n            \"UPDATE items SET name = ?, sku = ?, location = ?, reorder_level = ? WHERE id = ?\",\n            (name, sku, location, reorder_level, item_id),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(f\"duplicate sku '{sku}': an item with this sku already exists\", 409)\n    return jsonify(item_json(find_item(item_id)))\n\n\n@app.delete(\"/api/items/<int:item_id>\")\n@login_required\ndef delete_item(item_id: int):\n    conn = get_db()\n    row = find_item(item_id)\n    if row is None:\n        return error(\"item not found\", 404)\n    with conn:\n        conn.execute(\"DELETE FROM movements WHERE item_id = ?\", (item_id,))\n        conn.execute(\"DELETE FROM items WHERE id = ?\", (item_id,))\n    return \"\", 204\n\n\n# ---------------------------------------------------------------- movements\n\n@app.get(\"/api/items/<int:item_id>/movements\")\ndef list_movements(item_id: int):\n    if find_item(item_id) is None:\n        return error(\"item not found\", 404)\n    rows = get_db().execute(\n        \"SELECT * FROM movements WHERE item_id = ? ORDER BY id DESC\", (item_id,)\n    ).fetchall()\n    return jsonify({\"items\": [movement_json(row) for row in rows]})\n\n\n@app.post(\"/api/items/<int:item_id>/movements\")\n@login_required\ndef create_movement(item_id: int):\n    if find_item(item_id) is None:\n        return error(\"item not found\", 404)\n    data = body()\n    errors: list[str] = []\n    if \"delta\" not in data or data[\"delta\"] is None:\n        errors.append(\"delta is required\")\n        delta = None\n    else:\n        delta = as_int(data[\"delta\"])\n        if delta is None:\n            errors.append(\"delta must be a whole number\")\n        elif delta == 0:\n            errors.append(\"delta must not be zero\")\n    reason = text_field(data, \"reason\", errors, required=False) or \"\"\n    if errors:\n        return error(\"; \".join(errors), 400)\n\n    conn = get_db()\n    with conn:\n        cur = conn.execute(\n            \"UPDATE items SET quantity = quantity + ? WHERE id = ? AND quantity + ? >= 0\",\n            (delta, item_id, delta),\n        )\n        if cur.rowcount == 0:\n            return error(\"movement would take stock below zero\", 400)\n        quantity_after = conn.execute(\n            \"SELECT quantity FROM items WHERE id = ?\", (item_id,)\n        ).fetchone()[0]\n        cur = conn.execute(\n            \"INSERT INTO movements (item_id, delta, reason, quantity_after, created_at, username)\"\n            \" VALUES (?, ?, ?, ?, ?, ?)\",\n            (\n                item_id,\n                delta,\n                reason,\n                quantity_after,\n                datetime.now(timezone.utc).isoformat(),\n                g.user[\"username\"],\n            ),\n        )\n    row = conn.execute(\"SELECT * FROM movements WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(movement_json(row)), 201\n\n\n# ---------------------------------------------------------------- frontend\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":440,"totalLines":440,"truncated":false}},"title":"backend/app.py","time":{"start":1794350947850,"end":1794350947860}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7a69e05001Aq4hpUAU3hvGZB","sessionID":"ses_e386d783fffeaDLoAZQNXyWTbi","messageID":"msg_1c7a6880c001ZPceS070Fwwxt9"}}
