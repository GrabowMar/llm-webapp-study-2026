{"type":"step_start","timestamp":1794350575278,"sessionID":"ses_e386d783fffeaDLoAZQNXyWTbi","part":{"id":"prt_1c7a0ee9d001XHBbpdOxgXrTQc","messageID":"msg_1c7a0b8b4001YzvUQQIwHgn1Lt","sessionID":"ses_e386d783fffeaDLoAZQNXyWTbi","type":"step-start"}}
{"type":"tool_use","timestamp":1794350575303,"sessionID":"ses_e386d783fffeaDLoAZQNXyWTbi","part":{"type":"tool","tool":"write","callID":"call_6d4e955c72354375933e1990","state":{"status":"completed","input":{"content":"/* Temporary render smoke test: mounts the production bundle in jsdom. */\nimport { readdirSync } from \"node:fs\";\nimport { JSDOM } from \"jsdom\";\n\nconst BASE = \"http://localhost:8000\";\nconst dist = new URL(\"./dist/assets/\", import.meta.url);\nconst bundleName = readdirSync(dist).find((f) => f.endsWith(\".js\"));\nconst bundleUrl = new URL(bundleName, dist).href;\n\nconst realFetch = globalThis.fetch;\nglobalThis.fetch = (input, init) => realFetch(new URL(input, BASE), init);\n\nasync function getToken() {\n  const res = await realFetch(`${BASE}/api/auth/login`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username: \"e2e_user\", password: \"hunter2!\" }),\n  });\n  return (await res.json()).token;\n}\n\nconst token = await getToken();\n\nconst fails = [];\nfunction check(name, cond, detail = \"\") {\n  if (cond) console.log(`ok   ${name}`);\n  else {\n    fails.push(name);\n    console.log(`FAIL ${name} ${detail}`);\n  }\n}\n\nasync function renderAt(path, expected, forbidden = []) {\n  const dom = new JSDOM('<!DOCTYPE html><html><body><div id=\"root\"></div></body></html>', {\n    url: BASE + path,\n    pretendToBeVisual: true,\n  });\n  globalThis.window = dom.window;\n  globalThis.document = dom.window.document;\n  Object.defineProperty(globalThis, \"navigator\", { value: dom.window.navigator, configurable: true });\n  globalThis.localStorage = dom.window.localStorage;\n  globalThis.Event = dom.window.Event;\n  globalThis.HTMLElement = dom.window.HTMLElement;\n  globalThis.HTMLIFrameElement = dom.window.HTMLIFrameElement;\n  dom.window.localStorage.setItem(\"inventory.token\", token);\n  dom.window.localStorage.setItem(\"inventory.username\", \"e2e_user\");\n\n  await import(`${bundleUrl}?v=${Date.now()}-${Math.random()}`);\n  await new Promise((r) => setTimeout(r, 600));\n\n  const text = dom.window.document.body.textContent ?? \"\";\n  for (const needle of expected) {\n    check(`${path} shows \"${needle}\"`, text.includes(needle), `text=${JSON.stringify(text.slice(0, 200))}`);\n  }\n  for (const needle of forbidden) {\n    check(`${path} hides \"${needle}\"`, !text.includes(needle));\n  }\n  dom.window.close();\n}\n\nawait renderAt(\"/\", [\"Warehouse Inventory\", \"Inventory\", \"Search\", \"Low stock only\", \"Add item\", \"Signed in as\", \"e2e_user\", \"Sign out\", \"Widget\", \"E2E-1\", \"Previous\", \"Next\", \"Low stock\"]);\nawait renderAt(\"/account\", [\"Sign in\", \"Create an account\", \"Username\", \"Password\", \"Register\"]);\nawait renderAt(\"/items/1\", [\"Widget\", \"Receive stock\", \"Take out stock\", \"Stock movements\", \"Edit\", \"Delete\", \"Reorder level\", \"sold\"]);\nawait renderAt(\"/items/new\", [\"Add item\", \"Name\", \"SKU\", \"Location\", \"Reorder level\", \"Opening quantity\"]);\n\nconsole.log();\nconsole.log(\"FAILURES:\", fails.length ? fails : \"none\");\nprocess.exit(fails.length ? 1 : 0);\n","filePath":"/workspace/frontend/smoke_render.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/smoke_render.mjs","exists":false,"truncated":false},"title":"frontend/smoke_render.mjs","time":{"start":1794350575273,"end":1794350575281}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7a0eea1001PVSZkK0rdM5KiI","sessionID":"ses_e386d783fffeaDLoAZQNXyWTbi","messageID":"msg_1c7a0b8b4001YzvUQQIwHgn1Lt"}}
