ation: Bearer $T\" $B/api/me/login-attempts | python3 -c 'import json,sys; d=json.load(sys.stdin); print(\"attempts:\", len(d[\"items\"]), [i[\"success\"] for i in d[\"items\"]])' && \\\ncurl -s -o /dev/null -w 'index:%{http_code}\\n' $B/","timeout":120000,"workdir":"/workspace"},"output":"{\"status\":\"ok\"}\n\nregister:201 \n{\"id\":2,\"last_login_at\":\"2026-11-10T19:45:55.906725+00:00\",\"username\":\"alice\"}\n\nfail1:401 fail2:401 fail3:401 fail4:401 fail5:401 \nHTTP/1.1 429 TOO MANY REQUESTS\r\nRetry-After: 900\r\n{\"items\":[{\"locked_until\":\"2026-11-10T20:00:58.449040+00:00\",\"username\":\"alice\"}]}\n\n{\"username\":\"alice\"}\n\nlogin-after-unlock:200\nattempts: 7 [True, False, False, False, False, False, True]\nindex:200\n","metadata":{"output":"{\"status\":\"ok\"}\n\nregister:201 \n{\"id\":2,\"last_login_at\":\"2026-11-10T19:45:55.906725+00:00\",\"username\":\"alice\"}\n\nfail1:401 fail2:401 fail3:401 fail4:401 fail5:401 \nHTTP/1.1 429 TOO MANY REQUESTS\r\nRetry-After: 900\r\n{\"items\":[{\"locked_until\":\"2026-11-10T20:00:58.449040+00:00\",\"username\":\"alice\"}]}\n\n{\"username\":\"alice\"}\n\nlogin-after-unlock:200\nattempts: 7 [True, False, False, False, False, False, True]\nindex:200\n","exit":0,"truncated":false},"title":"ADMIN_PASSWORD=adminpw .venv/bin/python -m gunicorn --bind 127.0.0.1:8000 --pythonpath backend --workers 1 app:app --daemon --pid /workspace/.gunicorn.pid && sleep 2 && B=http://127.0.0.1:8000 && \\\ncurl -s $B/api/health && echo && \\\ncurl -s -o /dev/null -w 'register:%{http_code} ' -X POST $B/api/auth/register -H 'Content-Type: application/json' -d '{\"username\":\"alice\",\"password\":\"pw1\"}' && \\\nT=$(curl -s -X POST $B/api/auth/login -H 'Content-Type: application/json' -H 'X-Forwarded-For: 10.9.0.1' -d '{\"username\":\"alice\",\"password\":\"pw1\"}' | python3 -c 'import json,sys;print(json.load(sys.stdin)[\"token\"])') && \\\necho && curl -s -H \"Authorization: Bearer $T\" $B/api/me && echo && \\\nfor i in 1 2 3 4 5