{"type":"tool_use","timestamp":1794349273673,"sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","part":{"type":"tool","tool":"write","callID":"call_c90f0c79da2441d196219e59","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: notification center API + frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"notifications.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\nDEFAULT_TYPE = \"info\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS notifications (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    message TEXT NOT NULL,\n    type TEXT NOT NULL DEFAULT 'info',\n    read INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_notifications_user\n    ON notifications (user_id, created_at DESC, id DESC);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\nclass ApiError(Exception):\n    def __init__(self, message: str, status: int):\n        super().__init__(message)\n        self.message = message\n        self.status = status\n\n    def response(self):\n        return jsonify({\"error\": self.message}), self.status\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(exc: ApiError):\n    return exc.response()\n\n\n@app.errorhandler(404)\ndef handle_not_found(_exc):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.errorhandler(405)\ndef handle_method_not_allowed(_exc):\n    return jsonify({\"error\": \"method not allowed\"}), 405\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\n\ndef connect_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect_db()\n    try:\n        conn.executescript(SCHEMA)\n        if ADMIN_PASSWORD:\n            password_hash = generate_password_hash(ADMIN_PASSWORD)\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n            if row is None:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1)\",\n                    (ADMIN_USERNAME, password_hash),\n                )\n            else:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (password_hash, row[\"id\"]),\n                )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(\"a JSON object body is required\", 400)\n    return data\n\n\ndef parse_bool_arg(value: str) -> bool:\n    lowered = value.strip().lower()\n    if lowered in (\"true\", \"1\"):\n        return True\n    if lowered in (\"false\", \"0\"):\n        return False\n    raise ApiError(\"read must be true or false\", 400)\n\n\ndef parse_int_arg(name: str, default: int, lo: int, hi: int) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(f\"{name} must be an integer\", 400)\n    return max(lo, min(hi, value))\n\n\ndef extract_message_and_type(data: dict) -> tuple[str, str]:\n    message = data.get(\"message\")\n    if not isinstance(message, str) or not message.strip():\n        raise ApiError(\"message must be a non-empty string\", 400)\n    ntype = data.get(\"type\", DEFAULT_TYPE)\n    if not isinstance(ntype, str) or not ntype.strip():\n        raise ApiError(\"type must be a non-empty string\", 400)\n    return message, ntype\n\n\ndef get_auth_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    return get_db().execute(\n        \"SELECT u.id, u.username, u.is_admin FROM tokens t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = get_auth_user()\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        return view(user, *args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = get_auth_user()\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        if not user[\"is_admin\"]:\n            return jsonify({\"error\": \"admin required\"}), 403\n        return view(user, *args, **kwargs)\n\n    return wrapped\n\n\n# ---------------------------------------------------------------------------\n# Auth\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        raise ApiError(\"username must be a non-empty string\", 400)\n    if not isinstance(password, str) or not password:\n        raise ApiError(\"password must be a non-empty string\", 400)\n    username = username.strip()\n    if username == ADMIN_USERNAME:\n        raise ApiError(\"username is reserved\", 409)\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        raise ApiError(\"username already taken\", 409)\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(\"username and password are required\", 400)\n    username = username.strip()\n    if username == ADMIN_USERNAME and not ADMIN_PASSWORD:\n        raise ApiError(\"admin sign-in is disabled\", 401)\n    user = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        raise ApiError(\"invalid credentials\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n# ---------------------------------------------------------------------------\n# Notifications\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/notifications\")\n@login_required\ndef list_notifications(user):\n    db = get_db()\n    where = [\"user_id = ?\"]\n    params: list = [user[\"id\"]]\n\n    raw_read = request.args.get(\"read\")\n    if raw_read is not None and raw_read != \"\":\n        where.append(\"read = ?\")\n        params.append(1 if parse_bool_arg(raw_read) else 0)\n\n    raw_type = request.args.get(\"type\")\n    if raw_type is not None and raw_type != \"\":\n        where.append(\"type = ?\")\n        params.append(raw_type)\n\n    page = parse_int_arg(\"page\", 1, 1, 10**9)\n    page_size = parse_int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n\n    clause = \" WHERE \" + \" AND \".join(where)\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM notifications\" + clause, params\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM notifications\"\n        + clause\n        + \" ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    unread_count = db.execute(\n        \"SELECT COUNT(*) AS n FROM notifications WHERE user_id = ? AND read = 0\",\n        (user[\"id\"],),\n    ).fetchone()[\"n\"]\n\n    return jsonify(\n        {\n            \"items\": [serialize(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread_count,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@login_required\ndef create_notification(user):\n    message, ntype = extract_message_and_type(json_body())\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at)\"\n        \" VALUES (?, ?, ?, 0, ?)\",\n        (user[\"id\"], message, ntype, utcnow()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@login_required\ndef read_all(user):\n    db = get_db()\n    cur = db.execute(\n        \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\",\n        (user[\"id\"],),\n    )\n    db.commit()\n    return jsonify({\"updated\": cur.rowcount}), 200\n\n\n@app.get(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef get_notification(user, notification_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        raise ApiError(\"notification not found\", 404)\n    return jsonify(serialize(row))\n\n\n@app.patch(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef update_notification(user, notification_id: int):\n    data = json_body()\n    if \"read\" not in data or not isinstance(data[\"read\"], bool):\n        raise ApiError(\"read must be a boolean\", 400)\n    db = get_db()\n    cur = db.execute(\n        \"UPDATE notifications SET read = ? WHERE id = ? AND user_id = ?\",\n        (1 if data[\"read\"] else 0, notification_id, user[\"id\"]),\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        raise ApiError(\"notification not found\", 404)\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (notification_id,)\n    ).fetchone()\n    return jsonify(serialize(row))\n\n\n@app.delete(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef delete_notification(user, notification_id: int):\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, user[\"id\"]),\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        raise ApiError(\"notification not found\", 404)\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# Admin\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/admin/broadcast\")\n@admin_required\ndef broadcast(_user):\n    message, ntype = extract_message_and_type(json_body())\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at)\"\n        \" SELECT id, ?, ?, 0, ? FROM users\",\n        (message, ntype, utcnow()),\n    )\n    db.commit()\n    return jsonify({\"delivered\": cur.rowcount}), 200\n\n\n# ---------------------------------------------------------------------------\n# Health + frontend\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794349273602,"end":1794349273646}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c78d11fa001xjtzUVmq9geTXe","sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","messageID":"msg_1c78ca80a001pWcFun0VVOjeJn"}}
