deError(\"Expecting value\", s, err.value) from None\njson.decoder.JSONDecodeError: Expecting value: line 1 column 1 (char 0)\n","exit":1,"truncated":false},"title":"python3 - <<'EOF'\nimport json, urllib.request, urllib.error\n\nBASE = \"http://localhost:8000\"\n\ndef call(method, path, body=None, token=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    if body is not None:\n        req.data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(req) as res:\n            raw = res.read()\n            return res.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        raw = e.read()\n        return e.code, (json.loads(raw) if raw else None)\n\ndef check(name, cond, extra=\"\"):\n    print((\"PASS \" if cond else \"FAIL \") + name + (\"\" if cond else f\"  -> {extra}\"))\n\ns, b = call(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and b == {\"status\": \"ok\"}, (s, b))\n\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw-alice\"})\ncheck(\"register alice 201\", s == 201 and b[\"username\"] == \"alice\", (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"})\ncheck(\"register duplicate 409\", s == 409, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"x\"})\ncheck(\"register admin reserved 409\", s == 409, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", s == 400, (s, b))\ns, b = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw-bob\"})\ncheck(\"register bob 201\", s == 201, (s, b))\n\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login wrong pw 401\", s == 401, (s, b))\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw-alice\"})\ncheck(\"login alice 200 token\", s == 200 and \"token\" in b, (s, b))\nalice = b[\"token\"]\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw-bob\"})\nbob = b[\"token\"]\ns, b = call(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"admin-secret\"})\ncheck(\"admin login 200\", s == 200 and \"token\" in b, (s, b))\nadmin = b[\"token\"]\n\ns, b = call(\"GET\", \"/api/notifications\", token=alice)\ncheck(\"list requires auth 401\", s == 401, (s, b))\ns, b = call(\"GET\", \"/api/notifications\", token=\"nonsense\")\ncheck(\"bad token 401\", s == 401, (s, b))\n\ns, b = call(\"POST\", \"/api/notifications\", {\"message\": \"first\", \"type\": \"info\"}, alice)\ncheck(\"create 201 shape\", s == 201 and set(b) == {\"id\",\"message\",\"type\",\"read\",\"created_at\"} and b[\"read\"] is False and b[\"message\"] == \"first\", (s, b))\nn1 = b[\"id\"]\ns, b = call(\"POST\", \"/api/notifications\", {\"message\": \"second one\", \"type\": \"warning\"}, alice)\nn2 = b[\"id\"]\ns, b = call(\"POST\", \"/api/notifications\", {\"message\": \"third\"}, alice)\ncheck(\"default type info\", s == 201 and b[\"type\"] == \"info\", (s, b))\nn3 = b[\"id\"]\ns, b = call(\"POST\", \"/api/notifications\", {\"message\": \"\"}, alice)\ncheck(\"empty message 400\", s == 400, (s, b))\n\ns, b = call(\"GET\", \"/api/notifications\", token=alice)\ncheck(\"list newest first\", s == 200 and [i[\"id\"] for i in b[\"items\"]] == [n3, n2, n1], (s, b))\ncheck(\"list counts\", b[\"total\"] == 3 and b[\"unread_count\"] == 3 and b[\"page\"] == 1 and b[\"page_size\"] == 20, b)\n\ns, b = call(\"PATCH\", f\"/api/notifications/{n2}\", {\"read\": True}, alice)\ncheck(\"patch read true\", s == 200 and b[\"read\"] is True, (s, b))\ns, b = call(\"GET\", \"/api/notifications\", token=alice)\ncheck(\"unread_count after patch\", b[\"unread_count\"] == 2, b)\ns, b = call(\"GET\", \"/api/notifications?read=false\", token=alice)\ncheck(\"filter unread\", s == 200 and b[\"total\"] == 2 and all(not i[\"read\"] for i in b[\"items\"]) and b[\"unread_count\"] == 2, b)\ns, b = call(\"GET\", \"/api/notifications?read=true\", token=alice)\ncheck(\"filter read\", s == 200 and b[\"total\"] == 1 and b[\"items\"][0][\"id\"] == n2 and b[\"unread_count\"] == 2, b)\ns, b = call(\"GET\", \"/api/notifications?type=warning\", token=alice)\ncheck(\"filter type\", s == 200 and b[\"total\"] == 1 and b[\"items\"][0][\"id\"] == n2, b)\ns, b = call(\"GET\", \"/api/notifications?read=banana\", token=alice)\ncheck(\"bad read param 400\", s == 400, (s, b))\ns, b = call(\"GET\", \"/api/notifications?page=2&page_size=2\", token=alice)\ncheck(\"paging\", s == 200 and b[\"page\"] == 2 and b[\"page_size\"] == 2 and len(b[\"items\"]) == 1 and b[\"items\"][0][\"id\"] == n1 and b[\"total\"] == 3, b)\ns, b = call(\"GET\", \"/api/notifications?page=notan\", token=alice)\ncheck(\"bad page 400\", s == 400, (s, b))\n\ns, b = call(\"PATCH\", f\"/api/notifications/{n1}\", {\"read\": \"yes\"}, alice)\ncheck(\"patch non-bool 400\", s == 400, (s, b))\n\ns, b = call(\"GET\", f\"/api/notifications/{n1}\", token=alice)\ncheck(\"get one\", s == 200 and b[\"id\"] == n1, (s, b))\ns, b = call(\"GET\", f\"/api/notifications/{n1}\", token=bob)\ncheck(\"cross-user get 404\", s == 404, (s, b))\ns, b = call(\"PATCH\", f\"/api/notifications/{n1}\", {\"read\": True}, bob)\ncheck(\"cross-user patch 404\", s == 404, (s, b))\ns, b = call(\"DELETE\", f\"/api/notifications/{n1}\", bob)\ncheck(\"cross-user delete 404\", s == 404, (s, b))\ns, b = call(\"GET\", f\"/api/notifications/{n1}\", token=alice)\ncheck(\"alice still has it\", s == 200, (s, b))\n\ns, b = call(\"POST\", \"/api/notifications/read-all\", token=alice)\ncheck(\"read-all updated=2\", s == 200 and b == {\"updated\": 2}, (s, b))\ns, b = call(\"POST\", \"/api/notifications/read-all\", token=alice)\ncheck(\"read-all again updated=0\", s == 200 and b == {\"updated\": 0}, (s, b))\ns, b = call(\"GET\", \"/api/notifications\", token=alice)\ncheck(\"all read now\", b[\"unread_count\"] == 0, b)\n\ns, b = call(\"DELETE\", f\"/api/notifications/{n3}\", alice)\ncheck(\"delete 204\", s == 204, (s, b))\ns, b = call(\"GET\", f\"/api/notifications/{n3}\", token=alice)\ncheck(\"deleted is gone\", s == 404, (s, b))\ns, b = call(\"DELETE\", f\"/api/notifications/{n3}\", alice)\ncheck(\"delete again 404\", s == 404, (s, b))\n\ns, b = call(\"POST\", \"/api/admin/broadcast\", {\"message\": \"hello all\", \"type\": \"announcement\"}, admin)\ncheck(\"broadcast delivered=3\", s == 200 and b == {\"delivered\": 3}, (s, b))\nfor name, tok in ((\"alice\", alice), (\"bob\", bob), (\"admin\", admin)):\n    s, b = call(\"GET\", f\"/api/notifications?type=announcement\", token=tok)\n    check(f\"{name} got broadcast\", s == 200 and b[\"total\"] == 1 and b[\"items\"][0][\"message\"] == \"hello all\" and b[\"items\"][0][\"read\"] is False, b)\ns, b = call(\"POST\", \"/api/admin/broadcast\", {\"message\": \"hi\"}, alice)\ncheck(\"non-admin broadcast 403\", s == 403, (s, b))\ns, b = call(\"POST\", \"/api/admin/broadcast\", {\"message\": \"hi\"})\ncheck(\"broadcast unauth 401\", s == 401, (s, b))\ns, b = call(\"POST\", \"/api/admin/broadcast\", {\"message\": \"\"}, admin)\ncheck(\"broadcast empty message 400\", s == 400, (s, b))\n\ns, b = call(\"GET\", \"/api/nonexistent\")\ncheck(\"unknown api 404 json\", s == 404 and \"error\" in b, (s, b))\ns, b = call(\"POST\", \"/api/notifications/read-allx\", {}, alice)\ncheck(\"unknown api post 404\", s == 404, (s, b))\n\ns, b = call(\"GET\", \"/\")\ncheck(\"frontend index served\", s == 200, (s, b))\nEOF","time":{"start":1794349566733,"end":1794349567621}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7918b04001Ly8NdmmCp9zZ3T","sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","messageID":"msg_1c7911f890011EYe2dtv4pBRFp"}}
