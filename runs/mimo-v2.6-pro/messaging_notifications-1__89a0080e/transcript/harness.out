{"type":"tool_use","timestamp":1794349389899,"sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","part":{"type":"tool","tool":"write","callID":"call_e8dbe7483c5646c49a875a53","state":{"status":"completed","input":{"content":"export type Notification = {\n  id: number;\n  message: string;\n  type: string;\n  read: boolean;\n  created_at: string;\n};\n\nexport type NotificationPage = {\n  items: Notification[];\n  total: number;\n  page: number;\n  page_size: number;\n  unread_count: number;\n};\n\nconst TOKEN_KEY = \"notification_center_token\";\nconst USERNAME_KEY = \"notification_center_username\";\n\nexport class HttpError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function saveSession(token: string, username: string): void {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession(): void {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(path, {\n    method,\n    headers,\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  if (!res.ok) {\n    const data = await res.json().catch(() => null);\n    const message =\n      data && typeof data.error === \"string\"\n        ? data.error\n        : res.statusText || `request failed (${res.status})`;\n    throw new HttpError(message, res.status);\n  }\n  if (res.status === 204) return undefined as T;\n  return (await res.json()) as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ id: number; username: string }>(\"POST\", \"/api/auth/register\", {\n    username,\n    password,\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"POST\", \"/api/auth/login\", { username, password });\n}\n\nexport function listNotifications(params: {\n  read: string;\n  type: string;\n  page: number;\n  pageSize: number;\n}): Promise<NotificationPage> {\n  const query = new URLSearchParams();\n  if (params.read) query.set(\"read\", params.read);\n  if (params.type) query.set(\"type\", params.type);\n  query.set(\"page\", String(params.page));\n  query.set(\"page_size\", String(params.pageSize));\n  return request(\"GET\", `/api/notifications?${query.toString()}`);\n}\n\nexport function createNotification(message: string, type: string) {\n  return request<Notification>(\"POST\", \"/api/notifications\", { message, type });\n}\n\nexport function markAllRead() {\n  return request<{ updated: number }>(\"POST\", \"/api/notifications/read-all\");\n}\n\nexport function setRead(id: number, read: boolean) {\n  return request<Notification>(\"PATCH\", `/api/notifications/${id}`, { read });\n}\n\nexport function deleteNotification(id: number) {\n  return request<void>(\"DELETE\", `/api/notifications/${id}`);\n}\n\nexport function broadcast(message: string, type: string) {\n  return request<{ delivered: number }>(\"POST\", \"/api/admin/broadcast\", { message, type });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794349389863,"end":1794349389871}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c78ed821001nn5HqQESIlj4Wj","sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","messageID":"msg_1c78eb7cf001gTOKILwUYfZlhS"}}
