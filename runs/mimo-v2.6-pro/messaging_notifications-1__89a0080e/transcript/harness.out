{"type":"tool_use","timestamp":1794349453937,"sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","part":{"type":"tool","tool":"write","callID":"call_801d1bfba0a64baeb27bc7a1","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport * as api from \"./api\";\nimport type { Notification } from \"./api\";\nimport AddNotificationForm from \"./components/AddNotificationForm\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport Bell from \"./components/Bell\";\nimport BroadcastForm from \"./components/BroadcastForm\";\nimport Inbox from \"./components/Inbox\";\n\ntype Session = { token: string; username: string };\n\nconst PAGE_SIZE = 10;\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(() => {\n    const token = api.getToken();\n    const username = api.getStoredUsername();\n    return token && username ? { token, username } : null;\n  });\n\n  const handleSignedIn = useCallback((username: string) => {\n    const token = api.getToken();\n    if (token) setSession({ token, username });\n  }, []);\n\n  const handleSignOut = useCallback(() => {\n    api.clearSession();\n    setSession(null);\n  }, []);\n\n  if (!session) {\n    return <AuthPanel onSignedIn={handleSignedIn} />;\n  }\n\n  return <Main username={session.username} onSignOut={handleSignOut} />;\n}\n\nfunction Main({ username, onSignOut }: { username: string; onSignOut: () => void }) {\n  const [items, setItems] = useState<Notification[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [readFilter, setReadFilter] = useState(\"\");\n  const [typeFilter, setTypeFilter] = useState(\"\");\n  const [unreadCount, setUnreadCount] = useState(0);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [version, setVersion] = useState(0);\n\n  const refresh = useCallback(() => setVersion((value) => value + 1), []);\n\n  const fail = useCallback(\n    (err: unknown) => {\n      if (err instanceof api.HttpError && err.status === 401) {\n        onSignOut();\n        return;\n      }\n      setError(err instanceof Error ? err.message : \"Request failed\");\n    },\n    [onSignOut]\n  );\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    api\n      .listNotifications({\n        read: readFilter,\n        type: typeFilter.trim(),\n        page,\n        pageSize: PAGE_SIZE,\n      })\n      .then((res) => {\n        if (cancelled) return;\n        setItems(res.items);\n        setTotal(res.total);\n        setUnreadCount(res.unread_count);\n        setError(null);\n      })\n      .catch((err) => {\n        if (!cancelled) fail(err);\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [readFilter, typeFilter, page, version, fail]);\n\n  useEffect(() => {\n    const id = window.setInterval(refresh, 15000);\n    return () => window.clearInterval(id);\n  }, [refresh]);\n\n  const run = useCallback(\n    async (action: () => Promise<void>) => {\n      try {\n        await action();\n        setError(null);\n      } catch (err) {\n        fail(err);\n      }\n    },\n    [fail]\n  );\n\n  const handleToggleRead = useCallback(\n    (notification: Notification) =>\n      run(async () => {\n        await api.setRead(notification.id, !notification.read);\n        refresh();\n      }),\n    [run, refresh]\n  );\n\n  const handleDelete = useCallback(\n    (notification: Notification) =>\n      run(async () => {\n        await api.deleteNotification(notification.id);\n        refresh();\n      }),\n    [run, refresh]\n  );\n\n  const handleMarkAllRead = useCallback(\n    () =>\n      run(async () => {\n        await api.markAllRead();\n        refresh();\n      }),\n    [run, refresh]\n  );\n\n  const handleAdd = useCallback(\n    async (message: string, type: string) => {\n      try {\n        await api.createNotification(message, type);\n        setPage(1);\n        refresh();\n        setError(null);\n        return true;\n      } catch (err) {\n        fail(err);\n        return false;\n      }\n    },\n    [fail, refresh]\n  );\n\n  const handleBroadcast = useCallback(\n    async (message: string, type: string) => {\n      try {\n        const res = await api.broadcast(message, type);\n        refresh();\n        setError(null);\n        return res.delivered;\n      } catch (err) {\n        fail(err);\n        return null;\n      }\n    },\n    [fail, refresh]\n  );\n\n  const handleReadFilterChange = useCallback((value: string) => {\n    setReadFilter(value);\n    setPage(1);\n  }, []);\n\n  const handleTypeFilterChange = useCallback((value: string) => {\n    setTypeFilter(value);\n    setPage(1);\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"sticky top-0 z-10 border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3\">\n          <h1 className=\"text-lg font-bold text-slate-900\">Notification Center</h1>\n          <div className=\"flex items-center gap-2 sm:gap-3\">\n            <Bell\n              count={unreadCount}\n              onClick={() => {\n                handleReadFilterChange(\"false\");\n                document.getElementById(\"inbox\")?.scrollIntoView({ behavior: \"smooth\" });\n              }}\n            />\n            <span className=\"hidden text-sm text-slate-600 sm:inline\">{username}</span>\n            <button\n              type=\"button\"\n              onClick={onSignOut}\n              className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100\"\n            >\n              Sign out\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto flex max-w-3xl flex-col gap-4 px-4 py-6\">\n        {error && (\n          <div className=\"rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700\">\n            {error}\n          </div>\n        )}\n        <AddNotificationForm onAdd={handleAdd} />\n        <Inbox\n          items={items}\n          total={total}\n          page={page}\n          pageSize={PAGE_SIZE}\n          readFilter={readFilter}\n          typeFilter={typeFilter}\n          loading={loading}\n          onReadFilterChange={handleReadFilterChange}\n          onTypeFilterChange={handleTypeFilterChange}\n          onPageChange={setPage}\n          onMarkAllRead={handleMarkAllRead}\n          onToggleRead={handleToggleRead}\n          onDelete={handleDelete}\n        />\n        {username === \"admin\" && <BroadcastForm onBroadcast={handleBroadcast} />}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794349453901,"end":1794349453911}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c78fd247001BHV5GEJKr9N0VM","sessionID":"ses_e3876b338ffeAwI4p3DzL6ZA68","messageID":"msg_1c78f957b001O6MS9E2qaatlDp"}}
