{"type":"tool_use","timestamp":1794375357558,"sessionID":"ses_e36f46510ffeYfuwiEvFjOQw09","part":{"type":"tool","tool":"write","callID":"call_8bec6bc5a5f845f8b0c5593f","state":{"status":"completed","input":{"content":"import type { Note, NoteSummary, PublicNote } from \"./types\";\n\nconst TOKEN_KEY = \"markdown-notes-token\";\nconst USERNAME_KEY = \"markdown-notes-username\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function storeSession(token: string, username: string): void {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession(): void {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function parseError(res: Response): Promise<ApiError> {\n  let message = `Request failed with status ${res.status}`;\n  try {\n    const data = await res.json();\n    if (data && typeof data.error === \"string\") message = data.error;\n  } catch {\n    if (res.status === 401) message = \"authentication required\";\n  }\n  return new ApiError(message, res.status);\n}\n\nasync function request(path: string, init: RequestInit = {}): Promise<Response> {\n  const headers = new Headers(init.headers);\n  if (init.body) headers.set(\"Content-Type\", \"application/json\");\n  const token = getToken();\n  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  const res = await fetch(path, { ...init, headers });\n  if (!res.ok) throw await parseError(res);\n  return res;\n}\n\nasync function requestJson<T>(path: string, init: RequestInit = {}): Promise<T> {\n  const res = await request(path, init);\n  return (await res.json()) as T;\n}\n\nfunction jsonBody(data: unknown): RequestInit {\n  return { body: JSON.stringify(data) };\n}\n\nexport async function register(username: string, password: string): Promise<void> {\n  await requestJson(\"/api/auth/register\", {\n    method: \"POST\",\n    ...jsonBody({ username, password }),\n  });\n}\n\nexport async function login(username: string, password: string): Promise<{ token: string }> {\n  return requestJson(\"/api/auth/login\", {\n    method: \"POST\",\n    ...jsonBody({ username, password }),\n  });\n}\n\nexport async function listNotes(): Promise<NoteSummary[]> {\n  const data = await requestJson<{ items: NoteSummary[] }>(\"/api/notes\");\n  return data.items;\n}\n\nexport async function createNote(): Promise<Note> {\n  return requestJson<Note>(\"/api/notes\", { method: \"POST\", ...jsonBody({}) });\n}\n\nexport async function getNote(id: number): Promise<Note> {\n  return requestJson<Note>(`/api/notes/${id}`);\n}\n\nexport interface NotePatch {\n  title?: string;\n  body?: string;\n  published?: boolean;\n}\n\nexport async function updateNote(id: number, patch: NotePatch): Promise<Note> {\n  return requestJson<Note>(`/api/notes/${id}`, {\n    method: \"PATCH\",\n    ...jsonBody(patch),\n  });\n}\n\nexport async function deleteNote(id: number): Promise<void> {\n  await request(`/api/notes/${id}`, { method: \"DELETE\" });\n}\n\nexport async function fetchNoteHtml(id: number): Promise<string> {\n  const res = await request(`/api/notes/${id}/html`);\n  return res.text();\n}\n\nexport async function fetchPublicNote(id: number): Promise<PublicNote> {\n  return requestJson<PublicNote>(`/api/public/notes/${id}`);\n}\n\nexport async function fetchPublicNoteHtml(id: number): Promise<string> {\n  const res = await request(`/api/public/notes/${id}/html`);\n  return res.text();\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794375357534,"end":1794375357541}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c91b1458001JT2VQChzCdWJao","sessionID":"ses_e36f46510ffeYfuwiEvFjOQw09","messageID":"msg_1c91a87cc001zauNTnWMyvUecu"}}
