{"type":"text","timestamp":1794375124988,"sessionID":"ses_e36f46510ffeYfuwiEvFjOQw09","part":{"id":"prt_1c91787ea001Sz8SGDVMI5nOiY","messageID":"msg_1c9170a77001gpCeGGZE6XRjvM","sessionID":"ses_e36f46510ffeYfuwiEvFjOQw09","type":"text","text":"nh3 sanitizes XSS while keeping standard Markdown output. Now writing the backend:","time":{"start":1794375124970,"end":1794375124985}}}
{"type":"tool_use","timestamp":1794375125050,"sessionID":"ses_e36f46510ffeYfuwiEvFjOQw09","part":{"type":"tool","tool":"write","callID":"call_1117c5202db14b75b10c69c1","state":{"status":"completed","input":{"content":"\"\"\"Markdown notes: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nimport markdown as markdown_lib\nimport nh3\nfrom flask import Flask\nfrom flask import Response\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"notes.db\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS notes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL DEFAULT '',\n    body TEXT NOT NULL DEFAULT '',\n    published INTEGER NOT NULL DEFAULT 0,\n    updated_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_notes_user_updated ON notes(user_id, updated_at DESC);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with sqlite3.connect(DB_PATH) as db:\n        db.executescript(SCHEMA)\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        db = sqlite3.connect(DB_PATH)\n        db.row_factory = sqlite3.Row\n        db.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = db\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n\n\ndef render_markdown(text: str) -> str:\n    html = markdown_lib.markdown(text or \"\", extensions=[\"extra\", \"sane_lists\"])\n    return nh3.clean(html, link_rel=\"noopener noreferrer\")\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return dict(row) if row else None\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef note_json(row: sqlite3.Row, include_body: bool = True) -> dict:\n    data = {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"published\": bool(row[\"published\"]),\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n    }\n    if include_body:\n        data[\"body\"] = row[\"body\"]\n    return data\n\n\ndef find_note(note_id: int, user_id: int | None = None) -> sqlite3.Row | None:\n    sql = (\n        \"SELECT n.*, u.username AS author FROM notes n\"\n        \" JOIN users u ON u.id = n.user_id WHERE n.id = ?\"\n    )\n    params: list = [note_id]\n    if user_id is not None:\n        sql += \" AND n.user_id = ?\"\n        params.append(user_id)\n    return get_db().execute(sql, params).fetchone()\n\n\ndef check_string_fields(payload: dict) -> str | None:\n    for field in (\"title\", \"body\"):\n        if field in payload and not isinstance(payload[field], str):\n            return f\"{field} must be a string\"\n    if \"published\" in payload and not isinstance(payload[\"published\"], bool):\n        return \"published must be a boolean\"\n    return None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    payload = request.get_json(silent=True)\n    if not isinstance(payload, dict):\n        return jsonify({\"error\": \"a JSON body is required\"}), 400\n    username = payload.get(\"username\")\n    password = payload.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password must be strings\"}), 400\n    username = username.strip()\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    payload = request.get_json(silent=True)\n    if not isinstance(payload, dict):\n        return jsonify({\"error\": \"a JSON body is required\"}), 400\n    username = payload.get(\"username\")\n    password = payload.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password must be strings\"}), 400\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, row[\"id\"]))\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/notes\")\n@login_required\ndef list_notes():\n    rows = get_db().execute(\n        \"SELECT id, title, published, updated_at FROM notes WHERE user_id = ?\"\n        \" ORDER BY updated_at DESC, id DESC\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    items = [\n        {\n            \"id\": row[\"id\"],\n            \"title\": row[\"title\"],\n            \"published\": bool(row[\"published\"]),\n            \"updated_at\": row[\"updated_at\"],\n        }\n        for row in rows\n    ]\n    return jsonify({\"items\": items})\n\n\n@app.post(\"/api/notes\")\n@login_required\ndef create_note():\n    payload = request.get_json(silent=True)\n    if payload is None:\n        payload = {}\n    if not isinstance(payload, dict):\n        return jsonify({\"error\": \"a JSON object body is required\"}), 400\n    problem = check_string_fields(payload)\n    if problem:\n        return jsonify({\"error\": problem}), 400\n    title = payload.get(\"title\", \"\")\n    body = payload.get(\"body\", \"\")\n    published = payload.get(\"published\", False)\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notes (user_id, title, body, published, updated_at)\"\n        \" VALUES (?, ?, ?, ?, ?)\",\n        (g.user[\"id\"], title, body, int(published), now_iso()),\n    )\n    db.commit()\n    row = find_note(cur.lastrowid)\n    return jsonify(note_json(row)), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\n@login_required\ndef get_note(note_id: int):\n    row = find_note(note_id, g.user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"note not found\"}), 404\n    return jsonify(note_json(row))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\n@login_required\ndef update_note(note_id: int):\n    row = find_note(note_id, g.user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"note not found\"}), 404\n    payload = request.get_json(silent=True)\n    if payload is None:\n        payload = {}\n    if not isinstance(payload, dict):\n        return jsonify({\"error\": \"a JSON object body is required\"}), 400\n    problem = check_string_fields(payload)\n    if problem:\n        return jsonify({\"error\": problem}), 400\n    updates = {}\n    if \"title\" in payload:\n        updates[\"title\"] = payload[\"title\"]\n    if \"body\" in payload:\n        updates[\"body\"] = payload[\"body\"]\n    if \"published\" in payload:\n        updates[\"published\"] = int(payload[\"published\"])\n    if updates:\n        updates[\"updated_at\"] = now_iso()\n        assignments = \", \".join(f\"{field} = ?\" for field in updates)\n        db = get_db()\n        db.execute(\n            f\"UPDATE notes SET {assignments} WHERE id = ?\",  # noqa: S608\n            [*updates.values(), note_id],\n        )\n        db.commit()\n    row = find_note(note_id, g.user[\"id\"])\n    return jsonify(note_json(row))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\n@login_required\ndef delete_note(note_id: int):\n    db = get_db()\n    cur = db.execute(\"DELETE FROM notes WHERE id = ? AND user_id = ?\", (note_id, g.user[\"id\"]))\n    db.commit()\n    if cur.rowcount == 0:\n        return jsonify({\"error\": \"note not found\"}), 404\n    return \"\", 204\n\n\n@app.get(\"/api/notes/<int:note_id>/html\")\n@login_required\ndef note_html(note_id: int):\n    row = find_note(note_id, g.user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"note not found\"}), 404\n    return Response(render_markdown(row[\"body\"]), mimetype=\"text/html\")\n\n\ndef public_note_or_404(note_id: int):\n    row = find_note(note_id)\n    if row is None or not row[\"published\"]:\n        return None, (jsonify({\"error\": \"note not found\"}), 404)\n    return row, None\n\n\n@app.get(\"/api/public/notes/<int:note_id>\")\ndef public_note(note_id: int):\n    row, error = public_note_or_404(note_id)\n    if error:\n        return error\n    return jsonify(note_json(row, include_body=False))\n\n\n@app.get(\"/api/public/notes/<int:note_id>/html\")\ndef public_note_html(note_id: int):\n    row, error = public_note_or_404(note_id)\n    if error:\n        return error\n    return Response(render_markdown(row[\"body\"]), mimetype=\"text/html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000, debug=True)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794375124980,"end":1794375125029}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c91787ee001q0O9Ai58PSUD1y","sessionID":"ses_e36f46510ffeYfuwiEvFjOQw09","messageID":"msg_1c9170a77001gpCeGGZE6XRjvM"}}
