{"type":"tool_use","timestamp":1794325231735,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"type":"tool","tool":"write","callID":"call_228d6ab4d6bb4509836d8fb7","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  clearSession,\n  fetchAvailability,\n  getSavedUsername,\n  listReservations,\n} from \"./api\";\nimport type { Reservation, SlotAvailability } from \"./types\";\nimport { todayISO } from \"./dates\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport AvailabilityPanel from \"./components/AvailabilityPanel\";\nimport BookingForm from \"./components/BookingForm\";\nimport MyReservations from \"./components/MyReservations\";\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(getSavedUsername());\n  const [date, setDate] = useState(todayISO());\n  const [availability, setAvailability] = useState<SlotAvailability[]>([]);\n  const [mine, setMine] = useState<Reservation[]>([]);\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  const signedIn = username !== null;\n  const isAdmin = username === \"admin\";\n\n  const refresh = useCallback(() => {\n    setRefreshKey((key) => key + 1);\n  }, []);\n\n  useEffect(() => {\n    const handler = () => setUsername(null);\n    window.addEventListener(\"auth:signout\", handler);\n    return () => window.removeEventListener(\"auth:signout\", handler);\n  }, []);\n\n  useEffect(() => {\n    let cancelled = false;\n    fetchAvailability(date)\n      .then((res) => {\n        if (!cancelled) setAvailability(res.items);\n      })\n      .catch(() => {\n        if (!cancelled) setAvailability([]);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [date, refreshKey, signedIn]);\n\n  useEffect(() => {\n    if (!signedIn) {\n      setMine([]);\n      return;\n    }\n    let cancelled = false;\n    listReservations()\n      .then((res) => {\n        if (!cancelled) setMine(res.items);\n      })\n      .catch(() => {\n        if (!cancelled) setMine([]);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [signedIn, refreshKey]);\n\n  function signOut() {\n    clearSession();\n    setUsername(null);\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-100\">\n      <header className=\"bg-slate-900 text-white\">\n        <div className=\"mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 p-4\">\n          <h1 className=\"text-xl font-semibold\">Table Reservations</h1>\n          {username ? (\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-sm text-slate-300\">\n                Signed in as{\" \"}\n                <span className=\"font-medium text-white\">{username}</span>\n              </span>\n              <button\n                type=\"button\"\n                onClick={signOut}\n                className=\"rounded-md border border-slate-600 px-3 py-1.5 text-sm hover:bg-slate-800\"\n              >\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <span className=\"text-sm text-slate-300\">Not signed in</span>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-5xl space-y-6 p-4\">\n        <div className=\"grid gap-6 lg:grid-cols-2\">\n          <AvailabilityPanel\n            date={date}\n            onDateChange={setDate}\n            items={availability}\n          />\n          {signedIn ? (\n            <BookingForm date={date} onDateChange={setDate} onBooked={refresh} />\n          ) : (\n            <AuthPanel onSignedIn={(name) => { setUsername(name); refresh(); }} />\n          )}\n        </div>\n\n        {signedIn ? (\n          <MyReservations items={mine} onChanged={refresh} />\n        ) : null}\n\n        {isAdmin ? (\n          <AdminPanel date={date} availability={availability} />\n        ) : null}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794325231699,"end":1794325231711}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61e3849001D1953OnfLKwpHp","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","messageID":"msg_1c61dfc08001gFr6ATGKecVtKZ"}}
