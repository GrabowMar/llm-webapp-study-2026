None\n    return value\n\n\ndef valid_time(value) -> str | None:\n    if not isinstance(value, str):\n        return None\n    value = value.strip()\n    if not TIME_RE.match(value):\n        return None\n    return value[:5]\n\n\n","metadata":{"output":"                date TEXT NOT NULL,\n                time TEXT NOT NULL,\n                party_size INTEGER NOT NULL,\n                notes TEXT NOT NULL DEFAULT '',\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_reservations_slot\n                ON reservations (date, time);\n            CREATE INDEX IF NOT EXISTS idx_reservations_user\n                ON reservations (user_id);\n            \"\"\"\n        )\n        if ADMIN_ENABLED:\n            db.execute(\n                \"\"\"\n                INSERT INTO users (username, password_hash, is_admin, created_at)\n                VALUES ('admin', ?, 1, ?)\n                ON CONFLICT(username) DO UPDATE SET\n                    password_hash = excluded.password_hash,\n                    is_admin = 1\n                \"\"\",\n                (generate_password_hash(ADMIN_PASSWORD), now_iso()),\n            )\n    finally:\n        db.close()\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\n\ndef error(message: str, status: int, **extra):\n    body = {\"error\": message, \"message\": message}\n    body.update(extra)\n    return jsonify(body), status\n\n\ndef get_json_body() -> dict:\n    data = request.get_json(silent=True, force=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef valid_date(value) -> str | None:\n    if not isinstance(value, str):\n        return None\n    value = value.strip()\n    if not DATE_RE.match(value):\n        return None\n    try:\n        datetime.strptime(value, \"%Y-%m-%d\")\n    except ValueError:\n        return None\n    return value\n\n\