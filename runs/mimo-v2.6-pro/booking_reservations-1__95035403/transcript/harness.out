{"type":"tool_use","timestamp":1794324422650,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"type":"tool","tool":"write","callID":"call_d56b2068c05d4732bab4a6e9","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: reservation API and frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import date as date_cls\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"app.db\"\nSLOT_CAPACITY = 20\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\nADMIN_ENABLED = bool(ADMIN_PASSWORD)\n\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\nTIME_RE = re.compile(r\"^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$\")\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# database\n# --------------------------------------------------------------------------\n\ndef connect_db() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef init_db() -> None:\n    db = connect_db()\n    try:\n        db.execute(\"BEGIN IMMEDIATE\")\n        db.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS reservations (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                name TEXT NOT NULL,\n                email TEXT NOT NULL,\n                date TEXT NOT NULL,\n                time TEXT NOT NULL,\n                party_size INTEGER NOT NULL,\n                notes TEXT NOT NULL DEFAULT '',\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_reservations_slot\n                ON reservations (date, time);\n            CREATE INDEX IF NOT EXISTS idx_reservations_user\n                ON reservations (user_id);\n            \"\"\"\n        )\n        if ADMIN_ENABLED:\n            db.execute(\n                \"\"\"\n                INSERT INTO users (username, password_hash, is_admin, created_at)\n                VALUES ('admin', ?, 1, ?)\n                ON CONFLICT(username) DO UPDATE SET\n                    password_hash = excluded.password_hash,\n                    is_admin = 1\n                \"\"\",\n                (generate_password_hash(ADMIN_PASSWORD), now_iso()),\n            )\n        db.execute(\"COMMIT\")\n    except Exception:\n        db.execute(\"ROLLBACK\")\n        raise\n    finally:\n        db.close()\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\n\ndef error(message: str, status: int, **extra):\n    body = {\"error\": message, \"message\": message}\n    body.update(extra)\n    return jsonify(body), status\n\n\ndef get_json_body() -> dict:\n    data = request.get_json(silent=True, force=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef valid_date(value) -> str | None:\n    if not isinstance(value, str):\n        return None\n    value = value.strip()\n    if not DATE_RE.match(value):\n        return None\n    try:\n        datetime.strptime(value, \"%Y-%m-%d\")\n    except ValueError:\n        return None\n    return value\n\n\ndef valid_time(value) -> str | None:\n    if not isinstance(value, str):\n        return None\n    value = value.strip()\n    if not TIME_RE.match(value):\n        return None\n    return value[:5]\n\n\ndef valid_party_size(value) -> int | None:\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, int):\n        size = value\n    elif isinstance(value, float) and value.is_integer():\n        size = int(value)\n    elif isinstance(value, str) and re.fullmatch(r\"\\d+\", value.strip()):\n        size = int(value.strip())\n    else:\n        return None\n    if size < 1 or size > SLOT_CAPACITY:\n        return None\n    return size\n\n\ndef parse_reservation(data: dict, require_fields: bool = True):\n    \"\"\"Validate the writable fields of a reservation.\n\n    Returns (fields, error_message). ``notes`` is optional and cleared when\n    omitted.\n    \"\"\"\n\n    def need(key):\n        if key in data:\n            return data[key]\n        return None if require_fields else \"\"\n\n    name = data.get(\"name\")\n    email = data.get(\"email\")\n    date_s = data.get(\"date\")\n    time_s = data.get(\"time\")\n    party = data.get(\"party_size\")\n    notes = data.get(\"notes\", \"\")\n\n    if not isinstance(name, str) or not name.strip():\n        return None, \"name is required\"\n    name = name.strip()\n\n    if not isinstance(email, str) or not email.strip():\n        return None, \"email is required\"\n    email = email.strip()\n    if \"@\" not in email:\n        return None, \"email must be a valid email address\"\n\n    date_norm = valid_date(date_s)\n    if date_norm is None:\n        return None, \"date must be a date in YYYY-MM-DD format\"\n\n    time_norm = valid_time(time_s)\n    if time_norm is None:\n        return None, \"time must be a time in HH:MM format\"\n\n    party_norm = valid_party_size(party)\n    if party_norm is None:\n        return None, \"party_size must be an integer between 1 and 20\"\n\n    if notes is None:\n        notes = \"\"\n    if not isinstance(notes, str):\n        return None, \"notes must be a string\"\n\n    return {\n        \"name\": name,\n        \"email\": email,\n        \"date\": date_norm,\n        \"time\": time_norm,\n        \"party_size\": party_norm,\n        \"notes\": notes,\n    }, None\n\n\ndef reservation_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"email\": row[\"email\"],\n        \"date\": row[\"date\"],\n        \"time\": row[\"time\"],\n        \"party_size\": row[\"party_size\"],\n        \"notes\": row[\"notes\"] or \"\",\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef slot_booked(db: sqlite3.Connection, date_s: str, time_s: str,\n                exclude_id: int | None = None) -> int:\n    sql = (\"SELECT COALESCE(SUM(party_size), 0) AS booked FROM reservations\"\n           \" WHERE date = ? AND time = ?\")\n    params: list = [date_s, time_s]\n    if exclude_id is not None:\n        sql += \" AND id != ?\"\n        params.append(exclude_id)\n    return db.execute(sql, params).fetchone()[\"booked\"]\n\n\ndef capacity_error(booked: int):\n    remaining = max(SLOT_CAPACITY - booked, 0)\n    if remaining <= 0:\n        message = \"Slot is fully booked\"\n    else:\n        message = (f\"Slot is fully booked: only {remaining} of \"\n                   f\"{SLOT_CAPACITY} seats are still free in this slot\")\n    return error(message, 400, code=\"slot_full\", remaining=remaining)\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    return get_db().execute(\n        \"SELECT u.* FROM tokens t JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        return view(user, *args, **kwargs)\n\n    return wrapped\n\n\n# --------------------------------------------------------------------------\n# auth\n# --------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = get_json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    username = username.strip() if isinstance(username, str) else \"\"\n\n    if not username or not isinstance(password, str) or not password:\n        return error(\"username and password are required\", 400)\n    if username.lower() == \"admin\":\n        return error(\"This username is reserved\", 400)\n\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n            \" VALUES (?, ?, 0, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n    except sqlite3.IntegrityError:\n        return error(\"Username already taken\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = get_json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    username = username.strip() if isinstance(username, str) else \"\"\n\n    if not username or not isinstance(password, str) or not password:\n        return error(\"username and password are required\", 400)\n\n    if username == \"admin\" and not ADMIN_ENABLED:\n        return error(\"Invalid username or password\", 401)\n\n    row = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    get_db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    return jsonify({\"token\": token}), 200\n\n\n# --------------------------------------------------------------------------\n# reservations\n# --------------------------------------------------------------------------\n\n@app.post(\"/api/reservations\")\n@login_required\ndef create_reservation(user):\n    fields, err = parse_reservation(get_json_body())\n    if err:\n        return error(err, 400)\n\n    db = get_db()\n    db.execute(\"BEGIN IMMEDIATE\")\n    try:\n        booked = slot_booked(db, fields[\"date\"], fields[\"time\"])\n        if booked + fields[\"party_size\"] > SLOT_CAPACITY:\n            db.execute(\"ROLLBACK\")\n            return capacity_error(booked)\n        cur = db.execute(\n            \"INSERT INTO reservations\"\n            \" (user_id, name, email, date, time, party_size, notes, created_at)\"\n            \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (user[\"id\"], fields[\"name\"], fields[\"email\"], fields[\"date\"],\n             fields[\"time\"], fields[\"party_size\"], fields[\"notes\"], now_iso()),\n        )\n        res_id = cur.lastrowid\n        db.execute(\"COMMIT\")\n    except Exception:\n        db.execute(\"ROLLBACK\")\n        raise\n\n    row = db.execute(\n        \"SELECT * FROM reservations WHERE id = ?\", (res_id,)\n    ).fetchone()\n    return jsonify(reservation_dict(row)), 201\n\n\n@app.get(\"/api/reservations\")\n@login_required\ndef list_reservations(user):\n    date_s = request.args.get(\"date\")\n    if date_s is not None:\n        date_s = valid_date(date_s)\n        if date_s is None:\n            return error(\"date must be a date in YYYY-MM-DD format\", 400)\n\n    sql = \"SELECT * FROM reservations WHERE user_id = ?\"\n    params: list = [user[\"id\"]]\n    if date_s is not None:\n        sql += \" AND date = ?\"\n        params.append(date_s)\n    sql += \" ORDER BY date, time, id\"\n\n    rows = get_db().execute(sql, params).fetchall()\n    items = [reservation_dict(r) for r in rows]\n    return jsonify({\"items\": items, \"total\": len(items)}), 200\n\n\n@app.get(\"/api/reservations/<int:res_id>\")\n@login_required\ndef get_reservation(user, res_id):\n    row = get_db().execute(\n        \"SELECT * FROM reservations WHERE id = ?\", (res_id,)\n    ).fetchone()\n    if row is None or row[\"user_id\"] != user[\"id\"]:\n        return error(\"Reservation not found\", 404)\n    return jsonify(reservation_dict(row)), 200\n\n\n@app.put(\"/api/reservations/<int:res_id>\")\n@login_required\ndef update_reservation(user, res_id):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM reservations WHERE id = ?\", (res_id,)\n    ).fetchone()\n    if row is None or row[\"user_id\"] != user[\"id\"]:\n        return error(\"Reservation not found\", 404)\n\n    fields, err = parse_reservation(get_json_body())\n    if err:\n        return error(err, 400)\n\n    db.execute(\"BEGIN IMMEDIATE\")\n    try:\n        booked = slot_booked(db, fields[\"date\"], fields[\"time\"],\n                             exclude_id=res_id)\n        if booked + fields[\"party_size\"] > SLOT_CAPACITY:\n            db.execute(\"ROLLBACK\")\n            return capacity_error(booked)\n        db.execute(\n            \"UPDATE reservations\"\n            \" SET name = ?, email = ?, date = ?, time = ?, party_size = ?,\"\n            \" notes = ? WHERE id = ?\",\n            (fields[\"name\"], fields[\"email\"], fields[\"date\"], fields[\"time\"],\n             fields[\"party_size\"], fields[\"notes\"], res_id),\n        )\n        db.execute(\"COMMIT\")\n    except Exception:\n        db.execute(\"ROLLBACK\")\n        raise\n\n    row = db.execute(\n        \"SELECT * FROM reservations WHERE id = ?\", (res_id,)\n    ).fetchone()\n    return jsonify(reservation_dict(row)), 200\n\n\n@app.delete(\"/api/reservations/<int:res_id>\")\n@login_required\ndef delete_reservation(user, res_id):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM reservations WHERE id = ?\", (res_id,)\n    ).fetchone()\n    if row is None or row[\"user_id\"] != user[\"id\"]:\n        return error(\"Reservation not found\", 404)\n    db.execute(\"DELETE FROM reservations WHERE id = ?\", (res_id,))\n    return jsonify({\"ok\": True}), 200\n\n\n# --------------------------------------------------------------------------\n# availability\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/availability\")\ndef availability():\n    date_s = request.args.get(\"date\")\n    if date_s is None:\n        date_s = date_cls.today().isoformat()\n    else:\n        date_s = valid_date(date_s)\n        if date_s is None:\n            return error(\"date must be a date in YYYY-MM-DD format\", 400)\n\n    rows = get_db().execute(\n        \"SELECT time, SUM(party_size) AS booked FROM reservations\"\n        \" WHERE date = ? GROUP BY time ORDER BY time\",\n        (date_s,),\n    ).fetchall()\n    items = [\n        {\n            \"time\": r[\"time\"],\n            \"booked\": r[\"booked\"],\n            \"remaining\": max(SLOT_CAPACITY - r[\"booked\"], 0),\n        }\n        for r in rows\n        if r[\"booked\"] > 0\n    ]\n    return jsonify({\"items\": items}), 200\n\n\n# --------------------------------------------------------------------------\n# admin\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/admin/reservations\")\n@login_required\ndef admin_reservations(user):\n    if not user[\"is_admin\"]:\n        return error(\"Admin access required\", 403)\n\n    date_s = request.args.get(\"date\")\n    if date_s is not None:\n        date_s = valid_date(date_s)\n        if date_s is None:\n            return error(\"date must be a date in YYYY-MM-DD format\", 400)\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 50))\n    except ValueError:\n        return error(\"page and page_size must be integers\", 400)\n    if page < 1 or page_size < 1:\n        return error(\"page and page_size must be positive integers\", 400)\n\n    where = \"\"\n    params: list = []\n    if date_s is not None:\n        where = \" WHERE date = ?\"\n        params.append(date_s)\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM reservations\" + where, params\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT * FROM reservations\" + where\n        + \" ORDER BY date, time, id LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n\n    return jsonify({\n        \"items\": [reservation_dict(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }), 200\n\n\n# --------------------------------------------------------------------------\n# health + frontend\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path == \"api\":\n        return error(\"Not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794324422609,"end":1794324422631}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c611dfca001ax3rjGx79us4R1","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","messageID":"msg_1c61076fa0014Tu3KJrK7co4ss"}}
