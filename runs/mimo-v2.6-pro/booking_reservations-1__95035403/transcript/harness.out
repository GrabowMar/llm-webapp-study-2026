one\n     return size\n \n \n-def parse_reservation(data: dict, require_fields: bool = True):\n+def parse_reservation(data: dict):\n     \"\"\"Validate the writable fields of a reservation.\n \n     Returns (fields, error_message). ``notes`` is optional and cleared when\n     omitted.\n     \"\"\"\n-\n-    def need(key):\n-        if key in data:\n-            return data[key]\n-        return None if require_fields else \"\"\n-\n     name = data.get(\"name\")\n     email = data.get(\"email\")\n     date_s = data.get(\"date\")\n     time_s = data.get(\"time\")\n","additions":1,"deletions":7},"truncated":false},"title":"backend/app.py","time":{"start":1794324428581,"end":1794324428594}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c611f71e001iNfLnyLUyczdxf","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","messageID":"msg_1c611dff40013uyToxFD8jMOAo"}}
