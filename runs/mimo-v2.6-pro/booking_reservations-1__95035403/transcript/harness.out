{"type":"step_start","timestamp":1794325167162,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"id":"prt_1c61d3c290012wGqp4Hktq0Zzq","messageID":"msg_1c61c997200124ahIRMts933Ej","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","type":"step-start"}}
{"type":"tool_use","timestamp":1794325167191,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"type":"tool","tool":"write","callID":"call_1f316d6b0c6f4b678065e033","state":{"status":"completed","input":{"content":"import { useState, type FormEvent } from \"react\";\nimport { deleteReservation, updateReservation } from \"../api\";\nimport type { Reservation, ReservationInput } from \"../types\";\nimport { formatISO } from \"../dates\";\nimport { SLOT_CAPACITY } from \"../config\";\nimport Message from \"./Message\";\n\nconst inputClass =\n  \"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\n\nfunction Editor({\n  reservation,\n  onSaved,\n  onCancelled,\n}: {\n  reservation: Reservation;\n  onSaved: () => void;\n  onCancelled: () => void;\n}) {\n  const [name, setName] = useState(reservation.name);\n  const [email, setEmail] = useState(reservation.email);\n  const [date, setDate] = useState(reservation.date);\n  const [time, setTime] = useState(reservation.time);\n  const [partySize, setPartySize] = useState(String(reservation.party_size));\n  const [notes, setNotes] = useState(reservation.notes);\n  const [busy, setBusy] = useState(false);\n\n  async function handleSubmit(event: FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    const input: ReservationInput = {\n      name,\n      email,\n      date,\n      time,\n      party_size: Number(partySize),\n      notes,\n    };\n    try {\n      await updateReservation(reservation.id, input);\n      onSaved();\n    } catch {\n      onSaved();\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={handleSubmit} className=\"mt-3 grid gap-2 sm:grid-cols-2\">\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">\n          Name\n        </span>\n        <input\n          value={name}\n          onChange={(event) => setName(event.target.value)}\n          required\n          className={inputClass}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">\n          Email\n        </span>\n        <input\n          type=\"email\"\n          value={email}\n          onChange={(event) => setEmail(event.target.value)}\n          required\n          className={inputClass}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">\n          Date\n        </span>\n        <input\n          type=\"date\"\n          value={date}\n          onChange={(event) => setDate(event.target.value)}\n          required\n          className={inputClass}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">\n          Time\n        </span>\n        <input\n          type=\"time\"\n          value={time}\n          onChange={(event) => setTime(event.target.value)}\n          required\n          className={inputClass}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">\n          Party size\n        </span>\n        <input\n          type=\"number\"\n          min={1}\n          max={SLOT_CAPACITY}\n          value={partySize}\n          onChange={(event) => setPartySize(event.target.value)}\n          required\n          className={inputClass}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">\n          Notes\n        </span>\n        <input\n          value={notes}\n          onChange={(event) => setNotes(event.target.value)}\n          className={inputClass}\n        />\n      </label>\n      <div className=\"flex gap-2 sm:col-span-2\">\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\"\n        >\n          Save changes\n        </button>\n        <button\n          type=\"button\"\n          onClick={onCancelled}\n          className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50\"\n        >\n          Close\n        </button>\n      </div>\n    </form>\n  );\n}\n\nexport default function MyReservations({\n  items,\n  onChanged,\n}: {\n  items: Reservation[];\n  onChanged: () => void;\n}) {\n  const [editingId, setEditingId] = useState<number | null>(null);\n  const [confirmingId, setConfirmingId] = useState<number | null>(null);\n  const [message, setMessage] = useState(\"\");\n  const [kind, setKind] = useState<\"ok\" | \"error\">(\"ok\");\n\n  function report(k: \"ok\" | \"error\", text: string) {\n    setKind(k);\n    setMessage(text);\n  }\n\n  async function confirmCancel(id: number) {\n    try {\n      await deleteReservation(id);\n      report(\"ok\", \"Reservation cancelled.\");\n      onChanged();\n    } catch (err) {\n      report(\"error\", err instanceof Error ? err.message : \"Request failed\");\n    } finally {\n      setConfirmingId(null);\n    }\n  }\n\n  const groups: [string, Reservation[]][] = [];\n  for (const res of items) {\n    const last = groups[groups.length - 1];\n    if (last && last[0] === res.date) {\n      last[1].push(res);\n    } else {\n      groups.push([res.date, [res]]);\n    }\n  }\n\n  return (\n    <section className=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-lg font-semibold text-slate-800\">\n        My reservations\n      </h2>\n      <Message kind={kind} text={message} />\n      {items.length === 0 ? (\n        <p className=\"mt-3 text-sm text-slate-500\">\n          You have no reservations yet.\n        </p>\n      ) : (\n        groups.map(([day, list]) => (\n          <div key={day} className=\"mt-4\">\n            <h3 className=\"text-sm font-semibold text-slate-700\">\n              {formatISO(day)}\n            </h3>\n            <ul className=\"mt-2 space-y-2\">\n              {list.map((res) => (\n                <li\n                  key={res.id}\n                  className=\"rounded-lg border border-slate-200 p-3\"\n                >\n                  <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                    <div>\n                      <p className=\"text-sm text-slate-800\">\n                        <span className=\"font-medium\">{res.time}</span> &middot;{\" \"}\n                        {res.name} &middot; party of {res.party_size}\n                      </p>\n                      <p className=\"text-sm text-slate-500\">{res.email}</p>\n                      {res.notes ? (\n                        <p className=\"text-sm text-slate-500\">\n                          Notes: {res.notes}\n                        </p>\n                      ) : null}\n                      <p className=\"text-xs text-slate-400\">\n                        Booked at {res.created_at}\n                      </p>\n                    </div>\n                    <div className=\"flex gap-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          setConfirmingId(null);\n                          setEditingId(editingId === res.id ? null : res.id);\n                        }}\n                        className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50\"\n                      >\n                        {editingId === res.id ? \"Close\" : \"Edit\"}\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          setEditingId(null);\n                          setConfirmingId(res.id);\n                        }}\n                        className=\"rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700\"\n                      >\n                        Cancel\n                      </button>\n                    </div>\n                  </div>\n\n                  {confirmingId === res.id ? (\n                    <div className=\"mt-3 rounded-md bg-red-50 p-3\">\n                      <p className=\"text-sm text-red-800\">\n                        Cancel this reservation? The seats will be freed.\n                      </p>\n                      <div className=\"mt-2 flex gap-2\">\n                        <button\n                          type=\"button\"\n                          onClick={() => confirmCancel(res.id)}\n                          className=\"rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700\"\n                        >\n                          Yes, cancel it\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={() => setConfirmingId(null)}\n                          className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50\"\n                        >\n                          Keep reservation\n                        </button>\n                      </div>\n                    </div>\n                  ) : null}\n\n                  {editingId === res.id ? (\n                    <Editor\n                      reservation={res}\n                      onSaved={() => {\n                        setEditingId(null);\n                        report(\"ok\", \"Reservation updated.\");\n                        onChanged();\n                      }}\n                      onCancelled={() => setEditingId(null)}\n                    />\n                  ) : null}\n                </li>\n              ))}\n            </ul>\n          </div>\n        ))\n      )}\n    </sec