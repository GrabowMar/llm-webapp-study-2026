{"type":"text","timestamp":1794325216248,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"id":"prt_1c61dfbe9001E2Bx8uyqGTP7c5","messageID":"msg_1c61d9c88001lDReQ4iIYIclrw","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","type":"text","text":"Now the admin panel:","time":{"start":1794325216233,"end":1794325216244}}}
{"type":"tool_use","timestamp":1794325216269,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"type":"tool","tool":"write","callID":"call_2bf5f2b85ed64f4693f72751","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { fetchAdminReservations } from \"../api\";\nimport type { AdminReservationList, SlotAvailability } from \"../types\";\nimport { formatISO } from \"../dates\";\n\nconst PAGE_SIZE = 10;\n\nexport default function AdminPanel({\n  date,\n  availability,\n}: {\n  date: string;\n  availability: SlotAvailability[];\n}) {\n  const [data, setData] = useState<AdminReservationList | null>(null);\n  const [page, setPage] = useState(1);\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    setBusy(true);\n    setMessage(\"\");\n    fetchAdminReservations({ date, page, page_size: PAGE_SIZE })\n      .then((res) => {\n        if (!cancelled) setData(res);\n      })\n      .catch((err) => {\n        if (!cancelled) {\n          setMessage(err instanceof Error ? err.message : \"Request failed\");\n          setData(null);\n        }\n      })\n      .finally(() => {\n        if (!cancelled) setBusy(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [date, page]);\n\n  useEffect(() => {\n    setPage(1);\n  }, [date]);\n\n  const guestTotal = availability.reduce((sum, slot) => sum + slot.booked, 0);\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <section className=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-lg font-semibold text-slate-800\">\n        Admin &mdash; all reservations\n      </h2>\n      <p className=\"text-sm text-slate-600\">\n        {formatISO(date)} &middot;{\" \"}\n        <span className=\"font-medium text-slate-800\">\n          {data?.total ?? 0} reservation{(data?.total ?? 0) === 1 ? \"\" : \"s\"}\n        </span>{\" \"}\n        &middot;{\" \"}\n        <span className=\"font-medium text-slate-800\">\n          {guestTotal} guest{guestTotal === 1 ? \"\" : \"s\"} in total\n        </span>\n      </p>\n      {message ? (\n        <p className=\"mt-3 rounded-md bg-red-50 p-3 text-sm text-red-800\">\n          {message}\n        </p>\n      ) : null}\n\n      <div className=\"mt-4 overflow-x-auto\">\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr className=\"border-b border-slate-200 text-slate-500\">\n              <th className=\"py-2 pr-4 font-medium\">Date</th>\n              <th className=\"py-2 pr-4 font-medium\">Time</th>\n              <th className=\"py-2 pr-4 font-medium\">Name</th>\n              <th className=\"py-2 pr-4 font-medium\">Email</th>\n              <th className=\"py-2 pr-4 font-medium\">Party</th>\n              <th className=\"py-2 pr-4 font-medium\">Notes</th>\n              <th className=\"py-2 font-medium\">Booked at</th>\n            </tr>\n          </thead>\n          <tbody>\n            {(data?.items ?? []).map((res) => (\n              <tr key={res.id} className=\"border-b border-slate-100\">\n                <td className=\"py-2 pr-4 whitespace-nowrap\">{res.date}</td>\n                <td className=\"py-2 pr-4 whitespace-nowrap\">{res.time}</td>\n                <td className=\"py-2 pr-4\">{res.name}</td>\n                <td className=\"py-2 pr-4\">{res.email}</td>\n                <td className=\"py-2 pr-4\">{res.party_size}</td>\n                <td className=\"py-2 pr-4\">{res.notes}</td>\n                <td className=\"py-2 whitespace-nowrap\">{res.created_at}</td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n        {data && data.items.length === 0 && !busy ? (\n          <p className=\"mt-3 text-sm text-slate-500\">\n            No reservations for this day.\n          </p>\n        ) : null}\n      </div>\n\n      <div className=\"mt-4 flex items-center gap-2\">\n        <button\n          type=\"button\"\n          disabled={busy || page <= 1}\n          onClick={() => setPage((p) => Math.max(1, p - 1))}\n          className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50 disabled:opacity-50\"\n        >\n          Previous\n        </button>\n        <span className=\"text-sm text-slate-600\">\n          Page {page} of {pages}\n        </span>\n        <button\n          type=\"button\"\n          disabled={busy || page >= pages}\n          onClick={() => setPage((p) => p + 1)}\n          className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50 disabled:opacity-50\"\n        >\n          Next\n        </button>\n      </div>\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AdminPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AdminPanel.tsx","time":{"start":1794325216241,"end":1794325216251}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61dfbec001nRaUt2Y1CA2dqA","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","messageID":"msg_1c61d9c88001lDReQ4iIYIclrw"}}
