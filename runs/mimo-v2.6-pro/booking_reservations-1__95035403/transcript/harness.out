{"type":"tool_use","timestamp":1794325125496,"sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","part":{"type":"tool","tool":"write","callID":"call_3f94f0b9e4204768941cecef","state":{"status":"completed","input":{"content":"import { useState, type FormEvent } from \"react\";\nimport { createReservation } from \"../api\";\nimport type { ReservationInput } from \"../types\";\nimport { SLOT_CAPACITY } from \"../config\";\nimport Message from \"./Message\";\n\nconst inputClass =\n  \"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\n\nexport default function BookingForm({\n  date,\n  onDateChange,\n  onBooked,\n}: {\n  date: string;\n  onDateChange: (date: string) => void;\n  onBooked: () => void;\n}) {\n  const [name, setName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [time, setTime] = useState(\"\");\n  const [partySize, setPartySize] = useState(\"2\");\n  const [notes, setNotes] = useState(\"\");\n  const [message, setMessage] = useState(\"\");\n  const [kind, setKind] = useState<\"ok\" | \"error\">(\"ok\");\n  const [busy, setBusy] = useState(false);\n\n  async function handleSubmit(event: FormEvent) {\n    event.preventDefault();\n    setMessage(\"\");\n    setBusy(true);\n    const input: ReservationInput = {\n      name,\n      email,\n      date,\n      time,\n      party_size: Number(partySize),\n      notes,\n    };\n    try {\n      const res = await createReservation(input);\n      setKind(\"ok\");\n      setMessage(\n        `Booked ${res.party_size} guests on ${res.date} at ${res.time}.`,\n      );\n      setNotes(\"\");\n      onBooked();\n    } catch (err) {\n      setKind(\"error\");\n      setMessage(err instanceof Error ? err.message : \"Request failed\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <section className=\"rounded-xl border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-lg font-semibold text-slate-800\">\n        Book a table\n      </h2>\n      <form onSubmit={handleSubmit} className=\"grid gap-3 sm:grid-cols-2\">\n        <label className=\"block\">\n          <span className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Name\n          </span>\n          <input\n            value={name}\n            onChange={(event) => setName(event.target.value)}\n            required\n            className={inputClass}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Email\n          </span>\n          <input\n            type=\"email\"\n            value={email}\n            onChange={(event) => setEmail(event.target.value)}\n            required\n            className={inputClass}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Date\n          </span>\n          <input\n            type=\"date\"\n            value={date}\n            onChange={(event) => onDateChange(event.target.value)}\n            required\n            className={inputClass}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Time\n          </span>\n          <input\n            type=\"time\"\n            value={time}\n            onChange={(event) => setTime(event.target.value)}\n            required\n            className={inputClass}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Party size\n          </span>\n          <input\n            type=\"number\"\n            min={1}\n            max={SLOT_CAPACITY}\n            value={partySize}\n            onChange={(event) => setPartySize(event.target.value)}\n            required\n            className={inputClass}\n          />\n        </label>\n        <label className=\"block sm:col-span-2\">\n          <span className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Notes\n          </span>\n          <textarea\n            value={notes}\n            onChange={(event) => setNotes(event.target.value)}\n            rows={2}\n            className={inputClass}\n          />\n        </label>\n        <div className=\"sm:col-span-2\">\n          <Message kind={kind} text={message} />\n        </div>\n        <div className=\"sm:col-span-2\">\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\"\n          >\n            Book\n          </button>\n        </div>\n      </form>\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/BookingForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/BookingForm.tsx","exists":false,"truncated":false},"title":"frontend/src/components/BookingForm.tsx","time":{"start":1794325125466,"end":1794325125475}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61c9954001IjOv6mcx0ESj8D","sessionID":"ses_e39f40dfaffeJMKs6SiMZ6Mx9w","messageID":"msg_1c61c598b001gTuJ8UedWO3B15"}}
