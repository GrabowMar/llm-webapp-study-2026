@@ -0,0 +1,12 @@
+import { Droplets, Radio, Sun, Thermometer, Waves, Wind } from "lucide-react";
+import type { Sensor } from "./types";
+
+export function sensorStyle(sensor: Sensor) {
+  const name = sensor.name.toLowerCase();
+  if (name.includes("water") || name.includes("tank")) return { Icon: Waves, background: "bg-[#e8f1f4]", color: "#6896a5", text: "text-[#608d9b]" };
+  if (name.includes("humidity") || name.includes("moisture") || sensor.unit === "%") return { Icon: Droplets, background: "bg-[#eaf0e4]", color: "#809768", text: "text-[#78905f]" };
+  if (name.includes("light") || sensor.unit === "lux") return { Icon: Sun, background: "bg-[#faf2df]", color: "#c6a056", text: "text-[#b99349]" };
+  if (name.includes("co₂") || name.includes("co2") || sensor.unit === "ppm") return { Icon: Wind, background: "bg-[#edeaf4]", color: "#9b8daf", text: "text-[#8c7ca4]" };
+  if (name.includes("temp") || sensor.unit.includes("°")) return { Icon: Thermometer, background: "bg-[#f6eae1]", color: "#c39779", text: "text-[#b4886a]" };
+  return { Icon: Radio, background: "bg-[#eaf0e4]", color: "#809768", text: "text-[#78905f]" };
+}
diff --git a/frontend/src/types.ts b/frontend/src/types.ts
new file mode 100644
index 0000000..d711352
--- /dev/null
+++ b/frontend/src/types.ts
@@ -0,0 +1,59 @@
+export type Sensor = {
+  id: number;
+  name: string;
+  unit: string;
+  location: string;
+  last_value: number | null;
+  last_updated: string | null;
+  owner: string;
+};
+
+export type Reading = {
+  id: number;
+  sensor_id: number;
+  value: number;
+  recorded_at: string;
+};
+
+export type Session = { token: string; username: string };
+export type View = "overview" | "all" | "mine";
+
+export class ApiError extends Error {
+  status: number;
+  constructor(message: string, status: number) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {
+  const response = await fetch(`/api${path}`, {
+    ...options,
+    headers: {
+      ...(options.body ? { "Content-Type": "application/json" } : {}),
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      ...options.headers,
+    },
+  });
+  if (!response.ok) {
+    const body = await response.json().catch(() => ({ error: "Something went wrong. Please try again." }));
+    throw new ApiError(body.error || "Unable to complete the request.", response.status);
+  }
+  return response.status === 204 ? (undefined as T) : response.json();
+}
+
+export const numberFormat = (value: number) => new Intl.NumberFormat("en", { maximumFractionDigits: 2 }).format(value);
+
+export function timeAgo(date: string | null) {
+  if (!date) return "No readings yet";
+  const seconds = Math.max(0, Math.floor((Date.now() - new Date(date).getTime()) / 1000));
+  if (seconds < 5) return "Just now";
+  if (seconds < 60) return `${seconds}s ago`;
+  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
+  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
+  return `${Math.floor(seconds / 86400)}d ago`;
+}
+
+export function isRecent(sensor: Sensor) {
+  return !!sensor.last_updated && Date.now() - new Date(sensor.last_updated).getTime() < 3600000;
+}
