{"type":"tool_use","timestamp":1794313984412,"sessionID":"ses_e3a9bc48effe0IpMJNFD0aHrVw","part":{"type":"tool","tool":"read","callID":"call_KT8iqkIcAQYXNFHlFASSQY19","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/SensorCard.tsx","limit":80},"output":"<path>/workspace/frontend/src/SensorCard.tsx</path>\n<type>file</type>\n<content>\n1: import { ArrowUpRight, Clock3, Droplets, MapPin, Radio, Sun, Thermometer, Waves, Wind } from \"lucide-react\";\n2: import { useId } from \"react\";\n3: import type { Reading, Sensor } from \"./types\";\n4: import { isRecent, numberFormat, timeAgo } from \"./types\";\n5: \n6: export function sensorStyle(sensor: Sensor) {\n7:   const name = sensor.name.toLowerCase();\n8:   if (name.includes(\"water\") || name.includes(\"tank\")) return { Icon: Waves, background: \"bg-[#e8f1f4]\", color: \"#6896a5\", text: \"text-[#608d9b]\" };\n9:   if (name.includes(\"humidity\") || name.includes(\"moisture\") || sensor.unit === \"%\") return { Icon: Droplets, background: \"bg-[#eaf0e4]\", color: \"#809768\", text: \"text-[#78905f]\" };\n10:   if (name.includes(\"light\") || sensor.unit === \"lux\") return { Icon: Sun, background: \"bg-[#faf2df]\", color: \"#c6a056\", text: \"text-[#b99349]\" };\n11:   if (name.includes(\"co₂\") || name.includes(\"co2\") || sensor.unit === \"ppm\") return { Icon: Wind, background: \"bg-[#edeaf4]\", color: \"#9b8daf\", text: \"text-[#8c7ca4]\" };\n12:   if (name.includes(\"temp\") || sensor.unit.includes(\"°\")) return { Icon: Thermometer, background: \"bg-[#f6eae1]\", color: \"#c39779\", text: \"text-[#b4886a]\" };\n13:   return { Icon: Radio, background: \"bg-[#eaf0e4]\", color: \"#809768\", text: \"text-[#78905f]\" };\n14: }\n15: \n16: export function Sparkline({ readings, color }: { readings: Reading[]; color: string }) {\n17:   const id = useId().replace(/:/g, \"\");\n18:   const values = [...readings].reverse().map((reading) => reading.value);\n19:   if (values.length < 2) return <div className=\"flex h-[57px] items-center gap-3 text-[11px] text-muted\"><span className=\"h-px flex-1 bg-line\" />{values.length ? \"First reading recorded\" : \"Waiting for first reading\"}<span className=\"h-px flex-1 bg-line\" /></div>;\n20:   const minimum = Math.min(...values);\n21:   const range = Math.max(...values) - minimum || 1;\n22:   const points = values.map((value, index) => `${(index / (values.length - 1)) * 300},${44 - ((value - minimum) / range) * 32}`);\n23:   const last = points[points.length - 1].split(\",\");\n24:   return <svg viewBox=\"0 0 300 57\" className=\"h-[57px] w-full overflow-visible\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n25:     <defs><linearGradient id={id} x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stopColor={color} stopOpacity=\"0.15\" /><stop offset=\"100%\" stopColor={color} stopOpacity=\"0\" /></linearGradient></defs>\n26:     <path d={`M${points.join(\" L\")} L300,57 L0,57 Z`} fill={`url(#${id})`} />\n27:     <polyline points={points.join(\" \")} fill=\"none\" stroke={color} strokeWidth=\"1.8\" strokeLinejoin=\"round\" strokeLinecap=\"round\" vectorEffect=\"non-scaling-stroke\" />\n28:     <circle cx={last[0]} cy={last[1]} r=\"3\" fill={color} stroke=\"white\" strokeWidth=\"1.5\" />\n29:   </svg>;\n30: }\n31: \n32: export default function SensorCard({ sensor, readings, onOpen, demo }: { sensor: Sensor; readings: Reading[]; onOpen: () => void; demo: boolean }) {\n33:   const style = sensorStyle(sensor);\n34:   const recent = isRecent(sensor);\n35:   return <article className=\"group overflow-hidden rounded-xl border border-line bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-[#cbd7c3] hover:shadow-[0_8px_24px_-12px_#315c4330]\">\n36:     <button onClick={onOpen} className=\"block w-full text-left\" aria-label={`View ${sensor.name} sensor and readings`}>\n37:       <div className=\"px-5 pt-5\">\n38:         <div className=\"flex items-start justify-between gap-3\">\n39:           <div className={`flex size-10 shrink-0 items-center justify-center rounded-xl ${style.background} ${style.text}`}><style.Icon size={20} strokeWidth={1.7} /></div>\n40:           <span className={`mt-1 flex items-center gap-1.5 rounded-full px-2 py-1 text-[10px] font-medium ${sensor.last_value === null ? \"bg-[#f2f3ef] text-muted\" : recent ? \"bg-[#f0f5e9] text-[#678448]\" : \"bg-[#faf3e5] text-[#a28851]\"}`}><span className={`size-1.5 rounded-full ${sensor.last_value === null ? \"bg-muted\" : recent ? \"bg-[#89a966]\" : \"bg-[#c7ac71]\"}`} />{sensor.last_value === null ? \"Awaiting data\" : demo ? \"Demo\" : recent ? \"Reporting\" : \"Inactive\"}</span>\n41:         </div>\n42:         <h3 className=\"mt-4 truncate text-[15px] font-semibold tracking-[-0.2px]\">{sensor.name}</h3>\n43:         <p className=\"mt-1 flex items-center gap-1 text-[11px] text-muted\"><MapPin size={11} />{sensor.location || \"No location set\"}</p>\n44:         <div className=\"mb-1 mt-5 flex items-baseline gap-2\"><span className=\"text-[37px] font-medium leading-none tracking-[-1.5px]\">{sensor.last_value === null ? \"—\" : numberFormat(sensor.last_value)}</span><span className=\"text-[17px] font-normal text-[#95a08e]\">{sensor.unit}</span></div>\n45:         <div className=\"mb-3 text-[10px] text-muted\">Latest reading</div>\n46:         <Sparkline readings={readings} color={style.color} />\n47:       </div>\n48:       <div className=\"mt-3 flex items-center justify-between border-t border-line/80 px-5 py-3.5\">\n49:         <span className=\"flex items-center gap-1.5 text-[10px] text-muted\"><Clock3 size={11} />{timeAgo(sensor.last_updated)}</span>\n50:         <span className=\"flex items-center gap-1 text-[10px] font-medium text-[#718266] transition-colors group-hover:text-forest\">View history<ArrowUpRight size={13} /></span>\n51:       </div>\n52:     </button>\n53:   </article>;\n54: }\n\n(End of file - total 54 lines)\n</content>","metadata":{"preview":"import { ArrowUpRight, Clock3, Droplets, MapPin, Radio, Sun, Thermometer, Waves, Wind } from \"lucide-react\";\nimport { useId } from \"react\";\nimport type { Reading, Sensor } from \"./types\";\nimport { isRecent, numberFormat, timeAgo } from \"./types\";\n\nexport function sensorStyle(sensor: Sensor) {\n  const name = sensor.name.toLowerCase();\n  if (name.includes(\"water\") || name.includes(\"tank\")) return { Icon: Waves, background: \"bg-[#e8f1f4]\", color: \"#6896a5\", text: \"text-[#608d9b]\" };\n  if (name.includes(\"humidity\") || name.includes(\"moisture\") || sensor.unit === \"%\") return { Icon: Droplets, background: \"bg-[#eaf0e4]\", color: \"#809768\", text: \"text-[#78905f]\" };\n  if (name.includes(\"light\") || sensor.unit === \"lux\") return { Icon: Sun, background: \"bg-[#faf2df]\", color: \"#c6a056\", text: \"text-[#b99349]\" };\n  if (name.includes(\"co₂\") || name.includes(\"co2\") || sensor.unit === \"ppm\") return { Icon: Wind, background: \"bg-[#edeaf4]\", color: \"#9b8daf\", text: \"text-[#8c7ca4]\" };\n  if (name.includes(\"temp\") || sensor.unit.includes(\"°\")) return { Icon: Thermometer, background: \"bg-[#f6eae1]\", color: \"#c39779\", text: \"text-[#b4886a]\" };\n  return { Icon: Radio, background: \"bg-[#eaf0e4]\", color: \"#809768\", text: \"text-[#78905f]\" };\n}\n\nexport function Sparkline({ readings, color }: { readings: Reading[]; color: string }) {\n  const id = useId().replace(/:/g, \"\");\n  const values = [...readings].reverse().map((reading) => reading.value);\n  if (values.length < 2) return <div className=\"flex h-[57px] items-center gap-3 text-[11px] text-muted\"><span className=\"h-px flex-1 bg-line\" />{values.length ? \"First reading recorded\" : \"Waiting for first reading\"}<span className=\"h-px flex-1 bg-line\" /></div>;\n  const minimum = Math.min(...values);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/SensorCard.tsx","text":"import { ArrowUpRight, Clock3, Droplets, MapPin, Radio, Sun, Thermometer, Waves, Wind } from \"lucide-react\";\nimport { useId } from \"react\";\nimport type { Reading, Sensor } from \"./types\";\nimport { isRecent, numberFormat, timeAgo } from \"./types\";\n\nexport function sensorStyle(sensor: Sensor) {\n  const name = sensor.name.toLowerCase();\n  if (name.includes(\"water\") || name.includes(\"tank\")) return { Icon: Waves, background: \"bg-[#e8f1f4]\", color: \"#6896a5\", text: \"text-[#608d9b]\" };\n  if (name.includes(\"humidity\") || name.includes(\"moisture\") || sensor.unit === \"%\") return { Icon: Droplets, background: \"bg-[#eaf0e4]\", color: \"#809768\", text: \"text-[#78905f]\" };\n  if (name.includes(\"light\") || sensor.unit === \"lux\") return { Icon: Sun, background: \"bg-[#faf2df]\", color: \"#c6a056\", text: \"text-[#b99349]\" };\n  if (name.includes(\"co₂\") || name.includes(\"co2\") || sensor.unit === \"ppm\") return { Icon: Wind, background: \"bg-[#edeaf4]\", color: \"#9b8daf\", text: \"text-[#8c7ca4]\" };\n  if (name.includes(\"temp\") || sensor.unit.includes(\"°\")) return { Icon: Thermometer, background: \"bg-[#f6eae1]\", color: \"#c39779\", text: \"text-[#b4886a]\" };\n  return { Icon: Radio, background: \"bg-[#eaf0e4]\", color: \"#809768\", text: \"text-[#78905f]\" };\n}\n\nexport function Sparkline({ readings, color }: { readings: Reading[]; color: string }) {\n  const id = useId().replace(/:/g, \"\");\n  const values = [...readings].reverse().map((reading) => reading.value);\n  if (values.length < 2) return <div className=\"flex h-[57px] items-center gap-3 text-[11px] text-muted\"><span className=\"h-px flex-1 bg-line\" />{values.length ? \"First reading recorded\" : \"Waiting for first reading\"}<span className=\"h-px flex-1 bg-line\" /></div>;\n  const minimum = Math.min(...values);\n  const range = Math.max(...values) - minimum || 1;\n  const points = values.map((value, index) => `${(index / (values.length - 1)) * 300},${44 - ((value - minimum) / range) * 32}`);\n  const last = points[points.length - 1].split(\",\");\n  return <svg viewBox=\"0 0 300 57\" className=\"h-[57px] w-full overflow-visible\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n    <defs><linearGradient id={id} x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stopColor={color} stopOpacity=\"0.15\" /><stop offset=\"100%\" stopColor={color} stopOpacity=\"0\" /></linearGradient></defs>\n    <path d={`M${points.join(\" L\")} L300,57 L0,57 Z`} fill={`url(#${id})`} />\n    <polyline points={points.join(\" \")} fill=\"none\" stroke={color} strokeWidth=\"1.8\" strokeLinejoin=\"round\" strokeLinecap=\"round\" vectorEffect=\"non-scaling-stroke\" />\n    <circle cx={last[0]} cy={last[1]} r=\"3\" fill={color} stroke=\"white\" strokeWidth=\"1.5\" />\n  </svg>;\n}\n\nexport default function SensorCard({ sensor, readings, onOpen, demo }: { sensor: Sensor; readings: Reading[]; onOpen: () => void; demo: boolean }) {\n  const style = sensorStyle(sensor);\n  const recent = isRecent(sensor);\n  return <article className=\"group overflow-hidden rounded-xl border border-line bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-[#cbd7c3] hover:shadow-[0_8px_24px_-12px_#315c4330]\">\n    <button onClick={onOpen} className=\"block w-full text-left\" aria-label={`View ${sensor.name} sensor and readings`}>\n      <div className=\"px-5 pt-5\">\n        <div className=\"flex items-start justify-between gap-3\">\n          <div className={`flex size-10 shrink-0 items-center justify-center rounded-xl ${style.background} ${style.text}`}><style.Icon size={20} strokeWidth={1.7} /></div>\n          <span className={`mt-1 flex items-center gap-1.5 rounded-full px-2 py-1 text-[10px] font-medium ${sensor.last_value === null ? \"bg-[#f2f3ef] text-muted\" : recent ? \"bg-[#f0f5e9] text-[#678448]\" : \"bg-[#faf3e5] text-[#a28851]\"}`}><span className={`size-1.5 rounded-full ${sensor.last_value === null ? \"bg-muted\" : recent ? \"bg-[#89a966]\" : \"bg-[#c7ac71]\"}`} />{sensor.last_value === null ? \"Awaiting data\" : demo ? \"Demo\" : recent ? \"Reporting\" : \"Inactive\"}</span>\n        </div>\n        <h3 className=\"mt-4 truncate text-[15px] font-semibold tracking-[-0.2px]\">{sensor.name}</h3>\n        <p className=\"mt-1 flex items-center gap-1 text-[11px] text-muted\"><MapPin size={11} />{sensor.location || \"No location set\"}</p>\n        <div className=\"mb-1 mt-5 flex items-baseline gap-2\"><span className=\"text-[37px] font-medium leading-none tracking-[-1.5px]\">{sensor.last_value === null ? \"—\" : numberFormat(sensor.last_value)}</span><span className=\"text-[17px] font-normal text-[#95a08e]\">{sensor.unit}</span></div>\n        <div className=\"mb-3 text-[10px] text-muted\">Latest reading</div>\n        <Sparkline readings={readings} color={style.color} />\n      </div>\n      <div className=\"mt-3 flex items-center justify-between border-t border-line/80 px-5 py-3.5\">\n        <span className=\"flex items-center gap-1.5 text-[10px] text-muted\"><Clock3 size={11} />{timeAgo(sensor.last_updated)}</span>\n        <span className=\"flex items-center gap-1 text-[10px] font-medium text-[#718266] transition-colors group-hover:text-forest\">View history<ArrowUpRight size={13} /></span>\n      </div>\n    </button>\n  </article>;\n}","lineStart":1,"lineEnd":54,"totalLines":54,"truncated":false}},"title":"frontend/src/SensorCard.tsx","time":{"start":1794313984338,"end":1794313984409}},"id":"prt_1c572994d0017FCyOFC41fdm59","sessionID":"ses_e3a9bc48effe0IpMJNFD0aHrVw","messageID":"msg_1c5728152001FzfzBeBfAruWr9"}}
