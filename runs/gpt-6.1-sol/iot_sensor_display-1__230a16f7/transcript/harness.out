{"type":"tool_use","timestamp":1794313155978,"sessionID":"ses_e3a9bc48effe0IpMJNFD0aHrVw","part":{"type":"tool","tool":"apply_patch","callID":"call_1e1QbQ8zgTU5jQck2GbPKc8M","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Delete File: /workspace/backend/app.py\n*** Add File: /workspace/backend/app.py\n+import hashlib\n+import math\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+SENSOR_QUERY = \"\"\"\n+    SELECT sensors.id, sensors.name, sensors.unit, sensors.location,\n+           sensors.last_value, sensors.last_updated, users.username AS owner\n+    FROM sensors JOIN users ON users.id = sensors.owner_id\n+\"\"\"\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        g.db = sqlite3.connect(g.database_path, timeout=20)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def utc_now():\n+    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        raise ApiError(\"A JSON object is required.\", 400)\n+    return body\n+\n+\n+def text_field(body, name, maximum, required=True, strip=True):\n+    value = body.get(name, \"\")\n+    if not isinstance(value, str):\n+        raise ApiError(f\"{name} must be text.\", 400)\n+    if strip:\n+        value = value.strip()\n+    if (required and not value) or len(value) > maximum:\n+        raise ApiError(f\"{name} must contain {'1' if required else '0'}–{maximum} characters.\", 400)\n+    return value\n+\n+\n+class ApiError(Exception):\n+    def __init__(self, message, status):\n+        self.message = message\n+        self.status = status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        header = request.headers.get(\"Authorization\", \"\").split()\n+        if len(header) != 2 or header[0].lower() != \"bearer\":\n+            raise ApiError(\"Sign in to continue.\", 401)\n+        digest = hashlib.sha256(header[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"\"\"SELECT users.id, users.username FROM sessions\n+               JOIN users ON users.id = sessions.user_id\n+               WHERE token_hash = ? AND expires_at > ?\"\"\",\n+            (digest, utc_now()),\n+        ).fetchone()\n+        if user is None:\n+            raise ApiError(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = digest\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def find_sensor(sensor_id, owned=False):\n+    sensor = get_db().execute(SENSOR_QUERY + \" WHERE sensors.id = ?\", (sensor_id,)).fetchone()\n+    if sensor is None:\n+        raise ApiError(\"Sensor not found.\", 404)\n+    if owned and sensor[\"owner\"] != g.user[\"username\"]:\n+        raise ApiError(\"Only the sensor owner can perform this action.\", 403)\n+    return dict(sensor)\n+\n+\n+def create_app(config=None):\n+    application = Flask(__name__, static_folder=None)\n+    application.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"sensors.sqlite3\")),\n+        MAX_CONTENT_LENGTH=16384,\n+    )\n+    if config:\n+        application.config.update(config)\n+    database_path = Path(application.config[\"DATABASE\"])\n+    database_path.parent.mkdir(parents=True, exist_ok=True)\n+    with sqlite3.connect(database_path, timeout=20) as db:\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sensors (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                owner_id INTEGER NOT NULL REFERENCES users(id),\n+                name TEXT NOT NULL,\n+                unit TEXT NOT NULL DEFAULT '',\n+                location TEXT NOT NULL DEFAULT '',\n+                last_value REAL,\n+                last_updated TEXT\n+            );\n+            CREATE TABLE IF NOT EXISTS readings (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n+                value REAL NOT NULL,\n+                recorded_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS readings_sensor_id ON readings(sensor_id, id DESC);\n+            CREATE INDEX IF NOT EXISTS sessions_user_id ON sessions(user_id);\n+        \"\"\")\n+\n+    @application.before_request\n+    def database_config():\n+        g.database_path = application.config[\"DATABASE\"]\n+\n+    @application.teardown_appcontext\n+    def close_db(error=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @application.errorhandler(ApiError)\n+    def api_error(error):\n+        return {\"error\": error.message}, error.status\n+\n+    @application.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @application.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @application.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @application.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        username = text_field(body, \"username\", 64)\n+        password = text_field(body, \"password\", 256, strip=False)\n+        password_hash = generate_password_hash(password)\n+        db = get_db()\n+        try:\n+            with db:\n+                db.execute(\"INSERT INTO users (username, password_hash) VALUES (?, ?)\", (username, password_hash))\n+        except sqlite3.IntegrityError:\n+            raise ApiError(\"That username is already taken.\", 409) from None\n+        return {\"username\": username}, 201\n+\n+    @application.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        username = text_field(body, \"username\", 64)\n+        password = text_field(body, \"password\", 256, strip=False)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            raise ApiError(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        expires = (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(timespec=\"microseconds\")\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (utc_now(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], expires),\n+            )\n+        return {\"token\": token}\n+\n+    @application.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @application.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @application.get(\"/api/sensors\")\n+    def sensors():\n+        rows = get_db().execute(SENSOR_QUERY + \" ORDER BY sensors.name COLLATE NOCASE, sensors.id\").fetchall()\n+        return {\"items\": [dict(row) for row in rows]}\n+\n+    @application.post(\"/api/sensors\")\n+    @authenticated\n+    def add_sensor():\n+        body = json_body()\n+        name = text_field(body, \"name\", 120)\n+        unit = text_field(body, \"unit\", 32, required=False)\n+        location = text_field(body, \"location\", 160, required=False)\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO sensors (owner_id, name, unit, location) VALUES (?, ?, ?, ?)\",\n+                (g.user[\"id\"], name, unit, location),\n+            )\n+        return find_sensor(cursor.lastrowid), 201\n+\n+    @application.get(\"/api/sensors/<int:sensor_id>\")\n+    def sensor(sensor_id):\n+        return find_sensor(sensor_id)\n+\n+    @application.delete(\"/api/sensors/<int:sensor_id>\")\n+    @authenticated\n+    def delete_sensor(sensor_id):\n+        find_sensor(sensor_id, owned=True)\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n+        return \"\", 204\n+\n+    @application.get(\"/api/sensors/<int:sensor_id>/readings\")\n+    def readings(sensor_id):\n+        find_sensor(sensor_id)\n+        try:\n+            limit = int(request.args.get(\"limit\", \"100\"))\n+        except ValueError:\n+            raise ApiError(\"limit must be an integer between 1 and 1000.\", 400) from None\n+        if not 1 <= limit <= 1000:\n+            raise ApiError(\"limit must be an integer between 1 and 1000.\", 400)\n+        db = get_db()\n+        with db:\n+            rows = db.execute(\n+                \"SELECT * FROM readings WHERE sensor_id = ? ORDER BY id DESC LIMIT ?\", (sensor_id, limit)\n+            ).fetchall()\n+            total = db.execute(\"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)).fetchone()[0]\n+        return {\"items\": [dict(row) for row in rows], \"total\": total}\n+\n+    @application.post(\"/api/sensors/<int:sensor_id>/readings\")\n+    @authenticated\n+    def add_reading(sensor_id):\n+        find_sensor(sensor_id, owned=True)\n+        value = json_body().get(\"value\")\n+        try:\n+            valid = type(value) in (int, float) and math.isfinite(value)\n+        except OverflowError:\n+            valid = False\n+        if not valid:\n+            raise ApiError(\"value must be a finite number.\", 400)\n+        db = get_db()\n+        with db:\n+            db.execute(\"BEGIN IMMEDIATE\")\n+            find_sensor(sensor_id, owned=True)\n+            recorded_at = utc_now()\n+            cursor = db.execute(\n+                \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n+                (sensor_id, value, recorded_at),\n+            )\n+            db.execute(\n+                \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n+                (value, recorded_at, sensor_id),\n+            )\n+        return {\"id\": cursor.lastrowid, \"sensor_id\": sensor_id, \"value\": value, \"recorded_at\": recorded_at}, 201\n+\n+    @application.get(\"/\")\n+    @application.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            raise ApiError(\"API endpoint not found.\", 404)\n+        candidate = (DIST / path).resolve()\n+        if candidate.is_relative_to(DIST.resolve()) and candidate.is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return application\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n*** Add File: /workspace/backend/test_app.py\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app\n+\n+\n+class ApiTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.config = {\"TESTING\": True, \"DATABASE\": str(Path(self.directory.name) / \"test.sqlite3\")}\n+        self.app = create_app(self.config)\n+        self.client = self.app.test_client()\n+        self.alice = self.account(\"alice\")\n+        self.bob = self.account(\"bob\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        result = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(result.status_code, 201)\n+        result = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(result.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + result.json[\"token\"]}\n+\n+    def sensor(self, name=\"Temperature\"):\n+        response = self.client.post(\n+            \"/api/sensors\", json={\"name\": name, \"unit\": \"°C\", \"location\": \"Greenhouse\"}, headers=self.alice\n+        )\n+        self.assertEqual(response.status_code, 201)\n+        return response.json\n+\n+    def test_health_and_json_errors(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/unknown\").status_code, 404)\n+        self.assertIn(\"error\", self.client.get(\"/api/unknown\").json)\n+        self.assertEqual(self.client.patch(\"/api/sensors\").status_code, 405)\n+\n+    def test_authentication(self):\n+        self.assertEqual(self.client.post(\"/api/sensors\", json={\"name\": \"A\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/sensors\", headers={\"Authorization\": \"Bearer bad\"}).status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.alice).json, {\"username\": \"alice\"})\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"}).status_code, 409)\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.alice).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.alice).status_code, 401)\n+\n+    def test_new_sensor_and_sorting(self):\n+        sensor = self.sensor(\"Zulu\")\n+        self.assertEqual(set(sensor), {\"id\", \"name\", \"unit\", \"location\", \"last_value\", \"last_updated\", \"owner\"})\n+        self.assertIsNone(sensor[\"last_value\"])\n+        self.assertIsNone(sensor[\"last_updated\"])\n+        self.assertEqual(sensor[\"owner\"], \"alice\")\n+        self.sensor(\"Alpha\")\n+        self.assertEqual([s[\"name\"] for s in self.client.get(\"/api/sensors\").json[\"items\"]], [\"Alpha\", \"Zulu\"])\n+        self.assertEqual(self.client.get(f\"/api/sensors/{sensor['id']}\").json, sensor)\n+\n+    def test_ownership_and_cascade(self):\n+        sensor = self.sensor()\n+        url = f\"/api/sensors/{sensor['id']}\"\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}, headers=self.bob).status_code, 403)\n+        self.assertEqual(self.client.delete(url, headers=self.bob).status_code, 403)\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}).status_code, 401)\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}, headers=self.alice).status_code, 201)\n+        self.assertEqual(self.client.delete(url, headers=self.alice).status_code, 204)\n+        self.assertEqual(self.client.get(url).status_code, 404)\n+        self.assertEqual(self.client.get(url + \"/readings\").status_code, 404)\n+        with self.app.app_context():\n+            import sqlite3\n+            with sqlite3.connect(self.config[\"DATABASE\"]) as db:\n+                self.assertEqual(db.execute(\"SELECT COUNT(*) FROM readings\").fetchone()[0], 0)\n+\n+    def test_readings_and_limit(self):\n+        sensor = self.sensor()\n+        url = f\"/api/sensors/{sensor['id']}\"\n+        self.assertEqual(self.client.get(url + \"/readings\").json, {\"items\": [], \"total\": 0})\n+        for value in [0, -2.5, 21.7]:\n+            result = self.client.post(url + \"/readings\", json={\"value\": value, \"recorded_at\": \"fake\"}, headers=self.alice)\n+            self.assertEqual(result.status_code, 201)\n+            self.assertNotEqual(result.json[\"recorded_at\"], \"fake\")\n+        data = self.client.get(url + \"/readings?limit=2\").json\n+        self.assertEqual(data[\"total\"], 3)\n+        self.assertEqual([r[\"value\"] for r in data[\"items\"]], [21.7, -2.5])\n+        latest = self.client.get(url).json\n+        self.assertEqual(latest[\"last_value\"], 21.7)\n+        self.assertEqual(latest[\"last_updated\"], data[\"items\"][0][\"recorded_at\"])\n+        for limit in [\"0\", \"-1\", \"x\", \"1001\", \"1.5\"]:\n+            self.assertEqual(self.client.get(url + \"/readings?limit=\" + limit).status_code, 400)\n+\n+    def test_validation(self):\n+        for body in [[], None, {\"name\": \"\"}, {\"name\": 3}, {\"name\": \"a\", \"unit\": []}]:\n+            self.assertEqual(self.client.post(\"/api/sensors\", json=body, headers=self.alice).status_code, 400)\n+        sensor = self.sensor()\n+        for value in [None, True, \"23\", float(\"inf\"), float(\"nan\"), [], {}]:\n+            response = self.client.post(f\"/api/sensors/{sensor['id']}/readings\", json={\"value\": value}, headers=self.alice)\n+            self.assertEqual(response.status_code, 400)\n+\n+    def test_persistence_across_restart(self):\n+        sensor = self.sensor()\n+        self.client.post(f\"/api/sensors/{sensor['id']}/readings\", json={\"value\": 20}, headers=self.alice)\n+        restarted = create_app(self.config).test_client()\n+        self.assertEqual(restarted.get(f\"/api/sensors/{sensor['id']}\").json[\"last_value\"], 20)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.alice).status_code, 200)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** Add File: /workspace/.gitignore\n+data/\n+__pycache__/\n+*.pyc\n+frontend/node_modules/\n+frontend/dist/\n+.venv/\n*** End Patch"},"output":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/test_app.py\nA .gitignore","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n\nIndex: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,302 @@\n+import hashlib\n+import math\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+SENSOR_QUERY = \"\"\"\n+    SELECT sensors.id, sensors.name, sensors.unit, sensors.location,\n+           sensors.last_value, sensors.last_updated, users.username AS owner\n+    FROM sensors JOIN users ON users.id = sensors.owner_id\n+\"\"\"\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        g.db = sqlite3.connect(g.database_path, timeout=20)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def utc_now():\n+    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        raise ApiError(\"A JSON object is required.\", 400)\n+    return body\n+\n+\n+def text_field(body, name, maximum, required=True, strip=True):\n+    value = body.get(name, \"\")\n+    if not isinstance(value, str):\n+        raise ApiError(f\"{name} must be text.\", 400)\n+    if strip:\n+        value = value.strip()\n+    if (required and not value) or len(value) > maximum:\n+        raise ApiError(f\"{name} must contain {'1' if required else '0'}–{maximum} characters.\", 400)\n+    return value\n+\n+\n+class ApiError(Exception):\n+    def __init__(self, message, status):\n+        self.message = message\n+        self.status = status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        header = request.headers.get(\"Authorization\", \"\").split()\n+        if len(header) != 2 or header[0].lower() != \"bearer\":\n+            raise ApiError(\"Sign in to continue.\", 401)\n+        digest = hashlib.sha256(header[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"\"\"SELECT users.id, users.username FROM sessions\n+               JOIN users ON users.id = sessions.user_id\n+               WHERE token_hash = ? AND expires_at > ?\"\"\",\n+            (digest, utc_now()),\n+        ).fetchone()\n+        if user is None:\n+            raise ApiError(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = digest\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def find_sensor(sensor_id, owned=False):\n+    sensor = get_db().execute(SENSOR_QUERY + \" WHERE sensors.id = ?\", (sensor_id,)).fetchone()\n+    if sensor is None:\n+        raise ApiError(\"Sensor not found.\", 404)\n+    if owned and sensor[\"owner\"] != g.user[\"username\"]:\n+        raise ApiError(\"Only the sensor owner can perform this action.\", 403)\n+    return dict(sensor)\n+\n+\n+def create_app(config=None):\n+    application = Flask(__name__, static_folder=None)\n+    application.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"sensors.sqlite3\")),\n+        MAX_CONTENT_LENGTH=16384,\n+    )\n+    if config:\n+        application.config.update(config)\n+    database_path = Path(application.config[\"DATABASE\"])\n+    database_path.parent.mkdir(parents=True, exist_ok=True)\n+    with sqlite3.connect(database_path, timeout=20) as db:\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sensors (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                owner_id INTEGER NOT NULL REFERENCES users(id),\n+                name TEXT NOT NULL,\n+                unit TEXT NOT NULL DEFAULT '',\n+                location TEXT NOT NULL DEFAULT '',\n+                last_value REAL,\n+                last_updated TEXT\n+            );\n+            CREATE TABLE IF NOT EXISTS readings (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n+                value REAL NOT NULL,\n+                recorded_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS readings_sensor_id ON readings(sensor_id, id DESC);\n+            CREATE INDEX IF NOT EXISTS sessions_user_id ON sessions(user_id);\n+        \"\"\")\n+\n+    @application.before_request\n+    def database_config():\n+        g.database_path = application.config[\"DATABASE\"]\n+\n+    @application.teardown_appcontext\n+    def close_db(error=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @application.errorhandler(ApiError)\n+    def api_error(error):\n+        return {\"error\": error.message}, error.status\n+\n+    @application.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @application.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @application.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @application.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        username = text_field(body, \"username\", 64)\n+        password = text_field(body, \"password\", 256, strip=False)\n+        password_hash = generate_password_hash(password)\n+        db = get_db()\n+        try:\n+            with db:\n+                db.execute(\"INSERT INTO users (username, password_hash) VALUES (?, ?)\", (username, password_hash))\n+        except sqlite3.IntegrityError:\n+            raise ApiError(\"That username is already taken.\", 409) from None\n+        return {\"username\": username}, 201\n+\n+    @application.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        username = text_field(body, \"username\", 64)\n+        password = text_field(body, \"password\", 256, strip=False)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            raise ApiError(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        expires = (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(timespec=\"microseconds\")\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (utc_now(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], expires),\n+            )\n+        return {\"token\": token}\n+\n+    @application.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @application.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @application.get(\"/api/sensors\")\n+    def sensors():\n+        rows = get_db().execute(SENSOR_QUERY + \" ORDER BY sensors.name COLLATE NOCASE, sensors.id\").fetchall()\n+        return {\"items\": [dict(row) for row in rows]}\n+\n+    @application.post(\"/api/sensors\")\n+    @authenticated\n+    def add_sensor():\n+        body = json_body()\n+        name = text_field(body, \"name\", 120)\n+        unit = text_field(body, \"unit\", 32, required=False)\n+        location = text_field(body, \"location\", 160, required=False)\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO sensors (owner_id, name, unit, location) VALUES (?, ?, ?, ?)\",\n+                (g.user[\"id\"], name, unit, location),\n+            )\n+        return find_sensor(cursor.lastrowid), 201\n+\n+    @application.get(\"/api/sensors/<int:sensor_id>\")\n+    def sensor(sensor_id):\n+        return find_sensor(sensor_id)\n+\n+    @application.delete(\"/api/sensors/<int:sensor_id>\")\n+    @authenticated\n+    def delete_sensor(sensor_id):\n+        find_sensor(sensor_id, owned=True)\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n+        return \"\", 204\n+\n+    @application.get(\"/api/sensors/<int:sensor_id>/readings\")\n+    def readings(sensor_id):\n+        find_sensor(sensor_id)\n+        try:\n+            limit = int(request.args.get(\"limit\", \"100\"))\n+        except ValueError:\n+            raise ApiError(\"limit must be an integer between 1 and 1000.\", 400) from None\n+        if not 1 <= limit <= 1000:\n+            raise ApiError(\"limit must be an integer between 1 and 1000.\", 400)\n+        db = get_db()\n+        with db:\n+            rows = db.execute(\n+                \"SELECT * FROM readings WHERE sensor_id = ? ORDER BY id DESC LIMIT ?\", (sensor_id, limit)\n+            ).fetchall()\n+            total = db.execute(\"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)).fetchone()[0]\n+        return {\"items\": [dict(row) for row in rows], \"total\": total}\n+\n+    @application.post(\"/api/sensors/<int:sensor_id>/readings\")\n+    @authenticated\n+    def add_reading(sensor_id):\n+        find_sensor(sensor_id, owned=True)\n+        value = json_body().get(\"value\")\n+        try:\n+            valid = type(value) in (int, float) and math.isfinite(value)\n+        except OverflowError:\n+            valid = False\n+        if not valid:\n+            raise ApiError(\"value must be a finite number.\", 400)\n+        db = get_db()\n+        with db:\n+            db.execute(\"BEGIN IMMEDIATE\")\n+            find_sensor(sensor_id, owned=True)\n+            recorded_at = utc_now()\n+            cursor = db.execute(\n+                \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n+                (sensor_id, value, recorded_at),\n+            )\n+            db.execute(\n+                \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n+                (value, recorded_at, sensor_id),\n+            )\n+        return {\"id\": cursor.lastrowid, \"sensor_id\": sensor_id, \"value\": value, \"recorded_at\": recorded_at}, 201\n+\n+    @application.get(\"/\")\n+    @application.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            raise ApiError(\"API endpoint not found.\", 404)\n+        candidate = (DIST / path).resolve()\n+        if candidate.is_relative_to(DIST.resolve()) and candidate.is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return application\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\nIndex: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,108 @@\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app\n+\n+\n+class ApiTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.config = {\"TESTING\": True, \"DATABASE\": str(Path(self.directory.name) / \"test.sqlite3\")}\n+        self.app = create_app(self.config)\n+        self.client = self.app.test_client()\n+        self.alice = self.account(\"alice\")\n+        self.bob = self.account(\"bob\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        result = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(result.status_code, 201)\n+        result = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(result.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + result.json[\"token\"]}\n+\n+    def sensor(self, name=\"Temperature\"):\n+        response = self.client.post(\n+            \"/api/sensors\", json={\"name\": name, \"unit\": \"°C\", \"location\": \"Greenhouse\"}, headers=self.alice\n+        )\n+        self.assertEqual(response.status_code, 201)\n+        return response.json\n+\n+    def test_health_and_json_errors(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/unknown\").status_code, 404)\n+        self.assertIn(\"error\", self.client.get(\"/api/unknown\").json)\n+        self.assertEqual(self.client.patch(\"/api/sensors\").status_code, 405)\n+\n+    def test_authentication(self):\n+        self.assertEqual(self.client.post(\"/api/sensors\", json={\"name\": \"A\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/sensors\", headers={\"Authorization\": \"Bearer bad\"}).status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.alice).json, {\"username\": \"alice\"})\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"}).status_code, 409)\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.alice).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.alice).status_code, 401)\n+\n+    def test_new_sensor_and_sorting(self):\n+        sensor = self.sensor(\"Zulu\")\n+        self.assertEqual(set(sensor), {\"id\", \"name\", \"unit\", \"location\", \"last_value\", \"last_updated\", \"owner\"})\n+        self.assertIsNone(sensor[\"last_value\"])\n+        self.assertIsNone(sensor[\"last_updated\"])\n+        self.assertEqual(sensor[\"owner\"], \"alice\")\n+        self.sensor(\"Alpha\")\n+        self.assertEqual([s[\"name\"] for s in self.client.get(\"/api/sensors\").json[\"items\"]], [\"Alpha\", \"Zulu\"])\n+        self.assertEqual(self.client.get(f\"/api/sensors/{sensor['id']}\").json, sensor)\n+\n+    def test_ownership_and_cascade(self):\n+        sensor = self.sensor()\n+        url = f\"/api/sensors/{sensor['id']}\"\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}, headers=self.bob).status_code, 403)\n+        self.assertEqual(self.client.delete(url, headers=self.bob).status_code, 403)\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}).status_code, 401)\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}, headers=self.alice).status_code, 201)\n+        self.assertEqual(self.client.delete(url, headers=self.alice).status_code, 204)\n+        self.assertEqual(self.client.get(url).status_code, 404)\n+        self.assertEqual(self.client.get(url + \"/readings\").status_code, 404)\n+        with self.app.app_context():\n+            import sqlite3\n+            with sqlite3.connect(self.config[\"DATABASE\"]) as db:\n+                self.assertEqual(db.execute(\"SELECT COUNT(*) FROM readings\").fetchone()[0], 0)\n+\n+    def test_readings_and_limit(self):\n+        sensor = self.sensor()\n+        url = f\"/api/sensors/{sensor['id']}\"\n+        self.assertEqual(self.client.get(url + \"/readings\").json, {\"items\": [], \"total\": 0})\n+        for value in [0, -2.5, 21.7]:\n+            result = self.client.post(url + \"/readings\", json={\"value\": value, \"recorded_at\": \"fake\"}, headers=self.alice)\n+            self.assertEqual(result.status_code, 201)\n+            self.assertNotEqual(result.json[\"recorded_at\"], \"fake\")\n+        data = self.client.get(url + \"/readings?limit=2\").json\n+        self.assertEqual(data[\"total\"], 3)\n+        self.assertEqual([r[\"value\"] for r in data[\"items\"]], [21.7, -2.5])\n+        latest = self.client.get(url).json\n+        self.assertEqual(latest[\"last_value\"], 21.7)\n+        self.assertEqual(latest[\"last_updated\"], data[\"items\"][0][\"recorded_at\"])\n+        for limit in [\"0\", \"-1\", \"x\", \"1001\", \"1.5\"]:\n+            self.assertEqual(self.client.get(url + \"/readings?limit=\" + limit).status_code, 400)\n+\n+    def test_validation(self):\n+        for body in [[], None, {\"name\": \"\"}, {\"name\": 3}, {\"name\": \"a\", \"unit\": []}]:\n+            self.assertEqual(self.client.post(\"/api/sensors\", json=body, headers=self.alice).status_code, 400)\n+        sensor = self.sensor()\n+        for value in [None, True, \"23\", float(\"inf\"), float(\"nan\"), [], {}]:\n+            response = self.client.post(f\"/api/sensors/{sensor['id']}/readings\", json={\"value\": value}, headers=self.alice)\n+            self.assertEqual(response.status_code, 400)\n+\n+    def test_persistence_across_restart(self):\n+        sensor = self.sensor()\n+        self.client.post(f\"/api/sensors/{sensor['id']}/readings\", json={\"value\": 20}, headers=self.alice)\n+        restarted = create_app(self.config).test_client()\n+        self.assertEqual(restarted.get(f\"/api/sensors/{sensor['id']}\").json[\"last_value\"], 20)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.alice).status_code, 200)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,6 @@\n+data/\n+__pycache__/\n+*.pyc\n+frontend/node_modules/\n+frontend/dist/\n+.venv/\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,302 @@\n+import hashlib\n+import math\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+SENSOR_QUERY = \"\"\"\n+    SELECT sensors.id, sensors.name, sensors.unit, sensors.location,\n+           sensors.last_value, sensors.last_updated, users.username AS owner\n+    FROM sensors JOIN users ON users.id = sensors.owner_id\n+\"\"\"\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        g.db = sqlite3.connect(g.database_path, timeout=20)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def utc_now():\n+    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        raise ApiError(\"A JSON object is required.\", 400)\n+    return body\n+\n+\n+def text_field(body, name, maximum, required=True, strip=True):\n+    value = body.get(name, \"\")\n+    if not isinstance(value, str):\n+        raise ApiError(f\"{name} must be text.\", 400)\n+    if strip:\n+        value = value.strip()\n+    if (required and not value) or len(value) > maximum:\n+        raise ApiError(f\"{name} must contain {'1' if required else '0'}–{maximum} characters.\", 400)\n+    return value\n+\n+\n+class ApiError(Exception):\n+    def __init__(self, message, status):\n+        self.message = message\n+        self.status = status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        header = request.headers.get(\"Authorization\", \"\").split()\n+        if len(header) != 2 or header[0].lower() != \"bearer\":\n+            raise ApiError(\"Sign in to continue.\", 401)\n+        digest = hashlib.sha256(header[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"\"\"SELECT users.id, users.username FROM sessions\n+               JOIN users ON users.id = sessions.user_id\n+               WHERE token_hash = ? AND expires_at > ?\"\"\",\n+            (digest, utc_now()),\n+        ).fetchone()\n+        if user is None:\n+            raise ApiError(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = digest\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def find_sensor(sensor_id, owned=False):\n+    sensor = get_db().execute(SENSOR_QUERY + \" WHERE sensors.id = ?\", (sensor_id,)).fetchone()\n+    if sensor is None:\n+        raise ApiError(\"Sensor not found.\", 404)\n+    if owned and sensor[\"owner\"] != g.user[\"username\"]:\n+        raise ApiError(\"Only the sensor owner can perform this action.\", 403)\n+    return dict(sensor)\n+\n+\n+def create_app(config=None):\n+    application = Flask(__name__, static_folder=None)\n+    application.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"sensors.sqlite3\")),\n+        MAX_CONTENT_LENGTH=16384,\n+    )\n+    if config:\n+        application.config.update(config)\n+    database_path = Path(application.config[\"DATABASE\"])\n+    database_path.parent.mkdir(parents=True, exist_ok=True)\n+    with sqlite3.connect(database_path, timeout=20) as db:\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sensors (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                owner_id INTEGER NOT NULL REFERENCES users(id),\n+                name TEXT NOT NULL,\n+                unit TEXT NOT NULL DEFAULT '',\n+                location TEXT NOT NULL DEFAULT '',\n+                last_value REAL,\n+                last_updated TEXT\n+            );\n+            CREATE TABLE IF NOT EXISTS readings (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n+                value REAL NOT NULL,\n+                recorded_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS readings_sensor_id ON readings(sensor_id, id DESC);\n+            CREATE INDEX IF NOT EXISTS sessions_user_id ON sessions(user_id);\n+        \"\"\")\n+\n+    @application.before_request\n+    def database_config():\n+        g.database_path = application.config[\"DATABASE\"]\n+\n+    @application.teardown_appcontext\n+    def close_db(error=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @application.errorhandler(ApiError)\n+    def api_error(error):\n+        return {\"error\": error.message}, error.status\n+\n+    @application.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @application.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @application.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @application.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        username = text_field(body, \"username\", 64)\n+        password = text_field(body, \"password\", 256, strip=False)\n+        password_hash = generate_password_hash(password)\n+        db = get_db()\n+        try:\n+            with db:\n+                db.execute(\"INSERT INTO users (username, password_hash) VALUES (?, ?)\", (username, password_hash))\n+        except sqlite3.IntegrityError:\n+            raise ApiError(\"That username is already taken.\", 409) from None\n+        return {\"username\": username}, 201\n+\n+    @application.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        username = text_field(body, \"username\", 64)\n+        password = text_field(body, \"password\", 256, strip=False)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            raise ApiError(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        expires = (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(timespec=\"microseconds\")\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (utc_now(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], expires),\n+            )\n+        return {\"token\": token}\n+\n+    @application.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @application.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @application.get(\"/api/sensors\")\n+    def sensors():\n+        rows = get_db().execute(SENSOR_QUERY + \" ORDER BY sensors.name COLLATE NOCASE, sensors.id\").fetchall()\n+        return {\"items\": [dict(row) for row in rows]}\n+\n+    @application.post(\"/api/sensors\")\n+    @authenticated\n+    def add_sensor():\n+        body = json_body()\n+        name = text_field(body, \"name\", 120)\n+        unit = text_field(body, \"unit\", 32, required=False)\n+        location = text_field(body, \"location\", 160, required=False)\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO sensors (owner_id, name, unit, location) VALUES (?, ?, ?, ?)\",\n+                (g.user[\"id\"], name, unit, location),\n+            )\n+        return find_sensor(cursor.lastrowid), 201\n+\n+    @application.get(\"/api/sensors/<int:sensor_id>\")\n+    def sensor(sensor_id):\n+        return find_sensor(sensor_id)\n+\n+    @application.delete(\"/api/sensors/<int:sensor_id>\")\n+    @authenticated\n+    def delete_sensor(sensor_id):\n+        find_sensor(sensor_id, owned=True)\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n+        return \"\", 204\n+\n+    @application.get(\"/api/sensors/<int:sensor_id>/readings\")\n+    def readings(sensor_id):\n+        find_sensor(sensor_id)\n+        try:\n+            limit = int(request.args.get(\"limit\", \"100\"))\n+        except ValueError:\n+            raise ApiError(\"limit must be an integer between 1 and 1000.\", 400) from None\n+        if not 1 <= limit <= 1000:\n+            raise ApiError(\"limit must be an integer between 1 and 1000.\", 400)\n+        db = get_db()\n+        with db:\n+            rows = db.execute(\n+                \"SELECT * FROM readings WHERE sensor_id = ? ORDER BY id DESC LIMIT ?\", (sensor_id, limit)\n+            ).fetchall()\n+            total = db.execute(\"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)).fetchone()[0]\n+        return {\"items\": [dict(row) for row in rows], \"total\": total}\n+\n+    @application.post(\"/api/sensors/<int:sensor_id>/readings\")\n+    @authenticated\n+    def add_reading(sensor_id):\n+        find_sensor(sensor_id, owned=True)\n+        value = json_body().get(\"value\")\n+        try:\n+            valid = type(value) in (int, float) and math.isfinite(value)\n+        except OverflowError:\n+            valid = False\n+        if not valid:\n+            raise ApiError(\"value must be a finite number.\", 400)\n+        db = get_db()\n+        with db:\n+            db.execute(\"BEGIN IMMEDIATE\")\n+            find_sensor(sensor_id, owned=True)\n+            recorded_at = utc_now()\n+            cursor = db.execute(\n+                \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n+                (sensor_id, value, recorded_at),\n+            )\n+            db.execute(\n+                \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n+                (value, recorded_at, sensor_id),\n+            )\n+        return {\"id\": cursor.lastrowid, \"sensor_id\": sensor_id, \"value\": value, \"recorded_at\": recorded_at}, 201\n+\n+    @application.get(\"/\")\n+    @application.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            raise ApiError(\"API endpoint not found.\", 404)\n+        candidate = (DIST / path).resolve()\n+        if candidate.is_relative_to(DIST.resolve()) and candidate.is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return application\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n","additions":302,"deletions":0},{"filePath":"/workspace/backend/test_app.py","relativePath":"backend/test_app.py","type":"add","patch":"Index: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,108 @@\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app\n+\n+\n+class ApiTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.config = {\"TESTING\": True, \"DATABASE\": str(Path(self.directory.name) / \"test.sqlite3\")}\n+        self.app = create_app(self.config)\n+        self.client = self.app.test_client()\n+        self.alice = self.account(\"alice\")\n+        self.bob = self.account(\"bob\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        result = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(result.status_code, 201)\n+        result = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(result.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + result.json[\"token\"]}\n+\n+    def sensor(self, name=\"Temperature\"):\n+        response = self.client.post(\n+            \"/api/sensors\", json={\"name\": name, \"unit\": \"°C\", \"location\": \"Greenhouse\"}, headers=self.alice\n+        )\n+        self.assertEqual(response.status_code, 201)\n+        return response.json\n+\n+    def test_health_and_json_errors(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/unknown\").status_code, 404)\n+        self.assertIn(\"error\", self.client.get(\"/api/unknown\").json)\n+        self.assertEqual(self.client.patch(\"/api/sensors\").status_code, 405)\n+\n+    def test_authentication(self):\n+        self.assertEqual(self.client.post(\"/api/sensors\", json={\"name\": \"A\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/sensors\", headers={\"Authorization\": \"Bearer bad\"}).status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.alice).json, {\"username\": \"alice\"})\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"}).status_code, 409)\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.alice).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.alice).status_code, 401)\n+\n+    def test_new_sensor_and_sorting(self):\n+        sensor = self.sensor(\"Zulu\")\n+        self.assertEqual(set(sensor), {\"id\", \"name\", \"unit\", \"location\", \"last_value\", \"last_updated\", \"owner\"})\n+        self.assertIsNone(sensor[\"last_value\"])\n+        self.assertIsNone(sensor[\"last_updated\"])\n+        self.assertEqual(sensor[\"owner\"], \"alice\")\n+        self.sensor(\"Alpha\")\n+        self.assertEqual([s[\"name\"] for s in self.client.get(\"/api/sensors\").json[\"items\"]], [\"Alpha\", \"Zulu\"])\n+        self.assertEqual(self.client.get(f\"/api/sensors/{sensor['id']}\").json, sensor)\n+\n+    def test_ownership_and_cascade(self):\n+        sensor = self.sensor()\n+        url = f\"/api/sensors/{sensor['id']}\"\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}, headers=self.bob).status_code, 403)\n+        self.assertEqual(self.client.delete(url, headers=self.bob).status_code, 403)\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}).status_code, 401)\n+        self.assertEqual(self.client.post(url + \"/readings\", json={\"value\": 5}, headers=self.alice).status_code, 201)\n+        self.assertEqual(self.client.delete(url, headers=self.alice).status_code, 204)\n+        self.assertEqual(self.client.get(url).status_code, 404)\n+        self.assertEqual(self.client.get(url + \"/readings\").status_code, 404)\n+        with self.app.app_context():\n+            import sqlite3\n+            with sqlite3.connect(self.config[\"DATABASE\"]) as db:\n+                self.assertEqual(db.execute(\"SELECT COUNT(*) FROM readings\").fetchone()[0], 0)\n+\n+    def test_readings_and_limit(self):\n+        sensor = self.sensor()\n+        url = f\"/api/sensors/{sensor['id']}\"\n+        self.assertEqual(self.client.get(url + \"/readings\").json, {\"items\": [], \"total\": 0})\n+        for value in [0, -2.5, 21.7]:\n+            result = self.client.post(url + \"/readings\", json={\"value\": value, \"recorded_at\": \"fake\"}, headers=self.alice)\n+            self.assertEqual(result.status_code, 201)\n+            self.assertNotEqual(result.json[\"recorded_at\"], \"fake\")\n+        data = self.client.get(url + \"/readings?limit=2\").json\n+        self.assertEqual(data[\"total\"], 3)\n+        self.assertEqual([r[\"value\"] for r in data[\"items\"]], [21.7, -2.5])\n+        latest = self.client.get(url).json\n+        self.assertEqual(latest[\"last_value\"], 21.7)\n+        self.assertEqual(latest[\"last_updated\"], data[\"items\"][0][\"recorded_at\"])\n+        for limit in [\"0\", \"-1\", \"x\", \"1001\", \"1.5\"]:\n+            self.assertEqual(self.client.get(url + \"/readings?limit=\" + limit).status_code, 400)\n+\n+    def test_validation(self):\n+        for body in [[], None, {\"name\": \"\"}, {\"name\": 3}, {\"name\": \"a\", \"unit\": []}]:\n+            self.assertEqual(self.client.post(\"/api/sensors\", json=body, headers=self.alice).status_code, 400)\n+        sensor = self.sensor()\n+        for value in [None, True, \"23\", float(\"inf\"), float(\"nan\"), [], {}]:\n+            response = self.client.post(f\"/api/sensors/{sensor['id']}/readings\", json={\"value\": value}, headers=self.alice)\n+            self.assertEqual(response.status_code, 400)\n+\n+    def test_persistence_across_restart(self):\n+        sensor = self.sensor()\n+        self.client.post(f\"/api/sensors/{sensor['id']}/readings\", json={\"value\": 20}, headers=self.alice)\n+        restarted = create_app(self.config).test_client()\n+        self.assertEqual(restarted.get(f\"/api/sensors/{sensor['id']}\").json[\"last_value\"], 20)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.alice).status_code, 200)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":108,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,6 @@\n+data/\n+__pycache__/\n+*.pyc\n+frontend/node_modules/\n+frontend/dist/\n+.venv/\n","additions":6,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/test_app.py\nA .gitignore","time":{"start":1794313155928,"end":1794313155951}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c564e129001XES1ODptJvA4Kd","sessionID":"ses_e3a9bc48effe0IpMJNFD0aHrVw","messageID":"msg_1c564d92a0015iLScGITD7onZ3"}}
