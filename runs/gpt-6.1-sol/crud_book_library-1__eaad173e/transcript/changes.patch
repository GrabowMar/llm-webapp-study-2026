+@theme {
+  --font-sans: "DM Sans", sans-serif;
+  --font-serif: "Newsreader", Georgia, serif;
+  --color-paper: #f8f8f3;
+  --color-ink: #283e32;
+  --color-forest: #315c48;
+  --color-muted: #777c72;
+  --color-line: #e4e6dc;
+}
+
+@layer base {
+  body {
+    @apply m-0 bg-paper font-sans text-ink antialiased;
+  }
+  button, a, input, select, textarea {
+    @apply outline-none focus-visible:ring-2 focus-visible:ring-forest/60 focus-visible:ring-offset-4;
+  }
+  button, select {
+    @apply cursor-pointer;
+  }
+  button:disabled {
+    @apply cursor-not-allowed;
+  }
+  ::selection {
+    @apply bg-forest/20;
+  }
+}
