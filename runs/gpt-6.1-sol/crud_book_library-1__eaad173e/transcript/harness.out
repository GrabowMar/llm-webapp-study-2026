Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"@tailwindcss/vite\": \"^4.3.5\",\n   \"lucide-react\": \"^1.71.0\",\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,16 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"noEmit\": true,\n+    \"skipLibCheck\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,18 @@\n+import js from \"@eslint/js\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }],\n+    },\n+  },\n+);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f8f8f3\" />\n+    <meta name=\"description\" content=\"Folio is a shared bookshelf for curious readers. Discover good books, share honest reviews, and find your next great read.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Folio — Good books. Better together.</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#315c48\"/><path d=\"M10 11c4-1 7 0 10 2 3-2 6-3 10-2v19c-4-1-7 0-10 2-3-2-6-3-10-2Z\" fill=\"none\" stroke=\"#f7f6eb\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M20 13v19\" stroke=\"#f7f6eb\" stroke-width=\"2\"/></svg>\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,29 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"DM Sans\", sans-serif;\n+  --font-serif: \"Newsreader\", Georgia, serif;\n+  --color-paper: #f8f8f3;\n+  --color-ink: #283e32;\n+  --color-forest: #315c48;\n+  --color-muted: #777c72;\n+  --color-line: #e4e6dc;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input, select, textarea {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-forest/60 focus-visible:ring-offset-4;\n+  }\n+  button, select {\n+    @apply cursor-pointer;\n+  }\n+  button:disabled {\n+    @apply cursor-not-allowed;\n+  }\n+  ::selection {\n+    @apply bg-forest/20;\n+  }\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,13 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"@fontsource/dm-sans/400.css\";\n+import \"@fontsource/dm-sans/500.css\";\n+import \"@fontsource/dm-sans/600.css\";\n+import \"@fontsource/dm-sans/700.css\";\n+import \"@fontsource/newsreader/400.css\";\n+import \"@fontsource/newsreader/500.css\";\n+import \"@fontsource/newsreader/600.css\";\n+import \"@fontsource/newsreader/400-italic.css\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\n","files":[{"filePath":"/workspace/backend/requirements.lock","relativePath":"backend/requirements.lock","type":"delete","patch":"Index: /workspace/backend/requirements.lock\n===================================================================\n--- /workspace/backend/requirements.lock\n+++ /workspace/backend/requirements.lock\n@@ -1,184 +0,0 @@\