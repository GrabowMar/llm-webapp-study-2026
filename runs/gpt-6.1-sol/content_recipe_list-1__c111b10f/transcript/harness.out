{"type":"tool_use","timestamp":1794308113953,"sessionID":"ses_e3af4328bffe533fBpAJlyD2Ek","part":{"type":"tool","tool":"apply_patch","callID":"call_68AteajaMKTB40JIxKks14TS","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Delete File: /workspace/frontend/src/App.tsx\n*** Add File: /workspace/frontend/src/App.tsx\n+import { useCallback, useEffect, useState } from \"react\";\n+import { ArrowRight, Check, ChefHat, Heart, LogOut, Plus, Sprout, X } from \"lucide-react\";\n+import { api, ApiError } from \"./api\";\n+import AuthForm from \"./AuthForm\";\n+import RecipeBook from \"./RecipeBook\";\n+import RecipeDetail from \"./RecipeDetail\";\n+import RecipeForm from \"./RecipeForm\";\n+import { Modal, primaryButton } from \"./ui\";\n+\n+function storedToken() {\n+  try { return localStorage.getItem(\"table-thyme-token\") || \"\"; } catch { return \"\"; }\n+}\n+\n+export default function App() {\n+  const [path, setPath] = useState(window.location.pathname);\n+  const [token, setToken] = useState(storedToken);\n+  const [username, setUsername] = useState(\"\");\n+  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n+  const [pendingPath, setPendingPath] = useState(\"\");\n+  const [about, setAbout] = useState(false);\n+  const [notice, setNotice] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+\n+  const navigate = useCallback((next: string) => {\n+    window.history.pushState({}, \"\", next);\n+    setPath(next);\n+    window.scrollTo({ top: 0, behavior: \"instant\" });\n+  }, []);\n+\n+  const clearSession = useCallback(() => {\n+    setToken(\"\");\n+    setUsername(\"\");\n+    try { localStorage.removeItem(\"table-thyme-token\"); } catch { /* empty */ }\n+  }, []);\n+\n+  const sessionExpired = useCallback(() => {\n+    clearSession();\n+    setAuthMode(\"login\");\n+    setNotice(\"Your session has expired. Sign in to continue.\");\n+  }, [clearSession]);\n+\n+  useEffect(() => {\n+    const listener = () => setPath(window.location.pathname);\n+    window.addEventListener(\"popstate\", listener);\n+    return () => window.removeEventListener(\"popstate\", listener);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<{ username: string }>(\"/auth/me\", { signal: controller.signal }, token)\n+      .then(user => setUsername(user.username))\n+      .catch(error => {\n+        if (error instanceof ApiError && error.status === 401) clearSession();\n+        else if (!(error instanceof DOMException && error.name === \"AbortError\")) setNotice(\"Couldn’t verify your session. Try refreshing the page.\");\n+      });\n+    return () => controller.abort();\n+  }, [token, clearSession]);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 6000);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  function openAuth(mode: \"login\" | \"register\", next = \"\") {\n+    setPendingPath(next);\n+    setAuthMode(mode);\n+  }\n+\n+  function addRecipe() {\n+    if (token) navigate(\"/recipes/new\");\n+    else openAuth(\"login\", \"/recipes/new\");\n+  }\n+\n+  async function signOut() {\n+    try { await api(\"/auth/logout\", { method: \"POST\" }, token); }\n+    catch (error) {\n+      if (!(error instanceof ApiError && error.status === 401)) {\n+        setNotice(\"Couldn’t sign out. Please try again.\");\n+        return;\n+      }\n+    }\n+    clearSession();\n+    setNotice(\"You’re signed out. There’s always a seat for you here.\");\n+  }\n+\n+  const detailMatch = path.match(/^\\/recipes\\/(\\d+)\\/?$/);\n+  const editMatch = path.match(/^\\/recipes\\/(\\d+)\\/edit\\/?$/);\n+  const newRecipe = path === \"/recipes/new\";\n+  const isBook = path === \"/\" || path === \"/recipes\";\n+\n+  return <div className=\"flex min-h-dvh flex-col\">\n+    <header className=\"border-b border-line bg-cream\">\n+      <div className=\"mx-auto flex min-h-24 max-w-7xl flex-wrap items-center justify-between gap-x-5 gap-y-3 px-5 py-5 sm:px-8 lg:px-12\">\n+        <a href=\"/\" onClick={event => { event.preventDefault(); navigate(\"/\"); }} className=\"flex shrink-0 items-center gap-2.5\" aria-label=\"Table and Thyme home\">\n+          <Sprout className=\"text-olive\" size={31} strokeWidth={1.5} /><span className=\"font-serif text-[27px] tracking-[-1px] sm:text-[29px]\">Table <span className=\"italic text-olive\">&</span> Thyme<span className=\"text-terra\">.</span></span>\n+        </a>\n+        <nav aria-label=\"Main navigation\" className=\"ml-8 hidden items-center gap-8 self-stretch text-[13px] md:flex\">\n+          <a href=\"/\" onClick={event => { event.preventDefault(); navigate(\"/\"); }} aria-current={isBook ? \"page\" : undefined} className={`flex items-center border-b-2 px-1 ${isBook ? \"border-olive font-medium\" : \"border-transparent text-muted hover:text-ink\"}`}>The recipe book</a>\n+          <button onClick={() => setAbout(true)} className=\"text-muted transition hover:text-ink\">Our philosophy</button>\n+        </nav>\n+        <div className=\"ml-auto flex items-center gap-3 sm:gap-5\">\n+          {token ? <div className=\"flex items-center gap-2 sm:gap-3\"><span className=\"hidden max-w-32 truncate text-sm sm:block\">Hi, <span className=\"font-medium\">{username || \"cook\"}</span></span><button onClick={signOut} className=\"flex items-center gap-1.5 text-xs text-muted hover:text-ink\" aria-label=\"Sign out\"><LogOut size={15} /><span className=\"hidden sm:inline\">Sign out</span></button></div> : <button onClick={() => openAuth(\"login\")} className=\"px-1 text-sm font-medium transition hover:text-olive\">Sign in</button>}\n+          <button onClick={addRecipe} className={`${primaryButton} !gap-1.5 !px-3.5 !py-2.5 sm:!px-4`}><Plus size={16} /><span className=\"hidden min-[420px]:inline\">Add a recipe</span><span className=\"min-[420px]:hidden\">Add</span></button>\n+        </div>\n+      </div>\n+    </header>\n+\n+    <main className=\"mx-auto w-full max-w-7xl flex-1 px-5 sm:px-8 lg:px-12\">\n+      {isBook ? <RecipeBook revision={revision} onOpen={id => navigate(`/recipes/${id}`)} onShare={() => token ? navigate(\"/recipes/new\") : openAuth(\"register\", \"/recipes/new\")} /> :\n+        detailMatch ? <RecipeDetail key={detailMatch[1]} id={Number(detailMatch[1])} username={username} token={token} onBack={() => navigate(\"/\")} onEdit={() => navigate(`/recipes/${detailMatch[1]}/edit`)} onDeleted={() => { setRevision(value => value + 1); setNotice(\"Recipe deleted.\"); navigate(\"/\"); }} onUnauthorized={sessionExpired} /> :\n+        newRecipe || editMatch ? <RecipeForm key={editMatch?.[1] || \"new\"} id={editMatch ? Number(editMatch[1]) : undefined} token={token} username={username} onSignIn={() => openAuth(\"login\")} onCancel={() => navigate(editMatch ? `/recipes/${editMatch[1]}` : \"/\")} onSaved={recipe => { setRevision(value => value + 1); setNotice(editMatch ? \"Your recipe has been updated.\" : \"Your recipe is at the table. Thanks for sharing!\"); navigate(`/recipes/${recipe.id}`); }} onUnauthorized={sessionExpired} /> :\n+        <div className=\"py-28 text-center\"><h1 className=\"mb-4 font-serif text-4xl\">This page isn’t on the menu.</h1><button onClick={() => navigate(\"/\")} className={primaryButton}>Back to the recipe book <ArrowRight size={16} /></button></div>}\n+    </main>\n+\n+    <footer className=\"mt-16 border-t border-line\">\n+      <div className=\"mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-5 py-7 text-xs text-muted sm:flex-row sm:px-8 lg:px-12\">\n+        <span className=\"flex items-center gap-2\"><Sprout size={16} className=\"text-olive\" /> A recipe book for all of us.</span>\n+        <span className=\"flex items-center gap-1.5\">Made with care. Shared with <Heart size={12} className=\"text-terra\" />.</span>\n+        <button onClick={() => setAbout(true)} className=\"transition hover:text-ink\">A little about Table & Thyme <ArrowRight size={12} className=\"ml-1 inline\" /></button>\n+      </div>\n+    </footer>\n+\n+    {authMode && <AuthForm key={authMode} mode={authMode} onMode={setAuthMode} onClose={() => { setAuthMode(null); setPendingPath(\"\"); }} onLogin={(nextToken, name) => {\n+      try { localStorage.setItem(\"table-thyme-token\", nextToken); } catch { /* empty */ }\n+      setToken(nextToken); setUsername(name); setAuthMode(null); setNotice(`Welcome to the kitchen, ${name}.`);\n+      if (pendingPath) navigate(pendingPath);\n+      setPendingPath(\"\");\n+    }} />}\n+    {about && <Modal title=\"Good food brings us together.\" onClose={() => setAbout(false)} wide>\n+      <div className=\"mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-sage text-olive\"><ChefHat size={32} strokeWidth={1.5} /></div>\n+      <div className=\"space-y-4 text-sm leading-7 text-muted\"><p>Table & Thyme is a little corner of the internet for the recipes you make again and again. The easy weekday dinner. The pancakes everyone asks for. The dish that tastes like home.</p><p>No perfect kitchens required. Just simple ingredients, a little curiosity, and something worth sharing.</p><p>Everyone is welcome to browse. Make an account to add your own recipes, and edit them whenever inspiration strikes.</p></div>\n+      <button className={`${primaryButton} mt-7`} onClick={() => { setAbout(false); addRecipe(); }}>Share a little of your kitchen <ArrowRight size={16} /></button>\n+    </Modal>}\n+    {notice && <div role=\"status\" className=\"fixed bottom-5 left-1/2 z-50 flex w-[calc(100%-2.5rem)] max-w-lg -translate-x-1/2 items-center gap-3 rounded-xl border border-line bg-white p-4 text-sm shadow-xl\"><Check size={18} className=\"shrink-0 text-olive\" /><span className=\"flex-1\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss notification\" className=\"p-1 text-muted\"><X size={16} /></button></div>}\n+  </div>;\n+}\n*** Add File: /workspace/frontend/src/RecipeBook.tsx\n+import { useEffect, useRef, useState } from \"react\";\n+import { ArrowDown, ArrowRight, BookOpen, ChefHat, ChevronDown, ChevronLeft, ChevronRight, Clock3, Coffee, Heart, Leaf, Plus, Search, SlidersHorizontal, Sprout, Utensils, X } from \"lucide-react\";\n+import { api, type RecipePage, type RecipeSummary } from \"./api\";\n+import FoodArt, { dishFor } from \"./FoodArt\";\n+import { ErrorBox, Loading, primaryButton, secondaryButton } from \"./ui\";\n+\n+const categoryStyle = (category: string) => ({ Breakfast: \"bg-[#f5ead6] text-[#8c7042]\", Lunch: \"bg-[#e9efdc] text-[#62784b]\", Dinner: \"bg-[#f2e4da] text-[#9e6245]\", Dessert: \"bg-[#f1e3e7] text-[#9c6276]\" }[category] || \"bg-sage text-olive\");\n+\n+function RecipeCard({ recipe, onOpen }: { recipe: RecipeSummary; onOpen: () => void }) {\n+  return <article className=\"group overflow-hidden rounded-xl border border-line bg-white transition duration-300 hover:-translate-y-1 hover:border-olive/35 hover:shadow-lg hover:shadow-ink/5\">\n+    <a href={`/recipes/${recipe.id}`} onClick={event => { event.preventDefault(); onOpen(); }} className=\"block h-full\">\n+      <div className=\"relative aspect-[1.65] overflow-hidden bg-sage\">\n+        <FoodArt dish={dishFor(recipe.title, recipe.category)} className=\"transition duration-700 group-hover:scale-105\" />\n+        <span className={`absolute left-4 top-4 rounded-md px-2.5 py-1 text-[10px] font-semibold tracking-wide ${categoryStyle(recipe.category)}`}>{recipe.category}</span>\n+      </div>\n+      <div className=\"p-5\">\n+        <div className=\"mb-3 flex items-center gap-1.5 text-[11px] text-muted\"><Clock3 size={13} strokeWidth={1.6} />{recipe.prep_minutes} min<span className=\"mx-1.5 text-line\">|</span><span>Made for real life</span></div>\n+        <h3 className=\"min-h-7 font-serif text-[23px] leading-7 tracking-[-.45px] transition group-hover:text-olive\">{recipe.title}</h3>\n+        <div className=\"mt-5 flex items-center justify-between border-t border-line pt-4\">\n+          <div className=\"flex items-center gap-2\"><span className=\"flex h-6 w-6 items-center justify-center rounded-full bg-sage font-serif text-xs text-olive\">{recipe.author.charAt(0).toUpperCase()}</span><span className=\"text-[11px] text-muted\">From <span className=\"font-medium text-ink/80\">{recipe.author}</span>’s kitchen</span></div>\n+          <ArrowRight size={16} strokeWidth={1.5} className=\"text-olive transition group-hover:translate-x-1\" />\n+        </div>\n+      </div>\n+    </a>\n+  </article>;\n+}\n+\n+export default function RecipeBook({ revision, onOpen, onShare }: { revision: number; onOpen: (id: number) => void; onShare: () => void }) {\n+  const [category, setCategory] = useState(\"\");\n+  const [search, setSearch] = useState(\"\");\n+  const [query, setQuery] = useState(\"\");\n+  const [page, setPage] = useState(1);\n+  const [pageSize, setPageSize] = useState(6);\n+  const [categories, setCategories] = useState<string[]>([]);\n+  const [result, setResult] = useState<RecipePage | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  const book = useRef<HTMLElement>(null);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    api<{ items: string[] }>(\"/categories\", { signal: controller.signal }).then(data => setCategories(data.items)).catch(() => {});\n+    return () => controller.abort();\n+  }, [revision, retry]);\n+\n+  useEffect(() => {\n+    const timeout = window.setTimeout(() => { setQuery(search); setPage(1); }, 300);\n+    return () => window.clearTimeout(timeout);\n+  }, [search]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    const params = new URLSearchParams({ category, q: query, page: String(page), page_size: String(pageSize) });\n+    api<RecipePage>(`/recipes?${params}`, { signal: controller.signal })\n+      .then(data => {\n+        if (data.total > 0 && page > Math.ceil(data.total / pageSize)) setPage(Math.ceil(data.total / pageSize));\n+        else setResult(data);\n+      })\n+      .catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setError(caught.message); })\n+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    return () => controller.abort();\n+  }, [category, query, page, pageSize, revision, retry]);\n+\n+  function selectCategory(next: string) { setCategory(next); setPage(1); }\n+  function browse() { book.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" }); }\n+  const tabs = [...[\"Breakfast\", \"Lunch\", \"Dinner\", \"Dessert\"].filter(item => categories.includes(item)), ...categories.filter(item => ![\"Breakfast\", \"Lunch\", \"Dinner\", \"Dessert\"].includes(item))];\n+  const pages = Math.max(1, Math.ceil((result?.total || 0) / pageSize));\n+\n+  return <>\n+    <section className=\"relative mt-9 overflow-hidden rounded-2xl bg-[#edf0e7] md:mt-10\" aria-labelledby=\"hero-heading\">\n+      <div className=\"relative z-10 px-7 pb-8 pt-10 sm:px-10 lg:px-12 lg:py-12 md:w-[53%]\">\n+        <div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[2px] text-olive\"><span className=\"h-1.5 w-1.5 rounded-full bg-olive\" /> FROM OUR KITCHENS TO YOURS</div>\n+        <h1 id=\"hero-heading\" className=\"font-serif text-[43px] leading-[1.13] tracking-[-1.6px] sm:text-[52px] lg:text-[58px]\">A little inspiration.<br />A lot of <span className=\"italic text-olive\">good food.</span></h1>\n+        <p className=\"mt-5 max-w-sm text-[13px] leading-[1.9] text-muted\">Everyday recipes. Something for every craving.<br className=\"hidden lg:block\" /> A collection made by home cooks, for home cooks.</p>\n+        <div className=\"mt-7 flex flex-wrap items-center gap-5\">\n+          <button onClick={browse} className={`${primaryButton} !px-5 !text-xs`}>Explore the recipes <ArrowDown size={15} /></button>\n+          <button onClick={onShare} className=\"flex items-center gap-1.5 text-xs font-medium text-olive underline decoration-olive/30 underline-offset-4 transition hover:text-ink\">Share your favorite <ArrowRight size={14} /></button>\n+        </div>\n+      </div>\n+      <div className=\"relative h-60 md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[51%]\">\n+        <FoodArt hero />\n+        <div className=\"absolute right-6 top-5 flex h-[83px] w-[83px] rotate-12 flex-col items-center justify-center rounded-full border border-olive/35 bg-[#edf0e7]/80 text-olive backdrop-blur-sm lg:right-8 lg:top-7\"><Sprout size={21} strokeWidth={1.3} /><span className=\"mt-1 text-[8px] font-medium tracking-[1.1px]\">FRESH IDEAS</span><span className=\"mt-0.5 font-serif text-[10px] italic\">every day</span></div>\n+        <div className=\"absolute bottom-6 left-7 flex -rotate-3 items-center gap-3 rounded-lg border border-white/70 bg-cream/95 px-4 py-3 shadow-sm md:bottom-8 md:left-9\"><Heart size={18} strokeWidth={1.5} className=\"text-terra\" /><span className=\"font-serif text-sm italic\">Good food. Good company.</span></div>\n+      </div>\n+    </section>\n+\n+    <div className=\"mt-5 grid grid-cols-1 gap-3 border-b border-line pb-6 text-[11px] text-muted min-[540px]:grid-cols-3 min-[540px]:gap-1\">\n+      <span className=\"flex items-center justify-center gap-2\"><Leaf size={15} strokeWidth={1.5} className=\"text-olive\" /> Simple ingredients, lovely results</span>\n+      <span className=\"flex items-center justify-center gap-2\"><ChefHat size={16} strokeWidth={1.5} className=\"text-olive\" /> From real home cooks</span>\n+      <span className=\"flex items-center justify-center gap-2\"><Heart size={14} strokeWidth={1.5} className=\"text-olive\" /> A little something for everyone</span>\n+    </div>\n+\n+    <section ref={book} className=\"scroll-mt-6 pt-9\" aria-labelledby=\"recipes-heading\">\n+      <div className=\"mb-6 flex flex-wrap items-end justify-between gap-4\">\n+        <div><div className=\"mb-2 text-[9px] font-semibold tracking-[1.8px] text-terra\">THE RECIPE BOOK</div><h2 id=\"recipes-heading\" className=\"font-serif text-[32px] leading-tight tracking-[-.7px] sm:text-[35px]\">Find your next favorite<span className=\"text-terra\">.</span></h2><p className=\"mt-2 text-xs text-muted\">A few good ingredients. A recipe worth keeping.</p></div>\n+        <span className=\"mb-1 flex items-center gap-1.5 text-[11px] text-muted\"><SlidersHorizontal size={13} strokeWidth={1.5} /> Newest additions first</span>\n+      </div>\n+\n+      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-white px-4 py-3\">\n+        <div className=\"flex max-w-full items-center gap-1 overflow-x-auto\" role=\"group\" aria-label=\"Filter by category\">\n+          <button onClick={() => selectCategory(\"\")} aria-pressed={!category} className={`flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-xs transition ${!category ? \"bg-sage font-medium text-olive\" : \"text-muted hover:bg-cream\"}`}><BookOpen size={14} />All recipes</button>\n+          {tabs.map(item => <button key={item} onClick={() => selectCategory(item)} aria-pressed={category === item} className={`flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-xs transition ${category === item ? \"bg-sage font-medium text-olive\" : \"text-muted hover:bg-cream\"}`}>{item === \"Breakfast\" ? <Coffee size={13} /> : item === \"Dinner\" ? <Utensils size={13} /> : item === \"Lunch\" ? <Leaf size={13} /> : item === \"Dessert\" ? <Heart size={13} /> : null}{item}</button>)}\n+        </div>\n+        <div className=\"flex w-full items-center gap-2 border-t border-line pt-3 lg:w-auto lg:border-0 lg:pt-0\">\n+          <div className=\"relative min-w-0 flex-1 lg:w-48\"><Search size={14} className=\"absolute left-3 top-1/2 -translate-y-1/2 text-muted\" /><input aria-label=\"Search recipe titles\" type=\"search\" value={search} onChange={event => setSearch(event.target.value)} placeholder=\"Find something delicious…\" className=\"w-full rounded-lg border border-line bg-cream py-2.5 pl-9 pr-3 text-[11px] placeholder:text-muted focus:border-olive focus:outline-none\" /></div>\n+          <div className=\"relative\"><select aria-label=\"Recipe category\" value={category} onChange={event => selectCategory(event.target.value)} className=\"max-w-36 appearance-none rounded-lg border border-line bg-cream py-2.5 pl-3 pr-7 text-[11px] text-muted focus:border-olive\"><option value=\"\">All categories</option>{categories.map(item => <option key={item}>{item}</option>)}</select><ChevronDown size={12} className=\"pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted\" /></div>\n+        </div>\n+      </div>\n+\n+      <div className=\"mb-5 flex items-center justify-between text-[11px] text-muted\" aria-live=\"polite\"><span>{loading ? \"Finding your next favorite…\" : `${result?.total || 0} ${(result?.total || 0) === 1 ? \"recipe\" : \"recipes\"}${category ? ` in ${category.toLowerCase()}` : \" to make your own\"}${query ? ` matching “${query}”` : \"\"}`}</span>{(category || search) && <button onClick={() => { setSearch(\"\"); setQuery(\"\"); selectCategory(\"\"); }} className=\"flex items-center gap-1 text-olive hover:underline\">Clear filters <X size={12} /></button>}</div>\n+\n+      {error ? <div className=\"space-y-4 py-6\"><ErrorBox message={error} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : loading ? <Loading /> : result?.items.length ? <div className=\"grid gap-6 min-[600px]:grid-cols-2 lg:grid-cols-3\">\n+        {result.items.map(recipe => <RecipeCard key={recipe.id} recipe={recipe} onOpen={() => onOpen(recipe.id)} />)}\n+        {result.items.length < pageSize && <div className=\"flex min-h-80 flex-col items-center justify-center rounded-xl border border-dashed border-olive/30 bg-sage/60 px-6 py-9 text-center\">\n+          <div className=\"relative mb-5 flex h-[72px] w-[72px] items-center justify-center rounded-full bg-[#e1e7d6]\"><BookOpen size={31} strokeWidth={1.2} className=\"-rotate-12 text-olive\" /><span className=\"absolute -right-1 bottom-0 flex h-6 w-6 items-center justify-center rounded-full border-2 border-sage bg-cream text-terra\"><Plus size={14} /></span></div>\n+          <h3 className=\"font-serif text-[25px] tracking-tight\">Your recipe belongs here.</h3><p className=\"mt-3 max-w-56 text-xs leading-6 text-muted\">That family favorite. Your latest discovery.<br />Good things are made to be shared.</p><button onClick={onShare} className=\"mt-5 flex items-center gap-2 rounded-lg border border-olive/30 bg-transparent px-4 py-2.5 text-xs font-medium text-olive transition hover:bg-olive hover:text-white\">Share a recipe <ArrowRight size={14} /></button>\n+        </div>}\n+      </div> : <div className=\"flex min-h-64 flex-col items-center justify-center rounded-xl border border-dashed border-line text-center\"><Search size={28} className=\"mb-4 text-olive\" strokeWidth={1.3} /><h3 className=\"font-serif text-2xl\">Nothing on the menu just yet.</h3><p className=\"mt-2 text-sm text-muted\">Try another title or category, or share something of your own.</p><button onClick={() => { setSearch(\"\"); setQuery(\"\"); selectCategory(\"\"); }} className={`${secondaryButton} mt-5`}>See all recipes</button></div>}\n+\n+      {!loading && !error && result && <div className=\"mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5 text-[11px] text-muted\">\n+        <div className=\"flex items-center gap-4\"><span>{result.total ? `${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, result.total)} of ${result.total} recipes` : \"0 recipes\"}</span><label className=\"hidden items-center gap-1.5 sm:flex\">Per page <select value={pageSize} onChange={event => { setPageSize(Number(event.target.value)); setPage(1); }} className=\"rounded-md border border-line bg-white px-1.5 py-1 text-ink\" aria-label=\"Recipes per page\"><option value={6}>6</option><option value={12}>12</option><option value={24}>24</option></select></label></div>\n+        <nav aria-label=\"Recipe pages\" className=\"flex items-center gap-2\"><button disabled={page === 1} onClick={() => { setPage(value => value - 1); browse(); }} className=\"flex h-8 items-center gap-1 rounded-md border border-line bg-white px-2.5 transition hover:border-olive disabled:opacity-40\"><ChevronLeft size={13} /> Previous</button><span className=\"px-2\">{page} <span className=\"px-1 text-muted/50\">/</span> {pages}</span><button disabled={page >= pages} onClick={() => { setPage(value => value + 1); browse(); }} className=\"flex h-8 items-center gap-1 rounded-md border border-line bg-white px-2.5 transition hover:border-olive disabled:opacity-40\">Next <ChevronRight size={13} /></button></nav>\n+      </div>}\n+    </section>\n+\n+    <aside className=\"mt-10 flex flex-col items-center gap-3 rounded-xl bg-[#f0ece3] px-6 py-5 text-center sm:flex-row sm:justify-between sm:text-left\"><div className=\"flex items-center gap-3\"><Sprout size={24} strokeWidth={1.3} className=\"shrink-0 text-olive\" /><div><p className=\"font-serif text-lg\">The best recipes have a story.</p><p className=\"mt-0.5 text-[11px] text-muted\">We’d love to hear yours. Make yourself at home.</p></div></div><button onClick={onShare} className=\"flex shrink-0 items-center gap-2 text-xs font-medium text-olive transition hover:text-ink\">Join our kitchen <ArrowRight size={14} /></button></aside>\n+  </>;\n+}\n*** Add File: /workspace/frontend/src/RecipeDetail.tsx\n+import { useEffect, useState } from \"react\";\n+import { ArrowLeft, CalendarDays, ChefHat, Clock3, Pencil, Sprout, Trash2, Users } from \"lucide-react\";\n+import { api, ApiError, type Recipe } from \"./api\";\n+import FoodArt, { dishFor } from \"./FoodArt\";\n+import { ErrorBox, Loading, Modal, secondaryButton } from \"./ui\";\n+\n+export default function RecipeDetail({ id, username, token, onBack, onEdit, onDeleted, onUnauthorized }: { id: number; username: string; token: string; onBack: () => void; onEdit: () => void; onDeleted: () => void; onUnauthorized: () => void }) {\n+  const [recipe, setRecipe] = useState<Recipe | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  const [confirm, setConfirm] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+  const [deleting, setDeleting] = useState(false);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setError(\"\");\n+    api<Recipe>(`/recipes/${id}`, { signal: controller.signal }).then(setRecipe).catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setError(caught.message); });\n+    return () => controller.abort();\n+  }, [id, retry]);\n+\n+  async function remove() {\n+    setDeleting(true);\n+    setDeleteError(\"\");\n+    try { await api(`/recipes/${id}`, { method: \"DELETE\" }, token); setConfirm(false); onDeleted(); }\n+    catch (caught) {\n+      if (caught instanceof ApiError && caught.status === 401) { setConfirm(false); onUnauthorized(); }\n+      else setDeleteError(caught instanceof Error ? caught.message : \"Couldn’t delete the recipe.\");\n+    } finally { setDeleting(false); }\n+  }\n+\n+  return <div className=\"py-9 sm:py-11\">\n+    <button onClick={onBack} className=\"mb-7 flex items-center gap-2 text-xs text-muted transition hover:text-olive\"><ArrowLeft size={15} /> Back to the recipe book</button>\n+    {error ? <div className=\"space-y-4\"><ErrorBox message={error} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : !recipe ? <Loading /> : <>\n+      <div className=\"grid overflow-hidden rounded-2xl border border-line bg-white md:grid-cols-2\">\n+        <div className=\"aspect-[1.4] md:aspect-auto md:min-h-96\"><FoodArt dish={dishFor(recipe.title, recipe.category)} /></div>\n+        <div className=\"flex flex-col justify-center p-7 sm:p-10\"><span className=\"mb-4 w-fit rounded-md bg-sage px-3 py-1.5 text-[10px] font-semibold uppercase tracking-widest text-olive\">{recipe.category}</span><h1 className=\"font-serif text-4xl leading-tight tracking-tight lg:text-[45px]\">{recipe.title}</h1><div className=\"mt-6 flex items-center gap-2.5\"><span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-sage font-serif text-olive\">{recipe.author.charAt(0).toUpperCase()}</span><span className=\"text-xs text-muted\">From <span className=\"font-medium text-ink\">{recipe.author}</span>’s kitchen</span></div><div className=\"mt-7 flex flex-wrap gap-5 border-t border-line pt-5 text-xs text-muted\"><span className=\"flex items-center gap-2\"><Clock3 size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{recipe.prep_minutes} min</b><span className=\"mt-1 block text-[10px]\">Prep time</span></span></span><span className=\"flex items-center gap-2\"><Users size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{recipe.servings} {recipe.servings === 1 ? \"serving\" : \"servings\"}</b><span className=\"mt-1 block text-[10px]\">At the table</span></span></span><span className=\"flex items-center gap-2\"><CalendarDays size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{new Date(recipe.created_at).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" })}</b><span className=\"mt-1 block text-[10px]\">Shared on</span></span></span></div>\n+          {username === recipe.author && <div className=\"mt-7 flex gap-3\"><button onClick={onEdit} className={secondaryButton}><Pencil size={14} /> Edit recipe</button><button onClick={() => { setDeleteError(\"\"); setConfirm(true); }} className=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs text-terra transition hover:bg-red-50\"><Trash2 size={14} /> Delete</button></div>}\n+        </div>\n+      </div>\n+      <div className=\"mt-10 grid gap-10 md:grid-cols-[1fr_1.8fr] lg:gap-16\">\n+        <section><div className=\"mb-5 flex items-center gap-2.5\"><Sprout size={21} strokeWidth={1.4} className=\"text-olive\" /><h2 className=\"font-serif text-[28px]\">A few good ingredients</h2></div><p className=\"mb-5 text-xs text-muted\">For {recipe.servings} {recipe.servings === 1 ? \"serving\" : \"servings\"}. A little preparation goes a long way.</p><ul className=\"divide-y divide-line rounded-xl border border-line bg-white px-5\">{recipe.ingredients.map((ingredient, index) => <li key={index} className=\"flex items-start gap-3 py-4 text-sm leading-6\"><span className=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-olive/65\" />{ingredient}</li>)}</ul></section>\n+        <section><div className=\"mb-5 flex items-center gap-2.5\"><ChefHat size={23} strokeWidth={1.4} className=\"text-olive\" /><h2 className=\"font-serif text-[28px]\">Let’s make something good.</h2></div><div className=\"whitespace-pre-wrap break-words text-sm leading-[2] text-ink/80\">{recipe.instructions}</div><div className=\"mt-8 border-t border-line pt-5 font-serif text-lg italic text-olive\">Made with care. Best enjoyed together.</div></section>\n+      </div>\n+    </>}\n+    {confirm && <Modal title=\"Take it off the menu?\" onClose={() => { if (!deleting) setConfirm(false); }}><p className=\"text-sm leading-7 text-muted\">Are you sure you want to delete <span className=\"font-medium text-ink\">{recipe?.title}</span>? This can’t be undone.</p>{deleteError && <div className=\"mt-4\"><ErrorBox message={deleteError} /></div>}<div className=\"mt-7 flex justify-end gap-3\"><button disabled={deleting} onClick={() => setConfirm(false)} className={secondaryButton}>Keep recipe</button><button disabled={deleting} onClick={remove} className=\"flex items-center gap-2 rounded-lg bg-terra px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-800 disabled:opacity-50\"><Trash2 size={15} />{deleting ? \"Deleting…\" : \"Delete recipe\"}</button></div></Modal>}\n+  </div>;\n+}\n*** Add File: /workspace/frontend/src/RecipeForm.tsx\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { ArrowLeft, ArrowRight, ChefHat, GripVertical, Plus, Sprout, Trash2 } from \"lucide-react\";\n+import { api, ApiError, type Recipe, type RecipeFields } from \"./api\";\n+import { ErrorBox, Field, inputClass, Loading, primaryButton, secondaryButton } from \"./ui\";\n+\n+const blank: RecipeFields = { title: \"\", category: \"\", ingredients: [\"\", \"\"], instructions: \"\", prep_minutes: 20, servings: 2 };\n+\n+export default function RecipeForm({ id, token, username, onSignIn, onCancel, onSaved, onUnauthorized }: { id?: number; token: string; username: string; onSignIn: () => void; onCancel: () => void; onSaved: (recipe: Recipe) => void; onUnauthorized: () => void }) {\n+  const [form, setForm] = useState<RecipeFields>(blank);\n+  const [categories, setCategories] = useState<string[]>([]);\n+  const [loading, setLoading] = useState(!!id);\n+  const [author, setAuthor] = useState(\"\");\n+  const [loadError, setLoadError] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<Record<string, string>>({});\n+  const [busy, setBusy] = useState(false);\n+  const [retry, setRetry] = useState(0);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    api<{ items: string[] }>(\"/categories\", { signal: controller.signal }).then(data => setCategories(data.items)).catch(() => {});\n+    if (id) {\n+      setLoading(true);\n+      setLoadError(\"\");\n+      api<Recipe>(`/recipes/${id}`, { signal: controller.signal }).then(recipe => { setForm(recipe); setAuthor(recipe.author); })\n+        .catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setLoadError(caught.message); })\n+        .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    }\n+    return () => controller.abort();\n+  }, [id, retry]);\n+\n+  function update<K extends keyof RecipeFields>(field: K, value: RecipeFields[K]) {\n+    setForm(current => ({ ...current, [field]: value }));\n+    setFields(current => ({ ...current, [field]: \"\" }));\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true); setError(\"\"); setFields({});\n+    try {\n+      const recipe = await api<Recipe>(id ? `/recipes/${id}` : \"/recipes\", { method: id ? \"PUT\" : \"POST\", body: JSON.stringify({ title: form.title, category: form.category, ingredients: form.ingredients, instructions: form.instructions, prep_minutes: form.prep_minutes, servings: form.servings }) }, token);\n+      onSaved(recipe);\n+    } catch (caught) {\n+      setError(caught instanceof Error ? caught.message : \"Couldn’t save your recipe. Please try again.\");\n+      if (caught instanceof ApiError) { setFields(caught.fields); if (caught.status === 401) onUnauthorized(); }\n+    } finally { setBusy(false); }\n+  }\n+\n+  function accessibility(name: string) { return { \"aria-invalid\": !!fields[name], \"aria-describedby\": fields[name] ? `${name}-error` : undefined }; }\n+\n+  return <div className=\"mx-auto max-w-3xl py-9 sm:py-11\">\n+    <button onClick={onCancel} className=\"mb-7 flex items-center gap-2 text-xs text-muted transition hover:text-olive\"><ArrowLeft size={15} />{id ? \"Back to your recipe\" : \"Back to the recipe book\"}</button>\n+    <div className=\"mb-8\"><span className=\"mb-3 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[1.8px] text-olive\"><Sprout size={16} /> A little of your kitchen</span><h1 className=\"font-serif text-4xl tracking-tight sm:text-[44px]\">{id ? \"Make it even more yours.\" : \"Something worth sharing.\"}</h1><p className=\"mt-3 text-sm leading-6 text-muted\">{id ? \"A new twist, a little refinement. Keep your recipe just the way you like it.\" : \"Simple or special, everyday or once a year. We’d love to try your favorite.\"}</p></div>\n+    {loading ? <Loading text=\"Getting your recipe ready…\" /> : loadError ? <div className=\"space-y-4\"><ErrorBox message={loadError} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : !token ? <div className=\"rounded-xl border border-line bg-white p-8 text-center\"><ChefHat size={36} strokeWidth={1.4} className=\"mx-auto mb-4 text-olive\" /><h2 className=\"font-serif text-2xl\">First, make yourself at home.</h2><p className=\"my-4 text-sm text-muted\">Sign in to share and manage your recipes.</p><button onClick={onSignIn} className={primaryButton}>Sign in to continue <ArrowRight size={16} /></button></div> : id && username && author !== username ? <ErrorBox message=\"Only the author can edit this recipe. You can still make and share a recipe of your own.\" /> : <form noValidate onSubmit={submit} className=\"space-y-7\">\n+      {error && <ErrorBox message={error} />}\n+      <section className=\"space-y-5 rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"mb-1 font-serif text-2xl\">The essentials</h2>\n+        <Field label=\"Recipe title\" name=\"title\" error={fields.title}><input id=\"title\" className={inputClass} placeholder=\"What’s cooking?\" value={form.title} onChange={event => update(\"title\", event.target.value)} {...accessibility(\"title\")} /></Field>\n+        <div className=\"grid gap-5 sm:grid-cols-3\"><Field label=\"Category\" name=\"category\" error={fields.category}><input id=\"category\" list=\"recipe-categories\" className={inputClass} placeholder=\"e.g. Dinner\" value={form.category} onChange={event => update(\"category\", event.target.value)} {...accessibility(\"category\")} /><datalist id=\"recipe-categories\">{categories.map(category => <option key={category} value={category} />)}</datalist></Field><Field label=\"Prep time (minutes)\" name=\"prep_minutes\" error={fields.prep_minutes}><input id=\"prep_minutes\" type=\"number\" min=\"0\" max=\"1440\" step=\"1\" className={inputClass} value={Number.isNaN(form.prep_minutes) ? \"\" : form.prep_minutes} onChange={event => update(\"prep_minutes\", event.target.value === \"\" ? NaN : Number(event.target.value))} {...accessibility(\"prep_minutes\")} /></Field><Field label=\"Servings\" name=\"servings\" error={fields.servings}><input id=\"servings\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" className={inputClass} value={Number.isNaN(form.servings) ? \"\" : form.servings} onChange={event => update(\"servings\", event.target.value === \"\" ? NaN : Number(event.target.value))} {...accessibility(\"servings\")} /></Field></div>\n+      </section>\n+      <section className=\"rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"font-serif text-2xl\">A few good ingredients</h2><p className=\"mb-5 mt-2 text-xs leading-6 text-muted\">One ingredient per row, with the quantity. We’ll keep them in this order.</p><div className=\"space-y-3\" aria-describedby={fields.ingredients ? \"ingredients-error\" : undefined}>{form.ingredients.map((ingredient, index) => <div key={index} className=\"flex items-center gap-2\"><GripVertical size={15} className=\"shrink-0 text-line\" /><span className=\"w-4 shrink-0 text-xs text-muted\">{index + 1}</span><input id={index === 0 ? \"ingredients\" : `ingredient-${index}`} aria-label={`Ingredient ${index + 1}`} className={inputClass} placeholder={index === 0 ? \"e.g. 200 g pasta\" : \"Another lovely ingredient\"} value={ingredient} onChange={event => update(\"ingredients\", form.ingredients.map((value, position) => position === index ? event.target.value : value))} {...accessibility(\"ingredients\")} /><button type=\"button\" aria-label={`Remove ingredient ${index + 1}`} onClick={() => update(\"ingredients\", form.ingredients.filter((_, position) => position !== index))} className=\"rounded-lg p-2.5 text-muted transition hover:bg-red-50 hover:text-terra\"><Trash2 size={16} /></button></div>)}</div>{fields.ingredients && <p id=\"ingredients-error\" role=\"alert\" className=\"mt-2 text-xs text-red-700\">{fields.ingredients}</p>}<button type=\"button\" disabled={form.ingredients.length >= 100} onClick={() => update(\"ingredients\", [...form.ingredients, \"\"])} className=\"mt-5 flex items-center gap-1.5 rounded-md px-1 py-1.5 text-xs font-medium text-olive hover:bg-sage disabled:opacity-50\"><Plus size={15} /> Add an ingredient</button></section>\n+      <section className=\"rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"mb-5 font-serif text-2xl\">Let’s make something good.</h2><Field label=\"Instructions\" name=\"instructions\" error={fields.instructions} hint=\"Write it just as you’d explain it to a friend. Line breaks are kept.\"><textarea id=\"instructions\" rows={9} className={`${inputClass} resize-y leading-7`} placeholder=\"Start here…\" value={form.instructions} onChange={event => update(\"instructions\", event.target.value)} {...accessibility(\"instructions\")} /></Field></section>\n+      <div className=\"flex items-center justify-between gap-4\"><p className=\"hidden text-xs text-muted sm:block\">From <span className=\"font-medium text-olive\">{username || \"your\"}</span>’s kitchen, with love.</p><div className=\"ml-auto flex gap-3\"><button type=\"button\" disabled={busy} onClick={onCancel} className={secondaryButton}>Cancel</button><button disabled={busy} className={primaryButton}>{busy ? \"Saving your recipe…\" : id ? \"Save changes\" : \"Share your recipe\"}<ArrowRight size={16} /></button></div></div>\n+    </form>}\n+  </div>;\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nD frontend/src/App.tsx\nA frontend/src/App.tsx\nA frontend/src/RecipeBook.tsx\nA frontend/src/RecipeDetail.tsx\nA frontend/src/RecipeForm.tsx","metadata":{"diff":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,138 @@\n+import { useCallback, useEffect, useState } from \"react\";\n+import { ArrowRight, Check, ChefHat, Heart, LogOut, Plus, Sprout, X } from \"lucide-react\";\n+import { api, ApiError } from \"./api\";\n+import AuthForm from \"./AuthForm\";\n+import RecipeBook from \"./RecipeBook\";\n+import RecipeDetail from \"./RecipeDetail\";\n+import RecipeForm from \"./RecipeForm\";\n+import { Modal, primaryButton } from \"./ui\";\n+\n+function storedToken() {\n+  try { return localStorage.getItem(\"table-thyme-token\") || \"\"; } catch { return \"\"; }\n+}\n+\n+export default function App() {\n+  const [path, setPath] = useState(window.location.pathname);\n+  const [token, setToken] = useState(storedToken);\n+  const [username, setUsername] = useState(\"\");\n+  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n+  const [pendingPath, setPendingPath] = useState(\"\");\n+  const [about, setAbout] = useState(false);\n+  const [notice, setNotice] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+\n+  const navigate = useCallback((next: string) => {\n+    window.history.pushState({}, \"\", next);\n+    setPath(next);\n+    window.scrollTo({ top: 0, behavior: \"instant\" });\n+  }, []);\n+\n+  const clearSession = useCallback(() => {\n+    setToken(\"\");\n+    setUsername(\"\");\n+    try { localStorage.removeItem(\"table-thyme-token\"); } catch { /* empty */ }\n+  }, []);\n+\n+  const sessionExpired = useCallback(() => {\n+    clearSession();\n+    setAuthMode(\"login\");\n+    setNotice(\"Your session has expired. Sign in to continue.\");\n+  }, [clearSession]);\n+\n+  useEffect(() => {\n+    const listener = () => setPath(window.location.pathname);\n+    window.addEventListener(\"popstate\", listener);\n+    return () => window.removeEventListener(\"popstate\", listener);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<{ username: string }>(\"/auth/me\", { signal: controller.signal }, token)\n+      .then(user => setUsername(user.username))\n+      .catch(error => {\n+        if (error instanceof ApiError && error.status === 401) clearSession();\n+        else if (!(error instanceof DOMException && error.name === \"AbortError\")) setNotice(\"Couldn’t verify your session. Try refreshing the page.\");\n+      });\n+    return () => controller.abort();\n+  }, [token, clearSession]);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 6000);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  function openAuth(mode: \"login\" | \"register\", next = \"\") {\n+    setPendingPath(next);\n+    setAuthMode(mode);\n+  }\n+\n+  function addRecipe() {\n+    if (token) navigate(\"/recipes/new\");\n+    else openAuth(\"login\", \"/recipes/new\");\n+  }\n+\n+  async function signOut() {\n+    try { await api(\"/auth/logout\", { method: \"POST\" }, token); }\n+    catch (error) {\n+      if (!(error instanceof ApiError && error.status === 401)) {\n+        setNotice(\"Couldn’t sign out. Please try again.\");\n+        return;\n+      }\n+    }\n+    clearSession();\n+    setNotice(\"You’re signed out. There’s always a seat for you here.\");\n+  }\n+\n+  const detailMatch = path.match(/^\\/recipes\\/(\\d+)\\/?$/);\n+  const editMatch = path.match(/^\\/recipes\\/(\\d+)\\/edit\\/?$/);\n+  const newRecipe = path === \"/recipes/new\";\n+  const isBook = path === \"/\" || path === \"/recipes\";\n+\n+  return <div className=\"flex min-h-dvh flex-col\">\n+    <header className=\"border-b border-line bg-cream\">\n+      <div className=\"mx-auto flex min-h-24 max-w-7xl flex-wrap items-center justify-between gap-x-5 gap-y-3 px-5 py-5 sm:px-8 lg:px-12\">\n+        <a href=\"/\" onClick={event => { event.preventDefault(); navigate(\"/\"); }} className=\"flex shrink-0 items-center gap-2.5\" aria-label=\"Table and Thyme home\">\n+          <Sprout className=\"text-olive\" size={31} strokeWidth={1.5} /><span className=\"font-serif text-[27px] tracking-[-1px] sm:text-[29px]\">Table <span className=\"italic text-olive\">&</span> Thyme<span className=\"text-terra\">.</span></span>\n+        </a>\n+        <nav aria-label=\"Main navigation\" className=\"ml-8 hidden items-center gap-8 self-stretch text-[13px] md:flex\">\n+          <a href=\"/\" onClick={event => { event.preventDefault(); navigate(\"/\"); }} aria-current={isBook ? \"page\" : undefined} className={`flex items-center border-b-2 px-1 ${isBook ? \"border-olive font-medium\" : \"border-transparent text-muted hover:text-ink\"}`}>The recipe book</a>\n+          <button onClick={() => setAbout(true)} className=\"text-muted transition hover:text-ink\">Our philosophy</button>\n+        </nav>\n+        <div className=\"ml-auto flex items-center gap-3 sm:gap-5\">\n+          {token ? <div className=\"flex items-center gap-2 sm:gap-3\"><span className=\"hidden max-w-32 truncate text-sm sm:block\">Hi, <span className=\"font-medium\">{username || \"cook\"}</span></span><button onClick={signOut} className=\"flex items-center gap-1.5 text-xs text-muted hover:text-ink\" aria-label=\"Sign out\"><LogOut size={15} /><span className=\"hidden sm:inline\">Sign out</span></button></div> : <button onClick={() => openAuth(\"login\")} className=\"px-1 text-sm font-medium transition hover:text-olive\">Sign in</button>}\n+          <button onClick={addRecipe} className={`${primaryButton} !gap-1.5 !px-3.5 !py-2.5 sm:!px-4`}><Plus size={16} /><span className=\"hidden min-[420px]:inline\">Add a recipe</span><span className=\"min-[420px]:hidden\">Add</span></button>\n+        </div>\n+      </div>\n+    </header>\n+\n+    <main className=\"mx-auto w-full max-w-7xl flex-1 px-5 sm:px-8 lg:px-12\">\n+      {isBook ? <RecipeBook revision={revision} onOpen={id => navigate(`/recipes/${id}`)} onShare={() => token ? navigate(\"/recipes/new\") : openAuth(\"register\", \"/recipes/new\")} /> :\n+        detailMatch ? <RecipeDetail key={detailMatch[1]} id={Number(detailMatch[1])} username={username} token={token} onBack={() => navigate(\"/\")} onEdit={() => navigate(`/recipes/${detailMatch[1]}/edit`)} onDeleted={() => { setRevision(value => value + 1); setNotice(\"Recipe deleted.\"); navigate(\"/\"); }} onUnauthorized={sessionExpired} /> :\n+        newRecipe || editMatch ? <RecipeForm key={editMatch?.[1] || \"new\"} id={editMatch ? Number(editMatch[1]) : undefined} token={token} username={username} onSignIn={() => openAuth(\"login\")} onCancel={() => navigate(editMatch ? `/recipes/${editMatch[1]}` : \"/\")} onSaved={recipe => { setRevision(value => value + 1); setNotice(editMatch ? \"Your recipe has been updated.\" : \"Your recipe is at the table. Thanks for sharing!\"); navigate(`/recipes/${recipe.id}`); }} onUnauthorized={sessionExpired} /> :\n+        <div className=\"py-28 text-center\"><h1 className=\"mb-4 font-serif text-4xl\">This page isn’t on the menu.</h1><button onClick={() => navigate(\"/\")} className={primaryButton}>Back to the recipe book <ArrowRight size={16} /></button></div>}\n+    </main>\n+\n+    <footer className=\"mt-16 border-t border-line\">\n+      <div className=\"mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-5 py-7 text-xs text-muted sm:flex-row sm:px-8 lg:px-12\">\n+        <span className=\"flex items-center gap-2\"><Sprout size={16} className=\"text-olive\" /> A recipe book for all of us.</span>\n+        <span className=\"flex items-center gap-1.5\">Made with care. Shared with <Heart size={12} className=\"text-terra\" />.</span>\n+        <button onClick={() => setAbout(true)} className=\"transition hover:text-ink\">A little about Table & Thyme <ArrowRight size={12} className=\"ml-1 inline\" /></button>\n+      </div>\n+    </footer>\n+\n+    {authMode && <AuthForm key={authMode} mode={authMode} onMode={setAuthMode} onClose={() => { setAuthMode(null); setPendingPath(\"\"); }} onLogin={(nextToken, name) => {\n+      try { localStorage.setItem(\"table-thyme-token\", nextToken); } catch { /* empty */ }\n+      setToken(nextToken); setUsername(name); setAuthMode(null); setNotice(`Welcome to the kitchen, ${name}.`);\n+      if (pendingPath) navigate(pendingPath);\n+      setPendingPath(\"\");\n+    }} />}\n+    {about && <Modal title=\"Good food brings us together.\" onClose={() => setAbout(false)} wide>\n+      <div className=\"mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-sage text-olive\"><ChefHat size={32} strokeWidth={1.5} /></div>\n+      <div className=\"space-y-4 text-sm leading-7 text-muted\"><p>Table & Thyme is a little corner of the internet for the recipes you make again and again. The easy weekday dinner. The pancakes everyone asks for. The dish that tastes like home.</p><p>No perfect kitchens required. Just simple ingredients, a little curiosity, and something worth sharing.</p><p>Everyone is welcome to browse. Make an account to add your own recipes, and edit them whenever inspiration strikes.</p></div>\n+      <button className={`${primaryButton} mt-7`} onClick={() => { setAbout(false); addRecipe(); }}>Share a little of your kitchen <ArrowRight size={16} /></button>\n+    </Modal>}\n+    {notice && <div role=\"status\" className=\"fixed bottom-5 left-1/2 z-50 flex w-[calc(100%-2.5rem)] max-w-lg -translate-x-1/2 items-center gap-3 rounded-xl border border-line bg-white p-4 text-sm shadow-xl\"><Check size={18} className=\"shrink-0 text-olive\" /><span className=\"flex-1\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss notification\" className=\"p-1 text-muted\"><X size={16} /></button></div>}\n+  </div>;\n+}\n\nIndex: /workspace/frontend/src/RecipeBook.tsx\n===================================================================\n--- /workspace/frontend/src/RecipeBook.tsx\n+++ /workspace/frontend/src/RecipeBook.tsx\n@@ -0,0 +1,131 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { ArrowDown, ArrowRight, BookOpen, ChefHat, ChevronDown, ChevronLeft, ChevronRight, Clock3, Coffee, Heart, Leaf, Plus, Search, SlidersHorizontal, Sprout, Utensils, X } from \"lucide-react\";\n+import { api, type RecipePage, type RecipeSummary } from \"./api\";\n+import FoodArt, { dishFor } from \"./FoodArt\";\n+import { ErrorBox, Loading, primaryButton, secondaryButton } from \"./ui\";\n+\n+const categoryStyle = (category: string) => ({ Breakfast: \"bg-[#f5ead6] text-[#8c7042]\", Lunch: \"bg-[#e9efdc] text-[#62784b]\", Dinner: \"bg-[#f2e4da] text-[#9e6245]\", Dessert: \"bg-[#f1e3e7] text-[#9c6276]\" }[category] || \"bg-sage text-olive\");\n+\n+function RecipeCard({ recipe, onOpen }: { recipe: RecipeSummary; onOpen: () => void }) {\n+  return <article className=\"group overflow-hidden rounded-xl border border-line bg-white transition duration-300 hover:-translate-y-1 hover:border-olive/35 hover:shadow-lg hover:shadow-ink/5\">\n+    <a href={`/recipes/${recipe.id}`} onClick={event => { event.preventDefault(); onOpen(); }} className=\"block h-full\">\n+      <div className=\"relative aspect-[1.65] overflow-hidden bg-sage\">\n+        <FoodArt dish={dishFor(recipe.title, recipe.category)} className=\"transition duration-700 group-hover:scale-105\" />\n+        <span className={`absolute left-4 top-4 rounded-md px-2.5 py-1 text-[10px] font-semibold tracking-wide ${categoryStyle(recipe.category)}`}>{recipe.category}</span>\n+      </div>\n+      <div className=\"p-5\">\n+        <div className=\"mb-3 flex items-center gap-1.5 text-[11px] text-muted\"><Clock3 size={13} strokeWidth={1.6} />{recipe.prep_minutes} min<span className=\"mx-1.5 text-line\">|</span><span>Made for real life</span></div>\n+        <h3 className=\"min-h-7 font-serif text-[23px] leading-7 tracking-[-.45px] transition group-hover:text-olive\">{recipe.title}</h3>\n+        <div className=\"mt-5 flex items-center justify-between border-t border-line pt-4\">\n+          <div className=\"flex items-center gap-2\"><span className=\"flex h-6 w-6 items-center justify-center rounded-full bg-sage font-serif text-xs text-olive\">{recipe.author.charAt(0).toUpperCase()}</span><span className=\"text-[11px] text-muted\">From <span className=\"font-medium text-ink/80\">{recipe.author}</span>’s kitchen</span></div>\n+          <ArrowRight size={16} strokeWidth={1.5} className=\"text-olive transition group-hover:translate-x-1\" />\n+        </div>\n+      </div>\n+    </a>\n+  </article>;\n+}\n+\n+export default function RecipeBook({ revision, onOpen, onShare }: { revision: number; onOpen: (id: number) => void; onShare: () => void }) {\n+  const [category, setCategory] = useState(\"\");\n+  const [search, setSearch] = useState(\"\");\n+  const [query, setQuery] = useState(\"\");\n+  const [page, setPage] = useState(1);\n+  const [pageSize, setPageSize] = useState(6);\n+  const [categories, setCategories] = useState<string[]>([]);\n+  const [result, setResult] = useState<RecipePage | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  const book = useRef<HTMLElement>(null);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    api<{ items: string[] }>(\"/categories\", { signal: controller.signal }).then(data => setCategories(data.items)).catch(() => {});\n+    return () => controller.abort();\n+  }, [revision, retry]);\n+\n+  useEffect(() => {\n+    const timeout = window.setTimeout(() => { setQuery(search); setPage(1); }, 300);\n+    return () => window.clearTimeout(timeout);\n+  }, [search]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    const params = new URLSearchParams({ category, q: query, page: String(page), page_size: String(pageSize) });\n+    api<RecipePage>(`/recipes?${params}`, { signal: controller.signal })\n+      .then(data => {\n+        if (data.total > 0 && page > Math.ceil(data.total / pageSize)) setPage(Math.ceil(data.total / pageSize));\n+        else setResult(data);\n+      })\n+      .catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setError(caught.message); })\n+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    return () => controller.abort();\n+  }, [category, query, page, pageSize, revision, retry]);\n+\n+  function selectCategory(next: string) { setCategory(next); setPage(1); }\n+  function browse() { book.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" }); }\n+  const tabs = [...[\"Breakfast\", \"Lunch\", \"Dinner\", \"Dessert\"].filter(item => categories.includes(item)), ...categories.filter(item => ![\"Breakfast\", \"Lunch\", \"Dinner\", \"Dessert\"].includes(item))];\n+  const pages = Math.max(1, Math.ceil((result?.total || 0) / pageSize));\n+\n+  return <>\n+    <section className=\"relative mt-9 overflow-hidden rounded-2xl bg-[#edf0e7] md:mt-10\" aria-labelledby=\"hero-heading\">\n+      <div className=\"relative z-10 px-7 pb-8 pt-10 sm:px-10 lg:px-12 lg:py-12 md:w-[53%]\">\n+        <div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[2px] text-olive\"><span className=\"h-1.5 w-1.5 rounded-full bg-olive\" /> FROM OUR KITCHENS TO YOURS</div>\n+        <h1 id=\"hero-heading\" className=\"font-serif text-[43px] leading-[1.13] tracking-[-1.6px] sm:text-[52px] lg:text-[58px]\">A little inspiration.<br />A lot of <span className=\"italic text-olive\">good food.</span></h1>\n+        <p className=\"mt-5 max-w-sm text-[13px] leading-[1.9] text-muted\">Everyday recipes. Something for every craving.<br className=\"hidden lg:block\" /> A collection made by home cooks, for home cooks.</p>\n+        <div className=\"mt-7 flex flex-wrap items-center gap-5\">\n+          <button onClick={browse} className={`${primaryButton} !px-5 !text-xs`}>Explore the recipes <ArrowDown size={15} /></button>\n+          <button onClick={onShare} className=\"flex items-center gap-1.5 text-xs font-medium text-olive underline decoration-olive/30 underline-offset-4 transition hover:text-ink\">Share your favorite <ArrowRight size={14} /></button>\n+        </div>\n+      </div>\n+      <div className=\"relative h-60 md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[51%]\">\n+        <FoodArt hero />\n+        <div className=\"absolute right-6 top-5 flex h-[83px] w-[83px] rotate-12 flex-col items-center justify-center rounded-full border border-olive/35 bg-[#edf0e7]/80 text-olive backdrop-blur-sm lg:right-8 lg:top-7\"><Sprout size={21} strokeWidth={1.3} /><span className=\"mt-1 text-[8px] font-medium tracking-[1.1px]\">FRESH IDEAS</span><span className=\"mt-0.5 font-serif text-[10px] italic\">every day</span></div>\n+        <div className=\"absolute bottom-6 left-7 flex -rotate-3 items-center gap-3 rounded-lg border border-white/70 bg-cream/95 px-4 py-3 shadow-sm md:bottom-8 md:left-9\"><Heart size={18} strokeWidth={1.5} className=\"text-terra\" /><span className=\"font-serif text-sm italic\">Good food. Good company.</span></div>\n+      </div>\n+    </section>\n+\n+    <div className=\"mt-5 grid grid-cols-1 gap-3 border-b border-line pb-6 text-[11px] text-muted min-[540px]:grid-cols-3 min-[540px]:gap-1\">\n+      <span className=\"flex items-center justify-center gap-2\"><Leaf size={15} strokeWidth={1.5} className=\"text-olive\" /> Simple ingredients, lovely results</span>\n+      <span className=\"flex items-center justify-center gap-2\"><ChefHat size={16} strokeWidth={1.5} className=\"text-olive\" /> From real home cooks</span>\n+      <span className=\"flex items-center justify-center gap-2\"><Heart size={14} strokeWidth={1.5} className=\"text-olive\" /> A little something for everyone</span>\n+    </div>\n+\n+    <section ref={book} className=\"scroll-mt-6 pt-9\" aria-labelledby=\"recipes-heading\">\n+      <div className=\"mb-6 flex flex-wrap items-end justify-between gap-4\">\n+        <div><div className=\"mb-2 text-[9px] font-semibold tracking-[1.8px] text-terra\">THE RECIPE BOOK</div><h2 id=\"recipes-heading\" className=\"font-serif text-[32px] leading-tight tracking-[-.7px] sm:text-[35px]\">Find your next favorite<span className=\"text-terra\">.</span></h2><p className=\"mt-2 text-xs text-muted\">A few good ingredients. A recipe worth keeping.</p></div>\n+        <span className=\"mb-1 flex items-center gap-1.5 text-[11px] text-muted\"><SlidersHorizontal size={13} strokeWidth={1.5} /> Newest additions first</span>\n+      </div>\n+\n+      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-white px-4 py-3\">\n+        <div className=\"flex max-w-full items-center gap-1 overflow-x-auto\" role=\"group\" aria-label=\"Filter by category\">\n+          <button onClick={() => selectCategory(\"\")} aria-pressed={!category} className={`flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-xs transition ${!category ? \"bg-sage font-medium text-olive\" : \"text-muted hover:bg-cream\"}`}><BookOpen size={14} />All recipes</button>\n+          {tabs.map(item => <button key={item} onClick={() => selectCategory(item)} aria-pressed={category === item} className={`flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-xs transition ${category === item ? \"bg-sage font-medium text-olive\" : \"text-muted hover:bg-cream\"}`}>{item === \"Breakfast\" ? <Coffee size={13} /> : item === \"Dinner\" ? <Utensils size={13} /> : item === \"Lunch\" ? <Leaf size={13} /> : item === \"Dessert\" ? <Heart size={13} /> : null}{item}</button>)}\n+        </div>\n+        <div className=\"flex w-full items-center gap-2 border-t border-line pt-3 lg:w-auto lg:border-0 lg:pt-0\">\n+          <div className=\"relative min-w-0 flex-1 lg:w-48\"><Search size={14} className=\"absolute left-3 top-1/2 -translate-y-1/2 text-muted\" /><input aria-label=\"Search recipe titles\" type=\"search\" value={search} onChange={event => setSearch(event.target.value)} placeholder=\"Find something delicious…\" className=\"w-full rounded-lg border border-line bg-cream py-2.5 pl-9 pr-3 text-[11px] placeholder:text-muted focus:border-olive focus:outline-none\" /></div>\n+          <div className=\"relative\"><select aria-label=\"Recipe category\" value={category} onChange={event => selectCategory(event.target.value)} className=\"max-w-36 appearance-none rounded-lg border border-line bg-cream py-2.5 pl-3 pr-7 text-[11px] text-muted focus:border-olive\"><option value=\"\">All categories</option>{categories.map(item => <option key={item}>{item}</option>)}</select><ChevronDown size={12} className=\"pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted\" /></div>\n+        </div>\n+      </div>\n+\n+      <div className=\"mb-5 flex items-center justify-between text-[11px] text-muted\" aria-live=\"polite\"><span>{loading ? \"Finding your next favorite…\" : `${result?.total || 0} ${(result?.total || 0) === 1 ? \"recipe\" : \"recipes\"}${category ? ` in ${category.toLowerCase()}` : \" to make your own\"}${query ? ` matching “${query}”` : \"\"}`}</span>{(category || search) && <button onClick={() => { setSearch(\"\"); setQuery(\"\"); selectCategory(\"\"); }} className=\"flex items-center gap-1 text-olive hover:underline\">Clear filters <X size={12} /></button>}</div>\n+\n+      {error ? <div className=\"space-y-4 py-6\"><ErrorBox message={error} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : loading ? <Loading /> : result?.items.length ? <div className=\"grid gap-6 min-[600px]:grid-cols-2 lg:grid-cols-3\">\n+        {result.items.map(recipe => <RecipeCard key={recipe.id} recipe={recipe} onOpen={() => onOpen(recipe.id)} />)}\n+        {result.items.length < pageSize && <div className=\"flex min-h-80 flex-col items-center justify-center rounded-xl border border-dashed border-olive/30 bg-sage/60 px-6 py-9 text-center\">\n+          <div className=\"relative mb-5 flex h-[72px] w-[72px] items-center justify-center rounded-full bg-[#e1e7d6]\"><BookOpen size={31} strokeWidth={1.2} className=\"-rotate-12 text-olive\" /><span className=\"absolute -right-1 bottom-0 flex h-6 w-6 items-center justify-center rounded-full border-2 border-sage bg-cream text-terra\"><Plus size={14} /></span></div>\n+          <h3 className=\"font-serif text-[25px] tracking-tight\">Your recipe belongs here.</h3><p className=\"mt-3 max-w-56 text-xs leading-6 text-muted\">That family favorite. Your latest discovery.<br />Good things are made to be shared.</p><button onClick={onShare} className=\"mt-5 flex items-center gap-2 rounded-lg border border-olive/30 bg-transparent px-4 py-2.5 text-xs font-medium text-olive transition hover:bg-olive hover:text-white\">Share a recipe <ArrowRight size={14} /></button>\n+        </div>}\n+      </div> : <div className=\"flex min-h-64 flex-col items-center justify-center rounded-xl border border-dashed border-line text-center\"><Search size={28} className=\"mb-4 text-olive\" strokeWidth={1.3} /><h3 className=\"font-serif text-2xl\">Nothing on the menu just yet.</h3><p className=\"mt-2 text-sm text-muted\">Try another title or category, or share something of your own.</p><button onClick={() => { setSearch(\"\"); setQuery(\"\"); selectCategory(\"\"); }} className={`${secondaryButton} mt-5`}>See all recipes</button></div>}\n+\n+      {!loading && !error && result && <div className=\"mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5 text-[11px] text-muted\">\n+        <div className=\"flex items-center gap-4\"><span>{result.total ? `${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, result.total)} of ${result.total} recipes` : \"0 recipes\"}</span><label className=\"hidden items-center gap-1.5 sm:flex\">Per page <select value={pageSize} onChange={event => { setPageSize(Number(event.target.value)); setPage(1); }} className=\"rounded-md border border-line bg-white px-1.5 py-1 text-ink\" aria-label=\"Recipes per page\"><option value={6}>6</option><option value={12}>12</option><option value={24}>24</option></select></label></div>\n+        <nav aria-label=\"Recipe pages\" className=\"flex items-center gap-2\"><button disabled={page === 1} onClick={() => { setPage(value => value - 1); browse(); }} className=\"flex h-8 items-center gap-1 rounded-md border border-line bg-white px-2.5 transition hover:border-olive disabled:opacity-40\"><ChevronLeft size={13} /> Previous</button><span className=\"px-2\">{page} <span className=\"px-1 text-muted/50\">/</span> {pages}</span><button disabled={page >= pages} onClick={() => { setPage(value => value + 1); browse(); }} className=\"flex h-8 items-center gap-1 rounded-md border border-line bg-white px-2.5 transition hover:border-olive disabled:opacity-40\">Next <ChevronRight size={13} /></button></nav>\n+      </div>}\n+    </section>\n+\n+    <aside className=\"mt-10 flex flex-col items-center gap-3 rounded-xl bg-[#f0ece3] px-6 py-5 text-center sm:flex-row sm:justify-between sm:text-left\"><div className=\"flex items-center gap-3\"><Sprout size={24} strokeWidth={1.3} className=\"shrink-0 text-olive\" /><div><p className=\"font-serif text-lg\">The best recipes have a story.</p><p className=\"mt-0.5 text-[11px] text-muted\">We’d love to hear yours. Make yourself at home.</p></div></div><button onClick={onShare} className=\"flex shrink-0 items-center gap-2 text-xs font-medium text-olive transition hover:text-ink\">Join our kitchen <ArrowRight size={14} /></button></aside>\n+  </>;\n+}\n\nIndex: /workspace/frontend/src/RecipeDetail.tsx\n===================================================================\n--- /workspace/frontend/src/RecipeDetail.tsx\n+++ /workspace/frontend/src/RecipeDetail.tsx\n@@ -0,0 +1,48 @@\n+import { useEffect, useState } from \"react\";\n+import { ArrowLeft, CalendarDays, ChefHat, Clock3, Pencil, Sprout, Trash2, Users } from \"lucide-react\";\n+import { api, ApiError, type Recipe } from \"./api\";\n+import FoodArt, { dishFor } from \"./FoodArt\";\n+import { ErrorBox, Loading, Modal, secondaryButton } from \"./ui\";\n+\n+export default function RecipeDetail({ id, username, token, onBack, onEdit, onDeleted, onUnauthorized }: { id: number; username: string; token: string; onBack: () => void; onEdit: () => void; onDeleted: () => void; onUnauthorized: () => void }) {\n+  const [recipe, setRecipe] = useState<Recipe | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  const [confirm, setConfirm] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+  const [deleting, setDeleting] = useState(false);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setError(\"\");\n+    api<Recipe>(`/recipes/${id}`, { signal: controller.signal }).then(setRecipe).catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setError(caught.message); });\n+    return () => controller.abort();\n+  }, [id, retry]);\n+\n+  async function remove() {\n+    setDeleting(true);\n+    setDeleteError(\"\");\n+    try { await api(`/recipes/${id}`, { method: \"DELETE\" }, token); setConfirm(false); onDeleted(); }\n+    catch (caught) {\n+      if (caught instanceof ApiError && caught.status === 401) { setConfirm(false); onUnauthorized(); }\n+      else setDeleteError(caught instanceof Error ? caught.message : \"Couldn’t delete the recipe.\");\n+    } finally { setDeleting(false); }\n+  }\n+\n+  return <div className=\"py-9 sm:py-11\">\n+    <button onClick={onBack} className=\"mb-7 flex items-center gap-2 text-xs text-muted transition hover:text-olive\"><ArrowLeft size={15} /> Back to the recipe book</button>\n+    {error ? <div className=\"space-y-4\"><ErrorBox message={error} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : !recipe ? <Loading /> : <>\n+      <div className=\"grid overflow-hidden rounded-2xl border border-line bg-white md:grid-cols-2\">\n+        <div className=\"aspect-[1.4] md:aspect-auto md:min-h-96\"><FoodArt dish={dishFor(recipe.title, recipe.category)} /></div>\n+        <div className=\"flex flex-col justify-center p-7 sm:p-10\"><span className=\"mb-4 w-fit rounded-md bg-sage px-3 py-1.5 text-[10px] font-semibold uppercase tracking-widest text-olive\">{recipe.category}</span><h1 className=\"font-serif text-4xl leading-tight tracking-tight lg:text-[45px]\">{recipe.title}</h1><div className=\"mt-6 flex items-center gap-2.5\"><span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-sage font-serif text-olive\">{recipe.author.charAt(0).toUpperCase()}</span><span className=\"text-xs text-muted\">From <span className=\"font-medium text-ink\">{recipe.author}</span>’s kitchen</span></div><div className=\"mt-7 flex flex-wrap gap-5 border-t border-line pt-5 text-xs text-muted\"><span className=\"flex items-center gap-2\"><Clock3 size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{recipe.prep_minutes} min</b><span className=\"mt-1 block text-[10px]\">Prep time</span></span></span><span className=\"flex items-center gap-2\"><Users size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{recipe.servings} {recipe.servings === 1 ? \"serving\" : \"servings\"}</b><span className=\"mt-1 block text-[10px]\">At the table</span></span></span><span className=\"flex items-center gap-2\"><CalendarDays size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{new Date(recipe.created_at).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" })}</b><span className=\"mt-1 block text-[10px]\">Shared on</span></span></span></div>\n+          {username === recipe.author && <div className=\"mt-7 flex gap-3\"><button onClick={onEdit} className={secondaryButton}><Pencil size={14} /> Edit recipe</button><button onClick={() => { setDeleteError(\"\"); setConfirm(true); }} className=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs text-terra transition hover:bg-red-50\"><Trash2 size={14} /> Delete</button></div>}\n+        </div>\n+      </div>\n+      <div className=\"mt-10 grid gap-10 md:grid-cols-[1fr_1.8fr] lg:gap-16\">\n+        <section><div className=\"mb-5 flex items-center gap-2.5\"><Sprout size={21} strokeWidth={1.4} className=\"text-olive\" /><h2 className=\"font-serif text-[28px]\">A few good ingredients</h2></div><p className=\"mb-5 text-xs text-muted\">For {recipe.servings} {recipe.servings === 1 ? \"serving\" : \"servings\"}. A little preparation goes a long way.</p><ul className=\"divide-y divide-line rounded-xl border border-line bg-white px-5\">{recipe.ingredients.map((ingredient, index) => <li key={index} className=\"flex items-start gap-3 py-4 text-sm leading-6\"><span className=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-olive/65\" />{ingredient}</li>)}</ul></section>\n+        <section><div className=\"mb-5 flex items-center gap-2.5\"><ChefHat size={23} strokeWidth={1.4} className=\"text-olive\" /><h2 className=\"font-serif text-[28px]\">Let’s make something good.</h2></div><div className=\"whitespace-pre-wrap break-words text-sm leading-[2] text-ink/80\">{recipe.instructions}</div><div className=\"mt-8 border-t border-line pt-5 font-serif text-lg italic text-olive\">Made with care. Best enjoyed together.</div></section>\n+      </div>\n+    </>}\n+    {confirm && <Modal title=\"Take it off the menu?\" onClose={() => { if (!deleting) setConfirm(false); }}><p className=\"text-sm leading-7 text-muted\">Are you sure you want to delete <span className=\"font-medium text-ink\">{recipe?.title}</span>? This can’t be undone.</p>{deleteError && <div className=\"mt-4\"><ErrorBox message={deleteError} /></div>}<div className=\"mt-7 flex justify-end gap-3\"><button disabled={deleting} onClick={() => setConfirm(false)} className={secondaryButton}>Keep recipe</button><button disabled={deleting} onClick={remove} className=\"flex items-center gap-2 rounded-lg bg-terra px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-800 disabled:opacity-50\"><Trash2 size={15} />{deleting ? \"Deleting…\" : \"Delete recipe\"}</button></div></Modal>}\n+  </div>;\n+}\n\nIndex: /workspace/frontend/src/RecipeForm.tsx\n===================================================================\n--- /workspace/frontend/src/RecipeForm.tsx\n+++ /workspace/frontend/src/RecipeForm.tsx\n@@ -0,0 +1,65 @@\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { ArrowLeft, ArrowRight, ChefHat, GripVertical, Plus, Sprout, Trash2 } from \"lucide-react\";\n+import { api, ApiError, type Recipe, type RecipeFields } from \"./api\";\n+import { ErrorBox, Field, inputClass, Loading, primaryButton, secondaryButton } from \"./ui\";\n+\n+const blank: RecipeFields = { title: \"\", category: \"\", ingredients: [\"\", \"\"], instructions: \"\", prep_minutes: 20, servings: 2 };\n+\n+export default function RecipeForm({ id, token, username, onSignIn, onCancel, onSaved, onUnauthorized }: { id?: number; token: string; username: string; onSignIn: () => void; onCancel: () => void; onSaved: (recipe: Recipe) => void; onUnauthorized: () => void }) {\n+  const [form, setForm] = useState<RecipeFields>(blank);\n+  const [categories, setCategories] = useState<string[]>([]);\n+  const [loading, setLoading] = useState(!!id);\n+  const [author, setAuthor] = useState(\"\");\n+  const [loadError, setLoadError] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<Record<string, string>>({});\n+  const [busy, setBusy] = useState(false);\n+  const [retry, setRetry] = useState(0);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    api<{ items: string[] }>(\"/categories\", { signal: controller.signal }).then(data => setCategories(data.items)).catch(() => {});\n+    if (id) {\n+      setLoading(true);\n+      setLoadError(\"\");\n+      api<Recipe>(`/recipes/${id}`, { signal: controller.signal }).then(recipe => { setForm(recipe); setAuthor(recipe.author); })\n+        .catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setLoadError(caught.message); })\n+        .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    }\n+    return () => controller.abort();\n+  }, [id, retry]);\n+\n+  function update<K extends keyof RecipeFields>(field: K, value: RecipeFields[K]) {\n+    setForm(current => ({ ...current, [field]: value }));\n+    setFields(current => ({ ...current, [field]: \"\" }));\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true); setError(\"\"); setFields({});\n+    try {\n+      const recipe = await api<Recipe>(id ? `/recipes/${id}` : \"/recipes\", { method: id ? \"PUT\" : \"POST\", body: JSON.stringify({ title: form.title, category: form.category, ingredients: form.ingredients, instructions: form.instructions, prep_minutes: form.prep_minutes, servings: form.servings }) }, token);\n+      onSaved(recipe);\n+    } catch (caught) {\n+      setError(caught instanceof Error ? caught.message : \"Couldn’t save your recipe. Please try again.\");\n+      if (caught instanceof ApiError) { setFields(caught.fields); if (caught.status === 401) onUnauthorized(); }\n+    } finally { setBusy(false); }\n+  }\n+\n+  function accessibility(name: string) { return { \"aria-invalid\": !!fields[name], \"aria-describedby\": fields[name] ? `${name}-error` : undefined }; }\n+\n+  return <div className=\"mx-auto max-w-3xl py-9 sm:py-11\">\n+    <button onClick={onCancel} className=\"mb-7 flex items-center gap-2 text-xs text-muted transition hover:text-olive\"><ArrowLeft size={15} />{id ? \"Back to your recipe\" : \"Back to the recipe book\"}</button>\n+    <div className=\"mb-8\"><span className=\"mb-3 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[1.8px] text-olive\"><Sprout size={16} /> A little of your kitchen</span><h1 className=\"font-serif text-4xl tracking-tight sm:text-[44px]\">{id ? \"Make it even more yours.\" : \"Something worth sharing.\"}</h1><p className=\"mt-3 text-sm leading-6 text-muted\">{id ? \"A new twist, a little refinement. Keep your recipe just the way you like it.\" : \"Simple or special, everyday or once a year. We’d love to try your favorite.\"}</p></div>\n+    {loading ? <Loading text=\"Getting your recipe ready…\" /> : loadError ? <div className=\"space-y-4\"><ErrorBox message={loadError} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : !token ? <div className=\"rounded-xl border border-line bg-white p-8 text-center\"><ChefHat size={36} strokeWidth={1.4} className=\"mx-auto mb-4 text-olive\" /><h2 className=\"font-serif text-2xl\">First, make yourself at home.</h2><p className=\"my-4 text-sm text-muted\">Sign in to share and manage your recipes.</p><button onClick={onSignIn} className={primaryButton}>Sign in to continue <ArrowRight size={16} /></button></div> : id && username && author !== username ? <ErrorBox message=\"Only the author can edit this recipe. You can still make and share a recipe of your own.\" /> : <form noValidate onSubmit={submit} className=\"space-y-7\">\n+      {error && <ErrorBox message={error} />}\n+      <section className=\"space-y-5 rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"mb-1 font-serif text-2xl\">The essentials</h2>\n+        <Field label=\"Recipe title\" name=\"title\" error={fields.title}><input id=\"title\" className={inputClass} placeholder=\"What’s cooking?\" value={form.title} onChange={event => update(\"title\", event.target.value)} {...accessibility(\"title\")} /></Field>\n+        <div className=\"grid gap-5 sm:grid-cols-3\"><Field label=\"Category\" name=\"category\" error={fields.category}><input id=\"category\" list=\"recipe-categories\" className={inputClass} placeholder=\"e.g. Dinner\" value={form.category} onChange={event => update(\"category\", event.target.value)} {...accessibility(\"category\")} /><datalist id=\"recipe-categories\">{categories.map(category => <option key={category} value={category} />)}</datalist></Field><Field label=\"Prep time (minutes)\" name=\"prep_minutes\" error={fields.prep_minutes}><input id=\"prep_minutes\" type=\"number\" min=\"0\" max=\"1440\" step=\"1\" className={inputClass} value={Number.isNaN(form.prep_minutes) ? \"\" : form.prep_minutes} onChange={event => update(\"prep_minutes\", event.target.value === \"\" ? NaN : Number(event.target.value))} {...accessibility(\"prep_minutes\")} /></Field><Field label=\"Servings\" name=\"servings\" error={fields.servings}><input id=\"servings\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" className={inputClass} value={Number.isNaN(form.servings) ? \"\" : form.servings} onChange={event => update(\"servings\", event.target.value === \"\" ? NaN : Number(event.target.value))} {...accessibility(\"servings\")} /></Field></div>\n+      </section>\n+      <section className=\"rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"font-serif text-2xl\">A few good ingredients</h2><p className=\"mb-5 mt-2 text-xs leading-6 text-muted\">One ingredient per row, with the quantity. We’ll keep them in this order.</p><div className=\"space-y-3\" aria-describedby={fields.ingredients ? \"ingredients-error\" : undefined}>{form.ingredients.map((ingredient, index) => <div key={index} className=\"flex items-center gap-2\"><GripVertical size={15} className=\"shrink-0 text-line\" /><span className=\"w-4 shrink-0 text-xs text-muted\">{index + 1}</span><input id={index === 0 ? \"ingredients\" : `ingredient-${index}`} aria-label={`Ingredient ${index + 1}`} className={inputClass} placeholder={index === 0 ? \"e.g. 200 g pasta\" : \"Another lovely ingredient\"} value={ingredient} onChange={event => update(\"ingredients\", form.ingredients.map((value, position) => position === index ? event.target.value : value))} {...accessibility(\"ingredients\")} /><button type=\"button\" aria-label={`Remove ingredient ${index + 1}`} onClick={() => update(\"ingredients\", form.ingredients.filter((_, position) => position !== index))} className=\"rounded-lg p-2.5 text-muted transition hover:bg-red-50 hover:text-terra\"><Trash2 size={16} /></button></div>)}</div>{fields.ingredients && <p id=\"ingredients-error\" role=\"alert\" className=\"mt-2 text-xs text-red-700\">{fields.ingredients}</p>}<button type=\"button\" disabled={form.ingredients.length >= 100} onClick={() => update(\"ingredients\", [...form.ingredients, \"\"])} className=\"mt-5 flex items-center gap-1.5 rounded-md px-1 py-1.5 text-xs font-medium text-olive hover:bg-sage disabled:opacity-50\"><Plus size={15} /> Add an ingredient</button></section>\n+      <section className=\"rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"mb-5 font-serif text-2xl\">Let’s make something good.</h2><Field label=\"Instructions\" name=\"instructions\" error={fields.instructions} hint=\"Write it just as you’d explain it to a friend. Line breaks are kept.\"><textarea id=\"instructions\" rows={9} className={`${inputClass} resize-y leading-7`} placeholder=\"Start here…\" value={form.instructions} onChange={event => update(\"instructions\", event.target.value)} {...accessibility(\"instructions\")} /></Field></section>\n+      <div className=\"flex items-center justify-between gap-4\"><p className=\"hidden text-xs text-muted sm:block\">From <span className=\"font-medium text-olive\">{username || \"your\"}</span>’s kitchen, with love.</p><div className=\"ml-auto flex gap-3\"><button type=\"button\" disabled={busy} onClick={onCancel} className={secondaryButton}>Cancel</button><button disabled={busy} className={primaryButton}>{busy ? \"Saving your recipe…\" : id ? \"Save changes\" : \"Share your recipe\"}<ArrowRight size={16} /></button></div></div>\n+    </form>}\n+  </div>;\n+}\n\n","files":[{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"delete","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n","additions":0,"deletions":4},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"add","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,138 @@\n+import { useCallback, useEffect, useState } from \"react\";\n+import { ArrowRight, Check, ChefHat, Heart, LogOut, Plus, Sprout, X } from \"lucide-react\";\n+import { api, ApiError } from \"./api\";\n+import AuthForm from \"./AuthForm\";\n+import RecipeBook from \"./RecipeBook\";\n+import RecipeDetail from \"./RecipeDetail\";\n+import RecipeForm from \"./RecipeForm\";\n+import { Modal, primaryButton } from \"./ui\";\n+\n+function storedToken() {\n+  try { return localStorage.getItem(\"table-thyme-token\") || \"\"; } catch { return \"\"; }\n+}\n+\n+export default function App() {\n+  const [path, setPath] = useState(window.location.pathname);\n+  const [token, setToken] = useState(storedToken);\n+  const [username, setUsername] = useState(\"\");\n+  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n+  const [pendingPath, setPendingPath] = useState(\"\");\n+  const [about, setAbout] = useState(false);\n+  const [notice, setNotice] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+\n+  const navigate = useCallback((next: string) => {\n+    window.history.pushState({}, \"\", next);\n+    setPath(next);\n+    window.scrollTo({ top: 0, behavior: \"instant\" });\n+  }, []);\n+\n+  const clearSession = useCallback(() => {\n+    setToken(\"\");\n+    setUsername(\"\");\n+    try { localStorage.removeItem(\"table-thyme-token\"); } catch { /* empty */ }\n+  }, []);\n+\n+  const sessionExpired = useCallback(() => {\n+    clearSession();\n+    setAuthMode(\"login\");\n+    setNotice(\"Your session has expired. Sign in to continue.\");\n+  }, [clearSession]);\n+\n+  useEffect(() => {\n+    const listener = () => setPath(window.location.pathname);\n+    window.addEventListener(\"popstate\", listener);\n+    return () => window.removeEventListener(\"popstate\", listener);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<{ username: string }>(\"/auth/me\", { signal: controller.signal }, token)\n+      .then(user => setUsername(user.username))\n+      .catch(error => {\n+        if (error instanceof ApiError && error.status === 401) clearSession();\n+        else if (!(error instanceof DOMException && error.name === \"AbortError\")) setNotice(\"Couldn’t verify your session. Try refreshing the page.\");\n+      });\n+    return () => controller.abort();\n+  }, [token, clearSession]);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 6000);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  function openAuth(mode: \"login\" | \"register\", next = \"\") {\n+    setPendingPath(next);\n+    setAuthMode(mode);\n+  }\n+\n+  function addRecipe() {\n+    if (token) navigate(\"/recipes/new\");\n+    else openAuth(\"login\", \"/recipes/new\");\n+  }\n+\n+  async function signOut() {\n+    try { await api(\"/auth/logout\", { method: \"POST\" }, token); }\n+    catch (error) {\n+      if (!(error instanceof ApiError && error.status === 401)) {\n+        setNotice(\"Couldn’t sign out. Please try again.\");\n+        return;\n+      }\n+    }\n+    clearSession();\n+    setNotice(\"You’re signed out. There’s always a seat for you here.\");\n+  }\n+\n+  const detailMatch = path.match(/^\\/recipes\\/(\\d+)\\/?$/);\n+  const editMatch = path.match(/^\\/recipes\\/(\\d+)\\/edit\\/?$/);\n+  const newRecipe = path === \"/recipes/new\";\n+  const isBook = path === \"/\" || path === \"/recipes\";\n+\n+  return <div className=\"flex min-h-dvh flex-col\">\n+    <header className=\"border-b border-line bg-cream\">\n+      <div className=\"mx-auto flex min-h-24 max-w-7xl flex-wrap items-center justify-between gap-x-5 gap-y-3 px-5 py-5 sm:px-8 lg:px-12\">\n+        <a href=\"/\" onClick={event => { event.preventDefault(); navigate(\"/\"); }} className=\"flex shrink-0 items-center gap-2.5\" aria-label=\"Table and Thyme home\">\n+          <Sprout className=\"text-olive\" size={31} strokeWidth={1.5} /><span className=\"font-serif text-[27px] tracking-[-1px] sm:text-[29px]\">Table <span className=\"italic text-olive\">&</span> Thyme<span className=\"text-terra\">.</span></span>\n+        </a>\n+        <nav aria-label=\"Main navigation\" className=\"ml-8 hidden items-center gap-8 self-stretch text-[13px] md:flex\">\n+          <a href=\"/\" onClick={event => { event.preventDefault(); navigate(\"/\"); }} aria-current={isBook ? \"page\" : undefined} className={`flex items-center border-b-2 px-1 ${isBook ? \"border-olive font-medium\" : \"border-transparent text-muted hover:text-ink\"}`}>The recipe book</a>\n+          <button onClick={() => setAbout(true)} className=\"text-muted transition hover:text-ink\">Our philosophy</button>\n+        </nav>\n+        <div className=\"ml-auto flex items-center gap-3 sm:gap-5\">\n+          {token ? <div className=\"flex items-center gap-2 sm:gap-3\"><span className=\"hidden max-w-32 truncate text-sm sm:block\">Hi, <span className=\"font-medium\">{username || \"cook\"}</span></span><button onClick={signOut} className=\"flex items-center gap-1.5 text-xs text-muted hover:text-ink\" aria-label=\"Sign out\"><LogOut size={15} /><span className=\"hidden sm:inline\">Sign out</span></button></div> : <button onClick={() => openAuth(\"login\")} className=\"px-1 text-sm font-medium transition hover:text-olive\">Sign in</button>}\n+          <button onClick={addRecipe} className={`${primaryButton} !gap-1.5 !px-3.5 !py-2.5 sm:!px-4`}><Plus size={16} /><span className=\"hidden min-[420px]:inline\">Add a recipe</span><span className=\"min-[420px]:hidden\">Add</span></button>\n+        </div>\n+      </div>\n+    </header>\n+\n+    <main className=\"mx-auto w-full max-w-7xl flex-1 px-5 sm:px-8 lg:px-12\">\n+      {isBook ? <RecipeBook revision={revision} onOpen={id => navigate(`/recipes/${id}`)} onShare={() => token ? navigate(\"/recipes/new\") : openAuth(\"register\", \"/recipes/new\")} /> :\n+        detailMatch ? <RecipeDetail key={detailMatch[1]} id={Number(detailMatch[1])} username={username} token={token} onBack={() => navigate(\"/\")} onEdit={() => navigate(`/recipes/${detailMatch[1]}/edit`)} onDeleted={() => { setRevision(value => value + 1); setNotice(\"Recipe deleted.\"); navigate(\"/\"); }} onUnauthorized={sessionExpired} /> :\n+        newRecipe || editMatch ? <RecipeForm key={editMatch?.[1] || \"new\"} id={editMatch ? Number(editMatch[1]) : undefined} token={token} username={username} onSignIn={() => openAuth(\"login\")} onCancel={() => navigate(editMatch ? `/recipes/${editMatch[1]}` : \"/\")} onSaved={recipe => { setRevision(value => value + 1); setNotice(editMatch ? \"Your recipe has been updated.\" : \"Your recipe is at the table. Thanks for sharing!\"); navigate(`/recipes/${recipe.id}`); }} onUnauthorized={sessionExpired} /> :\n+        <div className=\"py-28 text-center\"><h1 className=\"mb-4 font-serif text-4xl\">This page isn’t on the menu.</h1><button onClick={() => navigate(\"/\")} className={primaryButton}>Back to the recipe book <ArrowRight size={16} /></button></div>}\n+    </main>\n+\n+    <footer className=\"mt-16 border-t border-line\">\n+      <div className=\"mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-5 py-7 text-xs text-muted sm:flex-row sm:px-8 lg:px-12\">\n+        <span className=\"flex items-center gap-2\"><Sprout size={16} className=\"text-olive\" /> A recipe book for all of us.</span>\n+        <span className=\"flex items-center gap-1.5\">Made with care. Shared with <Heart size={12} className=\"text-terra\" />.</span>\n+        <button onClick={() => setAbout(true)} className=\"transition hover:text-ink\">A little about Table & Thyme <ArrowRight size={12} className=\"ml-1 inline\" /></button>\n+      </div>\n+    </footer>\n+\n+    {authMode && <AuthForm key={authMode} mode={authMode} onMode={setAuthMode} onClose={() => { setAuthMode(null); setPendingPath(\"\"); }} onLogin={(nextToken, name) => {\n+      try { localStorage.setItem(\"table-thyme-token\", nextToken); } catch { /* empty */ }\n+      setToken(nextToken); setUsername(name); setAuthMode(null); setNotice(`Welcome to the kitchen, ${name}.`);\n+      if (pendingPath) navigate(pendingPath);\n+      setPendingPath(\"\");\n+    }} />}\n+    {about && <Modal title=\"Good food brings us together.\" onClose={() => setAbout(false)} wide>\n+      <div className=\"mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-sage text-olive\"><ChefHat size={32} strokeWidth={1.5} /></div>\n+      <div className=\"space-y-4 text-sm leading-7 text-muted\"><p>Table & Thyme is a little corner of the internet for the recipes you make again and again. The easy weekday dinner. The pancakes everyone asks for. The dish that tastes like home.</p><p>No perfect kitchens required. Just simple ingredients, a little curiosity, and something worth sharing.</p><p>Everyone is welcome to browse. Make an account to add your own recipes, and edit them whenever inspiration strikes.</p></div>\n+      <button className={`${primaryButton} mt-7`} onClick={() => { setAbout(false); addRecipe(); }}>Share a little of your kitchen <ArrowRight size={16} /></button>\n+    </Modal>}\n+    {notice && <div role=\"status\" className=\"fixed bottom-5 left-1/2 z-50 flex w-[calc(100%-2.5rem)] max-w-lg -translate-x-1/2 items-center gap-3 rounded-xl border border-line bg-white p-4 text-sm shadow-xl\"><Check size={18} className=\"shrink-0 text-olive\" /><span className=\"flex-1\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss notification\" className=\"p-1 text-muted\"><X size={16} /></button></div>}\n+  </div>;\n+}\n","additions":138,"deletions":0},{"filePath":"/workspace/frontend/src/RecipeBook.tsx","relativePath":"frontend/src/RecipeBook.tsx","type":"add","patch":"Index: /workspace/frontend/src/RecipeBook.tsx\n===================================================================\n--- /workspace/frontend/src/RecipeBook.tsx\n+++ /workspace/frontend/src/RecipeBook.tsx\n@@ -0,0 +1,131 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { ArrowDown, ArrowRight, BookOpen, ChefHat, ChevronDown, ChevronLeft, ChevronRight, Clock3, Coffee, Heart, Leaf, Plus, Search, SlidersHorizontal, Sprout, Utensils, X } from \"lucide-react\";\n+import { api, type RecipePage, type RecipeSummary } from \"./api\";\n+import FoodArt, { dishFor } from \"./FoodArt\";\n+import { ErrorBox, Loading, primaryButton, secondaryButton } from \"./ui\";\n+\n+const categoryStyle = (category: string) => ({ Breakfast: \"bg-[#f5ead6] text-[#8c7042]\", Lunch: \"bg-[#e9efdc] text-[#62784b]\", Dinner: \"bg-[#f2e4da] text-[#9e6245]\", Dessert: \"bg-[#f1e3e7] text-[#9c6276]\" }[category] || \"bg-sage text-olive\");\n+\n+function RecipeCard({ recipe, onOpen }: { recipe: RecipeSummary; onOpen: () => void }) {\n+  return <article className=\"group overflow-hidden rounded-xl border border-line bg-white transition duration-300 hover:-translate-y-1 hover:border-olive/35 hover:shadow-lg hover:shadow-ink/5\">\n+    <a href={`/recipes/${recipe.id}`} onClick={event => { event.preventDefault(); onOpen(); }} className=\"block h-full\">\n+      <div className=\"relative aspect-[1.65] overflow-hidden bg-sage\">\n+        <FoodArt dish={dishFor(recipe.title, recipe.category)} className=\"transition duration-700 group-hover:scale-105\" />\n+        <span className={`absolute left-4 top-4 rounded-md px-2.5 py-1 text-[10px] font-semibold tracking-wide ${categoryStyle(recipe.category)}`}>{recipe.category}</span>\n+      </div>\n+      <div className=\"p-5\">\n+        <div className=\"mb-3 flex items-center gap-1.5 text-[11px] text-muted\"><Clock3 size={13} strokeWidth={1.6} />{recipe.prep_minutes} min<span className=\"mx-1.5 text-line\">|</span><span>Made for real life</span></div>\n+        <h3 className=\"min-h-7 font-serif text-[23px] leading-7 tracking-[-.45px] transition group-hover:text-olive\">{recipe.title}</h3>\n+        <div className=\"mt-5 flex items-center justify-between border-t border-line pt-4\">\n+          <div className=\"flex items-center gap-2\"><span className=\"flex h-6 w-6 items-center justify-center rounded-full bg-sage font-serif text-xs text-olive\">{recipe.author.charAt(0).toUpperCase()}</span><span className=\"text-[11px] text-muted\">From <span className=\"font-medium text-ink/80\">{recipe.author}</span>’s kitchen</span></div>\n+          <ArrowRight size={16} strokeWidth={1.5} className=\"text-olive transition group-hover:translate-x-1\" />\n+        </div>\n+      </div>\n+    </a>\n+  </article>;\n+}\n+\n+export default function RecipeBook({ revision, onOpen, onShare }: { revision: number; onOpen: (id: number) => void; onShare: () => void }) {\n+  const [category, setCategory] = useState(\"\");\n+  const [search, setSearch] = useState(\"\");\n+  const [query, setQuery] = useState(\"\");\n+  const [page, setPage] = useState(1);\n+  const [pageSize, setPageSize] = useState(6);\n+  const [categories, setCategories] = useState<string[]>([]);\n+  const [result, setResult] = useState<RecipePage | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  const book = useRef<HTMLElement>(null);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    api<{ items: string[] }>(\"/categories\", { signal: controller.signal }).then(data => setCategories(data.items)).catch(() => {});\n+    return () => controller.abort();\n+  }, [revision, retry]);\n+\n+  useEffect(() => {\n+    const timeout = window.setTimeout(() => { setQuery(search); setPage(1); }, 300);\n+    return () => window.clearTimeout(timeout);\n+  }, [search]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    const params = new URLSearchParams({ category, q: query, page: String(page), page_size: String(pageSize) });\n+    api<RecipePage>(`/recipes?${params}`, { signal: controller.signal })\n+      .then(data => {\n+        if (data.total > 0 && page > Math.ceil(data.total / pageSize)) setPage(Math.ceil(data.total / pageSize));\n+        else setResult(data);\n+      })\n+      .catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setError(caught.message); })\n+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    return () => controller.abort();\n+  }, [category, query, page, pageSize, revision, retry]);\n+\n+  function selectCategory(next: string) { setCategory(next); setPage(1); }\n+  function browse() { book.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" }); }\n+  const tabs = [...[\"Breakfast\", \"Lunch\", \"Dinner\", \"Dessert\"].filter(item => categories.includes(item)), ...categories.filter(item => ![\"Breakfast\", \"Lunch\", \"Dinner\", \"Dessert\"].includes(item))];\n+  const pages = Math.max(1, Math.ceil((result?.total || 0) / pageSize));\n+\n+  return <>\n+    <section className=\"relative mt-9 overflow-hidden rounded-2xl bg-[#edf0e7] md:mt-10\" aria-labelledby=\"hero-heading\">\n+      <div className=\"relative z-10 px-7 pb-8 pt-10 sm:px-10 lg:px-12 lg:py-12 md:w-[53%]\">\n+        <div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[2px] text-olive\"><span className=\"h-1.5 w-1.5 rounded-full bg-olive\" /> FROM OUR KITCHENS TO YOURS</div>\n+        <h1 id=\"hero-heading\" className=\"font-serif text-[43px] leading-[1.13] tracking-[-1.6px] sm:text-[52px] lg:text-[58px]\">A little inspiration.<br />A lot of <span className=\"italic text-olive\">good food.</span></h1>\n+        <p className=\"mt-5 max-w-sm text-[13px] leading-[1.9] text-muted\">Everyday recipes. Something for every craving.<br className=\"hidden lg:block\" /> A collection made by home cooks, for home cooks.</p>\n+        <div className=\"mt-7 flex flex-wrap items-center gap-5\">\n+          <button onClick={browse} className={`${primaryButton} !px-5 !text-xs`}>Explore the recipes <ArrowDown size={15} /></button>\n+          <button onClick={onShare} className=\"flex items-center gap-1.5 text-xs font-medium text-olive underline decoration-olive/30 underline-offset-4 transition hover:text-ink\">Share your favorite <ArrowRight size={14} /></button>\n+        </div>\n+      </div>\n+      <div className=\"relative h-60 md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[51%]\">\n+        <FoodArt hero />\n+        <div className=\"absolute right-6 top-5 flex h-[83px] w-[83px] rotate-12 flex-col items-center justify-center rounded-full border border-olive/35 bg-[#edf0e7]/80 text-olive backdrop-blur-sm lg:right-8 lg:top-7\"><Sprout size={21} strokeWidth={1.3} /><span className=\"mt-1 text-[8px] font-medium tracking-[1.1px]\">FRESH IDEAS</span><span className=\"mt-0.5 font-serif text-[10px] italic\">every day</span></div>\n+        <div className=\"absolute bottom-6 left-7 flex -rotate-3 items-center gap-3 rounded-lg border border-white/70 bg-cream/95 px-4 py-3 shadow-sm md:bottom-8 md:left-9\"><Heart size={18} strokeWidth={1.5} className=\"text-terra\" /><span className=\"font-serif text-sm italic\">Good food. Good company.</span></div>\n+      </div>\n+    </section>\n+\n+    <div className=\"mt-5 grid grid-cols-1 gap-3 border-b border-line pb-6 text-[11px] text-muted min-[540px]:grid-cols-3 min-[540px]:gap-1\">\n+      <span className=\"flex items-center justify-center gap-2\"><Leaf size={15} strokeWidth={1.5} className=\"text-olive\" /> Simple ingredients, lovely results</span>\n+      <span className=\"flex items-center justify-center gap-2\"><ChefHat size={16} strokeWidth={1.5} className=\"text-olive\" /> From real home cooks</span>\n+      <span className=\"flex items-center justify-center gap-2\"><Heart size={14} strokeWidth={1.5} className=\"text-olive\" /> A little something for everyone</span>\n+    </div>\n+\n+    <section ref={book} className=\"scroll-mt-6 pt-9\" aria-labelledby=\"recipes-heading\">\n+      <div className=\"mb-6 flex flex-wrap items-end justify-between gap-4\">\n+        <div><div className=\"mb-2 text-[9px] font-semibold tracking-[1.8px] text-terra\">THE RECIPE BOOK</div><h2 id=\"recipes-heading\" className=\"font-serif text-[32px] leading-tight tracking-[-.7px] sm:text-[35px]\">Find your next favorite<span className=\"text-terra\">.</span></h2><p className=\"mt-2 text-xs text-muted\">A few good ingredients. A recipe worth keeping.</p></div>\n+        <span className=\"mb-1 flex items-center gap-1.5 text-[11px] text-muted\"><SlidersHorizontal size={13} strokeWidth={1.5} /> Newest additions first</span>\n+      </div>\n+\n+      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-white px-4 py-3\">\n+        <div className=\"flex max-w-full items-center gap-1 overflow-x-auto\" role=\"group\" aria-label=\"Filter by category\">\n+          <button onClick={() => selectCategory(\"\")} aria-pressed={!category} className={`flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-xs transition ${!category ? \"bg-sage font-medium text-olive\" : \"text-muted hover:bg-cream\"}`}><BookOpen size={14} />All recipes</button>\n+          {tabs.map(item => <button key={item} onClick={() => selectCategory(item)} aria-pressed={category === item} className={`flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-xs transition ${category === item ? \"bg-sage font-medium text-olive\" : \"text-muted hover:bg-cream\"}`}>{item === \"Breakfast\" ? <Coffee size={13} /> : item === \"Dinner\" ? <Utensils size={13} /> : item === \"Lunch\" ? <Leaf size={13} /> : item === \"Dessert\" ? <Heart size={13} /> : null}{item}</button>)}\n+        </div>\n+        <div className=\"flex w-full items-center gap-2 border-t border-line pt-3 lg:w-auto lg:border-0 lg:pt-0\">\n+          <div className=\"relative min-w-0 flex-1 lg:w-48\"><Search size={14} className=\"absolute left-3 top-1/2 -translate-y-1/2 text-muted\" /><input aria-label=\"Search recipe titles\" type=\"search\" value={search} onChange={event => setSearch(event.target.value)} placeholder=\"Find something delicious…\" className=\"w-full rounded-lg border border-line bg-cream py-2.5 pl-9 pr-3 text-[11px] placeholder:text-muted focus:border-olive focus:outline-none\" /></div>\n+          <div className=\"relative\"><select aria-label=\"Recipe category\" value={category} onChange={event => selectCategory(event.target.value)} className=\"max-w-36 appearance-none rounded-lg border border-line bg-cream py-2.5 pl-3 pr-7 text-[11px] text-muted focus:border-olive\"><option value=\"\">All categories</option>{categories.map(item => <option key={item}>{item}</option>)}</select><ChevronDown size={12} className=\"pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted\" /></div>\n+        </div>\n+      </div>\n+\n+      <div className=\"mb-5 flex items-center justify-between text-[11px] text-muted\" aria-live=\"polite\"><span>{loading ? \"Finding your next favorite…\" : `${result?.total || 0} ${(result?.total || 0) === 1 ? \"recipe\" : \"recipes\"}${category ? ` in ${category.toLowerCase()}` : \" to make your own\"}${query ? ` matching “${query}”` : \"\"}`}</span>{(category || search) && <button onClick={() => { setSearch(\"\"); setQuery(\"\"); selectCategory(\"\"); }} className=\"flex items-center gap-1 text-olive hover:underline\">Clear filters <X size={12} /></button>}</div>\n+\n+      {error ? <div className=\"space-y-4 py-6\"><ErrorBox message={error} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : loading ? <Loading /> : result?.items.length ? <div className=\"grid gap-6 min-[600px]:grid-cols-2 lg:grid-cols-3\">\n+        {result.items.map(recipe => <RecipeCard key={recipe.id} recipe={recipe} onOpen={() => onOpen(recipe.id)} />)}\n+        {result.items.length < pageSize && <div className=\"flex min-h-80 flex-col items-center justify-center rounded-xl border border-dashed border-olive/30 bg-sage/60 px-6 py-9 text-center\">\n+          <div className=\"relative mb-5 flex h-[72px] w-[72px] items-center justify-center rounded-full bg-[#e1e7d6]\"><BookOpen size={31} strokeWidth={1.2} className=\"-rotate-12 text-olive\" /><span className=\"absolute -right-1 bottom-0 flex h-6 w-6 items-center justify-center rounded-full border-2 border-sage bg-cream text-terra\"><Plus size={14} /></span></div>\n+          <h3 className=\"font-serif text-[25px] tracking-tight\">Your recipe belongs here.</h3><p className=\"mt-3 max-w-56 text-xs leading-6 text-muted\">That family favorite. Your latest discovery.<br />Good things are made to be shared.</p><button onClick={onShare} className=\"mt-5 flex items-center gap-2 rounded-lg border border-olive/30 bg-transparent px-4 py-2.5 text-xs font-medium text-olive transition hover:bg-olive hover:text-white\">Share a recipe <ArrowRight size={14} /></button>\n+        </div>}\n+      </div> : <div className=\"flex min-h-64 flex-col items-center justify-center rounded-xl border border-dashed border-line text-center\"><Search size={28} className=\"mb-4 text-olive\" strokeWidth={1.3} /><h3 className=\"font-serif text-2xl\">Nothing on the menu just yet.</h3><p className=\"mt-2 text-sm text-muted\">Try another title or category, or share something of your own.</p><button onClick={() => { setSearch(\"\"); setQuery(\"\"); selectCategory(\"\"); }} className={`${secondaryButton} mt-5`}>See all recipes</button></div>}\n+\n+      {!loading && !error && result && <div className=\"mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5 text-[11px] text-muted\">\n+        <div className=\"flex items-center gap-4\"><span>{result.total ? `${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, result.total)} of ${result.total} recipes` : \"0 recipes\"}</span><label className=\"hidden items-center gap-1.5 sm:flex\">Per page <select value={pageSize} onChange={event => { setPageSize(Number(event.target.value)); setPage(1); }} className=\"rounded-md border border-line bg-white px-1.5 py-1 text-ink\" aria-label=\"Recipes per page\"><option value={6}>6</option><option value={12}>12</option><option value={24}>24</option></select></label></div>\n+        <nav aria-label=\"Recipe pages\" className=\"flex items-center gap-2\"><button disabled={page === 1} onClick={() => { setPage(value => value - 1); browse(); }} className=\"flex h-8 items-center gap-1 rounded-md border border-line bg-white px-2.5 transition hover:border-olive disabled:opacity-40\"><ChevronLeft size={13} /> Previous</button><span className=\"px-2\">{page} <span className=\"px-1 text-muted/50\">/</span> {pages}</span><button disabled={page >= pages} onClick={() => { setPage(value => value + 1); browse(); }} className=\"flex h-8 items-center gap-1 rounded-md border border-line bg-white px-2.5 transition hover:border-olive disabled:opacity-40\">Next <ChevronRight size={13} /></button></nav>\n+      </div>}\n+    </section>\n+\n+    <aside className=\"mt-10 flex flex-col items-center gap-3 rounded-xl bg-[#f0ece3] px-6 py-5 text-center sm:flex-row sm:justify-between sm:text-left\"><div className=\"flex items-center gap-3\"><Sprout size={24} strokeWidth={1.3} className=\"shrink-0 text-olive\" /><div><p className=\"font-serif text-lg\">The best recipes have a story.</p><p className=\"mt-0.5 text-[11px] text-muted\">We’d love to hear yours. Make yourself at home.</p></div></div><button onClick={onShare} className=\"flex shrink-0 items-center gap-2 text-xs font-medium text-olive transition hover:text-ink\">Join our kitchen <ArrowRight size={14} /></button></aside>\n+  </>;\n+}\n","additions":131,"deletions":0},{"filePath":"/workspace/frontend/src/RecipeDetail.tsx","relativePath":"frontend/src/RecipeDetail.tsx","type":"add","patch":"Index: /workspace/frontend/src/RecipeDetail.tsx\n===================================================================\n--- /workspace/frontend/src/RecipeDetail.tsx\n+++ /workspace/frontend/src/RecipeDetail.tsx\n@@ -0,0 +1,48 @@\n+import { useEffect, useState } from \"react\";\n+import { ArrowLeft, CalendarDays, ChefHat, Clock3, Pencil, Sprout, Trash2, Users } from \"lucide-react\";\n+import { api, ApiError, type Recipe } from \"./api\";\n+import FoodArt, { dishFor } from \"./FoodArt\";\n+import { ErrorBox, Loading, Modal, secondaryButton } from \"./ui\";\n+\n+export default function RecipeDetail({ id, username, token, onBack, onEdit, onDeleted, onUnauthorized }: { id: number; username: string; token: string; onBack: () => void; onEdit: () => void; onDeleted: () => void; onUnauthorized: () => void }) {\n+  const [recipe, setRecipe] = useState<Recipe | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  const [confirm, setConfirm] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+  const [deleting, setDeleting] = useState(false);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setError(\"\");\n+    api<Recipe>(`/recipes/${id}`, { signal: controller.signal }).then(setRecipe).catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setError(caught.message); });\n+    return () => controller.abort();\n+  }, [id, retry]);\n+\n+  async function remove() {\n+    setDeleting(true);\n+    setDeleteError(\"\");\n+    try { await api(`/recipes/${id}`, { method: \"DELETE\" }, token); setConfirm(false); onDeleted(); }\n+    catch (caught) {\n+      if (caught instanceof ApiError && caught.status === 401) { setConfirm(false); onUnauthorized(); }\n+      else setDeleteError(caught instanceof Error ? caught.message : \"Couldn’t delete the recipe.\");\n+    } finally { setDeleting(false); }\n+  }\n+\n+  return <div className=\"py-9 sm:py-11\">\n+    <button onClick={onBack} className=\"mb-7 flex items-center gap-2 text-xs text-muted transition hover:text-olive\"><ArrowLeft size={15} /> Back to the recipe book</button>\n+    {error ? <div className=\"space-y-4\"><ErrorBox message={error} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : !recipe ? <Loading /> : <>\n+      <div className=\"grid overflow-hidden rounded-2xl border border-line bg-white md:grid-cols-2\">\n+        <div className=\"aspect-[1.4] md:aspect-auto md:min-h-96\"><FoodArt dish={dishFor(recipe.title, recipe.category)} /></div>\n+        <div className=\"flex flex-col justify-center p-7 sm:p-10\"><span className=\"mb-4 w-fit rounded-md bg-sage px-3 py-1.5 text-[10px] font-semibold uppercase tracking-widest text-olive\">{recipe.category}</span><h1 className=\"font-serif text-4xl leading-tight tracking-tight lg:text-[45px]\">{recipe.title}</h1><div className=\"mt-6 flex items-center gap-2.5\"><span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-sage font-serif text-olive\">{recipe.author.charAt(0).toUpperCase()}</span><span className=\"text-xs text-muted\">From <span className=\"font-medium text-ink\">{recipe.author}</span>’s kitchen</span></div><div className=\"mt-7 flex flex-wrap gap-5 border-t border-line pt-5 text-xs text-muted\"><span className=\"flex items-center gap-2\"><Clock3 size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{recipe.prep_minutes} min</b><span className=\"mt-1 block text-[10px]\">Prep time</span></span></span><span className=\"flex items-center gap-2\"><Users size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{recipe.servings} {recipe.servings === 1 ? \"serving\" : \"servings\"}</b><span className=\"mt-1 block text-[10px]\">At the table</span></span></span><span className=\"flex items-center gap-2\"><CalendarDays size={17} strokeWidth={1.5} /><span><b className=\"font-medium text-ink\">{new Date(recipe.created_at).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" })}</b><span className=\"mt-1 block text-[10px]\">Shared on</span></span></span></div>\n+          {username === recipe.author && <div className=\"mt-7 flex gap-3\"><button onClick={onEdit} className={secondaryButton}><Pencil size={14} /> Edit recipe</button><button onClick={() => { setDeleteError(\"\"); setConfirm(true); }} className=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs text-terra transition hover:bg-red-50\"><Trash2 size={14} /> Delete</button></div>}\n+        </div>\n+      </div>\n+      <div className=\"mt-10 grid gap-10 md:grid-cols-[1fr_1.8fr] lg:gap-16\">\n+        <section><div className=\"mb-5 flex items-center gap-2.5\"><Sprout size={21} strokeWidth={1.4} className=\"text-olive\" /><h2 className=\"font-serif text-[28px]\">A few good ingredients</h2></div><p className=\"mb-5 text-xs text-muted\">For {recipe.servings} {recipe.servings === 1 ? \"serving\" : \"servings\"}. A little preparation goes a long way.</p><ul className=\"divide-y divide-line rounded-xl border border-line bg-white px-5\">{recipe.ingredients.map((ingredient, index) => <li key={index} className=\"flex items-start gap-3 py-4 text-sm leading-6\"><span className=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-olive/65\" />{ingredient}</li>)}</ul></section>\n+        <section><div className=\"mb-5 flex items-center gap-2.5\"><ChefHat size={23} strokeWidth={1.4} className=\"text-olive\" /><h2 className=\"font-serif text-[28px]\">Let’s make something good.</h2></div><div className=\"whitespace-pre-wrap break-words text-sm leading-[2] text-ink/80\">{recipe.instructions}</div><div className=\"mt-8 border-t border-line pt-5 font-serif text-lg italic text-olive\">Made with care. Best enjoyed together.</div></section>\n+      </div>\n+    </>}\n+    {confirm && <Modal title=\"Take it off the menu?\" onClose={() => { if (!deleting) setConfirm(false); }}><p className=\"text-sm leading-7 text-muted\">Are you sure you want to delete <span className=\"font-medium text-ink\">{recipe?.title}</span>? This can’t be undone.</p>{deleteError && <div className=\"mt-4\"><ErrorBox message={deleteError} /></div>}<div className=\"mt-7 flex justify-end gap-3\"><button disabled={deleting} onClick={() => setConfirm(false)} className={secondaryButton}>Keep recipe</button><button disabled={deleting} onClick={remove} className=\"flex items-center gap-2 rounded-lg bg-terra px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-800 disabled:opacity-50\"><Trash2 size={15} />{deleting ? \"Deleting…\" : \"Delete recipe\"}</button></div></Modal>}\n+  </div>;\n+}\n","additions":48,"deletions":0},{"filePath":"/workspace/frontend/src/RecipeForm.tsx","relativePath":"frontend/src/RecipeForm.tsx","type":"add","patch":"Index: /workspace/frontend/src/RecipeForm.tsx\n===================================================================\n--- /workspace/frontend/src/RecipeForm.tsx\n+++ /workspace/frontend/src/RecipeForm.tsx\n@@ -0,0 +1,65 @@\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { ArrowLeft, ArrowRight, ChefHat, GripVertical, Plus, Sprout, Trash2 } from \"lucide-react\";\n+import { api, ApiError, type Recipe, type RecipeFields } from \"./api\";\n+import { ErrorBox, Field, inputClass, Loading, primaryButton, secondaryButton } from \"./ui\";\n+\n+const blank: RecipeFields = { title: \"\", category: \"\", ingredients: [\"\", \"\"], instructions: \"\", prep_minutes: 20, servings: 2 };\n+\n+export default function RecipeForm({ id, token, username, onSignIn, onCancel, onSaved, onUnauthorized }: { id?: number; token: string; username: string; onSignIn: () => void; onCancel: () => void; onSaved: (recipe: Recipe) => void; onUnauthorized: () => void }) {\n+  const [form, setForm] = useState<RecipeFields>(blank);\n+  const [categories, setCategories] = useState<string[]>([]);\n+  const [loading, setLoading] = useState(!!id);\n+  const [author, setAuthor] = useState(\"\");\n+  const [loadError, setLoadError] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<Record<string, string>>({});\n+  const [busy, setBusy] = useState(false);\n+  const [retry, setRetry] = useState(0);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    api<{ items: string[] }>(\"/categories\", { signal: controller.signal }).then(data => setCategories(data.items)).catch(() => {});\n+    if (id) {\n+      setLoading(true);\n+      setLoadError(\"\");\n+      api<Recipe>(`/recipes/${id}`, { signal: controller.signal }).then(recipe => { setForm(recipe); setAuthor(recipe.author); })\n+        .catch(caught => { if (!(caught instanceof DOMException && caught.name === \"AbortError\")) setLoadError(caught.message); })\n+        .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    }\n+    return () => controller.abort();\n+  }, [id, retry]);\n+\n+  function update<K extends keyof RecipeFields>(field: K, value: RecipeFields[K]) {\n+    setForm(current => ({ ...current, [field]: value }));\n+    setFields(current => ({ ...current, [field]: \"\" }));\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true); setError(\"\"); setFields({});\n+    try {\n+      const recipe = await api<Recipe>(id ? `/recipes/${id}` : \"/recipes\", { method: id ? \"PUT\" : \"POST\", body: JSON.stringify({ title: form.title, category: form.category, ingredients: form.ingredients, instructions: form.instructions, prep_minutes: form.prep_minutes, servings: form.servings }) }, token);\n+      onSaved(recipe);\n+    } catch (caught) {\n+      setError(caught instanceof Error ? caught.message : \"Couldn’t save your recipe. Please try again.\");\n+      if (caught instanceof ApiError) { setFields(caught.fields); if (caught.status === 401) onUnauthorized(); }\n+    } finally { setBusy(false); }\n+  }\n+\n+  function accessibility(name: string) { return { \"aria-invalid\": !!fields[name], \"aria-describedby\": fields[name] ? `${name}-error` : undefined }; }\n+\n+  return <div className=\"mx-auto max-w-3xl py-9 sm:py-11\">\n+    <button onClick={onCancel} className=\"mb-7 flex items-center gap-2 text-xs text-muted transition hover:text-olive\"><ArrowLeft size={15} />{id ? \"Back to your recipe\" : \"Back to the recipe book\"}</button>\n+    <div className=\"mb-8\"><span className=\"mb-3 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[1.8px] text-olive\"><Sprout size={16} /> A little of your kitchen</span><h1 className=\"font-serif text-4xl tracking-tight sm:text-[44px]\">{id ? \"Make it even more yours.\" : \"Something worth sharing.\"}</h1><p className=\"mt-3 text-sm leading-6 text-muted\">{id ? \"A new twist, a little refinement. Keep your recipe just the way you like it.\" : \"Simple or special, everyday or once a year. We’d love to try your favorite.\"}</p></div>\n+    {loading ? <Loading text=\"Getting your recipe ready…\" /> : loadError ? <div className=\"space-y-4\"><ErrorBox message={loadError} /><button onClick={() => setRetry(value => value + 1)} className={secondaryButton}>Try again</button></div> : !token ? <div className=\"rounded-xl border border-line bg-white p-8 text-center\"><ChefHat size={36} strokeWidth={1.4} className=\"mx-auto mb-4 text-olive\" /><h2 className=\"font-serif text-2xl\">First, make yourself at home.</h2><p className=\"my-4 text-sm text-muted\">Sign in to share and manage your recipes.</p><button onClick={onSignIn} className={primaryButton}>Sign in to continue <ArrowRight size={16} /></button></div> : id && username && author !== username ? <ErrorBox message=\"Only the author can edit this recipe. You can still make and share a recipe of your own.\" /> : <form noValidate onSubmit={submit} className=\"space-y-7\">\n+      {error && <ErrorBox message={error} />}\n+      <section className=\"space-y-5 rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"mb-1 font-serif text-2xl\">The essentials</h2>\n+        <Field label=\"Recipe title\" name=\"title\" error={fields.title}><input id=\"title\" className={inputClass} placeholder=\"What’s cooking?\" value={form.title} onChange={event => update(\"title\", event.target.value)} {...accessibility(\"title\")} /></Field>\n+        <div className=\"grid gap-5 sm:grid-cols-3\"><Field label=\"Category\" name=\"category\" error={fields.category}><input id=\"category\" list=\"recipe-categories\" className={inputClass} placeholder=\"e.g. Dinner\" value={form.category} onChange={event => update(\"category\", event.target.value)} {...accessibility(\"category\")} /><datalist id=\"recipe-categories\">{categories.map(category => <option key={category} value={category} />)}</datalist></Field><Field label=\"Prep time (minutes)\" name=\"prep_minutes\" error={fields.prep_minutes}><input id=\"prep_minutes\" type=\"number\" min=\"0\" max=\"1440\" step=\"1\" className={inputClass} value={Number.isNaN(form.prep_minutes) ? \"\" : form.prep_minutes} onChange={event => update(\"prep_minutes\", event.target.value === \"\" ? NaN : Number(event.target.value))} {...accessibility(\"prep_minutes\")} /></Field><Field label=\"Servings\" name=\"servings\" error={fields.servings}><input id=\"servings\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" className={inputClass} value={Number.isNaN(form.servings) ? \"\" : form.servings} onChange={event => update(\"servings\", event.target.value === \"\" ? NaN : Number(event.target.value))} {...accessibility(\"servings\")} /></Field></div>\n+      </section>\n+      <section className=\"rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"font-serif text-2xl\">A few good ingredients</h2><p className=\"mb-5 mt-2 text-xs leading-6 text-muted\">One ingredient per row, with the quantity. We’ll keep them in this order.</p><div className=\"space-y-3\" aria-describedby={fields.ingredients ? \"ingredients-error\" : undefined}>{form.ingredients.map((ingredient, index) => <div key={index} className=\"flex items-center gap-2\"><GripVertical size={15} className=\"shrink-0 text-line\" /><span className=\"w-4 shrink-0 text-xs text-muted\">{index + 1}</span><input id={index === 0 ? \"ingredients\" : `ingredient-${index}`} aria-label={`Ingredient ${index + 1}`} className={inputClass} placeholder={index === 0 ? \"e.g. 200 g pasta\" : \"Another lovely ingredient\"} value={ingredient} onChange={event => update(\"ingredients\", form.ingredients.map((value, position) => position === index ? event.target.value : value))} {...accessibility(\"ingredients\")} /><button type=\"button\" aria-label={`Remove ingredient ${index + 1}`} onClick={() => update(\"ingredients\", form.ingredients.filter((_, position) => position !== index))} className=\"rounded-lg p-2.5 text-muted transition hover:bg-red-50 hover:text-terra\"><Trash2 size={16} /></button></div>)}</div>{fields.ingredients && <p id=\"ingredients-error\" role=\"alert\" className=\"mt-2 text-xs text-red-700\">{fields.ingredients}</p>}<button type=\"button\" disabled={form.ingredients.length >= 100} onClick={() => update(\"ingredients\", [...form.ingredients, \"\"])} className=\"mt-5 flex items-center gap-1.5 rounded-md px-1 py-1.5 text-xs font-medium text-olive hover:bg-sage disabled:opacity-50\"><Plus size={15} /> Add an ingredient</button></section>\n+      <section className=\"rounded-xl border border-line bg-white p-6 sm:p-8\"><h2 className=\"mb-5 font-serif text-2xl\">Let’s make something good.</h2><Field label=\"Instructions\" name=\"instructions\" error={fields.instructions} hint=\"Write it just as you’d explain it to a friend. Line breaks are kept.\"><textarea id=\"instructions\" rows={9} className={`${inputClass} resize-y leading-7`} placeholder=\"Start here…\" value={form.instructions} onChange={event => update(\"instructions\", event.target.value)} {...accessibility(\"instructions\")} /></Field></section>\n+      <div className=\"flex items-center justify-between gap-4\"><p className=\"hidden text-xs text-muted sm:block\">From <span className=\"font-medium text-olive\">{username || \"your\"}</span>’s kitchen, with love.</p><div className=\"ml-auto flex gap-3\"><button type=\"button\" disabled={busy} onClick={onCancel} className={secondaryButton}>Cancel</button><button disabled={busy} className={primaryButton}>{busy ? \"Saving your recipe…\" : id ? \"Save changes\" : \"Share your recipe\"}<ArrowRight size={16} /></button></div></div>\n+    </form>}\n+  </div>;\n+}\n","additions":65,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD frontend/src/App.tsx\nA frontend/src/App.tsx\nA frontend/src/RecipeBook.tsx\nA frontend/src/RecipeDetail.tsx\nA frontend/src/RecipeForm.tsx","time":{"start":1794308113924,"end":1794308113943}},"metadata":{"openrouter":{"reasoning_details":[{"type"