neConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,17 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"noEmit\": true,\n+    \"esModuleInterop\": true,\n+    \"skipLibCheck\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,19 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import hooks from \"eslint-plugin-react-hooks\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+    plugins: { \"react-hooks\": hooks },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"error\",\n+    },\n+  },\n+);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,20 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Helvetica Neue\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-cream: #faf9f6;\n+  --color-ink: #293d32;\n+  --color-muted: #7a7d72;\n+  --color-line: #e7e7df;\n+  --color-olive: #566d4c;\n+  --color-sage: #edf0e7;\n+  --color-terra: #b56648;\n+}\n+\n+@layer base {\n+  body { @apply m-0 bg-cream font-sans text-ink antialiased; }\n+  button, a, input, select, textarea { @apply focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-olive; }\n+  button { @apply cursor-pointer disabled:cursor-not-allowed; }\n+  ::selection { @apply bg-olive/20; }\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,11 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#faf9f6\" />\n+    <meta name=\"description\" content=\"A little inspiration, a lot of good food. Discover and share recipes made for everyday life at Table & Thyme.\" />\n+    <title>Table & Thyme — Recipes worth sharing</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\n","files":[{"filePath":"/workspace/backend/requirements.lock","relativePath":"backend/requirements.lock","type":"delete","patch":"Index: /workspace/backend/requirements.lock\n============