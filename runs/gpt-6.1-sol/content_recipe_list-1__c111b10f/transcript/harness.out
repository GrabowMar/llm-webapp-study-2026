     {Array.from({ length: 35 }, (_, i) => <ellipse key={i} cx={262 + (i * 47) % 91} cy={142 + (i * 31) % 100} rx={1 + i % 3} ry=\"1.5\" fill=\"#7c502d\" opacity=\".5\" />)}\n+            </g>\n+            {lemon(221, 158, -65, \"lemon1\")}{lemon(385, 257, 100, \"lemon2\")}{lemon(251, 300, -5, \"lemon3\")}\n+            {[0, 1, 2].map(i => <g key={i} transform={`translate(${276 + i * 25} ${165 + i * 28}) rotate(${35 + i * 40})`}>\n+              <path d=\"M0 0V85\" stroke=\"#526446\" strokeWidth=\"3\" />\n+              {[10, 25, 40, 55, 70].map(y => <path key={y} d={`M0 ${y}l-13-10M0 ${y + 4}l13-10`} stroke=\"#56724b\" strokeWidth=\"3\" strokeLinecap=\"round\" />)}\n+            </g>)}\n+          </>}\n+          {dish === \"pancakes\" && <>\n+            {[0, 1, 2, 3].map(i => <g key={i} transform={`translate(${i % 2 * 4} ${-i * 13})`}>\n+              <ellipse cx=\"306\" cy=\"235\" rx=\"103\" ry=\"68\" fill=\"#a86c36\" />\n+              <ellipse cx=\"306\" cy=\"226\" rx=\"103\" ry=\"68\" fill={ref(\"cake\")} />\n+              <path d=\"M205 224Q210 287 306 291Q400 286 408 225\" stroke=\"#ebc594\" strokeWidth=\"4\" fill=\"none\" />\n+            </g>)}\n+            <path d=\"M267 152Q310 126 351 156Q380 167 367 189L339 221Q323 244 309 219Q298 202 281 217Q256 224 246 206Q245 185 267 152Z\" fill=\"#a9682c\" opacity=\".75\" />\n+            <path d=\"M303 227Q299 261 305 294\" stroke=\"#ab682a\" strokeWidth=\"9\" strokeLinecap=\"round\" />\n+            <path d=\"M282 154L316 143L335 166L300 181Z\" fill=\"#f7e8a7\" stroke=\"#ebd187\" strokeWidth=\"2\" />\n+            {[[247, 158], [260, 141], [269, 161], [363, 216], [376, 202], [247, 288], [221, 260], [333, 128], [348, 142], [386, 258]].map(([x, y], i) => <g key={i}>\n+              <circle cx={x} cy={y} r=\"10\" fill={ref(\"berry\")} /><path d={`M${x - 3} ${y - 3}l3-3 3 3-3 2Z`} fill=\"#333a55\" />\n+            </g>)}\n+            {leaf(336, 153, 30, .65)}{leaf(336, 156, -70, .6)}\n+          </>}\n+          {dish === \"galette\" && <>\n+            <path d=\"M302 88L350 101L389 128L415 171L420 216L400 262L364 297L315 310L265 303L224 275L199 234L197 186L218 140L255 107Z\" fill={ref(\"cake\")} stroke=\"#b78046\" strokeWidth=\"3\" />\n+            <circle cx=\"309\" cy=\"203\" r=\"91\" fill=\"#a13d2c\" />\n+            {Array.from({ length: 32 }, (_, i) => {\n+              const a = i * 2.4;\n+              const r = Math.sqrt(i / 32) * 76;\n+              return <g key={i} transform={`translate(${307 + Math.cos(a) * r} ${202 + Math.sin(a) * r}) rotate(${i * 45})`}>\n+                <path d=\"M-14-10Q0-30 15-9Q18 3 0 22Q-18 3-14-10Z\" fill={ref(\"tomato\")} stroke=\"#ce5341\" strokeWidth=\"1\" />\n+                <path d=\"M0-13Q-8 0 0 16Q8 0 0-13Z\" fill=\"#ffb191\" opacity=\".7\" />\n+                {[-7, 7].map(x => <path key={x} d={`M${x}-5v3M${x} 3v3`} stroke=\"#f4d68d\" strokeWidth=\"1.5\" />)}\n+              </g>;\n+            })}\n+            <path d=\"M300 90L340 105L324 130L287 127L262 141L226 151L215 187L230 216L229 257L270 269L305 283L339 270L373 262L384 224L394 185L373 155L353 132L350 103\" fill=\"none\" stroke=\"#ddb07a\" strokeWidth=\"23\" strokeLinejoin=\"round\" />\n+            <path d=\"M248 130L235 151M203 191L219 194M253 284L260 264M335 296L329 277M400 238L381 232\" stroke=\"#a97440\" strokeWidth=\"2\" opacity=\".6\" />\n+            <circle cx=\"323\" cy=\"177\" r=\"33\" fill={ref(\"cheese\")} /><path d=\"M301 171Q330 149 342 176M303 187Q321 171 345 189\" fill=\"none\" stroke=\"#fffcf1\" strokeWidth=\"4\" />\n+            {leaf(330, 174, 40, .6)}{leaf(329, 174, -60, .55)}\n+          </>}\n+        </g>\n+        {Array.from({ length: 38 }, (_, i) => {\n+          const a = i * 2.4;\n+          const r = Math.sqrt(i / 38) * 118;\n+          return <circle key={i} cx={307 + Math.cos(a) * r} cy={202 + Math.sin(a) * r} r={i % 3 === 0 ? 1.5 : .8} fill=\"#3e4528\" opacity=\".45\" />;\n+        })}\n+      </g>\n+      <g transform={hero ? \"translate(556 96) rotate(16)\" : \"translate(512 83) rotate(16)\"} filter={ref(\"smallshadow\")} opacity=\".85\">\n+        <path d=\"M-6 3V54Q-6 66 0 66Q6 66 6 54V3M-14 2V48Q-14 57 0 57Q14 57 14 48V2M0 61V236\" fill=\"none\" stroke=\"#e6e7df\" strokeWidth=\"5\" strokeLinecap=\"round\" />\n+        <path d=\"M1 68V230\" stroke=\"#a3a69c\" strokeWidth=\"2\" />\n+      </g>\n+      {hero && <g transform=\"translate(64 72) rotate(-30)\">\n+        <path d=\"M0 0Q5 50 20 115\" stroke=\"#60704b\" strokeWidth=\"3\" fill=\"none\" />\n+        {[15, 35, 55, 75, 95].map((y, i) => <g key={y}>{leaf(y / 8, y, -70, .45)}{leaf(y / 8, y + 5, 65, .4)}</g>)}\n+      </g>}\n+      <path d=\"M0 0H600V400H0Z\" fill=\"transparent\" filter={ref(\"grain\")} opacity=\".65\" />\n+    </svg>\n+  );\n+}\n*** Add File: /workspace/frontend/src/api.ts\n+export type RecipeSummary = {\n+  id: number;\n+  title: string;\n+  category: string;\n+  prep_minutes: number;\n+  author: string;\n+};\n+\n+export type Recipe = RecipeSummary & {\n+  ingredients: string[];\n+  instructions: string;\n+  servings: number;\n+  created_at: string;\n+};\n+\n+export type RecipeFields = Pick<Recipe, \"title\" | \"category\" | \"prep_minutes\" | \"servings\" | \"ingredients\" | \"instructions\">;\n+export type RecipePage = { items: RecipeSummary[]; total: number; page: number; page_size: number };\n+\n+export class ApiError extends Error {\n+  constructor(message: string, public status: number, public fields: Record<string, string> = {}) {\n+    super(message);\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {\n+  const headers = new Headers(options.headers);\n+  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n+  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, { ...options, headers });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"We couldn’t reach the kitchen. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json();\n+  if (!response.ok) throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status, data.errors);\n+  return data as T;\n+}\n*** Add File: /workspace/frontend/src/ui.tsx\n+import { useEffect, useRef, type ReactNode } from \"react\";\n+import { X } from \"lucide-react\";\n+\n+export const primaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg bg-ink px-5 py-3 text-sm font-medium text-white transition hover:bg-olive disabled:opacity-50\";\n+export const secondaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-white px-4 py-2.5 text-sm font-medium transition hover:border-olive hover:bg-sage disabled:opacity-40\";\n+export const inputClass = \"w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm text-ink placeholder:text-muted/70 focus:border-olive focus:outline-2 focus:outline-offset-0 focus:outline-olive/20\";\n+\n+export function Modal({ title, onClose, children, wide = false }: { title: string; onClose: () => void; children: ReactNode; wide?: boolean }) {\n+  const dialog = useRef<HTMLDialogElement>(null);\n+  useEffect(() => {\n+    const element = dialog.current;\n+    element?.showModal();\n+    const overflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => {\n+      element?.close();\n+      document.body.style.overflow = overflow;\n+    };\n+  }, []);\n+  return <dialog ref={dialog} onCancel={onClose} onClick={event => { if (event.target === event.currentTarget) onClose(); }} aria-labelledby=\"modal-title\" className={`fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] ${wide ? \"max-w-xl\" : \"max-w-md\"} overflow-y-auto rounded-2xl border-0 bg-cream p-7 text-ink shadow-2xl backdrop:bg-ink/45 backdrop:backdrop-blur-sm sm:p-9`}>\n+    <div className=\"mb-6 flex items-start justify-between gap-4\">\n+      <h2 id=\"modal-title\" className=\"font-serif text-3xl tracking-tight\">{title}</h2>\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"-mr-2 -mt-1 rounded-full p-2 text-muted transition hover:bg-sage hover:text-ink\"><X size={20} /></button>\n+    </div>\n+    {children}\n+  </dialog>;\n+}\n+\n+export function Field({ label, name, error, children, hint }: { label: string; name: string; error?: string; children: ReactNode; hint?: string }) {\n+  return <div>\n+    <label htmlFor={name} className=\"mb-2 block text-sm font-medium\">{label}</label>\n+    {children}\n+    {error ? <p id={`${name}-error`} role=\"alert\" className=\"mt-1.5 text-xs text-red-700\">{error}</p> : hint ? <p className=\"mt-1.5 text-xs text-muted\">{hint}</p> : null}\n+  </div>;\n+}\n+\n+export function ErrorBox({ message }: { message: string }) {\n+  return <div role=\"alert\" className=\"rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800\">{message}</div>;\n+}\n+\n+export function Loading({ text = \"Gathering something delicious…\" }: { text?: string }) {\n+  return <div role=\"status\" className=\"flex min-h-48 flex-col items-center justify-center gap-4 text-sm text-muted\"><span className=\"h-6 w-6 animate-spin rounded-full border-2 border-line border-t-olive\" />{text}</div>;\n+}\n*** Add File: /workspace/frontend/src/AuthForm.tsx\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, Sprout } from \"lucide-react\";\n+import { api, ApiError } from \"./api\";\n+import { ErrorBox, Field, inputClass, Modal, primaryButton } from \"./ui\";\n+\n+export default function AuthForm({ mode, onMode, onClose, onLogin }: { mode: \"login\" | \"register\"; onMode: (mode: \"login\" | \"register\") => void; onClose: () => void; onLogin: (token: string, username: string) => void }) {\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<Record<string, string>>({});\n+  const registering = mode === \"register\";\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    try {\n+      const body = JSON.stringify({ username, password });\n+      if (registering) await api(\"/auth/register\", { method: \"POST\", body });\n+      const result = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, result.token);\n+      onLogin(result.token, user.username);\n+    } catch (caught) {\n+      setError(caught instanceof Error ? caught.message : \"Unable to sign in. Please try again.\");\n+      if (caught instanceof ApiError) setFields(caught.fields);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return <Modal title={registering ? \"A seat at the table.\" : \"Welcome back.\"} onClose={onClose}>\n+    <div className=\"mb-6 flex items-start gap-3 text-sm leading-relaxed text-muted\"><Sprout size={25} className=\"mt-1 shrink-0 text-olive\" /><p>{registering ? \"Good recipes are even better when shared. Join our little community of home cooks.\" : \"Sign in to share a new favorite or make a little change to your recipes.\"}</p></div>\n+    <form onSubmit={submit} noValidate className=\"space-y-5\">\n+      {error && <ErrorBox message={error} />}\n+      <Field name=\"username\" label=\"Username\" error={fields.username} hint={registering ? \"3–30 letters, numbers, dots, hyphens or underscores.\" : undefined}>\n+        <input id=\"username\" autoFocus autoComplete=\"username\" value={username} onChange={event => setUsername(event.target.value)} className={inputClass} placeholder=\"Your kitchen name\" aria-invalid={!!fields.username} aria-describedby={fields.username ? \"username-error\" : undefined} />\n+      </Field>\n+      <Field name=\"password\" label=\"Password\" error={fields.password} hint={registering ? \"At least 8 characters. Make it a good one.\" : undefined}>\n+        <input id=\"password\" type=\"password\" autoComplete={registering ? \"new-password\" : \"current-password\"} value={password} onChange={event => setPassword(event.target.value)} className={inputClass} placeholder=\"Your password\" aria-invalid={!!fields.password} aria-describedby={fields.password ? \"password-error\" : undefined} />\n+      </Field>\n+      <button disabled={busy} className={`${primaryButton} w-full`}>{busy ? \"Just a moment…\" : registering ? \"Create your account\" : \"Sign in\"}<ArrowRight size={16} /></button>\n+    </form>\n+    <p className=\"mt-6 border-t border-line pt-5 text-center text-sm text-muted\">{registering ? \"Already part of the kitchen?\" : \"New to Table & Thyme?\"} <button onClick={() => onMode(registering ? \"login\" : \"register\")} className=\"font-medium text-olive underline decoration-olive/30 underline-offset-4\">{registering ? \"Sign in\" : \"Create an account\"}</button></p>\n+  </Modal>;\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nA frontend/src/FoodArt.tsx\nA frontend/src/api.ts\nA frontend/src/ui.tsx\nA frontend/src/AuthForm.tsx","metadata":{"diff":"Index: /workspace/frontend/src/FoodArt.tsx\n===================================================================\n--- /workspace/frontend/src/FoodArt.tsx\n+++ /workspace/frontend/src/FoodArt.tsx\n@@ -0,0 +1,159 @@\n+import { useId } from \"react\";\n+\n+type Dish = \"chicken\" | \"pasta\" | \"salad\" | \"pancakes\" | \"galette\";\n+\n+export function dishFor(title: string, category: string): Dish {\n+  const name = title.toLowerCase();\n+  if (name.includes(\"chicken\")) return \"chicken\";\n+  if (name.includes(\"pasta\")) return 