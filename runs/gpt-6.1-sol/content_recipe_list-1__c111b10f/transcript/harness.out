\n47:   - textbox \"Recipe title\":\n48:     - /placeholder: What’s cooking?\n49:     - text: Better browser test soup\n50:   - text: Category\n51:   - combobox \"Category\": Lunch\n52:   - text: Prep time (minutes)\n53:   - spinbutton \"Prep time (minutes)\": \"20\"\n54:   - text: Servings\n55:   - spinbutton \"Servings\": \"2\"\n56:   - heading \"A few good ingredients\" [level=2]\n57:   - paragraph: One ingredient per row, with the quantity. We’ll keep them in this order.\n58:   - text: \"1\"\n59:   - textbox \"Ingredient 1\":\n60:     - /placeholder: e.g. 200 g pasta\n61:     - text: 1 onion\n62:   - button \"Remove ingredient 1\"\n63:   - text: \"2\"\n64:   - textbox \"Ingredient 2\":\n65:     - /placeholder: Another lovely ingredient\n66:     - text: 1 carrot\n67:   - button \"Remove ingredient 2\"\n68:   - button \"Add an ingredient\"\n69:   - heading \"Let’s make something good.\" [level=2]\n70:   - text: Instructions\n71:   - textbox \"Instructions\":\n72:     - /placeholder: Start here…\n73:     - text: Chop everything. Simmer gently.\n74:   - paragraph: Write it just as you’d explain it to a friend. Line breaks are kept.\n75:   - paragraph: From cook1794308415862’s kitchen, with love.\n76:   - button \"Cancel\" [disabled]\n77:   - button \"Saving your recipe…\" [disabled]\n78: - contentinfo:\n79:   - text: A recipe book for all of us. Made with care. Shared with .\n80:   - button \"A little about Table & Thyme\"\n81: ```\n82: \n83: # Test source\n84: \n85: ```ts\n86:   1  | import { expect, test } from \"@playwright/test\";\n87:   2  | \n88:   3  | test(\"public recipes, filtering, details and mobile layout\", async ({ page }) => {\n89:   4  |   const errors: string[] = [];\n90:   5  |   page.on(\"pageerror\", error => errors.push(error.message));\n91:   6  |   await page.goto(\"/\");\n92:   7  |   await expect(page.getByRole(\"heading\", { name: \"A little inspiration. A lot of good food.\" })).toBeVisible();\n93:   8  |   await expect(page.locator(\"article\")).toHaveCount(5);\n94:   9  |   await page.screenshot({ path: \"test-results/table-thyme-desktop.png\", fullPage: true });\n95:   10 |   await page.getByRole(\"button\", { name: \"Dinner\", exact: true }).click();\n96:   11 |   await expect(page.locator(\"article\")).toHaveCount(2);\n97:   12 |   await page.getByRole(\"searchbox\", { name: \"Search recipe titles\" }).fill(\"pasta\");\n98:   13 |   await expect(page.locator(\"article\")).toHaveCount(1);\n99:   14 |   await page.getByRole(\"heading\", { name: \"Creamy tomato & basil pasta\" }).click();\n100:   15 |   await expect(page.getByRole(\"heading\", { name: \"A few good ingredients\" })).toBeVisible();\n101:   16 |   await expect(page.locator(\"li\")).toHaveCount(8);\n102:   17 |   await expect(page.getByRole(\"button\", { name: \"Edit recipe\" })).toHaveCount(0);\n103:   18 |   await page.reload();\n104:   19 |   await expect(page.getByRole(\"heading\", { name: \"Creamy tomato & basil pasta\" })).toBeVisible();\n105:   20 |   await page.getByRole(\"button\", { name: \"Back to the recipe book\" }).click();\n106:   21 |   await page.setViewportSize({ width: 390, height: 844 });\n107:   22 |   await expect(page.locator(\"article\")).toHaveCount(5);\n108:   23 |   await expect(page.getByRole(\"button\", { name: \"Add\", exact: true })).toBeVisible();\n109:   24 |   await page.screenshot({ path: \"test-results/table-thyme-mobile.png\", fullPage: true });\n110:   25 |   expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n111:   26 |   expect(errors).toEqual([]);\n112:   27 | });\n113:   28 | \n114:   29 | test(\"register, validation, add, edit, delete, and sign out\", async ({ page }) => {\n115:   30 |   await page.goto(\"/\");\n116:   31 |   await page.getByRole(\"button\", { name: \"Share your favorite\" }).click();\n117:   32 |   await page.getByRole(\"button\", { name: \"Create your account\" }).click();\n118:   33 |   await expect(page.getByText(\"Password must be between 8 and 128 characters.\")).toBeVisible();\n119:   34 |   const username = `cook${Date.now()}`;\n120:   35 |   await page.getByLabel(\"Username\", { exact: true }).fill(username);\n121:   36 |   await page.getByLabel(\"Password\", { exact: true }).fill(\"a-good-secret-password\");\n122:   37 |   await page.getByRole(\"button\", { name: \"Create your account\" }).click();\n123:   38 |   await expect(page.getByRole(\"heading\", { name: \"Something worth sharing.\" })).toBeVisible();\n124:   39 |   await page.getByRole(\"button\", { name: \"Share your recipe\", exact: true }).click();\n125:   40 |   await expect(page.getByText(\"Each ingredient must contain 1–500 characters. Remove unused rows.\")).toBeVisible();\n126:   41 |   await page.getByLabel(\"Recipe title\").fill(\"Browser test soup\");\n127:   42 |   await page.getByLabel(\"Category\", { exact: true }).fill(\"Lunch\");\n128:   43 |   await page.getByLabel(\"Ingredient 1\", { exact: true }).fill(\"1 onion\");\n129:   44 |   await page.getByLabel(\"Ingredient 2\", { exact: true }).fill(\"500 ml stock\");\n130:   45 |   await page.getByRole(\"button\", { name: \"Add an ingredient\" }).click();\n131:   46 |   await page.getByLabel(\"Ingredient 3\", { exact: true }).fill(\"1 carrot\");\n132:   47 |   await page.getByRole(\"button\", { name: \"Remove ingredient 2\" }).click();\n133:   48 |   await page.getByLabel(\"Instructions\", { exact: true }).fill(\"Chop everything.\\n\\nSimmer gently.\");\n134:   49 |   await page.getByRole(\"button\", { name: \"Share your recipe\", exact: true }).click();\n135:   50 |   await expect(page.getByRole(\"heading\", { name: \"Browser test soup\" })).toBeVisible();\n136:   51 |   await expect(page.locator(\"li\")).toHaveText([\"1 onion\", \"1 carrot\"]);\n137:   52 |   await page.reload();\n138:   53 |   await expect(page.getByRole(\"button\", { name: \"Edit recipe\" })).toBeVisible();\n139:   54 |   await page.getByRole(\"button\", { name: \"Edit recipe\" }).c