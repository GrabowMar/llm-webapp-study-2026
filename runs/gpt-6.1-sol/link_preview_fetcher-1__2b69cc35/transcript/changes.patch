@@ -0,0 +1,28 @@
+@import "tailwindcss";
+
+@theme {
+  --font-sans: "Inter", "Segoe UI", Arial, sans-serif;
+  --font-serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
+  --color-ink: #2f3529;
+  --color-muted: #828579;
+  --color-paper: #fcfcf9;
+  --color-sidebar: #f3f5ee;
+  --color-line: #e6e8de;
+  --color-olive: #687c45;
+  --color-accent: #de7858;
+}
+
+@layer base {
+  body {
+    @apply m-0 bg-paper font-sans text-ink antialiased;
+  }
+  button, a, input {
+    @apply outline-none focus-visible:ring-2 focus-visible:ring-olive/60 focus-visible:ring-offset-2;
+  }
+  button {
+    @apply cursor-pointer disabled:cursor-not-allowed;
