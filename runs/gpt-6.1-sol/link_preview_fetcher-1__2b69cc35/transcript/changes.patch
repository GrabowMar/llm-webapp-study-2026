diff --git a/backend/tests/test_app.py b/backend/tests/test_app.py
new file mode 100644
index 0000000..b7ca35c
--- /dev/null
+++ b/backend/tests/test_app.py
@@ -0,0 +1,184 @@
+import hashlib
+import sqlite3
+import tempfile
+import unittest
+from contextlib import closing
+from pathlib import Path
+from unittest.mock import patch
+
+from backend.app import DIST, PREVIEW_FIELDS, create_app
+from backend.preview import PreviewError
+
+
+def fixture_preview(url="https://example.com/", title="A good find"):
+    return {
+        "url": url,
+        "final_url": "https://example.com/article",
+        "status_code": 200,
+        "title": title,
+        "description": "A useful description.",
+        "image_url": "https://example.com/image.png",
+        "fetched_at": "2026-11-10T12:00:00+00:00",
+    }
+
+
+class AppTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.config = {"TESTING": True, "DATABASE": str(Path(self.directory.name) / "app.sqlite3")}
+        self.app = create_app(self.config)
+        self.client = self.app.test_client()
+        self.headers = self.account("alice")
+
+    def tearDown(self):
+        self.directory.cleanup()
+
+    def account(self, username):
+        response = self.client.post("/api/auth/register", json={"username": username, "password": "secret"})
+        self.assertEqual(response.status_code, 201)
+        response = self.client.post("/api/auth/login", json={"username": username, "password": "secret"})
+        self.assertEqual(response.status_code, 200)
+        return {"Authorization": f"Bearer {response.json['token']}"}
+
+    def add(self, url="https://example.com/", title="A good find"):
+        with patch("backend.app.fetch_preview", return_value=fixture_preview(url, title)):
+            response = self.client.post("/api/previews", json={"url": url}, headers=self.headers)
+        self.assertEqual(response.status_code, 201)
+        return response.json
+
+    def test_health_and_unknown_api(self):
+        self.assertEqual(self.client.get("/api/health").json, {"status": "ok"})
+        response = self.client.get("/api/not-a-route")
+        self.assertEqual(response.status_code, 404)
+        self.assertIn("error", response.json)
+        self.assertEqual(self.client.post("/api/health").status_code, 405)
+
+    def test_registration_validation_and_duplicates(self):
+        response = self.client.post("/api/auth/register", json={"username": "alice", "password": "other"})
+        self.assertEqual(response.status_code, 409)
+        for body in (None, [], {}, {"username": 1, "password": "secret"},
+                     {"username": "   ", "password": "secret"},
+                     {"username": "user", "password": ""},
+                     {"username": "user\nname", "password": "secret"}):
+            with self.subTest(body=body):
+                response = self.client.post("/api/auth/register", json=body)
+                self.assertEqual(response.status_code, 400)
+
+    def test_login_rejects_wrong_password(self):
+        for username, password in (("alice", "wrong"), ("unknown", "secret")):
+            response = self.client.post("/api/auth/login", json={"username": username, "password": password})
+            self.assertEqual(response.status_code, 401)
+        self.assertEqual(self.client.get("/api/auth/me", headers=self.headers).json, {"username": "alice"})
+
+    def test_credentials_and_tokens_are_hashed(self):
+        with closing(sqlite3.connect(self.config["DATABASE"])) as database:
+            password_hash = database.execute("SELECT password_hash FROM users").fetchone()[0]
+            token_hash = database.execute("SELECT token_hash FROM tokens").fetchone()[0]
+        token = self.headers["Authorization"].split()[1]
+        self.assertNotEqual(password_hash, "secret")
+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())
+
+    def test_all_preview_routes_require_authentication(self):
+        for method, path in (("GET", "/api/previews"), ("POST", "/api/previews"),
+                             ("GET", "/api/previews/1"), ("POST", "/api/previews/1/refresh"),
+                             ("DELETE", "/api/previews/1")):
+            for authorization in (None, "Bearer invalid", "Basic invalid", "Bearer"):
+                with self.subTest(method=method, path=path, authorization=authorization):
+                    response = self.client.open(path, method=method, headers={"Authorization": authorization} if authorization else {})
+                    self.assertEqual(response.status_code, 401)
+
+    def test_create_get_and_delete(self):
+        preview = self.add()
+        self.assertEqual(set(preview), set(PREVIEW_FIELDS))
+        self.assertEqual(self.client.get(f"/api/previews/{preview['id']}", headers=self.headers).json, preview)
+        response = self.client.delete(f"/api/previews/{preview['id']}", headers=self.headers)
+        self.assertEqual(response.status_code, 204)
+        self.assertEqual(self.client.get(f"/api/previews/{preview['id']}", headers=self.headers).status_code, 404)
+
+    def test_users_cannot_read_refresh_or_delete_each_others_links(self):
+        preview = self.add()
+        bob = self.account("bob")
+        self.assertEqual(self.client.get("/api/previews", headers=bob).json["total"], 0)
+        with patch("backend.app.fetch_preview") as fetch:
+            for method, suffix in (("GET", ""), ("POST", "/refresh"), ("DELETE", "")):
+                response = self.client.open(f"/api/previews/{preview['id']}{suffix}", method=method, headers=bob)
+                self.assertEqual(response.status_code, 404)
+            fetch.assert_not_called()
+        self.assertEqual(self.client.get(f"/api/previews/{preview['id']}", headers=self.headers).status_code, 200)
+
+    def test_pagination_is_newest_first(self):
+        previews = [self.add(title=f"Link {index}") for index in range(5)]
+        response = self.client.get("/api/previews?page=2&page_size=2", headers=self.headers)
+        self.assertEqual(response.json, {"items": [previews[2], previews[1]], "total": 5, "page": 2, "page_size": 2})
+        self.assertEqual(self.client.get("/api/previews?page=10&page_size=2", headers=self.headers).json["items"], [])
+
+    def test_invalid_pagination(self):
+        for query in ("page=0", "page=-1", "page=no", "page=1.2", "page_size=0", "page_size=101", "page_size=no"):
+            with self.subTest(query=query):
+                self.assertEqual(self.client.get(f"/api/previews?{query}", headers=self.headers).status_code, 400)
+
+    def test_refresh_updates_without_reordering(self):
+        first = self.add()
+        second = self.add()
+        updated = fixture_preview(title="Fresh title")
+        updated["fetched_at"] = "2026-11-11T12:00:00+00:00"
+        with patch("backend.app.fetch_preview", return_value=updated) as fetch:
+            response = self.client.post(f"/api/previews/{first['id']}/refresh", headers=self.headers)
+            fetch.assert_called_once_with(first["url"])
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json["id"], first["id"])
+        self.assertEqual(response.json["title"], "Fresh title")
+        items = self.client.get("/api/previews", headers=self.headers).json["items"]
+        self.assertEqual([item["id"] for item in items], [second["id"], first["id"]])
+
+    def test_failed_fetch_does_not_save_or_destroy_preview(self):
+        original = self.add()
+        with patch("backend.app.fetch_preview", side_effect=PreviewError("Unreachable", 502)):
+            self.assertEqual(self.client.post("/api/previews", json={"url": "https://example.com"}, headers=self.headers).status_code, 502)
+            self.assertEqual(self.client.post(f"/api/previews/{original['id']}/refresh", headers=self.headers).status_code, 502)
+        self.assertEqual(self.client.get(f"/api/previews/{original['id']}", headers=self.headers).json, original)
+        self.assertEqual(self.client.get("/api/previews", headers=self.headers).json["total"], 1)
+
+    def test_invalid_url_and_json_are_json_errors(self):
+        for body in ({}, {"url": "file:///etc/passwd"}, {"url": "javascript:alert(1)"}, {"url": 42}, []):
+            response = self.client.post("/api/previews", json=body, headers=self.headers)
+            self.assertEqual(response.status_code, 400)
+            self.assertIn("error", response.json)
+
+    def test_accounts_tokens_and_previews_survive_restart(self):
+        preview = self.add()
+        restarted = create_app(self.config).test_client()
+        self.assertEqual(restarted.get(f"/api/previews/{preview['id']}", headers=self.headers).json, preview)
+        self.assertEqual(restarted.get("/api/auth/me", headers=self.headers).json, {"username": "alice"})
+
+    def test_logout_revokes_token(self):
+        self.assertEqual(self.client.post("/api/auth/logout", headers=self.headers).status_code, 204)
+        self.assertEqual(self.client.get("/api/previews", headers=self.headers).status_code, 401)
+
+    def test_expired_token_is_rejected(self):
+        with closing(sqlite3.connect(self.config["DATABASE"])) as database, database:
+            database.execute("UPDATE tokens SET expires_at = '2000-01-01T00:00:00+00:00'")
+        self.assertEqual(self.client.get("/api/previews", headers=self.headers).status_code, 401)
+
+    def test_request_size_is_bounded(self):
+        response = self.client.post("/api/previews", json={"url": "x" * 20000}, headers=self.headers)
+        self.assertEqual(response.status_code, 413)
+        self.assertIn("error", response.json)
+
+    @unittest.skipUnless((DIST / "index.html").is_file(), "Build the frontend to test static serving.")
+    def test_production_frontend_and_assets_are_served(self):
+        response = self.client.get("/")
+        self.assertEqual(response.status_code, 200)
+        self.assertIn(b"Marginal", response.data)
+        response.close()
+        response = self.client.get("/illustration.svg")
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.mimetype, "image/svg+xml")
+        response.close()
+        response = self.client.get("/a/frontend/route")
+        self.assertEqual(response.status_code, 200)
+        response.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/backend/tests/test_preview.py b/backend/tests/test_preview.py
new file mode 100644
index 0000000..4aca70c
--- /dev/null
+++ b/backend/tests/test_preview.py
@@ -0,0 +1,168 @@
+import socket
+import threading
+import unittest
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import patch
+
+from backend.preview import PreviewError, fetch_preview, parse_page, public_addresses, validated_url
+
+
+class MetadataTests(unittest.TestCase):
+    def parse(self, html, url="https://example.com/articles/page", content_type="text/html"):
+        return parse_page(html.encode(), content_type, url)
+
+    def test_open_graph_takes_precedence_and_is_plain_text(self):
+        result = self.parse("""
+            <title>Fallback title</title>
+            <meta name="description" content="Fallback description">
+            <META content="&lt;b&gt;Good &amp; curious&lt;/b&gt;" PROPERTY="og:title">
+            <meta property="og:description" content="&lt;script&gt;bad()&lt;/script&gt;Plain &lt;i&gt;text&lt;/i&gt;">
+            <meta property="og:image" content="../cover.png">
+        """)
+        self.assertEqual(result, {"title": "Good & curious", "description": "Plain text", "image_url": "https://example.com/cover.png"})
+
+    def test_title_and_description_fallback(self):
+        result = self.parse('<title> Hello &amp;  world </title><meta content="A short summary" name="description">')
+        self.assertEqual(result["title"], "Hello & world")
+        self.assertEqual(result["description"], "A short summary")
+        self.assertIsNone(result["image_url"])
+
+    def test_empty_or_unsafe_open_graph_falls_back(self):
+        result = self.parse('<title>Good title</title><meta property="og:title" content="&lt;script&gt;bad()&lt;/script&gt;"><meta name="description" content="Good description"><meta property="og:description" content=" ">')
+        self.assertEqual(result["title"], "Good title")
+        self.assertEqual(result["description"], "Good description")
+
+    def test_missing_metadata(self):
+        self.assertEqual(self.parse("<html><body>No metadata</body></html>"), {"title": "", "description": "", "image_url": None})
+
+    def test_unsafe_image_urls_are_discarded(self):
+        for image in ("javascript:alert(1)", "data:text/html,bad", "http://127.0.0.1/image", "http://localhost/image", "http://[::1]/image", "http://user:pass@example.com/image"):
+            with self.subTest(image=image):
+                self.assertIsNone(self.parse(f'<meta property="og:image" content="{image}">')["image_url"])
+
+    def test_protocol_relative_image_and_first_tag(self):
+        result = self.parse('<meta property="og:title" content="First"><meta property="og:title" content="Second"><meta property="og:image" content="//images.example.com/photo.jpg">')
+        self.assertEqual(result["title"], "First")
+        self.assertEqual(result["image_url"], "https://images.example.com/photo.jpg")
+
+    def test_charset_is_respected(self):
+        body = '<title>Café</title>'.encode("iso-8859-1")
+        self.assertEqual(parse_page(body, "text/html; charset=iso-8859-1", "https://example.com/")["title"], "Café")
+        self.assertEqual(parse_page(b"<title>Hello</title>", "text/html; charset=unknown-encoding", "https://example.com/")["title"], "Hello")
+
+    def test_metadata_lengths_are_bounded(self):
+        result = self.parse(f'<title>{"t" * 1000}</title><meta name="description" content="{"d" * 6000}">')
+        self.assertEqual(len(result["title"]), 500)
+        self.assertEqual(len(result["description"]), 5000)
+
+
+class UrlSafetyTests(unittest.TestCase):
+    def test_invalid_urls(self):
+        for value in (None, 1, "", "example.com", "file:///tmp/file", "ftp://example.com", "https://", "http://example.com:0", "http://example.com:99999", "https://a:b@example.com", "https://example.com/a\nb", "http://example.com\\@localhost"):
+            with self.subTest(value=value), self.assertRaises(PreviewError):
+                validated_url(value)
+
+    def test_unicode_url_is_encoded(self):
+        self.assertEqual(validated_url("https://example.com/café?q=é#fragment"), "https://example.com/caf%C3%A9?q=%C3%A9")
+        self.assertEqual(validated_url("https://bücher.example/"), "https://xn--bcher-kva.example/")
+
+    def test_private_reserved_and_mixed_addresses_are_blocked(self):
+        for address in ("127.0.0.1", "10.0.0.1", "192.168.1.1", "169.254.169.254", "0.0.0.0", "224.0.0.1", "::1", "fc00::1", "::ffff:8.8.8.8"):
+            with self.subTest(address=address), patch("backend.preview.socket.getaddrinfo", return_value=[(socket.AF_INET, socket.SOCK_STREAM, 6, "", (address, 80))]), self.assertRaises(PreviewError):
+                public_addresses("example.com", 80)
+        with patch("backend.preview.socket.getaddrinfo", return_value=[
+            (socket.AF_INET, socket.SOCK_STREAM, 6, "", ("8.8.8.8", 80)),
+            (socket.AF_INET, socket.SOCK_STREAM, 6, "", ("127.0.0.1", 80)),
+        ]), self.assertRaises(PreviewError):
+            public_addresses("example.com", 80)
+
+    def test_public_address_allowed_and_dns_error_is_handled(self):
+        addresses = [(socket.AF_INET, socket.SOCK_STREAM, 6, "", ("8.8.8.8", 80))]
+        with patch("backend.preview.socket.getaddrinfo", return_value=addresses):
+            self.assertEqual(public_addresses("example.com", 80), addresses)
+        with patch("backend.preview.socket.getaddrinfo", side_effect=socket.gaierror), self.assertRaises(PreviewError) as error:
+            public_addresses("example.com", 80)
+        self.assertEqual(error.exception.status, 502)
+
+
+class FixtureHandler(BaseHTTPRequestHandler):
+    def log_message(self, _format, *_args):
+        pass
+
+    def do_GET(self):
+        if self.path in ("/redirect", "/loop", "/private"):
+            self.send_response(302)
+            self.send_header("Location", {"/redirect": "/page", "/loop": "/loop", "/private": "http://127.0.0.1/private"}[self.path])
+            self.end_headers()
+            return
+        self.send_response(404 if self.path == "/missing" else 200)
+        self.send_header("Content-Type", "application/json" if self.path == "/json" else "text/html; charset=utf-8")
+        self.end_headers()
+        self.wfile.write(b'<title>Fixture title</title><meta property="og:description" content="Fixture description"><meta property="og:image" content="/cover.png">')
+
+
+class FetchTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.server = ThreadingHTTPServer(("127.0.0.1", 0), FixtureHandler)
+        cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)
+        cls.thread.start()
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.server.shutdown()
+        cls.server.server_close()
+        cls.thread.join()
+
+    def setUp(self):
+        self.base = f"http://example.com:{self.server.server_port}"
+
+        def fixture_addresses(host, port):
+            if host != "example.com":
+                raise PreviewError("Only public web links can be previewed.", 400)
+            return [(socket.AF_INET, socket.SOCK_STREAM, 6, "", ("127.0.0.1", port))]
+
+        self.patcher = patch("backend.preview.public_addresses", side_effect=fixture_addresses)
+        self.patcher.start()
+        self.addCleanup(self.patcher.stop)
+
+    def test_fetch_and_relative_redirect(self):
+        result = fetch_preview(self.base + "/redirect")
+        self.assertEqual(result["url"], self.base + "/redirect")
+        self.assertEqual(result["final_url"], self.base + "/page")
+        self.assertEqual(result["status_code"], 200)
+        self.assertEqual(result["title"], "Fixture title")
+        self.assertEqual(result["description"], "Fixture description")
+        self.assertEqual(result["image_url"], self.base + "/cover.png")
+        self.assertTrue(result["fetched_at"].endswith("+00:00"))
+
+    def test_redirect_to_private_address_is_blocked(self):
+        with self.assertRaises(PreviewError) as error:
+            fetch_preview(self.base + "/private")
+        self.assertEqual(error.exception.status, 400)
+
+    def test_original_url_is_preserved(self):
+        result = fetch_preview(self.base + "/page#section")
+        self.assertEqual(result["url"], self.base + "/page#section")
+        self.assertEqual(result["final_url"], self.base + "/page")
+
+    def test_redirect_limit(self):
+        with self.assertRaises(PreviewError) as error:
+            fetch_preview(self.base + "/loop")
+        self.assertEqual(error.exception.status, 502)
+
+    def test_non_html_is_rejected(self):
+        with self.assertRaises(PreviewError) as error:
+            fetch_preview(self.base + "/json")
+        self.assertEqual(error.exception.status, 422)
+
+    def test_error_page_status_is_retained(self):
+        self.assertEqual(fetch_preview(self.base + "/missing")["status_code"], 404)
+
+    def test_response_size_limit(self):
+        with patch("backend.preview.MAX_PAGE_BYTES", 32), self.assertRaises(PreviewError):
+            fetch_preview(self.base + "/page")
+
+
+if __name__ == "__main__":
+    unittest.main()
