{"type":"tool_use","timestamp":1794316966617,"sessionID":"ses_e3a6af12cffemPwVWkj0znar6y","part":{"type":"tool","tool":"apply_patch","callID":"call_kUZjro7Jstzn55RcqYD7ay5j","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Update File: /workspace/frontend/package.json\n@@\n-    \"build\": \"vite build\"\n+    \"build\": \"tsc --noEmit && vite build\",\n+    \"typecheck\": \"tsc --noEmit\",\n+    \"lint\": \"eslint .\"\n*** Update File: /workspace/frontend/vite.config.ts\n@@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n@@\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n*** Update File: /workspace/frontend/src/main.tsx\n@@\n import App from \"./App\";\n+import \"./index.css\";\n*** Update File: /workspace/frontend/index.html\n@@\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f7f8f2\" />\n+    <meta name=\"description\" content=\"A little corner of the internet, all yours. Save, preview, and rediscover your favorite links with Marginal.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Marginal — Good links live here</title>\n*** Add File: /workspace/frontend/tsconfig.json\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"esModuleInterop\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n*** Add File: /workspace/frontend/eslint.config.js\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"react-hooks/set-state-in-effect\": \"off\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n*** Add File: /workspace/frontend/src/index.css\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-ink: #2f3529;\n+  --color-muted: #828579;\n+  --color-paper: #fcfcf9;\n+  --color-sidebar: #f3f5ee;\n+  --color-line: #e6e8de;\n+  --color-olive: #687c45;\n+  --color-accent: #de7858;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-olive/60 focus-visible:ring-offset-2;\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  ::selection {\n+    @apply bg-olive/20;\n+  }\n+}\n*** Add File: /workspace/frontend/public/favicon.svg\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#687c45\"/><path d=\"M13 10h14v22l-7-5-7 5z\" fill=\"#fff\"/><path d=\"M18 14h4\" stroke=\"#687c45\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n*** Add File: /workspace/frontend/src/api.ts\n+export type Session = { token: string; username: string };\n+\n+export type Preview = {\n+  id: number;\n+  url: string;\n+  final_url: string;\n+  status_code: number;\n+  title: string;\n+  description: string;\n+  image_url: string | null;\n+  fetched_at: string;\n+};\n+\n+export type PreviewPage = {\n+  items: Preview[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+};\n+\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(\n+  path: string,\n+  options: { token?: string; method?: string; body?: unknown; signal?: AbortSignal } = {},\n+): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      signal: options.signal,\n+      headers: {\n+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+      },\n+      ...(options.body !== undefined ? { body: JSON.stringify(options.body) } : {}),\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Could not connect. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) {\n+    if (response.status === 401 && options.token) window.dispatchEvent(new Event(\"session-expired\"));\n+    throw new ApiError(data?.error ?? \"Something went wrong. Please try again.\", response.status);\n+  }\n+  return data as T;\n+}\n+\n+export function getStoredToken(): string | null {\n+  try {\n+    return localStorage.getItem(\"marginal-token\");\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function storeToken(token: string | null) {\n+  try {\n+    if (token) localStorage.setItem(\"marginal-token\", token);\n+    else localStorage.removeItem(\"marginal-token\");\n+  } catch {\n+    return;\n+  }\n+}\n+\n+export function hostOf(url: string): string {\n+  try {\n+    return new URL(url).hostname.replace(/^www\\./, \"\");\n+  } catch {\n+    return \"Web link\";\n+  }\n+}\n+\n+export function safeWebUrl(url: string | null): string | undefined {\n+  if (!url) return undefined;\n+  try {\n+    const parsed = new URL(url);\n+    return [\"https:\", \"http:\"].includes(parsed.protocol) ? parsed.href : undefined;\n+  } catch {\n+    return undefined;\n+  }\n+}\n*** Add File: /workspace/frontend/src/components/Dialog.tsx\n+import { useEffect, useId, useRef, type ReactNode } from \"react\";\n+import { X } from \"lucide-react\";\n+\n+export default function Dialog({ title, children, onClose, busy = false }: {\n+  title: string;\n+  children: ReactNode;\n+  onClose: () => void;\n+  busy?: boolean;\n+}) {\n+  const titleId = useId();\n+  const ref = useRef<HTMLDivElement>(null);\n+  const closeRef = useRef(onClose);\n+  closeRef.current = onClose;\n+\n+  useEffect(() => {\n+    const previous = document.activeElement as HTMLElement | null;\n+    const overflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    const panel = ref.current;\n+    panel?.querySelector<HTMLElement>(\"input, button\")?.focus();\n+    function keydown(event: KeyboardEvent) {\n+      if (event.key === \"Escape\" && !busy) closeRef.current();\n+      if (event.key === \"Tab\" && panel) {\n+        const elements = Array.from(panel.querySelectorAll<HTMLElement>(\n+          'button:not([disabled]), input:not([disabled]), a[href], [tabindex=\"0\"]',\n+        ));\n+        const first = elements[0];\n+        const last = elements[elements.length - 1];\n+        if (event.shiftKey && document.activeElement === first) {\n+          event.preventDefault();\n+          last?.focus();\n+        } else if (!event.shiftKey && document.activeElement === last) {\n+          event.preventDefault();\n+          first?.focus();\n+        }\n+      }\n+    }\n+    document.addEventListener(\"keydown\", keydown);\n+    return () => {\n+      document.body.style.overflow = overflow;\n+      document.removeEventListener(\"keydown\", keydown);\n+      previous?.focus();\n+    };\n+  }, [busy]);\n+\n+  return (\n+    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/30 p-5 backdrop-blur-sm\" onMouseDown={(event) => {\n+      if (event.target === event.currentTarget && !busy) onClose();\n+    }}>\n+      <div ref={ref} role=\"dialog\" aria-modal=\"true\" aria-labelledby={titleId} className=\"relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-2xl border border-line bg-paper p-7 shadow-2xl sm:p-9\">\n+        <button aria-label=\"Close dialog\" disabled={busy} onClick={onClose} className=\"absolute right-4 top-4 rounded-lg p-2 text-muted hover:bg-sidebar hover:text-ink disabled:opacity-40\"><X size={19} /></button>\n+        <h2 id={titleId} className=\"pr-5 font-serif text-3xl tracking-tight\">{title}</h2>\n+        {children}\n+      </div>\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/AuthDialog.tsx\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, LoaderCircle, LockKeyhole } from \"lucide-react\";\n+import { api, type Session } from \"../api\";\n+import Dialog from \"./Dialog\";\n+\n+export default function AuthDialog({ initialMode, onClose, onSession }: {\n+  initialMode: \"login\" | \"register\";\n+  onClose: () => void;\n+  onSession: (session: Session) => void;\n+}) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [registered, setRegistered] = useState(false);\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    if (busy) return;\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      if (mode === \"register\" && !registered) {\n+        await api(\"/auth/register\", { method: \"POST\", body: { username, password } });\n+        setRegistered(true);\n+      }\n+      const { token } = await api<{ token: string }>(\"/auth/login\", {\n+        method: \"POST\", body: { username, password },\n+      });\n+      onSession({ token, username: username.trim() });\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to sign in.\");\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <Dialog title={mode === \"login\" ? \"Welcome back.\" : \"Make yourself at home.\"} onClose={onClose} busy={busy}>\n+      <p className=\"mt-3 text-sm leading-relaxed text-muted\">{mode === \"login\" ? \"Your good finds are right where you left them.\" : \"A personal space for everything worth coming back to.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+        <div>\n+          <label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label>\n+          <input id=\"username\" name=\"username\" required maxLength={64} autoComplete=\"username\" value={username} disabled={busy || registered} onChange={(event) => setUsername(event.target.value)} className=\"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/60 disabled:bg-sidebar\" placeholder=\"Your name around here\" />\n+        </div>\n+        <div>\n+          <label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label>\n+          <input id=\"password\" name=\"password\" type=\"password\" required maxLength={1024} autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} disabled={busy} onChange={(event) => setPassword(event.target.value)} className=\"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/60\" placeholder=\"Keep your corner private\" />\n+        </div>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">{registered ? \"Account created. \" : \"\"}{error}</p>}\n+        <button disabled={busy} className=\"flex w-full items-center justify-center gap-3 rounded-xl bg-olive px-4 py-3.5 text-sm font-medium text-white transition hover:bg-olive/90 disabled:opacity-60\">\n+          {busy ? <LoaderCircle size={17} className=\"animate-spin motion-reduce:animate-none\" /> : <ArrowRight size={17} />}\n+          {busy ? \"One moment…\" : mode === \"login\" || registered ? \"Sign in\" : \"Create account\"}\n+        </button>\n+      </form>\n+      <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New to Marginal?\" : \"Already have an account?\"}{\" \"}\n+        <button disabled={busy} className=\"font-medium text-olive underline decoration-olive/30 underline-offset-4\" onClick={() => {\n+          setMode(mode === \"login\" ? \"register\" : \"login\");\n+          setError(\"\");\n+          setRegistered(false);\n+        }}>{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button>\n+      </p>\n+      <div className=\"mt-7 flex items-center justify-center gap-2 border-t border-line pt-5 text-xs text-muted\"><LockKeyhole size={13} /> Your links are private. Always.</div>\n+    </Dialog>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/PreviewCard.tsx\n+import { useState } from \"react\";\n+import { ArrowUpRight, Globe2, LoaderCircle, RefreshCw, Trash2 } from \"lucide-react\";\n+import { hostOf, safeWebUrl, type Preview } from \"../api\";\n+\n+export default function PreviewCard({ preview, list = false, refreshing, deleting, onRefresh, onDelete }: {\n+  preview: Preview;\n+  list?: boolean;\n+  refreshing?: boolean;\n+  deleting?: boolean;\n+  onRefresh: () => void;\n+  onDelete: () => void;\n+}) {\n+  const [failedImage, setFailedImage] = useState<string | null>(null);\n+  const image = safeWebUrl(preview.image_url);\n+  const host = hostOf(preview.final_url || preview.url);\n+  const href = safeWebUrl(preview.final_url) ?? safeWebUrl(preview.url);\n+  const title = preview.title || host;\n+  const date = new Date(preview.fetched_at);\n+  const dateText = Number.isNaN(date.getTime()) ? \"Saved link\" : date.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" });\n+\n+  return (\n+    <article className={`group overflow-hidden rounded-xl border border-line bg-white transition duration-200 hover:-translate-y-0.5 hover:border-olive/30 hover:shadow-lg hover:shadow-ink/5 ${list ? \"flex\" : \"flex flex-col\"}`}>\n+      <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" aria-label={`Open ${title}`} className={`relative block shrink-0 overflow-hidden bg-sidebar ${list ? \"hidden w-44 sm:block\" : \"aspect-[1.85/1]\"}`}>\n+        {image && failedImage !== image ? (\n+          <img src={image} alt=\"\" loading=\"lazy\" referrerPolicy=\"no-referrer\" onError={() => setFailedImage(image)} className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]\" />\n+        ) : (\n+          <div className=\"flex h-full min-h-36 flex-col items-center justify-center gap-3 bg-gradient-to-br from-sidebar to-[#e6eadb] text-olive/70\">\n+            <Globe2 size={40} strokeWidth={1} />\n+            <span className=\"max-w-[85%] truncate text-xs tracking-wide\">{host}</span>\n+          </div>\n+        )}\n+        <span className=\"absolute right-3 top-3 rounded-full bg-white/90 p-1.5 text-ink opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100\"><ArrowUpRight size={15} /></span>\n+      </a>\n+      <div className=\"flex min-w-0 flex-1 flex-col p-5\">\n+        <div className=\"mb-3 flex items-center gap-2 text-[11px] text-muted\"><Globe2 size={12} /><span className=\"truncate\">{host}</span>{preview.status_code >= 400 && <span className=\"ml-auto rounded bg-amber-50 px-1.5 text-amber-700\">HTTP {preview.status_code}</span>}</div>\n+        <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" className=\"rounded-sm font-serif text-[21px] font-medium leading-snug tracking-[-0.3px] hover:text-olive\"><h3 className=\"line-clamp-2\">{title}</h3></a>\n+        <p className={`mt-2 text-[12px] leading-[1.8] text-muted ${list ? \"line-clamp-2\" : \"line-clamp-3\"}`}>{preview.description || \"A good find, saved for later. Open this link to explore the page.\"}</p>\n+        <div className=\"mt-auto flex items-center justify-between gap-2 pt-5\">\n+          <time dateTime={preview.fetched_at} title={`Last fetched: ${Number.isNaN(date.getTime()) ? preview.fetched_at : date.toLocaleString()}`} className=\"text-[10px] text-muted/80\">{dateText}</time>\n+          <div className=\"flex gap-1\">\n+            <button title=\"Refresh preview\" aria-label={`Refresh ${title}`} disabled={refreshing || deleting} onClick={onRefresh} className=\"rounded-md p-1.5 text-muted/70 transition hover:bg-sidebar hover:text-olive disabled:opacity-40\">{refreshing ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <RefreshCw size={14} />}</button>\n+            <button title=\"Delete link\" aria-label={`Delete ${title}`} disabled={refreshing || deleting} onClick={onDelete} className=\"rounded-md p-1.5 text-muted/70 transition hover:bg-red-50 hover:text-red-600 disabled:opacity-40\">{deleting ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <Trash2 size={14} />}</button>\n+          </div>\n+        </div>\n+      </div>\n+    </article>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/Inspiration.tsx\n+import { ArrowUpRight, Globe2 } from \"lucide-react\";\n+\n+const examples = [\n+  { host: \"developer.mozilla.org\", url: \"https://developer.mozilla.org/en-US/\", title: \"The web is for everyone.\", description: \"A trusty field guide to the web. Explore the building blocks of your next big idea.\", image: \"mdn\" },\n+  { host: \"react.dev\", url: \"https://react.dev/\", title: \"A new way to think in React\", description: \"Little components. Endless possibilities. Get inspired to make something of your own.\", image: \"react\" },\n+  { host: \"tailwindcss.com\", url: \"https://tailwindcss.com/\", title: \"Make something beautiful\", description: \"A little less wrestling with styles. A little more bringing your ideas to life.\", image: \"tailwind\" },\n+];\n+\n+export default function Inspiration() {\n+  return (\n+    <div className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\">\n+      {examples.map((example) => (\n+        <a key={example.host} href={example.url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"group flex flex-col overflow-hidden rounded-xl border border-line bg-white transition duration-200 hover:-translate-y-1 hover:border-olive/30 hover:shadow-lg hover:shadow-ink/5\">\n+          <div className=\"relative aspect-[1.85/1] overflow-hidden\">\n+            <img src={`/examples/${example.image}.svg`} alt=\"\" className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]\" />\n+            <span className=\"absolute right-3 top-3 rounded-full bg-white/80 p-1.5 text-ink opacity-0 transition group-hover:opacity-100 group-focus:opacity-100\"><ArrowUpRight size={15} /></span>\n+          </div>\n+          <div className=\"flex flex-1 flex-col p-5\">\n+            <div className=\"mb-3 flex items-center gap-2 text-[11px] text-muted\"><Globe2 size={12} />{example.host}</div>\n+            <h3 className=\"font-serif text-[21px] leading-snug tracking-[-0.3px] group-hover:text-olive\">{example.title}</h3>\n+            <p className=\"mt-2 text-[12px] leading-[1.8] text-muted\">{example.description}</p>\n+            <div className=\"mt-auto flex items-center justify-between pt-5\"><span className=\"text-[9px] tracking-[0.13em] text-muted/80\">EXAMPLE PREVIEW</span><ArrowUpRight size={14} className=\"text-muted/70\" /></div>\n+          </div>\n+        </a>\n+      ))}\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/public/examples/mdn.svg\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#ece9df\"/><circle cx=\"643\" cy=\"88\" r=\"130\" fill=\"#dedfcd\"/><circle cx=\"690\" cy=\"375\" r=\"160\" fill=\"#e0decf\"/><path d=\"M484 104l-40 150h-24l40-150zM543 104l-40 150h-24l40-150zM602 104l-40 150h-24l40-150z\" fill=\"#6d7b53\"/><text x=\"51\" y=\"71\" fill=\"#66704f\" font-family=\"Arial,sans-serif\" font-size=\"17\" letter-spacing=\"4\">MDN WEB DOCS</text><text x=\"49\" y=\"181\" fill=\"#343b2e\" font-family=\"Georgia,serif\" font-size=\"62\">The web,</text><text x=\"49\" y=\"249\" fill=\"#343b2e\" font-family=\"Georgia,serif\" font-size=\"62\">explained.</text><path d=\"M51 291h111\" stroke=\"#6d7b53\" stroke-width=\"3\"/><text x=\"51\" y=\"343\" fill=\"#798070\" font-family=\"Arial,sans-serif\" font-size=\"14\">OPEN KNOWLEDGE. ENDLESS POSSIBILITY.</text></svg>\n*** Add File: /workspace/frontend/public/examples/react.svg\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#e9e6f0\"/><circle cx=\"80\" cy=\"350\" r=\"145\" fill=\"#ded9e8\"/><circle cx=\"720\" cy=\"-20\" r=\"160\" fill=\"#ded9e8\"/><g fill=\"none\" stroke=\"#797393\" stroke-width=\"6\" transform=\"translate(370 178)\"><ellipse rx=\"139\" ry=\"49\"/><ellipse rx=\"139\" ry=\"49\" transform=\"rotate(60)\"/><ellipse rx=\"139\" ry=\"49\" transform=\"rotate(120)\"/><circle r=\"18\" fill=\"#797393\" stroke=\"none\"/></g><text x=\"370\" y=\"343\" text-anchor=\"middle\" fill=\"#6c657f\" font-family=\"Georgia,serif\" font-size=\"31\" letter-spacing=\"1\">Small pieces. Big possibilities.</text><circle cx=\"104\" cy=\"72\" r=\"3\" fill=\"#aaa1bb\"/><circle cx=\"632\" cy=\"320\" r=\"4\" fill=\"#aaa1bb\"/></svg>\n*** Add File: /workspace/frontend/public/examples/tailwind.svg\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#e3eceb\"/><g stroke=\"#cddedb\" stroke-width=\"1\"><path d=\"M0 80h740M0 160h740M0 240h740M0 320h740M80 0v400M160 0v400M240 0v400M320 0v400M400 0v400M480 0v400M560 0v400M640 0v400M720 0v400\"/></g><rect x=\"173\" y=\"84\" width=\"394\" height=\"232\" rx=\"13\" fill=\"#fbfdfb\" stroke=\"#c5d8d4\"/><rect x=\"173\" y=\"84\" width=\"394\" height=\"30\" rx=\"13\" fill=\"#edf3ef\"/><path d=\"M173 104h394v10H173z\" fill=\"#edf3ef\"/><circle cx=\"192\" cy=\"99\" r=\"3\" fill=\"#dca793\"/><circle cx=\"204\" cy=\"99\" r=\"3\" fill=\"#dbc990\"/><circle cx=\"216\" cy=\"99\" r=\"3\" fill=\"#94ae92\"/><path d=\"M370 142c-25 0-41 12-49 37 12-12 26-17 41-12 9 3 15 10 21 16 10 11 22 23 46 23 25 0 41-12 49-37-12 12-26 17-41 12-9-3-15-10-21-16-10-11-22-23-46-23zm-49 59c-25 0-41 12-49 37 12-12 26-17 41-12 9 3 15 10 21 16 10 11 22 23 46 23 25 0 41-12 49-37-12 12-26 17-41 12-9-3-15-10-21-16-10-11-22-23-46-23z\" fill=\"#6b9a92\"/><text x=\"370\" y=\"292\" text-anchor=\"middle\" fill=\"#53736c\" font-family=\"Arial,sans-serif\" font-size=\"17\" letter-spacing=\"2\">LESS FRICTION. MORE CREATION.</text></svg>\n*** End Patch"},"output":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nA frontend/public/favicon.svg\nA frontend/src/api.ts\nA frontend/src/components/Dialog.tsx\nA frontend/src/components/AuthDialog.tsx\nA frontend/src/components/PreviewCard.tsx\nA frontend/src/components/Inspiration.tsx\nA frontend/public/examples/mdn.svg\nA frontend/public/examples/react.svg\nA frontend/public/examples/tailwind.svg","metadata":{"diff":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"lucide-react\": \"^1.71.0\",\n   \"react\": \"19.3.1\",\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f7f8f2\" />\n+    <meta name=\"description\" content=\"A little corner of the internet, all yours. Save, preview, and rediscover your favorite links with Marginal.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Marginal — Good links live here</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,17 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"esModuleInterop\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,21 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"react-hooks/set-state-in-effect\": \"off\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,28 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-ink: #2f3529;\n+  --color-muted: #828579;\n+  --color-paper: #fcfcf9;\n+  --color-sidebar: #f3f5ee;\n+  --color-line: #e6e8de;\n+  --color-olive: #687c45;\n+  --color-accent: #de7858;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-olive/60 focus-visible:ring-offset-2;\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  ::selection {\n+    @apply bg-olive/20;\n+  }\n+}\n\nIndex: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#687c45\"/><path d=\"M13 10h14v22l-7-5-7 5z\" fill=\"#fff\"/><path d=\"M18 14h4\" stroke=\"#687c45\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n\nIndex: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,91 @@\n+export type Session = { token: string; username: string };\n+\n+export type Preview = {\n+  id: number;\n+  url: string;\n+  final_url: string;\n+  status_code: number;\n+  title: string;\n+  description: string;\n+  image_url: string | null;\n+  fetched_at: string;\n+};\n+\n+export type PreviewPage = {\n+  items: Preview[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+};\n+\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(\n+  path: string,\n+  options: { token?: string; method?: string; body?: unknown; signal?: AbortSignal } = {},\n+): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      signal: options.signal,\n+      headers: {\n+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+      },\n+      ...(options.body !== undefined ? { body: JSON.stringify(options.body) } : {}),\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Could not connect. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) {\n+    if (response.status === 401 && options.token) window.dispatchEvent(new Event(\"session-expired\"));\n+    throw new ApiError(data?.error ?? \"Something went wrong. Please try again.\", response.status);\n+  }\n+  return data as T;\n+}\n+\n+export function getStoredToken(): string | null {\n+  try {\n+    return localStorage.getItem(\"marginal-token\");\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function storeToken(token: string | null) {\n+  try {\n+    if (token) localStorage.setItem(\"marginal-token\", token);\n+    else localStorage.removeItem(\"marginal-token\");\n+  } catch {\n+    return;\n+  }\n+}\n+\n+export function hostOf(url: string): string {\n+  try {\n+    return new URL(url).hostname.replace(/^www\\./, \"\");\n+  } catch {\n+    return \"Web link\";\n+  }\n+}\n+\n+export function safeWebUrl(url: string | null): string | undefined {\n+  if (!url) return undefined;\n+  try {\n+    const parsed = new URL(url);\n+    return [\"https:\", \"http:\"].includes(parsed.protocol) ? parsed.href : undefined;\n+  } catch {\n+    return undefined;\n+  }\n+}\n\nIndex: /workspace/frontend/src/components/Dialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/Dialog.tsx\n+++ /workspace/frontend/src/components/Dialog.tsx\n@@ -0,0 +1,57 @@\n+import { useEffect, useId, useRef, type ReactNode } from \"react\";\n+import { X } from \"lucide-react\";\n+\n+export default function Dialog({ title, children, onClose, busy = false }: {\n+  title: string;\n+  children: ReactNode;\n+  onClose: () => void;\n+  busy?: boolean;\n+}) {\n+  const titleId = useId();\n+  const ref = useRef<HTMLDivElement>(null);\n+  const closeRef = useRef(onClose);\n+  closeRef.current = onClose;\n+\n+  useEffect(() => {\n+    const previous = document.activeElement as HTMLElement | null;\n+    const overflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    const panel = ref.current;\n+    panel?.querySelector<HTMLElement>(\"input, button\")?.focus();\n+    function keydown(event: KeyboardEvent) {\n+      if (event.key === \"Escape\" && !busy) closeRef.current();\n+      if (event.key === \"Tab\" && panel) {\n+        const elements = Array.from(panel.querySelectorAll<HTMLElement>(\n+          'button:not([disabled]), input:not([disabled]), a[href], [tabindex=\"0\"]',\n+        ));\n+        const first = elements[0];\n+        const last = elements[elements.length - 1];\n+        if (event.shiftKey && document.activeElement === first) {\n+          event.preventDefault();\n+          last?.focus();\n+        } else if (!event.shiftKey && document.activeElement === last) {\n+          event.preventDefault();\n+          first?.focus();\n+        }\n+      }\n+    }\n+    document.addEventListener(\"keydown\", keydown);\n+    return () => {\n+      document.body.style.overflow = overflow;\n+      document.removeEventListener(\"keydown\", keydown);\n+      previous?.focus();\n+    };\n+  }, [busy]);\n+\n+  return (\n+    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/30 p-5 backdrop-blur-sm\" onMouseDown={(event) => {\n+      if (event.target === event.currentTarget && !busy) onClose();\n+    }}>\n+      <div ref={ref} role=\"dialog\" aria-modal=\"true\" aria-labelledby={titleId} className=\"relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-2xl border border-line bg-paper p-7 shadow-2xl sm:p-9\">\n+        <button aria-label=\"Close dialog\" disabled={busy} onClick={onClose} className=\"absolute right-4 top-4 rounded-lg p-2 text-muted hover:bg-sidebar hover:text-ink disabled:opacity-40\"><X size={19} /></button>\n+        <h2 id={titleId} className=\"pr-5 font-serif text-3xl tracking-tight\">{title}</h2>\n+        {children}\n+      </div>\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/AuthDialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/AuthDialog.tsx\n+++ /workspace/frontend/src/components/AuthDialog.tsx\n@@ -0,0 +1,67 @@\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, LoaderCircle, LockKeyhole } from \"lucide-react\";\n+import { api, type Session } from \"../api\";\n+import Dialog from \"./Dialog\";\n+\n+export default function AuthDialog({ initialMode, onClose, onSession }: {\n+  initialMode: \"login\" | \"register\";\n+  onClose: () => void;\n+  onSession: (session: Session) => void;\n+}) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [registered, setRegistered] = useState(false);\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    if (busy) return;\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      if (mode === \"register\" && !registered) {\n+        await api(\"/auth/register\", { method: \"POST\", body: { username, password } });\n+        setRegistered(true);\n+      }\n+      const { token } = await api<{ token: string }>(\"/auth/login\", {\n+        method: \"POST\", body: { username, password },\n+      });\n+      onSession({ token, username: username.trim() });\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to sign in.\");\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <Dialog title={mode === \"login\" ? \"Welcome back.\" : \"Make yourself at home.\"} onClose={onClose} busy={busy}>\n+      <p className=\"mt-3 text-sm leading-relaxed text-muted\">{mode === \"login\" ? \"Your good finds are right where you left them.\" : \"A personal space for everything worth coming back to.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+        <div>\n+          <label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label>\n+          <input id=\"username\" name=\"username\" required maxLength={64} autoComplete=\"username\" value={username} disabled={busy || registered} onChange={(event) => setUsername(event.target.value)} className=\"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/60 disabled:bg-sidebar\" placeholder=\"Your name around here\" />\n+        </div>\n+        <div>\n+          <label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label>\n+          <input id=\"password\" name=\"password\" type=\"password\" required maxLength={1024} autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} disabled={busy} onChange={(event) => setPassword(event.target.value)} className=\"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/60\" placeholder=\"Keep your corner private\" />\n+        </div>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">{registered ? \"Account created. \" : \"\"}{error}</p>}\n+        <button disabled={busy} className=\"flex w-full items-center justify-center gap-3 rounded-xl bg-olive px-4 py-3.5 text-sm font-medium text-white transition hover:bg-olive/90 disabled:opacity-60\">\n+          {busy ? <LoaderCircle size={17} className=\"animate-spin motion-reduce:animate-none\" /> : <ArrowRight size={17} />}\n+          {busy ? \"One moment…\" : mode === \"login\" || registered ? \"Sign in\" : \"Create account\"}\n+        </button>\n+      </form>\n+      <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New to Marginal?\" : \"Already have an account?\"}{\" \"}\n+        <button disabled={busy} className=\"font-medium text-olive underline decoration-olive/30 underline-offset-4\" onClick={() => {\n+          setMode(mode === \"login\" ? \"register\" : \"login\");\n+          setError(\"\");\n+          setRegistered(false);\n+        }}>{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button>\n+      </p>\n+      <div className=\"mt-7 flex items-center justify-center gap-2 border-t border-line pt-5 text-xs text-muted\"><LockKeyhole size={13} /> Your links are private. Always.</div>\n+    </Dialog>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/PreviewCard.tsx\n===================================================================\n--- /workspace/frontend/src/components/PreviewCard.tsx\n+++ /workspace/frontend/src/components/PreviewCard.tsx\n@@ -0,0 +1,48 @@\n+import { useState } from \"react\";\n+import { ArrowUpRight, Globe2, LoaderCircle, RefreshCw, Trash2 } from \"lucide-react\";\n+import { hostOf, safeWebUrl, type Preview } from \"../api\";\n+\n+export default function PreviewCard({ preview, list = false, refreshing, deleting, onRefresh, onDelete }: {\n+  preview: Preview;\n+  list?: boolean;\n+  refreshing?: boolean;\n+  deleting?: boolean;\n+  onRefresh: () => void;\n+  onDelete: () => void;\n+}) {\n+  const [failedImage, setFailedImage] = useState<string | null>(null);\n+  const image = safeWebUrl(preview.image_url);\n+  const host = hostOf(preview.final_url || preview.url);\n+  const href = safeWebUrl(preview.final_url) ?? safeWebUrl(preview.url);\n+  const title = preview.title || host;\n+  const date = new Date(preview.fetched_at);\n+  const dateText = Number.isNaN(date.getTime()) ? \"Saved link\" : date.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" });\n+\n+  return (\n+    <article className={`group overflow-hidden rounded-xl border border-line bg-white transition duration-200 hover:-translate-y-0.5 hover:border-olive/30 hover:shadow-lg hover:shadow-ink/5 ${list ? \"flex\" : \"flex flex-col\"}`}>\n+      <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" aria-label={`Open ${title}`} className={`relative block shrink-0 overflow-hidden bg-sidebar ${list ? \"hidden w-44 sm:block\" : \"aspect-[1.85/1]\"}`}>\n+        {image && failedImage !== image ? (\n+          <img src={image} alt=\"\" loading=\"lazy\" referrerPolicy=\"no-referrer\" onError={() => setFailedImage(image)} className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]\" />\n+        ) : (\n+          <div className=\"flex h-full min-h-36 flex-col items-center justify-center gap-3 bg-gradient-to-br from-sidebar to-[#e6eadb] text-olive/70\">\n+            <Globe2 size={40} strokeWidth={1} />\n+            <span className=\"max-w-[85%] truncate text-xs tracking-wide\">{host}</span>\n+          </div>\n+        )}\n+        <span className=\"absolute right-3 top-3 rounded-full bg-white/90 p-1.5 text-ink opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100\"><ArrowUpRight size={15} /></span>\n+      </a>\n+      <div className=\"flex min-w-0 flex-1 flex-col p-5\">\n+        <div className=\"mb-3 flex items-center gap-2 text-[11px] text-muted\"><Globe2 size={12} /><span className=\"truncate\">{host}</span>{preview.status_code >= 400 && <span className=\"ml-auto rounded bg-amber-50 px-1.5 text-amber-700\">HTTP {preview.status_code}</span>}</div>\n+        <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" className=\"rounded-sm font-serif text-[21px] font-medium leading-snug tracking-[-0.3px] hover:text-olive\"><h3 className=\"line-clamp-2\">{title}</h3></a>\n+        <p className={`mt-2 text-[12px] leading-[1.8] text-muted ${list ? \"line-clamp-2\" : \"line-clamp-3\"}`}>{preview.description || \"A good find, saved for later. Open this link to explore the page.\"}</p>\n+        <div className=\"mt-auto flex items-center justify-between gap-2 pt-5\">\n+          <time dateTime={preview.fetched_at} title={`Last fetched: ${Number.isNaN(date.getTime()) ? preview.fetched_at : date.toLocaleString()}`} className=\"text-[10px] text-muted/80\">{dateText}</time>\n+          <div className=\"flex gap-1\">\n+            <button title=\"Refresh preview\" aria-label={`Refresh ${title}`} disabled={refreshing || deleting} onClick={onRefresh} className=\"rounded-md p-1.5 text-muted/70 transition hover:bg-sidebar hover:text-olive disabled:opacity-40\">{refreshing ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <RefreshCw size={14} />}</button>\n+            <button title=\"Delete link\" aria-label={`Delete ${title}`} disabled={refreshing || deleting} onClick={onDelete} className=\"rounded-md p-1.5 text-muted/70 transition hover:bg-red-50 hover:text-red-600 disabled:opacity-40\">{deleting ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <Trash2 size={14} />}</button>\n+          </div>\n+        </div>\n+      </div>\n+    </article>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/Inspiration.tsx\n===================================================================\n--- /workspace/frontend/src/components/Inspiration.tsx\n+++ /workspace/frontend/src/components/Inspiration.tsx\n@@ -0,0 +1,28 @@\n+import { ArrowUpRight, Globe2 } from \"lucide-react\";\n+\n+const examples = [\n+  { host: \"developer.mozilla.org\", url: \"https://developer.mozilla.org/en-US/\", title: \"The web is for everyone.\", description: \"A trusty field guide to the web. Explore the building blocks of your next big idea.\", image: \"mdn\" },\n+  { host: \"react.dev\", url: \"https://react.dev/\", title: \"A new way to think in React\", description: \"Little components. Endless possibilities. Get inspired to make something of your own.\", image: \"react\" },\n+  { host: \"tailwindcss.com\", url: \"https://tailwindcss.com/\", title: \"Make something beautiful\", description: \"A little less wrestling with styles. A little more bringing your ideas to life.\", image: \"tailwind\" },\n+];\n+\n+export default function Inspiration() {\n+  return (\n+    <div className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\">\n+      {examples.map((example) => (\n+        <a key={example.host} href={example.url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"group flex flex-col overflow-hidden rounded-xl border border-line bg-white transition duration-200 hover:-translate-y-1 hover:border-olive/30 hover:shadow-lg hover:shadow-ink/5\">\n+          <div className=\"relative aspect-[1.85/1] overflow-hidden\">\n+            <img src={`/examples/${example.image}.svg`} alt=\"\" className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]\" />\n+            <span className=\"absolute right-3 top-3 rounded-full bg-white/80 p-1.5 text-ink opacity-0 transition group-hover:opacity-100 group-focus:opacity-100\"><ArrowUpRight size={15} /></span>\n+          </div>\n+          <div className=\"flex flex-1 flex-col p-5\">\n+            <div className=\"mb-3 flex items-center gap-2 text-[11px] text-muted\"><Globe2 size={12} />{example.host}</div>\n+            <h3 className=\"font-serif text-[21px] leading-snug tracking-[-0.3px] group-hover:text-olive\">{example.title}</h3>\n+            <p className=\"mt-2 text-[12px] leading-[1.8] text-muted\">{example.description}</p>\n+            <div className=\"mt-auto flex items-center justify-between pt-5\"><span className=\"text-[9px] tracking-[0.13em] text-muted/80\">EXAMPLE PREVIEW</span><ArrowUpRight size={14} className=\"text-muted/70\" /></div>\n+          </div>\n+        </a>\n+      ))}\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/public/examples/mdn.svg\n===================================================================\n--- /workspace/frontend/public/examples/mdn.svg\n+++ /workspace/frontend/public/examples/mdn.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#ece9df\"/><circle cx=\"643\" cy=\"88\" r=\"130\" fill=\"#dedfcd\"/><circle cx=\"690\" cy=\"375\" r=\"160\" fill=\"#e0decf\"/><path d=\"M484 104l-40 150h-24l40-150zM543 104l-40 150h-24l40-150zM602 104l-40 150h-24l40-150z\" fill=\"#6d7b53\"/><text x=\"51\" y=\"71\" fill=\"#66704f\" font-family=\"Arial,sans-serif\" font-size=\"17\" letter-spacing=\"4\">MDN WEB DOCS</text><text x=\"49\" y=\"181\" fill=\"#343b2e\" font-family=\"Georgia,serif\" font-size=\"62\">The web,</text><text x=\"49\" y=\"249\" fill=\"#343b2e\" font-family=\"Georgia,serif\" font-size=\"62\">explained.</text><path d=\"M51 291h111\" stroke=\"#6d7b53\" stroke-width=\"3\"/><text x=\"51\" y=\"343\" fill=\"#798070\" font-family=\"Arial,sans-serif\" font-size=\"14\">OPEN KNOWLEDGE. ENDLESS POSSIBILITY.</text></svg>\n\nIndex: /workspace/frontend/public/examples/react.svg\n===================================================================\n--- /workspace/frontend/public/examples/react.svg\n+++ /workspace/frontend/public/examples/react.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#e9e6f0\"/><circle cx=\"80\" cy=\"350\" r=\"145\" fill=\"#ded9e8\"/><circle cx=\"720\" cy=\"-20\" r=\"160\" fill=\"#ded9e8\"/><g fill=\"none\" stroke=\"#797393\" stroke-width=\"6\" transform=\"translate(370 178)\"><ellipse rx=\"139\" ry=\"49\"/><ellipse rx=\"139\" ry=\"49\" transform=\"rotate(60)\"/><ellipse rx=\"139\" ry=\"49\" transform=\"rotate(120)\"/><circle r=\"18\" fill=\"#797393\" stroke=\"none\"/></g><text x=\"370\" y=\"343\" text-anchor=\"middle\" fill=\"#6c657f\" font-family=\"Georgia,serif\" font-size=\"31\" letter-spacing=\"1\">Small pieces. Big possibilities.</text><circle cx=\"104\" cy=\"72\" r=\"3\" fill=\"#aaa1bb\"/><circle cx=\"632\" cy=\"320\" r=\"4\" fill=\"#aaa1bb\"/></svg>\n\nIndex: /workspace/frontend/public/examples/tailwind.svg\n===================================================================\n--- /workspace/frontend/public/examples/tailwind.svg\n+++ /workspace/frontend/public/examples/tailwind.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#e3eceb\"/><g stroke=\"#cddedb\" stroke-width=\"1\"><path d=\"M0 80h740M0 160h740M0 240h740M0 320h740M80 0v400M160 0v400M240 0v400M320 0v400M400 0v400M480 0v400M560 0v400M640 0v400M720 0v400\"/></g><rect x=\"173\" y=\"84\" width=\"394\" height=\"232\" rx=\"13\" fill=\"#fbfdfb\" stroke=\"#c5d8d4\"/><rect x=\"173\" y=\"84\" width=\"394\" height=\"30\" rx=\"13\" fill=\"#edf3ef\"/><path d=\"M173 104h394v10H173z\" fill=\"#edf3ef\"/><circle cx=\"192\" cy=\"99\" r=\"3\" fill=\"#dca793\"/><circle cx=\"204\" cy=\"99\" r=\"3\" fill=\"#dbc990\"/><circle cx=\"216\" cy=\"99\" r=\"3\" fill=\"#94ae92\"/><path d=\"M370 142c-25 0-41 12-49 37 12-12 26-17 41-12 9 3 15 10 21 16 10 11 22 23 46 23 25 0 41-12 49-37-12 12-26 17-41 12-9-3-15-10-21-16-10-11-22-23-46-23zm-49 59c-25 0-41 12-49 37 12-12 26-17 41-12 9 3 15 10 21 16 10 11 22 23 46 23 25 0 41-12 49-37-12 12-26 17-41 12-9-3-15-10-21-16-10-11-22-23-46-23z\" fill=\"#6b9a92\"/><text x=\"370\" y=\"292\" text-anchor=\"middle\" fill=\"#53736c\" font-family=\"Arial,sans-serif\" font-size=\"17\" letter-spacing=\"2\">LESS FRICTION. MORE CREATION.</text></svg>\n\n","files":[{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"lucide-react\": \"^1.71.0\",\n   \"react\": \"19.3.1\",\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f7f8f2\" />\n+    <meta name=\"description\" content=\"A little corner of the internet, all yours. Save, preview, and rediscover your favorite links with Marginal.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Marginal — Good links live here</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":4,"deletions":1},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,17 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"esModuleInterop\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":17,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,21 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"react-hooks/set-state-in-effect\": \"off\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n","additions":21,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,28 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-ink: #2f3529;\n+  --color-muted: #828579;\n+  --color-paper: #fcfcf9;\n+  --color-sidebar: #f3f5ee;\n+  --color-line: #e6e8de;\n+  --color-olive: #687c45;\n+  --color-accent: #de7858;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-olive/60 focus-visible:ring-offset-2;\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  ::selection {\n+    @apply bg-olive/20;\n+  }\n+}\n","additions":28,"deletions":0},{"filePath":"/workspace/frontend/public/favicon.svg","relativePath":"frontend/public/favicon.svg","type":"add","patch":"Index: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#687c45\"/><path d=\"M13 10h14v22l-7-5-7 5z\" fill=\"#fff\"/><path d=\"M18 14h4\" stroke=\"#687c45\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,91 @@\n+export type Session = { token: string; username: string };\n+\n+export type Preview = {\n+  id: number;\n+  url: string;\n+  final_url: string;\n+  status_code: number;\n+  title: string;\n+  description: string;\n+  image_url: string | null;\n+  fetched_at: string;\n+};\n+\n+export type PreviewPage = {\n+  items: Preview[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+};\n+\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(\n+  path: string,\n+  options: { token?: string; method?: string; body?: unknown; signal?: AbortSignal } = {},\n+): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      signal: options.signal,\n+      headers: {\n+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+      },\n+      ...(options.body !== undefined ? { body: JSON.stringify(options.body) } : {}),\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Could not connect. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) {\n+    if (response.status === 401 && options.token) window.dispatchEvent(new Event(\"session-expired\"));\n+    throw new ApiError(data?.error ?? \"Something went wrong. Please try again.\", response.status);\n+  }\n+  return data as T;\n+}\n+\n+export function getStoredToken(): string | null {\n+  try {\n+    return localStorage.getItem(\"marginal-token\");\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function storeToken(token: string | null) {\n+  try {\n+    if (token) localStorage.setItem(\"marginal-token\", token);\n+    else localStorage.removeItem(\"marginal-token\");\n+  } catch {\n+    return;\n+  }\n+}\n+\n+export function hostOf(url: string): string {\n+  try {\n+    return new URL(url).hostname.replace(/^www\\./, \"\");\n+  } catch {\n+    return \"Web link\";\n+  }\n+}\n+\n+export function safeWebUrl(url: string | null): string | undefined {\n+  if (!url) return undefined;\n+  try {\n+    const parsed = new URL(url);\n+    return [\"https:\", \"http:\"].includes(parsed.protocol) ? parsed.href : undefined;\n+  } catch {\n+    return undefined;\n+  }\n+}\n","additions":91,"deletions":0},{"filePath":"/workspace/frontend/src/components/Dialog.tsx","relativePath":"frontend/src/components/Dialog.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Dialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/Dialog.tsx\n+++ /workspace/frontend/src/components/Dialog.tsx\n@@ -0,0 +1,57 @@\n+import { useEffect, useId, useRef, type ReactNode } from \"react\";\n+import { X } from \"lucide-react\";\n+\n+export default function Dialog({ title, children, onClose, busy = false }: {\n+  title: string;\n+  children: ReactNode;\n+  onClose: () => void;\n+  busy?: boolean;\n+}) {\n+  const titleId = useId();\n+  const ref = useRef<HTMLDivElement>(null);\n+  const closeRef = useRef(onClose);\n+  closeRef.current = onClose;\n+\n+  useEffect(() => {\n+    const previous = document.activeElement as HTMLElement | null;\n+    const overflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    const panel = ref.current;\n+    panel?.querySelector<HTMLElement>(\"input, button\")?.focus();\n+    function keydown(event: KeyboardEvent) {\n+      if (event.key === \"Escape\" && !busy) closeRef.current();\n+      if (event.key === \"Tab\" && panel) {\n+        const elements = Array.from(panel.querySelectorAll<HTMLElement>(\n+          'button:not([disabled]), input:not([disabled]), a[href], [tabindex=\"0\"]',\n+        ));\n+        const first = elements[0];\n+        const last = elements[elements.length - 1];\n+        if (event.shiftKey && document.activeElement === first) {\n+          event.preventDefault();\n+          last?.focus();\n+        } else if (!event.shiftKey && document.activeElement === last) {\n+          event.preventDefault();\n+          first?.focus();\n+        }\n+      }\n+    }\n+    document.addEventListener(\"keydown\", keydown);\n+    return () => {\n+      document.body.style.overflow = overflow;\n+      document.removeEventListener(\"keydown\", keydown);\n+      previous?.focus();\n+    };\n+  }, [busy]);\n+\n+  return (\n+    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/30 p-5 backdrop-blur-sm\" onMouseDown={(event) => {\n+      if (event.target === event.currentTarget && !busy) onClose();\n+    }}>\n+      <div ref={ref} role=\"dialog\" aria-modal=\"true\" aria-labelledby={titleId} className=\"relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-2xl border border-line bg-paper p-7 shadow-2xl sm:p-9\">\n+        <button aria-label=\"Close dialog\" disabled={busy} onClick={onClose} className=\"absolute right-4 top-4 rounded-lg p-2 text-muted hover:bg-sidebar hover:text-ink disabled:opacity-40\"><X size={19} /></button>\n+        <h2 id={titleId} className=\"pr-5 font-serif text-3xl tracking-tight\">{title}</h2>\n+        {children}\n+      </div>\n+    </div>\n+  );\n+}\n","additions":57,"deletions":0},{"filePath":"/workspace/frontend/src/components/AuthDialog.tsx","relativePath":"frontend/src/components/AuthDialog.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/AuthDialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/AuthDialog.tsx\n+++ /workspace/frontend/src/components/AuthDialog.tsx\n@@ -0,0 +1,67 @@\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, LoaderCircle, LockKeyhole } from \"lucide-react\";\n+import { api, type Session } from \"../api\";\n+import Dialog from \"./Dialog\";\n+\n+export default function AuthDialog({ initialMode, onClose, onSession }: {\n+  initialMode: \"login\" | \"register\";\n+  onClose: () => void;\n+  onSession: (session: Session) => void;\n+}) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [registered, setRegistered] = useState(false);\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    if (busy) return;\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      if (mode === \"register\" && !registered) {\n+        await api(\"/auth/register\", { method: \"POST\", body: { username, password } });\n+        setRegistered(true);\n+      }\n+      const { token } = await api<{ token: string }>(\"/auth/login\", {\n+        method: \"POST\", body: { username, password },\n+      });\n+      onSession({ token, username: username.trim() });\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to sign in.\");\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <Dialog title={mode === \"login\" ? \"Welcome back.\" : \"Make yourself at home.\"} onClose={onClose} busy={busy}>\n+      <p className=\"mt-3 text-sm leading-relaxed text-muted\">{mode === \"login\" ? \"Your good finds are right where you left them.\" : \"A personal space for everything worth coming back to.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+        <div>\n+          <label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label>\n+          <input id=\"username\" name=\"username\" required maxLength={64} autoComplete=\"username\" value={username} disabled={busy || registered} onChange={(event) => setUsername(event.target.value)} className=\"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/60 disabled:bg-sidebar\" placeholder=\"Your name around here\" />\n+        </div>\n+        <div>\n+          <label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label>\n+          <input id=\"password\" name=\"password\" type=\"password\" required maxLength={1024} autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} disabled={busy} onChange={(event) => setPassword(event.target.value)} className=\"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/60\" placeholder=\"Keep your corner private\" />\n+        </div>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">{registered ? \"Account created. \" : \"\"}{error}</p>}\n+        <button disabled={busy} className=\"flex w-full items-center justify-center gap-3 rounded-xl bg-olive px-4 py-3.5 text-sm font-medium text-white transition hover:bg-olive/90 disabled:opacity-60\">\n+          {busy ? <LoaderCircle size={17} className=\"animate-spin motion-reduce:animate-none\" /> : <ArrowRight size={17} />}\n+          {busy ? \"One moment…\" : mode === \"login\" || registered ? \"Sign in\" : \"Create account\"}\n+        </button>\n+      </form>\n+      <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New to Marginal?\" : \"Already have an account?\"}{\" \"}\n+        <button disabled={busy} className=\"font-medium text-olive underline decoration-olive/30 underline-offset-4\" onClick={() => {\n+          setMode(mode === \"login\" ? \"register\" : \"login\");\n+          setError(\"\");\n+          setRegistered(false);\n+        }}>{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button>\n+      </p>\n+      <div className=\"mt-7 flex items-center justify-center gap-2 border-t border-line pt-5 text-xs text-muted\"><LockKeyhole size={13} /> Your links are private. Always.</div>\n+    </Dialog>\n+  );\n+}\n","additions":67,"deletions":0},{"filePath":"/workspace/frontend/src/components/PreviewCard.tsx","relativePath":"frontend/src/components/PreviewCard.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/PreviewCard.tsx\n===================================================================\n--- /workspace/frontend/src/components/PreviewCard.tsx\n+++ /workspace/frontend/src/components/PreviewCard.tsx\n@@ -0,0 +1,48 @@\n+import { useState } from \"react\";\n+import { ArrowUpRight, Globe2, LoaderCircle, RefreshCw, Trash2 } from \"lucide-react\";\n+import { hostOf, safeWebUrl, type Preview } from \"../api\";\n+\n+export default function PreviewCard({ preview, list = false, refreshing, deleting, onRefresh, onDelete }: {\n+  preview: Preview;\n+  list?: boolean;\n+  refreshing?: boolean;\n+  deleting?: boolean;\n+  onRefresh: () => void;\n+  onDelete: () => void;\n+}) {\n+  const [failedImage, setFailedImage] = useState<string | null>(null);\n+  const image = safeWebUrl(preview.image_url);\n+  const host = hostOf(preview.final_url || preview.url);\n+  const href = safeWebUrl(preview.final_url) ?? safeWebUrl(preview.url);\n+  const title = preview.title || host;\n+  const date = new Date(preview.fetched_at);\n+  const dateText = Number.isNaN(date.getTime()) ? \"Saved link\" : date.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" });\n+\n+  return (\n+    <article className={`group overflow-hidden rounded-xl border border-line bg-white transition duration-200 hover:-translate-y-0.5 hover:border-olive/30 hover:shadow-lg hover:shadow-ink/5 ${list ? \"flex\" : \"flex flex-col\"}`}>\n+      <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" aria-label={`Open ${title}`} className={`relative block shrink-0 overflow-hidden bg-sidebar ${list ? \"hidden w-44 sm:block\" : \"aspect-[1.85/1]\"}`}>\n+        {image && failedImage !== image ? (\n+          <img src={image} alt=\"\" loading=\"lazy\" referrerPolicy=\"no-referrer\" onError={() => setFailedImage(image)} className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]\" />\n+        ) : (\n+          <div className=\"flex h-full min-h-36 flex-col items-center justify-center gap-3 bg-gradient-to-br from-sidebar to-[#e6eadb] text-olive/70\">\n+            <Globe2 size={40} strokeWidth={1} />\n+            <span className=\"max-w-[85%] truncate text-xs tracking-wide\">{host}</span>\n+          </div>\n+        )}\n+        <span className=\"absolute right-3 top-3 rounded-full bg-white/90 p-1.5 text-ink opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100\"><ArrowUpRight size={15} /></span>\n+      </a>\n+      <div className=\"flex min-w-0 flex-1 flex-col p-5\">\n+        <div className=\"mb-3 flex items-center gap-2 text-[11px] text-muted\"><Globe2 size={12} /><span className=\"truncate\">{host}</span>{preview.status_code >= 400 && <span className=\"ml-auto rounded bg-amber-50 px-1.5 text-amber-700\">HTTP {preview.status_code}</span>}</div>\n+        <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" className=\"rounded-sm font-serif text-[21px] font-medium leading-snug tracking-[-0.3px] hover:text-olive\"><h3 className=\"line-clamp-2\">{title}</h3></a>\n+        <p className={`mt-2 text-[12px] leading-[1.8] text-muted ${list ? \"line-clamp-2\" : \"line-clamp-3\"}`}>{preview.description || \"A good find, saved for later. Open this link to explore the page.\"}</p>\n+        <div className=\"mt-auto flex items-center justify-between gap-2 pt-5\">\n+          <time dateTime={preview.fetched_at} title={`Last fetched: ${Number.isNaN(date.getTime()) ? preview.fetched_at : date.toLocaleString()}`} className=\"text-[10px] text-muted/80\">{dateText}</time>\n+          <div className=\"flex gap-1\">\n+            <button title=\"Refresh preview\" aria-label={`Refresh ${title}`} disabled={refreshing || deleting} onClick={onRefresh} className=\"rounded-md p-1.5 text-muted/70 transition hover:bg-sidebar hover:text-olive disabled:opacity-40\">{refreshing ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <RefreshCw size={14} />}</button>\n+            <button title=\"Delete link\" aria-label={`Delete ${title}`} disabled={refreshing || deleting} onClick={onDelete} className=\"rounded-md p-1.5 text-muted/70 transition hover:bg-red-50 hover:text-red-600 disabled:opacity-40\">{deleting ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <Trash2 size={14} />}</button>\n+          </div>\n+        </div>\n+      </div>\n+    </article>\n+  );\n+}\n","additions":48,"deletions":0},{"filePath":"/workspace/frontend/src/components/Inspiration.tsx","relativePath":"frontend/src/components/Inspiration.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Inspiration.tsx\n===================================================================\n--- /workspace/frontend/src/components/Inspiration.tsx\n+++ /workspace/frontend/src/components/Inspiration.tsx\n@@ -0,0 +1,28 @@\n+import { ArrowUpRight, Globe2 } from \"lucide-react\";\n+\n+const examples = [\n+  { host: \"developer.mozilla.org\", url: \"https://developer.mozilla.org/en-US/\", title: \"The web is for everyone.\", description: \"A trusty field guide to the web. Explore the building blocks of your next big idea.\", image: \"mdn\" },\n+  { host: \"react.dev\", url: \"https://react.dev/\", title: \"A new way to think in React\", description: \"Little components. Endless possibilities. Get inspired to make something of your own.\", image: \"react\" },\n+  { host: \"tailwindcss.com\", url: \"https://tailwindcss.com/\", title: \"Make something beautiful\", description: \"A little less wrestling with styles. A little more bringing your ideas to life.\", image: \"tailwind\" },\n+];\n+\n+export default function Inspiration() {\n+  return (\n+    <div className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\">\n+      {examples.map((example) => (\n+        <a key={example.host} href={example.url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"group flex flex-col overflow-hidden rounded-xl border border-line bg-white transition duration-200 hover:-translate-y-1 hover:border-olive/30 hover:shadow-lg hover:shadow-ink/5\">\n+          <div className=\"relative aspect-[1.85/1] overflow-hidden\">\n+            <img src={`/examples/${example.image}.svg`} alt=\"\" className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]\" />\n+            <span className=\"absolute right-3 top-3 rounded-full bg-white/80 p-1.5 text-ink opacity-0 transition group-hover:opacity-100 group-focus:opacity-100\"><ArrowUpRight size={15} /></span>\n+          </div>\n+          <div className=\"flex flex-1 flex-col p-5\">\n+            <div className=\"mb-3 flex items-center gap-2 text-[11px] text-muted\"><Globe2 size={12} />{example.host}</div>\n+            <h3 className=\"font-serif text-[21px] leading-snug tracking-[-0.3px] group-hover:text-olive\">{example.title}</h3>\n+            <p className=\"mt-2 text-[12px] leading-[1.8] text-muted\">{example.description}</p>\n+            <div className=\"mt-auto flex items-center justify-between pt-5\"><span className=\"text-[9px] tracking-[0.13em] text-muted/80\">EXAMPLE PREVIEW</span><ArrowUpRight size={14} className=\"text-muted/70\" /></div>\n+          </div>\n+        </a>\n+      ))}\n+    </div>\n+  );\n+}\n","additions":28,"deletions":0},{"filePath":"/workspace/frontend/public/examples/mdn.svg","relativePath":"frontend/public/examples/mdn.svg","type":"add","patch":"Index: /workspace/frontend/public/examples/mdn.svg\n===================================================================\n--- /workspace/frontend/public/examples/mdn.svg\n+++ /workspace/frontend/public/examples/mdn.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"740\" height=\"400\" viewBox=\"0 0 740 400\"><rect width=\"740\" height=\"400\" fill=\"#ece9df\"/><circle cx=\"643\" cy=\"88\" r=\"130\" fill=\"#dedfcd\"/><circle cx=\"690\" cy=\"375\" r=\"160\" fill=\"#e0decf\"/><path d=\"M484 104l-40 150h-24l40-150zM543 104l-40 150h-24l40-150zM602 104l-40 150h-24l40-150z\" fill=\"#6d7b53\"/><text x=\"51\" y=\"71\" fill=\"#66704f\" font-family=\"Arial,sans-serif\" font-size=\"17\" letter-spacing=\"4\">MDN WEB DOCS</text><text x=\"49\" y=\"181\" fill=\"#343b2e\" font-family=\"Georgia,serif\" font-size=\"62\">The web,</text><text x=\"49\" y=\"249\" fill=\"#343b2e\" font-family=\"Georgia,serif\" font-size=\"62\">explained.</text><path d=\"M51 291h111\" stroke=\"#6d7b53\" stroke-width=\"3\"/><text x=\"51\" y=\"343\" fill=\"#798070\" font-family=\"Arial,sans-serif\" font-size=\"14\">OPEN KNOWLEDGE. ENDLESS POSSIBILITY.</text></svg>\n","additio