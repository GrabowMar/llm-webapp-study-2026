{"type":"tool_use","timestamp":1794317248117,"sessionID":"ses_e3a6af12cffemPwVWkj0znar6y","part":{"type":"tool","tool":"apply_patch","callID":"call_qzA6pEFpbOKzrS7NoZOGQe8P","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Update File: /workspace/frontend/src/components/Dialog.tsx\n@@\n   const ref = useRef<HTMLDivElement>(null);\n   const closeRef = useRef(onClose);\n-  closeRef.current = onClose;\n+  const busyRef = useRef(busy);\n+\n+  useEffect(() => {\n+    closeRef.current = onClose;\n+    busyRef.current = busy;\n+  }, [onClose, busy]);\n@@\n-    panel?.querySelector<HTMLElement>(\"input, button\")?.focus();\n+    (panel?.querySelector<HTMLElement>(\"input\") ?? panel?.querySelector<HTMLElement>(\"button\"))?.focus();\n@@\n-      if (event.key === \"Escape\" && !busy) closeRef.current();\n+      if (event.key === \"Escape\" && !busyRef.current) closeRef.current();\n@@\n-  }, [busy]);\n+  }, []);\n*** Update File: /workspace/backend/app.py\n@@\n-from datetime import datetime, timedelta, timezone\n+from datetime import UTC, datetime, timedelta\n@@\n-                (token_hash, datetime.now(timezone.utc).isoformat()),\n+                (token_hash, datetime.now(UTC).isoformat()),\n@@\n-        now = datetime.now(timezone.utc)\n+        now = datetime.now(UTC)\n*** Update File: /workspace/backend/preview.py\n@@\n-from datetime import datetime, timezone\n+from datetime import UTC, datetime\n@@\n         port = parsed.port\n+        if port is not None and not 1 <= port <= 65535:\n+            raise ValueError\n@@\n-    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.I)\n+    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.IGNORECASE)\n@@\n-        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.I)\n+        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.IGNORECASE)\n@@\n-                    **metadata, \"fetched_at\": datetime.now(timezone.utc).isoformat()}\n+                    **metadata, \"fetched_at\": datetime.now(UTC).isoformat()}\n*** Add File: /workspace/pyproject.toml\n+[tool.ruff]\n+target-version = \"py313\"\n+line-length = 100\n+\n+[tool.ruff.lint]\n+select = [\"E4\", \"E7\", \"E9\", \"F\", \"I\", \"UP\"]\n*** Add File: /workspace/backend/tests/test_app.py\n+import hashlib\n+import sqlite3\n+import tempfile\n+import unittest\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from backend.app import PREVIEW_FIELDS, create_app\n+from backend.preview import PreviewError\n+\n+\n+def fixture_preview(url=\"https://example.com/\", title=\"A good find\"):\n+    return {\n+        \"url\": url,\n+        \"final_url\": \"https://example.com/article\",\n+        \"status_code\": 200,\n+        \"title\": title,\n+        \"description\": \"A useful description.\",\n+        \"image_url\": \"https://example.com/image.png\",\n+        \"fetched_at\": \"2026-11-10T12:00:00+00:00\",\n+    }\n+\n+\n+class AppTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.config = {\"TESTING\": True, \"DATABASE\": str(Path(self.directory.name) / \"app.sqlite3\")}\n+        self.app = create_app(self.config)\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"secret\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"secret\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def add(self, url=\"https://example.com/\", title=\"A good find\"):\n+        with patch(\"backend.app.fetch_preview\", return_value=fixture_preview(url, title)):\n+            response = self.client.post(\"/api/previews\", json={\"url\": url}, headers=self.headers)\n+        self.assertEqual(response.status_code, 201)\n+        return response.json\n+\n+    def test_health_and_unknown_api(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        response = self.client.get(\"/api/not-a-route\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertIn(\"error\", response.json)\n+        self.assertEqual(self.client.post(\"/api/health\").status_code, 405)\n+\n+    def test_registration_validation_and_duplicates(self):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"other\"})\n+        self.assertEqual(response.status_code, 409)\n+        for body in (None, [], {}, {\"username\": 1, \"password\": \"secret\"},\n+                     {\"username\": \"   \", \"password\": \"secret\"},\n+                     {\"username\": \"user\", \"password\": \"\"},\n+                     {\"username\": \"user\\nname\", \"password\": \"secret\"}):\n+            with self.subTest(body=body):\n+                response = self.client.post(\"/api/auth/register\", json=body)\n+                self.assertEqual(response.status_code, 400)\n+\n+    def test_login_rejects_wrong_password(self):\n+        for username, password in ((\"alice\", \"wrong\"), (\"unknown\", \"secret\")):\n+            response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password})\n+            self.assertEqual(response.status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.headers).json, {\"username\": \"alice\"})\n+\n+    def test_credentials_and_tokens_are_hashed(self):\n+        with sqlite3.connect(self.config[\"DATABASE\"]) as database:\n+            password_hash = database.execute(\"SELECT password_hash FROM users\").fetchone()[0]\n+            token_hash = database.execute(\"SELECT token_hash FROM tokens\").fetchone()[0]\n+        token = self.headers[\"Authorization\"].split()[1]\n+        self.assertNotEqual(password_hash, \"secret\")\n+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())\n+\n+    def test_all_preview_routes_require_authentication(self):\n+        for method, path in ((\"GET\", \"/api/previews\"), (\"POST\", \"/api/previews\"),\n+                             (\"GET\", \"/api/previews/1\"), (\"POST\", \"/api/previews/1/refresh\"),\n+                             (\"DELETE\", \"/api/previews/1\")):\n+            for authorization in (None, \"Bearer invalid\", \"Basic invalid\", \"Bearer\"):\n+                with self.subTest(method=method, path=path, authorization=authorization):\n+                    response = self.client.open(path, method=method, headers={\"Authorization\": authorization} if authorization else {})\n+                    self.assertEqual(response.status_code, 401)\n+\n+    def test_create_get_and_delete(self):\n+        preview = self.add()\n+        self.assertEqual(set(preview), set(PREVIEW_FIELDS))\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).json, preview)\n+        response = self.client.delete(f\"/api/previews/{preview['id']}\", headers=self.headers)\n+        self.assertEqual(response.status_code, 204)\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).status_code, 404)\n+\n+    def test_users_cannot_read_refresh_or_delete_each_others_links(self):\n+        preview = self.add()\n+        bob = self.account(\"bob\")\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=bob).json[\"total\"], 0)\n+        with patch(\"backend.app.fetch_preview\") as fetch:\n+            for method, suffix in ((\"GET\", \"\"), (\"POST\", \"/refresh\"), (\"DELETE\", \"\")):\n+                response = self.client.open(f\"/api/previews/{preview['id']}{suffix}\", method=method, headers=bob)\n+                self.assertEqual(response.status_code, 404)\n+            fetch.assert_not_called()\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).status_code, 200)\n+\n+    def test_pagination_is_newest_first(self):\n+        previews = [self.add(title=f\"Link {index}\") for index in range(5)]\n+        response = self.client.get(\"/api/previews?page=2&page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json, {\"items\": [previews[2], previews[1]], \"total\": 5, \"page\": 2, \"page_size\": 2})\n+        self.assertEqual(self.client.get(\"/api/previews?page=10&page_size=2\", headers=self.headers).json[\"items\"], [])\n+\n+    def test_invalid_pagination(self):\n+        for query in (\"page=0\", \"page=-1\", \"page=no\", \"page=1.2\", \"page_size=0\", \"page_size=101\", \"page_size=no\"):\n+            with self.subTest(query=query):\n+                self.assertEqual(self.client.get(f\"/api/previews?{query}\", headers=self.headers).status_code, 400)\n+\n+    def test_refresh_updates_without_reordering(self):\n+        first = self.add()\n+        second = self.add()\n+        updated = fixture_preview(title=\"Fresh title\")\n+        updated[\"fetched_at\"] = \"2026-11-11T12:00:00+00:00\"\n+        with patch(\"backend.app.fetch_preview\", return_value=updated) as fetch:\n+            response = self.client.post(f\"/api/previews/{first['id']}/refresh\", headers=self.headers)\n+            fetch.assert_called_once_with(first[\"url\"])\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json[\"id\"], first[\"id\"])\n+        self.assertEqual(response.json[\"title\"], \"Fresh title\")\n+        items = self.client.get(\"/api/previews\", headers=self.headers).json[\"items\"]\n+        self.assertEqual([item[\"id\"] for item in items], [second[\"id\"], first[\"id\"]])\n+\n+    def test_failed_fetch_does_not_save_or_destroy_preview(self):\n+        original = self.add()\n+        with patch(\"backend.app.fetch_preview\", side_effect=PreviewError(\"Unreachable\", 502)):\n+            self.assertEqual(self.client.post(\"/api/previews\", json={\"url\": \"https://example.com\"}, headers=self.headers).status_code, 502)\n+            self.assertEqual(self.client.post(f\"/api/previews/{original['id']}/refresh\", headers=self.headers).status_code, 502)\n+        self.assertEqual(self.client.get(f\"/api/previews/{original['id']}\", headers=self.headers).json, original)\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).json[\"total\"], 1)\n+\n+    def test_invalid_url_and_json_are_json_errors(self):\n+        for body in ({}, {\"url\": \"file:///etc/passwd\"}, {\"url\": \"javascript:alert(1)\"}, {\"url\": 42}, []):\n+            response = self.client.post(\"/api/previews\", json=body, headers=self.headers)\n+            self.assertEqual(response.status_code, 400)\n+            self.assertIn(\"error\", response.json)\n+\n+    def test_accounts_tokens_and_previews_survive_restart(self):\n+        preview = self.add()\n+        restarted = create_app(self.config).test_client()\n+        self.assertEqual(restarted.get(f\"/api/previews/{preview['id']}\", headers=self.headers).json, preview)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.headers).json, {\"username\": \"alice\"})\n+\n+    def test_logout_revokes_token(self):\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).status_code, 401)\n+\n+    def test_expired_token_is_rejected(self):\n+        with sqlite3.connect(self.config[\"DATABASE\"]) as database:\n+            database.execute(\"UPDATE tokens SET expires_at = '2000-01-01T00:00:00+00:00'\")\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).status_code, 401)\n+\n+    def test_request_size_is_bounded(self):\n+        response = self.client.post(\"/api/previews\", json={\"url\": \"x\" * 20000}, headers=self.headers)\n+        self.assertEqual(response.status_code, 413)\n+        self.assertIn(\"error\", response.json)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** Add File: /workspace/backend/tests/test_preview.py\n+import socket\n+import threading\n+import unittest\n+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n+from unittest.mock import patch\n+\n+from backend.preview import PreviewError, fetch_preview, parse_page, public_addresses, validated_url\n+\n+\n+class MetadataTests(unittest.TestCase):\n+    def parse(self, html, url=\"https://example.com/articles/page\", content_type=\"text/html\"):\n+        return parse_page(html.encode(), content_type, url)\n+\n+    def test_open_graph_takes_precedence_and_is_plain_text(self):\n+        result = self.parse(\"\"\"\n+            <title>Fallback title</title>\n+            <meta name=\"description\" content=\"Fallback description\">\n+            <META content=\"&lt;b&gt;Good &amp; curious&lt;/b&gt;\" PROPERTY=\"og:title\">\n+            <meta property=\"og:description\" content=\"&lt;script&gt;bad()&lt;/script&gt;Plain &lt;i&gt;text&lt;/i&gt;\">\n+            <meta property=\"og:image\" content=\"../cover.png\">\n+        \"\"\")\n+        self.assertEqual(result, {\"title\": \"Good & curious\", \"description\": \"Plain text\", \"image_url\": \"https://example.com/cover.png\"})\n+\n+    def test_title_and_description_fallback(self):\n+        result = self.parse('<title> Hello &amp;  world </title><meta content=\"A short summary\" name=\"description\">')\n+        self.assertEqual(result[\"title\"], \"Hello & world\")\n+        self.assertEqual(result[\"description\"], \"A short summary\")\n+        self.assertIsNone(result[\"image_url\"])\n+\n+    def test_empty_or_unsafe_open_graph_falls_back(self):\n+        result = self.parse('<title>Good title</title><meta property=\"og:title\" content=\"&lt;script&gt;bad()&lt;/script&gt;\"><meta name=\"description\" content=\"Good description\"><meta property=\"og:description\" content=\" \">')\n+        self.assertEqual(result[\"title\"], \"Good title\")\n+        self.assertEqual(result[\"description\"], \"Good description\")\n+\n+    def test_missing_metadata(self):\n+        self.assertEqual(self.parse(\"<html><body>No metadata</body></html>\"), {\"title\": \"\", \"description\": \"\", \"image_url\": None})\n+\n+    def test_unsafe_image_urls_are_discarded(self):\n+        for image in (\"javascript:alert(1)\", \"data:text/html,bad\", \"http://127.0.0.1/image\", \"http://localhost/image\", \"http://[::1]/image\", \"http://user:pass@example.com/image\"):\n+            with self.subTest(image=image):\n+                self.assertIsNone(self.parse(f'<meta property=\"og:image\" content=\"{image}\">')[\"image_url\"])\n+\n+    def test_protocol_relative_image_and_first_tag(self):\n+        result = self.parse('<meta property=\"og:title\" content=\"First\"><meta property=\"og:title\" content=\"Second\"><meta property=\"og:image\" content=\"//images.example.com/photo.jpg\">')\n+        self.assertEqual(result[\"title\"], \"First\")\n+        self.assertEqual(result[\"image_url\"], \"https://images.example.com/photo.jpg\")\n+\n+    def test_charset_is_respected(self):\n+        body = '<title>Café</title>'.encode(\"iso-8859-1\")\n+        self.assertEqual(parse_page(body, \"text/html; charset=iso-8859-1\", \"https://example.com/\")[\"title\"], \"Café\")\n+        self.assertEqual(parse_page(b\"<title>Hello</title>\", \"text/html; charset=unknown-encoding\", \"https://example.com/\")[\"title\"], \"Hello\")\n+\n+    def test_metadata_lengths_are_bounded(self):\n+        result = self.parse(f'<title>{\"t\" * 1000}</title><meta name=\"description\" content=\"{\"d\" * 6000}\">')\n+        self.assertEqual(len(result[\"title\"]), 500)\n+        self.assertEqual(len(result[\"description\"]), 5000)\n+\n+\n+class UrlSafetyTests(unittest.TestCase):\n+    def test_invalid_urls(self):\n+        for value in (None, 1, \"\", \"example.com\", \"file:///tmp/file\", \"ftp://example.com\", \"https://\", \"http://example.com:0\", \"http://example.com:99999\", \"https://a:b@example.com\", \"https://example.com/\\n\", \"http://example.com\\\\@localhost\"):\n+            with self.subTest(value=value), self.assertRaises(PreviewError):\n+                validated_url(value)\n+\n+    def test_unicode_url_is_encoded(self):\n+        self.assertEqual(validated_url(\"https://example.com/café?q=é#fragment\"), \"https://example.com/caf%C3%A9?q=%C3%A9\")\n+        self.assertEqual(validated_url(\"https://bücher.example/\"), \"https://xn--bcher-kva.example/\")\n+\n+    def test_private_reserved_and_mixed_addresses_are_blocked(self):\n+        for address in (\"127.0.0.1\", \"10.0.0.1\", \"192.168.1.1\", \"169.254.169.254\", \"0.0.0.0\", \"224.0.0.1\", \"::1\", \"fc00::1\", \"::ffff:8.8.8.8\"):\n+            with self.subTest(address=address), patch(\"backend.preview.socket.getaddrinfo\", return_value=[(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (address, 80))]), self.assertRaises(PreviewError):\n+                public_addresses(\"example.com\", 80)\n+        with patch(\"backend.preview.socket.getaddrinfo\", return_value=[\n+            (socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"8.8.8.8\", 80)),\n+            (socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"127.0.0.1\", 80)),\n+        ]), self.assertRaises(PreviewError):\n+            public_addresses(\"example.com\", 80)\n+\n+    def test_public_address_allowed_and_dns_error_is_handled(self):\n+        addresses = [(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"8.8.8.8\", 80))]\n+        with patch(\"backend.preview.socket.getaddrinfo\", return_value=addresses):\n+            self.assertEqual(public_addresses(\"example.com\", 80), addresses)\n+        with patch(\"backend.preview.socket.getaddrinfo\", side_effect=socket.gaierror), self.assertRaises(PreviewError) as error:\n+            public_addresses(\"example.com\", 80)\n+        self.assertEqual(error.exception.status, 502)\n+\n+\n+class FixtureHandler(BaseHTTPRequestHandler):\n+    def log_message(self, _format, *_args):\n+        pass\n+\n+    def do_GET(self):\n+        if self.path in (\"/redirect\", \"/loop\", \"/private\"):\n+            self.send_response(302)\n+            self.send_header(\"Location\", {\"/redirect\": \"/page\", \"/loop\": \"/loop\", \"/private\": \"http://127.0.0.1/private\"}[self.path])\n+            self.end_headers()\n+            return\n+        self.send_response(404 if self.path == \"/missing\" else 200)\n+        self.send_header(\"Content-Type\", \"application/json\" if self.path == \"/json\" else \"text/html; charset=utf-8\")\n+        self.end_headers()\n+        self.wfile.write(b'<title>Fixture title</title><meta property=\"og:description\" content=\"Fixture description\"><meta property=\"og:image\" content=\"/cover.png\">')\n+\n+\n+class FetchTests(unittest.TestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.server = ThreadingHTTPServer((\"127.0.0.1\", 0), FixtureHandler)\n+        cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)\n+        cls.thread.start()\n+\n+    @classmethod\n+    def tearDownClass(cls):\n+        cls.server.shutdown()\n+        cls.server.server_close()\n+        cls.thread.join()\n+\n+    def setUp(self):\n+        self.base = f\"http://example.com:{self.server.server_port}\"\n+\n+        def fixture_addresses(host, port):\n+            if host != \"example.com\":\n+                raise PreviewError(\"Only public web links can be previewed.\", 400)\n+            return [(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"127.0.0.1\", port))]\n+\n+        self.patcher = patch(\"backend.preview.public_addresses\", side_effect=fixture_addresses)\n+        self.patcher.start()\n+        self.addCleanup(self.patcher.stop)\n+\n+    def test_fetch_and_relative_redirect(self):\n+        result = fetch_preview(self.base + \"/redirect\")\n+        self.assertEqual(result[\"url\"], self.base + \"/redirect\")\n+        self.assertEqual(result[\"final_url\"], self.base + \"/page\")\n+        self.assertEqual(result[\"status_code\"], 200)\n+        self.assertEqual(result[\"title\"], \"Fixture title\")\n+        self.assertEqual(result[\"description\"], \"Fixture description\")\n+        self.assertEqual(result[\"image_url\"], self.base + \"/cover.png\")\n+        self.assertTrue(result[\"fetched_at\"].endswith(\"+00:00\"))\n+\n+    def test_redirect_to_private_address_is_blocked(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/private\")\n+        self.assertEqual(error.exception.status, 400)\n+\n+    def test_redirect_limit(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/loop\")\n+        self.assertEqual(error.exception.status, 502)\n+\n+    def test_non_html_is_rejected(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/json\")\n+        self.assertEqual(error.exception.status, 422)\n+\n+    def test_error_page_status_is_retained(self):\n+        self.assertEqual(fetch_preview(self.base + \"/missing\")[\"status_code\"], 404)\n+\n+    def test_response_size_limit(self):\n+        with patch(\"backend.preview.MAX_PAGE_BYTES\", 32), self.assertRaises(PreviewError):\n+            fetch_preview(self.base + \"/page\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** End Patch"},"output":"Success. Updated the following files:\nM frontend/src/components/Dialog.tsx\nM backend/app.py\nM backend/preview.py\nA pyproject.toml\nA backend/tests/test_app.py\nA backend/tests/test_preview.py","metadata":{"diff":"Index: /workspace/frontend/src/components/Dialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/Dialog.tsx\n+++ /workspace/frontend/src/components/Dialog.tsx\n@@ -9,18 +9,23 @@\n }) {\n   const titleId = useId();\n   const ref = useRef<HTMLDivElement>(null);\n   const closeRef = useRef(onClose);\n-  closeRef.current = onClose;\n+  const busyRef = useRef(busy);\n \n   useEffect(() => {\n+    closeRef.current = onClose;\n+    busyRef.current = busy;\n+  }, [onClose, busy]);\n+\n+  useEffect(() => {\n     const previous = document.activeElement as HTMLElement | null;\n     const overflow = document.body.style.overflow;\n     document.body.style.overflow = \"hidden\";\n     const panel = ref.current;\n-    panel?.querySelector<HTMLElement>(\"input, button\")?.focus();\n+    (panel?.querySelector<HTMLElement>(\"input\") ?? panel?.querySelector<HTMLElement>(\"button\"))?.focus();\n     function keydown(event: KeyboardEvent) {\n-      if (event.key === \"Escape\" && !busy) closeRef.current();\n+      if (event.key === \"Escape\" && !busyRef.current) closeRef.current();\n       if (event.key === \"Tab\" && panel) {\n         const elements = Array.from(panel.querySelectorAll<HTMLElement>(\n           'button:not([disabled]), input:not([disabled]), a[href], [tabindex=\"0\"]',\n         ));\n@@ -40,9 +45,9 @@\n       document.body.style.overflow = overflow;\n       document.removeEventListener(\"keydown\", keydown);\n       previous?.focus();\n     };\n-  }, [busy]);\n+  }, []);\n \n   return (\n     <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/30 p-5 backdrop-blur-sm\" onMouseDown={(event) => {\n       if (event.target === event.currentTarget && !busy) onClose();\n\nIndex: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,9 +1,9 @@\n import hashlib\n import os\n import secrets\n import sqlite3\n-from datetime import datetime, timedelta, timezone\n+from datetime import UTC, datetime, timedelta\n from functools import wraps\n from pathlib import Path\n \n from flask import Flask, g, request, send_from_directory\n@@ -84,9 +84,9 @@\n             token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n             user = db().execute(\n                 \"SELECT users.id, users.username FROM tokens JOIN users \"\n                 \"ON users.id = tokens.user_id WHERE token_hash = ? AND expires_at > ?\",\n-                (token_hash, datetime.now(timezone.utc).isoformat()),\n+                (token_hash, datetime.now(UTC).isoformat()),\n             ).fetchone()\n             if user is None:\n                 return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n             g.user = user\n@@ -171,9 +171,9 @@\n         user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n         if user is None or not check_password_hash(user[\"password_hash\"], password):\n             return {\"error\": \"Incorrect username or password.\"}, 401\n         token = secrets.token_urlsafe(48)\n-        now = datetime.now(timezone.utc)\n+        now = datetime.now(UTC)\n         with db():\n             db().execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n             db().execute(\n                 \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n\nIndex: /workspace/backend/preview.py\n===================================================================\n--- /workspace/backend/preview.py\n+++ /workspace/backend/preview.py\n@@ -3,9 +3,9 @@\n import re\n import socket\n import ssl\n import time\n-from datetime import datetime, timezone\n+from datetime import UTC, datetime\n from html.parser import HTMLParser\n from urllib.parse import quote, urljoin, urlsplit, urlunsplit\n \n MAX_PAGE_BYTES = 2 * 1024 * 1024\n@@ -85,8 +85,10 @@\n             raise ValueError\n         if parsed.username is not None or parsed.password is not None:\n             raise ValueError\n         port = parsed.port\n+        if port is not None and not 1 <= port <= 65535:\n+            raise ValueError\n         hostname = parsed.hostname.encode(\"idna\").decode(\"ascii\")\n         if \"%\" in hostname or not hostname:\n             raise ValueError\n         host = f\"[{hostname}]\" if \":\" in hostname else hostname\n@@ -144,11 +146,11 @@\n     raise PreviewError(\"The site could not be reached. Please try again.\", 502) from last_error\n \n \n def parse_page(body, content_type, final_url):\n-    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.I)\n+    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.IGNORECASE)\n     if charset_match is None:\n-        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.I)\n+        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.IGNORECASE)\n     charset = charset_match.group(1) if charset_match else \"utf-8\"\n     try:\n         html = body.decode(charset, errors=\"replace\")\n     except LookupError:\n@@ -219,9 +221,9 @@\n                     raise PreviewError(\"This page is too large to preview.\")\n                 chunks.append(chunk)\n             metadata = parse_page(b\"\".join(chunks), content_type, final_url)\n             return {\"url\": url, \"final_url\": final_url, \"status_code\": response.status,\n-                    **metadata, \"fetched_at\": datetime.now(timezone.utc).isoformat()}\n+                    **metadata, \"fetched_at\": datetime.now(UTC).isoformat()}\n         except (OSError, http.client.HTTPException):\n             raise PreviewError(\"The site took too long or returned an incomplete page.\", 502) from None\n         finally:\n             response.close()\n\nIndex: /workspace/pyproject.toml\n===================================================================\n--- /workspace/pyproject.toml\n+++ /workspace/pyproject.toml\n@@ -0,0 +1,6 @@\n+[tool.ruff]\n+target-version = \"py313\"\n+line-length = 100\n+\n+[tool.ruff.lint]\n+select = [\"E4\", \"E7\", \"E9\", \"F\", \"I\", \"UP\"]\n\nIndex: /workspace/backend/tests/test_app.py\n===================================================================\n--- /workspace/backend/tests/test_app.py\n+++ /workspace/backend/tests/test_app.py\n@@ -0,0 +1,169 @@\n+import hashlib\n+import sqlite3\n+import tempfile\n+import unittest\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from backend.app import PREVIEW_FIELDS, create_app\n+from backend.preview import PreviewError\n+\n+\n+def fixture_preview(url=\"https://example.com/\", title=\"A good find\"):\n+    return {\n+        \"url\": url,\n+        \"final_url\": \"https://example.com/article\",\n+        \"status_code\": 200,\n+        \"title\": title,\n+        \"description\": \"A useful description.\",\n+        \"image_url\": \"https://example.com/image.png\",\n+        \"fetched_at\": \"2026-11-10T12:00:00+00:00\",\n+    }\n+\n+\n+class AppTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.config = {\"TESTING\": True, \"DATABASE\": str(Path(self.directory.name) / \"app.sqlite3\")}\n+        self.app = create_app(self.config)\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"secret\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"secret\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def add(self, url=\"https://example.com/\", title=\"A good find\"):\n+        with patch(\"backend.app.fetch_preview\", return_value=fixture_preview(url, title)):\n+            response = self.client.post(\"/api/previews\", json={\"url\": url}, headers=self.headers)\n+        self.assertEqual(response.status_code, 201)\n+        return response.json\n+\n+    def test_health_and_unknown_api(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        response = self.client.get(\"/api/not-a-route\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertIn(\"error\", response.json)\n+        self.assertEqual(self.client.post(\"/api/health\").status_code, 405)\n+\n+    def test_registration_validation_and_duplicates(self):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"other\"})\n+        self.assertEqual(response.status_code, 409)\n+        for body in (None, [], {}, {\"username\": 1, \"password\": \"secret\"},\n+                     {\"username\": \"   \", \"password\": \"secret\"},\n+                     {\"username\": \"user\", \"password\": \"\"},\n+                     {\"username\": \"user\\nname\", \"password\": \"secret\"}):\n+            with self.subTest(body=body):\n+                response = self.client.post(\"/api/auth/register\", json=body)\n+                self.assertEqual(response.status_code, 400)\n+\n+    def test_login_rejects_wrong_password(self):\n+        for username, password in ((\"alice\", \"wrong\"), (\"unknown\", \"secret\")):\n+            response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password})\n+            self.assertEqual(response.status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.headers).json, {\"username\": \"alice\"})\n+\n+    def test_credentials_and_tokens_are_hashed(self):\n+        with sqlite3.connect(self.config[\"DATABASE\"]) as database:\n+            password_hash = database.execute(\"SELECT password_hash FROM users\").fetchone()[0]\n+            token_hash = database.execute(\"SELECT token_hash FROM tokens\").fetchone()[0]\n+        token = self.headers[\"Authorization\"].split()[1]\n+        self.assertNotEqual(password_hash, \"secret\")\n+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())\n+\n+    def test_all_preview_routes_require_authentication(self):\n+        for method, path in ((\"GET\", \"/api/previews\"), (\"POST\", \"/api/previews\"),\n+                             (\"GET\", \"/api/previews/1\"), (\"POST\", \"/api/previews/1/refresh\"),\n+                             (\"DELETE\", \"/api/previews/1\")):\n+            for authorization in (None, \"Bearer invalid\", \"Basic invalid\", \"Bearer\"):\n+                with self.subTest(method=method, path=path, authorization=authorization):\n+                    response = self.client.open(path, method=method, headers={\"Authorization\": authorization} if authorization else {})\n+                    self.assertEqual(response.status_code, 401)\n+\n+    def test_create_get_and_delete(self):\n+        preview = self.add()\n+        self.assertEqual(set(preview), set(PREVIEW_FIELDS))\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).json, preview)\n+        response = self.client.delete(f\"/api/previews/{preview['id']}\", headers=self.headers)\n+        self.assertEqual(response.status_code, 204)\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).status_code, 404)\n+\n+    def test_users_cannot_read_refresh_or_delete_each_others_links(self):\n+        preview = self.add()\n+        bob = self.account(\"bob\")\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=bob).json[\"total\"], 0)\n+        with patch(\"backend.app.fetch_preview\") as fetch:\n+            for method, suffix in ((\"GET\", \"\"), (\"POST\", \"/refresh\"), (\"DELETE\", \"\")):\n+                response = self.client.open(f\"/api/previews/{preview['id']}{suffix}\", method=method, headers=bob)\n+                self.assertEqual(response.status_code, 404)\n+            fetch.assert_not_called()\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).status_code, 200)\n+\n+    def test_pagination_is_newest_first(self):\n+        previews = [self.add(title=f\"Link {index}\") for index in range(5)]\n+        response = self.client.get(\"/api/previews?page=2&page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json, {\"items\": [previews[2], previews[1]], \"total\": 5, \"page\": 2, \"page_size\": 2})\n+        self.assertEqual(self.client.get(\"/api/previews?page=10&page_size=2\", headers=self.headers).json[\"items\"], [])\n+\n+    def test_invalid_pagination(self):\n+        for query in (\"page=0\", \"page=-1\", \"page=no\", \"page=1.2\", \"page_size=0\", \"page_size=101\", \"page_size=no\"):\n+            with self.subTest(query=query):\n+                self.assertEqual(self.client.get(f\"/api/previews?{query}\", headers=self.headers).status_code, 400)\n+\n+    def test_refresh_updates_without_reordering(self):\n+        first = self.add()\n+        second = self.add()\n+        updated = fixture_preview(title=\"Fresh title\")\n+        updated[\"fetched_at\"] = \"2026-11-11T12:00:00+00:00\"\n+        with patch(\"backend.app.fetch_preview\", return_value=updated) as fetch:\n+            response = self.client.post(f\"/api/previews/{first['id']}/refresh\", headers=self.headers)\n+            fetch.assert_called_once_with(first[\"url\"])\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json[\"id\"], first[\"id\"])\n+        self.assertEqual(response.json[\"title\"], \"Fresh title\")\n+        items = self.client.get(\"/api/previews\", headers=self.headers).json[\"items\"]\n+        self.assertEqual([item[\"id\"] for item in items], [second[\"id\"], first[\"id\"]])\n+\n+    def test_failed_fetch_does_not_save_or_destroy_preview(self):\n+        original = self.add()\n+        with patch(\"backend.app.fetch_preview\", side_effect=PreviewError(\"Unreachable\", 502)):\n+            self.assertEqual(self.client.post(\"/api/previews\", json={\"url\": \"https://example.com\"}, headers=self.headers).status_code, 502)\n+            self.assertEqual(self.client.post(f\"/api/previews/{original['id']}/refresh\", headers=self.headers).status_code, 502)\n+        self.assertEqual(self.client.get(f\"/api/previews/{original['id']}\", headers=self.headers).json, original)\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).json[\"total\"], 1)\n+\n+    def test_invalid_url_and_json_are_json_errors(self):\n+        for body in ({}, {\"url\": \"file:///etc/passwd\"}, {\"url\": \"javascript:alert(1)\"}, {\"url\": 42}, []):\n+            response = self.client.post(\"/api/previews\", json=body, headers=self.headers)\n+            self.assertEqual(response.status_code, 400)\n+            self.assertIn(\"error\", response.json)\n+\n+    def test_accounts_tokens_and_previews_survive_restart(self):\n+        preview = self.add()\n+        restarted = create_app(self.config).test_client()\n+        self.assertEqual(restarted.get(f\"/api/previews/{preview['id']}\", headers=self.headers).json, preview)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.headers).json, {\"username\": \"alice\"})\n+\n+    def test_logout_revokes_token(self):\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).status_code, 401)\n+\n+    def test_expired_token_is_rejected(self):\n+        with sqlite3.connect(self.config[\"DATABASE\"]) as database:\n+            database.execute(\"UPDATE tokens SET expires_at = '2000-01-01T00:00:00+00:00'\")\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).status_code, 401)\n+\n+    def test_request_size_is_bounded(self):\n+        response = self.client.post(\"/api/previews\", json={\"url\": \"x\" * 20000}, headers=self.headers)\n+        self.assertEqual(response.status_code, 413)\n+        self.assertIn(\"error\", response.json)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\nIndex: /workspace/backend/tests/test_preview.py\n===================================================================\n--- /workspace/backend/tests/test_preview.py\n+++ /workspace/backend/tests/test_preview.py\n@@ -0,0 +1,163 @@\n+import socket\n+import threading\n+import unittest\n+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n+from unittest.mock import patch\n+\n+from backend.preview import PreviewError, fetch_preview, parse_page, public_addresses, validated_url\n+\n+\n+class MetadataTests(unittest.TestCase):\n+    def parse(self, html, url=\"https://example.com/articles/page\", content_type=\"text/html\"):\n+        return parse_page(html.encode(), content_type, url)\n+\n+    def test_open_graph_takes_precedence_and_is_plain_text(self):\n+        result = self.parse(\"\"\"\n+            <title>Fallback title</title>\n+            <meta name=\"description\" content=\"Fallback description\">\n+            <META content=\"&lt;b&gt;Good &amp; curious&lt;/b&gt;\" PROPERTY=\"og:title\">\n+            <meta property=\"og:description\" content=\"&lt;script&gt;bad()&lt;/script&gt;Plain &lt;i&gt;text&lt;/i&gt;\">\n+            <meta property=\"og:image\" content=\"../cover.png\">\n+        \"\"\")\n+        self.assertEqual(result, {\"title\": \"Good & curious\", \"description\": \"Plain text\", \"image_url\": \"https://example.com/cover.png\"})\n+\n+    def test_title_and_description_fallback(self):\n+        result = self.parse('<title> Hello &amp;  world </title><meta content=\"A short summary\" name=\"description\">')\n+        self.assertEqual(result[\"title\"], \"Hello & world\")\n+        self.assertEqual(result[\"description\"], \"A short summary\")\n+        self.assertIsNone(result[\"image_url\"])\n+\n+    def test_empty_or_unsafe_open_graph_falls_back(self):\n+        result = self.parse('<title>Good title</title><meta property=\"og:title\" content=\"&lt;script&gt;bad()&lt;/script&gt;\"><meta name=\"description\" content=\"Good description\"><meta property=\"og:description\" content=\" \">')\n+        self.assertEqual(result[\"title\"], \"Good title\")\n+        self.assertEqual(result[\"description\"], \"Good description\")\n+\n+    def test_missing_metadata(self):\n+        self.assertEqual(self.parse(\"<html><body>No metadata</body></html>\"), {\"title\": \"\", \"description\": \"\", \"image_url\": None})\n+\n+    def test_unsafe_image_urls_are_discarded(self):\n+        for image in (\"javascript:alert(1)\", \"data:text/html,bad\", \"http://127.0.0.1/image\", \"http://localhost/image\", \"http://[::1]/image\", \"http://user:pass@example.com/image\"):\n+            with self.subTest(image=image):\n+                self.assertIsNone(self.parse(f'<meta property=\"og:image\" content=\"{image}\">')[\"image_url\"])\n+\n+    def test_protocol_relative_image_and_first_tag(self):\n+        result = self.parse('<meta property=\"og:title\" content=\"First\"><meta property=\"og:title\" content=\"Second\"><meta property=\"og:image\" content=\"//images.example.com/photo.jpg\">')\n+        self.assertEqual(result[\"title\"], \"First\")\n+        self.assertEqual(result[\"image_url\"], \"https://images.example.com/photo.jpg\")\n+\n+    def test_charset_is_respected(self):\n+        body = '<title>Café</title>'.encode(\"iso-8859-1\")\n+        self.assertEqual(parse_page(body, \"text/html; charset=iso-8859-1\", \"https://example.com/\")[\"title\"], \"Café\")\n+        self.assertEqual(parse_page(b\"<title>Hello</title>\", \"text/html; charset=unknown-encoding\", \"https://example.com/\")[\"title\"], \"Hello\")\n+\n+    def test_metadata_lengths_are_bounded(self):\n+        result = self.parse(f'<title>{\"t\" * 1000}</title><meta name=\"description\" content=\"{\"d\" * 6000}\">')\n+        self.assertEqual(len(result[\"title\"]), 500)\n+        self.assertEqual(len(result[\"description\"]), 5000)\n+\n+\n+class UrlSafetyTests(unittest.TestCase):\n+    def test_invalid_urls(self):\n+        for value in (None, 1, \"\", \"example.com\", \"file:///tmp/file\", \"ftp://example.com\", \"https://\", \"http://example.com:0\", \"http://example.com:99999\", \"https://a:b@example.com\", \"https://example.com/\\n\", \"http://example.com\\\\@localhost\"):\n+            with self.subTest(value=value), self.assertRaises(PreviewError):\n+                validated_url(value)\n+\n+    def test_unicode_url_is_encoded(self):\n+        self.assertEqual(validated_url(\"https://example.com/café?q=é#fragment\"), \"https://example.com/caf%C3%A9?q=%C3%A9\")\n+        self.assertEqual(validated_url(\"https://bücher.example/\"), \"https://xn--bcher-kva.example/\")\n+\n+    def test_private_reserved_and_mixed_addresses_are_blocked(self):\n+        for address in (\"127.0.0.1\", \"10.0.0.1\", \"192.168.1.1\", \"169.254.169.254\", \"0.0.0.0\", \"224.0.0.1\", \"::1\", \"fc00::1\", \"::ffff:8.8.8.8\"):\n+            with self.subTest(address=address), patch(\"backend.preview.socket.getaddrinfo\", return_value=[(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (address, 80))]), self.assertRaises(PreviewError):\n+                public_addresses(\"example.com\", 80)\n+        with patch(\"backend.preview.socket.getaddrinfo\", return_value=[\n+            (socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"8.8.8.8\", 80)),\n+            (socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"127.0.0.1\", 80)),\n+        ]), self.assertRaises(PreviewError):\n+            public_addresses(\"example.com\", 80)\n+\n+    def test_public_address_allowed_and_dns_error_is_handled(self):\n+        addresses = [(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"8.8.8.8\", 80))]\n+        with patch(\"backend.preview.socket.getaddrinfo\", return_value=addresses):\n+            self.assertEqual(public_addresses(\"example.com\", 80), addresses)\n+        with patch(\"backend.preview.socket.getaddrinfo\", side_effect=socket.gaierror), self.assertRaises(PreviewError) as error:\n+            public_addresses(\"example.com\", 80)\n+        self.assertEqual(error.exception.status, 502)\n+\n+\n+class FixtureHandler(BaseHTTPRequestHandler):\n+    def log_message(self, _format, *_args):\n+        pass\n+\n+    def do_GET(self):\n+        if self.path in (\"/redirect\", \"/loop\", \"/private\"):\n+            self.send_response(302)\n+            self.send_header(\"Location\", {\"/redirect\": \"/page\", \"/loop\": \"/loop\", \"/private\": \"http://127.0.0.1/private\"}[self.path])\n+            self.end_headers()\n+            return\n+        self.send_response(404 if self.path == \"/missing\" else 200)\n+        self.send_header(\"Content-Type\", \"application/json\" if self.path == \"/json\" else \"text/html; charset=utf-8\")\n+        self.end_headers()\n+        self.wfile.write(b'<title>Fixture title</title><meta property=\"og:description\" content=\"Fixture description\"><meta property=\"og:image\" content=\"/cover.png\">')\n+\n+\n+class FetchTests(unittest.TestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.server = ThreadingHTTPServer((\"127.0.0.1\", 0), FixtureHandler)\n+        cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)\n+        cls.thread.start()\n+\n+    @classmethod\n+    def tearDownClass(cls):\n+        cls.server.shutdown()\n+        cls.server.server_close()\n+        cls.thread.join()\n+\n+    def setUp(self):\n+        self.base = f\"http://example.com:{self.server.server_port}\"\n+\n+        def fixture_addresses(host, port):\n+            if host != \"example.com\":\n+                raise PreviewError(\"Only public web links can be previewed.\", 400)\n+            return [(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"127.0.0.1\", port))]\n+\n+        self.patcher = patch(\"backend.preview.public_addresses\", side_effect=fixture_addresses)\n+        self.patcher.start()\n+        self.addCleanup(self.patcher.stop)\n+\n+    def test_fetch_and_relative_redirect(self):\n+        result = fetch_preview(self.base + \"/redirect\")\n+        self.assertEqual(result[\"url\"], self.base + \"/redirect\")\n+        self.assertEqual(result[\"final_url\"], self.base + \"/page\")\n+        self.assertEqual(result[\"status_code\"], 200)\n+        self.assertEqual(result[\"title\"], \"Fixture title\")\n+        self.assertEqual(result[\"description\"], \"Fixture description\")\n+        self.assertEqual(result[\"image_url\"], self.base + \"/cover.png\")\n+        self.assertTrue(result[\"fetched_at\"].endswith(\"+00:00\"))\n+\n+    def test_redirect_to_private_address_is_blocked(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/private\")\n+        self.assertEqual(error.exception.status, 400)\n+\n+    def test_redirect_limit(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/loop\")\n+        self.assertEqual(error.exception.status, 502)\n+\n+    def test_non_html_is_rejected(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/json\")\n+        self.assertEqual(error.exception.status, 422)\n+\n+    def test_error_page_status_is_retained(self):\n+        self.assertEqual(fetch_preview(self.base + \"/missing\")[\"status_code\"], 404)\n+\n+    def test_response_size_limit(self):\n+        with patch(\"backend.preview.MAX_PAGE_BYTES\", 32), self.assertRaises(PreviewError):\n+            fetch_preview(self.base + \"/page\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\n","files":[{"filePath":"/workspace/frontend/src/components/Dialog.tsx","relativePath":"frontend/src/components/Dialog.tsx","type":"update","patch":"Index: /workspace/frontend/src/components/Dialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/Dialog.tsx\n+++ /workspace/frontend/src/components/Dialog.tsx\n@@ -9,18 +9,23 @@\n }) {\n   const titleId = useId();\n   const ref = useRef<HTMLDivElement>(null);\n   const closeRef = useRef(onClose);\n-  closeRef.current = onClose;\n+  const busyRef = useRef(busy);\n \n   useEffect(() => {\n+    closeRef.current = onClose;\n+    busyRef.current = busy;\n+  }, [onClose, busy]);\n+\n+  useEffect(() => {\n     const previous = document.activeElement as HTMLElement | null;\n     const overflow = document.body.style.overflow;\n     document.body.style.overflow = \"hidden\";\n     const panel = ref.current;\n-    panel?.querySelector<HTMLElement>(\"input, button\")?.focus();\n+    (panel?.querySelector<HTMLElement>(\"input\") ?? panel?.querySelector<HTMLElement>(\"button\"))?.focus();\n     function keydown(event: KeyboardEvent) {\n-      if (event.key === \"Escape\" && !busy) closeRef.current();\n+      if (event.key === \"Escape\" && !busyRef.current) closeRef.current();\n       if (event.key === \"Tab\" && panel) {\n         const elements = Array.from(panel.querySelectorAll<HTMLElement>(\n           'button:not([disabled]), input:not([disabled]), a[href], [tabindex=\"0\"]',\n         ));\n@@ -40,9 +45,9 @@\n       document.body.style.overflow = overflow;\n       document.removeEventListener(\"keydown\", keydown);\n       previous?.focus();\n     };\n-  }, [busy]);\n+  }, []);\n \n   return (\n     <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/30 p-5 backdrop-blur-sm\" onMouseDown={(event) => {\n       if (event.target === event.currentTarget && !busy) onClose();\n","additions":9,"deletions":4},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"update","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,9 +1,9 @@\n import hashlib\n import os\n import secrets\n import sqlite3\n-from datetime import datetime, timedelta, timezone\n+from datetime import UTC, datetime, timedelta\n from functools import wraps\n from pathlib import Path\n \n from flask import Flask, g, request, send_from_directory\n@@ -84,9 +84,9 @@\n             token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n             user = db().execute(\n                 \"SELECT users.id, users.username FROM tokens JOIN users \"\n                 \"ON users.id = tokens.user_id WHERE token_hash = ? AND expires_at > ?\",\n-                (token_hash, datetime.now(timezone.utc).isoformat()),\n+                (token_hash, datetime.now(UTC).isoformat()),\n             ).fetchone()\n             if user is None:\n                 return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n             g.user = user\n@@ -171,9 +171,9 @@\n         user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n         if user is None or not check_password_hash(user[\"password_hash\"], password):\n             return {\"error\": \"Incorrect username or password.\"}, 401\n         token = secrets.token_urlsafe(48)\n-        now = datetime.now(timezone.utc)\n+        now = datetime.now(UTC)\n         with db():\n             db().execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n             db().execute(\n                 \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n","additions":3,"deletions":3},{"filePath":"/workspace/backend/preview.py","relativePath":"backend/preview.py","type":"update","patch":"Index: /workspace/backend/preview.py\n===================================================================\n--- /workspace/backend/preview.py\n+++ /workspace/backend/preview.py\n@@ -3,9 +3,9 @@\n import re\n import socket\n import ssl\n import time\n-from datetime import datetime, timezone\n+from datetime import UTC, datetime\n from html.parser import HTMLParser\n from urllib.parse import quote, urljoin, urlsplit, urlunsplit\n \n MAX_PAGE_BYTES = 2 * 1024 * 1024\n@@ -85,8 +85,10 @@\n             raise ValueError\n         if parsed.username is not None or parsed.password is not None:\n             raise ValueError\n         port = parsed.port\n+        if port is not None and not 1 <= port <= 65535:\n+            raise ValueError\n         hostname = parsed.hostname.encode(\"idna\").decode(\"ascii\")\n         if \"%\" in hostname or not hostname:\n             raise ValueError\n         host = f\"[{hostname}]\" if \":\" in hostname else hostname\n@@ -144,11 +146,11 @@\n     raise PreviewError(\"The site could not be reached. Please try again.\", 502) from last_error\n \n \n def parse_page(body, content_type, final_url):\n-    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.I)\n+    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.IGNORECASE)\n     if charset_match is None:\n-        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.I)\n+        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.IGNORECASE)\n     charset = charset_match.group(1) if charset_match else \"utf-8\"\n     try:\n         html = body.decode(charset, errors=\"replace\")\n     except LookupError:\n@@ -219,9 +221,9 @@\n                     raise PreviewError(\"This page is too large to preview.\")\n                 chunks.append(chunk)\n             metadata = parse_page(b\"\".join(chunks), content_type, final_url)\n             return {\"url\": url, \"final_url\": final_url, \"status_code\": response.status,\n-                    **metadata, \"fetched_at\": datetime.now(timezone.utc).isoformat()}\n+                    **metadata, \"fetched_at\": datetime.now(UTC).isoformat()}\n         except (OSError, http.client.HTTPException):\n             raise PreviewError(\"The site took too long or returned an incomplete page.\", 502) from None\n         finally:\n             response.close()\n","additions":6,"deletions":4},{"filePath":"/workspace/pyproject.toml","relativePath":"pyproject.toml","type":"add","patch":"Index: /workspace/pyproject.toml\n===================================================================\n--- /workspace/pyproject.toml\n+++ /workspace/pyproject.toml\n@@ -0,0 +1,6 @@\n+[tool.ruff]\n+target-version = \"py313\"\n+line-length = 100\n+\n+[tool.ruff.lint]\n+select = [\"E4\", \"E7\", \"E9\", \"F\", \"I\", \"UP\"]\n","additions":6,"deletions":0},{"filePath":"/workspace/backend/tests/test_app.py","relativePath":"backend/tests/test_app.py","type":"add","patch":"Index: /workspace/backend/tests/test_app.py\n===================================================================\n--- /workspace/backend/tests/test_app.py\n+++ /workspace/backend/tests/test_app.py\n@@ -0,0 +1,169 @@\n+import hashlib\n+import sqlite3\n+import tempfile\n+import unittest\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from backend.app import PREVIEW_FIELDS, create_app\n+from backend.preview import PreviewError\n+\n+\n+def fixture_preview(url=\"https://example.com/\", title=\"A good find\"):\n+    return {\n+        \"url\": url,\n+        \"final_url\": \"https://example.com/article\",\n+        \"status_code\": 200,\n+        \"title\": title,\n+        \"description\": \"A useful description.\",\n+        \"image_url\": \"https://example.com/image.png\",\n+        \"fetched_at\": \"2026-11-10T12:00:00+00:00\",\n+    }\n+\n+\n+class AppTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.config = {\"TESTING\": True, \"DATABASE\": str(Path(self.directory.name) / \"app.sqlite3\")}\n+        self.app = create_app(self.config)\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"secret\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"secret\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def add(self, url=\"https://example.com/\", title=\"A good find\"):\n+        with patch(\"backend.app.fetch_preview\", return_value=fixture_preview(url, title)):\n+            response = self.client.post(\"/api/previews\", json={\"url\": url}, headers=self.headers)\n+        self.assertEqual(response.status_code, 201)\n+        return response.json\n+\n+    def test_health_and_unknown_api(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        response = self.client.get(\"/api/not-a-route\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertIn(\"error\", response.json)\n+        self.assertEqual(self.client.post(\"/api/health\").status_code, 405)\n+\n+    def test_registration_validation_and_duplicates(self):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"other\"})\n+        self.assertEqual(response.status_code, 409)\n+        for body in (None, [], {}, {\"username\": 1, \"password\": \"secret\"},\n+                     {\"username\": \"   \", \"password\": \"secret\"},\n+                     {\"username\": \"user\", \"password\": \"\"},\n+                     {\"username\": \"user\\nname\", \"password\": \"secret\"}):\n+            with self.subTest(body=body):\n+                response = self.client.post(\"/api/auth/register\", json=body)\n+                self.assertEqual(response.status_code, 400)\n+\n+    def test_login_rejects_wrong_password(self):\n+        for username, password in ((\"alice\", \"wrong\"), (\"unknown\", \"secret\")):\n+            response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password})\n+            self.assertEqual(response.status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.headers).json, {\"username\": \"alice\"})\n+\n+    def test_credentials_and_tokens_are_hashed(self):\n+        with sqlite3.connect(self.config[\"DATABASE\"]) as database:\n+            password_hash = database.execute(\"SELECT password_hash FROM users\").fetchone()[0]\n+            token_hash = database.execute(\"SELECT token_hash FROM tokens\").fetchone()[0]\n+        token = self.headers[\"Authorization\"].split()[1]\n+        self.assertNotEqual(password_hash, \"secret\")\n+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())\n+\n+    def test_all_preview_routes_require_authentication(self):\n+        for method, path in ((\"GET\", \"/api/previews\"), (\"POST\", \"/api/previews\"),\n+                             (\"GET\", \"/api/previews/1\"), (\"POST\", \"/api/previews/1/refresh\"),\n+                             (\"DELETE\", \"/api/previews/1\")):\n+            for authorization in (None, \"Bearer invalid\", \"Basic invalid\", \"Bearer\"):\n+                with self.subTest(method=method, path=path, authorization=authorization):\n+                    response = self.client.open(path, method=method, headers={\"Authorization\": authorization} if authorization else {})\n+                    self.assertEqual(response.status_code, 401)\n+\n+    def test_create_get_and_delete(self):\n+        preview = self.add()\n+        self.assertEqual(set(preview), set(PREVIEW_FIELDS))\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).json, preview)\n+        response = self.client.delete(f\"/api/previews/{preview['id']}\", headers=self.headers)\n+        self.assertEqual(response.status_code, 204)\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).status_code, 404)\n+\n+    def test_users_cannot_read_refresh_or_delete_each_others_links(self):\n+        preview = self.add()\n+        bob = self.account(\"bob\")\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=bob).json[\"total\"], 0)\n+        with patch(\"backend.app.fetch_preview\") as fetch:\n+            for method, suffix in ((\"GET\", \"\"), (\"POST\", \"/refresh\"), (\"DELETE\", \"\")):\n+                response = self.client.open(f\"/api/previews/{preview['id']}{suffix}\", method=method, headers=bob)\n+                self.assertEqual(response.status_code, 404)\n+            fetch.assert_not_called()\n+        self.assertEqual(self.client.get(f\"/api/previews/{preview['id']}\", headers=self.headers).status_code, 200)\n+\n+    def test_pagination_is_newest_first(self):\n+        previews = [self.add(title=f\"Link {index}\") for index in range(5)]\n+        response = self.client.get(\"/api/previews?page=2&page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json, {\"items\": [previews[2], previews[1]], \"total\": 5, \"page\": 2, \"page_size\": 2})\n+        self.assertEqual(self.client.get(\"/api/previews?page=10&page_size=2\", headers=self.headers).json[\"items\"], [])\n+\n+    def test_invalid_pagination(self):\n+        for query in (\"page=0\", \"page=-1\", \"page=no\", \"page=1.2\", \"page_size=0\", \"page_size=101\", \"page_size=no\"):\n+            with self.subTest(query=query):\n+                self.assertEqual(self.client.get(f\"/api/previews?{query}\", headers=self.headers).status_code, 400)\n+\n+    def test_refresh_updates_without_reordering(self):\n+        first = self.add()\n+        second = self.add()\n+        updated = fixture_preview(title=\"Fresh title\")\n+        updated[\"fetched_at\"] = \"2026-11-11T12:00:00+00:00\"\n+        with patch(\"backend.app.fetch_preview\", return_value=updated) as fetch:\n+            response = self.client.post(f\"/api/previews/{first['id']}/refresh\", headers=self.headers)\n+            fetch.assert_called_once_with(first[\"url\"])\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json[\"id\"], first[\"id\"])\n+        self.assertEqual(response.json[\"title\"], \"Fresh title\")\n+        items = self.client.get(\"/api/previews\", headers=self.headers).json[\"items\"]\n+        self.assertEqual([item[\"id\"] for item in items], [second[\"id\"], first[\"id\"]])\n+\n+    def test_failed_fetch_does_not_save_or_destroy_preview(self):\n+        original = self.add()\n+        with patch(\"backend.app.fetch_preview\", side_effect=PreviewError(\"Unreachable\", 502)):\n+            self.assertEqual(self.client.post(\"/api/previews\", json={\"url\": \"https://example.com\"}, headers=self.headers).status_code, 502)\n+            self.assertEqual(self.client.post(f\"/api/previews/{original['id']}/refresh\", headers=self.headers).status_code, 502)\n+        self.assertEqual(self.client.get(f\"/api/previews/{original['id']}\", headers=self.headers).json, original)\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).json[\"total\"], 1)\n+\n+    def test_invalid_url_and_json_are_json_errors(self):\n+        for body in ({}, {\"url\": \"file:///etc/passwd\"}, {\"url\": \"javascript:alert(1)\"}, {\"url\": 42}, []):\n+            response = self.client.post(\"/api/previews\", json=body, headers=self.headers)\n+            self.assertEqual(response.status_code, 400)\n+            self.assertIn(\"error\", response.json)\n+\n+    def test_accounts_tokens_and_previews_survive_restart(self):\n+        preview = self.add()\n+        restarted = create_app(self.config).test_client()\n+        self.assertEqual(restarted.get(f\"/api/previews/{preview['id']}\", headers=self.headers).json, preview)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.headers).json, {\"username\": \"alice\"})\n+\n+    def test_logout_revokes_token(self):\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).status_code, 401)\n+\n+    def test_expired_token_is_rejected(self):\n+        with sqlite3.connect(self.config[\"DATABASE\"]) as database:\n+            database.execute(\"UPDATE tokens SET expires_at = '2000-01-01T00:00:00+00:00'\")\n+        self.assertEqual(self.client.get(\"/api/previews\", headers=self.headers).status_code, 401)\n+\n+    def test_request_size_is_bounded(self):\n+        response = self.client.post(\"/api/previews\", json={\"url\": \"x\" * 20000}, headers=self.headers)\n+        self.assertEqual(response.status_code, 413)\n+        self.assertIn(\"error\", response.json)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":169,"deletions":0},{"filePath":"/workspace/backend/tests/test_preview.py","relativePath":"backend/tests/test_preview.py","type":"add","patch":"Index: /workspace/backend/tests/test_preview.py\n===================================================================\n--- /workspace/backend/tests/test_preview.py\n+++ /workspace/backend/tests/test_preview.py\n@@ -0,0 +1,163 @@\n+import socket\n+import threading\n+import unittest\n+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n+from unittest.mock import patch\n+\n+from backend.preview import PreviewError, fetch_preview, parse_page, public_addresses, validated_url\n+\n+\n+class MetadataTests(unittest.TestCase):\n+    def parse(self, html, url=\"https://example.com/articles/page\", content_type=\"text/html\"):\n+        return parse_page(html.encode(), content_type, url)\n+\n+    def test_open_graph_takes_precedence_and_is_plain_text(self):\n+        result = self.parse(\"\"\"\n+            <title>Fallback title</title>\n+            <meta name=\"description\" content=\"Fallback description\">\n+            <META content=\"&lt;b&gt;Good &amp; curious&lt;/b&gt;\" PROPERTY=\"og:title\">\n+            <meta property=\"og:description\" content=\"&lt;script&gt;bad()&lt;/script&gt;Plain &lt;i&gt;text&lt;/i&gt;\">\n+            <meta property=\"og:image\" content=\"../cover.png\">\n+        \"\"\")\n+        self.assertEqual(result, {\"title\": \"Good & curious\", \"description\": \"Plain text\", \"image_url\": \"https://example.com/cover.png\"})\n+\n+    def test_title_and_description_fallback(self):\n+        result = self.parse('<title> Hello &amp;  world </title><meta content=\"A short summary\" name=\"description\">')\n+        self.assertEqual(result[\"title\"], \"Hello & world\")\n+        self.assertEqual(result[\"description\"], \"A short summary\")\n+        self.assertIsNone(result[\"image_url\"])\n+\n+    def test_empty_or_unsafe_open_graph_falls_back(self):\n+        result = self.parse('<title>Good title</title><meta property=\"og:title\" content=\"&lt;script&gt;bad()&lt;/script&gt;\"><meta name=\"description\" content=\"Good description\"><meta property=\"og:description\" content=\" \">')\n+        self.assertEqual(result[\"title\"], \"Good title\")\n+        self.assertEqual(result[\"description\"], \"Good description\")\n+\n+    def test_missing_metadata(self):\n+        self.assertEqual(self.parse(\"<html><body>No metadata</body></html>\"), {\"title\": \"\", \"description\": \"\", \"image_url\": None})\n+\n+    def test_unsafe_image_urls_are_discarded(self):\n+        for image in (\"javascript:alert(1)\", \"data:text/html,bad\", \"http://127.0.0.1/image\", \"http://localhost/image\", \"http://[::1]/image\", \"http://user:pass@example.com/image\"):\n+            with self.subTest(image=image):\n+                self.assertIsNone(self.parse(f'<meta property=\"og:image\" content=\"{image}\">')[\"image_url\"])\n+\n+    def test_protocol_relative_image_and_first_tag(self):\n+        result = self.parse('<meta property=\"og:title\" content=\"First\"><meta property=\"og:title\" content=\"Second\"><meta property=\"og:image\" content=\"//images.example.com/photo.jpg\">')\n+        self.assertEqual(result[\"title\"], \"First\")\n+        self.assertEqual(result[\"image_url\"], \"https://images.example.com/photo.jpg\")\n+\n+    def test_charset_is_respected(self):\n+        body = '<title>Café</title>'.encode(\"iso-8859-1\")\n+        self.assertEqual(parse_page(body, \"text/html; charset=iso-8859-1\", \"https://example.com/\")[\"title\"], \"Café\")\n+        self.assertEqual(parse_page(b\"<title>Hello</title>\", \"text/html; charset=unknown-encoding\", \"https://example.com/\")[\"title\"], \"Hello\")\n+\n+    def test_metadata_lengths_are_bounded(self):\n+        result = self.parse(f'<title>{\"t\" * 1000}</title><meta name=\"description\" content=\"{\"d\" * 6000}\">')\n+        self.assertEqual(len(result[\"title\"]), 500)\n+        self.assertEqual(len(result[\"description\"]), 5000)\n+\n+\n+class UrlSafetyTests(unittest.TestCase):\n+    def test_invalid_urls(self):\n+        for value in (None, 1, \"\", \"example.com\", \"file:///tmp/file\", \"ftp://example.com\", \"https://\", \"http://example.com:0\", \"http://example.com:99999\", \"https://a:b@example.com\", \"https://example.com/\\n\", \"http://example.com\\\\@localhost\"):\n+            with self.subTest(value=value), self.assertRaises(PreviewError):\n+                validated_url(value)\n+\n+    def test_unicode_url_is_encoded(self):\n+        self.assertEqual(validated_url(\"https://example.com/café?q=é#fragment\"), \"https://example.com/caf%C3%A9?q=%C3%A9\")\n+        self.assertEqual(validated_url(\"https://bücher.example/\"), \"https://xn--bcher-kva.example/\")\n+\n+    def test_private_reserved_and_mixed_addresses_are_blocked(self):\n+        for address in (\"127.0.0.1\", \"10.0.0.1\", \"192.168.1.1\", \"169.254.169.254\", \"0.0.0.0\", \"224.0.0.1\", \"::1\", \"fc00::1\", \"::ffff:8.8.8.8\"):\n+            with self.subTest(address=address), patch(\"backend.preview.socket.getaddrinfo\", return_value=[(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (address, 80))]), self.assertRaises(PreviewError):\n+                public_addresses(\"example.com\", 80)\n+        with patch(\"backend.preview.socket.getaddrinfo\", return_value=[\n+            (socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"8.8.8.8\", 80)),\n+            (socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"127.0.0.1\", 80)),\n+        ]), self.assertRaises(PreviewError):\n+            public_addresses(\"example.com\", 80)\n+\n+    def test_public_address_allowed_and_dns_error_is_handled(self):\n+        addresses = [(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"8.8.8.8\", 80))]\n+        with patch(\"backend.preview.socket.getaddrinfo\", return_value=addresses):\n+            self.assertEqual(public_addresses(\"example.com\", 80), addresses)\n+        with patch(\"backend.preview.socket.getaddrinfo\", side_effect=socket.gaierror), self.assertRaises(PreviewError) as error:\n+            public_addresses(\"example.com\", 80)\n+        self.assertEqual(error.exception.status, 502)\n+\n+\n+class FixtureHandler(BaseHTTPRequestHandler):\n+    def log_message(self, _format, *_args):\n+        pass\n+\n+    def do_GET(self):\n+        if self.path in (\"/redirect\", \"/loop\", \"/private\"):\n+            self.send_response(302)\n+            self.send_header(\"Location\", {\"/redirect\": \"/page\", \"/loop\": \"/loop\", \"/private\": \"http://127.0.0.1/private\"}[self.path])\n+            self.end_headers()\n+            return\n+        self.send_response(404 if self.path == \"/missing\" else 200)\n+        self.send_header(\"Content-Type\", \"application/json\" if self.path == \"/json\" else \"text/html; charset=utf-8\")\n+        self.end_headers()\n+        self.wfile.write(b'<title>Fixture title</title><meta property=\"og:description\" content=\"Fixture description\"><meta property=\"og:image\" content=\"/cover.png\">')\n+\n+\n+class FetchTests(unittest.TestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.server = ThreadingHTTPServer((\"127.0.0.1\", 0), FixtureHandler)\n+        cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)\n+        cls.thread.start()\n+\n+    @classmethod\n+    def tearDownClass(cls):\n+        cls.server.shutdown()\n+        cls.server.server_close()\n+        cls.thread.join()\n+\n+    def setUp(self):\n+        self.base = f\"http://example.com:{self.server.server_port}\"\n+\n+        def fixture_addresses(host, port):\n+            if host != \"example.com\":\n+                raise PreviewError(\"Only public web links can be previewed.\", 400)\n+            return [(socket.AF_INET, socket.SOCK_STREAM, 6, \"\", (\"127.0.0.1\", port))]\n+\n+        self.patcher = patch(\"backend.preview.public_addresses\", side_effect=fixture_addresses)\n+        self.patcher.start()\n+        self.addCleanup(self.patcher.stop)\n+\n+    def test_fetch_and_relative_redirect(self):\n+        result = fetch_preview(self.base + \"/redirect\")\n+        self.assertEqual(result[\"url\"], self.base + \"/redirect\")\n+        self.assertEqual(result[\"final_url\"], self.base + \"/page\")\n+        self.assertEqual(result[\"status_code\"], 200)\n+        self.assertEqual(result[\"title\"], \"Fixture title\")\n+        self.assertEqual(result[\"description\"], \"Fixture description\")\n+        self.assertEqual(result[\"image_url\"], self.base + \"/cover.png\")\n+        self.assertTrue(result[\"fetched_at\"].endswith(\"+00:00\"))\n+\n+    def test_redirect_to_private_address_is_blocked(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/private\")\n+        self.assertEqual(error.exception.status, 400)\n+\n+    def test_redirect_limit(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/loop\")\n+        self.assertEqual(error.exception.status, 502)\n+\n+    def test_non_html_is_rejected(self):\n+        with self.assertRaises(PreviewError) as error:\n+            fetch_preview(self.base + \"/json\")\n+        self.assertEqual(error.exception.status, 422)\n+\n+    def test_error_page_status_is_retained(self):\n+        self.assertEqual(fetch_preview(self.base + \"/missing\")[\"status_code\"], 404)\n+\n+    def test_response_size_limit(self):\n+        with patch(\"backend.preview.MAX_PAGE_BYTES\", 32), self.assertRaises(PreviewError):\n+            fetch_preview(self.base + \"/page\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":163,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM frontend/src/components/Dialog.tsx\nM backend/app.py\nM backend/preview.py\nA pyproject.toml\nA backend/tests/test_app.py\nA backend/tests/test_preview.py","time":{"start":1794317248042,"end":1794317248070}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.summary","summary":"**Configuring Ruff settings**\n\nI'm","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" trying","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" to","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" figure","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" out","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","fo