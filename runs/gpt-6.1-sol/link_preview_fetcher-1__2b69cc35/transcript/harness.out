{"type":"tool_use","timestamp":1794316357267,"sessionID":"ses_e3a6af12cffemPwVWkj0znar6y","part":{"type":"tool","tool":"apply_patch","callID":"call_ye20yo8WoqxanhwKXoTFVbCM","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Delete File: /workspace/backend/app.py\n*** Add File: /workspace/backend/app.py\n+import hashlib\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+try:\n+    from .preview import PreviewError, fetch_preview\n+except ImportError:\n+    from preview import PreviewError, fetch_preview\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+PREVIEW_FIELDS = (\n+    \"id\", \"url\", \"final_url\", \"status_code\", \"title\", \"description\",\n+    \"image_url\", \"fetched_at\",\n+)\n+\n+\n+def create_app(test_config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"bookmarks.sqlite3\"),\n+        MAX_CONTENT_LENGTH=16 * 1024,\n+    )\n+    if test_config:\n+        app.config.update(test_config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with sqlite3.connect(app.config[\"DATABASE\"]) as database:\n+        database.executescript(\"\"\"\n+            PRAGMA journal_mode = WAL;\n+            PRAGMA foreign_keys = ON;\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS tokens (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS previews (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                url TEXT NOT NULL,\n+                final_url TEXT NOT NULL,\n+                status_code INTEGER NOT NULL,\n+                title TEXT NOT NULL,\n+                description TEXT NOT NULL,\n+                image_url TEXT,\n+                fetched_at TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS previews_owner_order\n+                ON previews(user_id, id DESC);\n+            CREATE INDEX IF NOT EXISTS tokens_expiry ON tokens(expires_at);\n+        \"\"\")\n+\n+    def db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=15)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(_error):\n+        database = g.pop(\"db\", None)\n+        if database is not None:\n+            database.close()\n+\n+    def authenticated(view):\n+        @wraps(view)\n+        def wrapped(*args, **kwargs):\n+            parts = request.headers.get(\"Authorization\", \"\").split()\n+            if len(parts) != 2 or parts[0].lower() != \"bearer\" or len(parts[1]) > 256:\n+                return {\"error\": \"Please sign in to continue.\"}, 401\n+            token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+            user = db().execute(\n+                \"SELECT users.id, users.username FROM tokens JOIN users \"\n+                \"ON users.id = tokens.user_id WHERE token_hash = ? AND expires_at > ?\",\n+                (token_hash, datetime.now(timezone.utc).isoformat()),\n+            ).fetchone()\n+            if user is None:\n+                return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n+            g.user = user\n+            g.token_hash = token_hash\n+            return view(*args, **kwargs)\n+        return wrapped\n+\n+    def json_body():\n+        body = request.get_json(silent=True)\n+        if not isinstance(body, dict):\n+            raise PreviewError(\"Send a JSON object in the request body.\", 400)\n+        return body\n+\n+    def credentials():\n+        body = json_body()\n+        username, password = body.get(\"username\"), body.get(\"password\")\n+        if not isinstance(username, str) or not 1 <= len(username.strip()) <= 64:\n+            raise PreviewError(\"Username must be between 1 and 64 characters.\", 400)\n+        if not isinstance(password, str) or not 1 <= len(password) <= 1024:\n+            raise PreviewError(\"Password must be between 1 and 1024 characters.\", 400)\n+        if any(ord(character) < 32 for character in username):\n+            raise PreviewError(\"Username cannot contain control characters.\", 400)\n+        return username.strip(), password\n+\n+    def owned_preview(preview_id):\n+        row = db().execute(\n+            \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n+            (preview_id, g.user[\"id\"]),\n+        ).fetchone()\n+        if row is None:\n+            raise PreviewError(\"Preview not found.\", 404)\n+        return row\n+\n+    def serialize(row):\n+        return {field: row[field] for field in PREVIEW_FIELDS}\n+\n+    @app.errorhandler(PreviewError)\n+    def preview_error(error):\n+        return {\"error\": str(error)}, error.status\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path.startswith(\"/api/\") or request.path == \"/api\":\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"no-referrer\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; img-src 'self' https: http: data:; \"\n+            \"style-src 'self'; script-src 'self'; connect-src 'self'; \"\n+            \"base-uri 'self'; form-action 'self'; frame-ancestors 'none'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        username, password = credentials()\n+        password_hash = generate_password_hash(password)\n+        try:\n+            with db():\n+                db().execute(\n+                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                    (username, password_hash),\n+                )\n+        except sqlite3.IntegrityError:\n+            return {\"error\": \"That username is already taken.\"}, 409\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        username, password = credentials()\n+        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            return {\"error\": \"Incorrect username or password.\"}, 401\n+        token = secrets.token_urlsafe(48)\n+        now = datetime.now(timezone.utc)\n+        with db():\n+            db().execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n+            db().execute(\n+                \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"],\n+                 (now + timedelta(days=30)).isoformat()),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        with db():\n+            db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.post(\"/api/previews\")\n+    @authenticated\n+    def add_preview():\n+        url = json_body().get(\"url\")\n+        preview = fetch_preview(url)\n+        with db():\n+            cursor = db().execute(\n+                \"INSERT INTO previews (user_id, url, final_url, status_code, title, \"\n+                \"description, image_url, fetched_at, created_at) \"\n+                \"VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\",\n+                (g.user[\"id\"], preview[\"url\"], preview[\"final_url\"], preview[\"status_code\"],\n+                 preview[\"title\"], preview[\"description\"], preview[\"image_url\"],\n+                 preview[\"fetched_at\"], preview[\"fetched_at\"]),\n+            )\n+        return serialize(owned_preview(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/previews\")\n+    @authenticated\n+    def list_previews():\n+        try:\n+            page = int(request.args.get(\"page\", \"1\"))\n+            page_size = int(request.args.get(\"page_size\", \"12\"))\n+        except (ValueError, TypeError):\n+            raise PreviewError(\"Page and page_size must be positive integers.\", 400) from None\n+        if not 1 <= page <= 1_000_000 or not 1 <= page_size <= 100:\n+            raise PreviewError(\"Page must be positive and page_size between 1 and 100.\", 400)\n+        total = db().execute(\n+            \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user[\"id\"],),\n+        ).fetchone()[0]\n+        rows = db().execute(\n+            \"SELECT * FROM previews WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n+            (g.user[\"id\"], page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        return {\"items\": [serialize(row) for row in rows], \"total\": total,\n+                \"page\": page, \"page_size\": page_size}\n+\n+    @app.get(\"/api/previews/<int:preview_id>\")\n+    @authenticated\n+    def get_preview(preview_id):\n+        return serialize(owned_preview(preview_id))\n+\n+    @app.post(\"/api/previews/<int:preview_id>/refresh\")\n+    @authenticated\n+    def refresh_preview(preview_id):\n+        row = owned_preview(preview_id)\n+        preview = fetch_preview(row[\"url\"])\n+        with db():\n+            db().execute(\n+                \"UPDATE previews SET final_url = ?, status_code = ?, title = ?, \"\n+                \"description = ?, image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n+                (preview[\"final_url\"], preview[\"status_code\"], preview[\"title\"],\n+                 preview[\"description\"], preview[\"image_url\"], preview[\"fetched_at\"],\n+                 preview_id, g.user[\"id\"]),\n+            )\n+        return serialize(owned_preview(preview_id))\n+\n+    @app.delete(\"/api/previews/<int:preview_id>\")\n+    @authenticated\n+    def delete_preview(preview_id):\n+        owned_preview(preview_id)\n+        with db():\n+            db().execute(\"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n+                         (preview_id, g.user[\"id\"]))\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return {\"error\": \"Endpoint not found.\"}, 404\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n*** Add File: /workspace/backend/preview.py\n+import http.client\n+import ipaddress\n+import re\n+import socket\n+import ssl\n+import time\n+from datetime import datetime, timezone\n+from html.parser import HTMLParser\n+from urllib.parse import quote, urljoin, urlsplit, urlunsplit\n+\n+MAX_PAGE_BYTES = 2 * 1024 * 1024\n+FETCH_TIMEOUT = 20\n+MAX_REDIRECTS = 5\n+\n+\n+class PreviewError(Exception):\n+    def __init__(self, message, status=422):\n+        super().__init__(message)\n+        self.status = status\n+\n+\n+class PlainTextParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.parts = []\n+        self.hidden = 0\n+\n+    def handle_starttag(self, tag, _attrs):\n+        if tag in (\"script\", \"style\"):\n+            self.hidden += 1\n+\n+    def handle_endtag(self, tag):\n+        if tag in (\"script\", \"style\"):\n+            self.hidden = max(0, self.hidden - 1)\n+\n+    def handle_data(self, data):\n+        if not self.hidden:\n+            self.parts.append(data)\n+\n+\n+def plain_text(value, limit):\n+    parser = PlainTextParser()\n+    parser.feed(value)\n+    parser.close()\n+    return \" \".join(\" \".join(parser.parts).split())[:limit]\n+\n+\n+class MetadataParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.metadata = {}\n+        self.title_parts = []\n+        self.in_title = False\n+        self.title_finished = False\n+\n+    def handle_starttag(self, tag, attrs):\n+        attributes = {key.lower(): value for key, value in attrs if value is not None}\n+        if tag == \"title\" and not self.title_finished:\n+            self.in_title = True\n+        if tag == \"meta\":\n+            key = (attributes.get(\"property\") or attributes.get(\"name\") or \"\").lower()\n+            value = attributes.get(\"content\", \"\").strip()\n+            if key in (\"og:title\", \"og:description\", \"og:image\", \"description\") and value:\n+                self.metadata.setdefault(key, value)\n+\n+    def handle_endtag(self, tag):\n+        if tag == \"title\":\n+            self.in_title = False\n+            self.title_finished = True\n+\n+    def handle_data(self, data):\n+        if self.in_title:\n+            self.title_parts.append(data)\n+\n+\n+def validated_url(value):\n+    if not isinstance(value, str) or not value.strip() or len(value) > 4096:\n+        raise PreviewError(\"Enter a valid HTTP or HTTPS URL.\", 400)\n+    value = value.strip()\n+    if any(ord(character) < 33 or ord(character) == 127 for character in value) or \"\\\\\" in value:\n+        raise PreviewError(\"The URL contains invalid characters.\", 400)\n+    try:\n+        parsed = urlsplit(value)\n+        if parsed.scheme.lower() not in (\"http\", \"https\") or not parsed.hostname:\n+            raise ValueError\n+        if parsed.username is not None or parsed.password is not None:\n+            raise ValueError\n+        port = parsed.port\n+        hostname = parsed.hostname.encode(\"idna\").decode(\"ascii\")\n+        if \"%\" in hostname or not hostname:\n+            raise ValueError\n+        host = f\"[{hostname}]\" if \":\" in hostname else hostname\n+        netloc = host + (f\":{port}\" if port is not None else \"\")\n+        return urlunsplit((parsed.scheme.lower(), netloc,\n+                           quote(parsed.path or \"/\", safe=\"/%:@!$&'()*+,;=-._~\"),\n+                           quote(parsed.query, safe=\"/%?:@!$&'()*+,;=-._~\"), \"\"))\n+    except (ValueError, UnicodeError):\n+        raise PreviewError(\"Enter a valid HTTP or HTTPS URL without credentials.\", 400) from None\n+\n+\n+def public_addresses(hostname, port):\n+    try:\n+        addresses = socket.getaddrinfo(hostname, port, type=socket.SOCK_STREAM)\n+    except OSError:\n+        raise PreviewError(\"Could not resolve this site's address.\", 502) from None\n+    if not addresses:\n+        raise PreviewError(\"Could not resolve this site's address.\", 502)\n+    for _, _, _, _, address in addresses:\n+        ip = ipaddress.ip_address(address[0])\n+        if not ip.is_global or ip.is_multicast or (ip.version == 6 and ip.ipv4_mapped):\n+            raise PreviewError(\"Only public web links can be previewed.\", 400)\n+    return addresses\n+\n+\n+def open_page(url, deadline):\n+    parsed = urlsplit(url)\n+    port = parsed.port or (443 if parsed.scheme == \"https\" else 80)\n+    addresses = public_addresses(parsed.hostname, port)\n+    connection = http.client.HTTPConnection(parsed.hostname, port, timeout=8)\n+    last_error = None\n+    for family, socktype, protocol, _, address in addresses:\n+        sock = socket.socket(family, socktype, protocol)\n+        try:\n+            remaining = deadline - time.monotonic()\n+            if remaining <= 0:\n+                raise TimeoutError\n+            sock.settimeout(min(8, remaining))\n+            sock.connect(address)\n+            if parsed.scheme == \"https\":\n+                sock = ssl.create_default_context().wrap_socket(sock, server_hostname=parsed.hostname)\n+            connection.sock = sock\n+            target = parsed.path + (\"?\" + parsed.query if parsed.query else \"\")\n+            connection.request(\"GET\", target, headers={\n+                \"User-Agent\": \"Marginal-LinkPreview/1.0\",\n+                \"Accept\": \"text/html,application/xhtml+xml\",\n+                \"Accept-Encoding\": \"identity\",\n+                \"Connection\": \"close\",\n+            })\n+            return connection, connection.getresponse()\n+        except (OSError, http.client.HTTPException) as error:\n+            last_error = error\n+            sock.close()\n+            connection.close()\n+    raise PreviewError(\"The site could not be reached. Please try again.\", 502) from last_error\n+\n+\n+def parse_page(body, content_type, final_url):\n+    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.I)\n+    if charset_match is None:\n+        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.I)\n+    charset = charset_match.group(1) if charset_match else \"utf-8\"\n+    try:\n+        html = body.decode(charset, errors=\"replace\")\n+    except LookupError:\n+        html = body.decode(\"utf-8\", errors=\"replace\")\n+    parser = MetadataParser()\n+    parser.feed(html)\n+    parser.close()\n+    metadata = parser.metadata\n+    title = plain_text(metadata.get(\"og:title\", \"\"), 500)\n+    title = title or plain_text(\"\".join(parser.title_parts), 500)\n+    description = plain_text(metadata.get(\"og:description\", \"\"), 5000)\n+    description = description or plain_text(metadata.get(\"description\", \"\"), 5000)\n+    image_url = None\n+    if metadata.get(\"og:image\"):\n+        try:\n+            candidate = validated_url(urljoin(final_url, metadata[\"og:image\"]))\n+            hostname = urlsplit(candidate).hostname\n+            if hostname.lower().rstrip(\".\") == \"localhost\" or hostname.lower().endswith(\".localhost\"):\n+                raise PreviewError(\"Unsafe image URL.\")\n+            try:\n+                ip = ipaddress.ip_address(hostname)\n+            except ValueError:\n+                ip = None\n+            if ip is not None and (not ip.is_global or ip.is_multicast):\n+                raise PreviewError(\"Unsafe image URL.\")\n+            image_url = candidate\n+        except PreviewError:\n+            pass\n+    return {\"title\": title, \"description\": description, \"image_url\": image_url}\n+\n+\n+def fetch_preview(value):\n+    url = validated_url(value)\n+    final_url = url\n+    deadline = time.monotonic() + FETCH_TIMEOUT\n+    for redirect in range(MAX_REDIRECTS + 1):\n+        connection, response = open_page(final_url, deadline)\n+        try:\n+            if response.status in (301, 302, 303, 307, 308):\n+                location = response.getheader(\"Location\")\n+                if not location:\n+                    raise PreviewError(\"The site returned a redirect without a destination.\", 502)\n+                if redirect == MAX_REDIRECTS:\n+                    raise PreviewError(\"The site redirected too many times.\", 502)\n+                final_url = validated_url(urljoin(final_url, location))\n+                continue\n+            content_type = response.getheader(\"Content-Type\", \"\")\n+            if content_type and content_type.split(\";\", 1)[0].strip().lower() not in (\n+                \"text/html\", \"application/xhtml+xml\",\n+            ):\n+                raise PreviewError(\"This link is not an HTML web page.\")\n+            encoding = response.getheader(\"Content-Encoding\", \"identity\").lower()\n+            if encoding not in (\"identity\", \"\"):\n+                raise PreviewError(\"The site returned an unsupported page encoding.\", 502)\n+            chunks = []\n+            size = 0\n+            while True:\n+                remaining = deadline - time.monotonic()\n+                if remaining <= 0:\n+                    raise TimeoutError\n+                if connection.sock is not None:\n+                    connection.sock.settimeout(min(8, remaining))\n+                chunk = response.read1(min(65536, MAX_PAGE_BYTES + 1 - size))\n+                if not chunk:\n+                    break\n+                size += len(chunk)\n+                if size > MAX_PAGE_BYTES:\n+                    raise PreviewError(\"This page is too large to preview.\")\n+                chunks.append(chunk)\n+            metadata = parse_page(b\"\".join(chunks), content_type, final_url)\n+            return {\"url\": url, \"final_url\": final_url, \"status_code\": response.status,\n+                    **metadata, \"fetched_at\": datetime.now(timezone.utc).isoformat()}\n+        except (OSError, http.client.HTTPException):\n+            raise PreviewError(\"The site took too long or returned an incomplete page.\", 502) from None\n+        finally:\n+            response.close()\n+            connection.close()\n+    raise PreviewError(\"The site redirected too many times.\", 502)\n*** Add File: /workspace/.gitignore\n+frontend/node_modules/\n+frontend/dist/\n+.venv/\n+__pycache__/\n+*.pyc\n+.ruff_cache/\n+data/\n+playwright-report/\n+test-results/\n*** End Patch"},"output":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/preview.py\nA .gitignore","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n\nIndex: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,274 @@\n+import hashlib\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+try:\n+    from .preview import PreviewError, fetch_preview\n+except ImportError:\n+    from preview import PreviewError, fetch_preview\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+PREVIEW_FIELDS = (\n+    \"id\", \"url\", \"final_url\", \"status_code\", \"title\", \"description\",\n+    \"image_url\", \"fetched_at\",\n+)\n+\n+\n+def create_app(test_config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"bookmarks.sqlite3\"),\n+        MAX_CONTENT_LENGTH=16 * 1024,\n+    )\n+    if test_config:\n+        app.config.update(test_config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with sqlite3.connect(app.config[\"DATABASE\"]) as database:\n+        database.executescript(\"\"\"\n+            PRAGMA journal_mode = WAL;\n+            PRAGMA foreign_keys = ON;\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS tokens (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS previews (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                url TEXT NOT NULL,\n+                final_url TEXT NOT NULL,\n+                status_code INTEGER NOT NULL,\n+                title TEXT NOT NULL,\n+                description TEXT NOT NULL,\n+                image_url TEXT,\n+                fetched_at TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS previews_owner_order\n+                ON previews(user_id, id DESC);\n+            CREATE INDEX IF NOT EXISTS tokens_expiry ON tokens(expires_at);\n+        \"\"\")\n+\n+    def db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=15)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(_error):\n+        database = g.pop(\"db\", None)\n+        if database is not None:\n+            database.close()\n+\n+    def authenticated(view):\n+        @wraps(view)\n+        def wrapped(*args, **kwargs):\n+            parts = request.headers.get(\"Authorization\", \"\").split()\n+            if len(parts) != 2 or parts[0].lower() != \"bearer\" or len(parts[1]) > 256:\n+                return {\"error\": \"Please sign in to continue.\"}, 401\n+            token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+            user = db().execute(\n+                \"SELECT users.id, users.username FROM tokens JOIN users \"\n+                \"ON users.id = tokens.user_id WHERE token_hash = ? AND expires_at > ?\",\n+                (token_hash, datetime.now(timezone.utc).isoformat()),\n+            ).fetchone()\n+            if user is None:\n+                return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n+            g.user = user\n+            g.token_hash = token_hash\n+            return view(*args, **kwargs)\n+        return wrapped\n+\n+    def json_body():\n+        body = request.get_json(silent=True)\n+        if not isinstance(body, dict):\n+            raise PreviewError(\"Send a JSON object in the request body.\", 400)\n+        return body\n+\n+    def credentials():\n+        body = json_body()\n+        username, password = body.get(\"username\"), body.get(\"password\")\n+        if not isinstance(username, str) or not 1 <= len(username.strip()) <= 64:\n+            raise PreviewError(\"Username must be between 1 and 64 characters.\", 400)\n+        if not isinstance(password, str) or not 1 <= len(password) <= 1024:\n+            raise PreviewError(\"Password must be between 1 and 1024 characters.\", 400)\n+        if any(ord(character) < 32 for character in username):\n+            raise PreviewError(\"Username cannot contain control characters.\", 400)\n+        return username.strip(), password\n+\n+    def owned_preview(preview_id):\n+        row = db().execute(\n+            \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n+            (preview_id, g.user[\"id\"]),\n+        ).fetchone()\n+        if row is None:\n+            raise PreviewError(\"Preview not found.\", 404)\n+        return row\n+\n+    def serialize(row):\n+        return {field: row[field] for field in PREVIEW_FIELDS}\n+\n+    @app.errorhandler(PreviewError)\n+    def preview_error(error):\n+        return {\"error\": str(error)}, error.status\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path.startswith(\"/api/\") or request.path == \"/api\":\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"no-referrer\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; img-src 'self' https: http: data:; \"\n+            \"style-src 'self'; script-src 'self'; connect-src 'self'; \"\n+            \"base-uri 'self'; form-action 'self'; frame-ancestors 'none'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        username, password = credentials()\n+        password_hash = generate_password_hash(password)\n+        try:\n+            with db():\n+                db().execute(\n+                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                    (username, password_hash),\n+                )\n+        except sqlite3.IntegrityError:\n+            return {\"error\": \"That username is already taken.\"}, 409\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        username, password = credentials()\n+        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            return {\"error\": \"Incorrect username or password.\"}, 401\n+        token = secrets.token_urlsafe(48)\n+        now = datetime.now(timezone.utc)\n+        with db():\n+            db().execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n+            db().execute(\n+                \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"],\n+                 (now + timedelta(days=30)).isoformat()),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        with db():\n+            db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.post(\"/api/previews\")\n+    @authenticated\n+    def add_preview():\n+        url = json_body().get(\"url\")\n+        preview = fetch_preview(url)\n+        with db():\n+            cursor = db().execute(\n+                \"INSERT INTO previews (user_id, url, final_url, status_code, title, \"\n+                \"description, image_url, fetched_at, created_at) \"\n+                \"VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\",\n+                (g.user[\"id\"], preview[\"url\"], preview[\"final_url\"], preview[\"status_code\"],\n+                 preview[\"title\"], preview[\"description\"], preview[\"image_url\"],\n+                 preview[\"fetched_at\"], preview[\"fetched_at\"]),\n+            )\n+        return serialize(owned_preview(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/previews\")\n+    @authenticated\n+    def list_previews():\n+        try:\n+            page = int(request.args.get(\"page\", \"1\"))\n+            page_size = int(request.args.get(\"page_size\", \"12\"))\n+        except (ValueError, TypeError):\n+            raise PreviewError(\"Page and page_size must be positive integers.\", 400) from None\n+        if not 1 <= page <= 1_000_000 or not 1 <= page_size <= 100:\n+            raise PreviewError(\"Page must be positive and page_size between 1 and 100.\", 400)\n+        total = db().execute(\n+            \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user[\"id\"],),\n+        ).fetchone()[0]\n+        rows = db().execute(\n+            \"SELECT * FROM previews WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n+            (g.user[\"id\"], page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        return {\"items\": [serialize(row) for row in rows], \"total\": total,\n+                \"page\": page, \"page_size\": page_size}\n+\n+    @app.get(\"/api/previews/<int:preview_id>\")\n+    @authenticated\n+    def get_preview(preview_id):\n+        return serialize(owned_preview(preview_id))\n+\n+    @app.post(\"/api/previews/<int:preview_id>/refresh\")\n+    @authenticated\n+    def refresh_preview(preview_id):\n+        row = owned_preview(preview_id)\n+        preview = fetch_preview(row[\"url\"])\n+        with db():\n+            db().execute(\n+                \"UPDATE previews SET final_url = ?, status_code = ?, title = ?, \"\n+                \"description = ?, image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n+                (preview[\"final_url\"], preview[\"status_code\"], preview[\"title\"],\n+                 preview[\"description\"], preview[\"image_url\"], preview[\"fetched_at\"],\n+                 preview_id, g.user[\"id\"]),\n+            )\n+        return serialize(owned_preview(preview_id))\n+\n+    @app.delete(\"/api/previews/<int:preview_id>\")\n+    @authenticated\n+    def delete_preview(preview_id):\n+        owned_preview(preview_id)\n+        with db():\n+            db().execute(\"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n+                         (preview_id, g.user[\"id\"]))\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return {\"error\": \"Endpoint not found.\"}, 404\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n\nIndex: /workspace/backend/preview.py\n===================================================================\n--- /workspace/backend/preview.py\n+++ /workspace/backend/preview.py\n@@ -0,0 +1,229 @@\n+import http.client\n+import ipaddress\n+import re\n+import socket\n+import ssl\n+import time\n+from datetime import datetime, timezone\n+from html.parser import HTMLParser\n+from urllib.parse import quote, urljoin, urlsplit, urlunsplit\n+\n+MAX_PAGE_BYTES = 2 * 1024 * 1024\n+FETCH_TIMEOUT = 20\n+MAX_REDIRECTS = 5\n+\n+\n+class PreviewError(Exception):\n+    def __init__(self, message, status=422):\n+        super().__init__(message)\n+        self.status = status\n+\n+\n+class PlainTextParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.parts = []\n+        self.hidden = 0\n+\n+    def handle_starttag(self, tag, _attrs):\n+        if tag in (\"script\", \"style\"):\n+            self.hidden += 1\n+\n+    def handle_endtag(self, tag):\n+        if tag in (\"script\", \"style\"):\n+            self.hidden = max(0, self.hidden - 1)\n+\n+    def handle_data(self, data):\n+        if not self.hidden:\n+            self.parts.append(data)\n+\n+\n+def plain_text(value, limit):\n+    parser = PlainTextParser()\n+    parser.feed(value)\n+    parser.close()\n+    return \" \".join(\" \".join(parser.parts).split())[:limit]\n+\n+\n+class MetadataParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.metadata = {}\n+        self.title_parts = []\n+        self.in_title = False\n+        self.title_finished = False\n+\n+    def handle_starttag(self, tag, attrs):\n+        attributes = {key.lower(): value for key, value in attrs if value is not None}\n+        if tag == \"title\" and not self.title_finished:\n+            self.in_title = True\n+        if tag == \"meta\":\n+            key = (attributes.get(\"property\") or attributes.get(\"name\") or \"\").lower()\n+            value = attributes.get(\"content\", \"\").strip()\n+            if key in (\"og:title\", \"og:description\", \"og:image\", \"description\") and value:\n+                self.metadata.setdefault(key, value)\n+\n+    def handle_endtag(self, tag):\n+        if tag == \"title\":\n+            self.in_title = False\n+            self.title_finished = True\n+\n+    def handle_data(self, data):\n+        if self.in_title:\n+            self.title_parts.append(data)\n+\n+\n+def validated_url(value):\n+    if not isinstance(value, str) or not value.strip() or len(value) > 4096:\n+        raise PreviewError(\"Enter a valid HTTP or HTTPS URL.\", 400)\n+    value = value.strip()\n+    if any(ord(character) < 33 or ord(character) == 127 for character in value) or \"\\\\\" in value:\n+        raise PreviewError(\"The URL contains invalid characters.\", 400)\n+    try:\n+        parsed = urlsplit(value)\n+        if parsed.scheme.lower() not in (\"http\", \"https\") or not parsed.hostname:\n+            raise ValueError\n+        if parsed.username is not None or parsed.password is not None:\n+            raise ValueError\n+        port = parsed.port\n+        hostname = parsed.hostname.encode(\"idna\").decode(\"ascii\")\n+        if \"%\" in hostname or not hostname:\n+            raise ValueError\n+        host = f\"[{hostname}]\" if \":\" in hostname else hostname\n+        netloc = host + (f\":{port}\" if port is not None else \"\")\n+        return urlunsplit((parsed.scheme.lower(), netloc,\n+                           quote(parsed.path or \"/\", safe=\"/%:@!$&'()*+,;=-._~\"),\n+                           quote(parsed.query, safe=\"/%?:@!$&'()*+,;=-._~\"), \"\"))\n+    except (ValueError, UnicodeError):\n+        raise PreviewError(\"Enter a valid HTTP or HTTPS URL without credentials.\", 400) from None\n+\n+\n+def public_addresses(hostname, port):\n+    try:\n+        addresses = socket.getaddrinfo(hostname, port, type=socket.SOCK_STREAM)\n+    except OSError:\n+        raise PreviewError(\"Could not resolve this site's address.\", 502) from None\n+    if not addresses:\n+        raise PreviewError(\"Could not resolve this site's address.\", 502)\n+    for _, _, _, _, address in addresses:\n+        ip = ipaddress.ip_address(address[0])\n+        if not ip.is_global or ip.is_multicast or (ip.version == 6 and ip.ipv4_mapped):\n+            raise PreviewError(\"Only public web links can be previewed.\", 400)\n+    return addresses\n+\n+\n+def open_page(url, deadline):\n+    parsed = urlsplit(url)\n+    port = parsed.port or (443 if parsed.scheme == \"https\" else 80)\n+    addresses = public_addresses(parsed.hostname, port)\n+    connection = http.client.HTTPConnection(parsed.hostname, port, timeout=8)\n+    last_error = None\n+    for family, socktype, protocol, _, address in addresses:\n+        sock = socket.socket(family, socktype, protocol)\n+        try:\n+            remaining = deadline - time.monotonic()\n+            if remaining <= 0:\n+                raise TimeoutError\n+            sock.settimeout(min(8, remaining))\n+            sock.connect(address)\n+            if parsed.scheme == \"https\":\n+                sock = ssl.create_default_context().wrap_socket(sock, server_hostname=parsed.hostname)\n+            connection.sock = sock\n+            target = parsed.path + (\"?\" + parsed.query if parsed.query else \"\")\n+            connection.request(\"GET\", target, headers={\n+                \"User-Agent\": \"Marginal-LinkPreview/1.0\",\n+                \"Accept\": \"text/html,application/xhtml+xml\",\n+                \"Accept-Encoding\": \"identity\",\n+                \"Connection\": \"close\",\n+            })\n+            return connection, connection.getresponse()\n+        except (OSError, http.client.HTTPException) as error:\n+            last_error = error\n+            sock.close()\n+            connection.close()\n+    raise PreviewError(\"The site could not be reached. Please try again.\", 502) from last_error\n+\n+\n+def parse_page(body, content_type, final_url):\n+    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.I)\n+    if charset_match is None:\n+        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.I)\n+    charset = charset_match.group(1) if charset_match else \"utf-8\"\n+    try:\n+        html = body.decode(charset, errors=\"replace\")\n+    except LookupError:\n+        html = body.decode(\"utf-8\", errors=\"replace\")\n+    parser = MetadataParser()\n+    parser.feed(html)\n+    parser.close()\n+    metadata = parser.metadata\n+    title = plain_text(metadata.get(\"og:title\", \"\"), 500)\n+    title = title or plain_text(\"\".join(parser.title_parts), 500)\n+    description = plain_text(metadata.get(\"og:description\", \"\"), 5000)\n+    description = description or plain_text(metadata.get(\"description\", \"\"), 5000)\n+    image_url = None\n+    if metadata.get(\"og:image\"):\n+        try:\n+            candidate = validated_url(urljoin(final_url, metadata[\"og:image\"]))\n+            hostname = urlsplit(candidate).hostname\n+            if hostname.lower().rstrip(\".\") == \"localhost\" or hostname.lower().endswith(\".localhost\"):\n+                raise PreviewError(\"Unsafe image URL.\")\n+            try:\n+                ip = ipaddress.ip_address(hostname)\n+            except ValueError:\n+                ip = None\n+            if ip is not None and (not ip.is_global or ip.is_multicast):\n+                raise PreviewError(\"Unsafe image URL.\")\n+            image_url = candidate\n+        except PreviewError:\n+            pass\n+    return {\"title\": title, \"description\": description, \"image_url\": image_url}\n+\n+\n+def fetch_preview(value):\n+    url = validated_url(value)\n+    final_url = url\n+    deadline = time.monotonic() + FETCH_TIMEOUT\n+    for redirect in range(MAX_REDIRECTS + 1):\n+        connection, response = open_page(final_url, deadline)\n+        try:\n+            if response.status in (301, 302, 303, 307, 308):\n+                location = response.getheader(\"Location\")\n+                if not location:\n+                    raise PreviewError(\"The site returned a redirect without a destination.\", 502)\n+                if redirect == MAX_REDIRECTS:\n+                    raise PreviewError(\"The site redirected too many times.\", 502)\n+                final_url = validated_url(urljoin(final_url, location))\n+                continue\n+            content_type = response.getheader(\"Content-Type\", \"\")\n+            if content_type and content_type.split(\";\", 1)[0].strip().lower() not in (\n+                \"text/html\", \"application/xhtml+xml\",\n+            ):\n+                raise PreviewError(\"This link is not an HTML web page.\")\n+            encoding = response.getheader(\"Content-Encoding\", \"identity\").lower()\n+            if encoding not in (\"identity\", \"\"):\n+                raise PreviewError(\"The site returned an unsupported page encoding.\", 502)\n+            chunks = []\n+            size = 0\n+            while True:\n+                remaining = deadline - time.monotonic()\n+                if remaining <= 0:\n+                    raise TimeoutError\n+                if connection.sock is not None:\n+                    connection.sock.settimeout(min(8, remaining))\n+                chunk = response.read1(min(65536, MAX_PAGE_BYTES + 1 - size))\n+                if not chunk:\n+                    break\n+                size += len(chunk)\n+                if size > MAX_PAGE_BYTES:\n+                    raise PreviewError(\"This page is too large to preview.\")\n+                chunks.append(chunk)\n+            metadata = parse_page(b\"\".join(chunks), content_type, final_url)\n+            return {\"url\": url, \"final_url\": final_url, \"status_code\": response.status,\n+                    **metadata, \"fetched_at\": datetime.now(timezone.utc).isoformat()}\n+        except (OSError, http.client.HTTPException):\n+            raise PreviewError(\"The site took too long or returned an incomplete page.\", 502) from None\n+        finally:\n+            response.close()\n+            connection.close()\n+    raise PreviewError(\"The site redirected too many times.\", 502)\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,9 @@\n+frontend/node_modules/\n+frontend/dist/\n+.venv/\n+__pycache__/\n+*.pyc\n+.ruff_cache/\n+data/\n+playwright-report/\n+test-results/\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,274 @@\n+import hashlib\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+try:\n+    from .preview import PreviewError, fetch_preview\n+except ImportError:\n+    from preview import PreviewError, fetch_preview\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+PREVIEW_FIELDS = (\n+    \"id\", \"url\", \"final_url\", \"status_code\", \"title\", \"description\",\n+    \"image_url\", \"fetched_at\",\n+)\n+\n+\n+def create_app(test_config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"bookmarks.sqlite3\"),\n+        MAX_CONTENT_LENGTH=16 * 1024,\n+    )\n+    if test_config:\n+        app.config.update(test_config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with sqlite3.connect(app.config[\"DATABASE\"]) as database:\n+        database.executescript(\"\"\"\n+            PRAGMA journal_mode = WAL;\n+            PRAGMA foreign_keys = ON;\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS tokens (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS previews (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                url TEXT NOT NULL,\n+                final_url TEXT NOT NULL,\n+                status_code INTEGER NOT NULL,\n+                title TEXT NOT NULL,\n+                description TEXT NOT NULL,\n+                image_url TEXT,\n+                fetched_at TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS previews_owner_order\n+                ON previews(user_id, id DESC);\n+            CREATE INDEX IF NOT EXISTS tokens_expiry ON tokens(expires_at);\n+        \"\"\")\n+\n+    def db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=15)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(_error):\n+        database = g.pop(\"db\", None)\n+        if database is not None:\n+            database.close()\n+\n+    def authenticated(view):\n+        @wraps(view)\n+        def wrapped(*args, **kwargs):\n+            parts = request.headers.get(\"Authorization\", \"\").split()\n+            if len(parts) != 2 or parts[0].lower() != \"bearer\" or len(parts[1]) > 256:\n+                return {\"error\": \"Please sign in to continue.\"}, 401\n+            token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+            user = db().execute(\n+                \"SELECT users.id, users.username FROM tokens JOIN users \"\n+                \"ON users.id = tokens.user_id WHERE token_hash = ? AND expires_at > ?\",\n+                (token_hash, datetime.now(timezone.utc).isoformat()),\n+            ).fetchone()\n+            if user is None:\n+                return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n+            g.user = user\n+            g.token_hash = token_hash\n+            return view(*args, **kwargs)\n+        return wrapped\n+\n+    def json_body():\n+        body = request.get_json(silent=True)\n+        if not isinstance(body, dict):\n+            raise PreviewError(\"Send a JSON object in the request body.\", 400)\n+        return body\n+\n+    def credentials():\n+        body = json_body()\n+        username, password = body.get(\"username\"), body.get(\"password\")\n+        if not isinstance(username, str) or not 1 <= len(username.strip()) <= 64:\n+            raise PreviewError(\"Username must be between 1 and 64 characters.\", 400)\n+        if not isinstance(password, str) or not 1 <= len(password) <= 1024:\n+            raise PreviewError(\"Password must be between 1 and 1024 characters.\", 400)\n+        if any(ord(character) < 32 for character in username):\n+            raise PreviewError(\"Username cannot contain control characters.\", 400)\n+        return username.strip(), password\n+\n+    def owned_preview(preview_id):\n+        row = db().execute(\n+            \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n+            (preview_id, g.user[\"id\"]),\n+        ).fetchone()\n+        if row is None:\n+            raise PreviewError(\"Preview not found.\", 404)\n+        return row\n+\n+    def serialize(row):\n+        return {field: row[field] for field in PREVIEW_FIELDS}\n+\n+    @app.errorhandler(PreviewError)\n+    def preview_error(error):\n+        return {\"error\": str(error)}, error.status\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path.startswith(\"/api/\") or request.path == \"/api\":\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"no-referrer\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; img-src 'self' https: http: data:; \"\n+            \"style-src 'self'; script-src 'self'; connect-src 'self'; \"\n+            \"base-uri 'self'; form-action 'self'; frame-ancestors 'none'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        username, password = credentials()\n+        password_hash = generate_password_hash(password)\n+        try:\n+            with db():\n+                db().execute(\n+                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                    (username, password_hash),\n+                )\n+        except sqlite3.IntegrityError:\n+            return {\"error\": \"That username is already taken.\"}, 409\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        username, password = credentials()\n+        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            return {\"error\": \"Incorrect username or password.\"}, 401\n+        token = secrets.token_urlsafe(48)\n+        now = datetime.now(timezone.utc)\n+        with db():\n+            db().execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n+            db().execute(\n+                \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"],\n+                 (now + timedelta(days=30)).isoformat()),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        with db():\n+            db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.post(\"/api/previews\")\n+    @authenticated\n+    def add_preview():\n+        url = json_body().get(\"url\")\n+        preview = fetch_preview(url)\n+        with db():\n+            cursor = db().execute(\n+                \"INSERT INTO previews (user_id, url, final_url, status_code, title, \"\n+                \"description, image_url, fetched_at, created_at) \"\n+                \"VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\",\n+                (g.user[\"id\"], preview[\"url\"], preview[\"final_url\"], preview[\"status_code\"],\n+                 preview[\"title\"], preview[\"description\"], preview[\"image_url\"],\n+                 preview[\"fetched_at\"], preview[\"fetched_at\"]),\n+            )\n+        return serialize(owned_preview(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/previews\")\n+    @authenticated\n+    def list_previews():\n+        try:\n+            page = int(request.args.get(\"page\", \"1\"))\n+            page_size = int(request.args.get(\"page_size\", \"12\"))\n+        except (ValueError, TypeError):\n+            raise PreviewError(\"Page and page_size must be positive integers.\", 400) from None\n+        if not 1 <= page <= 1_000_000 or not 1 <= page_size <= 100:\n+            raise PreviewError(\"Page must be positive and page_size between 1 and 100.\", 400)\n+        total = db().execute(\n+            \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user[\"id\"],),\n+        ).fetchone()[0]\n+        rows = db().execute(\n+            \"SELECT * FROM previews WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n+            (g.user[\"id\"], page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        return {\"items\": [serialize(row) for row in rows], \"total\": total,\n+                \"page\": page, \"page_size\": page_size}\n+\n+    @app.get(\"/api/previews/<int:preview_id>\")\n+    @authenticated\n+    def get_preview(preview_id):\n+        return serialize(owned_preview(preview_id))\n+\n+    @app.post(\"/api/previews/<int:preview_id>/refresh\")\n+    @authenticated\n+    def refresh_preview(preview_id):\n+        row = owned_preview(preview_id)\n+        preview = fetch_preview(row[\"url\"])\n+        with db():\n+            db().execute(\n+                \"UPDATE previews SET final_url = ?, status_code = ?, title = ?, \"\n+                \"description = ?, image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n+                (preview[\"final_url\"], preview[\"status_code\"], preview[\"title\"],\n+                 preview[\"description\"], preview[\"image_url\"], preview[\"fetched_at\"],\n+                 preview_id, g.user[\"id\"]),\n+            )\n+        return serialize(owned_preview(preview_id))\n+\n+    @app.delete(\"/api/previews/<int:preview_id>\")\n+    @authenticated\n+    def delete_preview(preview_id):\n+        owned_preview(preview_id)\n+        with db():\n+            db().execute(\"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n+                         (preview_id, g.user[\"id\"]))\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return {\"error\": \"Endpoint not found.\"}, 404\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n","additions":274,"deletions":0},{"filePath":"/workspace/backend/preview.py","relativePath":"backend/preview.py","type":"add","patch":"Index: /workspace/backend/preview.py\n===================================================================\n--- /workspace/backend/preview.py\n+++ /workspace/backend/preview.py\n@@ -0,0 +1,229 @@\n+import http.client\n+import ipaddress\n+import re\n+import socket\n+import ssl\n+import time\n+from datetime import datetime, timezone\n+from html.parser import HTMLParser\n+from urllib.parse import quote, urljoin, urlsplit, urlunsplit\n+\n+MAX_PAGE_BYTES = 2 * 1024 * 1024\n+FETCH_TIMEOUT = 20\n+MAX_REDIRECTS = 5\n+\n+\n+class PreviewError(Exception):\n+    def __init__(self, message, status=422):\n+        super().__init__(message)\n+        self.status = status\n+\n+\n+class PlainTextParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.parts = []\n+        self.hidden = 0\n+\n+    def handle_starttag(self, tag, _attrs):\n+        if tag in (\"script\", \"style\"):\n+            self.hidden += 1\n+\n+    def handle_endtag(self, tag):\n+        if tag in (\"script\", \"style\"):\n+            self.hidden = max(0, self.hidden - 1)\n+\n+    def handle_data(self, data):\n+        if not self.hidden:\n+            self.parts.append(data)\n+\n+\n+def plain_text(value, limit):\n+    parser = PlainTextParser()\n+    parser.feed(value)\n+    parser.close()\n+    return \" \".join(\" \".join(parser.parts).split())[:limit]\n+\n+\n+class MetadataParser(HTMLParser):\n+    def __init__(self):\n+        super().__init__(convert_charrefs=True)\n+        self.metadata = {}\n+        self.title_parts = []\n+        self.in_title = False\n+        self.title_finished = False\n+\n+    def handle_starttag(self, tag, attrs):\n+        attributes = {key.lower(): value for key, value in attrs if value is not None}\n+        if tag == \"title\" and not self.title_finished:\n+            self.in_title = True\n+        if tag == \"meta\":\n+            key = (attributes.get(\"property\") or attributes.get(\"name\") or \"\").lower()\n+            value = attributes.get(\"content\", \"\").strip()\n+            if key in (\"og:title\", \"og:description\", \"og:image\", \"description\") and value:\n+                self.metadata.setdefault(key, value)\n+\n+    def handle_endtag(self, tag):\n+        if tag == \"title\":\n+            self.in_title = False\n+            self.title_finished = True\n+\n+    def handle_data(self, data):\n+        if self.in_title:\n+            self.title_parts.append(data)\n+\n+\n+def validated_url(value):\n+    if not isinstance(value, str) or not value.strip() or len(value) > 4096:\n+        raise PreviewError(\"Enter a valid HTTP or HTTPS URL.\", 400)\n+    value = value.strip()\n+    if any(ord(character) < 33 or ord(character) == 127 for character in value) or \"\\\\\" in value:\n+        raise PreviewError(\"The URL contains invalid characters.\", 400)\n+    try:\n+        parsed = urlsplit(value)\n+        if parsed.scheme.lower() not in (\"http\", \"https\") or not parsed.hostname:\n+            raise ValueError\n+        if parsed.username is not None or parsed.password is not None:\n+            raise ValueError\n+        port = parsed.port\n+        hostname = parsed.hostname.encode(\"idna\").decode(\"ascii\")\n+        if \"%\" in hostname or not hostname:\n+            raise ValueError\n+        host = f\"[{hostname}]\" if \":\" in hostname else hostname\n+        netloc = host + (f\":{port}\" if port is not None else \"\")\n+        return urlunsplit((parsed.scheme.lower(), netloc,\n+                           quote(parsed.path or \"/\", safe=\"/%:@!$&'()*+,;=-._~\"),\n+                           quote(parsed.query, safe=\"/%?:@!$&'()*+,;=-._~\"), \"\"))\n+    except (ValueError, UnicodeError):\n+        raise PreviewError(\"Enter a valid HTTP or HTTPS URL without credentials.\", 400) from None\n+\n+\n+def public_addresses(hostname, port):\n+    try:\n+        addresses = socket.getaddrinfo(hostname, port, type=socket.SOCK_STREAM)\n+    except OSError:\n+        raise PreviewError(\"Could not resolve this site's address.\", 502) from None\n+    if not addresses:\n+        raise PreviewError(\"Could not resolve this site's address.\", 502)\n+    for _, _, _, _, address in addresses:\n+        ip = ipaddress.ip_address(address[0])\n+        if not ip.is_global or ip.is_multicast or (ip.version == 6 and ip.ipv4_mapped):\n+            raise PreviewError(\"Only public web links can be previewed.\", 400)\n+    return addresses\n+\n+\n+def open_page(url, deadline):\n+    parsed = urlsplit(url)\n+    port = parsed.port or (443 if parsed.scheme == \"https\" else 80)\n+    addresses = public_addresses(parsed.hostname, port)\n+    connection = http.client.HTTPConnection(parsed.hostname, port, timeout=8)\n+    last_error = None\n+    for family, socktype, protocol, _, address in addresses:\n+        sock = socket.socket(family, socktype, protocol)\n+        try:\n+            remaining = deadline - time.monotonic()\n+            if remaining <= 0:\n+                raise TimeoutError\n+            sock.settimeout(min(8, remaining))\n+            sock.connect(address)\n+            if parsed.scheme == \"https\":\n+                sock = ssl.create_default_context().wrap_socket(sock, server_hostname=parsed.hostname)\n+            connection.sock = sock\n+            target = parsed.path + (\"?\" + parsed.query if parsed.query else \"\")\n+            connection.request(\"GET\", target, headers={\n+                \"User-Agent\": \"Marginal-LinkPreview/1.0\",\n+                \"Accept\": \"text/html,application/xhtml+xml\",\n+                \"Accept-Encoding\": \"identity\",\n+                \"Connection\": \"close\",\n+            })\n+            return connection, connection.getresponse()\n+        except (OSError, http.client.HTTPException) as error:\n+            last_error = error\n+            sock.close()\n+            connection.close()\n+    raise PreviewError(\"The site could not be reached. Please try again.\", 502) from last_error\n+\n+\n+def parse_page(body, content_type, final_url):\n+    charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", content_type, re.I)\n+    if charset_match is None:\n+        charset_match = re.search(r\"charset\\s*=\\s*[\\\"']?([\\w-]+)\", body[:4096].decode(\"ascii\", \"ignore\"), re.I)\n+    charset = charset_match.group(1) if charset_match else \"utf-8\"\n+    try:\n+        html = body.decode(charset, errors=\"replace\")\n+    except LookupError:\n+        html = body.decode(\"utf-8\", errors=\"replace\")\n+    parser = MetadataParser()\n+    parser.feed(html)\n+    parser.close()\n+    metadata = parser.metadata\n+    title = plain_text(metadata.get(\"og:title\", \"\"), 500)\n+    title = title or plain_text(\"\".join(parser.title_parts), 500)\n+    description = plain_text(metadata.get(\"og:description\", \"\"), 5000)\n+    description = description or plain_text(metadata.get(\"description\", \"\"), 5000)\n+    image_url = None\n+    if metadata.get(\"og:image\"):\n+        try:\n+            candidate = validated_url(urljoin(final_url, metadata[\"og:image\"]))\n+            hostname = urlsplit(candidate).hostname\n+            if hostname.lower().rstrip(\".\") == \"localhost\" or hostname.lower().endswith(\".localhost\"):\n+                raise PreviewError(\"Unsafe image URL.\")\n+            try:\n+                ip = ipaddress.ip_address(hostname)\n+            except ValueError:\n+                ip = None\n+            if ip is not None and (not ip.is_global or ip.is_multicast):\n+                raise PreviewError(\"Unsafe image URL.\")\n+            image_url = candidate\n+        except PreviewError:\n+            pass\n+    return {\"title\": title, \"description\": description, \"image_url\": image_url}\n+\n+\n+def fetch_preview(value):\n+    url = validated_url(value)\n+    final_url = url\n+    deadline = time.monotonic() + FETCH_TIMEOUT\n+    for redirect in range(MAX_REDIRECTS + 1):\n+        connection, response = open_page(final_url, deadline)\n+        try:\n+            if response.status in (301, 302, 303, 307, 308):\n+                location = response.getheader(\"Location\")\n+                if not location:\n+                    raise PreviewError(\"The site returned a redirect without a destination.\", 502)\n+                if redirect == MAX_REDIRECTS:\n+                    raise PreviewError(\"The site redirected too many times.\", 502)\n+                final_url = validated_url(urljoin(final_url, location))\n+                continue\n+            content_type = response.getheader(\"Content-Type\", \"\")\n+            if content_type and content_type.split(\";\", 1)[0].strip().lower() not in (\n+                \"text/html\", \"application/xhtml+xml\",\n+            ):\n+                raise PreviewError(\"This link is not an HTML web page.\")\n+            encoding = response.getheader(\"Content-Encoding\", \"identity\").lower()\n+            if encoding not in (\"identity\", \"\"):\n+                raise PreviewError(\"The site returned an unsupported page encoding.\", 502)\n+            chunks = []\n+            size = 0\n+            while True:\n+                remaining = deadline - time.monotonic()\n+                if remaining <= 0:\n+                    raise TimeoutError\n+                if connection.sock is not None:\n+                    connection.sock.settimeout(min(8, remaining))\n+                chunk = response.read1(min(65536, MAX_PAGE_BYTES + 1 - size))\n+                if not chunk:\n+                    break\n+                size += len(chunk)\n+                if size > MAX_PAGE_BYTES:\n+                    raise PreviewError(\"This page is too large to preview.\")\n+                chunks.append(chunk)\n+            metadata = parse_page(b\"\".join(chunks), content_type, final_url)\n+            return {\"url\": url, \"final_url\": final_url, \"status_code\": response.status,\n+                    **metadata, \"fetched_at\": datetime.now(timezone.utc).isoformat()}\n+        except (OSError, http.client.HTTPException):\n+            raise PreviewError(\"The site took too long or returned an incomplete page.\", 502) from None\n+        finally:\n+            response.close()\n+            connection.close()\n+    raise PreviewError(\"The site redirected too many times.\", 502)\n","additions":229,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,9 @@\n+frontend/node_modules/\n+frontend/dist/\n+.venv/\n+__pycache__/\n+*.pyc\n+.ruff_cache/\n+data/\n+playwright-report/\n+test-results/\n","additions":9,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/preview.py\nA .gitignore","time":{"start":1794316357149,"end":1794316357209}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c595b4fb001Y0DnNw5urWPMUU","sessionID":"ses_e3a6af12cffemPwVWkj0znar6y","messageID":"msg_1c595a818001oz34fkktLibfEz"}}
