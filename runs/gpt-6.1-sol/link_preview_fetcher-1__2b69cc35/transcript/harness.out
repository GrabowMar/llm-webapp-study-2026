{"type":"tool_use","timestamp":1794317110395,"sessionID":"ses_e3a6af12cffemPwVWkj0znar6y","part":{"type":"tool","tool":"apply_patch","callID":"call_SE5DJUno386Zx7aXNWd1RJHO","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Add File: /workspace/frontend/src/components/Library.tsx\n+import { useEffect, useState } from \"react\";\n+import { ArrowDown, ArrowRight, Bookmark, ChevronLeft, ChevronRight, LayoutGrid, List, LoaderCircle, Search, X } from \"lucide-react\";\n+import { api, type Preview, type PreviewPage, type Session } from \"../api\";\n+import Dialog from \"./Dialog\";\n+import PreviewCard from \"./PreviewCard\";\n+\n+const PAGE_SIZE = 9;\n+\n+export default function Library({ session, revision, onTotal, notify }: {\n+  session: Session;\n+  revision: number;\n+  onTotal: (total: number) => void;\n+  notify: (message: string) => void;\n+}) {\n+  const [page, setPage] = useState(1);\n+  const [data, setData] = useState<PreviewPage | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [reload, setReload] = useState(0);\n+  const [query, setQuery] = useState(\"\");\n+  const [view, setView] = useState<\"grid\" | \"list\">(\"grid\");\n+  const [refreshing, setRefreshing] = useState<Set<number>>(new Set());\n+  const [deleteTarget, setDeleteTarget] = useState<Preview | null>(null);\n+  const [deleting, setDeleting] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+\n+  useEffect(() => { setPage(1); }, [revision]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    api<PreviewPage>(`/previews?page=${page}&page_size=${PAGE_SIZE}`, {\n+      token: session.token, signal: controller.signal,\n+    }).then((result) => {\n+      setData(result);\n+      onTotal(result.total);\n+      const lastPage = Math.max(1, Math.ceil(result.total / PAGE_SIZE));\n+      if (page > lastPage) setPage(lastPage);\n+    }).catch((error: unknown) => {\n+      if (!controller.signal.aborted) setError(error instanceof Error ? error.message : \"Unable to load links.\");\n+    }).finally(() => {\n+      if (!controller.signal.aborted) setLoading(false);\n+    });\n+    return () => controller.abort();\n+  }, [session.token, page, revision, reload, onTotal]);\n+\n+  async function refresh(preview: Preview) {\n+    setRefreshing((current) => new Set(current).add(preview.id));\n+    try {\n+      const updated = await api<Preview>(`/previews/${preview.id}/refresh`, { token: session.token, method: \"POST\" });\n+      setData((current) => current ? { ...current, items: current.items.map((item) => item.id === updated.id ? updated : item) } : current);\n+      notify(\"A fresh look at a good find. Preview updated.\");\n+    } catch (error) {\n+      notify(error instanceof Error ? error.message : \"Unable to refresh this preview.\");\n+    } finally {\n+      setRefreshing((current) => {\n+        const next = new Set(current);\n+        next.delete(preview.id);\n+        return next;\n+      });\n+    }\n+  }\n+\n+  async function remove() {\n+    if (!deleteTarget || deleting) return;\n+    setDeleting(true);\n+    setDeleteError(\"\");\n+    try {\n+      await api(`/previews/${deleteTarget.id}`, { token: session.token, method: \"DELETE\" });\n+      setDeleteTarget(null);\n+      setReload((current) => current + 1);\n+      notify(\"Link removed from your library.\");\n+    } catch (error) {\n+      setDeleteError(error instanceof Error ? error.message : \"Unable to delete this link.\");\n+    } finally {\n+      setDeleting(false);\n+    }\n+  }\n+\n+  const items = (data?.items ?? []).filter((item) => `${item.title} ${item.description} ${item.url}`.toLowerCase().includes(query.toLowerCase()));\n+  const totalPages = Math.max(1, Math.ceil((data?.total ?? 0) / PAGE_SIZE));\n+\n+  return (\n+    <section aria-labelledby=\"library-heading\">\n+      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4\">\n+        <div className=\"flex items-center gap-3\"><h2 id=\"library-heading\" className=\"text-lg font-semibold tracking-tight\">Your library</h2><span className=\"rounded-md bg-sidebar px-2 py-0.5 text-[11px] text-olive\">{data?.total ?? 0}</span></div>\n+        <div className=\"flex items-center gap-3\">\n+          <div className=\"relative\">\n+            <Search size={14} className=\"pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted\" />\n+            <input aria-label=\"Search links on this page\" value={query} onChange={(event) => setQuery(event.target.value)} placeholder=\"Search this page…\" className=\"w-44 rounded-lg border border-line bg-white py-2 pl-9 pr-8 text-xs placeholder:text-muted/70 sm:w-48\" />\n+            {query && <button aria-label=\"Clear search\" onClick={() => setQuery(\"\")} className=\"absolute right-2 top-1/2 -translate-y-1/2 rounded p-1 text-muted\"><X size={13} /></button>}\n+          </div>\n+          <div className=\"flex rounded-lg border border-line bg-white p-0.5\">\n+            <button aria-label=\"Grid view\" aria-pressed={view === \"grid\"} onClick={() => setView(\"grid\")} className={`rounded-md p-1.5 transition ${view === \"grid\" ? \"bg-sidebar text-olive\" : \"text-muted hover:text-ink\"}`}><LayoutGrid size={16} /></button>\n+            <button aria-label=\"List view\" aria-pressed={view === \"list\"} onClick={() => setView(\"list\")} className={`rounded-md p-1.5 transition ${view === \"list\" ? \"bg-sidebar text-olive\" : \"text-muted hover:text-ink\"}`}><List size={16} /></button>\n+          </div>\n+        </div>\n+      </div>\n+      {!loading && !error && (data?.total ?? 0) > 0 && <div className=\"mb-5 flex items-center justify-between text-[11px] text-muted\"><span>{query ? `Searching ${data?.items.length ?? 0} links on this page` : \"A collection of things that caught your eye.\"}</span><span className=\"flex shrink-0 items-center gap-1.5\"><ArrowDown size={12} />Newest first</span></div>}\n+      {error ? (\n+        <div role=\"alert\" className=\"rounded-xl border border-red-100 bg-red-50/50 px-6 py-10 text-center\"><p className=\"text-sm text-red-700\">{error}</p><button onClick={() => setReload((current) => current + 1)} className=\"mt-4 rounded-lg bg-white px-4 py-2 text-sm text-ink shadow-sm\">Try again</button></div>\n+      ) : loading ? (\n+        <div role=\"status\" aria-label=\"Loading your links\" className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\">{Array.from({ length: 6 }, (_, index) => <div key={index} className=\"overflow-hidden rounded-xl border border-line bg-white motion-safe:animate-pulse\"><div className=\"aspect-[1.85/1] bg-sidebar\" /><div className=\"space-y-4 p-5\"><div className=\"h-2 w-24 rounded bg-sidebar\" /><div className=\"h-5 w-3/4 rounded bg-sidebar\" /><div className=\"h-3 rounded bg-sidebar\" /><div className=\"h-3 w-2/3 rounded bg-sidebar\" /><div className=\"h-5\" /></div></div>)}</div>\n+      ) : !data?.total ? (\n+        <div className=\"flex flex-col items-center rounded-2xl border border-dashed border-olive/25 bg-sidebar/35 px-6 py-16 text-center\">\n+          <span className=\"mb-5 rotate-[-8deg] rounded-2xl border border-olive/15 bg-white p-5 text-olive\"><Bookmark size={30} strokeWidth={1.3} /></span>\n+          <h3 className=\"font-serif text-3xl tracking-tight\">Room for your first good find.</h3>\n+          <p className=\"mt-3 max-w-sm text-sm leading-relaxed text-muted\">An article to read. An idea to revisit. A rabbit hole to fall into. It all starts with a link.</p>\n+          <button onClick={() => document.getElementById(\"link-url\")?.focus()} className=\"mt-6 flex items-center gap-2 rounded-lg bg-olive px-5 py-2.5 text-sm text-white hover:bg-olive/90\">Save your first link<ArrowRight size={15} /></button>\n+        </div>\n+      ) : !items.length ? (\n+        <div className=\"rounded-xl border border-dashed border-line py-16 text-center\"><Search size={25} className=\"mx-auto mb-4 text-muted\" /><h3 className=\"font-serif text-2xl\">No matches on this page.</h3><p className=\"mt-2 text-sm text-muted\">Try a different search or browse another page.</p><button onClick={() => setQuery(\"\")} className=\"mt-4 rounded-lg px-4 py-2 text-sm text-olive underline underline-offset-4\">Clear search</button></div>\n+      ) : (\n+        <div className={view === \"grid\" ? \"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\" : \"flex flex-col gap-4\"}>\n+          {items.map((preview) => <PreviewCard key={preview.id} preview={preview} list={view === \"list\"} refreshing={refreshing.has(preview.id)} onRefresh={() => void refresh(preview)} onDelete={() => { setDeleteError(\"\"); setDeleteTarget(preview); }} />)}\n+        </div>\n+      )}\n+      {!error && (data?.total ?? 0) > 0 && <div className=\"mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 text-xs text-muted\">\n+        <span>{(page - 1) * PAGE_SIZE + 1}–{Math.min(page * PAGE_SIZE, data?.total ?? 0)} of {data?.total} links</span>\n+        <div className=\"flex items-center gap-3\">\n+          <button aria-label=\"Previous page\" disabled={page === 1 || loading} onClick={() => { setPage((current) => current - 1); setQuery(\"\"); }} className=\"flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-2 text-ink hover:bg-sidebar disabled:opacity-35\"><ChevronLeft size={14} /><span className=\"hidden sm:inline\">Previous</span></button>\n+          <span>Page {page} of {totalPages}</span>\n+          <button aria-label=\"Next page\" disabled={page >= totalPages || loading} onClick={() => { setPage((current) => current + 1); setQuery(\"\"); }} className=\"flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-2 text-ink hover:bg-sidebar disabled:opacity-35\"><span className=\"hidden sm:inline\">Next</span><ChevronRight size={14} /></button>\n+        </div>\n+      </div>}\n+      {deleteTarget && <Dialog title=\"Let this one go?\" onClose={() => setDeleteTarget(null)} busy={deleting}>\n+        <p className=\"mt-4 text-sm leading-relaxed text-muted\">“{deleteTarget.title || deleteTarget.url}” will be removed from your library. You can always save it again later.</p>\n+        {deleteError && <p role=\"alert\" className=\"mt-4 text-sm text-red-700\">{deleteError}</p>}\n+        <div className=\"mt-7 flex justify-end gap-3\"><button disabled={deleting} onClick={() => setDeleteTarget(null)} className=\"rounded-lg border border-line px-4 py-2.5 text-sm hover:bg-sidebar\">Keep it</button><button disabled={deleting} onClick={() => void remove()} className=\"flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm text-white hover:bg-red-700 disabled:opacity-60\">{deleting && <LoaderCircle size={15} className=\"animate-spin motion-reduce:animate-none\" />}Delete link</button></div>\n+      </Dialog>}\n+    </section>\n+  );\n+}\n*** Delete File: /workspace/frontend/src/App.tsx\n*** Add File: /workspace/frontend/src/App.tsx\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { ArrowRight, ArrowUpRight, Bookmark, Check, ChevronRight, CircleHelp, Globe2, Leaf, Link2, LoaderCircle, LogOut, Menu, Plus, ShieldCheck, Sparkles, X } from \"lucide-react\";\n+import { api, ApiError, getStoredToken, storeToken, type Session } from \"./api\";\n+import AuthDialog from \"./components/AuthDialog\";\n+import Dialog from \"./components/Dialog\";\n+import Inspiration from \"./components/Inspiration\";\n+import Library from \"./components/Library\";\n+\n+export default function App() {\n+  const [session, setSession] = useState<Session | null>(null);\n+  const [restoring, setRestoring] = useState(() => Boolean(getStoredToken()));\n+  const [restoreError, setRestoreError] = useState(\"\");\n+  const [restoreAttempt, setRestoreAttempt] = useState(0);\n+  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n+  const [info, setInfo] = useState<\"how\" | \"about\" | null>(null);\n+  const [mobileNav, setMobileNav] = useState(false);\n+  const [url, setUrl] = useState(\"\");\n+  const [adding, setAdding] = useState(false);\n+  const [addError, setAddError] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+  const [total, setTotal] = useState(0);\n+  const [notice, setNotice] = useState(\"\");\n+  const [signingOut, setSigningOut] = useState(false);\n+\n+  useEffect(() => {\n+    const token = getStoredToken();\n+    if (!token) { setRestoring(false); return; }\n+    const controller = new AbortController();\n+    setRestoring(true);\n+    setRestoreError(\"\");\n+    api<{ username: string }>(\"/auth/me\", { token, signal: controller.signal }).then((user) => {\n+      setSession({ token, username: user.username });\n+    }).catch((error: unknown) => {\n+      if (controller.signal.aborted) return;\n+      if (error instanceof ApiError && error.status === 401) storeToken(null);\n+      else setRestoreError(error instanceof Error ? error.message : \"Unable to restore your session.\");\n+    }).finally(() => {\n+      if (!controller.signal.aborted) setRestoring(false);\n+    });\n+    return () => controller.abort();\n+  }, [restoreAttempt]);\n+\n+  useEffect(() => {\n+    function expired() {\n+      storeToken(null);\n+      setSession(null);\n+      setTotal(0);\n+      setNotice(\"Your session has expired. Sign in to return to your library.\");\n+    }\n+    window.addEventListener(\"session-expired\", expired);\n+    return () => window.removeEventListener(\"session-expired\", expired);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 6000);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  async function addLink(event: FormEvent) {\n+    event.preventDefault();\n+    if (adding || restoring) return;\n+    setAddError(\"\");\n+    let candidate = url.trim();\n+    if (!candidate) { setAddError(\"Paste a link to get started.\"); return; }\n+    if (!/^[a-z][a-z\\d+.-]*:/i.test(candidate)) candidate = `https://${candidate}`;\n+    try {\n+      const parsed = new URL(candidate);\n+      if (![\"https:\", \"http:\"].includes(parsed.protocol) || !parsed.hostname || parsed.username || parsed.password) throw new Error();\n+    } catch {\n+      setAddError(\"That doesn't look like a web link. Try an HTTP or HTTPS URL.\");\n+      return;\n+    }\n+    if (!session) { setAuthMode(\"register\"); return; }\n+    setAdding(true);\n+    try {\n+      await api(\"/previews\", { token: session.token, method: \"POST\", body: { url: candidate } });\n+      setUrl(\"\");\n+      setRevision((current) => current + 1);\n+      setNotice(\"A good find, safely tucked away.\");\n+    } catch (error) {\n+      setAddError(error instanceof Error ? error.message : \"Unable to save this link.\");\n+    } finally {\n+      setAdding(false);\n+    }\n+  }\n+\n+  async function signOut() {\n+    if (!session || signingOut) return;\n+    setSigningOut(true);\n+    try {\n+      await api(\"/auth/logout\", { token: session.token, method: \"POST\" });\n+      storeToken(null);\n+      setSession(null);\n+      setTotal(0);\n+      setNotice(\"Signed out. Your links will be here when you're back.\");\n+    } catch (error) {\n+      setNotice(error instanceof Error ? error.message : \"Could not sign out. Please try again.\");\n+    } finally {\n+      setSigningOut(false);\n+    }\n+  }\n+\n+  const navigation = (\n+    <>\n+      <a href=\"/\" aria-label=\"Marginal home\" className=\"flex items-center gap-2.5 px-2\"><span className=\"flex h-9 w-9 items-center justify-center rounded-[10px] bg-olive text-white\"><Bookmark size={21} fill=\"currentColor\" strokeWidth={1.5} /></span><span className=\"font-serif text-[31px] tracking-[-1.3px]\">marginal<span className=\"text-olive\">.</span></span></a>\n+      <p className=\"mt-3 pl-2 text-[11px] text-muted\">Good links. A little breathing room.</p>\n+      <nav aria-label=\"Main navigation\" className=\"mt-14\">\n+        <p className=\"mb-4 px-3 text-[9px] font-medium tracking-[0.18em] text-muted\">YOUR SPACE</p>\n+        <button onClick={() => { setMobileNav(false); document.getElementById(\"library-section\")?.scrollIntoView({ behavior: \"smooth\" }); }} className=\"flex w-full items-center gap-3 rounded-lg bg-[#e7ecde] px-3.5 py-3 text-[13px] font-medium text-olive\"><Bookmark size={17} /><span>All links</span><span className=\"ml-auto rounded-md bg-white/65 px-2 py-0.5 text-[10px]\">{session ? total : \"—\"}</span></button>\n+        <button onClick={() => { setInfo(\"how\"); setMobileNav(false); }} className=\"mt-2 flex w-full items-center gap-3 rounded-lg px-3.5 py-3 text-[13px] text-muted hover:bg-line/50 hover:text-ink\"><CircleHelp size={17} />How it works<ArrowUpRight size={13} className=\"ml-auto\" /></button>\n+      </nav>\n+      <div className=\"mt-auto pt-20\">\n+        <div className=\"relative overflow-hidden rounded-xl border border-[#e0e5d7] bg-[#edf0e5] p-5\">\n+          <Leaf size={22} strokeWidth={1.2} className=\"mb-4 text-olive\" />\n+          <p className=\"font-serif text-[20px] leading-[1.35] tracking-[-0.3px]\">Less scrolling.<br />More discovering.</p>\n+          <p className=\"mt-3 text-[11px] leading-[1.8] text-muted\">Make a little space for the things that inspire you.</p>\n+          <svg aria-hidden=\"true\" viewBox=\"0 0 80 110\" className=\"absolute -bottom-4 -right-4 h-28 w-20 rotate-[-20deg] text-olive/15\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M45 110V22M45 55C11 55 9 24 9 24s36 0 36 31zm0 29c30 0 31-30 31-30s-30 0-31 30z\" /></svg>\n+        </div>\n+        <button onClick={() => { setInfo(\"about\"); setMobileNav(false); }} className=\"mt-7 flex items-center gap-2 px-2 text-[11px] text-muted hover:text-olive\"><span className=\"h-1.5 w-1.5 rounded-full bg-olive/60\" />A calmer corner of the internet<ChevronRight size={12} /></button>\n+        <p className=\"mt-4 px-2 text-[10px] text-muted/65\">Made for curious minds.</p>\n+      </div>\n+    </>\n+  );\n+\n+  return (\n+    <div className=\"min-h-screen\">\n+      <aside className=\"fixed inset-y-0 left-0 z-20 hidden w-[244px] flex-col border-r border-line bg-sidebar px-6 pb-7 pt-9 lg:flex\">{navigation}</aside>\n+      {mobileNav && <div className=\"fixed inset-0 z-40 bg-ink/25 lg:hidden\" onMouseDown={(event) => { if (event.currentTarget === event.target) setMobileNav(false); }}><aside className=\"relative flex h-full w-[270px] flex-col overflow-y-auto border-r border-line bg-sidebar px-6 pb-7 pt-9\"><button aria-label=\"Close menu\" onClick={() => setMobileNav(false)} className=\"absolute right-3 top-3 rounded p-1 text-muted\"><X size={18} /></button>{navigation}</aside></div>}\n+      <div className=\"lg:ml-[244px]\">\n+        <header className=\"flex h-[83px] items-center justify-between gap-4 border-b border-line px-5 sm:px-9 xl:px-12\">\n+          <div className=\"flex items-center gap-3\"><button aria-label=\"Open menu\" onClick={() => setMobileNav(true)} className=\"rounded-lg p-1.5 text-muted lg:hidden\"><Menu size={20} /></button><span className=\"font-serif text-2xl tracking-tight lg:hidden\">marginal.</span><span className=\"hidden items-center gap-2 text-[11px] text-muted lg:flex\"><Bookmark size={13} strokeWidth={1.5} />Your personal link library</span></div>\n+          {restoring ? <span role=\"status\" className=\"flex items-center gap-2 text-xs text-muted\"><LoaderCircle size={15} className=\"animate-spin motion-reduce:animate-none\" />Opening your library…</span> : session ? (\n+            <div className=\"flex items-center gap-3 sm:gap-5\"><span className=\"flex items-center gap-2.5\"><span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#e7ecde] font-serif text-sm text-olive\">{session.username.slice(0, 1).toUpperCase()}</span><span className=\"max-w-28 truncate text-xs font-medium sm:max-w-48\">{session.username}</span></span><span className=\"h-5 w-px bg-line\" /><button disabled={signingOut} onClick={() => void signOut()} className=\"flex items-center gap-2 rounded-md p-1 text-xs text-muted hover:text-ink disabled:opacity-50\">{signingOut ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <LogOut size={14} />}<span className=\"hidden sm:inline\">Sign out</span></button></div>\n+          ) : (\n+            <div className=\"flex items-center gap-4 sm:gap-6\"><button onClick={() => setAuthMode(\"login\")} className=\"rounded text-xs text-muted hover:text-ink\">Sign in</button><button onClick={() => setAuthMode(\"register\")} className=\"flex items-center gap-2 rounded-lg bg-olive px-3.5 py-2.5 text-xs font-medium text-white transition hover:bg-olive/90\">Make it yours<ArrowRight size={14} className=\"hidden sm:block\" /></button></div>\n+          )}\n+        </header>\n+        <main className=\"mx-auto max-w-[1320px] px-5 pb-8 pt-9 sm:px-9 sm:pt-11 xl:px-12\">\n+          {restoreError && <div role=\"alert\" className=\"mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800\"><span>{restoreError}</span><button onClick={() => setRestoreAttempt((current) => current + 1)} className=\"rounded font-medium underline underline-offset-2\">Retry session</button></div>}\n+          <section className=\"relative flex items-center justify-between gap-5\" aria-labelledby=\"welcome-heading\">\n+            <div className=\"relative z-10\">\n+              <span className=\"inline-flex items-center gap-1.5 rounded-full border border-[#e1e7d6] bg-[#f0f3e9] px-2.5 py-1 text-[10px] text-olive\"><Sparkles size={11} />A home for your good finds</span>\n+              <h1 id=\"welcome-heading\" className=\"mt-5 font-serif text-[39px] leading-[1.12] tracking-[-1.7px] sm:text-[49px] xl:text-[54px]\">Good links deserve<br />a place to live<span className=\"text-accent\">.</span></h1>\n+              <p className=\"mt-4 max-w-md text-[13px] leading-[1.9] text-muted\">Save what catches your eye. Come back when you're curious.<br className=\"hidden sm:block\" /> Your little corner of the internet, all in one place.</p>\n+            </div>\n+            <img src=\"/illustration.svg\" alt=\"\" className=\"mr-1 hidden w-[240px] shrink-0 lg:block xl:mr-5 xl:w-[285px]\" />\n+          </section>\n+          <section aria-label=\"Save a new link\" className=\"mb-11 mt-9\">\n+            <form onSubmit={addLink} className=\"flex items-center gap-2 rounded-xl border border-line bg-white p-2 shadow-[0_3px_10px_-5px_rgba(47,53,41,0.12)] sm:gap-3 sm:p-2.5\">\n+              <Link2 size={19} className=\"ml-2 shrink-0 text-muted/70 sm:ml-3\" strokeWidth={1.7} />\n+              <input id=\"link-url\" aria-label=\"Link to save\" aria-describedby={addError ? \"add-error\" : \"add-hint\"} inputMode=\"url\" autoComplete=\"url\" value={url} onChange={(event) => { setUrl(event.target.value); if (addError) setAddError(\"\"); }} disabled={adding || restoring} placeholder=\"Paste a link to keep for later…\" className=\"min-w-0 flex-1 rounded-md bg-transparent px-1 py-2 text-[13px] placeholder:text-muted/70 disabled:opacity-50\" />\n+              <button disabled={adding || restoring} className=\"flex min-w-[89px] items-center justify-center gap-2 rounded-lg bg-accent px-4 py-3 text-[12px] font-medium text-white transition hover:bg-[#cc694b] disabled:opacity-60 sm:min-w-[110px] sm:px-5\">{adding ? <LoaderCircle size={16} className=\"animate-spin motion-reduce:animate-none\" /> : <Plus size={17} />}{adding ? \"Saving…\" : \"Add link\"}</button>\n+            </form>\n+            {addError ? <p id=\"add-error\" role=\"alert\" className=\"mt-3 text-xs text-red-700\">{addError}</p> : <p id=\"add-hint\" className=\"mt-3 flex items-center gap-1.5 pl-1 text-[10px] text-muted/80\">{adding ? <><LoaderCircle size={11} className=\"animate-spin motion-reduce:animate-none\" />Fetching the page and putting together your preview…</> : <><ShieldCheck size={11} />{session ? \"Just paste a URL. We'll take care of the preview.\" : \"Your links stay private. Create a free account to start collecting.\"}</>}</p>}\n+          </section>\n+          <div id=\"library-section\" className=\"scroll-mt-8\">\n+            {session ? <Library key={session.token} session={session} revision={revision} onTotal={setTotal} notify={setNotice} /> : (\n+              <section aria-labelledby=\"inspiration-heading\">\n+                <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3\"><div className=\"flex items-center gap-3\"><h2 id=\"inspiration-heading\" className=\"text-[17px] font-semibold tracking-tight\">A little inspiration</h2><span className=\"rounded-md border border-line bg-sidebar px-2 py-0.5 text-[9px] tracking-wide text-muted\">A PEEK INSIDE</span></div><span className=\"flex items-center gap-1.5 text-[10px] text-muted\"><Globe2 size={12} />A big world of good finds</span></div>\n+                <p className=\"mb-5 text-[11px] text-muted\">The kind of links you'll be glad you kept. Here's how they'll look in your library.</p>\n+                <Inspiration />\n+                <div className=\"mt-7 flex flex-col items-start justify-between gap-4 rounded-xl border border-[#e2e7da] bg-[#f0f3e9] px-6 py-5 sm:flex-row sm:items-center\"><div className=\"flex items-center gap-4\"><span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/80 text-olive\"><Bookmark size={19} strokeWidth={1.5} /></span><div><h3 className=\"font-serif text-xl tracking-tight\">Your next good find belongs here.</h3><p className=\"mt-1 text-[11px] text-muted\">Start a collection that's a little more you.</p></div></div><button onClick={() => setAuthMode(\"register\")} className=\"flex shrink-0 items-center gap-2 rounded-lg border border-olive/20 bg-white px-4 py-2.5 text-[11px] font-medium text-olive transition hover:bg-olive hover:text-white\">Create your library<ArrowRight size={14} /></button></div>\n+              </section>\n+            )}\n+          </div>\n+          <footer className=\"mt-10 flex items-center justify-between gap-4 border-t border-line pt-5 text-[10px] text-muted/75\"><span className=\"flex items-center gap-1.5\"><Leaf size={12} strokeWidth={1.4} />Collected with curiosity.</span><span>A little less lost in the tabs.</span></footer>\n+        </main>\n+      </div>\n+      {authMode && <AuthDialog key={authMode} initialMode={authMode} onClose={() => setAuthMode(null)} onSession={(next) => {\n+        storeToken(next.token);\n+        setSession(next);\n+        setRestoreError(\"\");\n+        setAuthMode(null);\n+        setNotice(url.trim() ? \"You're in. Add your link to make your first good find.\" : \"Welcome to your own little corner of the internet.\");\n+      }} />}\n+      {info && <Dialog title={info === \"how\" ? \"A link. A preview. A keeper.\" : \"A little more intentional.\"} onClose={() => setInfo(null)}>\n+        {info === \"how\" ? <div className=\"mt-6 space-y-6\">{[\n+          [\"01\", \"Find something good\", \"An article, a handy resource, or an idea you don't want to lose. Copy its web link.\"],\n+          [\"02\", \"Give it a home\", \"Paste the link and hit Add. We'll fetch the page's title, description, and image to build a little preview.\"],\n+          [\"03\", \"Come back, whenever\", \"Your library is private and saved between visits. Open a link, refresh its preview, or let it go when you're done.\"],\n+        ].map(([number, title, text]) => <div key={number} className=\"flex gap-4\"><span className=\"pt-1 font-serif text-xl text-olive/70\">{number}</span><div><h3 className=\"text-sm font-medium\">{title}</h3><p className=\"mt-2 text-xs leading-[1.8] text-muted\">{text}</p></div></div>)}</div> : <div className=\"mt-5 space-y-4 text-sm leading-[1.9] text-muted\"><p>The internet is full of wonderful things. It's also full of tabs you meant to come back to.</p><p>Marginal is a simple, quiet place to keep the links that matter to you. No feed, no followers, no noise. Just your curiosity, neatly collected.</p><p className=\"flex items-center gap-2 border-t border-line pt-4 text-xs text-olive\"><ShieldCheck size={15} />Only you can see and change your saved links.</p></div>}\n+        {!session && <button onClick={() => { setInfo(null); setAuthMode(\"register\"); }} className=\"mt-7 flex w-full items-center justify-center gap-2 rounded-lg bg-olive px-5 py-3 text-sm text-white hover:bg-olive/90\">Make it yours<ArrowRight size={15} /></button>}\n+      </Dialog>}\n+      {notice && <div role=\"status\" className=\"fixed bottom-5 left-5 right-5 z-[60] mx-auto flex w-fit max-w-[calc(100%-40px)] items-center gap-3 rounded-xl border border-line bg-white px-4 py-3 text-xs shadow-lg\"><Check size={16} className=\"shrink-0 text-olive\" /><span className=\"max-w-md leading-relaxed\">{notice}</span><button aria-label=\"Dismiss notification\" onClick={() => setNotice(\"\")} className=\"shrink-0 rounded p-1 text-muted hover:text-ink\"><X size={14} /></button></div>}\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/public/illustration.svg\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"265\" viewBox=\"0 0 320 265\"><ellipse cx=\"158\" cy=\"224\" rx=\"103\" ry=\"14\" fill=\"#e9ecdf\"/><circle cx=\"163\" cy=\"130\" r=\"107\" fill=\"#f0f2e9\"/><g transform=\"rotate(11 192 124)\"><rect x=\"122\" y=\"50\" width=\"134\" height=\"165\" rx=\"10\" fill=\"#e5e9dc\" stroke=\"#cbd4ba\" stroke-width=\"1.5\"/><rect x=\"139\" y=\"70\" width=\"100\" height=\"65\" rx=\"5\" fill=\"#d2dac2\"/><path d=\"M139 119l32-30 25 23 20-17 23 24v16H139z\" fill=\"#b3c39a\"/><circle cx=\"219\" cy=\"86\" r=\"9\" fill=\"#edf0e6\"/><path d=\"M141 154h76M141 166h61M141 188h28\" stroke=\"#bac5ab\" stroke-width=\"5\" stroke-linecap=\"round\"/></g><g transform=\"rotate(-10 116 134)\"><rect x=\"53\" y=\"39\" width=\"131\" height=\"172\" rx=\"10\" fill=\"#fffef9\" stroke=\"#d5dacb\" stroke-width=\"1.5\"/><rect x=\"66\" y=\"53\" width=\"105\" height=\"77\" rx=\"5\" fill=\"#eddcc8\"/><path d=\"M66 108l29-26 31 27 22-19 23 22v18H66z\" fill=\"#ccb994\"/><circle cx=\"145\" cy=\"74\" r=\"11\" fill=\"#f8efdf\"/><path d=\"M71 147h80M71 159h65\" stroke=\"#c6cdba\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M72 181h26\" stroke=\"#d5d9cf\" stroke-width=\"4\" stroke-linecap=\"round\"/><path d=\"M137 38h24v41l-12-8-12 8z\" fill=\"#7b8d5c\"/></g><g transform=\"rotate(9 237 196)\"><rect x=\"215\" y=\"175\" width=\"48\" height=\"44\" rx=\"12\" fill=\"#e3b598\" stroke=\"#fffef9\" stroke-width=\"4\"/><path d=\"M230 189h18v22l-9-6-9 6z\" fill=\"#fff8ec\"/></g><path d=\"M44 53v13M38 59h13M268 112v12M262 118h12\" stroke=\"#a7b692\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M249 39l3 7 7 3-7 3-3 7-3-7-7-3 7-3z\" fill=\"#cda380\"/><circle cx=\"55\" cy=\"192\" r=\"3\" fill=\"#c7d0b8\"/><circle cx=\"285\" cy=\"157\" r=\"3\" fill=\"#c7d0b8\"/><path d=\"M25 149q8-13 14-6\" fill=\"none\" stroke=\"#c7d0b8\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n*** End Patch"},"output":"Success. Updated the following files:\nA frontend/src/components/Library.tsx\nD frontend/src/App.tsx\nA frontend/src/App.tsx\nA frontend/public/illustration.svg","metadata":{"diff":"Index: /workspace/frontend/src/components/Library.tsx\n===================================================================\n--- /workspace/frontend/src/components/Library.tsx\n+++ /workspace/frontend/src/components/Library.tsx\n@@ -0,0 +1,134 @@\n+import { useEffect, useState } from \"react\";\n+import { ArrowDown, ArrowRight, Bookmark, ChevronLeft, ChevronRight, LayoutGrid, List, LoaderCircle, Search, X } from \"lucide-react\";\n+import { api, type Preview, type PreviewPage, type Session } from \"../api\";\n+import Dialog from \"./Dialog\";\n+import PreviewCard from \"./PreviewCard\";\n+\n+const PAGE_SIZE = 9;\n+\n+export default function Library({ session, revision, onTotal, notify }: {\n+  session: Session;\n+  revision: number;\n+  onTotal: (total: number) => void;\n+  notify: (message: string) => void;\n+}) {\n+  const [page, setPage] = useState(1);\n+  const [data, setData] = useState<PreviewPage | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [reload, setReload] = useState(0);\n+  const [query, setQuery] = useState(\"\");\n+  const [view, setView] = useState<\"grid\" | \"list\">(\"grid\");\n+  const [refreshing, setRefreshing] = useState<Set<number>>(new Set());\n+  const [deleteTarget, setDeleteTarget] = useState<Preview | null>(null);\n+  const [deleting, setDeleting] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+\n+  useEffect(() => { setPage(1); }, [revision]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    api<PreviewPage>(`/previews?page=${page}&page_size=${PAGE_SIZE}`, {\n+      token: session.token, signal: controller.signal,\n+    }).then((result) => {\n+      setData(result);\n+      onTotal(result.total);\n+      const lastPage = Math.max(1, Math.ceil(result.total / PAGE_SIZE));\n+      if (page > lastPage) setPage(lastPage);\n+    }).catch((error: unknown) => {\n+      if (!controller.signal.aborted) setError(error instanceof Error ? error.message : \"Unable to load links.\");\n+    }).finally(() => {\n+      if (!controller.signal.aborted) setLoading(false);\n+    });\n+    return () => controller.abort();\n+  }, [session.token, page, revision, reload, onTotal]);\n+\n+  async function refresh(preview: Preview) {\n+    setRefreshing((current) => new Set(current).add(preview.id));\n+    try {\n+      const updated = await api<Preview>(`/previews/${preview.id}/refresh`, { token: session.token, method: \"POST\" });\n+      setData((current) => current ? { ...current, items: current.items.map((item) => item.id === updated.id ? updated : item) } : current);\n+      notify(\"A fresh look at a good find. Preview updated.\");\n+    } catch (error) {\n+      notify(error instanceof Error ? error.message : \"Unable to refresh this preview.\");\n+    } finally {\n+      setRefreshing((current) => {\n+        const next = new Set(current);\n+        next.delete(preview.id);\n+        return next;\n+      });\n+    }\n+  }\n+\n+  async function remove() {\n+    if (!deleteTarget || deleting) return;\n+    setDeleting(true);\n+    setDeleteError(\"\");\n+    try {\n+      await api(`/previews/${deleteTarget.id}`, { token: session.token, method: \"DELETE\" });\n+      setDeleteTarget(null);\n+      setReload((current) => current + 1);\n+      notify(\"Link removed from your library.\");\n+    } catch (error) {\n+      setDeleteError(error instanceof Error ? error.message : \"Unable to delete this link.\");\n+    } finally {\n+      setDeleting(false);\n+    }\n+  }\n+\n+  const items = (data?.items ?? []).filter((item) => `${item.title} ${item.description} ${item.url}`.toLowerCase().includes(query.toLowerCase()));\n+  const totalPages = Math.max(1, Math.ceil((data?.total ?? 0) / PAGE_SIZE));\n+\n+  return (\n+    <section aria-labelledby=\"library-heading\">\n+      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4\">\n+        <div className=\"flex items-center gap-3\"><h2 id=\"library-heading\" className=\"text-lg font-semibold tracking-tight\">Your library</h2><span className=\"rounded-md bg-sidebar px-2 py-0.5 text-[11px] text-olive\">{data?.total ?? 0}</span></div>\n+        <div className=\"flex items-center gap-3\">\n+          <div className=\"relative\">\n+            <Search size={14} className=\"pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted\" />\n+            <input aria-label=\"Search links on this page\" value={query} onChange={(event) => setQuery(event.target.value)} placeholder=\"Search this page…\" className=\"w-44 rounded-lg border border-line bg-white py-2 pl-9 pr-8 text-xs placeholder:text-muted/70 sm:w-48\" />\n+            {query && <button aria-label=\"Clear search\" onClick={() => setQuery(\"\")} className=\"absolute right-2 top-1/2 -translate-y-1/2 rounded p-1 text-muted\"><X size={13} /></button>}\n+          </div>\n+          <div className=\"flex rounded-lg border border-line bg-white p-0.5\">\n+            <button aria-label=\"Grid view\" aria-pressed={view === \"grid\"} onClick={() => setView(\"grid\")} className={`rounded-md p-1.5 transition ${view === \"grid\" ? \"bg-sidebar text-olive\" : \"text-muted hover:text-ink\"}`}><LayoutGrid size={16} /></button>\n+            <button aria-label=\"List view\" aria-pressed={view === \"list\"} onClick={() => setView(\"list\")} className={`rounded-md p-1.5 transition ${view === \"list\" ? \"bg-sidebar text-olive\" : \"text-muted hover:text-ink\"}`}><List size={16} /></button>\n+          </div>\n+        </div>\n+      </div>\n+      {!loading && !error && (data?.total ?? 0) > 0 && <div className=\"mb-5 flex items-center justify-between text-[11px] text-muted\"><span>{query ? `Searching ${data?.items.length ?? 0} links on this page` : \"A collection of things that caught your eye.\"}</span><span className=\"flex shrink-0 items-center gap-1.5\"><ArrowDown size={12} />Newest first</span></div>}\n+      {error ? (\n+        <div role=\"alert\" className=\"rounded-xl border border-red-100 bg-red-50/50 px-6 py-10 text-center\"><p className=\"text-sm text-red-700\">{error}</p><button onClick={() => setReload((current) => current + 1)} className=\"mt-4 rounded-lg bg-white px-4 py-2 text-sm text-ink shadow-sm\">Try again</button></div>\n+      ) : loading ? (\n+        <div role=\"status\" aria-label=\"Loading your links\" className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\">{Array.from({ length: 6 }, (_, index) => <div key={index} className=\"overflow-hidden rounded-xl border border-line bg-white motion-safe:animate-pulse\"><div className=\"aspect-[1.85/1] bg-sidebar\" /><div className=\"space-y-4 p-5\"><div className=\"h-2 w-24 rounded bg-sidebar\" /><div className=\"h-5 w-3/4 rounded bg-sidebar\" /><div className=\"h-3 rounded bg-sidebar\" /><div className=\"h-3 w-2/3 rounded bg-sidebar\" /><div className=\"h-5\" /></div></div>)}</div>\n+      ) : !data?.total ? (\n+        <div className=\"flex flex-col items-center rounded-2xl border border-dashed border-olive/25 bg-sidebar/35 px-6 py-16 text-center\">\n+          <span className=\"mb-5 rotate-[-8deg] rounded-2xl border border-olive/15 bg-white p-5 text-olive\"><Bookmark size={30} strokeWidth={1.3} /></span>\n+          <h3 className=\"font-serif text-3xl tracking-tight\">Room for your first good find.</h3>\n+          <p className=\"mt-3 max-w-sm text-sm leading-relaxed text-muted\">An article to read. An idea to revisit. A rabbit hole to fall into. It all starts with a link.</p>\n+          <button onClick={() => document.getElementById(\"link-url\")?.focus()} className=\"mt-6 flex items-center gap-2 rounded-lg bg-olive px-5 py-2.5 text-sm text-white hover:bg-olive/90\">Save your first link<ArrowRight size={15} /></button>\n+        </div>\n+      ) : !items.length ? (\n+        <div className=\"rounded-xl border border-dashed border-line py-16 text-center\"><Search size={25} className=\"mx-auto mb-4 text-muted\" /><h3 className=\"font-serif text-2xl\">No matches on this page.</h3><p className=\"mt-2 text-sm text-muted\">Try a different search or browse another page.</p><button onClick={() => setQuery(\"\")} className=\"mt-4 rounded-lg px-4 py-2 text-sm text-olive underline underline-offset-4\">Clear search</button></div>\n+      ) : (\n+        <div className={view === \"grid\" ? \"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\" : \"flex flex-col gap-4\"}>\n+          {items.map((preview) => <PreviewCard key={preview.id} preview={preview} list={view === \"list\"} refreshing={refreshing.has(preview.id)} onRefresh={() => void refresh(preview)} onDelete={() => { setDeleteError(\"\"); setDeleteTarget(preview); }} />)}\n+        </div>\n+      )}\n+      {!error && (data?.total ?? 0) > 0 && <div className=\"mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 text-xs text-muted\">\n+        <span>{(page - 1) * PAGE_SIZE + 1}–{Math.min(page * PAGE_SIZE, data?.total ?? 0)} of {data?.total} links</span>\n+        <div className=\"flex items-center gap-3\">\n+          <button aria-label=\"Previous page\" disabled={page === 1 || loading} onClick={() => { setPage((current) => current - 1); setQuery(\"\"); }} className=\"flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-2 text-ink hover:bg-sidebar disabled:opacity-35\"><ChevronLeft size={14} /><span className=\"hidden sm:inline\">Previous</span></button>\n+          <span>Page {page} of {totalPages}</span>\n+          <button aria-label=\"Next page\" disabled={page >= totalPages || loading} onClick={() => { setPage((current) => current + 1); setQuery(\"\"); }} className=\"flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-2 text-ink hover:bg-sidebar disabled:opacity-35\"><span className=\"hidden sm:inline\">Next</span><ChevronRight size={14} /></button>\n+        </div>\n+      </div>}\n+      {deleteTarget && <Dialog title=\"Let this one go?\" onClose={() => setDeleteTarget(null)} busy={deleting}>\n+        <p className=\"mt-4 text-sm leading-relaxed text-muted\">“{deleteTarget.title || deleteTarget.url}” will be removed from your library. You can always save it again later.</p>\n+        {deleteError && <p role=\"alert\" className=\"mt-4 text-sm text-red-700\">{deleteError}</p>}\n+        <div className=\"mt-7 flex justify-end gap-3\"><button disabled={deleting} onClick={() => setDeleteTarget(null)} className=\"rounded-lg border border-line px-4 py-2.5 text-sm hover:bg-sidebar\">Keep it</button><button disabled={deleting} onClick={() => void remove()} className=\"flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm text-white hover:bg-red-700 disabled:opacity-60\">{deleting && <LoaderCircle size={15} className=\"animate-spin motion-reduce:animate-none\" />}Delete link</button></div>\n+      </Dialog>}\n+    </section>\n+  );\n+}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,188 @@\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { ArrowRight, ArrowUpRight, Bookmark, Check, ChevronRight, CircleHelp, Globe2, Leaf, Link2, LoaderCircle, LogOut, Menu, Plus, ShieldCheck, Sparkles, X } from \"lucide-react\";\n+import { api, ApiError, getStoredToken, storeToken, type Session } from \"./api\";\n+import AuthDialog from \"./components/AuthDialog\";\n+import Dialog from \"./components/Dialog\";\n+import Inspiration from \"./components/Inspiration\";\n+import Library from \"./components/Library\";\n+\n+export default function App() {\n+  const [session, setSession] = useState<Session | null>(null);\n+  const [restoring, setRestoring] = useState(() => Boolean(getStoredToken()));\n+  const [restoreError, setRestoreError] = useState(\"\");\n+  const [restoreAttempt, setRestoreAttempt] = useState(0);\n+  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n+  const [info, setInfo] = useState<\"how\" | \"about\" | null>(null);\n+  const [mobileNav, setMobileNav] = useState(false);\n+  const [url, setUrl] = useState(\"\");\n+  const [adding, setAdding] = useState(false);\n+  const [addError, setAddError] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+  const [total, setTotal] = useState(0);\n+  const [notice, setNotice] = useState(\"\");\n+  const [signingOut, setSigningOut] = useState(false);\n+\n+  useEffect(() => {\n+    const token = getStoredToken();\n+    if (!token) { setRestoring(false); return; }\n+    const controller = new AbortController();\n+    setRestoring(true);\n+    setRestoreError(\"\");\n+    api<{ username: string }>(\"/auth/me\", { token, signal: controller.signal }).then((user) => {\n+      setSession({ token, username: user.username });\n+    }).catch((error: unknown) => {\n+      if (controller.signal.aborted) return;\n+      if (error instanceof ApiError && error.status === 401) storeToken(null);\n+      else setRestoreError(error instanceof Error ? error.message : \"Unable to restore your session.\");\n+    }).finally(() => {\n+      if (!controller.signal.aborted) setRestoring(false);\n+    });\n+    return () => controller.abort();\n+  }, [restoreAttempt]);\n+\n+  useEffect(() => {\n+    function expired() {\n+      storeToken(null);\n+      setSession(null);\n+      setTotal(0);\n+      setNotice(\"Your session has expired. Sign in to return to your library.\");\n+    }\n+    window.addEventListener(\"session-expired\", expired);\n+    return () => window.removeEventListener(\"session-expired\", expired);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 6000);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  async function addLink(event: FormEvent) {\n+    event.preventDefault();\n+    if (adding || restoring) return;\n+    setAddError(\"\");\n+    let candidate = url.trim();\n+    if (!candidate) { setAddError(\"Paste a link to get started.\"); return; }\n+    if (!/^[a-z][a-z\\d+.-]*:/i.test(candidate)) candidate = `https://${candidate}`;\n+    try {\n+      const parsed = new URL(candidate);\n+      if (![\"https:\", \"http:\"].includes(parsed.protocol) || !parsed.hostname || parsed.username || parsed.password) throw new Error();\n+    } catch {\n+      setAddError(\"That doesn't look like a web link. Try an HTTP or HTTPS URL.\");\n+      return;\n+    }\n+    if (!session) { setAuthMode(\"register\"); return; }\n+    setAdding(true);\n+    try {\n+      await api(\"/previews\", { token: session.token, method: \"POST\", body: { url: candidate } });\n+      setUrl(\"\");\n+      setRevision((current) => current + 1);\n+      setNotice(\"A good find, safely tucked away.\");\n+    } catch (error) {\n+      setAddError(error instanceof Error ? error.message : \"Unable to save this link.\");\n+    } finally {\n+      setAdding(false);\n+    }\n+  }\n+\n+  async function signOut() {\n+    if (!session || signingOut) return;\n+    setSigningOut(true);\n+    try {\n+      await api(\"/auth/logout\", { token: session.token, method: \"POST\" });\n+      storeToken(null);\n+      setSession(null);\n+      setTotal(0);\n+      setNotice(\"Signed out. Your links will be here when you're back.\");\n+    } catch (error) {\n+      setNotice(error instanceof Error ? error.message : \"Could not sign out. Please try again.\");\n+    } finally {\n+      setSigningOut(false);\n+    }\n+  }\n+\n+  const navigation = (\n+    <>\n+      <a href=\"/\" aria-label=\"Marginal home\" className=\"flex items-center gap-2.5 px-2\"><span className=\"flex h-9 w-9 items-center justify-center rounded-[10px] bg-olive text-white\"><Bookmark size={21} fill=\"currentColor\" strokeWidth={1.5} /></span><span className=\"font-serif text-[31px] tracking-[-1.3px]\">marginal<span className=\"text-olive\">.</span></span></a>\n+      <p className=\"mt-3 pl-2 text-[11px] text-muted\">Good links. A little breathing room.</p>\n+      <nav aria-label=\"Main navigation\" className=\"mt-14\">\n+        <p className=\"mb-4 px-3 text-[9px] font-medium tracking-[0.18em] text-muted\">YOUR SPACE</p>\n+        <button onClick={() => { setMobileNav(false); document.getElementById(\"library-section\")?.scrollIntoView({ behavior: \"smooth\" }); }} className=\"flex w-full items-center gap-3 rounded-lg bg-[#e7ecde] px-3.5 py-3 text-[13px] font-medium text-olive\"><Bookmark size={17} /><span>All links</span><span className=\"ml-auto rounded-md bg-white/65 px-2 py-0.5 text-[10px]\">{session ? total : \"—\"}</span></button>\n+        <button onClick={() => { setInfo(\"how\"); setMobileNav(false); }} className=\"mt-2 flex w-full items-center gap-3 rounded-lg px-3.5 py-3 text-[13px] text-muted hover:bg-line/50 hover:text-ink\"><CircleHelp size={17} />How it works<ArrowUpRight size={13} className=\"ml-auto\" /></button>\n+      </nav>\n+      <div className=\"mt-auto pt-20\">\n+        <div className=\"relative overflow-hidden rounded-xl border border-[#e0e5d7] bg-[#edf0e5] p-5\">\n+          <Leaf size={22} strokeWidth={1.2} className=\"mb-4 text-olive\" />\n+          <p className=\"font-serif text-[20px] leading-[1.35] tracking-[-0.3px]\">Less scrolling.<br />More discovering.</p>\n+          <p className=\"mt-3 text-[11px] leading-[1.8] text-muted\">Make a little space for the things that inspire you.</p>\n+          <svg aria-hidden=\"true\" viewBox=\"0 0 80 110\" className=\"absolute -bottom-4 -right-4 h-28 w-20 rotate-[-20deg] text-olive/15\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M45 110V22M45 55C11 55 9 24 9 24s36 0 36 31zm0 29c30 0 31-30 31-30s-30 0-31 30z\" /></svg>\n+        </div>\n+        <button onClick={() => { setInfo(\"about\"); setMobileNav(false); }} className=\"mt-7 flex items-center gap-2 px-2 text-[11px] text-muted hover:text-olive\"><span className=\"h-1.5 w-1.5 rounded-full bg-olive/60\" />A calmer corner of the internet<ChevronRight size={12} /></button>\n+        <p className=\"mt-4 px-2 text-[10px] text-muted/65\">Made for curious minds.</p>\n+      </div>\n+    </>\n+  );\n+\n+  return (\n+    <div className=\"min-h-screen\">\n+      <aside className=\"fixed inset-y-0 left-0 z-20 hidden w-[244px] flex-col border-r border-line bg-sidebar px-6 pb-7 pt-9 lg:flex\">{navigation}</aside>\n+      {mobileNav && <div className=\"fixed inset-0 z-40 bg-ink/25 lg:hidden\" onMouseDown={(event) => { if (event.currentTarget === event.target) setMobileNav(false); }}><aside className=\"relative flex h-full w-[270px] flex-col overflow-y-auto border-r border-line bg-sidebar px-6 pb-7 pt-9\"><button aria-label=\"Close menu\" onClick={() => setMobileNav(false)} className=\"absolute right-3 top-3 rounded p-1 text-muted\"><X size={18} /></button>{navigation}</aside></div>}\n+      <div className=\"lg:ml-[244px]\">\n+        <header className=\"flex h-[83px] items-center justify-between gap-4 border-b border-line px-5 sm:px-9 xl:px-12\">\n+          <div className=\"flex items-center gap-3\"><button aria-label=\"Open menu\" onClick={() => setMobileNav(true)} className=\"rounded-lg p-1.5 text-muted lg:hidden\"><Menu size={20} /></button><span className=\"font-serif text-2xl tracking-tight lg:hidden\">marginal.</span><span className=\"hidden items-center gap-2 text-[11px] text-muted lg:flex\"><Bookmark size={13} strokeWidth={1.5} />Your personal link library</span></div>\n+          {restoring ? <span role=\"status\" className=\"flex items-center gap-2 text-xs text-muted\"><LoaderCircle size={15} className=\"animate-spin motion-reduce:animate-none\" />Opening your library…</span> : session ? (\n+            <div className=\"flex items-center gap-3 sm:gap-5\"><span className=\"flex items-center gap-2.5\"><span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#e7ecde] font-serif text-sm text-olive\">{session.username.slice(0, 1).toUpperCase()}</span><span className=\"max-w-28 truncate text-xs font-medium sm:max-w-48\">{session.username}</span></span><span className=\"h-5 w-px bg-line\" /><button disabled={signingOut} onClick={() => void signOut()} className=\"flex items-center gap-2 rounded-md p-1 text-xs text-muted hover:text-ink disabled:opacity-50\">{signingOut ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <LogOut size={14} />}<span className=\"hidden sm:inline\">Sign out</span></button></div>\n+          ) : (\n+            <div className=\"flex items-center gap-4 sm:gap-6\"><button onClick={() => setAuthMode(\"login\")} className=\"rounded text-xs text-muted hover:text-ink\">Sign in</button><button onClick={() => setAuthMode(\"register\")} className=\"flex items-center gap-2 rounded-lg bg-olive px-3.5 py-2.5 text-xs font-medium text-white transition hover:bg-olive/90\">Make it yours<ArrowRight size={14} className=\"hidden sm:block\" /></button></div>\n+          )}\n+        </header>\n+        <main className=\"mx-auto max-w-[1320px] px-5 pb-8 pt-9 sm:px-9 sm:pt-11 xl:px-12\">\n+          {restoreError && <div role=\"alert\" className=\"mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800\"><span>{restoreError}</span><button onClick={() => setRestoreAttempt((current) => current + 1)} className=\"rounded font-medium underline underline-offset-2\">Retry session</button></div>}\n+          <section className=\"relative flex items-center justify-between gap-5\" aria-labelledby=\"welcome-heading\">\n+            <div className=\"relative z-10\">\n+              <span className=\"inline-flex items-center gap-1.5 rounded-full border border-[#e1e7d6] bg-[#f0f3e9] px-2.5 py-1 text-[10px] text-olive\"><Sparkles size={11} />A home for your good finds</span>\n+              <h1 id=\"welcome-heading\" className=\"mt-5 font-serif text-[39px] leading-[1.12] tracking-[-1.7px] sm:text-[49px] xl:text-[54px]\">Good links deserve<br />a place to live<span className=\"text-accent\">.</span></h1>\n+              <p className=\"mt-4 max-w-md text-[13px] leading-[1.9] text-muted\">Save what catches your eye. Come back when you're curious.<br className=\"hidden sm:block\" /> Your little corner of the internet, all in one place.</p>\n+            </div>\n+            <img src=\"/illustration.svg\" alt=\"\" className=\"mr-1 hidden w-[240px] shrink-0 lg:block xl:mr-5 xl:w-[285px]\" />\n+          </section>\n+          <section aria-label=\"Save a new link\" className=\"mb-11 mt-9\">\n+            <form onSubmit={addLink} className=\"flex items-center gap-2 rounded-xl border border-line bg-white p-2 shadow-[0_3px_10px_-5px_rgba(47,53,41,0.12)] sm:gap-3 sm:p-2.5\">\n+              <Link2 size={19} className=\"ml-2 shrink-0 text-muted/70 sm:ml-3\" strokeWidth={1.7} />\n+              <input id=\"link-url\" aria-label=\"Link to save\" aria-describedby={addError ? \"add-error\" : \"add-hint\"} inputMode=\"url\" autoComplete=\"url\" value={url} onChange={(event) => { setUrl(event.target.value); if (addError) setAddError(\"\"); }} disabled={adding || restoring} placeholder=\"Paste a link to keep for later…\" className=\"min-w-0 flex-1 rounded-md bg-transparent px-1 py-2 text-[13px] placeholder:text-muted/70 disabled:opacity-50\" />\n+              <button disabled={adding || restoring} className=\"flex min-w-[89px] items-center justify-center gap-2 rounded-lg bg-accent px-4 py-3 text-[12px] font-medium text-white transition hover:bg-[#cc694b] disabled:opacity-60 sm:min-w-[110px] sm:px-5\">{adding ? <LoaderCircle size={16} className=\"animate-spin motion-reduce:animate-none\" /> : <Plus size={17} />}{adding ? \"Saving…\" : \"Add link\"}</button>\n+            </form>\n+            {addError ? <p id=\"add-error\" role=\"alert\" className=\"mt-3 text-xs text-red-700\">{addError}</p> : <p id=\"add-hint\" className=\"mt-3 flex items-center gap-1.5 pl-1 text-[10px] text-muted/80\">{adding ? <><LoaderCircle size={11} className=\"animate-spin motion-reduce:animate-none\" />Fetching the page and putting together your preview…</> : <><ShieldCheck size={11} />{session ? \"Just paste a URL. We'll take care of the preview.\" : \"Your links stay private. Create a free account to start collecting.\"}</>}</p>}\n+          </section>\n+          <div id=\"library-section\" className=\"scroll-mt-8\">\n+            {session ? <Library key={session.token} session={session} revision={revision} onTotal={setTotal} notify={setNotice} /> : (\n+              <section aria-labelledby=\"inspiration-heading\">\n+                <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3\"><div className=\"flex items-center gap-3\"><h2 id=\"inspiration-heading\" className=\"text-[17px] font-semibold tracking-tight\">A little inspiration</h2><span className=\"rounded-md border border-line bg-sidebar px-2 py-0.5 text-[9px] tracking-wide text-muted\">A PEEK INSIDE</span></div><span className=\"flex items-center gap-1.5 text-[10px] text-muted\"><Globe2 size={12} />A big world of good finds</span></div>\n+                <p className=\"mb-5 text-[11px] text-muted\">The kind of links you'll be glad you kept. Here's how they'll look in your library.</p>\n+                <Inspiration />\n+                <div className=\"mt-7 flex flex-col items-start justify-between gap-4 rounded-xl border border-[#e2e7da] bg-[#f0f3e9] px-6 py-5 sm:flex-row sm:items-center\"><div className=\"flex items-center gap-4\"><span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/80 text-olive\"><Bookmark size={19} strokeWidth={1.5} /></span><div><h3 className=\"font-serif text-xl tracking-tight\">Your next good find belongs here.</h3><p className=\"mt-1 text-[11px] text-muted\">Start a collection that's a little more you.</p></div></div><button onClick={() => setAuthMode(\"register\")} className=\"flex shrink-0 items-center gap-2 rounded-lg border border-olive/20 bg-white px-4 py-2.5 text-[11px] font-medium text-olive transition hover:bg-olive hover:text-white\">Create your library<ArrowRight size={14} /></button></div>\n+              </section>\n+            )}\n+          </div>\n+          <footer className=\"mt-10 flex items-center justify-between gap-4 border-t border-line pt-5 text-[10px] text-muted/75\"><span className=\"flex items-center gap-1.5\"><Leaf size={12} strokeWidth={1.4} />Collected with curiosity.</span><span>A little less lost in the tabs.</span></footer>\n+        </main>\n+      </div>\n+      {authMode && <AuthDialog key={authMode} initialMode={authMode} onClose={() => setAuthMode(null)} onSession={(next) => {\n+        storeToken(next.token);\n+        setSession(next);\n+        setRestoreError(\"\");\n+        setAuthMode(null);\n+        setNotice(url.trim() ? \"You're in. Add your link to make your first good find.\" : \"Welcome to your own little corner of the internet.\");\n+      }} />}\n+      {info && <Dialog title={info === \"how\" ? \"A link. A preview. A keeper.\" : \"A little more intentional.\"} onClose={() => setInfo(null)}>\n+        {info === \"how\" ? <div className=\"mt-6 space-y-6\">{[\n+          [\"01\", \"Find something good\", \"An article, a handy resource, or an idea you don't want to lose. Copy its web link.\"],\n+          [\"02\", \"Give it a home\", \"Paste the link and hit Add. We'll fetch the page's title, description, and image to build a little preview.\"],\n+          [\"03\", \"Come back, whenever\", \"Your library is private and saved between visits. Open a link, refresh its preview, or let it go when you're done.\"],\n+        ].map(([number, title, text]) => <div key={number} className=\"flex gap-4\"><span className=\"pt-1 font-serif text-xl text-olive/70\">{number}</span><div><h3 className=\"text-sm font-medium\">{title}</h3><p className=\"mt-2 text-xs leading-[1.8] text-muted\">{text}</p></div></div>)}</div> : <div className=\"mt-5 space-y-4 text-sm leading-[1.9] text-muted\"><p>The internet is full of wonderful things. It's also full of tabs you meant to come back to.</p><p>Marginal is a simple, quiet place to keep the links that matter to you. No feed, no followers, no noise. Just your curiosity, neatly collected.</p><p className=\"flex items-center gap-2 border-t border-line pt-4 text-xs text-olive\"><ShieldCheck size={15} />Only you can see and change your saved links.</p></div>}\n+        {!session && <button onClick={() => { setInfo(null); setAuthMode(\"register\"); }} className=\"mt-7 flex w-full items-center justify-center gap-2 rounded-lg bg-olive px-5 py-3 text-sm text-white hover:bg-olive/90\">Make it yours<ArrowRight size={15} /></button>}\n+      </Dialog>}\n+      {notice && <div role=\"status\" className=\"fixed bottom-5 left-5 right-5 z-[60] mx-auto flex w-fit max-w-[calc(100%-40px)] items-center gap-3 rounded-xl border border-line bg-white px-4 py-3 text-xs shadow-lg\"><Check size={16} className=\"shrink-0 text-olive\" /><span className=\"max-w-md leading-relaxed\">{notice}</span><button aria-label=\"Dismiss notification\" onClick={() => setNotice(\"\")} className=\"shrink-0 rounded p-1 text-muted hover:text-ink\"><X size={14} /></button></div>}\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/public/illustration.svg\n===================================================================\n--- /workspace/frontend/public/illustration.svg\n+++ /workspace/frontend/public/illustration.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"265\" viewBox=\"0 0 320 265\"><ellipse cx=\"158\" cy=\"224\" rx=\"103\" ry=\"14\" fill=\"#e9ecdf\"/><circle cx=\"163\" cy=\"130\" r=\"107\" fill=\"#f0f2e9\"/><g transform=\"rotate(11 192 124)\"><rect x=\"122\" y=\"50\" width=\"134\" height=\"165\" rx=\"10\" fill=\"#e5e9dc\" stroke=\"#cbd4ba\" stroke-width=\"1.5\"/><rect x=\"139\" y=\"70\" width=\"100\" height=\"65\" rx=\"5\" fill=\"#d2dac2\"/><path d=\"M139 119l32-30 25 23 20-17 23 24v16H139z\" fill=\"#b3c39a\"/><circle cx=\"219\" cy=\"86\" r=\"9\" fill=\"#edf0e6\"/><path d=\"M141 154h76M141 166h61M141 188h28\" stroke=\"#bac5ab\" stroke-width=\"5\" stroke-linecap=\"round\"/></g><g transform=\"rotate(-10 116 134)\"><rect x=\"53\" y=\"39\" width=\"131\" height=\"172\" rx=\"10\" fill=\"#fffef9\" stroke=\"#d5dacb\" stroke-width=\"1.5\"/><rect x=\"66\" y=\"53\" width=\"105\" height=\"77\" rx=\"5\" fill=\"#eddcc8\"/><path d=\"M66 108l29-26 31 27 22-19 23 22v18H66z\" fill=\"#ccb994\"/><circle cx=\"145\" cy=\"74\" r=\"11\" fill=\"#f8efdf\"/><path d=\"M71 147h80M71 159h65\" stroke=\"#c6cdba\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M72 181h26\" stroke=\"#d5d9cf\" stroke-width=\"4\" stroke-linecap=\"round\"/><path d=\"M137 38h24v41l-12-8-12 8z\" fill=\"#7b8d5c\"/></g><g transform=\"rotate(9 237 196)\"><rect x=\"215\" y=\"175\" width=\"48\" height=\"44\" rx=\"12\" fill=\"#e3b598\" stroke=\"#fffef9\" stroke-width=\"4\"/><path d=\"M230 189h18v22l-9-6-9 6z\" fill=\"#fff8ec\"/></g><path d=\"M44 53v13M38 59h13M268 112v12M262 118h12\" stroke=\"#a7b692\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M249 39l3 7 7 3-7 3-3 7-3-7-7-3 7-3z\" fill=\"#cda380\"/><circle cx=\"55\" cy=\"192\" r=\"3\" fill=\"#c7d0b8\"/><circle cx=\"285\" cy=\"157\" r=\"3\" fill=\"#c7d0b8\"/><path d=\"M25 149q8-13 14-6\" fill=\"none\" stroke=\"#c7d0b8\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n\n","files":[{"filePath":"/workspace/frontend/src/components/Library.tsx","relativePath":"frontend/src/components/Library.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Library.tsx\n===================================================================\n--- /workspace/frontend/src/components/Library.tsx\n+++ /workspace/frontend/src/components/Library.tsx\n@@ -0,0 +1,134 @@\n+import { useEffect, useState } from \"react\";\n+import { ArrowDown, ArrowRight, Bookmark, ChevronLeft, ChevronRight, LayoutGrid, List, LoaderCircle, Search, X } from \"lucide-react\";\n+import { api, type Preview, type PreviewPage, type Session } from \"../api\";\n+import Dialog from \"./Dialog\";\n+import PreviewCard from \"./PreviewCard\";\n+\n+const PAGE_SIZE = 9;\n+\n+export default function Library({ session, revision, onTotal, notify }: {\n+  session: Session;\n+  revision: number;\n+  onTotal: (total: number) => void;\n+  notify: (message: string) => void;\n+}) {\n+  const [page, setPage] = useState(1);\n+  const [data, setData] = useState<PreviewPage | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [reload, setReload] = useState(0);\n+  const [query, setQuery] = useState(\"\");\n+  const [view, setView] = useState<\"grid\" | \"list\">(\"grid\");\n+  const [refreshing, setRefreshing] = useState<Set<number>>(new Set());\n+  const [deleteTarget, setDeleteTarget] = useState<Preview | null>(null);\n+  const [deleting, setDeleting] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+\n+  useEffect(() => { setPage(1); }, [revision]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    api<PreviewPage>(`/previews?page=${page}&page_size=${PAGE_SIZE}`, {\n+      token: session.token, signal: controller.signal,\n+    }).then((result) => {\n+      setData(result);\n+      onTotal(result.total);\n+      const lastPage = Math.max(1, Math.ceil(result.total / PAGE_SIZE));\n+      if (page > lastPage) setPage(lastPage);\n+    }).catch((error: unknown) => {\n+      if (!controller.signal.aborted) setError(error instanceof Error ? error.message : \"Unable to load links.\");\n+    }).finally(() => {\n+      if (!controller.signal.aborted) setLoading(false);\n+    });\n+    return () => controller.abort();\n+  }, [session.token, page, revision, reload, onTotal]);\n+\n+  async function refresh(preview: Preview) {\n+    setRefreshing((current) => new Set(current).add(preview.id));\n+    try {\n+      const updated = await api<Preview>(`/previews/${preview.id}/refresh`, { token: session.token, method: \"POST\" });\n+      setData((current) => current ? { ...current, items: current.items.map((item) => item.id === updated.id ? updated : item) } : current);\n+      notify(\"A fresh look at a good find. Preview updated.\");\n+    } catch (error) {\n+      notify(error instanceof Error ? error.message : \"Unable to refresh this preview.\");\n+    } finally {\n+      setRefreshing((current) => {\n+        const next = new Set(current);\n+        next.delete(preview.id);\n+        return next;\n+      });\n+    }\n+  }\n+\n+  async function remove() {\n+    if (!deleteTarget || deleting) return;\n+    setDeleting(true);\n+    setDeleteError(\"\");\n+    try {\n+      await api(`/previews/${deleteTarget.id}`, { token: session.token, method: \"DELETE\" });\n+      setDeleteTarget(null);\n+      setReload((current) => current + 1);\n+      notify(\"Link removed from your library.\");\n+    } catch (error) {\n+      setDeleteError(error instanceof Error ? error.message : \"Unable to delete this link.\");\n+    } finally {\n+      setDeleting(false);\n+    }\n+  }\n+\n+  const items = (data?.items ?? []).filter((item) => `${item.title} ${item.description} ${item.url}`.toLowerCase().includes(query.toLowerCase()));\n+  const totalPages = Math.max(1, Math.ceil((data?.total ?? 0) / PAGE_SIZE));\n+\n+  return (\n+    <section aria-labelledby=\"library-heading\">\n+      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4\">\n+        <div className=\"flex items-center gap-3\"><h2 id=\"library-heading\" className=\"text-lg font-semibold tracking-tight\">Your library</h2><span className=\"rounded-md bg-sidebar px-2 py-0.5 text-[11px] text-olive\">{data?.total ?? 0}</span></div>\n+        <div className=\"flex items-center gap-3\">\n+          <div className=\"relative\">\n+            <Search size={14} className=\"pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted\" />\n+            <input aria-label=\"Search links on this page\" value={query} onChange={(event) => setQuery(event.target.value)} placeholder=\"Search this page…\" className=\"w-44 rounded-lg border border-line bg-white py-2 pl-9 pr-8 text-xs placeholder:text-muted/70 sm:w-48\" />\n+            {query && <button aria-label=\"Clear search\" onClick={() => setQuery(\"\")} className=\"absolute right-2 top-1/2 -translate-y-1/2 rounded p-1 text-muted\"><X size={13} /></button>}\n+          </div>\n+          <div className=\"flex rounded-lg border border-line bg-white p-0.5\">\n+            <button aria-label=\"Grid view\" aria-pressed={view === \"grid\"} onClick={() => setView(\"grid\")} className={`rounded-md p-1.5 transition ${view === \"grid\" ? \"bg-sidebar text-olive\" : \"text-muted hover:text-ink\"}`}><LayoutGrid size={16} /></button>\n+            <button aria-label=\"List view\" aria-pressed={view === \"list\"} onClick={() => setView(\"list\")} className={`rounded-md p-1.5 transition ${view === \"list\" ? \"bg-sidebar text-olive\" : \"text-muted hover:text-ink\"}`}><List size={16} /></button>\n+          </div>\n+        </div>\n+      </div>\n+      {!loading && !error && (data?.total ?? 0) > 0 && <div className=\"mb-5 flex items-center justify-between text-[11px] text-muted\"><span>{query ? `Searching ${data?.items.length ?? 0} links on this page` : \"A collection of things that caught your eye.\"}</span><span className=\"flex shrink-0 items-center gap-1.5\"><ArrowDown size={12} />Newest first</span></div>}\n+      {error ? (\n+        <div role=\"alert\" className=\"rounded-xl border border-red-100 bg-red-50/50 px-6 py-10 text-center\"><p className=\"text-sm text-red-700\">{error}</p><button onClick={() => setReload((current) => current + 1)} className=\"mt-4 rounded-lg bg-white px-4 py-2 text-sm text-ink shadow-sm\">Try again</button></div>\n+      ) : loading ? (\n+        <div role=\"status\" aria-label=\"Loading your links\" className=\"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\">{Array.from({ length: 6 }, (_, index) => <div key={index} className=\"overflow-hidden rounded-xl border border-line bg-white motion-safe:animate-pulse\"><div className=\"aspect-[1.85/1] bg-sidebar\" /><div className=\"space-y-4 p-5\"><div className=\"h-2 w-24 rounded bg-sidebar\" /><div className=\"h-5 w-3/4 rounded bg-sidebar\" /><div className=\"h-3 rounded bg-sidebar\" /><div className=\"h-3 w-2/3 rounded bg-sidebar\" /><div className=\"h-5\" /></div></div>)}</div>\n+      ) : !data?.total ? (\n+        <div className=\"flex flex-col items-center rounded-2xl border border-dashed border-olive/25 bg-sidebar/35 px-6 py-16 text-center\">\n+          <span className=\"mb-5 rotate-[-8deg] rounded-2xl border border-olive/15 bg-white p-5 text-olive\"><Bookmark size={30} strokeWidth={1.3} /></span>\n+          <h3 className=\"font-serif text-3xl tracking-tight\">Room for your first good find.</h3>\n+          <p className=\"mt-3 max-w-sm text-sm leading-relaxed text-muted\">An article to read. An idea to revisit. A rabbit hole to fall into. It all starts with a link.</p>\n+          <button onClick={() => document.getElementById(\"link-url\")?.focus()} className=\"mt-6 flex items-center gap-2 rounded-lg bg-olive px-5 py-2.5 text-sm text-white hover:bg-olive/90\">Save your first link<ArrowRight size={15} /></button>\n+        </div>\n+      ) : !items.length ? (\n+        <div className=\"rounded-xl border border-dashed border-line py-16 text-center\"><Search size={25} className=\"mx-auto mb-4 text-muted\" /><h3 className=\"font-serif text-2xl\">No matches on this page.</h3><p className=\"mt-2 text-sm text-muted\">Try a different search or browse another page.</p><button onClick={() => setQuery(\"\")} className=\"mt-4 rounded-lg px-4 py-2 text-sm text-olive underline underline-offset-4\">Clear search</button></div>\n+      ) : (\n+        <div className={view === \"grid\" ? \"grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3\" : \"flex flex-col gap-4\"}>\n+          {items.map((preview) => <PreviewCard key={preview.id} preview={preview} list={view === \"list\"} refreshing={refreshing.has(preview.id)} onRefresh={() => void refresh(preview)} onDelete={() => { setDeleteError(\"\"); setDeleteTarget(preview); }} />)}\n+        </div>\n+      )}\n+      {!error && (data?.total ?? 0) > 0 && <div className=\"mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 text-xs text-muted\">\n+        <span>{(page - 1) * PAGE_SIZE + 1}–{Math.min(page * PAGE_SIZE, data?.total ?? 0)} of {data?.total} links</span>\n+        <div className=\"flex items-center gap-3\">\n+          <button aria-label=\"Previous page\" disabled={page === 1 || loading} onClick={() => { setPage((current) => current - 1); setQuery(\"\"); }} className=\"flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-2 text-ink hover:bg-sidebar disabled:opacity-35\"><ChevronLeft size={14} /><span className=\"hidden sm:inline\">Previous</span></button>\n+          <span>Page {page} of {totalPages}</span>\n+          <button aria-label=\"Next page\" disabled={page >= totalPages || loading} onClick={() => { setPage((current) => current + 1); setQuery(\"\"); }} className=\"flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-2 text-ink hover:bg-sidebar disabled:opacity-35\"><span className=\"hidden sm:inline\">Next</span><ChevronRight size={14} /></button>\n+        </div>\n+      </div>}\n+      {deleteTarget && <Dialog title=\"Let this one go?\" onClose={() => setDeleteTarget(null)} busy={deleting}>\n+        <p className=\"mt-4 text-sm leading-relaxed text-muted\">“{deleteTarget.title || deleteTarget.url}” will be removed from your library. You can always save it again later.</p>\n+        {deleteError && <p role=\"alert\" className=\"mt-4 text-sm text-red-700\">{deleteError}</p>}\n+        <div className=\"mt-7 flex justify-end gap-3\"><button disabled={deleting} onClick={() => setDeleteTarget(null)} className=\"rounded-lg border border-line px-4 py-2.5 text-sm hover:bg-sidebar\">Keep it</button><button disabled={deleting} onClick={() => void remove()} className=\"flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm text-white hover:bg-red-700 disabled:opacity-60\">{deleting && <LoaderCircle size={15} className=\"animate-spin motion-reduce:animate-none\" />}Delete link</button></div>\n+      </Dialog>}\n+    </section>\n+  );\n+}\n","additions":134,"deletions":0},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"delete","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n","additions":0,"deletions":4},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"add","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,188 @@\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { ArrowRight, ArrowUpRight, Bookmark, Check, ChevronRight, CircleHelp, Globe2, Leaf, Link2, LoaderCircle, LogOut, Menu, Plus, ShieldCheck, Sparkles, X } from \"lucide-react\";\n+import { api, ApiError, getStoredToken, storeToken, type Session } from \"./api\";\n+import AuthDialog from \"./components/AuthDialog\";\n+import Dialog from \"./components/Dialog\";\n+import Inspiration from \"./components/Inspiration\";\n+import Library from \"./components/Library\";\n+\n+export default function App() {\n+  const [session, setSession] = useState<Session | null>(null);\n+  const [restoring, setRestoring] = useState(() => Boolean(getStoredToken()));\n+  const [restoreError, setRestoreError] = useState(\"\");\n+  const [restoreAttempt, setRestoreAttempt] = useState(0);\n+  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n+  const [info, setInfo] = useState<\"how\" | \"about\" | null>(null);\n+  const [mobileNav, setMobileNav] = useState(false);\n+  const [url, setUrl] = useState(\"\");\n+  const [adding, setAdding] = useState(false);\n+  const [addError, setAddError] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+  const [total, setTotal] = useState(0);\n+  const [notice, setNotice] = useState(\"\");\n+  const [signingOut, setSigningOut] = useState(false);\n+\n+  useEffect(() => {\n+    const token = getStoredToken();\n+    if (!token) { setRestoring(false); return; }\n+    const controller = new AbortController();\n+    setRestoring(true);\n+    setRestoreError(\"\");\n+    api<{ username: string }>(\"/auth/me\", { token, signal: controller.signal }).then((user) => {\n+      setSession({ token, username: user.username });\n+    }).catch((error: unknown) => {\n+      if (controller.signal.aborted) return;\n+      if (error instanceof ApiError && error.status === 401) storeToken(null);\n+      else setRestoreError(error instanceof Error ? error.message : \"Unable to restore your session.\");\n+    }).finally(() => {\n+      if (!controller.signal.aborted) setRestoring(false);\n+    });\n+    return () => controller.abort();\n+  }, [restoreAttempt]);\n+\n+  useEffect(() => {\n+    function expired() {\n+      storeToken(null);\n+      setSession(null);\n+      setTotal(0);\n+      setNotice(\"Your session has expired. Sign in to return to your library.\");\n+    }\n+    window.addEventListener(\"session-expired\", expired);\n+    return () => window.removeEventListener(\"session-expired\", expired);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 6000);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  async function addLink(event: FormEvent) {\n+    event.preventDefault();\n+    if (adding || restoring) return;\n+    setAddError(\"\");\n+    let candidate = url.trim();\n+    if (!candidate) { setAddError(\"Paste a link to get started.\"); return; }\n+    if (!/^[a-z][a-z\\d+.-]*:/i.test(candidate)) candidate = `https://${candidate}`;\n+    try {\n+      const parsed = new URL(candidate);\n+      if (![\"https:\", \"http:\"].includes(parsed.protocol) || !parsed.hostname || parsed.username || parsed.password) throw new Error();\n+    } catch {\n+      setAddError(\"That doesn't look like a web link. Try an HTTP or HTTPS URL.\");\n+      return;\n+    }\n+    if (!session) { setAuthMode(\"register\"); return; }\n+    setAdding(true);\n+    try {\n+      await api(\"/previews\", { token: session.token, method: \"POST\", body: { url: candidate } });\n+      setUrl(\"\");\n+      setRevision((current) => current + 1);\n+      setNotice(\"A good find, safely tucked away.\");\n+    } catch (error) {\n+      setAddError(error instanceof Error ? error.message : \"Unable to save this link.\");\n+    } finally {\n+      setAdding(false);\n+    }\n+  }\n+\n+  async function signOut() {\n+    if (!session || signingOut) return;\n+    setSigningOut(true);\n+    try {\n+      await api(\"/auth/logout\", { token: session.token, method: \"POST\" });\n+      storeToken(null);\n+      setSession(null);\n+      setTotal(0);\n+      setNotice(\"Signed out. Your links will be here when you're back.\");\n+    } catch (error) {\n+      setNotice(error instanceof Error ? error.message : \"Could not sign out. Please try again.\");\n+    } finally {\n+      setSigningOut(false);\n+    }\n+  }\n+\n+  const navigation = (\n+    <>\n+      <a href=\"/\" aria-label=\"Marginal home\" className=\"flex items-center gap-2.5 px-2\"><span className=\"flex h-9 w-9 items-center justify-center rounded-[10px] bg-olive text-white\"><Bookmark size={21} fill=\"currentColor\" strokeWidth={1.5} /></span><span className=\"font-serif text-[31px] tracking-[-1.3px]\">marginal<span className=\"text-olive\">.</span></span></a>\n+      <p className=\"mt-3 pl-2 text-[11px] text-muted\">Good links. A little breathing room.</p>\n+      <nav aria-label=\"Main navigation\" className=\"mt-14\">\n+        <p className=\"mb-4 px-3 text-[9px] font-medium tracking-[0.18em] text-muted\">YOUR SPACE</p>\n+        <button onClick={() => { setMobileNav(false); document.getElementById(\"library-section\")?.scrollIntoView({ behavior: \"smooth\" }); }} className=\"flex w-full items-center gap-3 rounded-lg bg-[#e7ecde] px-3.5 py-3 text-[13px] font-medium text-olive\"><Bookmark size={17} /><span>All links</span><span className=\"ml-auto rounded-md bg-white/65 px-2 py-0.5 text-[10px]\">{session ? total : \"—\"}</span></button>\n+        <button onClick={() => { setInfo(\"how\"); setMobileNav(false); }} className=\"mt-2 flex w-full items-center gap-3 rounded-lg px-3.5 py-3 text-[13px] text-muted hover:bg-line/50 hover:text-ink\"><CircleHelp size={17} />How it works<ArrowUpRight size={13} className=\"ml-auto\" /></button>\n+      </nav>\n+      <div className=\"mt-auto pt-20\">\n+        <div className=\"relative overflow-hidden rounded-xl border border-[#e0e5d7] bg-[#edf0e5] p-5\">\n+          <Leaf size={22} strokeWidth={1.2} className=\"mb-4 text-olive\" />\n+          <p className=\"font-serif text-[20px] leading-[1.35] tracking-[-0.3px]\">Less scrolling.<br />More discovering.</p>\n+          <p className=\"mt-3 text-[11px] leading-[1.8] text-muted\">Make a little space for the things that inspire you.</p>\n+          <svg aria-hidden=\"true\" viewBox=\"0 0 80 110\" className=\"absolute -bottom-4 -right-4 h-28 w-20 rotate-[-20deg] text-olive/15\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M45 110V22M45 55C11 55 9 24 9 24s36 0 36 31zm0 29c30 0 31-30 31-30s-30 0-31 30z\" /></svg>\n+        </div>\n+        <button onClick={() => { setInfo(\"about\"); setMobileNav(false); }} className=\"mt-7 flex items-center gap-2 px-2 text-[11px] text-muted hover:text-olive\"><span className=\"h-1.5 w-1.5 rounded-full bg-olive/60\" />A calmer corner of the internet<ChevronRight size={12} /></button>\n+        <p className=\"mt-4 px-2 text-[10px] text-muted/65\">Made for curious minds.</p>\n+      </div>\n+    </>\n+  );\n+\n+  return (\n+    <div className=\"min-h-screen\">\n+      <aside className=\"fixed inset-y-0 left-0 z-20 hidden w-[244px] flex-col border-r border-line bg-sidebar px-6 pb-7 pt-9 lg:flex\">{navigation}</aside>\n+      {mobileNav && <div className=\"fixed inset-0 z-40 bg-ink/25 lg:hidden\" onMouseDown={(event) => { if (event.currentTarget === event.target) setMobileNav(false); }}><aside className=\"relative flex h-full w-[270px] flex-col overflow-y-auto border-r border-line bg-sidebar px-6 pb-7 pt-9\"><button aria-label=\"Close menu\" onClick={() => setMobileNav(false)} className=\"absolute right-3 top-3 rounded p-1 text-muted\"><X size={18} /></button>{navigation}</aside></div>}\n+      <div className=\"lg:ml-[244px]\">\n+        <header className=\"flex h-[83px] items-center justify-between gap-4 border-b border-line px-5 sm:px-9 xl:px-12\">\n+          <div className=\"flex items-center gap-3\"><button aria-label=\"Open menu\" onClick={() => setMobileNav(true)} className=\"rounded-lg p-1.5 text-muted lg:hidden\"><Menu size={20} /></button><span className=\"font-serif text-2xl tracking-tight lg:hidden\">marginal.</span><span className=\"hidden items-center gap-2 text-[11px] text-muted lg:flex\"><Bookmark size={13} strokeWidth={1.5} />Your personal link library</span></div>\n+          {restoring ? <span role=\"status\" className=\"flex items-center gap-2 text-xs text-muted\"><LoaderCircle size={15} className=\"animate-spin motion-reduce:animate-none\" />Opening your library…</span> : session ? (\n+            <div className=\"flex items-center gap-3 sm:gap-5\"><span className=\"flex items-center gap-2.5\"><span className=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#e7ecde] font-serif text-sm text-olive\">{session.username.slice(0, 1).toUpperCase()}</span><span className=\"max-w-28 truncate text-xs font-medium sm:max-w-48\">{session.username}</span></span><span className=\"h-5 w-px bg-line\" /><button disabled={signingOut} onClick={() => void signOut()} className=\"flex items-center gap-2 rounded-md p-1 text-xs text-muted hover:text-ink disabled:opacity-50\">{signingOut ? <LoaderCircle size={14} className=\"animate-spin motion-reduce:animate-none\" /> : <LogOut size={14} />}<span className=\"hidden sm:inline\">Sign out</span></button></div>\n+          ) : (\n+            <div className=\"flex items-center gap-4 sm:gap-6\"><button onClick={() => setAuthMode(\"login\")} className=\"rounded text-xs text-muted hover:text-ink\">Sign in</button><button onClick={() => setAuthMode(\"register\")} className=\"flex items-center gap-2 rounded-lg bg-olive px-3.5 py-2.5 text-xs font-medium text-white transition hover:bg-olive/90\">Make it yours<ArrowRight size={14} className=\"hidden sm:block\" /></button></div>\n+          )}\n+        </header>\n+        <main className=\"mx-auto max-w-[1320px] px-5 pb-8 pt-9 sm:px-9 sm:pt-11 xl:px-12\">\n+          {restoreError && <div role=\"alert\" className=\"mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800\"><span>{restoreError}</span><button onClick={() => setRestoreAttempt((current) => current + 1)} className=\"rounded font-medium underline underline-offset-2\">Retry session</button></div>}\n+          <section className=\"relative flex items-center justify-between gap-5\" aria-labelledby=\"welcome-heading\">\n+            <div className=\"relative z-10\">\n+              <span className=\"inline-flex items-center gap-1.5 rounded-full border border-[#e1e7d6] bg-[#f0f3e9] px-2.5 py-1 text-[10px] text-olive\"><Sparkles size={11} />A home for your good finds</span>\n+              <h1 id=\"welcome-heading\" className=\"mt-5 font-serif text-[39px] leading-[1.12] tracking-[-1.7px] sm:text-[49px] xl:text-[54px]\">Good links deserve<br />a place to live<span className=\"text-accent\">.</span></h1>\n+              <p className=\"mt-4 max-w-md text-[13px] leading-[1.9] text-muted\">Save what catches your eye. Come back when you're curious.<br className=\"hidden sm:block\" /> Your little corner of the internet, all in one place.</p>\n+            </div>\n+            <img src=\"/illustration.svg\" alt=\"\" className=\"mr-1 hidden w-[240px] shrink-0 lg:block xl:mr-5 xl:w-[285px]\" />\n+          </section>\n+          <section aria-label=\"Save a new link\" className=\"mb-11 mt-9\">\n+            <form onSubmit={addLink} className=\"flex items-center gap-2 rounded-xl border border-line bg-white p-2 shadow-[0_3px_10px_-5px_rgba(47,53,41,0.12)] sm:gap-3 sm:p-2.5\">\n+              <Link2 size={19} className=\"ml-2 shrink-0 text-muted/70 sm:ml-3\" strokeWidth={1.7} />\n+              <input id=\"link-url\" aria-label=\"Link to save\" aria-describedby={addError ? \"add-error\" : \"add-hint\"} inputMode=\"url\" autoComplete=\"url\" value={url} onChange={(event) => { setUrl(event.target.value); if (addError) setAddError(\"\"); }} disabled={adding || restoring} placeholder=\"Paste a link to keep for later…\" className=\"min-w-0 flex-1 rounded-md bg-transparent px-1 py-2 text-[13px] placeholder:text-muted/70 disabled:opacity-50\" />\n+              <button disabled={adding || restoring} className=\"flex min-w-[89px] items-center justify-center gap-2 rounded-lg bg-accent px-4 py-3 text-[12px] font-medium text-white transition hover:bg-[#cc694b] disabled:opacity-60 sm:min-w-[110px] sm:px-5\">{adding ? <LoaderCircle size={16} className=\"animate-spin motion-reduce:animate-none\" /> : <Plus size={17} />}{adding ? \"Saving…\" : \"Add link\"}</button>\n+            </form>\n+            {addError ? <p id=\"add-error\" role=\"alert\" className=\"mt-3 text-xs text-red-700\">{addError}</p> : <p id=\"add-hint\" className=\"mt-3 flex items-center gap-1.5 pl-1 text-[10px] text-muted/80\">{adding ? <><LoaderCircle size={11} className=\"animate-spin motion-reduce:animate-none\" />Fetching the page and putting together your preview…</> : <><ShieldCheck size={11} />{session ? \"Just paste a URL. We'll take care of the preview.\" : \"Your links stay private. Create a free account to start collecting.\"}</>}</p>}\n+          </section>\n+          <div id=\"library-section\" className=\"scroll-mt-8\">\n+            {session ? <Library key={session.token} session={session} revision={revision} onTotal={setTotal} notify={setNotice} /> : (\n+              <section aria-labelledby=\"inspiration-heading\">\n+                <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3\"><div className=\"flex items-center gap-3\"><h2 id=\"inspiration-heading\" className=\"text-[17px] font-semibold tracking-tight\">A little inspiration</h2><span className=\"rounded-md border border-line bg-sidebar px-2 py-0.5 text-[9px] tracking-wide text-muted\">A PEEK INSIDE</span></div><span className=\"flex items-center gap-1.5 text-[10px] text-muted\"><Globe2 size={12} />A big world of good finds</span></div>\n+                <p className=\"mb-5 text-[11px] text-muted\">The kind of links you'll be glad you kept. Here's how they'll look in your library.</p>\n+                <Inspiration />\n+                <div className=\"mt-7 flex flex-col items-start justify-between gap-4 rounded-xl border border-[#e2e7da] bg-[#f0f3e9] px-6 py-5 sm:flex-row sm:items-center\"><div className=\"flex items-center gap-4\"><span className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/80 text-olive\"><Bookmark size={19} strokeWidth={1.5} /></span><div><h3 className=\"font-serif text-xl tracking-tight\">Your next good find belongs here.</h3><p className=\"mt-1 text-[11px] text-muted\">Start a collection that's a little more you.</p></div></div><button onClick={() => setAuthMode(\"register\")} className=\"flex shrink-0 items-center gap-2 rounded-lg border border-olive/20 bg-white px-4 py-2.5 text-[11px] font-medium text-olive transition hover:bg-olive hover:text-white\">Create your library<ArrowRight size={14} /></button></div>\n+              </section>\n+            )}\n+          </div>\n+          <footer className=\"mt-10 flex items-center justify-between gap-4 border-t border-line pt-5 text-[10px] text-muted/75\"><span className=\"flex items-center gap-1.5\"><Leaf size={12} strokeWidth={1.4} />Collected with curiosity.</span><span>A little less lost in the tabs.</span></footer>\n+        </main>\n+      </div>\n+      {authMode && <AuthDialog key={authMode} initialMode={authMode} onClose={() => setAuthMode(null)} onSession={(next) => {\n+        storeToken(next.token);\n+        setSession(next);\n+        setRestoreError(\"\");\n+        setAuthMode(null);\n+        setNotice(url.trim() ? \"You're in. Add your link to make your first good find.\" : \"Welcome to your own little corner of the internet.\");\n+      }} />}\n+      {info && <Dialog title={info === \"how\" ? \"A link. A preview. A keeper.\" : \"A little more intentional.\"} onClose={() => setInfo(null)}>\n+        {info === \"how\" ? <div className=\"mt-6 space-y-6\">{[\n+          [\"01\", \"Find something good\", \"An article, a handy resource, or an idea you don't want to lose. Copy its web link.\"],\n+          [\"02\", \"Give it a home\", \"Paste the link and hit Add. We'll fetch the page's title, description, and image to build a little preview.\"],\n+          [\"03\", \"Come back, whenever\", \"Your library is private and saved between visits. Open a link, refresh its preview, or let it go when you're done.\"],\n+        ].map(([number, title, text]) => <div key={number} className=\"flex gap-4\"><span className=\"pt-1 font-serif text-xl text-olive/70\">{number}</span><div><h3 className=\"text-sm font-medium\">{title}</h3><p className=\"mt-2 text-xs leading-[1.8] text-muted\">{text}</p></div></div>)}</div> : <div className=\"mt-5 space-y-4 text-sm leading-[1.9] text-muted\"><p>The internet is full of wonderful things. It's also full of tabs you meant to come back to.</p><p>Marginal is a simple, quiet place to keep the links that matter to you. No feed, no followers, no noise. Just your curiosity, neatly collected.</p><p className=\"flex items-center gap-2 border-t border-line pt-4 text-xs text-olive\"><ShieldCheck size={15} />Only you can see and change your saved links.</p></div>}\n+        {!session && <button onClick={() => { setInfo(null); setAuthMode(\"register\"); }} className=\"mt-7 flex w-full items-center justify-center gap-2 rounded-lg bg-olive px-5 py-3 text-sm text-white hover:bg-olive/90\">Make it yours<ArrowRight size={15} /></button>}\n+      </Dialog>}\n+      {notice && <div role=\"status\" className=\"fixed bottom-5 left-5 right-5 z-[60] mx-auto flex w-fit max-w-[calc(100%-40px)] items-center gap-3 rounded-xl border border-line bg-white px-4 py-3 text-xs shadow-lg\"><Check size={16} className=\"shrink-0 text-olive\" /><span className=\"max-w-md leading-relaxed\">{notice}</span><button aria-label=\"Dismiss notification\" onClick={() => setNotice(\"\")} className=\"shrink-0 rounded p-1 text-muted hover:text-ink\"><X size={14} /></button></div>}\n+    </div>\n+  );\n+}\n","additions":188,"deletions":0},{"filePath":"/workspace/frontend/public/illustration.svg","relativePath":"frontend/public/illustration.svg","type":"add","patch":"Index: /workspace/frontend/public/illustration.svg\n===================================================================\n--- /workspace/frontend/public/illustration.svg\n+++ /workspace/frontend/public/illustration.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"265\" viewBox=\"0 0 320 265\"><ellipse cx=\"158\" cy=\"224\" rx=\"103\" ry=\"14\" fill=\"#e9ecdf\"/><circle cx=\"163\" cy=\"130\" r=\"107\" fill=\"#f0f2e9\"/><g transform=\"rotate(11 192 124)\"><rect x=\"122\" y=\"50\" width=\"134\" height=\"165\" rx=\"10\" fill=\"#e5e9dc\" stroke=\"#cbd4ba\" stroke-width=\"1.5\"/><re