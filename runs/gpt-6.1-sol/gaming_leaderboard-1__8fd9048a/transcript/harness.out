{"type":"tool_use","timestamp":1794315881531,"sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","part":{"type":"tool","tool":"apply_patch","callID":"call_7Lb6Sa3nnqw6bzktDtfHJvNv","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Update File: /workspace/backend/app.py\n@@\n-from datetime import datetime, timedelta, timezone\n+from datetime import UTC, datetime, timedelta\n@@\n-    return datetime.now(timezone.utc)\n+    return datetime.now(UTC)\n*** Update File: /workspace/frontend/src/App.tsx\n@@\n-      <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your personal best\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n+      <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your next challenge\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n*** Add File: /workspace/backend/test_app.py\n+import hashlib\n+import os\n+import sqlite3\n+import tempfile\n+import unittest\n+from datetime import UTC, datetime\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from backend.app import MAX_SCORE, create_app\n+\n+\n+class LeaderboardTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.addCleanup(self.directory.cleanup)\n+        self.db_path = str(Path(self.directory.name) / \"data\" / \"test.sqlite3\")\n+        self.environment = patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"test-admin-password\"})\n+        self.environment.start()\n+        self.addCleanup(self.environment.stop)\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.db_path})\n+        self.client = self.app.test_client()\n+\n+    def register(self, username=\"player\", password=\"password\"):\n+        return self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": password})\n+\n+    def login(self, username=\"player\", password=\"password\"):\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password})\n+        self.assertEqual(response.status_code, 200, response.json)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def player(self, username=\"player\"):\n+        self.assertEqual(self.register(username).status_code, 201)\n+        return self.login(username)\n+\n+    def submit(self, headers, score, **extra):\n+        response = self.client.post(\"/api/scores\", headers=headers, json={\"score\": score, **extra})\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def admin(self):\n+        return self.login(\"admin\", \"test-admin-password\")\n+\n+    def toggle(self, score_id, headers=None):\n+        return self.client.post(f\"/api/admin/scores/{score_id}/toggle\", headers=headers or self.admin())\n+\n+    def sql(self, query, parameters=()):\n+        with sqlite3.connect(self.db_path) as db:\n+            return db.execute(query, parameters).fetchall()\n+\n+    def test_health_and_empty_leaderboard(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/leaderboard\").json, {\"items\": [], \"total\": 0})\n+\n+    def test_register_login_and_me(self):\n+        response = self.register(\"ArcadeAce\", \"p\")\n+        self.assertEqual(response.status_code, 201)\n+        headers = self.login(\"arcadeace\", \"p\")\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=headers).json, {\"username\": \"ArcadeAce\", \"is_admin\": False})\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).json, {\"items\": [], \"best_score\": None})\n+\n+    def test_duplicate_and_reserved_usernames(self):\n+        self.register(\"Player\")\n+        for name in (\"player\", \"PLAYER\", \"admin\", \"ADMIN\"):\n+            with self.subTest(name=name):\n+                self.assertEqual(self.register(name).status_code, 409)\n+\n+    def test_invalid_credentials(self):\n+        for body in (None, [], {}, {\"username\": 1, \"password\": \"p\"}, {\"username\": \"a b\", \"password\": \"p\"}, {\"username\": \"p\", \"password\": \"\"}, {\"username\": \"p\", \"password\": 3}, {\"username\": \"x\" * 33, \"password\": \"p\"}, {\"username\": \"p\", \"password\": \"x\" * 257}):\n+            with self.subTest(body=body):\n+                self.assertEqual(self.client.post(\"/api/auth/register\", json=body).status_code, 400)\n+                self.assertEqual(self.client.post(\"/api/auth/login\", json=body).status_code, 400)\n+\n+    def test_bad_login_is_unauthorized(self):\n+        self.register()\n+        for username, password in ((\"player\", \"incorrect\"), (\"unknown\", \"password\"), (\"admin\", \"admin\")):\n+            self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password}).status_code, 401)\n+\n+    def test_passwords_and_tokens_are_hashed(self):\n+        self.player()\n+        password_hash = self.sql(\"SELECT password_hash FROM users WHERE username = 'player'\")[0][0]\n+        self.assertNotEqual(password_hash, \"password\")\n+        headers = self.login()\n+        token = headers[\"Authorization\"].split()[1]\n+        self.assertEqual(self.sql(\"SELECT COUNT(*) FROM sessions WHERE token_hash = ?\", (hashlib.sha256(token.encode()).hexdigest(),))[0][0], 1)\n+        self.assertEqual(self.sql(\"SELECT COUNT(*) FROM sessions WHERE token_hash = ?\", (token,))[0][0], 0)\n+\n+    def test_protected_routes_require_authentication(self):\n+        for headers in ({}, {\"Authorization\": \"Bearer wrong\"}, {\"Authorization\": \"Basic wrong\"}, {\"Authorization\": \"Bearer\"}):\n+            for method, path in ((\"get\", \"/api/scores\"), (\"post\", \"/api/scores\"), (\"get\", \"/api/admin/scores\"), (\"post\", \"/api/admin/scores/1/toggle\"), (\"get\", \"/api/auth/me\")):\n+                with self.subTest(headers=headers, path=path):\n+                    self.assertEqual(getattr(self.client, method)(path, headers=headers).status_code, 401)\n+\n+    def test_players_cannot_moderate(self):\n+        headers = self.player()\n+        self.assertEqual(self.client.get(\"/api/admin/scores\", headers=headers).status_code, 403)\n+        self.assertEqual(self.toggle(1, headers).status_code, 403)\n+\n+    def test_logout_and_expired_sessions(self):\n+        headers = self.player()\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=headers).status_code, 200)\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).status_code, 401)\n+        headers = self.login()\n+        self.sql(\"UPDATE sessions SET expires_at = '2000-01-01T00:00:00.000000Z'\")\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).status_code, 401)\n+\n+    def test_disabled_admin_and_password_rotation(self):\n+        old_headers = self.admin()\n+        with patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"\"}):\n+            disabled = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-password\"}).status_code, 401)\n+        self.assertEqual(disabled.get(\"/api/admin/scores\", headers=old_headers).status_code, 401)\n+        with patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"new-password\"}):\n+            rotated = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(rotated.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"new-password\"}).status_code, 200)\n+        self.assertEqual(rotated.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-password\"}).status_code, 401)\n+\n+    def test_unset_admin_password(self):\n+        with patch.dict(os.environ):\n+            os.environ.pop(\"ADMIN_PASSWORD\", None)\n+            disabled = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"admin\"}).status_code, 401)\n+\n+    def test_score_shape_ownership_and_server_timestamp(self):\n+        headers = self.player()\n+        score = self.submit(headers, 123, player=\"admin\", user_id=1, achieved_at=\"2000-01-01\", is_hidden=True)\n+        self.assertEqual(set(score), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\", \"rank\", \"personal_best\"})\n+        self.assertEqual(score[\"player\"], \"player\")\n+        self.assertEqual(score[\"rank\"], 1)\n+        self.assertTrue(score[\"personal_best\"])\n+        self.assertFalse(score[\"is_hidden\"])\n+        achieved = datetime.fromisoformat(score[\"achieved_at\"].replace(\"Z\", \"+00:00\"))\n+        self.assertLess(abs((datetime.now(UTC) - achieved).total_seconds()), 5)\n+\n+    def test_scores_validate_whole_non_negative_safe_numbers(self):\n+        headers = self.player()\n+        for value in (-1, 1.5, 1.0, True, False, \"100\", None, MAX_SCORE + 1, {}, []):\n+            with self.subTest(value=value):\n+                self.assertEqual(self.client.post(\"/api/scores\", headers=headers, json={\"score\": value}).status_code, 400)\n+        self.assertEqual(self.client.post(\"/api/scores\", headers=headers, json={}).status_code, 400)\n+        self.assertEqual(self.client.post(\"/api/scores\", headers=headers, data=\"not JSON\", content_type=\"application/json\").status_code, 400)\n+        self.assertTrue(self.submit(headers, 0)[\"personal_best\"])\n+        self.assertTrue(self.submit(headers, MAX_SCORE)[\"personal_best\"])\n+\n+    def test_personal_best_is_strictly_higher(self):\n+        headers = self.player()\n+        self.assertTrue(self.submit(headers, 100)[\"personal_best\"])\n+        self.assertFalse(self.submit(headers, 100)[\"personal_best\"])\n+        self.assertFalse(self.submit(headers, 50)[\"personal_best\"])\n+        self.assertTrue(self.submit(headers, 101)[\"personal_best\"])\n+\n+    def test_one_row_per_player_and_rank_of_player_best(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        self.submit(alice, 100)\n+        self.submit(alice, 200)\n+        self.submit(bob, 300)\n+        result = self.submit(alice, 1)\n+        self.assertEqual(result[\"rank\"], 2)\n+        board = self.client.get(\"/api/leaderboard\").json\n+        self.assertEqual(board[\"total\"], 2)\n+        self.assertEqual([(i[\"rank\"], i[\"player\"], i[\"score\"]) for i in board[\"items\"]], [(1, \"bob\", 300), (2, \"alice\", 200)])\n+        self.assertEqual(set(board[\"items\"][0]), {\"rank\", \"player\", \"score\", \"achieved_at\"})\n+\n+    def test_ties_use_earliest_achievement_then_id(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        fixed = datetime(2026, 11, 11, 12, tzinfo=UTC)\n+        with patch(\"backend.app.utc_now\", return_value=fixed):\n+            first = self.submit(alice, 100)\n+            self.submit(alice, 100)\n+            self.submit(bob, 100)\n+        board = self.client.get(\"/api/leaderboard\").json[\"items\"]\n+        self.assertEqual([item[\"player\"] for item in board], [\"alice\", \"bob\"])\n+        self.assertEqual(board[0][\"achieved_at\"], first[\"achieved_at\"])\n+\n+    def test_search_filters_after_ranking_and_total_before_limit(self):\n+        for name, value in ((\"alpha\", 300), (\"Alpine\", 200), (\"bravo\", 100)):\n+            self.submit(self.player(name), value)\n+        filtered = self.client.get(\"/api/leaderboard?player=AL&limit=1\").json\n+        self.assertEqual(filtered[\"total\"], 2)\n+        self.assertEqual(len(filtered[\"items\"]), 1)\n+        self.assertEqual(self.client.get(\"/api/leaderboard?player=bravo\").json[\"items\"][0][\"rank\"], 3)\n+        self.assertEqual(self.client.get(\"/api/leaderboard?player=%25\").json[\"total\"], 0)\n+\n+    def test_utc_period_boundaries_and_best_within_period(self):\n+        headers = self.player()\n+        fixed = datetime(2026, 11, 11, 12, tzinfo=UTC)\n+        values = [(900, \"2026-11-08T23:59:59.999999Z\"), (800, \"2026-11-09T00:00:00.000000Z\"), (700, \"2026-11-10T23:59:59.999999Z\"), (600, \"2026-11-11T00:00:00.000000Z\")]\n+        for value, achieved in values:\n+            submitted = self.submit(headers, value)\n+            self.sql(\"UPDATE scores SET achieved_at = ? WHERE id = ?\", (achieved, submitted[\"id\"]))\n+        with patch(\"backend.app.utc_now\", return_value=fixed):\n+            for period, expected in ((\"all\", 900), (\"week\", 800), (\"today\", 600)):\n+                with self.subTest(period=period):\n+                    self.assertEqual(self.client.get(f\"/api/leaderboard?period={period}\").json[\"items\"][0][\"score\"], expected)\n+\n+    def test_hidden_scores_excluded_from_all_rankings_and_bests(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        lower = self.submit(alice, 100)\n+        best = self.submit(alice, 300)\n+        self.submit(bob, 200)\n+        hidden = self.toggle(best[\"id\"])\n+        self.assertEqual(hidden.status_code, 200)\n+        self.assertTrue(hidden.json[\"is_hidden\"])\n+        for period in (\"all\", \"week\", \"today\"):\n+            board = self.client.get(f\"/api/leaderboard?period={period}\").json\n+            self.assertEqual([(i[\"player\"], i[\"score\"]) for i in board[\"items\"]], [(\"bob\", 200), (\"alice\", 100)])\n+        personal = self.client.get(\"/api/scores\", headers=alice).json\n+        self.assertEqual(personal[\"best_score\"], 100)\n+        self.assertTrue(personal[\"items\"][0][\"is_hidden\"])\n+        result = self.submit(alice, 150)\n+        self.assertTrue(result[\"personal_best\"])\n+        self.assertEqual(result[\"rank\"], 2)\n+        self.assertFalse(self.toggle(best[\"id\"]).json[\"is_hidden\"])\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=alice).json[\"best_score\"], 300)\n+        self.toggle(best[\"id\"])\n+        self.toggle(lower[\"id\"])\n+        self.toggle(result[\"id\"])\n+        self.assertIsNone(self.client.get(\"/api/scores\", headers=alice).json[\"best_score\"])\n+        self.assertEqual(self.client.get(\"/api/leaderboard\").json[\"total\"], 1)\n+\n+    def test_personal_submissions_newest_first_and_private(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        first = self.submit(alice, 500)\n+        second = self.submit(alice, 200)\n+        self.submit(bob, 900)\n+        data = self.client.get(\"/api/scores\", headers=alice).json\n+        self.assertEqual([item[\"id\"] for item in data[\"items\"]], [second[\"id\"], first[\"id\"]])\n+        self.assertEqual(data[\"best_score\"], 500)\n+        self.assertEqual(set(data[\"items\"][0]), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\"})\n+\n+    def test_admin_pagination_includes_hidden_scores(self):\n+        headers = self.player()\n+        scores = [self.submit(headers, value) for value in (100, 200, 300)]\n+        admin = self.admin()\n+        self.toggle(scores[1][\"id\"], admin)\n+        data = self.client.get(\"/api/admin/scores?page=2&page_size=2\", headers=admin).json\n+        self.assertEqual((data[\"total\"], data[\"page\"], data[\"page_size\"]), (3, 2, 2))\n+        self.assertEqual([i[\"id\"] for i in data[\"items\"]], [scores[0][\"id\"]])\n+        first_page = self.client.get(\"/api/admin/scores?page_size=2\", headers=admin).json\n+        self.assertTrue(first_page[\"items\"][1][\"is_hidden\"])\n+        self.assertEqual(self.client.get(\"/api/admin/scores?page=99\", headers=admin).json[\"items\"], [])\n+        self.assertEqual(self.toggle(99999, admin).status_code, 404)\n+\n+    def test_query_validation(self):\n+        for query in (\"period=invalid\", \"limit=0\", \"limit=-1\", \"limit=1.5\", \"limit=abc\", \"limit=1001\", \"player=\" + \"x\" * 33):\n+            self.assertEqual(self.client.get(\"/api/leaderboard?\" + query).status_code, 400)\n+        admin = self.admin()\n+        for query in (\"page=0\", \"page=-1\", \"page=1.5\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page_size=abc\"):\n+            self.assertEqual(self.client.get(\"/api/admin/scores?\" + query, headers=admin).status_code, 400)\n+\n+    def test_data_sessions_and_hidden_state_survive_restart(self):\n+        headers = self.player()\n+        score = self.submit(headers, 123)\n+        admin = self.admin()\n+        self.toggle(score[\"id\"], admin)\n+        restarted = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        data = restarted.get(\"/api/scores\", headers=headers).json\n+        self.assertEqual(data[\"items\"][0][\"score\"], 123)\n+        self.assertTrue(data[\"items\"][0][\"is_hidden\"])\n+        self.assertEqual(restarted.get(\"/api/admin/scores\", headers=admin).status_code, 200)\n+\n+    def test_unknown_api_routes_and_errors_are_json(self):\n+        for path in (\"/api/not-found\", \"/api\", \"/api/admin/scores/999/toggle\"):\n+            response = self.client.get(path)\n+            self.assertIn(response.status_code, (404, 405))\n+            self.assertEqual(response.content_type, \"application/json\")\n+            self.assertIn(\"error\", response.json)\n+        response = self.client.post(\"/api/scores\", headers=self.player(), data=\"x\" * 20000, content_type=\"application/json\")\n+        self.assertEqual(response.status_code, 413)\n+        self.assertEqual(response.content_type, \"application/json\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** Add File: /workspace/pyproject.toml\n+[tool.ruff]\n+target-version = \"py313\"\n+line-length = 100\n+\n+[tool.ruff.lint]\n+select = [\"E4\", \"E7\", \"E9\", \"F\", \"I\", \"UP\"]\n*** Update File: /workspace/README.md\n@@\n-# App\n+# Highscore\n+\n+A community game leaderboard built with Flask, React, TypeScript, Tailwind CSS and SQLite.\n+\n+## Run\n+\n+```sh\n+docker build -t highscore .\n+docker run --rm -p 8000:8000 -v \"$(pwd)/data:/app/data\" -e ADMIN_PASSWORD highscore\n+```\n+\n+Set `ADMIN_PASSWORD` in your environment before running to enable the reserved `admin` account. If it is unset or empty, admin sign-in is disabled. Changing or disabling the password invalidates existing admin sessions. There is no default password.\n+\n+For local development:\n+\n+```sh\n+python3.13 -m venv .venv\n+.venv/bin/pip install -r backend/requirements.txt -c backend/requirements.lock\n+npm --prefix frontend ci\n+npm --prefix frontend run build\n+.venv/bin/python backend/app.py\n+```\n+\n+Use `npm --prefix frontend run dev` in a second terminal for Vite hot reload; `/api` requests are proxied to port 8000.\n+\n+## Behavior\n+\n+- Registration creates an account; login returns a bearer token. Tokens expire after 30 days, are stored hashed in SQLite, and survive server restarts. `GET /api/auth/me` restores the current account and `POST /api/auth/logout` invalidates its token.\n+- Usernames are case-insensitively unique, 1–32 characters, using letters, numbers, `_`, `.` or `-`. Passwords are 1–256 characters and stored using scrypt hashing.\n+- Scores are non-negative integers up to `9007199254740991`. The server sets `achieved_at` in UTC. Only the authenticated account can own a submission.\n+- `period=all` (default), `week` and `today` select all time, the current week starting Monday at 00:00 UTC, and the current UTC day.\n+- Each player appears once, using their best visible score in that period. Higher scores rank first; ties go to the earliest achievement, then submission ID. Ranks are unique and do not change when searching.\n+- `player` is a case-insensitive substring filter. `limit` defaults to 50 (maximum 1000); leaderboard `total` counts matching players before the limit.\n+- A personal best is strictly higher than the player's previous visible all-time best, or their first visible score. A submission's `rank` is the player's all-time rank, even if that submission is lower than their best.\n+- Hidden scores remain in submission history and admin results, but are excluded from leaderboards, ranks and personal bests. With no visible scores, `best_score` is `null`.\n+- Admin pagination defaults to `page=1&page_size=50`; maximum page size is 100. All score histories are newest first.\n+- Validation errors return JSON with an `error` string. Protected requests return 401 without a valid bearer token; non-admin moderation requests return 403.\n+\n+## Checks\n+\n+```sh\n+.venv/bin/pip install ruff\n+.venv/bin/python -m unittest discover -s backend -p 'test_*.py' -v\n+.venv/bin/ruff check backend\n+.venv/bin/ruff format --check backend\n+npm --prefix frontend run lint\n+npm --prefix frontend run typecheck\n+npm --prefix frontend run build\n+```\n*** End Patch"},"output":"Success. Updated the following files:\nM backend/app.py\nM frontend/src/App.tsx\nA backend/test_app.py\nA pyproject.toml\nM README.md","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -2,9 +2,9 @@\n import os\n import re\n import secrets\n import sqlite3\n-from datetime import datetime, timedelta, timezone\n+from datetime import UTC, datetime, timedelta\n from functools import wraps\n from pathlib import Path\n \n from flask import Flask, current_app, g, request, send_from_directory\n@@ -55,9 +55,9 @@\n \"\"\"\n \n \n def utc_now():\n-    return datetime.now(timezone.utc)\n+    return datetime.now(UTC)\n \n \n def timestamp(value):\n     return value.isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -307,9 +307,9 @@\n </div></header>\n <main className=\"mx-auto max-w-[1200px] px-5 pb-12 sm:px-8\">\n   {sessionNotice && <div className=\"mt-5 flex items-center gap-3 rounded-xl border border-line bg-white p-4 text-xs text-muted\" role=\"status\"><span className=\"flex-1\">{sessionNotice}</span><button onClick={() => setAuthMode(\"login\")} className=\"font-semibold text-forest underline\">Sign in</button><button aria-label=\"Dismiss notification\" onClick={() => setSessionNotice(\"\")}><X size={15} /></button></div>}\n   <section className=\"flex items-center justify-between gap-8 py-10 sm:py-12\"><div><div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[0.16em] text-muted\"><span className=\"flex size-5 items-center justify-center rounded-md bg-lime\"><Gamepad2 size={13} className=\"text-forest\" /></span>A LITTLE COMPETITION. A LOT OF FUN.</div><h1 className=\"text-[44px] font-bold leading-[1.08] tracking-[-0.055em] sm:text-[58px]\">Good games.<br />Great scores<span className=\"text-[#91ae61]\">.</span></h1><p className=\"mt-5 max-w-md text-sm leading-6 text-muted\">Chase your personal best. Climb the ranks.<br className=\"hidden sm:block\" /> See how you stack up with the community.</p></div><HeroArtwork /></section>\n-  <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your personal best\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n+  <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your next challenge\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n   <div className=\"grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_310px]\"><Leaderboard user={user} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"register\")} /><PlayerPanel user={user} token={token} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"login\")} /></div>\n   {user?.is_admin && token && <AdminPanel token={token} refresh={refresh} onRefresh={doRefresh} />}\n   <section className=\"mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line px-6 py-5\"><div className=\"flex items-center gap-3\"><span className=\"flex size-9 items-center justify-center rounded-xl bg-white\"><Trophy size={18} strokeWidth={1.5} /></span><div><p className=\"text-xs font-semibold\">It's not just about the top spot.</p><p className=\"mt-1 text-[11px] text-muted\">It's about beating your last best. You've got this.</p></div></div><button onClick={() => setShowHelp(true)} className={`${button} text-xs text-muted hover:text-forest`}>The rules of the game<ArrowUpRight size={14} /></button></section>\n </main>\n\nIndex: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,274 @@\n+import hashlib\n+import os\n+import sqlite3\n+import tempfile\n+import unittest\n+from datetime import UTC, datetime\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from backend.app import MAX_SCORE, create_app\n+\n+\n+class LeaderboardTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.addCleanup(self.directory.cleanup)\n+        self.db_path = str(Path(self.directory.name) / \"data\" / \"test.sqlite3\")\n+        self.environment = patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"test-admin-password\"})\n+        self.environment.start()\n+        self.addCleanup(self.environment.stop)\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.db_path})\n+        self.client = self.app.test_client()\n+\n+    def register(self, username=\"player\", password=\"password\"):\n+        return self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": password})\n+\n+    def login(self, username=\"player\", password=\"password\"):\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password})\n+        self.assertEqual(response.status_code, 200, response.json)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def player(self, username=\"player\"):\n+        self.assertEqual(self.register(username).status_code, 201)\n+        return self.login(username)\n+\n+    def submit(self, headers, score, **extra):\n+        response = self.client.post(\"/api/scores\", headers=headers, json={\"score\": score, **extra})\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def admin(self):\n+        return self.login(\"admin\", \"test-admin-password\")\n+\n+    def toggle(self, score_id, headers=None):\n+        return self.client.post(f\"/api/admin/scores/{score_id}/toggle\", headers=headers or self.admin())\n+\n+    def sql(self, query, parameters=()):\n+        with sqlite3.connect(self.db_path) as db:\n+            return db.execute(query, parameters).fetchall()\n+\n+    def test_health_and_empty_leaderboard(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/leaderboard\").json, {\"items\": [], \"total\": 0})\n+\n+    def test_register_login_and_me(self):\n+        response = self.register(\"ArcadeAce\", \"p\")\n+        self.assertEqual(response.status_code, 201)\n+        headers = self.login(\"arcadeace\", \"p\")\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=headers).json, {\"username\": \"ArcadeAce\", \"is_admin\": False})\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).json, {\"items\": [], \"best_score\": None})\n+\n+    def test_duplicate_and_reserved_usernames(self):\n+        self.register(\"Player\")\n+        for name in (\"player\", \"PLAYER\", \"admin\", \"ADMIN\"):\n+            with self.subTest(name=name):\n+                self.assertEqual(self.register(name).status_code, 409)\n+\n+    def test_invalid_credentials(self):\n+        for body in (None, [], {}, {\"username\": 1, \"password\": \"p\"}, {\"username\": \"a b\", \"password\": \"p\"}, {\"username\": \"p\", \"password\": \"\"}, {\"username\": \"p\", \"password\": 3}, {\"username\": \"x\" * 33, \"password\": \"p\"}, {\"username\": \"p\", \"password\": \"x\" * 257}):\n+            with self.subTest(body=body):\n+                self.assertEqual(self.client.post(\"/api/auth/register\", json=body).status_code, 400)\n+                self.assertEqual(self.client.post(\"/api/auth/login\", json=body).status_code, 400)\n+\n+    def test_bad_login_is_unauthorized(self):\n+        self.register()\n+        for username, password in ((\"player\", \"incorrect\"), (\"unknown\", \"password\"), (\"admin\", \"admin\")):\n+            self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password}).status_code, 401)\n+\n+    def test_passwords_and_tokens_are_hashed(self):\n+        self.player()\n+        password_hash = self.sql(\"SELECT password_hash FROM users WHERE username = 'player'\")[0][0]\n+        self.assertNotEqual(password_hash, \"password\")\n+        headers = self.login()\n+        token = headers[\"Authorization\"].split()[1]\n+        self.assertEqual(self.sql(\"SELECT COUNT(*) FROM sessions WHERE token_hash = ?\", (hashlib.sha256(token.encode()).hexdigest(),))[0][0], 1)\n+        self.assertEqual(self.sql(\"SELECT COUNT(*) FROM sessions WHERE token_hash = ?\", (token,))[0][0], 0)\n+\n+    def test_protected_routes_require_authentication(self):\n+        for headers in ({}, {\"Authorization\": \"Bearer wrong\"}, {\"Authorization\": \"Basic wrong\"}, {\"Authorization\": \"Bearer\"}):\n+            for method, path in ((\"get\", \"/api/scores\"), (\"post\", \"/api/scores\"), (\"get\", \"/api/admin/scores\"), (\"post\", \"/api/admin/scores/1/toggle\"), (\"get\", \"/api/auth/me\")):\n+                with self.subTest(headers=headers, path=path):\n+                    self.assertEqual(getattr(self.client, method)(path, headers=headers).status_code, 401)\n+\n+    def test_players_cannot_moderate(self):\n+        headers = self.player()\n+        self.assertEqual(self.client.get(\"/api/admin/scores\", headers=headers).status_code, 403)\n+        self.assertEqual(self.toggle(1, headers).status_code, 403)\n+\n+    def test_logout_and_expired_sessions(self):\n+        headers = self.player()\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=headers).status_code, 200)\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).status_code, 401)\n+        headers = self.login()\n+        self.sql(\"UPDATE sessions SET expires_at = '2000-01-01T00:00:00.000000Z'\")\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).status_code, 401)\n+\n+    def test_disabled_admin_and_password_rotation(self):\n+        old_headers = self.admin()\n+        with patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"\"}):\n+            disabled = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-password\"}).status_code, 401)\n+        self.assertEqual(disabled.get(\"/api/admin/scores\", headers=old_headers).status_code, 401)\n+        with patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"new-password\"}):\n+            rotated = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(rotated.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"new-password\"}).status_code, 200)\n+        self.assertEqual(rotated.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-password\"}).status_code, 401)\n+\n+    def test_unset_admin_password(self):\n+        with patch.dict(os.environ):\n+            os.environ.pop(\"ADMIN_PASSWORD\", None)\n+            disabled = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"admin\"}).status_code, 401)\n+\n+    def test_score_shape_ownership_and_server_timestamp(self):\n+        headers = self.player()\n+        score = self.submit(headers, 123, player=\"admin\", user_id=1, achieved_at=\"2000-01-01\", is_hidden=True)\n+        self.assertEqual(set(score), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\", \"rank\", \"personal_best\"})\n+        self.assertEqual(score[\"player\"], \"player\")\n+        self.assertEqual(score[\"rank\"], 1)\n+        self.assertTrue(score[\"personal_best\"])\n+        self.assertFalse(score[\"is_hidden\"])\n+        achieved = datetime.fromisoformat(score[\"achieved_at\"].replace(\"Z\", \"+00:00\"))\n+        self.assertLess(abs((datetime.now(UTC) - achieved).total_seconds()), 5)\n+\n+    def test_scores_validate_whole_non_negative_safe_numbers(self):\n+        headers = self.player()\n+        for value in (-1, 1.5, 1.0, True, False, \"100\", None, MAX_SCORE + 1, {}, []):\n+            with self.subTest(value=value):\n+                self.assertEqual(self.client.post(\"/api/scores\", headers=headers, json={\"score\": value}).status_code, 400)\n+        self.assertEqual(self.client.post(\"/api/scores\", headers=headers, json={}).status_code, 400)\n+        self.assertEqual(self.client.post(\"/api/scores\", headers=headers, data=\"not JSON\", content_type=\"application/json\").status_code, 400)\n+        self.assertTrue(self.submit(headers, 0)[\"personal_best\"])\n+        self.assertTrue(self.submit(headers, MAX_SCORE)[\"personal_best\"])\n+\n+    def test_personal_best_is_strictly_higher(self):\n+        headers = self.player()\n+        self.assertTrue(self.submit(headers, 100)[\"personal_best\"])\n+        self.assertFalse(self.submit(headers, 100)[\"personal_best\"])\n+        self.assertFalse(self.submit(headers, 50)[\"personal_best\"])\n+        self.assertTrue(self.submit(headers, 101)[\"personal_best\"])\n+\n+    def test_one_row_per_player_and_rank_of_player_best(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        self.submit(alice, 100)\n+        self.submit(alice, 200)\n+        self.submit(bob, 300)\n+        result = self.submit(alice, 1)\n+        self.assertEqual(result[\"rank\"], 2)\n+        board = self.client.get(\"/api/leaderboard\").json\n+        self.assertEqual(board[\"total\"], 2)\n+        self.assertEqual([(i[\"rank\"], i[\"player\"], i[\"score\"]) for i in board[\"items\"]], [(1, \"bob\", 300), (2, \"alice\", 200)])\n+        self.assertEqual(set(board[\"items\"][0]), {\"rank\", \"player\", \"score\", \"achieved_at\"})\n+\n+    def test_ties_use_earliest_achievement_then_id(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        fixed = datetime(2026, 11, 11, 12, tzinfo=UTC)\n+        with patch(\"backend.app.utc_now\", return_value=fixed):\n+            first = self.submit(alice, 100)\n+            self.submit(alice, 100)\n+            self.submit(bob, 100)\n+        board = self.client.get(\"/api/leaderboard\").json[\"items\"]\n+        self.assertEqual([item[\"player\"] for item in board], [\"alice\", \"bob\"])\n+        self.assertEqual(board[0][\"achieved_at\"], first[\"achieved_at\"])\n+\n+    def test_search_filters_after_ranking_and_total_before_limit(self):\n+        for name, value in ((\"alpha\", 300), (\"Alpine\", 200), (\"bravo\", 100)):\n+            self.submit(self.player(name), value)\n+        filtered = self.client.get(\"/api/leaderboard?player=AL&limit=1\").json\n+        self.assertEqual(filtered[\"total\"], 2)\n+        self.assertEqual(len(filtered[\"items\"]), 1)\n+        self.assertEqual(self.client.get(\"/api/leaderboard?player=bravo\").json[\"items\"][0][\"rank\"], 3)\n+        self.assertEqual(self.client.get(\"/api/leaderboard?player=%25\").json[\"total\"], 0)\n+\n+    def test_utc_period_boundaries_and_best_within_period(self):\n+        headers = self.player()\n+        fixed = datetime(2026, 11, 11, 12, tzinfo=UTC)\n+        values = [(900, \"2026-11-08T23:59:59.999999Z\"), (800, \"2026-11-09T00:00:00.000000Z\"), (700, \"2026-11-10T23:59:59.999999Z\"), (600, \"2026-11-11T00:00:00.000000Z\")]\n+        for value, achieved in values:\n+            submitted = self.submit(headers, value)\n+            self.sql(\"UPDATE scores SET achieved_at = ? WHERE id = ?\", (achieved, submitted[\"id\"]))\n+        with patch(\"backend.app.utc_now\", return_value=fixed):\n+            for period, expected in ((\"all\", 900), (\"week\", 800), (\"today\", 600)):\n+                with self.subTest(period=period):\n+                    self.assertEqual(self.client.get(f\"/api/leaderboard?period={period}\").json[\"items\"][0][\"score\"], expected)\n+\n+    def test_hidden_scores_excluded_from_all_rankings_and_bests(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        lower = self.submit(alice, 100)\n+        best = self.submit(alice, 300)\n+        self.submit(bob, 200)\n+        hidden = self.toggle(best[\"id\"])\n+        self.assertEqual(hidden.status_code, 200)\n+        self.assertTrue(hidden.json[\"is_hidden\"])\n+        for period in (\"all\", \"week\", \"today\"):\n+            board = self.client.get(f\"/api/leaderboard?period={period}\").json\n+            self.assertEqual([(i[\"player\"], i[\"score\"]) for i in board[\"items\"]], [(\"bob\", 200), (\"alice\", 100)])\n+        personal = self.client.get(\"/api/scores\", headers=alice).json\n+        self.assertEqual(personal[\"best_score\"], 100)\n+        self.assertTrue(personal[\"items\"][0][\"is_hidden\"])\n+        result = self.submit(alice, 150)\n+        self.assertTrue(result[\"personal_best\"])\n+        self.assertEqual(result[\"rank\"], 2)\n+        self.assertFalse(self.toggle(best[\"id\"]).json[\"is_hidden\"])\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=alice).json[\"best_score\"], 300)\n+        self.toggle(best[\"id\"])\n+        self.toggle(lower[\"id\"])\n+        self.toggle(result[\"id\"])\n+        self.assertIsNone(self.client.get(\"/api/scores\", headers=alice).json[\"best_score\"])\n+        self.assertEqual(self.client.get(\"/api/leaderboard\").json[\"total\"], 1)\n+\n+    def test_personal_submissions_newest_first_and_private(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        first = self.submit(alice, 500)\n+        second = self.submit(alice, 200)\n+        self.submit(bob, 900)\n+        data = self.client.get(\"/api/scores\", headers=alice).json\n+        self.assertEqual([item[\"id\"] for item in data[\"items\"]], [second[\"id\"], first[\"id\"]])\n+        self.assertEqual(data[\"best_score\"], 500)\n+        self.assertEqual(set(data[\"items\"][0]), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\"})\n+\n+    def test_admin_pagination_includes_hidden_scores(self):\n+        headers = self.player()\n+        scores = [self.submit(headers, value) for value in (100, 200, 300)]\n+        admin = self.admin()\n+        self.toggle(scores[1][\"id\"], admin)\n+        data = self.client.get(\"/api/admin/scores?page=2&page_size=2\", headers=admin).json\n+        self.assertEqual((data[\"total\"], data[\"page\"], data[\"page_size\"]), (3, 2, 2))\n+        self.assertEqual([i[\"id\"] for i in data[\"items\"]], [scores[0][\"id\"]])\n+        first_page = self.client.get(\"/api/admin/scores?page_size=2\", headers=admin).json\n+        self.assertTrue(first_page[\"items\"][1][\"is_hidden\"])\n+        self.assertEqual(self.client.get(\"/api/admin/scores?page=99\", headers=admin).json[\"items\"], [])\n+        self.assertEqual(self.toggle(99999, admin).status_code, 404)\n+\n+    def test_query_validation(self):\n+        for query in (\"period=invalid\", \"limit=0\", \"limit=-1\", \"limit=1.5\", \"limit=abc\", \"limit=1001\", \"player=\" + \"x\" * 33):\n+            self.assertEqual(self.client.get(\"/api/leaderboard?\" + query).status_code, 400)\n+        admin = self.admin()\n+        for query in (\"page=0\", \"page=-1\", \"page=1.5\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page_size=abc\"):\n+            self.assertEqual(self.client.get(\"/api/admin/scores?\" + query, headers=admin).status_code, 400)\n+\n+    def test_data_sessions_and_hidden_state_survive_restart(self):\n+        headers = self.player()\n+        score = self.submit(headers, 123)\n+        admin = self.admin()\n+        self.toggle(score[\"id\"], admin)\n+        restarted = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        data = restarted.get(\"/api/scores\", headers=headers).json\n+        self.assertEqual(data[\"items\"][0][\"score\"], 123)\n+        self.assertTrue(data[\"items\"][0][\"is_hidden\"])\n+        self.assertEqual(restarted.get(\"/api/admin/scores\", headers=admin).status_code, 200)\n+\n+    def test_unknown_api_routes_and_errors_are_json(self):\n+        for path in (\"/api/not-found\", \"/api\", \"/api/admin/scores/999/toggle\"):\n+            response = self.client.get(path)\n+            self.assertIn(response.status_code, (404, 405))\n+            self.assertEqual(response.content_type, \"application/json\")\n+            self.assertIn(\"error\", response.json)\n+        response = self.client.post(\"/api/scores\", headers=self.player(), data=\"x\" * 20000, content_type=\"application/json\")\n+        self.assertEqual(response.status_code, 413)\n+        self.assertEqual(response.content_type, \"application/json\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\nIndex: /workspace/pyproject.toml\n===================================================================\n--- /workspace/pyproject.toml\n+++ /workspace/pyproject.toml\n@@ -0,0 +1,6 @@\n+[tool.ruff]\n+target-version = \"py313\"\n+line-length = 100\n+\n+[tool.ruff.lint]\n+select = [\"E4\", \"E7\", \"E9\", \"F\", \"I\", \"UP\"]\n\nIndex: /workspace/README.md\n===================================================================\n--- /workspace/README.md\n+++ /workspace/README.md\n@@ -1,6 +1,54 @@\n-# App\n+# Highscore\n \n+A community game leaderboard built with Flask, React, TypeScript, Tailwind CSS and SQLite.\n+\n+## Run\n+\n+```sh\n+docker build -t highscore .\n+docker run --rm -p 8000:8000 -v \"$(pwd)/data:/app/data\" -e ADMIN_PASSWORD highscore\n+```\n+\n+Set `ADMIN_PASSWORD` in your environment before running to enable the reserved `admin` account. If it is unset or empty, admin sign-in is disabled. Changing or disabling the password invalidates existing admin sessions. There is no default password.\n+\n+For local development:\n+\n+```sh\n+python3.13 -m venv .venv\n+.venv/bin/pip install -r backend/requirements.txt -c backend/requirements.lock\n+npm --prefix frontend ci\n+npm --prefix frontend run build\n+.venv/bin/python backend/app.py\n+```\n+\n+Use `npm --prefix frontend run dev` in a second terminal for Vite hot reload; `/api` requests are proxied to port 8000.\n+\n+## Behavior\n+\n+- Registration creates an account; login returns a bearer token. Tokens expire after 30 days, are stored hashed in SQLite, and survive server restarts. `GET /api/auth/me` restores the current account and `POST /api/auth/logout` invalidates its token.\n+- Usernames are case-insensitively unique, 1–32 characters, using letters, numbers, `_`, `.` or `-`. Passwords are 1–256 characters and stored using scrypt hashing.\n+- Scores are non-negative integers up to `9007199254740991`. The server sets `achieved_at` in UTC. Only the authenticated account can own a submission.\n+- `period=all` (default), `week` and `today` select all time, the current week starting Monday at 00:00 UTC, and the current UTC day.\n+- Each player appears once, using their best visible score in that period. Higher scores rank first; ties go to the earliest achievement, then submission ID. Ranks are unique and do not change when searching.\n+- `player` is a case-insensitive substring filter. `limit` defaults to 50 (maximum 1000); leaderboard `total` counts matching players before the limit.\n+- A personal best is strictly higher than the player's previous visible all-time best, or their first visible score. A submission's `rank` is the player's all-time rank, even if that submission is lower than their best.\n+- Hidden scores remain in submission history and admin results, but are excluded from leaderboards, ranks and personal bests. With no visible scores, `best_score` is `null`.\n+- Admin pagination defaults to `page=1&page_size=50`; maximum page size is 100. All score histories are newest first.\n+- Validation errors return JSON with an `error` string. Protected requests return 401 without a valid bearer token; non-admin moderation requests return 403.\n+\n+## Checks\n+\n+```sh\n+.venv/bin/pip install ruff\n+.venv/bin/python -m unittest discover -s backend -p 'test_*.py' -v\n+.venv/bin/ruff check backend\n+.venv/bin/ruff format --check backend\n+npm --prefix frontend run lint\n+npm --prefix frontend run typecheck\n+npm --prefix frontend run build\n+```\n+\n ## Run contract\n \n - The app is built from `Dockerfile` in this directory and the container listens on port 8000.\n - The API is served under `/api`. `GET /api/health` answers `{\"status\": \"ok\"}` once the app is ready.\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"update","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -2,9 +2,9 @@\n import os\n import re\n import secrets\n import sqlite3\n-from datetime import datetime, timedelta, timezone\n+from datetime import UTC, datetime, timedelta\n from functools import wraps\n from pathlib import Path\n \n from flask import Flask, current_app, g, request, send_from_directory\n@@ -55,9 +55,9 @@\n \"\"\"\n \n \n def utc_now():\n-    return datetime.now(timezone.utc)\n+    return datetime.now(UTC)\n \n \n def timestamp(value):\n     return value.isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n","additions":2,"deletions":2},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"update","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -307,9 +307,9 @@\n </div></header>\n <main className=\"mx-auto max-w-[1200px] px-5 pb-12 sm:px-8\">\n   {sessionNotice && <div className=\"mt-5 flex items-center gap-3 rounded-xl border border-line bg-white p-4 text-xs text-muted\" role=\"status\"><span className=\"flex-1\">{sessionNotice}</span><button onClick={() => setAuthMode(\"login\")} className=\"font-semibold text-forest underline\">Sign in</button><button aria-label=\"Dismiss notification\" onClick={() => setSessionNotice(\"\")}><X size={15} /></button></div>}\n   <section className=\"flex items-center justify-between gap-8 py-10 sm:py-12\"><div><div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[0.16em] text-muted\"><span className=\"flex size-5 items-center justify-center rounded-md bg-lime\"><Gamepad2 size={13} className=\"text-forest\" /></span>A LITTLE COMPETITION. A LOT OF FUN.</div><h1 className=\"text-[44px] font-bold leading-[1.08] tracking-[-0.055em] sm:text-[58px]\">Good games.<br />Great scores<span className=\"text-[#91ae61]\">.</span></h1><p className=\"mt-5 max-w-md text-sm leading-6 text-muted\">Chase your personal best. Climb the ranks.<br className=\"hidden sm:block\" /> See how you stack up with the community.</p></div><HeroArtwork /></section>\n-  <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your personal best\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n+  <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your next challenge\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n   <div className=\"grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_310px]\"><Leaderboard user={user} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"register\")} /><PlayerPanel user={user} token={token} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"login\")} /></div>\n   {user?.is_admin && token && <AdminPanel token={token} refresh={refresh} onRefresh={doRefresh} />}\n   <section className=\"mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line px-6 py-5\"><div className=\"flex items-center gap-3\"><span className=\"flex size-9 items-center justify-center rounded-xl bg-white\"><Trophy size={18} strokeWidth={1.5} /></span><div><p className=\"text-xs font-semibold\">It's not just about the top spot.</p><p className=\"mt-1 text-[11px] text-muted\">It's about beating your last best. You've got this.</p></div></div><button onClick={() => setShowHelp(true)} className={`${button} text-xs text-muted hover:text-forest`}>The rules of the game<ArrowUpRight size={14} /></button></section>\n </main>\n","additions":1,"deletions":1},{"filePath":"/workspace/backend/test_app.py","relativePath":"backend/test_app.py","type":"add","patch":"Index: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,274 @@\n+import hashlib\n+import os\n+import sqlite3\n+import tempfile\n+import unittest\n+from datetime import UTC, datetime\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from backend.app import MAX_SCORE, create_app\n+\n+\n+class LeaderboardTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.addCleanup(self.directory.cleanup)\n+        self.db_path = str(Path(self.directory.name) / \"data\" / \"test.sqlite3\")\n+        self.environment = patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"test-admin-password\"})\n+        self.environment.start()\n+        self.addCleanup(self.environment.stop)\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.db_path})\n+        self.client = self.app.test_client()\n+\n+    def register(self, username=\"player\", password=\"password\"):\n+        return self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": password})\n+\n+    def login(self, username=\"player\", password=\"password\"):\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password})\n+        self.assertEqual(response.status_code, 200, response.json)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def player(self, username=\"player\"):\n+        self.assertEqual(self.register(username).status_code, 201)\n+        return self.login(username)\n+\n+    def submit(self, headers, score, **extra):\n+        response = self.client.post(\"/api/scores\", headers=headers, json={\"score\": score, **extra})\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def admin(self):\n+        return self.login(\"admin\", \"test-admin-password\")\n+\n+    def toggle(self, score_id, headers=None):\n+        return self.client.post(f\"/api/admin/scores/{score_id}/toggle\", headers=headers or self.admin())\n+\n+    def sql(self, query, parameters=()):\n+        with sqlite3.connect(self.db_path) as db:\n+            return db.execute(query, parameters).fetchall()\n+\n+    def test_health_and_empty_leaderboard(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/leaderboard\").json, {\"items\": [], \"total\": 0})\n+\n+    def test_register_login_and_me(self):\n+        response = self.register(\"ArcadeAce\", \"p\")\n+        self.assertEqual(response.status_code, 201)\n+        headers = self.login(\"arcadeace\", \"p\")\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=headers).json, {\"username\": \"ArcadeAce\", \"is_admin\": False})\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).json, {\"items\": [], \"best_score\": None})\n+\n+    def test_duplicate_and_reserved_usernames(self):\n+        self.register(\"Player\")\n+        for name in (\"player\", \"PLAYER\", \"admin\", \"ADMIN\"):\n+            with self.subTest(name=name):\n+                self.assertEqual(self.register(name).status_code, 409)\n+\n+    def test_invalid_credentials(self):\n+        for body in (None, [], {}, {\"username\": 1, \"password\": \"p\"}, {\"username\": \"a b\", \"password\": \"p\"}, {\"username\": \"p\", \"password\": \"\"}, {\"username\": \"p\", \"password\": 3}, {\"username\": \"x\" * 33, \"password\": \"p\"}, {\"username\": \"p\", \"password\": \"x\" * 257}):\n+            with self.subTest(body=body):\n+                self.assertEqual(self.client.post(\"/api/auth/register\", json=body).status_code, 400)\n+                self.assertEqual(self.client.post(\"/api/auth/login\", json=body).status_code, 400)\n+\n+    def test_bad_login_is_unauthorized(self):\n+        self.register()\n+        for username, password in ((\"player\", \"incorrect\"), (\"unknown\", \"password\"), (\"admin\", \"admin\")):\n+            self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": password}).status_code, 401)\n+\n+    def test_passwords_and_tokens_are_hashed(self):\n+        self.player()\n+        password_hash = self.sql(\"SELECT password_hash FROM users WHERE username = 'player'\")[0][0]\n+        self.assertNotEqual(password_hash, \"password\")\n+        headers = self.login()\n+        token = headers[\"Authorization\"].split()[1]\n+        self.assertEqual(self.sql(\"SELECT COUNT(*) FROM sessions WHERE token_hash = ?\", (hashlib.sha256(token.encode()).hexdigest(),))[0][0], 1)\n+        self.assertEqual(self.sql(\"SELECT COUNT(*) FROM sessions WHERE token_hash = ?\", (token,))[0][0], 0)\n+\n+    def test_protected_routes_require_authentication(self):\n+        for headers in ({}, {\"Authorization\": \"Bearer wrong\"}, {\"Authorization\": \"Basic wrong\"}, {\"Authorization\": \"Bearer\"}):\n+            for method, path in ((\"get\", \"/api/scores\"), (\"post\", \"/api/scores\"), (\"get\", \"/api/admin/scores\"), (\"post\", \"/api/admin/scores/1/toggle\"), (\"get\", \"/api/auth/me\")):\n+                with self.subTest(headers=headers, path=path):\n+                    self.assertEqual(getattr(self.client, method)(path, headers=headers).status_code, 401)\n+\n+    def test_players_cannot_moderate(self):\n+        headers = self.player()\n+        self.assertEqual(self.client.get(\"/api/admin/scores\", headers=headers).status_code, 403)\n+        self.assertEqual(self.toggle(1, headers).status_code, 403)\n+\n+    def test_logout_and_expired_sessions(self):\n+        headers = self.player()\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=headers).status_code, 200)\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).status_code, 401)\n+        headers = self.login()\n+        self.sql(\"UPDATE sessions SET expires_at = '2000-01-01T00:00:00.000000Z'\")\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=headers).status_code, 401)\n+\n+    def test_disabled_admin_and_password_rotation(self):\n+        old_headers = self.admin()\n+        with patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"\"}):\n+            disabled = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-password\"}).status_code, 401)\n+        self.assertEqual(disabled.get(\"/api/admin/scores\", headers=old_headers).status_code, 401)\n+        with patch.dict(os.environ, {\"ADMIN_PASSWORD\": \"new-password\"}):\n+            rotated = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(rotated.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"new-password\"}).status_code, 200)\n+        self.assertEqual(rotated.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-password\"}).status_code, 401)\n+\n+    def test_unset_admin_password(self):\n+        with patch.dict(os.environ):\n+            os.environ.pop(\"ADMIN_PASSWORD\", None)\n+            disabled = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"admin\"}).status_code, 401)\n+\n+    def test_score_shape_ownership_and_server_timestamp(self):\n+        headers = self.player()\n+        score = self.submit(headers, 123, player=\"admin\", user_id=1, achieved_at=\"2000-01-01\", is_hidden=True)\n+        self.assertEqual(set(score), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\", \"rank\", \"personal_best\"})\n+        self.assertEqual(score[\"player\"], \"player\")\n+        self.assertEqual(score[\"rank\"], 1)\n+        self.assertTrue(score[\"personal_best\"])\n+        self.assertFalse(score[\"is_hidden\"])\n+        achieved = datetime.fromisoformat(score[\"achieved_at\"].replace(\"Z\", \"+00:00\"))\n+        self.assertLess(abs((datetime.now(UTC) - achieved).total_seconds()), 5)\n+\n+    def test_scores_validate_whole_non_negative_safe_numbers(self):\n+        headers = self.player()\n+        for value in (-1, 1.5, 1.0, True, False, \"100\", None, MAX_SCORE + 1, {}, []):\n+            with self.subTest(value=value):\n+                self.assertEqual(self.client.post(\"/api/scores\", headers=headers, json={\"score\": value}).status_code, 400)\n+        self.assertEqual(self.client.post(\"/api/scores\", headers=headers, json={}).status_code, 400)\n+        self.assertEqual(self.client.post(\"/api/scores\", headers=headers, data=\"not JSON\", content_type=\"application/json\").status_code, 400)\n+        self.assertTrue(self.submit(headers, 0)[\"personal_best\"])\n+        self.assertTrue(self.submit(headers, MAX_SCORE)[\"personal_best\"])\n+\n+    def test_personal_best_is_strictly_higher(self):\n+        headers = self.player()\n+        self.assertTrue(self.submit(headers, 100)[\"personal_best\"])\n+        self.assertFalse(self.submit(headers, 100)[\"personal_best\"])\n+        self.assertFalse(self.submit(headers, 50)[\"personal_best\"])\n+        self.assertTrue(self.submit(headers, 101)[\"personal_best\"])\n+\n+    def test_one_row_per_player_and_rank_of_player_best(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        self.submit(alice, 100)\n+        self.submit(alice, 200)\n+        self.submit(bob, 300)\n+        result = self.submit(alice, 1)\n+        self.assertEqual(result[\"rank\"], 2)\n+        board = self.client.get(\"/api/leaderboard\").json\n+        self.assertEqual(board[\"total\"], 2)\n+        self.assertEqual([(i[\"rank\"], i[\"player\"], i[\"score\"]) for i in board[\"items\"]], [(1, \"bob\", 300), (2, \"alice\", 200)])\n+        self.assertEqual(set(board[\"items\"][0]), {\"rank\", \"player\", \"score\", \"achieved_at\"})\n+\n+    def test_ties_use_earliest_achievement_then_id(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        fixed = datetime(2026, 11, 11, 12, tzinfo=UTC)\n+        with patch(\"backend.app.utc_now\", return_value=fixed):\n+            first = self.submit(alice, 100)\n+            self.submit(alice, 100)\n+            self.submit(bob, 100)\n+        board = self.client.get(\"/api/leaderboard\").json[\"items\"]\n+        self.assertEqual([item[\"player\"] for item in board], [\"alice\", \"bob\"])\n+        self.assertEqual(board[0][\"achieved_at\"], first[\"achieved_at\"])\n+\n+    def test_search_filters_after_ranking_and_total_before_limit(self):\n+        for name, value in ((\"alpha\", 300), (\"Alpine\", 200), (\"bravo\", 100)):\n+            self.submit(self.player(name), value)\n+        filtered = self.client.get(\"/api/leaderboard?player=AL&limit=1\").json\n+        self.assertEqual(filtered[\"total\"], 2)\n+        self.assertEqual(len(filtered[\"items\"]), 1)\n+        self.assertEqual(self.client.get(\"/api/leaderboard?player=bravo\").json[\"items\"][0][\"rank\"], 3)\n+        self.assertEqual(self.client.get(\"/api/leaderboard?player=%25\").json[\"total\"], 0)\n+\n+    def test_utc_period_boundaries_and_best_within_period(self):\n+        headers = self.player()\n+        fixed = datetime(2026, 11, 11, 12, tzinfo=UTC)\n+        values = [(900, \"2026-11-08T23:59:59.999999Z\"), (800, \"2026-11-09T00:00:00.000000Z\"), (700, \"2026-11-10T23:59:59.999999Z\"), (600, \"2026-11-11T00:00:00.000000Z\")]\n+        for value, achieved in values:\n+            submitted = self.submit(headers, value)\n+            self.sql(\"UPDATE scores SET achieved_at = ? WHERE id = ?\", (achieved, submitted[\"id\"]))\n+        with patch(\"backend.app.utc_now\", return_value=fixed):\n+            for period, expected in ((\"all\", 900), (\"week\", 800), (\"today\", 600)):\n+                with self.subTest(period=period):\n+                    self.assertEqual(self.client.get(f\"/api/leaderboard?period={period}\").json[\"items\"][0][\"score\"], expected)\n+\n+    def test_hidden_scores_excluded_from_all_rankings_and_bests(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        lower = self.submit(alice, 100)\n+        best = self.submit(alice, 300)\n+        self.submit(bob, 200)\n+        hidden = self.toggle(best[\"id\"])\n+        self.assertEqual(hidden.status_code, 200)\n+        self.assertTrue(hidden.json[\"is_hidden\"])\n+        for period in (\"all\", \"week\", \"today\"):\n+            board = self.client.get(f\"/api/leaderboard?period={period}\").json\n+            self.assertEqual([(i[\"player\"], i[\"score\"]) for i in board[\"items\"]], [(\"bob\", 200), (\"alice\", 100)])\n+        personal = self.client.get(\"/api/scores\", headers=alice).json\n+        self.assertEqual(personal[\"best_score\"], 100)\n+        self.assertTrue(personal[\"items\"][0][\"is_hidden\"])\n+        result = self.submit(alice, 150)\n+        self.assertTrue(result[\"personal_best\"])\n+        self.assertEqual(result[\"rank\"], 2)\n+        self.assertFalse(self.toggle(best[\"id\"]).json[\"is_hidden\"])\n+        self.assertEqual(self.client.get(\"/api/scores\", headers=alice).json[\"best_score\"], 300)\n+        self.toggle(best[\"id\"])\n+        self.toggle(lower[\"id\"])\n+        self.toggle(result[\"id\"])\n+        self.assertIsNone(self.client.get(\"/api/scores\", headers=alice).json[\"best_score\"])\n+        self.assertEqual(self.client.get(\"/api/leaderboard\").json[\"total\"], 1)\n+\n+    def test_personal_submissions_newest_first_and_private(self):\n+        alice, bob = self.player(\"alice\"), self.player(\"bob\")\n+        first = self.submit(alice, 500)\n+        second = self.submit(alice, 200)\n+        self.submit(bob, 900)\n+        data = self.client.get(\"/api/scores\", headers=alice).json\n+        self.assertEqual([item[\"id\"] for item in data[\"items\"]], [second[\"id\"], first[\"id\"]])\n+        self.assertEqual(data[\"best_score\"], 500)\n+        self.assertEqual(set(data[\"items\"][0]), {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\"})\n+\n+    def test_admin_pagination_includes_hidden_scores(self):\n+        headers = self.player()\n+        scores = [self.submit(headers, value) for value in (100, 200, 300)]\n+        admin = self.admin()\n+        self.toggle(scores[1][\"id\"], admin)\n+        data = self.client.get(\"/api/admin/scores?page=2&page_size=2\", headers=admin).json\n+        self.assertEqual((data[\"total\"], data[\"page\"], data[\"page_size\"]), (3, 2, 2))\n+        self.assertEqual([i[\"id\"] for i in data[\"items\"]], [scores[0][\"id\"]])\n+        first_page = self.client.get(\"/api/admin/scores?page_size=2\", headers=admin).json\n+        self.assertTrue(first_page[\"items\"][1][\"is_hidden\"])\n+        self.assertEqual(self.client.get(\"/api/admin/scores?page=99\", headers=admin).json[\"items\"], [])\n+        self.assertEqual(self.toggle(99999, admin).status_code, 404)\n+\n+    def test_query_validation(self):\n+        for query in (\"period=invalid\", \"limit=0\", \"limit=-1\", \"limit=1.5\", \"limit=abc\", \"limit=1001\", \"player=\" + \"x\" * 33):\n+            self.assertEqual(self.client.get(\"/api/leaderboard?\" + query).status_code, 400)\n+        admin = self.admin()\n+        for query in (\"page=0\", \"page=-1\", \"page=1.5\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page_size=abc\"):\n+            self.assertEqual(self.client.get(\"/api/admin/scores?\" + query, headers=admin).status_code, 400)\n+\n+    def test_data_sessions_and_hidden_state_survive_restart(self):\n+        headers = self.player()\n+        score = self.submit(headers, 123)\n+        admin = self.admin()\n+        self.toggle(score[\"id\"], admin)\n+        restarted = create_app({\"TESTING\": True, \"DATABASE\": self.db_path}).test_client()\n+        data = restarted.get(\"/api/scores\", headers=headers).json\n+        self.assertEqual(data[\"items\"][0][\"score\"], 123)\n+        self.assertTrue(data[\"items\"][0][\"is_hidden\"])\n+        self.assertEqual(restarted.get(\"/api/admin/scores\", headers=admin).status_code, 200)\n+\n+    def test_unknown_api_routes_and_errors_are_json(self):\n+        for path in (\"/api/not-found\", \"/api\", \"/api/admin/scores/999/toggle\"):\n+            response = self.client.get(path)\n+            self.assertIn(response.status_code, (404, 405))\n+            self.assertEqual(response.content_type, \"application/json\")\n+            self.assertIn(\"error\", response.json)\n+        response = self.client.post(\"/api/scores\", headers=self.player(), data=\"x\" * 20000, content_type=\"application/json\")\n+        self.assertEqual(response.status_code, 413)\n+        self.assertEqual(response.content_type, \"application/json\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":274,"deletions":0},{"filePath":"/workspace/pyproject.toml","relativePath":"pyproject.toml","type":"add","patch":"Index: /workspace/pyproject.toml\n===================================================================\n--- /workspace/pyproject.toml\n+++ /workspace/pyproject.toml\n@@ -0,0 +1,6 @@\n+[tool.ruff]\n+target-version = \"py313\"\n+line-length = 100\n+\n+[tool.ruff.lint]\n+select = [\"E4\", \"E7\", \"E9\", \"F\", \"I\", \"UP\"]\n","additions":6,"deletions":0},{"filePath":"/workspace/README.md","relativePath":"README.md","type":"update","patch":"Index: /workspace/README.md\n===================================================================\n--- /workspace/README.md\n+++ /workspace/README.md\n@@ -1,6 +1,54 @@\n-# App\n+# Highscore\n \n+A community game leaderboard built with Flask, React, TypeScript, Tailwind CSS and SQLite.\n+\n+## Run\n+\n+```sh\n+docker build -t highscore .\n+docker run --rm -p 8000:8000 -v \"$(pwd)/data:/app/data\" -e ADMIN_PASSWORD highscore\n+```\n+\n+Set `ADMIN_PASSWORD` in your environment before running to enable the reserved `admin` account. If it is unset or empty, admin sign-in is disabled. Changing or disabling the password invalidates existing admin sessions. There is no default password.\n+\n+For local development:\n+\n+```sh\n+python3.13 -m venv .venv\n+.venv/bin/pip install -r backend/requirements.txt -c backend/requirements.lock\n+npm --prefix frontend ci\n+npm --prefix frontend run build\n+.venv/bin/python backend/app.py\n+```\n+\n+Use `npm --prefix frontend run dev` in a second terminal for Vite hot reload; `/api` requests are proxied to port 8000.\n+\n+## Behavior\n+\n+- Registration creates an account; login returns a bearer token. Tokens expire after 30 days, are stored hashed in SQLite, and survive server restarts. `GET /api/auth/me` restores the current account and `POST /api/auth/logout` invalidates its token.\n+- Usernames are case-insensitively unique, 1–32 characters, using letters, numbers, `_`, `.` or `-`. Passwords are 1–256 characters and stored using scrypt hashing.\n+- Scores are non-negative integers up to `9007199254740991`. The server sets `achieved_at` in UTC. Only the authenticated account can own a submission.\n+- `period=all` (default), `week` and `today` select all time, the current week starting Monday at 00:00 UTC, and the current UTC day.\n+- Each player appears once, using their best visible score in that period. Higher scores rank first; ties go to the earliest achievement, then submission ID. Ranks are unique and do not change when searching.\n+- `player` is a case-insensitive substring filter. `limit` defaults to 50 (maximum 1000); leaderboard `total` counts matching players before the limit.\n+- A personal best is strictly higher than the player's previous visible all-time best, or their first visible score. A submission's `rank` is the player's all-time rank, even if that submission is lower than their best.\n+- Hidden scores remain in submission history and admin results, but are excluded from leaderboards, ranks and personal bests. With no visible scores, `best_score` is `null`.\n+- Admin pagination defaults to `page=1&page_size=50`; maximum page size is 100. All score histories are newest first.\n+- Validation errors return JSON with an `error` string. Protected requests return 401 without a valid bearer token; non-admin moderation requests return 403.\n+\n+## Checks\n+\n+```sh\n+.venv/bin/pip install ruff\n+.venv/bin/python -m unittest discover -s backend -p 'test_*.py' -v\n+.venv/bin/ruff check backend\n+.venv/bin/ruff format --check backend\n+npm --prefix frontend run lint\n+npm --prefix frontend run typecheck\n+npm --prefix frontend run build\n+```\n+\n ## Run contract\n \n - The app is built from `Dockerfile` in this directory and the container listens on port 8000.\n - The API is served under `/api`. `GET /api/health` answers `{\"status\": \"ok\"}` once the app is ready.\n","additions":49,"deletions":1}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM backend/app.py\nM frontend/src/App.tsx\nA backend/test_app.py\nA pyproject.toml\nM README.md","time":{"start":1794315881427,"end":1794315881485}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.summary","summary":"**Implementing front-end tests**\n\nI","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" need","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" to","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" visually","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" verify","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" and","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" ideally","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" implement","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" tests","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" with","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" a","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" Java","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":"Script","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" script","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" under","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" frontend","format":"azure-opena