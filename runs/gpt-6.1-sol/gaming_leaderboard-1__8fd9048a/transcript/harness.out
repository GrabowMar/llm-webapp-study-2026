{"type":"tool_use","timestamp":1794316900972,"sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","part":{"type":"tool","tool":"read","callID":"call_Hpz4lHhTUg004MPj1fl6AAIy","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","limit":370},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: import hashlib\n2: import os\n3: import re\n4: import secrets\n5: import sqlite3\n6: from datetime import UTC, datetime, timedelta\n7: from functools import wraps\n8: from pathlib import Path\n9: \n10: from flask import Flask, current_app, g, request, send_from_directory\n11: from werkzeug.exceptions import HTTPException\n12: from werkzeug.security import check_password_hash, generate_password_hash\n13: \n14: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n15: MAX_SCORE = 9_007_199_254_740_991\n16: \n17: SCHEMA = \"\"\"\n18: CREATE TABLE IF NOT EXISTS users (\n19:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n20:     username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n21:     password_hash TEXT NOT NULL,\n22:     is_admin INTEGER NOT NULL DEFAULT 0 CHECK (is_admin IN (0, 1))\n23: );\n24: CREATE TABLE IF NOT EXISTS sessions (\n25:     token_hash TEXT PRIMARY KEY,\n26:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n27:     expires_at TEXT NOT NULL\n28: );\n29: CREATE TABLE IF NOT EXISTS scores (\n30:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n31:     user_id INTEGER NOT NULL REFERENCES users(id),\n32:     score INTEGER NOT NULL CHECK (score >= 0),\n33:     achieved_at TEXT NOT NULL,\n34:     is_hidden INTEGER NOT NULL DEFAULT 0 CHECK (is_hidden IN (0, 1))\n35: );\n36: CREATE INDEX IF NOT EXISTS scores_player ON scores(user_id, achieved_at DESC, id DESC);\n37: CREATE INDEX IF NOT EXISTS scores_visible ON scores(is_hidden, achieved_at, score DESC);\n38: CREATE INDEX IF NOT EXISTS sessions_expiration ON sessions(expires_at);\n39: \"\"\"\n40: \n41: RANKING = \"\"\"\n42: WITH player_scores AS (\n43:     SELECT s.*, u.username AS player,\n44:            ROW_NUMBER() OVER (\n45:                PARTITION BY s.user_id\n46:                ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\n47:            ) AS best\n48:     FROM scores s JOIN users u ON u.id = s.user_id\n49:     WHERE s.is_hidden = 0 AND s.achieved_at >= ?\n50: ), ranked AS (\n51:     SELECT user_id, player, score, achieved_at,\n52:            ROW_NUMBER() OVER (ORDER BY score DESC, achieved_at ASC, id ASC) AS rank\n53:     FROM player_scores WHERE best = 1\n54: )\n55: \"\"\"\n56: \n57: \n58: def utc_now():\n59:     return datetime.now(UTC)\n60: \n61: \n62: def timestamp(value):\n63:     return value.isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n64: \n65: \n66: def connect_database(path):\n67:     connection = sqlite3.connect(path, timeout=30)\n68:     connection.row_factory = sqlite3.Row\n69:     connection.execute(\"PRAGMA foreign_keys = ON\")\n70:     return connection\n71: \n72: \n73: def database():\n74:     if \"db\" not in g:\n75:         g.db = connect_database(current_app.config[\"DATABASE\"])\n76:     return g.db\n77: \n78: \n79: def error(message, status=400):\n80:     return {\"error\": message}, status\n81: \n82: \n83: def json_body():\n84:     body = request.get_json(silent=True)\n85:     if not isinstance(body, dict):\n86:         return None\n87:     return body\n88: \n89: \n90: def credentials(body):\n91:     if body is None:\n92:         return None\n93:     username, password = body.get(\"username\"), body.get(\"password\")\n94:     if not isinstance(username, str) or not isinstance(password, str):\n95:         return None\n96:     username = username.strip()\n97:     if not re.fullmatch(r\"[A-Za-z0-9_.-]{1,32}\", username):\n98:         return None\n99:     if not 1 <= len(password) <= 256:\n100:         return None\n101:     return username, password\n102: \n103: \n104: def authenticated(admin=False):\n105:     def decorator(view):\n106:         @wraps(view)\n107:         def wrapped(*args, **kwargs):\n108:             parts = request.headers.get(\"Authorization\", \"\").split()\n109:             if len(parts) != 2 or parts[0].lower() != \"bearer\":\n110:                 return error(\"Sign in to continue.\", 401)\n111:             token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n112:             user = (\n113:                 database()\n114:                 .execute(\n115:                     \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n116:                     \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n117:                     (token_hash, timestamp(utc_now())),\n118:                 )\n119:                 .fetchone()\n120:             )\n121:             if user is None or (user[\"is_admin\"] and not user[\"password_hash\"]):\n122:                 return error(\"Your session is invalid or expired. Please sign in again.\", 401)\n123:             if admin and not user[\"is_admin\"]:\n124:                 return error(\"Admin access is required.\", 403)\n125:             g.user = user\n126:             g.token_hash = token_hash\n127:             return view(*args, **kwargs)\n128: \n129:         return wrapped\n130: \n131:     return decorator\n132: \n133: \n134: def score_object(row):\n135:     return {\n136:         \"id\": row[\"id\"],\n137:         \"score\": row[\"score\"],\n138:         \"achieved_at\": row[\"achieved_at\"],\n139:         \"is_hidden\": bool(row[\"is_hidden\"]),\n140:         \"player\": row[\"player\"],\n141:     }\n142: \n143: \n144: def get_score(score_id):\n145:     return (\n146:         database()\n147:         .execute(\n148:             \"SELECT s.*, u.username AS player FROM scores s \"\n149:             \"JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n150:             (score_id,),\n151:         )\n152:         .fetchone()\n153:     )\n154: \n155: \n156: def integer_param(name, default, maximum):\n157:     value = request.args.get(name, str(default))\n158:     if not re.fullmatch(r\"[0-9]{1,10}\", value):\n159:         return None\n160:     number = int(value)\n161:     return number if 1 <= number <= maximum else None\n162: \n163: \n164: def create_app(config=None):\n165:     app = Flask(__name__, static_folder=None)\n166:     app.config.from_mapping(\n167:         DATABASE=str(Path.cwd() / \"data\" / \"leaderboard.sqlite3\"),\n168:         MAX_CONTENT_LENGTH=16 * 1024,\n169:     )\n170:     if config:\n171:         app.config.update(config)\n172: \n173:     db_path = Path(app.config[\"DATABASE\"])\n174:     db_path.parent.mkdir(parents=True, exist_ok=True)\n175:     db = connect_database(str(db_path))\n176:     try:\n177:         db.execute(\"PRAGMA journal_mode = WAL\")\n178:         db.executescript(SCHEMA)\n179:         db.execute(\"BEGIN IMMEDIATE\")\n180:         admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n181:         admin = db.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n182:         if admin is None:\n183:             db.execute(\n184:                 \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n185:                 (generate_password_hash(admin_password) if admin_password else \"\",),\n186:             )\n187:         elif not admin_password or not check_password_hash(admin[\"password_hash\"], admin_password):\n188:             db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n189:             db.execute(\n190:                 \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n191:                 (generate_password_hash(admin_password) if admin_password else \"\", admin[\"id\"]),\n192:             )\n193:         db.commit()\n194:     finally:\n195:         db.close()\n196: \n197:     @app.teardown_appcontext\n198:     def close_database(exception=None):\n199:         db = g.pop(\"db\", None)\n200:         if db is not None:\n201:             db.close()\n202: \n203:     @app.errorhandler(HTTPException)\n204:     def handle_http_error(exception):\n205:         if request.path.startswith(\"/api\"):\n206:             return error(exception.description, exception.code)\n207:         return exception\n208: \n209:     @app.after_request\n210:     def response_headers(response):\n211:         response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n212:         response.headers[\"Referrer-Policy\"] = \"same-origin\"\n213:         response.headers[\"X-Frame-Options\"] = \"DENY\"\n214:         if request.path.startswith(\"/api\"):\n215:             response.headers[\"Cache-Control\"] = \"no-store\"\n216:         return response\n217: \n218:     @app.get(\"/api/health\")\n219:     def health():\n220:         return {\"status\": \"ok\"}\n221: \n222:     @app.post(\"/api/auth/register\")\n223:     def register():\n224:         account = credentials(json_body())\n225:         if account is None:\n226:             return error(\n227:                 \"Use a 1–32 character username (letters, numbers, _, . or -) and a password of 1–256 characters.\"\n228:             )\n229:         username, password = account\n230:         if username.lower() == \"admin\":\n231:             return error(\"This username is reserved.\", 409)\n232:         db = database()\n233:         try:\n234:             db.execute(\n235:                 \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n236:                 (username, generate_password_hash(password)),\n237:             )\n238:             db.commit()\n239:         except sqlite3.IntegrityError:\n240:             db.rollback()\n241:             return error(\"That username is already taken.\", 409)\n242:         return {\"username\": username}, 201\n243: \n244:     @app.post(\"/api/auth/login\")\n245:     def login():\n246:         account = credentials(json_body())\n247:         if account is None:\n248:             return error(\"Enter a valid username and password.\")\n249:         username, password = account\n250:         db = database()\n251:         user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n252:         password_hash = (\n253:             user[\"password_hash\"]\n254:             if user and user[\"password_hash\"]\n255:             else app.config[\"DUMMY_PASSWORD_HASH\"]\n256:         )\n257:         valid_password = check_password_hash(password_hash, password)\n258:         if user is None or not user[\"password_hash\"] or not valid_password:\n259:             return error(\"Incorrect username or password.\", 401)\n260:         token = secrets.token_urlsafe(32)\n261:         db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(utc_now()),))\n262:         db.execute(\n263:             \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n264:             (\n265:                 hashlib.sha256(token.encode()).hexdigest(),\n266:                 user[\"id\"],\n267:                 timestamp(utc_now() + timedelta(days=30)),\n268:             ),\n269:         )\n270:         db.commit()\n271:         return {\"token\": token}\n272: \n273:     @app.get(\"/api/auth/me\")\n274:     @authenticated()\n275:     def me():\n276:         return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n277: \n278:     @app.post(\"/api/auth/logout\")\n279:     @authenticated()\n280:     def logout():\n281:         database().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n282:         database().commit()\n283:         return {\"status\": \"ok\"}\n284: \n285:     @app.get(\"/api/leaderboard\")\n286:     def leaderboard():\n287:         period = request.args.get(\"period\", \"all\")\n288:         now = utc_now()\n289:         day = now.replace(hour=0, minute=0, second=0, microsecond=0)\n290:         if period in (\"all\", \"all_time\", \"all-time\"):\n291:             cutoff = \"\"\n292:         elif period in (\"week\", \"weekly\"):\n293:             cutoff = timestamp(day - timedelta(days=day.weekday()))\n294:         elif period in (\"today\", \"day\", \"daily\"):\n295:             cutoff = timestamp(day)\n296:         else:\n297:             return error(\"Period must be all, week or today.\")\n298:         limit = integer_param(\"limit\", 50, 1000)\n299:         if limit is None:\n300:             return error(\"Limit must be an integer between 1 and 1000.\")\n301:         player = request.args.get(\"player\", \"\").strip()\n302:         if len(player) > 32:\n303:             return error(\"Player search must be 32 characters or fewer.\")\n304:         db = database()\n305:         items = db.execute(\n306:             RANKING + \"SELECT rank, player, score, achieved_at FROM ranked \"\n307:             \"WHERE instr(lower(player), lower(?)) > 0 ORDER BY rank LIMIT ?\",\n308:             (cutoff, player, limit),\n309:         ).fetchall()\n310:         total = db.execute(\n311:             RANKING + \"SELECT COUNT(*) FROM ranked WHERE instr(lower(player), lower(?)) > 0\",\n312:             (cutoff, player),\n313:         ).fetchone()[0]\n314:         return {\"items\": [dict(row) for row in items], \"total\": total}\n315: \n316:     @app.post(\"/api/scores\")\n317:     @authenticated()\n318:     def submit_score():\n319:         body = json_body()\n320:         value = body.get(\"score\") if body is not None else None\n321:         if type(value) is not int or not 0 <= value <= MAX_SCORE:\n322:             return error(f\"Score must be a whole number between 0 and {MAX_SCORE}.\")\n323:         db = database()\n324:         db.execute(\"BEGIN IMMEDIATE\")\n325:         previous_best = db.execute(\n326:             \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n327:         ).fetchone()[0]\n328:         cursor = db.execute(\n329:             \"INSERT INTO scores (user_id, score, achieved_at) VALUES (?, ?, ?)\",\n330:             (g.user[\"id\"], value, timestamp(utc_now())),\n331:         )\n332:         result = score_object(get_score(cursor.lastrowid))\n333:         result[\"rank\"] = db.execute(\n334:             RANKING + \"SELECT rank FROM ranked WHERE user_id = ?\", (\"\", g.user[\"id\"])\n335:         ).fetchone()[0]\n336:         result[\"personal_best\"] = previous_best is None or value > previous_best\n337:         db.commit()\n338:         return result, 201\n339: \n340:     @app.get(\"/api/scores\")\n341:     @authenticated()\n342:     def personal_scores():\n343:         db = database()\n344:         items = db.execute(\n345:             \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n346:             \"WHERE s.user_id = ? ORDER BY s.achieved_at DESC, s.id DESC\",\n347:             (g.user[\"id\"],),\n348:         ).fetchall()\n349:         best = db.execute(\n350:             \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n351:         ).fetchone()[0]\n352:         return {\"items\": [score_object(row) for row in items], \"best_score\": best}\n353: \n354:     @app.get(\"/api/admin/scores\")\n355:     @authenticated(admin=True)\n356:     def admin_scores():\n357:         page = integer_param(\"page\", 1, 2_147_483_647)\n358:         page_size = integer_param(\"page_size\", 50, 100)\n359:         if page is None or page_size is None:\n360:             return error(\"Page must be a positive integer; page_size must be between 1 and 100.\")\n361:         db = database()\n362:         items = db.execute(\n363:             \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n364:             \"ORDER BY s.achieved_at DESC, s.id DESC LIMIT ? OFFSET ?\",\n365:             (page_size, (page - 1) * page_size),\n366:         ).fetchall()\n367:         total = db.execute(\"SELECT COUNT(*) FROM scores\").fetchone()[0]\n368:         return {\n369:             \"items\": [score_object(row) for row in items],\n370:             \"total\": total,\n\n(Showing lines 1-370 of 407. Use offset=371 to continue.)\n</content>","metadata":{"preview":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import UTC, datetime, timedelta\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, current_app, g, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nMAX_SCORE = 9_007_199_254_740_991\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import UTC, datetime, timedelta\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, current_app, g, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nMAX_SCORE = 9_007_199_254_740_991\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0 CHECK (is_admin IN (0, 1))\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS scores (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id),\n    score INTEGER NOT NULL CHECK (score >= 0),\n    achieved_at TEXT NOT NULL,\n    is_hidden INTEGER NOT NULL DEFAULT 0 CHECK (is_hidden IN (0, 1))\n);\nCREATE INDEX IF NOT EXISTS scores_player ON scores(user_id, achieved_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS scores_visible ON scores(is_hidden, achieved_at, score DESC);\nCREATE INDEX IF NOT EXISTS sessions_expiration ON sessions(expires_at);\n\"\"\"\n\nRANKING = \"\"\"\nWITH player_scores AS (\n    SELECT s.*, u.username AS player,\n           ROW_NUMBER() OVER (\n               PARTITION BY s.user_id\n               ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\n           ) AS best\n    FROM scores s JOIN users u ON u.id = s.user_id\n    WHERE s.is_hidden = 0 AND s.achieved_at >= ?\n), ranked AS (\n    SELECT user_id, player, score, achieved_at,\n           ROW_NUMBER() OVER (ORDER BY score DESC, achieved_at ASC, id ASC) AS rank\n    FROM player_scores WHERE best = 1\n)\n\"\"\"\n\n\ndef utc_now():\n    return datetime.now(UTC)\n\n\ndef timestamp(value):\n    return value.isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef connect_database(path):\n    connection = sqlite3.connect(path, timeout=30)\n    connection.row_factory = sqlite3.Row\n    connection.execute(\"PRAGMA foreign_keys = ON\")\n    return connection\n\n\ndef database():\n    if \"db\" not in g:\n        g.db = connect_database(current_app.config[\"DATABASE\"])\n    return g.db\n\n\ndef error(message, status=400):\n    return {\"error\": message}, status\n\n\ndef json_body():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return None\n    return body\n\n\ndef credentials(body):\n    if body is None:\n        return None\n    username, password = body.get(\"username\"), body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return None\n    username = username.strip()\n    if not re.fullmatch(r\"[A-Za-z0-9_.-]{1,32}\", username):\n        return None\n    if not 1 <= len(password) <= 256:\n        return None\n    return username, password\n\n\ndef authenticated(admin=False):\n    def decorator(view):\n        @wraps(view)\n        def wrapped(*args, **kwargs):\n            parts = request.headers.get(\"Authorization\", \"\").split()\n            if len(parts) != 2 or parts[0].lower() != \"bearer\":\n                return error(\"Sign in to continue.\", 401)\n            token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n            user = (\n                database()\n                .execute(\n                    \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n                    \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n                    (token_hash, timestamp(utc_now())),\n                )\n                .fetchone()\n            )\n            if user is None or (user[\"is_admin\"] and not user[\"password_hash\"]):\n                return error(\"Your session is invalid or expired. Please sign in again.\", 401)\n            if admin and not user[\"is_admin\"]:\n                return error(\"Admin access is required.\", 403)\n            g.user = user\n            g.token_hash = token_hash\n            return view(*args, **kwargs)\n\n        return wrapped\n\n    return decorator\n\n\ndef score_object(row):\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"achieved_at\": row[\"achieved_at\"],\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"player\"],\n    }\n\n\ndef get_score(score_id):\n    return (\n        database()\n        .execute(\n            \"SELECT s.*, u.username AS player FROM scores s \"\n            \"JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n            (score_id,),\n        )\n        .fetchone()\n    )\n\n\ndef integer_param(name, default, maximum):\n    value = request.args.get(name, str(default))\n    if not re.fullmatch(r\"[0-9]{1,10}\", value):\n        return None\n    number = int(value)\n    return number if 1 <= number <= maximum else None\n\n\ndef create_app(config=None):\n    app = Flask(__name__, static_folder=None)\n    app.config.from_mapping(\n        DATABASE=str(Path.cwd() / \"data\" / \"leaderboard.sqlite3\"),\n        MAX_CONTENT_LENGTH=16 * 1024,\n    )\n    if config:\n        app.config.update(config)\n\n    db_path = Path(app.config[\"DATABASE\"])\n    db_path.parent.mkdir(parents=True, exist_ok=True)\n    db = connect_database(str(db_path))\n    try:\n        db.execute(\"PRAGMA journal_mode = WAL\")\n        db.executescript(SCHEMA)\n        db.execute(\"BEGIN IMMEDIATE\")\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        admin = db.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n        if admin is None:\n            db.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n                (generate_password_hash(admin_password) if admin_password else \"\",),\n            )\n        elif not admin_password or not check_password_hash(admin[\"password_hash\"], admin_password):\n            db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n            db.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(admin_password) if admin_password else \"\", admin[\"id\"]),\n            )\n        db.commit()\n    finally:\n        db.close()\n\n    @app.teardown_appcontext\n    def close_database(exception=None):\n        db = g.pop(\"db\", None)\n        if db is not None:\n            db.close()\n\n    @app.errorhandler(HTTPException)\n    def handle_http_error(exception):\n        if request.path.startswith(\"/api\"):\n            return error(exception.description, exception.code)\n        return exception\n\n    @app.after_request\n    def response_headers(response):\n        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n        response.headers[\"X-Frame-Options\"] = \"DENY\"\n        if request.path.startswith(\"/api\"):\n            response.headers[\"Cache-Control\"] = \"no-store\"\n        return response\n\n    @app.get(\"/api/health\")\n    def health():\n        return {\"status\": \"ok\"}\n\n    @app.post(\"/api/auth/register\")\n    def register():\n        account = credentials(json_body())\n        if account is None:\n            return error(\n                \"Use a 1–32 character username (letters, numbers, _, . or -) and a password of 1–256 characters.\"\n            )\n        username, password = account\n        if username.lower() == \"admin\":\n            return error(\"This username is reserved.\", 409)\n        db = database()\n        try:\n            db.execute(\n                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                (username, generate_password_hash(password)),\n            )\n            db.commit()\n        except sqlite3.IntegrityError:\n            db.rollback()\n            return error(\"That username is already taken.\", 409)\n        return {\"username\": username}, 201\n\n    @app.post(\"/api/auth/login\")\n    def login():\n        account = credentials(json_body())\n        if account is None:\n            return error(\"Enter a valid username and password.\")\n        username, password = account\n        db = database()\n        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n        password_hash = (\n            user[\"password_hash\"]\n            if user and user[\"password_hash\"]\n            else app.config[\"DUMMY_PASSWORD_HASH\"]\n        )\n        valid_password = check_password_hash(password_hash, password)\n        if user is None or not user[\"password_hash\"] or not valid_password:\n            return error(\"Incorrect username or password.\", 401)\n        token = secrets.token_urlsafe(32)\n        db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(utc_now()),))\n        db.execute(\n            \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (\n                hashlib.sha256(token.encode()).hexdigest(),\n                user[\"id\"],\n                timestamp(utc_now() + timedelta(days=30)),\n            ),\n        )\n        db.commit()\n        return {\"token\": token}\n\n    @app.get(\"/api/auth/me\")\n    @authenticated()\n    def me():\n        return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n\n    @app.post(\"/api/auth/logout\")\n    @authenticated()\n    def logout():\n        database().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n        database().commit()\n        return {\"status\": \"ok\"}\n\n    @app.get(\"/api/leaderboard\")\n    def leaderboard():\n        period = request.args.get(\"period\", \"all\")\n        now = utc_now()\n        day = now.replace(hour=0, minute=0, second=0, microsecond=0)\n        if period in (\"all\", \"all_time\", \"all-time\"):\n            cutoff = \"\"\n        elif period in (\"week\", \"weekly\"):\n            cutoff = timestamp(day - timedelta(days=day.weekday()))\n        elif period in (\"today\", \"day\", \"daily\"):\n            cutoff = timestamp(day)\n        else:\n            return error(\"Period must be all, week or today.\")\n        limit = integer_param(\"limit\", 50, 1000)\n        if limit is None:\n            return error(\"Limit must be an integer between 1 and 1000.\")\n        player = request.args.get(\"player\", \"\").strip()\n        if len(player) > 32:\n            return error(\"Player search must be 32 characters or fewer.\")\n        db = database()\n        items = db.execute(\n            RANKING + \"SELECT rank, player, score, achieved_at FROM ranked \"\n            \"WHERE instr(lower(player), lower(?)) > 0 ORDER BY rank LIMIT ?\",\n            (cutoff, player, limit),\n        ).fetchall()\n        total = db.execute(\n            RANKING + \"SELECT COUNT(*) FROM ranked WHERE instr(lower(player), lower(?)) > 0\",\n            (cutoff, player),\n        ).fetchone()[0]\n        return {\"items\": [dict(row) for row in items], \"total\": total}\n\n    @app.post(\"/api/scores\")\n    @authenticated()\n    def submit_score():\n        body = json_body()\n        value = body.get(\"score\") if body is not None else None\n        if type(value) is not int or not 0 <= value <= MAX_SCORE:\n            return error(f\"Score must be a whole number between 0 and {MAX_SCORE}.\")\n        db = database()\n        db.execute(\"BEGIN IMMEDIATE\")\n        previous_best = db.execute(\n            \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n        ).fetchone()[0]\n        cursor = db.execute(\n            \"INSERT INTO scores (user_id, score, achieved_at) VALUES (?, ?, ?)\",\n            (g.user[\"id\"], value, timestamp(utc_now())),\n        )\n        result = score_object(get_score(cursor.lastrowid))\n        result[\"rank\"] = db.execute(\n            RANKING + \"SELECT rank FROM ranked WHERE user_id = ?\", (\"\", g.user[\"id\"])\n        ).fetchone()[0]\n        result[\"personal_best\"] = previous_best is None or value > previous_best\n        db.commit()\n        return result, 201\n\n    @app.get(\"/api/scores\")\n    @authenticated()\n    def personal_scores():\n        db = database()\n        items = db.execute(\n            \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n            \"WHERE s.user_id = ? ORDER BY s.achieved_at DESC, s.id DESC\",\n            (g.user[\"id\"],),\n        ).fetchall()\n        best = db.execute(\n            \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n        ).fetchone()[0]\n        return {\"items\": [score_object(row) for row in items], \"best_score\": best}\n\n    @app.get(\"/api/admin/scores\")\n    @authenticated(admin=True)\n    def admin_scores():\n        page = integer_param(\"page\", 1, 2_147_483_647)\n        page_size = integer_param(\"page_size\", 50, 100)\n        if page is None or page_size is None:\n            return error(\"Page must be a positive integer; page_size must be between 1 and 100.\")\n        db = database()\n        items = db.execute(\n            \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n            \"ORDER BY s.achieved_at DESC, s.id DESC LIMIT ? OFFSET ?\",\n            (page_size, (page - 1) * page_size),\n        ).fetchall()\n        total = db.execute(\"SELECT COUNT(*) FROM scores\").fetchone()[0]\n        return {\n            \"items\": [score_object(row) for row in items],\n            \"total\": total,","lineStart":1,"lineEnd":370,"totalLines":407,"truncated":true}},"title":"backend/app.py","time":{"start":1794316900950,"end":1794316900968}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"gAAAAABq8xpkidLO_l9-oGtosUSd9fDPKE5rNmfNomFcnfJL4zHQELeBFErTl96TmAXVhW5wi5Yky2z6iawe8WcXkCQCpSxGu1bNQIc5_ntVLNINvndO7HdrkQbiuvjh73cmIOAdC_2F43IO32xsygcEUXYZiYehkts81V0ZmaEeJ3n7pvh9JMSWsk8pvrIocsMJYU4xBvdzV6pMAQDPYTmsAcrwOzLlRc9DBJpAxYszW51ij4dD_hsgM-o1YPD1jlXQspzzYh7RagDETbIksbzobzwcIYeiXr-0gWDayiwvRtYt6pZdu69GBPJyi2NJ9fO_wkeTeWgAeHEnZpugz4-hWXX8gcOlOHAFMYWy16buDy3Po4M2Z-uDvyOeSeXfYXM1chXyWPWzbpOIJ3KmVIBXsaIw6-ovYfh5QxsxpC-9uFGJ8MBQ3CRqvwtYAoeNJGctvFf6YtcpH54VqTPPc-mJI_PD_c7UXmJM8scD7YpUEKQ6LodmMbOTnINkte42iKU60oZqMk_7o2Lg5FIHQ_qYrh10cAdsoogcx_xntYwTM9FLc91CVTkCK_FVXl5K8kDd9HwOSZ_lQRgSvG9u7U0pB3e5WsV3QEDCR3-a7sck9e8AJzwfAxoZpCIes_Nxf6uTGJSGIgdXS-qKb-QjbT9zo0Smeef3SlRNE5RoQjztT8WLbeOfW3yGaG1G0xkRiK5p2gtYxCd-7aH9fk6Vwr_CezbiLl1pz0FdiVxmKSLCCtixHdIc2hMuG14k3vrjVIWIRugEVjzwzhLHuQ5vU44nLytMDYtzgr2gxCqJPw9o9C-Se7_6Xmq3f8KWr2t9VtyG4MLmjDZ7OOAp99VSOes89wmpwn_-BS-rB0-7P6Y03AdhhAVLfaNAjo4am-I7hxvvY4V_tDLlI0UTnRrT5_9-Bx0k444FLK108RaZNDl5NV4XwYhgj5A1nkAnptpoA