name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"^4.3.5\",\n    \"lucide-react\": \"^1.71.0\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"^4.3.5\"\n  },\n  \"devDependencies\": {\n    \"@eslint/js\": \"^10.0.1\",\n    \"@types/node\": \"^26.6.6\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"eslint\": \"^10.14.0\",\n    \"eslint-plugin-react-hooks\": \"^7.1.1\",\n    \"eslint-plugin-react-refresh\": \"^0.5.7\",\n    \"globals\": \"^17.14.0\",\n    \"typescript\": \"^6.0.3\",\n    \"typescript-eslint\": \"^8.72.2\",\n    \"vite\": \"8.3.5\"\n  }\n}","lineStart":1,"lineEnd":30,"totalLines":30,"truncated":false}},"title":"frontend/package.json","time":{"start":1794315489284,"end":1794315489294}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5898f06001gNxL13xLFhCKWP","sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","messageID":"msg_1c5898570001ZHnvRmiQWHOJCD"}}
