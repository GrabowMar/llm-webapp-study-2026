"LD_LIBRARY_PATH\"] === undefined) {\n39:         process.env[\"LD_LIBRARY_PATH\"] = baseLibPath;\n40:     }\n41:     else if (!process.env[\"LD_LIBRARY_PATH\"].startsWith(baseLibPath)) {\n42:         process.env[\"LD_LIBRARY_PATH\"] = [\n43:             baseLibPath,\n44:             ...new Set(process.env[\"LD_LIBRARY_PATH\"].split(\":\")),\n45:         ].join(\":\");\n46:     }\n47: };\n48: /**\n49:  * Determines if the input is a valid URL\n50:  * @param input the input to check\n51:  * @returns boolean indicating if the input is a valid URL\n52:  */\n53: export const isValidUrl = (input) => {\n54:     try {\n55:         const url = new URL(input);\n56:         if (url.protocol === \"https:\")\n57:             return true;\n58:         // Allow http:// only for localhost/127.0.0.1 (development/testing)\n59:         if (url.protocol === \"http:\" &&\n60:             (url.hostname === \"localhost\" ||\n61:                 url.hostname === \"127.0.0.1\" ||\n62:                 url.hostname === \"[::1]\")) {\n63:             return true;\n64:         }\n65:         return false;\n66:     }\n67:     catch {\n68:         return false;\n69:     }\n70: };\n71: /**\n72:  * Determines if the running instance is inside an Amazon Linux 2023 container,\n73:  * AWS_EXECUTION_ENV is for native Lambda instances\n74:  * AWS_LAMBDA_JS_RUNTIME is for netlify instances\n75:  * CODEBUILD_BUILD_IMAGE is for CodeBuild instances\n76:  * VERCEL is for Vercel Functions (Node 20 or later enables an AL2023-compatible environment).\n77:  * @returns boolean indicating if the running instance is inside a Lambda container with nodejs20\n78:  */\n79: export const isRunningInAmazonLinux2023 = (nodeMajorVersion) => {\n80:     const awsExecEnv = process.env[\"AWS_EXECUTION_ENV\"] ?? \"\";\n81:     const awsLambdaJsRuntime = process.env[\"AWS_LAMBDA_JS_RUNTIME\"] ?? \"\";\n82:     const codebuildImage = process.env[\"CODEBUILD_BUILD_IMAGE\"] ?? \"\";\n83:     // Check for explicit version substrings