not 1 <= len(password) <= 256:\n+        return None\n+    return username, password\n+\n+\n+def authenticated(admin=False):\n+    def decorator(view):\n+        @wraps(view)\n+        def wrapped(*args, **kwargs):\n+            parts = request.headers.get(\"Authorization\", \"\").split()\n+            if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+                return error(\"Sign in to continue.\", 401)\n+            token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+            user = database().execute(\n+                \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n+                \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n+                (token_hash, timestamp(utc_now())),\n+            ).fetchone()\n+            if user is None or (user[\"is_admin\"] and not user[\"password_hash\"]):\n+                return error(\"Your session is invalid or expired. Please sign in again.\", 401)\n+            if admin and not user[\"is_admin\"]:\n+                return error(\"Admin access is required.\", 403)\n+            g.user = user\n+            g.token_hash = token_hash\n+            return view(*args, **kwargs)\n+\n+        return wrapped\n+\n+    return decorator\n+\n+\n+def score_object(row):\n+    return {\n+        \"id\": row[\"id\"],\n+        \"score\": row[\"score\"],\n+        \"achieved_at\": row[\"achieved_at\"],\n+        \"is_hidden\": bool(row[\"is_hidden\"]),\n+        \"player\": row[\"player\"],\n+    }\n+\n+\n+def get_score(score_id):\n+    return database().execute(\n+        \"SELECT s.*, u.username AS player FROM scores s \"\n+        \"JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n+        (score_id,),\n+    ).fetchone()\n+\n+\n+def integer_param(name, default, maximum):\n+    value = request.args.get(name, str(default))\n+    if not re.fullmatch(r\"[0-9]{1,10}\", value):\n+        return None\n+    number = int(value)\n+    return number if 1 <= number <= maximum else None\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.from_mapping(\n+        DATABASE=str(Path.cwd() / \"data\" / \"leaderboard.sqlite3\"),\n+        MAX_CONTENT_LENGTH=16 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+\n+    db_path = Path(app.config[\"DATABASE\"])\n+    db_path.parent.mkdir(parents=True, exist_ok=True)\n+    db = connect_database(str(db_path))\n+    try:\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(SCHEMA)\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n+        admin = db.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n+        if admin is None:\n+            db.execute(\n+                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n+                (generate_password_hash(admin_password) if admin_password else \"\",),\n+            )\n+        elif not admin_password or not check_password_hash(admin[\"password_hash\"], admin_password):\n+            db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n+            db.execute(\n+                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n+                (generate_password_hash(admin_password) if admin_password else \"\", admin[\"id\"]),\n+            )\n+        db.commit()\n+    finally:\n+        db.close()\n+\n+    @app.teardown_appcontext\n+    def close_database(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def handle_http_error(exception):\n+        if request.path.startswith(\"/api\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        account = credentials(json_body())\n+        if account is None:\n+            return error(\"Use a 1–32 character username (letters, numbers, _, . or -) and a password of 1–256 characters.\")\n+        username, password = account\n+        if username.lower() == \"admin\":\n+            return error(\"This username is reserved.\", 409)\n+        db = database()\n+        try:\n+            db.execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            return error(\"That username is already taken.\", 409)\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        account = credentials(json_body())\n+        if account is None:\n+            return error(\"Enter a valid username and password.\")\n+        username, password = account\n+        db = database()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        password_hash = user[\"password_hash\"] if user and user[\"password_hash\"] else app.config[\"DUMMY_PASSWORD_HASH\"]\n+        valid_password = check_password_hash(password_hash, password)\n+        if user is None or not user[\"password_hash\"] or not valid_password:\n+            return error(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(utc_now()),))\n+        db.execute(\n+            \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], timestamp(utc_now() + timedelta(days=30))),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated()\n+    def me():\n+        return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated()\n+    def logout():\n+        database().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        database().commit()\n+        return {\"status\": \"ok\"}\n+\n+    @app.get(\"/api/leaderboard\")\n+    def leaderboard():\n+        period = request.args.get(\"period\", \"all\")\n+        now = utc_now()\n+        day = now.replace(hour=0, minute=0, second=0, microsecond=0)\n+        if period in (\"all\", \"all_time\", \"all-time\"):\n+            cutoff = \"\"\n+        elif period in (\"week\", \"weekly\"):\n+            cutoff = timestamp(day - timedelta(days=day.weekday()))\n+        elif period in (\"today\", \"day\", \"daily\"):\n+            cutoff = timestamp(day)\n+        else:\n+            return error(\"Period must be all, week or today.\")\n+        limit = integer_param(\"limit\", 50, 1000)\n+        if limit is None:\n+            return error(\"Limit must be an integer between 1 and 1000.\")\n+        player = request.args.get(\"player\", \"\").strip()\n+        if len(player) > 32:\n+            return error(\"Player search must be 32 characters or fewer.\")\n+        db = database()\n+        items = db.execute(\n+            RANKING + \"SELECT rank, player, score, achieved_at FROM ranked \"\n+            \"WHERE instr(lower(player), lower(?)) > 0 ORDER BY rank LIMIT ?\",\n+            (cutoff, player, limit),\n+        ).fetchall()\n+        total = db.execute(\n+            RANKING + \"SELECT COUNT(*) FROM ranked WHERE instr(lower(player), lower(?)) > 0\",\n+            (cutoff, player),\n+        ).fetchone()[0]\n+        return {\"items\": [dict(row) for row in items], \"total\": total}\n+\n+    @app.post(\"/api/scores\")\n+    @authenticated()\n+    def submit_score():\n+        body = json_body()\n+        value = body.get(\"score\") if body is not None else None\n+        if type(value) is not int or not 0 <= value <= MAX_SCORE:\n+            return error(f\"Score must be a whole number between 0 and {MAX_SCORE}.\")\n+        db = database()\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        previous_best = db.execute(\n+            \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n+        ).fetchone()[0]\n+        cursor = db.execute(\n+            \"INSERT INTO scores (user_id, score, achieved_at) VALUES (?, ?, ?)\",\n+            (g.user[\"id\"], value, timestamp(utc_now())),\n+        )\n+        result = score_object(get_score(cursor.lastrowid))\n+        result[\"rank\"] = db.execute(\n+            RANKING + \"SELECT rank FROM ranked WHERE user_id = ?\", (\"\", g.user[\"id\"])\n+        ).fetchone()[0]\n+        result[\"personal_best\"] = previous_best is None or value > previous_best\n+        db.commit()\n+        return result, 201\n+\n+    @app.get(\"/api/scores\")\n+    @authenticated()\n+    def personal_scores():\n+        db = database()\n+        items = db.execute(\n+            \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n+            \"WHERE s.user_id = ? ORDER BY s.achieved_at DESC, s.id DESC\", (g.user[\"id\"],)\n+        ).fetchall()\n+        best = db.execute(\n+            \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n+        ).fetchone()[0]\n+        return {\"items\": [score_object(row) for row in items], \"best_score\": best}\n+\n+    @app.get(\"/api/admin/scores\")\n+    @authenticated(admin=True)\n+    def admin_scores():\n+        page = integer_param(\"page\", 1, 2_147_483_647)\n+        page_size = integer_param(\"page_size\", 50, 100)\n+        if page is None or page_size is None:\n+            return error(\"Page must be a positive integer; page_size must be between 1 and 100.\")\n+        db = database()\n+        items = db.execute(\n+            \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n+            \"ORDER BY s.achieved_at DESC, s.id DESC LIMIT ? OFFSET ?\",\n+            (page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        total = db.execute(\"SELECT COUNT(*) FROM scores\").fetchone()[0]\n+        return {\"items\": [score_object(row) for row in items], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n+    @authenticated(admin=True)\n+    def toggle_score(score_id):\n+        db = database()\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        cursor = db.execute(\"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,))\n+        if cursor.rowcount == 0:\n+            db.rollback()\n+            return error(\"Score not found.\", 404)\n+        result = score_object(get_score(score_id))\n+        db.commit()\n+        return result\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        if Path(path).suffix:\n+            return error(\"File not found.\", 404)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_PASSWORD_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+backend/__pycache__/\n+.venv/\n+__pycache__/\n+.ruff_cache/\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,383 @@\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+MAX_SCORE = 9_007_199_254_740_991\n+\n+SCHEMA = \"\"\"\n+CREATE TABLE IF NOT EXISTS users (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+    password_hash TEXT NOT NULL,\n+    is_admin INTEGER NOT NULL DEFAULT 0 CHECK (is_admin IN (0, 1))\n+);\n+CREATE TABLE IF NOT EXISTS sessions (\n+    token_hash TEXT PRIMARY KEY,\n+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+    expires_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS scores (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    user_id INTEGER NOT NULL REFERENCES users(id),\n+    score INTEGER NOT NULL CHECK (score >= 0),\n+    achieved_at TEXT NOT NULL,\n+    is_hidden INTEGER NOT NULL DEFAULT 0 CHECK (is_hidden IN (0, 1))\n+);\n+CREATE INDEX IF NOT EXISTS scores_player ON scores(user_id, achieved_at DESC, id DESC);\n+CREATE INDEX IF NOT EXISTS scores_visible ON scores(is_hidden, achieved_at, score DESC);\n+CREATE INDEX IF NOT EXISTS sessions_expiration ON sessions(expires_at);\n+\"\"\"\n+\n+RANKING = \"\"\"\n+WITH player_scores AS (\n+    SELECT s.*, u.username AS player,\n+           ROW_NUMBER() OVER (\n+               PARTITION BY s.user_id\n+               ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\n+           ) AS best\n+    FROM scores s JOIN users u ON u.id = s.user_id\n+    WHERE s.is_hidden = 0 AND s.achieved_at >= ?\n+), ranked AS (\n+    SELECT user_id, player, score, achieved_at,\n+           ROW_NUMBER() OVER (ORDER BY score DESC, achieved_at ASC, id ASC) AS rank\n+    FROM player_scores WHERE best = 1\n+)\n+\"\"\"\n+\n+\n+def utc_now():\n+    return datetime.now(timezone.utc)\n+\n+\n+def timestamp(value):\n+    return value.isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n+\n+\n+def connect_database(path):\n+    connection = sqlite3.connect(path, timeout=30)\n+    connection.row_factory = sqlite3.Row\n+    connection.execute(\"PRAGMA foreign_keys = ON\")\n+    return connection\n+\n+\n+def database():\n+    if \"db\" not in g:\n+        g.db = connect_database(current_app.config[\"DATABASE\"])\n+    return g.db\n+\n+\n+def error(message, status=400):\n+    return {\"error\": message}, status\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        return None\n+    return body\n+\n+\n+def credentials(body):\n+    if body is None:\n+        return None\n+    username, password = body.get(\"username\"), body.get(\"password\")\n+    if not isinstance(username, str) or not isinstance(password, str):\n+        return None\n+    username = username.strip()\n+    if not re.fullmatch(r\"[A-Za-z0-9_.-]{1,32}\", username):\n+        return None\n+    if not 1 <= len(password) <= 256:\n+        return None\n+    return username, password\n+\n+\n+def authenticated(admin=False):\n+    def decorator(view):\n+        @wraps(view)\n+        def wrapped(*args, **kwargs):\n+            parts = request.headers.get(\"Authorization\", \"\").split()\n+            if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+                return error(\"Sign in to continue.\", 401)\n+            token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+            user = database().execute(\n+                \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n+                \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n+                (token_hash, timestamp(utc_now())),\n+            ).fetchone()\n+            if user is None or (user[\"is_admin\"] and not user[\"password_hash\"]):\n+                return error(\"Your session is invalid or expired. Please sign in again.\", 401)\n+            if admin and not user[\"is_admin\"]:\n+                return error(\"Admin access is required.\", 403)\n+            g.user = user\n+            g.token_hash = token_hash\n+            return view(*args, **kwargs)\n+\n+        return wrapped\n+\n+    return decorator\n+\n+\n+def score_object(row):\n+    return {\n+        \"id\": row[\"id\"],\n+        \"score\": row[\"score\"],\n+        \"achieved_at\": row[\"achieved_at\"],\n+        \"is_hidden\": bool(row[\"is_hidden\"]),\n+        \"player\": row[\"player\"],\n+    }\n+\n+\n+def get_score(score_id):\n+    return database().execute(\n+        \"SELECT s.*, u.username AS player FROM scores s \"\n+        \"JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n+        (score_id,),\n+    ).fetchone()\n+\n+\n+def integer_param(name, default, maximum):\n+    value = request.args.get(name, str(default))\n+    if not re.fullmatch(r\"[0-9]{1,10}\", value):\n+        return None\n+    number = int(value)\n+    return number if 1 <= number <= maximum else None\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.from_mapping(\n+        DATABASE=str(Path.cwd() / \"data\" / \"leaderboard.sqlite3\"),\n+        MAX_CONTENT_LENGTH=16 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+\n+    db_path = Path(app.config[\"DATABASE\"])\n+    db_path.parent.mkdir(parents=True, exist_ok=True)\n+    db = connect_database(str(db_path))\n+    try:\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(SCHEMA)\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n+        admin = db.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n+        if admin is None:\n+            db.execute(\n+                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n+                (generate_password_hash(admin_password) if admin_password else \"\",),\n+            )\n+        elif not admin_password or not check_password_hash(admin[\"password_hash\"], admin_password):\n+            db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n+            db.execute(\n+                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n+                (generate_password_hash(admin_password) if admin_password else \"\", admin[\"id\"]),\n+            )\n+        db.commit()\n+    finally:\n+        db.close()\n+\n+    @app.teardown_appcontext\n+    def close_database(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def handle_http_error(exception):\n+        if request.path.startswith(\"/api\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        account = credentials(json_body())\n+        if account is None:\n+            return error(\"Use a 1–32 character username (letters, numbers, _, . or -) and a password of 1–256 characters.\")\n+        username, password = account\n+        if username.lower() == \"admin\":\n+            return error(\"This username is reserved.\", 409)\n+        db = database()\n+        try:\n+            db.execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            return error(\"That username is already taken.\", 409)\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        account = credentials(json_body())\n+        if account is None:\n+            return error(\"Enter a valid username and password.\")\n+        username, password = account\n+        db = database()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        password_hash = user[\"password_hash\"] if user and user[\"password_hash\"] else app.config[\"DUMMY_PASSWORD_HASH\"]\n+        valid_password = check_password_hash(password_hash, password)\n+        if user is None or not user[\"password_hash\"] or not valid_password:\n+            return error(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(utc_now()),))\n+        db.execute(\n+            \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], timestamp(utc_now() + timedelta(days=30))),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated()\n+    def me():\n+        return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated()\n+    def logout():\n+        database().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        database().commit()\n+        return {\"status\": \"ok\"}\n+\n+    @app.get(\"/api/leaderboard\")\n+    def leaderboard():\n+        period = request.args.get(\"period\", \"all\")\n+        now = utc_now()\n+        day = now.replace(hour=0, minute=0, second=0, microsecond=0)\n+        if period in (\"all\", \"all_time\", \"all-time\"):\n+            cutoff = \"\"\n+        elif period in (\"week\", \"weekly\"):\n+            cutoff = timestamp(day - timedelta(days=day.weekday()))\n+        elif period in (\"today\", \"day\", \"daily\"):\n+            cutoff = timestamp(day)\n+        else:\n+            return error(\"Period must be all, week or today.\")\n+        limit = integer_param(\"limit\", 50, 1000)\n+        if limit is None:\n+            return error(\"Limit must be an integer between 1 and 1000.\")\n+        player = request.args.get(\"player\", \"\").strip()\n+        if len(player) > 32:\n+            return error(\"Player search must be 32 characters or fewer.\")\n+        db = database()\n+        items = db.execute(\n+            RANKING + \"SELECT rank, player, score, achieved_at FROM ranked \"\n+            \"WHERE instr(lower(player), lower(?)) > 0 ORDER BY rank LIMIT ?\",\n+            (cutoff, player, limit),\n+        ).fetchall()\n+        total = db.execute(\n+            RANKING + \"SELECT COUNT(*) FROM ranked WHERE instr(lower(player), lower(?)) > 0\",\n+            (cutoff, player),\n+        ).fetchone()[0]\n+        return {\"items\": [dict(row) for row in items], \"total\": total}\n+\n+    @app.post(\"/api/scores\")\n+    @authenticated()\n+    def submit_score():\n+        body = json_body()\n+        value = body.get(\"score\") if body is not None else None\n+        if type(value) is not int or not 0 <= value <= MAX_SCORE:\n+            return error(f\"Score must be a whole number between 0 and {MAX_SCORE}.\")\n+        db = database()\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        previous_best = db.execute(\n+            \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n+        ).fetchone()[0]\n+        cursor = db.execute(\n+            \"INSERT INTO scores (user_id, score, achieved_at) VALUES (?, ?, ?)\",\n+            (g.user[\"id\"], value, timestamp(utc_now())),\n+        )\n+        result = score_object(get_score(cursor.lastrowid))\n+        result[\"rank\"] = db.execute(\n+            RANKING + \"SELECT rank FROM ranked WHERE user_id = ?\", (\"\", g.user[\"id\"])\n+        ).fetchone()[0]\n+        result[\"personal_best\"] = previous_best is None or value > previous_best\n+        db.commit()\n+        return result, 201\n+\n+    @app.get(\"/api/scores\")\n+    @authenticated()\n+    def personal_scores():\n+        db = database()\n+        items = db.execute(\n+            \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n+            \"WHERE s.user_id = ? ORDER BY s.achieved_at DESC, s.id DESC\", (g.user[\"id\"],)\n+        ).fetchall()\n+        best = db.execute(\n+            \"SELECT MAX(score) FROM scores WHERE user_id = ? AND is_hidden = 0\", (g.user[\"id\"],)\n+        ).fetchone()[0]\n+        return {\"items\": [score_object(row) for row in items], \"best_score\": best}\n+\n+    @app.get(\"/api/admin/scores\")\n+    @authenticated(admin=True)\n+    def admin_scores():\n+        page = integer_param(\"page\", 1, 2_147_483_647)\n+        page_size = integer_param(\"page_size\", 50, 100)\n+        if page is None or page_size is None:\n+            return error(\"Page must be a positive integer; page_size must be between 1 and 100.\")\n+        db = database()\n+        items = db.execute(\n+            \"SELECT s.*, u.username AS player FROM scores s JOIN users u ON u.id = s.user_id \"\n+            \"ORDER BY s.achieved_at DESC, s.id DESC LIMIT ? OFFSET ?\",\n+            (page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        total = db.execute(\"SELECT COUNT(*) FROM scores\").fetchone()[0]\n+        return {\"items\": [score_object(row) for row in items], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n+    @authenticated(admin=True)\n+    def toggle_score(score_id):\n+        db = database()\n+        db.execute(\"BEGIN IMMEDIATE\")\n+        cursor = db.execute(\"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,))\n+        if cursor.rowcount == 0:\n+            db.rollback()\n+            return error(\"Score not found.\", 404)\n+        result = score_object(get_score(score_id))\n+        db.commit()\n+        return result\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        if Path(path).suffix:\n+            return error(\"File not found.\", 404)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_PASSWORD_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n","additions":383,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+backend/__pycache__/\n+.venv/\n+__pycache__/\n+.ruff_cache/\n","additions":7,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA .gitignore","time":{"start":1794315213125,"end":1794315213153}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5845908001mrQeQ0mg5oXLf0","sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","messageID":"msg_1c584509b001pEPofYSh2kYEXp"}}
