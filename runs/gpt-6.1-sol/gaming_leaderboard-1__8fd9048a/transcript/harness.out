{"type":"tool_use","timestamp":1794316871734,"sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","part":{"type":"tool","tool":"read","callID":"call_R8yisA5od5N2xmvAsS5BXkaX","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/App.tsx","limit":400},"output":"<path>/workspace/frontend/src/App.tsx</path>\n<type>file</type>\n<content>\n1: import { useDeferredValue, useEffect, useRef, useState } from \"react\";\n2: import type { FormEvent, ReactNode } from \"react\";\n3: import {\n4:   ArrowDown, ArrowRight, ArrowUpRight, Award, Check, ChevronLeft,\n5:   ChevronRight, CircleHelp, Clock3, Crown, Eye, EyeOff, Gamepad2,\n6:   Hash, LoaderCircle, LogOut, Medal, Plus, RefreshCw, Search,\n7:   ShieldCheck, Sparkles, Target, Trophy, Users, X, Zap,\n8: } from \"lucide-react\";\n9: import { api, date, message, number, savedToken, saveToken } from \"./api\";\n10: import type { AdminScores, Board, Period, PersonalScores, RankedPlayer, Submission, User } from \"./api\";\n11: \n12: const button = \"inline-flex items-center justify-center gap-2 rounded-xl text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forest disabled:cursor-not-allowed disabled:opacity-50\";\n13: const field = \"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-forest outline-none transition focus:border-forest focus:ring-2 focus:ring-forest/10 placeholder:text-muted/70\";\n14: const periods: { value: Period; label: string }[] = [\n15:   { value: \"all\", label: \"All time\" },\n16:   { value: \"week\", label: \"This week\" },\n17:   { value: \"today\", label: \"Today\" },\n18: ];\n19: \n20: function Avatar({ name, className = \"\" }: { name: string; className?: string }) {\n21:   const colors = [\"bg-[#eef0ff] text-[#7770ae]\", \"bg-[#fce8d6] text-[#ad7043]\", \"bg-[#e6efdf] text-[#647d4e]\", \"bg-[#f7e7ed] text-[#a65f7c]\", \"bg-[#e0eff1] text-[#4e8087]\"];\n22:   const hash = Array.from(name).reduce((sum, char) => sum + char.charCodeAt(0), 0);\n23:   return <span aria-hidden=\"true\" className={`inline-flex size-9 shrink-0 items-center justify-center rounded-full text-xs font-bold ${colors[hash % colors.length]} ${className}`}>{name.slice(0, 2).toUpperCase()}</span>;\n24: }\n25: \n26: function Notice({ children, success = false }: { children: ReactNode; success?: boolean }) {\n27:   return <div role={success ? \"status\" : \"alert\"} className={`rounded-xl px-4 py-3 text-sm leading-relaxed ${success ? \"bg-forest/7 text-forest\" : \"bg-red-50 text-red-700\"}`}>{children}</div>;\n28: }\n29: \n30: function Modal({ title, children, onClose }: { title: string; children: ReactNode; onClose: () => void }) {\n31:   const ref = useRef<HTMLDivElement>(null);\n32:   const closeRef = useRef(onClose);\n33:   useEffect(() => { closeRef.current = onClose; }, [onClose]);\n34:   useEffect(() => {\n35:     const previous = document.activeElement as HTMLElement | null;\n36:     const overflow = document.body.style.overflow;\n37:     document.body.style.overflow = \"hidden\";\n38:     ref.current?.querySelector<HTMLElement>(\"input, button\")?.focus();\n39:     const handleKey = (event: KeyboardEvent) => {\n40:       if (event.key === \"Escape\") closeRef.current();\n41:       if (event.key === \"Tab\") {\n42:         const elements = ref.current?.querySelectorAll<HTMLElement>(\"button:not([disabled]), input, a[href]\");\n43:         if (!elements?.length) return;\n44:         const first = elements[0], last = elements[elements.length - 1];\n45:         if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }\n46:         else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }\n47:       }\n48:     };\n49:     document.addEventListener(\"keydown\", handleKey);\n50:     return () => {\n51:       document.body.style.overflow = overflow;\n52:       document.removeEventListener(\"keydown\", handleKey);\n53:       previous?.focus();\n54:     };\n55:   }, []);\n56:   return <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-forest/35 p-4 backdrop-blur-sm\" onMouseDown={event => { if (event.target === event.currentTarget) onClose(); }}>\n57:     <div ref={ref} role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-title\" className=\"relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-3xl bg-paper p-7 shadow-2xl sm:p-9\">\n58:       <button onClick={onClose} aria-label=\"Close dialog\" className={`${button} absolute right-5 top-5 size-8 text-muted hover:bg-line`}><X size={18} /></button>\n59:       <div className=\"mb-6 flex size-12 items-center justify-center rounded-2xl bg-lime text-forest\"><Gamepad2 size={25} /></div>\n60:       <h2 id=\"modal-title\" className=\"mb-2 text-3xl font-bold tracking-tight\">{title}</h2>\n61:       {children}\n62:     </div>\n63:   </div>;\n64: }\n65: \n66: function AuthModal({ mode, onClose, onMode, onSignedIn }: {\n67:   mode: \"login\" | \"register\";\n68:   onClose: () => void;\n69:   onMode: (mode: \"login\" | \"register\") => void;\n70:   onSignedIn: (token: string, user: User) => void;\n71: }) {\n72:   const [username, setUsername] = useState(\"\");\n73:   const [password, setPassword] = useState(\"\");\n74:   const [busy, setBusy] = useState(false);\n75:   const [error, setError] = useState(\"\");\n76:   const [registered, setRegistered] = useState(false);\n77:   const [showPassword, setShowPassword] = useState(false);\n78:   async function submit(event: FormEvent) {\n79:     event.preventDefault(); setBusy(true); setError(\"\");\n80:     try {\n81:       const body = JSON.stringify({ username, password });\n82:       if (mode === \"register\" && !registered) {\n83:         await api(\"/auth/register\", { method: \"POST\", body });\n84:         setRegistered(true);\n85:       }\n86:       const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n87:       const user = await api<User>(\"/auth/me\", {}, token);\n88:       onSignedIn(token, user);\n89:     } catch (error) { setError(message(error)); }\n90:     finally { setBusy(false); }\n91:   }\n92:   return <Modal title={mode === \"login\" ? \"Welcome back.\" : \"Your next high starts here.\"} onClose={onClose}>\n93:     <p className=\"mb-7 text-sm leading-relaxed text-muted\">{mode === \"login\" ? \"Sign in, submit your best, and make your move.\" : \"Join the community. Every great player starts somewhere.\"}</p>\n94:     <form onSubmit={submit} className=\"space-y-4\">\n95:       <label className=\"block text-sm font-semibold\">Username<input required maxLength={32} pattern=\"[A-Za-z0-9_.\\-]+\" autoComplete=\"username\" value={username} onChange={e => setUsername(e.target.value)} className={`${field} mt-2`} placeholder=\"Your player name\" /></label>\n96:       <label className=\"block text-sm font-semibold\">Password<div className=\"relative mt-2\"><input required maxLength={256} type={showPassword ? \"text\" : \"password\"} autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={e => setPassword(e.target.value)} className={`${field} pr-12`} placeholder=\"Your secret combo\" /><button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute right-4 top-3.5 text-muted\">{showPassword ? <EyeOff size={18} /> : <Eye size={18} />}</button></div></label>\n97:       {mode === \"register\" && <p className=\"text-xs leading-relaxed text-muted\">Usernames can contain letters, numbers, dots, dashes and underscores.</p>}\n98:       {registered && error && <Notice success>Your account was created. Retry to sign in.</Notice>}\n99:       {error && <Notice>{error}</Notice>}\n100:       <button disabled={busy} className={`${button} w-full bg-forest py-3.5 text-white hover:bg-forest/90`}>{busy ? <LoaderCircle size={18} className=\"animate-spin\" /> : <ArrowRight size={18} />}{mode === \"login\" ? \"Sign in\" : registered ? \"Sign in to your new account\" : \"Create account\"}</button>\n101:     </form>\n102:     <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New to the game?\" : \"Already a player?\"} <button className=\"font-semibold text-forest underline underline-offset-4\" onClick={() => { onMode(mode === \"login\" ? \"register\" : \"login\"); setError(\"\"); setRegistered(false); }}>{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n103:   </Modal>;\n104: }\n105: \n106: function HeroArtwork() {\n107:   return <div aria-hidden=\"true\" className=\"relative hidden h-56 w-80 shrink-0 items-center justify-center md:flex\">\n108:     <div className=\"absolute size-52 rounded-full border border-forest/10\" />\n109:     <div className=\"absolute size-64 rounded-full border border-dashed border-forest/10\" />\n110:     <div className=\"absolute left-10 top-9 -rotate-12 rounded-lg border border-forest/15 bg-white px-3 py-1.5 font-mono text-xs font-bold shadow-sm\">1UP <span className=\"text-[#80a543]\">↑</span></div>\n111:     <Sparkles className=\"absolute right-8 top-7 text-[#88a64e]\" size={26} />\n112:     <Plus className=\"absolute bottom-7 left-8 text-forest/40\" size={20} />\n113:     <div className=\"relative flex size-40 -rotate-8 items-center justify-center rounded-[2.5rem] bg-lime shadow-[8px_10px_0_0_#203c32] ring-1 ring-forest/10\">\n114:       <Trophy className=\"text-forest\" size={85} strokeWidth={1.3} />\n115:       <span className=\"absolute bottom-8 font-mono text-[11px] font-bold\">GO FOR GREAT.</span>\n116:     </div>\n117:     <div className=\"absolute bottom-5 right-3 rotate-6 rounded-full border border-forest/10 bg-white px-4 py-2 text-xs font-bold shadow-sm\"><span className=\"mr-2 inline-block size-2 rounded-full bg-[#91b84c]\" />EVERY GAME COUNTS</div>\n118:   </div>;\n119: }\n120: \n121: function Stat({ icon, label, value, detail }: { icon: ReactNode; label: string; value: string; detail: string }) {\n122:   return <div className=\"flex items-center gap-4 rounded-2xl border border-line bg-white/70 px-5 py-5 sm:px-6\">\n123:     <div className=\"flex size-11 shrink-0 items-center justify-center rounded-xl bg-paper text-forest/70\">{icon}</div>\n124:     <div className=\"min-w-0\"><p className=\"text-xs font-medium text-muted\">{label}</p><p className=\"mt-1 truncate text-2xl font-semibold tracking-tight tabular-nums\">{value}</p><p className=\"mt-0.5 text-[11px] text-muted\">{detail}</p></div>\n125:   </div>;\n126: }\n127: \n128: function Podium({ items, username }: { items: RankedPlayer[]; username?: string }) {\n129:   if (!items.length) return <div className=\"mb-6 flex items-center justify-between gap-4 rounded-2xl bg-[#eff3e7] px-5 py-5 sm:px-6\">\n130:     <div><div className=\"mb-2 flex items-center gap-2 text-xs font-semibold text-[#6d8250]\"><Sparkles size={14} /> THE NEXT GREAT SCORE COULD BE YOURS</div><p className=\"text-lg font-semibold tracking-tight\">Every legend starts at zero.</p><p className=\"mt-1 text-xs text-muted\">Play your best. Claim your place.</p></div>\n131:     <div aria-hidden=\"true\" className=\"flex h-20 shrink-0 items-end gap-1.5 text-center font-mono text-sm font-bold\"><div className=\"flex h-10 w-9 items-center justify-center rounded-t-lg bg-forest/10 text-forest/50\">2</div><div className=\"flex h-16 w-11 flex-col items-center justify-center gap-1 rounded-t-lg bg-lime\"><Crown size={18} />1</div><div className=\"flex h-8 w-9 items-center justify-center rounded-t-lg bg-forest/10 text-forest/50\">3</div></div>\n132:   </div>;\n133:   return <div className=\"mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3\">\n134:     {items.map((item, index) => <div key={item.player} className={`relative overflow-hidden rounded-2xl border p-4 ${index === 0 ? \"border-[#d9e8bd] bg-[#eff5e4]\" : \"border-line bg-paper/60\"}`}>\n135:       <div className=\"mb-4 flex items-center justify-between\"><span className={`flex size-7 items-center justify-center rounded-lg ${index === 0 ? \"bg-lime text-forest\" : index === 1 ? \"bg-[#e6e8ec] text-[#7e858e]\" : \"bg-[#efe3d5] text-[#a57c52]\"}`}><Medal size={16} /></span><span className=\"font-mono text-[11px] text-muted\">0{item.rank} / {index === 0 ? \"THE ONE TO BEAT\" : index === 1 ? \"RUNNER UP\" : \"ON THE PODIUM\"}</span></div>\n136:       <div className=\"flex items-center gap-2.5\"><Avatar name={item.player} className=\"size-8\" /><span className=\"truncate text-sm font-semibold\">{item.player}</span>{item.player === username && <span className=\"text-[10px] text-muted\">YOU</span>}</div>\n137:       <p className=\"mt-3 truncate text-2xl font-bold tracking-tight tabular-nums\">{number(item.score)}<span className=\"ml-1.5 text-[11px] font-normal text-muted\">pts</span></p>\n138:     </div>)}\n139:   </div>;\n140: }\n141: \n142: function Leaderboard({ user, refresh, onRefresh, onJoin }: { user: User | null; refresh: number; onRefresh: () => void; onJoin: () => void }) {\n143:   const [period, setPeriod] = useState<Period>(\"all\");\n144:   const [search, setSearch] = useState(\"\");\n145:   const query = useDeferredValue(search);\n146:   const [limit, setLimit] = useState(25);\n147:   const [board, setBoard] = useState<Board>({ items: [], total: 0 });\n148:   const [podium, setPodium] = useState<RankedPlayer[]>([]);\n149:   const [busy, setBusy] = useState(true);\n150:   const [error, setError] = useState(\"\");\n151:   useEffect(() => {\n152:     const controller = new AbortController();\n153:     setBusy(true); setError(\"\");\n154:     Promise.all([\n155:       api<Board>(`/leaderboard?period=${period}&limit=${limit}&player=${encodeURIComponent(query)}`, { signal: controller.signal }),\n156:       api<Board>(`/leaderboard?period=${period}&limit=3`, { signal: controller.signal }),\n157:     ]).then(([board, top]) => { setBoard(board); setPodium(top.items); })\n158:       .catch(error => { if (!controller.signal.aborted) setError(message(error)); })\n159:       .finally(() => { if (!controller.signal.aborted) setBusy(false); });\n160:     return () => controller.abort();\n161:   }, [period, query, limit, refresh]);\n162:   return <section id=\"leaderboard\" className=\"min-w-0 rounded-[1.4rem] border border-line bg-white p-5 sm:p-7\">\n163:     <div className=\"mb-6 flex items-center justify-between gap-3\"><div><h2 className=\"text-xl font-bold tracking-tight\">The leaderboard</h2><p className=\"mt-1 text-xs text-muted\">One player. One best score. All the glory.</p></div><span className=\"flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 text-[10px] font-medium text-muted\"><span className=\"size-1.5 rounded-full bg-[#90b852]\" /> LIVE RANKINGS</span></div>\n164:     <div className=\"mb-6 flex flex-wrap items-center justify-between gap-3\">\n165:       <div className=\"flex rounded-xl bg-paper p-1\" role=\"tablist\" aria-label=\"Leaderboard period\">{periods.map(tab => <button key={tab.value} role=\"tab\" aria-selected={period === tab.value} onClick={() => setPeriod(tab.value)} className={`${button} rounded-lg px-4 py-2 text-xs sm:px-5 ${period === tab.value ? \"bg-forest text-white shadow-sm\" : \"text-muted hover:text-forest\"}`}>{tab.label}</button>)}</div>\n166:       <button onClick={onRefresh} disabled={busy} className={`${button} gap-1.5 px-2 py-2 text-xs text-muted hover:text-forest`}><RefreshCw size={14} className={busy ? \"animate-spin\" : \"\"} />Refresh</button>\n167:     </div>\n168:     {!busy && !error && <Podium items={podium} username={user?.username} />}\n169:     <div className=\"mb-4 flex items-center justify-between gap-3\"><div className=\"relative min-w-0 flex-1\"><Search size={16} className=\"absolute left-3.5 top-3 text-muted\" /><input aria-label=\"Search players\" placeholder=\"Find a player...\" maxLength={32} value={search} onChange={e => setSearch(e.target.value)} className={`${field} bg-paper/50 py-2.5 pl-10 pr-9 text-xs`} />{search && <button aria-label=\"Clear search\" className=\"absolute right-3 top-3 text-muted\" onClick={() => setSearch(\"\")}><X size={15} /></button>}</div><select aria-label=\"Leaderboard size\" value={limit} onChange={e => setLimit(Number(e.target.value))} className=\"rounded-xl border border-line bg-white px-2 py-2.5 text-xs text-muted outline-forest\"><option value={25}>Top 25</option><option value={50}>Top 50</option><option value={100}>Top 100</option><option value={1000}>Top 1,000</option></select></div>\n170:     {error ? <div className=\"space-y-3 py-4\"><Notice>{error}</Notice><button onClick={onRefresh} className={`${button} px-3 py-2 text-forest`}><RefreshCw size={14} />Try again</button></div> : <div className=\"overflow-x-auto\">\n171:       <table className=\"w-full text-left text-sm\" aria-label=\"Player leaderboard\" aria-busy={busy}>\n172:         <thead><tr className=\"border-y border-line bg-paper/50 text-[10px] font-medium uppercase tracking-wider text-muted\"><th className=\"w-16 py-3 pl-3 font-medium\">Rank</th><th className=\"py-3 font-medium\">Player</th><th className=\"py-3 text-right font-medium\"><span className=\"inline-flex items-center gap-1\">Score<ArrowDown size={11} /></span></th><th className=\"py-3 pl-5 pr-3 text-right font-medium\">Achieved</th></tr></thead>\n173:         <tbody>{busy ? Array.from({ length: 5 }, (_, index) => <tr key={index} className=\"border-b border-line/70\"><td colSpan={4} className=\"py-4\"><div className=\"h-7 animate-pulse rounded-lg bg-paper\" /></td></tr>) : board.items.map(item => <tr key={item.player} className={`border-b border-line/70 transition-colors ${user?.username === item.player ? \"bg-lime/25\" : \"hover:bg-paper/60\"}`}>\n174:           <td className=\"py-4 pl-3\"><span className={`inline-flex size-7 items-center justify-center rounded-lg font-mono text-xs ${item.rank === 1 ? \"bg-lime text-forest\" : item.rank === 2 ? \"bg-[#eceef1] text-[#79808a]\" : item.rank === 3 ? \"bg-[#f2e6da] text-[#a17c56]\" : \"text-muted\"}`}>{item.rank <= 3 ? <Medal size={16} aria-label={`Rank ${item.rank}`} /> : String(item.rank).padStart(2, \"0\")}</span></td>\n175:           <td className=\"py-4\"><div className=\"flex items-center gap-2.5\"><Avatar name={item.player} /><span className=\"max-w-32 truncate text-xs font-semibold sm:max-w-44\">{item.player}</span>{user?.username === item.player && <span className=\"rounded bg-forest/8 px-1.5 py-0.5 text-[9px] font-bold text-forest\">YOU</span>}</div></td>\n176:           <td className=\"py-4 text-right font-mono text-xs font-semibold tabular-nums\">{number(item.score)}</td><td className=\"whitespace-nowrap py-4 pl-5 pr-3 text-right text-[11px] text-muted\"><time dateTime={item.achieved_at} title={date(item.achieved_at, true)}>{date(item.achieved_at)}</time></td>\n177:         </tr>)}</tbody>\n178:       </table>\n179:       {!busy && !board.items.length && <div className=\"flex flex-col items-center px-3 py-12 text-center\"><div className=\"mb-4 flex size-12 items-center justify-center rounded-2xl bg-paper text-forest/60\">{search ? <Search size={23} /> : <Trophy size={23} />}</div><h3 className=\"text-base font-semibold\">{search ? \"No players found\" : period === \"all\" ? \"Be the first on the board.\" : \"A fresh start. A new high.\"}</h3><p className=\"mt-2 max-w-xs text-xs leading-relaxed text-muted\">{search ? `No ranked players match “${search}”. Try another name.` : \"No scores here yet. Submit a score and set the standard.\"}</p>{search ? <button onClick={() => setSearch(\"\")} className={`${button} mt-5 text-xs underline underline-offset-4`}>Clear search</button> : <button onClick={user ? () => document.getElementById(\"score-input\")?.focus() : onJoin} className={`${button} mt-5 bg-forest px-4 py-2.5 text-xs text-white`}>{user ? \"Submit your first score\" : \"Join the leaderboard\"}<ArrowUpRight size={14} /></button>}</div>}\n180:     </div>}\n181:     <div className=\"mt-5 flex flex-wrap items-center justify-between gap-2 text-[10px] text-muted\"><span>{busy ? \"Updating rankings...\" : `Showing ${number(board.items.length)} of ${number(board.total)} ${search ? \"matching \" : \"\"}players`}</span><span className=\"flex items-center gap-1.5\"><ShieldCheck size={12} />Fair play. Visible scores only.</span></div>\n182:   </section>;\n183: }\n184: \n185: function PlayerPanel({ user, token, refresh, onRefresh, onJoin }: { user: User | null; token: string | null; refresh: number; onRefresh: () => void; onJoin: () => void }) {\n186:   const [value, setValue] = useState(\"\");\n187:   const [busy, setBusy] = useState(false);\n188:   const [result, setResult] = useState<Submission | null>(null);\n189:   const [error, setError] = useState(\"\");\n190:   const [personal, setPersonal] = useState<PersonalScores | null>(null);\n191:   const [historyError, setHistoryError] = useState(\"\");\n192:   const [historyBusy, setHistoryBusy] = useState(false);\n193:   const [showAll, setShowAll] = useState(false);\n194:   useEffect(() => {\n195:     setResult(null); setError(\"\"); setValue(\"\"); setPersonal(null); setShowAll(false);\n196:   }, [token]);\n197:   useEffect(() => {\n198:     if (!token || !user) { setPersonal(null); return; }\n199:     const controller = new AbortController();\n200:     setHistoryBusy(true); setHistoryError(\"\");\n201:     api<PersonalScores>(\"/scores\", { signal: controller.signal }, token)\n202:       .then(setPersonal).catch(error => { if (!controller.signal.aborted) setHistoryError(message(error)); })\n203:       .finally(() => { if (!controller.signal.aborted) setHistoryBusy(false); });\n204:     return () => controller.abort();\n205:   }, [token, user, refresh]);\n206:   async function submit(event: FormEvent) {\n207:     event.preventDefault(); setError(\"\"); setResult(null);\n208:     const score = Number(value);\n209:     if (!/^\\d+$/.test(value) || !Number.isSafeInteger(score) || score < 0) { setError(\"Enter a valid, non-negative whole number.\"); return; }\n210:     setBusy(true);\n211:     try {\n212:       const result = await api<Submission>(\"/scores\", { method: \"POST\", body: JSON.stringify({ score }) }, token);\n213:       setResult(result); setValue(\"\"); onRefresh();\n214:     } catch (error) { setError(message(error)); }\n215:     finally { setBusy(false); }\n216:   }\n217:   return <aside className=\"space-y-5\">\n218:     <section className=\"relative overflow-hidden rounded-[1.4rem] border border-[#dce7cd] bg-[#edf3e5] p-6\">\n219:       <div className=\"mb-5 flex items-center justify-between\"><span className=\"flex size-10 items-center justify-center rounded-xl bg-white/70\"><Zap size={20} strokeWidth={1.7} /></span><span className=\"text-[10px] font-semibold tracking-[0.12em] text-[#7b8b69]\">YOUR NEXT MOVE</span></div>\n220:       <h2 className=\"text-xl font-bold tracking-tight\">Got a new high?</h2><p className=\"mb-6 mt-2 text-xs leading-relaxed text-muted\">Big win or a little progress.<br />Put your score on the board.</p>\n221:       {user ? <form className=\"space-y-3\" onSubmit={submit}><label htmlFor=\"score-input\" className=\"block text-xs font-semibold\">Your score</label><div className=\"relative\"><input id=\"score-input\" required type=\"number\" min=\"0\" max=\"9007199254740991\" step=\"1\" inputMode=\"numeric\" value={value} onChange={e => setValue(e.target.value)} className={`${field} border-[#dce7cd] py-3.5 pr-12 font-mono text-xl font-semibold`} placeholder=\"0\" /><span className=\"absolute right-4 top-5 text-xs text-muted\">pts</span></div>{error && <Notice>{error}</Notice>}<button disabled={busy} className={`${button} w-full bg-forest py-3.5 text-white hover:bg-forest/90`}>{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : <Plus size={17} />}Submit score</button>{result && <div role=\"status\" className=\"rounded-xl border border-forest/10 bg-white/70 p-4\"><div className=\"flex items-center gap-2 text-xs font-semibold\"><Check size={15} />{number(result.score)} points submitted</div><p className=\"mt-2 text-sm\">Your all-time rank: <strong>#{number(result.rank)}</strong></p>{result.personal_best && <p className=\"mt-2 flex items-center gap-1.5 text-xs font-semibold text-[#648735]\"><Sparkles size={15} />New personal best!</p>}</div>}<p className=\"pt-1 text-center text-[10px] text-muted\">Make it count. Keep it honest.</p></form> : <><div className=\"mb-4 rounded-xl border border-[#dce7cd] bg-white/60 px-4 py-4\"><div className=\"flex items-center justify-between\"><span className=\"font-mono text-2xl font-semibold text-forest/25\">000,000</span><span className=\"text-xs text-muted\">pts</span></div></div><button onClick={onJoin} className={`${button} w-full bg-forest py-3.5 text-white hover:bg-forest/90`}>Sign in to submit<ArrowRight size={16} /></button><p className=\"mt-3 text-center text-[10px] text-muted\">Your personal best is waiting.</p></>}\n222:     </section>\n223:     <section className=\"rounded-[1.4rem] border border-line bg-white p-6\">\n224:       <div className=\"mb-5 flex items-center justify-between\"><h2 className=\"text-base font-bold tracking-tight\">Your scorecard</h2><Target size={18} className=\"text-muted\" /></div>\n225:       <div className=\"mb-5 rounded-xl bg-paper px-4 py-4\"><p className=\"mb-2 flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-wider text-muted\"><Award size={13} />Personal best</p><p className=\"truncate font-mono text-3xl font-semibold tracking-tight\">{user && personal?.best_score != null ? number(personal.best_score) : \"—\"}<span className=\"ml-2 font-sans text-xs font-normal text-muted\">pts</span></p><p className=\"mt-2 text-[10px] text-muted\">{user ? \"Your best visible score, all time.\" : \"Sign in to track your progress.\"}</p></div>\n226:       <div className=\"mb-4 flex items-center justify-between\"><h3 className=\"text-xs font-semibold\">Recent submissions</h3><Clock3 size={13} className=\"text-muted\" /></div>\n227:       {historyError ? <div className=\"space-y-2\"><Notice>{historyError}</Notice><button onClick={onRefresh} className={`${button} py-2 text-xs`}>Retry</button></div> : historyBusy ? <div className=\"space-y-3\">{[1, 2, 3].map(n => <div key={n} className=\"h-9 animate-pulse rounded-lg bg-paper\" />)}</div> : user && personal?.items.length ? <><ul className=\"divide-y divide-line\">{(showAll ? personal.items : personal.items.slice(0, 5)).map(score => <li key={score.id} className=\"flex items-center justify-between gap-3 py-3 first:pt-0\"><div><p className={`font-mono text-sm font-semibold tabular-nums ${score.is_hidden ? \"text-muted line-through\" : \"\"}`}>{number(score.score)}<span className=\"ml-1.5 font-sans text-[10px] font-normal text-muted\">pts</span></p><time dateTime={score.achieved_at} className=\"mt-1 block text-[10px] text-muted\">{date(score.achieved_at, true)}</time></div>{score.is_hidden ? <span title=\"Hidden by the admin; excluded from rankings\" className=\"rounded-full bg-[#f3ece5] px-2 py-1 text-[9px] text-[#997958]\">Hidden</span> : score.score === personal.best_score ? <span title=\"Personal best\" className=\"text-[#8caa51]\"><Sparkles size={15} /></span> : <Check size={13} className=\"text-muted/50\" />}</li>)}</ul>{personal.items.length > 5 && <button onClick={() => setShowAll(!showAll)} className={`${button} mt-3 w-full py-2 text-xs text-muted`}>{showAll ? \"Show recent only\" : `View all ${number(personal.items.length)} submissions`}<ChevronRight size={13} /></button>}</> : <div className=\"rounded-xl border border-dashed border-line px-4 py-6 text-center\"><Hash size={19} className=\"mx-auto mb-2 text-muted/50\" /><p className=\"text-xs text-muted\">{user ? \"Your story starts with one score.\" : \"A little friendly competition?\"}</p><p className=\"mt-1 text-[10px] text-muted/70\">{user ? \"Submit your first score above.\" : \"Sign in to see your recent games.\"}</p></div>}\n228:     </section>\n229:     <div className=\"flex gap-3 px-2 py-1\"><ShieldCheck size={19} className=\"mt-0.5 shrink-0 text-[#819565]\" /><p className=\"text-[11px] leading-relaxed text-muted\"><strong className=\"font-semibold text-forest/80\">Good games. Fair play.</strong><br />Scores are reviewed to keep the competition honest. Hidden scores don't affect rankings.</p></div>\n230:   </aside>;\n231: }\n232: \n233: function AdminPanel({ token, refresh, onRefresh }: { token: string; refresh: number; onRefresh: () => void }) {\n234:   const [page, setPage] = useState(1);\n235:   const [pageSize, setPageSize] = useState(20);\n236:   const [data, setData] = useState<AdminScores | null>(null);\n237:   const [busy, setBusy] = useState(true);\n238:   const [toggling, setToggling] = useState<number | null>(null);\n239:   const [error, setError] = useState(\"\");\n240:   useEffect(() => {\n241:     const controller = new AbortController(); setBusy(true); setError(\"\");\n242:     api<AdminScores>(`/admin/scores?page=${page}&page_size=${pageSize}`, { signal: controller.signal }, token)\n243:       .then(setData).catch(error => { if (!controller.signal.aborted) setError(message(error)); })\n244:       .finally(() => { if (!controller.signal.aborted) setBusy(false); });\n245:     return () => controller.abort();\n246:   }, [page, pageSize, token, refresh]);\n247:   async function toggle(id: number) {\n248:     setToggling(id); setError(\"\");\n249:     try { await api(`/admin/scores/${id}/toggle`, { method: \"POST\" }, token); onRefresh(); }\n250:     catch (error) { setError(message(error)); }\n251:     finally { setToggling(null); }\n252:   }\n253:   const pages = Math.max(1, Math.ceil((data?.total || 0) / pageSize));\n254:   return <section className=\"mt-7 rounded-[1.4rem] border border-line bg-white p-5 sm:p-7\">\n255:     <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4\"><div><div className=\"flex items-center gap-2\"><ShieldCheck size={21} /><h2 className=\"text-xl font-bold tracking-tight\">Score moderation</h2><span className=\"rounded-md bg-lime px-2 py-1 text-[9px] font-bold\">ADMIN</span></div><p className=\"mt-2 text-xs text-muted\">Keep the playing field level. Hide implausible scores or restore them.</p></div><button disabled={busy} onClick={onRefresh} className={`${button} border border-line px-3 py-2 text-xs`}><RefreshCw size={14} className={busy ? \"animate-spin\" : \"\"} />Refresh</button></div>\n256:     {error && <div className=\"mb-4\"><Notice>{error}</Notice></div>}\n257:     <div className=\"overflow-x-auto\"><table className=\"w-full text-left text-xs\" aria-label=\"All scores for moderation\" aria-busy={busy}><thead><tr className=\"border-y border-line bg-paper/50 text-[10px] uppercase tracking-wider text-muted\"><th className=\"p-3 font-medium\">ID</th><th className=\"p-3 font-medium\">Player</th><th className=\"p-3 text-right font-medium\">Score</th><th className=\"p-3 font-medium\">Submitted</th><th className=\"p-3 font-medium\">Status</th><th className=\"p-3 text-right font-medium\">Action</th></tr></thead><tbody>{data?.items.map(score => <tr key={score.id} className={`border-b border-line ${score.is_hidden ? \"bg-paper/70 text-muted\" : \"\"}`}><td className=\"p-3 font-mono text-muted\">#{score.id}</td><td className=\"p-3\"><div className=\"flex items-center gap-2\"><Avatar name={score.player} /><span className=\"font-semibold\">{score.player}</span></div></td><td className={`p-3 text-right font-mono font-semibold ${score.is_hidden ? \"line-through\" : \"\"}`}>{number(score.score)}</td><td className=\"whitespace-nowrap p-3 text-muted\">{date(score.achieved_at, true)}</td><td className=\"p-3\"><span className={`rounded-full px-2.5 py-1 text-[10px] ${score.is_hidden ? \"bg-[#f3e9df] text-[#99734d]\" : \"bg-[#edf3e5] text-[#6a8445]\"}`}>{score.is_hidden ? \"Hidden\" : \"Visible\"}</span></td><td className=\"p-3 text-right\"><button disabled={toggling !== null || busy} onClick={() => toggle(score.id)} aria-label={`${score.is_hidden ? \"Show\" : \"Hide\"} score ${score.id} by ${score.player}`} className={`${button} border border-line px-3 py-2 text-xs hover:bg-paper`}>{toggling === score.id ? <LoaderCircle size={13} className=\"animate-spin\" /> : score.is_hidden ? <Eye size={13} /> : <EyeOff size={13} />}{score.is_hidden ? \"Show\" : \"Hide\"}</button></td></tr>)}</tbody></table>{busy && <div className=\"py-8 text-center text-xs text-muted\">Loading scores...</div>}{!busy && !data?.items.length && <div className=\"py-10 text-center text-sm text-muted\">No submissions to review.</div>}</div>\n258:     <div className=\"mt-5 flex flex-wrap items-center justify-between gap-3 text-xs text-muted\"><span>{number(data?.total || 0)} total submissions</span><div className=\"flex items-center gap-3\"><select aria-label=\"Scores per page\" value={pageSize} onChange={e => { setPageSize(Number(e.target.value)); setPage(1); }} className=\"rounded-lg border border-line bg-white px-2 py-2\"><option value={20}>20 / page</option><option value={50}>50 / page</option><option value={100}>100 / page</option></select><button aria-label=\"Previous page\" disabled={page <= 1 || busy} onClick={() => setPage(page - 1)} className={`${button} size-8 border border-line`}><ChevronLeft size={15} /></button><span>{page} / {pages}</span><button aria-label=\"Next page\" disabled={page >= pages || busy} onClick={() => setPage(page + 1)} className={`${button} size-8 border border-line`}><ChevronRight size={15} /></button></div></div>\n259:   </section>;\n260: }\n261: \n262: export default function App() {\n263:   const [token, setToken] = useState(savedToken);\n264:   const [user, setUser] = useState<User | null>(null);\n265:   const [authReady, setAuthReady] = useState(!token);\n266:   const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n267:   const [showHelp, setShowHelp] = useState(false);\n268:   const [refresh, setRefresh] = useState(0);\n269:   const [summary, setSummary] = useState<Board | null>(null);\n270:   const [sessionNotice, setSessionNotice] = useState(\"\");\n271:   const [signingOut, setSigningOut] = useState(false);\n272:   useEffect(() => {\n273:     const expired = () => { saveToken(null); setToken(null); setUser(null); setAuthReady(true); setSessionNotice(\"Your session expired. Sign in again to keep playing.\"); };\n274:     window.addEventListener(\"session-expired\", expired);\n275:     return () => window.removeEventListener(\"session-expired\", expired);\n276:   }, []);\n277:   useEffect(() => {\n278:     if (!token) { setAuthReady(true); return; }\n279:     const controller = new AbortController();\n280:     api<User>(\"/auth/me\", { signal: controller.signal }, token).then(setUser)\n281:       .catch(error => { if (!controller.signal.aborted) setSessionNotice(message(error)); })\n282:       .finally(() => { if (!controller.signal.aborted) setAuthReady(true); });\n283:     return () => controller.abort();\n284:   }, [token]);\n285:   useEffect(() => {\n286:     const controller = new AbortController();\n287:     api<Board>(\"/leaderboard?limit=1\", { signal: controller.signal }).then(setSummary).catch(() => {});\n288:     return () => controller.abort();\n289:   }, [refresh]);\n290:   function signedIn(token: string, user: User) {\n291:     saveToken(token); setToken(token); setUser(user); setAuthReady(true); setAuthMode(null); setSessionNotice(\"\"); setRefresh(value => value + 1);\n292:   }\n293:   async function signOut() {\n294:     setSigningOut(true);\n295:     try {\n296:       await api(\"/auth/logout\", { method: \"POST\" }, token);\n297:       saveToken(null); setToken(null); setUser(null); setSessionNotice(\"\");\n298:     } catch (error) { setSessionNotice(message(error)); }\n299:     finally { setSigningOut(false); }\n300:   }\n301:   const doRefresh = () => setRefresh(value => value + 1);\n302:   return <div className=\"min-h-screen bg-paper font-sans text-forest antialiased selection:bg-lime\">\n303:     <header className=\"border-b border-line bg-white/60\"><div className=\"mx-auto flex h-20 max-w-[1200px] items-center justify-between gap-2 px-5 sm:gap-4 sm:px-8\">\n304:       <a href=\"/\" aria-label=\"Highscore home\" className=\"flex shrink-0 items-center gap-1.5 sm:gap-2.5\"><span className=\"flex size-8 items-center justify-center rounded-xl bg-forest text-lime sm:size-9\"><ArrowUpRight size={26} strokeWidth={2.3} /></span><span className=\"text-lg font-extrabold tracking-[-0.07em] sm:text-xl\">highscore<span className=\"text-[#8faf55]\">.</span></span></a>\n305:       <nav aria-label=\"Main navigation\" className=\"hidden h-full items-center gap-8 md:flex\"><a href=\"#leaderboard\" className=\"flex h-full items-center gap-2 border-b-2 border-forest px-1 text-xs font-semibold\"><Trophy size={15} />Leaderboard</a><button onClick={() => setShowHelp(true)} className=\"flex items-center gap-1.5 text-xs text-muted transition-colors hover:text-forest\">How it works<ArrowUpRight size={12} /></button></nav>\n306:       <div className=\"flex items-center gap-3\">{!authReady ? <LoaderCircle size={20} className=\"animate-spin text-muted\" /> : user ? <><div className=\"flex items-center gap-2\"><Avatar name={user.username} className=\"hidden size-8 sm:inline-flex\" /><span className=\"max-w-20 truncate text-xs font-semibold sm:max-w-40\" title={user.username}>{user.username}</span>{user.is_admin && <ShieldCheck size={14} className=\"text-muted\" aria-label=\"Admin account\" />}</div><button onClick={signOut} aria-label=\"Sign out\" disabled={signingOut} className={`${button} border border-line bg-white px-3 py-2.5 text-xs hover:bg-paper`}><LogOut size={14} /><span className=\"hidden sm:inline\">Sign out</span></button></> : <><button onClick={() => setAuthMode(\"login\")} className={`${button} px-2 py-2.5 text-xs hover:text-muted`}>Sign in</button><button onClick={() => setAuthMode(\"register\")} aria-label=\"Join the game\" className={`${button} bg-forest px-4 py-2.5 text-xs text-white hover:bg-forest/90`}><span className=\"sm:hidden\">Join</span><span className=\"hidden sm:inline\">Join the game</span><ArrowUpRight size={14} /></button></>}</div>\n307:     </div></header>\n308:     <main className=\"mx-auto max-w-[1200px] px-5 pb-12 sm:px-8\">\n309:       {sessionNotice && <div className=\"mt-5 flex items-center gap-3 rounded-xl border border-line bg-white p-4 text-xs text-muted\" role=\"status\"><span className=\"flex-1\">{sessionNotice}</span><button onClick={() => setAuthMode(\"login\")} className=\"font-semibold text-forest underline\">Sign in</button><button aria-label=\"Dismiss notification\" onClick={() => setSessionNotice(\"\")}><X size={15} /></button></div>}\n310:       <section className=\"flex items-center justify-between gap-8 py-10 sm:py-12\"><div><div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[0.16em] text-muted\"><span className=\"flex size-5 items-center justify-center rounded-md bg-lime\"><Gamepad2 size={13} className=\"text-forest\" /></span>A LITTLE COMPETITION. A LOT OF FUN.</div><h1 className=\"text-[44px] font-bold leading-[1.08] tracking-[-0.055em] sm:text-[58px]\">Good games.<br />Great scores<span className=\"text-[#91ae61]\">.</span></h1><p className=\"mt-5 max-w-md text-sm leading-6 text-muted\">Chase your personal best. Climb the ranks.<br className=\"hidden sm:block\" /> See how you stack up with the community.</p></div><HeroArtwork /></section>\n311:       <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your next challenge\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n312:       <div className=\"grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_310px]\"><Leaderboard user={user} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"register\")} /><PlayerPanel user={user} token={token} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"login\")} /></div>\n313:       {user?.is_admin && token && <AdminPanel token={token} refresh={refresh} onRefresh={doRefresh} />}\n314:       <section className=\"mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line px-6 py-5\"><div className=\"flex items-center gap-3\"><span className=\"flex size-9 items-center justify-center rounded-xl bg-white\"><Trophy size={18} strokeWidth={1.5} /></span><div><p className=\"text-xs font-semibold\">It's not just about the top spot.</p><p className=\"mt-1 text-[11px] text-muted\">It's about beating your last best. You've got this.</p></div></div><button onClick={() => setShowHelp(true)} className={`${button} text-xs text-muted hover:text-forest`}>The rules of the game<ArrowUpRight size={14} /></button></section>\n315:     </main>\n316:     <footer className=\"border-t border-line\"><div className=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-5 py-6 text-[10px] text-muted sm:px-8\"><span className=\"font-semibold tracking-tight\">highscore. <span className=\"ml-2 font-normal\">Made for the love of the game.</span></span><div className=\"flex items-center gap-5\"><span className=\"flex items-center gap-1.5\"><span className=\"size-1.5 rounded-full bg-[#94af68]\" />All rankings in UTC</span><button onClick={() => setShowHelp(true)} aria-label=\"How Highscore works\" className=\"hover:text-forest\"><CircleHelp size={15} /></button></div></div></footer>\n317:     {authMode && <AuthModal mode={authMode} onMode={setAuthMode} onClose={() => setAuthMode(null)} onSignedIn={signedIn} />}\n318:     {showHelp && <Modal title=\"Play. Post. Climb.\" onClose={() => setShowHelp(false)}><p className=\"mb-6 text-sm leading-relaxed text-muted\">Friendly competition, simple rules.</p><ol className=\"space-y-5\">{[{ title: \"Make it yours\", text: \"Create an account and submit a non-negative whole-number score. Every submission belongs to you and is dated by the server.\" }, { title: \"Your best takes the stage\", text: \"Each player appears once, ranked by their best visible score. Ties go to the score achieved first. Search keeps the original ranks.\" }, { title: \"Pick your playing field\", text: \"All time means every game. This week starts Monday at 00:00 UTC. Today starts at 00:00 UTC.\" }, { title: \"Keep the game fair\", text: \"The admin can hide implausible scores. Hidden submissions stay in your history but don't count toward your best or your rank.\" }].map((rule, index) => <li key={rule.title} className=\"flex gap-3\"><span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-lime font-mono text-xs font-semibold\">{index + 1}</span><div><h3 className=\"text-sm font-semibold\">{rule.title}</h3><p className=\"mt-1 text-xs leading-relaxed text-muted\">{rule.text}</p></div></li>)}</ol><button onClick={() => setShowHelp(false)} className={`${button} mt-7 w-full bg-forest py-3 text-white`}>Got it. Game on.<ArrowRight size={16} /></button></Modal>}\n319:     </div>;\n320: }\n\n(End of file - total 320 lines)\n</content>","metadata":{"preview":"import { useDeferredValue, useEffect, useRef, useState } from \"react\";\nimport type { FormEvent, ReactNode } from \"react\";\nimport {\n  ArrowDown, ArrowRight, ArrowUpRight, Award, Check, ChevronLeft,\n  ChevronRight, CircleHelp, Clock3, Crown, Eye, EyeOff, Gamepad2,\n  Hash, LoaderCircle, LogOut, Medal, Plus, RefreshCw, Search,\n  ShieldCheck, Sparkles, Target, Trophy, Users, X, Zap,\n} from \"lucide-react\";\nimport { api, date, message, number, savedToken, saveToken } from \"./api\";\nimport type { AdminScores, Board, Period, PersonalScores, RankedPlayer, Submission, User } from \"./api\";\n\nconst button = \"inline-flex items-center justify-center gap-2 rounded-xl text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forest disabled:cursor-not-allowed disabled:opacity-50\";\nconst field = \"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-forest outline-none transition focus:border-forest focus:ring-2 focus:ring-forest/10 placeholder:text-muted/70\";\nconst periods: { value: Period; label: string }[] = [\n  { value: \"all\", label: \"All time\" },\n  { value: \"week\", label: \"This week\" },\n  { value: \"today\", label: \"Today\" },\n];\n\nfunction Avatar({ name, className = \"\" }: { name: string; className?: string }) {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"import { useDeferredValue, useEffect, useRef, useState } from \"react\";\nimport type { FormEvent, ReactNode } from \"react\";\nimport {\n  ArrowDown, ArrowRight, ArrowUpRight, Award, Check, ChevronLeft,\n  ChevronRight, CircleHelp, Clock3, Crown, Eye, EyeOff, Gamepad2,\n  Hash, LoaderCircle, LogOut, Medal, Plus, RefreshCw, Search,\n  ShieldCheck, Sparkles, Target, Trophy, Users, X, Zap,\n} from \"lucide-react\";\nimport { api, date, message, number, savedToken, saveToken } from \"./api\";\nimport type { AdminScores, Board, Period, PersonalScores, RankedPlayer, Submission, User } from \"./api\";\n\nconst button = \"inline-flex items-center justify-center gap-2 rounded-xl text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forest disabled:cursor-not-allowed disabled:opacity-50\";\nconst field = \"w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-forest outline-none transition focus:border-forest focus:ring-2 focus:ring-forest/10 placeholder:text-muted/70\";\nconst periods: { value: Period; label: string }[] = [\n  { value: \"all\", label: \"All time\" },\n  { value: \"week\", label: \"This week\" },\n  { value: \"today\", label: \"Today\" },\n];\n\nfunction Avatar({ name, className = \"\" }: { name: string; className?: string }) {\n  const colors = [\"bg-[#eef0ff] text-[#7770ae]\", \"bg-[#fce8d6] text-[#ad7043]\", \"bg-[#e6efdf] text-[#647d4e]\", \"bg-[#f7e7ed] text-[#a65f7c]\", \"bg-[#e0eff1] text-[#4e8087]\"];\n  const hash = Array.from(name).reduce((sum, char) => sum + char.charCodeAt(0), 0);\n  return <span aria-hidden=\"true\" className={`inline-flex size-9 shrink-0 items-center justify-center rounded-full text-xs font-bold ${colors[hash % colors.length]} ${className}`}>{name.slice(0, 2).toUpperCase()}</span>;\n}\n\nfunction Notice({ children, success = false }: { children: ReactNode; success?: boolean }) {\n  return <div role={success ? \"status\" : \"alert\"} className={`rounded-xl px-4 py-3 text-sm leading-relaxed ${success ? \"bg-forest/7 text-forest\" : \"bg-red-50 text-red-700\"}`}>{children}</div>;\n}\n\nfunction Modal({ title, children, onClose }: { title: string; children: ReactNode; onClose: () => void }) {\n  const ref = useRef<HTMLDivElement>(null);\n  const closeRef = useRef(onClose);\n  useEffect(() => { closeRef.current = onClose; }, [onClose]);\n  useEffect(() => {\n    const previous = document.activeElement as HTMLElement | null;\n    const overflow = document.body.style.overflow;\n    document.body.style.overflow = \"hidden\";\n    ref.current?.querySelector<HTMLElement>(\"input, button\")?.focus();\n    const handleKey = (event: KeyboardEvent) => {\n      if (event.key === \"Escape\") closeRef.current();\n      if (event.key === \"Tab\") {\n        const elements = ref.current?.querySelectorAll<HTMLElement>(\"button:not([disabled]), input, a[href]\");\n        if (!elements?.length) return;\n        const first = elements[0], last = elements[elements.length - 1];\n        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }\n        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }\n      }\n    };\n    document.addEventListener(\"keydown\", handleKey);\n    return () => {\n      document.body.style.overflow = overflow;\n      document.removeEventListener(\"keydown\", handleKey);\n      previous?.focus();\n    };\n  }, []);\n  return <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-forest/35 p-4 backdrop-blur-sm\" onMouseDown={event => { if (event.target === event.currentTarget) onClose(); }}>\n    <div ref={ref} role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-title\" className=\"relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-3xl bg-paper p-7 shadow-2xl sm:p-9\">\n      <button onClick={onClose} aria-label=\"Close dialog\" className={`${button} absolute right-5 top-5 size-8 text-muted hover:bg-line`}><X size={18} /></button>\n      <div className=\"mb-6 flex size-12 items-center justify-center rounded-2xl bg-lime text-forest\"><Gamepad2 size={25} /></div>\n      <h2 id=\"modal-title\" className=\"mb-2 text-3xl font-bold tracking-tight\">{title}</h2>\n      {children}\n    </div>\n  </div>;\n}\n\nfunction AuthModal({ mode, onClose, onMode, onSignedIn }: {\n  mode: \"login\" | \"register\";\n  onClose: () => void;\n  onMode: (mode: \"login\" | \"register\") => void;\n  onSignedIn: (token: string, user: User) => void;\n}) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [registered, setRegistered] = useState(false);\n  const [showPassword, setShowPassword] = useState(false);\n  async function submit(event: FormEvent) {\n    event.preventDefault(); setBusy(true); setError(\"\");\n    try {\n      const body = JSON.stringify({ username, password });\n      if (mode === \"register\" && !registered) {\n        await api(\"/auth/register\", { method: \"POST\", body });\n        setRegistered(true);\n      }\n      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n      const user = await api<User>(\"/auth/me\", {}, token);\n      onSignedIn(token, user);\n    } catch (error) { setError(message(error)); }\n    finally { setBusy(false); }\n  }\n  return <Modal title={mode === \"login\" ? \"Welcome back.\" : \"Your next high starts here.\"} onClose={onClose}>\n    <p className=\"mb-7 text-sm leading-relaxed text-muted\">{mode === \"login\" ? \"Sign in, submit your best, and make your move.\" : \"Join the community. Every great player starts somewhere.\"}</p>\n    <form onSubmit={submit} className=\"space-y-4\">\n      <label className=\"block text-sm font-semibold\">Username<input required maxLength={32} pattern=\"[A-Za-z0-9_.\\-]+\" autoComplete=\"username\" value={username} onChange={e => setUsername(e.target.value)} className={`${field} mt-2`} placeholder=\"Your player name\" /></label>\n      <label className=\"block text-sm font-semibold\">Password<div className=\"relative mt-2\"><input required maxLength={256} type={showPassword ? \"text\" : \"password\"} autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={e => setPassword(e.target.value)} className={`${field} pr-12`} placeholder=\"Your secret combo\" /><button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute right-4 top-3.5 text-muted\">{showPassword ? <EyeOff size={18} /> : <Eye size={18} />}</button></div></label>\n      {mode === \"register\" && <p className=\"text-xs leading-relaxed text-muted\">Usernames can contain letters, numbers, dots, dashes and underscores.</p>}\n      {registered && error && <Notice success>Your account was created. Retry to sign in.</Notice>}\n      {error && <Notice>{error}</Notice>}\n      <button disabled={busy} className={`${button} w-full bg-forest py-3.5 text-white hover:bg-forest/90`}>{busy ? <LoaderCircle size={18} className=\"animate-spin\" /> : <ArrowRight size={18} />}{mode === \"login\" ? \"Sign in\" : registered ? \"Sign in to your new account\" : \"Create account\"}</button>\n    </form>\n    <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New to the game?\" : \"Already a player?\"} <button className=\"font-semibold text-forest underline underline-offset-4\" onClick={() => { onMode(mode === \"login\" ? \"register\" : \"login\"); setError(\"\"); setRegistered(false); }}>{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n  </Modal>;\n}\n\nfunction HeroArtwork() {\n  return <div aria-hidden=\"true\" className=\"relative hidden h-56 w-80 shrink-0 items-center justify-center md:flex\">\n    <div className=\"absolute size-52 rounded-full border border-forest/10\" />\n    <div className=\"absolute size-64 rounded-full border border-dashed border-forest/10\" />\n    <div className=\"absolute left-10 top-9 -rotate-12 rounded-lg border border-forest/15 bg-white px-3 py-1.5 font-mono text-xs font-bold shadow-sm\">1UP <span className=\"text-[#80a543]\">↑</span></div>\n    <Sparkles className=\"absolute right-8 top-7 text-[#88a64e]\" size={26} />\n    <Plus className=\"absolute bottom-7 left-8 text-forest/40\" size={20} />\n    <div className=\"relative flex size-40 -rotate-8 items-center justify-center rounded-[2.5rem] bg-lime shadow-[8px_10px_0_0_#203c32] ring-1 ring-forest/10\">\n      <Trophy className=\"text-forest\" size={85} strokeWidth={1.3} />\n      <span className=\"absolute bottom-8 font-mono text-[11px] font-bold\">GO FOR GREAT.</span>\n    </div>\n    <div className=\"absolute bottom-5 right-3 rotate-6 rounded-full border border-forest/10 bg-white px-4 py-2 text-xs font-bold shadow-sm\"><span className=\"mr-2 inline-block size-2 rounded-full bg-[#91b84c]\" />EVERY GAME COUNTS</div>\n  </div>;\n}\n\nfunction Stat({ icon, label, value, detail }: { icon: ReactNode; label: string; value: string; detail: string }) {\n  return <div className=\"flex items-center gap-4 rounded-2xl border border-line bg-white/70 px-5 py-5 sm:px-6\">\n    <div className=\"flex size-11 shrink-0 items-center justify-center rounded-xl bg-paper text-forest/70\">{icon}</div>\n    <div className=\"min-w-0\"><p className=\"text-xs font-medium text-muted\">{label}</p><p className=\"mt-1 truncate text-2xl font-semibold tracking-tight tabular-nums\">{value}</p><p className=\"mt-0.5 text-[11px] text-muted\">{detail}</p></div>\n  </div>;\n}\n\nfunction Podium({ items, username }: { items: RankedPlayer[]; username?: string }) {\n  if (!items.length) return <div className=\"mb-6 flex items-center justify-between gap-4 rounded-2xl bg-[#eff3e7] px-5 py-5 sm:px-6\">\n    <div><div className=\"mb-2 flex items-center gap-2 text-xs font-semibold text-[#6d8250]\"><Sparkles size={14} /> THE NEXT GREAT SCORE COULD BE YOURS</div><p className=\"text-lg font-semibold tracking-tight\">Every legend starts at zero.</p><p className=\"mt-1 text-xs text-muted\">Play your best. Claim your place.</p></div>\n    <div aria-hidden=\"true\" className=\"flex h-20 shrink-0 items-end gap-1.5 text-center font-mono text-sm font-bold\"><div className=\"flex h-10 w-9 items-center justify-center rounded-t-lg bg-forest/10 text-forest/50\">2</div><div className=\"flex h-16 w-11 flex-col items-center justify-center gap-1 rounded-t-lg bg-lime\"><Crown size={18} />1</div><div className=\"flex h-8 w-9 items-center justify-center rounded-t-lg bg-forest/10 text-forest/50\">3</div></div>\n  </div>;\n  return <div className=\"mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3\">\n    {items.map((item, index) => <div key={item.player} className={`relative overflow-hidden rounded-2xl border p-4 ${index === 0 ? \"border-[#d9e8bd] bg-[#eff5e4]\" : \"border-line bg-paper/60\"}`}>\n      <div className=\"mb-4 flex items-center justify-between\"><span className={`flex size-7 items-center justify-center rounded-lg ${index === 0 ? \"bg-lime text-forest\" : index === 1 ? \"bg-[#e6e8ec] text-[#7e858e]\" : \"bg-[#efe3d5] text-[#a57c52]\"}`}><Medal size={16} /></span><span className=\"font-mono text-[11px] text-muted\">0{item.rank} / {index === 0 ? \"THE ONE TO BEAT\" : index === 1 ? \"RUNNER UP\" : \"ON THE PODIUM\"}</span></div>\n      <div className=\"flex items-center gap-2.5\"><Avatar name={item.player} className=\"size-8\" /><span className=\"truncate text-sm font-semibold\">{item.player}</span>{item.player === username && <span className=\"text-[10px] text-muted\">YOU</span>}</div>\n      <p className=\"mt-3 truncate text-2xl font-bold tracking-tight tabular-nums\">{number(item.score)}<span className=\"ml-1.5 text-[11px] font-normal text-muted\">pts</span></p>\n    </div>)}\n  </div>;\n}\n\nfunction Leaderboard({ user, refresh, onRefresh, onJoin }: { user: User | null; refresh: number; onRefresh: () => void; onJoin: () => void }) {\n  const [period, setPeriod] = useState<Period>(\"all\");\n  const [search, setSearch] = useState(\"\");\n  const query = useDeferredValue(search);\n  const [limit, setLimit] = useState(25);\n  const [board, setBoard] = useState<Board>({ items: [], total: 0 });\n  const [podium, setPodium] = useState<RankedPlayer[]>([]);\n  const [busy, setBusy] = useState(true);\n  const [error, setError] = useState(\"\");\n  useEffect(() => {\n    const controller = new AbortController();\n    setBusy(true); setError(\"\");\n    Promise.all([\n      api<Board>(`/leaderboard?period=${period}&limit=${limit}&player=${encodeURIComponent(query)}`, { signal: controller.signal }),\n      api<Board>(`/leaderboard?period=${period}&limit=3`, { signal: controller.signal }),\n    ]).then(([board, top]) => { setBoard(board); setPodium(top.items); })\n      .catch(error => { if (!controller.signal.aborted) setError(message(error)); })\n      .finally(() => { if (!controller.signal.aborted) setBusy(false); });\n    return () => controller.abort();\n  }, [period, query, limit, refresh]);\n  return <section id=\"leaderboard\" className=\"min-w-0 rounded-[1.4rem] border border-line bg-white p-5 sm:p-7\">\n    <div className=\"mb-6 flex items-center justify-between gap-3\"><div><h2 className=\"text-xl font-bold tracking-tight\">The leaderboard</h2><p className=\"mt-1 text-xs text-muted\">One player. One best score. All the glory.</p></div><span className=\"flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 text-[10px] font-medium text-muted\"><span className=\"size-1.5 rounded-full bg-[#90b852]\" /> LIVE RANKINGS</span></div>\n    <div className=\"mb-6 flex flex-wrap items-center justify-between gap-3\">\n      <div className=\"flex rounded-xl bg-paper p-1\" role=\"tablist\" aria-label=\"Leaderboard period\">{periods.map(tab => <button key={tab.value} role=\"tab\" aria-selected={period === tab.value} onClick={() => setPeriod(tab.value)} className={`${button} rounded-lg px-4 py-2 text-xs sm:px-5 ${period === tab.value ? \"bg-forest text-white shadow-sm\" : \"text-muted hover:text-forest\"}`}>{tab.label}</button>)}</div>\n      <button onClick={onRefresh} disabled={busy} className={`${button} gap-1.5 px-2 py-2 text-xs text-muted hover:text-forest`}><RefreshCw size={14} className={busy ? \"animate-spin\" : \"\"} />Refresh</button>\n    </div>\n    {!busy && !error && <Podium items={podium} username={user?.username} />}\n    <div className=\"mb-4 flex items-center justify-between gap-3\"><div className=\"relative min-w-0 flex-1\"><Search size={16} className=\"absolute left-3.5 top-3 text-muted\" /><input aria-label=\"Search players\" placeholder=\"Find a player...\" maxLength={32} value={search} onChange={e => setSearch(e.target.value)} className={`${field} bg-paper/50 py-2.5 pl-10 pr-9 text-xs`} />{search && <button aria-label=\"Clear search\" className=\"absolute right-3 top-3 text-muted\" onClick={() => setSearch(\"\")}><X size={15} /></button>}</div><select aria-label=\"Leaderboard size\" value={limit} onChange={e => setLimit(Number(e.target.value))} className=\"rounded-xl border border-line bg-white px-2 py-2.5 text-xs text-muted outline-forest\"><option value={25}>Top 25</option><option value={50}>Top 50</option><option value={100}>Top 100</option><option value={1000}>Top 1,000</option></select></div>\n    {error ? <div className=\"space-y-3 py-4\"><Notice>{error}</Notice><button onClick={onRefresh} className={`${button} px-3 py-2 text-forest`}><RefreshCw size={14} />Try again</button></div> : <div className=\"overflow-x-auto\">\n      <table className=\"w-full text-left text-sm\" aria-label=\"Player leaderboard\" aria-busy={busy}>\n        <thead><tr className=\"border-y border-line bg-paper/50 text-[10px] font-medium uppercase tracking-wider text-muted\"><th className=\"w-16 py-3 pl-3 font-medium\">Rank</th><th className=\"py-3 font-medium\">Player</th><th className=\"py-3 text-right font-medium\"><span className=\"inline-flex items-center gap-1\">Score<ArrowDown size={11} /></span></th><th className=\"py-3 pl-5 pr-3 text-right font-medium\">Achieved</th></tr></thead>\n        <tbody>{busy ? Array.from({ length: 5 }, (_, index) => <tr key={index} className=\"border-b border-line/70\"><td colSpan={4} className=\"py-4\"><div className=\"h-7 animate-pulse rounded-lg bg-paper\" /></td></tr>) : board.items.map(item => <tr key={item.player} className={`border-b border-line/70 transition-colors ${user?.username === item.player ? \"bg-lime/25\" : \"hover:bg-paper/60\"}`}>\n          <td className=\"py-4 pl-3\"><span className={`inline-flex size-7 items-center justify-center rounded-lg font-mono text-xs ${item.rank === 1 ? \"bg-lime text-forest\" : item.rank === 2 ? \"bg-[#eceef1] text-[#79808a]\" : item.rank === 3 ? \"bg-[#f2e6da] text-[#a17c56]\" : \"text-muted\"}`}>{item.rank <= 3 ? <Medal size={16} aria-label={`Rank ${item.rank}`} /> : String(item.rank).padStart(2, \"0\")}</span></td>\n          <td className=\"py-4\"><div className=\"flex items-center gap-2.5\"><Avatar name={item.player} /><span className=\"max-w-32 truncate text-xs font-semibold sm:max-w-44\">{item.player}</span>{user?.username === item.player && <span className=\"rounded bg-forest/8 px-1.5 py-0.5 text-[9px] font-bold text-forest\">YOU</span>}</div></td>\n          <td className=\"py-4 text-right font-mono text-xs font-semibold tabular-nums\">{number(item.score)}</td><td className=\"whitespace-nowrap py-4 pl-5 pr-3 text-right text-[11px] text-muted\"><time dateTime={item.achieved_at} title={date(item.achieved_at, true)}>{date(item.achieved_at)}</time></td>\n        </tr>)}</tbody>\n      </table>\n      {!busy && !board.items.length && <div className=\"flex flex-col items-center px-3 py-12 text-center\"><div className=\"mb-4 flex size-12 items-center justify-center rounded-2xl bg-paper text-forest/60\">{search ? <Search size={23} /> : <Trophy size={23} />}</div><h3 className=\"text-base font-semibold\">{search ? \"No players found\" : period === \"all\" ? \"Be the first on the board.\" : \"A fresh start. A new high.\"}</h3><p className=\"mt-2 max-w-xs text-xs leading-relaxed text-muted\">{search ? `No ranked players match “${search}”. Try another name.` : \"No scores here yet. Submit a score and set the standard.\"}</p>{search ? <button onClick={() => setSearch(\"\")} className={`${button} mt-5 text-xs underline underline-offset-4`}>Clear search</button> : <button onClick={user ? () => document.getElementById(\"score-input\")?.focus() : onJoin} className={`${button} mt-5 bg-forest px-4 py-2.5 text-xs text-white`}>{user ? \"Submit your first score\" : \"Join the leaderboard\"}<ArrowUpRight size={14} /></button>}</div>}\n    </div>}\n    <div className=\"mt-5 flex flex-wrap items-center justify-between gap-2 text-[10px] text-muted\"><span>{busy ? \"Updating rankings...\" : `Showing ${number(board.items.length)} of ${number(board.total)} ${search ? \"matching \" : \"\"}players`}</span><span className=\"flex items-center gap-1.5\"><ShieldCheck size={12} />Fair play. Visible scores only.</span></div>\n  </section>;\n}\n\nfunction PlayerPanel({ user, token, refresh, onRefresh, onJoin }: { user: User | null; token: string | null; refresh: number; onRefresh: () => void; onJoin: () => void }) {\n  const [value, setValue] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const [result, setResult] = useState<Submission | null>(null);\n  const [error, setError] = useState(\"\");\n  const [personal, setPersonal] = useState<PersonalScores | null>(null);\n  const [historyError, setHistoryError] = useState(\"\");\n  const [historyBusy, setHistoryBusy] = useState(false);\n  const [showAll, setShowAll] = useState(false);\n  useEffect(() => {\n    setResult(null); setError(\"\"); setValue(\"\"); setPersonal(null); setShowAll(false);\n  }, [token]);\n  useEffect(() => {\n    if (!token || !user) { setPersonal(null); return; }\n    const controller = new AbortController();\n    setHistoryBusy(true); setHistoryError(\"\");\n    api<PersonalScores>(\"/scores\", { signal: controller.signal }, token)\n      .then(setPersonal).catch(error => { if (!controller.signal.aborted) setHistoryError(message(error)); })\n      .finally(() => { if (!controller.signal.aborted) setHistoryBusy(false); });\n    return () => controller.abort();\n  }, [token, user, refresh]);\n  async function submit(event: FormEvent) {\n    event.preventDefault(); setError(\"\"); setResult(null);\n    const score = Number(value);\n    if (!/^\\d+$/.test(value) || !Number.isSafeInteger(score) || score < 0) { setError(\"Enter a valid, non-negative whole number.\"); return; }\n    setBusy(true);\n    try {\n      const result = await api<Submission>(\"/scores\", { method: \"POST\", body: JSON.stringify({ score }) }, token);\n      setResult(result); setValue(\"\"); onRefresh();\n    } catch (error) { setError(message(error)); }\n    finally { setBusy(false); }\n  }\n  return <aside className=\"space-y-5\">\n    <section className=\"relative overflow-hidden rounded-[1.4rem] border border-[#dce7cd] bg-[#edf3e5] p-6\">\n      <div className=\"mb-5 flex items-center justify-between\"><span className=\"flex size-10 items-center justify-center rounded-xl bg-white/70\"><Zap size={20} strokeWidth={1.7} /></span><span className=\"text-[10px] font-semibold tracking-[0.12em] text-[#7b8b69]\">YOUR NEXT MOVE</span></div>\n      <h2 className=\"text-xl font-bold tracking-tight\">Got a new high?</h2><p className=\"mb-6 mt-2 text-xs leading-relaxed text-muted\">Big win or a little progress.<br />Put your score on the board.</p>\n      {user ? <form className=\"space-y-3\" onSubmit={submit}><label htmlFor=\"score-input\" className=\"block text-xs font-semibold\">Your score</label><div className=\"relative\"><input id=\"score-input\" required type=\"number\" min=\"0\" max=\"9007199254740991\" step=\"1\" inputMode=\"numeric\" value={value} onChange={e => setValue(e.target.value)} className={`${field} border-[#dce7cd] py-3.5 pr-12 font-mono text-xl font-semibold`} placeholder=\"0\" /><span className=\"absolute right-4 top-5 text-xs text-muted\">pts</span></div>{error && <Notice>{error}</Notice>}<button disabled={busy} className={`${button} w-full bg-forest py-3.5 text-white hover:bg-forest/90`}>{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : <Plus size={17} />}Submit score</button>{result && <div role=\"status\" className=\"rounded-xl border border-forest/10 bg-white/70 p-4\"><div className=\"flex items-center gap-2 text-xs font-semibold\"><Check size={15} />{number(result.score)} points submitted</div><p className=\"mt-2 text-sm\">Your all-time rank: <strong>#{number(result.rank)}</strong></p>{result.personal_best && <p className=\"mt-2 flex items-center gap-1.5 text-xs font-semibold text-[#648735]\"><Sparkles size={15} />New personal best!</p>}</div>}<p className=\"pt-1 text-center text-[10px] text-muted\">Make it count. Keep it honest.</p></form> : <><div className=\"mb-4 rounded-xl border border-[#dce7cd] bg-white/60 px-4 py-4\"><div className=\"flex items-center justify-between\"><span className=\"font-mono text-2xl font-semibold text-forest/25\">000,000</span><span className=\"text-xs text-muted\">pts</span></div></div><button onClick={onJoin} className={`${button} w-full bg-forest py-3.5 text-white hover:bg-forest/90`}>Sign in to submit<ArrowRight size={16} /></button><p className=\"mt-3 text-center text-[10px] text-muted\">Your personal best is waiting.</p></>}\n    </section>\n    <section className=\"rounded-[1.4rem] border border-line bg-white p-6\">\n      <div className=\"mb-5 flex items-center justify-between\"><h2 className=\"text-base font-bold tracking-tight\">Your scorecard</h2><Target size={18} className=\"text-muted\" /></div>\n      <div className=\"mb-5 rounded-xl bg-paper px-4 py-4\"><p className=\"mb-2 flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-wider text-muted\"><Award size={13} />Personal best</p><p className=\"truncate font-mono text-3xl font-semibold tracking-tight\">{user && personal?.best_score != null ? number(personal.best_score) : \"—\"}<span className=\"ml-2 font-sans text-xs font-normal text-muted\">pts</span></p><p className=\"mt-2 text-[10px] text-muted\">{user ? \"Your best visible score, all time.\" : \"Sign in to track your progress.\"}</p></div>\n      <div className=\"mb-4 flex items-center justify-between\"><h3 className=\"text-xs font-semibold\">Recent submissions</h3><Clock3 size={13} className=\"text-muted\" /></div>\n      {historyError ? <div className=\"space-y-2\"><Notice>{historyError}</Notice><button onClick={onRefresh} className={`${button} py-2 text-xs`}>Retry</button></div> : historyBusy ? <div className=\"space-y-3\">{[1, 2, 3].map(n => <div key={n} className=\"h-9 animate-pulse rounded-lg bg-paper\" />)}</div> : user && personal?.items.length ? <><ul className=\"divide-y divide-line\">{(showAll ? personal.items : personal.items.slice(0, 5)).map(score => <li key={score.id} className=\"flex items-center justify-between gap-3 py-3 first:pt-0\"><div><p className={`font-mono text-sm font-semibold tabular-nums ${score.is_hidden ? \"text-muted line-through\" : \"\"}`}>{number(score.score)}<span className=\"ml-1.5 font-sans text-[10px] font-normal text-muted\">pts</span></p><time dateTime={score.achieved_at} className=\"mt-1 block text-[10px] text-muted\">{date(score.achieved_at, true)}</time></div>{score.is_hidden ? <span title=\"Hidden by the admin; excluded from rankings\" className=\"rounded-full bg-[#f3ece5] px-2 py-1 text-[9px] text-[#997958]\">Hidden</span> : score.score === personal.best_score ? <span title=\"Personal best\" className=\"text-[#8caa51]\"><Sparkles size={15} /></span> : <Check size={13} className=\"text-muted/50\" />}</li>)}</ul>{personal.items.length > 5 && <button onClick={() => setShowAll(!showAll)} className={`${button} mt-3 w-full py-2 text-xs text-muted`}>{showAll ? \"Show recent only\" : `View all ${number(personal.items.length)} submissions`}<ChevronRight size={13} /></button>}</> : <div className=\"rounded-xl border border-dashed border-line px-4 py-6 text-center\"><Hash size={19} className=\"mx-auto mb-2 text-muted/50\" /><p className=\"text-xs text-muted\">{user ? \"Your story starts with one score.\" : \"A little friendly competition?\"}</p><p className=\"mt-1 text-[10px] text-muted/70\">{user ? \"Submit your first score above.\" : \"Sign in to see your recent games.\"}</p></div>}\n    </section>\n    <div className=\"flex gap-3 px-2 py-1\"><ShieldCheck size={19} className=\"mt-0.5 shrink-0 text-[#819565]\" /><p className=\"text-[11px] leading-relaxed text-muted\"><strong className=\"font-semibold text-forest/80\">Good games. Fair play.</strong><br />Scores are reviewed to keep the competition honest. Hidden scores don't affect rankings.</p></div>\n  </aside>;\n}\n\nfunction AdminPanel({ token, refresh, onRefresh }: { token: string; refresh: number; onRefresh: () => void }) {\n  const [page, setPage] = useState(1);\n  const [pageSize, setPageSize] = useState(20);\n  const [data, setData] = useState<AdminScores | null>(null);\n  const [busy, setBusy] = useState(true);\n  const [toggling, setToggling] = useState<number | null>(null);\n  const [error, setError] = useState(\"\");\n  useEffect(() => {\n    const controller = new AbortController(); setBusy(true); setError(\"\");\n    api<AdminScores>(`/admin/scores?page=${page}&page_size=${pageSize}`, { signal: controller.signal }, token)\n      .then(setData).catch(error => { if (!controller.signal.aborted) setError(message(error)); })\n      .finally(() => { if (!controller.signal.aborted) setBusy(false); });\n    return () => controller.abort();\n  }, [page, pageSize, token, refresh]);\n  async function toggle(id: number) {\n    setToggling(id); setError(\"\");\n    try { await api(`/admin/scores/${id}/toggle`, { method: \"POST\" }, token); onRefresh(); }\n    catch (error) { setError(message(error)); }\n    finally { setToggling(null); }\n  }\n  const pages = Math.max(1, Math.ceil((data?.total || 0) / pageSize));\n  return <section className=\"mt-7 rounded-[1.4rem] border border-line bg-white p-5 sm:p-7\">\n    <div className=\"mb-6 flex flex-wrap items-center justify-between gap-4\"><div><div className=\"flex items-center gap-2\"><ShieldCheck size={21} /><h2 className=\"text-xl font-bold tracking-tight\">Score moderation</h2><span className=\"rounded-md bg-lime px-2 py-1 text-[9px] font-bold\">ADMIN</span></div><p className=\"mt-2 text-xs text-muted\">Keep the playing field level. Hide implausible scores or restore them.</p></div><button disabled={busy} onClick={onRefresh} className={`${button} border border-line px-3 py-2 text-xs`}><RefreshCw size={14} className={busy ? \"animate-spin\" : \"\"} />Refresh</button></div>\n    {error && <div className=\"mb-4\"><Notice>{error}</Notice></div>}\n    <div className=\"overflow-x-auto\"><table className=\"w-full text-left text-xs\" aria-label=\"All scores for moderation\" aria-busy={busy}><thead><tr className=\"border-y border-line bg-paper/50 text-[10px] uppercase tracking-wider text-muted\"><th className=\"p-3 font-medium\">ID</th><th className=\"p-3 font-medium\">Player</th><th className=\"p-3 text-right font-medium\">Score</th><th className=\"p-3 font-medium\">Submitted</th><th className=\"p-3 font-medium\">Status</th><th className=\"p-3 text-right font-medium\">Action</th></tr></thead><tbody>{data?.items.map(score => <tr key={score.id} className={`border-b border-line ${score.is_hidden ? \"bg-paper/70 text-muted\" : \"\"}`}><td className=\"p-3 font-mono text-muted\">#{score.id}</td><td className=\"p-3\"><div className=\"flex items-center gap-2\"><Avatar name={score.player} /><span className=\"font-semibold\">{score.player}</span></div></td><td className={`p-3 text-right font-mono font-semibold ${score.is_hidden ? \"line-through\" : \"\"}`}>{number(score.score)}</td><td className=\"whitespace-nowrap p-3 text-muted\">{date(score.achieved_at, true)}</td><td className=\"p-3\"><span className={`rounded-full px-2.5 py-1 text-[10px] ${score.is_hidden ? \"bg-[#f3e9df] text-[#99734d]\" : \"bg-[#edf3e5] text-[#6a8445]\"}`}>{score.is_hidden ? \"Hidden\" : \"Visible\"}</span></td><td className=\"p-3 text-right\"><button disabled={toggling !== null || busy} onClick={() => toggle(score.id)} aria-label={`${score.is_hidden ? \"Show\" : \"Hide\"} score ${score.id} by ${score.player}`} className={`${button} border border-line px-3 py-2 text-xs hover:bg-paper`}>{toggling === score.id ? <LoaderCircle size={13} className=\"animate-spin\" /> : score.is_hidden ? <Eye size={13} /> : <EyeOff size={13} />}{score.is_hidden ? \"Show\" : \"Hide\"}</button></td></tr>)}</tbody></table>{busy && <div className=\"py-8 text-center text-xs text-muted\">Loading scores...</div>}{!busy && !data?.items.length && <div className=\"py-10 text-center text-sm text-muted\">No submissions to review.</div>}</div>\n    <div className=\"mt-5 flex flex-wrap items-center justify-between gap-3 text-xs text-muted\"><span>{number(data?.total || 0)} total submissions</span><div className=\"flex items-center gap-3\"><select aria-label=\"Scores per page\" value={pageSize} onChange={e => { setPageSize(Number(e.target.value)); setPage(1); }} className=\"rounded-lg border border-line bg-white px-2 py-2\"><option value={20}>20 / page</option><option value={50}>50 / page</option><option value={100}>100 / page</option></select><button aria-label=\"Previous page\" disabled={page <= 1 || busy} onClick={() => setPage(page - 1)} className={`${button} size-8 border border-line`}><ChevronLeft size={15} /></button><span>{page} / {pages}</span><button aria-label=\"Next page\" disabled={page >= pages || busy} onClick={() => setPage(page + 1)} className={`${button} size-8 border border-line`}><ChevronRight size={15} /></button></div></div>\n  </section>;\n}\n\nexport default function App() {\n  const [token, setToken] = useState(savedToken);\n  const [user, setUser] = useState<User | null>(null);\n  const [authReady, setAuthReady] = useState(!token);\n  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n  const [showHelp, setShowHelp] = useState(false);\n  const [refresh, setRefresh] = useState(0);\n  const [summary, setSummary] = useState<Board | null>(null);\n  const [sessionNotice, setSessionNotice] = useState(\"\");\n  const [signingOut, setSigningOut] = useState(false);\n  useEffect(() => {\n    const expired = () => { saveToken(null); setToken(null); setUser(null); setAuthReady(true); setSessionNotice(\"Your session expired. Sign in again to keep playing.\"); };\n    window.addEventListener(\"session-expired\", expired);\n    return () => window.removeEventListener(\"session-expired\", expired);\n  }, []);\n  useEffect(() => {\n    if (!token) { setAuthReady(true); return; }\n    const controller = new AbortController();\n    api<User>(\"/auth/me\", { signal: controller.signal }, token).then(setUser)\n      .catch(error => { if (!controller.signal.aborted) setSessionNotice(message(error)); })\n      .finally(() => { if (!controller.signal.aborted) setAuthReady(true); });\n    return () => controller.abort();\n  }, [token]);\n  useEffect(() => {\n    const controller = new AbortController();\n    api<Board>(\"/leaderboard?limit=1\", { signal: controller.signal }).then(setSummary).catch(() => {});\n    return () => controller.abort();\n  }, [refresh]);\n  function signedIn(token: string, user: User) {\n    saveToken(token); setToken(token); setUser(user); setAuthReady(true); setAuthMode(null); setSessionNotice(\"\"); setRefresh(value => value + 1);\n  }\n  async function signOut() {\n    setSigningOut(true);\n    try {\n      await api(\"/auth/logout\", { method: \"POST\" }, token);\n      saveToken(null); setToken(null); setUser(null); setSessionNotice(\"\");\n    } catch (error) { setSessionNotice(message(error)); }\n    finally { setSigningOut(false); }\n  }\n  const doRefresh = () => setRefresh(value => value + 1);\n  return <div className=\"min-h-screen bg-paper font-sans text-forest antialiased selection:bg-lime\">\n    <header className=\"border-b border-line bg-white/60\"><div className=\"mx-auto flex h-20 max-w-[1200px] items-center justify-between gap-2 px-5 sm:gap-4 sm:px-8\">\n      <a href=\"/\" aria-label=\"Highscore home\" className=\"flex shrink-0 items-center gap-1.5 sm:gap-2.5\"><span className=\"flex size-8 items-center justify-center rounded-xl bg-forest text-lime sm:size-9\"><ArrowUpRight size={26} strokeWidth={2.3} /></span><span className=\"text-lg font-extrabold tracking-[-0.07em] sm:text-xl\">highscore<span className=\"text-[#8faf55]\">.</span></span></a>\n      <nav aria-label=\"Main navigation\" className=\"hidden h-full items-center gap-8 md:flex\"><a href=\"#leaderboard\" className=\"flex h-full items-center gap-2 border-b-2 border-forest px-1 text-xs font-semibold\"><Trophy size={15} />Leaderboard</a><button onClick={() => setShowHelp(true)} className=\"flex items-center gap-1.5 text-xs text-muted transition-colors hover:text-forest\">How it works<ArrowUpRight size={12} /></button></nav>\n      <div className=\"flex items-center gap-3\">{!authReady ? <LoaderCircle size={20} className=\"animate-spin text-muted\" /> : user ? <><div className=\"flex items-center gap-2\"><Avatar name={user.username} className=\"hidden size-8 sm:inline-flex\" /><span className=\"max-w-20 truncate text-xs font-semibold sm:max-w-40\" title={user.username}>{user.username}</span>{user.is_admin && <ShieldCheck size={14} className=\"text-muted\" aria-label=\"Admin account\" />}</div><button onClick={signOut} aria-label=\"Sign out\" disabled={signingOut} className={`${button} border border-line bg-white px-3 py-2.5 text-xs hover:bg-paper`}><LogOut size={14} /><span className=\"hidden sm:inline\">Sign out</span></button></> : <><button onClick={() => setAuthMode(\"login\")} className={`${button} px-2 py-2.5 text-xs hover:text-muted`}>Sign in</button><button onClick={() => setAuthMode(\"register\")} aria-label=\"Join the game\" className={`${button} bg-forest px-4 py-2.5 text-xs text-white hover:bg-forest/90`}><span className=\"sm:hidden\">Join</span><span className=\"hidden sm:inline\">Join the game</span><ArrowUpRight size={14} /></button></>}</div>\n    </div></header>\n    <main className=\"mx-auto max-w-[1200px] px-5 pb-12 sm:px-8\">\n      {sessionNotice && <div className=\"mt-5 flex items-center gap-3 rounded-xl border border-line bg-white p-4 text-xs text-muted\" role=\"status\"><span className=\"flex-1\">{sessionNotice}</span><button onClick={() => setAuthMode(\"login\")} className=\"font-semibold text-forest underline\">Sign in</button><button aria-label=\"Dismiss notification\" onClick={() => setSessionNotice(\"\")}><X size={15} /></button></div>}\n      <section className=\"flex items-center justify-between gap-8 py-10 sm:py-12\"><div><div className=\"mb-5 flex items-center gap-2 text-[10px] font-semibold tracking-[0.16em] text-muted\"><span className=\"flex size-5 items-center justify-center rounded-md bg-lime\"><Gamepad2 size={13} className=\"text-forest\" /></span>A LITTLE COMPETITION. A LOT OF FUN.</div><h1 className=\"text-[44px] font-bold leading-[1.08] tracking-[-0.055em] sm:text-[58px]\">Good games.<br />Great scores<span className=\"text-[#91ae61]\">.</span></h1><p className=\"mt-5 max-w-md text-sm leading-6 text-muted\">Chase your personal best. Climb the ranks.<br className=\"hidden sm:block\" /> See how you stack up with the community.</p></div><HeroArtwork /></section>\n      <div className=\"mb-8 grid grid-cols-1 gap-3 min-[480px]:grid-cols-3 sm:gap-5\"><Stat icon={<Users size={21} strokeWidth={1.7} />} label=\"Players on the board\" value={summary ? number(summary.total) : \"—\"} detail=\"A community of high achievers\" /><Stat icon={<Crown size={22} strokeWidth={1.7} />} label=\"Score to beat\" value={summary?.items.length ? number(summary.items[0].score) : \"—\"} detail={summary?.items.length ? `Set by ${summary.items[0].player}` : \"The top spot is up for grabs\"} /><Stat icon={<Gamepad2 size={22} strokeWidth={1.7} />} label=\"Your next challenge\" value={user ? \"Make your move\" : \"Ready, player?\"} detail={user ? `You're in, ${user.username}. Let's play.` : \"Your next great game starts here\"} /></div>\n      <div className=\"grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_310px]\"><Leaderboard user={user} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"register\")} /><PlayerPanel user={user} token={token} refresh={refresh} onRefresh={doRefresh} onJoin={() => setAuthMode(\"login\")} /></div>\n      {user?.is_admin && token && <AdminPanel token={token} refresh={refresh} onRefresh={doRefresh} />}\n      <section className=\"mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line px-6 py-5\"><div className=\"flex items-center gap-3\"><span className=\"flex size-9 items-center justify-center rounded-xl bg-white\"><Trophy size={18} strokeWidth={1.5} /></span><div><p className=\"text-xs font-semibold\">It's not just about the top spot.</p><p className=\"mt-1 text-[11px] text-muted\">It's about beating your last best. You've got this.</p></div></div><button onClick={() => setShowHelp(true)} className={`${button} text-xs text-muted hover:text-forest`}>The rules of the game<ArrowUpRight size={14} /></button></section>\n    </main>\n    <footer className=\"border-t border-line\"><div className=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-5 py-6 text-[10px] text-muted sm:px-8\"><span className=\"font-semibold tracking-tight\">highscore. <span className=\"ml-2 font-normal\">Made for the love of the game.</span></span><div className=\"flex items-center gap-5\"><span className=\"flex items-center gap-1.5\"><span className=\"size-1.5 rounded-full bg-[#94af68]\" />All rankings in UTC</span><button onClick={() => setShowHelp(true)} aria-label=\"How Highscore works\" className=\"hover:text-forest\"><CircleHelp size={15} /></button></div></div></footer>\n    {authMode && <AuthModal mode={authMode} onMode={setAuthMode} onClose={() => setAuthMode(null)} onSignedIn={signedIn} />}\n    {showHelp && <Modal title=\"Play. Post. Climb.\" onClose={() => setShowHelp(false)}><p className=\"mb-6 text-sm leading-relaxed text-muted\">Friendly competition, simple rules.</p><ol className=\"space-y-5\">{[{ title: \"Make it yours\", text: \"Create an account and submit a non-negative whole-number score. Every submission belongs to you and is dated by the server.\" }, { title: \"Your best takes the stage\", text: \"Each player appears once, ranked by their best visible score. Ties go to the score achieved first. Search keeps the original ranks.\" }, { title: \"Pick your playing field\", text: \"All time means every game. This week starts Monday at 00:00 UTC. Today starts at 00:00 UTC.\" }, { title: \"Keep the game fair\", text: \"The admin can hide implausible scores. Hidden submissions stay in your history but don't count toward your best or your rank.\" }].map((rule, index) => <li key={rule.title} className=\"flex gap-3\"><span className=\"flex size-7 shrink-0 items-center justify-center rounded-lg bg-lime font-mono text-xs font-semibold\">{index + 1}</span><div><h3 className=\"text-sm font-semibold\">{rule.title}</h3><p className=\"mt-1 text-xs leading-relaxed text-muted\">{rule.text}</p></div></li>)}</ol><button onClick={() => setShowHelp(false)} className={`${button} mt-7 w-full bg-forest py-3 text-white`}>Got it. Game on.<ArrowRight size={16} /></button></Modal>}\n    </div>;\n}","lineStart":1,"lineEnd":320,"totalLines":320,"truncated":false}},"title":"frontend/src/App.tsx","time":{"start":1794316871715,"end":1794316871725}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c59ea818001ixndNy63XKc7OZ","sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","messageID":"msg_1c59e9b71001ysV9hSztC8VNkm"}}
{"type":"tool_use","timestamp":1794316871785,"sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","part":{"type":"tool","tool":"read","callID":"call_QqKCZ2zbbajqKIiJYHHluT9R","state":{"status":"completed","input":{"filePath":"/workspace/.checks/browser.mjs"},"output":"<path>/workspace/.checks/browser.mjs</path>\n<type>file</type>\n<content>\n1: import { chromium as playwright, expect } from \"@playwright/test\";\n2: import chromium, { inflate, setupLambdaEnvironment } from \"@sparticuz/chromium\";\n3: import { spawn } from \"node:child_process\";\n4: \n5: const server = spawn(\"/workspace/.venv/bin/python\", [\"/workspace/.checks/server.py\"], {\n6:   cwd: \"/workspace\",\n7:   env: { ...process.env, PYTHONPATH: \"/workspace\", ADMIN_PASSWORD: \"browser-admin-password\", PORT: \"8001\" },\n8:   stdio: [\"ignore\", \"ignore\", \"inherit\"],\n9: });\n10: for (let attempt = 0; attempt < 100; attempt++) {\n11:   try { if ((await fetch(\"http://127.0.0.1:8001/api/health\")).ok) break; } catch {}\n12:   await new Promise(resolve => setTimeout(resolve, 100));\n13: }\n14: \n15: await inflate(\"/workspace/.checks/node_modules/@sparticuz/chromium/bin/al2023.tar.br\");\n16: setupLambdaEnvironment(\"/tmp/al2023/lib\");\n17: const browser = await playwright.launch({\n18:   executablePath: await chromium.executablePath(),\n19:   args: chromium.args.filter(arg => arg !== \"--single-process\"),\n20:   headless: true,\n21: });\n22: const page = await browser.newPage({ viewport: { width: 1440, height: 1100 } });\n23: const errors = [];\n24: page.on(\"pageerror\", error => errors.push(error.message));\n25: page.on(\"response\", response => { if (response.url().includes(\"/api\")) console.log(response.status(), new URL(response.url()).pathname); });\n26: page.on(\"requestfinished\", request => { if (request.url().includes(\"/api\")) console.log(\"Finished\", new URL(request.url()).pathname); });\n27: page.on(\"requestfailed\", request => console.log(\"Request failed\", new URL(request.url()).pathname, request.failure()));\n28: const base = \"http://127.0.0.1:8001\";\n29: try {\n30:   await page.goto(base);\n31:   await expect(page.getByText(\"Be the first on the board.\")).toBeVisible();\n32:   await page.screenshot({ path: \"/workspace/.checks/desktop-empty.png\", fullPage: true });\n33:   await page.getByRole(\"button\", { name: \"Join the game\", exact: true }).click();\n34:   await page.getByRole(\"textbox\", { name: \"Username\" }).fill(\"ArcadeAce\");\n35:   await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-player-password\");\n36:   await page.getByRole(\"button\", { name: \"Create account\", exact: true }).click();\n37:   await expect(page.getByRole(\"button\", { name: \"Sign out\" })).toBeVisible();\n38:   await page.getByLabel(\"Your score\", { exact: true }).fill(\"8400\");\n39:   await page.getByRole(\"button\", { name: \"Submit score\", exact: true }).click();\n40:   await expect(page.getByText(\"New personal best!\", { exact: true })).toBeVisible();\n41:   await expect(page.getByText(\"Your all-time rank:\")).toContainText(\"#1\");\n42:   await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"ArcadeAce\")).toBeVisible();\n43:   await page.getByLabel(\"Your score\", { exact: true }).fill(\"5000\");\n44:   await page.getByRole(\"button\", { name: \"Submit score\", exact: true }).click();\n45:   await expect(page.getByText(\"5,000 points submitted\")).toBeVisible();\n46:   await expect(page.getByText(\"New personal best!\", { exact: true })).toHaveCount(0);\n47:   await page.reload();\n48:   await page.waitForLoadState(\"networkidle\");\n49:   await expect(page.getByRole(\"button\", { name: \"Sign out\" })).toBeVisible();\n50:   await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"8,400\")).toBeVisible();\n51:   await page.getByRole(\"tab\", { name: \"This week\", exact: true }).click();\n52:   await expect(page.getByRole(\"tab\", { name: \"This week\" })).toHaveAttribute(\"aria-selected\", \"true\");\n53:   await page.getByRole(\"tab\", { name: \"Today\", exact: true }).click();\n54:   await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"8,400\")).toBeVisible();\n55:   await page.getByRole(\"textbox\", { name: \"Search players\" }).fill(\"not-a-player\");\n56:   await expect(page.getByText(\"No players found\", { exact: true })).toBeVisible();\n57:   await page.getByRole(\"button\", { name: \"Clear search\", exact: true }).first().click();\n58:   await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"ArcadeAce\")).toBeVisible();\n59:   await page.screenshot({ path: \"/workspace/.checks/desktop-player.png\", fullPage: true });\n60:   await page.setViewportSize({ width: 390, height: 844 });\n61:   await page.screenshot({ path: \"/workspace/.checks/mobile-player.png\", fullPage: true });\n62:   expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n63:   await page.getByRole(\"button\", { name: \"Sign out\" }).click();\n64:   await expect(page.getByRole(\"button\", { name: \"Sign in\", exact: true })).toBeVisible();\n65:   await page.getByRole(\"button\", { name: \"Sign in\", exact: true }).click();\n66:   await page.getByRole(\"textbox\", { name: \"Username\" }).fill(\"admin\");\n67:   await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-admin-password\");\n68:   await page.getByRole(\"dialog\").getByRole(\"button\", { name: \"Sign in\", exact: true }).click();\n69:   await expect(page.getByText(\"Score moderation\", { exact: true })).toBeVisible();\n70:   await page.getByRole(\"button\", { name: \"Hide score 1 by ArcadeAce\", exact: true }).click();\n71:   await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"5,000\")).toBeVisible();\n72:   await expect(page.getByRole(\"button\", { name: \"Show score 1 by ArcadeAce\", exact: true })).toBeVisible();\n73:   await page.getByRole(\"button\", { name: \"Show score 1 by ArcadeAce\", exact: true }).click();\n74:   await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"8,400\")).toBeVisible();\n75:   expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n76:   await page.setViewportSize({ width: 1440, height: 1100 });\n77:   await page.screenshot({ path: \"/workspace/.checks/desktop-admin.png\", fullPage: true });\n78:   await page.setViewportSize({ width: 320, height: 720 });\n79:   expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n80:   await page.getByRole(\"button\", { name: \"Sign out\" }).click();\n81:   await page.getByRole(\"button\", { name: \"Join the game\", exact: true }).click();\n82:   await page.getByRole(\"textbox\", { name: \"Username\" }).fill(\"APlayerNameThatIsThirtyTwoLetters\");\n83:   await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-player-password\");\n84:   await page.getByRole(\"button\", { name: \"Create account\", exact: true }).click();\n85:   await expect(page.getByRole(\"button\", { name: \"Sign out\" })).toBeVisible();\n86:   expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n87:   expect(errors).toEqual([]);\n88:   console.log(\"Browser checks passed: registration, login, submission, personal best, session restore, periods, search, logout, admin hide/show, and mobile overflow.\");\n89: } catch (error) {\n90:   console.log(\"Page errors\", errors);\n91:   await page.screenshot({ path: \"/workspace/.checks/failure.png\", fullPage: true });\n92:   throw error;\n93: } finally {\n94:   await browser.close();\n95:   server.kill(\"SIGINT\");\n96: }\n\n(End of file - total 96 lines)\n</content>","metadata":{"preview":"import { chromium as playwright, expect } from \"@playwright/test\";\nimport chromium, { inflate, setupLambdaEnvironment } from \"@sparticuz/chromium\";\nimport { spawn } from \"node:child_process\";\n\nconst server = spawn(\"/workspace/.venv/bin/python\", [\"/workspace/.checks/server.py\"], {\n  cwd: \"/workspace\",\n  env: { ...process.env, PYTHONPATH: \"/workspace\", ADMIN_PASSWORD: \"browser-admin-password\", PORT: \"8001\" },\n  stdio: [\"ignore\", \"ignore\", \"inherit\"],\n});\nfor (let attempt = 0; attempt < 100; attempt++) {\n  try { if ((await fetch(\"http://127.0.0.1:8001/api/health\")).ok) break; } catch {}\n  await new Promise(resolve => setTimeout(resolve, 100));\n}\n\nawait inflate(\"/workspace/.checks/node_modules/@sparticuz/chromium/bin/al2023.tar.br\");\nsetupLambdaEnvironment(\"/tmp/al2023/lib\");\nconst browser = await playwright.launch({\n  executablePath: await chromium.executablePath(),\n  args: chromium.args.filter(arg => arg !== \"--single-process\"),\n  headless: true,","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/.checks/browser.mjs","text":"import { chromium as playwright, expect } from \"@playwright/test\";\nimport chromium, { inflate, setupLambdaEnvironment } from \"@sparticuz/chromium\";\nimport { spawn } from \"node:child_process\";\n\nconst server = spawn(\"/workspace/.venv/bin/python\", [\"/workspace/.checks/server.py\"], {\n  cwd: \"/workspace\",\n  env: { ...process.env, PYTHONPATH: \"/workspace\", ADMIN_PASSWORD: \"browser-admin-password\", PORT: \"8001\" },\n  stdio: [\"ignore\", \"ignore\", \"inherit\"],\n});\nfor (let attempt = 0; attempt < 100; attempt++) {\n  try { if ((await fetch(\"http://127.0.0.1:8001/api/health\")).ok) break; } catch {}\n  await new Promise(resolve => setTimeout(resolve, 100));\n}\n\nawait inflate(\"/workspace/.checks/node_modules/@sparticuz/chromium/bin/al2023.tar.br\");\nsetupLambdaEnvironment(\"/tmp/al2023/lib\");\nconst browser = await playwright.launch({\n  executablePath: await chromium.executablePath(),\n  args: chromium.args.filter(arg => arg !== \"--single-process\"),\n  headless: true,\n});\nconst page = await browser.newPage({ viewport: { width: 1440, height: 1100 } });\nconst errors = [];\npage.on(\"pageerror\", error => errors.push(error.message));\npage.on(\"response\", response => { if (response.url().includes(\"/api\")) console.log(response.status(), new URL(response.url()).pathname); });\npage.on(\"requestfinished\", request => { if (request.url().includes(\"/api\")) console.log(\"Finished\", new URL(request.url()).pathname); });\npage.on(\"requestfailed\", request => console.log(\"Request failed\", new URL(request.url()).pathname, request.failure()));\nconst base = \"http://127.0.0.1:8001\";\ntry {\n  await page.goto(base);\n  await expect(page.getByText(\"Be the first on the board.\")).toBeVisible();\n  await page.screenshot({ path: \"/workspace/.checks/desktop-empty.png\", fullPage: true });\n  await page.getByRole(\"button\", { name: \"Join the game\", exact: true }).click();\n  await page.getByRole(\"textbox\", { name: \"Username\" }).fill(\"ArcadeAce\");\n  await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-player-password\");\n  await page.getByRole(\"button\", { name: \"Create account\", exact: true }).click();\n  await expect(page.getByRole(\"button\", { name: \"Sign out\" })).toBeVisible();\n  await page.getByLabel(\"Your score\", { exact: true }).fill(\"8400\");\n  await page.getByRole(\"button\", { name: \"Submit score\", exact: true }).click();\n  await expect(page.getByText(\"New personal best!\", { exact: true })).toBeVisible();\n  await expect(page.getByText(\"Your all-time rank:\")).toContainText(\"#1\");\n  await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"ArcadeAce\")).toBeVisible();\n  await page.getByLabel(\"Your score\", { exact: true }).fill(\"5000\");\n  await page.getByRole(\"button\", { name: \"Submit score\", exact: true }).click();\n  await expect(page.getByText(\"5,000 points submitted\")).toBeVisible();\n  await expect(page.getByText(\"New personal best!\", { exact: true })).toHaveCount(0);\n  await page.reload();\n  await page.waitForLoadState(\"networkidle\");\n  await expect(page.getByRole(\"button\", { name: \"Sign out\" })).toBeVisible();\n  await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"8,400\")).toBeVisible();\n  await page.getByRole(\"tab\", { name: \"This week\", exact: true }).click();\n  await expect(page.getByRole(\"tab\", { name: \"This week\" })).toHaveAttribute(\"aria-selected\", \"true\");\n  await page.getByRole(\"tab\", { name: \"Today\", exact: true }).click();\n  await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"8,400\")).toBeVisible();\n  await page.getByRole(\"textbox\", { name: \"Search players\" }).fill(\"not-a-player\");\n  await expect(page.getByText(\"No players found\", { exact: true })).toBeVisible();\n  await page.getByRole(\"button\", { name: \"Clear search\", exact: true }).first().click();\n  await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"ArcadeAce\")).toBeVisible();\n  await page.screenshot({ path: \"/workspace/.checks/desktop-player.png\", fullPage: true });\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.screenshot({ path: \"/workspace/.checks/mobile-player.png\", fullPage: true });\n  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n  await page.getByRole(\"button\", { name: \"Sign out\" }).click();\n  await expect(page.getByRole(\"button\", { name: \"Sign in\", exact: true })).toBeVisible();\n  await page.getByRole(\"button\", { name: \"Sign in\", exact: true }).click();\n  await page.getByRole(\"textbox\", { name: \"Username\" }).fill(\"admin\");\n  await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-admin-password\");\n  await page.getByRole(\"dialog\").getByRole(\"button\", { name: \"Sign in\", exact: true }).click();\n  await expect(page.getByText(\"Score moderation\", { exact: true })).toBeVisible();\n  await page.getByRole(\"button\", { name: \"Hide score 1 by ArcadeAce\", exact: true }).click();\n  await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"5,000\")).toBeVisible();\n  await expect(page.getByRole(\"button\", { name: \"Show score 1 by ArcadeAce\", exact: true })).toBeVisible();\n  await page.getByRole(\"button\", { name: \"Show score 1 by ArcadeAce\", exact: true }).click();\n  await expect(page.getByRole(\"table\", { name: \"Player leaderboard\" }).getByText(\"8,400\")).toBeVisible();\n  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n  await page.setViewportSize({ width: 1440, height: 1100 });\n  await page.screenshot({ path: \"/workspace/.checks/desktop-admin.png\", fullPage: true });\n  await page.setViewportSize({ width: 320, height: 720 });\n  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n  await page.getByRole(\"button\", { name: \"Sign out\" }).click();\n  await page.getByRole(\"button\", { name: \"Join the game\", exact: true }).click();\n  await page.getByRole(\"textbox\", { name: \"Username\" }).fill(\"APlayerNameThatIsThirtyTwoLetters\");\n  await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-player-password\");\n  await page.getByRole(\"button\", { name: \"Create account\", exact: true }).click();\n  await expect(page.getByRole(\"button\", { name: \"Sign out\" })).toBeVisible();\n  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);\n  expect(errors).toEqual([]);\n  console.log(\"Browser checks passed: registration, login, submission, personal best, session restore, periods, search, logout, admin hide/show, and mobile overflow.\");\n} catch (error) {\n  console.log(\"Page errors\", errors);\n  await page.screenshot({ path: \"/workspace/.checks/failure.png\", fullPage: true });\n  throw error;\n} finally {\n  await browser.close();\n  server.kill(\"SIGINT\");\n}","lineStart":1,"lineEnd":96,"totalLines":96,"truncated":false}},"title":".checks/browser.mjs","time":{"start":1794316871761,"end":1794316871769}},"id":"prt_1c59ea84c001AY5Y0z2nLLm03K","sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","messageID":"msg_1c59e9b71001ysV9hSztC8VNkm"}}
{"type":"tool_use","timestamp":1794316871785,"sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","part":{"type":"tool","tool":"read","callID":"call_OshvWekoMwipJszNxAJRRBlf","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts"},"output":"<path>/workspace/frontend/src/api.ts</path>\n<type>file</type>\n<content>\n1: export type User = { username: string; is_admin: boolean };\n2: export type Score = {\n3:   id: number;\n4:   score: number;\n5:   achieved_at: string;\n6:   is_hidden: boolean;\n7:   player: string;\n8: };\n9: export type RankedPlayer = {\n10:   rank: number;\n11:   player: string;\n12:   score: number;\n13:   achieved_at: string;\n14: };\n15: export type Board = { items: RankedPlayer[]; total: number };\n16: export type PersonalScores = { items: Score[]; best_score: number | null };\n17: export type Submission = Score & { rank: number; personal_best: boolean };\n18: export type AdminScores = { items: Score[]; total: number; page: number; page_size: number };\n19: export type Period = \"all\" | \"week\" | \"today\";\n20: \n21: export function savedToken(): string | null {\n22:   try {\n23:     return localStorage.getItem(\"highscore-token\");\n24:   } catch {\n25:     return null;\n26:   }\n27: }\n28: \n29: export function saveToken(token: string | null) {\n30:   try {\n31:     if (token) localStorage.setItem(\"highscore-token\", token);\n32:     else localStorage.removeItem(\"highscore-token\");\n33:   } catch {\n34:     return;\n35:   }\n36: }\n37: \n38: export async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {\n39:   const headers = new Headers(options.headers);\n40:   if (options.body) headers.set(\"Content-Type\", \"application/json\");\n41:   if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n42:   const response = await fetch(`/api${path}`, { ...options, headers });\n43:   const body = await response.json().catch(() => null);\n44:   if (!response.ok) {\n45:     if (response.status === 401 && token) window.dispatchEvent(new Event(\"session-expired\"));\n46:     throw new Error(body?.error || \"Something went wrong. Please try again.\");\n47:   }\n48:   return body as T;\n49: }\n50: \n51: export function number(value: number) {\n52:   return new Intl.NumberFormat(\"en-US\").format(value);\n53: }\n54: \n55: export function date(value: string, includeTime = false) {\n56:   return new Intl.DateTimeFormat(\"en-US\", {\n57:     month: \"short\", day: \"numeric\", year: \"numeric\",\n58:     ...(includeTime ? { hour: \"numeric\", minute: \"2-digit\" } : {}),\n59:   }).format(new Date(value));\n60: }\n61: \n62: export function message(error: unknown) {\n63:   return error instanceof Error ? error.message : \"Unable to connect. Please try again.\";\n64: }\n\n(End of file - total 64 lines)\n</content>","metadata":{"preview":"export type User = { username: string; is_admin: boolean };\nexport type Score = {\n  id: number;\n  score: number;\n  achieved_at: string;\n  is_hidden: boolean;\n  player: string;\n};\nexport type RankedPlayer = {\n  rank: number;\n  player: string;\n  score: number;\n  achieved_at: string;\n};\nexport type Board = { items: RankedPlayer[]; total: number };\nexport type PersonalScores = { items: Score[]; best_score: number | null };\nexport type Submission = Score & { rank: number; personal_best: boolean };\nexport type AdminScores = { items: Score[]; total: number; page: number; page_size: number };\nexport type Period = \"all\" | \"week\" | \"today\";\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/api.ts","text":"export type User = { username: string; is_admin: boolean };\nexport type Score = {\n  id: number;\n  score: number;\n  achieved_at: string;\n  is_hidden: boolean;\n  player: string;\n};\nexport type RankedPlayer = {\n  rank: number;\n  player: string;\n  score: number;\n  achieved_at: string;\n};\nexport type Board = { items: RankedPlayer[]; total: number };\nexport type PersonalScores = { items: Score[]; best_score: number | null };\nexport type Submission = Score & { rank: number; personal_best: boolean };\nexport type AdminScores = { items: Score[]; total: number; page: number; page_size: number };\nexport type Period = \"all\" | \"week\" | \"today\";\n\nexport function savedToken(): string | null {\n  try {\n    return localStorage.getItem(\"highscore-token\");\n  } catch {\n    return null;\n  }\n}\n\nexport function saveToken(token: string | null) {\n  try {\n    if (token) localStorage.setItem(\"highscore-token\", token);\n    else localStorage.removeItem(\"highscore-token\");\n  } catch {\n    return;\n  }\n}\n\nexport async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {\n  const headers = new Headers(options.headers);\n  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  const response = await fetch(`/api${path}`, { ...options, headers });\n  const body = await response.json().catch(() => null);\n  if (!response.ok) {\n    if (response.status === 401 && token) window.dispatchEvent(new Event(\"session-expired\"));\n    throw new Error(body?.error || \"Something went wrong. Please try again.\");\n  }\n  return body as T;\n}\n\nexport function number(value: number) {\n  return new Intl.NumberFormat(\"en-US\").format(value);\n}\n\nexport function date(value: string, includeTime = false) {\n  return new Intl.DateTimeFormat(\"en-US\", {\n    month: \"short\", day: \"numeric\", year: \"numeric\",\n    ...(includeTime ? { hour: \"numeric\", minute: \"2-digit\" } : {}),\n  }).format(new Date(value));\n}\n\nexport function message(error: unknown) {\n  return error instanceof Error ? error.message : \"Unable to connect. Please try again.\";\n}","lineStart":1,"lineEnd":64,"totalLines":64,"truncated":false}},"title":"frontend/src/api.ts","time":{"start":1794316871751,"end":1794316871773}},"id":"prt_1c59ea84300123kfSlhYDJRhu4","sessionID":"ses_e3a7c4a06ffeVhrkKZI5fW6gXl","messageID":"msg_1c59e9b71001ysV9hSztC8VNkm"}}
