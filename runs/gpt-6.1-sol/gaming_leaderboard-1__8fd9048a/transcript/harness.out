an className=\"flex size-9 items-center justify-center rounded-xl bg-forest text-lime\"><ArrowUpRight size={26} strokeWidth={2.3} /></span><span className=\"text-xl font-extrabold tracking-[-0.07em]\">highscore<span className=\"text-[#8faf55]\">.</span></span></a>\n     <nav aria-label=\"Main navigation\" className=\"hidden h-full items-center gap-8 md:flex\"><a href=\"#leaderboard\" className=\"flex h-full items-center gap-2 border-b-2 border-forest px-1 text-xs font-semibold\"><Trophy size={15} />Leaderboard</a><button onClick={() => setShowHelp(true)} className=\"flex items-center gap-1.5 text-xs text-muted transition-colors hover:text-forest\">How it works<ArrowUpRight size={12} /></button></nav>\n-    <div className=\"flex items-center gap-3\">{!authReady ? <LoaderCircle size={20} className=\"animate-spin text-muted\" /> : user ? <><div className=\"flex items-center gap-2\"><Avatar name={user.username} className=\"size-8\" /><span className=\"max-w-28 truncate text-xs font-semibold sm:max-w-40\">{user.username}</span>{user.is_admin && <ShieldCheck size={14} className=\"text-muted\" aria-label=\"Admin account\" />}</div><button onClick={signOut} disabled={signingOut} className={`${button} border border-line bg-white px-3 py-2.5 text-xs hover:bg-paper`}><LogOut size={14} /><span className=\"hidden sm:inline\">Sign out</span></button></> : <><button onClick={() => setAuthMode(\"login\")} className={`${button} px-2 py-2.5 text-xs hover:text-muted`}>Sign in</button><button onClick={() => setAuthMode(\"register\")} className={`${button} bg-forest px-4 py-2.5 text-xs text-white hover:bg-forest/90`}>Join the game<ArrowUpRight size={14} /></button></>}</div>\n+    <div className=\"flex items-center gap-3\">{!authReady ? <LoaderCircle size={20} className=\"animate-spin text-muted\" /> : user ? <><div className=\"flex items-center gap-2\"><Avatar name={user.username} className=\"size-8\" /><span className=\"max-w-28 truncate text-xs font-semibold sm:max-w-40\">{user.usern