nt-medium\">{answer.text}</h3><span className={`mt-0.5 flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-[9px] font-medium ${answer.is_correct ? \"bg-[#edf4e5] text-[#6b8758]\" : \"bg-[#faf0e9] text-[#b48266]\"}`}><Icon name={answer.is_correct ? \"check\" : \"close\"} size={12} /><span className=\"hidden sm:block\">{answer.is_correct ? \"Correct\" : \"A new discovery\"}</span></span></div><div className=\"grid gap-2.5 sm:grid-cols-2\">{OPTIONS.map(option => <div key={option} className={`flex items-center gap-3 rounded-lg border px-3.5 py-3 text-xs ${option === answer.correct_option ? \"border-[#c4d8b2] bg-[#f0f6e9] text-[#567044]\" : option === answer.selected ? \"border-[#e8d5c8] bg-[#fbf2ed] text-[#9f7057]\" : \"border-[#edf0e7] text-[#91988b]\"}`}><span className=\"text-[10px] font-semibold\">{option}</span><span className=\"flex-1\">{optionText(answer, option)}</span>{option === answer.correct_option ? <span className=\"flex items-center gap-1 text-[9px]\"><Icon name=\"check\" size={12} />{option === answer.selected ? \"Your answer\" : \"Correct\"}</span> : option === answer.selected && <span className=\"flex items-center gap-1 text-[9px]\"><Icon name=\"close\" size={12} />Your answer</span>}</div>)}</div></article>)}</div>\n+    <div className=\"mt-8 flex flex-wrap justify-center gap-3\">{user && <button onClick={onHistory} className={secondaryButton}><Icon name=\"history\" size={16} />My attempts</button>}<button onClick={onPlay} className={primaryButton}>Another little adventure<Icon name=\"arrow\" size={17} /></button></div>\n+  </div>;\n+}\n\nIndex: /workspace/frontend/src/History.tsx\n===================================================================\n--- /workspace/frontend/src/History.tsx\n+++ /workspace/frontend/src/History.tsx\n@@ -0,0 +1,35 @@\n+import { useEffect, useState } from \"react\";\n+import { api, errorMessage } from \"./api\";\n+import type { Attempt, User } from \"./api\";\n+import { Icon } from \"./Icons\";\n+import { ErrorBanner, Loading, PageHeading, primaryButton, secondaryButton } from \"./ui\";\n+\n+export default function History({ user, onSignIn, onOpen, onPlay }: { user: User | null; onSignIn: () => void; onOpen: (attempt: Attempt) => void; onPlay: () => void }) {\n+  const [items, setItems] = useState<Attempt[]>([]);\n+  const [loading, setLoading] = useState(!!user);\n+  const [opening, setOpening] = useState<number | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  useEffect(() => {\n+    if (!user) return;\n+    let active = true;\n+    api<{ items: Attempt[] }>(\"/attempts\").then(data => { if (active) setItems(data.items); }).catch(error => { if (active) setError(errorMessage(error)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [user, retry]);\n+  async function open(id: number) {\n+    setOpening(id); setError(\"\");\n+    try { onOpen(await api<Attempt>(`/attempts/${id}`)); }\n+    catch (error) { setError(errorMessage(error)); }\n+    finally { setOpening(null); }\n+  }\n+  const best = items.length ? Math.max(...items.map(item => item.score)) : 0;\n+  const average = items.length ? Math.round(items.reduce((sum, item) => sum + item.score, 0) / items.length) : 0;\n+  return <div>\n+    <PageHeading eyebrow=\"Your curiosity, collected\" title=\"Every little discovery counts.\" description=\"A history of your adventures, aha moments, and progress.\" action={<button onClick={onPlay} className={primaryButton}>Take a quiz<Icon name=\"plus\" size={16} /></button>} />\n+    <ErrorBanner message={error} />{error && <button onClick={() => { setError(\"\"); setLoading(true); setRetry(retry + 1); }} className={`${secondaryButton} mt-3`}>Try again</button>}\n+    {!user ? <div className=\"rounded-3xl border border-[#e0e6d7] bg-white py-16 text-center\"><span className=\"mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-mint\"><Icon name=\"history\" size={28} /></span><h2 className=\"text-2xl font-medium tracking-[-.6px]\">A story worth keeping.</h2><p className=\"mx-auto mt-3 max-w-xs text-sm leading-relaxed text-muted\">Sign in to save your quiz attempts and see your curiosity grow over time.</p><button onClick={onSignIn} className={`${primaryButton} mt-7`}>Sign in to see your attempts<Icon name=\"arrow\" size={16} /></button></div> : loading ? <Loading label=\"Gathering your little victories…\" /> : <>\n+      <div className=\"my-7 grid grid-cols-3 gap-3 sm:gap-5\">{[{ title: \"Quizzes explored\", value: items.length, icon: \"book\" as const }, { title: \"Personal best\", value: `${best}%`, icon: \"trophy\" as const }, { title: \"Average score\", value: `${average}%`, icon: \"spark\" as const }].map(stat => <div key={stat.title} className=\"rounded-2xl border border-[#e2e7dc] bg-white p-4 sm:p-6\"><Icon name={stat.icon} size={20} className=\"mb-5 text-[#8a9c78]\" /><p className=\"text-2xl font-semibold tracking-[-1px] sm:text-3xl\">{stat.value}</p><p className=\"mt-2 text-[10px] text-muted sm:text-xs\">{stat.title}</p></div>)}</div>\n+      {!items.length ? <div className=\"rounded-2xl border border-dashed border-[#cfd9c5] py-14 text-center\"><Icon name=\"leaf\" size={30} className=\"mx-auto mb-4 text-[#91a77a]\" /><h2 className=\"text-xl font-medium\">Your story starts with a question.</h2><p className=\"mt-2 text-xs text-muted\">Take your first quiz and we’ll keep it right here.</p><button onClick={onPlay} className={`${primaryButton} mt-6`}>Let’s discover something<Icon name=\"arrow\" size={16} /></button></div> : <section className=\"overflow-hidden rounded-2xl border border-[#e0e6d8] bg-white\"><div className=\"grid grid-cols-[1fr_70px_36px] gap-3 border-b border-[#e7eadf] bg-[#f5f7ef] px-5 py-4 text-[10px] tracking-wider text-muted uppercase sm:grid-cols-[1fr_120px_100px_75px] sm:px-7\"><span>Your adventures</span><span className=\"hidden sm:block\">Questions</span><span>Score</span><span className=\"text-right\">Review</span></div>{items.map(attempt => <button key={attempt.id} disabled={opening !== null} onClick={() => void open(attempt.id!)} className=\"grid w-full grid-cols-[1fr_70px_36px] items-center gap-3 border-b border-[#edf0e7] px-5 py-5 text-left last:border-b-0 hover:bg-[#f8faf4] sm:grid-cols-[1fr_120px_100px_75px] sm:px-7\"><div><span className=\"text-xs font-medium\">{new Date(attempt.submitted_at).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" })}</span><p className=\"mt-1.5 text-[10px] text-muted\">{new Date(attempt.submitted_at).toLocaleTimeString(undefined, { hour: \"numeric\", minute: \"2-digit\" })}<span className=\"sm:hidden\"> · {attempt.total_questions} questions</span></p></div><span className=\"hidden text-xs text-muted sm:block\">{attempt.correct} / {attempt.total_questions} correct</span><span className=\"w-fit rounded-full bg-[#edf3e5] px-3 py-1.5 text-[11px] font-medium text-[#72865f]\">{attempt.score}%</span><span className=\"flex items-center justify-end text-muted\">{opening === attempt.id ? <span className=\"h-4 w-4 animate-spin rounded-full border-2 border-mint border-t-ink\" /> : <Icon name=\"arrow\" size={17} />}</span></button>)}</section>}\n+    </>}\n+  </div>;\n+}\n\n","files":[{"filePath":"/workspace/frontend/src/Quiz.tsx","relativePath":"frontend/src/Quiz.tsx","type":"add","patch":"Index: /workspace/frontend/src/Quiz.tsx\n===================================================================\n--- /workspace/frontend/src/Quiz.tsx\n+++ /workspace/frontend/src/Quiz.tsx\n@@ -0,0 +1,46 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { api, errorMessage, OPTIONS, optionText } from \"./api\";\n+import type { Attempt, Option, Question } from \"./api\";\n+import { Icon } from \"./Icons\";\n+import { ErrorBanner, primaryButton, secondaryButton } from \"./ui\";\n+\n+export default function Quiz({ questions, onComplete, onExit }: { questions: Question[]; onComplete: (attempt: Attempt) => void; onExit: () => void }) {\n+  const [index, setIndex] = useState(0);\n+  const [selected, setSelected] = useState<Record<number, Option>>({});\n+  const [submitting, setSubmitting] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const heading = useRef<HTMLHeadingElement>(null);\n+  const question = questions[index];\n+  const last = index === questions.length - 1;\n+  useEffect(() => { heading.current?.focus(); }, [index]);\n+  useEffect(() => {\n+    const handler = (event: BeforeUnloadEvent) => { event.preventDefault(); };\n+    window.addEventListener(\"beforeunload\", handler);\n+    return () => window.removeEventListener(\"beforeunload\", handler);\n+  }, []);\n+  async function advance() {\n+    if (!selected[question.id] || submitting) return;\n+    if (!last) { setIndex(index + 1); return; }\n+    setSubmitting(true); setError(\"\");\n+    try {\n+      const attempt = await api<Attempt>(\"/attempts\", { method: \"POST\", body: JSON.stringify({ answers: questions.map(item => ({ question_id: item.id, selected: selected[item.id] })) }) });\n+      onComplete(attempt);\n+    } catch (error) { setError(errorMessage(error)); }\n+    finally { setSubmitting(false); }\n+  }\n+  return <div className=\"mx-auto max-w-[780px]\">\n+    <div className=\"mb-8 flex items-center justify-between\"><span className=\"flex items-center gap-2 text-[11px] text-muted\"><Icon name=\"globe\" size={16} />THE EVERYDAY QUIZ</span><button disabled={submitting} onClick={onExit} className=\"flex items-center gap-2 rounded-lg p-2 text-xs text-muted hover:text-ink\">Leave quiz<Icon name=\"close\" size={16} /></button></div>\n+    <div className=\"mb-3 flex items-center justify-between text-xs\"><p className=\"font-medium\">Question {index + 1} <span className=\"font-normal text-muted\">of {questions.length}</span></p><span className=\"text-[#87977b]\">{Math.round(index / questions.length * 100)}% of the adventure</span></div>\n+    <div className=\"mb-8 h-1.5 overflow-hidden rounded-full bg-[#e4e8dd]\"><div className=\"h-full rounded-full bg-[#91a77a] transition-all duration-500\" style={{ width: `${(index + 1) / questions.length * 100}%` }} /></div>\n+    <section className=\"rounded-3xl border border-[#e0e6d9] bg-white p-6 sm:p-10\">\n+      <span className=\"mb-5 inline-flex rounded-lg bg-[#f0f4e8] px-3 py-1.5 text-[10px] font-medium tracking-wide text-[#7a8a68]\">A LITTLE SOMETHING TO THINK ABOUT</span>\n+      <h1 ref={heading} tabIndex={-1} className=\"mb-8 text-[25px] leading-[1.4] font-medium tracking-[-.7px] outline-none sm:text-[30px]\">{question.text}</h1>\n+      <form onSubmit={event => { event.preventDefault(); void advance(); }}>\n+        <fieldset disabled={submitting}><legend className=\"sr-only\">Choose one answer</legend><div className=\"space-y-3\">{OPTIONS.map(option => <label key={`${question.id}-${option}`} className={`relative flex cursor-pointer items-center gap-4 rounded-xl border p-4 transition-colors sm:p-5 ${selected[question.id] === option ? \"border-[#8ba476] bg-[#f0f5e9]\" : \"border-[#e4e8df] hover:bg-paper\"}`}><input type=\"radio\" name={`question-${question.id}`} value={option} checked={selected[question.id] === option} onChange={() => setSelected(previous => ({ ...previous, [question.id]: option }))} className=\"peer sr-only\" /><span className=\"pointer-events-none absolute inset-0 rounded-xl peer-focus-visible:ring-2 peer-focus-visible:ring-[#73966b]\" /><span className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-xs font-medium ${selected[question.id] === option ? \"bg-[#dae7c9]\" : \"bg-[#f3f5ef] text-muted\"}`}>{option}</span><span className=\"flex-1 text-sm\">{optionText(question, option)}</span><span className={`flex h-[18px] w-[18px] items-center justify-center rounded-full border ${selected[question.id] === option ? \"border-[#7e976a] bg-[#7e976a] text-white\" : \"border-[#cdd4c5]\"}`}>{selected[question.id] === option && <Icon name=\"check\" size={12} />}</span></label>)}</div></fieldset>\n+        <div className=\"mt-5\"><ErrorBanner message={error} /></div>\n+        <div className=\"mt-7 flex items-center justify-between gap-3\">{index > 0 ? <button type=\"button\" disabled={submitting} onClick={() => setIndex(index - 1)} className={secondaryButton}><Icon name=\"arrow\" size={15} className=\"rotate-180\" />Back</button> : <span className=\"hidden text-[11px] text-muted sm:block\">Trust your curiosity.</span>}<button type=\"submit\" disabled={!selected[question.id] || submitting} className={`${primaryButton} ml-auto min-w-40`}>{submitting ? \"A moment of truth…\" : last ? \"Submit answers\" : \"Next question\"}<Icon name={last ? \"check\" : \"arrow\"} size={17} /></button></div>\n+      </form>\n+    </section>\n+    <p className=\"mt-6 flex items-center justify-center gap-2 text-[11px] text-muted\"><Icon name=\"leaf\" size={14} />No timer, no rush. Good things take a little thought.</p>\n+  </div>;\n+}\n","additions":46,"deletions":0},{"filePath":"/workspace/frontend/src/Results.tsx","relativePath":"frontend/src/Results.tsx","type":"add","patch":"Index: /workspace/frontend/src/Results.tsx\n===================================================================\n--- /workspace/frontend/src/Results.tsx\n+++ /workspace/frontend/src/Results.tsx\n@@ -0,0 +1,15 @@\n+import type { Attempt, User } from \"./api\";\n+import { OPTIONS, optionText } from \"./api\";\n+import { Icon } from \"./Icons\";\n+import { PageHeading, primaryButton, secondaryButton } from \"./ui\";\n+\n+export default function Results({ attempt, user, onPlay, onSignIn, onHistory, historical }: { attempt: Attempt; user: User | null; onPlay: () => void; onSignIn: () => void; onHistory: () => void; historical: boolean }) {\n+  return <div className=\"mx-auto max-w-[860px]\">\n+    <PageHeading eyebrow={historical ? \"A look back\" : \"The moment of truth\"} title={historical ? \"A little trip down memory lane.\" : attempt.score >= 80 ? \"Look at that curious mind.\" : \"A little wiser than before.\"} description={historical ? new Date(attempt.submitted_at).toLocaleString(undefined, { dateStyle: \"long\", timeStyle: \"short\" }) : \"Every answer is a chance to discover something new.\"} action={<button onClick={onPlay} className={secondaryButton}>Play again<Icon name=\"arrow\" size={15} /></button>} />\n+    <section className=\"mb-7 flex flex-wrap items-center gap-6 rounded-3xl border border-[#d9e4ce] bg-[#e8efdf] p-7 sm:gap-9 sm:p-9\"><div className=\"flex h-28 w-28 shrink-0 flex-col items-center justify-center rounded-full border-[6px] border-[#c3d5ae] bg-[#f4f7ec]\"><span className=\"text-[32px] font-semibold tracking-[-1px]\">{attempt.score}<span className=\"text-base\">%</span></span><span className=\"text-[9px] tracking-widest text-muted uppercase\">Your score</span></div><div className=\"flex-1\"><span className=\"mb-3 inline-flex items-center gap-2 text-[10px] font-medium tracking-[.15em] text-[#7d8e68]\"><Icon name=\"trophy\" size={17} />CURIOSITY LOOKS GOOD ON YOU</span><h2 className=\"text-2xl font-medium tracking-[-.6px]\">{attempt.correct} out of {attempt.total_questions} correct.</h2><p className=\"mt-2 text-xs leading-relaxed text-[#7e8b71]\">{attempt.score === 100 ? \"A perfect little adventure. You really know your stuff!\" : attempt.score >= 60 ? \"Nicely done. Let’s see what you discovered along the way.\" : \"The best part? Now you know a few things you didn’t before.\"}</p>{attempt.id !== null && <span className=\"mt-4 flex items-center gap-1.5 text-[10px] font-medium text-[#789064]\"><Icon name=\"check\" size={13} />Saved to your attempts</span>}</div></section>\n+    {!user && <div className=\"mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-[#e4e7dc] bg-white p-5\"><div className=\"flex items-center gap-3\"><span className=\"rounded-xl bg-[#f1f4e9] p-3\"><Icon name=\"history\" size={21} /></span><div><h3 className=\"text-sm font-medium\">Sign in to save your results</h3><p className=\"mt-1 text-[11px] text-muted\">Keep this discovery. See how you grow.</p></div></div><button onClick={onSignIn} className={`${primaryButton} py-2.5 text-xs`}>Sign in<Icon name=\"arrow\" size={15} /></button></div>}\n+    <div className=\"mb-5 flex items-center justify-between\"><h2 className=\"text-lg font-semibold tracking-[-.5px]\">Your discoveries, in review</h2><span className=\"text-[11px] text-muted\">{attempt.total_questions} questions</span></div>\n+    <div className=\"space-y-4\">{attempt.answers.map((answer, index) => <article key={answer.question_id} className=\"rounded-2xl border border-[#e2e7dc] bg-white p-5 sm:p-7\"><div className=\"mb-5 flex items-start gap-3\"><span className=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-paper text-[10px] text-muted\">{String(index + 1).padStart(2, \"0\")}</span><h3 className=\"flex-1 text-[15px] leading-relaxed font-medium\">{answer.text}</h3><span className={`mt-0.5 flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-[9px] font-medium ${answer.is_correct ? \"bg-[#edf4e5] text-[#6b8758]\" : \"bg-[#faf0e9] text-[#b48266]\"}`}><Icon name={answer.is_correct ? \"check\" : \"close\"} size={12} /><span className=\"hidden sm:block\">{answer.is_correct ? \"Correct\" : \"A new discovery\"}</span></span></div><div className=\"grid gap-2.5 sm:grid-cols-2\">{OPTIONS.map(option => <div key={option} className={`flex items-center gap-3 rounded-lg border px-3.5 py-3 text-xs ${option === answer.correct_option ? \"border-[#c4d8b2] bg-[#f0f6e9] text-[#567044]\" : option === answer.selected ? \"border-[#e8d5c8] bg-[#fbf2ed] text-[#9f7057]\" : \"border-[#edf0e7] text-[#91988b]\"}`}><span className=\"text-[10px] font-semibold\">{option}</span><span className=\"flex-1\">{optionText(answer, option)}</span>{option === answer.correct_option ? <span className=\"flex items-center gap-1 text-[9px]\"><Icon name=\"check\" size={12} />{option === answer.selected ? \"Your answer\" : \"Correct\"}</span> : option === answer.selected && <span className=\"flex items-center gap-1 text-[9px]\"><Icon name=\"close\" size={12} />Your answer</span>}</div>)}</div></article>)}</div>\n+    <div className=\"mt-8 flex flex-wrap justify-center gap-3\">{user && <button onClick={onHistory} className={secondaryButton}><Icon name=\"history\" size={16} />My attempts</button>}<button onClick={onPlay} className={primaryButton}>Another little adventure<Icon name=\"arrow\" size={17} /></button></div>\n+  </div>;\n+}\n","additions":15,"deletions":0},{"filePath":"/workspace/frontend/src/History.tsx","relativePath":"frontend/src/History.tsx","type":"add","patch":"Index: /workspace/frontend/src/History.tsx\n===================================================================\n--- /workspace/frontend/src/History.tsx\n+++ /workspace/frontend/src/History.tsx\n@@ -0,0 +1,35 @@\n+import { useEffect, useState } from \"react\";\n+import { api, errorMessage } from \"./api\";\n+import type { Attempt, User } from \"./api\";\n+import { Icon } from \"./Icons\";\n+import { ErrorBanner, Loading, PageHeading, primaryButton, secondaryButton } from \"./ui\";\n+\n+export default function History({ user, onSignIn, onOpen, onPlay }: { user: User | null; onSignIn: () => void; onOpen: (attempt: Attempt) => void; onPlay: () => void }) {\n+  const [items, setItems] = useState<Attempt[]>([]);\n+  const [loading, setLoading] = useState(!!user);\n+  const [opening, setOpening] = useState<number | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+  useEffect(() => {\n+    if (!user) return;\n+    let active = true;\n+    api<{ items: Attempt[] }>(\"/attempts\").then(data => { if (active) setItems(data.items); }).catch(error => { if (active) setError(errorMessage(error)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [user, retry]);\n+  async function open(id: number) {\n+    setOpening(id); setError(\"\");\n+    try { onOpen(await api<Attempt>(`/attempts/${id}`)); }\n+    catch (error) { setError(errorMessage(error)); }\n+    finally { setOpening(null); }\n+  }\n+  const best = items.length ? Math.max(...items.map(item => item.score)) : 0;\n+  const average = items.length ? Math.round(items.reduce((sum, item) => sum + item.score, 0) / items.length) : 0;\n+  return <div>\n+    <PageHeading eyebrow=\"Your curiosity, collected\" title=\"Every little discovery counts.\" description=\"A history of your adventures, aha moments, and progress.\" action={<button onClick={onPlay} className={primaryButton}>Take a quiz<Icon name=\"plus\" size={16} /></button>} />\n+    <ErrorBanner message={error} />{error && <button onClick={() => { setError(\"\"); setLoading(true); setRetry(retry + 1); }} className={`${secondaryButton} mt-3`}>Try again</button>}\n+    {!user ? <div className=\"rounded-3xl border border-[#e0e6d7] bg-white py-16 text-center\"><span className=\"mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-mint\"><Icon name=\"history\" size={28} /></span><h2 className=\"text-2xl font-medium tracking-[-.6px]\">A story worth keeping.</h2><p className=\"mx-auto mt-3 max-w-xs text-sm leading-relaxed text-muted\">Sign in to save your quiz attempts and see your curiosity grow over time.</p><button onClick={onSignIn} className={`${primaryButton} mt-7`}>Sign in to see your attempts<Icon name=\"arrow\" size={16} /></button></div> : loading ? <Loading label=\"Gathering your little victories…\" /> : <>\n+      <div className=\"my-7 grid grid-cols-3 gap-3 sm:gap-5\">{[{ title: \"Quizzes explored\", value: items.length, icon: \"book\" as const }, { title: \"Personal best\", value: `${best}%`, icon: \"trophy\" as const }, { title: \"Average score\", value: `${average}%`, icon: \"spark\" as const }].map(stat => <div key={stat.title} className=\"rounded-2xl border border-[#e2e7dc] bg-white p-4 sm:p-6\"><Icon name={stat.icon} size={20} className=\"mb-5 text-[#8a9c78]\" /><p className=\"text-2xl font-semibold tracking-[-1px] sm:text-3xl\">{stat.value}</p><p className=\"mt-2 text-[10px] text-muted sm:text-xs\">{stat.title}</p></div>)}</div>\n+      {!items.length ? <div className=\"rounded-2xl border border-dashed border-[#cfd9c5] py-14 text-center\"><Icon name=\"leaf\" size={30} className=\"mx-auto mb-4 text-[#91a77a]\" /><h2 className=\"text-xl font-medium\">Your story starts with a question.</h2><p className=\"mt-2 text-xs text-muted\">Take your first quiz and we’ll keep it right here.</p><button onClick={onPlay} className={`${primaryButton} mt-6`}>Let’s discover something<Icon name=\"arrow\" size={16} /></button></div> : <section className=\"overflow-hidden rounded-2xl border border-[#e0e6d8] bg-white\"><div className=\"grid grid-cols-[1fr_70px_36px] gap-3 border-b border-[#e7eadf] bg-[#f5f7ef] px-5 py-4 text-[10px] tracking-wider text-muted uppercase sm:grid-cols-[1fr_120px_100px_75px] sm:px-7\"><span>Your adventures</span><span className=\"hidden sm:block\">Questions</span><span>Score</span><span className=\"text-right\">Review</span></div>{items.map(attempt => <button key={attempt.id} disabled={opening !== null} onClick={() => void open(attempt.id!)} className=\"grid w-full grid-cols-[1fr_70px_36px] items-center gap-3 border-b border-[#edf0e7] px-5 py-5 text-left last:border-b-0 hover:bg-[#f8faf4] sm:grid-cols-[1fr_120px_100px_75px] sm:px-7\"><div><span className=\"text-xs font-medium\">{new Date(attempt.submitted_at).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" })}</span><p className=\"mt-1.5 text-[10px] text-muted\">{new Date(attempt.submitted_at).toLocaleTimeString(undefined, { hour: \"numeric\", minute: \"2-digit\" })}<span className=\"sm:hidden\"> · {attempt.total_questions} questions</span></p></div><span className=\"hidden text-xs text-muted sm:block\">{attempt.correct} / {attempt.total_questions} correct</span><span className=\"w-fit rounded-full bg-[#edf3e5] px-3 py-1.5 text-[11px] font-medium text-[#72865f]\">{attempt.score}%</span><span className=\"flex items-center justify-end text-muted\">{opening === attempt.id ? <span className=\"h-4 w-4 animate-spin rounded-full border-2 border-mint border-t-ink\" /> : <Icon name=\"arrow\" size={17} />}</span></button>)}</section>}\n+    </>}\n+  </div>;\n+}\n","additions":35,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nA frontend/src/Quiz.tsx\nA frontend/src/Results.tsx\nA frontend/src/History.tsx","time":{"start":1794303217996,"end":1794303218007}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"gAAAAABq8uTHAL107e9_fNi7O-YRgOTHEOajC14QOTsekiwEjbM8y9-Mw9Bq2Ty4MHrTPZviKDMvGosBoXPhB7aA7Cuihc9tZ4eQx2ryYMQPFNYeGd-WrYB1rwsBDKpoIReC7sHBbuZB2FPCSMXpMSBgxUoYpRKMjgpKwoOsE5DXdMp51MaL7T7UePxEkUYDITDAGNaF0F-dKSzz3PZyM6sdh44orApPZGdhC4dioWbRvikZFaySOnZudWMoey1HRmm0P7cRc8cJcXNcEKhbbRGSSd4GlRyZ1sHztttUd8s5_gKwKSbHcgAVpmC7TUzQGzAjHYIrWA4EfPxQm8kVn-jLH0v8geLGWuJ9l9XfIML_iJ2CXG-jM_L9O-ydudp_dAHhFpku-yMGZthqpszCez_COgJtpddY30OO0hYA4O0XM2CEE2PGBZNes8P0IZG6KCTA8j8bPpaeJfGGLmRew7sq-TGxjjVDATAta5lPaM95QtflPOBYdGF2RwSH7nEsbm9bthfZ7EM47Xa1tfHBLo6NJw0A0nwjbSl5Qm7_4O9mX5OIRffKWNOc_5AJYaFCYvTxH7H31oLeQch2Nr2FCqaDvkEic_MLnsBDG4ZTllU-vBhjXNMg3QP9EzG9AGN1pJXIimMTD8q5Qq3TU266FJRG8cY2q6OS1OnkCUTRhv77fAfBl69mCwWOWdPCPjY6wZk2xWqKS-Rm4gIeLVPQ7YfLyUV3pV3Fe0LR0saMCXotKJr8ScxsyLHYCLu5laJgdm1dIXAdyfZXaqyx6ycOW7asNYAi-Srs_OIfltQFYtVwKh0qfmPJQd4RHqBhBWjZ5SmqbrOCOA2GHs2z_xtty9ndvKMt5n9Pe-HBVcd_QYGG9UzuyZsBU5OOD7a6-y_kbueLioBWUFDlzukkso0awKZ7IkYNhK-yWKUnfN3EqRTylR6vg5ed9r0kIvANa__nI9HX7Jq6BgFFIvIzLF-jfihNUr6zWrDzsHEG__3cJn4f1xH3wo12zMfLIW6f9rUcFQXWGXYYsO_uo_km5r7aw2GkjbjWz4KDCrQititGOJyOzf4QUntesPn-5oGGH_JFkdObcXxylUYjw8B24sfrIeB2AgvH2oecZ0uEvNDzxSBOYWokF22nwhL-JzFel7-wlITrLKiHygQwayqw09HYCjBzZv4lodGBVmTwYH5U9Eah7x2euL7rGwWINs3HN8sqs44JdPi5IYrgPW5pbwIFaP32DNAvf35H2hHPBzknPQEkU_bTOkxzGZca7_3OU8rdAJwvPsndfcecQOLX2h5ZKhFSchaSvUFrExVscv