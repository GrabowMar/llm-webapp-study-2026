bmitted_at: string;\n+  answers: Answer[];\n+}\n+\n+export interface User {\n+  username: string;\n+  is_admin: boolean;\n+}\n+\n+export class ApiError extends Error {\n+  status: number;\n+  fields: Record<string, string>;\n+\n+  constructor(message: string, status: number, fields: Record<string, string> = {}) {\n+    super(message);\n+    this.status = status;\n+    this.fields = fields;\n+  }\n+}\n+\n+export function getToken(): string | null {\n+  try { return localStorage.getItem(\"quizly_token\"); } catch { return null; }\n+}\n+\n+export function setToken(token: string | null) {\n+  try {\n+    if (token) localStorage.setItem(\"quizly_token\", token);\n+    else localStorage.removeItem(\"quizly_token\");\n+  } catch { /* empty */ }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}): Promise<T> {\n+  const headers = new Headers(options.headers);\n+  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n+  const token = getToken();\n+  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, { ...options, headers });\n+  } catch {\n+    throw new ApiError(\"We couldn’t connect. Check your connection and try again.\", 0);\n+  }\n+  const data = await response.json();\n+  if (!response.ok) {\n+    if (response.status === 401 && token) {\n+      setToken(null);\n+      window.dispatchEvent(new Event(\"quizly:session-expired\"));\n+    }\n+    throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function optionText(question: Question, option: Option) {\n+  return question[`option_${option.toLowerCase()}` as \"option_a\" | \"option_b\" | \"option_c\" | \"option_d\"];\n+}\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n","additions":85,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM Dockerfile\nM frontend/vite.config.ts\nM frontend/src/main.tsx\nA frontend/src/index.css\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/src/api.ts","time":{"start":1794303061982,"end":1794303062023}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.summary","summary":"**Clarifying Docker Pip constraints**\n\nI'm","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" thinking","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" about","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" existing","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" Docker","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" pip","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" constraint","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":".","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" It","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" seems","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" like","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" hashes","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" in","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","format":"openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" requirements","format":"openai-responses-v1","index":0},{"type":"reasoning.summar