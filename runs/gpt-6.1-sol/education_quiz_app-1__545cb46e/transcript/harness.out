{"type":"tool_use","timestamp":1794302581351,"sessionID":"ses_e3b3ca287ffeW1XfQqh9dYPxo0","part":{"type":"tool","tool":"apply_patch","callID":"call_01kqXh5JxfXkg6Kg0fWPHwE1","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Delete File: /workspace/backend/app.py\n*** Add File: /workspace/backend/app.py\n+import hashlib\n+import json\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+from backend.seed import QUESTIONS\n+\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+QUESTION_FIELDS = (\n+    \"id\", \"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\", \"correct_option\"\n+)\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"quiz.sqlite3\"),\n+        ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n+        MAX_CONTENT_LENGTH=256 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+\n+    def db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=30)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(error=None):\n+        connection = g.pop(\"db\", None)\n+        if connection is not None:\n+            connection.close()\n+\n+    with app.app_context():\n+        connection = db()\n+        connection.execute(\"PRAGMA journal_mode = WAL\")\n+        connection.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL,\n+                is_admin INTEGER NOT NULL DEFAULT 0\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS questions (\n+                id INTEGER PRIMARY KEY,\n+                text TEXT NOT NULL,\n+                option_a TEXT NOT NULL,\n+                option_b TEXT NOT NULL,\n+                option_c TEXT NOT NULL,\n+                option_d TEXT NOT NULL,\n+                correct_option TEXT NOT NULL CHECK(correct_option IN ('A','B','C','D')),\n+                active INTEGER NOT NULL DEFAULT 1\n+            );\n+            CREATE TABLE IF NOT EXISTS attempts (\n+                id INTEGER PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                score REAL NOT NULL,\n+                correct INTEGER NOT NULL,\n+                total_questions INTEGER NOT NULL,\n+                submitted_at TEXT NOT NULL,\n+                answers TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS attempts_user ON attempts(user_id, id DESC);\n+            CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT);\n+        \"\"\")\n+        connection.execute(\"BEGIN IMMEDIATE\")\n+        if not connection.execute(\"SELECT 1 FROM metadata WHERE key = 'seeded'\").fetchone():\n+            connection.executemany(\n+                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option) VALUES (?, ?, ?, ?, ?, ?)\",\n+                QUESTIONS,\n+            )\n+            connection.execute(\"INSERT INTO metadata VALUES ('seeded', '1')\")\n+        admin = connection.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n+        password = app.config[\"ADMIN_PASSWORD\"]\n+        if admin is None:\n+            connection.execute(\n+                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n+                (generate_password_hash(password or secrets.token_urlsafe(32)),),\n+            )\n+        elif not password or not check_password_hash(admin[\"password_hash\"], password):\n+            connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n+            if password:\n+                connection.execute(\n+                    \"UPDATE users SET password_hash = ? WHERE id = ?\",\n+                    (generate_password_hash(password), admin[\"id\"]),\n+                )\n+        connection.commit()\n+\n+    def fail(message, status=400, errors=None):\n+        response = {\"error\": message}\n+        if errors:\n+            response[\"errors\"] = errors\n+        return response, status\n+\n+    def body():\n+        value = request.get_json(silent=True)\n+        return value if isinstance(value, dict) else None\n+\n+    @app.before_request\n+    def identify_user():\n+        g.user = None\n+        if not request.path.startswith(\"/api\"):\n+            return None\n+        authorization = request.headers.get(\"Authorization\")\n+        if authorization is None:\n+            return None\n+        parts = authorization.split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return fail(\"A valid bearer token is required.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        g.user = db().execute(\n+            \"SELECT users.* FROM sessions JOIN users ON users.id = sessions.user_id WHERE token_hash = ? AND expires_at > ?\",\n+            (token_hash, datetime.now(timezone.utc).isoformat()),\n+        ).fetchone()\n+        if g.user is None or (g.user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"]):\n+            return fail(\"Your session has expired. Please sign in again.\", 401)\n+        g.token_hash = token_hash\n+        return None\n+\n+    def authenticated(admin=False):\n+        def decorator(function):\n+            @wraps(function)\n+            def wrapped(*args, **kwargs):\n+                if g.user is None:\n+                    return fail(\"Please sign in to continue.\", 401)\n+                if admin and not g.user[\"is_admin\"]:\n+                    return fail(\"Administrator access is required.\", 403)\n+                return function(*args, **kwargs)\n+            return wrapped\n+        return decorator\n+\n+    def user_json(user):\n+        return {\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}\n+\n+    def int_param(name, default, maximum):\n+        raw = request.args.get(name, str(default))\n+        if not re.fullmatch(r\"[0-9]+\", raw) or len(raw) > 9:\n+            return None\n+        value = int(raw)\n+        return value if 1 <= value <= maximum else None\n+\n+    def question_json(row, reveal=True):\n+        return {key: row[key] for key in QUESTION_FIELDS if reveal or key != \"correct_option\"}\n+\n+    def attempt_json(row):\n+        return {\n+            \"id\": row[\"id\"], \"score\": row[\"score\"], \"correct\": row[\"correct\"],\n+            \"total_questions\": row[\"total_questions\"], \"submitted_at\": row[\"submitted_at\"],\n+            \"answers\": json.loads(row[\"answers\"]),\n+        }\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        username, password = data.get(\"username\"), data.get(\"password\")\n+        errors = {}\n+        if not isinstance(username, str) or not re.fullmatch(r\"[a-zA-Z0-9_]{3,32}\", username):\n+            errors[\"username\"] = \"Use 3–32 letters, numbers or underscores.\"\n+        if not isinstance(password, str) or not 8 <= len(password) <= 128:\n+            errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n+        if errors:\n+            return fail(\"Please check your account details.\", errors=errors)\n+        if username.lower() == \"admin\":\n+            return fail(\"This username is reserved.\", 409, {\"username\": \"This username is reserved.\"})\n+        try:\n+            db().execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db().commit()\n+        except sqlite3.IntegrityError:\n+            db().rollback()\n+            return fail(\"This username is already taken.\", 409, {\"username\": \"This username is already taken.\"})\n+        return {\"username\": username, \"message\": \"Account created. You can now sign in.\"}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        username, password = data.get(\"username\"), data.get(\"password\")\n+        if not isinstance(username, str) or not isinstance(password, str) or len(password) > 128:\n+            return fail(\"A username and password are required.\")\n+        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if (user is None or (user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"])\n+                or not check_password_hash(user[\"password_hash\"], password)):\n+            return fail(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        db().execute(\n+            \"INSERT INTO sessions VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"],\n+             (datetime.now(timezone.utc) + timedelta(days=30)).isoformat()),\n+        )\n+        db().commit()\n+        return {\"token\": token, \"user\": user_json(user)}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated()\n+    def me():\n+        return user_json(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated()\n+    def logout():\n+        db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        db().commit()\n+        return {\"message\": \"Signed out.\"}\n+\n+    @app.get(\"/api/quiz\")\n+    def quiz():\n+        count = int_param(\"count\", 5, 50)\n+        if count is None:\n+            return fail(\"count must be an integer between 1 and 50.\")\n+        rows = db().execute(\"SELECT * FROM questions WHERE active = 1 ORDER BY RANDOM() LIMIT ?\", (count,)).fetchall()\n+        return {\"items\": [question_json(row, reveal=False) for row in rows]}\n+\n+    @app.post(\"/api/attempts\")\n+    def submit_attempt():\n+        data = body()\n+        answers = data.get(\"answers\") if data is not None else None\n+        if not isinstance(answers, list) or not 1 <= len(answers) <= 50:\n+            return fail(\"answers must contain between 1 and 50 answers.\")\n+        seen = set()\n+        review = []\n+        for index, answer in enumerate(answers):\n+            if not isinstance(answer, dict):\n+                return fail(f\"Answer {index + 1} must be an object.\")\n+            question_id, selected = answer.get(\"question_id\"), answer.get(\"selected\")\n+            if type(question_id) is not int or question_id < 1 or question_id > 9223372036854775807:\n+                return fail(f\"Answer {index + 1} needs a valid question_id.\")\n+            if not isinstance(selected, str) or selected not in (\"A\", \"B\", \"C\", \"D\"):\n+                return fail(f\"Answer {index + 1}: selected must be A, B, C or D.\")\n+            if question_id in seen:\n+                return fail(\"A question can only be answered once per attempt.\")\n+            seen.add(question_id)\n+            row = db().execute(\"SELECT * FROM questions WHERE id = ? AND active = 1\", (question_id,)).fetchone()\n+            if row is None:\n+                return fail(f\"Question {question_id} does not exist or is inactive.\")\n+            review.append({\n+                **question_json(row), \"question_id\": question_id, \"selected\": selected,\n+                \"is_correct\": selected == row[\"correct_option\"],\n+            })\n+        correct = sum(answer[\"is_correct\"] for answer in review)\n+        result = {\n+            \"id\": None, \"score\": round(correct / len(review) * 100, 2),\n+            \"correct\": correct, \"total_questions\": len(review),\n+            \"submitted_at\": datetime.now(timezone.utc).isoformat(), \"answers\": review,\n+        }\n+        if g.user is not None:\n+            cursor = db().execute(\n+                \"INSERT INTO attempts (user_id, score, correct, total_questions, submitted_at, answers) VALUES (?, ?, ?, ?, ?, ?)\",\n+                (g.user[\"id\"], result[\"score\"], correct, len(review), result[\"submitted_at\"], json.dumps(review)),\n+            )\n+            db().commit()\n+            result[\"id\"] = cursor.lastrowid\n+        return result\n+\n+    @app.get(\"/api/attempts\")\n+    @authenticated()\n+    def attempts():\n+        rows = db().execute(\"SELECT * FROM attempts WHERE user_id = ? ORDER BY id DESC\", (g.user[\"id\"],)).fetchall()\n+        return {\"items\": [attempt_json(row) for row in rows]}\n+\n+    @app.get(\"/api/attempts/<int:attempt_id>\")\n+    @authenticated()\n+    def attempt(attempt_id):\n+        if attempt_id > 9223372036854775807:\n+            return fail(\"Attempt not found.\", 404)\n+        row = db().execute(\"SELECT * FROM attempts WHERE id = ? AND user_id = ?\", (attempt_id, g.user[\"id\"])).fetchone()\n+        if row is None:\n+            return fail(\"Attempt not found.\", 404)\n+        return attempt_json(row)\n+\n+    @app.post(\"/api/admin/questions\")\n+    @authenticated(admin=True)\n+    def add_question():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        errors = {}\n+        cleaned = {}\n+        for field in QUESTION_FIELDS[1:-1]:\n+            value = data.get(field)\n+            maximum = 1000 if field == \"text\" else 300\n+            if not isinstance(value, str) or not value.strip() or len(value.strip()) > maximum:\n+                errors[field] = f\"Enter between 1 and {maximum} characters.\"\n+            else:\n+                cleaned[field] = value.strip()\n+        if data.get(\"correct_option\") not in (\"A\", \"B\", \"C\", \"D\"):\n+            errors[\"correct_option\"] = \"Choose the correct option: A, B, C or D.\"\n+        active = data.get(\"active\", True)\n+        if type(active) is not bool:\n+            errors[\"active\"] = \"active must be true or false.\"\n+        if errors:\n+            return fail(\"Please check the highlighted fields.\", errors=errors)\n+        cursor = db().execute(\n+            \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option, active) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n+            (*cleaned.values(), data[\"correct_option\"], int(active)),\n+        )\n+        db().commit()\n+        row = db().execute(\"SELECT * FROM questions WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n+        return question_json(row), 201\n+\n+    @app.get(\"/api/admin/questions\")\n+    @authenticated(admin=True)\n+    def admin_questions():\n+        page, page_size = int_param(\"page\", 1, 1000000), int_param(\"page_size\", 10, 100)\n+        if page is None or page_size is None:\n+            return fail(\"page must be a positive integer; page_size must be between 1 and 100.\")\n+        total = db().execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n+        rows = db().execute(\"SELECT * FROM questions ORDER BY id DESC LIMIT ? OFFSET ?\", (page_size, (page - 1) * page_size)).fetchall()\n+        return {\"items\": [question_json(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        return fail(error.description, error.code)\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return fail(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n*** Add File: /workspace/backend/__init__.py\n*** Add File: /workspace/backend/seed.py\n+QUESTIONS = [\n+    (\"Which planet is known as the Red Planet?\", \"Venus\", \"Mars\", \"Jupiter\", \"Saturn\", \"B\"),\n+    (\"What is the largest ocean on Earth?\", \"Atlantic Ocean\", \"Indian Ocean\", \"Arctic Ocean\", \"Pacific Ocean\", \"D\"),\n+    (\"Who painted the Mona Lisa?\", \"Vincent van Gogh\", \"Pablo Picasso\", \"Leonardo da Vinci\", \"Claude Monet\", \"C\"),\n+    (\"What is the chemical symbol for gold?\", \"Au\", \"Ag\", \"Fe\", \"Cu\", \"A\"),\n+    (\"Which country is home to the ancient city of Machu Picchu?\", \"Mexico\", \"Peru\", \"Chile\", \"Brazil\", \"B\"),\n+    (\"How many bones are in a typical adult human body?\", \"186\", \"196\", \"206\", \"216\", \"C\"),\n+    (\"Who wrote Pride and Prejudice?\", \"Charlotte Brontë\", \"Virginia Woolf\", \"Mary Shelley\", \"Jane Austen\", \"D\"),\n+    (\"What is the smallest prime number?\", \"2\", \"0\", \"1\", \"3\", \"A\"),\n+    (\"Which gas do plants absorb during photosynthesis?\", \"Oxygen\", \"Carbon dioxide\", \"Nitrogen\", \"Hydrogen\", \"B\"),\n+    (\"In which year did humans first land on the Moon?\", \"1959\", \"1965\", \"1969\", \"1972\", \"C\"),\n+    (\"What is the capital of Japan?\", \"Kyoto\", \"Osaka\", \"Seoul\", \"Tokyo\", \"D\"),\n+    (\"Which instrument has 88 keys on a standard modern version?\", \"Piano\", \"Violin\", \"Trumpet\", \"Flute\", \"A\"),\n+    (\"What is the fastest land animal?\", \"Lion\", \"Cheetah\", \"Pronghorn\", \"Leopard\", \"B\"),\n+    (\"Which scientist developed the theory of general relativity?\", \"Isaac Newton\", \"Marie Curie\", \"Albert Einstein\", \"Galileo Galilei\", \"C\"),\n+    (\"How many players are on the field for one football (soccer) team?\", \"9\", \"10\", \"12\", \"11\", \"D\"),\n+    (\"What is the largest organ of the human body?\", \"Skin\", \"Liver\", \"Heart\", \"Lungs\", \"A\"),\n+    (\"Which language has the most native speakers worldwide?\", \"English\", \"Mandarin Chinese\", \"Spanish\", \"Hindi\", \"B\"),\n+    (\"What is the hardest naturally occurring mineral?\", \"Quartz\", \"Ruby\", \"Diamond\", \"Emerald\", \"C\"),\n+    (\"On which continent is the Sahara Desert?\", \"Asia\", \"Australia\", \"South America\", \"Africa\", \"D\"),\n+    (\"Who wrote the play Romeo and Juliet?\", \"William Shakespeare\", \"Charles Dickens\", \"Oscar Wilde\", \"George Orwell\", \"A\"),\n+    (\"What is the currency of Japan?\", \"Won\", \"Yen\", \"Yuan\", \"Rupee\", \"B\"),\n+    (\"Which planet has the most prominent ring system?\", \"Earth\", \"Mars\", \"Saturn\", \"Venus\", \"C\"),\n+    (\"How many sides does a hexagon have?\", \"5\", \"7\", \"8\", \"6\", \"D\"),\n+    (\"What is the main ingredient in traditional hummus?\", \"Chickpeas\", \"Lentils\", \"Potatoes\", \"Peas\", \"A\"),\n+    (\"Which city hosted the first modern Olympic Games in 1896?\", \"Paris\", \"Athens\", \"London\", \"Rome\", \"B\"),\n+    (\"What is the process of a liquid turning into a gas called?\", \"Condensation\", \"Freezing\", \"Evaporation\", \"Melting\", \"C\"),\n+    (\"Which artist is famous for the painting The Starry Night?\", \"Salvador Dalí\", \"Henri Matisse\", \"Rembrandt\", \"Vincent van Gogh\", \"D\"),\n+    (\"What is the largest species of shark?\", \"Whale shark\", \"Great white shark\", \"Tiger shark\", \"Hammerhead shark\", \"A\"),\n+    (\"Which element has the chemical symbol O?\", \"Osmium\", \"Oxygen\", \"Gold\", \"Oganesson\", \"B\"),\n+    (\"Which country gifted the Statue of Liberty to the United States?\", \"Italy\", \"Spain\", \"France\", \"Germany\", \"C\"),\n+]\n*** Add File: /workspace/.gitignore\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n*** Update File: /workspace/Dockerfile\n@@\n-CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]\n+CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"backend.app:app\"]\n*** End Patch"},"output":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/__init__.py\nA backend/seed.py\nA .gitignore\nM Dockerfile","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n\nIndex: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,355 @@\n+import hashlib\n+import json\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+from backend.seed import QUESTIONS\n+\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+QUESTION_FIELDS = (\n+    \"id\", \"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\", \"correct_option\"\n+)\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"quiz.sqlite3\"),\n+        ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n+        MAX_CONTENT_LENGTH=256 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+\n+    def db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=30)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(error=None):\n+        connection = g.pop(\"db\", None)\n+        if connection is not None:\n+            connection.close()\n+\n+    with app.app_context():\n+        connection = db()\n+        connection.execute(\"PRAGMA journal_mode = WAL\")\n+        connection.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL,\n+                is_admin INTEGER NOT NULL DEFAULT 0\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS questions (\n+                id INTEGER PRIMARY KEY,\n+                text TEXT NOT NULL,\n+                option_a TEXT NOT NULL,\n+                option_b TEXT NOT NULL,\n+                option_c TEXT NOT NULL,\n+                option_d TEXT NOT NULL,\n+                correct_option TEXT NOT NULL CHECK(correct_option IN ('A','B','C','D')),\n+                active INTEGER NOT NULL DEFAULT 1\n+            );\n+            CREATE TABLE IF NOT EXISTS attempts (\n+                id INTEGER PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                score REAL NOT NULL,\n+                correct INTEGER NOT NULL,\n+                total_questions INTEGER NOT NULL,\n+                submitted_at TEXT NOT NULL,\n+                answers TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS attempts_user ON attempts(user_id, id DESC);\n+            CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT);\n+        \"\"\")\n+        connection.execute(\"BEGIN IMMEDIATE\")\n+        if not connection.execute(\"SELECT 1 FROM metadata WHERE key = 'seeded'\").fetchone():\n+            connection.executemany(\n+                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option) VALUES (?, ?, ?, ?, ?, ?)\",\n+                QUESTIONS,\n+            )\n+            connection.execute(\"INSERT INTO metadata VALUES ('seeded', '1')\")\n+        admin = connection.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n+        password = app.config[\"ADMIN_PASSWORD\"]\n+        if admin is None:\n+            connection.execute(\n+                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n+                (generate_password_hash(password or secrets.token_urlsafe(32)),),\n+            )\n+        elif not password or not check_password_hash(admin[\"password_hash\"], password):\n+            connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n+            if password:\n+                connection.execute(\n+                    \"UPDATE users SET password_hash = ? WHERE id = ?\",\n+                    (generate_password_hash(password), admin[\"id\"]),\n+                )\n+        connection.commit()\n+\n+    def fail(message, status=400, errors=None):\n+        response = {\"error\": message}\n+        if errors:\n+            response[\"errors\"] = errors\n+        return response, status\n+\n+    def body():\n+        value = request.get_json(silent=True)\n+        return value if isinstance(value, dict) else None\n+\n+    @app.before_request\n+    def identify_user():\n+        g.user = None\n+        if not request.path.startswith(\"/api\"):\n+            return None\n+        authorization = request.headers.get(\"Authorization\")\n+        if authorization is None:\n+            return None\n+        parts = authorization.split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return fail(\"A valid bearer token is required.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        g.user = db().execute(\n+            \"SELECT users.* FROM sessions JOIN users ON users.id = sessions.user_id WHERE token_hash = ? AND expires_at > ?\",\n+            (token_hash, datetime.now(timezone.utc).isoformat()),\n+        ).fetchone()\n+        if g.user is None or (g.user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"]):\n+            return fail(\"Your session has expired. Please sign in again.\", 401)\n+        g.token_hash = token_hash\n+        return None\n+\n+    def authenticated(admin=False):\n+        def decorator(function):\n+            @wraps(function)\n+            def wrapped(*args, **kwargs):\n+                if g.user is None:\n+                    return fail(\"Please sign in to continue.\", 401)\n+                if admin and not g.user[\"is_admin\"]:\n+                    return fail(\"Administrator access is required.\", 403)\n+                return function(*args, **kwargs)\n+            return wrapped\n+        return decorator\n+\n+    def user_json(user):\n+        return {\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}\n+\n+    def int_param(name, default, maximum):\n+        raw = request.args.get(name, str(default))\n+        if not re.fullmatch(r\"[0-9]+\", raw) or len(raw) > 9:\n+            return None\n+        value = int(raw)\n+        return value if 1 <= value <= maximum else None\n+\n+    def question_json(row, reveal=True):\n+        return {key: row[key] for key in QUESTION_FIELDS if reveal or key != \"correct_option\"}\n+\n+    def attempt_json(row):\n+        return {\n+            \"id\": row[\"id\"], \"score\": row[\"score\"], \"correct\": row[\"correct\"],\n+            \"total_questions\": row[\"total_questions\"], \"submitted_at\": row[\"submitted_at\"],\n+            \"answers\": json.loads(row[\"answers\"]),\n+        }\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        username, password = data.get(\"username\"), data.get(\"password\")\n+        errors = {}\n+        if not isinstance(username, str) or not re.fullmatch(r\"[a-zA-Z0-9_]{3,32}\", username):\n+            errors[\"username\"] = \"Use 3–32 letters, numbers or underscores.\"\n+        if not isinstance(password, str) or not 8 <= len(password) <= 128:\n+            errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n+        if errors:\n+            return fail(\"Please check your account details.\", errors=errors)\n+        if username.lower() == \"admin\":\n+            return fail(\"This username is reserved.\", 409, {\"username\": \"This username is reserved.\"})\n+        try:\n+            db().execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db().commit()\n+        except sqlite3.IntegrityError:\n+            db().rollback()\n+            return fail(\"This username is already taken.\", 409, {\"username\": \"This username is already taken.\"})\n+        return {\"username\": username, \"message\": \"Account created. You can now sign in.\"}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        username, password = data.get(\"username\"), data.get(\"password\")\n+        if not isinstance(username, str) or not isinstance(password, str) or len(password) > 128:\n+            return fail(\"A username and password are required.\")\n+        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if (user is None or (user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"])\n+                or not check_password_hash(user[\"password_hash\"], password)):\n+            return fail(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        db().execute(\n+            \"INSERT INTO sessions VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"],\n+             (datetime.now(timezone.utc) + timedelta(days=30)).isoformat()),\n+        )\n+        db().commit()\n+        return {\"token\": token, \"user\": user_json(user)}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated()\n+    def me():\n+        return user_json(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated()\n+    def logout():\n+        db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        db().commit()\n+        return {\"message\": \"Signed out.\"}\n+\n+    @app.get(\"/api/quiz\")\n+    def quiz():\n+        count = int_param(\"count\", 5, 50)\n+        if count is None:\n+            return fail(\"count must be an integer between 1 and 50.\")\n+        rows = db().execute(\"SELECT * FROM questions WHERE active = 1 ORDER BY RANDOM() LIMIT ?\", (count,)).fetchall()\n+        return {\"items\": [question_json(row, reveal=False) for row in rows]}\n+\n+    @app.post(\"/api/attempts\")\n+    def submit_attempt():\n+        data = body()\n+        answers = data.get(\"answers\") if data is not None else None\n+        if not isinstance(answers, list) or not 1 <= len(answers) <= 50:\n+            return fail(\"answers must contain between 1 and 50 answers.\")\n+        seen = set()\n+        review = []\n+        for index, answer in enumerate(answers):\n+            if not isinstance(answer, dict):\n+                return fail(f\"Answer {index + 1} must be an object.\")\n+            question_id, selected = answer.get(\"question_id\"), answer.get(\"selected\")\n+            if type(question_id) is not int or question_id < 1 or question_id > 9223372036854775807:\n+                return fail(f\"Answer {index + 1} needs a valid question_id.\")\n+            if not isinstance(selected, str) or selected not in (\"A\", \"B\", \"C\", \"D\"):\n+                return fail(f\"Answer {index + 1}: selected must be A, B, C or D.\")\n+            if question_id in seen:\n+                return fail(\"A question can only be answered once per attempt.\")\n+            seen.add(question_id)\n+            row = db().execute(\"SELECT * FROM questions WHERE id = ? AND active = 1\", (question_id,)).fetchone()\n+            if row is None:\n+                return fail(f\"Question {question_id} does not exist or is inactive.\")\n+            review.append({\n+                **question_json(row), \"question_id\": question_id, \"selected\": selected,\n+                \"is_correct\": selected == row[\"correct_option\"],\n+            })\n+        correct = sum(answer[\"is_correct\"] for answer in review)\n+        result = {\n+            \"id\": None, \"score\": round(correct / len(review) * 100, 2),\n+            \"correct\": correct, \"total_questions\": len(review),\n+            \"submitted_at\": datetime.now(timezone.utc).isoformat(), \"answers\": review,\n+        }\n+        if g.user is not None:\n+            cursor = db().execute(\n+                \"INSERT INTO attempts (user_id, score, correct, total_questions, submitted_at, answers) VALUES (?, ?, ?, ?, ?, ?)\",\n+                (g.user[\"id\"], result[\"score\"], correct, len(review), result[\"submitted_at\"], json.dumps(review)),\n+            )\n+            db().commit()\n+            result[\"id\"] = cursor.lastrowid\n+        return result\n+\n+    @app.get(\"/api/attempts\")\n+    @authenticated()\n+    def attempts():\n+        rows = db().execute(\"SELECT * FROM attempts WHERE user_id = ? ORDER BY id DESC\", (g.user[\"id\"],)).fetchall()\n+        return {\"items\": [attempt_json(row) for row in rows]}\n+\n+    @app.get(\"/api/attempts/<int:attempt_id>\")\n+    @authenticated()\n+    def attempt(attempt_id):\n+        if attempt_id > 9223372036854775807:\n+            return fail(\"Attempt not found.\", 404)\n+        row = db().execute(\"SELECT * FROM attempts WHERE id = ? AND user_id = ?\", (attempt_id, g.user[\"id\"])).fetchone()\n+        if row is None:\n+            return fail(\"Attempt not found.\", 404)\n+        return attempt_json(row)\n+\n+    @app.post(\"/api/admin/questions\")\n+    @authenticated(admin=True)\n+    def add_question():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        errors = {}\n+        cleaned = {}\n+        for field in QUESTION_FIELDS[1:-1]:\n+            value = data.get(field)\n+            maximum = 1000 if field == \"text\" else 300\n+            if not isinstance(value, str) or not value.strip() or len(value.strip()) > maximum:\n+                errors[field] = f\"Enter between 1 and {maximum} characters.\"\n+            else:\n+                cleaned[field] = value.strip()\n+        if data.get(\"correct_option\") not in (\"A\", \"B\", \"C\", \"D\"):\n+            errors[\"correct_option\"] = \"Choose the correct option: A, B, C or D.\"\n+        active = data.get(\"active\", True)\n+        if type(active) is not bool:\n+            errors[\"active\"] = \"active must be true or false.\"\n+        if errors:\n+            return fail(\"Please check the highlighted fields.\", errors=errors)\n+        cursor = db().execute(\n+            \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option, active) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n+            (*cleaned.values(), data[\"correct_option\"], int(active)),\n+        )\n+        db().commit()\n+        row = db().execute(\"SELECT * FROM questions WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n+        return question_json(row), 201\n+\n+    @app.get(\"/api/admin/questions\")\n+    @authenticated(admin=True)\n+    def admin_questions():\n+        page, page_size = int_param(\"page\", 1, 1000000), int_param(\"page_size\", 10, 100)\n+        if page is None or page_size is None:\n+            return fail(\"page must be a positive integer; page_size must be between 1 and 100.\")\n+        total = db().execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n+        rows = db().execute(\"SELECT * FROM questions ORDER BY id DESC LIMIT ? OFFSET ?\", (page_size, (page - 1) * page_size)).fetchall()\n+        return {\"items\": [question_json(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        return fail(error.description, error.code)\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return fail(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n\nIndex: /workspace/backend/__init__.py\n===================================================================\n--- /workspace/backend/__init__.py\n+++ /workspace/backend/__init__.py\n\nIndex: /workspace/backend/seed.py\n===================================================================\n--- /workspace/backend/seed.py\n+++ /workspace/backend/seed.py\n@@ -0,0 +1,32 @@\n+QUESTIONS = [\n+    (\"Which planet is known as the Red Planet?\", \"Venus\", \"Mars\", \"Jupiter\", \"Saturn\", \"B\"),\n+    (\"What is the largest ocean on Earth?\", \"Atlantic Ocean\", \"Indian Ocean\", \"Arctic Ocean\", \"Pacific Ocean\", \"D\"),\n+    (\"Who painted the Mona Lisa?\", \"Vincent van Gogh\", \"Pablo Picasso\", \"Leonardo da Vinci\", \"Claude Monet\", \"C\"),\n+    (\"What is the chemical symbol for gold?\", \"Au\", \"Ag\", \"Fe\", \"Cu\", \"A\"),\n+    (\"Which country is home to the ancient city of Machu Picchu?\", \"Mexico\", \"Peru\", \"Chile\", \"Brazil\", \"B\"),\n+    (\"How many bones are in a typical adult human body?\", \"186\", \"196\", \"206\", \"216\", \"C\"),\n+    (\"Who wrote Pride and Prejudice?\", \"Charlotte Brontë\", \"Virginia Woolf\", \"Mary Shelley\", \"Jane Austen\", \"D\"),\n+    (\"What is the smallest prime number?\", \"2\", \"0\", \"1\", \"3\", \"A\"),\n+    (\"Which gas do plants absorb during photosynthesis?\", \"Oxygen\", \"Carbon dioxide\", \"Nitrogen\", \"Hydrogen\", \"B\"),\n+    (\"In which year did humans first land on the Moon?\", \"1959\", \"1965\", \"1969\", \"1972\", \"C\"),\n+    (\"What is the capital of Japan?\", \"Kyoto\", \"Osaka\", \"Seoul\", \"Tokyo\", \"D\"),\n+    (\"Which instrument has 88 keys on a standard modern version?\", \"Piano\", \"Violin\", \"Trumpet\", \"Flute\", \"A\"),\n+    (\"What is the fastest land animal?\", \"Lion\", \"Cheetah\", \"Pronghorn\", \"Leopard\", \"B\"),\n+    (\"Which scientist developed the theory of general relativity?\", \"Isaac Newton\", \"Marie Curie\", \"Albert Einstein\", \"Galileo Galilei\", \"C\"),\n+    (\"How many players are on the field for one football (soccer) team?\", \"9\", \"10\", \"12\", \"11\", \"D\"),\n+    (\"What is the largest organ of the human body?\", \"Skin\", \"Liver\", \"Heart\", \"Lungs\", \"A\"),\n+    (\"Which language has the most native speakers worldwide?\", \"English\", \"Mandarin Chinese\", \"Spanish\", \"Hindi\", \"B\"),\n+    (\"What is the hardest naturally occurring mineral?\", \"Quartz\", \"Ruby\", \"Diamond\", \"Emerald\", \"C\"),\n+    (\"On which continent is the Sahara Desert?\", \"Asia\", \"Australia\", \"South America\", \"Africa\", \"D\"),\n+    (\"Who wrote the play Romeo and Juliet?\", \"William Shakespeare\", \"Charles Dickens\", \"Oscar Wilde\", \"George Orwell\", \"A\"),\n+    (\"What is the currency of Japan?\", \"Won\", \"Yen\", \"Yuan\", \"Rupee\", \"B\"),\n+    (\"Which planet has the most prominent ring system?\", \"Earth\", \"Mars\", \"Saturn\", \"Venus\", \"C\"),\n+    (\"How many sides does a hexagon have?\", \"5\", \"7\", \"8\", \"6\", \"D\"),\n+    (\"What is the main ingredient in traditional hummus?\", \"Chickpeas\", \"Lentils\", \"Potatoes\", \"Peas\", \"A\"),\n+    (\"Which city hosted the first modern Olympic Games in 1896?\", \"Paris\", \"Athens\", \"London\", \"Rome\", \"B\"),\n+    (\"What is the process of a liquid turning into a gas called?\", \"Condensation\", \"Freezing\", \"Evaporation\", \"Melting\", \"C\"),\n+    (\"Which artist is famous for the painting The Starry Night?\", \"Salvador Dalí\", \"Henri Matisse\", \"Rembrandt\", \"Vincent van Gogh\", \"D\"),\n+    (\"What is the largest species of shark?\", \"Whale shark\", \"Great white shark\", \"Tiger shark\", \"Hammerhead shark\", \"A\"),\n+    (\"Which element has the chemical symbol O?\", \"Osmium\", \"Oxygen\", \"Gold\", \"Oganesson\", \"B\"),\n+    (\"Which country gifted the Statue of Liberty to the United States?\", \"Italy\", \"Spain\", \"France\", \"Germany\", \"C\"),\n+]\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n\nIndex: /workspace/Dockerfile\n===================================================================\n--- /workspace/Dockerfile\n+++ /workspace/Dockerfile\n@@ -21,5 +21,5 @@\n COPY backend/ backend/\n COPY --from=frontend /app/frontend/dist frontend/dist\n RUN mkdir -p data\n EXPOSE 8000\n-CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]\n+CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"backend.app:app\"]\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,355 @@\n+import hashlib\n+import json\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+from backend.seed import QUESTIONS\n+\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+QUESTION_FIELDS = (\n+    \"id\", \"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\", \"correct_option\"\n+)\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"quiz.sqlite3\"),\n+        ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n+        MAX_CONTENT_LENGTH=256 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+\n+    def db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=30)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(error=None):\n+        connection = g.pop(\"db\", None)\n+        if connection is not None:\n+            connection.close()\n+\n+    with app.app_context():\n+        connection = db()\n+        connection.execute(\"PRAGMA journal_mode = WAL\")\n+        connection.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL,\n+                is_admin INTEGER NOT NULL DEFAULT 0\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS questions (\n+                id INTEGER PRIMARY KEY,\n+                text TEXT NOT NULL,\n+                option_a TEXT NOT NULL,\n+                option_b TEXT NOT NULL,\n+                option_c TEXT NOT NULL,\n+                option_d TEXT NOT NULL,\n+                correct_option TEXT NOT NULL CHECK(correct_option IN ('A','B','C','D')),\n+                active INTEGER NOT NULL DEFAULT 1\n+            );\n+            CREATE TABLE IF NOT EXISTS attempts (\n+                id INTEGER PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                score REAL NOT NULL,\n+                correct INTEGER NOT NULL,\n+                total_questions INTEGER NOT NULL,\n+                submitted_at TEXT NOT NULL,\n+                answers TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS attempts_user ON attempts(user_id, id DESC);\n+            CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT);\n+        \"\"\")\n+        connection.execute(\"BEGIN IMMEDIATE\")\n+        if not connection.execute(\"SELECT 1 FROM metadata WHERE key = 'seeded'\").fetchone():\n+            connection.executemany(\n+                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option) VALUES (?, ?, ?, ?, ?, ?)\",\n+                QUESTIONS,\n+            )\n+            connection.execute(\"INSERT INTO metadata VALUES ('seeded', '1')\")\n+        admin = connection.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n+        password = app.config[\"ADMIN_PASSWORD\"]\n+        if admin is None:\n+            connection.execute(\n+                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n+                (generate_password_hash(password or secrets.token_urlsafe(32)),),\n+            )\n+        elif not password or not check_password_hash(admin[\"password_hash\"], password):\n+            connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n+            if password:\n+                connection.execute(\n+                    \"UPDATE users SET password_hash = ? WHERE id = ?\",\n+                    (generate_password_hash(password), admin[\"id\"]),\n+                )\n+        connection.commit()\n+\n+    def fail(message, status=400, errors=None):\n+        response = {\"error\": message}\n+        if errors:\n+            response[\"errors\"] = errors\n+        return response, status\n+\n+    def body():\n+        value = request.get_json(silent=True)\n+        return value if isinstance(value, dict) else None\n+\n+    @app.before_request\n+    def identify_user():\n+        g.user = None\n+        if not request.path.startswith(\"/api\"):\n+            return None\n+        authorization = request.headers.get(\"Authorization\")\n+        if authorization is None:\n+            return None\n+        parts = authorization.split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return fail(\"A valid bearer token is required.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        g.user = db().execute(\n+            \"SELECT users.* FROM sessions JOIN users ON users.id = sessions.user_id WHERE token_hash = ? AND expires_at > ?\",\n+            (token_hash, datetime.now(timezone.utc).isoformat()),\n+        ).fetchone()\n+        if g.user is None or (g.user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"]):\n+            return fail(\"Your session has expired. Please sign in again.\", 401)\n+        g.token_hash = token_hash\n+        return None\n+\n+    def authenticated(admin=False):\n+        def decorator(function):\n+            @wraps(function)\n+            def wrapped(*args, **kwargs):\n+                if g.user is None:\n+                    return fail(\"Please sign in to continue.\", 401)\n+                if admin and not g.user[\"is_admin\"]:\n+                    return fail(\"Administrator access is required.\", 403)\n+                return function(*args, **kwargs)\n+            return wrapped\n+        return decorator\n+\n+    def user_json(user):\n+        return {\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}\n+\n+    def int_param(name, default, maximum):\n+        raw = request.args.get(name, str(default))\n+        if not re.fullmatch(r\"[0-9]+\", raw) or len(raw) > 9:\n+            return None\n+        value = int(raw)\n+        return value if 1 <= value <= maximum else None\n+\n+    def question_json(row, reveal=True):\n+        return {key: row[key] for key in QUESTION_FIELDS if reveal or key != \"correct_option\"}\n+\n+    def attempt_json(row):\n+        return {\n+            \"id\": row[\"id\"], \"score\": row[\"score\"], \"correct\": row[\"correct\"],\n+            \"total_questions\": row[\"total_questions\"], \"submitted_at\": row[\"submitted_at\"],\n+            \"answers\": json.loads(row[\"answers\"]),\n+        }\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        username, password = data.get(\"username\"), data.get(\"password\")\n+        errors = {}\n+        if not isinstance(username, str) or not re.fullmatch(r\"[a-zA-Z0-9_]{3,32}\", username):\n+            errors[\"username\"] = \"Use 3–32 letters, numbers or underscores.\"\n+        if not isinstance(password, str) or not 8 <= len(password) <= 128:\n+            errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n+        if errors:\n+            return fail(\"Please check your account details.\", errors=errors)\n+        if username.lower() == \"admin\":\n+            return fail(\"This username is reserved.\", 409, {\"username\": \"This username is reserved.\"})\n+        try:\n+            db().execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db().commit()\n+        except sqlite3.IntegrityError:\n+            db().rollback()\n+            return fail(\"This username is already taken.\", 409, {\"username\": \"This username is already taken.\"})\n+        return {\"username\": username, \"message\": \"Account created. You can now sign in.\"}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        username, password = data.get(\"username\"), data.get(\"password\")\n+        if not isinstance(username, str) or not isinstance(password, str) or len(password) > 128:\n+            return fail(\"A username and password are required.\")\n+        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if (user is None or (user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"])\n+                or not check_password_hash(user[\"password_hash\"], password)):\n+            return fail(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        db().execute(\n+            \"INSERT INTO sessions VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"],\n+             (datetime.now(timezone.utc) + timedelta(days=30)).isoformat()),\n+        )\n+        db().commit()\n+        return {\"token\": token, \"user\": user_json(user)}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated()\n+    def me():\n+        return user_json(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated()\n+    def logout():\n+        db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        db().commit()\n+        return {\"message\": \"Signed out.\"}\n+\n+    @app.get(\"/api/quiz\")\n+    def quiz():\n+        count = int_param(\"count\", 5, 50)\n+        if count is None:\n+            return fail(\"count must be an integer between 1 and 50.\")\n+        rows = db().execute(\"SELECT * FROM questions WHERE active = 1 ORDER BY RANDOM() LIMIT ?\", (count,)).fetchall()\n+        return {\"items\": [question_json(row, reveal=False) for row in rows]}\n+\n+    @app.post(\"/api/attempts\")\n+    def submit_attempt():\n+        data = body()\n+        answers = data.get(\"answers\") if data is not None else None\n+        if not isinstance(answers, list) or not 1 <= len(answers) <= 50:\n+            return fail(\"answers must contain between 1 and 50 answers.\")\n+        seen = set()\n+        review = []\n+        for index, answer in enumerate(answers):\n+            if not isinstance(answer, dict):\n+                return fail(f\"Answer {index + 1} must be an object.\")\n+            question_id, selected = answer.get(\"question_id\"), answer.get(\"selected\")\n+            if type(question_id) is not int or question_id < 1 or question_id > 9223372036854775807:\n+                return fail(f\"Answer {index + 1} needs a valid question_id.\")\n+            if not isinstance(selected, str) or selected not in (\"A\", \"B\", \"C\", \"D\"):\n+                return fail(f\"Answer {index + 1}: selected must be A, B, C or D.\")\n+            if question_id in seen:\n+                return fail(\"A question can only be answered once per attempt.\")\n+            seen.add(question_id)\n+            row = db().execute(\"SELECT * FROM questions WHERE id = ? AND active = 1\", (question_id,)).fetchone()\n+            if row is None:\n+                return fail(f\"Question {question_id} does not exist or is inactive.\")\n+            review.append({\n+                **question_json(row), \"question_id\": question_id, \"selected\": selected,\n+                \"is_correct\": selected == row[\"correct_option\"],\n+            })\n+        correct = sum(answer[\"is_correct\"] for answer in review)\n+        result = {\n+            \"id\": None, \"score\": round(correct / len(review) * 100, 2),\n+            \"correct\": correct, \"total_questions\": len(review),\n+            \"submitted_at\": datetime.now(timezone.utc).isoformat(), \"answers\": review,\n+        }\n+        if g.user is not None:\n+            cursor = db().execute(\n+                \"INSERT INTO attempts (user_id, score, correct, total_questions, submitted_at, answers) VALUES (?, ?, ?, ?, ?, ?)\",\n+                (g.user[\"id\"], result[\"score\"], correct, len(review), result[\"submitted_at\"], json.dumps(review)),\n+            )\n+            db().commit()\n+            result[\"id\"] = cursor.lastrowid\n+        return result\n+\n+    @app.get(\"/api/attempts\")\n+    @authenticated()\n+    def attempts():\n+        rows = db().execute(\"SELECT * FROM attempts WHERE user_id = ? ORDER BY id DESC\", (g.user[\"id\"],)).fetchall()\n+        return {\"items\": [attempt_json(row) for row in rows]}\n+\n+    @app.get(\"/api/attempts/<int:attempt_id>\")\n+    @authenticated()\n+    def attempt(attempt_id):\n+        if attempt_id > 9223372036854775807:\n+            return fail(\"Attempt not found.\", 404)\n+        row = db().execute(\"SELECT * FROM attempts WHERE id = ? AND user_id = ?\", (attempt_id, g.user[\"id\"])).fetchone()\n+        if row is None:\n+            return fail(\"Attempt not found.\", 404)\n+        return attempt_json(row)\n+\n+    @app.post(\"/api/admin/questions\")\n+    @authenticated(admin=True)\n+    def add_question():\n+        data = body()\n+        if data is None:\n+            return fail(\"A JSON object is required.\")\n+        errors = {}\n+        cleaned = {}\n+        for field in QUESTION_FIELDS[1:-1]:\n+            value = data.get(field)\n+            maximum = 1000 if field == \"text\" else 300\n+            if not isinstance(value, str) or not value.strip() or len(value.strip()) > maximum:\n+                errors[field] = f\"Enter between 1 and {maximum} characters.\"\n+            else:\n+                cleaned[field] = value.strip()\n+        if data.get(\"correct_option\") not in (\"A\", \"B\", \"C\", \"D\"):\n+            errors[\"correct_option\"] = \"Choose the correct option: A, B, C or D.\"\n+        active = data.get(\"active\", True)\n+        if type(active) is not bool:\n+            errors[\"active\"] = \"active must be true or false.\"\n+        if errors:\n+            return fail(\"Please check the highlighted fields.\", errors=errors)\n+        cursor = db().execute(\n+            \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option, active) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n+            (*cleaned.values(), data[\"correct_option\"], int(active)),\n+        )\n+        db().commit()\n+        row = db().execute(\"SELECT * FROM questions WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n+        return question_json(row), 201\n+\n+    @app.get(\"/api/admin/questions\")\n+    @authenticated(admin=True)\n+    def admin_questions():\n+        page, page_size = int_param(\"page\", 1, 1000000), int_param(\"page_size\", 10, 100)\n+        if page is None or page_size is None:\n+            return fail(\"page must be a positive integer; page_size must be between 1 and 100.\")\n+        total = db().execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n+        rows = db().execute(\"SELECT * FROM questions ORDER BY id DESC LIMIT ? OFFSET ?\", (page_size, (page - 1) * page_size)).fetchall()\n+        return {\"items\": [question_json(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        return fail(error.description, error.code)\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return fail(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n","additions":355,"deletions":0},{"filePath":"/workspace/backend/__init__.py","relativePath":"backend/__init__.py","type":"add","patch":"Index: /workspace/backend/__init__.py\n===================================================================\n--- /workspace/backend/__init__.py\n+++ /workspace/backend/__init__.py\n","additions":0,"deletions":0},{"filePath":"/workspace/backend/seed.py","relativePath":"backend/seed.py","type":"add","patch":"Index: /workspace/backend/seed.py\n===================================================================\n--- /workspace/backend/seed.py\n+++ /workspace/backend/seed.py\n@@ -0,0 +1,32 @@\n+QUESTIONS = [\n+    (\"Which planet is known as the Red Planet?\", \"Venus\", \"Mars\", \"Jupiter\", \"Saturn\", \"B\"),\n+    (\"What is the largest ocean on Earth?\", \"Atlantic Ocean\", \"Indian Ocean\", \"Arctic Ocean\", \"Pacific Ocean\", \"D\"),\n+    (\"Who painted the Mona Lisa?\", \"Vincent van Gogh\", \"Pablo Picasso\", \"Leonardo da Vinci\", \"Claude Monet\", \"C\"),\n+    (\"What is the chemical symbol for gold?\", \"Au\", \"Ag\", \"Fe\", \"Cu\", \"A\"),\n+    (\"Which country is home to the ancient city of Machu Picchu?\", \"Mexico\", \"Peru\", \"Chile\", \"Brazil\", \"B\"),\n+    (\"How many bones are in a typical adult human body?\", \"186\", \"196\", \"206\", \"216\", \"C\"),\n+    (\"Who wrote Pride and Prejudice?\", \"Charlotte Brontë\", \"Virginia Woolf\", \"Mary Shelley\", \"Jane Austen\", \"D\"),\n+    (\"What is the smallest prime number?\", \"2\", \"0\", \"1\", \"3\", \"A\"),\n+    (\"Which gas do plants absorb during photosynthesis?\", \"Oxygen\", \"Carbon dioxide\", \"Nitrogen\", \"Hydrogen\", \"B\"),\n+    (\"In which year did humans first land on the Moon?\", \"1959\", \"1965\", \"1969\", \"1972\", \"C\"),\n+    (\"What is the capital of Japan?\", \"Kyoto\", \"Osaka\", \"Seoul\", \"Tokyo\", \"D\"),\n+    (\"Which instrument has 88 keys on a standard modern version?\", \"Piano\", \"Violin\", \"Trumpet\", \"Flute\", \"A\"),\n+    (\"What is the fastest land animal?\", \"Lion\", \"Cheetah\", \"Pronghorn\", \"Leopard\", \"B\"),\n+    (\"Which scientist developed the theory of general relativity?\", \"Isaac Newton\", \"Marie Curie\", \"Albert Einstein\", \"Galileo Galilei\", \"C\"),\n+    (\"How many players are on the field for one football (soccer) team?\", \"9\", \"10\", \"12\", \"11\", \"D\"),\n+    (\"What is the largest organ of the human body?\", \"Skin\", \"Liver\", \"Heart\", \"Lungs\", \"A\"),\n+    (\"Which language has the most native speakers worldwide?\", \"English\", \"Mandarin Chinese\", \"Spanish\", \"Hindi\", \"B\"),\n+    (\"What is the hardest naturally occurring mineral?\", \"Quartz\", \"Ruby\", \"Diamond\", \"Emerald\", \"C\"),\n+    (\"On which continent is the Sahara Desert?\", \"Asia\", \"Australia\", \"South America\", \"Africa\", \"D\"),\n+    (\"Who wrote the play Romeo and Juliet?\", \"William Shakespeare\", \"Charles Dickens\", \"Oscar Wilde\", \"George Orwell\", \"A\"),\n+    (\"What is the currency of Japan?\", \"Won\", \"Yen\", \"Yuan\", \"Rupee\", \"B\"),\n+    (\"Which planet has the most prominent ring system?\", \"Earth\", \"Mars\", \"Saturn\", \"Venus\", \"C\"),\n+    (\"How many sides does a hexagon have?\", \"5\", \"7\", \"8\", \"6\", \"D\"),\n+    (\"What is the main ingredient in traditional hummus?\", \"Chickpeas\", \"Lentils\", \"Potatoes\", \"Peas\", \"A\"),\n+    (\"Which city hosted the first modern Olympic Games in 1896?\", \"Paris\", \"Athens\", \"London\", \"Rome\", \"B\"),\n+    (\"What is the process of a liquid turning into a gas called?\", \"Condensation\", \"Freezing\", \"Evaporation\", \"Melting\", \"C\"),\n+    (\"Which artist is famous for the painting The Starry Night?\", \"Salvador Dalí\", \"Henri Matisse\", \"Rembrandt\", \"Vincent van Gogh\", \"D\"),\n+    (\"What is the largest species of shark?\", \"Whale shark\", \"Great white shark\", \"Tiger shark\", \"Hammerhead shark\", \"A\"),\n+    (\"Which element has the chemical symbol O?\", \"Osmium\", \"Oxygen\", \"Gold\", \"Oganesson\", \"B\"),\n+    (\"Which country gifted the Statue of Liberty to the United States?\", \"Italy\", \"Spain\", \"France\", \"Germany\", \"C\"),\n+]\n","additions":32,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n","additions":7,"deletions":0},{"filePath":"/workspace/Dockerfile","relativePath":"Dockerfile","type":"update","patch":"Index: /workspace/Dockerfile\n===================================================================\n--- /workspace/Dockerfile\n+++ /workspace/Dockerfile\n@@ -21,5 +21,5 @@\n COPY backend/ backend/\n COPY --from=frontend /app/frontend/dist frontend/dist\n RUN mkdir -p data\n EXPOSE 8000\n-CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]\n+CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"backend.app:app\"]\n","additions":1,"deletions":1}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD backend/app.py\n