 selectDate = (selected: Date) => { setDate(selected); setMobileMenu(false); };\n   const calendarProps = { date, days, events: filteredEvents, today, signedIn, onSelect: selectDate, onCreate: createEvent, onEvent: (event: CalendarEvent) => setDialog({ type: \"detail\", event }) };\n \n   const authenticate = (newToken: string, name: string) => {\n-    try { localStorage.setItem(\"gather-token\", newToken); } catch { /* empty */ }\n+    try { localStorage.setItem(\"gather-token\", newToken); } catch {}\n     setToken(newToken);\n     setUsername(name);\n     setDialog(null);\n     setToast(`You’re in. Welcome, ${name}!`);\n   };\n \n   async function signOut() {\n-    try { await api(\"/auth/logout\", { method: \"POST\" }, token); } catch { /* empty */ }\n+    try { await api(\"/auth/logout\", { method: \"POST\" }, token); } catch {}\n     clearAccount();\n     setDialog(null);\n     setToast(\"You’ve signed out. See you soon.\");\n   }\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -11,8 +11,9 @@\n   files: [\"**/*.{ts,tsx}\"],\n   languageOptions: { globals: { ...globals.browser, ...globals.node } },\n   plugins: { \"react-hooks\": hooks },\n   rules: {\n+    \"no-empty\": [\"error\", { \"allowEmptyCatch\": true }],\n     \"react-hooks/rules-of-hooks\": \"error\",\n     \"react-hooks/exhaustive-deps\": \"warn\"\n   }\n }\n\nIndex: /workspace/frontend/src/Calendar.tsx\n===================================================================\n--- /workspace/frontend/src/Calendar.tsx\n+++ /workspace/frontend/src/Calendar.tsx\n@@ -53,9 +53,9 @@\n const currentMonth = day.getUTCMonth() === date.getUTCMonth();\n const selected = sameDay(day, date);\n const isToday = sameDay(day, today);\n const weekend = index % 7 > 4;\n-return <div key={dateKey(day)} className={`group relative min-h-[116px] border-line p-2.5 ${index % 7