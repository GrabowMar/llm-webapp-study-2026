es/@sparticuz/chromium/bin/al2023.tar.br\");\n+  setupLambdaEnvironment(\"/tmp/al2023/lib\");\n   browser = await playwright.launch({ executablePath: await chromium.executablePath(), args: chromium.args, headless: true });\n   const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } });\n   const pageErrors = [];\n   page.on(\"pageerror\", error => pageErrors.push(error.message));\n\n","files":[{"filePath":"/workspace/.browser-check/smoke.mjs","relativePath":".browser-check/smoke.mjs","type":"update","patch":"Index: /workspace/.browser-check/smoke.mjs\n===================================================================\n--- /workspace/.browser-check/smoke.mjs\n+++ /workspace/.browser-check/smoke.mjs\n@@ -1,8 +1,8 @@\n import assert from \"node:assert/strict\";\n import { spawn } from \"node:child_process\";\n import { chromium as playwright } from \"playwright-core\";\n-import chromium from \"@sparticuz/chromium\";\n+import chromium, { inflate, setupLambdaEnvironment } from \"@sparticuz/chromium\";\n \n const server = spawn(\"python3\", [\"-m\", \"gunicorn\", \"--bind\", \"127.0.0.1:8000\", \"--pythonpath\", \"backend\", \"--workers\", \"2\", \"app:app\"], {\n   cwd: \"/workspace\",\n   env: { ...process.env, DATABASE_PATH: \"/workspace/.browser-check/smoke.sqlite3\" },\n@@ -21,8 +21,10 @@\n try {\n   await waitFor(async () => {\n     try { return (await fetch(\"http://127.0.0.1:8000/api/health\")).ok; } catch { return false; }\n   }, `Server failed to start: ${serverLog}`);\n+  await inflate(\"/workspace/.browser-check/node_modules/@sparticuz/chromium/bin/al2023.tar.br\");\n+  setupLambdaEnvironment(\"/tmp/al2023/lib\");\n   browser = await playwright.launch({ executablePath: await chromium.executablePath(), args: chromium.args, headless: true });\n   const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } });\n   const pageErrors = [];\n   page.on(\"pageerror\", error => pageErrors.push(error.message));\n","additions":3,"de