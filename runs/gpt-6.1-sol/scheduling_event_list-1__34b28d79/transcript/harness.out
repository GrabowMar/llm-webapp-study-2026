\n+    elif len(password) > 256:\n+        errors[\"password\"] = \"Password must be 256 characters or fewer.\"\n+    return username.strip() if isinstance(username, str) else \"\", password, errors\n+\n+\n+def authenticated(handler):\n+    @wraps(handler)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return {\"error\": \"Please sign in to continue.\"}, 401\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"SELECT users.id, users.username FROM sessions JOIN users ON users.id = sessions.user_id \"\n+            \"WHERE sessions.token_hash = ? AND sessions.expires_at > ?\",\n+            (token_hash, utc_string(datetime.now(UTC))),\n+        ).fetchone()\n+        if user is None:\n+            return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n+        g.user = user\n+        g.token_hash = token_hash\n+        return handler(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def event_fields(body):\n+    errors = {}\n+    values = {}\n+    title = body.get(\"title\")\n+    if not isinstance(title, str) or not title.strip():\n+        errors[\"title\"] = \"An event title is required.\"\n+    elif len(title.strip()) > 200:\n+        errors[\"title\"] = \"Title must be 200 characters or fewer.\"\n+    else:\n+        values[\"title\"] = title.strip()\n+    for field, limit in ((\"description\", 10000), (\"location\", 500)):\n+        value = body.get(field)\n+        if value is not None and not isinstance(value, str):\n+            errors[field] = f\"{field.capitalize()} must be text.\"\n+        elif value is not None and len(value) > limit:\n+            errors[field] = f\"{field.capitalize()} must be {limit:,} characters or fewer.\"\n+        else:\n+            values[field] = value\n+    times = {}\n+    for field in (\"start_time\", \"end_time\"):\n+        if not body.get(field):\n+            errors[field] = f\"{field.replace('_', ' ').capitalize()} is required.\"\n+            continue\n+        try:\n+            times[field] = parse_datetime(body[field])\n+            values[field] = utc_string(times[field])\n+        except ValueError as exc:\n+            errors[field] = str(exc)\n+    if len(times) == 2 and times[\"end_time\"] <= times[\"start_time\"]:\n+        errors[\"end_time\"] = \"End time must be after start time.\"\n+    return values, errors\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"calendar.sqlite3\")),\n+        MAX_CONTENT_LENGTH=1024 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = get_db()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS events (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                title TEXT NOT NULL,\n+                description TEXT,\n+                location TEXT,\n+                start_time TEXT NOT NULL,\n+                end_time TEXT NOT NULL,\n+                created_at TEXT NOT NULL,\n+                created_by TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS events_start_time ON events(start_time);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_db(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path.startswith(\"/api\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return validation_error(errors)\n+        db = get_db()\n+        try:\n+            db.execute(\n+                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n+                (username, generate_password_hash(password), utc_string(datetime.now(UTC))),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            return {\"error\": \"This username is already taken.\", \"errors\": {\"username\": \"This username is already taken.\"}}, 409\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return validation_error(errors)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            return {\"error\": \"Incorrect username or password.\"}, 401\n+        token = secrets.token_urlsafe(32)\n+        now = datetime.now(UTC)\n+        db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (utc_string(now),))\n+        db.execute(\n+            \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], utc_string(now + timedelta(days=30))),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        db.commit()\n+        return \"\", 204\n+\n+    @app.get(\"/api/events\")\n+    def list_events():\n+        conditions = []\n+        parameters = []\n+        bounds = {}\n+        for field in (\"start_date\", \"end_date\"):\n+            value = request.args.get(field)\n+            if value is None:\n+                continue\n+            try:\n+                if re.fullmatch(r\"\\d{4}-\\d{2}-\\d{2}\", value):\n+                    parsed = datetime.combine(date.fromisoformat(value), datetime.min.time(), UTC)\n+                    if field == \"end_date\":\n+                        parsed += timedelta(days=1)\n+                        operator = \"<\"\n+                    else:\n+                        operator = \">=\"\n+                else:\n+                    parsed = parse_datetime(value)\n+                    operator = \">=\" if field == \"start_date\" else \"<=\"\n+                bounds[field] = parsed\n+                conditions.append(f\"julianday(start_time) {operator} julianday(?)\")\n+                parameters.append(utc_string(parsed))\n+            except (ValueError, OverflowError):\n+                return validation_error({field: \"Enter a valid ISO 8601 date or date-time.\"})\n+        if len(bounds) == 2 and bounds[\"end_date\"] < bounds[\"start_date\"]:\n+            return validation_error({\"end_date\": \"End date must not be before start date.\"})\n+        where = \" WHERE \" + \" AND \".join(conditions) if conditions else \"\"\n+        rows = get_db().execute(\"SELECT * FROM events\" + where + \" ORDER BY julianday(start_time), id\", parameters).fetchall()\n+        return {\"items\": [dict(row) for row in rows], \"total\": len(rows)}\n+\n+    @app.post(\"/api/events\")\n+    @authenticated\n+    def create_event():\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        values, errors = event_fields(body)\n+        if errors:\n+            return validation_error(errors)\n+        db = get_db()\n+        cursor = db.execute(\n+            \"INSERT INTO events (title, description, location, start_time, end_time, created_at, created_by) \"\n+            \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n+            (*[values[field] for field in (\"title\", \"description\", \"location\", \"start_time\", \"end_time\")],\n+             utc_string(datetime.now(UTC)), g.user[\"username\"]),\n+        )\n+        db.commit()\n+        return dict(db.execute(\"SELECT * FROM events WHERE id = ?\", (cursor.lastrowid,)).fetchone()), 201\n+\n+    @app.get(\"/api/events/<int:event_id>\")\n+    def get_event(event_id):\n+        event = get_db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n+        if event is None:\n+            return {\"error\": \"Event not found.\"}, 404\n+        return dict(event)\n+\n+    @app.put(\"/api/events/<int:event_id>\")\n+    @authenticated\n+    def update_event(event_id):\n+        db = get_db()\n+        if db.execute(\"SELECT id FROM events WHERE id = ?\", (event_id,)).fetchone() is None:\n+            return {\"error\": \"Event not found.\"}, 404\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        values, errors = event_fields(body)\n+        if errors:\n+            return validation_error(errors)\n+        db.execute(\n+            \"UPDATE events SET title = ?, description = ?, location = ?, start_time = ?, end_time = ? WHERE id = ?\",\n+            (*[values[field] for field in (\"title\", \"description\", \"location\", \"start_time\", \"end_time\")], event_id),\n+        )\n+        db.commit()\n+        return dict(db.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone())\n+\n+    @app.delete(\"/api/events/<int:event_id>\")\n+    @authenticated\n+    def delete_event(event_id):\n+        db = get_db()\n+        cursor = db.execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n+        db.commit()\n+        if cursor.rowcount == 0:\n+            return {\"error\": \"Event not found.\"}, 404\n+        return \"\", 204\n+\n+    @app.get(\"/api\")\n+    @app.get(\"/api/<path:path>\")\n+    def unknown_api(path=\"\"):\n+        return {\"error\": \"API endpoint not found.\"}, 404\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        resolved = safe_join(str(DIST), path)\n+        if resolved and Path(resolved).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,349 @@\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import date, datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+from werkzeug.utils import safe_join\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+UTC = timezone.utc\n+\n+\n+def utc_string(value):\n+    return value.astimezone(UTC).isoformat().replace(\"+00:00\", \"Z\")\n+\n+\n+def parse_datetime(value):\n+    if not isinstance(value, str) or not re.match(r\"^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}\", value):\n+        raise ValueError(\"Enter a valid ISO 8601 date and time.\")\n+    try:\n+        parsed = datetime.fromisoformat(value.replace(\"z\", \"+00:00\").replace(\"Z\", \"+00:00\"))\n+        return parsed.replace(tzinfo=UTC) if parsed.tzinfo is None else parsed.astimezone(UTC)\n+    except (ValueError, OverflowError) as exc:\n+        raise ValueError(\"Enter a valid ISO 8601 date and time.\") from exc\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        from flask import current_app\n+\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=20)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        return None\n+    return body\n+\n+\n+def validation_error(errors):\n+    return {\"error\": \"Please check the highlighted fields.\", \"errors\": errors}, 400\n+\n+\n+def credentials(body):\n+    errors = {}\n+    username = body.get(\"username\")\n+    password = body.get(\"password\")\n+    if not isinstance(username, str) or not username.strip():\n+        errors[\"username\"] = \"Username is required.\"\n+    elif len(username.strip()) > 80:\n+        errors[\"username\"] = \"Username must be 80 characters or fewer.\"\n+    if not isinstance(password, str) or not password:\n+        errors[\"password\"] = \"Password is required.\"\n+    elif len(password) > 256:\n+        errors[\"password\"] = \"Password must be 256 characters or fewer.\"\n+    return username.strip() if isinstance(username, str) else \"\", password, errors\n+\n+\n+def authenticated(handler):\n+    @wraps(handler)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return {\"error\": \"Please sign in to continue.\"}, 401\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"SELECT users.id, users.username FROM sessions JOIN users ON users.id = sessions.user_id \"\n+            \"WHERE sessions.token_hash = ? AND sessions.expires_at > ?\",\n+            (token_hash, utc_string(datetime.now(UTC))),\n+        ).fetchone()\n+        if user is None:\n+            return {\"error\": \"Your session has expired. Please sign in again.\"}, 401\n+        g.user = user\n+        g.token_hash = token_hash\n+        return handler(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def event_fields(body):\n+    errors = {}\n+    values = {}\n+    title = body.get(\"title\")\n+    if not isinstance(title, str) or not title.strip():\n+        errors[\"title\"] = \"An event title is required.\"\n+    elif len(title.strip()) > 200:\n+        errors[\"title\"] = \"Title must be 200 characters or fewer.\"\n+    else:\n+        values[\"title\"] = title.strip()\n+    for field, limit in ((\"description\", 10000), (\"location\", 500)):\n+        value = body.get(field)\n+        if value is not None and not isinstance(value, str):\n+            errors[field] = f\"{field.capitalize()} must be text.\"\n+        elif value is not None and len(value) > limit:\n+            errors[field] = f\"{field.capitalize()} must be {limit:,} characters or fewer.\"\n+        else:\n+            values[field] = value\n+    times = {}\n+    for field in (\"start_time\", \"end_time\"):\n+        if not body.get(field):\n+            errors[field] = f\"{field.replace('_', ' ').capitalize()} is required.\"\n+            continue\n+        try:\n+            times[field] = parse_datetime(body[field])\n+            values[field] = utc_string(times[field])\n+        except ValueError as exc:\n+            errors[field] = str(exc)\n+    if len(times) == 2 and times[\"end_time\"] <= times[\"start_time\"]:\n+        errors[\"end_time\"] = \"End time must be after start time.\"\n+    return values, errors\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"calendar.sqlite3\")),\n+        MAX_CONTENT_LENGTH=1024 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = get_db()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE,\n+                password_hash TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id),\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS events (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                title TEXT NOT NULL,\n+                description TEXT,\n+                location TEXT,\n+                start_time TEXT NOT NULL,\n+                end_time TEXT NOT NULL,\n+                created_at TEXT NOT NULL,\n+                created_by TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS events_start_time ON events(start_time);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_db(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path.startswith(\"/api\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return validation_error(errors)\n+        db = get_db()\n+        try:\n+            db.execute(\n+                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n+                (username, generate_password_hash(password), utc_string(datetime.now(UTC))),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            return {\"error\": \"This username is already taken.\", \"errors\": {\"username\": \"This username is already taken.\"}}, 409\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return validation_error(errors)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            return {\"error\": \"Incorrect username or password.\"}, 401\n+        token = secrets.token_urlsafe(32)\n+        now = datetime.now(UTC)\n+        db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (utc_string(now),))\n+        db.execute(\n+            \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], utc_string(now + timedelta(days=30))),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        db.commit()\n+        return \"\", 204\n+\n+    @app.get(\"/api/events\")\n+    def list_events():\n+        conditions = []\n+        parameters = []\n+        bounds = {}\n+        for field in (\"start_date\", \"end_date\"):\n+            value = request.args.get(field)\n+            if value is None:\n+                continue\n+            try:\n+                if re.fullmatch(r\"\\d{4}-\\d{2}-\\d{2}\", value):\n+                    parsed = datetime.combine(date.fromisoformat(value), datetime.min.time(), UTC)\n+                    if field == \"end_date\":\n+                        parsed += timedelta(days=1)\n+                        operator = \"<\"\n+                    else:\n+                        operator = \">=\"\n+                else:\n+                    parsed = parse_datetime(value)\n+                    operator = \">=\" if field == \"start_date\" else \"<=\"\n+                bounds[field] = parsed\n+                conditions.append(f\"julianday(start_time) {operator} julianday(?)\")\n+                parameters.append(utc_string(parsed))\n+            except (ValueError, OverflowError):\n+                return validation_error({field: \"Enter a valid ISO 8601 date or date-time.\"})\n+        if len(bounds) == 2 and bounds[\"end_date\"] < bounds[\"start_date\"]:\n+            return validation_error({\"end_date\": \"End date must not be before start date.\"})\n+        where = \" WHERE \" + \" AND \".join(conditions) if conditions else \"\"\n+        rows = get_db().execute(\"SELECT * FROM events\" + where + \" ORDER BY julianday(start_time), id\", parameters).fetchall()\n+        return {\"items\": [dict(row) for row in rows], \"total\": len(rows)}\n+\n+    @app.post(\"/api/events\")\n+    @authenticated\n+    def create_event():\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        values, errors = event_fields(body)\n+        if errors:\n+            return validation_error(errors)\n+        db = get_db()\n+        cursor = db.execute(\n+            \"INSERT INTO events (title, description, location, start_time, end_time, created_at, created_by) \"\n+            \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n+            (*[values[field] for field in (\"title\", \"description\", \"location\", \"start_time\", \"end_time\")],\n+             utc_string(datetime.now(UTC)), g.user[\"username\"]),\n+        )\n+        db.commit()\n+        return dict(db.execute(\"SELECT * FROM events WHERE id = ?\", (cursor.lastrowid,)).fetchone()), 201\n+\n+    @app.get(\"/api/events/<int:event_id>\")\n+    def get_event(event_id):\n+        event = get_db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n+        if event is None:\n+            return {\"error\": \"Event not found.\"}, 404\n+        return dict(event)\n+\n+    @app.put(\"/api/events/<int:event_id>\")\n+    @authenticated\n+    def update_event(event_id):\n+        db = get_db()\n+        if db.execute(\"SELECT id FROM events WHERE id = ?\", (event_id,)).fetchone() is None:\n+            return {\"error\": \"Event not found.\"}, 404\n+        body = json_body()\n+        if body is None:\n+            return {\"error\": \"A JSON object is required.\"}, 400\n+        values, errors = event_fields(body)\n+        if errors:\n+            return validation_error(errors)\n+        db.execute(\n+            \"UPDATE events SET title = ?, description = ?, location = ?, start_time = ?, end_time = ? WHERE id = ?\",\n+            (*[values[field] for field in (\"title\", \"description\", \"location\", \"start_time\", \"end_time\")], event_id),\n+        )\n+        db.commit()\n+        return dict(db.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone())\n+\n+    @app.delete(\"/api/events/<int:event_id>\")\n+    @authenticated\n+    def delete_event(event_id):\n+        db = get_db()\n+        cursor = db.execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n+        db.commit()\n+        if cursor.rowcount == 0:\n+            return {\"error\": \"Event not found.\"}, 404\n+        return \"\", 204\n+\n+    @app.get(\"/api\")\n+    @app.get(\"/api/<path:path>\")\n+    def unknown_api(path=\"\"):\n+        return {\"error\": \"API endpoint not found.\"}, 404\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        resolved = safe_join(str(DIST), path)\n+        if resolved and Path(resolved).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n","additions":349,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace