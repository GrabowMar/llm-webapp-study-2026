+@layer base {
+  body { @apply m-0 bg-paper font-sans text-ink antialiased; }
+  button:not(:disabled) { @apply cursor-pointer; }
+  button, a, input, textarea { @apply focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forest; }
+  button, a { @apply transition-colors; }
+  ::selection { @apply bg-sage text-forest-dark; }
+}
