ields).status_code, 400)\n \n def test_restart_preserves_accounts_tokens_and_cart(self):\n     item = self.add(3).json\n@@ -138,12 +173,17 @@\n     self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.admin).status_code, 200)\n \n def test_admin_disabled_and_password_rotation(self):\n     disabled = create_app({**self.config, \"ADMIN_PASSWORD\": \"\"}).test_client()\n-    self.assertEqual(disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-secret\"}).status_code, 401)\n+    self.assertEqual(\n+        disabled.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"test-admin-secret\"}).status_code,\n+        401,\n+    )\n     self.assertEqual(disabled.get(\"/api/auth/me\", headers=self.admin).status_code, 401)\n     changed = create_app({**self.config, \"ADMIN_PASSWORD\": \"new-secret\"}).test_client()\n-    self.assertEqual(changed.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"new-secret\"}).status_code, 200)\n+    self.assertEqual(\n+        changed.post(\"/api/auth/login\", json={\"username\": \"admin\", \"password\": \"new-secret\"}).status_code, 200\n+    )\n     self.assertEqual(changed.get(\"/api/auth/me\", headers=self.admin).status_code, 401)\n \n def test_logout_revokes_token_and_secrets_are_hashed(self):\n     self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.user).status_code, 200)\n\n","files":[{"filePath":"/workspace/frontend/src/Modal.tsx","relativePath":"frontend/src/Modal.tsx","type":"update","patch":"Index: /workspace/frontend/src/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/Modal.tsx\n+++ /workspace/frontend/src/Modal.tsx\n@@ -10,8 +10,9 @@\n const dialog = ref.current;\n const previousOverflow = document.body.style.overflow;\n document.body.style.overflow = \"hidden\";\n dialog?.showModal();\n+dialog?.querySelector<HTMLElement>(\"[data-autofocus]\")?.focus();\n return () => {\n   dialog?.close();\n   document.body.style.overflow = previousOverflow;\n   previousFocus?.focus();\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/src/AuthForm.tsx","relativePath":"frontend/src/AuthForm.tsx","type":"update","patch":"Index: /workspace/frontend/src/AuthForm.tsx\n===================================================================\n--- /workspace/frontend/src/AuthForm.tsx\n+++ /workspace/frontend/src/AuthForm.tsx\n@@ -36,9 +36,9 @@\n <div className=\"px-7 py-7\">\n   <BrandMark className=\"mb-5 h-8 w-8 text-rust\" />\n   <p className=\"mb-7 text-sm leading-relaxed text-muted\">{mode === \"login\" ? \"Sign in to keep your favorite objects together. Your personal cart will be right where you left it.\" : \"Create an account and start a collection of things you’ll love living with.\"}</p>\n   <form onSubmit={submit} className=\"space-y-5\">\n-    <label className=\"block text-sm font-medium\">Username<input autoFocus required autoComplete=\"username\" maxLength={32} pattern=\"[a-zA-Z0-9_.\\-]+\" className={`${inputClass} mt-2`} placeholder=\"Your username\" value={username} onChange={(event) => setUsername(event.target.value)} /></label>\n+    <label className=\"block text-sm font-medium\">Username<input data-autofocus required autoComplete=\"username\" maxLength={32} pattern=\"[a-zA-Z0-9_.\\-]+\" className={`${inputClass} mt-2`} placeholder=\"Your username\" value={username} onChange={(event) => setUsername(event.target.value)} /></label>\n     <label className=\"block text-sm font-medium\">Password<input required type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} maxLength={256} className={`${inputClass} mt-2`} placeholder=\"Your password\" value={password} onChange={(event) => setPassword(event.target.value)} /></label>\n     <ErrorMessage message={error} />\n     <button disabled={busy} className={`${primaryButton} w-full`}>{busy ? <Icon name=\"loader\" className=\"animate-spin\" /> : <>{mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" className=\"h-4 w-4\" /></>}</button>\n   </form>\n","additions":1,"deletions":1},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"update","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -227,21 +227,27 @@\n             auth = request.headers.get(\"Authorization\", \"\").split()\n             if len(auth) != 2 or auth[0].lower() != \"bearer\":\n                 raise APIError(\"Please sign in to continue.\", 401)\n             token_hash = hashlib.sha256(auth[1].encode()).hexdigest()\n-            user = db().execute(\n-                \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n-                \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n-                (token_hash, int(time.time())),\n-            ).fetchone()\n+            user = (\n+                db()\n+                .execute(\n+                    \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n+                    \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n+                    (token_hash, int(time.time())),\n+                )\n+                .fetchone()\n+            )\n             if user is None or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"]):\n                 raise APIError(\"Your session has expired. Please sign in again.\", 401)\n             if admin_only and not user[\"is_admin\"]:\n                 raise APIError(\"Only the admin can manage products.\", 403)\n             g.user = user\n             g.token_hash = token_hash\n             return view(*args, **kwargs)\n+\n         return wrapped\n+\n     return decorator\n \n def credentials():\n     body = json_body()\n@@ -274,11 +280,14 @@\n @application.post(\"/api/auth/login\")\n def login():\n     username, password = credentials()\n     user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n-    if (user is None or not user[\"password_hash\"]\n-            or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"])\n-            or not check_password_hash(user[\"password_hash\"], password)):\n+    if (\n+        user is None\n+        or not user[\"password_hash\"]\n+        or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"])\n+        or not check_password_hash(user[\"password_hash\"], password)\n+    ):\n         raise APIError(\"Incorrect username or password.\", 401)\n     token = secrets.token_urlsafe(48)\n     with db():\n         db().execute(\n@@ -313,13 +322,22 @@\n     if not include_inactive:\n         where += \" AND is_active = 1\"\n     parameters = (f\"%{escaped}%\", f\"%{escaped}%\")\n     total = db().execute(f\"SELECT COUNT(*) FROM products WHERE {where}\", parameters).fetchone()[0]\n-    products = db().execute(\n-        f\"SELECT * FROM products WHERE {where} ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n-        (*parameters, page_size, (page - 1) * page_size),\n-    ).fetchall()\n-    return {\"items\": [product_json(product) for product in products], \"total\": total, \"page\": page, \"page_size\": page_size}\n+    products = (\n+        db()\n+        .execute(\n+            f\"SELECT * FROM products WHERE {where} ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n+            (*parameters, page_size, (page - 1) * page_size),\n+        )\n+        .fetchall()\n+    )\n+    return {\n+        \"items\": [product_json(product) for product in products],\n+        \"total\": total,\n+        \"page\": page,\n+        \"page_size\": page_size,\n+    }\n \n @application.get(\"/api/products\")\n def products():\n     return paged_products()\n@@ -331,13 +349,17 @@\n         raise APIError(\"Product not found.\", 404)\n     return product_json(product)\n \n def cart_item(item_id):\n-    item = db().e