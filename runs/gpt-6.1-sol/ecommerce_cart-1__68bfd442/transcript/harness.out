 \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,18 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":18,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,19 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: globals.browser },\n+    plugins: { \"react-hooks\": reactHooks },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+    },\n+  },\n+);\n","additions":19,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,30 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Helvetica Neue\", \"Arial\", sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", \"Georgia\", serif;\n+  --color-paper: #faf9f6;\n+  --color-ink: #292c25;\n+  --color-muted: #77786e;\n+  --color-rust: #a55336;\n+  --color-rust-dark: #834029;\n+  --color-line: #e3e2d9;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input, select, textarea {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-rust focus-visible:ring-offset-4;\n+  }\n+  button, a {\n+    -webkit-tap-highlight-color: transparent;\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  ::selection {\n+    @apply bg-rust/20;\n+  }\n+}\n","additions":30,"deletions":0},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,11 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#faf9f6\" />\n+    <meta name=\"description\" content=\"Form & Field — thoughtfully chosen objects for a considered everyday. Explore home, kitchen and everyday essentials.\" />\n+    <title>Form & Field — Objects for the everyday</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,41 @@\n+export type Product = {\n+  id: number;\n+  name: string;\n+  description: string;\n+  price: number;\n+  stock: number;\n+  is_active: boolean;\n+};\n+\n+export type ProductPage = { items: Product[]; total: number; page: number; page_size: number };\n+export type CartItem = { id: number; product_id: number; quantity: number; name: string; unit_price: number; line_total: number };\n+export type Cart = { items: CartItem[]; subtotal: number };\n+export type User = { id: number; username: string; is_admin: boolean };\n+\n+export class ApiError extends Error {\n+  status: number;\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {\n+  const headers = new Headers(options.headers);\n+  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n+  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, { ...options, headers });\n+  } catch {\n+    throw new ApiError(\"We couldn’t connect to the shop. Please try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) throw new ApiError(data?.message || \"Something went wrong. Please try again.\", response.status);\n+  return data as T;\n+}\n+\n+export const money = (amount: number) => new Intl.NumberFormat(\"en-US\", { style: \"currency\", currency: \"USD\" }).format(amount);\n+export const category = (product: Pick<Product, \"description\">) => product.description.split(\" · \")[0] || \"Everyday essentials\";\n+export const description = (product: Pick<Product, \"description\">) => product.description.includes(\" · \") ? product.description.split(\" · \").slice(1).join(\" · \") : product.description;\n","additions":41,"deletions":0},{"filePath":"/workspace/frontend/src/Icons.tsx","relativePath":"frontend/src/Icons.tsx","type":"add","patch":"Index: /workspace/frontend/src/Icons.tsx\n===================================================================\n--- /workspace/frontend/src/Icons.tsx\n+++ /workspace/frontend/src/Icons.tsx\n@@ -0,0 +1,31 @@\n+import type { SVGProps } from \"react\";\n+\n+type IconName = \"bag\" | \"user\" | \"search\" | \"arrow\" | \"chevron-left\" | \"chevron-right\" | \"plus\" | \"minus\" | \"close\" | \"check\" | \"leaf\" | \"box\" | \"heart\" | \"logout\" | \"settings\" | \"trash\" | \"grid\" | \"loader\";\n+\n+export function Icon({ name, ...props }: SVGProps<SVGSVGElement> & { name: IconName }) {\n+  const paths: Record<IconName, React.ReactNode> = {\n+    bag: <><path d=\"M5 7h14l1 14H4L5 7Z\" /><path d=\"M8 8V6a4 4 0 0 1 8 0v2\" /></>,\n+    user: <><circle cx=\"12\" cy=\"8\" r=\"3.5\" /><path d=\"M5 21v-2a7 7 0 0 1 14 0v2\" /></>,\n+    search: <><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" /><path d=\"m16 16 5 5\" /></>,\n+    arrow: <><path d=\"M4 12h16m-6-6 6 6-6 6\" /></>,\n+    \"chevron-left\": <path d=\"m14 5-7 7 7 7\" />,\n+    \"chevron-right\": <path d=\"m10 5 7 7-7 7\" />,\n+    plus: <path d=\"M12 5v14M5 12h14\" />,\n+    minus: <path d=\"M5 12h14\" />,\n+    close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+    check: <path d=\"m5 12 4 4L19 6\" />,\n+    leaf: <><path d=\"M20 3C9 2 3 7 5 14c2 7 15 5 15-11Z\" /><path d=\"M3 21 15 9\" /></>,\n+    box: <><path d=\"m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 10v9M3 8l9 5 9-5M7.5 5.5l9 5v4\" /></>,\n+    heart: <path d=\"M20.5 5.5a5 5 0 0 0-7 0L12 7l-1.5-1.5a5 5 0 0 0-7 7L12 21l8.5-8.5a5 5 0 0 0 0-7Z\" />,\n+    logout: <><path d=\"M9 3H4v18h5m6-14 5 5-5 5M8 12h12\" /></>,\n+    settings: <><path d=\"M4 7h16M4 17h16\" /><circle cx=\"9\" cy=\"7\" r=\"3\" fill=\"currentColor\" /><circle cx=\"16\" cy=\"17\" r=\"3\" fill=\"currentColor\" /></>,\n+    trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\" /></>,\n+    grid: <><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /></>,\n+    loader: <path d=\"M21 12a9 9 0 1 1-9-9\" />,\n+  };\n+  return <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\" {...props}>{paths[name]}</svg>;\n+}\n+\n+export function BrandMark({ className = \"\" }: { className?: string }) {\n+  return <svg className={className} width=\"29\" height=\"29\" viewBox=\"0 0 32 32\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M3 3h11v11H3zM18 3h11v11H18zM3 18h11v11H3zM18 18h11v11H18z\" /><path d=\"M14 14h4v4h-4z\" /></svg>;\n+}\n","additions":31,"deletions":0},{"filePath":"/workspace/frontend/src/ProductArt.tsx","relativePath":"frontend/src/ProductArt.tsx","type":"add","patch":"Index: /workspace/frontend/src/ProductArt.tsx\n===================================================================\n--- /workspace/frontend/src/ProductArt.tsx\n+++ /workspace/frontend/src/ProductArt.tsx\n@@ -0,0 +1,139 @@\n+import { useId } from \"react\";\n+\n+export function ProductArt({ name, className = \"\" }: { name: string; className?: string }) {\n+  const id = useId().replace(/:/g, \"\");\n+  const paint = (color: string) => `url(#${id}-${color})`;\n+  const lower = name.toLowerCase();\n+  let art;\n+  if (lower.includes(\"vase\")) {\n+    art = <>\n+      <path d=\"M179 129c-8-43 8-76 21-99m-18 71c-12-15-19-25-23-43m29 21c16-9 30-15 45-15\" stroke=\"#6e7050\" strokeWidth=\"2\" fill=\"none\" />\n+      <g fill=\"#838363\"><ellipse cx=\"164\" cy=\"69\" rx=\"6\" ry=\"15\" transform=\"rotate(-34 164 69)\" /><ellipse cx=\"197\" cy=\"49\" rx=\"5\" ry=\"14\" transform=\"rotate(28 197 49)\" /><ellipse cx=\"216\" cy=\"69\" rx=\"5\" ry=\"13\" transform=\"rotate(63 216 69)\" /><ellipse cx=\"181\" cy=\"88\" rx=\"5\" ry=\"13\" transform=\"rotate(-22 181 88)\" /></g>\n+      <path d=\"M161 104h38v28c0 11 25 31 27 57l3 45c1 12-20 21-50 21s-48-9-47-21l3-45c2-26 26-46 26-57Z\" fill={paint(\"amber\")} />\n+      <ellipse cx=\"180\" cy=\"104\" rx=\"19\" ry=\"5\" fill=\"#8e4f26\" /><ellipse cx=\"180\" cy=\"104\" rx=\"14\" ry=\"3\" fill=\"#52391f\" />\n+      <path d=\"M146 174c5-12 16-24 19-39v-23\" fill=\"none\" stroke=\"#fce4b0\" strokeOpacity=\".5\" strokeWidth=\"5\" strokeLinecap=\"round\" />\n+      <path d=\"M142 228c18 8 53 10 74 0\" stroke=\"#ecbc76\" opacity=\".45\" fill=\"none\" />\n+    </>;\n+  } else if (lower.includes(\"bookend\")) {\n+    art = <>\n+      <path d=\"M92 238V133a63 63 0 0 1 126 0v105h-38V134a25 25 0 0 0-50 0v104Z\" fill=\"#c8b7a0\" />\n+      <path d=\"M103 243V138a63 63 0 0 1 126 0v105h-38V139a25 25 0 0 0-50 0v104Z\" fill={paint(\"stone\")} />\n+      <path d=\"M182 240V139a26 26 0 0 0-43-19\" fill=\"none\" stroke=\"#b2a087\" strokeWidth=\"3\" />\n+      <path d=\"M238 238V166a47 47 0 0 0-94 0v72h29v-71a18 18 0 0 1 36 0v71Z\" fill=\"#a7947b\" />\n+      <path d=\"M248 245V173a47 47 0 0 0-94 0v72h29v-71a18 18 0 0 1 36 0v71Z\" fill={paint(\"stone\")} />\n+    </>;\n+  } else if (lower.includes(\"mug\")) {\n+    art = <>\n+      <path d=\"M222 126h20c44 0 45 80-1 80h-20\" fill=\"none\" stroke=\"#b4b39d\" strokeWidth=\"16\" />\n+      <path d=\"M226 125h15c38 0 38 76-1 76h-14\" fill=\"none\" stroke=\"#d8d7c4\" strokeWidth=\"11\" />\n+      <path d=\"M109 116h119l-6 110c-2 26-104 27-106 0Z\" fill={paint(\"cream\")} />\n+      <ellipse cx=\"169\" cy=\"116\" rx=\"59\" ry=\"14\" fill=\"#dfdeca\" /><ellipse cx=\"169\" cy=\"117\" rx=\"51\" ry=\"10\" fill=\"#999781\" /><ellipse cx=\"169\" cy=\"121\" rx=\"46\" ry=\"7\" fill=\"#65513c\" />\n+      <path d=\"m121 139 3 77\" stroke=\"#f5f1e0\" strokeWidth=\"7\" strokeLinecap=\"round\" opacity=\".55\" />\n+      <path d=\"M122 230c20 10 72 12 92 0\" fill=\"none\" stroke=\"#9c9b85\" strokeOpacity=\".35\" strokeWidth=\"2\" />\n+    </>;\n+  } else if (lower.includes(\"cushion\") || lower.includes(\"throw\")) {\n+    art = <>\n+      <path d=\"m94 96 164-7 19 150-177 15-15-22Z\" fill=\"#777c56\" />\n+      <path d=\"M94 96c57 12 101-12 164-7-8 52 10 96 19 150-62-3-110 20-177 15 10-53-13-108-6-158Z\" fill={paint(\"olive\")} />\n+      <path d=\"M106 111c48 9 92-8 138-7-5 40 8 87 14 121-45 0-96 15-143 15 5-45-10-89-9-129Z\" fill=\"none\" stroke=\"#b0b28a\" strokeWidth=\"1\" strokeDasharray=\"2 3\" />\n+      <path d=\"m92 97 29 32m136-39-21 29m40 120-31-17m-143 30 23-31\" stroke=\"#697048\" strokeWidth=\"3\" opacity=\".6\" />\n+      <path d=\"M149 118c-12 33-16 76-11 109m36-111c-4 40-1 74 7 105\" stroke=\"#d3d2ab\" strokeOpacity=\".13\" strokeWidth=\"14\" fill=\"none\" />\n+      <path d=\"m101 254 3-19m173 4-5-19\" stroke=\"#4f573b\" strokeWidth=\"2\" />\n+    </>;\n+  } else if (lower.includes(\"board\") || lower.includes(\"tray\")) {\n+    art = <g transform=\"rotate(-16 180 160)\">\n+      <path d=\"M155 72V44q0-12 12-12h26q12 0 12 12v28h30q15 0 15 15v150q0 15-15 15H125q-15 0-15-15V87q0-15 15-15Z\" fill=\"#a47c4e\" transform=\"translate(4 7)\" />\n+      <path d=\"M155 72V44q0-12 12-12h26q12 0 12 12v28h30q15 0 15 15v150q0 15-15 15H125q-15 0-15-15V87q0-15 15-15Z\" fill={paint(\"wood\")} />\n+      <circle cx=\"180\" cy=\"48\" r=\"6\" fill=\"#a38258\" /><circle cx=\"180\" cy=\"47\" r=\"4.5\" fill=\"#e8e1d6\" />\n+      <g stroke=\"#9c7547\" strokeOpacity=\".23\" fill=\"none\"><path d=\"M130 87c-12 80 13 88-3 149m20-149c-8 70 9 88 0 156m20-163c-14 70 14 105 4 160m20-162c-11 90 14 103 7 158m21-155c-15 92 5 112-1 155m18-153c-2 70 10 90 0 134\" /><path d=\"M151 142c28-20 43 60 12 63-22 3-33-46-12-63Z\" /><ellipse cx=\"165\" cy=\"175\" rx=\"7\" ry=\"19\" /></g>\n+    </g>;\n+  } else if (lower.includes(\"candle\")) {\n+    art = <>\n+      <path d=\"M180 86c-19-21 12-30 0-48 22 17 20 37 0 48Z\" fill=\"#d2a46c\" opacity=\".8\" /><path d=\"M180 82c-5-10 6-17 3-24 8 12 6 19-3 24Z\" fill=\"#f6e2ab\" />\n+      <path d=\"M180 98V84\" stroke=\"#524131\" strokeWidth=\"2\" />\n+      <rect x=\"131\" y=\"100\" width=\"98\" height=\"146\" rx=\"10\" fill={paint(\"cream\")} />\n+      <g stroke=\"#b9b39c\" strokeWidth=\"3\" opacity=\".6\">{Array.from({ length: 12 }, (_, i) => <path key={i} d={`M${137 + i * 8} 107v131`} />)}</g>\n+      <ellipse cx=\"180\" cy=\"101\"