{"type":"tool_use","timestamp":1794314848446,"sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","part":{"type":"tool","tool":"read","callID":"call_q8LmNqYn72YilUPEaSBGimI0","state":{"status":"completed","input":{"filePath":"/workspace/Dockerfile"},"output":"<path>/workspace/Dockerfile</path>\n<type>file</type>\n<content>\n1: FROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\n2: WORKDIR /app\n3: COPY frontend/package.json frontend/package-lock.json* frontend/\n4: RUN cd frontend \\\n5:     && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\n6: COPY frontend/ frontend/\n7: RUN cd frontend && npm run build\n8: \n9: FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\n10: ENV PYTHONDONTWRITEBYTECODE=1 \\\n11:     PYTHONUNBUFFERED=1 \\\n12:     PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n13:     PORT=8000\n14: WORKDIR /app\n15: COPY backend/requirements.txt backend/requirements.lock* backend/\n16: RUN if [ -f backend/requirements.lock ]; then \\\n17:       pip install --no-cache-dir -r backend/requirements.txt -c backend/requirements.lock; \\\n18:     else \\\n19:       pip install --no-cache-dir -r backend/requirements.txt; \\\n20:     fi\n21: COPY backend/ backend/\n22: COPY --from=frontend /app/frontend/dist frontend/dist\n23: RUN mkdir -p data\n24: EXPOSE 8000\n25: CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]\n\n(End of file - total 25 lines)\n</content>","metadata":{"preview":"FROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\nWORKDIR /app\nCOPY frontend/package.json frontend/package-lock.json* frontend/\nRUN cd frontend \\\n    && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\nCOPY frontend/ frontend/\nRUN cd frontend && npm run build\n\nFROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\nENV PYTHONDONTWRITEBYTECODE=1 \\\n    PYTHONUNBUFFERED=1 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    PORT=8000\nWORKDIR /app\nCOPY backend/requirements.txt backend/requirements.lock* backend/\nRUN if [ -f backend/requirements.lock ]; then \\\n      pip install --no-cache-dir -r backend/requirements.txt -c backend/requirements.lock; \\\n    else \\\n      pip install --no-cache-dir -r backend/requirements.txt; \\\n    fi","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/Dockerfile","text":"FROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\nWORKDIR /app\nCOPY frontend/package.json frontend/package-lock.json* frontend/\nRUN cd frontend \\\n    && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\nCOPY frontend/ frontend/\nRUN cd frontend && npm run build\n\nFROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\nENV PYTHONDONTWRITEBYTECODE=1 \\\n    PYTHONUNBUFFERED=1 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    PORT=8000\nWORKDIR /app\nCOPY backend/requirements.txt backend/requirements.lock* backend/\nRUN if [ -f backend/requirements.lock ]; then \\\n      pip install --no-cache-dir -r backend/requirements.txt -c backend/requirements.lock; \\\n    else \\\n      pip install --no-cache-dir -r backend/requirements.txt; \\\n    fi\nCOPY backend/ backend/\nCOPY --from=frontend /app/frontend/dist frontend/dist\nRUN mkdir -p data\nEXPOSE 8000\nCMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]","lineStart":1,"lineEnd":25,"totalLines":25,"truncated":false}},"title":"Dockerfile","time":{"start":1794314848252,"end":1794314848345}},"id":"prt_1c57fc7f5001O1AiRTd8DxH5k1","sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","messageID":"msg_1c57fafb1001CyzdI6P8tt9F8l"}}
{"type":"tool_use","timestamp":1794314848446,"sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","part":{"type":"tool","tool":"read","callID":"call_Q170SPN4uH2reO8QLW4hEB9E","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: import hashlib\n2: import os\n3: import re\n4: import secrets\n5: import sqlite3\n6: import time\n7: from decimal import Decimal, InvalidOperation\n8: from functools import wraps\n9: from pathlib import Path\n10: \n11: from flask import Flask, g, request, send_from_directory\n12: from werkzeug.exceptions import HTTPException\n13: from werkzeug.security import check_password_hash, generate_password_hash\n14: \n15: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n16: SEED_PRODUCTS = [\n17:     (\"Amber glass vase\", \"Home & living · Warm-toned recycled glass for a stem or two.\", 3200, 24),\n18:     (\"Arc bookends\", \"Home & living · A sculptural pair, cast in warm sandstone.\", 4800, 18),\n19:     (\"Everyday ceramic mug\", \"Kitchen & dining · Your morning ritual, made a little slower.\", 1800, 40),\n20:     (\"Linen cushion\", \"Home & living · Soft, washed linen in a quiet shade of olive.\", 4200, 25),\n21:     (\"Oak serving board\", \"Kitchen & dining · Solid oak. For gathering around the table.\", 3600, 20),\n22:     (\"Ribbed pillar candle\", \"Home & living · An unscented, slow-burning moment of calm.\", 1600, 30),\n23:     (\"Softcover notebook\", \"Everyday essentials · A little space for your next big idea.\", 1400, 45),\n24:     (\"Stoneware bowl\", \"Kitchen & dining · Hand-finished stoneware, beautifully imperfect.\", 2400, 32),\n25:     (\"Terra planter\", \"Home & living · A terracotta home for something green.\", 2800, 22),\n26:     (\"Woven cotton throw\", \"Home & living · An easy layer for your favorite corner.\", 6400, 15),\n27:     (\"Woven market tote\", \"Everyday essentials · Natural cotton for wherever the day takes you.\", 2600, 28),\n28:     (\"Wooden desk tray\", \"Everyday essentials · A place for the small things, in solid ash.\", 2200, 20),\n29: ]\n30: \n31: \n32: class APIError(Exception):\n33:     def __init__(self, message, status=400):\n34:         self.message = message\n35:         self.status = status\n36: \n37: \n38: def connect_database(path):\n39:     connection = sqlite3.connect(path, timeout=20)\n40:     connection.row_factory = sqlite3.Row\n41:     connection.execute(\"PRAGMA foreign_keys = ON\")\n42:     connection.execute(\"PRAGMA busy_timeout = 20000\")\n43:     return connection\n44: \n45: \n46: def initialize_database(path, admin_password):\n47:     Path(path).parent.mkdir(parents=True, exist_ok=True)\n48:     connection = connect_database(path)\n49:     try:\n50:         connection.execute(\"PRAGMA journal_mode = WAL\")\n51:         connection.executescript(\"\"\"\n52:             CREATE TABLE IF NOT EXISTS users (\n53:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n54:                 username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n55:                 password_hash TEXT NOT NULL,\n56:                 is_admin INTEGER NOT NULL DEFAULT 0\n57:             );\n58:             CREATE TABLE IF NOT EXISTS products (\n59:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n60:                 name TEXT NOT NULL,\n61:                 description TEXT NOT NULL DEFAULT '',\n62:                 price_cents INTEGER NOT NULL CHECK(price_cents >= 0),\n63:                 stock INTEGER NOT NULL CHECK(stock >= 0),\n64:                 is_active INTEGER NOT NULL DEFAULT 1\n65:             );\n66:             CREATE TABLE IF NOT EXISTS cart_items (\n67:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n68:                 user_id INTEGER NOT NULL REFERENCES users(id),\n69:                 product_id INTEGER NOT NULL REFERENCES products(id),\n70:                 quantity INTEGER NOT NULL CHECK(quantity > 0),\n71:                 UNIQUE(user_id, product_id)\n72:             );\n73:             CREATE TABLE IF NOT EXISTS sessions (\n74:                 token_hash TEXT PRIMARY KEY,\n75:                 user_id INTEGER NOT NULL REFERENCES users(id),\n76:                 expires_at INTEGER NOT NULL\n77:             );\n78:             CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n79:         \"\"\")\n80:         connection.execute(\"BEGIN IMMEDIATE\")\n81:         if not connection.execute(\"SELECT 1 FROM products LIMIT 1\").fetchone():\n82:             connection.executemany(\n83:                 \"INSERT INTO products (name, description, price_cents, stock) VALUES (?, ?, ?, ?)\",\n84:                 SEED_PRODUCTS,\n85:             )\n86:         admin = connection.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n87:         password_changed = admin and (\n88:             not admin_password\n89:             or not admin[\"password_hash\"]\n90:             or not check_password_hash(admin[\"password_hash\"], admin_password)\n91:         )\n92:         if not admin:\n93:             connection.execute(\n94:                 \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n95:                 (generate_password_hash(admin_password) if admin_password else \"\",),\n96:             )\n97:         elif password_changed:\n98:             connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n99:             connection.execute(\n100:                 \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n101:                 (generate_password_hash(admin_password) if admin_password else \"\", admin[\"id\"]),\n102:             )\n103:         connection.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (int(time.time()),))\n104:         connection.commit()\n105:     finally:\n106:         connection.close()\n107: \n108: \n109: def product_json(product):\n110:     return {\n111:         \"id\": product[\"id\"],\n112:         \"name\": product[\"name\"],\n113:         \"description\": product[\"description\"],\n114:         \"price\": product[\"price_cents\"] / 100,\n115:         \"stock\": product[\"stock\"],\n116:         \"is_active\": bool(product[\"is_active\"]),\n117:     }\n118: \n119: \n120: def item_json(item):\n121:     return {\n122:         \"id\": item[\"id\"],\n123:         \"product_id\": item[\"product_id\"],\n124:         \"quantity\": item[\"quantity\"],\n125:         \"name\": item[\"name\"],\n126:         \"unit_price\": item[\"price_cents\"] / 100,\n127:         \"line_total\": item[\"quantity\"] * item[\"price_cents\"] / 100,\n128:     }\n129: \n130: \n131: def json_body():\n132:     body = request.get_json(silent=True)\n133:     if not isinstance(body, dict):\n134:         raise APIError(\"Please send a JSON object.\")\n135:     return body\n136: \n137: \n138: def integer(value, name, minimum=0):\n139:     if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= 1_000_000:\n140:         raise APIError(f\"{name} must be a whole number between {minimum} and 1000000.\")\n141:     return value\n142: \n143: \n144: def validated_product(body, partial=False):\n145:     fields = {\"name\", \"description\", \"price\", \"stock\", \"is_active\"}\n146:     if set(body) - fields:\n147:         raise APIError(\"Unknown product field.\")\n148:     if not partial and (\"name\" not in body or \"price\" not in body):\n149:         raise APIError(\"Name and price are required.\")\n150:     if not body and partial:\n151:         raise APIError(\"Provide at least one field to update.\")\n152:     result = {}\n153:     for field in (\"name\", \"description\"):\n154:         if field in body:\n155:             value = body[field]\n156:             if not isinstance(value, str) or len(value) > (150 if field == \"name\" else 2000):\n157:                 raise APIError(f\"{field.capitalize()} must be valid text.\")\n158:             if field == \"name\" and not value.strip():\n159:                 raise APIError(\"Product name cannot be empty.\")\n160:             result[field] = value.strip()\n161:     if \"price\" in body:\n162:         try:\n163:             if isinstance(body[\"price\"], bool):\n164:                 raise InvalidOperation\n165:             price = Decimal(str(body[\"price\"]))\n166:             if not price.is_finite() or not 0 <= price <= 1_000_000 or price * 100 != (price * 100).to_integral_value():\n167:                 raise InvalidOperation\n168:             result[\"price_cents\"] = int(price * 100)\n169:         except (InvalidOperation, ValueError, TypeError):\n170:             raise APIError(\"Price must be a non-negative amount with at most two decimal places.\") from None\n171:     if \"stock\" in body:\n172:         result[\"stock\"] = integer(body[\"stock\"], \"Stock\")\n173:     if \"is_active\" in body:\n174:         if not isinstance(body[\"is_active\"], bool):\n175:             raise APIError(\"Active status must be true or false.\")\n176:         result[\"is_active\"] = int(body[\"is_active\"])\n177:     if not partial:\n178:         result.setdefault(\"description\", \"\")\n179:         result.setdefault(\"stock\", 0)\n180:         result.setdefault(\"is_active\", 1)\n181:     return result\n182: \n183: \n184: def create_app(config=None):\n185:     application = Flask(__name__, static_folder=None)\n186:     application.config.update(\n187:         DATABASE=str(Path.cwd() / \"data\" / \"shop.sqlite3\"),\n188:         ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n189:         MAX_CONTENT_LENGTH=64 * 1024,\n190:     )\n191:     if config:\n192:         application.config.update(config)\n193:     initialize_database(application.config[\"DATABASE\"], application.config[\"ADMIN_PASSWORD\"])\n194: \n195:     def db():\n196:         if \"db\" not in g:\n197:             g.db = connect_database(application.config[\"DATABASE\"])\n198:         return g.db\n199: \n200:     @application.teardown_appcontext\n201:     def close_database(error=None):\n202:         connection = g.pop(\"db\", None)\n203:         if connection is not None:\n204:             connection.close()\n205: \n206:     @application.errorhandler(APIError)\n207:     def api_error(error):\n208:         return {\"message\": error.message}, error.status\n209: \n210:     @application.errorhandler(HTTPException)\n211:     def http_error(error):\n212:         return {\"message\": error.description}, error.code\n213: \n214:     @application.after_request\n215:     def security_headers(response):\n216:         response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n217:         response.headers[\"Referrer-Policy\"] = \"same-origin\"\n218:         response.headers[\"X-Frame-Options\"] = \"DENY\"\n219:         if request.path.startswith(\"/api/\"):\n220:             response.headers[\"Cache-Control\"] = \"no-store\"\n221:         return response\n222: \n223:     def authenticated(admin_only=False):\n224:         def decorator(view):\n225:             @wraps(view)\n226:             def wrapped(*args, **kwargs):\n227:                 auth = request.headers.get(\"Authorization\", \"\").split()\n228:                 if len(auth) != 2 or auth[0].lower() != \"bearer\":\n229:                     raise APIError(\"Please sign in to continue.\", 401)\n230:                 token_hash = hashlib.sha256(auth[1].encode()).hexdigest()\n231:                 user = (\n232:                     db()\n233:                     .execute(\n234:                         \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n235:                         \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n236:                         (token_hash, int(time.time())),\n237:                     )\n238:                     .fetchone()\n239:                 )\n240:                 if user is None or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"]):\n241:                     raise APIError(\"Your session has expired. Please sign in again.\", 401)\n242:                 if admin_only and not user[\"is_admin\"]:\n243:                     raise APIError(\"Only the admin can manage products.\", 403)\n244:                 g.user = user\n245:                 g.token_hash = token_hash\n246:                 return view(*args, **kwargs)\n247: \n248:             return wrapped\n249: \n250:         return decorator\n251: \n252:     def credentials():\n253:         body = json_body()\n254:         username, password = body.get(\"username\"), body.get(\"password\")\n255:         if not isinstance(username, str) or not re.fullmatch(r\"[a-zA-Z0-9_.-]{1,32}\", username):\n256:             raise APIError(\"Use a username of 1–32 letters, numbers, dots, underscores or hyphens.\")\n257:         if not isinstance(password, str) or not 1 <= len(password) <= 256:\n258:             raise APIError(\"Password must be between 1 and 256 characters.\")\n259:         return username, password\n260: \n261:     @application.get(\"/api/health\")\n262:     def health():\n263:         return {\"status\": \"ok\"}\n264: \n265:     @application.post(\"/api/auth/register\")\n266:     def register():\n267:         username, password = credentials()\n268:         if username.lower() == \"admin\":\n269:             raise APIError(\"That username is reserved.\", 409)\n270:         try:\n271:             with db():\n272:                 cursor = db().execute(\n273:                     \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n274:                     (username, generate_password_hash(password)),\n275:                 )\n276:         except sqlite3.IntegrityError:\n277:             raise APIError(\"That username is already taken.\", 409) from None\n278:         return {\"id\": cursor.lastrowid, \"username\": username}, 201\n279: \n280:     @application.post(\"/api/auth/login\")\n281:     def login():\n282:         username, password = credentials()\n283:         user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n284:         if (\n285:             user is None\n286:             or not user[\"password_hash\"]\n287:             or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"])\n288:             or not check_password_hash(user[\"password_hash\"], password)\n289:         ):\n290:             raise APIError(\"Incorrect username or password.\", 401)\n291:         token = secrets.token_urlsafe(48)\n292:         with db():\n293:             db().execute(\n294:                 \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n295:                 (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], int(time.time()) + 30 * 86400),\n296:             )\n297:         return {\"token\": token}\n298: \n299:     @application.get(\"/api/auth/me\")\n300:     @authenticated()\n301:     def me():\n302:         return {\"id\": g.user[\"id\"], \"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n303: \n304:     @application.post(\"/api/auth/logout\")\n305:     @authenticated()\n306:     def logout():\n307:         with db():\n308:             db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n309:         return {\"message\": \"Signed out.\"}\n310: \n311:     def paged_products(include_inactive=False):\n312:         try:\n313:             page = int(request.args.get(\"page\", \"1\"))\n314:             page_size = int(request.args.get(\"page_size\", \"8\"))\n315:         except ValueError:\n316:             raise APIError(\"Page and page_size must be positive whole numbers.\") from None\n317:         if not 1 <= page <= 1_000_000 or not 1 <= page_size <= 100:\n318:             raise APIError(\"Page must be positive and page_size must be between 1 and 100.\")\n319:         query = request.args.get(\"q\", \"\").strip()[:200]\n320:         escaped = query.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n321:         where = \"(name LIKE ? ESCAPE '\\\\' OR description LIKE ? ESCAPE '\\\\')\"\n322:         if not include_inactive:\n323:             where += \" AND is_active = 1\"\n324:         parameters = (f\"%{escaped}%\", f\"%{escaped}%\")\n325:         total = db().execute(f\"SELECT COUNT(*) FROM products WHERE {where}\", parameters).fetchone()[0]\n326:         products = (\n327:             db()\n328:             .execute(\n329:                 f\"SELECT * FROM products WHERE {where} ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n330:                 (*parameters, page_size, (page - 1) * page_size),\n331:             )\n332:             .fetchall()\n333:         )\n334:         return {\n335:             \"items\": [product_json(product) for product in products],\n336:             \"total\": total,\n337:             \"page\": page,\n338:             \"page_size\": page_size,\n339:         }\n340: \n341:     @application.get(\"/api/products\")\n342:     def products():\n343:         return paged_products()\n344: \n345:     @application.get(\"/api/products/<int:product_id>\")\n346:     def product_detail(product_id):\n347:         product = db().execute(\"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)).fetchone()\n348:         if product is None:\n349:             raise APIError(\"Product not found.\", 404)\n350:         return product_json(product)\n351: \n352:     def cart_item(item_id):\n353:         item = (\n354:             db()\n355:             .execute(\n356:                 \"SELECT c.*, p.name, p.price_cents, p.stock, p.is_active FROM cart_items c \"\n357:                 \"JOIN products p ON p.id = c.product_id WHERE c.id = ? AND c.user_id = ?\",\n358:                 (item_id, g.user[\"id\"]),\n359:             )\n360:             .fetchone()\n361:         )\n362:         if item is None:\n363:             raise APIError(\"Cart item not found.\", 404)\n364:         return item\n365: \n366:     def available(product, quantity):\n367:         if not product[\"is_active\"]:\n368:             raise APIError(\"This product is no longer available.\", 404)\n369:         if product[\"stock\"] == 0:\n370:             raise APIError(\"This product is out of stock.\")\n371:         if quantity > product[\"stock\"]:\n372:             raise APIError(f\"Only {product['stock']} available. Please choose a smaller quantity.\")\n373: \n374:     @application.get(\"/api/cart\")\n375:     @authenticated()\n376:     def cart():\n377:         items = (\n378:             db()\n379:             .execute(\n380:                 \"SELECT c.*, p.name, p.price_cents FROM cart_items c JOIN products p ON p.id = c.product_id \"\n381:                 \"WHERE c.user_id = ? AND p.is_active = 1 ORDER BY c.id\",\n382:                 (g.user[\"id\"],),\n383:             )\n384:             .fetchall()\n385:         )\n386:         return {\n387:             \"items\": [item_json(item) for item in items],\n388:             \"subtotal\": sum(item[\"quantity\"] * item[\"price_cents\"] for item in items) / 100,\n389:         }\n390: \n391:     @application.post(\"/api/cart\")\n392:     @authenticated()\n393:     def add_to_cart():\n394:         body = json_body()\n395:         product_id = integer(body.get(\"product_id\"), \"Product ID\", 1)\n396:         quantity = integer(body.get(\"quantity\"), \"Quantity\", 1)\n397:         with db():\n398:             db().execute(\"BEGIN IMMEDIATE\")\n399:             product = db().execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n400:             if product is None:\n401:                 raise APIError(\"Product not found.\", 404)\n402:             existing = (\n403:                 db()\n404:                 .execute(\"SELECT * FROM cart_items WHERE user_id = ? AND product_id = ?\", (g.user[\"id\"], product_id))\n405:                 .fetchone()\n406:             )\n407:             new_quantity = quantity + (existing[\"quantity\"] if existing else 0)\n408:             available(product, new_quantity)\n409:             if existing:\n410:                 db().execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (new_quantity, existing[\"id\"]))\n411:                 item_id = existing[\"id\"]\n412:             else:\n413:                 cursor = db().execute(\n414:                     \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n415:                     (g.user[\"id\"], product_id, quantity),\n416:                 )\n417:                 item_id = cursor.lastrowid\n418:             item = item_json(cart_item(item_id))\n419:         return item, 201\n420: \n421:     @application.patch(\"/api/cart/<int:item_id>\")\n422:     @authenticated()\n423:     def update_cart_item(item_id):\n424:         with db():\n425:             db().execute(\"BEGIN IMMEDIATE\")\n426:             item = cart_item(item_id)\n427:             quantity = integer(json_body().get(\"quantity\"), \"Quantity\", 1)\n428:             available(item, quantity)\n429:             db().execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n430:             result = item_json(cart_item(item_id))\n431:         return result\n432: \n433:     @application.delete(\"/api/cart/<int:item_id>\")\n434:     @authenticated()\n435:     def remove_cart_item(item_id):\n436:         with db():\n437:             cart_item(item_id)\n438:             db().execute(\"DELETE FROM cart_items WHERE id = ? AND user_id = ?\", (item_id, g.user[\"id\"]))\n439:         return \"\", 204\n440: \n441:     @application.get(\"/api/admin/products\")\n442:     @authenticated(admin_only=True)\n443:     def admin_products():\n444:         return paged_products(include_inactive=True)\n445: \n446:     @application.post(\"/api/admin/products\")\n447:     @authenticated(admin_only=True)\n448:     def create_product():\n449:         fields = validated_product(json_body())\n450:         with db():\n451:             cursor = db().execute(\n452:                 f\"INSERT INTO products ({', '.join(fields)}) VALUES ({', '.join('?' for _ in fields)})\",\n453:                 tuple(fields.values()),\n454:             )\n455:             product = db().execute(\"SELECT * FROM products WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n456:         return product_json(product), 201\n457: \n458:     @application.patch(\"/api/admin/products/<int:product_id>\")\n459:     @authenticated(admin_only=True)\n460:     def update_product(product_id):\n461:         if db().execute(\"SELECT 1 FROM products WHERE id = ?\", (product_id,)).fetchone() is None:\n462:             raise APIError(\"Product not found.\", 404)\n463:         fields = validated_product(json_body(), partial=True)\n464:         with db():\n465:             db().execute(\n466:                 f\"UPDATE products SET {', '.join(f'{field} = ?' for field in fields)} WHERE id = ?\",\n467:                 (*fields.values(), product_id),\n468:             )\n469:             product = db().execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n470:         return product_json(product)\n471: \n472:     @application.get(\"/\")\n473:     @application.get(\"/<path:path>\")\n474:     def frontend(path=\"index.html\"):\n475:         if path == \"api\" or path.startswith(\"api/\"):\n476:             raise APIError(\"API endpoint not found.\", 404)\n477:         if (DIST / path).is_file():\n478:             return send_from_directory(DIST, path)\n479:         return send_from_directory(DIST, \"index.html\")\n480: \n481:     return application\n482: \n483: \n484: app = create_app()\n485: \n486: \n487: if __name__ == \"__main__\":\n488:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\n(End of file - total 488 lines)\n</content>","metadata":{"preview":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nimport time\nfrom decimal import Decimal, InvalidOperation\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nSEED_PRODUCTS = [\n    (\"Amber glass vase\", \"Home & living · Warm-toned recycled glass for a stem or two.\", 3200, 24),\n    (\"Arc bookends\", \"Home & living · A sculptural pair, cast in warm sandstone.\", 4800, 18),\n    (\"Everyday ceramic mug\", \"Kitchen & dining · Your morning ritual, made a little slower.\", 1800, 40),\n    (\"Linen cushion\", \"Home & living · Soft, washed linen in a quiet shade of olive.\", 4200, 25),","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nimport time\nfrom decimal import Decimal, InvalidOperation\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nSEED_PRODUCTS = [\n    (\"Amber glass vase\", \"Home & living · Warm-toned recycled glass for a stem or two.\", 3200, 24),\n    (\"Arc bookends\", \"Home & living · A sculptural pair, cast in warm sandstone.\", 4800, 18),\n    (\"Everyday ceramic mug\", \"Kitchen & dining · Your morning ritual, made a little slower.\", 1800, 40),\n    (\"Linen cushion\", \"Home & living · Soft, washed linen in a quiet shade of olive.\", 4200, 25),\n    (\"Oak serving board\", \"Kitchen & dining · Solid oak. For gathering around the table.\", 3600, 20),\n    (\"Ribbed pillar candle\", \"Home & living · An unscented, slow-burning moment of calm.\", 1600, 30),\n    (\"Softcover notebook\", \"Everyday essentials · A little space for your next big idea.\", 1400, 45),\n    (\"Stoneware bowl\", \"Kitchen & dining · Hand-finished stoneware, beautifully imperfect.\", 2400, 32),\n    (\"Terra planter\", \"Home & living · A terracotta home for something green.\", 2800, 22),\n    (\"Woven cotton throw\", \"Home & living · An easy layer for your favorite corner.\", 6400, 15),\n    (\"Woven market tote\", \"Everyday essentials · Natural cotton for wherever the day takes you.\", 2600, 28),\n    (\"Wooden desk tray\", \"Everyday essentials · A place for the small things, in solid ash.\", 2200, 20),\n]\n\n\nclass APIError(Exception):\n    def __init__(self, message, status=400):\n        self.message = message\n        self.status = status\n\n\ndef connect_database(path):\n    connection = sqlite3.connect(path, timeout=20)\n    connection.row_factory = sqlite3.Row\n    connection.execute(\"PRAGMA foreign_keys = ON\")\n    connection.execute(\"PRAGMA busy_timeout = 20000\")\n    return connection\n\n\ndef initialize_database(path, admin_password):\n    Path(path).parent.mkdir(parents=True, exist_ok=True)\n    connection = connect_database(path)\n    try:\n        connection.execute(\"PRAGMA journal_mode = WAL\")\n        connection.executescript(\"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE TABLE IF NOT EXISTS products (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL,\n                description TEXT NOT NULL DEFAULT '',\n                price_cents INTEGER NOT NULL CHECK(price_cents >= 0),\n                stock INTEGER NOT NULL CHECK(stock >= 0),\n                is_active INTEGER NOT NULL DEFAULT 1\n            );\n            CREATE TABLE IF NOT EXISTS cart_items (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id),\n                product_id INTEGER NOT NULL REFERENCES products(id),\n                quantity INTEGER NOT NULL CHECK(quantity > 0),\n                UNIQUE(user_id, product_id)\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id),\n                expires_at INTEGER NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n        \"\"\")\n        connection.execute(\"BEGIN IMMEDIATE\")\n        if not connection.execute(\"SELECT 1 FROM products LIMIT 1\").fetchone():\n            connection.executemany(\n                \"INSERT INTO products (name, description, price_cents, stock) VALUES (?, ?, ?, ?)\",\n                SEED_PRODUCTS,\n            )\n        admin = connection.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n        password_changed = admin and (\n            not admin_password\n            or not admin[\"password_hash\"]\n            or not check_password_hash(admin[\"password_hash\"], admin_password)\n        )\n        if not admin:\n            connection.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n                (generate_password_hash(admin_password) if admin_password else \"\",),\n            )\n        elif password_changed:\n            connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n            connection.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(admin_password) if admin_password else \"\", admin[\"id\"]),\n            )\n        connection.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (int(time.time()),))\n        connection.commit()\n    finally:\n        connection.close()\n\n\ndef product_json(product):\n    return {\n        \"id\": product[\"id\"],\n        \"name\": product[\"name\"],\n        \"description\": product[\"description\"],\n        \"price\": product[\"price_cents\"] / 100,\n        \"stock\": product[\"stock\"],\n        \"is_active\": bool(product[\"is_active\"]),\n    }\n\n\ndef item_json(item):\n    return {\n        \"id\": item[\"id\"],\n        \"product_id\": item[\"product_id\"],\n        \"quantity\": item[\"quantity\"],\n        \"name\": item[\"name\"],\n        \"unit_price\": item[\"price_cents\"] / 100,\n        \"line_total\": item[\"quantity\"] * item[\"price_cents\"] / 100,\n    }\n\n\ndef json_body():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        raise APIError(\"Please send a JSON object.\")\n    return body\n\n\ndef integer(value, name, minimum=0):\n    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= 1_000_000:\n        raise APIError(f\"{name} must be a whole number between {minimum} and 1000000.\")\n    return value\n\n\ndef validated_product(body, partial=False):\n    fields = {\"name\", \"description\", \"price\", \"stock\", \"is_active\"}\n    if set(body) - fields:\n        raise APIError(\"Unknown product field.\")\n    if not partial and (\"name\" not in body or \"price\" not in body):\n        raise APIError(\"Name and price are required.\")\n    if not body and partial:\n        raise APIError(\"Provide at least one field to update.\")\n    result = {}\n    for field in (\"name\", \"description\"):\n        if field in body:\n            value = body[field]\n            if not isinstance(value, str) or len(value) > (150 if field == \"name\" else 2000):\n                raise APIError(f\"{field.capitalize()} must be valid text.\")\n            if field == \"name\" and not value.strip():\n                raise APIError(\"Product name cannot be empty.\")\n            result[field] = value.strip()\n    if \"price\" in body:\n        try:\n            if isinstance(body[\"price\"], bool):\n                raise InvalidOperation\n            price = Decimal(str(body[\"price\"]))\n            if not price.is_finite() or not 0 <= price <= 1_000_000 or price * 100 != (price * 100).to_integral_value():\n                raise InvalidOperation\n            result[\"price_cents\"] = int(price * 100)\n        except (InvalidOperation, ValueError, TypeError):\n            raise APIError(\"Price must be a non-negative amount with at most two decimal places.\") from None\n    if \"stock\" in body:\n        result[\"stock\"] = integer(body[\"stock\"], \"Stock\")\n    if \"is_active\" in body:\n        if not isinstance(body[\"is_active\"], bool):\n            raise APIError(\"Active status must be true or false.\")\n        result[\"is_active\"] = int(body[\"is_active\"])\n    if not partial:\n        result.setdefault(\"description\", \"\")\n        result.setdefault(\"stock\", 0)\n        result.setdefault(\"is_active\", 1)\n    return result\n\n\ndef create_app(config=None):\n    application = Flask(__name__, static_folder=None)\n    application.config.update(\n        DATABASE=str(Path.cwd() / \"data\" / \"shop.sqlite3\"),\n        ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n        MAX_CONTENT_LENGTH=64 * 1024,\n    )\n    if config:\n        application.config.update(config)\n    initialize_database(application.config[\"DATABASE\"], application.config[\"ADMIN_PASSWORD\"])\n\n    def db():\n        if \"db\" not in g:\n            g.db = connect_database(application.config[\"DATABASE\"])\n        return g.db\n\n    @application.teardown_appcontext\n    def close_database(error=None):\n        connection = g.pop(\"db\", None)\n        if connection is not None:\n            connection.close()\n\n    @application.errorhandler(APIError)\n    def api_error(error):\n        return {\"message\": error.message}, error.status\n\n    @application.errorhandler(HTTPException)\n    def http_error(error):\n        return {\"message\": error.description}, error.code\n\n    @application.after_request\n    def security_headers(response):\n        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n        response.headers[\"X-Frame-Options\"] = \"DENY\"\n        if request.path.startswith(\"/api/\"):\n            response.headers[\"Cache-Control\"] = \"no-store\"\n        return response\n\n    def authenticated(admin_only=False):\n        def decorator(view):\n            @wraps(view)\n            def wrapped(*args, **kwargs):\n                auth = request.headers.get(\"Authorization\", \"\").split()\n                if len(auth) != 2 or auth[0].lower() != \"bearer\":\n                    raise APIError(\"Please sign in to continue.\", 401)\n                token_hash = hashlib.sha256(auth[1].encode()).hexdigest()\n                user = (\n                    db()\n                    .execute(\n                        \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n                        \"WHERE s.token_hash = ? AND s.expires_at > ?\",\n                        (token_hash, int(time.time())),\n                    )\n                    .fetchone()\n                )\n                if user is None or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"]):\n                    raise APIError(\"Your session has expired. Please sign in again.\", 401)\n                if admin_only and not user[\"is_admin\"]:\n                    raise APIError(\"Only the admin can manage products.\", 403)\n                g.user = user\n                g.token_hash = token_hash\n                return view(*args, **kwargs)\n\n            return wrapped\n\n        return decorator\n\n    def credentials():\n        body = json_body()\n        username, password = body.get(\"username\"), body.get(\"password\")\n        if not isinstance(username, str) or not re.fullmatch(r\"[a-zA-Z0-9_.-]{1,32}\", username):\n            raise APIError(\"Use a username of 1–32 letters, numbers, dots, underscores or hyphens.\")\n        if not isinstance(password, str) or not 1 <= len(password) <= 256:\n            raise APIError(\"Password must be between 1 and 256 characters.\")\n        return username, password\n\n    @application.get(\"/api/health\")\n    def health():\n        return {\"status\": \"ok\"}\n\n    @application.post(\"/api/auth/register\")\n    def register():\n        username, password = credentials()\n        if username.lower() == \"admin\":\n            raise APIError(\"That username is reserved.\", 409)\n        try:\n            with db():\n                cursor = db().execute(\n                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                    (username, generate_password_hash(password)),\n                )\n        except sqlite3.IntegrityError:\n            raise APIError(\"That username is already taken.\", 409) from None\n        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n\n    @application.post(\"/api/auth/login\")\n    def login():\n        username, password = credentials()\n        user = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n        if (\n            user is None\n            or not user[\"password_hash\"]\n            or (user[\"is_admin\"] and not application.config[\"ADMIN_PASSWORD\"])\n            or not check_password_hash(user[\"password_hash\"], password)\n        ):\n            raise APIError(\"Incorrect username or password.\", 401)\n        token = secrets.token_urlsafe(48)\n        with db():\n            db().execute(\n                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], int(time.time()) + 30 * 86400),\n            )\n        return {\"token\": token}\n\n    @application.get(\"/api/auth/me\")\n    @authenticated()\n    def me():\n        return {\"id\": g.user[\"id\"], \"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n\n    @application.post(\"/api/auth/logout\")\n    @authenticated()\n    def logout():\n        with db():\n            db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n        return {\"message\": \"Signed out.\"}\n\n    def paged_products(include_inactive=False):\n        try:\n            page = int(request.args.get(\"page\", \"1\"))\n            page_size = int(request.args.get(\"page_size\", \"8\"))\n        except ValueError:\n            raise APIError(\"Page and page_size must be positive whole numbers.\") from None\n        if not 1 <= page <= 1_000_000 or not 1 <= page_size <= 100:\n            raise APIError(\"Page must be positive and page_size must be between 1 and 100.\")\n        query = request.args.get(\"q\", \"\").strip()[:200]\n        escaped = query.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        where = \"(name LIKE ? ESCAPE '\\\\' OR description LIKE ? ESCAPE '\\\\')\"\n        if not include_inactive:\n            where += \" AND is_active = 1\"\n        parameters = (f\"%{escaped}%\", f\"%{escaped}%\")\n        total = db().execute(f\"SELECT COUNT(*) FROM products WHERE {where}\", parameters).fetchone()[0]\n        products = (\n            db()\n            .execute(\n                f\"SELECT * FROM products WHERE {where} ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n                (*parameters, page_size, (page - 1) * page_size),\n            )\n            .fetchall()\n        )\n        return {\n            \"items\": [product_json(product) for product in products],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n\n    @application.get(\"/api/products\")\n    def products():\n        return paged_products()\n\n    @application.get(\"/api/products/<int:product_id>\")\n    def product_detail(product_id):\n        product = db().execute(\"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)).fetchone()\n        if product is None:\n            raise APIError(\"Product not found.\", 404)\n        return product_json(product)\n\n    def cart_item(item_id):\n        item = (\n            db()\n            .execute(\n                \"SELECT c.*, p.name, p.price_cents, p.stock, p.is_active FROM cart_items c \"\n                \"JOIN products p ON p.id = c.product_id WHERE c.id = ? AND c.user_id = ?\",\n                (item_id, g.user[\"id\"]),\n            )\n            .fetchone()\n        )\n        if item is None:\n            raise APIError(\"Cart item not found.\", 404)\n        return item\n\n    def available(product, quantity):\n        if not product[\"is_active\"]:\n            raise APIError(\"This product is no longer available.\", 404)\n        if product[\"stock\"] == 0:\n            raise APIError(\"This product is out of stock.\")\n        if quantity > product[\"stock\"]:\n            raise APIError(f\"Only {product['stock']} available. Please choose a smaller quantity.\")\n\n    @application.get(\"/api/cart\")\n    @authenticated()\n    def cart():\n        items = (\n            db()\n            .execute(\n                \"SELECT c.*, p.name, p.price_cents FROM cart_items c JOIN products p ON p.id = c.product_id \"\n                \"WHERE c.user_id = ? AND p.is_active = 1 ORDER BY c.id\",\n                (g.user[\"id\"],),\n            )\n            .fetchall()\n        )\n        return {\n            \"items\": [item_json(item) for item in items],\n            \"subtotal\": sum(item[\"quantity\"] * item[\"price_cents\"] for item in items) / 100,\n        }\n\n    @application.post(\"/api/cart\")\n    @authenticated()\n    def add_to_cart():\n        body = json_body()\n        product_id = integer(body.get(\"product_id\"), \"Product ID\", 1)\n        quantity = integer(body.get(\"quantity\"), \"Quantity\", 1)\n        with db():\n            db().execute(\"BEGIN IMMEDIATE\")\n            product = db().execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n            if product is None:\n                raise APIError(\"Product not found.\", 404)\n            existing = (\n                db()\n                .execute(\"SELECT * FROM cart_items WHERE user_id = ? AND product_id = ?\", (g.user[\"id\"], product_id))\n                .fetchone()\n            )\n            new_quantity = quantity + (existing[\"quantity\"] if existing else 0)\n            available(product, new_quantity)\n            if existing:\n                db().execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (new_quantity, existing[\"id\"]))\n                item_id = existing[\"id\"]\n            else:\n                cursor = db().execute(\n                    \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n                    (g.user[\"id\"], product_id, quantity),\n                )\n                item_id = cursor.lastrowid\n            item = item_json(cart_item(item_id))\n        return item, 201\n\n    @application.patch(\"/api/cart/<int:item_id>\")\n    @authenticated()\n    def update_cart_item(item_id):\n        with db():\n            db().execute(\"BEGIN IMMEDIATE\")\n            item = cart_item(item_id)\n            quantity = integer(json_body().get(\"quantity\"), \"Quantity\", 1)\n            available(item, quantity)\n            db().execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n            result = item_json(cart_item(item_id))\n        return result\n\n    @application.delete(\"/api/cart/<int:item_id>\")\n    @authenticated()\n    def remove_cart_item(item_id):\n        with db():\n            cart_item(item_id)\n            db().execute(\"DELETE FROM cart_items WHERE id = ? AND user_id = ?\", (item_id, g.user[\"id\"]))\n        return \"\", 204\n\n    @application.get(\"/api/admin/products\")\n    @authenticated(admin_only=True)\n    def admin_products():\n        return paged_products(include_inactive=True)\n\n    @application.post(\"/api/admin/products\")\n    @authenticated(admin_only=True)\n    def create_product():\n        fields = validated_product(json_body())\n        with db():\n            cursor = db().execute(\n                f\"INSERT INTO products ({', '.join(fields)}) VALUES ({', '.join('?' for _ in fields)})\",\n                tuple(fields.values()),\n            )\n            product = db().execute(\"SELECT * FROM products WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n        return product_json(product), 201\n\n    @application.patch(\"/api/admin/products/<int:product_id>\")\n    @authenticated(admin_only=True)\n    def update_product(product_id):\n        if db().execute(\"SELECT 1 FROM products WHERE id = ?\", (product_id,)).fetchone() is None:\n            raise APIError(\"Product not found.\", 404)\n        fields = validated_product(json_body(), partial=True)\n        with db():\n            db().execute(\n                f\"UPDATE products SET {', '.join(f'{field} = ?' for field in fields)} WHERE id = ?\",\n                (*fields.values(), product_id),\n            )\n            product = db().execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n        return product_json(product)\n\n    @application.get(\"/\")\n    @application.get(\"/<path:path>\")\n    def frontend(path=\"index.html\"):\n        if path == \"api\" or path.startswith(\"api/\"):\n            raise APIError(\"API endpoint not found.\", 404)\n        if (DIST / path).is_file():\n            return send_from_directory(DIST, path)\n        return send_from_directory(DIST, \"index.html\")\n\n    return application\n\n\napp = create_app()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))","lineStart":1,"lineEnd":488,"totalLines":488,"truncated":false}},"title":"backend/app.py","time":{"start":1794314848242,"end":1794314848351}},"id":"prt_1c57fc7e4001xnADPk4TS4a7w6","sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","messageID":"msg_1c57fafb1001CyzdI6P8tt9F8l"}}
{"type":"tool_use","timestamp":1794314848447,"sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","part":{"type":"tool","tool":"read","callID":"call_JNoRFzfX2TNbZYv0DLyrCBYt","state":{"status":"completed","input":{"filePath":"/workspace/frontend/playwright.config.ts"},"output":"<path>/workspace/frontend/playwright.config.ts</path>\n<type>file</type>\n<content>\n1: import { defineConfig } from \"@playwright/test\";\n2: \n3: export default defineConfig({\n4:   testDir: \"./tests\",\n5:   fullyParallel: false,\n6:   workers: 1,\n7:   reporter: \"list\",\n8:   use: {\n9:     baseURL: \"http://127.0.0.1:8001\",\n10:     viewport: { width: 1440, height: 1000 },\n11:     trace: \"retain-on-failure\",\n12:     launchOptions: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ? {\n13:       executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH,\n14:       args: [\"--no-sandbox\", \"--disable-dev-shm-usage\"],\n15:     } : {},\n16:   },\n17:   webServer: {\n18:     command: \"../.venv/bin/python ../backend/test_server.py\",\n19:     url: \"http://127.0.0.1:8001/api/health\",\n20:     env: { ADMIN_PASSWORD: \"browser-test-admin-secret\" },\n21:     reuseExistingServer: false,\n22:     timeout: 30000,\n23:   },\n24: });\n\n(End of file - total 24 lines)\n</content>","metadata":{"preview":"import { defineConfig } from \"@playwright/test\";\n\nexport default defineConfig({\n  testDir: \"./tests\",\n  fullyParallel: false,\n  workers: 1,\n  reporter: \"list\",\n  use: {\n    baseURL: \"http://127.0.0.1:8001\",\n    viewport: { width: 1440, height: 1000 },\n    trace: \"retain-on-failure\",\n    launchOptions: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ? {\n      executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH,\n      args: [\"--no-sandbox\", \"--disable-dev-shm-usage\"],\n    } : {},\n  },\n  webServer: {\n    command: \"../.venv/bin/python ../backend/test_server.py\",\n    url: \"http://127.0.0.1:8001/api/health\",\n    env: { ADMIN_PASSWORD: \"browser-test-admin-secret\" },","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/playwright.config.ts","text":"import { defineConfig } from \"@playwright/test\";\n\nexport default defineConfig({\n  testDir: \"./tests\",\n  fullyParallel: false,\n  workers: 1,\n  reporter: \"list\",\n  use: {\n    baseURL: \"http://127.0.0.1:8001\",\n    viewport: { width: 1440, height: 1000 },\n    trace: \"retain-on-failure\",\n    launchOptions: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ? {\n      executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH,\n      args: [\"--no-sandbox\", \"--disable-dev-shm-usage\"],\n    } : {},\n  },\n  webServer: {\n    command: \"../.venv/bin/python ../backend/test_server.py\",\n    url: \"http://127.0.0.1:8001/api/health\",\n    env: { ADMIN_PASSWORD: \"browser-test-admin-secret\" },\n    reuseExistingServer: false,\n    timeout: 30000,\n  },\n});","lineStart":1,"lineEnd":24,"totalLines":24,"truncated":false}},"title":"frontend/playwright.config.ts","time":{"start":1794314848280,"end":1794314848427}},"id":"prt_1c57fc8120012QFQq6mUS7GgSv","sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","messageID":"msg_1c57fafb1001CyzdI6P8tt9F8l"}}
{"type":"tool_use","timestamp":1794314848448,"sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","part":{"type":"tool","tool":"read","callID":"call_5yFwoaTYzhKWFQ71YrUlf9Kt","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/App.tsx"},"output":"<path>/workspace/frontend/src/App.tsx</path>\n<type>file</type>\n<content>\n1: import { useCallback, useEffect, useRef, useState } from \"react\";\n2: import { Admin } from \"./Admin\";\n3: import { api, ApiError, category, description, money } from \"./api\";\n4: import type { Cart, Product, ProductPage, User } from \"./api\";\n5: import { AuthForm, primaryButton } from \"./AuthForm\";\n6: import { BrandMark, Icon } from \"./Icons\";\n7: import { ErrorMessage, Modal } from \"./Modal\";\n8: import { HeroArt, ProductArt } from \"./ProductArt\";\n9: \n10: const categories = [\"All objects\", \"Home & living\", \"Kitchen & dining\", \"Everyday essentials\"];\n11: const tileColors = [\"bg-[#eee9e0]\", \"bg-[#eae7df]\", \"bg-[#e9e9df]\", \"bg-[#eee9e2]\", \"bg-[#ebe7dd]\", \"bg-[#e8e5dc]\", \"bg-[#ebe3d7]\", \"bg-[#efe6df]\"];\n12: const emptyCart: Cart = { items: [], subtotal: 0 };\n13: \n14: function storedToken() {\n15:   try { return localStorage.getItem(\"form-field-token\"); } catch { return null; }\n16: }\n17: \n18: function saveToken(token: string | null) {\n19:   try {\n20:     if (token) localStorage.setItem(\"form-field-token\", token);\n21:     else localStorage.removeItem(\"form-field-token\");\n22:   } catch { return; }\n23: }\n24: \n25: export default function App() {\n26:   const [token, setToken] = useState<string | null>(storedToken);\n27:   const [user, setUser] = useState<User | null>(null);\n28:   const [sessionLoading, setSessionLoading] = useState(Boolean(token));\n29:   const [products, setProducts] = useState<ProductPage | null>(null);\n30:   const [loading, setLoading] = useState(true);\n31:   const [catalogueError, setCatalogueError] = useState(\"\");\n32:   const [search, setSearch] = useState(\"\");\n33:   const [query, setQuery] = useState(\"\");\n34:   const [selectedCategory, setSelectedCategory] = useState(\"All objects\");\n35:   const [page, setPage] = useState(1);\n36:   const [version, setVersion] = useState(0);\n37:   const [cart, setCart] = useState<Cart>(emptyCart);\n38:   const [cartOpen, setCartOpen] = useState(false);\n39:   const [cartLoading, setCartLoading] = useState(false);\n40:   const [cartError, setCartError] = useState(\"\");\n41:   const [busyItem, setBusyItem] = useState<number | null>(null);\n42:   const [adding, setAdding] = useState<number | null>(null);\n43:   const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n44:   const [pendingProduct, setPendingProduct] = useState<Product | null>(null);\n45:   const [detail, setDetail] = useState<Product | null>(null);\n46:   const [detailError, setDetailError] = useState(\"\");\n47:   const [aboutOpen, setAboutOpen] = useState(false);\n48:   const [adminOpen, setAdminOpen] = useState(false);\n49:   const [toast, setToast] = useState<{ message: string; error?: boolean } | null>(null);\n50:   const collectionRef = useRef<HTMLElement>(null);\n51:   const cartMutation = useRef(false);\n52: \n53:   const resetSession = useCallback(() => {\n54:     setToken(null); saveToken(null); setUser(null); setCart(emptyCart); setAdminOpen(false);\n55:   }, []);\n56: \n57:   const refreshCart = useCallback(async (currentToken: string) => {\n58:     const next = await api<Cart>(\"/cart\", {}, currentToken);\n59:     setCart(next);\n60:     return next;\n61:   }, []);\n62: \n63:   useEffect(() => {\n64:     if (!token) { setSessionLoading(false); return; }\n65:     let ignore = false;\n66:     setSessionLoading(true);\n67:     api<User>(\"/auth/me\", {}, token).then(async (data) => {\n68:       if (ignore) return;\n69:       setUser(data);\n70:       const nextCart = await api<Cart>(\"/cart\", {}, token);\n71:       if (!ignore) setCart(nextCart);\n72:     }).catch((caught: Error) => {\n73:       if (ignore) return;\n74:       if (caught instanceof ApiError && caught.status === 401) resetSession();\n75:       else setToast({ message: caught.message, error: true });\n76:     }).finally(() => { if (!ignore) setSessionLoading(false); });\n77:     return () => { ignore = true; };\n78:   }, [token, resetSession]);\n79: \n80:   useEffect(() => {\n81:     const timer = window.setTimeout(() => { setQuery(search.trim()); setPage(1); }, 250);\n82:     return () => window.clearTimeout(timer);\n83:   }, [search]);\n84: \n85:   useEffect(() => {\n86:     const controller = new AbortController();\n87:     setLoading(true);\n88:     setCatalogueError(\"\");\n89:     const q = query || (selectedCategory === \"All objects\" ? \"\" : selectedCategory);\n90:     api<ProductPage>(`/products?${new URLSearchParams({ q, page: String(page), page_size: \"8\" })}`, { signal: controller.signal }).then((data) => {\n91:       if (!controller.signal.aborted) setProducts(data);\n92:     }).catch((caught: Error) => {\n93:       if (!controller.signal.aborted) setCatalogueError(caught.message);\n94:     }).finally(() => { if (!controller.signal.aborted) setLoading(false); });\n95:     return () => controller.abort();\n96:   }, [query, selectedCategory, page, version]);\n97: \n98:   useEffect(() => {\n99:     if (!toast) return;\n100:     const timer = window.setTimeout(() => setToast(null), 4500);\n101:     return () => window.clearTimeout(timer);\n102:   }, [toast]);\n103: \n104:   useEffect(() => {\n105:     if (!token || !user || !cartOpen) return;\n106:     let ignore = false;\n107:     setCartLoading(true);\n108:     setCartError(\"\");\n109:     api<Cart>(\"/cart\", {}, token).then((data) => { if (!ignore) setCart(data); }).catch((caught: Error) => {\n110:       if (!ignore) setCartError(caught.message);\n111:     }).finally(() => { if (!ignore) setCartLoading(false); });\n112:     return () => { ignore = true; };\n113:   }, [token, user, cartOpen, version]);\n114: \n115:   async function addProduct(product: Product, currentToken = token) {\n116:     if (!currentToken) {\n117:       setPendingProduct(product); setDetail(null); setAuthMode(\"login\");\n118:       return;\n119:     }\n120:     if (cartMutation.current) return;\n121:     cartMutation.current = true;\n122:     setAdding(product.id);\n123:     setDetailError(\"\");\n124:     try {\n125:       await api(\"/cart\", { method: \"POST\", body: JSON.stringify({ product_id: product.id, quantity: 1 }) }, currentToken);\n126:       await refreshCart(currentToken);\n127:       setDetail(null);\n128:       setToast({ message: `${product.name} added to your cart.` });\n129:     } catch (caught) {\n130:       const message = caught instanceof Error ? caught.message : \"Couldn’t add this object.\";\n131:       setToast({ message, error: true });\n132:       setDetailError(message);\n133:       if (caught instanceof ApiError && caught.status === 401) { resetSession(); setPendingProduct(product); setDetail(null); setAuthMode(\"login\"); }\n134:     } finally {\n135:       setAdding(null);\n136:       cartMutation.current = false;\n137:     }\n138:   }\n139: \n140:   async function changeItem(id: number, quantity?: number) {\n141:     if (!token || cartMutation.current) return;\n142:     cartMutation.current = true;\n143:     setBusyItem(id); setCartError(\"\");\n144:     try {\n145:       await api(`/cart/${id}`, { method: quantity === undefined ? \"DELETE\" : \"PATCH\", ...(quantity !== undefined ? { body: JSON.stringify({ quantity }) } : {}) }, token);\n146:       await refreshCart(token);\n147:     } catch (caught) {\n148:       setCartError(caught instanceof Error ? caught.message : \"Couldn’t update your cart.\");\n149:       if (caught instanceof ApiError && caught.status === 401) resetSession();\n150:     } finally {\n151:       setBusyItem(null); cartMutation.current = false;\n152:     }\n153:   }\n154: \n155:   async function signOut() {\n156:     if (!token) return;\n157:     try {\n158:       await api(\"/auth/logout\", { method: \"POST\" }, token);\n159:       resetSession(); setCartOpen(false); setToast({ message: \"You’re signed out. Your cart is saved for next time.\" });\n160:     } catch (caught) {\n161:       if (caught instanceof ApiError && caught.status === 401) resetSession();\n162:       else setToast({ message: caught instanceof Error ? caught.message : \"Couldn’t sign out. Please try again.\", error: true });\n163:     }\n164:   }\n165: \n166:   function authenticated(nextToken: string, nextUser: User) {\n167:     saveToken(nextToken); setToken(nextToken); setUser(nextUser); setAuthMode(null);\n168:     if (pendingProduct) { void addProduct(pendingProduct, nextToken); setPendingProduct(null); }\n169:     else setToast({ message: `Welcome ${nextUser.username}. Make yourself at home.` });\n170:   }\n171: \n172:   function selectCategory(value: string) {\n173:     setSelectedCategory(value); setSearch(\"\"); setQuery(\"\"); setPage(1);\n174:   }\n175: \n176:   function browse() {\n177:     setAdminOpen(false);\n178:     window.setTimeout(() => collectionRef.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" }), 10);\n179:   }\n180: \n181:   function catalogueUpdated() {\n182:     setVersion((value) => value + 1);\n183:     if (token) void refreshCart(token).catch((caught: Error) => setToast({ message: caught.message, error: true }));\n184:   }\n185: \n186:   const cartCount = cart.items.reduce((count, item) => count + item.quantity, 0);\n187:   const pages = Math.max(1, Math.ceil((products?.total ?? 0) / 8));\n188: \n189:   return <>\n190:     <div className=\"flex h-8 items-center justify-center bg-[#eeeee6] px-4 text-center text-[10px] tracking-[.09em] text-[#656b58] sm:text-[11px]\"><span>Thoughtfully chosen. Made for the everyday.</span><span className=\"mx-3 h-1 w-1 rounded-full bg-[#a8ad98]\" /><span>Good things, simply.</span></div>\n191:     <header className=\"border-b border-line bg-paper\">\n192:       <div className=\"mx-auto flex h-[88px] max-w-[1280px] items-center justify-between gap-4 px-5 sm:px-8 lg:px-12\">\n193:         <a href=\"#\" onClick={(event) => { event.preventDefault(); setAdminOpen(false); window.scrollTo({ top: 0, behavior: \"smooth\" }); }} aria-label=\"Form and Field home\" className=\"flex shrink-0 items-center gap-2.5 sm:gap-3\"><BrandMark className=\"h-6 w-6 text-rust sm:h-7 sm:w-7\" /><span className=\"font-serif text-[25px] font-semibold tracking-[-1.3px] sm:text-[29px]\">form <span className=\"font-normal italic\">&</span> field<span className=\"text-rust\">.</span></span></a>\n194:         <nav aria-label=\"Main navigation\" className=\"ml-8 hidden items-center gap-8 text-[13px] md:flex\"><button onClick={browse} className={`relative py-2 transition hover:text-rust ${!adminOpen ? \"text-rust after:absolute after:inset-x-0 after:-bottom-[22px] after:h-[2px] after:bg-rust\" : \"text-muted\"}`}>The shop</button><button onClick={() => setAboutOpen(true)} className=\"text-muted transition hover:text-rust\">Our philosophy</button>{user?.is_admin && <button onClick={() => setAdminOpen(true)} className={`flex items-center gap-2 transition hover:text-rust ${adminOpen ? \"text-rust\" : \"text-muted\"}`}><Icon name=\"settings\" className=\"h-4 w-4\" />Manage products</button>}</nav>\n195:         <div className=\"flex items-center gap-3 sm:gap-6\">\n196:           {user ? <div className=\"flex items-center gap-3\"><span className=\"max-w-24 truncate text-xs sm:max-w-32 sm:text-sm\" title={user.username}>{user.username}</span><button onClick={() => void signOut()} aria-label=\"Sign out\" title=\"Sign out\" className=\"rounded p-1.5 text-muted hover:text-rust\"><Icon name=\"logout\" className=\"h-[18px] w-[18px]\" /></button></div> : <button onClick={() => setAuthMode(\"login\")} disabled={sessionLoading} className=\"flex items-center gap-2 rounded py-2 text-[13px] transition hover:text-rust\"><Icon name=\"user\" className=\"h-[18px] w-[18px]\" /><span className=\"hidden sm:inline\">{sessionLoading ? \"Signing in…\" : \"Sign in\"}</span><span className=\"sr-only sm:hidden\">Sign in</span></button>}\n197:           <div className=\"h-5 w-px bg-line\" />\n198:           <button onClick={() => setCartOpen(true)} aria-label={`Open cart, ${cartCount} ${cartCount === 1 ? \"item\" : \"items\"}`} className=\"flex items-center gap-2 rounded py-2 transition hover:text-rust\"><Icon name=\"bag\" className=\"h-5 w-5\" /><span className=\"hidden text-[13px] lg:inline\">Cart</span><span className=\"flex h-5 min-w-5 items-center justify-center rounded-full bg-rust px-1 text-[10px] font-medium text-white\">{cartCount}</span></button>\n199:         </div>\n200:       </div>\n201:       {user?.is_admin && <div className=\"border-t border-line px-5 py-2 md:hidden\"><button onClick={() => setAdminOpen(!adminOpen)} className=\"flex items-center gap-2 text-xs text-rust\"><Icon name=\"settings\" className=\"h-4 w-4\" />{adminOpen ? \"Return to shop\" : \"Manage products\"}</button></div>}\n202:     </header>\n203: \n204:     {adminOpen && user?.is_admin && token ? <Admin token={token} onChange={catalogueUpdated} onBack={() => setAdminOpen(false)} /> : <main className=\"mx-auto max-w-[1280px] px-5 sm:px-8 lg:px-12\">\n205:       <section className=\"relative mt-7 grid overflow-hidden rounded-lg bg-[#eae3d6] md:mt-8 md:min-h-[370px] md:grid-cols-[1fr_1.02fr]\" aria-labelledby=\"hero-title\">\n206:         <div className=\"relative z-10 px-7 pt-9 pb-7 sm:px-11 sm:pt-11 md:py-12 lg:px-12\">\n207:           <div className=\"mb-5 flex items-center gap-2.5 text-[10px] font-medium tracking-[.19em] text-[#756b54] uppercase\"><span className=\"h-px w-6 bg-[#a6977f]\" />The everyday, considered</div>\n208:           <h1 id=\"hero-title\" className=\"font-serif text-[44px] leading-[1.09] tracking-[-1.7px] sm:text-[52px] lg:text-[58px]\">Good things.<br />For everyday living.</h1>\n209:           <p className=\"mt-5 max-w-[315px] text-[13px] leading-[1.85] text-[#737061]\">A collection of simple, beautiful objects.<br className=\"hidden sm:block\" /> Chosen with care. Made to feel like home.</p>\n210:           <button onClick={browse} className={`${primaryButton} mt-7 gap-6! px-5! text-[12px]!`}>Explore the collection<Icon name=\"arrow\" className=\"h-4 w-4\" /></button>\n211:         </div>\n212:         <div className=\"relative -mt-12 h-[285px] sm:h-[330px] md:mt-0 md:h-full\"><HeroArt /></div>\n213:         <div className=\"absolute top-6 right-6 hidden text-[9px] tracking-[.17em] text-[#8c806b] uppercase sm:block\">The slow living edit / No. 01</div>\n214:       </section>\n215: \n216:       <section aria-label=\"Our values\" className=\"grid grid-cols-3 gap-2 border-b border-line py-6 sm:py-7\">\n217:         {([{ icon: \"leaf\", title: \"Thoughtfully chosen\", text: \"Fewer things. Better things.\" }, { icon: \"heart\", title: \"Everyday, elevated\", text: \"Small joys, lasting favorites.\" }, { icon: \"box\", title: \"Made to be kept\", text: \"Good design never gets old.\" }] as const).map((value, index) => <div key={value.title} className={`flex flex-col items-center justify-center gap-2 text-center sm:flex-row sm:gap-3.5 sm:text-left ${index !== 2 ? \"border-r border-line\" : \"\"}`}><Icon name={value.icon} className=\"h-[21px] w-[21px] shrink-0 text-[#788268]\" /><div><p className=\"text-[10px] font-medium sm:text-[12px]\">{value.title}</p><p className=\"mt-1 hidden text-[11px] text-muted sm:block\">{value.text}</p></div></div>)}\n218:       </section>\n219: \n220:       <section ref={collectionRef} id=\"collection\" className=\"scroll-mt-6 pt-10 pb-14 sm:pt-12 sm:pb-16\" aria-labelledby=\"collection-title\">\n221:         <div className=\"mb-7 flex flex-wrap items-end justify-between gap-4\"><div><p className=\"mb-2.5 text-[9px] font-medium tracking-[.2em] text-rust uppercase\">Little things. Lasting favorites.</p><h2 id=\"collection-title\" className=\"font-serif text-[30px] leading-tight tracking-[-.65px] sm:text-[34px]\">Meet your new everyday.</h2><p className=\"mt-2.5 text-[12px] leading-relaxed text-muted\">Useful, beautiful, and a little bit special. Just like the everyday should be.</p></div><span className=\"mb-1 hidden text-[11px] text-muted lg:block\">A considered collection, not an endless catalogue.</span></div>\n222:         <div className=\"mb-7 flex flex-col justify-between gap-5 lg:flex-row lg:items-center\">\n223:           <div className=\"-mx-1 flex gap-1 overflow-x-auto p-1\" role=\"group\" aria-label=\"Product categories\">{categories.map((label) => <button key={label} aria-pressed={selectedCategory === label} onClick={() => selectCategory(label)} className={`shrink-0 rounded-md px-3.5 py-2.5 text-[11px] transition sm:px-4 ${selectedCategory === label ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50 hover:text-ink\"}`}>{label}</button>)}</div>\n224:           <div className=\"relative w-full lg:w-[240px]\"><Icon name=\"search\" className=\"pointer-events-none absolute top-3 left-3.5 h-4 w-4 text-muted\" /><input type=\"search\" aria-label=\"Search products\" placeholder=\"Find something good…\" value={search} onChange={(event) => { setSearch(event.target.value); if (event.target.value) setSelectedCategory(\"All objects\"); }} className=\"h-[40px] w-full rounded-md border border-line bg-white py-2 pr-4 pl-10 text-[11px] placeholder:text-muted/75 focus:border-rust focus:ring-offset-0\" /></div>\n225:         </div>\n226: \n227:         {catalogueError ? <div className=\"rounded-lg border border-line p-7\"><ErrorMessage message={catalogueError} /><button onClick={() => setVersion((value) => value + 1)} className={`${primaryButton} mt-4`}>Try again</button></div> : loading ? <div aria-label=\"Loading products\" role=\"status\" className=\"grid grid-cols-2 gap-x-5 gap-y-8 lg:grid-cols-4 lg:gap-x-6\">{Array.from({ length: 8 }, (_, i) => <div key={i} className=\"animate-pulse\"><div className=\"aspect-[1.12] rounded-md bg-line/70\" /><div className=\"mt-4 h-2 w-20 rounded bg-line\" /><div className=\"mt-3 h-4 w-3/4 rounded bg-line\" /><div className=\"mt-3 h-3 w-12 rounded bg-line\" /></div>)}</div> : products?.items.length ? <div className=\"grid grid-cols-2 gap-x-5 gap-y-8 sm:gap-y-9 lg:grid-cols-4 lg:gap-x-6\">\n228:           {products.items.map((product, index) => <article key={product.id} className=\"group min-w-0\">\n229:             <button onClick={() => { setDetail(product); setDetailError(\"\"); }} className={`relative block aspect-[1.12] w-full overflow-hidden rounded-md ${tileColors[index % tileColors.length]}`} aria-label={`View ${product.name}`}>\n230:               <div className=\"h-full w-full transition-transform duration-500 group-hover:scale-[1.045]\"><ProductArt name={product.name} /></div>\n231:               {product.stock === 0 ? <span className=\"absolute top-3 left-3 rounded bg-paper/90 px-2.5 py-1.5 text-[9px] font-medium tracking-wide text-muted\">Out of stock</span> : product.name === \"Everyday ceramic mug\" ? <span className=\"absolute top-3 left-3 rounded bg-paper/85 px-2.5 py-1.5 text-[8px] tracking-[.12em] text-[#6c715d] uppercase\">A daily ritual</span> : null}\n232:               <span className=\"absolute right-3 bottom-3 rounded-full bg-paper/80 p-1.5 opacity-0 transition-opacity group-hover:opacity-100\"><Icon name=\"arrow\" className=\"h-3.5 w-3.5 text-[#7b786b]\" /></span>\n233:             </button>\n234:             <div className=\"mt-4 flex items-end justify-between gap-2\"><div className=\"min-w-0\"><p className=\"mb-1.5 truncate text-[8px] tracking-[.12em] text-muted uppercase sm:text-[9px]\">{categories.includes(category(product)) ? category(product) : \"The collection\"}</p><button onClick={() => { setDetail(product); setDetailError(\"\"); }} className=\"text-left\"><h3 className=\"text-[12px] font-medium leading-snug transition group-hover:text-rust sm:text-[14px]\">{product.name}</h3></button><p className=\"mt-2 text-[12px] text-[#686c61] sm:text-[13px]\">{money(product.price)}</p></div>\n235:               <button onClick={() => void addProduct(product)} disabled={product.stock === 0 || adding !== null || sessionLoading} aria-label={`Add ${product.name} to cart`} title={product.stock === 0 ? \"Out of stock\" : \"Add to cart\"} className=\"mb-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d8d9ce] bg-paper text-[#686e5a] transition hover:border-rust hover:bg-rust hover:text-white disabled:opacity-35 sm:h-9 sm:w-9\"><Icon name={adding === product.id ? \"loader\" : \"plus\"} className={`h-4 w-4 ${adding === product.id ? \"animate-spin\" : \"\"}`} /></button>\n236:             </div>\n237:           </article>)}\n238:         </div> : <div className=\"rounded-lg border border-dashed border-line py-16 text-center\"><Icon name=\"search\" className=\"mx-auto mb-4 h-8 w-8 text-muted/60\" /><h3 className=\"font-serif text-2xl\">Nothing here just yet.</h3><p className=\"mt-3 text-sm text-muted\">Try another search, or explore the full collection.</p><button onClick={() => selectCategory(\"All objects\")} className=\"mt-5 text-sm text-rust underline underline-offset-4\">See all objects</button></div>}\n239: \n240:         {!loading && !catalogueError && products && products.total > 0 && <div className=\"mt-10 flex flex-col items-center justify-between gap-5 border-t border-line pt-6 sm:flex-row\"><p className=\"text-[11px] text-muted\">Showing {(page - 1) * 8 + 1}–{Math.min(page * 8, products.total)} of {products.total} thoughtfully chosen objects</p><nav aria-label=\"Product pagination\" className=\"flex items-center gap-2\"><button aria-label=\"Previous page\" disabled={page === 1} onClick={() => setPage((value) => value - 1)} className=\"mr-1 rounded p-2 text-muted hover:text-rust disabled:opacity-30\"><Icon name=\"chevron-left\" className=\"h-3.5 w-3.5\" /></button>{Array.from({ length: pages }, (_, i) => i + 1).filter((value) => value === 1 || value === pages || Math.abs(value - page) <= 1).map((value, index, visible) => <span key={value} className=\"flex items-center gap-2\">{index > 0 && value - visible[index - 1] > 1 && <span className=\"text-xs text-muted\">…</span>}<button onClick={() => setPage(value)} aria-label={`Page ${value}`} aria-current={page === value ? \"page\" : undefined} className={`h-8 w-8 rounded text-xs transition ${page === value ? \"bg-ink text-white\" : \"hover:bg-line/60\"}`}>{value}</button></span>)}<button aria-label=\"Next page\" disabled={page >= pages} onClick={() => setPage((value) => value + 1)} className=\"ml-1 rounded p-2 text-muted hover:text-rust disabled:opacity-30\"><Icon name=\"chevron-right\" className=\"h-3.5 w-3.5\" /></button></nav></div>}\n241:       </section>\n242:     </main>}\n243: \n244:     <footer className=\"border-t border-[#dfded2] bg-[#eeeee6]\">\n245:       <div className=\"mx-auto max-w-[1280px] px-5 pt-10 pb-5 sm:px-8 lg:px-12\"><div className=\"flex flex-col justify-between gap-7 pb-8 sm:flex-row\"><div><div className=\"mb-4 flex items-center gap-2.5\"><BrandMark className=\"h-5 w-5 text-rust\" /><span className=\"font-serif text-2xl font-semibold tracking-[-1px]\">form <span className=\"font-normal italic\">&</span> field.</span></div><p className=\"max-w-64 text-[12px] leading-[1.8] text-[#777a6c]\">A considered life, one object at a time.<br />For the spaces and rituals you call your own.</p></div><div className=\"flex gap-16 sm:gap-20\"><div><h3 className=\"mb-4 text-[10px] tracking-[.1em] uppercase\">A little exploring</h3><div className=\"flex flex-col items-start gap-3 text-[11px] text-muted\"><button onClick={browse} className=\"hover:text-rust\">The collection</button><button onClick={() => setAboutOpen(true)} className=\"hover:text-rust\">Our philosophy</button></div></div><div><h3 className=\"mb-4 text-[10px] tracking-[.1em] uppercase\">Make yourself at home</h3><div className=\"flex flex-col items-start gap-3 text-[11px] text-muted\"><button onClick={() => user ? setCartOpen(true) : setAuthMode(\"login\")} className=\"hover:text-rust\">{user ? \"Your collection\" : \"Your account\"}</button>{!user && <button onClick={() => setAuthMode(\"register\")} className=\"hover:text-rust\">Join the everyday</button>}{user?.is_admin && <button onClick={() => { setAdminOpen(true); window.scrollTo({ top: 0, behavior: \"smooth\" }); }} className=\"hover:text-rust\">Product workspace</button>}</div></div></div></div><div className=\"flex items-center justify-between gap-4 border-t border-[#dadccf] pt-5 text-[9px] text-[#888b7c]\"><span>© {new Date().getFullYear()} Form & Field</span><span className=\"flex items-center gap-2\"><Icon name=\"leaf\" className=\"h-3 w-3\" />Less, but better.</span></div></div>\n246:     </footer>\n247: \n248:     {authMode && <AuthForm initialMode={authMode} onDismiss={() => { setAuthMode(null); setPendingProduct(null); }} onAuthenticated={authenticated} />}\n249: \n250:     {detail && <Modal title=\"A closer look.\" onDismiss={() => setDetail(null)}><div className=\"overflow-y-auto\"><div className=\"h-[270px] bg-[#eae6dc]\"><ProductArt name={detail.name} /></div><div className=\"space-y-4 p-7\"><p className=\"text-[10px] tracking-[.15em] text-muted uppercase\">{categories.includes(category(detail)) ? category(detail) : \"The collection\"}</p><div className=\"flex items-center justify-between gap-4\"><h3 className=\"font-serif text-[27px]\">{detail.name}</h3><span className=\"text-lg text-rust\">{money(detail.price)}</span></div><p className=\"text-sm leading-relaxed text-muted\">{description(detail)}</p><p className={`text-xs ${detail.stock === 0 ? \"text-rust\" : \"text-[#737e60]\"}`}>{detail.stock === 0 ? \"Out of stock\" : `${detail.stock} available · A little everyday joy`}</p><ErrorMessage message={detailError} /><button disabled={detail.stock === 0 || adding !== null || sessionLoading} onClick={() => void addProduct(detail)} className={`${primaryButton} w-full`}><Icon name={adding === detail.id ? \"loader\" : \"bag\"} className={adding === detail.id ? \"animate-spin\" : \"\"} />{detail.stock === 0 ? \"Out of stock\" : adding === detail.id ? \"Adding…\" : \"Add to your cart\"}</button></div></div></Modal>}\n251: \n252:     {aboutOpen && <Modal title=\"Less, but better.\" onDismiss={() => setAboutOpen(false)}><div className=\"space-y-5 p-7\"><BrandMark className=\"mb-6 h-9 w-9 text-rust\" /><h3 className=\"font-serif text-3xl leading-snug\">Good design belongs<br />in the everyday.</h3><p className=\"text-sm leading-[1.85] text-muted\">We believe the objects you surround yourself with should earn their place. Not by being more, but by meaning more: a mug that makes mornings feel slower, a bowl that brings people together, a notebook that holds a new beginning.</p><p className=\"text-sm leading-[1.85] text-muted\">Form & Field is a small, considered collection for the home and beyond. Useful, beautiful objects in natural textures and quiet colors. A little less noise. A little more joy.</p><button onClick={() => { setAboutOpen(false); browse(); }} className={`${primaryButton} mt-2`}>Find your everyday<Icon name=\"arrow\" className=\"h-4 w-4\" /></button></div></Modal>}\n253: \n254:     {cartOpen && <Modal title={`Your cart${cartCount ? ` (${cartCount})` : \"\"}`} onDismiss={() => setCartOpen(false)} drawer>\n255:       {!user ? <div className=\"flex flex-1 flex-col items-center justify-center px-8 py-12 text-center\"><div className=\"mb-6 rounded-full bg-[#eeeee6] p-5\"><Icon name=\"bag\" className=\"h-8 w-8 text-[#7d846c]\" /></div><h3 className=\"font-serif text-3xl\">A place for your favorites.</h3><p className=\"mt-4 max-w-72 text-sm leading-relaxed text-muted\">Sign in to build your personal cart. We’ll keep it safe for your next visit.</p><ErrorMessage message={cartError} /><button disabled={sessionLoading} onClick={() => { setCartOpen(false); setAuthMode(\"login\"); }} className={`${primaryButton} mt-7 w-full`}>{sessionLoading ? \"Checking your account…\" : \"Sign in to your account\"}<Icon name=\"arrow\" className=\"h-4 w-4\" /></button><button onClick={() => { setCartOpen(false); setAuthMode(\"register\"); }} className=\"mt-5 text-sm text-rust underline underline-offset-4\">Create an account</button></div> : <>\n256:         <div className=\"min-h-0 flex-1 overflow-y-auto px-7 py-6\">\n257:           <p className=\"mb-5 text-xs leading-relaxed text-muted\">A few good things, chosen by {user.username}.</p>\n258:           <ErrorMessage message={cartError} />\n259:           {cartLoading ? <div role=\"status\" className=\"flex items-center justify-center gap-3 py-16 text-sm text-muted\"><Icon name=\"loader\" className=\"animate-spin\" />Gathering your favorites…</div> : cart.items.length ? <div className=\"divide-y divide-line\">{cart.items.map((item) => <article key={item.id} className=\"flex gap-4 py-6\"><div className=\"h-[94px] w-[90px] shrink-0 overflow-hidden rounded-md bg-[#eae6dc]\"><ProductArt name={item.name} /></div><div className=\"min-w-0 flex-1\"><div className=\"flex items-start justify-between gap-3\"><h3 className=\"text-sm font-medium leading-snug\">{item.name}</h3><button disabled={busyItem !== null} onClick={() => void changeItem(item.id)} aria-label={`Remove ${item.name}`} className=\"-mt-1 rounded p-1 text-muted/75 hover:text-rust disabled:opacity-40\"><Icon name=\"close\" className=\"h-4 w-4\" /></button></div><p className=\"mt-1.5 text-xs text-muted\">{money(item.unit_price)} each</p><div className=\"mt-4 flex items-center justify-between gap-3\"><div className=\"flex h-8 items-center rounded border border-line bg-white\"><button disabled={item.quantity <= 1 || busyItem !== null} onClick={() => void changeItem(item.id, item.quantity - 1)} aria-label={`Decrease quantity of ${item.name}`} className=\"px-2.5 py-2 hover:text-rust disabled:opacity-30\"><Icon name=\"minus\" className=\"h-3 w-3\" /></button><span className=\"min-w-7 text-center text-xs\" aria-label={`Quantity ${item.quantity}`}>{busyItem === item.id ? <Icon name=\"loader\" className=\"mx-auto h-3 w-3 animate-spin\" /> : item.quantity}</span><button disabled={busyItem !== null} onClick={() => void changeItem(item.id, item.quantity + 1)} aria-label={`Increase quantity of ${item.name}`} className=\"px-2.5 py-2 hover:text-rust disabled:opacity-30\"><Icon name=\"plus\" className=\"h-3 w-3\" /></button></div><span className=\"text-sm font-medium\">{money(item.line_total)}</span></div></div></article>)}</div> : <div className=\"py-14 text-center\"><Icon name=\"bag\" className=\"mx-auto mb-6 h-10 w-10 text-... (line truncated to 2000 chars)\n260:         </div>\n261:         <div className=\"shrink-0 border-t border-line bg-[#f1f0e9] px-7 py-6\"><div className=\"flex items-center justify-between\"><span className=\"font-serif text-xl\">Subtotal</span><span className=\"text-xl\">{money(cart.subtotal)}</span></div><p className=\"mt-3 text-[11px] leading-relaxed text-muted\">Calculated from current catalogue prices. Items in your cart don’t reserve stock.</p><button onClick={() => { setCartOpen(false); browse(); }} className={`${primaryButton} mt-5 w-full`}>Keep exploring<Icon name=\"arrow\" className=\"h-4 w-4\" /></button><p className=\"mt-3 text-center text-[10px] text-muted\">A considered collection. No rush.</p></div>\n262:       </>}\n263:     </Modal>}\n264: \n265:     {toast && <div role={toast.error ? \"alert\" : \"status\"} className={`fixed right-5 bottom-5 left-5 z-50 flex items-center gap-3 rounded-lg border px-5 py-4 text-sm shadow-lg sm:left-auto sm:max-w-md ${toast.error ? \"border-rust/25 bg-[#fbefe9] text-rust-dark\" : \"border-[#d5deca] bg-[#f0f3eb] text-[#52633e]\"}`}><Icon name={toast.error ? \"close\" : \"check\"} className=\"h-4 w-4 shrink-0\" /><span>{toast.message}</span><button onClick={() => setToast(null)} aria-label=\"Dismiss notification\" className=\"ml-2 rounded p-1 opacity-60 hover:opacity-100\"><Icon name=\"close\" className=\"h-3.5 w-3.5\" /></button></div>}\n266:   </>;\n267: }\n\n(End of file - total 267 lines)\n</content>","metadata":{"preview":"import { useCallback, useEffect, useRef, useState } from \"react\";\nimport { Admin } from \"./Admin\";\nimport { api, ApiError, category, description, money } from \"./api\";\nimport type { Cart, Product, ProductPage, User } from \"./api\";\nimport { AuthForm, primaryButton } from \"./AuthForm\";\nimport { BrandMark, Icon } from \"./Icons\";\nimport { ErrorMessage, Modal } from \"./Modal\";\nimport { HeroArt, ProductArt } from \"./ProductArt\";\n\nconst categories = [\"All objects\", \"Home & living\", \"Kitchen & dining\", \"Everyday essentials\"];\nconst tileColors = [\"bg-[#eee9e0]\", \"bg-[#eae7df]\", \"bg-[#e9e9df]\", \"bg-[#eee9e2]\", \"bg-[#ebe7dd]\", \"bg-[#e8e5dc]\", \"bg-[#ebe3d7]\", \"bg-[#efe6df]\"];\nconst emptyCart: Cart = { items: [], subtotal: 0 };\n\nfunction storedToken() {\n  try { return localStorage.getItem(\"form-field-token\"); } catch { return null; }\n}\n\nfunction saveToken(token: string | null) {\n  try {\n    if (token) localStorage.setItem(\"form-field-token\", token);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"import { useCallback, useEffect, useRef, useState } from \"react\";\nimport { Admin } from \"./Admin\";\nimport { api, ApiError, category, description, money } from \"./api\";\nimport type { Cart, Product, ProductPage, User } from \"./api\";\nimport { AuthForm, primaryButton } from \"./AuthForm\";\nimport { BrandMark, Icon } from \"./Icons\";\nimport { ErrorMessage, Modal } from \"./Modal\";\nimport { HeroArt, ProductArt } from \"./ProductArt\";\n\nconst categories = [\"All objects\", \"Home & living\", \"Kitchen & dining\", \"Everyday essentials\"];\nconst tileColors = [\"bg-[#eee9e0]\", \"bg-[#eae7df]\", \"bg-[#e9e9df]\", \"bg-[#eee9e2]\", \"bg-[#ebe7dd]\", \"bg-[#e8e5dc]\", \"bg-[#ebe3d7]\", \"bg-[#efe6df]\"];\nconst emptyCart: Cart = { items: [], subtotal: 0 };\n\nfunction storedToken() {\n  try { return localStorage.getItem(\"form-field-token\"); } catch { return null; }\n}\n\nfunction saveToken(token: string | null) {\n  try {\n    if (token) localStorage.setItem(\"form-field-token\", token);\n    else localStorage.removeItem(\"form-field-token\");\n  } catch { return; }\n}\n\nexport default function App() {\n  const [token, setToken] = useState<string | null>(storedToken);\n  const [user, setUser] = useState<User | null>(null);\n  const [sessionLoading, setSessionLoading] = useState(Boolean(token));\n  const [products, setProducts] = useState<ProductPage | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [catalogueError, setCatalogueError] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [query, setQuery] = useState(\"\");\n  const [selectedCategory, setSelectedCategory] = useState(\"All objects\");\n  const [page, setPage] = useState(1);\n  const [version, setVersion] = useState(0);\n  const [cart, setCart] = useState<Cart>(emptyCart);\n  const [cartOpen, setCartOpen] = useState(false);\n  const [cartLoading, setCartLoading] = useState(false);\n  const [cartError, setCartError] = useState(\"\");\n  const [busyItem, setBusyItem] = useState<number | null>(null);\n  const [adding, setAdding] = useState<number | null>(null);\n  const [authMode, setAuthMode] = useState<\"login\" | \"register\" | null>(null);\n  const [pendingProduct, setPendingProduct] = useState<Product | null>(null);\n  const [detail, setDetail] = useState<Product | null>(null);\n  const [detailError, setDetailError] = useState(\"\");\n  const [aboutOpen, setAboutOpen] = useState(false);\n  const [adminOpen, setAdminOpen] = useState(false);\n  const [toast, setToast] = useState<{ message: string; error?: boolean } | null>(null);\n  const collectionRef = useRef<HTMLElement>(null);\n  const cartMutation = useRef(false);\n\n  const resetSession = useCallback(() => {\n    setToken(null); saveToken(null); setUser(null); setCart(emptyCart); setAdminOpen(false);\n  }, []);\n\n  const refreshCart = useCallback(async (currentToken: string) => {\n    const next = await api<Cart>(\"/cart\", {}, currentToken);\n    setCart(next);\n    return next;\n  }, []);\n\n  useEffect(() => {\n    if (!token) { setSessionLoading(false); return; }\n    let ignore = false;\n    setSessionLoading(true);\n    api<User>(\"/auth/me\", {}, token).then(async (data) => {\n      if (ignore) return;\n      setUser(data);\n      const nextCart = await api<Cart>(\"/cart\", {}, token);\n      if (!ignore) setCart(nextCart);\n    }).catch((caught: Error) => {\n      if (ignore) return;\n      if (caught instanceof ApiError && caught.status === 401) resetSession();\n      else setToast({ message: caught.message, error: true });\n    }).finally(() => { if (!ignore) setSessionLoading(false); });\n    return () => { ignore = true; };\n  }, [token, resetSession]);\n\n  useEffect(() => {\n    const timer = window.setTimeout(() => { setQuery(search.trim()); setPage(1); }, 250);\n    return () => window.clearTimeout(timer);\n  }, [search]);\n\n  useEffect(() => {\n    const controller = new AbortController();\n    setLoading(true);\n    setCatalogueError(\"\");\n    const q = query || (selectedCategory === \"All objects\" ? \"\" : selectedCategory);\n    api<ProductPage>(`/products?${new URLSearchParams({ q, page: String(page), page_size: \"8\" })}`, { signal: controller.signal }).then((data) => {\n      if (!controller.signal.aborted) setProducts(data);\n    }).catch((caught: Error) => {\n      if (!controller.signal.aborted) setCatalogueError(caught.message);\n    }).finally(() => { if (!controller.signal.aborted) setLoading(false); });\n    return () => controller.abort();\n  }, [query, selectedCategory, page, version]);\n\n  useEffect(() => {\n    if (!toast) return;\n    const timer = window.setTimeout(() => setToast(null), 4500);\n    return () => window.clearTimeout(timer);\n  }, [toast]);\n\n  useEffect(() => {\n    if (!token || !user || !cartOpen) return;\n    let ignore = false;\n    setCartLoading(true);\n    setCartError(\"\");\n    api<Cart>(\"/cart\", {}, token).then((data) => { if (!ignore) setCart(data); }).catch((caught: Error) => {\n      if (!ignore) setCartError(caught.message);\n    }).finally(() => { if (!ignore) setCartLoading(false); });\n    return () => { ignore = true; };\n  }, [token, user, cartOpen, version]);\n\n  async function addProduct(product: Product, currentToken = token) {\n    if (!currentToken) {\n      setPendingProduct(product); setDetail(null); setAuthMode(\"login\");\n      return;\n    }\n    if (cartMutation.current) return;\n    cartMutation.current = true;\n    setAdding(product.id);\n    setDetailError(\"\");\n    try {\n      await api(\"/cart\", { method: \"POST\", body: JSON.stringify({ product_id: product.id, quantity: 1 }) }, currentToken);\n      await refreshCart(currentToken);\n      setDetail(null);\n      setToast({ message: `${product.name} added to your cart.` });\n    } catch (caught) {\n      const message = caught instanceof Error ? caught.message : \"Couldn’t add this object.\";\n      setToast({ message, error: true });\n      setDetailError(message);\n      if (caught instanceof ApiError && caught.status === 401) { resetSession(); setPendingProduct(product); setDetail(null); setAuthMode(\"login\"); }\n    } finally {\n      setAdding(null);\n      cartMutation.current = false;\n    }\n  }\n\n  async function changeItem(id: number, quantity?: number) {\n    if (!token || cartMutation.current) return;\n    cartMutation.current = true;\n    setBusyItem(id); setCartError(\"\");\n    try {\n      await api(`/cart/${id}`, { method: quantity === undefined ? \"DELETE\" : \"PATCH\", ...(quantity !== undefined ? { body: JSON.stringify({ quantity }) } : {}) }, token);\n      await refreshCart(token);\n    } catch (caught) {\n      setCartError(caught instanceof Error ? caught.message : \"Couldn’t update your cart.\");\n      if (caught instanceof ApiError && caught.status === 401) resetSession();\n    } finally {\n      setBusyItem(null); cartMutation.current = false;\n    }\n  }\n\n  async function signOut() {\n    if (!token) return;\n    try {\n      await api(\"/auth/logout\", { method: \"POST\" }, token);\n      resetSession(); setCartOpen(false); setToast({ message: \"You’re signed out. Your cart is saved for next time.\" });\n    } catch (caught) {\n      if (caught instanceof ApiError && caught.status === 401) resetSession();\n      else setToast({ message: caught instanceof Error ? caught.message : \"Couldn’t sign out. Please try again.\", error: true });\n    }\n  }\n\n  function authenticated(nextToken: string, nextUser: User) {\n    saveToken(nextToken); setToken(nextToken); setUser(nextUser); setAuthMode(null);\n    if (pendingProduct) { void addProduct(pendingProduct, nextToken); setPendingProduct(null); }\n    else setToast({ message: `Welcome ${nextUser.username}. Make yourself at home.` });\n  }\n\n  function selectCategory(value: string) {\n    setSelectedCategory(value); setSearch(\"\"); setQuery(\"\"); setPage(1);\n  }\n\n  function browse() {\n    setAdminOpen(false);\n    window.setTimeout(() => collectionRef.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" }), 10);\n  }\n\n  function catalogueUpdated() {\n    setVersion((value) => value + 1);\n    if (token) void refreshCart(token).catch((caught: Error) => setToast({ message: caught.message, error: true }));\n  }\n\n  const cartCount = cart.items.reduce((count, item) => count + item.quantity, 0);\n  const pages = Math.max(1, Math.ceil((products?.total ?? 0) / 8));\n\n  return <>\n    <div className=\"flex h-8 items-center justify-center bg-[#eeeee6] px-4 text-center text-[10px] tracking-[.09em] text-[#656b58] sm:text-[11px]\"><span>Thoughtfully chosen. Made for the everyday.</span><span className=\"mx-3 h-1 w-1 rounded-full bg-[#a8ad98]\" /><span>Good things, simply.</span></div>\n    <header className=\"border-b border-line bg-paper\">\n      <div className=\"mx-auto flex h-[88px] max-w-[1280px] items-center justify-between gap-4 px-5 sm:px-8 lg:px-12\">\n        <a href=\"#\" onClick={(event) => { event.preventDefault(); setAdminOpen(false); window.scrollTo({ top: 0, behavior: \"smooth\" }); }} aria-label=\"Form and Field home\" className=\"flex shrink-0 items-center gap-2.5 sm:gap-3\"><BrandMark className=\"h-6 w-6 text-rust sm:h-7 sm:w-7\" /><span className=\"font-serif text-[25px] font-semibold tracking-[-1.3px] sm:text-[29px]\">form <span className=\"font-normal italic\">&</span> field<span className=\"text-rust\">.</span></span></a>\n        <nav aria-label=\"Main navigation\" className=\"ml-8 hidden items-center gap-8 text-[13px] md:flex\"><button onClick={browse} className={`relative py-2 transition hover:text-rust ${!adminOpen ? \"text-rust after:absolute after:inset-x-0 after:-bottom-[22px] after:h-[2px] after:bg-rust\" : \"text-muted\"}`}>The shop</button><button onClick={() => setAboutOpen(true)} className=\"text-muted transition hover:text-rust\">Our philosophy</button>{user?.is_admin && <button onClick={() => setAdminOpen(true)} className={`flex items-center gap-2 transition hover:text-rust ${adminOpen ? \"text-rust\" : \"text-muted\"}`}><Icon name=\"settings\" className=\"h-4 w-4\" />Manage products</button>}</nav>\n        <div className=\"flex items-center gap-3 sm:gap-6\">\n          {user ? <div className=\"flex items-center gap-3\"><span className=\"max-w-24 truncate text-xs sm:max-w-32 sm:text-sm\" title={user.username}>{user.username}</span><button onClick={() => void signOut()} aria-label=\"Sign out\" title=\"Sign out\" className=\"rounded p-1.5 text-muted hover:text-rust\"><Icon name=\"logout\" className=\"h-[18px] w-[18px]\" /></button></div> : <button onClick={() => setAuthMode(\"login\")} disabled={sessionLoading} className=\"flex items-center gap-2 rounded py-2 text-[13px] transition hover:text-rust\"><Icon name=\"user\" className=\"h-[18px] w-[18px]\" /><span className=\"hidden sm:inline\">{sessionLoading ? \"Signing in…\" : \"Sign in\"}</span><span className=\"sr-only sm:hidden\">Sign in</span></button>}\n          <div className=\"h-5 w-px bg-line\" />\n          <button onClick={() => setCartOpen(true)} aria-label={`Open cart, ${cartCount} ${cartCount === 1 ? \"item\" : \"items\"}`} className=\"flex items-center gap-2 rounded py-2 transition hover:text-rust\"><Icon name=\"bag\" className=\"h-5 w-5\" /><span className=\"hidden text-[13px] lg:inline\">Cart</span><span className=\"flex h-5 min-w-5 items-center justify-center rounded-full bg-rust px-1 text-[10px] font-medium text-white\">{cartCount}</span></button>\n        </div>\n      </div>\n      {user?.is_admin && <div className=\"border-t border-line px-5 py-2 md:hidden\"><button onClick={() => setAdminOpen(!adminOpen)} className=\"flex items-center gap-2 text-xs text-rust\"><Icon name=\"settings\" className=\"h-4 w-4\" />{adminOpen ? \"Return to shop\" : \"Manage products\"}</button></div>}\n    </header>\n\n    {adminOpen && user?.is_admin && token ? <Admin token={token} onChange={catalogueUpdated} onBack={() => setAdminOpen(false)} /> : <main className=\"mx-auto max-w-[1280px] px-5 sm:px-8 lg:px-12\">\n      <section className=\"relative mt-7 grid overflow-hidden rounded-lg bg-[#eae3d6] md:mt-8 md:min-h-[370px] md:grid-cols-[1fr_1.02fr]\" aria-labelledby=\"hero-title\">\n        <div className=\"relative z-10 px-7 pt-9 pb-7 sm:px-11 sm:pt-11 md:py-12 lg:px-12\">\n          <div className=\"mb-5 flex items-center gap-2.5 text-[10px] font-medium tracking-[.19em] text-[#756b54] uppercase\"><span className=\"h-px w-6 bg-[#a6977f]\" />The everyday, considered</div>\n          <h1 id=\"hero-title\" className=\"font-serif text-[44px] leading-[1.09] tracking-[-1.7px] sm:text-[52px] lg:text-[58px]\">Good things.<br />For everyday living.</h1>\n          <p className=\"mt-5 max-w-[315px] text-[13px] leading-[1.85] text-[#737061]\">A collection of simple, beautiful objects.<br className=\"hidden sm:block\" /> Chosen with care. Made to feel like home.</p>\n          <button onClick={browse} className={`${primaryButton} mt-7 gap-6! px-5! text-[12px]!`}>Explore the collection<Icon name=\"arrow\" className=\"h-4 w-4\" /></button>\n        </div>\n        <div className=\"relative -mt-12 h-[285px] sm:h-[330px] md:mt-0 md:h-full\"><HeroArt /></div>\n        <div className=\"absolute top-6 right-6 hidden text-[9px] tracking-[.17em] text-[#8c806b] uppercase sm:block\">The slow living edit / No. 01</div>\n      </section>\n\n      <section aria-label=\"Our values\" className=\"grid grid-cols-3 gap-2 border-b border-line py-6 sm:py-7\">\n        {([{ icon: \"leaf\", title: \"Thoughtfully chosen\", text: \"Fewer things. Better things.\" }, { icon: \"heart\", title: \"Everyday, elevated\", text: \"Small joys, lasting favorites.\" }, { icon: \"box\", title: \"Made to be kept\", text: \"Good design never gets old.\" }] as const).map((value, index) => <div key={value.title} className={`flex flex-col items-center justify-center gap-2 text-center sm:flex-row sm:gap-3.5 sm:text-left ${index !== 2 ? \"border-r border-line\" : \"\"}`}><Icon name={value.icon} className=\"h-[21px] w-[21px] shrink-0 text-[#788268]\" /><div><p className=\"text-[10px] font-medium sm:text-[12px]\">{value.title}</p><p className=\"mt-1 hidden text-[11px] text-muted sm:block\">{value.text}</p></div></div>)}\n      </section>\n\n      <section ref={collectionRef} id=\"collection\" className=\"scroll-mt-6 pt-10 pb-14 sm:pt-12 sm:pb-16\" aria-labelledby=\"collection-title\">\n        <div className=\"mb-7 flex flex-wrap items-end justify-between gap-4\"><div><p className=\"mb-2.5 text-[9px] font-medium tracking-[.2em] text-rust uppercase\">Little things. Lasting favorites.</p><h2 id=\"collection-title\" className=\"font-serif text-[30px] leading-tight tracking-[-.65px] sm:text-[34px]\">Meet your new everyday.</h2><p className=\"mt-2.5 text-[12px] leading-relaxed text-muted\">Useful, beautiful, and a little bit special. Just like the everyday should be.</p></div><span className=\"mb-1 hidden text-[11px] text-muted lg:block\">A considered collection, not an endless catalogue.</span></div>\n        <div className=\"mb-7 flex flex-col justify-between gap-5 lg:flex-row lg:items-center\">\n          <div className=\"-mx-1 flex gap-1 overflow-x-auto p-1\" role=\"group\" aria-label=\"Product categories\">{categories.map((label) => <button key={label} aria-pressed={selectedCategory === label} onClick={() => selectCategory(label)} className={`shrink-0 rounded-md px-3.5 py-2.5 text-[11px] transition sm:px-4 ${selectedCategory === label ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50 hover:text-ink\"}`}>{label}</button>)}</div>\n          <div className=\"relative w-full lg:w-[240px]\"><Icon name=\"search\" className=\"pointer-events-none absolute top-3 left-3.5 h-4 w-4 text-muted\" /><input type=\"search\" aria-label=\"Search products\" placeholder=\"Find something good…\" value={search} onChange={(event) => { setSearch(event.target.value); if (event.target.value) setSelectedCategory(\"All objects\"); }} className=\"h-[40px] w-full rounded-md border border-line bg-white py-2 pr-4 pl-10 text-[11px] placeholder:text-muted/75 focus:border-rust focus:ring-offset-0\" /></div>\n        </div>\n\n        {catalogueError ? <div className=\"rounded-lg border border-line p-7\"><ErrorMessage message={catalogueError} /><button onClick={() => setVersion((value) => value + 1)} className={`${primaryButton} mt-4`}>Try again</button></div> : loading ? <div aria-label=\"Loading products\" role=\"status\" className=\"grid grid-cols-2 gap-x-5 gap-y-8 lg:grid-cols-4 lg:gap-x-6\">{Array.from({ length: 8 }, (_, i) => <div key={i} className=\"animate-pulse\"><div className=\"aspect-[1.12] rounded-md bg-line/70\" /><div className=\"mt-4 h-2 w-20 rounded bg-line\" /><div className=\"mt-3 h-4 w-3/4 rounded bg-line\" /><div className=\"mt-3 h-3 w-12 rounded bg-line\" /></div>)}</div> : products?.items.length ? <div className=\"grid grid-cols-2 gap-x-5 gap-y-8 sm:gap-y-9 lg:grid-cols-4 lg:gap-x-6\">\n          {products.items.map((product, index) => <article key={product.id} className=\"group min-w-0\">\n            <button onClick={() => { setDetail(product); setDetailError(\"\"); }} className={`relative block aspect-[1.12] w-full overflow-hidden rounded-md ${tileColors[index % tileColors.length]}`} aria-label={`View ${product.name}`}>\n              <div className=\"h-full w-full transition-transform duration-500 group-hover:scale-[1.045]\"><ProductArt name={product.name} /></div>\n              {product.stock === 0 ? <span className=\"absolute top-3 left-3 rounded bg-paper/90 px-2.5 py-1.5 text-[9px] font-medium tracking-wide text-muted\">Out of stock</span> : product.name === \"Everyday ceramic mug\" ? <span className=\"absolute top-3 left-3 rounded bg-paper/85 px-2.5 py-1.5 text-[8px] tracking-[.12em] text-[#6c715d] uppercase\">A daily ritual</span> : null}\n              <span className=\"absolute right-3 bottom-3 rounded-full bg-paper/80 p-1.5 opacity-0 transition-opacity group-hover:opacity-100\"><Icon name=\"arrow\" className=\"h-3.5 w-3.5 text-[#7b786b]\" /></span>\n            </button>\n            <div className=\"mt-4 flex items-end justify-between gap-2\"><div className=\"min-w-0\"><p className=\"mb-1.5 truncate text-[8px] tracking-[.12em] text-muted uppercase sm:text-[9px]\">{categories.includes(category(product)) ? category(product) : \"The collection\"}</p><button onClick={() => { setDetail(product); setDetailError(\"\"); }} className=\"text-left\"><h3 className=\"text-[12px] font-medium leading-snug transition group-hover:text-rust sm:text-[14px]\">{product.name}</h3></button><p className=\"mt-2 text-[12px] text-[#686c61] sm:text-[13px]\">{money(product.price)}</p></div>\n              <button onClick={() => void addProduct(product)} disabled={product.stock === 0 || adding !== null || sessionLoading} aria-label={`Add ${product.name} to cart`} title={product.stock === 0 ? \"Out of stock\" : \"Add to cart\"} className=\"mb-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d8d9ce] bg-paper text-[#686e5a] transition hover:border-rust hover:bg-rust hover:text-white disabled:opacity-35 sm:h-9 sm:w-9\"><Icon name={adding === product.id ? \"loader\" : \"plus\"} className={`h-4 w-4 ${adding === product.id ? \"animate-spin\" : \"\"}`} /></button>\n            </div>\n          </article>)}\n        </div> : <div className=\"rounded-lg border border-dashed border-line py-16 text-center\"><Icon name=\"search\" className=\"mx-auto mb-4 h-8 w-8 text-muted/60\" /><h3 className=\"font-serif text-2xl\">Nothing here just yet.</h3><p className=\"mt-3 text-sm text-muted\">Try another search, or explore the full collection.</p><button onClick={() => selectCategory(\"All objects\")} className=\"mt-5 text-sm text-rust underline underline-offset-4\">See all objects</button></div>}\n\n        {!loading && !catalogueError && products && products.total > 0 && <div className=\"mt-10 flex flex-col items-center justify-between gap-5 border-t border-line pt-6 sm:flex-row\"><p className=\"text-[11px] text-muted\">Showing {(page - 1) * 8 + 1}–{Math.min(page * 8, products.total)} of {products.total} thoughtfully chosen objects</p><nav aria-label=\"Product pagination\" className=\"flex items-center gap-2\"><button aria-label=\"Previous page\" disabled={page === 1} onClick={() => setPage((value) => value - 1)} className=\"mr-1 rounded p-2 text-muted hover:text-rust disabled:opacity-30\"><Icon name=\"chevron-left\" className=\"h-3.5 w-3.5\" /></button>{Array.from({ length: pages }, (_, i) => i + 1).filter((value) => value === 1 || value === pages || Math.abs(value - page) <= 1).map((value, index, visible) => <span key={value} className=\"flex items-center gap-2\">{index > 0 && value - visible[index - 1] > 1 && <span className=\"text-xs text-muted\">…</span>}<button onClick={() => setPage(value)} aria-label={`Page ${value}`} aria-current={page === value ? \"page\" : undefined} className={`h-8 w-8 rounded text-xs transition ${page === value ? \"bg-ink text-white\" : \"hover:bg-line/60\"}`}>{value}</button></span>)}<button aria-label=\"Next page\" disabled={page >= pages} onClick={() => setPage((value) => value + 1)} className=\"ml-1 rounded p-2 text-muted hover:text-rust disabled:opacity-30\"><Icon name=\"chevron-right\" className=\"h-3.5 w-3.5\" /></button></nav></div>}\n      </section>\n    </main>}\n\n    <footer className=\"border-t border-[#dfded2] bg-[#eeeee6]\">\n      <div className=\"mx-auto max-w-[1280px] px-5 pt-10 pb-5 sm:px-8 lg:px-12\"><div className=\"flex flex-col justify-between gap-7 pb-8 sm:flex-row\"><div><div className=\"mb-4 flex items-center gap-2.5\"><BrandMark className=\"h-5 w-5 text-rust\" /><span className=\"font-serif text-2xl font-semibold tracking-[-1px]\">form <span className=\"font-normal italic\">&</span> field.</span></div><p className=\"max-w-64 text-[12px] leading-[1.8] text-[#777a6c]\">A considered life, one object at a time.<br />For the spaces and rituals you call your own.</p></div><div className=\"flex gap-16 sm:gap-20\"><div><h3 className=\"mb-4 text-[10px] tracking-[.1em] uppercase\">A little exploring</h3><div className=\"flex flex-col items-start gap-3 text-[11px] text-muted\"><button onClick={browse} className=\"hover:text-rust\">The collection</button><button onClick={() => setAboutOpen(true)} className=\"hover:text-rust\">Our philosophy</button></div></div><div><h3 className=\"mb-4 text-[10px] tracking-[.1em] uppercase\">Make yourself at home</h3><div className=\"flex flex-col items-start gap-3 text-[11px] text-muted\"><button onClick={() => user ? setCartOpen(true) : setAuthMode(\"login\")} className=\"hover:text-rust\">{user ? \"Your collection\" : \"Your account\"}</button>{!user && <button onClick={() => setAuthMode(\"register\")} className=\"hover:text-rust\">Join the everyday</button>}{user?.is_admin && <button onClick={() => { setAdminOpen(true); window.scrollTo({ top: 0, behavior: \"smooth\" }); }} className=\"hover:text-rust\">Product workspace</button>}</div></div></div></div><div className=\"flex items-center justify-between gap-4 border-t border-[#dadccf] pt-5 text-[9px] text-[#888b7c]\"><span>© {new Date().getFullYear()} Form & Field</span><span className=\"flex items-center gap-2\"><Icon name=\"leaf\" className=\"h-3 w-3\" />Less, but better.</span></div></div>\n    </footer>\n\n    {authMode && <AuthForm initialMode={authMode} onDismiss={() => { setAuthMode(null); setPendingProduct(null); }} onAuthenticated={authenticated} />}\n\n    {detail && <Modal title=\"A closer look.\" onDismiss={() => setDetail(null)}><div className=\"overflow-y-auto\"><div className=\"h-[270px] bg-[#eae6dc]\"><ProductArt name={detail.name} /></div><div className=\"space-y-4 p-7\"><p className=\"text-[10px] tracking-[.15em] text-muted uppercase\">{categories.includes(category(detail)) ? category(detail) : \"The collection\"}</p><div className=\"flex items-center justify-between gap-4\"><h3 className=\"font-serif text-[27px]\">{detail.name}</h3><span className=\"text-lg text-rust\">{money(detail.price)}</span></div><p className=\"text-sm leading-relaxed text-muted\">{description(detail)}</p><p className={`text-xs ${detail.stock === 0 ? \"text-rust\" : \"text-[#737e60]\"}`}>{detail.stock === 0 ? \"Out of stock\" : `${detail.stock} available · A little everyday joy`}</p><ErrorMessage message={detailError} /><button disabled={detail.stock === 0 || adding !== null || sessionLoading} onClick={() => void addProduct(detail)} className={`${primaryButton} w-full`}><Icon name={adding === detail.id ? \"loader\" : \"bag\"} className={adding === detail.id ? \"animate-spin\" : \"\"} />{detail.stock === 0 ? \"Out of stock\" : adding === detail.id ? \"Adding…\" : \"Add to your cart\"}</button></div></div></Modal>}\n\n    {aboutOpen && <Modal title=\"Less, but better.\" onDismiss={() => setAboutOpen(false)}><div className=\"space-y-5 p-7\"><BrandMark className=\"mb-6 h-9 w-9 text-rust\" /><h3 className=\"font-serif text-3xl leading-snug\">Good design belongs<br />in the everyday.</h3><p className=\"text-sm leading-[1.85] text-muted\">We believe the objects you surround yourself with should earn their place. Not by being more, but by meaning more: a mug that makes mornings feel slower, a bowl that brings people together, a notebook that holds a new beginning.</p><p className=\"text-sm leading-[1.85] text-muted\">Form & Field is a small, considered collection for the home and beyond. Useful, beautiful objects in natural textures and quiet colors. A little less noise. A little more joy.</p><button onClick={() => { setAboutOpen(false); browse(); }} className={`${primaryButton} mt-2`}>Find your everyday<Icon name=\"arrow\" className=\"h-4 w-4\" /></button></div></Modal>}\n\n    {cartOpen && <Modal title={`Your cart${cartCount ? ` (${cartCount})` : \"\"}`} onDismiss={() => setCartOpen(false)} drawer>\n      {!user ? <div className=\"flex flex-1 flex-col items-center justify-center px-8 py-12 text-center\"><div className=\"mb-6 rounded-full bg-[#eeeee6] p-5\"><Icon name=\"bag\" className=\"h-8 w-8 text-[#7d846c]\" /></div><h3 className=\"font-serif text-3xl\">A place for your favorites.</h3><p className=\"mt-4 max-w-72 text-sm leading-relaxed text-muted\">Sign in to build your personal cart. We’ll keep it safe for your next visit.</p><ErrorMessage message={cartError} /><button disabled={sessionLoading} onClick={() => { setCartOpen(false); setAuthMode(\"login\"); }} className={`${primaryButton} mt-7 w-full`}>{sessionLoading ? \"Checking your account…\" : \"Sign in to your account\"}<Icon name=\"arrow\" className=\"h-4 w-4\" /></button><button onClick={() => { setCartOpen(false); setAuthMode(\"register\"); }} className=\"mt-5 text-sm text-rust underline underline-offset-4\">Create an account</button></div> : <>\n        <div className=\"min-h-0 flex-1 overflow-y-auto px-7 py-6\">\n          <p className=\"mb-5 text-xs leading-relaxed text-muted\">A few good things, chosen by {user.username}.</p>\n          <ErrorMessage message={cartError} />\n          {cartLoading ? <div role=\"status\" className=\"flex items-center justify-center gap-3 py-16 text-sm text-muted\"><Icon name=\"loader\" className=\"animate-spin\" />Gathering your favorites…</div> : cart.items.length ? <div className=\"divide-y divide-line\">{cart.items.map((item) => <article key={item.id} className=\"flex gap-4 py-6\"><div className=\"h-[94px] w-[90px] shrink-0 overflow-hidden rounded-md bg-[#eae6dc]\"><ProductArt name={item.name} /></div><div className=\"min-w-0 flex-1\"><div className=\"flex items-start justify-between gap-3\"><h3 className=\"text-sm font-medium leading-snug\">{item.name}</h3><button disabled={busyItem !== null} onClick={() => void changeItem(item.id)} aria-label={`Remove ${item.name}`} className=\"-mt-1 rounded p-1 text-muted/75 hover:text-rust disabled:opacity-40\"><Icon name=\"close\" className=\"h-4 w-4\" /></button></div><p className=\"mt-1.5 text-xs text-muted\">{money(item.unit_price)} each</p><div className=\"mt-4 flex items-center justify-between gap-3\"><div className=\"flex h-8 items-center rounded border border-line bg-white\"><button disabled={item.quantity <= 1 || busyItem !== null} onClick={() => void changeItem(item.id, item.quantity - 1)} aria-label={`Decrease quantity of ${item.name}`} className=\"px-2.5 py-2 hover:text-rust disabled:opacity-30\"><Icon name=\"minus\" className=\"h-3 w-3\" /></button><span className=\"min-w-7 text-center text-xs\" aria-label={`Quantity ${item.quantity}`}>{busyItem === item.id ? <Icon name=\"loader\" className=\"mx-auto h-3 w-3 animate-spin\" /> : item.quantity}</span><button disabled={busyItem !== null} onClick={() => void changeItem(item.id, item.quantity + 1)} aria-label={`Increase quantity of ${item.name}`} className=\"px-2.5 py-2 hover:text-rust disabled:opacity-30\"><Icon name=\"plus\" className=\"h-3 w-3\" /></button></div><span className=\"text-sm font-medium\">{money(item.line_total)}</span></div></div></article>)}</div> : <div className=\"py-14 text-center\"><Icon name=\"bag\" className=\"mx-auto mb-6 h-10 w-10 text-... (line truncated to 2000 chars)\n        </div>\n        <div className=\"shrink-0 border-t border-line bg-[#f1f0e9] px-7 py-6\"><div className=\"flex items-center justify-between\"><span className=\"font-serif text-xl\">Subtotal</span><span className=\"text-xl\">{money(cart.subtotal)}</span></div><p className=\"mt-3 text-[11px] leading-relaxed text-muted\">Calculated from current catalogue prices. Items in your cart don’t reserve stock.</p><button onClick={() => { setCartOpen(false); browse(); }} className={`${primaryButton} mt-5 w-full`}>Keep exploring<Icon name=\"arrow\" className=\"h-4 w-4\" /></button><p className=\"mt-3 text-center text-[10px] text-muted\">A considered collection. No rush.</p></div>\n      </>}\n    </Modal>}\n\n    {toast && <div role={toast.error ? \"alert\" : \"status\"} className={`fixed right-5 bottom-5 left-5 z-50 flex items-center gap-3 rounded-lg border px-5 py-4 text-sm shadow-lg sm:left-auto sm:max-w-md ${toast.error ? \"border-rust/25 bg-[#fbefe9] text-rust-dark\" : \"border-[#d5deca] bg-[#f0f3eb] text-[#52633e]\"}`}><Icon name={toast.error ? \"close\" : \"check\"} className=\"h-4 w-4 shrink-0\" /><span>{toast.message}</span><button onClick={() => setToast(null)} aria-label=\"Dismiss notification\" className=\"ml-2 rounded p-1 opacity-60 hover:opacity-100\"><Icon name=\"close\" className=\"h-3.5 w-3.5\" /></button></div>}\n  </>;\n}","lineStart":1,"lineEnd":267,"totalLines":267,"truncated":false}},"title":"frontend/src/App.tsx","time":{"start":1794314848263,"end":1794314848432}},"id":"prt_1c57fc800001rSdENKzYAa0pEz","sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","messageID":"msg_1c57fafb1001CyzdI6P8tt9F8l"}}
{"type":"tool_use","timestamp":1794314848449,"sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","part":{"type":"tool","tool":"read","callID":"call_JKWQFUAWTyM1JWs3bEqd3cpk","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts"},"output":"<path>/workspace/frontend/src/api.ts</path>\n<type>file</type>\n<content>\n1: export type Product = {\n2:   id: number;\n3:   name: string;\n4:   description: string;\n5:   price: number;\n6:   stock: number;\n7:   is_active: boolean;\n8: };\n9: \n10: export type ProductPage = { items: Product[]; total: number; page: number; page_size: number };\n11: export type CartItem = { id: number; product_id: number; quantity: number; name: string; unit_price: number; line_total: number };\n12: export type Cart = { items: CartItem[]; subtotal: number };\n13: export type User = { id: number; username: string; is_admin: boolean };\n14: \n15: export class ApiError extends Error {\n16:   status: number;\n17:   constructor(message: string, status: number) {\n18:     super(message);\n19:     this.status = status;\n20:   }\n21: }\n22: \n23: export async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {\n24:   const headers = new Headers(options.headers);\n25:   if (options.body) headers.set(\"Content-Type\", \"application/json\");\n26:   if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n27:   let response: Response;\n28:   try {\n29:     response = await fetch(`/api${path}`, { ...options, headers });\n30:   } catch {\n31:     throw new ApiError(\"We couldn’t connect to the shop. Please try again.\", 0);\n32:   }\n33:   if (response.status === 204) return undefined as T;\n34:   const data = await response.json().catch(() => null);\n35:   if (!response.ok) throw new ApiError(data?.message || \"Something went wrong. Please try again.\", response.status);\n36:   return data as T;\n37: }\n38: \n39: export const money = (amount: number) => new Intl.NumberFormat(\"en-US\", { style: \"currency\", currency: \"USD\" }).format(amount);\n40: export const category = (product: Pick<Product, \"description\">) => product.description.split(\" · \")[0] || \"Everyday essentials\";\n41: export const description = (product: Pick<Product, \"description\">) => product.description.includes(\" · \") ? product.description.split(\" · \").slice(1).join(\" · \") : product.description;\n\n(End of file - total 41 lines)\n</content>","metadata":{"preview":"export type Product = {\n  id: number;\n  name: string;\n  description: string;\n  price: number;\n  stock: number;\n  is_active: boolean;\n};\n\nexport type ProductPage = { items: Product[]; total: number; page: number; page_size: number };\nexport type CartItem = { id: number; product_id: number; quantity: number; name: string; unit_price: number; line_total: number };\nexport type Cart = { items: CartItem[]; subtotal: number };\nexport type User = { id: number; username: string; is_admin: boolean };\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/api.ts","text":"export type Product = {\n  id: number;\n  name: string;\n  description: string;\n  price: number;\n  stock: number;\n  is_active: boolean;\n};\n\nexport type ProductPage = { items: Product[]; total: number; page: number; page_size: number };\nexport type CartItem = { id: number; product_id: number; quantity: number; name: string; unit_price: number; line_total: number };\nexport type Cart = { items: CartItem[]; subtotal: number };\nexport type User = { id: number; username: string; is_admin: boolean };\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport async function api<T>(path: string, options: RequestInit = {}, token?: string | null): Promise<T> {\n  const headers = new Headers(options.headers);\n  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  let response: Response;\n  try {\n    response = await fetch(`/api${path}`, { ...options, headers });\n  } catch {\n    throw new ApiError(\"We couldn’t connect to the shop. Please try again.\", 0);\n  }\n  if (response.status === 204) return undefined as T;\n  const data = await response.json().catch(() => null);\n  if (!response.ok) throw new ApiError(data?.message || \"Something went wrong. Please try again.\", response.status);\n  return data as T;\n}\n\nexport const money = (amount: number) => new Intl.NumberFormat(\"en-US\", { style: \"currency\", currency: \"USD\" }).format(amount);\nexport const category = (product: Pick<Product, \"description\">) => product.description.split(\" · \")[0] || \"Everyday essentials\";\nexport const description = (product: Pick<Product, \"description\">) => product.description.includes(\" · \") ? product.description.split(\" · \").slice(1).join(\" · \") : product.description;","lineStart":1,"lineEnd":41,"totalLines":41,"truncated":false}},"title":"frontend/src/api.ts","time":{"start":1794314848271,"end":1794314848440}},"id":"prt_1c57fc80a0016clCWFjbapptXR","sessionID":"ses_e3a99293bffepwQ9jkh5Z7xel0","messageID":"msg_1c57fafb1001CyzdI6P8tt9F8l"}}
