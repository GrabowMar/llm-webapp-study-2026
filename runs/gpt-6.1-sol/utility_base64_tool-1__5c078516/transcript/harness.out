 \"shield\" | \"bolt\" | \"chevron\" | \"trash\" | \"logout\" | \"clipboard\" | \"info\" | \"plus\" | \"user\";\n+\n+const paths: Record<IconName, React.ReactNode> = {\n+  arrow: <><path d=\"M4 12h16m-6-6 6 6-6 6\" /></>,\n+  swap: <><path d=\"M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4\" /></>,\n+  copy: <><rect x=\"8\" y=\"8\" width=\"12\" height=\"13\" rx=\"2\" /><path d=\"M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3\" /></>,\n+  check: <path d=\"m5 12 4 4L19 6\" />,\n+  close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+  history: <><path d=\"M3 11a9 9 0 1 1 2.7 7M3 4v7h7M12 7v5l3 2\" /></>,\n+  lock: <><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\" /><path d=\"M8 10V7a4 4 0 0 1 8 0v3M12 14v3\" /></>,\n+  code: <path d=\"m7 6-6 6 6 6m10-12 6 6-6 6m-3-15-4 18\" />,\n+  globe: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><ellipse cx=\"12\" cy=\"12\" rx=\"4\" ry=\"9\" /><path d=\"M3 12h18\" /></>,\n+  shield: <><path d=\"m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z\" /><path d=\"m8 12 3 3 5-6\" /></>,\n+  bolt: <path d=\"m13 2-9 12h7l-1 8 10-13h-7l1-7Z\" />,\n+  chevron: <path d=\"m9 5 7 7-7 7\" />,\n+  trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\" /></>,\n+  logout: <><path d=\"M9 3H4v18h5m5-9H8m7-4 4 4-4 4m-1-4h7\" /></>,\n+  clipboard: <><rect x=\"8\" y=\"3\" width=\"8\" height=\"4\" rx=\"1\" /><path d=\"M8 5H5v16h14V5h-3\" /></>,\n+  info: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 11v6m0-10v.1\" /></>,\n+  plus: <path d=\"M12 5v14M5 12h14\" />,\n+  user: <><circle cx=\"12\" cy=\"8\" r=\"4\" /><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\" /></>,\n+};\n+\n+export default function Icon({ name, className = \"h-4 w-4\" }: { name: IconName; className?: string }) {\n+  return <svg aria-hidden=\"true\" className={className} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.65\" strokeLinecap=\"round\" strokeLinejoin=\"round\">{paths[name]}</svg>;\n+}\n*** Add File: /workspace/frontend/src/api.ts\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      ...options,\n+      headers: {\n+        ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n+        ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+        ...options.headers,\n+      },\n+    });\n+  } catch {\n+    throw new ApiError(\"Unable to reach the server. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const body = await response.json();\n+  if (!response.ok) throw new ApiError(body.error || \"Something went wrong. Please try again.\", response.status);\n+  return body as T;\n+}\n+\n+export type Session = { token: string; username: string };\n+export type Direction = \"encode\" | \"decode\";\n+export type Conversion = {\n+  id: number;\n+  direction: Direction;\n+  input_preview: string;\n+  output_preview: string;\n+  created_at: string;\n+};\n+export type HistoryPage = { items: Conversion[]; total: number; page: number; page_size: number };\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n*** Add File: /workspace/frontend/src/Modal.tsx\n+import { useEffect, useRef } from \"react\";\n+import type { ReactNode } from \"react\";\n+import Icon from \"./icons\";\n+\n+export default function Modal({ children, onClose, title }: { children: ReactNode; onClose: () => void; title: string }) {\n+  const container = useRef<HTMLDivElement>(null);\n+  const closeRef = useRef(onClose);\n+\n+  useEffect(() => { closeRef.current = onClose; }, [onClose]);\n+\n+  useEffect(() => {\n+    const previous = document.activeElement as HTMLElement | null;\n+    const previousOverflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    const focusable = () => container.current?.querySelectorAll<HTMLElement>(\"button:not(:disabled), input, a[href], textarea, [tabindex='0']\");\n+    focusable()?.[0]?.focus();\n+    function onKey(event: KeyboardEvent) {\n+      if (event.key === \"Escape\") closeRef.current();\n+      if (event.key === \"Tab\") {\n+        const elements = focusable();\n+        if (!elements?.length) return;\n+        const first = elements[0];\n+        const last = elements[elements.length - 1];\n+        if (event.shiftKey && document.activeElement === first) {\n+          event.preventDefault();\n+          last.focus();\n+        } else if (!event.shiftKey && document.activeElement === last) {\n+          event.preventDefault();\n+          first.focus();\n+        }\n+      }\n+    }\n+    document.addEventListener(\"keydown\", onKey);\n+    return () => {\n+      document.body.style.overflow = previousOverflow;\n+      document.removeEventListener(\"keydown\", onKey);\n+      previous?.focus();\n+    };\n+  }, []);\n+\n+  return <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/35 p-4 backdrop-blur-sm\" onMouseDown={(event) => { if (event.target === event.currentTarget) onClose(); }}>\n+    <div ref={container} role=\"dialog\" aria-modal=\"true\" aria-label={title} className=\"relative max-h-[90dvh] w-full max-w-lg overflow-y-auto rounded-2xl border border-line bg-paper p-7 shadow-2xl sm:p-9\">\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"absolute right-4 top-4 rounded-lg p-2 text-muted transition-colors hover:bg-line hover:text-ink\"><Icon name=\"close\" /></button>\n+      {children}\n+    </div>\n+  </div>;\n+}\n*** Add File: /workspace/frontend/src/AuthModal.tsx\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, errorMessage } from \"./api\";\n+import type { Session } from \"./api\";\n+import Icon from \"./icons\";\n+import Modal from \"./Modal\";\n+\n+export default function AuthModal({ initialMode, onClose, onSuccess }: { initialMode: \"login\" | \"register\"; onClose: () => void; onSuccess: (session: Session) => void }) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      const body = JSON.stringify({ username: username.trim(), password });\n+      if (mode === \"register\") await api(\"/auth/register\", { method: \"POST\", body });\n+      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, token);\n+      onSuccess({ token, username: user.username });\n+    } catch (error) {\n+      setError(errorMessage(error));\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return <Modal title={mode === \"login\" ? \"Sign in\" : \"Create an account\"} onClose={onClose}>\n+    <div className=\"mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-forest\"><Icon name=\"lock\" className=\"h-6 w-6\" /></div>\n+    <p className=\"mb-2 text-[10px] font-bold tracking-[0.18em] text-forest\">YOUR OWN LITTLE SPACE</p>\n+    <h2 className=\"text-3xl font-semibold tracking-tight\">{mode === \"login\" ? \"Welcome back.\" : \"Keep it for later.\"}</h2>\n+    <p className=\"mt-3 text-sm leading-6 text-muted\">{mode === \"login\" ? \"Sign in to pick up where you left off. Your conversion history is just for you.\" : \"Create a free account and give your conversions a private place to live.\"}</p>\n+    <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+      <div><label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label><input id=\"username\" name=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} required maxLength={80} placeholder=\"Your username\" disabled={busy} className=\"w-full rounded-lg border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/70\" /></div>\n+      <div><label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label><input id=\"password\" name=\"password\" type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={(event) => setPassword(event.target.value)} required maxLength={1024} placeholder={mode === \"login\" ? \"Your password\" : \"Choose a password\"} disabled={busy} className=\"w-full rounded-lg border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/70\" /></div>\n+      {error && <p role=\"alert\" className=\"rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+      <button disabled={busy} className=\"flex w-full items-center justify-center gap-3 rounded-lg bg-forest py-3.5 text-sm font-medium text-white transition-colors hover:bg-ink disabled:opacity-50\">{busy ? \"One moment…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" /></button>\n+    </form>\n+    <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New around here?\" : \"Already have an account?\"} <button type=\"button\" disabled={busy} onClick={() => { setMode(mode === \"login\" ? \"register\" : \"login\"); setError(\"\"); }} className=\"ml-1 font-medium text-forest hover:underline\">{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n+    <div className=\"mt-7 flex items-center justify-center gap-2 border-t border-line pt-5 text-xs text-muted\"><Icon name=\"shield\" className=\"h-3.5 w-3.5\" />Private history. No unnecessary extras.</div>\n+  </Modal>;\n+}\n*** Add File: /workspace/frontend/src/ApiModal.tsx\n+import Modal from \"./Modal\";\n+import Icon from \"./icons\";\n+\n+export default function ApiModal({ onClose }: { onClose: () => void }) {\n+  return <Modal title=\"API reference\" onClose={onClose}>\n+    <div className=\"mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-forest\"><Icon name=\"code\" className=\"h-6 w-6\" /></div>\n+    <p className=\"text-[10px] font-bold tracking-[0.18em] text-forest\">MADE TO FIT YOUR WORKFLOW</p>\n+    <h2 className=\"mt-2 text-3xl font-semibold tracking-tight\">Meet the API.</h2>\n+    <p className=\"mt-3 text-sm leading-6 text-muted\">The same simple conversions, from your code. All endpoints use JSON and live under <code className=\"text-forest\">/api</code>.</p>\n+    <div className=\"mt-6 space-y-5\">\n+      <section><h3 className=\"text-sm font-semibold\">Encode text</h3><pre className=\"mt-2 overflow-x-auto rounded-lg bg-ink p-4 font-mono text-[11px] leading-6 text-mint\">{'POST /api/base64/encode\\n{\"text\": \"Hello, world!\"}\\n\\n→ {\"encoded\": \"SGVsbG8sIHdvcmxkIQ==\"}'}</pre></section>\n+      <section><h3 className=\"text-sm font-semibold\">Decode Base64</h3><pre className=\"mt-2 overflow-x-auto rounded-lg bg-ink p-4 font-mono text-[11px] leading-6 text-mint\">{'POST /api/base64/decode\\n{\"encoded\": \"SGVsbG8sIHdvcmxkIQ==\"}\\n\\n→ {\"text\": \"Hello, world!\"}'}</pre></section>\n+      <section className=\"rounded-lg border border-line p-4\"><h3 className=\"flex items-center gap-2 text-sm font-semibold\"><Icon name=\"lock\" />Accounts & private history</h3><p className=\"mt-2 text-xs leading-6 text-muted\">Register at <code>/api/auth/register</code>, then sign in at <code>/api/auth/login</code> with <code>{'{\"username\": \"you\", \"password\": \"…\"}'}</code>. Pass the returned token as <code>Authorization: Bearer &lt;token&gt;</code>.</p><div className=\"mt-3 space-y-2 font-mono text-[11px]\"><p>POST /api/conversions</p><p className=\"break-all text-muted\">{'{\"direction\": \"encode\", \"input\": \"Hello\"}'}</p><p>GET /api/conversions?page=1&page_size=10</p><p>DELETE /api/conversions/&#123;id&#125;</p></div></section>\n+    </div>\n+    <p className=\"mt-5 flex items-center gap-2 text-xs text-muted\"><Icon name=\"info\" />Base64 is an encoding, not encryption.</p>\n+  </Modal>;\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nM Dockerfile\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/src/icons.tsx\nA frontend/src/api.ts\nA frontend/src/Modal.tsx\nA frontend/src/AuthModal.tsx\nA frontend/src/ApiModal.tsx","metadata":{"diff":"Index: /workspace/Dockerfile\n===================================================================\n--- /workspace/Dockerfile\n+++ /workspace/Dockerfile\n@@ -13,9 +13,9 @@\n     PORT=8000\n WORKDIR /app\n COPY backend/requirements.txt backend/requirements.lock* backend/\n RUN if [ -f backend/requirements.lock ]; then \\\n-      pip install --no-cache-dir -r backend/requirements.txt -c backend/requirements.lock; \\\n+      pip install --no-cache-dir -r backend/requirements.lock; \\\n     else \\\n       pip install --no-cache-dir -r backend/requirements.txt; \\\n     fi\n COPY backend/ backend/\n\nIndex: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,18 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,22 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx,js}\"],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+  },\n+  {\n+    files: [\"src/**/*.{ts,tsx}\"],\n+    plugins: { \"react-hooks\": reactHooks },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+    },\n+  },\n+);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,19 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n+  --color-ink: #20352d;\n+  --color-muted: #7c847f;\n+  --color-paper: #f7f8f5;\n+  --color-line: #e4e8e1;\n+  --color-forest: #2e6247;\n+  --color-mint: #eaf2e6;\n+}\n+\n+@layer base {\n+  body { @apply m-0 min-w-[320px] bg-paper font-sans text-ink antialiased; }\n+  button, a, input, textarea { @apply outline-none focus-visible:ring-2 focus-visible:ring-forest/60 focus-visible:ring-offset-2; }\n+  button { @apply cursor-pointer disabled:cursor-not-allowed; }\n+  ::selection { @apply bg-[#d3e9c8] text-ink; }\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f7f8f5\" />\n+    <meta name=\"description\" content=\"A little less friction. Encode and decode UTF-8 text with a simple Base64 converter, and keep a private conversion history.\" />\n+    <title>Base64 — Your text, transformed.</title>\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#2e6247\"/><path d=\"m15 12-7 8 7 8m10-16 7 8-7 8m-3-19-4 22\" fill=\"none\" stroke=\"#eaf2e6\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n\nIndex: /workspace/frontend/src/icons.tsx\n===================================================================\n--- /workspace/frontend/src/icons.tsx\n+++ /workspace/frontend/src/icons.tsx\n@@ -0,0 +1,26 @@\n+type IconName = \"arrow\" | \"swap\" | \"copy\" | \"check\" | \"close\" | \"history\" | \"lock\" | \"code\" | \"globe\" | \"shield\" | \"bolt\" | \"chevron\" | \"trash\" | \"logout\" | \"clipboard\" | \"info\" | \"plus\" | \"user\";\n+\n+const paths: Record<IconName, React.ReactNode> = {\n+  arrow: <><path d=\"M4 12h16m-6-6 6 6-6 6\" /></>,\n+  swap: <><path d=\"M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4\" /></>,\n+  copy: <><rect x=\"8\" y=\"8\" width=\"12\" height=\"13\" rx=\"2\" /><path d=\"M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3\" /></>,\n+  check: <path d=\"m5 12 4 4L19 6\" />,\n+  close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+  history: <><path d=\"M3 11a9 9 0 1 1 2.7 7M3 4v7h7M12 7v5l3 2\" /></>,\n+  lock: <><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\" /><path d=\"M8 10V7a4 4 0 0 1 8 0v3M12 14v3\" /></>,\n+  code: <path d=\"m7 6-6 6 6 6m10-12 6 6-6 6m-3-15-4 18\" />,\n+  globe: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><ellipse cx=\"12\" cy=\"12\" rx=\"4\" ry=\"9\" /><path d=\"M3 12h18\" /></>,\n+  shield: <><path d=\"m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z\" /><path d=\"m8 12 3 3 5-6\" /></>,\n+  bolt: <path d=\"m13 2-9 12h7l-1 8 10-13h-7l1-7Z\" />,\n+  chevron: <path d=\"m9 5 7 7-7 7\" />,\n+  trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\" /></>,\n+  logout: <><path d=\"M9 3H4v18h5m5-9H8m7-4 4 4-4 4m-1-4h7\" /></>,\n+  clipboard: <><rect x=\"8\" y=\"3\" width=\"8\" height=\"4\" rx=\"1\" /><path d=\"M8 5H5v16h14V5h-3\" /></>,\n+  info: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 11v6m0-10v.1\" /></>,\n+  plus: <path d=\"M12 5v14M5 12h14\" />,\n+  user: <><circle cx=\"12\" cy=\"8\" r=\"4\" /><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\" /></>,\n+};\n+\n+export default function Icon({ name, className = \"h-4 w-4\" }: { name: IconName; className?: string }) {\n+  return <svg aria-hidden=\"true\" className={className} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.65\" strokeLinecap=\"round\" strokeLinejoin=\"round\">{paths[name]}</svg>;\n+}\n\nIndex: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,43 @@\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      ...options,\n+      headers: {\n+        ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n+        ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+        ...options.headers,\n+      },\n+    });\n+  } catch {\n+    throw new ApiError(\"Unable to reach the server. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const body = await response.json();\n+  if (!response.ok) throw new ApiError(body.error || \"Something went wrong. Please try again.\", response.status);\n+  return body as T;\n+}\n+\n+export type Session = { token: string; username: string };\n+export type Direction = \"encode\" | \"decode\";\n+export type Conversion = {\n+  id: number;\n+  direction: Direction;\n+  input_preview: string;\n+  output_preview: string;\n+  created_at: string;\n+};\n+export type HistoryPage = { items: Conversion[]; total: number; page: number; page_size: number };\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n\nIndex: /workspace/frontend/src/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/Modal.tsx\n+++ /workspace/frontend/src/Modal.tsx\n@@ -0,0 +1,47 @@\n+import { useEffect, useRef } from \"react\";\n+import type { ReactNode } from \"react\";\n+import Icon from \"./icons\";\n+\n+export default function Modal({ children, onClose, title }: { children: ReactNode; onClose: () => void; title: string }) {\n+  const container = useRef<HTMLDivElement>(null);\n+  const closeRef = useRef(onClose);\n+\n+  useEffect(() => { closeRef.current = onClose; }, [onClose]);\n+\n+  useEffect(() => {\n+    const previous = document.activeElement as HTMLElement | null;\n+    const previousOverflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    const focusable = () => container.current?.querySelectorAll<HTMLElement>(\"button:not(:disabled), input, a[href], textarea, [tabindex='0']\");\n+    focusable()?.[0]?.focus();\n+    function onKey(event: KeyboardEvent) {\n+      if (event.key === \"Escape\") closeRef.current();\n+      if (event.key === \"Tab\") {\n+        const elements = focusable();\n+        if (!elements?.length) return;\n+        const first = elements[0];\n+        const last = elements[elements.length - 1];\n+        if (event.shiftKey && document.activeElement === first) {\n+          event.preventDefault();\n+          last.focus();\n+        } else if (!event.shiftKey && document.activeElement === last) {\n+          event.preventDefault();\n+          first.focus();\n+        }\n+      }\n+    }\n+    document.addEventListener(\"keydown\", onKey);\n+    return () => {\n+      document.body.style.overflow = previousOverflow;\n+      document.removeEventListener(\"keydown\", onKey);\n+      previous?.focus();\n+    };\n+  }, []);\n+\n+  return <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/35 p-4 backdrop-blur-sm\" onMouseDown={(event) => { if (event.target === event.currentTarget) onClose(); }}>\n+    <div ref={container} role=\"dialog\" aria-modal=\"true\" aria-label={title} className=\"relative max-h-[90dvh] w-full max-w-lg overflow-y-auto rounded-2xl border border-line bg-paper p-7 shadow-2xl sm:p-9\">\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"absolute right-4 top-4 rounded-lg p-2 text-muted transition-colors hover:bg-line hover:text-ink\"><Icon name=\"close\" /></button>\n+      {children}\n+    </div>\n+  </div>;\n+}\n\nIndex: /workspace/frontend/src/AuthModal.tsx\n===================================================================\n--- /workspace/frontend/src/AuthModal.tsx\n+++ /workspace/frontend/src/AuthModal.tsx\n@@ -0,0 +1,46 @@\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, errorMessage } from \"./api\";\n+import type { Session } from \"./api\";\n+import Icon from \"./icons\";\n+import Modal from \"./Modal\";\n+\n+export default function AuthModal({ initialMode, onClose, onSuccess }: { initialMode: \"login\" | \"register\"; onClose: () => void; onSuccess: (session: Session) => void }) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      const body = JSON.stringify({ username: username.trim(), password });\n+      if (mode === \"register\") await api(\"/auth/register\", { method: \"POST\", body });\n+      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, token);\n+      onSuccess({ token, username: user.username });\n+    } catch (error) {\n+      setError(errorMessage(error));\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return <Modal title={mode === \"login\" ? \"Sign in\" : \"Create an account\"} onClose={onClose}>\n+    <div className=\"mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-forest\"><Icon name=\"lock\" className=\"h-6 w-6\" /></div>\n+    <p className=\"mb-2 text-[10px] font-bold tracking-[0.18em] text-forest\">YOUR OWN LITTLE SPACE</p>\n+    <h2 className=\"text-3xl font-semibold tracking-tight\">{mode === \"login\" ? \"Welcome back.\" : \"Keep it for later.\"}</h2>\n+    <p className=\"mt-3 text-sm leading-6 text-muted\">{mode === \"login\" ? \"Sign in to pick up where you left off. Your conversion history is just for you.\" : \"Create a free account and give your conversions a private place to live.\"}</p>\n+    <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+      <div><label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label><input id=\"username\" name=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} required maxLength={80} placeholder=\"Your username\" disabled={busy} className=\"w-full rounded-lg border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/70\" /></div>\n+      <div><label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label><input id=\"password\" name=\"password\" type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={(event) => setPassword(event.target.value)} required maxLength={1024} placeholder={mode === \"login\" ? \"Your password\" : \"Choose a password\"} disabled={busy} className=\"w-full rounded-lg border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/70\" /></div>\n+      {error && <p role=\"alert\" className=\"rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+      <button disabled={busy} className=\"flex w-full items-center justify-center gap-3 rounded-lg bg-forest py-3.5 text-sm font-medium text-white transition-colors hover:bg-ink disabled:opacity-50\">{busy ? \"One moment…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" /></button>\n+    </form>\n+    <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New around here?\" : \"Already have an account?\"} <button type=\"button\" disabled={busy} onClick={() => { setMode(mode === \"login\" ? \"register\" : \"login\"); setError(\"\"); }} className=\"ml-1 font-medium text-forest hover:underline\">{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n+    <div className=\"mt-7 flex items-center justify-center gap-2 border-t border-line pt-5 text-xs text-muted\"><Icon name=\"shield\" className=\"h-3.5 w-3.5\" />Private history. No unnecessary extras.</div>\n+  </Modal>;\n+}\n\nIndex: /workspace/frontend/src/ApiModal.tsx\n===================================================================\n--- /workspace/frontend/src/ApiModal.tsx\n+++ /workspace/frontend/src/ApiModal.tsx\n@@ -0,0 +1,17 @@\n+import Modal from \"./Modal\";\n+import Icon from \"./icons\";\n+\n+export default function ApiModal({ onClose }: { onClose: () => void }) {\n+  return <Modal title=\"API reference\" onClose={onClose}>\n+    <div className=\"mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-forest\"><Icon name=\"code\" className=\"h-6 w-6\" /></div>\n+    <p className=\"text-[10px] font-bold tracking-[0.18em] text-forest\">MADE TO FIT YOUR WORKFLOW</p>\n+    <h2 className=\"mt-2 text-3xl font-semibold tracking-tight\">Meet the API.</h2>\n+    <p className=\"mt-3 text-sm leading-6 text-muted\">The same simple conversions, from your code. All endpoints use JSON and live under <code className=\"text-forest\">/api</code>.</p>\n+    <div className=\"mt-6 space-y-5\">\n+      <section><h3 className=\"text-sm font-semibold\">Encode text</h3><pre className=\"mt-2 overflow-x-auto rounded-lg bg-ink p-4 font-mono text-[11px] leading-6 text-mint\">{'POST /api/base64/encode\\n{\"text\": \"Hello, world!\"}\\n\\n→ {\"encoded\": \"SGVsbG8sIHdvcmxkIQ==\"}'}</pre></section>\n+      <section><h3 className=\"text-sm font-semibold\">Decode Base64</h3><pre className=\"mt-2 overflow-x-auto rounded-lg bg-ink p-4 font-mono text-[11px] leading-6 text-mint\">{'POST /api/base64/decode\\n{\"encoded\": \"SGVsbG8sIHdvcmxkIQ==\"}\\n\\n→ {\"text\": \"Hello, world!\"}'}</pre></section>\n+      <section className=\"rounded-lg border border-line p-4\"><h3 className=\"flex items-center gap-2 text-sm font-semibold\"><Icon name=\"lock\" />Accounts & private history</h3><p className=\"mt-2 text-xs leading-6 text-muted\">Register at <code>/api/auth/register</code>, then sign in at <code>/api/auth/login</code> with <code>{'{\"username\": \"you\", \"password\": \"…\"}'}</code>. Pass the returned token as <code>Authorization: Bearer &lt;token&gt;</code>.</p><div className=\"mt-3 space-y-2 font-mono text-[11px]\"><p>POST /api/conversions</p><p className=\"break-all text-muted\">{'{\"direction\": \"encode\", \"input\": \"Hello\"}'}</p><p>GET /api/conversions?page=1&page_size=10</p><p>DELETE /api/conversions/&#123;id&#125;</p></div></section>\n+    </div>\n+    <p className=\"mt-5 flex items-center gap-2 text-xs text-muted\"><Icon name=\"info\" />Base64 is an encoding, not encryption.</p>\n+  </Modal>;\n+}\n\n","files":[{"filePath":"/workspace/Dockerfile","relativePath":"Dockerfile","type":"update","patch":"Index: /workspace/Dockerfile\n===================================================================\n--- /workspace/Dockerfile\n+++ /workspace/Dockerfile\n@@ -13,9 +13,9 @@\n     PORT=8000\n WORKDIR /app\n COPY backend/requirements.txt backend/requirements.lock* backend/\n RUN if [ -f backend/requirements.lock ]; then \\\n-      pip install --no-cache-dir -r backend/requirements.txt -c backend/requirements.lock; \\\n+      pip install --no-cache-dir -r backend/requirements.lock; \\\n     else \\\n       pip install --no-cache-dir -r backend/requirements.txt; \\\n     fi\n COPY backend/ backend/\n","additions":1,"deletions":1},{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,18 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":18,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,22 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx,js}\"],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+  },\n+  {\n+    files: [\"src/**/*.{ts,tsx}\"],\n+    plugins: { \"react-hooks\": reactHooks },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+    },\n+  },\n+);\n","additions":22,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,19 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n+  --color-ink: #20352d;\n+  --color-muted: #7c847f;\n+  --color-paper: #f7f8f5;\n+  --color-line: #e4e8e1;\n+  --color-forest: #2e6247;\n+  --color-mint: #eaf2e6;\n+}\n+\n+@layer base {\n+  body { @apply m-0 min-w-[320px] bg-paper font-sans text-ink antialiased; }\n+  button, a, input, textarea { @apply outline-none focus-visible:ring-2 focus-visible:ring-forest/60 focus-visible:ring-offset-2; }\n+  button { @apply cursor-pointer disabled:cursor-not-allowed; }\n+  ::selection { @apply bg-[#d3e9c8] text-ink; }\n+}\n","additions":19,"deletions":0},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f7f8f5\" />\n+    <meta name=\"description\" content=\"A little less friction. Encode and decode UTF-8 text with a simple Base64 converter, and keep a private conversion history.\" />\n+    <title>Base64 — Your text, transformed.</title>\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":4,"deletions":1},{"filePath":"/workspace/frontend/public/favicon.svg","relativePath":"frontend/public/favicon.svg","type":"add","patch":"Index: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"11\" fill=\"#2e6247\"/><path d=\"m15 12-7 8 7 8m10-16 7 8-7 8m-3-19-4 22\" fill=\"none\" stroke=\"#eaf2e6\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/src/icons.tsx","relativePath":"frontend/src/icons.tsx","type":"add","patch":"Index: /workspace/frontend/src/icons.tsx\n===================================================================\n--- /workspace/frontend/src/icons.tsx\n+++ /workspace/frontend/src/icons.tsx\n@@ -0,0 +1,26 @@\n+type IconName = \"arrow\" | \"swap\" | \"copy\" | \"check\" | \"close\" | \"history\" | \"lock\" | \"code\" | \"globe\" | \"shield\" | \"bolt\" | \"chevron\" | \"trash\" | \"logout\" | \"clipboard\" | \"info\" | \"plus\" | \"user\";\n+\n+const paths: Record<IconName, React.ReactNode> = {\n+  arrow: <><path d=\"M4 12h16m-6-6 6 6-6 6\" /></>,\n+  swap: <><path d=\"M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4\" /></>,\n+  copy: <><rect x=\"8\" y=\"8\" width=\"12\" height=\"13\" rx=\"2\" /><path d=\"M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3\" /></>,\n+  check: <path d=\"m5 12 4 4L19 6\" />,\n+  close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+  history: <><path d=\"M3 11a9 9 0 1 1 2.7 7M3 4v7h7M12 7v5l3 2\" /></>,\n+  lock: <><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\" /><path d=\"M8 10V7a4 4 0 0 1 8 0v3M12 14v3\" /></>,\n+  code: <path d=\"m7 6-6 6 6 6m10-12 6 6-6 6m-3-15-4 18\" />,\n+  globe: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><ellipse cx=\"12\" cy=\"12\" rx=\"4\" ry=\"9\" /><path d=\"M3 12h18\" /></>,\n+  shield: <><path d=\"m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z\" /><path d=\"m8 12 3 3 5-6\" /></>,\n+  bolt: <path d=\"m13 2-9 12h7l-1 8 10-13h-7l1-7Z\" />,\n+  chevron: <path d=\"m9 5 7 7-7 7\" />,\n+  trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\" /></>,\n+  logout: <><path d=\"M9 3H4v18h5m5-9H8m7-4 4 4-4 4m-1-4h7\" /></>,\n+  clipboard: <><rect x=\"8\" y=\"3\" width=\"8\" height=\"4\" rx=\"1\" /><path d=\"M8 5H5v16h14V5h-3\" /></>,\n+  info: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 11v6m0-10v.1\" /></>,\n+  plus: <path d=\"M12 5v14M5 12h14\" />,\n+  user: <><circle cx=\"12\" cy=\"8\" r=\"4\" /><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\" /></>,\n+};\n+\n+export default function Icon({ name, className = \"h-4 w-4\" }: { name: IconName; className?: string }) {\n+  return <svg aria-hidden=\"true\" className={className} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.65\" strokeLinecap=\"round\" strokeLinejoin=\"round\">{paths[name]}</svg>;\n+}\n","additions":26,"deletions":0},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,43 @@\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      ...options,\n+      headers: {\n+        ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n+        ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+        ...options.headers,\n+      },\n+    });\n+  } catch {\n+    throw new ApiError(\"Unable to reach the server. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const body = await response.json();\n+  if (!response.ok) throw new ApiError(body.error || \"Something went wrong. Please try again.\", response.status);\n+  return body as T;\n+}\n+\n+export type Session = { token: string; username: string };\n+export type Direction = \"encode\" | \"decode\";\n+export type Conversion = {\n+  id: number;\n+  direction: Direction;\n+  input_preview: string;\n+  output_preview: string;\n+  created_at: string;\n+};\n+export type HistoryPage = { items: Conversion[]; total: number; page: number; page_size: number };\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n","additions":43,"deletions":0},{"filePath":"/workspace/frontend/src/Modal.tsx","relativePath":"frontend/src/Modal.tsx","type":"add","patch":"Index: /workspace/frontend/src/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/Modal.tsx\n+++ /workspace/frontend/src/Modal.tsx\n@@ -0,0 +1,47 @@\n+import { useEffect, useRef } from \"react\";\n+import type { ReactNode } from \"react\";\n+import Icon from \"./icons\";\n+\n+export default function Modal({ children, onClose, title }: { children: ReactNode; onClose: () => void; title: string }) {\n+  const container = useRef<HTMLDivElement>(null);\n+  const closeRef = useRef(onClose);\n+\n+  useEffect(() => { closeRef.current = onClose; }, [onClose]);\n+\n+  useEffect(() => {\n+    const previous = document.activeElement as HTMLElement | null;\n+    const previousOverflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    const focusable = () => container.current?.querySelectorAll<HTMLElement>(\"button:not(:disabled), input, a[href], textarea, [tabindex='0']\");\n+    focusable()?.[0]?.focus();\n+    function onKey(event: KeyboardEvent) {\n+      if (event.key === \"Escape\") closeRef.current();\n+      if (event.key === \"Tab\") {\n+        const elements = focusable();\n+        if (!elements?.length) return;\n+        const first = elements[0];\n+        const last = elements[elements.length - 1];\n+        if (event.shiftKey && document.activeElement === first) {\n+          event.preventDefault();\n+          last.focus();\n+        } else if (!event.shiftKey && document.activeElement === last) {\n+          event.preventDefault();\n+          first.focus();\n+        }\n+      }\n+    }\n+    document.addEventListener(\"keydown\", onKey);\n+    return () => {\n+      document.body.style.overflow = previousOverflow;\n+      document.removeEventListener(\"keydown\", onKey);\n+      previous?.focus();\n+    };\n+  }, []);\n+\n+  return <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-ink/35 p-4 backdrop-blur-sm\" onMouseDown={(event) => { if (event.target === event.currentTarget) onClose(); }}>\n+    <div ref={container} role=\"dialog\" aria-modal=\"true\" aria-label={title} className=\"relative max-h-[90dvh] w-full max-w-lg overflow-y-auto rounded-2xl border border-line bg-paper p-7 shadow-2xl sm:p-9\">\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"absolute right-4 top-4 rounded-lg p-2 text-muted transition-colors hover:bg-line hover:text-ink\"><Icon name=\"close\" /></button>\n+      {children}\n+    </div>\n+  </div>;\n+}\n","additions":47,"deletions":0},{"filePath":"/workspace/frontend/src/AuthModal.tsx","relativePath":"frontend/src/AuthModal.tsx","type":"add","patch":"Index: /workspace/frontend/src/AuthModal.tsx\n===================================================================\n--- /workspace/frontend/src/AuthModal.tsx\n+++ /workspace/frontend/src/AuthModal.tsx\n@@ -0,0 +1,46 @@\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, errorMessage } from \"./api\";\n+import type { Session } from \"./api\";\n+import Icon from \"./icons\";\n+import Modal from \"./Modal\";\n+\n+export default function AuthModal({ initialMode, onClose, onSuccess }: { initialMode: \"login\" | \"register\"; onClose: () => void; onSuccess: (session: Session) => void }) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      const body = JSON.stringify({ username: username.trim(), password });\n+      if (mode === \"register\") await api(\"/auth/register\", { method: \"POST\", body });\n+      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, token);\n+      onSuccess({ token, username: user.username });\n+    } catch (error) {\n+      setError(errorMessage(error));\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return <Modal title={mode === \"login\" ? \"Sign in\" : \"Create an account\"} onClose={onClose}>\n+    <div className=\"mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-forest\"><Icon name=\"lock\" className=\"h-6 w-6\" /></div>\n+    <p className=\"mb-2 text-[10px] font-bold tracking-[0.18em] text-forest\">YOUR OWN LITTLE SPACE</p>\n+    <h2 className=\"text-3xl font-semibold tracking-tight\">{mode === \"login\" ? \"Welcome back.\" : \"Keep it for later.\"}</h2>\n+    <p className=\"mt-3 text-sm leading-6 text-muted\">{mode === \"login\" ? \"Sign in to pick up where you left off. Your conversion history is just for you.\" : \"Create a free account and give your conversions a private place to live.\"}</p>\n+    <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+      <div><label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label><input id=\"username\" name=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} required maxLength={80} placeholder=\"Your username\" disabled={busy} className=\"w-full rounded-lg border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/70\" /></div>\n+      <div><label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label><input id=\"password\" name=\"password\" type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={(event) => setPassword(event.target.value)} required maxLength={1024} placeholder={mode === \"login\" ? \"Your password\" : \"Choose a password\"} disabled={busy} className=\"w-full rounded-lg border border-line bg-white px-4 py-3 text-sm placeholder:text-muted/70\" /></div>\n+      {error && <p role=\"alert\" className=\"rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+      <button disabled={busy} className=\"flex w-full items-center justify-center gap-3 rounded-lg bg-forest py-3.5 text-sm font-medium text-white transition-colors hover:bg-ink disabled:opacity-50\">{busy ? \"One moment…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" /></button>\n+    </form>\n+    <p className=\"mt-6 text-center text-sm text-muted\">{mode === \"login\" ? \"New around here?\" : \"Already have an account?\"} <button type=\"button\" disabled={busy} onClick={() => { setMode(mode === \"login\" ? \"register\" : \"login\"); setError(\"\"); }} className=\"ml-1 font-medium text-forest hover:underline\">{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n+    <div className=\"mt-7 flex items-center justify-center gap-2 border-t border-line pt-5 text-xs text-muted\"><Icon name=\"shield\" className=\"h-3.5 w-3.5\" />Private history. No unnecessary extras.</div>\n+  </Modal>;\n+}\n","additions":46,"deletions":0},{"filePath":"/workspace/frontend/src/ApiModal.tsx","relativePath":"frontend/src/ApiModal.tsx","type":"add","patch":"Index: /workspace/frontend/src/ApiModal.tsx\n===================================================================\n--- /workspace/frontend/src/ApiModal.tsx\n+++ /workspace/frontend/src/ApiModal.tsx\n@@ -0,0 +1,17 @@\n+import Modal from \"./Modal\";\n+import Icon from \"./icons\";\n+\n+export default function ApiModal({ onClose }: { onClose: () => void }) {\n+  return <Modal title=\"API reference\" onClose={onClose}>\n+    <div className=\"mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-forest\"><Icon name=\"code\" className=\"h-6 w-6\" /></div>\n+    <p className=\"text-[10px] font-bold tracking-[0.18em] text-forest\">MADE TO FIT YOUR WORKFLOW</p>\n+    <h2 className=\"mt-2 text-3xl font-semibold tracking-tight\">Meet the API.</h2>\n+    <p className=\"mt-3 text-sm leading-6 text-muted\">The same simple conversions, from your code. All endpoints use JSON and live under <code className=\"text-forest\">/api</code>.</p>\n+    <div className=\"mt-6 space-y-5\">\n+      <section><h3 className=\"text-sm font-semibold\">Encode text</h3><pre className=\"mt-2 overflow-x-auto rounded-lg bg-ink p-4 font-mono text-[11px] leading-6 text-mint\">{'POST /api/base64/encode\\n{\"text\": \"Hello, world!\"}\\n\\n→ {\"encoded\": \"SGVsbG8sIHdvcmxkIQ==\"}'}</pre></section>\n+      <section><h3 className=\"text-sm font-semibold\">Decode Base64</h3><pre className=\"mt-2 overflow-x-auto rounded-lg bg-ink p-4 font-mono text-[11px] leading-6 text-mint\">{'POST /api/base64/decode\\n{\"encoded\": \"SGVsbG8sIHdvcmxkIQ==\"}\\n\\n→ {\"text\": \"Hello, world!\"}'}</pre></section>\n+      <section className=\"rounded-lg border border-line p-4\"><h3 className=\"flex items-center gap-2 text-sm font-semibold\"><Icon name=\"lock\" />Accounts & private history</h3><p className=\"mt-2 text-xs leading-6 text-muted\">Register at <code>/api/auth/register</code>, then sign in at <code>/api/auth/login</code> with <code>{'{\"username\": \"you\", \"password\": \"…\"}'}</code>. Pass the returned token as <code>Authorization: Bearer &lt;token&gt;</code>.</p><div className=\"mt-3 space-y-2 font-mono text-[11px]\"><p>POST /api/conversions</p><p className=\"break-all text-muted\">{'{\"direction\": \"encode\", \"input\": \"Hello\"}'}</p><p>GET /api/conversions?page=1&page_size=10</p><p>DELETE /api/conversions/&#123;id&#125;</p></div></section>\n+    </div>\n+    <p className=\"mt-5 flex items-center gap-2 text-xs text-muted\"><Icon name=\"info\" />Base64 is an encoding, not encryption.</p>\n+  </Modal>;\n+}\n","additions":17,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM Dockerfile\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/src/icons.tsx\nA frontend/src/api.ts\nA frontend/src/Modal.tsx\nA frontend/src/AuthModal.tsx\nA frontend/src/ApiModal.tsx","time":{"start":1794315260459,"end":1794315260