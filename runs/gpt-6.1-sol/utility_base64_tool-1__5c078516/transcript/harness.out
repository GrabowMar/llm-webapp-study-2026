{"type":"tool_use","timestamp":1794314979146,"sessionID":"ses_e3a801e1dffegVWZJ0Q16Bat5g","part":{"type":"tool","tool":"apply_patch","callID":"call_UIQO3TifcNiOu8yzOToYSYuW","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Update File: /workspace/backend/app.py\n@@\n-\"\"\"Flask entry point.\"\"\"\n-\n+import base64\n+import binascii\n+import hashlib\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n from pathlib import Path\n \n-from flask import Flask\n-from flask import send_from_directory\n+from flask import Flask, abort, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n \n DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n \n-app = Flask(__name__, static_folder=None)\n \n+def database():\n+    if \"database\" not in g:\n+        g.database = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\n+        g.database.row_factory = sqlite3.Row\n+        g.database.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.database\n \n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n \n+def json_body():\n+    if not request.is_json:\n+        abort(400, description=\"Send a JSON object in the request body.\")\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        abort(400, description=\"Send a valid JSON object in the request body.\")\n+    return body\n \n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n+\n+def string_field(body, name):\n+    value = body.get(name)\n+    if not isinstance(value, str):\n+        abort(400, description=f\"'{name}' must be a string.\")\n+    return value\n+\n+\n+def credentials(body):\n+    username = string_field(body, \"username\").strip()\n+    password = string_field(body, \"password\")\n+    if not username or len(username) > 80:\n+        abort(400, description=\"Username must contain between 1 and 80 characters.\")\n+    if not password or len(password) > 1024:\n+        abort(400, description=\"Password must contain between 1 and 1024 characters.\")\n+    try:\n+        username.encode(\"utf-8\")\n+        password.encode(\"utf-8\")\n+    except UnicodeEncodeError:\n+        abort(400, description=\"Username and password must be valid UTF-8 text.\")\n+    return username, password\n+\n+\n+def convert(direction, value):\n+    if direction == \"encode\":\n+        try:\n+            return base64.b64encode(value.encode(\"utf-8\")).decode(\"ascii\")\n+        except UnicodeEncodeError:\n+            abort(400, description=\"The input must be valid UTF-8 text.\")\n+    if direction != \"decode\":\n+        abort(400, description=\"'direction' must be 'encode' or 'decode'.\")\n+    try:\n+        decoded = base64.b64decode(value, validate=True)\n+        if base64.b64encode(decoded).decode(\"ascii\") != value:\n+            raise ValueError\n+    except (binascii.Error, ValueError):\n+        abort(400, description=\"Invalid Base64. Use standard Base64 with correct padding and no whitespace.\")\n+    try:\n+        return decoded.decode(\"utf-8\")\n+    except UnicodeDecodeError:\n+        abort(400, description=\"The decoded data is not valid UTF-8 text.\")\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        authorization = request.headers.get(\"Authorization\", \"\").split()\n+        if len(authorization) != 2 or authorization[0].lower() != \"bearer\":\n+            abort(401, description=\"Please sign in to access your history.\")\n+        digest = hashlib.sha256(authorization[1].encode()).hexdigest()\n+        user = database().execute(\n+            \"SELECT users.id, users.username FROM tokens JOIN users ON users.id = tokens.user_id \"\n+            \"WHERE token_hash = ? AND expires_at > ?\",\n+            (digest, datetime.now(timezone.utc).isoformat()),\n+        ).fetchone()\n+        if user is None:\n+            abort(401, description=\"Your session has expired. Please sign in again.\")\n+        g.user = user\n+        g.token_hash = digest\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def conversion_object(row, include_output=False):\n+    def preview(value):\n+        return value if len(value) <= 160 else value[:159] + \"…\"\n+\n+    result = {\n+        \"id\": row[\"id\"],\n+        \"direction\": row[\"direction\"],\n+        \"input_preview\": preview(row[\"input\"]),\n+        \"output_preview\": preview(row[\"output\"]),\n+        \"created_at\": row[\"created_at\"],\n+    }\n+    if include_output:\n+        result[\"output\"] = row[\"output\"]\n+    return result\n+\n+\n+def create_app(data_dir=None):\n+    app = Flask(__name__, static_folder=None)\n+    directory = Path(data_dir or os.environ.get(\"DATA_DIR\", \"./data\"))\n+    directory.mkdir(parents=True, exist_ok=True)\n+    app.config.update(DATABASE=str(directory / \"base64.sqlite3\"), MAX_CONTENT_LENGTH=2 * 1024 * 1024)\n+    with app.app_context():\n+        db = database()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS tokens (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS conversions (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                direction TEXT NOT NULL CHECK (direction IN ('encode', 'decode')),\n+                input TEXT NOT NULL,\n+                output TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS conversions_user_id ON conversions(user_id, id DESC);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"database\", None)\n+\n+    @app.teardown_appcontext\n+    def close_database(exception=None):\n+        db = g.pop(\"database\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n+            \"img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        username, password = credentials(json_body())\n+        db = database()\n+        try:\n+            cursor = db.execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            abort(409, description=\"That username is already taken. Try another one.\")\n+        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        username, password = credentials(json_body())\n+        db = database()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            abort(401, description=\"Incorrect username or password.\")\n+        token = secrets.token_urlsafe(32)\n+        now = datetime.now(timezone.utc)\n+        db.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n+        db.execute(\n+            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], (now + timedelta(days=30)).isoformat()),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = database()\n+        db.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n+        db.commit()\n+        return \"\", 204\n+\n+    @app.post(\"/api/base64/encode\")\n+    def encode():\n+        return {\"encoded\": convert(\"encode\", string_field(json_body(), \"text\"))}\n+\n+    @app.post(\"/api/base64/decode\")\n+    def decode():\n+        return {\"text\": convert(\"decode\", string_field(json_body(), \"encoded\"))}\n+\n+    @app.post(\"/api/conversions\")\n+    @authenticated\n+    def save_conversion():\n+        body = json_body()\n+        direction = string_field(body, \"direction\")\n+        value = string_field(body, \"input\")\n+        output = convert(direction, value)\n+        db = database()\n+        cursor = db.execute(\n+            \"INSERT INTO conversions (user_id, direction, input, output, created_at) VALUES (?, ?, ?, ?, ?)\",\n+            (g.user[\"id\"], direction, value, output, datetime.now(timezone.utc).isoformat()),\n+        )\n+        db.commit()\n+        row = db.execute(\"SELECT * FROM conversions WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n+        return conversion_object(row, include_output=True), 201\n+\n+    @app.get(\"/api/conversions\")\n+    @authenticated\n+    def history():\n+        def positive_integer(name, default, maximum):\n+            raw = request.args.get(name, str(default))\n+            if not raw.isascii() or not raw.isdecimal() or len(raw) > 10:\n+                abort(400, description=f\"'{name}' must be a positive integer up to {maximum}.\")\n+            value = int(raw)\n+            if not 1 <= value <= maximum:\n+                abort(400, description=f\"'{name}' must be a positive integer up to {maximum}.\")\n+            return value\n+\n+        page = positive_integer(\"page\", 1, 1_000_000_000)\n+        page_size = positive_integer(\"page_size\", 10, 100)\n+        db = database()\n+        total = db.execute(\"SELECT COUNT(*) FROM conversions WHERE user_id = ?\", (g.user[\"id\"],)).fetchone()[0]\n+        rows = db.execute(\n+            \"SELECT * FROM conversions WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n+            (g.user[\"id\"], page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        return {\"items\": [conversion_object(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.delete(\"/api/conversions/<int:conversion_id>\")\n+    @authenticated\n+    def delete_conversion(conversion_id):\n+        db = database()\n+        cursor = db.execute(\"DELETE FROM conversions WHERE id = ? AND user_id = ?\", (conversion_id, g.user[\"id\"]))\n+        db.commit()\n+        if cursor.rowcount == 0:\n+            abort(404, description=\"Conversion not found.\")\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            abort(404, description=\"API endpoint not found.\")\n+        candidate = (DIST / path).resolve()\n+        if candidate.is_relative_to(DIST) and candidate.is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n*** Add File: /workspace/.gitignore\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+**/.venv/\n+data/\n+.ruff_cache/\n+.pytest_cache/\n*** Add File: /workspace/backend/test_app.py\n+import base64\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from app import create_app\n+\n+\n+class ApiTest(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.app = create_app(self.directory.name)\n+        self.app.config[\"TESTING\"] = True\n+        self.client = self.app.test_client()\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username=\"alice\"):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def save(self, headers, value=\"Hello, world!\", direction=\"encode\"):\n+        return self.client.post(\"/api/conversions\", headers=headers, json={\"direction\": direction, \"input\": value})\n+\n+    def test_health_and_unknown_api(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        response = self.client.get(\"/api/missing\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertIn(\"error\", response.json)\n+\n+    def test_utf8_and_empty_roundtrip(self):\n+        for text in [\"\", \"Hello, world!\", \"你好 🌍 café\\n\\t\", \"\\x00\"]:\n+            with self.subTest(text=text):\n+                encoded = self.client.post(\"/api/base64/encode\", json={\"text\": text})\n+                self.assertEqual(encoded.status_code, 200)\n+                self.assertEqual(encoded.json[\"encoded\"], base64.b64encode(text.encode()).decode())\n+                decoded = self.client.post(\"/api/base64/decode\", json=encoded.json)\n+                self.assertEqual(decoded.status_code, 200)\n+                self.assertEqual(decoded.json, {\"text\": text})\n+\n+    def test_invalid_base64(self):\n+        for encoded in [\"not base64!\", \"a\", \"Zg\", \"Zg===\", \"Zh==\", \"SGVsbG8=\\n\", \"_-==\", \"你好\", \"/w==\"]:\n+            with self.subTest(encoded=encoded):\n+                response = self.client.post(\"/api/base64/decode\", json={\"encoded\": encoded})\n+                self.assertEqual(response.status_code, 400)\n+                self.assertIn(\"error\", response.json)\n+\n+    def test_invalid_bodies(self):\n+        for body in [None, [], {}, {\"text\": 1}, {\"text\": None}]:\n+            response = self.client.post(\"/api/base64/encode\", json=body)\n+            self.assertEqual(response.status_code, 400)\n+        response = self.client.post(\"/api/base64/encode\", data=\"{\", content_type=\"application/json\")\n+        self.assertEqual(response.status_code, 400)\n+        response = self.client.post(\"/api/base64/encode\", json={\"text\": \"\\ud800\"})\n+        self.assertEqual(response.status_code, 400)\n+\n+    def test_accounts_and_logout(self):\n+        headers = self.account()\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=headers).json, {\"username\": \"alice\"})\n+        duplicate = self.client.post(\"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"another\"})\n+        self.assertEqual(duplicate.status_code, 409)\n+        incorrect = self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"})\n+        self.assertEqual(incorrect.status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).status_code, 401)\n+\n+    def test_authentication_required(self):\n+        for headers in [{}, {\"Authorization\": \"Bearer invalid\"}, {\"Authorization\": \"Basic invalid\"}]:\n+            self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).status_code, 401)\n+            self.assertEqual(self.save(headers).status_code, 401)\n+            self.assertEqual(self.client.delete(\"/api/conversions/1\", headers=headers).status_code, 401)\n+\n+    def test_private_history_and_delete(self):\n+        alice = self.account()\n+        bob = self.account(\"bob\")\n+        response = self.save(alice)\n+        self.assertEqual(response.status_code, 201)\n+        saved = response.json\n+        self.assertEqual(saved[\"output\"], \"SGVsbG8sIHdvcmxkIQ==\")\n+        self.assertEqual(set(saved), {\"id\", \"direction\", \"input_preview\", \"output_preview\", \"created_at\", \"output\"})\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=bob).json[\"total\"], 0)\n+        self.assertEqual(self.client.delete(f\"/api/conversions/{saved['id']}\", headers=bob).status_code, 404)\n+        listing = self.client.get(\"/api/conversions\", headers=alice).json\n+        self.assertEqual(listing[\"total\"], 1)\n+        self.assertNotIn(\"output\", listing[\"items\"][0])\n+        self.assertEqual(self.client.delete(f\"/api/conversions/{saved['id']}\", headers=alice).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=alice).json[\"total\"], 0)\n+\n+    def test_pagination_previews_and_persistence(self):\n+        headers = self.account()\n+        ids = [self.save(headers, str(index) * 200).json[\"id\"] for index in range(5)]\n+        listing = self.client.get(\"/api/conversions?page=2&page_size=2\", headers=headers).json\n+        self.assertEqual(listing[\"total\"], 5)\n+        self.assertEqual([item[\"id\"] for item in listing[\"items\"]], [ids[2], ids[1]])\n+        self.assertLessEqual(len(listing[\"items\"][0][\"input_preview\"]), 160)\n+        self.assertEqual(listing[\"page\"], 2)\n+        self.assertEqual(listing[\"page_size\"], 2)\n+        restarted = create_app(Path(self.directory.name)).test_client()\n+        self.assertEqual(restarted.get(\"/api/conversions\", headers=headers).json[\"total\"], 5)\n+\n+    def test_pagination_validation(self):\n+        headers = self.account()\n+        for query in [\"page=0\", \"page=-1\", \"page=abc\", \"page=1.5\", \"page_size=0\", \"page_size=101\", \"page=\"]:\n+            self.assertEqual(self.client.get(f\"/api/conversions?{query}\", headers=headers).status_code, 400)\n+\n+    def test_public_conversion_does_not_save(self):\n+        headers = self.account()\n+        self.client.post(\"/api/base64/encode\", headers=headers, json={\"text\": \"not saved\"})\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).json[\"total\"], 0)\n+        self.assertEqual(self.save(headers, \"\", \"encode\").json[\"output\"], \"\")\n+        self.assertEqual(self.save(headers, \"\", \"decode\").json[\"output\"], \"\")\n+        self.assertEqual(self.save(headers, \"!\", \"decode\").status_code, 400)\n+        self.assertEqual(self.save(headers, \"test\", \"other\").status_code, 400)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).json[\"total\"], 2)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** End Patch"},"output":"Success. Updated the following files:\nM backend/app.py\nA .gitignore\nA backend/test_app.py","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +1,291 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n+import base64\n+import binascii\n+import hashlib\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n from pathlib import Path\n \n-from flask import Flask\n-from flask import send_from_directory\n+from flask import Flask, abort, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n \n DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n \n-app = Flask(__name__, static_folder=None)\n \n+def database():\n+    if \"database\" not in g:\n+        g.database = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\n+        g.database.row_factory = sqlite3.Row\n+        g.database.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.database\n \n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n \n+def json_body():\n+    if not request.is_json:\n+        abort(400, description=\"Send a JSON object in the request body.\")\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        abort(400, description=\"Send a valid JSON object in the request body.\")\n+    return body\n \n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n+\n+def string_field(body, name):\n+    value = body.get(name)\n+    if not isinstance(value, str):\n+        abort(400, description=f\"'{name}' must be a string.\")\n+    return value\n+\n+\n+def credentials(body):\n+    username = string_field(body, \"username\").strip()\n+    password = string_field(body, \"password\")\n+    if not username or len(username) > 80:\n+        abort(400, description=\"Username must contain between 1 and 80 characters.\")\n+    if not password or len(password) > 1024:\n+        abort(400, description=\"Password must contain between 1 and 1024 characters.\")\n+    try:\n+        username.encode(\"utf-8\")\n+        password.encode(\"utf-8\")\n+    except UnicodeEncodeError:\n+        abort(400, description=\"Username and password must be valid UTF-8 text.\")\n+    return username, password\n+\n+\n+def convert(direction, value):\n+    if direction == \"encode\":\n+        try:\n+            return base64.b64encode(value.encode(\"utf-8\")).decode(\"ascii\")\n+        except UnicodeEncodeError:\n+            abort(400, description=\"The input must be valid UTF-8 text.\")\n+    if direction != \"decode\":\n+        abort(400, description=\"'direction' must be 'encode' or 'decode'.\")\n+    try:\n+        decoded = base64.b64decode(value, validate=True)\n+        if base64.b64encode(decoded).decode(\"ascii\") != value:\n+            raise ValueError\n+    except (binascii.Error, ValueError):\n+        abort(400, description=\"Invalid Base64. Use standard Base64 with correct padding and no whitespace.\")\n+    try:\n+        return decoded.decode(\"utf-8\")\n+    except UnicodeDecodeError:\n+        abort(400, description=\"The decoded data is not valid UTF-8 text.\")\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        authorization = request.headers.get(\"Authorization\", \"\").split()\n+        if len(authorization) != 2 or authorization[0].lower() != \"bearer\":\n+            abort(401, description=\"Please sign in to access your history.\")\n+        digest = hashlib.sha256(authorization[1].encode()).hexdigest()\n+        user = database().execute(\n+            \"SELECT users.id, users.username FROM tokens JOIN users ON users.id = tokens.user_id \"\n+            \"WHERE token_hash = ? AND expires_at > ?\",\n+            (digest, datetime.now(timezone.utc).isoformat()),\n+        ).fetchone()\n+        if user is None:\n+            abort(401, description=\"Your session has expired. Please sign in again.\")\n+        g.user = user\n+        g.token_hash = digest\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def conversion_object(row, include_output=False):\n+    def preview(value):\n+        return value if len(value) <= 160 else value[:159] + \"…\"\n+\n+    result = {\n+        \"id\": row[\"id\"],\n+        \"direction\": row[\"direction\"],\n+        \"input_preview\": preview(row[\"input\"]),\n+        \"output_preview\": preview(row[\"output\"]),\n+        \"created_at\": row[\"created_at\"],\n+    }\n+    if include_output:\n+        result[\"output\"] = row[\"output\"]\n+    return result\n+\n+\n+def create_app(data_dir=None):\n+    app = Flask(__name__, static_folder=None)\n+    directory = Path(data_dir or os.environ.get(\"DATA_DIR\", \"./data\"))\n+    directory.mkdir(parents=True, exist_ok=True)\n+    app.config.update(DATABASE=str(directory / \"base64.sqlite3\"), MAX_CONTENT_LENGTH=2 * 1024 * 1024)\n+    with app.app_context():\n+        db = database()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS tokens (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS conversions (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                direction TEXT NOT NULL CHECK (direction IN ('encode', 'decode')),\n+                input TEXT NOT NULL,\n+                output TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS conversions_user_id ON conversions(user_id, id DESC);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"database\", None)\n+\n+    @app.teardown_appcontext\n+    def close_database(exception=None):\n+        db = g.pop(\"database\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n+            \"img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        username, password = credentials(json_body())\n+        db = database()\n+        try:\n+            cursor = db.execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            abort(409, description=\"That username is already taken. Try another one.\")\n+        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        username, password = credentials(json_body())\n+        db = database()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            abort(401, description=\"Incorrect username or password.\")\n+        token = secrets.token_urlsafe(32)\n+        now = datetime.now(timezone.utc)\n+        db.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n+        db.execute(\n+            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], (now + timedelta(days=30)).isoformat()),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = database()\n+        db.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n+        db.commit()\n+        return \"\", 204\n+\n+    @app.post(\"/api/base64/encode\")\n+    def encode():\n+        return {\"encoded\": convert(\"encode\", string_field(json_body(), \"text\"))}\n+\n+    @app.post(\"/api/base64/decode\")\n+    def decode():\n+        return {\"text\": convert(\"decode\", string_field(json_body(), \"encoded\"))}\n+\n+    @app.post(\"/api/conversions\")\n+    @authenticated\n+    def save_conversion():\n+        body = json_body()\n+        direction = string_field(body, \"direction\")\n+        value = string_field(body, \"input\")\n+        output = convert(direction, value)\n+        db = database()\n+        cursor = db.execute(\n+            \"INSERT INTO conversions (user_id, direction, input, output, created_at) VALUES (?, ?, ?, ?, ?)\",\n+            (g.user[\"id\"], direction, value, output, datetime.now(timezone.utc).isoformat()),\n+        )\n+        db.commit()\n+        row = db.execute(\"SELECT * FROM conversions WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n+        return conversion_object(row, include_output=True), 201\n+\n+    @app.get(\"/api/conversions\")\n+    @authenticated\n+    def history():\n+        def positive_integer(name, default, maximum):\n+            raw = request.args.get(name, str(default))\n+            if not raw.isascii() or not raw.isdecimal() or len(raw) > 10:\n+                abort(400, description=f\"'{name}' must be a positive integer up to {maximum}.\")\n+            value = int(raw)\n+            if not 1 <= value <= maximum:\n+                abort(400, description=f\"'{name}' must be a positive integer up to {maximum}.\")\n+            return value\n+\n+        page = positive_integer(\"page\", 1, 1_000_000_000)\n+        page_size = positive_integer(\"page_size\", 10, 100)\n+        db = database()\n+        total = db.execute(\"SELECT COUNT(*) FROM conversions WHERE user_id = ?\", (g.user[\"id\"],)).fetchone()[0]\n+        rows = db.execute(\n+            \"SELECT * FROM conversions WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n+            (g.user[\"id\"], page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        return {\"items\": [conversion_object(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.delete(\"/api/conversions/<int:conversion_id>\")\n+    @authenticated\n+    def delete_conversion(conversion_id):\n+        db = database()\n+        cursor = db.execute(\"DELETE FROM conversions WHERE id = ? AND user_id = ?\", (conversion_id, g.user[\"id\"]))\n+        db.commit()\n+        if cursor.rowcount == 0:\n+            abort(404, description=\"Conversion not found.\")\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            abort(404, description=\"API endpoint not found.\")\n+        candidate = (DIST / path).resolve()\n+        if candidate.is_relative_to(DIST) and candidate.is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+**/.venv/\n+data/\n+.ruff_cache/\n+.pytest_cache/\n\nIndex: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,122 @@\n+import base64\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from app import create_app\n+\n+\n+class ApiTest(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.app = create_app(self.directory.name)\n+        self.app.config[\"TESTING\"] = True\n+        self.client = self.app.test_client()\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username=\"alice\"):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def save(self, headers, value=\"Hello, world!\", direction=\"encode\"):\n+        return self.client.post(\"/api/conversions\", headers=headers, json={\"direction\": direction, \"input\": value})\n+\n+    def test_health_and_unknown_api(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        response = self.client.get(\"/api/missing\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertIn(\"error\", response.json)\n+\n+    def test_utf8_and_empty_roundtrip(self):\n+        for text in [\"\", \"Hello, world!\", \"你好 🌍 café\\n\\t\", \"\\x00\"]:\n+            with self.subTest(text=text):\n+                encoded = self.client.post(\"/api/base64/encode\", json={\"text\": text})\n+                self.assertEqual(encoded.status_code, 200)\n+                self.assertEqual(encoded.json[\"encoded\"], base64.b64encode(text.encode()).decode())\n+                decoded = self.client.post(\"/api/base64/decode\", json=encoded.json)\n+                self.assertEqual(decoded.status_code, 200)\n+                self.assertEqual(decoded.json, {\"text\": text})\n+\n+    def test_invalid_base64(self):\n+        for encoded in [\"not base64!\", \"a\", \"Zg\", \"Zg===\", \"Zh==\", \"SGVsbG8=\\n\", \"_-==\", \"你好\", \"/w==\"]:\n+            with self.subTest(encoded=encoded):\n+                response = self.client.post(\"/api/base64/decode\", json={\"encoded\": encoded})\n+                self.assertEqual(response.status_code, 400)\n+                self.assertIn(\"error\", response.json)\n+\n+    def test_invalid_bodies(self):\n+        for body in [None, [], {}, {\"text\": 1}, {\"text\": None}]:\n+            response = self.client.post(\"/api/base64/encode\", json=body)\n+            self.assertEqual(response.status_code, 400)\n+        response = self.client.post(\"/api/base64/encode\", data=\"{\", content_type=\"application/json\")\n+        self.assertEqual(response.status_code, 400)\n+        response = self.client.post(\"/api/base64/encode\", json={\"text\": \"\\ud800\"})\n+        self.assertEqual(response.status_code, 400)\n+\n+    def test_accounts_and_logout(self):\n+        headers = self.account()\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=headers).json, {\"username\": \"alice\"})\n+        duplicate = self.client.post(\"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"another\"})\n+        self.assertEqual(duplicate.status_code, 409)\n+        incorrect = self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"})\n+        self.assertEqual(incorrect.status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).status_code, 401)\n+\n+    def test_authentication_required(self):\n+        for headers in [{}, {\"Authorization\": \"Bearer invalid\"}, {\"Authorization\": \"Basic invalid\"}]:\n+            self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).status_code, 401)\n+            self.assertEqual(self.save(headers).status_code, 401)\n+            self.assertEqual(self.client.delete(\"/api/conversions/1\", headers=headers).status_code, 401)\n+\n+    def test_private_history_and_delete(self):\n+        alice = self.account()\n+        bob = self.account(\"bob\")\n+        response = self.save(alice)\n+        self.assertEqual(response.status_code, 201)\n+        saved = response.json\n+        self.assertEqual(saved[\"output\"], \"SGVsbG8sIHdvcmxkIQ==\")\n+        self.assertEqual(set(saved), {\"id\", \"direction\", \"input_preview\", \"output_preview\", \"created_at\", \"output\"})\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=bob).json[\"total\"], 0)\n+        self.assertEqual(self.client.delete(f\"/api/conversions/{saved['id']}\", headers=bob).status_code, 404)\n+        listing = self.client.get(\"/api/conversions\", headers=alice).json\n+        self.assertEqual(listing[\"total\"], 1)\n+        self.assertNotIn(\"output\", listing[\"items\"][0])\n+        self.assertEqual(self.client.delete(f\"/api/conversions/{saved['id']}\", headers=alice).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=alice).json[\"total\"], 0)\n+\n+    def test_pagination_previews_and_persistence(self):\n+        headers = self.account()\n+        ids = [self.save(headers, str(index) * 200).json[\"id\"] for index in range(5)]\n+        listing = self.client.get(\"/api/conversions?page=2&page_size=2\", headers=headers).json\n+        self.assertEqual(listing[\"total\"], 5)\n+        self.assertEqual([item[\"id\"] for item in listing[\"items\"]], [ids[2], ids[1]])\n+        self.assertLessEqual(len(listing[\"items\"][0][\"input_preview\"]), 160)\n+        self.assertEqual(listing[\"page\"], 2)\n+        self.assertEqual(listing[\"page_size\"], 2)\n+        restarted = create_app(Path(self.directory.name)).test_client()\n+        self.assertEqual(restarted.get(\"/api/conversions\", headers=headers).json[\"total\"], 5)\n+\n+    def test_pagination_validation(self):\n+        headers = self.account()\n+        for query in [\"page=0\", \"page=-1\", \"page=abc\", \"page=1.5\", \"page_size=0\", \"page_size=101\", \"page=\"]:\n+            self.assertEqual(self.client.get(f\"/api/conversions?{query}\", headers=headers).status_code, 400)\n+\n+    def test_public_conversion_does_not_save(self):\n+        headers = self.account()\n+        self.client.post(\"/api/base64/encode\", headers=headers, json={\"text\": \"not saved\"})\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).json[\"total\"], 0)\n+        self.assertEqual(self.save(headers, \"\", \"encode\").json[\"output\"], \"\")\n+        self.assertEqual(self.save(headers, \"\", \"decode\").json[\"output\"], \"\")\n+        self.assertEqual(self.save(headers, \"!\", \"decode\").status_code, 400)\n+        self.assertEqual(self.save(headers, \"test\", \"other\").status_code, 400)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).json[\"total\"], 2)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"update","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +1,291 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n+import base64\n+import binascii\n+import hashlib\n+import os\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n from pathlib import Path\n \n-from flask import Flask\n-from flask import send_from_directory\n+from flask import Flask, abort, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n \n DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n \n-app = Flask(__name__, static_folder=None)\n \n+def database():\n+    if \"database\" not in g:\n+        g.database = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=10)\n+        g.database.row_factory = sqlite3.Row\n+        g.database.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.database\n \n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n \n+def json_body():\n+    if not request.is_json:\n+        abort(400, description=\"Send a JSON object in the request body.\")\n+    body = request.get_json(silent=True)\n+    if not isinstance(body, dict):\n+        abort(400, description=\"Send a valid JSON object in the request body.\")\n+    return body\n \n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n+\n+def string_field(body, name):\n+    value = body.get(name)\n+    if not isinstance(value, str):\n+        abort(400, description=f\"'{name}' must be a string.\")\n+    return value\n+\n+\n+def credentials(body):\n+    username = string_field(body, \"username\").strip()\n+    password = string_field(body, \"password\")\n+    if not username or len(username) > 80:\n+        abort(400, description=\"Username must contain between 1 and 80 characters.\")\n+    if not password or len(password) > 1024:\n+        abort(400, description=\"Password must contain between 1 and 1024 characters.\")\n+    try:\n+        username.encode(\"utf-8\")\n+        password.encode(\"utf-8\")\n+    except UnicodeEncodeError:\n+        abort(400, description=\"Username and password must be valid UTF-8 text.\")\n+    return username, password\n+\n+\n+def convert(direction, value):\n+    if direction == \"encode\":\n+        try:\n+            return base64.b64encode(value.encode(\"utf-8\")).decode(\"ascii\")\n+        except UnicodeEncodeError:\n+            abort(400, description=\"The input must be valid UTF-8 text.\")\n+    if direction != \"decode\":\n+        abort(400, description=\"'direction' must be 'encode' or 'decode'.\")\n+    try:\n+        decoded = base64.b64decode(value, validate=True)\n+        if base64.b64encode(decoded).decode(\"ascii\") != value:\n+            raise ValueError\n+    except (binascii.Error, ValueError):\n+        abort(400, description=\"Invalid Base64. Use standard Base64 with correct padding and no whitespace.\")\n+    try:\n+        return decoded.decode(\"utf-8\")\n+    except UnicodeDecodeError:\n+        abort(400, description=\"The decoded data is not valid UTF-8 text.\")\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        authorization = request.headers.get(\"Authorization\", \"\").split()\n+        if len(authorization) != 2 or authorization[0].lower() != \"bearer\":\n+            abort(401, description=\"Please sign in to access your history.\")\n+        digest = hashlib.sha256(authorization[1].encode()).hexdigest()\n+        user = database().execute(\n+            \"SELECT users.id, users.username FROM tokens JOIN users ON users.id = tokens.user_id \"\n+            \"WHERE token_hash = ? AND expires_at > ?\",\n+            (digest, datetime.now(timezone.utc).isoformat()),\n+        ).fetchone()\n+        if user is None:\n+            abort(401, description=\"Your session has expired. Please sign in again.\")\n+        g.user = user\n+        g.token_hash = digest\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def conversion_object(row, include_output=False):\n+    def preview(value):\n+        return value if len(value) <= 160 else value[:159] + \"…\"\n+\n+    result = {\n+        \"id\": row[\"id\"],\n+        \"direction\": row[\"direction\"],\n+        \"input_preview\": preview(row[\"input\"]),\n+        \"output_preview\": preview(row[\"output\"]),\n+        \"created_at\": row[\"created_at\"],\n+    }\n+    if include_output:\n+        result[\"output\"] = row[\"output\"]\n+    return result\n+\n+\n+def create_app(data_dir=None):\n+    app = Flask(__name__, static_folder=None)\n+    directory = Path(data_dir or os.environ.get(\"DATA_DIR\", \"./data\"))\n+    directory.mkdir(parents=True, exist_ok=True)\n+    app.config.update(DATABASE=str(directory / \"base64.sqlite3\"), MAX_CONTENT_LENGTH=2 * 1024 * 1024)\n+    with app.app_context():\n+        db = database()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS tokens (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS conversions (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                direction TEXT NOT NULL CHECK (direction IN ('encode', 'decode')),\n+                input TEXT NOT NULL,\n+                output TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS conversions_user_id ON conversions(user_id, id DESC);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"database\", None)\n+\n+    @app.teardown_appcontext\n+    def close_database(exception=None):\n+        db = g.pop(\"database\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(error):\n+        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n+            return {\"error\": error.description}, error.code\n+        return error\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n+            \"img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        username, password = credentials(json_body())\n+        db = database()\n+        try:\n+            cursor = db.execute(\n+                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                (username, generate_password_hash(password)),\n+            )\n+            db.commit()\n+        except sqlite3.IntegrityError:\n+            db.rollback()\n+            abort(409, description=\"That username is already taken. Try another one.\")\n+        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        username, password = credentials(json_body())\n+        db = database()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            abort(401, description=\"Incorrect username or password.\")\n+        token = secrets.token_urlsafe(32)\n+        now = datetime.now(timezone.utc)\n+        db.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now.isoformat(),))\n+        db.execute(\n+            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+            (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], (now + timedelta(days=30)).isoformat()),\n+        )\n+        db.commit()\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = database()\n+        db.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n+        db.commit()\n+        return \"\", 204\n+\n+    @app.post(\"/api/base64/encode\")\n+    def encode():\n+        return {\"encoded\": convert(\"encode\", string_field(json_body(), \"text\"))}\n+\n+    @app.post(\"/api/base64/decode\")\n+    def decode():\n+        return {\"text\": convert(\"decode\", string_field(json_body(), \"encoded\"))}\n+\n+    @app.post(\"/api/conversions\")\n+    @authenticated\n+    def save_conversion():\n+        body = json_body()\n+        direction = string_field(body, \"direction\")\n+        value = string_field(body, \"input\")\n+        output = convert(direction, value)\n+        db = database()\n+        cursor = db.execute(\n+            \"INSERT INTO conversions (user_id, direction, input, output, created_at) VALUES (?, ?, ?, ?, ?)\",\n+            (g.user[\"id\"], direction, value, output, datetime.now(timezone.utc).isoformat()),\n+        )\n+        db.commit()\n+        row = db.execute(\"SELECT * FROM conversions WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n+        return conversion_object(row, include_output=True), 201\n+\n+    @app.get(\"/api/conversions\")\n+    @authenticated\n+    def history():\n+        def positive_integer(name, default, maximum):\n+            raw = request.args.get(name, str(default))\n+            if not raw.isascii() or not raw.isdecimal() or len(raw) > 10:\n+                abort(400, description=f\"'{name}' must be a positive integer up to {maximum}.\")\n+            value = int(raw)\n+            if not 1 <= value <= maximum:\n+                abort(400, description=f\"'{name}' must be a positive integer up to {maximum}.\")\n+            return value\n+\n+        page = positive_integer(\"page\", 1, 1_000_000_000)\n+        page_size = positive_integer(\"page_size\", 10, 100)\n+        db = database()\n+        total = db.execute(\"SELECT COUNT(*) FROM conversions WHERE user_id = ?\", (g.user[\"id\"],)).fetchone()[0]\n+        rows = db.execute(\n+            \"SELECT * FROM conversions WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?\",\n+            (g.user[\"id\"], page_size, (page - 1) * page_size),\n+        ).fetchall()\n+        return {\"items\": [conversion_object(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.delete(\"/api/conversions/<int:conversion_id>\")\n+    @authenticated\n+    def delete_conversion(conversion_id):\n+        db = database()\n+        cursor = db.execute(\"DELETE FROM conversions WHERE id = ? AND user_id = ?\", (conversion_id, g.user[\"id\"]))\n+        db.commit()\n+        if cursor.rowcount == 0:\n+            abort(404, description=\"Conversion not found.\")\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            abort(404, description=\"API endpoint not found.\")\n+        candidate = (DIST / path).resolve()\n+        if candidate.is_relative_to(DIST) and candidate.is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n","additions":282,"deletions":14},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+**/.venv/\n+data/\n+.ruff_cache/\n+.pytest_cache/\n","additions":7,"deletions":0},{"filePath":"/workspace/backend/test_app.py","relativePath":"backend/test_app.py","type":"add","patch":"Index: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,122 @@\n+import base64\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from app import create_app\n+\n+\n+class ApiTest(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.app = create_app(self.directory.name)\n+        self.app.config[\"TESTING\"] = True\n+        self.client = self.app.test_client()\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username=\"alice\"):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"test-password\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def save(self, headers, value=\"Hello, world!\", direction=\"encode\"):\n+        return self.client.post(\"/api/conversions\", headers=headers, json={\"direction\": direction, \"input\": value})\n+\n+    def test_health_and_unknown_api(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        response = self.client.get(\"/api/missing\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertIn(\"error\", response.json)\n+\n+    def test_utf8_and_empty_roundtrip(self):\n+        for text in [\"\", \"Hello, world!\", \"你好 🌍 café\\n\\t\", \"\\x00\"]:\n+            with self.subTest(text=text):\n+                encoded = self.client.post(\"/api/base64/encode\", json={\"text\": text})\n+                self.assertEqual(encoded.status_code, 200)\n+                self.assertEqual(encoded.json[\"encoded\"], base64.b64encode(text.encode()).decode())\n+                decoded = self.client.post(\"/api/base64/decode\", json=encoded.json)\n+                self.assertEqual(decoded.status_code, 200)\n+                self.assertEqual(decoded.json, {\"text\": text})\n+\n+    def test_invalid_base64(self):\n+        for encoded in [\"not base64!\", \"a\", \"Zg\", \"Zg===\", \"Zh==\", \"SGVsbG8=\\n\", \"_-==\", \"你好\", \"/w==\"]:\n+            with self.subTest(encoded=encoded):\n+                response = self.client.post(\"/api/base64/decode\", json={\"encoded\": encoded})\n+                self.assertEqual(response.status_code, 400)\n+                self.assertIn(\"error\", response.json)\n+\n+    def test_invalid_bodies(self):\n+        for body in [None, [], {}, {\"text\": 1}, {\"text\": None}]:\n+            response = self.client.post(\"/api/base64/encode\", json=body)\n+            self.assertEqual(response.status_code, 400)\n+        response = self.client.post(\"/api/base64/encode\", data=\"{\", content_type=\"application/json\")\n+        self.assertEqual(response.status_code, 400)\n+        response = self.client.post(\"/api/base64/encode\", json={\"text\": \"\\ud800\"})\n+        self.assertEqual(response.status_code, 400)\n+\n+    def test_accounts_and_logout(self):\n+        headers = self.account()\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=headers).json, {\"username\": \"alice\"})\n+        duplicate = self.client.post(\"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"another\"})\n+        self.assertEqual(duplicate.status_code, 409)\n+        incorrect = self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"})\n+        self.assertEqual(incorrect.status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).status_code, 401)\n+\n+    def test_authentication_required(self):\n+        for headers in [{}, {\"Authorization\": \"Bearer invalid\"}, {\"Authorization\": \"Basic invalid\"}]:\n+            self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).status_code, 401)\n+            self.assertEqual(self.save(headers).status_code, 401)\n+            self.assertEqual(self.client.delete(\"/api/conversions/1\", headers=headers).status_code, 401)\n+\n+    def test_private_history_and_delete(self):\n+        alice = self.account()\n+        bob = self.account(\"bob\")\n+        response = self.save(alice)\n+        self.assertEqual(response.status_code, 201)\n+        saved = response.json\n+        self.assertEqual(saved[\"output\"], \"SGVsbG8sIHdvcmxkIQ==\")\n+        self.assertEqual(set(saved), {\"id\", \"direction\", \"input_preview\", \"output_preview\", \"created_at\", \"output\"})\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=bob).json[\"total\"], 0)\n+        self.assertEqual(self.client.delete(f\"/api/conversions/{saved['id']}\", headers=bob).status_code, 404)\n+        listing = self.client.get(\"/api/conversions\", headers=alice).json\n+        self.assertEqual(listing[\"total\"], 1)\n+        self.assertNotIn(\"output\", listing[\"items\"][0])\n+        self.assertEqual(self.client.delete(f\"/api/conversions/{saved['id']}\", headers=alice).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=alice).json[\"total\"], 0)\n+\n+    def test_pagination_previews_and_persistence(self):\n+        headers = self.account()\n+        ids = [self.save(headers, str(index) * 200).json[\"id\"] for index in range(5)]\n+        listing = self.client.get(\"/api/conversions?page=2&page_size=2\", headers=headers).json\n+        self.assertEqual(listing[\"total\"], 5)\n+        self.assertEqual([item[\"id\"] for item in listing[\"items\"]], [ids[2], ids[1]])\n+        self.assertLessEqual(len(listing[\"items\"][0][\"input_preview\"]), 160)\n+        self.assertEqual(listing[\"page\"], 2)\n+        self.assertEqual(listing[\"page_size\"], 2)\n+        restarted = create_app(Path(self.directory.name)).test_client()\n+        self.assertEqual(restarted.get(\"/api/conversions\", headers=headers).json[\"total\"], 5)\n+\n+    def test_pagination_validation(self):\n+        headers = self.account()\n+        for query in [\"page=0\", \"page=-1\", \"page=abc\", \"page=1.5\", \"page_size=0\", \"page_size=101\", \"page=\"]:\n+            self.assertEqual(self.client.get(f\"/api/conversions?{query}\", headers=headers).status_code, 400)\n+\n+    def test_public_conversion_does_not_save(self):\n+        headers = self.account()\n+        self.client.post(\"/api/base64/encode\", headers=headers, json={\"text\": \"not saved\"})\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).json[\"total\"], 0)\n+        self.assertEqual(self.save(headers, \"\", \"encode\").json[\"output\"], \"\")\n+        self.assertEqual(self.save(headers, \"\", \"decode\").json[\"output\"], \"\")\n+        self.assertEqual(self.save(headers, \"!\", \"decode\").status_code, 400)\n+        self.assertEqual(self.save(headers, \"test\", \"other\").status_code, 400)\n+        self.assertEqual(self.client.get(\"/api/conversions\", headers=headers).json[\"total\"], 2)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":122,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM backend/app.py\nA .gitignore\nA backend/test_app.py","time":{"start":1794314979065,"end":1794314979107}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c580cbbd001XI5He45CY5wxwr","sessionID":"ses_e3a801e1dffegVWZJ0Q16Bat5g","messageID":"msg_1c580c4b5001B2o2OY29g5jcka"}}
