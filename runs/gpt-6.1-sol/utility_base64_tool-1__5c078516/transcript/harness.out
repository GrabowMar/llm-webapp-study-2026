 }).click();\n74:   await page.getByRole(\"alert\").waitFor();\n75:   assert.match(await page.getByRole(\"alert\").innerText(), /Incorrect username or password/);\n76:   await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-test-password\");\n77:   await page.getByRole(\"dialog\").getByRole(\"button\", { name: \"Sign in\", exact: true }).click();\n78:   await page.getByRole(\"heading\", { name: \"Your history\", exact: true }).waitFor();\n79:   await page.getByRole(\"button\", { name: \"Sign out\", exact: true }).click();\n80:   await page.getByRole(\"button\", { name: \"Sign in\", exact: true }).waitFor();\n81:   await page.getByRole(\"button\", { name: \"API reference\", exact: true }).first().click();\n82:   await page.getByRole(\"dialog\", { name: \"API reference\" }).waitFor();\n83:   await page.keyboard.press(\"Escape\");\n84:   await page.getByText(\"A quick note on Base64\", { exact: true }).click();\n85:   assert.equal(await page.locator(\"details\").getAttribute(\"open\"), \"\");\n86:   assert.deepEqual(errors, []);\n87:   const mobile = await browser.newPage({ viewport: { width: 390, height: 844 }, isMobile: true, deviceScaleFactor: 1 });\n88:   await mobile.goto(root);\n89:   assert.equal(await mobile.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth), true);\n90:   await mobile.getByRole(\"button\", { name: \"Try an example\" }).click();\n91:   await mobile.getByRole(\"button\", { name: \"Encode text\", exact: true }).click();\n92:   await mobile.waitForFunction(() => document.querySelector(\"#converter-output\").value === \"SGVsbG8sIHdvcmxkIQ==\");\n93:   await mobile.screenshot({ path: \"node_modules/.cache/mobile.png\", fullPage: true });\n94:   console.log(\"Browser smoke tests passed: conversion, clipboard, empty input, errors, registration, login, logout, persistence, history paging/deletion, API docs, and mobile layout.\");\n95: } finally {\n96:   if (browser) await browser.close();\n97:   server.kill(\"SIGTER