{"type":"tool_use","timestamp":1794313038471,"sessionID":"ses_e3ab6a190ffeefD3lk4C1wi2O7","part":{"type":"tool","tool":"read","callID":"call_cHroftyKz7tI8Q5dS8wpyAjN","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: import hashlib\n2: import os\n3: import re\n4: import secrets\n5: import sqlite3\n6: import time\n7: from datetime import UTC, datetime\n8: from functools import wraps\n9: from pathlib import Path\n10: from urllib.parse import urlsplit\n11: \n12: from flask import Flask, abort, g, redirect, request, send_from_directory\n13: from werkzeug.exceptions import HTTPException\n14: from werkzeug.security import check_password_hash, generate_password_hash\n15: from werkzeug.utils import safe_join\n16: \n17: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n18: LINK_QUERY = \"\"\"\n19:     SELECT links.*, users.username AS owner\n20:     FROM links JOIN users ON users.id = links.owner_id\n21: \"\"\"\n22: \n23: \n24: def create_app(config=None):\n25:     app = Flask(__name__, static_folder=None)\n26:     app.config.update(\n27:         DATABASE=str(Path(\"data\") / \"shortlinks.sqlite3\"),\n28:         ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n29:         MAX_CONTENT_LENGTH=32 * 1024,\n30:     )\n31:     if config:\n32:         app.config.update(config)\n33: \n34:     Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n35: \n36:     def database():\n37:         if \"db\" not in g:\n38:             g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=20)\n39:             g.db.row_factory = sqlite3.Row\n40:             g.db.execute(\"PRAGMA foreign_keys = ON\")\n41:         return g.db\n42: \n43:     @app.teardown_appcontext\n44:     def close_database(_error):\n45:         db = g.pop(\"db\", None)\n46:         if db is not None:\n47:             db.close()\n48: \n49:     with app.app_context():\n50:         db = database()\n51:         db.execute(\"PRAGMA journal_mode = WAL\")\n52:         db.executescript(\"\"\"\n53:             CREATE TABLE IF NOT EXISTS users (\n54:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n55:                 username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n56:                 password_hash TEXT NOT NULL,\n57:                 is_admin INTEGER NOT NULL DEFAULT 0\n58:             );\n59:             CREATE TABLE IF NOT EXISTS sessions (\n60:                 token_hash TEXT PRIMARY KEY,\n61:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n62:                 expires_at INTEGER NOT NULL\n63:             );\n64:             CREATE TABLE IF NOT EXISTS links (\n65:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n66:                 original_url TEXT NOT NULL,\n67:                 short_code TEXT NOT NULL UNIQUE,\n68:                 click_count INTEGER NOT NULL DEFAULT 0,\n69:                 created_at TEXT NOT NULL,\n70:                 owner_id INTEGER NOT NULL REFERENCES users(id),\n71:                 is_active INTEGER NOT NULL DEFAULT 1\n72:             );\n73:             CREATE INDEX IF NOT EXISTS links_active_newest ON links(is_active, id DESC);\n74:             CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n75:         \"\"\")\n76:         admin = db.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n77:         password = app.config[\"ADMIN_PASSWORD\"]\n78:         with db:\n79:             if admin is None:\n80:                 db.execute(\n81:                     \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n82:                     (generate_password_hash(password) if password else \"\",),\n83:                 )\n84:             elif not password or not check_password_hash(admin[\"password_hash\"], password):\n85:                 db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n86:                 db.execute(\n87:                     \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n88:                     (generate_password_hash(password) if password else \"\", admin[\"id\"]),\n89:                 )\n90: \n91:     def error(message, status=400):\n92:         return {\"error\": message}, status\n93: \n94:     def json_body():\n95:         body = request.get_json(silent=True)\n96:         if not isinstance(body, dict):\n97:             abort(400, description=\"Send a JSON object in the request body.\")\n98:         return body\n99: \n100:     def credentials():\n101:         body = json_body()\n102:         username, password = body.get(\"username\"), body.get(\"password\")\n103:         if not isinstance(username, str) or not re.fullmatch(r\"[A-Za-z0-9_.-]{1,32}\", username):\n104:             abort(400, description=\"Username must be 1–32 letters, numbers, dots, dashes, or underscores.\")\n105:         if not isinstance(password, str) or not password or len(password) > 256:\n106:             abort(400, description=\"Password must be between 1 and 256 characters.\")\n107:         return username, password\n108: \n109:     def authenticated(admin_only=False):\n110:         def decorator(view):\n111:             @wraps(view)\n112:             def wrapped(*args, **kwargs):\n113:                 parts = request.headers.get(\"Authorization\", \"\").split()\n114:                 if len(parts) != 2 or parts[0].lower() != \"bearer\" or len(parts[1]) > 256:\n115:                     return error(\"Please sign in to continue.\", 401)\n116:                 token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n117:                 g.user = database().execute(\n118:                     \"\"\"SELECT users.* FROM sessions JOIN users ON users.id = sessions.user_id\n119:                     WHERE token_hash = ? AND expires_at > ?\"\"\",\n120:                     (token_hash, int(time.time())),\n121:                 ).fetchone()\n122:                 if g.user is None or (g.user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"]):\n123:                     return error(\"Your session has expired. Please sign in again.\", 401)\n124:                 if admin_only and not g.user[\"is_admin\"]:\n125:                     return error(\"Administrator access is required.\", 403)\n126:                 g.token_hash = token_hash\n127:                 return view(*args, **kwargs)\n128: \n129:             return wrapped\n130: \n131:         return decorator\n132: \n133:     def serialize_link(row):\n134:         return {\n135:             \"id\": row[\"id\"],\n136:             \"original_url\": row[\"original_url\"],\n137:             \"short_code\": row[\"short_code\"],\n138:             \"click_count\": row[\"click_count\"],\n139:             \"created_at\": row[\"created_at\"],\n140:             \"short_url\": f\"/r/{row['short_code']}\",\n141:             \"owner\": row[\"owner\"],\n142:             \"is_active\": bool(row[\"is_active\"]),\n143:         }\n144: \n145:     def paged_links(include_disabled=False, owner_id=None):\n146:         try:\n147:             page = int(request.args.get(\"page\", \"1\"))\n148:             page_size = int(request.args.get(\"page_size\", \"10\"))\n149:         except ValueError:\n150:             return error(\"Page and page_size must be whole numbers.\")\n151:         if page < 1 or not 1 <= page_size <= 100 or page > 2147483647:\n152:             return error(\"Page must be positive and page_size must be between 1 and 100.\")\n153:         conditions = [] if include_disabled else [\"links.is_active = 1\"]\n154:         parameters = []\n155:         if owner_id is not None:\n156:             conditions.append(\"links.owner_id = ?\")\n157:             parameters.append(owner_id)\n158:         query = request.args.get(\"q\", \"\").strip()[:256]\n159:         if query:\n160:             conditions.append(\"(links.original_url LIKE ? OR links.short_code LIKE ?)\")\n161:             parameters.extend([f\"%{query}%\", f\"%{query}%\"])\n162:         where = \" WHERE \" + \" AND \".join(conditions) if conditions else \"\"\n163:         db = database()\n164:         with db:\n165:             db.execute(\"BEGIN\")\n166:             total = db.execute(\"SELECT COUNT(*) FROM links\" + where, parameters).fetchone()[0]\n167:             rows = db.execute(\n168:                 LINK_QUERY + where + \" ORDER BY links.id DESC LIMIT ? OFFSET ?\",\n169:                 [*parameters, page_size, (page - 1) * page_size],\n170:             ).fetchall()\n171:         return {\"items\": [serialize_link(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n172: \n173:     @app.get(\"/api/health\")\n174:     def health():\n175:         return {\"status\": \"ok\"}\n176: \n177:     @app.post(\"/api/auth/register\")\n178:     def register():\n179:         username, password = credentials()\n180:         if username.lower() == \"admin\":\n181:             return error(\"This username is reserved.\", 409)\n182:         db = database()\n183:         try:\n184:             with db:\n185:                 cursor = db.execute(\n186:                     \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n187:                     (username, generate_password_hash(password)),\n188:                 )\n189:         except sqlite3.IntegrityError:\n190:             return error(\"That username is already taken.\", 409)\n191:         return {\"id\": cursor.lastrowid, \"username\": username}, 201\n192: \n193:     @app.post(\"/api/auth/login\")\n194:     def login():\n195:         username, password = credentials()\n196:         db = database()\n197:         user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n198:         if (\n199:             user is None\n200:             or (user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"])\n201:             or not check_password_hash(user[\"password_hash\"], password)\n202:         ):\n203:             return error(\"Incorrect username or password.\", 401)\n204:         token = secrets.token_urlsafe(32)\n205:         with db:\n206:             db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (int(time.time()),))\n207:             db.execute(\n208:                 \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n209:                 (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], int(time.time()) + 30 * 86400),\n210:             )\n211:         return {\"token\": token}\n212: \n213:     @app.get(\"/api/auth/me\")\n214:     @authenticated()\n215:     def current_user():\n216:         return {\"id\": g.user[\"id\"], \"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n217: \n218:     @app.post(\"/api/auth/logout\")\n219:     @authenticated()\n220:     def logout():\n221:         db = database()\n222:         with db:\n223:             db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n224:         return \"\", 204\n225: \n226:     @app.post(\"/api/links\")\n227:     @authenticated()\n228:     def create_link():\n229:         url = json_body().get(\"original_url\")\n230:         if not isinstance(url, str) or not url.strip():\n231:             return error(\"Enter an address to shorten.\")\n232:         url = url.strip()\n233:         try:\n234:             parsed = urlsplit(url)\n235:             valid = parsed.scheme in (\"http\", \"https\") and bool(parsed.hostname)\n236:             _ = parsed.port\n237:             if len(url) > 8192 or any(char.isspace() or ord(char) < 32 or ord(char) == 127 for char in url):\n238:                 valid = False\n239:         except ValueError:\n240:             valid = False\n241:         if not valid:\n242:             return error(\"Enter a valid URL beginning with http:// or https:// (up to 8,192 characters).\")\n243:         db = database()\n244:         for _ in range(5):\n245:             code = secrets.token_urlsafe(6)\n246:             try:\n247:                 with db:\n248:                     cursor = db.execute(\n249:                         \"\"\"INSERT INTO links (original_url, short_code, created_at, owner_id)\n250:                         VALUES (?, ?, ?, ?)\"\"\",\n251:                         (url, code, datetime.now(UTC).isoformat(), g.user[\"id\"]),\n252:                     )\n253:                 row = db.execute(LINK_QUERY + \" WHERE links.id = ?\", (cursor.lastrowid,)).fetchone()\n254:                 return serialize_link(row), 201\n255:             except sqlite3.IntegrityError:\n256:                 continue\n257:         return error(\"Could not generate a short link. Please try again.\", 503)\n258: \n259:     @app.get(\"/api/links\")\n260:     def list_links():\n261:         return paged_links()\n262: \n263:     @app.get(\"/api/links/mine\")\n264:     @authenticated()\n265:     def my_links():\n266:         return paged_links(owner_id=g.user[\"id\"])\n267: \n268:     @app.get(\"/api/stats\")\n269:     def stats():\n270:         row = database().execute(\n271:             \"\"\"SELECT COUNT(*) AS total_links, COALESCE(SUM(click_count), 0) AS total_clicks,\n272:             COALESCE(SUM(substr(created_at, 1, 10) = ?), 0) AS links_today\n273:             FROM links WHERE is_active = 1\"\"\",\n274:             (datetime.now(UTC).date().isoformat(),),\n275:         ).fetchone()\n276:         return dict(row)\n277: \n278:     @app.get(\"/api/links/<int:link_id>\")\n279:     def get_link(link_id):\n280:         row = database().execute(\n281:             LINK_QUERY + \" WHERE links.id = ? AND links.is_active = 1\", (link_id,)\n282:         ).fetchone()\n283:         if row is None:\n284:             return error(\"Link not found.\", 404)\n285:         return serialize_link(row)\n286: \n287:     @app.delete(\"/api/links/<int:link_id>\")\n288:     @authenticated()\n289:     def delete_link(link_id):\n290:         db = database()\n291:         with db:\n292:             db.execute(\"BEGIN IMMEDIATE\")\n293:             row = db.execute(\"SELECT * FROM links WHERE id = ? AND is_active = 1\", (link_id,)).fetchone()\n294:             if row is None:\n295:                 return error(\"Link not found.\", 404)\n296:             if row[\"owner_id\"] != g.user[\"id\"]:\n297:                 return error(\"You can only delete your own links.\", 403)\n298:             db.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n299:         return \"\", 204\n300: \n301:     @app.get(\"/api/admin/links\")\n302:     @authenticated(admin_only=True)\n303:     def admin_links():\n304:         return paged_links(include_disabled=True)\n305: \n306:     @app.post(\"/api/admin/links/<int:link_id>/toggle\")\n307:     @authenticated(admin_only=True)\n308:     def toggle_link(link_id):\n309:         db = database()\n310:         with db:\n311:             cursor = db.execute(\"UPDATE links SET is_active = 1 - is_active WHERE id = ?\", (link_id,))\n312:             if cursor.rowcount == 0:\n313:                 return error(\"Link not found.\", 404)\n314:             row = db.execute(LINK_QUERY + \" WHERE links.id = ?\", (link_id,)).fetchone()\n315:         return serialize_link(row)\n316: \n317:     @app.get(\"/r/<code>\")\n318:     def follow_link(code):\n319:         db = database()\n320:         with db:\n321:             row = db.execute(\n322:                 \"\"\"UPDATE links SET click_count = click_count + 1\n323:                 WHERE short_code = ? AND is_active = 1 RETURNING original_url\"\"\",\n324:                 (code,),\n325:             ).fetchone() if request.method == \"GET\" else db.execute(\n326:                 \"SELECT original_url FROM links WHERE short_code = ? AND is_active = 1\", (code,)\n327:             ).fetchone()\n328:         if row is None:\n329:             return error(\"This short link does not exist or has been disabled.\", 404)\n330:         response = redirect(row[\"original_url\"], code=302)\n331:         response.headers[\"Cache-Control\"] = \"no-store\"\n332:         return response\n333: \n334:     @app.errorhandler(HTTPException)\n335:     def http_error(exc):\n336:         return error(exc.description, exc.code)\n337: \n338:     @app.after_request\n339:     def response_headers(response):\n340:         response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n341:         response.headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\"\n342:         response.headers[\"X-Frame-Options\"] = \"DENY\"\n343:         if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n344:             response.headers[\"Cache-Control\"] = \"no-store\"\n345:         if response.status_code == 401:\n346:             response.headers[\"WWW-Authenticate\"] = \"Bearer\"\n347:         return response\n348: \n349:     @app.get(\"/\")\n350:     @app.get(\"/<path:path>\")\n351:     def frontend(path=\"index.html\"):\n352:         if path in (\"api\", \"r\") or path.startswith((\"api/\", \"r/\")):\n353:             abort(404, description=\"Endpoint not found.\")\n354:         candidate = safe_join(str(DIST), path)\n355:         if candidate and Path(candidate).is_file():\n356:             return send_from_directory(DIST, path)\n357:         return send_from_directory(DIST, \"index.html\")\n358: \n359:     return app\n360: \n361: \n362: app = create_app()\n\n(End of file - total 362 lines)\n</content>","metadata":{"preview":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import UTC, datetime\nfrom functools import wraps\nfrom pathlib import Path\nfrom urllib.parse import urlsplit\n\nfrom flask import Flask, abort, g, redirect, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\nfrom werkzeug.utils import safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nLINK_QUERY = \"\"\"\n    SELECT links.*, users.username AS owner\n    FROM links JOIN users ON users.id = links.owner_id","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import UTC, datetime\nfrom functools import wraps\nfrom pathlib import Path\nfrom urllib.parse import urlsplit\n\nfrom flask import Flask, abort, g, redirect, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\nfrom werkzeug.utils import safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nLINK_QUERY = \"\"\"\n    SELECT links.*, users.username AS owner\n    FROM links JOIN users ON users.id = links.owner_id\n\"\"\"\n\n\ndef create_app(config=None):\n    app = Flask(__name__, static_folder=None)\n    app.config.update(\n        DATABASE=str(Path(\"data\") / \"shortlinks.sqlite3\"),\n        ADMIN_PASSWORD=os.environ.get(\"ADMIN_PASSWORD\", \"\"),\n        MAX_CONTENT_LENGTH=32 * 1024,\n    )\n    if config:\n        app.config.update(config)\n\n    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n\n    def database():\n        if \"db\" not in g:\n            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=20)\n            g.db.row_factory = sqlite3.Row\n            g.db.execute(\"PRAGMA foreign_keys = ON\")\n        return g.db\n\n    @app.teardown_appcontext\n    def close_database(_error):\n        db = g.pop(\"db\", None)\n        if db is not None:\n            db.close()\n\n    with app.app_context():\n        db = database()\n        db.execute(\"PRAGMA journal_mode = WAL\")\n        db.executescript(\"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                expires_at INTEGER NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS links (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                original_url TEXT NOT NULL,\n                short_code TEXT NOT NULL UNIQUE,\n                click_count INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                owner_id INTEGER NOT NULL REFERENCES users(id),\n                is_active INTEGER NOT NULL DEFAULT 1\n            );\n            CREATE INDEX IF NOT EXISTS links_active_newest ON links(is_active, id DESC);\n            CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n        \"\"\")\n        admin = db.execute(\"SELECT * FROM users WHERE username = 'admin'\").fetchone()\n        password = app.config[\"ADMIN_PASSWORD\"]\n        with db:\n            if admin is None:\n                db.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n                    (generate_password_hash(password) if password else \"\",),\n                )\n            elif not password or not check_password_hash(admin[\"password_hash\"], password):\n                db.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n                db.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (generate_password_hash(password) if password else \"\", admin[\"id\"]),\n                )\n\n    def error(message, status=400):\n        return {\"error\": message}, status\n\n    def json_body():\n        body = request.get_json(silent=True)\n        if not isinstance(body, dict):\n            abort(400, description=\"Send a JSON object in the request body.\")\n        return body\n\n    def credentials():\n        body = json_body()\n        username, password = body.get(\"username\"), body.get(\"password\")\n        if not isinstance(username, str) or not re.fullmatch(r\"[A-Za-z0-9_.-]{1,32}\", username):\n            abort(400, description=\"Username must be 1–32 letters, numbers, dots, dashes, or underscores.\")\n        if not isinstance(password, str) or not password or len(password) > 256:\n            abort(400, description=\"Password must be between 1 and 256 characters.\")\n        return username, password\n\n    def authenticated(admin_only=False):\n        def decorator(view):\n            @wraps(view)\n            def wrapped(*args, **kwargs):\n                parts = request.headers.get(\"Authorization\", \"\").split()\n                if len(parts) != 2 or parts[0].lower() != \"bearer\" or len(parts[1]) > 256:\n                    return error(\"Please sign in to continue.\", 401)\n                token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n                g.user = database().execute(\n                    \"\"\"SELECT users.* FROM sessions JOIN users ON users.id = sessions.user_id\n                    WHERE token_hash = ? AND expires_at > ?\"\"\",\n                    (token_hash, int(time.time())),\n                ).fetchone()\n                if g.user is None or (g.user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"]):\n                    return error(\"Your session has expired. Please sign in again.\", 401)\n                if admin_only and not g.user[\"is_admin\"]:\n                    return error(\"Administrator access is required.\", 403)\n                g.token_hash = token_hash\n                return view(*args, **kwargs)\n\n            return wrapped\n\n        return decorator\n\n    def serialize_link(row):\n        return {\n            \"id\": row[\"id\"],\n            \"original_url\": row[\"original_url\"],\n            \"short_code\": row[\"short_code\"],\n            \"click_count\": row[\"click_count\"],\n            \"created_at\": row[\"created_at\"],\n            \"short_url\": f\"/r/{row['short_code']}\",\n            \"owner\": row[\"owner\"],\n            \"is_active\": bool(row[\"is_active\"]),\n        }\n\n    def paged_links(include_disabled=False, owner_id=None):\n        try:\n            page = int(request.args.get(\"page\", \"1\"))\n            page_size = int(request.args.get(\"page_size\", \"10\"))\n        except ValueError:\n            return error(\"Page and page_size must be whole numbers.\")\n        if page < 1 or not 1 <= page_size <= 100 or page > 2147483647:\n            return error(\"Page must be positive and page_size must be between 1 and 100.\")\n        conditions = [] if include_disabled else [\"links.is_active = 1\"]\n        parameters = []\n        if owner_id is not None:\n            conditions.append(\"links.owner_id = ?\")\n            parameters.append(owner_id)\n        query = request.args.get(\"q\", \"\").strip()[:256]\n        if query:\n            conditions.append(\"(links.original_url LIKE ? OR links.short_code LIKE ?)\")\n            parameters.extend([f\"%{query}%\", f\"%{query}%\"])\n        where = \" WHERE \" + \" AND \".join(conditions) if conditions else \"\"\n        db = database()\n        with db:\n            db.execute(\"BEGIN\")\n            total = db.execute(\"SELECT COUNT(*) FROM links\" + where, parameters).fetchone()[0]\n            rows = db.execute(\n                LINK_QUERY + where + \" ORDER BY links.id DESC LIMIT ? OFFSET ?\",\n                [*parameters, page_size, (page - 1) * page_size],\n            ).fetchall()\n        return {\"items\": [serialize_link(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n\n    @app.get(\"/api/health\")\n    def health():\n        return {\"status\": \"ok\"}\n\n    @app.post(\"/api/auth/register\")\n    def register():\n        username, password = credentials()\n        if username.lower() == \"admin\":\n            return error(\"This username is reserved.\", 409)\n        db = database()\n        try:\n            with db:\n                cursor = db.execute(\n                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                    (username, generate_password_hash(password)),\n                )\n        except sqlite3.IntegrityError:\n            return error(\"That username is already taken.\", 409)\n        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n\n    @app.post(\"/api/auth/login\")\n    def login():\n        username, password = credentials()\n        db = database()\n        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n        if (\n            user is None\n            or (user[\"is_admin\"] and not app.config[\"ADMIN_PASSWORD\"])\n            or not check_password_hash(user[\"password_hash\"], password)\n        ):\n            return error(\"Incorrect username or password.\", 401)\n        token = secrets.token_urlsafe(32)\n        with db:\n            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (int(time.time()),))\n            db.execute(\n                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], int(time.time()) + 30 * 86400),\n            )\n        return {\"token\": token}\n\n    @app.get(\"/api/auth/me\")\n    @authenticated()\n    def current_user():\n        return {\"id\": g.user[\"id\"], \"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}\n\n    @app.post(\"/api/auth/logout\")\n    @authenticated()\n    def logout():\n        db = database()\n        with db:\n            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n        return \"\", 204\n\n    @app.post(\"/api/links\")\n    @authenticated()\n    def create_link():\n        url = json_body().get(\"original_url\")\n        if not isinstance(url, str) or not url.strip():\n            return error(\"Enter an address to shorten.\")\n        url = url.strip()\n        try:\n            parsed = urlsplit(url)\n            valid = parsed.scheme in (\"http\", \"https\") and bool(parsed.hostname)\n            _ = parsed.port\n            if len(url) > 8192 or any(char.isspace() or ord(char) < 32 or ord(char) == 127 for char in url):\n                valid = False\n        except ValueError:\n            valid = False\n        if not valid:\n            return error(\"Enter a valid URL beginning with http:// or https:// (up to 8,192 characters).\")\n        db = database()\n        for _ in range(5):\n            code = secrets.token_urlsafe(6)\n            try:\n                with db:\n                    cursor = db.execute(\n                        \"\"\"INSERT INTO links (original_url, short_code, created_at, owner_id)\n                        VALUES (?, ?, ?, ?)\"\"\",\n                        (url, code, datetime.now(UTC).isoformat(), g.user[\"id\"]),\n                    )\n                row = db.execute(LINK_QUERY + \" WHERE links.id = ?\", (cursor.lastrowid,)).fetchone()\n                return serialize_link(row), 201\n            except sqlite3.IntegrityError:\n                continue\n        return error(\"Could not generate a short link. Please try again.\", 503)\n\n    @app.get(\"/api/links\")\n    def list_links():\n        return paged_links()\n\n    @app.get(\"/api/links/mine\")\n    @authenticated()\n    def my_links():\n        return paged_links(owner_id=g.user[\"id\"])\n\n    @app.get(\"/api/stats\")\n    def stats():\n        row = database().execute(\n            \"\"\"SELECT COUNT(*) AS total_links, COALESCE(SUM(click_count), 0) AS total_clicks,\n            COALESCE(SUM(substr(created_at, 1, 10) = ?), 0) AS links_today\n            FROM links WHERE is_active = 1\"\"\",\n            (datetime.now(UTC).date().isoformat(),),\n        ).fetchone()\n        return dict(row)\n\n    @app.get(\"/api/links/<int:link_id>\")\n    def get_link(link_id):\n        row = database().execute(\n            LINK_QUERY + \" WHERE links.id = ? AND links.is_active = 1\", (link_id,)\n        ).fetchone()\n        if row is None:\n            return error(\"Link not found.\", 404)\n        return serialize_link(row)\n\n    @app.delete(\"/api/links/<int:link_id>\")\n    @authenticated()\n    def delete_link(link_id):\n        db = database()\n        with db:\n            db.execute(\"BEGIN IMMEDIATE\")\n            row = db.execute(\"SELECT * FROM links WHERE id = ? AND is_active = 1\", (link_id,)).fetchone()\n            if row is None:\n                return error(\"Link not found.\", 404)\n            if row[\"owner_id\"] != g.user[\"id\"]:\n                return error(\"You can only delete your own links.\", 403)\n            db.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n        return \"\", 204\n\n    @app.get(\"/api/admin/links\")\n    @authenticated(admin_only=True)\n    def admin_links():\n        return paged_links(include_disabled=True)\n\n    @app.post(\"/api/admin/links/<int:link_id>/toggle\")\n    @authenticated(admin_only=True)\n    def toggle_link(link_id):\n        db = database()\n        with db:\n            cursor = db.execute(\"UPDATE links SET is_active = 1 - is_active WHERE id = ?\", (link_id,))\n            if cursor.rowcount == 0:\n                return error(\"Link not found.\", 404)\n            row = db.execute(LINK_QUERY + \" WHERE links.id = ?\", (link_id,)).fetchone()\n        return serialize_link(row)\n\n    @app.get(\"/r/<code>\")\n    def follow_link(code):\n        db = database()\n        with db:\n            row = db.execute(\n                \"\"\"UPDATE links SET click_count = click_count + 1\n                WHERE short_code = ? AND is_active = 1 RETURNING original_url\"\"\",\n                (code,),\n            ).fetchone() if request.method == \"GET\" else db.execute(\n                \"SELECT original_url FROM links WHERE short_code = ? AND is_active = 1\", (code,)\n            ).fetchone()\n        if row is None:\n            return error(\"This short link does not exist or has been disabled.\", 404)\n        response = redirect(row[\"original_url\"], code=302)\n        response.headers[\"Cache-Control\"] = \"no-store\"\n        return response\n\n    @app.errorhandler(HTTPException)\n    def http_error(exc):\n        return error(exc.description, exc.code)\n\n    @app.after_request\n    def response_headers(response):\n        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n        response.headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\"\n        response.headers[\"X-Frame-Options\"] = \"DENY\"\n        if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n            response.headers[\"Cache-Control\"] = \"no-store\"\n        if response.status_code == 401:\n            response.headers[\"WWW-Authenticate\"] = \"Bearer\"\n        return response\n\n    @app.get(\"/\")\n    @app.get(\"/<path:path>\")\n    def frontend(path=\"index.html\"):\n        if path in (\"api\", \"r\") or path.startswith((\"api/\", \"r/\")):\n            abort(404, description=\"Endpoint not found.\")\n        candidate = safe_join(str(DIST), path)\n        if candidate and Path(candidate).is_file():\n            return send_from_directory(DIST, path)\n        return send_from_directory(DIST, \"index.html\")\n\n    return app\n\n\napp = create_app()","lineStart":1,"lineEnd":362,"totalLines":362,"truncated":false}},"title":"backend/app.py","time":{"start":1794313038229,"end":1794313038465}},"id":"prt_1c5642990001OY7VzNC7AR1lpx","sessionID":"ses_e3ab6a190ffeefD3lk4C1wi2O7","messageID":"msg_1c56409ca001pEcnZHN2qVSCFi"}}
