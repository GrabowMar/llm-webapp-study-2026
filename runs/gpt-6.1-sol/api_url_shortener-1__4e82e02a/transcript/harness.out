LQp4jDCGMCts7Y9FG3oDNUhn-WR-YoYw3HlSZT3upcbzx66v7SUtuWfJIjh1VUZoAfKKNwg2WJN0fwRmF24kig8jnUR7rrGkVUhnQQBi1YXXTM9HY1SGPVjToY1dgdtl9qtSSB4OBgFGLfm5XPbaaOk9GIvdROgf5F_u8ICG9e0usmIxnJ8lY5anj-qnc38ERAycoyIstHnaPOghczxKoweKMbgrO42Gff4hmEPulSb3dhMTProvduMv7S31b5QHIO8sCTF7QDPfc7Asr6XqjouGCTjZ5V-YsFPVwhw8mHt4czedmaL_DFr4YZbtGaID0c7Kq2uKFFxtPmOXYdeBsVoizgDt4tbP9lgv4tsY3SkLuqtejCjBnsTFGwZQpO2Um0KjCzaiVCMX_z7vImmLmucj.eyJlbmRwb2ludF9zbHVnIjoib3BlbmFpL2dwdC02LjEtc29sLTIwMjYwOTI5fGF6dXJlIn0","id":"rs_053480768cb277f9016af30a8c29048190a9b70d098772f5bb","format":"azure-openai-responses-v1","index":0}]}},"id":"prt_1c56137ff0010LgitbYxNEfjCW","sessionID":"ses_e3ab6a190ffeefD3lk4C1wi2O7","messageID":"msg_1c5612899001Fi3voI9GuS7Xot"}}
