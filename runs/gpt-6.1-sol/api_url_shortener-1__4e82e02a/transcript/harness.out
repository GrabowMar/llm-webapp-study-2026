ller();\n    const load = async () => {\n      setLoading(true);\n      setListError(\"\");\n      const endpoint = view === \"admin\" ? \"/admin/links\" : view === \"mine\" ? \"/links/mine\" : \"/links\";\n      try {\n        const result = await api<Page>(`${endpoint}?page=${page}&page_size=${PAGE_SIZE}&q=${encodeURIComponent(query)}`, { signal: controller.signal }, token);\n        if (controller.signal.aborted) return;\n        if (page > 1 && result.items.length === 0) {\n          setPage(Math.max(1, Math.ceil(result.total / PAGE_SIZE)));\n        } else {\n          setLinks(result);\n        }\n      } catch (error) {\n        if (!controller.signal.aborted) {\n          setListError(error instanceof Error ? error.message : \"Unable to load links.\");\n          if (error instanceof ApiError && error.status === 401) {\n            saveToken(null);\n            setToken(null);\n            setUser(null);\n            setView(\"overview\");\n          }\n        }\n      } finally {\n        if (!controller.signal.aborted) setLoading(false);\n      }\n    };\n    void load();\n    return () => controller.abort();\n  }, [view, page, query, revision, token]);\n\n  useEffect(() => {\n    const controller = new AbortController();\n    api<Stats>(\"/stats\", { signal: controller.signal }).then(setStats).catch(() => {});\n    return () => controller.abort();\n  }, [revision]);\n\n  useEffect(() => {\n    const onFocus = () => setRevision((value) => value + 1);\n    window.addEventListener(\"focus\", onFocus);\n    return () => window.removeEventListener(\"focus\", onFocus);\n  }, []);\n\n  useEffect(() => {\n    if (!toast) return;\n    const timeout = window.setTimeout(() => setToast(null), 4000);\n    return () => window.clearTimeout(timeout);\n  }, [toast]);\n\n  useEffect(() => {\n    if (copied === null) return;\n    const timeout = window.setTimeout(() => setCopied(null), 2500);\n    return () => window.clearTimeout(timeout);\n  }, [copied]);\n\n  function navigate(next: View) {\n    setMobileNav(false);\n    if (next !== \"overview\" && !user) { setAuthMode(\"login\"); return; }\n    setView(next);\n    setPage(1);\n    setSearch(\"\");\n    setQuery(\"\");\n  }\n\n  async function shorten(event: FormEvent) {\n    event.preventDefault();\n    setFormError(\"\");\n    if (!user || !token) { setAuthMode(\"login\"); return; }\n    setShortening(true);\n    try {\n      const result = await api<Link>(\"/links\", { method: \"POST\", body: JSON.stringify({ original_url: url }) }, token);\n      setCreated(result);\n      setUrl(\"\");\n      setPage(1);\n      setSearch(\"\");\n      setQuery(\"\");\n      setRevision((value) => value + 1);\n      setToast({ message: \"A little link, ready for big things.\" });\n    } catch (error) {\n      setFormError(error instanceof Error ? error.message : \"Unable to shorten this address.\");\n      if (error instanceof ApiError && error.status === 401) {\n        saveToken(null);\n        setToken(null);\n        setUser(null);\n        setView(\"overview\");\n        setAuthMode(\"login\");\n      }\n    } finally {\n      setShortening(false);\n    }\n  }\n\n  async function copy(link: Link) {\n    const text = fullShortUrl(link);\n    try {\n      if (navigator.clipboard && window.isSecureContext) {\n        await navigator.clipboard.writeText(text);\n      } else {\n        const field = document.createElement(\"textarea\");\n        field.value = text;\n        field.className = \"fixed -left-full top-0\";\n        document.body.appendChild(field);\n        field.select();\n        const success = document.execCommand(\"copy\");\n        field.remove();\n        if (!success) throw new Error(\"Copy failed\");\n      }\n      setCopied(link.id);\n      setToast({ message: \"Short link copied to your clipboard.\" });\n    } catch {\n      setToast({ message: \"Couldn't copy automatically. Select the short address and copy it.\", error: true });\n    }\n  }\n\n  async function signOut() {\n    try { await api(\"/auth/logout\", { method: \"POST\" }, token); } catch { setToast({ message: \"Signed out on this device. The server could not be reached.\", error: true }); }\n    saveToken(null);\n    setToken(null);\n    setUser(null);\n    setCreated(null);\n    setView(\"overview\");\n    setPage(1);\n    setRevision((value) => value + 1);\n  }\n\n  async function deleteLink() {\n    if (!deleting) return;\n    setActionBusy(deleting.id);\n    try {\n      await api(`/links/${deleting.id}`, { method: \"DELETE\" }, token);\n      if (created?.id === deleting.id) setCreated(null);\n      setDeleting(null);\n      setRevision((value) => value + 1);\n      setToast({ message: \"Link permanently deleted.\" });\n    } catch (error) {\n      setToast({ message: error instanceof Error ? error.message : \"Unable to delete this link.\", error: true });\n    } finally { setActionBusy(null); }\n  }\n\n  async function toggleLink(link: Link) {\n    setActionBusy(link.id);\n    try {\n      await api(`/admin/links/${link.id}/toggle`, { method: \"POST\" }, token);","lineStart":50,"lineEnd":249,"totalLines":351,"truncated":true}},"title":"frontend/src/App.tsx","time":{"start":1794313000181,"end":1794313000213}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"gAAAAABq8wskLFYMW8tWf_JJ-JKrjS79iWsUOhX2ZIahH4hipFyqw16wbCpHF3eeLz8Kkf9nVOYMsBePTRzPlP4yaKHwtb7ObscTav9m_NAeRvswPOimHdD1zKbAxklDdZYPwvHeCuS-g12HCCu9vGI1y5PboNyIdcqrh6b_u3ePVX1lxOuIjI3U76sgLR3ubWNcwP57X1Bh-dTO9aYAhuPPZRM5hXYfw6clNT4d2v2nnx3kRerHq3aARnHeB7YBjkOxQiq6Yal2y3NGaJb1E93qyndACQn5XF1leMvK0LZ2EafsFrhL83Y9H1DOw3dsEcoRKlVOtHcwFLn9TSOIwgyS1Xe3vdeU__rc90KorL6nEbz-QaCBS14YmkHSAf09HYm3tyexRllf18uNru2W0rUvxxM6agjceNwAINCaGkYmsEBBFh9Rc2nG5-72TAAbrvl3mR_luZ2p07HewjE-n6AvsBP-MAlPVc6rD_ezNKh4Bbqvpz-JWal5kgd4S31GkUI13mA7N8y7rufVGc_qkLUSw9tHHU9Nj0yBe9rwk-dO5Qj3ig1aPt-IoR1TZr9mqewrbtgSPIgaOgczlNQHM9oPBVolzudPoSn0sqGzIQDMfIzPtQnTA03pxqxYc8jJjpqJgmiAB_-sSSvHO5-HM3cvQ1L97zPJ_JMJ9_bcUj1