.5\"><div className=\"flex h-8 w-8 items-center justify-center rounded-full bg-mint text-xs font-semibold text-forest\">{user.username.slice(0, 2).toUpperCase()}</div><span className=\"max-w-30 truncate text-xs font-medium\" title={user.username}>{user.username}</span>{user.is_admin && <span className=\"hidden rounded-md bg-mint px-2 py-1 text-[10px] font-medium text-forest sm:inline\">Admin</span>}</div><button onClick={() => void signOut()} className=\"flex items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 text-xs text-stone-500 transition hover:border-forest hover:text-forest\"><span className=\"hidden sm:inline\">Sign out</span><Icon name=\"logout\" className=\"h-4 w-4\" /></button></> : <><button onClick={() => setAuthMode(\"login\")} className=\"text-xs font-medium text-stone-500 transition hover:text-forest\">Sign in</button><button onClick={() => setAuthMode(\"register\")} className=\"rounded-lg bg-forest px-4 py-2.5 text-xs font-medium text-white transition hover:bg-ink\">Create account</button></>}\n+    {user ? (\n+      <>\n+        <div className=\"flex items-center gap-2.5\">\n+          <div className=\"flex h-8 w-8 items-center justify-center rounded-full bg-mint text-xs font-semibold text-forest\">{user.username.slice(0, 2).toUpperCase()}</div>\n+          <span className=\"max-w-30 truncate text-xs font-medium\" title={user.username}>{user.username}</span>\n+          {user.is_admin && <span className=\"hidden rounded-md bg-mint px-2 py-1 text-[10px] font-medium text-forest sm:inline\">Admin</span>}\n+        </div>\n+        <button onClick={() => void signOut()} aria-label=\"Sign out\" className=\"flex items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 text-xs text-stone-500 transition hover:border-forest hover:text-forest\">\n+          <span className=\"hidden sm:inline\">Sign out</span><Icon name=\"logout\" className=\"h-4 w-4\" />\n+        </button>\n+      </>\n+    ) : (\n+      <>\n+        <button onClick={() =