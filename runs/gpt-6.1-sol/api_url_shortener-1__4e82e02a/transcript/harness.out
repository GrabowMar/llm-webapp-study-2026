\n+  try {\n+    response = await fetch(`/api${path}`, { ...options, headers });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Unable to connect. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const body = await response.json();\n+  if (!response.ok) throw new ApiError(body.error ?? \"Something went wrong. Please try again.\", response.status);\n+  return body as T;\n+}\n+\n+export function fullShortUrl(link: Link) {\n+  return new URL(link.short_url, window.location.origin).href;\n+}\n\nIndex: /workspace/frontend/src/Icon.tsx\n===================================================================\n--- /workspace/frontend/src/Icon.tsx\n+++ /workspace/frontend/src/Icon.tsx\n@@ -0,0 +1,39 @@\n+import type { CSSProperties } from \"react\";\n+\n+const paths = {\n+  link: \"M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2 M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2\",\n+  grid: \"M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z\",\n+  arrow: \"M4 12h16 M14 6l6 6-6 6\",\n+  external: \"M14 3h7v7 M21 3l-10 10 M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5\",\n+  copy: \"M9 9h11v12H9z M15 9V3H3v12h6\",\n+  check: \"M5 12l4 4L19 6\",\n+  x: \"M6 6l12 12 M6 18 18 6\",\n+  search: \"M21 21l-5-5 M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0\",\n+  trash: \"M3 6h18 M9 6V3h6v3 M5 6l1 15h12l1-15 M10 10v7 M14 10v7\",\n+  shield: \"M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6z M8 11l3 3 5-5\",\n+  logout: \"M9 3H4v18h5 M9 12h12 M17 8l4 4-4 4\",\n+  user: \"M20 21v-2a6 6 0 0 0-6-6h-4a6 6 0 0 0-6 6v2 M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0\",\n+  menu: \"M4 6h16 M4 12h16 M4 18h16\",\n+  refresh: \"M20 7v5h-5 M4 17v-5h5 M6 6a8 8 0 0 1 13 2l1 4 M18 18a8 8 0 0 1-13-2l-1-4\",\n+  clock: \"M12 8v4l3 2 M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0\",\n+  left: \"M15 6l-6 6 6 6\",\n+  right: \"M9 6l6 6-6 6\",\n+  cursor: \"M4 3l7 18 3-7 7-3z M14 14l6 6\",\n+  plus: \"M12 5v14 M5 12h14\",\n+  lock: \"M5 10h14v11H5z M8 10V6a4 4 0 0 1 8 0v4 M12 14v3\",\n+  globe: \"M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0 M2 12h20 M12 2a20 20 0 0 1 0 20 20 20 0 0 1 0-20\",\n+  pause: \"M8 5v14 M16 5v14\",\n+  play: \"M7 4l14 8-14 8z\",\n+  spark: \"M12 3l2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5z\",\n+  chart: \"M4 20h17 M7 15v-4 M12 15V7 M17 15V3\",\n+};\n+\n+export type IconName = keyof typeof paths;\n+\n+export default function Icon({ name, className = \"h-5 w-5\", style }: { name: IconName; className?: string; style?: CSSProperties }) {\n+  return (\n+    <svg className={className} style={style} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.7\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+      <path d={paths[name]} />\n+    </svg>\n+  );\n+}\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"update","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -141,24 +141,33 @@\n         \"owner\": row[\"owner\"],\n         \"is_active\": bool(row[\"is_active\"]),\n     }\n \n-def paged_links(include_disabled=False):\n+def paged_links(include_disabled=False, owner_id=None):\n     try:\n         page = int(request.args.get(\"page\", \"1\"))\n         page_size = int(request.args.get(\"page_size\", \"10\"))\n     except ValueError:\n         return error(\"Page and page_size must be whole numbers.\")\n     if page < 1 or not 1 <= page_size <= 100 or page > 2147483647:\n         return error(\"Page must be positive and page_size must be between 1 and 100.\")\n-    where = \"\" if include_disabled else \" WHERE links.is_active = 1\"\n+    conditions = [] if include_disabled else [\"links.is_active = 1\"]\n+    parameters = []\n+    if owner_id is not None:\n+        conditions.append(\"links.owner_id = ?\")\n+        parameters.append(owner_id)\n+    query = request.args.get(\"q\", \"\").strip()[:256]\n+    if query:\n+        conditions.append(\"(links.original_url LIKE ? OR links.short_code LIKE ?)\")\n+        parameters.extend([f\"%{query}%\", f\"%{query}%\"])\n+    where = \" WHERE \" + \" AND \".join(conditions) if conditions else \"\"\n     db = database()\n     with db:\n         db.execute(\"BEGIN\")\n-        total = db.execute(\"SELECT COUNT(*) FROM links\" + where).fetchone()[0]\n+        total = db.execute(\"SELECT COUNT(*) FROM links\" + where, parameters).fetchone()[0]\n         rows = db.execute(\n             LINK_QUERY + where + \" ORDER BY links.id DESC LIMIT ? OFFSET ?\",\n-            (page_size, (page - 1) * page_size),\n+            [*parameters, page_size, (page - 1) * page_size],\n         ).fetchall()\n     return {\"items\": [serialize_link(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n \n @app.get(\"/api/health\")\n@@ -250,8 +259,23 @@\n @app.get(\"/api/links\")\n def list_links():\n     return paged_links()\n \n+@app.get(\"/api/links/mine\")\n+@authenticated()\n+def my_links():\n+    return paged_links(owner_id=g.user[\"id\"])\n+\n+@app.get(\"/api/stats\")\n+def stats():\n+    row = database().execute(\n+        \"\"\"SELECT COUNT(*) AS total_links, COALESCE(SUM(click_count), 0) AS total_clicks,\n+        COALESCE(SUM(substr(created_at, 1, 10) = ?), 0) AS links_today\n+        FROM links WHERE is_active = 1\"\"\",\n+        (datetime.now(timezone.utc).date().isoformat(),),\n+    ).fetchone()\n+    return dict(row)\n+\n @app.get(\"/api/links/<int:link_id>\")\n def get_link(link_id):\n     row = database().execute(\n         LINK_QUERY + \" WHERE links.id = ? AND links.is_active = 1\", (link_id,)\n","additions":28,"deletions":4},{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n=======================================