fdb4ca07ab75ffadab4a8b135ad59cdbb3156b99310f3d565370da74a15d6bd3\n-    # via\n-    #   flask\n-    #   jinja2\n-    #   werkzeug\n-werkzeug==3.1.9 \\\n-    --hash=sha256:55ca7c70a75689be937aa27f8ff4b018f06ff4838fc73045560bf0f5a1291060 \\\n-    --hash=sha256:6392e50c78460ba618e5b21f08a71f59c99ce99cdc6cf6e3dd7e6ccca8754fab\n-    # via flask\n\nIndex: /workspace/backend/requirements.lock\n===================================================================\n--- /workspace/backend/requirements.lock\n+++ /workspace/backend/requirements.lock\n@@ -0,0 +1,8 @@\n+blinker==1.9.0\n+click==8.5.0\n+flask==3.1.3\n+gunicorn==26.2.0\n+itsdangerous==2.2.0\n+jinja2==3.1.6\n+markupsafe==3.0.4\n+werkzeug==3.1.9\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,11 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#087f73\" />\n+    <meta name=\"description\" content=\"Stockroom — a clearer view of your warehouse. Manage inventory, track movements, and keep stock in check.\" />\n+    <title>Stockroom · Inventory management</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,12 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", sans-serif;\n+  --color-brand-50: #edf8f5;\n+  --color-brand-100: #d6efe7;\n+  --color-brand-200: #afe0d2;\n+  --color-brand-500: #149687;\n+  --color-brand-600: #087f73;\n+  --color-brand-700: #08685e;\n+  --color-ink: #24332f;\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,17 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"noEmit\": true,\n+    \"skipLibCheck\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true\n+  },\n+  \"include\": [\"src\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,22 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-r