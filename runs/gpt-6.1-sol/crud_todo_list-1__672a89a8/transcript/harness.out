{"type":"tool_use","timestamp":1794305260877,"sessionID":"ses_e3b1534f1ffe0d7Px32Bq6e6WC","part":{"type":"tool","tool":"apply_patch","callID":"call_mTruL84KAVaTdYz0dSQxFAnL","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Delete File: /workspace/backend/app.py\n*** Add File: /workspace/backend/app.py\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import date, datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+PRIORITIES = (\"low\", \"medium\", \"high\")\n+TODO_FIELDS = {\"title\", \"description\", \"priority\", \"due_date\", \"completed\"}\n+\n+\n+def now():\n+    return datetime.now(timezone.utc).isoformat()\n+\n+\n+def database():\n+    if \"db\" not in g:\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=15)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def error(message, status=400, errors=None):\n+    result = {\"error\": message}\n+    if errors:\n+        result[\"errors\"] = errors\n+    return result, status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return error(\"Please sign in to continue.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = database().execute(\n+            \"SELECT users.id, users.username FROM sessions \"\n+            \"JOIN users ON users.id = sessions.user_id \"\n+            \"WHERE token_hash = ? AND expires_at > ?\",\n+            (token_hash, now()),\n+        ).fetchone()\n+        if user is None:\n+            return error(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = token_hash\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    return body if isinstance(body, dict) else None\n+\n+\n+def credentials(body):\n+    errors = {}\n+    username = body.get(\"username\")\n+    password = body.get(\"password\")\n+    if not isinstance(username, str) or not re.fullmatch(\n+        r\"[A-Za-z0-9_.-]{3,32}\", username.strip()\n+    ):\n+        errors[\"username\"] = (\n+            \"Use 3–32 letters, numbers, dots, hyphens, or underscores.\"\n+        )\n+    if not isinstance(password, str) or not 8 <= len(password) <= 128:\n+        errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n+    return errors\n+\n+\n+def validate_todo(body, partial=False):\n+    values = {}\n+    errors = {}\n+    for field in body.keys() - TODO_FIELDS:\n+        errors[field] = \"This field cannot be changed.\"\n+    if \"title\" in body or not partial:\n+        title = body.get(\"title\")\n+        if not isinstance(title, str) or not 1 <= len(title.strip()) <= 200:\n+            errors[\"title\"] = \"Give your task a title between 1 and 200 characters.\"\n+        else:\n+            values[\"title\"] = title.strip()\n+    if \"description\" in body or not partial:\n+        description = body.get(\"description\", \"\")\n+        if description is not None and (\n+            not isinstance(description, str) or len(description) > 5000\n+        ):\n+            errors[\"description\"] = \"Keep the description under 5,000 characters.\"\n+        else:\n+            values[\"description\"] = description\n+    if \"priority\" in body or not partial:\n+        priority = body.get(\"priority\", \"medium\")\n+        if not isinstance(priority, str) or priority not in PRIORITIES:\n+            errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n+        else:\n+            values[\"priority\"] = priority\n+    if \"due_date\" in body or not partial:\n+        due_date = body.get(\"due_date\")\n+        if due_date is not None:\n+            try:\n+                if not isinstance(due_date, str) or not re.fullmatch(\n+                    r\"\\d{4}-\\d{2}-\\d{2}\", due_date\n+                ):\n+                    raise ValueError\n+                date.fromisoformat(due_date)\n+            except ValueError:\n+                errors[\"due_date\"] = \"Choose a valid date in YYYY-MM-DD format.\"\n+        values[\"due_date\"] = due_date\n+    if \"completed\" in body or not partial:\n+        completed = body.get(\"completed\", False)\n+        if not isinstance(completed, bool):\n+            errors[\"completed\"] = \"Completed must be true or false.\"\n+        else:\n+            values[\"completed\"] = completed\n+    return values, errors\n+\n+\n+def serialize(row):\n+    todo = dict(row)\n+    todo.pop(\"user_id\", None)\n+    todo[\"completed\"] = bool(todo[\"completed\"])\n+    return todo\n+\n+\n+def owned_todo(todo_id):\n+    return database().execute(\n+        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\",\n+        (todo_id, g.user[\"id\"]),\n+    ).fetchone()\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"todos.sqlite3\"),\n+        MAX_CONTENT_LENGTH=64 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = database()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS todos (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                title TEXT NOT NULL,\n+                description TEXT,\n+                priority TEXT NOT NULL CHECK (priority IN ('low', 'medium', 'high')),\n+                due_date TEXT,\n+                completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1)),\n+                completed_at TEXT,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS todos_user_order\n+                ON todos(user_id, completed, due_date, created_at DESC);\n+            CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_database(_exception):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def handle_http_error(exception):\n+        if request.path.startswith(\"/api/\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        else:\n+            response.headers[\"Content-Security-Policy\"] = (\n+                \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n+                \"img-src 'self' data:; connect-src 'self'; font-src 'self'; \"\n+                \"object-src 'none'; base-uri 'self'; frame-ancestors 'none'\"\n+            )\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your username and password.\")\n+        errors = credentials(body)\n+        if errors:\n+            return error(\"Please check your account details.\", errors=errors)\n+        db = database()\n+        try:\n+            with db:\n+                cursor = db.execute(\n+                    \"INSERT INTO users (username, password_hash, created_at) \"\n+                    \"VALUES (?, ?, ?)\",\n+                    (\n+                        body[\"username\"].strip(),\n+                        generate_password_hash(body[\"password\"]),\n+                        now(),\n+                    ),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\n+                \"That username is already taken.\",\n+                409,\n+                {\"username\": \"That username is already taken. Try another.\"},\n+            )\n+        return {\"id\": cursor.lastrowid, \"username\": body[\"username\"].strip()}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your username and password.\")\n+        errors = credentials(body)\n+        if errors:\n+            return error(\"Please check your account details.\", errors=errors)\n+        db = database()\n+        user = db.execute(\n+            \"SELECT * FROM users WHERE username = ?\", (body[\"username\"].strip(),)\n+        ).fetchone()\n+        password_hash = user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"]\n+        valid = check_password_hash(password_hash, body[\"password\"])\n+        if user is None or not valid:\n+            return error(\"The username or password is incorrect.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (now(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (\n+                    hashlib.sha256(token.encode()).hexdigest(),\n+                    user[\"id\"],\n+                    (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(),\n+                ),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return dict(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = database()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.get(\"/api/todos\")\n+    @authenticated\n+    def list_todos():\n+        conditions = [\"user_id = ?\"]\n+        params = [g.user[\"id\"]]\n+        errors = {}\n+        completed = request.args.get(\"completed\")\n+        if completed is not None:\n+            if completed not in (\"true\", \"false\", \"1\", \"0\"):\n+                errors[\"completed\"] = \"Completed must be true or false.\"\n+            else:\n+                conditions.append(\"completed = ?\")\n+                params.append(int(completed in (\"true\", \"1\")))\n+        priority = request.args.get(\"priority\")\n+        if priority is not None:\n+            if priority not in PRIORITIES:\n+                errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n+            else:\n+                conditions.append(\"priority = ?\")\n+                params.append(priority)\n+        pagination = {}\n+        for field, default, maximum in (\n+            (\"page\", 1, 2147483647),\n+            (\"page_size\", 20, 100),\n+        ):\n+            raw = request.args.get(field, str(default))\n+            try:\n+                if not re.fullmatch(r\"[0-9]{1,10}\", raw):\n+                    raise ValueError\n+                value = int(raw)\n+                if not 1 <= value <= maximum:\n+                    raise ValueError\n+                pagination[field] = value\n+            except ValueError:\n+                errors[field] = f\"Choose a whole number between 1 and {maximum}.\"\n+        if errors:\n+            return error(\"Please check your filters.\", errors=errors)\n+        where = \" AND \".join(conditions)\n+        db = database()\n+        page, page_size = pagination[\"page\"], pagination[\"page_size\"]\n+        offset = (page - 1) * page_size\n+        total = db.execute(\n+            f\"SELECT COUNT(*) FROM todos WHERE {where}\", params\n+        ).fetchone()[0]\n+        rows = db.execute(\n+            f\"SELECT * FROM todos WHERE {where} \"\n+            \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n+            \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n+            [*params, page_size, offset],\n+        ).fetchall()\n+        return {\n+            \"items\": [serialize(row) for row in rows],\n+            \"total\": total,\n+            \"page\": page,\n+            \"page_size\": page_size,\n+            \"remaining\": max(0, total - offset - len(rows)),\n+        }\n+\n+    @app.post(\"/api/todos\")\n+    @authenticated\n+    def add_todo():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your task details.\")\n+        values, errors = validate_todo(body)\n+        if errors:\n+            return error(\"Please check your task details.\", errors=errors)\n+        timestamp = now()\n+        db = database()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n+                \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n+                (\n+                    g.user[\"id\"],\n+                    values[\"title\"],\n+                    values[\"description\"],\n+                    values[\"priority\"],\n+                    values[\"due_date\"],\n+                    values[\"completed\"],\n+                    timestamp if values[\"completed\"] else None,\n+                    timestamp,\n+                ),\n+            )\n+        return serialize(owned_todo(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def get_todo(todo_id):\n+        row = owned_todo(todo_id)\n+        if row is None:\n+            return error(\"Task not found.\", 404)\n+        return serialize(row)\n+\n+    @app.patch(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def update_todo(todo_id):\n+        db = database()\n+        with db:\n+            db.execute(\"BEGIN IMMEDIATE\")\n+            row = owned_todo(todo_id)\n+            if row is None:\n+                return error(\"Task not found.\", 404)\n+            body = json_body()\n+            if body is None:\n+                return error(\"Send a JSON object with your task details.\")\n+            values, errors = validate_todo(body, partial=True)\n+            if errors:\n+                return error(\"Please check your task details.\", errors=errors)\n+            if \"completed\" in values and values[\"completed\"] != bool(row[\"completed\"]):\n+                values[\"completed_at\"] = now() if values[\"completed\"] else None\n+            if values:\n+                assignments = \", \".join(f\"{field} = ?\" for field in values)\n+                db.execute(\n+                    f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n+                    [*values.values(), todo_id, g.user[\"id\"]],\n+                )\n+            result = serialize(owned_todo(todo_id))\n+        return result\n+\n+    @app.delete(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def delete_todo(todo_id):\n+        db = database()\n+        with db:\n+            cursor = db.execute(\n+                \"DELETE FROM todos WHERE id = ? AND user_id = ?\",\n+                (todo_id, g.user[\"id\"]),\n+            )\n+        if cursor.rowcount == 0:\n+            return error(\"Task not found.\", 404)\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n*** Add File: /workspace/backend/test_app.py\n+import hashlib\n+import sqlite3\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app\n+\n+\n+class TodoApiTests(unittest.TestCase):\n+    def setUp(self):\n+        self.temp = tempfile.TemporaryDirectory()\n+        self.path = str(Path(self.temp.name) / \"todos.sqlite3\")\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.path})\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.temp.cleanup()\n+\n+    def account(self, username):\n+        credentials = {\"username\": username, \"password\": \"password123\"}\n+        self.assertEqual(\n+            self.client.post(\"/api/auth/register\", json=credentials).status_code, 201\n+        )\n+        response = self.client.post(\"/api/auth/login\", json=credentials)\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def add(self, **fields):\n+        response = self.client.post(\n+            \"/api/todos\", headers=self.headers, json={\"title\": \"A task\", **fields}\n+        )\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def test_health_and_authentication(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        for method, url in (\n+            (\"GET\", \"/api/todos\"),\n+            (\"POST\", \"/api/todos\"),\n+            (\"GET\", \"/api/todos/1\"),\n+            (\"PATCH\", \"/api/todos/1\"),\n+            (\"DELETE\", \"/api/todos/1\"),\n+        ):\n+            self.assertEqual(self.client.open(url, method=method).status_code, 401)\n+            self.assertEqual(\n+                self.client.open(\n+                    url, method=method, headers={\"Authorization\": \"Bearer invalid\"}\n+                ).status_code,\n+                401,\n+            )\n+        self.assertEqual(\n+            self.client.get(\"/api/auth/me\", headers=self.headers).json[\"username\"],\n+            \"alice\",\n+        )\n+        duplicate = self.client.post(\n+            \"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"password123\"}\n+        )\n+        self.assertEqual(duplicate.status_code, 409)\n+        self.assertIn(\"username\", duplicate.json[\"errors\"])\n+        self.assertEqual(\n+            self.client.post(\n+                \"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrongpassword\"}\n+            ).status_code,\n+            401,\n+        )\n+\n+    def test_crud_and_completion_transitions(self):\n+        todo = self.add(title=\"  Plan the week  \", description=\"Notes\", priority=\"high\")\n+        self.assertEqual(todo[\"title\"], \"Plan the week\")\n+        self.assertEqual(\n+            set(todo),\n+            {\"id\", \"title\", \"description\", \"priority\", \"due_date\", \"completed\",\n+             \"completed_at\", \"created_at\"},\n+        )\n+        self.assertFalse(todo[\"completed\"])\n+        self.assertIsNone(todo[\"completed_at\"])\n+        url = f\"/api/todos/{todo['id']}\"\n+        completed = self.client.patch(url, headers=self.headers, json={\"completed\": True}).json\n+        self.assertTrue(completed[\"completed\"])\n+        self.assertIsNotNone(completed[\"completed_at\"])\n+        again = self.client.patch(url, headers=self.headers, json={\"completed\": True}).json\n+        self.assertEqual(again[\"completed_at\"], completed[\"completed_at\"])\n+        updated = self.client.patch(url, headers=self.headers, json={\"title\": \"New title\"}).json\n+        self.assertEqual(updated[\"description\"], \"Notes\")\n+        self.assertEqual(updated[\"completed_at\"], completed[\"completed_at\"])\n+        reopened = self.client.patch(\n+            url, headers=self.headers, json={\"completed\": False, \"description\": None}\n+        ).json\n+        self.assertIsNone(reopened[\"completed_at\"])\n+        self.assertIsNone(reopened[\"description\"])\n+        self.assertEqual(self.client.get(url, headers=self.headers).json, reopened)\n+        self.assertEqual(self.client.patch(url, headers=self.headers, json={}).json, reopened)\n+        self.assertEqual(self.client.delete(url, headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(url, headers=self.headers).status_code, 404)\n+        self.assertEqual(self.client.delete(url, headers=self.headers).status_code, 404)\n+\n+    def test_private_lists(self):\n+        todo = self.add()\n+        bob = self.account(\"bob\")\n+        self.assertEqual(self.client.get(\"/api/todos\", headers=bob).json[\"total\"], 0)\n+        for method in (\"GET\", \"PATCH\", \"DELETE\"):\n+            response = self.client.open(\n+                f\"/api/todos/{todo['id']}\", method=method, headers=bob, json={\"title\": \"Stolen\"}\n+            )\n+            self.assertEqual(response.status_code, 404)\n+        self.assertEqual(self.client.get(\"/api/todos\", headers=self.headers).json[\"total\"], 1)\n+\n+    def test_sorting_filters_and_pagination(self):\n+        undated_old = self.add(title=\"Old undated\")\n+        completed = self.add(title=\"Done\", due_date=\"2020-01-01\", completed=True)\n+        later = self.add(title=\"Later\", due_date=\"2030-06-01\", priority=\"high\")\n+        earlier_old = self.add(title=\"Earlier old\", due_date=\"2030-05-01\")\n+        earlier_new = self.add(title=\"Earlier new\", due_date=\"2030-05-01\", priority=\"high\")\n+        undated_new = self.add(title=\"New undated\")\n+        result = self.client.get(\"/api/todos\", headers=self.headers).json\n+        self.assertEqual(\n+            [item[\"id\"] for item in result[\"items\"]],\n+            [earlier_new[\"id\"], earlier_old[\"id\"], later[\"id\"],\n+             undated_new[\"id\"], undated_old[\"id\"], completed[\"id\"]],\n+        )\n+        page = self.client.get(\"/api/todos?page=2&page_size=2\", headers=self.headers).json\n+        self.assertEqual(page[\"total\"], 6)\n+        self.assertEqual(page[\"page\"], 2)\n+        self.assertEqual(page[\"page_size\"], 2)\n+        self.assertEqual(page[\"remaining\"], 2)\n+        self.assertEqual(len(page[\"items\"]), 2)\n+        empty = self.client.get(\"/api/todos?page=20&page_size=2\", headers=self.headers).json\n+        self.assertEqual(empty[\"items\"], [])\n+        self.assertEqual(empty[\"remaining\"], 0)\n+        filtered = self.client.get(\n+            \"/api/todos?completed=false&priority=high\", headers=self.headers\n+        ).json\n+        self.assertEqual(filtered[\"total\"], 2)\n+        self.assertTrue(all(item[\"priority\"] == \"high\" for item in filtered[\"items\"]))\n+        self.assertEqual(\n+            self.client.get(\"/api/todos?completed=true\", headers=self.headers).json[\"total\"], 1\n+        )\n+\n+    def test_validation(self):\n+        for fields, field in (\n+            ({\"title\": \" \"}, \"title\"),\n+            ({\"title\": 123}, \"title\"),\n+            ({\"title\": \"x\" * 201}, \"title\"),\n+            ({\"description\": []}, \"description\"),\n+            ({\"priority\": \"urgent\"}, \"priority\"),\n+            ({\"priority\": []}, \"priority\"),\n+            ({\"due_date\": \"2026-02-30\"}, \"due_date\"),\n+            ({\"due_date\": \"20260101\"}, \"due_date\"),\n+            ({\"due_date\": 123}, \"due_date\"),\n+            ({\"completed\": \"false\"}, \"completed\"),\n+            ({\"user_id\": 2}, \"user_id\"),\n+        ):\n+            response = self.client.post(\n+                \"/api/todos\", headers=self.headers, json={\"title\": \"Valid\", **fields}\n+            )\n+            self.assertEqual(response.status_code, 400, fields)\n+            self.assertIn(field, response.json[\"errors\"])\n+        for query in (\"page=0\", \"page=-1\", \"page=abc\", \"page_size=101\", \"page_size=0\",\n+                      \"completed=maybe\", \"priority=urgent\", \"page=9999999999999999999999\"):\n+            self.assertEqual(\n+                self.client.get(f\"/api/todos?{query}\", headers=self.headers).status_code, 400\n+            )\n+        for body in ([], None, \"not an object\"):\n+            self.assertEqual(\n+                self.client.post(\"/api/todos\", headers=self.headers, json=body).status_code, 400\n+            )\n+        self.assertEqual(\n+            self.client.post(\n+                \"/api/todos\", headers=self.headers, data=\"{\", content_type=\"application/json\"\n+            ).status_code, 400\n+        )\n+        invalid_account = self.client.post(\n+            \"/api/auth/register\", json={\"username\": \"x\", \"password\": \"short\"}\n+        )\n+        self.assertEqual(invalid_account.status_code, 400)\n+        self.assertEqual(set(invalid_account.json[\"errors\"]), {\"username\", \"password\"})\n+\n+    def test_persistence_and_secure_storage(self):\n+        todo = self.add(completed=True)\n+        restarted = create_app({\"TESTING\": True, \"DATABASE\": self.path}).test_client()\n+        self.assertEqual(restarted.get(\"/api/todos\", headers=self.headers).json[\"items\"], [todo])\n+        with sqlite3.connect(self.path) as db:\n+            password_hash = db.execute(\"SELECT password_hash FROM users\").fetchone()[0]\n+            token_hash = db.execute(\"SELECT token_hash FROM sessions\").fetchone()[0]\n+        self.assertNotEqual(password_hash, \"password123\")\n+        token = self.headers[\"Authorization\"].split()[1]\n+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())\n+        self.assertNotEqual(token_hash, token)\n+        self.assertEqual(\n+            restarted.post(\"/api/auth/logout\", headers=self.headers).status_code, 204\n+        )\n+        self.assertEqual(restarted.get(\"/api/todos\", headers=self.headers).status_code, 401)\n+\n+    def test_api_errors_and_security_headers(self):\n+        response = self.client.get(\"/api/not-real\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertTrue(response.is_json)\n+        self.assertEqual(response.headers[\"Cache-Control\"], \"no-store\")\n+        self.assertEqual(response.headers[\"X-Content-Type-Options\"], \"nosniff\")\n+        self.assertEqual(self.client.put(\"/api/todos\", headers=self.headers).status_code, 405)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** Add File: /workspace/backend/requirements-dev.txt\n+-r requirements.txt\n+ruff>=0.14,<1\n*** Add File: /workspace/.gitignore\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+**/.venv/\n+.ruff_cache/\n*** End Patch"},"output":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/test_app.py\nA backend/requirements-dev.txt\nA .gitignore","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n\nIndex: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,435 @@\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import date, datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+PRIORITIES = (\"low\", \"medium\", \"high\")\n+TODO_FIELDS = {\"title\", \"description\", \"priority\", \"due_date\", \"completed\"}\n+\n+\n+def now():\n+    return datetime.now(timezone.utc).isoformat()\n+\n+\n+def database():\n+    if \"db\" not in g:\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=15)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def error(message, status=400, errors=None):\n+    result = {\"error\": message}\n+    if errors:\n+        result[\"errors\"] = errors\n+    return result, status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return error(\"Please sign in to continue.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = database().execute(\n+            \"SELECT users.id, users.username FROM sessions \"\n+            \"JOIN users ON users.id = sessions.user_id \"\n+            \"WHERE token_hash = ? AND expires_at > ?\",\n+            (token_hash, now()),\n+        ).fetchone()\n+        if user is None:\n+            return error(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = token_hash\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    return body if isinstance(body, dict) else None\n+\n+\n+def credentials(body):\n+    errors = {}\n+    username = body.get(\"username\")\n+    password = body.get(\"password\")\n+    if not isinstance(username, str) or not re.fullmatch(\n+        r\"[A-Za-z0-9_.-]{3,32}\", username.strip()\n+    ):\n+        errors[\"username\"] = (\n+            \"Use 3–32 letters, numbers, dots, hyphens, or underscores.\"\n+        )\n+    if not isinstance(password, str) or not 8 <= len(password) <= 128:\n+        errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n+    return errors\n+\n+\n+def validate_todo(body, partial=False):\n+    values = {}\n+    errors = {}\n+    for field in body.keys() - TODO_FIELDS:\n+        errors[field] = \"This field cannot be changed.\"\n+    if \"title\" in body or not partial:\n+        title = body.get(\"title\")\n+        if not isinstance(title, str) or not 1 <= len(title.strip()) <= 200:\n+            errors[\"title\"] = \"Give your task a title between 1 and 200 characters.\"\n+        else:\n+            values[\"title\"] = title.strip()\n+    if \"description\" in body or not partial:\n+        description = body.get(\"description\", \"\")\n+        if description is not None and (\n+            not isinstance(description, str) or len(description) > 5000\n+        ):\n+            errors[\"description\"] = \"Keep the description under 5,000 characters.\"\n+        else:\n+            values[\"description\"] = description\n+    if \"priority\" in body or not partial:\n+        priority = body.get(\"priority\", \"medium\")\n+        if not isinstance(priority, str) or priority not in PRIORITIES:\n+            errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n+        else:\n+            values[\"priority\"] = priority\n+    if \"due_date\" in body or not partial:\n+        due_date = body.get(\"due_date\")\n+        if due_date is not None:\n+            try:\n+                if not isinstance(due_date, str) or not re.fullmatch(\n+                    r\"\\d{4}-\\d{2}-\\d{2}\", due_date\n+                ):\n+                    raise ValueError\n+                date.fromisoformat(due_date)\n+            except ValueError:\n+                errors[\"due_date\"] = \"Choose a valid date in YYYY-MM-DD format.\"\n+        values[\"due_date\"] = due_date\n+    if \"completed\" in body or not partial:\n+        completed = body.get(\"completed\", False)\n+        if not isinstance(completed, bool):\n+            errors[\"completed\"] = \"Completed must be true or false.\"\n+        else:\n+            values[\"completed\"] = completed\n+    return values, errors\n+\n+\n+def serialize(row):\n+    todo = dict(row)\n+    todo.pop(\"user_id\", None)\n+    todo[\"completed\"] = bool(todo[\"completed\"])\n+    return todo\n+\n+\n+def owned_todo(todo_id):\n+    return database().execute(\n+        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\",\n+        (todo_id, g.user[\"id\"]),\n+    ).fetchone()\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"todos.sqlite3\"),\n+        MAX_CONTENT_LENGTH=64 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = database()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS todos (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                title TEXT NOT NULL,\n+                description TEXT,\n+                priority TEXT NOT NULL CHECK (priority IN ('low', 'medium', 'high')),\n+                due_date TEXT,\n+                completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1)),\n+                completed_at TEXT,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS todos_user_order\n+                ON todos(user_id, completed, due_date, created_at DESC);\n+            CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_database(_exception):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def handle_http_error(exception):\n+        if request.path.startswith(\"/api/\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        else:\n+            response.headers[\"Content-Security-Policy\"] = (\n+                \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n+                \"img-src 'self' data:; connect-src 'self'; font-src 'self'; \"\n+                \"object-src 'none'; base-uri 'self'; frame-ancestors 'none'\"\n+            )\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your username and password.\")\n+        errors = credentials(body)\n+        if errors:\n+            return error(\"Please check your account details.\", errors=errors)\n+        db = database()\n+        try:\n+            with db:\n+                cursor = db.execute(\n+                    \"INSERT INTO users (username, password_hash, created_at) \"\n+                    \"VALUES (?, ?, ?)\",\n+                    (\n+                        body[\"username\"].strip(),\n+                        generate_password_hash(body[\"password\"]),\n+                        now(),\n+                    ),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\n+                \"That username is already taken.\",\n+                409,\n+                {\"username\": \"That username is already taken. Try another.\"},\n+            )\n+        return {\"id\": cursor.lastrowid, \"username\": body[\"username\"].strip()}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your username and password.\")\n+        errors = credentials(body)\n+        if errors:\n+            return error(\"Please check your account details.\", errors=errors)\n+        db = database()\n+        user = db.execute(\n+            \"SELECT * FROM users WHERE username = ?\", (body[\"username\"].strip(),)\n+        ).fetchone()\n+        password_hash = user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"]\n+        valid = check_password_hash(password_hash, body[\"password\"])\n+        if user is None or not valid:\n+            return error(\"The username or password is incorrect.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (now(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (\n+                    hashlib.sha256(token.encode()).hexdigest(),\n+                    user[\"id\"],\n+                    (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(),\n+                ),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return dict(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = database()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.get(\"/api/todos\")\n+    @authenticated\n+    def list_todos():\n+        conditions = [\"user_id = ?\"]\n+        params = [g.user[\"id\"]]\n+        errors = {}\n+        completed = request.args.get(\"completed\")\n+        if completed is not None:\n+            if completed not in (\"true\", \"false\", \"1\", \"0\"):\n+                errors[\"completed\"] = \"Completed must be true or false.\"\n+            else:\n+                conditions.append(\"completed = ?\")\n+                params.append(int(completed in (\"true\", \"1\")))\n+        priority = request.args.get(\"priority\")\n+        if priority is not None:\n+            if priority not in PRIORITIES:\n+                errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n+            else:\n+                conditions.append(\"priority = ?\")\n+                params.append(priority)\n+        pagination = {}\n+        for field, default, maximum in (\n+            (\"page\", 1, 2147483647),\n+            (\"page_size\", 20, 100),\n+        ):\n+            raw = request.args.get(field, str(default))\n+            try:\n+                if not re.fullmatch(r\"[0-9]{1,10}\", raw):\n+                    raise ValueError\n+                value = int(raw)\n+                if not 1 <= value <= maximum:\n+                    raise ValueError\n+                pagination[field] = value\n+            except ValueError:\n+                errors[field] = f\"Choose a whole number between 1 and {maximum}.\"\n+        if errors:\n+            return error(\"Please check your filters.\", errors=errors)\n+        where = \" AND \".join(conditions)\n+        db = database()\n+        page, page_size = pagination[\"page\"], pagination[\"page_size\"]\n+        offset = (page - 1) * page_size\n+        total = db.execute(\n+            f\"SELECT COUNT(*) FROM todos WHERE {where}\", params\n+        ).fetchone()[0]\n+        rows = db.execute(\n+            f\"SELECT * FROM todos WHERE {where} \"\n+            \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n+            \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n+            [*params, page_size, offset],\n+        ).fetchall()\n+        return {\n+            \"items\": [serialize(row) for row in rows],\n+            \"total\": total,\n+            \"page\": page,\n+            \"page_size\": page_size,\n+            \"remaining\": max(0, total - offset - len(rows)),\n+        }\n+\n+    @app.post(\"/api/todos\")\n+    @authenticated\n+    def add_todo():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your task details.\")\n+        values, errors = validate_todo(body)\n+        if errors:\n+            return error(\"Please check your task details.\", errors=errors)\n+        timestamp = now()\n+        db = database()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n+                \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n+                (\n+                    g.user[\"id\"],\n+                    values[\"title\"],\n+                    values[\"description\"],\n+                    values[\"priority\"],\n+                    values[\"due_date\"],\n+                    values[\"completed\"],\n+                    timestamp if values[\"completed\"] else None,\n+                    timestamp,\n+                ),\n+            )\n+        return serialize(owned_todo(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def get_todo(todo_id):\n+        row = owned_todo(todo_id)\n+        if row is None:\n+            return error(\"Task not found.\", 404)\n+        return serialize(row)\n+\n+    @app.patch(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def update_todo(todo_id):\n+        db = database()\n+        with db:\n+            db.execute(\"BEGIN IMMEDIATE\")\n+            row = owned_todo(todo_id)\n+            if row is None:\n+                return error(\"Task not found.\", 404)\n+            body = json_body()\n+            if body is None:\n+                return error(\"Send a JSON object with your task details.\")\n+            values, errors = validate_todo(body, partial=True)\n+            if errors:\n+                return error(\"Please check your task details.\", errors=errors)\n+            if \"completed\" in values and values[\"completed\"] != bool(row[\"completed\"]):\n+                values[\"completed_at\"] = now() if values[\"completed\"] else None\n+            if values:\n+                assignments = \", \".join(f\"{field} = ?\" for field in values)\n+                db.execute(\n+                    f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n+                    [*values.values(), todo_id, g.user[\"id\"]],\n+                )\n+            result = serialize(owned_todo(todo_id))\n+        return result\n+\n+    @app.delete(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def delete_todo(todo_id):\n+        db = database()\n+        with db:\n+            cursor = db.execute(\n+                \"DELETE FROM todos WHERE id = ? AND user_id = ?\",\n+                (todo_id, g.user[\"id\"]),\n+            )\n+        if cursor.rowcount == 0:\n+            return error(\"Task not found.\", 404)\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\nIndex: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,206 @@\n+import hashlib\n+import sqlite3\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app\n+\n+\n+class TodoApiTests(unittest.TestCase):\n+    def setUp(self):\n+        self.temp = tempfile.TemporaryDirectory()\n+        self.path = str(Path(self.temp.name) / \"todos.sqlite3\")\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.path})\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.temp.cleanup()\n+\n+    def account(self, username):\n+        credentials = {\"username\": username, \"password\": \"password123\"}\n+        self.assertEqual(\n+            self.client.post(\"/api/auth/register\", json=credentials).status_code, 201\n+        )\n+        response = self.client.post(\"/api/auth/login\", json=credentials)\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def add(self, **fields):\n+        response = self.client.post(\n+            \"/api/todos\", headers=self.headers, json={\"title\": \"A task\", **fields}\n+        )\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def test_health_and_authentication(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        for method, url in (\n+            (\"GET\", \"/api/todos\"),\n+            (\"POST\", \"/api/todos\"),\n+            (\"GET\", \"/api/todos/1\"),\n+            (\"PATCH\", \"/api/todos/1\"),\n+            (\"DELETE\", \"/api/todos/1\"),\n+        ):\n+            self.assertEqual(self.client.open(url, method=method).status_code, 401)\n+            self.assertEqual(\n+                self.client.open(\n+                    url, method=method, headers={\"Authorization\": \"Bearer invalid\"}\n+                ).status_code,\n+                401,\n+            )\n+        self.assertEqual(\n+            self.client.get(\"/api/auth/me\", headers=self.headers).json[\"username\"],\n+            \"alice\",\n+        )\n+        duplicate = self.client.post(\n+            \"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"password123\"}\n+        )\n+        self.assertEqual(duplicate.status_code, 409)\n+        self.assertIn(\"username\", duplicate.json[\"errors\"])\n+        self.assertEqual(\n+            self.client.post(\n+                \"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrongpassword\"}\n+            ).status_code,\n+            401,\n+        )\n+\n+    def test_crud_and_completion_transitions(self):\n+        todo = self.add(title=\"  Plan the week  \", description=\"Notes\", priority=\"high\")\n+        self.assertEqual(todo[\"title\"], \"Plan the week\")\n+        self.assertEqual(\n+            set(todo),\n+            {\"id\", \"title\", \"description\", \"priority\", \"due_date\", \"completed\",\n+             \"completed_at\", \"created_at\"},\n+        )\n+        self.assertFalse(todo[\"completed\"])\n+        self.assertIsNone(todo[\"completed_at\"])\n+        url = f\"/api/todos/{todo['id']}\"\n+        completed = self.client.patch(url, headers=self.headers, json={\"completed\": True}).json\n+        self.assertTrue(completed[\"completed\"])\n+        self.assertIsNotNone(completed[\"completed_at\"])\n+        again = self.client.patch(url, headers=self.headers, json={\"completed\": True}).json\n+        self.assertEqual(again[\"completed_at\"], completed[\"completed_at\"])\n+        updated = self.client.patch(url, headers=self.headers, json={\"title\": \"New title\"}).json\n+        self.assertEqual(updated[\"description\"], \"Notes\")\n+        self.assertEqual(updated[\"completed_at\"], completed[\"completed_at\"])\n+        reopened = self.client.patch(\n+            url, headers=self.headers, json={\"completed\": False, \"description\": None}\n+        ).json\n+        self.assertIsNone(reopened[\"completed_at\"])\n+        self.assertIsNone(reopened[\"description\"])\n+        self.assertEqual(self.client.get(url, headers=self.headers).json, reopened)\n+        self.assertEqual(self.client.patch(url, headers=self.headers, json={}).json, reopened)\n+        self.assertEqual(self.client.delete(url, headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(url, headers=self.headers).status_code, 404)\n+        self.assertEqual(self.client.delete(url, headers=self.headers).status_code, 404)\n+\n+    def test_private_lists(self):\n+        todo = self.add()\n+        bob = self.account(\"bob\")\n+        self.assertEqual(self.client.get(\"/api/todos\", headers=bob).json[\"total\"], 0)\n+        for method in (\"GET\", \"PATCH\", \"DELETE\"):\n+            response = self.client.open(\n+                f\"/api/todos/{todo['id']}\", method=method, headers=bob, json={\"title\": \"Stolen\"}\n+            )\n+            self.assertEqual(response.status_code, 404)\n+        self.assertEqual(self.client.get(\"/api/todos\", headers=self.headers).json[\"total\"], 1)\n+\n+    def test_sorting_filters_and_pagination(self):\n+        undated_old = self.add(title=\"Old undated\")\n+        completed = self.add(title=\"Done\", due_date=\"2020-01-01\", completed=True)\n+        later = self.add(title=\"Later\", due_date=\"2030-06-01\", priority=\"high\")\n+        earlier_old = self.add(title=\"Earlier old\", due_date=\"2030-05-01\")\n+        earlier_new = self.add(title=\"Earlier new\", due_date=\"2030-05-01\", priority=\"high\")\n+        undated_new = self.add(title=\"New undated\")\n+        result = self.client.get(\"/api/todos\", headers=self.headers).json\n+        self.assertEqual(\n+            [item[\"id\"] for item in result[\"items\"]],\n+            [earlier_new[\"id\"], earlier_old[\"id\"], later[\"id\"],\n+             undated_new[\"id\"], undated_old[\"id\"], completed[\"id\"]],\n+        )\n+        page = self.client.get(\"/api/todos?page=2&page_size=2\", headers=self.headers).json\n+        self.assertEqual(page[\"total\"], 6)\n+        self.assertEqual(page[\"page\"], 2)\n+        self.assertEqual(page[\"page_size\"], 2)\n+        self.assertEqual(page[\"remaining\"], 2)\n+        self.assertEqual(len(page[\"items\"]), 2)\n+        empty = self.client.get(\"/api/todos?page=20&page_size=2\", headers=self.headers).json\n+        self.assertEqual(empty[\"items\"], [])\n+        self.assertEqual(empty[\"remaining\"], 0)\n+        filtered = self.client.get(\n+            \"/api/todos?completed=false&priority=high\", headers=self.headers\n+        ).json\n+        self.assertEqual(filtered[\"total\"], 2)\n+        self.assertTrue(all(item[\"priority\"] == \"high\" for item in filtered[\"items\"]))\n+        self.assertEqual(\n+            self.client.get(\"/api/todos?completed=true\", headers=self.headers).json[\"total\"], 1\n+        )\n+\n+    def test_validation(self):\n+        for fields, field in (\n+            ({\"title\": \" \"}, \"title\"),\n+            ({\"title\": 123}, \"title\"),\n+            ({\"title\": \"x\" * 201}, \"title\"),\n+            ({\"description\": []}, \"description\"),\n+            ({\"priority\": \"urgent\"}, \"priority\"),\n+            ({\"priority\": []}, \"priority\"),\n+            ({\"due_date\": \"2026-02-30\"}, \"due_date\"),\n+            ({\"due_date\": \"20260101\"}, \"due_date\"),\n+            ({\"due_date\": 123}, \"due_date\"),\n+            ({\"completed\": \"false\"}, \"completed\"),\n+            ({\"user_id\": 2}, \"user_id\"),\n+        ):\n+            response = self.client.post(\n+                \"/api/todos\", headers=self.headers, json={\"title\": \"Valid\", **fields}\n+            )\n+            self.assertEqual(response.status_code, 400, fields)\n+            self.assertIn(field, response.json[\"errors\"])\n+        for query in (\"page=0\", \"page=-1\", \"page=abc\", \"page_size=101\", \"page_size=0\",\n+                      \"completed=maybe\", \"priority=urgent\", \"page=9999999999999999999999\"):\n+            self.assertEqual(\n+                self.client.get(f\"/api/todos?{query}\", headers=self.headers).status_code, 400\n+            )\n+        for body in ([], None, \"not an object\"):\n+            self.assertEqual(\n+                self.client.post(\"/api/todos\", headers=self.headers, json=body).status_code, 400\n+            )\n+        self.assertEqual(\n+            self.client.post(\n+                \"/api/todos\", headers=self.headers, data=\"{\", content_type=\"application/json\"\n+            ).status_code, 400\n+        )\n+        invalid_account = self.client.post(\n+            \"/api/auth/register\", json={\"username\": \"x\", \"password\": \"short\"}\n+        )\n+        self.assertEqual(invalid_account.status_code, 400)\n+        self.assertEqual(set(invalid_account.json[\"errors\"]), {\"username\", \"password\"})\n+\n+    def test_persistence_and_secure_storage(self):\n+        todo = self.add(completed=True)\n+        restarted = create_app({\"TESTING\": True, \"DATABASE\": self.path}).test_client()\n+        self.assertEqual(restarted.get(\"/api/todos\", headers=self.headers).json[\"items\"], [todo])\n+        with sqlite3.connect(self.path) as db:\n+            password_hash = db.execute(\"SELECT password_hash FROM users\").fetchone()[0]\n+            token_hash = db.execute(\"SELECT token_hash FROM sessions\").fetchone()[0]\n+        self.assertNotEqual(password_hash, \"password123\")\n+        token = self.headers[\"Authorization\"].split()[1]\n+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())\n+        self.assertNotEqual(token_hash, token)\n+        self.assertEqual(\n+            restarted.post(\"/api/auth/logout\", headers=self.headers).status_code, 204\n+        )\n+        self.assertEqual(restarted.get(\"/api/todos\", headers=self.headers).status_code, 401)\n+\n+    def test_api_errors_and_security_headers(self):\n+        response = self.client.get(\"/api/not-real\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertTrue(response.is_json)\n+        self.assertEqual(response.headers[\"Cache-Control\"], \"no-store\")\n+        self.assertEqual(response.headers[\"X-Content-Type-Options\"], \"nosniff\")\n+        self.assertEqual(self.client.put(\"/api/todos\", headers=self.headers).status_code, 405)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\nIndex: /workspace/backend/requirements-dev.txt\n===================================================================\n--- /workspace/backend/requirements-dev.txt\n+++ /workspace/backend/requirements-dev.txt\n@@ -0,0 +1,2 @@\n+-r requirements.txt\n+ruff>=0.14,<1\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,6 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+**/.venv/\n+.ruff_cache/\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,435 @@\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import date, datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, current_app, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+PRIORITIES = (\"low\", \"medium\", \"high\")\n+TODO_FIELDS = {\"title\", \"description\", \"priority\", \"due_date\", \"completed\"}\n+\n+\n+def now():\n+    return datetime.now(timezone.utc).isoformat()\n+\n+\n+def database():\n+    if \"db\" not in g:\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=15)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def error(message, status=400, errors=None):\n+    result = {\"error\": message}\n+    if errors:\n+        result[\"errors\"] = errors\n+    return result, status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return error(\"Please sign in to continue.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = database().execute(\n+            \"SELECT users.id, users.username FROM sessions \"\n+            \"JOIN users ON users.id = sessions.user_id \"\n+            \"WHERE token_hash = ? AND expires_at > ?\",\n+            (token_hash, now()),\n+        ).fetchone()\n+        if user is None:\n+            return error(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = token_hash\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    return body if isinstance(body, dict) else None\n+\n+\n+def credentials(body):\n+    errors = {}\n+    username = body.get(\"username\")\n+    password = body.get(\"password\")\n+    if not isinstance(username, str) or not re.fullmatch(\n+        r\"[A-Za-z0-9_.-]{3,32}\", username.strip()\n+    ):\n+        errors[\"username\"] = (\n+            \"Use 3–32 letters, numbers, dots, hyphens, or underscores.\"\n+        )\n+    if not isinstance(password, str) or not 8 <= len(password) <= 128:\n+        errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n+    return errors\n+\n+\n+def validate_todo(body, partial=False):\n+    values = {}\n+    errors = {}\n+    for field in body.keys() - TODO_FIELDS:\n+        errors[field] = \"This field cannot be changed.\"\n+    if \"title\" in body or not partial:\n+        title = body.get(\"title\")\n+        if not isinstance(title, str) or not 1 <= len(title.strip()) <= 200:\n+            errors[\"title\"] = \"Give your task a title between 1 and 200 characters.\"\n+        else:\n+            values[\"title\"] = title.strip()\n+    if \"description\" in body or not partial:\n+        description = body.get(\"description\", \"\")\n+        if description is not None and (\n+            not isinstance(description, str) or len(description) > 5000\n+        ):\n+            errors[\"description\"] = \"Keep the description under 5,000 characters.\"\n+        else:\n+            values[\"description\"] = description\n+    if \"priority\" in body or not partial:\n+        priority = body.get(\"priority\", \"medium\")\n+        if not isinstance(priority, str) or priority not in PRIORITIES:\n+            errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n+        else:\n+            values[\"priority\"] = priority\n+    if \"due_date\" in body or not partial:\n+        due_date = body.get(\"due_date\")\n+        if due_date is not None:\n+            try:\n+                if not isinstance(due_date, str) or not re.fullmatch(\n+                    r\"\\d{4}-\\d{2}-\\d{2}\", due_date\n+                ):\n+                    raise ValueError\n+                date.fromisoformat(due_date)\n+            except ValueError:\n+                errors[\"due_date\"] = \"Choose a valid date in YYYY-MM-DD format.\"\n+        values[\"due_date\"] = due_date\n+    if \"completed\" in body or not partial:\n+        completed = body.get(\"completed\", False)\n+        if not isinstance(completed, bool):\n+            errors[\"completed\"] = \"Completed must be true or false.\"\n+        else:\n+            values[\"completed\"] = completed\n+    return values, errors\n+\n+\n+def serialize(row):\n+    todo = dict(row)\n+    todo.pop(\"user_id\", None)\n+    todo[\"completed\"] = bool(todo[\"completed\"])\n+    return todo\n+\n+\n+def owned_todo(todo_id):\n+    return database().execute(\n+        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\",\n+        (todo_id, g.user[\"id\"]),\n+    ).fetchone()\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"todos.sqlite3\"),\n+        MAX_CONTENT_LENGTH=64 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = database()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\n+            \"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS todos (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                title TEXT NOT NULL,\n+                description TEXT,\n+                priority TEXT NOT NULL CHECK (priority IN ('low', 'medium', 'high')),\n+                due_date TEXT,\n+                completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1)),\n+                completed_at TEXT,\n+                created_at TEXT NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS todos_user_order\n+                ON todos(user_id, completed, due_date, created_at DESC);\n+            CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n+            \"\"\"\n+        )\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_database(_exception):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.errorhandler(HTTPException)\n+    def handle_http_error(exception):\n+        if request.path.startswith(\"/api/\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        else:\n+            response.headers[\"Content-Security-Policy\"] = (\n+                \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n+                \"img-src 'self' data:; connect-src 'self'; font-src 'self'; \"\n+                \"object-src 'none'; base-uri 'self'; frame-ancestors 'none'\"\n+            )\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your username and password.\")\n+        errors = credentials(body)\n+        if errors:\n+            return error(\"Please check your account details.\", errors=errors)\n+        db = database()\n+        try:\n+            with db:\n+                cursor = db.execute(\n+                    \"INSERT INTO users (username, password_hash, created_at) \"\n+                    \"VALUES (?, ?, ?)\",\n+                    (\n+                        body[\"username\"].strip(),\n+                        generate_password_hash(body[\"password\"]),\n+                        now(),\n+                    ),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\n+                \"That username is already taken.\",\n+                409,\n+                {\"username\": \"That username is already taken. Try another.\"},\n+            )\n+        return {\"id\": cursor.lastrowid, \"username\": body[\"username\"].strip()}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your username and password.\")\n+        errors = credentials(body)\n+        if errors:\n+            return error(\"Please check your account details.\", errors=errors)\n+        db = database()\n+        user = db.execute(\n+            \"SELECT * FROM users WHERE username = ?\", (body[\"username\"].strip(),)\n+        ).fetchone()\n+        password_hash = user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"]\n+        valid = check_password_hash(password_hash, body[\"password\"])\n+        if user is None or not valid:\n+            return error(\"The username or password is incorrect.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (now(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (\n+                    hashlib.sha256(token.encode()).hexdigest(),\n+                    user[\"id\"],\n+                    (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(),\n+                ),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return dict(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = database()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.get(\"/api/todos\")\n+    @authenticated\n+    def list_todos():\n+        conditions = [\"user_id = ?\"]\n+        params = [g.user[\"id\"]]\n+        errors = {}\n+        completed = request.args.get(\"completed\")\n+        if completed is not None:\n+            if completed not in (\"true\", \"false\", \"1\", \"0\"):\n+                errors[\"completed\"] = \"Completed must be true or false.\"\n+            else:\n+                conditions.append(\"completed = ?\")\n+                params.append(int(completed in (\"true\", \"1\")))\n+        priority = request.args.get(\"priority\")\n+        if priority is not None:\n+            if priority not in PRIORITIES:\n+                errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n+            else:\n+                conditions.append(\"priority = ?\")\n+                params.append(priority)\n+        pagination = {}\n+        for field, default, maximum in (\n+            (\"page\", 1, 2147483647),\n+            (\"page_size\", 20, 100),\n+        ):\n+            raw = request.args.get(field, str(default))\n+            try:\n+                if not re.fullmatch(r\"[0-9]{1,10}\", raw):\n+                    raise ValueError\n+                value = int(raw)\n+                if not 1 <= value <= maximum:\n+                    raise ValueError\n+                pagination[field] = value\n+            except ValueError:\n+                errors[field] = f\"Choose a whole number between 1 and {maximum}.\"\n+        if errors:\n+            return error(\"Please check your filters.\", errors=errors)\n+        where = \" AND \".join(conditions)\n+        db = database()\n+        page, page_size = pagination[\"page\"], pagination[\"page_size\"]\n+        offset = (page - 1) * page_size\n+        total = db.execute(\n+            f\"SELECT COUNT(*) FROM todos WHERE {where}\", params\n+        ).fetchone()[0]\n+        rows = db.execute(\n+            f\"SELECT * FROM todos WHERE {where} \"\n+            \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n+            \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n+            [*params, page_size, offset],\n+        ).fetchall()\n+        return {\n+            \"items\": [serialize(row) for row in rows],\n+            \"total\": total,\n+            \"page\": page,\n+            \"page_size\": page_size,\n+            \"remaining\": max(0, total - offset - len(rows)),\n+        }\n+\n+    @app.post(\"/api/todos\")\n+    @authenticated\n+    def add_todo():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with your task details.\")\n+        values, errors = validate_todo(body)\n+        if errors:\n+            return error(\"Please check your task details.\", errors=errors)\n+        timestamp = now()\n+        db = database()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n+                \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n+                (\n+                    g.user[\"id\"],\n+                    values[\"title\"],\n+                    values[\"description\"],\n+                    values[\"priority\"],\n+                    values[\"due_date\"],\n+                    values[\"completed\"],\n+                    timestamp if values[\"completed\"] else None,\n+                    timestamp,\n+                ),\n+            )\n+        return serialize(owned_todo(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def get_todo(todo_id):\n+        row = owned_todo(todo_id)\n+        if row is None:\n+            return error(\"Task not found.\", 404)\n+        return serialize(row)\n+\n+    @app.patch(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def update_todo(todo_id):\n+        db = database()\n+        with db:\n+            db.execute(\"BEGIN IMMEDIATE\")\n+            row = owned_todo(todo_id)\n+            if row is None:\n+                return error(\"Task not found.\", 404)\n+            body = json_body()\n+            if body is None:\n+                return error(\"Send a JSON object with your task details.\")\n+            values, errors = validate_todo(body, partial=True)\n+            if errors:\n+                return error(\"Please check your task details.\", errors=errors)\n+            if \"completed\" in values and values[\"completed\"] != bool(row[\"completed\"]):\n+                values[\"completed_at\"] = now() if values[\"completed\"] else None\n+            if values:\n+                assignments = \", \".join(f\"{field} = ?\" for field in values)\n+                db.execute(\n+                    f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n+                    [*values.values(), todo_id, g.user[\"id\"]],\n+                )\n+            result = serialize(owned_todo(todo_id))\n+        return result\n+\n+    @app.delete(\"/api/todos/<int:todo_id>\")\n+    @authenticated\n+    def delete_todo(todo_id):\n+        db = database()\n+        with db:\n+            cursor = db.execute(\n+                \"DELETE FROM todos WHERE id = ? AND user_id = ?\",\n+                (todo_id, g.user[\"id\"]),\n+            )\n+        if cursor.rowcount == 0:\n+            return error(\"Task not found.\", 404)\n+        return \"\", 204\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n","additions":435,"deletions":0},{"filePath":"/workspace/backend/test_app.py","relativePath":"backend/test_app.py","type":"add","patch":"Index: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,206 @@\n+import hashlib\n+import sqlite3\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app\n+\n+\n+class TodoApiTests(unittest.TestCase):\n+    def setUp(self):\n+        self.temp = tempfile.TemporaryDirectory()\n+        self.path = str(Path(self.temp.name) / \"todos.sqlite3\")\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.path})\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.temp.cleanup()\n+\n+    def account(self, username):\n+        credentials = {\"username\": username, \"password\": \"password123\"}\n+        self.assertEqual(\n+            self.client.post(\"/api/auth/register\", json=credentials).status_code, 201\n+        )\n+        response = self.client.post(\"/api/auth/login\", json=credentials)\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": f\"Bearer {response.json['token']}\"}\n+\n+    def add(self, **fields):\n+        response = self.client.post(\n+            \"/api/todos\", headers=self.headers, json={\"title\": \"A task\", **fields}\n+        )\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def test_health_and_authentication(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        for method, url in (\n+            (\"GET\", \"/api/todos\"),\n+            (\"POST\", \"/api/todos\"),\n+            (\"GET\", \"/api/todos/1\"),\n+            (\"PATCH\", \"/api/todos/1\"),\n+            (\"DELETE\", \"/api/todos/1\"),\n+        ):\n+            self.assertEqual(self.client.open(url, method=method).status_code, 401)\n+            self.assertEqual(\n+                self.client.open(\n+                    url, method=method, headers={\"Authorization\": \"Bearer invalid\"}\n+                ).status_code,\n+                401,\n+            )\n+        self.assertEqual(\n+            self.client.get(\"/api/auth/me\", headers=self.headers).json[\"username\"],\n+            \"alice\",\n+        )\n+        duplicate = self.client.post(\n+            \"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"password123\"}\n+        )\n+        self.assertEqual(duplicate.status_code, 409)\n+        self.assertIn(\"username\", duplicate.json[\"errors\"])\n+        self.assertEqual(\n+            self.client.post(\n+                \"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrongpassword\"}\n+            ).status_code,\n+            401,\n+        )\n+\n+    def test_crud_and_completion_transitions(self):\n+        todo = self.add(title=\"  Plan the week  \", description=\"Notes\", priority=\"high\")\n+        self.assertEqual(todo[\"title\"], \"Plan the week\")\n+        self.assertEqual(\n+            set(todo),\n+            {\"id\", \"title\", \"description\", \"priority\", \"due_date\", \"completed\",\n+             \"completed_at\", \"created_at\"},\n+        )\n+        self.assertFalse(todo[\"completed\"])\n+        self.assertIsNone(todo[\"completed_at\"])\n+        url = f\"/api/todos/{todo['id']}\"\n+        completed = self.client.patch(url, headers=self.headers, json={\"completed\": True}).json\n+        self.assertTrue(completed[\"completed\"])\n+        self.assertIsNotNone(completed[\"completed_at\"])\n+        again = self.client.patch(url, headers=self.headers, json={\"completed\": True}).json\n+        self.assertEqual(again[\"completed_at\"], completed[\"completed_at\"])\n+        updated = self.client.patch(url, headers=self.headers, json={\"title\": \"New title\"}).json\n+        self.assertEqual(updated[\"description\"], \"Notes\")\n+        self.assertEqual(updated[\"completed_at\"], completed[\"completed_at\"])\n+        reopened = self.client.patch(\n+            url, headers=self.headers, json={\"completed\": False, \"description\": None}\n+        ).json\n+        self.assertIsNone(reopened[\"completed_at\"])\n+        self.assertIsNone(reopened[\"description\"])\n+        self.assertEqual(self.client.get(url, headers=self.headers).json, reopened)\n+        self.assertEqual(self.client.patch(url, headers=self.headers, json={}).json, reopened)\n+        self.assertEqual(self.client.delete(url, headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(url, headers=self.headers).status_code, 404)\n+        self.assertEqual(self.client.delete(url, headers=self.headers).status_code, 404)\n+\n+    def test_private_lists(self):\n+        todo = self.add()\n+        bob = self.account(\"bob\")\n+        self.assertEqual(self.client.get(\"/api/todos\", headers=bob).json[\"total\"], 0)\n+        for method in (\"GET\", \"PATCH\", \"DELETE\"):\n+            response = self.client.open(\n+                f\"/api/todos/{todo['id']}\", method=method, headers=bob, json={\"title\": \"Stolen\"}\n+            )\n+            self.assertEqual(response.status_code, 404)\n+        self.assertEqual(self.client.get(\"/api/todos\", headers=self.headers).json[\"total\"], 1)\n+\n+    def test_sorting_filters_and_pagination(self):\n+        undated_old = self.add(title=\"Old undated\")\n+        completed = self.add(title=\"Done\", due_date=\"2020-01-01\", completed=True)\n+        later = self.add(title=\"Later\", due_date=\"2030-06-01\", priority=\"high\")\n+        earlier_old = self.add(title=\"Earlier old\", due_date=\"2030-05-01\")\n+        earlier_new = self.add(title=\"Earlier new\", due_date=\"2030-05-01\", priority=\"high\")\n+        undated_new = self.add(title=\"New undated\")\n+        result = self.client.get(\"/api/todos\", headers=self.headers).json\n+        self.assertEqual(\n+            [item[\"id\"] for item in result[\"items\"]],\n+            [earlier_new[\"id\"], earlier_old[\"id\"], later[\"id\"],\n+             undated_new[\"id\"], undated_old[\"id\"], completed[\"id\"]],\n+        )\n+        page = self.client.get(\"/api/todos?page=2&page_size=2\", headers=self.headers).json\n+        self.assertEqual(page[\"total\"], 6)\n+        self.assertEqual(page[\"page\"], 2)\n+        self.assertEqual(page[\"page_size\"], 2)\n+        self.assertEqual(page[\"remaining\"], 2)\n+        self.assertEqual(len(page[\"items\"]), 2)\n+        empty = self.client.get(\"/api/todos?page=20&page_size=2\", headers=self.headers).json\n+        self.assertEqual(empty[\"items\"], [])\n+        self.assertEqual(empty[\"remaining\"], 0)\n+        filtered = self.client.get(\n+            \"/api/todos?completed=false&priority=high\", headers=self.headers\n+        ).json\n+        self.assertEqual(filtered[\"total\"], 2)\n+        self.assertTrue(all(item[\"priority\"] == \"high\" for item in filtered[\"items\"]))\n+        self.assertEqual(\n+            self.client.get(\"/api/todos?completed=true\", headers=self.headers).json[\"total\"], 1\n+        )\n+\n+    def test_validation(self):\n+        for fields, field in (\n+            ({\"title\": \" \"}, \"title\"),\n+            ({\"title\": 123}, \"title\"),\n+            ({\"title\": \"x\" * 201}, \"title\"),\n+            ({\"description\": []}, \"description\"),\n+            ({\"priority\": \"urgent\"}, \"priority\"),\n+            ({\"priority\": []}, \"priority\"),\n+            ({\"due_date\": \"2026-02-30\"}, \"due_date\"),\n+            ({\"due_date\": \"20260101\"}, \"due_date\"),\n+            ({\"due_date\": 123}, \"due_date\"),\n+            ({\"completed\": \"false\"}, \"completed\"),\n+            ({\"user_id\": 2}, \"user_id\"),\n+        ):\n+            response = self.client.post(\n+                \"/api/todos\", headers=self.headers, json={\"title\": \"Valid\", **fields}\n+            )\n+            self.assertEqual(response.status_code, 400, fields)\n+            self.assertIn(field, response.json[\"errors\"])\n+        for query in (\"page=0\", \"page=-1\", \"page=abc\", \"page_size=101\", \"page_size=0\",\n+                      \"completed=maybe\", \"priority=urgent\", \"page=9999999999999999999999\"):\n+            self.assertEqual(\n+                self.client.get(f\"/api/todos?{query}\", headers=self.headers).status_code, 400\n+            )\n+        for body in ([], None, \"not an object\"):\n+            self.assertEqual(\n+                self.client.post(\"/api/todos\", headers=self.headers, json=body).status_code, 400\n+            )\n+        self.assertEqual(\n+            self.client.post(\n+                \"/api/todos\", headers=self.headers, data=\"{\", content_type=\"application/json\"\n+            ).status_code, 400\n+        )\n+        invalid_account = self.client.post(\n+            \"/api/auth/register\", json={\"username\": \"x\", \"password\": \"short\"}\n+        )\n+        self.assertEqual(invalid_account.status_code, 400)\n+        self.assertEqual(set(invalid_account.json[\"errors\"]), {\"username\", \"password\"})\n+\n+    def test_persistence_and_secure_storage(self):\n+        todo = self.add(completed=True)\n+        restarted = create_app({\"TESTING\": True, \"DATABASE\": self.path}).test_client()\n+        self.assertEqual(restarted.get(\"/api/todos\", headers=self.headers).json[\"items\"], [todo])\n+        with sqlite3.connect(self.path) as db:\n+            password_hash = db.execute(\"SELECT password_hash FROM users\").fetchone()[0]\n+            token_hash = db.execute(\"SELECT token_hash FROM sessions\").fetchone()[0]\n+        self.assertNotEqual(password_hash, \"password123\")\n+        token = self.headers[\"Authorization\"].split()[1]\n+        self.assertEqual(token_hash, hashlib.sha256(token.encode()).hexdigest())\n+        self.assertNotEqual(token_hash, token)\n+        self.assertEqual(\n+            restarted.post(\"/api/auth/logout\", headers=self.headers).status_code, 204\n+        )\n+        self.assertEqual(restarted.get(\"/api/todos\", headers=self.headers).status_code, 401)\n+\n+    def test_api_errors_and_security_headers(self):\n+        response = self.client.get(\"/api/not-real\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertTrue(response.is_json)\n+        self.assertEqual(response.headers[\"Cache-Control\"], \"no-store\")\n+        self.assertEqual(response.headers[\"X-Content-Type-Options\"], \"nosniff\")\n+        self.assertEqual(self.client.put(\"/api/todos\", headers=self.headers).status_code, 405)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":206,"deletions":0},{"filePath":"/workspace/backend/requirements-dev.txt","relativePath":"backend/requirements-dev.txt","type":"add","patch":"Index: /workspace/backend/requirements-dev.txt\n===================================================================\n--- /workspace/backend/requirements-dev.txt\n+++ /workspace/backend/requirements-dev.txt\n@@ -0,0 +1,2 @@\n+-r requirements.txt\n+ruff>=0.14,<1\n","additions":2,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,6 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+**/__pycache__/\n+**/.venv/\n+.ruff_cache/\n","additions":6,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA backend/test_app.py\nA backend/requirements-dev.txt\nA .gitignore","time":{"start":1794305260767,"end":1794305260812}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.summary","summary":"**Exploring API