{"type":"tool_use","timestamp":1794306798881,"sessionID":"ses_e3b1534f1ffe0d7Px32Bq6e6WC","part":{"type":"tool","tool":"read","callID":"call_QfvnaEwlgP6ULEmA7U2lOsDH","state":{"status":"completed","input":{"filePath":"/workspace/Dockerfile"},"output":"<path>/workspace/Dockerfile</path>\n<type>file</type>\n<content>\n1: FROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\n2: WORKDIR /app\n3: COPY frontend/package.json frontend/package-lock.json* frontend/\n4: RUN cd frontend \\\n5:     && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\n6: COPY frontend/ frontend/\n7: RUN cd frontend && npm run build\n8: \n9: FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\n10: ENV PYTHONDONTWRITEBYTECODE=1 \\\n11:     PYTHONUNBUFFERED=1 \\\n12:     PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n13:     PORT=8000\n14: WORKDIR /app\n15: COPY backend/requirements.txt backend/requirements.lock* backend/\n16: RUN if [ -f backend/requirements.lock ]; then \\\n17:       pip install --no-cache-dir --require-hashes -r backend/requirements.lock; \\\n18:     else \\\n19:       pip install --no-cache-dir -r backend/requirements.txt; \\\n20:     fi\n21: COPY backend/ backend/\n22: COPY --from=frontend /app/frontend/dist frontend/dist\n23: RUN mkdir -p data\n24: EXPOSE 8000\n25: CMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]\n\n(End of file - total 25 lines)\n</content>","metadata":{"preview":"FROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\nWORKDIR /app\nCOPY frontend/package.json frontend/package-lock.json* frontend/\nRUN cd frontend \\\n    && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\nCOPY frontend/ frontend/\nRUN cd frontend && npm run build\n\nFROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\nENV PYTHONDONTWRITEBYTECODE=1 \\\n    PYTHONUNBUFFERED=1 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    PORT=8000\nWORKDIR /app\nCOPY backend/requirements.txt backend/requirements.lock* backend/\nRUN if [ -f backend/requirements.lock ]; then \\\n      pip install --no-cache-dir --require-hashes -r backend/requirements.lock; \\\n    else \\\n      pip install --no-cache-dir -r backend/requirements.txt; \\\n    fi","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/Dockerfile","text":"FROM node:24-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS frontend\nWORKDIR /app\nCOPY frontend/package.json frontend/package-lock.json* frontend/\nRUN cd frontend \\\n    && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi\nCOPY frontend/ frontend/\nRUN cd frontend && npm run build\n\nFROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1\nENV PYTHONDONTWRITEBYTECODE=1 \\\n    PYTHONUNBUFFERED=1 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1 \\\n    PORT=8000\nWORKDIR /app\nCOPY backend/requirements.txt backend/requirements.lock* backend/\nRUN if [ -f backend/requirements.lock ]; then \\\n      pip install --no-cache-dir --require-hashes -r backend/requirements.lock; \\\n    else \\\n      pip install --no-cache-dir -r backend/requirements.txt; \\\n    fi\nCOPY backend/ backend/\nCOPY --from=frontend /app/frontend/dist frontend/dist\nRUN mkdir -p data\nEXPOSE 8000\nCMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8000\", \"--pythonpath\", \"backend\", \"app:app\"]","lineStart":1,"lineEnd":25,"totalLines":25,"truncated":false}},"title":"Dockerfile","time":{"start":1794306798849,"end":1794306798867}},"id":"prt_1c504f4fc001Qt1SH8lMmprIBi","sessionID":"ses_e3b1534f1ffe0d7Px32Bq6e6WC","messageID":"msg_1c504e322001oqzHMqT9alYHNI"}}
{"type":"tool_use","timestamp":1794306798881,"sessionID":"ses_e3b1534f1ffe0d7Px32Bq6e6WC","part":{"type":"tool","tool":"read","callID":"call_OK8tXNaahtNrfXeQvEICbg7s","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: import hashlib\n2: import os\n3: import re\n4: import secrets\n5: import sqlite3\n6: from datetime import UTC, date, datetime, timedelta\n7: from functools import wraps\n8: from pathlib import Path\n9: \n10: from flask import Flask, current_app, g, request, send_from_directory\n11: from werkzeug.exceptions import HTTPException\n12: from werkzeug.security import check_password_hash, generate_password_hash\n13: \n14: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n15: PRIORITIES = (\"low\", \"medium\", \"high\")\n16: TODO_FIELDS = {\"title\", \"description\", \"priority\", \"due_date\", \"completed\"}\n17: \n18: \n19: def now():\n20:     return datetime.now(UTC).isoformat()\n21: \n22: \n23: def database():\n24:     if \"db\" not in g:\n25:         g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=15)\n26:         g.db.row_factory = sqlite3.Row\n27:         g.db.execute(\"PRAGMA foreign_keys = ON\")\n28:     return g.db\n29: \n30: \n31: def error(message, status=400, errors=None):\n32:     result = {\"error\": message}\n33:     if errors:\n34:         result[\"errors\"] = errors\n35:     return result, status\n36: \n37: \n38: def authenticated(view):\n39:     @wraps(view)\n40:     def wrapped(*args, **kwargs):\n41:         parts = request.headers.get(\"Authorization\", \"\").split()\n42:         if len(parts) != 2 or parts[0].lower() != \"bearer\":\n43:             return error(\"Please sign in to continue.\", 401)\n44:         token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n45:         user = database().execute(\n46:             \"SELECT users.id, users.username FROM sessions \"\n47:             \"JOIN users ON users.id = sessions.user_id \"\n48:             \"WHERE token_hash = ? AND expires_at > ?\",\n49:             (token_hash, now()),\n50:         ).fetchone()\n51:         if user is None:\n52:             return error(\"Your session has expired. Please sign in again.\", 401)\n53:         g.user = user\n54:         g.token_hash = token_hash\n55:         return view(*args, **kwargs)\n56: \n57:     return wrapped\n58: \n59: \n60: def json_body():\n61:     body = request.get_json(silent=True)\n62:     return body if isinstance(body, dict) else None\n63: \n64: \n65: def credentials(body):\n66:     errors = {}\n67:     username = body.get(\"username\")\n68:     password = body.get(\"password\")\n69:     if not isinstance(username, str) or not re.fullmatch(\n70:         r\"[A-Za-z0-9_.-]{3,32}\", username.strip()\n71:     ):\n72:         errors[\"username\"] = (\n73:             \"Use 3–32 letters, numbers, dots, hyphens, or underscores.\"\n74:         )\n75:     if not isinstance(password, str) or not 8 <= len(password) <= 128:\n76:         errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n77:     return errors\n78: \n79: \n80: def validate_todo(body, partial=False):\n81:     values = {}\n82:     errors = {}\n83:     for field in body.keys() - TODO_FIELDS:\n84:         errors[field] = \"This field cannot be changed.\"\n85:     if \"title\" in body or not partial:\n86:         title = body.get(\"title\")\n87:         if not isinstance(title, str) or not 1 <= len(title.strip()) <= 200:\n88:             errors[\"title\"] = \"Give your task a title between 1 and 200 characters.\"\n89:         else:\n90:             values[\"title\"] = title.strip()\n91:     if \"description\" in body or not partial:\n92:         description = body.get(\"description\", \"\")\n93:         if description is not None and (\n94:             not isinstance(description, str) or len(description) > 5000\n95:         ):\n96:             errors[\"description\"] = \"Keep the description under 5,000 characters.\"\n97:         else:\n98:             values[\"description\"] = description\n99:     if \"priority\" in body or not partial:\n100:         priority = body.get(\"priority\", \"medium\")\n101:         if not isinstance(priority, str) or priority not in PRIORITIES:\n102:             errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n103:         else:\n104:             values[\"priority\"] = priority\n105:     if \"due_date\" in body or not partial:\n106:         due_date = body.get(\"due_date\")\n107:         if due_date is not None:\n108:             try:\n109:                 if not isinstance(due_date, str) or not re.fullmatch(\n110:                     r\"\\d{4}-\\d{2}-\\d{2}\", due_date\n111:                 ):\n112:                     raise ValueError\n113:                 date.fromisoformat(due_date)\n114:             except ValueError:\n115:                 errors[\"due_date\"] = \"Choose a valid date in YYYY-MM-DD format.\"\n116:         values[\"due_date\"] = due_date\n117:     if \"completed\" in body or not partial:\n118:         completed = body.get(\"completed\", False)\n119:         if not isinstance(completed, bool):\n120:             errors[\"completed\"] = \"Completed must be true or false.\"\n121:         else:\n122:             values[\"completed\"] = completed\n123:     return values, errors\n124: \n125: \n126: def serialize(row):\n127:     todo = dict(row)\n128:     todo.pop(\"user_id\", None)\n129:     todo[\"completed\"] = bool(todo[\"completed\"])\n130:     return todo\n131: \n132: \n133: def owned_todo(todo_id):\n134:     return database().execute(\n135:         \"SELECT * FROM todos WHERE id = ? AND user_id = ?\",\n136:         (todo_id, g.user[\"id\"]),\n137:     ).fetchone()\n138: \n139: \n140: def create_app(config=None):\n141:     app = Flask(__name__, static_folder=None)\n142:     app.config.update(\n143:         DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"todos.sqlite3\"),\n144:         MAX_CONTENT_LENGTH=64 * 1024,\n145:     )\n146:     if config:\n147:         app.config.update(config)\n148:     Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n149:     with app.app_context():\n150:         db = database()\n151:         db.execute(\"PRAGMA journal_mode = WAL\")\n152:         db.executescript(\n153:             \"\"\"\n154:             CREATE TABLE IF NOT EXISTS users (\n155:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n156:                 username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n157:                 password_hash TEXT NOT NULL,\n158:                 created_at TEXT NOT NULL\n159:             );\n160:             CREATE TABLE IF NOT EXISTS sessions (\n161:                 token_hash TEXT PRIMARY KEY,\n162:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n163:                 expires_at TEXT NOT NULL\n164:             );\n165:             CREATE TABLE IF NOT EXISTS todos (\n166:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n167:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n168:                 title TEXT NOT NULL,\n169:                 description TEXT,\n170:                 priority TEXT NOT NULL CHECK (priority IN ('low', 'medium', 'high')),\n171:                 due_date TEXT,\n172:                 completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1)),\n173:                 completed_at TEXT,\n174:                 created_at TEXT NOT NULL\n175:             );\n176:             CREATE INDEX IF NOT EXISTS todos_user_order\n177:                 ON todos(user_id, completed, due_date, created_at DESC);\n178:             CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n179:             \"\"\"\n180:         )\n181:         db.close()\n182:         g.pop(\"db\", None)\n183: \n184:     @app.teardown_appcontext\n185:     def close_database(_exception):\n186:         db = g.pop(\"db\", None)\n187:         if db is not None:\n188:             db.close()\n189: \n190:     @app.errorhandler(HTTPException)\n191:     def handle_http_error(exception):\n192:         if request.path.startswith(\"/api/\"):\n193:             return error(exception.description, exception.code)\n194:         return exception\n195: \n196:     @app.after_request\n197:     def security_headers(response):\n198:         response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n199:         response.headers[\"Referrer-Policy\"] = \"same-origin\"\n200:         response.headers[\"X-Frame-Options\"] = \"DENY\"\n201:         if request.path.startswith(\"/api/\"):\n202:             response.headers[\"Cache-Control\"] = \"no-store\"\n203:         else:\n204:             response.headers[\"Content-Security-Policy\"] = (\n205:                 \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n206:                 \"img-src 'self' data:; connect-src 'self'; font-src 'self'; \"\n207:                 \"object-src 'none'; base-uri 'self'; frame-ancestors 'none'\"\n208:             )\n209:         return response\n210: \n211:     @app.get(\"/api/health\")\n212:     def health():\n213:         return {\"status\": \"ok\"}\n214: \n215:     @app.post(\"/api/auth/register\")\n216:     def register():\n217:         body = json_body()\n218:         if body is None:\n219:             return error(\"Send a JSON object with your username and password.\")\n220:         errors = credentials(body)\n221:         if errors:\n222:             return error(\"Please check your account details.\", errors=errors)\n223:         db = database()\n224:         try:\n225:             with db:\n226:                 cursor = db.execute(\n227:                     \"INSERT INTO users (username, password_hash, created_at) \"\n228:                     \"VALUES (?, ?, ?)\",\n229:                     (\n230:                         body[\"username\"].strip(),\n231:                         generate_password_hash(body[\"password\"]),\n232:                         now(),\n233:                     ),\n234:                 )\n235:         except sqlite3.IntegrityError:\n236:             return error(\n237:                 \"That username is already taken.\",\n238:                 409,\n239:                 {\"username\": \"That username is already taken. Try another.\"},\n240:             )\n241:         return {\"id\": cursor.lastrowid, \"username\": body[\"username\"].strip()}, 201\n242: \n243:     @app.post(\"/api/auth/login\")\n244:     def login():\n245:         body = json_body()\n246:         if body is None:\n247:             return error(\"Send a JSON object with your username and password.\")\n248:         errors = credentials(body)\n249:         if errors:\n250:             return error(\"Please check your account details.\", errors=errors)\n251:         db = database()\n252:         user = db.execute(\n253:             \"SELECT * FROM users WHERE username = ?\", (body[\"username\"].strip(),)\n254:         ).fetchone()\n255:         password_hash = user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"]\n256:         valid = check_password_hash(password_hash, body[\"password\"])\n257:         if user is None or not valid:\n258:             return error(\"The username or password is incorrect.\", 401)\n259:         token = secrets.token_urlsafe(32)\n260:         with db:\n261:             db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (now(),))\n262:             db.execute(\n263:                 \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n264:                 (\n265:                     hashlib.sha256(token.encode()).hexdigest(),\n266:                     user[\"id\"],\n267:                     (datetime.now(UTC) + timedelta(days=30)).isoformat(),\n268:                 ),\n269:             )\n270:         return {\"token\": token}\n271: \n272:     @app.get(\"/api/auth/me\")\n273:     @authenticated\n274:     def me():\n275:         return dict(g.user)\n276: \n277:     @app.post(\"/api/auth/logout\")\n278:     @authenticated\n279:     def logout():\n280:         db = database()\n281:         with db:\n282:             db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n283:         return \"\", 204\n284: \n285:     @app.get(\"/api/todos\")\n286:     @authenticated\n287:     def list_todos():\n288:         conditions = [\"user_id = ?\"]\n289:         params = [g.user[\"id\"]]\n290:         errors = {}\n291:         completed = request.args.get(\"completed\")\n292:         if completed is not None:\n293:             if completed not in (\"true\", \"false\", \"1\", \"0\"):\n294:                 errors[\"completed\"] = \"Completed must be true or false.\"\n295:             else:\n296:                 conditions.append(\"completed = ?\")\n297:                 params.append(int(completed in (\"true\", \"1\")))\n298:         priority = request.args.get(\"priority\")\n299:         if priority is not None:\n300:             if priority not in PRIORITIES:\n301:                 errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n302:             else:\n303:                 conditions.append(\"priority = ?\")\n304:                 params.append(priority)\n305:         pagination = {}\n306:         for field, default, maximum in (\n307:             (\"page\", 1, 2147483647),\n308:             (\"page_size\", 20, 100),\n309:         ):\n310:             raw = request.args.get(field, str(default))\n311:             try:\n312:                 if not re.fullmatch(r\"[0-9]{1,10}\", raw):\n313:                     raise ValueError\n314:                 value = int(raw)\n315:                 if not 1 <= value <= maximum:\n316:                     raise ValueError\n317:                 pagination[field] = value\n318:             except ValueError:\n319:                 errors[field] = f\"Choose a whole number between 1 and {maximum}.\"\n320:         if errors:\n321:             return error(\"Please check your filters.\", errors=errors)\n322:         where = \" AND \".join(conditions)\n323:         db = database()\n324:         page, page_size = pagination[\"page\"], pagination[\"page_size\"]\n325:         offset = (page - 1) * page_size\n326:         total = db.execute(\n327:             f\"SELECT COUNT(*) FROM todos WHERE {where}\", params\n328:         ).fetchone()[0]\n329:         rows = db.execute(\n330:             f\"SELECT * FROM todos WHERE {where} \"\n331:             \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n332:             \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n333:             [*params, page_size, offset],\n334:         ).fetchall()\n335:         return {\n336:             \"items\": [serialize(row) for row in rows],\n337:             \"total\": total,\n338:             \"page\": page,\n339:             \"page_size\": page_size,\n340:             \"remaining\": max(0, total - offset - len(rows)),\n341:         }\n342: \n343:     @app.post(\"/api/todos\")\n344:     @authenticated\n345:     def add_todo():\n346:         body = json_body()\n347:         if body is None:\n348:             return error(\"Send a JSON object with your task details.\")\n349:         values, errors = validate_todo(body)\n350:         if errors:\n351:             return error(\"Please check your task details.\", errors=errors)\n352:         timestamp = now()\n353:         db = database()\n354:         with db:\n355:             cursor = db.execute(\n356:                 \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n357:                 \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n358:                 (\n359:                     g.user[\"id\"],\n360:                     values[\"title\"],\n361:                     values[\"description\"],\n362:                     values[\"priority\"],\n363:                     values[\"due_date\"],\n364:                     values[\"completed\"],\n365:                     timestamp if values[\"completed\"] else None,\n366:                     timestamp,\n367:                 ),\n368:             )\n369:         return serialize(owned_todo(cursor.lastrowid)), 201\n370: \n371:     @app.get(\"/api/todos/<int:todo_id>\")\n372:     @authenticated\n373:     def get_todo(todo_id):\n374:         row = owned_todo(todo_id)\n375:         if row is None:\n376:             return error(\"Task not found.\", 404)\n377:         return serialize(row)\n378: \n379:     @app.patch(\"/api/todos/<int:todo_id>\")\n380:     @authenticated\n381:     def update_todo(todo_id):\n382:         db = database()\n383:         with db:\n384:             db.execute(\"BEGIN IMMEDIATE\")\n385:             row = owned_todo(todo_id)\n386:             if row is None:\n387:                 return error(\"Task not found.\", 404)\n388:             body = json_body()\n389:             if body is None:\n390:                 return error(\"Send a JSON object with your task details.\")\n391:             values, errors = validate_todo(body, partial=True)\n392:             if errors:\n393:                 return error(\"Please check your task details.\", errors=errors)\n394:             if \"completed\" in values and values[\"completed\"] != bool(row[\"completed\"]):\n395:                 values[\"completed_at\"] = now() if values[\"completed\"] else None\n396:             if values:\n397:                 assignments = \", \".join(f\"{field} = ?\" for field in values)\n398:                 db.execute(\n399:                     f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n400:                     [*values.values(), todo_id, g.user[\"id\"]],\n401:                 )\n402:             result = serialize(owned_todo(todo_id))\n403:         return result\n404: \n405:     @app.delete(\"/api/todos/<int:todo_id>\")\n406:     @authenticated\n407:     def delete_todo(todo_id):\n408:         db = database()\n409:         with db:\n410:             cursor = db.execute(\n411:                 \"DELETE FROM todos WHERE id = ? AND user_id = ?\",\n412:                 (todo_id, g.user[\"id\"]),\n413:             )\n414:         if cursor.rowcount == 0:\n415:             return error(\"Task not found.\", 404)\n416:         return \"\", 204\n417: \n418:     @app.get(\"/\")\n419:     @app.get(\"/<path:path>\")\n420:     def frontend(path=\"index.html\"):\n421:         if path == \"api\" or path.startswith(\"api/\"):\n422:             return error(\"API endpoint not found.\", 404)\n423:         if (DIST / path).is_file():\n424:             return send_from_directory(DIST, path)\n425:         return send_from_directory(DIST, \"index.html\")\n426: \n427:     app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n428:     return app\n429: \n430: \n431: app = create_app()\n432: \n433: \n434: if __name__ == \"__main__\":\n435:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\n(End of file - total 435 lines)\n</content>","metadata":{"preview":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import UTC, date, datetime, timedelta\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, current_app, g, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nPRIORITIES = (\"low\", \"medium\", \"high\")\nTODO_FIELDS = {\"title\", \"description\", \"priority\", \"due_date\", \"completed\"}\n\n\ndef now():\n    return datetime.now(UTC).isoformat()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"import hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import UTC, date, datetime, timedelta\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, current_app, g, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nPRIORITIES = (\"low\", \"medium\", \"high\")\nTODO_FIELDS = {\"title\", \"description\", \"priority\", \"due_date\", \"completed\"}\n\n\ndef now():\n    return datetime.now(UTC).isoformat()\n\n\ndef database():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=15)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\ndef error(message, status=400, errors=None):\n    result = {\"error\": message}\n    if errors:\n        result[\"errors\"] = errors\n    return result, status\n\n\ndef authenticated(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        parts = request.headers.get(\"Authorization\", \"\").split()\n        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n            return error(\"Please sign in to continue.\", 401)\n        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n        user = database().execute(\n            \"SELECT users.id, users.username FROM sessions \"\n            \"JOIN users ON users.id = sessions.user_id \"\n            \"WHERE token_hash = ? AND expires_at > ?\",\n            (token_hash, now()),\n        ).fetchone()\n        if user is None:\n            return error(\"Your session has expired. Please sign in again.\", 401)\n        g.user = user\n        g.token_hash = token_hash\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef json_body():\n    body = request.get_json(silent=True)\n    return body if isinstance(body, dict) else None\n\n\ndef credentials(body):\n    errors = {}\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not re.fullmatch(\n        r\"[A-Za-z0-9_.-]{3,32}\", username.strip()\n    ):\n        errors[\"username\"] = (\n            \"Use 3–32 letters, numbers, dots, hyphens, or underscores.\"\n        )\n    if not isinstance(password, str) or not 8 <= len(password) <= 128:\n        errors[\"password\"] = \"Use a password between 8 and 128 characters.\"\n    return errors\n\n\ndef validate_todo(body, partial=False):\n    values = {}\n    errors = {}\n    for field in body.keys() - TODO_FIELDS:\n        errors[field] = \"This field cannot be changed.\"\n    if \"title\" in body or not partial:\n        title = body.get(\"title\")\n        if not isinstance(title, str) or not 1 <= len(title.strip()) <= 200:\n            errors[\"title\"] = \"Give your task a title between 1 and 200 characters.\"\n        else:\n            values[\"title\"] = title.strip()\n    if \"description\" in body or not partial:\n        description = body.get(\"description\", \"\")\n        if description is not None and (\n            not isinstance(description, str) or len(description) > 5000\n        ):\n            errors[\"description\"] = \"Keep the description under 5,000 characters.\"\n        else:\n            values[\"description\"] = description\n    if \"priority\" in body or not partial:\n        priority = body.get(\"priority\", \"medium\")\n        if not isinstance(priority, str) or priority not in PRIORITIES:\n            errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n        else:\n            values[\"priority\"] = priority\n    if \"due_date\" in body or not partial:\n        due_date = body.get(\"due_date\")\n        if due_date is not None:\n            try:\n                if not isinstance(due_date, str) or not re.fullmatch(\n                    r\"\\d{4}-\\d{2}-\\d{2}\", due_date\n                ):\n                    raise ValueError\n                date.fromisoformat(due_date)\n            except ValueError:\n                errors[\"due_date\"] = \"Choose a valid date in YYYY-MM-DD format.\"\n        values[\"due_date\"] = due_date\n    if \"completed\" in body or not partial:\n        completed = body.get(\"completed\", False)\n        if not isinstance(completed, bool):\n            errors[\"completed\"] = \"Completed must be true or false.\"\n        else:\n            values[\"completed\"] = completed\n    return values, errors\n\n\ndef serialize(row):\n    todo = dict(row)\n    todo.pop(\"user_id\", None)\n    todo[\"completed\"] = bool(todo[\"completed\"])\n    return todo\n\n\ndef owned_todo(todo_id):\n    return database().execute(\n        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\",\n        (todo_id, g.user[\"id\"]),\n    ).fetchone()\n\n\ndef create_app(config=None):\n    app = Flask(__name__, static_folder=None)\n    app.config.update(\n        DATABASE=str(Path(os.environ.get(\"DATA_DIR\", \"./data\")) / \"todos.sqlite3\"),\n        MAX_CONTENT_LENGTH=64 * 1024,\n    )\n    if config:\n        app.config.update(config)\n    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n    with app.app_context():\n        db = database()\n        db.execute(\"PRAGMA journal_mode = WAL\")\n        db.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                expires_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS todos (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                title TEXT NOT NULL,\n                description TEXT,\n                priority TEXT NOT NULL CHECK (priority IN ('low', 'medium', 'high')),\n                due_date TEXT,\n                completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1)),\n                completed_at TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS todos_user_order\n                ON todos(user_id, completed, due_date, created_at DESC);\n            CREATE INDEX IF NOT EXISTS sessions_user ON sessions(user_id);\n            \"\"\"\n        )\n        db.close()\n        g.pop(\"db\", None)\n\n    @app.teardown_appcontext\n    def close_database(_exception):\n        db = g.pop(\"db\", None)\n        if db is not None:\n            db.close()\n\n    @app.errorhandler(HTTPException)\n    def handle_http_error(exception):\n        if request.path.startswith(\"/api/\"):\n            return error(exception.description, exception.code)\n        return exception\n\n    @app.after_request\n    def security_headers(response):\n        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n        response.headers[\"X-Frame-Options\"] = \"DENY\"\n        if request.path.startswith(\"/api/\"):\n            response.headers[\"Cache-Control\"] = \"no-store\"\n        else:\n            response.headers[\"Content-Security-Policy\"] = (\n                \"default-src 'self'; script-src 'self'; style-src 'self'; \"\n                \"img-src 'self' data:; connect-src 'self'; font-src 'self'; \"\n                \"object-src 'none'; base-uri 'self'; frame-ancestors 'none'\"\n            )\n        return response\n\n    @app.get(\"/api/health\")\n    def health():\n        return {\"status\": \"ok\"}\n\n    @app.post(\"/api/auth/register\")\n    def register():\n        body = json_body()\n        if body is None:\n            return error(\"Send a JSON object with your username and password.\")\n        errors = credentials(body)\n        if errors:\n            return error(\"Please check your account details.\", errors=errors)\n        db = database()\n        try:\n            with db:\n                cursor = db.execute(\n                    \"INSERT INTO users (username, password_hash, created_at) \"\n                    \"VALUES (?, ?, ?)\",\n                    (\n                        body[\"username\"].strip(),\n                        generate_password_hash(body[\"password\"]),\n                        now(),\n                    ),\n                )\n        except sqlite3.IntegrityError:\n            return error(\n                \"That username is already taken.\",\n                409,\n                {\"username\": \"That username is already taken. Try another.\"},\n            )\n        return {\"id\": cursor.lastrowid, \"username\": body[\"username\"].strip()}, 201\n\n    @app.post(\"/api/auth/login\")\n    def login():\n        body = json_body()\n        if body is None:\n            return error(\"Send a JSON object with your username and password.\")\n        errors = credentials(body)\n        if errors:\n            return error(\"Please check your account details.\", errors=errors)\n        db = database()\n        user = db.execute(\n            \"SELECT * FROM users WHERE username = ?\", (body[\"username\"].strip(),)\n        ).fetchone()\n        password_hash = user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"]\n        valid = check_password_hash(password_hash, body[\"password\"])\n        if user is None or not valid:\n            return error(\"The username or password is incorrect.\", 401)\n        token = secrets.token_urlsafe(32)\n        with db:\n            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (now(),))\n            db.execute(\n                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n                (\n                    hashlib.sha256(token.encode()).hexdigest(),\n                    user[\"id\"],\n                    (datetime.now(UTC) + timedelta(days=30)).isoformat(),\n                ),\n            )\n        return {\"token\": token}\n\n    @app.get(\"/api/auth/me\")\n    @authenticated\n    def me():\n        return dict(g.user)\n\n    @app.post(\"/api/auth/logout\")\n    @authenticated\n    def logout():\n        db = database()\n        with db:\n            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n        return \"\", 204\n\n    @app.get(\"/api/todos\")\n    @authenticated\n    def list_todos():\n        conditions = [\"user_id = ?\"]\n        params = [g.user[\"id\"]]\n        errors = {}\n        completed = request.args.get(\"completed\")\n        if completed is not None:\n            if completed not in (\"true\", \"false\", \"1\", \"0\"):\n                errors[\"completed\"] = \"Completed must be true or false.\"\n            else:\n                conditions.append(\"completed = ?\")\n                params.append(int(completed in (\"true\", \"1\")))\n        priority = request.args.get(\"priority\")\n        if priority is not None:\n            if priority not in PRIORITIES:\n                errors[\"priority\"] = \"Choose low, medium, or high priority.\"\n            else:\n                conditions.append(\"priority = ?\")\n                params.append(priority)\n        pagination = {}\n        for field, default, maximum in (\n            (\"page\", 1, 2147483647),\n            (\"page_size\", 20, 100),\n        ):\n            raw = request.args.get(field, str(default))\n            try:\n                if not re.fullmatch(r\"[0-9]{1,10}\", raw):\n                    raise ValueError\n                value = int(raw)\n                if not 1 <= value <= maximum:\n                    raise ValueError\n                pagination[field] = value\n            except ValueError:\n                errors[field] = f\"Choose a whole number between 1 and {maximum}.\"\n        if errors:\n            return error(\"Please check your filters.\", errors=errors)\n        where = \" AND \".join(conditions)\n        db = database()\n        page, page_size = pagination[\"page\"], pagination[\"page_size\"]\n        offset = (page - 1) * page_size\n        total = db.execute(\n            f\"SELECT COUNT(*) FROM todos WHERE {where}\", params\n        ).fetchone()[0]\n        rows = db.execute(\n            f\"SELECT * FROM todos WHERE {where} \"\n            \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n            \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n            [*params, page_size, offset],\n        ).fetchall()\n        return {\n            \"items\": [serialize(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"remaining\": max(0, total - offset - len(rows)),\n        }\n\n    @app.post(\"/api/todos\")\n    @authenticated\n    def add_todo():\n        body = json_body()\n        if body is None:\n            return error(\"Send a JSON object with your task details.\")\n        values, errors = validate_todo(body)\n        if errors:\n            return error(\"Please check your task details.\", errors=errors)\n        timestamp = now()\n        db = database()\n        with db:\n            cursor = db.execute(\n                \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n                \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n                (\n                    g.user[\"id\"],\n                    values[\"title\"],\n                    values[\"description\"],\n                    values[\"priority\"],\n                    values[\"due_date\"],\n                    values[\"completed\"],\n                    timestamp if values[\"completed\"] else None,\n                    timestamp,\n                ),\n            )\n        return serialize(owned_todo(cursor.lastrowid)), 201\n\n    @app.get(\"/api/todos/<int:todo_id>\")\n    @authenticated\n    def get_todo(todo_id):\n        row = owned_todo(todo_id)\n        if row is None:\n            return error(\"Task not found.\", 404)\n        return serialize(row)\n\n    @app.patch(\"/api/todos/<int:todo_id>\")\n    @authenticated\n    def update_todo(todo_id):\n        db = database()\n        with db:\n            db.execute(\"BEGIN IMMEDIATE\")\n            row = owned_todo(todo_id)\n            if row is None:\n                return error(\"Task not found.\", 404)\n            body = json_body()\n            if body is None:\n                return error(\"Send a JSON object with your task details.\")\n            values, errors = validate_todo(body, partial=True)\n            if errors:\n                return error(\"Please check your task details.\", errors=errors)\n            if \"completed\" in values and values[\"completed\"] != bool(row[\"completed\"]):\n                values[\"completed_at\"] = now() if values[\"completed\"] else None\n            if values:\n                assignments = \", \".join(f\"{field} = ?\" for field in values)\n                db.execute(\n                    f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n                    [*values.values(), todo_id, g.user[\"id\"]],\n                )\n            result = serialize(owned_todo(todo_id))\n        return result\n\n    @app.delete(\"/api/todos/<int:todo_id>\")\n    @authenticated\n    def delete_todo(todo_id):\n        db = database()\n        with db:\n            cursor = db.execute(\n                \"DELETE FROM todos WHERE id = ? AND user_id = ?\",\n                (todo_id, g.user[\"id\"]),\n            )\n        if cursor.rowcount == 0:\n            return error(\"Task not found.\", 404)\n        return \"\", 204\n\n    @app.get(\"/\")\n    @app.get(\"/<path:path>\")\n    def frontend(path=\"index.html\"):\n        if path == \"api\" or path.startswith(\"api/\"):\n            return error(\"API endpoint not found.\", 404)\n        if (DIST / path).is_file():\n            return send_from_directory(DIST, path)\n        return send_from_directory(DIST, \"index.html\")\n\n    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_urlsafe(32))\n    return app\n\n\napp = create_app()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))","lineStart":1,"lineEnd":435,"totalLines":435,"truncated":false}},"title":"backend/app.py","time":{"start":1794306798841,"end":1794306798873}},"id":"prt_1c504f4e6001Lk3BXxFcktl1rU","sessionID":"ses_e3b1534f1ffe0d7Px32Bq6e6WC","messageID":"msg_1c504e322001oqzHMqT9alYHNI"}}
