efresh/only-export-components\": [\"warn\", { allowConstantExport: true }],\n+    },\n+  },\n+]);\n*** Add File: /workspace/frontend/src/index.css\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", ui-sans-serif, system-ui, sans-serif;\n+  --color-ink: #26382e;\n+  --color-muted: #788079;\n+  --color-paper: #fbfcfa;\n+  --color-line: #e9ece6;\n+  --color-leaf: #397b56;\n+  --color-mint: #edf4e9;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, input, select, textarea {\n+    @apply font-[inherit];\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  button, a, input, select, textarea {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-leaf/50 focus-visible:ring-offset-2;\n+  }\n+  ::selection {\n+    @apply bg-leaf/20;\n+  }\n+}\n*** Update File: /workspace/frontend/src/main.tsx\n@@\n import App from \"./App\";\n+import \"./index.css\";\n*** Update File: /workspace/frontend/index.html\n@@\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#397b56\" />\n+    <meta name=\"description\" content=\"A little space to organize your day. Keep your tasks private, find your focus, and make progress with Tidy.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Tidy — A little more headspace</title>\n*** Add File: /workspace/frontend/public/favicon.svg\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"12\" fill=\"#397b56\"/><path d=\"M11 12h18M11 20h9m-9 8h9m2-5 3 3 6-7\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/></svg>\n*** Add File: /workspace/frontend/src/api.ts\n+export type Priority = \"low\" | \"medium\" | \"high\";\n+export type Todo = {\n+  id: number;\n+  title: string;\n+  description: string | null;\n+  priority: Priority;\n+  due_date: string | null;\n+  completed: boolean;\n+  completed_at: string | null;\n+  created_at: string;\n+};\n+export type TodoValues = Pick<Todo, \"title\" | \"description\" | \"priority\" | \"due_date\">;\n+export type TodoPage = {\n+  items: Todo[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+  remaining: number;\n+};\n+export type User = { id: number; username: string };\n+export type FieldErrors = Record<string, string>;\n+\n+export class ApiError extends Error {\n+  status: number;\n+  fields: FieldErrors;\n+\n+  constructor(message: string, status: number, fields: FieldErrors = {}) {\n+    super(message);\n+    this.name = \"ApiError\";\n+    this.status = status;\n+    this.fields = fields;\n+  }\n+}\n+\n+export async function api<T>(\n+  path: string,\n+  token: string | null = null,\n+  options: { method?: string; body?: unknown; signal?: AbortSignal } = {},\n+): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      headers: {\n+        ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+      },\n+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n+      signal: options.signal,\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Couldn’t reach the server. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) {\n+    throw new ApiError(data?.error ?? \"Something went wrong. Please try again.\", response.status, data?.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n+\n+export function todayISO() {\n+  const date = new Date();\n+  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, \"0\")}-${String(date.getDate()).padStart(2, \"0\")}`;\n+}\n+\n+export function formatDue(value: string) {\n+  if (value === todayISO()) return \"Today\";\n+  const tomorrow = new Date();\n+  tomorrow.setDate(tomorrow.getDate() + 1);\n+  const date = new Date(`${value}T12:00:00`);\n+  if (date.toDateString() === tomorrow.toDateString()) return \"Tomorrow\";\n+  return date.toLocaleDateString(undefined, {\n+    month: \"short\", day: \"numeric\",\n+    ...(date.getFullYear() !== new Date().getFullYear() ? { year: \"numeric\" } : {}),\n+  });\n+}\n*** Add File: /workspace/frontend/src/components/Icon.tsx\n+const paths = {\n+  list: \"M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01\",\n+  check: \"m5 12 4 4L19 6\",\n+  circleCheck: \"m8 12 3 3 5-6M21 12a9 9 0 1 1-5-8\",\n+  circle: \"M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0\",\n+  plus: \"M12 5v14M5 12h14\",\n+  calendar: \"M8 3v4m8-4v4M4 10h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 9h2m4 0h2m-8 3h2\",\n+  sun: \"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0\",\n+  logout: \"M9 5H4v14h5m5-14 5 7-5 7m-6-7h11\",\n+  pencil: \"m15 5 4 4M4 20l4-1 12-12a2.8 2.8 0 0 0-4-4L4 15v5Z\",\n+  trash: \"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\",\n+  chevron: \"m9 5 7 7-7 7\",\n+  chevronDown: \"m6 9 6 6 6-6\",\n+  arrow: \"M5 12h14m-6-6 6 6-6 6\",\n+  leaf: \"M5 19C0 6 10 3 21 3c0 11-3 21-16 16Zm-2 2L15 9\",\n+  lock: \"M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5V10Zm7 4v3\",\n+  eye: \"M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Zm13 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0\",\n+  eyeOff: \"m3 3 18 18M10 5c8-2 12 7 12 7a19 19 0 0 1-4 5M6 6a20 20 0 0 0-4 6s3 7 10 7a13 13 0 0 0 5-1M10 10a3 3 0 0 0 4 4\",\n+  clock: \"M12 8v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0\",\n+  x: \"m6 6 12 12M6 18 18 6\",\n+  menu: \"M4 6h16M4 12h16M4 18h16\",\n+  sparkles: \"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Zm8-1v4m-2-2h4\",\n+  flag: \"M5 21V3m0 1c5-4 9 4 14 0v10c-5 4-9-4-14 0\",\n+} as const;\n+\n+export type IconName = keyof typeof paths;\n+\n+export default function Icon({ name, className = \"size-5\" }: { name: IconName; className?: string }) {\n+  return (\n+    <svg className={className} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.7\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+      <path d={paths[name]} />\n+    </svg>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/Brand.tsx\n+export default function Brand() {\n+  return (\n+    <div className=\"flex items-center gap-2.5\" aria-label=\"Tidy\">\n+      <span className=\"flex size-9 items-center justify-center rounded-xl bg-leaf text-white\">\n+        <svg viewBox=\"0 0 40 40\" className=\"size-8\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+          <path d=\"M11 12h18M11 20h9m-9 8h9m2-5 3 3 6-7\" />\n+        </svg>\n+      </span>\n+      <span className=\"text-[27px] font-semibold tracking-[-1.5px]\">tidy<span className=\"text-leaf\">.</span></span>\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/Auth.tsx\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, ApiError, errorMessage } from \"../api\";\n+import type { FieldErrors } from \"../api\";\n+import Brand from \"./Brand\";\n+import Icon from \"./Icon\";\n+\n+export default function Auth({ onSignIn }: { onSignIn: (token: string) => void }) {\n+  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [showPassword, setShowPassword] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<FieldErrors>({});\n+  const register = mode === \"register\";\n+\n+  function changeMode(next: \"login\" | \"register\") {\n+    setMode(next);\n+    setError(\"\");\n+    setFields({});\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    let created = false;\n+    try {\n+      const body = { username, password };\n+      if (register) {\n+        await api(\"/auth/register\", null, { method: \"POST\", body });\n+        created = true;\n+      }\n+      const { token } = await api<{ token: string }>(\"/auth/login\", null, { method: \"POST\", body });\n+      onSignIn(token);\n+    } catch (error) {\n+      if (created) setMode(\"login\");\n+      setError(created ? `Your account was created. ${errorMessage(error)}` : errorMessage(error));\n+      if (error instanceof ApiError) setFields(error.fields);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  const inputClass = \"mt-2 w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm transition placeholder:text-[#a1a69e] focus:border-leaf focus:ring-2 focus:ring-leaf/10 disabled:opacity-60\";\n+\n+  return (\n+    <div className=\"relative flex min-h-screen flex-col overflow-hidden\">\n+      <header className=\"mx-auto flex w-full max-w-[1280px] items-center justify-between px-6 py-7 sm:px-12\">\n+        <Brand />\n+        <span className=\"hidden items-center gap-2 text-xs text-muted sm:flex\"><Icon name=\"leaf\" className=\"size-4 text-leaf\" /> A little more headspace.</span>\n+      </header>\n+      <main className=\"mx-auto grid w-full max-w-[1100px] flex-1 items-center gap-12 px-6 py-12 md:grid-cols-[1.15fr_1fr] md:gap-16 md:py-16\">\n+        <section className=\"relative\">\n+          <div className=\"mb-6 inline-flex items-center gap-2 rounded-full border border-[#dce8d6] bg-mint px-3.5 py-1.5 text-[11px] font-semibold tracking-[1.5px] text-leaf\"><Icon name=\"sun\" className=\"size-3.5\" /> YOUR DAY, A LITTLE LIGHTER</div>\n+          <h1 className=\"text-[44px] leading-[1.13] font-semibold tracking-[-2.3px] sm:text-[58px]\">Less on your mind.<br />More in your <span className=\"text-leaf\">day.</span></h1>\n+          <p className=\"mt-6 max-w-[390px] text-[15px] leading-7 text-muted\">A simple home for everything you need to do. Find your focus, take it one task at a time, and enjoy a little more breathing room.</p>\n+          <div className=\"mt-9 space-y-4\">\n+            {[\n+              { icon: \"lock\" as const, title: \"Just for you\", text: \"Your tasks. Your own private space.\" },\n+              { icon: \"flag\" as const, title: \"Focus on what matters\", text: \"Clear priorities, without the clutter.\" },\n+              { icon: \"circleCheck\" as const, title: \"Small steps, real progress\", text: \"Every checkmark is a little win.\" },\n+            ].map((feature) => (\n+              <div key={feature.title} className=\"flex items-center gap-3.5\">\n+                <span className=\"flex size-10 shrink-0 items-center justify-center rounded-xl border border-[#e0e8db] bg-mint text-leaf\"><Icon name={feature.icon} className=\"size-[18px]\" /></span>\n+                <div><h2 className=\"text-[13px] font-semibold\">{feature.title}</h2><p className=\"mt-0.5 text-xs text-muted\">{feature.text}</p></div>\n+              </div>\n+            ))}\n+          </div>\n+          <div className=\"mt-10 flex items-center gap-3 text-xs text-muted\"><span className=\"h-px w-8 bg-[#ccd8c5]\" /> Less busy. More intentional.</div>\n+        </section>\n+        <section className=\"rounded-2xl border border-line bg-white p-6 shadow-[0_12px_60px_-20px_rgba(40,65,40,0.13)] sm:p-9\">\n+          <div className=\"mb-8 flex rounded-lg bg-[#f3f5f0] p-1\" aria-label=\"Account options\">\n+            {([\"login\", \"register\"] as const).map((value) => (\n+              <button key={value} disabled={busy} onClick={() => changeMode(value)} aria-pressed={mode === value} className={`flex-1 rounded-md py-2.5 text-xs font-semibold transition ${mode === value ? \"bg-white text-ink shadow-sm\" : \"text-muted hover:text-ink\"}`}>\n+                {value === \"login\" ? \"Sign in\" : \"Create account\"}\n+              </button>\n+            ))}\n+          </div>\n+          <span className=\"mb-4 flex size-11 items-center justify-center rounded-xl bg-mint text-leaf\"><Icon name={register ? \"sparkles\" : \"leaf\"} className=\"size-5\" /></span>\n+          <h2 className=\"text-2xl font-semibold tracking-[-0.8px]\">{register ? \"A fresh start awaits.\" : \"Welcome back.\"}</h2>\n+          <p className=\"mt-2 text-sm text-muted\">{register ? \"Make a little space for what matters.\" : \"Let’s make a little room for a good day.\"}</p>\n+          <form className=\"mt-7 space-y-5\" onSubmit={submit} noValidate>\n+            <div>\n+              <label htmlFor=\"username\" className=\"text-xs font-semibold\">Username</label>\n+              <input id=\"username\" name=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} placeholder=\"Your username\" className={inputClass} disabled={busy} aria-invalid={!!fields.username} aria-describedby={fields.username ? \"username-error\" : undefined} />\n+              {fields.username && <p id=\"username-error\" className=\"mt-1.5 text-xs text-red-600\">{fields.username}</p>}\n+            </div>\n+            <div>\n+              <label htmlFor=\"password\" className=\"text-xs font-semibold\">Password</label>\n+              <div className=\"relative\">\n+                <input id=\"password\" name=\"password\" type={showPassword ? \"text\" : \"password\"} autoComplete={register ? \"new-password\" : \"current-password\"} value={password} onChange={(event) => setPassword(event.target.value)} placeholder={register ? \"At least 8 characters\" : \"Your password\"} className={`${inputClass} pr-11`} disabled={busy} aria-invalid={!!fields.password} aria-describedby={fields.password ? \"password-error\" : undefined} />\n+                <button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute inset-y-0 right-2 mt-2 flex w-8 items-center justify-center rounded text-muted hover:text-ink\"><Icon name={showPassword ? \"eyeOff\" : \"eye\"} className=\"size-[18px]\" /></button>\n+              </div>\n+              {fields.password && <p id=\"password-error\" className=\"mt-1.5 text-xs text-red-600\">{fields.password}</p>}\n+              {register && !fields.password && <p className=\"mt-2 text-[11px] text-muted\">8–128 characters. Make it uniquely yours.</p>}\n+            </div>\n+            {error && <p role=\"alert\" className=\"rounded-lg border border-red-100 bg-red-50 p-3 text-xs leading-5 text-red-700\">{error}</p>}\n+            <button disabled={busy} className=\"flex w-full items-center justify-center gap-2 rounded-lg bg-leaf py-3.5 text-sm font-medium text-white transition hover:bg-[#2f6848] disabled:opacity-60\">{busy ? \"Just a moment…\" : register ? \"Create your account\" : \"Sign in to your space\"}{!busy && <Icon name=\"arrow\" className=\"size-4\" />}</button>\n+          </form>\n+          <div className=\"mt-7 border-t border-line pt-5 text-center text-xs text-muted\">\n+            {register ? \"Already have a little space here? \" : \"New here? \"}\n+            <button disabled={busy} onClick={() => changeMode(register ? \"login\" : \"register\")} className=\"font-semibold text-leaf hover:underline\">{register ? \"Sign in\" : \"Create an account\"}</button>\n+          </div>\n+          <div className=\"mt-5 flex items-center justify-center gap-1.5 text-[10px] text-muted\"><Icon name=\"lock\" className=\"size-3\" /> Your list is private. Always.</div>\n+        </section>\n+      </main>\n+      <footer className=\"px-6 py-6 text-center text-[11px] text-muted\">Made for a little less chaos, and a little more you.</footer>\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/TodoForm.tsx\n+import { useId, useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { ApiError, errorMessage } from \"../api\";\n+import type { FieldErrors, Priority, Todo, TodoValues } from \"../api\";\n+import Icon from \"./Icon\";\n+\n+export default function TodoForm({ todo, onSave, onCancel }: {\n+  todo?: Todo;\n+  onSave: (values: TodoValues) => Promise<void>;\n+  onCancel: () => void;\n+}) {\n+  const id = useId();\n+  const [title, setTitle] = useState(todo?.title ?? \"\");\n+  const [description, setDescription] = useState(todo?.description ?? \"\");\n+  const [priority, setPriority] = useState<Priority>(todo?.priority ?? \"medium\");\n+  const [dueDate, setDueDate] = useState(todo?.due_date ?? \"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<FieldErrors>({});\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    try {\n+      await onSave({ title, description, priority, due_date: dueDate || null });\n+    } catch (error) {\n+      setError(errorMessage(error));\n+      if (error instanceof ApiError) setFields(error.fields);\n+      setBusy(false);\n+    }\n+  }\n+\n+  const inputClass = \"mt-1.5 w-full rounded-lg border border-[#dde4d8] bg-white px-3 py-2.5 text-sm focus:border-leaf focus:ring-2 focus:ring-leaf/10 placeholder:text-[#a1a69e] disabled:opacity-60\";\n+  function fieldError(field: string) {\n+    return fields[field] ? <p id={`${id}-${field}-error`} className=\"mt-1.5 text-xs text-red-600\">{fields[field]}</p> : null;\n+  }\n+\n+  return (\n+    <form onSubmit={submit} noValidate className=\"rounded-xl border border-[#dce6d6] bg-[#f7faf4] p-5 sm:p-6\">\n+      <div className=\"mb-5 flex items-center justify-between\"><h3 className=\"flex items-center gap-2 text-sm font-semibold\"><Icon name={todo ? \"pencil\" : \"plus\"} className=\"size-4 text-leaf\" />{todo ? \"Edit task\" : \"A new little to-do\"}</h3><button type=\"button\" onClick={onCancel} disabled={busy} aria-label=\"Close task form\" className=\"rounded-md p-1 text-muted hover:bg-mint\"><Icon name=\"x\" className=\"size-4\" /></button></div>\n+      <fieldset disabled={busy} className=\"space-y-4\">\n+        <div>\n+          <label htmlFor={`${id}-title`} className=\"text-xs font-medium\">Task title <span className=\"text-leaf\">*</span></label>\n+          <input autoFocus id={`${id}-title`} name=\"title\" value={title} onChange={(event) => setTitle(event.target.value)} placeholder=\"What would you like to get done?\" className={inputClass} aria-invalid={!!fields.title} aria-describedby={fields.title ? `${id}-title-error` : undefined} />\n+          {fieldError(\"title\")}\n+        </div>\n+        <div>\n+          <label htmlFor={`${id}-description`} className=\"text-xs font-medium\">Description <span className=\"font-normal text-muted\">(optional)</span></label>\n+          <textarea id={`${id}-description`} name=\"description\" rows={2} value={description} onChange={(event) => setDescription(event.target.value)} placeholder=\"A few details, a helpful reminder…\" className={`${inputClass} resize-y`} aria-invalid={!!fields.description} aria-describedby={fields.description ? `${id}-description-error` : undefined} />\n+          {fieldError(\"description\")}\n+        </div>\n+        <div className=\"grid gap-4 sm:grid-cols-2\">\n+          <div><label htmlFor={`${id}-priority`} className=\"text-xs font-medium\">Priority</label><select id={`${id}-priority`} value={priority} onChange={(event) => setPriority(event.target.value as Priority)} className={inputClass} aria-invalid={!!fields.priority} aria-describedby={fields.priority ? `${id}-priority-error` : undefined}><option value=\"low\">Low priority</option><option value=\"medium\">Medium priority</option><option value=\"high\">High priority</option></select>{fieldError(\"priority\")}</div>\n+          <div><label htmlFor={`${id}-due_date`} className=\"text-xs font-medium\">Due date <span className=\"font-normal text-muted\">(optional)</span></label><input id={`${id}-due_date`} type=\"date\" value={dueDate} onChange={(event) => setDueDate(event.target.value)} className={inputClass} aria-invalid={!!fields.due_date} aria-describedby={fields.due_date ? `${id}-due_date-error` : undefined} />{fieldError(\"due_date\")}</div>\n+        </div>\n+      </fieldset>\n+      {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-xs text-red-700\">{error}</p>}\n+      <div className=\"mt-5 flex items-center justify-end gap-3\"><button type=\"button\" onClick={onCancel} disabled={busy} className=\"rounded-lg px-4 py-2.5 text-xs font-medium text-muted transition hover:bg-mint\">Cancel</button><button disabled={busy} className=\"flex items-center gap-2 rounded-lg bg-leaf px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-[#2f6848] disabled:opacity-60\"><Icon name={todo ? \"check\" : \"plus\"} className=\"size-4\" />{busy ? \"Saving…\" : todo ? \"Save changes\" : \"Add task\"}</button></div>\n+    </form>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/DeleteDialog.tsx\n+import { useEffect, useRef, useState } from \"react\";\n+import { errorMessage } from \"../api\";\n+import type { Todo } from \"../api\";\n+import Icon from \"./Icon\";\n+\n+export default function DeleteDialog({ todo, onDelete, onCancel }: {\n+  todo: Todo;\n+  onDelete: () => Promise<void>;\n+  onCancel: () => void;\n+}) {\n+  const dialog = useRef<HTMLDialogElement>(null);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  useEffect(() => {\n+    const element = dialog.current;\n+    element?.showModal();\n+    return () => element?.close();\n+  }, []);\n+\n+  async function remove() {\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      await onDelete();\n+    } catch (error) {\n+      setError(errorMessage(error));\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <dialog ref={dialog} onCancel={(event) => { event.preventDefault(); if (!busy) onCancel(); }} aria-labelledby=\"delete-title\" aria-describedby=\"delete-description\" className=\"fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-line bg-white p-7 text-ink shadow-xl backdrop:bg-ink/30 backdrop:backdrop-blur-[3px]\">\n+      <span className=\"mb-5 flex size-11 items-center justify-center rounded-xl bg-red-50 text-red-500\"><Icon name=\"trash\" className=\"size-5\" /></span>\n+      <h2 id=\"delete-title\" className=\"text-xl font-semibold tracking-tight\">Delete this task?</h2>\n+      <p id=\"delete-description\" className=\"mt-3 text-sm leading-6 text-muted\">“<span className=\"break-words font-medium text-ink\">{todo.title}</span>” will be permanently deleted. This can’t be undone.</p>\n+      {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-xs text-red-700\">{error}</p>}\n+      <div className=\"mt-7 flex justify-end gap-3\"><button autoFocus disabled={busy} onClick={onCancel} className=\"rounded-lg border border-line px-4 py-2.5 text-xs font-medium hover:bg-paper\">Keep task</button><button disabled={busy} onClick={remove} className=\"rounded-lg bg-red-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-red-700 disabled:opacity-60\">{busy ? \"Deleting…\" : \"Delete task\"}</button></div>\n+    </dialog>\n+  );\n+}\n*** Delete File: /workspace/frontend/src/App.tsx\n*** Add File: /workspace/frontend/src/App.tsx\n+import { useCallback, useEffect, useState } from \"react\";\n+import { api, ApiError, errorMessage, formatDue, todayISO } from \"./api\";\n+import type { Priority, Todo, TodoPage, TodoValues, User } from \"./api\";\n+import Auth from \"./components/Auth\";\n+import Brand from \"./components/Brand\";\n+import DeleteDialog from \"./components/DeleteDialog\";\n+import Icon from \"./components/Icon\";\n+import type { IconName } from \"./components/Icon\";\n+import TodoForm from \"./components/TodoForm\";\n+\n+type Tab = \"all\" | \"open\" | \"completed\";\n+const tabs: { value: Tab; label: string; icon: IconName }[] = [\n+  { value: \"all\", label: \"All tasks\", icon: \"list\" },\n+  { value: \"open\", label: \"Open\", icon: \"circle\" },\n+  { value: \"completed\", label: \"Completed\", icon: \"circleCheck\" },\n+];\n+\n+function storedToken() {\n+  try { return localStorage.getItem(\"tidy-token\"); } catch { return null; }\n+}\n+\n+export default function App() {\n+  const [token, setToken] = useState<string | null>(storedToken);\n+  const [identity, setIdentity] = useState<{ token: string; user: User } | null>(null);\n+  const [sessionError, setSessionError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+\n+  const signIn = useCallback((next: string) => {\n+    try { localStorage.setItem(\"tidy-token\", next); } catch { /* empty */ }\n+    setToken(next);\n+    setSessionError(\"\");\n+  }, []);\n+\n+  const clearSession = useCallback(() => {\n+    try { localStorage.removeItem(\"tidy-token\"); } catch { /* empty */ }\n+    setToken(null);\n+    setIdentity(null);\n+    setSessionError(\"\");\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<User>(\"/auth/me\", token, { signal: controller.signal })\n+      .then((user) => { setIdentity({ token, user }); setSessionError(\"\"); })\n+      .catch((error) => {\n+        if (controller.signal.aborted) return;\n+        if (error instanceof ApiError && error.status === 401) clearSession();\n+        else setSessionError(errorMessage(error));\n+      });\n+    return () => controller.abort();\n+  }, [token, retry, clearSession]);\n+\n+  if (!token) return <Auth onSignIn={signIn} />;\n+  if (!identity || identity.token !== token) {\n+    return <div className=\"flex min-h-screen flex-col items-center justify-center gap-5 px-6\"><Brand />{sessionError ? <><p role=\"alert\" className=\"max-w-sm text-center text-sm text-muted\">{sessionError}</p><div className=\"flex gap-3\"><button onClick={() => { setSessionError(\"\"); setRetry(retry + 1); }} className=\"rounded-lg bg-leaf px-4 py-2 text-sm text-white\">Try again</button><button onClick={clearSession} className=\"rounded-lg border border-line px-4 py-2 text-sm\">Back to sign in</button></div></> : <p role=\"status\" className=\"text-sm text-muted\">Opening your little space…</p>}</div>;\n+  }\n+  return <Workspace key={token} token={token} user={identity.user} onExpired={clearSession} />;\n+}\n+\n+function Workspace({ token, user, onExpired }: { token: string; user: User; onExpired: () => void }) {\n+  const [tab, setTab] = useState<Tab>(\"all\");\n+  const [priority, setPriority] = useState<Priority | \"\">(\"\");\n+  const [pages, setPages] = useState(1);\n+  const [revision, setRevision] = useState(0);\n+  const [todos, setTodos] = useState<Todo[]>([]);\n+  const [stats, setStats] = useState({ total: 0, open: 0 });\n+  const [matching, setMatching] = useState(0);\n+  const [remaining, setRemaining] = useState(0);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [adding, setAdding] = useState(false);\n+  const [editing, setEditing] = useState<number | null>(null);\n+  const [deleting, setDeleting] = useState<Todo | null>(null);\n+  const [pending, setPending] = useState<number | null>(null);\n+  const [mobileMenu, setMobileMenu] = useState(false);\n+  const [signingOut, setSigningOut] = useState(false);\n+  const [notice, setNotice] = useState(\"\");\n+  const [today, setToday] = useState(todayISO);\n+\n+  useEffect(() => {\n+    const interval = window.setInterval(() => setToday(todayISO()), 60000);\n+    return () => window.clearInterval(interval);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timer = window.setTimeout(() => setNotice(\"\"), 4000);\n+    return () => window.clearTimeout(timer);\n+  }, [notice]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    const query = new URLSearchParams({ page_size: \"10\" });\n+    if (tab !== \"all\") query.set(\"completed\", String(tab === \"completed\"));\n+    if (priority) query.set(\"priority\", priority);\n+    async function load() {\n+      setLoading(true);\n+      setError(\"\");\n+      try {\n+        const [results, all, open] = await Promise.all([\n+          Promise.all(Array.from({ length: pages }, (_, index) => api<TodoPage>(`/todos?${query}&page=${index + 1}`, token, { signal: controller.signal }))),\n+          api<TodoPage>(\"/todos?page_size=1\", token, { signal: controller.signal }),\n+          api<TodoPage>(\"/todos?completed=false&page_size=1\", token, { signal: controller.signal }),\n+        ]);\n+        if (controller.signal.aborted) return;\n+        const unique = new Map(results.flatMap((result) => result.items).map((todo) => [todo.id, todo]));\n+        setTodos([...unique.values()]);\n+        setMatching(results[0].total);\n+        setRemaining(results[results.length - 1].remaining);\n+        setStats({ total: all.total, open: open.total });\n+      } catch (error) {\n+        if (controller.signal.aborted) return;\n+        if (error instanceof ApiError && error.status === 401) onExpired();\n+        else setError(errorMessage(error));\n+      } finally {\n+        if (!controller.signal.aborted) setLoading(false);\n+      }\n+    }\n+    void load();\n+    return () => controller.abort();\n+  }, [token, tab, priority, pages, revision, onExpired]);\n+\n+  function selectTab(next: Tab) {\n+    setTab(next);\n+    setPages(1);\n+    setTodos([]);\n+    setLoading(true);\n+    setEditing(null);\n+    setMobileMenu(false);\n+  }\n+\n+  function beginAdd() {\n+    setAdding(true);\n+    setEditing(null);\n+    setMobileMenu(false);\n+    window.setTimeout(() => document.getElementById(\"add-task\")?.scrollIntoView({ behavior: \"smooth\", block: \"center\" }), 50);\n+  }\n+\n+  async function mutate<T>(path: string, method: string, body?: unknown) {\n+    try {\n+      return await api<T>(path, token, { method, body });\n+    } catch (error) {\n+      if (error instanceof ApiError && error.status === 401) onExpired();\n+      throw error;\n+    }\n+  }\n+\n+  async function save(values: TodoValues, todo?: Todo) {\n+    await mutate(todo ? `/todos/${todo.id}` : \"/todos\", todo ? \"PATCH\" : \"POST\", values);\n+    setAdding(false);\n+    setEditing(null);\n+    setRevision((value) => value + 1);\n+    setNotice(todo ? \"A little update, all saved.\" : \"Your new task is on the list.\");\n+  }\n+\n+  async function toggle(todo: Todo) {\n+    setPending(todo.id);\n+    setError(\"\");\n+    try {\n+      await mutate(`/todos/${todo.id}`, \"PATCH\", { completed: !todo.completed });\n+      setRevision((value) => value + 1);\n+      setNotice(todo.completed ? \"Task reopened. Take it at your own pace.\" : \"One less thing. Nicely done!\");\n+    } catch (error) {\n+      setError(errorMessage(error));\n+    } finally {\n+      setPending(null);\n+    }\n+  }\n+\n+  async function remove() {\n+    if (!deleting) return;\n+    await mutate(`/todos/${deleting.id}`, \"DELETE\");\n+    setDeleting(null);\n+    setRevision((value) => value + 1);\n+    setNotice(\"Task deleted. A little less clutter.\");\n+  }\n+\n+  async function signOut() {\n+    setSigningOut(true);\n+    try { await api(\"/auth/logout\", token, { method: \"POST\" }); }\n+    finally { onExpired(); }\n+  }\n+\n+  const counts = { all: stats.total, open: stats.open, completed: stats.total - stats.open };\n+  const progress = stats.total ? Math.round((counts.completed / stats.total) * 100) : 0;\n+  const date = new Date(`${today}T12:00:00`).toLocaleDateString(undefined, { weekday: \"long\", month: \"short\", day: \"numeric\" });\n+\n+  return (\n+    <div className=\"min-h-screen lg:grid lg:grid-cols-[232px_minmax(0,1fr)]\">\n+      {mobileMenu && <button onClick={() => setMobileMenu(false)} aria-label=\"Close navigation\" className=\"fixed inset-0 z-20 bg-ink/25 backdrop-blur-[2px] lg:hidden\" />}\n+      <aside className={`${mobileMenu ? \"flex\" : \"hidden\"} fixed inset-y-0 left-0 z-30 w-[232px] flex-col border-r border-line bg-[#f5f7f2] lg:sticky lg:top-0 lg:flex lg:h-screen`}>\n+        <div className=\"px-7 pt-9 pb-10\"><Brand /></div>\n+        <div className=\"px-4\">\n+          <p className=\"mb-3 px-3 text-[10px] font-semibold tracking-[1.8px] text-[#949d91]\">YOUR WORKSPACE</p>\n+          <button onClick={() => { selectTab(\"all\"); setPriority(\"\"); }} className=\"flex w-full items-center gap-3 rounded-lg bg-[#e5eddc] px-3 py-3 text-[13px] font-semibold text-[#386044]\"><Icon name=\"list\" className=\"size-[18px]\" />My tasks<Icon name=\"chevron\" className=\"ml-auto size-3.5 text-[#6e8a61]\" /></button>\n+          <p className=\"mt-8 mb-3 px-3 text-[10px] font-semibold tracking-[1.8px] text-[#949d91]\">A LITTLE OVERVIEW</p>\n+          <nav aria-label=\"Task views\" className=\"space-y-1\">\n+            {tabs.map((item) => <button key={item.value} onClick={() => selectTab(item.value)} aria-current={tab === item.value ? \"page\" : undefined} className={`flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-xs transition hover:bg-[#e9eee3] ${tab === item.value ? \"font-medium text-ink\" : \"text-muted\"}`}><Icon name={item.icon} className=\"size-[17px]\" />{item.label}<span className=\"ml-auto rounded-md bg-white/70 px-1.5 py-0.5 text-[10px] text-muted\">{counts[item.value]}</span></button>)}\n+          </nav>\n+        </div>\n+        <div className=\"mx-5 mt-auto mb-6 rounded-xl border border-[#e0e7d8] bg-[#edf2e6] px-4 py-5\">\n+          <Icon name=\"leaf\" className=\"mb-3 size-5 text-[#73915d]\" /><p className=\"text-xs font-semibold\">Progress, not perfection.</p><p className=\"mt-2 text-[11px] leading-5 text-[#858e7b]\">Small steps still move you forward. You’ve got this.</p>\n+        </div>\n+        <div className=\"mx-5 mb-6 flex items-center gap-2.5 border-t border-[#e1e6dc] pt-5\"><span className=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#dfe8d3] text-xs font-semibold text-[#62724e]\">{user.username.slice(0, 1).toUpperCase()}</span><div className=\"min-w-0\"><p className=\"truncate text-xs font-semibold\">{user.username}</p><p className=\"mt-0.5 text-[10px] text-muted\">Your personal space</p></div><span title=\"Private workspace\" className=\"ml-auto text-[#96a28e]\"><Icon name=\"lock\" className=\"size-3.5\" /></span></div>\n+      </aside>\n+      <div className=\"min-w-0\">\n+        <header className=\"flex h-[78px] items-center justify-between gap-3 border-b border-line bg-white/60 px-5 sm:px-9 lg:px-11\">\n+          <div className=\"flex items-center gap-3 text-xs\"><button onClick={() => setMobileMenu(true)} aria-label=\"Open navigation\" className=\"rounded-md p-1.5 text-muted lg:hidden\"><Icon name=\"menu\" /></button><span className=\"hidden text-muted sm:inline\">My workspace</span><Icon name=\"chevron\" className=\"hidden size-3 text-[#a8ada4] sm:block\" /><span className=\"font-medium\">My tasks</span></div>\n+          <div className=\"flex items-center gap-3 sm:gap-5\"><span className=\"hidden items-center gap-2 text-[11px] text-muted md:flex\"><Icon name=\"calendar\" className=\"size-3.5\" />{date}</span><span className=\"hidden h-5 w-px bg-line md:block\" /><span className=\"max-w-24 truncate text-xs text-muted sm:max-w-36\">{user.username}</span><button disabled={signingOut} onClick={() => void signOut().catch(() => undefined)} className=\"flex items-center gap-1.5 rounded-md px-1 py-2 text-[11px] text-muted transition hover:text-ink disabled:opacity-50\"><Icon name=\"logout\" className=\"size-3.5\" />{signingOut ? \"Signing out…\" : \"Sign out\"}</button></div>\n+        </header>\n+        <main className=\"mx-auto max-w-[1190px] px-5 py-8 sm:px-9 sm:py-10 lg:px-11\">\n+          <div className=\"mb-7 flex flex-wrap items-center justify-between gap-5\">\n+            <div><p className=\"mb-2 flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"sun\" className=\"size-3.5 text-[#b39e56]\" />A fresh little perspective</p><h1 className=\"text-[32px] leading-tight font-semibold tracking-[-1.3px]\">My tasks<span className=\"text-leaf\">.</span></h1><p className=\"mt-2 text-[13px] text-muted\">A clear list. A calmer mind. Let’s take it one thing at a time.</p></div>\n+            <button onClick={beginAdd} className=\"flex items-center gap-2 rounded-lg bg-leaf px-4 py-3 text-xs font-semibold text-white shadow-[0_3px_6px_rgba(57,123,86,0.12)] transition hover:bg-[#2f6848]\"><Icon name=\"plus\" className=\"size-4\" />New task</button>\n+          </div>\n+          <section aria-label=\"Your task overview\" className=\"grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4\">\n+            {[\n+              { label: \"Still to do\", count: stats.open, icon: \"circle\" as const, hint: \"A little focus goes a long way\", color: \"bg-[#f4efe0] text-[#a78b46]\", view: \"open\" as Tab },\n+              { label: \"Checked off\", count: counts.completed, icon: \"circleCheck\" as const, hint: \"Every little win counts\", color: \"bg-[#e8f1e5] text-[#6b9259]\", view: \"completed\" as Tab },\n+              { label: \"All your tasks\", count: stats.total, icon: \"list\" as const, hint: \"Everything, in one little place\", color: \"bg-[#efedf6] text-[#9380b0]\", view: \"all\" as Tab },\n+            ].map((stat) => <button key={stat.label} onClick={() => selectTab(stat.view)} className=\"rounded-xl border border-line bg-white p-5 text-left transition hover:border-[#cbd8c3]\"><span className=\"flex items-center justify-between\"><span className=\"text-[11px] font-medium text-muted\">{stat.label}</span><span className={`flex size-8 items-center justify-center rounded-lg ${stat.color}`}><Icon name={stat.icon} className=\"size-[17px]\" /></span></span><span className=\"mt-0.5 block text-[30px] font-semibold tracking-tight\">{stat.count}</span><span className=\"mt-1 block text-[10px] text-muted\">{stat.hint}</span></button>)}\n+          </section>\n+          <section className=\"relative mt-6 flex items-center justify-between overflow-hidden rounded-xl border border-[#dfe9d6] bg-[#edf4e7] px-6 py-6 sm:px-7\">\n+            <div className=\"relative z-10\"><div className=\"mb-2 flex items-center gap-1.5 text-[10px] font-semibold tracking-[1.1px] text-[#7a8d63]\"><Icon name=\"sparkles\" className=\"size-3.5\" /> A GENTLE REMINDER</div><h2 className=\"text-[19px] font-semibold tracking-[-0.5px]\">You don’t have to do it all today.</h2><p className=\"mt-1.5 max-w-[380px] text-xs leading-5 text-[#7f8b74]\">Start with one small thing. The rest will follow.</p></div>\n+            <div aria-hidden=\"true\" className=\"relative mr-5 hidden h-24 w-32 shrink-0 sm:block\"><div className=\"absolute right-0 bottom-0 size-24 rounded-full bg-[#dee9cd]\" /><div className=\"absolute top-0 left-3 flex h-[91px] w-[70px] -rotate-12 flex-col gap-3 rounded-lg border border-[#c6d6b5] bg-[#f9fcf5] p-3.5 shadow-[3px_5px_0_#d5e2c7]\"><div className=\"flex items-center gap-1.5\"><span className=\"flex size-3 items-center justify-center rounded-sm bg-[#87a56b]\"><Icon name=\"check\" className=\"size-2.5 text-white\" /></span><span className=\"h-1 w-6 rounded bg-[#c5d4b6]\" /></div><div className=\"flex items-center gap-1.5\"><span className=\"size-3 rounded-sm border border-[#c2d0b5]\" /><span className=\"h-1 w-6 rounded bg-[#dbe4d0]\" /></div><div className=\"flex items-center gap-1.5\"><span className=\"size-3 rounded-sm border border-[#c2d0b5]\" /><span className=\"h-1 w-4 rounded bg-[#dbe4d0]\" /></div></div><Icon name=\"leaf\" className=\"absolute right-0 bottom-1 size-11 -rotate-12 text-[#7f9c62]\" /><Icon name=\"sparkles\" className=\"absolute -top-2 right-0 size-5 text-[#9ab082]\" /></div>\n+          </section>\n+          {adding && <div id=\"add-task\" className=\"mt-6\"><TodoForm onSave={(values) => save(values)} onCancel={() => setAdding(false)} /></div>}\n+          <section aria-label=\"Task list\" className=\"mt-8 overflow-hidden rounded-xl border border-line bg-white\">\n+            <div className=\"flex flex-wrap items-center justify-between gap-4 border-b border-line px-5 pt-4 sm:px-6\">\n+              <div className=\"flex gap-5 sm:gap-6\" role=\"tablist\" aria-label=\"Filter by completion\">\n+                {tabs.map((item) => <button key={item.value} role=\"tab\" aria-selected={tab === item.value} aria-controls=\"todo-panel\" id={`tab-${item.value}`} onClick={() => selectTab(item.value)} className={`relative flex items-center gap-1.5 border-b-2 pt-1 pb-4 text-xs font-medium transition ${tab === item.value ? \"border-leaf text-leaf\" : \"border-transparent text-muted hover:text-ink\"}`}>{item.value === \"all\" ? \"All\" : item.label}<span className={`rounded-md px-1.5 py-0.5 text-[9px] ${tab === item.value ? \"bg-mint text-leaf\" : \"bg-[#f3f4f1] text-muted\"}`}>{counts[item.value]}</span></button>)}\n+              </div>\n+              <div className=\"relative mb-3\"><Icon name=\"flag\" className=\"pointer-events-none absolute top-2.5 left-2.5 size-3.5 text-muted\" /><select aria-label=\"Filter by priority\" value={priority} onChange={(event) => { setPriority(event.target.value as Priority | \"\"); setPages(1); setTodos([]); setLoading(true); setEditing(null); }} className=\"appearance-none rounded-md border border-line bg-white py-2 pr-8 pl-8 text-[11px] text-muted hover:border-[#cbd8c3]\"><option value=\"\">All priorities</option><option value=\"high\">High priority</option><option value=\"medium\">Medium priority</option><option value=\"low\">Low priority</option></select><Icon name=\"chevronDown\" className=\"pointer-events-none absolute top-2.5 right-2.5 size-3 text-muted\" /></div>\n+            </div>\n+            <div id=\"todo-panel\" role=\"tabpanel\" aria-labelledby={`tab-${tab}`} aria-busy={loading}>\n+              {error && <div role=\"alert\" className=\"mx-5 my-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-red-100 bg-red-50 p-3 text-xs text-red-700\"><span>{error}</span><button onClick={() => setRevision((value) => value + 1)} className=\"shrink-0 font-semibold underline\">Try again</button></div>}\n+              <div className=\"hidden grid-cols-[minmax(0,1fr)_110px_140px_68px] gap-4 border-b border-line bg-[#fafbf8] px-6 py-3 text-[9px] font-medium tracking-[1.1px] text-[#969d90] md:grid\"><span className=\"pl-9\">TASK</span><span>PRIORITY</span><span>DUE DATE</span><span /></div>\n+              {loading && todos.length === 0 ? <div role=\"status\" className=\"space-y-5 px-6 py-9\"><span className=\"sr-only\">Loading your tasks</span>{[1, 2, 3].map((row) => <div key={row} className=\"flex animate-pulse items-center gap-4\"><span className=\"size-5 rounded-md bg-mint\" /><span className=\"h-3 w-2/5 rounded bg-[#f0f2ec]\" /><span className=\"ml-auto h-5 w-16 rounded bg-[#f0f2ec]\" /></div>)}</div> : todos.length === 0 && !error ? <div className=\"flex flex-col items-center px-6 py-14 text-center\"><span className=\"relative mb-5 flex size-16 items-center justify-center rounded-2xl border border-[#dfe8d7] bg-[#f0f5ea] text-[#8ca674]\"><Icon name={tab === \"completed\" ? \"circleCheck\" : \"list\"} className=\"size-7\" /><span className=\"absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full border-2 border-white bg-[#dce9cd]\"><Icon name=\"sparkles\" className=\"size-2.5 text-[#719251]\" /></span></span><h3 className=\"text-base font-semibold tracking-tight\">{priority ? \"A little breathing room.\" : tab === \"completed\" ? \"Your little wins will live here.\" : tab === \"open\" && stats.total ? \"All caught up. Look at you!\" : \"A fresh page. A clear mind.\"}</h3><p className=\"mt-2 max-w-xs text-xs leading-6 text-muted\">{priority ? \"No tasks match this filter. Try another priority, or add something new.\" : tab === \"completed\" ? \"Check off a task when it’s done. Every bit of progress counts.\" : tab === \"open\" && stats.total ? \"You’ve checked off every task. Take a moment to enjoy it.\" : \"Big plans or small reminders — get them out of your head and into your list.\"}</p><button onClick={priority ? () => { setPriority(\"\"); setPages(1); } : beginAdd} className=\"mt-5 flex items-center gap-1.5 rounded-lg border border-[#dce5d5] bg-white px-4 py-2.5 text-xs font-medium text-leaf transition hover:bg-mint\"><Icon name={priority ? \"x\" : \"plus\"} className=\"size-3.5\" />{priority ? \"Clear priority filter\" : \"Add your first task\"}</button></div> : <div className=\"divide-y divide-line\">\n+                {todos.map((todo) => editing === todo.id ? <div key={todo.id} className=\"p-4 sm:p-5\"><TodoForm todo={todo} onSave={(values) => save(values, todo)} onCancel={() => setEditing(null)} /></div> : <TodoRow key={todo.id} todo={todo} today={today} disabled={loading || pending !== null} onToggle={() => void toggle(todo)} onEdit={() => { setEditing(todo.id); setAdding(false); }} onDelete={() => setDeleting(todo)} />)}\n+              </div>}\n+              <div className=\"flex flex-wrap items-center justify-between gap-3 border-t border-line bg-[#fdfefb] px-5 py-4 sm:px-6\"><p className=\"text-[10px] text-muted\">{loading ? \"Refreshing your list…\" : `${todos.length} of ${matching} ${matching === 1 ? \"task\" : \"tasks\"}`}<span className=\"mx-2 text-[#ced4c7]\">·</span>{stats.open} still to do</p>{remaining > 0 && <button disabled={loading} onClick={() => setPages((value) => value + 1)} className=\"flex items-center gap-2 rounded-md border border-line bg-white px-3 py-2 text-[10px] font-medium transition hover:bg-mint disabled:opacity-50\">{loading ? \"Loading…\" : \"Load more\"}<Icon name=\"chevronDown\" className=\"size-3\" /></button>}<span className=\"flex items-center gap-1 text-[9px] text-[#9ba491]\"><Icon name=\"lock\" className=\"size-3\" />Only you can see this list</span></div>\n+            </div>\n+          </section>\n+          <div className=\"mt-7 flex flex-wrap items-center justify-between gap-4\"><p className=\"flex items-center gap-1.5 text-[10px] text-[#949d8d]\"><Icon name=\"leaf\" className=\"size-3.5\" />Little by little, a little becomes a lot.</p>{stats.total > 0 && <div className=\"flex items-center gap-3 text-[10px] text-muted\"><span>{progress}% complete</span><progress aria-label=\"Overall task completion\" value={counts.completed} max={stats.total} className=\"h-1.5 w-24 overflow-hidden rounded-full [&::-webkit-progress-bar]:bg-[#e9eee2] [&::-webkit-progress-value]:rounded-full [&::-webkit-progress-value]:bg-[#87a774] [&::-moz-progress-bar]:bg-[#87a774]\" /></div>}</div>\n+        </main>\n+      </div>\n+      {deleting && <DeleteDialog todo={deleting} onDelete={remove} onCancel={() => setDeleting(null)} />}\n+      {notice && <div role=\"status\" className=\"fixed right-5 bottom-5 left-5 z-40 flex items-center gap-3 rounded-xl border border-[#dbe6d3] bg-white px-4 py-3.5 shadow-lg sm:left-auto\"><span className=\"flex size-6 items-center justify-center rounded-full bg-mint text-leaf\"><Icon name=\"check\" className=\"size-3.5\" /></span><span className=\"text-xs\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss notification\" className=\"ml-3 rounded p-1 text-muted\"><Icon name=\"x\" className=\"size-3.5\" /></button></div>}\n+    </div>\n+  );\n+}\n+\n+function TodoRow({ todo, today, disabled, onToggle, onEdit, onDelete }: {\n+  todo: Todo; today: string; disabled: boolean;\n+  onToggle: () => void; onEdit: () => void; onDelete: () => void;\n+}) {\n+  const overdue = !todo.completed && !!todo.due_date && todo.due_date < today;\n+  const priorityStyle = { high: \"bg-[#fbebe7] text-[#bd7767]\", medium: \"bg-[#f9f2de] text-[#ac9150]\", low: \"bg-[#ecf2e6] text-[#789663]\" };\n+  return (\n+    <div className={`group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 px-5 py-5 transition hover:bg-[#fafcf7] sm:px-6 md:grid-cols-[minmax(0,1fr)_110px_140px_68px] ${overdue ? \"bg-[#fffdf9]\" : \"\"}`}>\n+      <div className=\"flex min-w-0 items-start gap-3\">\n+        <input type=\"checkbox\" checked={todo.completed} disabled={disabled} onChange={onToggle} aria-label={`${todo.completed ? \"Reopen\" : \"Complete\"} ${todo.title}`} className=\"mt-0.5 size-[18px] shrink-0 cursor-pointer rounded border-[#cdd7c5] accent-leaf disabled:cursor-wait disabled:opacity-50\" />\n+        <div className=\"min-w-0\"><p className={`break-words text-[12px] leading-5 font-medium ${todo.completed ? \"text-[#9ca493] line-through decoration-[#b5bbaa]\" : \"text-ink\"}`}>{todo.title}</p>{todo.description && <p className={`mt-1 line-clamp-2 break-words text-[11px] leading-5 ${todo.completed ? \"text-[#acb2a4]\" : \"text-muted\"}`}>{todo.description}</p>}</div>\n+      </div>\n+      <div className=\"col-start-1 row-start-2 ml-8 flex items-center gap-3 md:col-start-2 md:row-start-1 md:ml-0\"><span className={`inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[9px] font-medium ${priorityStyle[todo.priority]} ${todo.completed ? \"opacity-60\" : \"\"}`}><span className=\"size-1 rounded-full bg-current\" />{todo.priority.slice(0, 1).toUpperCase() + todo.priority.slice(1)}</span><span className=\"text-[10px] text-muted md:hidden\">{todo.due_date ? formatDue(todo.due_date) : \"No due date\"}{overdue && <span className=\"ml-1 text-[#c07860]\">· Overdue</span>}</span></div>\n+      <div className={`hidden items-center gap-1.5 text-[10px] md:flex ${overdue ? \"text-[#c07860]\" : \"text-[#939c89]\"}`}><Icon name={overdue ? \"clock\" : \"calendar\"} className=\"size-3.5\" />{todo.due_date ? <span>{formatDue(todo.due_date)}{overdue && <span className=\"mt-0.5 block text-[8px]\">Overdue</span>}</span> : <span className=\"text-[#b4bcac]\">No due date</span>}</div>\n+      <div className=\"col-start-2 row-start-1 flex items-center justify-end gap-1 md:col-start-4\"><button onClick={onEdit} disabled={disabled} aria-label={`Edit ${todo.title}`} title=\"Edit task\" className=\"rounded-md p-2 text-[#a2ab99] transition hover:bg-mint hover:text-leaf disabled:opacity-40\"><Icon name=\"pencil\" className=\"size-3.5\" /></button><button onClick={onDelete} disabled={disabled} aria-label={`Delete ${todo.title}`} title=\"Delete task\" className=\"rounded-md p-2 text-[#a2ab99] transition hover:bg-red-50 hover:text-red-500 disabled:opacity-40\"><Icon name=\"trash\" className=\"size-3.5\" /></button></div>\n+    </div>\n+  );\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/src/api.ts\nA frontend/src/components/Icon.tsx\nA frontend/src/components/Brand.tsx\nA frontend/src/components/Auth.tsx\nA frontend/src/components/TodoForm.tsx\nA frontend/src/components/DeleteDialog.tsx\nD frontend/src/App.tsx\nA frontend/src/App.tsx","metadata":{"diff":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n+import tailwindcss from \"@tailwindcss/vite\";\n import react from \"@vitejs/plugin-react\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,17 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,20 @@\n+import js from \"@eslint/js\";\n+import { defineConfig, globalIgnores } from \"eslint/config\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default defineConfig([\n+  globalIgnores([\"dist\", \"node_modules\"]),\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    extends: [js.configs.recommended, tseslint.configs.recommended],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }],\n+    },\n+  },\n+]);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,29 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", ui-sans-serif, system-ui, sans-serif;\n+  --color-ink: #26382e;\n+  --color-muted: #788079;\n+  --color-paper: #fbfcfa;\n+  --color-line: #e9ece6;\n+  --color-leaf: #397b56;\n+  --color-mint: #edf4e9;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, input, select, textarea {\n+    @apply font-[inherit];\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  button, a, input, select, textarea {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-leaf/50 focus-visible:ring-offset-2;\n+  }\n+  ::selection {\n+    @apply bg-leaf/20;\n+  }\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#397b56\" />\n+    <meta name=\"description\" content=\"A little space to organize your day. Keep your tasks private, find your focus, and make progress with Tidy.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Tidy — A little more headspace</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"12\" fill=\"#397b56\"/><path d=\"M11 12h18M11 20h9m-9 8h9m2-5 3 3 6-7\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/></svg>\n\nIndex: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,82 @@\n+export type Priority = \"low\" | \"medium\" | \"high\";\n+export type Todo = {\n+  id: number;\n+  title: string;\n+  description: string | null;\n+  priority: Priority;\n+  due_date: string | null;\n+  completed: boolean;\n+  completed_at: string | null;\n+  created_at: string;\n+};\n+export type TodoValues = Pick<Todo, \"title\" | \"description\" | \"priority\" | \"due_date\">;\n+export type TodoPage = {\n+  items: Todo[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+  remaining: number;\n+};\n+export type User = { id: number; username: string };\n+export type FieldErrors = Record<string, string>;\n+\n+export class ApiError extends Error {\n+  status: number;\n+  fields: FieldErrors;\n+\n+  constructor(message: string, status: number, fields: FieldErrors = {}) {\n+    super(message);\n+    this.name = \"ApiError\";\n+    this.status = status;\n+    this.fields = fields;\n+  }\n+}\n+\n+export async function api<T>(\n+  path: string,\n+  token: string | null = null,\n+  options: { method?: string; body?: unknown; signal?: AbortSignal } = {},\n+): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      headers: {\n+        ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+      },\n+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n+      signal: options.signal,\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Couldn’t reach the server. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) {\n+    throw new ApiError(data?.error ?? \"Something went wrong. Please try again.\", response.status, data?.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n+\n+export function todayISO() {\n+  const date = new Date();\n+  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, \"0\")}-${String(date.getDate()).padStart(2, \"0\")}`;\n+}\n+\n+export function formatDue(value: string) {\n+  if (value === todayISO()) return \"Today\";\n+  const tomorrow = new Date();\n+  tomorrow.setDate(tomorrow.getDate() + 1);\n+  const date = new Date(`${value}T12:00:00`);\n+  if (date.toDateString() === tomorrow.toDateString()) return \"Tomorrow\";\n+  return date.toLocaleDateString(undefined, {\n+    month: \"short\", day: \"numeric\",\n+    ...(date.getFullYear() !== new Date().getFullYear() ? { year: \"numeric\" } : {}),\n+  });\n+}\n\nIndex: /workspace/frontend/src/components/Icon.tsx\n===================================================================\n--- /workspace/frontend/src/components/Icon.tsx\n+++ /workspace/frontend/src/components/Icon.tsx\n@@ -0,0 +1,34 @@\n+const paths = {\n+  list: \"M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01\",\n+  check: \"m5 12 4 4L19 6\",\n+  circleCheck: \"m8 12 3 3 5-6M21 12a9 9 0 1 1-5-8\",\n+  circle: \"M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0\",\n+  plus: \"M12 5v14M5 12h14\",\n+  calendar: \"M8 3v4m8-4v4M4 10h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 9h2m4 0h2m-8 3h2\",\n+  sun: \"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0\",\n+  logout: \"M9 5H4v14h5m5-14 5 7-5 7m-6-7h11\",\n+  pencil: \"m15 5 4 4M4 20l4-1 12-12a2.8 2.8 0 0 0-4-4L4 15v5Z\",\n+  trash: \"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\",\n+  chevron: \"m9 5 7 7-7 7\",\n+  chevronDown: \"m6 9 6 6 6-6\",\n+  arrow: \"M5 12h14m-6-6 6 6-6 6\",\n+  leaf: \"M5 19C0 6 10 3 21 3c0 11-3 21-16 16Zm-2 2L15 9\",\n+  lock: \"M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5V10Zm7 4v3\",\n+  eye: \"M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Zm13 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0\",\n+  eyeOff: \"m3 3 18 18M10 5c8-2 12 7 12 7a19 19 0 0 1-4 5M6 6a20 20 0 0 0-4 6s3 7 10 7a13 13 0 0 0 5-1M10 10a3 3 0 0 0 4 4\",\n+  clock: \"M12 8v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0\",\n+  x: \"m6 6 12 12M6 18 18 6\",\n+  menu: \"M4 6h16M4 12h16M4 18h16\",\n+  sparkles: \"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Zm8-1v4m-2-2h4\",\n+  flag: \"M5 21V3m0 1c5-4 9 4 14 0v10c-5 4-9-4-14 0\",\n+} as const;\n+\n+export type IconName = keyof typeof paths;\n+\n+export default function Icon({ name, className = \"size-5\" }: { name: IconName; className?: string }) {\n+  return (\n+    <svg className={className} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.7\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+      <path d={paths[name]} />\n+    </svg>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/Brand.tsx\n===================================================================\n--- /workspace/frontend/src/components/Brand.tsx\n+++ /workspace/frontend/src/components/Brand.tsx\n@@ -0,0 +1,12 @@\n+export default function Brand() {\n+  return (\n+    <div className=\"flex items-center gap-2.5\" aria-label=\"Tidy\">\n+      <span className=\"flex size-9 items-center justify-center rounded-xl bg-leaf text-white\">\n+        <svg viewBox=\"0 0 40 40\" className=\"size-8\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+          <path d=\"M11 12h18M11 20h9m-9 8h9m2-5 3 3 6-7\" />\n+        </svg>\n+      </span>\n+      <span className=\"text-[27px] font-semibold tracking-[-1.5px]\">tidy<span className=\"text-leaf\">.</span></span>\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/Auth.tsx\n===================================================================\n--- /workspace/frontend/src/components/Auth.tsx\n+++ /workspace/frontend/src/components/Auth.tsx\n@@ -0,0 +1,113 @@\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, ApiError, errorMessage } from \"../api\";\n+import type { FieldErrors } from \"../api\";\n+import Brand from \"./Brand\";\n+import Icon from \"./Icon\";\n+\n+export default function Auth({ onSignIn }: { onSignIn: (token: string) => void }) {\n+  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [showPassword, setShowPassword] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<FieldErrors>({});\n+  const register = mode === \"register\";\n+\n+  function changeMode(next: \"login\" | \"register\") {\n+    setMode(next);\n+    setError(\"\");\n+    setFields({});\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    let created = false;\n+    try {\n+      const body = { username, password };\n+      if (register) {\n+        await api(\"/auth/register\", null, { method: \"POST\", body });\n+        created = true;\n+      }\n+      const { token } = await api<{ token: string }>(\"/auth/login\", null, { method: \"POST\", body });\n+      onSignIn(token);\n+    } catch (error) {\n+      if (created) setMode(\"login\");\n+      setError(created ? `Your account was created. ${errorMessage(error)}` : errorMessage(error));\n+      if (error instanceof ApiError) setFields(error.fields);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  const inputClass = \"mt-2 w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm transition placeholder:text-[#a1a69e] focus:border-leaf focus:ring-2 focus:ring-leaf/10 disabled:opacity-60\";\n+\n+  return (\n+    <div className=\"relative flex min-h-screen flex-col overflow-hidden\">\n+      <header className=\"mx-auto flex w-full max-w-[1280px] items-center justify-between px-6 py-7 sm:px-12\">\n+        <Brand />\n+        <span className=\"hidden items-center gap-2 text-xs text-muted sm:flex\"><Icon name=\"leaf\" className=\"size-4 text-leaf\" /> A little more headspace.</span>\n+      </header>\n+      <main className=\"mx-auto grid w-full max-w-[1100px] flex-1 items-center gap-12 px-6 py-12 md:grid-cols-[1.15fr_1fr] md:gap-16 md:py-16\">\n+        <section className=\"relative\">\n+          <div className=\"mb-6 inline-flex items-center gap-2 rounded-full border border-[#dce8d6] bg-mint px-3.5 py-1.5 text-[11px] font-semibold tracking-[1.5px] text-leaf\"><Icon name=\"sun\" className=\"size-3.5\" /> YOUR DAY, A LITTLE LIGHTER</div>\n+          <h1 className=\"text-[44px] leading-[1.13] font-semibold tracking-[-2.3px] sm:text-[58px]\">Less on your mind.<br />More in your <span className=\"text-leaf\">day.</span></h1>\n+          <p className=\"mt-6 max-w-[390px] text-[15px] leading-7 text-muted\">A simple home for everything you need to do. Find your focus, take it one task at a time, and enjoy a little more breathing room.</p>\n+          <div className=\"mt-9 space-y-4\">\n+            {[\n+              { icon: \"lock\" as const, title: \"Just for you\", text: \"Your tasks. Your own private space.\" },\n+              { icon: \"flag\" as const, title: \"Focus on what matters\", text: \"Clear priorities, without the clutter.\" },\n+              { icon: \"circleCheck\" as const, title: \"Small steps, real progress\", text: \"Every checkmark is a little win.\" },\n+            ].map((feature) => (\n+              <div key={feature.title} className=\"flex items-center gap-3.5\">\n+                <span className=\"flex size-10 shrink-0 items-center justify-center rounded-xl border border-[#e0e8db] bg-mint text-leaf\"><Icon name={feature.icon} className=\"size-[18px]\" /></span>\n+                <div><h2 className=\"text-[13px] font-semibold\">{feature.title}</h2><p className=\"mt-0.5 text-xs text-muted\">{feature.text}</p></div>\n+              </div>\n+            ))}\n+          </div>\n+          <div className=\"mt-10 flex items-center gap-3 text-xs text-muted\"><span className=\"h-px w-8 bg-[#ccd8c5]\" /> Less busy. More intentional.</div>\n+        </section>\n+        <section className=\"rounded-2xl border border-line bg-white p-6 shadow-[0_12px_60px_-20px_rgba(40,65,40,0.13)] sm:p-9\">\n+          <div className=\"mb-8 flex rounded-lg bg-[#f3f5f0] p-1\" aria-label=\"Account options\">\n+            {([\"login\", \"register\"] as const).map((value) => (\n+              <button key={value} disabled={busy} onClick={() => changeMode(value)} aria-pressed={mode === value} className={`flex-1 rounded-md py-2.5 text-xs font-semibold transition ${mode === value ? \"bg-white text-ink shadow-sm\" : \"text-muted hover:text-ink\"}`}>\n+                {value === \"login\" ? \"Sign in\" : \"Create account\"}\n+              </button>\n+            ))}\n+          </div>\n+          <span className=\"mb-4 flex size-11 items-center justify-center rounded-xl bg-mint text-leaf\"><Icon name={register ? \"sparkles\" : \"leaf\"} className=\"size-5\" /></span>\n+          <h2 className=\"text-2xl font-semibold tracking-[-0.8px]\">{register ? \"A fresh start awaits.\" : \"Welcome back.\"}</h2>\n+          <p className=\"mt-2 text-sm text-muted\">{register ? \"Make a little space for what matters.\" : \"Let’s make a little room for a good day.\"}</p>\n+          <form className=\"mt-7 space-y-5\" onSubmit={submit} noValidate>\n+            <div>\n+              <label htmlFor=\"username\" className=\"text-xs font-semibold\">Username</label>\n+              <input id=\"username\" name=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} placeholder=\"Your username\" className={inputClass} disabled={busy} aria-invalid={!!fields.username} aria-describedby={fields.username ? \"username-error\" : undefined} />\n+              {fields.username && <p id=\"username-error\" className=\"mt-1.5 text-xs text-red-600\">{fields.username}</p>}\n+            </div>\n+            <div>\n+              <label htmlFor=\"password\" className=\"text-xs font-semibold\">Password</label>\n+              <div className=\"relative\">\n+                <input id=\"password\" name=\"password\" type={showPassword ? \"text\" : \"password\"} autoComplete={register ? \"new-password\" : \"current-password\"} value={password} onChange={(event) => setPassword(event.target.value)} placeholder={register ? \"At least 8 characters\" : \"Your password\"} className={`${inputClass} pr-11`} disabled={busy} aria-invalid={!!fields.password} aria-describedby={fields.password ? \"password-error\" : undefined} />\n+                <button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute inset-y-0 right-2 mt-2 flex w-8 items-center justify-center rounded text-muted hover:text-ink\"><Icon name={showPassword ? \"eyeOff\" : \"eye\"} className=\"size-[18px]\" /></button>\n+              </div>\n+              {fields.password && <p id=\"password-error\" className=\"mt-1.5 text-xs text-red-600\">{fields.password}</p>}\n+              {register && !fields.password && <p className=\"mt-2 text-[11px] text-muted\">8–128 characters. Make it uniquely yours.</p>}\n+            </div>\n+            {error && <p role=\"alert\" className=\"rounded-lg border border-red-100 bg-red-50 p-3 text-xs leading-5 text-red-700\">{error}</p>}\n+            <button disabled={busy} className=\"flex w-full items-center justify-center gap-2 rounded-lg bg-leaf py-3.5 text-sm font-medium text-white transition hover:bg-[#2f6848] disabled:opacity-60\">{busy ? \"Just a moment…\" : register ? \"Create your account\" : \"Sign in to your space\"}{!busy && <Icon name=\"arrow\" className=\"size-4\" />}</button>\n+          </form>\n+          <div className=\"mt-7 border-t border-line pt-5 text-center text-xs text-muted\">\n+            {register ? \"Already have a little space here? \" : \"New here? \"}\n+            <button disabled={busy} onClick={() => changeMode(register ? \"login\" : \"register\")} className=\"font-semibold text-leaf hover:underline\">{register ? \"Sign in\" : \"Create an account\"}</button>\n+          </div>\n+          <div className=\"mt-5 flex items-center justify-center gap-1.5 text-[10px] text-muted\"><Icon name=\"lock\" className=\"size-3\" /> Your list is private. Always.</div>\n+        </section>\n+      </main>\n+      <footer className=\"px-6 py-6 text-center text-[11px] text-muted\">Made for a little less chaos, and a little more you.</footer>\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/TodoForm.tsx\n===================================================================\n--- /workspace/frontend/src/components/TodoForm.tsx\n+++ /workspace/frontend/src/components/TodoForm.tsx\n@@ -0,0 +1,63 @@\n+import { useId, useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { ApiError, errorMessage } from \"../api\";\n+import type { FieldErrors, Priority, Todo, TodoValues } from \"../api\";\n+import Icon from \"./Icon\";\n+\n+export default function TodoForm({ todo, onSave, onCancel }: {\n+  todo?: Todo;\n+  onSave: (values: TodoValues) => Promise<void>;\n+  onCancel: () => void;\n+}) {\n+  const id = useId();\n+  const [title, setTitle] = useState(todo?.title ?? \"\");\n+  const [description, setDescription] = useState(todo?.description ?? \"\");\n+  const [priority, setPriority] = useState<Priority>(todo?.priority ?? \"medium\");\n+  const [dueDate, setDueDate] = useState(todo?.due_date ?? \"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<FieldErrors>({});\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    try {\n+      await onSave({ title, description, priority, due_date: dueDate || null });\n+    } catch (error) {\n+      setError(errorMessage(error));\n+      if (error instanceof ApiError) setFields(error.fields);\n+      setBusy(false);\n+    }\n+  }\n+\n+  const inputClass = \"mt-1.5 w-full rounded-lg border border-[#dde4d8] bg-white px-3 py-2.5 text-sm focus:border-leaf focus:ring-2 focus:ring-leaf/10 placeholder:text-[#a1a69e] disabled:opacity-60\";\n+  function fieldError(field: string) {\n+    return fields[field] ? <p id={`${id}-${field}-error`} className=\"mt-1.5 text-xs text-red-600\">{fields[field]}</p> : null;\n+  }\n+\n+  return (\n+    <form onSubmit={submit} noValidate className=\"rounded-xl border border-[#dce6d6] bg-[#f7faf4] p-5 sm:p-6\">\n+      <div className=\"mb-5 flex items-center justify-between\"><h3 className=\"flex items-center gap-2 text-sm font-semibold\"><Icon name={todo ? \"pencil\" : \"plus\"} className=\"size-4 text-leaf\" />{todo ? \"Edit task\" : \"A new little to-do\"}</h3><button type=\"button\" onClick={onCancel} disabled={busy} aria-label=\"Close task form\" className=\"rounded-md p-1 text-muted hover:bg-mint\"><Icon name=\"x\" className=\"size-4\" /></button></div>\n+      <fieldset disabled={busy} className=\"space-y-4\">\n+        <div>\n+          <label htmlFor={`${id}-title`} className=\"text-xs font-medium\">Task title <span className=\"text-leaf\">*</span></label>\n+          <input autoFocus id={`${id}-title`} name=\"title\" value={title} onChange={(event) => setTitle(event.target.value)} placeholder=\"What would you like to get done?\" className={inputClass} aria-invalid={!!fields.title} aria-describedby={fields.title ? `${id}-title-error` : undefined} />\n+          {fieldError(\"title\")}\n+        </div>\n+        <div>\n+          <label htmlFor={`${id}-description`} className=\"text-xs font-medium\">Description <span className=\"font-normal text-muted\">(optional)</span></label>\n+          <textarea id={`${id}-description`} name=\"description\" rows={2} value={description} onChange={(event) => setDescription(event.target.value)} placeholder=\"A few details, a helpful reminder…\" className={`${inputClass} resize-y`} aria-invalid={!!fields.description} aria-describedby={fields.description ? `${id}-description-error` : undefined} />\n+          {fieldError(\"description\")}\n+        </div>\n+        <div className=\"grid gap-4 sm:grid-cols-2\">\n+          <div><label htmlFor={`${id}-priority`} className=\"text-xs font-medium\">Priority</label><select id={`${id}-priority`} value={priority} onChange={(event) => setPriority(event.target.value as Priority)} className={inputClass} aria-invalid={!!fields.priority} aria-describedby={fields.priority ? `${id}-priority-error` : undefined}><option value=\"low\">Low priority</option><option value=\"medium\">Medium priority</option><option value=\"high\">High priority</option></select>{fieldError(\"priority\")}</div>\n+          <div><label htmlFor={`${id}-due_date`} className=\"text-xs font-medium\">Due date <span className=\"font-normal text-muted\">(optional)</span></label><input id={`${id}-due_date`} type=\"date\" value={dueDate} onChange={(event) => setDueDate(event.target.value)} className={inputClass} aria-invalid={!!fields.due_date} aria-describedby={fields.due_date ? `${id}-due_date-error` : undefined} />{fieldError(\"due_date\")}</div>\n+        </div>\n+      </fieldset>\n+      {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-xs text-red-700\">{error}</p>}\n+      <div className=\"mt-5 flex items-center justify-end gap-3\"><button type=\"button\" onClick={onCancel} disabled={busy} className=\"rounded-lg px-4 py-2.5 text-xs font-medium text-muted transition hover:bg-mint\">Cancel</button><button disabled={busy} className=\"flex items-center gap-2 rounded-lg bg-leaf px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-[#2f6848] disabled:opacity-60\"><Icon name={todo ? \"check\" : \"plus\"} className=\"size-4\" />{busy ? \"Saving…\" : todo ? \"Save changes\" : \"Add task\"}</button></div>\n+    </form>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/DeleteDialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/DeleteDialog.tsx\n+++ /workspace/frontend/src/components/DeleteDialog.tsx\n@@ -0,0 +1,40 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { errorMessage } from \"../api\";\n+import type { Todo } from \"../api\";\n+import Icon from \"./Icon\";\n+\n+export default function DeleteDialog({ todo, onDelete, onCancel }: {\n+  todo: Todo;\n+  onDelete: () => Promise<void>;\n+  onCancel: () => void;\n+}) {\n+  const dialog = useRef<HTMLDialogElement>(null);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  useEffect(() => {\n+    const element = dialog.current;\n+    element?.showModal();\n+    return () => element?.close();\n+  }, []);\n+\n+  async function remove() {\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      await onDelete();\n+    } catch (error) {\n+      setError(errorMessage(error));\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <dialog ref={dialog} onCancel={(event) => { event.preventDefault(); if (!busy) onCancel(); }} aria-labelledby=\"delete-title\" aria-describedby=\"delete-description\" className=\"fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-line bg-white p-7 text-ink shadow-xl backdrop:bg-ink/30 backdrop:backdrop-blur-[3px]\">\n+      <span className=\"mb-5 flex size-11 items-center justify-center rounded-xl bg-red-50 text-red-500\"><Icon name=\"trash\" className=\"size-5\" /></span>\n+      <h2 id=\"delete-title\" className=\"text-xl font-semibold tracking-tight\">Delete this task?</h2>\n+      <p id=\"delete-description\" className=\"mt-3 text-sm leading-6 text-muted\">“<span className=\"break-words font-medium text-ink\">{todo.title}</span>” will be permanently deleted. This can’t be undone.</p>\n+      {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-xs text-red-700\">{error}</p>}\n+      <div className=\"mt-7 flex justify-end gap-3\"><button autoFocus disabled={busy} onClick={onCancel} className=\"rounded-lg border border-line px-4 py-2.5 text-xs font-medium hover:bg-paper\">Keep task</button><button disabled={busy} onClick={remove} className=\"rounded-lg bg-red-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-red-700 disabled:opacity-60\">{busy ? \"Deleting…\" : \"Delete task\"}</button></div>\n+    </dialog>\n+  );\n+}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,271 @@\n+import { useCallback, useEffect, useState } from \"react\";\n+import { api, ApiError, errorMessage, formatDue, todayISO } from \"./api\";\n+import type { Priority, Todo, TodoPage, TodoValues, User } from \"./api\";\n+import Auth from \"./components/Auth\";\n+import Brand from \"./components/Brand\";\n+import DeleteDialog from \"./components/DeleteDialog\";\n+import Icon from \"./components/Icon\";\n+import type { IconName } from \"./components/Icon\";\n+import TodoForm from \"./components/TodoForm\";\n+\n+type Tab = \"all\" | \"open\" | \"completed\";\n+const tabs: { value: Tab; label: string; icon: IconName }[] = [\n+  { value: \"all\", label: \"All tasks\", icon: \"list\" },\n+  { value: \"open\", label: \"Open\", icon: \"circle\" },\n+  { value: \"completed\", label: \"Completed\", icon: \"circleCheck\" },\n+];\n+\n+function storedToken() {\n+  try { return localStorage.getItem(\"tidy-token\"); } catch { return null; }\n+}\n+\n+export default function App() {\n+  const [token, setToken] = useState<string | null>(storedToken);\n+  const [identity, setIdentity] = useState<{ token: string; user: User } | null>(null);\n+  const [sessionError, setSessionError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+\n+  const signIn = useCallback((next: string) => {\n+    try { localStorage.setItem(\"tidy-token\", next); } catch { /* empty */ }\n+    setToken(next);\n+    setSessionError(\"\");\n+  }, []);\n+\n+  const clearSession = useCallback(() => {\n+    try { localStorage.removeItem(\"tidy-token\"); } catch { /* empty */ }\n+    setToken(null);\n+    setIdentity(null);\n+    setSessionError(\"\");\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<User>(\"/auth/me\", token, { signal: controller.signal })\n+      .then((user) => { setIdentity({ token, user }); setSessionError(\"\"); })\n+      .catch((error) => {\n+        if (controller.signal.aborted) return;\n+        if (error instanceof ApiError && error.status === 401) clearSession();\n+        else setSessionError(errorMessage(error));\n+      });\n+    return () => controller.abort();\n+  }, [token, retry, clearSession]);\n+\n+  if (!token) return <Auth onSignIn={signIn} />;\n+  if (!identity || identity.token !== token) {\n+    return <div className=\"flex min-h-screen flex-col items-center justify-center gap-5 px-6\"><Brand />{sessionError ? <><p role=\"alert\" className=\"max-w-sm text-center text-sm text-muted\">{sessionError}</p><div className=\"flex gap-3\"><button onClick={() => { setSessionError(\"\"); setRetry(retry + 1); }} className=\"rounded-lg bg-leaf px-4 py-2 text-sm text-white\">Try again</button><button onClick={clearSession} className=\"rounded-lg border border-line px-4 py-2 text-sm\">Back to sign in</button></div></> : <p role=\"status\" className=\"text-sm text-muted\">Opening your little space…</p>}</div>;\n+  }\n+  return <Workspace key={token} token={token} user={identity.user} onExpired={clearSession} />;\n+}\n+\n+function Workspace({ token, user, onExpired }: { token: string; user: User; onExpired: () => void }) {\n+  const [tab, setTab] = useState<Tab>(\"all\");\n+  const [priority, setPriority] = useState<Priority | \"\">(\"\");\n+  const [pages, setPages] = useState(1);\n+  const [revision, setRevision] = useState(0);\n+  const [todos, setTodos] = useState<Todo[]>([]);\n+  const [stats, setStats] = useState({ total: 0, open: 0 });\n+  const [matching, setMatching] = useState(0);\n+  const [remaining, setRemaining] = useState(0);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [adding, setAdding] = useState(false);\n+  const [editing, setEditing] = useState<number | null>(null);\n+  const [deleting, setDeleting] = useState<Todo | null>(null);\n+  const [pending, setPending] = useState<number | null>(null);\n+  const [mobileMenu, setMobileMenu] = useState(false);\n+  const [signingOut, setSigningOut] = useState(false);\n+  const [notice, setNotice] = useState(\"\");\n+  const [today, setToday] = useState(todayISO);\n+\n+  useEffect(() => {\n+    const interval = window.setInterval(() => setToday(todayISO()), 60000);\n+    return () => window.clearInterval(interval);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timer = window.setTimeout(() => setNotice(\"\"), 4000);\n+    return () => window.clearTimeout(timer);\n+  }, [notice]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    const query = new URLSearchParams({ page_size: \"10\" });\n+    if (tab !== \"all\") query.set(\"completed\", String(tab === \"completed\"));\n+    if (priority) query.set(\"priority\", priority);\n+    async function load() {\n+      setLoading(true);\n+      setError(\"\");\n+      try {\n+        const [results, all, open] = await Promise.all([\n+          Promise.all(Array.from({ length: pages }, (_, index) => api<TodoPage>(`/todos?${query}&page=${index + 1}`, token, { signal: controller.signal }))),\n+          api<TodoPage>(\"/todos?page_size=1\", token, { signal: controller.signal }),\n+          api<TodoPage>(\"/todos?completed=false&page_size=1\", token, { signal: controller.signal }),\n+        ]);\n+        if (controller.signal.aborted) return;\n+        const unique = new Map(results.flatMap((result) => result.items).map((todo) => [todo.id, todo]));\n+        setTodos([...unique.values()]);\n+        setMatching(results[0].total);\n+        setRemaining(results[results.length - 1].remaining);\n+        setStats({ total: all.total, open: open.total });\n+      } catch (error) {\n+        if (controller.signal.aborted) return;\n+        if (error instanceof ApiError && error.status === 401) onExpired();\n+        else setError(errorMessage(error));\n+      } finally {\n+        if (!controller.signal.aborted) setLoading(false);\n+      }\n+    }\n+    void load();\n+    return () => controller.abort();\n+  }, [token, tab, priority, pages, revision, onExpired]);\n+\n+  function selectTab(next: Tab) {\n+    setTab(next);\n+    setPages(1);\n+    setTodos([]);\n+    setLoading(true);\n+    setEditing(null);\n+    setMobileMenu(false);\n+  }\n+\n+  function beginAdd() {\n+    setAdding(true);\n+    setEditing(null);\n+    setMobileMenu(false);\n+    window.setTimeout(() => document.getElementById(\"add-task\")?.scrollIntoView({ behavior: \"smooth\", block: \"center\" }), 50);\n+  }\n+\n+  async function mutate<T>(path: string, method: string, body?: unknown) {\n+    try {\n+      return await api<T>(path, token, { method, body });\n+    } catch (error) {\n+      if (error instanceof ApiError && error.status === 401) onExpired();\n+      throw error;\n+    }\n+  }\n+\n+  async function save(values: TodoValues, todo?: Todo) {\n+    await mutate(todo ? `/todos/${todo.id}` : \"/todos\", todo ? \"PATCH\" : \"POST\", values);\n+    setAdding(false);\n+    setEditing(null);\n+    setRevision((value) => value + 1);\n+    setNotice(todo ? \"A little update, all saved.\" : \"Your new task is on the list.\");\n+  }\n+\n+  async function toggle(todo: Todo) {\n+    setPending(todo.id);\n+    setError(\"\");\n+    try {\n+      await mutate(`/todos/${todo.id}`, \"PATCH\", { completed: !todo.completed });\n+      setRevision((value) => value + 1);\n+      setNotice(todo.completed ? \"Task reopened. Take it at your own pace.\" : \"One less thing. Nicely done!\");\n+    } catch (error) {\n+      setError(errorMessage(error));\n+    } finally {\n+      setPending(null);\n+    }\n+  }\n+\n+  async function remove() {\n+    if (!deleting) return;\n+    await mutate(`/todos/${deleting.id}`, \"DELETE\");\n+    setDeleting(null);\n+    setRevision((value) => value + 1);\n+    setNotice(\"Task deleted. A little less clutter.\");\n+  }\n+\n+  async function signOut() {\n+    setSigningOut(true);\n+    try { await api(\"/auth/logout\", token, { method: \"POST\" }); }\n+    finally { onExpired(); }\n+  }\n+\n+  const counts = { all: stats.total, open: stats.open, completed: stats.total - stats.open };\n+  const progress = stats.total ? Math.round((counts.completed / stats.total) * 100) : 0;\n+  const date = new Date(`${today}T12:00:00`).toLocaleDateString(undefined, { weekday: \"long\", month: \"short\", day: \"numeric\" });\n+\n+  return (\n+    <div className=\"min-h-screen lg:grid lg:grid-cols-[232px_minmax(0,1fr)]\">\n+      {mobileMenu && <button onClick={() => setMobileMenu(false)} aria-label=\"Close navigation\" className=\"fixed inset-0 z-20 bg-ink/25 backdrop-blur-[2px] lg:hidden\" />}\n+      <aside className={`${mobileMenu ? \"flex\" : \"hidden\"} fixed inset-y-0 left-0 z-30 w-[232px] flex-col border-r border-line bg-[#f5f7f2] lg:sticky lg:top-0 lg:flex lg:h-screen`}>\n+        <div className=\"px-7 pt-9 pb-10\"><Brand /></div>\n+        <div className=\"px-4\">\n+          <p className=\"mb-3 px-3 text-[10px] font-semibold tracking-[1.8px] text-[#949d91]\">YOUR WORKSPACE</p>\n+          <button onClick={() => { selectTab(\"all\"); setPriority(\"\"); }} className=\"flex w-full items-center gap-3 rounded-lg bg-[#e5eddc] px-3 py-3 text-[13px] font-semibold text-[#386044]\"><Icon name=\"list\" className=\"size-[18px]\" />My tasks<Icon name=\"chevron\" className=\"ml-auto size-3.5 text-[#6e8a61]\" /></button>\n+          <p className=\"mt-8 mb-3 px-3 text-[10px] font-semibold tracking-[1.8px] text-[#949d91]\">A LITTLE OVERVIEW</p>\n+          <nav aria-label=\"Task views\" className=\"space-y-1\">\n+            {tabs.map((item) => <button key={item.value} onClick={() => selectTab(item.value)} aria-current={tab === item.value ? \"page\" : undefined} className={`flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-xs transition hover:bg-[#e9eee3] ${tab === item.value ? \"font-medium text-ink\" : \"text-muted\"}`}><Icon name={item.icon} className=\"size-[17px]\" />{item.label}<span className=\"ml-auto rounded-md bg-white/70 px-1.5 py-0.5 text-[10px] text-muted\">{counts[item.value]}</span></button>)}\n+          </nav>\n+        </div>\n+        <div className=\"mx-5 mt-auto mb-6 rounded-xl border border-[#e0e7d8] bg-[#edf2e6] px-4 py-5\">\n+          <Icon name=\"leaf\" className=\"mb-3 size-5 text-[#73915d]\" /><p className=\"text-xs font-semibold\">Progress, not perfection.</p><p className=\"mt-2 text-[11px] leading-5 text-[#858e7b]\">Small steps still move you forward. You’ve got this.</p>\n+        </div>\n+        <div className=\"mx-5 mb-6 flex items-center gap-2.5 border-t border-[#e1e6dc] pt-5\"><span className=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#dfe8d3] text-xs font-semibold text-[#62724e]\">{user.username.slice(0, 1).toUpperCase()}</span><div className=\"min-w-0\"><p className=\"truncate text-xs font-semibold\">{user.username}</p><p className=\"mt-0.5 text-[10px] text-muted\">Your personal space</p></div><span title=\"Private workspace\" className=\"ml-auto text-[#96a28e]\"><Icon name=\"lock\" className=\"size-3.5\" /></span></div>\n+      </aside>\n+      <div className=\"min-w-0\">\n+        <header className=\"flex h-[78px] items-center justify-between gap-3 border-b border-line bg-white/60 px-5 sm:px-9 lg:px-11\">\n+          <div className=\"flex items-center gap-3 text-xs\"><button onClick={() => setMobileMenu(true)} aria-label=\"Open navigation\" className=\"rounded-md p-1.5 text-muted lg:hidden\"><Icon name=\"menu\" /></button><span className=\"hidden text-muted sm:inline\">My workspace</span><Icon name=\"chevron\" className=\"hidden size-3 text-[#a8ada4] sm:block\" /><span className=\"font-medium\">My tasks</span></div>\n+          <div className=\"flex items-center gap-3 sm:gap-5\"><span className=\"hidden items-center gap-2 text-[11px] text-muted md:flex\"><Icon name=\"calendar\" className=\"size-3.5\" />{date}</span><span className=\"hidden h-5 w-px bg-line md:block\" /><span className=\"max-w-24 truncate text-xs text-muted sm:max-w-36\">{user.username}</span><button disabled={signingOut} onClick={() => void signOut().catch(() => undefined)} className=\"flex items-center gap-1.5 rounded-md px-1 py-2 text-[11px] text-muted transition hover:text-ink disabled:opacity-50\"><Icon name=\"logout\" className=\"size-3.5\" />{signingOut ? \"Signing out…\" : \"Sign out\"}</button></div>\n+        </header>\n+        <main className=\"mx-auto max-w-[1190px] px-5 py-8 sm:px-9 sm:py-10 lg:px-11\">\n+          <div className=\"mb-7 flex flex-wrap items-center justify-between gap-5\">\n+            <div><p className=\"mb-2 flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"sun\" className=\"size-3.5 text-[#b39e56]\" />A fresh little perspective</p><h1 className=\"text-[32px] leading-tight font-semibold tracking-[-1.3px]\">My tasks<span className=\"text-leaf\">.</span></h1><p className=\"mt-2 text-[13px] text-muted\">A clear list. A calmer mind. Let’s take it one thing at a time.</p></div>\n+            <button onClick={beginAdd} className=\"flex items-center gap-2 rounded-lg bg-leaf px-4 py-3 text-xs font-semibold text-white shadow-[0_3px_6px_rgba(57,123,86,0.12)] transition hover:bg-[#2f6848]\"><Icon name=\"plus\" className=\"size-4\" />New task</button>\n+          </div>\n+          <section aria-label=\"Your task overview\" className=\"grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4\">\n+            {[\n+              { label: \"Still to do\", count: stats.open, icon: \"circle\" as const, hint: \"A little focus goes a long way\", color: \"bg-[#f4efe0] text-[#a78b46]\", view: \"open\" as Tab },\n+              { label: \"Checked off\", count: counts.completed, icon: \"circleCheck\" as const, hint: \"Every little win counts\", color: \"bg-[#e8f1e5] text-[#6b9259]\", view: \"completed\" as Tab },\n+              { label: \"All your tasks\", count: stats.total, icon: \"list\" as const, hint: \"Everything, in one little place\", color: \"bg-[#efedf6] text-[#9380b0]\", view: \"all\" as Tab },\n+            ].map((stat) => <button key={stat.label} onClick={() => selectTab(stat.view)} className=\"rounded-xl border border-line bg-white p-5 text-left transition hover:border-[#cbd8c3]\"><span className=\"flex items-center justify-between\"><span className=\"text-[11px] font-medium text-muted\">{stat.label}</span><span className={`flex size-8 items-center justify-center rounded-lg ${stat.color}`}><Icon name={stat.icon} className=\"size-[17px]\" /></span></span><span className=\"mt-0.5 block text-[30px] font-semibold tracking-tight\">{stat.count}</span><span className=\"mt-1 block text-[10px] text-muted\">{stat.hint}</span></button>)}\n+          </section>\n+          <section className=\"relative mt-6 flex items-center justify-between overflow-hidden rounded-xl border border-[#dfe9d6] bg-[#edf4e7] px-6 py-6 sm:px-7\">\n+            <div className=\"relative z-10\"><div className=\"mb-2 flex items-center gap-1.5 text-[10px] font-semibold tracking-[1.1px] text-[#7a8d63]\"><Icon name=\"sparkles\" className=\"size-3.5\" /> A GENTLE REMINDER</div><h2 className=\"text-[19px] font-semibold tracking-[-0.5px]\">You don’t have to do it all today.</h2><p className=\"mt-1.5 max-w-[380px] text-xs leading-5 text-[#7f8b74]\">Start with one small thing. The rest will follow.</p></div>\n+            <div aria-hidden=\"true\" className=\"relative mr-5 hidden h-24 w-32 shrink-0 sm:block\"><div className=\"absolute right-0 bottom-0 size-24 rounded-full bg-[#dee9cd]\" /><div className=\"absolute top-0 left-3 flex h-[91px] w-[70px] -rotate-12 flex-col gap-3 rounded-lg border border-[#c6d6b5] bg-[#f9fcf5] p-3.5 shadow-[3px_5px_0_#d5e2c7]\"><div className=\"flex items-center gap-1.5\"><span className=\"flex size-3 items-center justify-center rounded-sm bg-[#87a56b]\"><Icon name=\"check\" className=\"size-2.5 text-white\" /></span><span className=\"h-1 w-6 rounded bg-[#c5d4b6]\" /></div><div className=\"flex items-center gap-1.5\"><span className=\"size-3 rounded-sm border border-[#c2d0b5]\" /><span className=\"h-1 w-6 rounded bg-[#dbe4d0]\" /></div><div className=\"flex items-center gap-1.5\"><span className=\"size-3 rounded-sm border border-[#c2d0b5]\" /><span className=\"h-1 w-4 rounded bg-[#dbe4d0]\" /></div></div><Icon name=\"leaf\" className=\"absolute right-0 bottom-1 size-11 -rotate-12 text-[#7f9c62]\" /><Icon name=\"sparkles\" className=\"absolute -top-2 right-0 size-5 text-[#9ab082]\" /></div>\n+          </section>\n+          {adding && <div id=\"add-task\" className=\"mt-6\"><TodoForm onSave={(values) => save(values)} onCancel={() => setAdding(false)} /></div>}\n+          <section aria-label=\"Task list\" className=\"mt-8 overflow-hidden rounded-xl border border-line bg-white\">\n+            <div className=\"flex flex-wrap items-center justify-between gap-4 border-b border-line px-5 pt-4 sm:px-6\">\n+              <div className=\"flex gap-5 sm:gap-6\" role=\"tablist\" aria-label=\"Filter by completion\">\n+                {tabs.map((item) => <button key={item.value} role=\"tab\" aria-selected={tab === item.value} aria-controls=\"todo-panel\" id={`tab-${item.value}`} onClick={() => selectTab(item.value)} className={`relative flex items-center gap-1.5 border-b-2 pt-1 pb-4 text-xs font-medium transition ${tab === item.value ? \"border-leaf text-leaf\" : \"border-transparent text-muted hover:text-ink\"}`}>{item.value === \"all\" ? \"All\" : item.label}<span className={`rounded-md px-1.5 py-0.5 text-[9px] ${tab === item.value ? \"bg-mint text-leaf\" : \"bg-[#f3f4f1] text-muted\"}`}>{counts[item.value]}</span></button>)}\n+              </div>\n+              <div className=\"relative mb-3\"><Icon name=\"flag\" className=\"pointer-events-none absolute top-2.5 left-2.5 size-3.5 text-muted\" /><select aria-label=\"Filter by priority\" value={priority} onChange={(event) => { setPriority(event.target.value as Priority | \"\"); setPages(1); setTodos([]); setLoading(true); setEditing(null); }} className=\"appearance-none rounded-md border border-line bg-white py-2 pr-8 pl-8 text-[11px] text-muted hover:border-[#cbd8c3]\"><option value=\"\">All priorities</option><option value=\"high\">High priority</option><option value=\"medium\">Medium priority</option><option value=\"low\">Low priority</option></select><Icon name=\"chevronDown\" className=\"pointer-events-none absolute top-2.5 right-2.5 size-3 text-muted\" /></div>\n+            </div>\n+            <div id=\"todo-panel\" role=\"tabpanel\" aria-labelledby={`tab-${tab}`} aria-busy={loading}>\n+              {error && <div role=\"alert\" className=\"mx-5 my-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-red-100 bg-red-50 p-3 text-xs text-red-700\"><span>{error}</span><button onClick={() => setRevision((value) => value + 1)} className=\"shrink-0 font-semibold underline\">Try again</button></div>}\n+              <div className=\"hidden grid-cols-[minmax(0,1fr)_110px_140px_68px] gap-4 border-b border-line bg-[#fafbf8] px-6 py-3 text-[9px] font-medium tracking-[1.1px] text-[#969d90] md:grid\"><span className=\"pl-9\">TASK</span><span>PRIORITY</span><span>DUE DATE</span><span /></div>\n+              {loading && todos.length === 0 ? <div role=\"status\" className=\"space-y-5 px-6 py-9\"><span className=\"sr-only\">Loading your tasks</span>{[1, 2, 3].map((row) => <div key={row} className=\"flex animate-pulse items-center gap-4\"><span className=\"size-5 rounded-md bg-mint\" /><span className=\"h-3 w-2/5 rounded bg-[#f0f2ec]\" /><span className=\"ml-auto h-5 w-16 rounded bg-[#f0f2ec]\" /></div>)}</div> : todos.length === 0 && !error ? <div className=\"flex flex-col items-center px-6 py-14 text-center\"><span className=\"relative mb-5 flex size-16 items-center justify-center rounded-2xl border border-[#dfe8d7] bg-[#f0f5ea] text-[#8ca674]\"><Icon name={tab === \"completed\" ? \"circleCheck\" : \"list\"} className=\"size-7\" /><span className=\"absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full border-2 border-white bg-[#dce9cd]\"><Icon name=\"sparkles\" className=\"size-2.5 text-[#719251]\" /></span></span><h3 className=\"text-base font-semibold tracking-tight\">{priority ? \"A little breathing room.\" : tab === \"completed\" ? \"Your little wins will live here.\" : tab === \"open\" && stats.total ? \"All caught up. Look at you!\" : \"A fresh page. A clear mind.\"}</h3><p className=\"mt-2 max-w-xs text-xs leading-6 text-muted\">{priority ? \"No tasks match this filter. Try another priority, or add something new.\" : tab === \"completed\" ? \"Check off a task when it’s done. Every bit of progress counts.\" : tab === \"open\" && stats.total ? \"You’ve checked off every task. Take a moment to enjoy it.\" : \"Big plans or small reminders — get them out of your head and into your list.\"}</p><button onClick={priority ? () => { setPriority(\"\"); setPages(1); } : beginAdd} className=\"mt-5 flex items-center gap-1.5 rounded-lg border border-[#dce5d5] bg-white px-4 py-2.5 text-xs font-medium text-leaf transition hover:bg-mint\"><Icon name={priority ? \"x\" : \"plus\"} className=\"size-3.5\" />{priority ? \"Clear priority filter\" : \"Add your first task\"}</button></div> : <div className=\"divide-y divide-line\">\n+                {todos.map((todo) => editing === todo.id ? <div key={todo.id} className=\"p-4 sm:p-5\"><TodoForm todo={todo} onSave={(values) => save(values, todo)} onCancel={() => setEditing(null)} /></div> : <TodoRow key={todo.id} todo={todo} today={today} disabled={loading || pending !== null} onToggle={() => void toggle(todo)} onEdit={() => { setEditing(todo.id); setAdding(false); }} onDelete={() => setDeleting(todo)} />)}\n+              </div>}\n+              <div className=\"flex flex-wrap items-center justify-between gap-3 border-t border-line bg-[#fdfefb] px-5 py-4 sm:px-6\"><p className=\"text-[10px] text-muted\">{loading ? \"Refreshing your list…\" : `${todos.length} of ${matching} ${matching === 1 ? \"task\" : \"tasks\"}`}<span className=\"mx-2 text-[#ced4c7]\">·</span>{stats.open} still to do</p>{remaining > 0 && <button disabled={loading} onClick={() => setPages((value) => value + 1)} className=\"flex items-center gap-2 rounded-md border border-line bg-white px-3 py-2 text-[10px] font-medium transition hover:bg-mint disabled:opacity-50\">{loading ? \"Loading…\" : \"Load more\"}<Icon name=\"chevronDown\" className=\"size-3\" /></button>}<span className=\"flex items-center gap-1 text-[9px] text-[#9ba491]\"><Icon name=\"lock\" className=\"size-3\" />Only you can see this list</span></div>\n+            </div>\n+          </section>\n+          <div className=\"mt-7 flex flex-wrap items-center justify-between gap-4\"><p className=\"flex items-center gap-1.5 text-[10px] text-[#949d8d]\"><Icon name=\"leaf\" className=\"size-3.5\" />Little by little, a little becomes a lot.</p>{stats.total > 0 && <div className=\"flex items-center gap-3 text-[10px] text-muted\"><span>{progress}% complete</span><progress aria-label=\"Overall task completion\" value={counts.completed} max={stats.total} className=\"h-1.5 w-24 overflow-hidden rounded-full [&::-webkit-progress-bar]:bg-[#e9eee2] [&::-webkit-progress-value]:rounded-full [&::-webkit-progress-value]:bg-[#87a774] [&::-moz-progress-bar]:bg-[#87a774]\" /></div>}</div>\n+        </main>\n+      </div>\n+      {deleting && <DeleteDialog todo={deleting} onDelete={remove} onCancel={() => setDeleting(null)} />}\n+      {notice && <div role=\"status\" className=\"fixed right-5 bottom-5 left-5 z-40 flex items-center gap-3 rounded-xl border border-[#dbe6d3] bg-white px-4 py-3.5 shadow-lg sm:left-auto\"><span className=\"flex size-6 items-center justify-center rounded-full bg-mint text-leaf\"><Icon name=\"check\" className=\"size-3.5\" /></span><span className=\"text-xs\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss notification\" className=\"ml-3 rounded p-1 text-muted\"><Icon name=\"x\" className=\"size-3.5\" /></button></div>}\n+    </div>\n+  );\n+}\n+\n+function TodoRow({ todo, today, disabled, onToggle, onEdit, onDelete }: {\n+  todo: Todo; today: string; disabled: boolean;\n+  onToggle: () => void; onEdit: () => void; onDelete: () => void;\n+}) {\n+  const overdue = !todo.completed && !!todo.due_date && todo.due_date < today;\n+  const priorityStyle = { high: \"bg-[#fbebe7] text-[#bd7767]\", medium: \"bg-[#f9f2de] text-[#ac9150]\", low: \"bg-[#ecf2e6] text-[#789663]\" };\n+  return (\n+    <div className={`group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 px-5 py-5 transition hover:bg-[#fafcf7] sm:px-6 md:grid-cols-[minmax(0,1fr)_110px_140px_68px] ${overdue ? \"bg-[#fffdf9]\" : \"\"}`}>\n+      <div className=\"flex min-w-0 items-start gap-3\">\n+        <input type=\"checkbox\" checked={todo.completed} disabled={disabled} onChange={onToggle} aria-label={`${todo.completed ? \"Reopen\" : \"Complete\"} ${todo.title}`} className=\"mt-0.5 size-[18px] shrink-0 cursor-pointer rounded border-[#cdd7c5] accent-leaf disabled:cursor-wait disabled:opacity-50\" />\n+        <div className=\"min-w-0\"><p className={`break-words text-[12px] leading-5 font-medium ${todo.completed ? \"text-[#9ca493] line-through decoration-[#b5bbaa]\" : \"text-ink\"}`}>{todo.title}</p>{todo.description && <p className={`mt-1 line-clamp-2 break-words text-[11px] leading-5 ${todo.completed ? \"text-[#acb2a4]\" : \"text-muted\"}`}>{todo.description}</p>}</div>\n+      </div>\n+      <div className=\"col-start-1 row-start-2 ml-8 flex items-center gap-3 md:col-start-2 md:row-start-1 md:ml-0\"><span className={`inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[9px] font-medium ${priorityStyle[todo.priority]} ${todo.completed ? \"opacity-60\" : \"\"}`}><span className=\"size-1 rounded-full bg-current\" />{todo.priority.slice(0, 1).toUpperCase() + todo.priority.slice(1)}</span><span className=\"text-[10px] text-muted md:hidden\">{todo.due_date ? formatDue(todo.due_date) : \"No due date\"}{overdue && <span className=\"ml-1 text-[#c07860]\">· Overdue</span>}</span></div>\n+      <div className={`hidden items-center gap-1.5 text-[10px] md:flex ${overdue ? \"text-[#c07860]\" : \"text-[#939c89]\"}`}><Icon name={overdue ? \"clock\" : \"calendar\"} className=\"size-3.5\" />{todo.due_date ? <span>{formatDue(todo.due_date)}{overdue && <span className=\"mt-0.5 block text-[8px]\">Overdue</span>}</span> : <span className=\"text-[#b4bcac]\">No due date</span>}</div>\n+      <div className=\"col-start-2 row-start-1 flex items-center justify-end gap-1 md:col-start-4\"><button onClick={onEdit} disabled={disabled} aria-label={`Edit ${todo.title}`} title=\"Edit task\" className=\"rounded-md p-2 text-[#a2ab99] transition hover:bg-mint hover:text-leaf disabled:opacity-40\"><Icon name=\"pencil\" className=\"size-3.5\" /></button><button onClick={onDelete} disabled={disabled} aria-label={`Delete ${todo.title}`} title=\"Delete task\" className=\"rounded-md p-2 text-[#a2ab99] transition hover:bg-red-50 hover:text-red-500 disabled:opacity-40\"><Icon name=\"trash\" className=\"size-3.5\" /></button></div>\n+    </div>\n+  );\n+}\n\n","files":[{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n+import tailwindcss from \"@tailwindcss/vite\";\n import react from \"@vitejs/plugin-react\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,17 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":17,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,20 @@\n+import js from \"@eslint/js\";\n+import { defineConfig, globalIgnores } from \"eslint/config\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default defineConfig([\n+  globalIgnores([\"dist\", \"node_modules\"]),\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    extends: [js.configs.recommended, tseslint.configs.recommended],\n+    languageOptions: { globals: { ...globals.browser, ...globals.node } },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }],\n+    },\n+  },\n+]);\n","additions":20,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,29 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", ui-sans-serif, system-ui, sans-serif;\n+  --color-ink: #26382e;\n+  --color-muted: #788079;\n+  --color-paper: #fbfcfa;\n+  --color-line: #e9ece6;\n+  --color-leaf: #397b56;\n+  --color-mint: #edf4e9;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, input, select, textarea {\n+    @apply font-[inherit];\n+  }\n+  button {\n+    @apply cursor-pointer disabled:cursor-not-allowed;\n+  }\n+  button, a, input, select, textarea {\n+    @apply outline-none focus-visible:ring-2 focus-visible:ring-leaf/50 focus-visible:ring-offset-2;\n+  }\n+  ::selection {\n+    @apply bg-leaf/20;\n+  }\n+}\n","additions":29,"deletions":0},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#397b56\" />\n+    <meta name=\"description\" content=\"A little space to organize your day. Keep your tasks private, find your focus, and make progress with Tidy.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Tidy — A little more headspace</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":4,"deletions":1},{"filePath":"/workspace/frontend/public/favicon.svg","relativePath":"frontend/public/favicon.svg","type":"add","patch":"Index: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"12\" fill=\"#397b56\"/><path d=\"M11 12h18M11 20h9m-9 8h9m2-5 3 3 6-7\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/></svg>\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,82 @@\n+export type Priority = \"low\" | \"medium\" | \"high\";\n+export type Todo = {\n+  id: number;\n+  title: string;\n+  description: string | null;\n+  priority: Priority;\n+  due_date: string | null;\n+  completed: boolean;\n+  completed_at: string | null;\n+  created_at: string;\n+};\n+export type TodoValues = Pick<Todo, \"title\" | \"description\" | \"priority\" | \"due_date\">;\n+export type TodoPage = {\n+  items: Todo[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+  remaining: number;\n+};\n+export type User = { id: number; username: string };\n+export type FieldErrors = Record<string, string>;\n+\n+export class ApiError extends Error {\n+  status: number;\n+  fields: FieldErrors;\n+\n+  constructor(message: string, status: number, fields: FieldErrors = {}) {\n+    super(message);\n+    this.name = \"ApiError\";\n+    this.status = status;\n+    this.fields = fields;\n+  }\n+}\n+\n+export async function api<T>(\n+  path: string,\n+  token: string | null = null,\n+  options: { method?: string; body?: unknown; signal?: AbortSignal } = {},\n+): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      headers: {\n+        ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+      },\n+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n+      signal: options.signal,\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"Couldn’t reach the server. Check your connection and try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => null);\n+  if (!response.ok) {\n+    throw new ApiError(data?.error ?? \"Something went wrong. Please try again.\", response.status, data?.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function errorMessage(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n+\n+export function todayISO() {\n+  const date = new Date();\n+  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, \"0\")}-${String(date.getDate()).padStart(2, \"0\")}`;\n+}\n+\n+export function formatDue(value: string) {\n+  if (value === todayISO()) return \"Today\";\n+  const tomorrow = new Date();\n+  tomorrow.setDate(tomorrow.getDate() + 1);\n+  const date = new Date(`${value}T12:00:00`);\n+  if (date.toDateString() === tomorrow.toDateString()) return \"Tomorrow\";\n+  return date.toLocaleDateString(undefined, {\n+    month: \"short\", day: \"numeric\",\n+    ...(date.getFullYear() !== new Date().getFullYear() ? { year: \"numeric\" } : {}),\n+  });\n+}\n","additions":82,"deletions":0},{"filePath":"/workspace/frontend/src/components/Icon.tsx","relativePath":"frontend/src/components/Icon.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Icon.tsx\n===================================================================\n--- /workspace/frontend/src/components/Icon.tsx\n+++ /workspace/frontend/src/components/Icon.tsx\n@@ -0,0 +1,34 @@\n+const paths = {\n+  list: \"M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01\",\n+  check: \"m5 12 4 4L19 6\",\n+  circleCheck: \"m8 12 3 3 5-6M21 12a9 9 0 1 1-5-8\",\n+  circle: \"M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0\",\n+  plus: \"M12 5v14M5 12h14\",\n+  calendar: \"M8 3v4m8-4v4M4 10h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 9h2m4 0h2m-8 3h2\",\n+  sun: \"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0\",\n+  logout: \"M9 5H4v14h5m5-14 5 7-5 7m-6-7h11\",\n+  pencil: \"m15 5 4 4M4 20l4-1 12-12a2.8 2.8 0 0 0-4-4L4 15v5Z\",\n+  trash: \"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7\",\n+  chevron: \"m9 5 7 7-7 7\",\n+  chevronDown: \"m6 9 6 6 6-6\",\n+  arrow: \"M5 12h14m-6-6 6 6-6 6\",\n+  leaf: \"M5 19C0 6 10 3 21 3c0 11-3 21-16 16Zm-2 2L15 9\",\n+  lock: \"M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5V10Zm7 4v3\",\n+  eye: \"M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Zm13 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0\",\n+  eyeOff: \"m3 3 18 18M10 5c8-2 12 7 12 7a19 19 0 0 1-4 5M6 6a20 20 0 0 0-4 6s3 7 10 7a13 13 0 0 0 5-1M10 10a3 3 0 0 0 4 4\",\n+  clock: \"M12 8v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0\",\n+  x: \"m6 6 12 12M6 18 18 6\",\n+  menu: \"M4 6h16M4 12h16M4 18h16\",\n+  sparkles: \"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Zm8-1v4m-2-2h4\",\n+  flag: \"M5 21V3m0 1c5-4 9 4 14 0v10c-5 4-9-4-14 0\",\n+} as const;\n+\n+export type IconName = keyof typeof paths;\n+\n+export default function Icon({ name, className = \"size-5\" }: { name: IconName; className?: string }) {\n+  return (\n+    <svg className={className} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.7\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+      <path d={paths[name]} />\n+    </svg>\n+  );\n+}\n","additions":34,"deletions":0},{"filePath":"/workspace/frontend/src/components/Brand.tsx","relativePath":"frontend/src/components/Brand.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Brand.tsx\n===================================================================\n--- /workspace/frontend/src/components/Brand.tsx\n+++ /workspace/frontend/src/components/Brand.tsx\n@@ -0,0 +1,12 @@\n+export default function Brand() {\n+  return (\n+    <div className=\"flex items-center gap-2.5\" aria-label=\"Tidy\">\n+      <span className=\"flex size-9 items-center justify-center rounded-xl bg-leaf text-white\">\n+        <svg viewBox=\"0 0 40 40\" className=\"size-8\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n+          <path d=\"M11 12h18M11 20h9m-9 8h9m2-5 3 3 6-7\" />\n+        </svg>\n+      </span>\n+      <span className=\"text-[27px] font-semibold tracking-[-1.5px]\">tidy<span className=\"text-leaf\">.</span></span>\n+    </div>\n+  );\n+}\n","additions":12,"deletions":0},{"filePath":"/workspace/frontend/src/components/Auth.tsx","relativePath":"frontend/src/components/Auth.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Auth.tsx\n===================================================================\n--- /workspace/frontend/src/components/Auth.tsx\n+++ /workspace/frontend/src/components/Auth.tsx\n@@ -0,0 +1,113 @@\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, ApiError, errorMessage } from \"../api\";\n+import type { FieldErrors } from \"../api\";\n+import Brand from \"./Brand\";\n+import Icon from \"./Icon\";\n+\n+export default function Auth({ onSignIn }: { onSignIn: (token: string) => void }) {\n+  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [showPassword, setShowPassword] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<FieldErrors>({});\n+  const register = mode === \"register\";\n+\n+  function changeMode(next: \"login\" | \"register\") {\n+    setMode(next);\n+    setError(\"\");\n+    setFields({});\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    let created = false;\n+    try {\n+      const body = { username, password };\n+      if (register) {\n+        await api(\"/auth/register\", null, { method: \"POST\", body });\n+        created = true;\n+      }\n+      const { token } = await api<{ token: string }>(\"/auth/login\", null, { method: \"POST\", body });\n+      onSignIn(token);\n+    } catch (error) {\n+      if (created) setMode(\"login\");\n+      setError(created ? `Your account was created. ${errorMessage(error)}` : errorMessage(error));\n+      if (error instanceof ApiError) setFields(error.fields);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  const inputClass = \"mt-2 w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm transition placeholder:text-[#a1a69e] focus:border-leaf focus:ring-2 focus:ring-leaf/10 disabled:opacity-60\";\n+\n+  return (\n+    <div className=\"relative flex min-h-screen flex-col overflow-hidden\">\n+      <header className=\"mx-auto flex w-full max-w-[1280px] items-center justify-between px-6 py-7 sm:px-12\">\n+        <Brand />\n+        <span className=\"hidden items-center gap-2 text-xs text-muted sm:flex\"><Icon name=\"leaf\" className=\"size-4 text-leaf\" /> A little more headspace.</span>\n+      </header>\n+      <main className=\"mx-auto grid w-full max-w-[1100px] flex-1 items-center gap-12 px-6 py-12 md:grid-cols-[1.15fr_1fr] md:gap-16 md:py-16\">\n+        <section className=\"relative\">\n+          <div className=\"mb-6 inline-flex items-center gap-2 rounded-full border border-[#dce8d6] bg-mint px-3.5 py-1.5 text-[11px] font-semibold tracking-[1.5px] text-leaf\"><Icon name=\"sun\" className=\"size-3.5\" /> YOUR DAY, A LITTLE LIGHTER</div>\n+          <h1 className=\"text-[44px] leading-[1.13] font-semibold tracking-[-2.3px] sm:text-[58px]\">Less on your mind.<br />More in your <span className=\"text-leaf\">day.</span></h1>\n+          <p className=\"mt-6 max-w-[390px] text-[15px] leading-7 text-muted\">A simple home for everything you need to do. Find your focus, take it one task at a time, and enjoy a little more breathing room.</p>\n+          <div className=\"mt-9 space-y-4\">\n+            {[\n+              { icon: \"lock\" as const, title: \"Just for you\", text: \"Your tasks. Your own private space.\" },\n+              { icon: \"flag\" as const, title: \"Focus on what matters\", text: \"Clear priorities, without the clutter.\" },\n+              { icon: \"circleCheck\" as const, title: \"Small steps, real progress\", text: \"Every checkmark is a little win.\" },\n+            ].map((feature) => (\n+              <div key={feature.title} className=\"flex items-center gap-3.5\">\n+                <span className=\"flex size-10 shrink-0 items-center justify-center rounded-xl border border-[#e0e8db] bg-mint text-leaf\"><Icon name={feature.icon} className=\"size-[18px]\" /></span>\n+                <div><h2 className=\"text-[13px] font-semibold\">{feature.title}</h2><p className=\"mt-0.5 text-xs text-muted\">{feature.text}</p></div>\n+              </div>\n+            ))}\n+          </div>\n+          <div className=\"mt-10 flex items-center gap-3 text-xs text-muted\"><span className=\"h-px w-8 bg-[#ccd8c5]\" /> Less busy. More intentional.</div>\n+        </section>\n+        <section className=\"rounded-2xl border border-line bg-white p-6 shadow-[0_12px_60px_-20px_rgba(40,65,40,0.13)] sm:p-9\">\n+          <div className=\"mb-8 flex rounded-lg bg-[#f3f5f0] p-1\" aria-label=\"Account options\">\n+            {([\"login\", \"register\"] as const).map((value) => (\n+              <button key={value} disabled={busy} onClick={() => changeMode(value)} aria-pressed={mode === value} className={`flex-1 rounded-md py-2.5 text-xs font-semibold transition ${mode === value ? \"bg-white text-ink shadow-sm\" : \"text-muted hover:text-ink\"}`}>\n+                {value === \"login\" ? \"Sign in\" : \"Create account\"}\n+              </button>\n+            ))}\n+          </div>\n+          <span className=\"mb-4 flex size-11 items-center justify-center rounded-xl bg-mint text-leaf\"><Icon name={register ? \"sparkles\" : \"leaf\"} className=\"size-5\" /></span>\n+          <h2 className=\"text-2xl font-semibold tracking-[-0.8px]\">{register ? \"A fresh start awaits.\" : \"Welcome back.\"}</h2>\n+          <p className=\"mt-2 text-sm text-muted\">{register ? \"Make a little space for what matters.\" : \"Let’s make a little room for a good day.\"}</p>\n+          <form className=\"mt-7 space-y-5\" onSubmit={submit} noValidate>\n+            <div>\n+              <label htmlFor=\"username\" className=\"text-xs font-semibold\">Username</label>\n+              <input id=\"username\" name=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} placeholder=\"Your username\" className={inputClass} disabled={busy} aria-invalid={!!fields.username} aria-describedby={fields.username ? \"username-error\" : undefined} />\n+              {fields.username && <p id=\"username-error\" className=\"mt-1.5 text-xs text-red-600\">{fields.username}</p>}\n+            </div>\n+            <div>\n+              <label htmlFor=\"password\" className=\"text-xs font-semibold\">Password</label>\n+              <div className=\"relative\">\n+                <input id=\"password\" name=\"password\" type={showPassword ? \"text\" : \"password\"} autoComplete={register ? \"new-password\" : \"current-password\"} value={password} onChange={(event) => setPassword(event.target.value)} placeholder={register ? \"At least 8 characters\" : \"Your password\"} className={`${inputClass} pr-11`} disabled={busy} aria-invalid={!!fields.password} aria-describedby={fields.password ? \"password-error\" : undefined} />\n+                <button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute inset-y-0 right-2 mt-2 flex w-8 items-center justify-center rounded text-muted hover:text-ink\"><Icon name={showPassword ? \"eyeOff\" : \"eye\"} className=\"size-[18px]\" /></button>\n+              </div>\n+              {fields.password && <p id=\"password-error\" className=\"mt-1.5 text-xs text-red-600\">{fields.password}</p>}\n+              {register && !fields.password && <p className=\"mt-2 text-[11px] text-muted\">8–128 characters. Make it uniquely yours.</p>}\n+            </div>\n+            {error && <p role=\"alert\" className=\"rounded-lg border border-red-100 bg-red-50 p-3 text-xs leading-5 text-red-700\">{error}</p>}\n+            <button disabled={busy} className=\"flex w-full items-center justify-center gap-2 rounded-lg bg-leaf py-3.5 text-sm font-medium text-white transition hover:bg-[#2f6848] disabled:opacity-60\">{busy ? \"Just a moment…\" : register ? \"Create your account\" : \"Sign in to your space\"}{!busy && <Icon name=\"arrow\" className=\"size-4\" />}</button>\n+          </form>\n+          <div className=\"mt-7 border-t border-line pt-5 text-center text-xs text-muted\">\n+            {register ? \"Already have a little space here? \" : \"New here? \"}\n+            <button disabled={busy} onClick={() => changeMode(register ? \"login\" : \"register\")} className=\"font-semibold text-leaf hover:underline\">{register ? \"Sign in\" : \"Create an account\"}</button>\n+          </div>\n+          <div className=\"mt-5 flex items-center justify-center gap-1.5 text-[10px] text-muted\"><Icon name=\"lock\" className=\"size-3\" /> Your list is private. Always.</div>\n+        </section>\n+      </main>\n+      <footer className=\"px-6 py-6 text-center text-[11px] text-muted\">Made for a little less chaos, and a little more you.</footer>\n+    </div>\n+  );\n+}\n","additions":113,"deletions":0},{"filePath":"/workspace/frontend/src/components/TodoForm.tsx","relativePath":"frontend/src/components/TodoForm.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/TodoForm.tsx\n===================================================================\n--- /workspace/frontend/src/components/TodoForm.tsx\n+++ /workspace/frontend/src/components/TodoForm.tsx\n@@ -0,0 +1,63 @@\n+import { useId, useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { ApiError, errorMessage } from \"../api\";\n+import type { FieldErrors, Priority, Todo, TodoValues } from \"../api\";\n+import Icon from \"./Icon\";\n+\n+export default function TodoForm({ todo, onSave, onCancel }: {\n+  todo?: Todo;\n+  onSave: (values: TodoValues) => Promise<void>;\n+  onCancel: () => void;\n+}) {\n+  const id = useId();\n+  const [title, setTitle] = useState(todo?.title ?? \"\");\n+  const [description, setDescription] = useState(todo?.description ?? \"\");\n+  const [priority, setPriority] = useState<Priority>(todo?.priority ?? \"medium\");\n+  const [dueDate, setDueDate] = useState(todo?.due_date ?? \"\");\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [fields, setFields] = useState<FieldErrors>({});\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setError(\"\");\n+    setFields({});\n+    try {\n+      await onSave({ title, description, priority, due_date: dueDate || null });\n+    } catch (error) {\n+      setError(errorMessage(error));\n+      if (error instanceof ApiError) setFields(error.fields);\n+      setBusy(false);\n+    }\n+  }\n+\n+  const inputClass = \"mt-1.5 w-full rounded-lg border border-[#dde4d8] bg-white px-3 py-2.5 text-sm focus:border-leaf focus:ring-2 focus:ring-leaf/10 placeholder:text-[#a1a69e] disabled:opacity-60\";\n+  function fieldError(field: string) {\n+    return fields[field] ? <p id={`${id}-${field}-error`} className=\"mt-1.5 text-xs text-red-600\">{fields[field]}</p> : null;\n+  }\n+\n+  return (\n+    <form onSubmit={submit} noValidate className=\"rounded-xl border border-[#dce6d6] bg-[#f7faf4] p-5 sm:p-6\">\n+      <div className=\"mb-5 flex items-center justify-between\"><h3 className=\"flex items-center gap-2 text-sm font-semibold\"><Icon name={todo ? \"pencil\" : \"plus\"} className=\"size-4 text-leaf\" />{todo ? \"Edit task\" : \"A new little to-do\"}</h3><button type=\"button\" onClick={onCancel} disabled={busy} aria-label=\"Close task form\" className=\"rounded-md p-1 text-muted hover:bg-mint\"><Icon name=\"x\" className=\"size-4\" /></button></div>\n+      <fieldset disabled={busy} className=\"space-y-4\">\n+        <div>\n+          <label htmlFor={`${id}-title`} className=\"text-xs font-medium\">Task title <span className=\"text-leaf\">*</span></label>\n+          <input autoFocus id={`${id}-title`} name=\"title\" value={title} onChange={(event) => setTitle(event.target.value)} placeholder=\"What would you like to get done?\" className={inputClass} aria-invalid={!!fields.title} aria-describedby={fields.title ? `${id}-title-error` : undefined} />\n+          {fieldError(\"title\")}\n+        </div>\n+        <div>\n+          <label htmlFor={`${id}-description`} className=\"text-xs font-medium\">Description <span className=\"font-normal text-muted\">(optional)</span></label>\n+          <textarea id={`${id}-description`} name=\"description\" rows={2} value={description} onChange={(event) => setDescription(event.target.value)} placeholder=\"A few details, a helpful reminder…\" className={`${inputClass} resize-y`} aria-invalid={!!fields.description} aria-describedby={fields.description ? `${id}-description-error` : undefined} />\n+          {fieldError(\"description\")}\n+        </div>\n+        <div className=\"grid gap-4 sm:grid-cols-2\">\n+          <div><label htmlFor={`${id}-priority`} className=\"text-xs font-medium\">Priority</label><select id={`${id}-priority`} value={priority} onChange={(event) => setPriority(event.target.value as Priority)} className={inputClass} aria-invalid={!!fields.priority} aria-describedby={fields.priority ? `${id}-priority-error` : undefined}><option value=\"low\">Low priority</option><option value=\"medium\">Medium priority</option><option value=\"high\">High priority</option></select>{fieldError(\"priority\")}</div>\n+          <div><label htmlFor={`${id}-due_date`} className=\"text-xs font-medium\">Due date <span className=\"font-normal text-muted\">(optional)</span></label><input id={`${id}-due_date`} type=\"date\" value={dueDate} onChange={(event) => setDueDate(event.target.value)} className={inputClass} aria-invalid={!!fields.due_date} aria-describedby={fields.due_date ? `${id}-due_date-error` : undefined} />{fieldError(\"due_date\")}</div>\n+        </div>\n+      </fieldset>\n+      {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-xs text-red-700\">{error}</p>}\n+      <div className=\"mt-5 flex items-center justify-end gap-3\"><button type=\"button\" onClick={onCancel} disabled={busy} className=\"rounded-lg px-4 py-2.5 text-xs font-medium text-muted transition hover:bg-mint\">Cancel</button><button disabled={busy} className=\"flex items-center gap-2 rounded-lg bg-leaf px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-[#2f6848] disabled:opacity-60\"><Icon name={todo ? \"check\" : \"plus\"} className=\"size-4\" />{busy ? \"Saving…\" : todo ? \"Save changes\" : \"Add task\"}</button></div>\n+    </form>\n+  );\n+}\n","additions":63,"deletions":0},{"filePath":"/workspace/frontend/src/components/DeleteDialog.tsx","relativePath":"frontend/src/components/DeleteDialog.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/DeleteDialog.tsx\n===================================================================\n--- /workspace/frontend/src/components/DeleteDialog.tsx\n+++ /workspace/frontend/src/components/DeleteDialog.tsx\n@@ -0,0 +1,40 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { errorMessage } from \"../api\";\n+import type { Todo } from \"../api\";\n+import Icon from \"./Icon\";\n+\n+export default function DeleteDialog({ todo, onDelete, onCancel }: {\n+  todo: Todo;\n+  onDelete: () => Promise<void>;\n+  onCancel: () => void;\n+}) {\n+  const dialog = useRef<HTMLDialogElement>(null);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  useEffect(() => {\n+    const element = dialog.current;\n+    element?.showModal();\n+    return () => element?.close();\n+  }, []);\n+\n+  async function remove() {\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      await onDelete();\n+    } catch (error) {\n+      setError(errorMessage(error));\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <dialog ref={dialog} onCancel={(event) => { event.preventDefault(); if (!busy) onCancel(); }} aria-labelledby=\"delete-title\" aria-describedby=\"delete-description\" className=\"fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-line bg-white p-7 text-ink shadow-xl backdrop:bg-ink/30 backdrop:backdrop-blur-[3px]\">\n+      <span className=\"mb-5 flex size-11 items-center justify-center rounded-xl bg-red-50 text-red-500\"><Icon name=\"trash\" className=\"size-5\" /></span>\n+      <h2 id=\"delete-title\" className=\"text-xl font-semibold tracking-tight\">Delete this task?</h2>\n+      <p id=\"delete-description\" className=\"mt-3 text-sm leading-6 text-muted\">“<span className=\"break-words font-medium text-ink\">{todo.title}</span>” will be permanently deleted. This can’t be undone.</p>\n+      {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-xs text-red-700\">{error}</p>}\n+      <div className=\"mt-7 flex justify-end gap-3\"><button autoFocus disabled={busy} onClick={onCancel} className=\"rounded-lg border border-line px-4 py-2.5 text-xs font-medium hover:bg-paper\">Keep task</button><button disabled={busy} onClick={remove} className=\"rounded-lg bg-red-600 px-4 py-2.5 text-xs font-medium text-white hover:bg-red-700 disabled:opacity-60\">{busy ? \"Deleting…\" : \"Delete task\"}</button></div>\n+    </dialog>\n+  );\n+}\n","additions":40,"deletions":0},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"delete","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n","additions":0,"deletions":4},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"add","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,271 @@\n+import { useCallback, useEffect, useState } from \"react\";\n+import { api, ApiError, errorMessage, formatDue, todayISO } from \"./api\";\n+import type { Priority, Todo, TodoPage, TodoValues, User } from \"./api\";\n+import Auth from \"./components/Auth\";\n+import Brand from \"./components/Brand\";\n+import DeleteDialog from \"./components/DeleteDialog\";\n+import Icon from \"./components/Icon\";\n+import type { IconName } from \"./components/Icon\";\n+import TodoForm from \"./components/TodoForm\";\n+\n+type Tab = \"all\" | \"open\" | \"completed\";\n+const tabs: { value: Tab; label: string; icon: IconName }[] = [\n+  { value: \"all\", label: \"All tasks\", icon: \"list\" },\n+  { value: \"open\", label: \"Open\", icon: \"circle\" },\n+  { value: \"completed\", label: \"Completed\", icon: \"circleCheck\" },\n+];\n+\n+function storedToken() {\n+  try { return localStorage.getItem(\"tidy-token\"); } catch { return null; }\n+}\n+\n+export default function App() {\n+  const [token, setToken] = useState<string | null>(storedToken);\n+  const [identity, setIdentity] = useState<{ token: string; user: User } | null>(null);\n+  const [sessionError, setSessionError] = useState(\"\");\n+  const [retry, setRetry] = useState(0);\n+\n+  const signIn = useCallback((next: string) => {\n+    try { localStorage.setItem(\"tidy-token\", next); } catch { /* empty */ }\n+    setToken(next);\n+    setSessionError(\"\");\n+  }, []);\n+\n+  const clearSession = useCallback(() => {\n+    try { localStorage.removeItem(\"tidy-token\"); } catch { /* empty */ }\n+    setToken(null);\n+    setIdentity(null);\n+    setSessionError(\"\");\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<User>(\"/auth/me\", token, { signal: controller.signal })\n+      .then((user) => { setIdentity({ token, user }); setSessionError(\"\"); })\n+      .catch((error) => {\n+        if (controller.signal.aborted) return;\n+        if (error instanceof ApiError && error.status === 401) clearSession();\n+        else setSessionError(errorMessage(error));\n+      });\n+    return () => controller.abort();\n+  }, [token, retry, clearSession]);\n+\n+  if (!token) return <Auth onSignIn={signIn} />;\n+  if (!identity || identity.token !== token) {\n+    return <div className=\"flex min-h-screen flex-col items-center justify-center gap-5 px-6\"><Brand />{sessionError ? <><p role=\"alert\" className=\"max-w-sm text-center text-sm text-muted\">{sessionError}</p><div className=\"flex gap-3\"><button onClick={() => { setSessionError(\"\"); setRetry(retry + 1); }} className=\"rounded-lg bg-leaf px-4 py-2 text-sm text-white\">Try again</button><button onClick={clearSession} className=\"rounded-lg border border-line px-4 py-2 text-sm\">Back to sign in</button></div></> : <p role=\"status\" className=\"text-sm text-muted\">Opening your little space…</p>}</div>;\n+  }\n+  return <Workspace key={token} token={token} user={identity.user} onExpired={clearSession} />;\n+}\n+\n+function Workspace({ token, user, onExpired }: { token: string; user: User; onExpired: () => void }) {\n+  const [tab, setTab] = useState<Tab>(\"all\");\n+  const [priority, setPriority] = useState<Priority | \"\">(\"\");\n+  const [pages, setPages] = useState(1);\n+  const [revision, setRevision] = useState(0);\n+  const [todos, setTodos] = useState<Todo[]>([]);\n+  const [stats, setStats] = useState({ total: 0, open: 0 });\n+  const [matching, setMatching] = useState(0);\n+  const [remaining, setRemaining] = useState(0);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [adding, setAdding] = useState(false);\n+  const [editing, setEditing] = useState<number | null>(null);\n+  const [deleting, setDeleting] = useState<Todo | null>(null);\n+  const [pending, setPending] = useState<number | null>(null);\n+  const [mobileMenu, setMobileMenu] = useState(false);\n+  const [signingOut, setSigningOut] = useState(false);\n+  const [notice, setNotice] = useState(\"\");\n+  const [today, setToday] = useState(todayISO);\n+\n+  useEffect(() => {\n+    const interval = window.setInterval(() => setToday(todayISO()), 60000);\n+    return () => window.clearInterval(interval);\n+  }, []);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timer = window.setTimeout(() => setNotice(\"\"), 4000);\n+    return () => window.clearTimeout(timer);\n+  }, [notice]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    const query = new URLSearchParams({ page_size: \"10\" });\n+    if (tab !== \"all\") query.set(\"completed\", String(tab === \"completed\"));\n+    if (priority) query.set(\"priority\", priority);\n+    async function load() {\n+      setLoading(true);\n+      setError(\"\");\n+      try {\n+        const [results, all, open] = await Promise.all([\n+          Promise.all(Array.from({ length: pages }, (_, index) => api<TodoPage>(`/todos?${query}&page=${index + 1}`, token, { signal: controller.signal }))),\n+          api<TodoPage>(\"/todos?page_size=1\", token, { signal: controller.signal }),\n+          api<TodoPage>(\"/todos?completed=false&page_size=1\", token, { signal: controller.signal }),\n+        ]);\n+        if (controller.signal.aborted) return;\n+        const unique = new Map(results.flatMap((result) => result.items).map((todo) => [todo.id, todo]));\n+        setTodos([...unique.values()]);\n+        setMatching(results[0].total);\n+        setRemaining(results[results.length - 1].remaining);\n+        setStats({ total: all.total, open: open.total });\n+      } catch (error) {\n+        if (controller.signal.aborted) return;\n+        if (error instanceof ApiError && error.status === 401) onExpired();\n+        else setError(errorMessage(error));\n+      } finally {\n+        if (!controller.signal.aborted) setLoading(false);\n+      }\n+    }\n+    void load();\n+    return () => controller.abort();\n+  }, [token, tab, priority, pages, revision, onExpired]);\n+\n+  function selectTab(next: Tab) {\n+    setTab(next);\n+    setPages(1);\n+    setTodos([]);\n+    setLoading(true);\n+    setEditing(null);\n+    setMobileMenu(false);\n+  }\n+\n+  function beginAdd() {\n+    setAdding(true);\n+    setEditing(null);\n+    setMobileMenu(false);\n+    window.setTimeout(() => document.getElementById(\"add-task\")?.scrollIntoView({ behavior: \"smooth\", block: \"center\" }), 50);\n+  }\n+\n+  async function mutate<T>(path: string, method: string, body?: unknown) {\n+    try {\n+      return await api<T>(path, token, { method, body });\n+    } catch (error) {\n+      if (error instanceof ApiError && error.status === 401) onExpired();\n+      throw error;\n+    }\n+  }\n+\n+  async function save(values: TodoValues, todo?: Todo) {\n+    await mutate(todo ? `/todos/${todo.id}` : \"/todos\", todo ? \"PATCH\" : \"POST\", values);\n+    setAdding(false);\n+    setEditing(null);\n+    setRevision((value) => value + 1);\n+    setNotice(todo ? \"A little update, all saved.\" : \"Your new task is on the list.\");\n+  }\n+\n+  async function toggle(todo: Todo) {\n+    setPending(todo.id);\n+    setError(\"\");\n+    try {\n+      await mutate(`/todos/${todo.id}`, \"PATCH\", { completed: !todo.completed });\n+      setRevision((value) => value + 1);\n+      setNotice(todo.completed ? \"Task reopened. Take it at your own pace.\" : \"One less thing. Nicely done!\");\n+    } catch (error) {\n+      setError(errorMessage(error));\n+    } finally {\n+      setPending(null);\n+    }\n+  }\n+\n+  async function remove() {\n+    if (!deleting) return;\n+    await mutate(`/todos/${deleting.id}`, \"DELETE\");\n+    setDeleting(null);\n+    setRevision((value) => value + 1);\n+    setNotice(\"Task deleted. A little less clutter.\");\n+  }\n+\n+  async function signOut() {\n+    setSigningOut(true);\n+    try { await api(\"/auth/logout\", token, { method: \"POST\" }); }\n+    finally { onExpired(); }\n+  }\n+\n+  const counts = { all: stats.total, open: stats.open, completed: stats.total - stats.open };\n+  const progress = stats.total ? Math.round((counts.completed / stats.total) * 100) : 0;\n+  const date = new Date(`${today}T12:00:00`).toLocaleDateString(undefined, { weekday: \"long\", month: \"short\", day: \"numeric\" });\n+\n+  return (\n+    <div className=\"min-h-screen lg:grid lg:grid-cols-[232px_minmax(0,1fr)]\">\n+      {mobileMenu && <button onClick={() => setMobileMenu(false)} aria-label=\"Close navigation\" className=\"fixed inset-0 z-20 bg-ink/25 backdrop-blur-[2px] lg:hidden\" />}\n+      <aside className={`${mobileMenu ? \"flex\" : \"hidden\"} fixed inset-y-0 left-0 z-30 w-[232px] flex-col border-r border-line bg-[#f5f7f2] lg:sticky lg:top-0 lg:flex lg:h-screen`}>\n+        <div className=\"px-7 pt-9 pb-10\"><Brand /></div>\n+        <div className=\"px-4\">\n+          <p className=\"mb-3 px-3 text-[10px] font-semibold tracking-[1.8px] text-[#949d91]\">YOUR WORKSPACE</p>\n+          <button onClick={() => { selectTab(\"all\"); setPriority(\"\"); }} className=\"flex w-full items-center gap-3 rounded-lg bg-[#e5eddc] px-3 py-3 text-[13px] font-semibold text-[#386044]\"><Icon name=\"list\" className=\"size-[18px]\" />My tasks<Icon name=\"chevron\" className=\"ml-auto size-3.5 text-[#6e8a61]\" /></button>\n+          <p className=\"mt-8 mb-3 px-3 text-[10px] font-semibold tracking-[1.8px] text-[#949d91]\">A LITTLE OVERVIEW</p>\n+          <nav aria-label=\"Task views\" className=\"space-y-1\">\n+            {tabs.map((item) => <button key={item.value} onClick={() => selectTab(item.value)} aria-current={tab === item.value ? \"page\" : undefined} className={`flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-xs transition hover:bg-[#e9eee3] ${tab === item.value ? \"font-medium text-ink\" : \"text-muted\"}`}><Icon name={item.icon} className=\"size-[17px]\" />{item.label}<span className=\"ml-auto rounded-md bg-white/70 px-1.5 py-0.5 text-[10px] text-muted\">{counts[item.value]}</span></button>)}\n+          </nav>\n+        </div>\n+        <div className=\"mx-5 mt-auto mb-6 rounded-xl border border-[#e0e7d8] bg-[#edf2e6] px-4 py-5\">\n+          <Icon name=\"leaf\" className=\"mb-3 size-5 text-[#73915d]\" /><p className=\"text-xs font-semibold\">Progress, not perfection.</p><p className=\"mt-2 text-[11px] leading-5 text-[#858e7b]\">Small steps still move you forward. You’ve got this.</p>\n+        </div>\n+        <div className=\"mx-5 mb-6 flex items-center gap-2.5 border-t border-[#e1e6dc] pt-5\"><span className=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#dfe8d3] text-xs font-semibold text-[#62724e]\">{user.username.slice(0, 1).toUpperCase()}</span><div className=\"min-w-0\"><p className=\"truncate text-xs font-semibold\">{user.username}</p><p className=\"mt-0.5 text-[10px] text-muted\">Your personal space</p></div><span title=\"Private workspace\" className=\"ml-auto text-[#96a28e]\"><Icon name=\"lock\" className=\"size-3.5\" /></span></div>\n+      </aside>\n+      <div className=\"min-w-0\">\n+        <header className=\"flex h-[78px] items-center justify-between gap-3 border-b border-line bg-white/60 px-5 sm:px-9 lg:px-11\">\n+          <div className=\"flex items-center gap-3 text-xs\"><button onClick={() => setMobileMenu(true)} aria-label=\"Open navigation\" className=\"rounded-md p-1.5 text-muted lg:hidden\"><Icon name=\"menu\" /></button><span className=\"hidden text-muted sm:inline\">My workspace</span><Icon name=\"chevron\" className=\"hidden size-3 text-[#a8ada4] sm:block\" /><span className=\"font-medium\">My tasks</span></div>\n+          <div className=\"flex items-center gap-3 sm:gap-5\"><span className=\"hidden items-center gap-2 text-[11px] text-muted md:flex\"><Icon name=\"calendar\" className=\"size-3.5\" />{date}</span><span className=\"hidden h-5 w-px bg-line md:block\" /><span className=\"max-w-24 truncate text-xs text-muted sm:max-w-36\">{user.username}</span><button disabled={signingOut} onClick={() => void signOut().catch(() => undefined)} className=\"flex items-center gap-1.5 rounded-md px-1 py-2 text-[11px] text-muted transition hover:text-ink disabled:opacity-50\"><Icon name=\"logout\" className=\"size-3.5\" />{signingOut ? \"Signing out…\" : \"Sign out\"}</button></div>\n+        </header>\n+        <main className=\"mx-auto max-w-[1190px] px-5 py-8 sm:px-9 sm:py-10 lg:px-11\">\n+          <div className=\"mb-7 flex flex-wrap items-center justify-between gap-5\">\n+            <div><p className=\"mb-2 flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"sun\" className=\"size-3.5 text-[#b39e56]\" />A fresh little perspective</p><h1 className=\"text-[32px] leading-tight font-semibold tracking-[-1.3px]\">My tasks<span className=\"text-leaf\">.</span></h1><p className=\"mt-2 text-[13px] text-muted\">A clear list. A calmer mind. Let’s take it one thing at a time.</p></div>\n+            <button onClick={beginAdd} className=\"flex items-center gap-2 rounded-lg bg-leaf px-4 py-3 text-xs font-semibold text-white shadow-[0_3px_6px_rgba(57,123,86,0.12)] transition hover:bg-[#2f6848]\"><Icon name=\"plus\" className=\"size-4\" />New task</button>\n+          </div>\n+          <section aria-label=\"Your task overview\" className=\"grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4\">\n+            {[\n+              { label: \"Still to do\", count: stats.open, icon: \"circle\" as const, hint: \"A little focus goes a long way\", color: \"bg-[#f4efe0] text-[#a78b46]\", view: \"open\" as Tab },\n+              { label: \"Checked off\", count: counts.completed, icon: \"circleCheck\" as const, hint: \"Every little win counts\", color: \"bg-[#e8f1e5] text-[#6b9259]\", view: \"completed\" as Tab },\n+              { label: \"All your tasks\", count: stats.total, icon: \"list\" as const, hint: \"Everything, in one little place\", color: \"bg-[#efedf6] text-[#9380b0]\", view: \"all\" as Tab },\n+            ].map((stat) => <button key={stat.label} onClick={() => selectTab(stat.view)} className=\"rounded-xl border border-line bg-white p-5 text-left transition hover:border-[#cbd8c3]\"><span className=\"flex items-center justify-between\"><span className=\"text-[11px] font-medium text-muted\">{stat.label}</span><span className={`flex size-8 items-center justify-center rounded-lg ${stat.color}`}><Icon name={stat.icon} className=\"size-[17px]\" /></span></span><span className=\"mt-0.5 block text-[30px] font-semibold tracking-tight\">{stat.count}</span><span className=\"mt-1 block text-[10px] text-muted\">{stat.hint}</span></button>)}\n+          </section>\n+          <section className=\"relative mt-6 flex items-center justify-between overflow-hidden rounded-xl border border-[#dfe9d6] bg-[#edf4e7] px-6 py-6 sm:px-7\">\n+            <div className=\"relative z-10\"><div className=\"mb-2 flex items-center gap-1.5 text-[10px] font-semibold tracking-[1.1px] text-[#7a8d63]\"><Icon name=\"sparkles\" className=\"size-3.5\" /> A GENTLE REMINDER</div><h2 className=\"text-[19px] font-semibold tracking-[-0.5px]\">You don’t have to do it all today.</h2><p className=\"mt-1.5 max-w-[380px] text-xs leading-5 text-[#7f8b74]\">Start with one small thing. The rest will follow.</p></div>\n+            <div aria-hidden=\"true\" className=\"relative mr-5 hidden h-24 w-32 shrink-0 sm:block\"><div className=\"absolute right-0 bottom-0 size-24 rounded-full bg-[#dee9cd]\" /><div className=\"absolute top-0 left-3 flex h-[91px] w-[70px] -rotate-12 flex-col gap-3 rounded-lg border border-[#c6d6b5] bg-[#f9fcf5] p-3.5 shadow-[3px_5px_0_#d5e2c7]\"><div className=\"flex items-center gap-1.5\"><span className=\"flex size-3 items-center justify-center rounded-sm bg-[#87a56b]\"><Icon name=\"check\" className=\"size-2.5 text-white\" /></span><span className=\"h-1 w-6 rounded bg-[#c5d4b6]\" /></div><div className=\"flex items-center gap-1.5\"><span className=\"size-3 rounded-sm border border-[#c2d0b5]\" /><span className=\"h-1 w-6 rounded bg-[#dbe4d0]\" /></div><div className=\"flex items-center gap-1.5\"><span className=\"size-3 rounded-sm border border-[#c2d0b5]\" /><span className=\"h-1 w-4 rounded bg-[#dbe4d0]\" /></div></div><Icon name=\"leaf\" className=\"absolute right-0 bottom-1 size-11 -rotate-12 text-[#7f9c62]\" /><Icon name=\"sparkles\" className=\"absolute -top-2 right-0 size-5 text-[#9ab082]\" /></div>\n+          </section>\n+          {adding && <div id=\"add-task\" className=\"mt-6\"><TodoForm onSave={(values) => save(values)} onCancel={() => setAdding(false)} /></div>}\n+          <section aria-label=\"Task list\" className=\"mt-8 overflow-hidden rounded-xl border border-line bg-white\">\n+            <div className=\"flex flex-wrap items-center justify-between gap-4 border-b border-line px-5 pt-4 sm:px-6\">\n+              <div className=\"flex gap-5 sm:gap-6\" role=\"tablist\" aria-label=\"Filter by completion\">\n+                {tabs.map((item) => <button key={item.value} role=\"tab\" aria-selected={tab === item.value} aria-controls=\"todo-panel\" id={`tab-${item.value}`} onClick={() => selectTab(item.value)} className={`relative flex items-center gap-1.5 border-b-2 pt-1 pb-4 text-xs font-medium transition ${tab === item.value ? \"border-leaf text-leaf\" : \"border-transparent text-muted hover:text-ink\"}`}>{item.value === \"all\" ? \"All\" : item.label}<span className={`rounded-md px-1.5 py-0.5 text-[9px] ${tab === item.value ? \"bg-mint text-leaf\" : \"bg-[#f3f4f1] text-muted\"}`}>{counts[item.value]}</span></button>)}\n+              </div>\n+              <div className=\"relative mb-3\"><Icon name=\"flag\" className=\"pointer-events-none absolute top-2.5 left-2.5 size-3.5 text-muted\" /><select aria-label=\"Filter by priority\" value={priority} onChange={(event) => { setPriority(event.target.value as Priority | \"\"); setPages(1); setTodos([]); setLoading(true); setEditing(null); }} className=\"appearance-none rounded-md border border-line bg-white py-2 pr-8 pl-8 text-[11px] text-muted hover:border-[#cbd8c3]\"><option value=\"\">All priorities</option><option value=\"high\">High priority</option><option value=\"medium\">Medium priority</option><option value=\"low\">Low priority</option></select><Icon name=\"chevronDown\" className=\"pointer-events-none absolute top-2.5 right-2.5 size-3 text-muted\" /></div>\n+            </div>\n+            <div id=\"todo-panel\" role=\"tabpanel\" aria-labelledby={`tab-${tab}`} aria-busy={loading}>\n+              {error && <div role=\"alert\" className=\"mx-5 my-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-red-100 bg-red-50 p-3 text-xs text-red-700\"><span>{error}</span><button onClick={() => setRevision((value) => value + 1)} className=\"shrink-0 font-semibold underline\">Try again</button></div>}\n+              <div className=\"hidden grid-cols-[minmax(0,1fr)_110px_140px_68px] gap-4 border-b border-line bg-[#fafbf8] px-6 py-3 text-[9px] font-medium tracking-[1.1px] text-[#969d90] md:grid\"><span className=\"pl-9\">TASK</span><span>PRIORITY</span><span>DUE DATE</span><span /></div>\n+              {loading && todos.length === 0 ? <div role=\"status\" className=\"space-y-5 px-6 py-9\"><span className=\"sr-only\">Loading your tasks</span>{[1, 2, 3].map((row) => <div key={row} className=\"flex animate-pulse items-center gap-4\"><span className=\"size-5 rounded-md bg-