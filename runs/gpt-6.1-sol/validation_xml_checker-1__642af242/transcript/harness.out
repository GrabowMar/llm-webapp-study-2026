-disable-gpu\"], headless: true });\n-  const page = await browser.newPage({ viewport: { width: 1440, height: 1150 } });\n-  const errors = [];\n-  page.on(\"pageerror\", error => { errors.push(error.message); console.error(\"Browser error:\", error.message); });\n-  page.on(\"dialog\", dialog => dialog.accept());\n-  await page.goto(\"http://127.0.0.1:8000\");\n-  await page.getByRole(\"heading\", { name: \"Good XML starts here.\" }).waitFor();\n-  await page.screenshot({ path: \"/workspace/data/desktop.png\", fullPage: true });\n-  await page.getByRole(\"button\", { name: \"Check XML\" }).click();\n-  await page.getByText(\"Everything is in its place.\").waitFor();\n-  await page.getByLabel(\"Load an example\").selectOption(\"broken\");\n-  await page.getByRole(\"button\", { name: \"Check XML\" }).click();\n-  await page.getByText(\"Line 7, column 5\").waitFor();\n-  assert.equal(await page.locator(\".bg-red-50.shadow-\\\\[inset_3px_0_0_\\\\#ef7777\\\\]\").count(), 1);\n-  await page.locator(\"input[type=file]\").setInputFiles({ name: \"loaded.xml\", mimeType: \"application/xml\", buffer: Buffer.from(\"<loaded>hello</loaded>\") });\n-  assert.equal(await page.getByLabel(\"XML document editor\").inputValue(), \"<loaded>hello</loaded>\");\n-  await page.getByText(\"loaded.xml\", { exact: true }).waitFor();\n-  await page.getByRole(\"button\", { name: \"Get started\" }).click();\n-  const user = `browser_${Date.now()}`;\n-  await page.getByLabel(\"Username\", { exact: true }).fill(user);\n-  await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-password\");\n-  await page.getByRole(\"button\", { name: \"Create account\", exact: true }).click();\n-  await page.getByText(user, { exact: true }).waitFor();\n-  assert.equal(await page.getByRole(\"switch\", { name: \"Save to history\" }).getAttribute(\"aria-checked\"), \"true\");\n-  await page.getByRole(\"button\", { name: \"Check XML\" }).click();\n-  await page.getByText(\"Saved to your private history\").waitFor();\n-  await page.locator(\"#history\").getByText(\"<loaded>\", { exact: true }).waitFor();\n-  await page.getByLabel(\"XML document editor\").fill(\"<broken>\");\n-  await page.getByRole(\"button\", { name: \"Check XML\" }).click();\n-  await page.getByText(\"Saved to your private history\").waitFor();\n-  await page.getByLabel(\"Show\", { exact: true }).selectOption(\"false\");\n-  await page.locator(\"#history tbody tr\").waitFor();\n-  assert.equal(await page.locator(\"#history tbody tr\").count(), 1);\n-  await page.getByRole(\"button\", { name: /Delete saved check/ }).click();\n-  await page.getByText(\"No matching checks yet.\").waitFor();\n-  await page.getByLabel(\"Show\", { exact: true }).selectOption(\"all\");\n-  for (let index = 0; index < 6; index++) {\n-    await page.getByLabel(\"XML document editor\").fill(`<item${index}/>`);\n-    await page.getByRole(\"button\", { name: \"Check XML\" }).click();\n-    await page.getByText(\"Saved to your private history\").waitFor();\n-  }\n-  await page.getByRole(\"button\", { name: \"Next page\", exact: true }).click();\n-  await page.locator(\"#history\").getByText(\"2 / 2\", { exact: true }).waitFor();\n-  await page.waitForFunction(() => document.querySelectorAll(\"#history tbody tr\").length === 2);\n-  assert.equal(await page.locator(\"#history tbody tr\").count(), 2);\n-  await page.getByRole(\"switch\", { name: \"Save to history\" }).click();\n-  await page.getByLabel(\"XML document editor\").fill(\"<notSaved/>\");\n-  await page.getByRole(\"button\", { name: \"Check XML\" }).click();\n-  await page.getByText(\"This check wasn’t stored\").waitFor();\n-  const token = await page.evaluate(() => localStorage.getItem(\"xmlcheck-token\"));\n-  const history = await page.request.get(\"http://127.0.0.1:8000/api/validations\", { headers: { Authorization: `Bearer ${token}` } });\n-  assert.equal((await history.json()).total, 7);\n-  await page.reload();\n-  await page.getByText(user, { exact: true }).waitFor();\n-  await page.locator('button[aria-label=\"Sign out\"]').evaluate(button => button.click());\n-  await page.getByRole(\"button\", { name: \"Get started\" }).waitFor();\n-  await new Promise(resolve => setTimeout(resolve, 150));\n-  assert.equal((await page.request.get(\"http://127.0.0.1:8000/api/validations\", { headers: { Authorization: `Bearer ${token}` } })).status(), 401);\n-  await page.getByRole(\"button\", { name: \"Sign in\", exact: true }).click();\n-  await page.getByLabel(\"Username\", { exact: true }).fill(user);\n-  await page.getByLabel(\"Password\", { exact: true }).fill(\"browser-password\");\n-  await page.getByRole(\"button\", { name: \"Sign in\", exact: true }).last().click();\n-  await page.getByText(user, { exact: true }).waitFor();\n-  await page.setViewportSize({ width: 375, height: 812 });\n-  await page.screenshot({ path: \"/workspace/data/mobile.png\", fullPage: true });\n-  assert(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth), \"Mobile horizontal overflow\");\n-  assert.deepEqual(errors, []);\n-  console.log(\"Browser smoke checks passed: validation, error highlighting, file loading, registration, saving, filtering, deletion, paging, session restoration, sign-out, sign-in, and mobile layout.\");\n-} finally {\n-  if (browser) await browser.close();\n-  server.kill(\"SIGTERM\");\n-}\n\n","files":[{"filePath":"/workspace/frontend/smoke.mjs","relativePath":"frontend/smoke.mjs","type":"delete","patch":"Index: /workspace/frontend/smoke.mjs\n===================================================================\n--- /workspace/frontend/smoke.mjs\n+++ /workspace/frontend/smoke.mjs\n@@ -1,99 +0,0 @@\n-import assert from \"node:assert/strict\";\n-import { spawn } from \"node:child_process\";\n-import chromium, { inflate, setupLambdaEnvironment } from \"@sparticuz/chromium\";\n-import { chromium as playwright } from \"playwright-core\";\n-\n-const server = spawn(\"python3\", [\"-m\", \"gunicorn\", \"--bind\