{"type":"step_start","timestamp":1794319016677,"sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","part":{"id":"prt_1c5bf62e0001moxHlGUrQbaQlp","messageID":"msg_1c5bf401a001aN2rFo8WMw83jk","sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","type":"step-start"}}
{"type":"tool_use","timestamp":1794319129682,"sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","part":{"type":"tool","tool":"apply_patch","callID":"call_1V2mGx9a3vxMAXGNkpTEwpem","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Add File: /workspace/frontend/src/CustomerDetail.tsx\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { Link, useNavigate, useOutletContext, useParams } from \"react-router-dom\";\n+import { ArrowLeft, Building2, CalendarDays, Clock3, FileText, LoaderCircle, Mail, MessageSquare, Pencil, Phone, Plus, ShieldCheck, Trash2, Users, Video } from \"lucide-react\";\n+import { api, ApiError, date, initials, message, type Customer, type Interaction } from \"./api\";\n+import { CustomerForm } from \"./CustomerForm\";\n+import type { LayoutContext } from \"./Layout\";\n+import { Alert, Field, inputClass, Modal, primaryButton, secondaryButton, Spinner } from \"./ui\";\n+\n+const kinds = {\n+  call: { label: \"Call\", icon: Phone, color: \"bg-brand-50 text-brand-600\" },\n+  email: { label: \"Email\", icon: Mail, color: \"bg-[#ecf2fa] text-[#6a8cba]\" },\n+  meeting: { label: \"Meeting\", icon: Video, color: \"bg-[#f1eef8] text-[#8b79b4]\" },\n+};\n+\n+function localDateTime() {\n+  const now = new Date();\n+  return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);\n+}\n+\n+function InteractionForm({ customerId, onSaved }: { customerId: number; onSaved: () => void }) {\n+  const [kind, setKind] = useState<Interaction[\"kind\"]>(\"call\");\n+  const [summary, setSummary] = useState(\"\");\n+  const [occurredAt, setOccurredAt] = useState(localDateTime);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({});\n+    try {\n+      const parsedDate = new Date(occurredAt);\n+      await api(`/customers/${customerId}/interactions`, {\n+        method: \"POST\",\n+        body: JSON.stringify({ kind, summary, occurred_at: Number.isNaN(parsedDate.getTime()) ? \"\" : parsedDate.toISOString() }),\n+      });\n+      setSummary(\"\"); setOccurredAt(localDateTime()); onSaved();\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  return <section className=\"rounded-xl border border-slate-200/80 bg-white\"><div className=\"border-b border-slate-100 px-5 py-4\"><h2 className=\"flex items-center gap-2 text-sm font-semibold\"><Plus size={16} className=\"text-brand-600\" />Log an interaction</h2><p className=\"mt-1.5 text-xs text-slate-400\">A quick note now. Helpful context later.</p></div><form onSubmit={submit} noValidate className=\"space-y-5 p-5\">\n+    {error && <Alert>{error}</Alert>}\n+    <fieldset><legend className=\"mb-2 text-xs font-medium text-slate-600\">Interaction type</legend><div className=\"grid grid-cols-3 gap-2\">{Object.entries(kinds).map(([key, { label, icon: Icon }]) => <label key={key} className={`flex cursor-pointer items-center justify-center gap-1.5 rounded-lg border px-2 py-2.5 text-xs transition ${kind === key ? \"border-brand-200 bg-brand-50 font-medium text-brand-700\" : \"border-slate-200 text-slate-500 hover:bg-slate-50\"}`}><input type=\"radio\" name=\"kind\" value={key} checked={kind === key} onChange={() => setKind(key as Interaction[\"kind\"])} disabled={busy} className=\"sr-only\" /><Icon size={14} /><span>{label}</span></label>)}</div>{errors.kind && <p role=\"alert\" className=\"mt-1 text-xs text-red-600\">{errors.kind}</p>}</fieldset>\n+    <Field id=\"interaction-summary\" label=\"What did you talk about?\" required error={errors.summary}><textarea id=\"interaction-summary\" rows={5} placeholder=\"A follow-up, an introduction, a useful detail…\" value={summary} onChange={(event) => setSummary(event.target.value)} disabled={busy} className={`${inputClass} resize-y text-xs leading-6`} aria-invalid={!!errors.summary} aria-describedby={errors.summary ? \"interaction-summary-error\" : undefined} /></Field>\n+    <Field id=\"interaction-date\" label=\"When did it happen?\" required error={errors.occurred_at} hint=\"Date and time in your local timezone.\"><input id=\"interaction-date\" type=\"datetime-local\" value={occurredAt} onChange={(event) => setOccurredAt(event.target.value)} disabled={busy} className={`${inputClass} text-xs`} aria-invalid={!!errors.occurred_at} aria-describedby={errors.occurred_at ? \"interaction-date-error\" : undefined} /></Field>\n+    <button disabled={busy} className={`${primaryButton} w-full`}>{busy ? <LoaderCircle size={15} className=\"animate-spin\" /> : <Plus size={15} />}{busy ? \"Logging…\" : \"Log interaction\"}</button>\n+    <p className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400\"><ShieldCheck size={12} />Logged as you. Visible to the whole team.</p>\n+  </form></section>;\n+}\n+\n+export function CustomerDetail() {\n+  const { id } = useParams();\n+  const navigate = useNavigate();\n+  const { notify } = useOutletContext<LayoutContext>();\n+  const [customer, setCustomer] = useState<Customer | null>(null);\n+  const [interactions, setInteractions] = useState<Interaction[]>([]);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [edit, setEdit] = useState(false);\n+  const [remove, setRemove] = useState(false);\n+  const [deleting, setDeleting] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+  useEffect(() => {\n+    let active = true;\n+    setError(\"\");\n+    Promise.all([api<Customer>(`/customers/${id}`), api<{ items: Interaction[] }>(`/customers/${id}/interactions`)]).then(([data, log]) => {\n+      if (active) { setCustomer(data); setInteractions(log.items); }\n+    }).catch((err) => { if (active) setError(message(err)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [id, revision]);\n+  async function deleteCustomer() {\n+    setDeleting(true); setDeleteError(\"\");\n+    try { await api(`/customers/${id}`, { method: \"DELETE\" }); notify(\"Customer and interaction history deleted.\"); navigate(\"/customers\"); }\n+    catch (err) { setDeleteError(message(err)); }\n+    finally { setDeleting(false); }\n+  }\n+  if (loading) return <Spinner label=\"Opening this customer’s profile…\" />;\n+  if (error || !customer) return <div className=\"space-y-5\"><Link to=\"/customers\" className=\"inline-flex items-center gap-2 text-sm text-slate-500\"><ArrowLeft size={15} />Back to customers</Link><Alert>{error || \"Customer not found.\"}</Alert><button onClick={() => { setLoading(true); setRevision(revision + 1); }} className={secondaryButton}>Try again</button></div>;\n+  return <>\n+    <Link to=\"/customers\" className=\"mb-7 inline-flex items-center gap-1.5 text-xs text-slate-500 transition hover:text-brand-700\"><ArrowLeft size={14} />Back to customers</Link>\n+    <div className=\"mb-8 flex flex-wrap items-center justify-between gap-5\"><div className=\"flex min-w-0 items-center gap-4\"><span className=\"flex size-16 shrink-0 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 text-xl font-medium text-brand-700\">{initials(customer.name)}</span><div className=\"min-w-0\"><p className=\"mb-1 text-[10px] font-semibold tracking-[1.5px] text-brand-600\">CUSTOMER PROFILE</p><h1 className=\"break-words text-[28px] font-semibold tracking-[-0.8px]\">{customer.name}</h1><p className=\"mt-1 flex items-center gap-1.5 text-xs text-slate-400\"><Building2 size={13} />{customer.company || \"No company added\"}</p></div></div><div className=\"flex gap-2\"><button onClick={() => setEdit(true)} className={secondaryButton}><Pencil size={15} />Edit customer</button><button onClick={() => { setDeleteError(\"\"); setRemove(true); }} title=\"Delete customer\" aria-label=\"Delete customer\" className=\"rounded-lg border border-slate-200 bg-white p-2.5 text-slate-400 hover:border-red-200 hover:bg-red-50 hover:text-red-600\"><Trash2 size={17} /></button></div></div>\n+    <div className=\"grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_340px]\">\n+      <div className=\"min-w-0 space-y-6\">\n+        <section className=\"rounded-xl border border-slate-200/80 bg-white\"><h2 className=\"border-b border-slate-100 px-6 py-4 text-sm font-semibold\">The essentials</h2><div className=\"grid gap-x-8 gap-y-6 p-6 sm:grid-cols-2\">{[\n+          { label: \"Email address\", icon: Mail, value: customer.email, href: customer.email ? `mailto:${customer.email}` : undefined },\n+          { label: \"Phone number\", icon: Phone, value: customer.phone, href: customer.phone ? `tel:${customer.phone}` : undefined },\n+          { label: \"Company\", icon: Building2, value: customer.company },\n+          { label: \"Added to directory\", icon: CalendarDays, value: date(customer.created_at) },\n+        ].map(({ label, icon: Icon, value, href }) => <div key={label} className=\"flex min-w-0 items-start gap-3\"><Icon size={16} className=\"mt-0.5 shrink-0 text-slate-400\" strokeWidth={1.7} /><div className=\"min-w-0\"><p className=\"text-[11px] text-slate-400\">{label}</p><p className=\"mt-1.5 break-words text-[13px] text-slate-600\">{href ? <a href={href} className=\"hover:text-brand-700 hover:underline\">{value}</a> : value || <span className=\"text-slate-300\">Not added</span>}</p></div></div>)}</div><div className=\"mx-6 border-t border-slate-100 py-5\"><h3 className=\"flex items-center gap-2 text-xs font-medium text-slate-500\"><FileText size={14} className=\"text-slate-400\" />Notes</h3><p className={`mt-2.5 whitespace-pre-wrap break-words text-xs leading-6 ${customer.notes ? \"text-slate-500\" : \"text-slate-400\"}`}>{customer.notes || \"No notes yet. Add a helpful detail when you edit this customer.\"}</p></div></section>\n+        <section className=\"overflow-hidden rounded-xl border border-slate-200/80 bg-white\"><div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-6 py-4\"><h2 className=\"flex items-center gap-2.5 text-sm font-semibold\">Interaction history<span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-normal text-slate-500\">{customer.interaction_count}</span></h2><span className=\"text-[10px] text-slate-400\">Newest first</span></div>\n+          {interactions.length ? <ol className=\"divide-y divide-slate-100\">{interactions.map((interaction) => {\n+            const { label, icon: Icon, color } = kinds[interaction.kind];\n+            return <li key={interaction.id} className=\"flex gap-3.5 px-6 py-5\"><span className={`mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg ${color}`}><Icon size={16} strokeWidth={1.7} /></span><div className=\"min-w-0 flex-1\"><div className=\"flex flex-wrap items-center justify-between gap-2\"><h3 className=\"text-xs font-semibold text-slate-700\">{label}</h3><time dateTime={interaction.occurred_at} className=\"text-[10px] text-slate-400\">{date(interaction.occurred_at, true)}</time></div><p className=\"mt-2 whitespace-pre-wrap break-words text-xs leading-6 text-slate-500\">{interaction.summary}</p><p className=\"mt-3 flex items-center gap-1.5 text-[10px] text-slate-400\"><span className=\"flex size-4 items-center justify-center rounded-full bg-slate-100 text-[7px] font-medium text-slate-500\">{initials(interaction.logged_by)}</span>Logged by <span className=\"font-medium text-slate-500\">{interaction.logged_by}</span></p></div></li>;\n+          })}</ol> : <div className=\"flex flex-col items-center px-6 py-14 text-center\"><span className=\"mb-4 flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-500\"><MessageSquare size={23} strokeWidth={1.5} /></span><h3 className=\"text-sm font-semibold\">The conversation starts here</h3><p className=\"mt-2 max-w-xs text-xs leading-6 text-slate-400\">Log your first call, email, or meeting to keep everyone in the loop.</p></div>}\n+        </section>\n+      </div>\n+      <div className=\"space-y-5\"><section className=\"rounded-xl border border-brand-100/75 bg-[#f1f7f2] p-5\"><p className=\"flex items-center gap-2 text-[11px] font-medium text-brand-700\"><Clock3 size={14} />Last contacted</p><p className=\"mt-3 text-lg font-semibold tracking-tight text-brand-900\">{date(customer.last_contacted_at)}</p><p className=\"mt-2 text-[11px] text-brand-600/70\">{customer.interaction_count} {customer.interaction_count === 1 ? \"conversation\" : \"conversations\"} remembered</p></section><InteractionForm key={customer.id} customerId={customer.id} onSaved={() => { setRevision(revision + 1); notify(\"Interaction logged. Your team is in the loop.\"); }} /><p className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400\"><Users size={12} />A shared history for stronger relationships.</p></div>\n+    </div>\n+    {edit && <CustomerForm customer={customer} onClose={() => setEdit(false)} onSaved={(saved) => { setCustomer(saved); setEdit(false); notify(\"Customer details updated.\"); }} />}\n+    {remove && <Modal title=\"Delete this customer?\" description=\"This action can’t be undone.\" onClose={() => { if (!deleting) setRemove(false); }}><div className=\"space-y-4 p-6\"><div className=\"flex gap-3 rounded-lg bg-red-50 p-4\"><Trash2 size={20} className=\"mt-0.5 shrink-0 text-red-500\" /><p className=\"text-sm leading-6 text-slate-600\"><strong className=\"font-semibold text-slate-800\">{customer.name}</strong> and all {customer.interaction_count} of their interactions will be permanently removed for your entire team.</p></div>{deleteError && <Alert>{deleteError}</Alert>}</div><div className=\"flex justify-end gap-3 border-t border-slate-100 px-6 py-4\"><button disabled={deleting} onClick={() => setRemove(false)} className={secondaryButton}>Keep customer</button><button disabled={deleting} onClick={deleteCustomer} className=\"inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50\">{deleting ? <LoaderCircle size={15} className=\"animate-spin\" /> : <Trash2 size={15} />}{deleting ? \"Deleting…\" : \"Delete customer\"}</button></div></Modal>}\n+  </>;\n+}\n*** Add File: /workspace/backend/requirements-dev.txt\n+-r requirements.txt\n+ruff==0.14.8\n*** Add File: /workspace/backend/test_app.py\n+import hashlib\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app, get_db\n+\n+\n+class DirectoryTest(unittest.TestCase):\n+    def setUp(self):\n+        self.temp = tempfile.TemporaryDirectory()\n+        self.database = str(Path(self.temp.name) / \"directory.sqlite3\")\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.database})\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.temp.cleanup()\n+\n+    def account(self, username):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + response.json[\"token\"]}\n+\n+    def customer(self, **fields):\n+        response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Alex Morgan\", **fields})\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def test_health_and_authorization(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        customer = self.customer()\n+        paths = [\"/api/customers\", f\"/api/customers/{customer['id']}\", f\"/api/customers/{customer['id']}/interactions\", \"/api/overview\", \"/api/auth/me\"]\n+        for path in paths:\n+            with self.subTest(path=path):\n+                self.assertEqual(self.client.get(path).status_code, 401)\n+                self.assertEqual(self.client.get(path, headers={\"Authorization\": \"Bearer invalid\"}).status_code, 401)\n+        for method, path in [(\"post\", \"/api/customers\"), (\"put\", f\"/api/customers/{customer['id']}\"), (\"delete\", f\"/api/customers/{customer['id']}\"), (\"post\", f\"/api/customers/{customer['id']}/interactions\")]:\n+            self.assertEqual(getattr(self.client, method)(path, json={}).status_code, 401)\n+\n+    def test_accounts_validation_and_logout(self):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 409)\n+        self.assertIn(\"username\", response.json[\"errors\"])\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"short\"}).status_code, 400)\n+        for password in (\"wrongpassword\", \"password123\"):\n+            response = self.client.post(\"/api/auth/login\", json={\"username\": \"nobody\", \"password\": password})\n+            self.assertEqual(response.status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrongpassword\"}).status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.headers).json[\"username\"], \"alice\")\n+        token = self.headers[\"Authorization\"].split()[1]\n+        with self.app.app_context():\n+            user = get_db().execute(\"SELECT * FROM users\").fetchone()\n+            session = get_db().execute(\"SELECT * FROM sessions\").fetchone()\n+            self.assertNotEqual(user[\"password_hash\"], \"password123\")\n+            self.assertEqual(session[\"token_hash\"], hashlib.sha256(token.encode()).hexdigest())\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/customers\", headers=self.headers).status_code, 401)\n+\n+    def test_customer_fields_validation_and_duplicates(self):\n+        self.assertEqual(self.client.post(\"/api/customers\", headers=self.headers, json={}).status_code, 400)\n+        for fields in ({\"name\": \" \"}, {\"email\": \"not-email\"}, {\"phone\": 123}, {\"notes\": []}):\n+            response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Alex\", **fields})\n+            self.assertEqual(response.status_code, 400)\n+        first = self.customer(email=\"alex@example.com\", phone=\"123\", company=\"Acme\", notes=\"Important\")\n+        self.assertEqual(set(first), {\"id\", \"name\", \"email\", \"phone\", \"company\", \"notes\", \"created_at\", \"interaction_count\", \"last_contacted_at\"})\n+        self.assertEqual(first[\"interaction_count\"], 0)\n+        self.assertIsNone(first[\"last_contacted_at\"])\n+        response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Another\", \"email\": \"ALEX@example.com\"})\n+        self.assertEqual(response.status_code, 409)\n+        self.assertIn(\"email\", response.json[\"errors\"])\n+        second = self.customer(name=\"Second\", email=\"second@example.com\")\n+        response = self.client.put(f\"/api/customers/{second['id']}\", headers=self.headers, json={\"name\": \"Second\", \"email\": \"alex@example.com\"})\n+        self.assertEqual(response.status_code, 409)\n+        response = self.client.put(f\"/api/customers/{first['id']}\", headers=self.headers, json={\"name\": \"Renamed\"})\n+        self.assertEqual(response.status_code, 200)\n+        for key in (\"email\", \"phone\", \"company\", \"notes\"):\n+            self.assertIsNone(response.json[key])\n+        self.assertEqual(response.json[\"created_at\"], first[\"created_at\"])\n+        self.customer(email=\"alex@example.com\")\n+        self.customer()\n+\n+    def test_search_company_sorting_and_pagination(self):\n+        self.customer(name=\"Zoe\", company=\"Acme\", notes=\"special 100%\")\n+        self.customer(name=\"amy\", email=\"amy@other.com\", company=\"Other\")\n+        self.customer(name=\"Ben\", phone=\"555\", company=\"Acme\")\n+        response = self.client.get(\"/api/customers?page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json[\"total\"], 3)\n+        self.assertEqual([row[\"name\"] for row in response.json[\"items\"]], [\"amy\", \"Ben\"])\n+        response = self.client.get(\"/api/customers?page=2&page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json[\"items\"][0][\"name\"], \"Zoe\")\n+        response = self.client.get(\"/api/customers?q=ben&company=acme\", headers=self.headers)\n+        self.assertEqual(response.json[\"total\"], 1)\n+        for query in (\"555\", \"100%\", \"amy@\", \"special\"):\n+            response = self.client.get(\"/api/customers\", query_string={\"q\": query}, headers=self.headers)\n+            self.assertEqual(response.json[\"total\"], 1)\n+        for query in (\"page=0\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page_size=2.5\"):\n+            self.assertEqual(self.client.get(\"/api/customers?\" + query, headers=self.headers).status_code, 400)\n+\n+    def test_shared_interactions_and_cascade_delete(self):\n+        customer = self.customer()\n+        path = f\"/api/customers/{customer['id']}\"\n+        bob = self.account(\"bob\")\n+        response = self.client.put(path, headers=bob, json={\"name\": \"Edited by Bob\"})\n+        self.assertEqual(response.status_code, 200)\n+        for kind, when, headers in [(\"call\", \"2026-01-02T12:00:00Z\", self.headers), (\"email\", \"2026-01-01T15:00:00+02:00\", bob), (\"meeting\", \"2026-01-02T12:00:00Z\", bob)]:\n+            response = self.client.post(path + \"/interactions\", headers=headers, json={\"kind\": kind, \"summary\": \"Follow-up\", \"occurred_at\": when, \"logged_by\": \"forged\"})\n+            self.assertEqual(response.status_code, 201)\n+            self.assertEqual(set(response.json), {\"id\", \"customer_id\", \"kind\", \"summary\", \"occurred_at\", \"logged_by\"})\n+            self.assertEqual(response.json[\"logged_by\"], \"alice\" if headers == self.headers else \"bob\")\n+        log = self.client.get(path + \"/interactions\", headers=self.headers).json[\"items\"]\n+        self.assertEqual([row[\"kind\"] for row in log], [\"meeting\", \"call\", \"email\"])\n+        self.assertEqual(log[2][\"occurred_at\"], \"2026-01-01T13:00:00.000000Z\")\n+        result = self.client.get(path, headers=self.headers).json\n+        self.assertEqual(result[\"interaction_count\"], 3)\n+        self.assertEqual(result[\"last_contacted_at\"], \"2026-01-02T12:00:00.000000Z\")\n+        listed = self.client.get(\"/api/customers\", headers=self.headers).json[\"items\"][0]\n+        self.assertEqual(listed, result)\n+        self.assertEqual(self.client.delete(path, headers=bob).status_code, 204)\n+        self.assertEqual(self.client.get(path, headers=self.headers).status_code, 404)\n+        self.assertEqual(self.client.get(path + \"/interactions\", headers=self.headers).status_code, 404)\n+        with self.app.app_context():\n+            self.assertEqual(get_db().execute(\"SELECT COUNT(*) FROM interactions\").fetchone()[0], 0)\n+\n+    def test_interaction_validation_missing_customers_and_json(self):\n+        customer = self.customer()\n+        path = f\"/api/customers/{customer['id']}/interactions\"\n+        for fields in ({}, {\"kind\": \"sms\", \"summary\": \"Hello\"}, {\"kind\": \"call\", \"summary\": \" \"}, {\"kind\": \"email\", \"summary\": \"Hello\", \"occurred_at\": \"not-a-date\"}, {\"kind\": \"call\", \"summary\": \"Hello\", \"occurred_at\": None}):\n+            self.assertEqual(self.client.post(path, headers=self.headers, json=fields).status_code, 400)\n+        self.assertEqual(self.client.post(path, headers=self.headers, json={\"kind\": \"call\", \"summary\": \"Default time\"}).status_code, 201)\n+        for method, path in [(\"get\", \"/api/customers/999\"), (\"put\", \"/api/customers/999\"), (\"delete\", \"/api/customers/999\"), (\"get\", \"/api/customers/999/interactions\"), (\"post\", \"/api/customers/999/interactions\")]:\n+            self.assertEqual(getattr(self.client, method)(path, headers=self.headers).status_code, 404)\n+        for body in ([], \"hello\", None):\n+            self.assertEqual(self.client.post(\"/api/customers\", headers=self.headers, json=body).status_code, 400)\n+        response = self.client.get(\"/api/does-not-exist\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertTrue(response.is_json)\n+\n+    def test_persistence_overview_and_expiration(self):\n+        self.customer(company=\"Acme\")\n+        self.customer(company=\"acme\")\n+        new_app = create_app({\"TESTING\": True, \"DATABASE\": self.database})\n+        response = new_app.test_client().get(\"/api/customers\", headers=self.headers)\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json[\"total\"], 2)\n+        stats = self.client.get(\"/api/overview\", headers=self.headers).json\n+        self.assertEqual(stats[\"customers\"], 2)\n+        self.assertEqual(stats[\"companies\"], 1)\n+        self.assertEqual(len(stats[\"company_options\"]), 1)\n+        with self.app.app_context():\n+            db = get_db()\n+            with db:\n+                db.execute(\"UPDATE sessions SET expires_at = '2000-01-01T00:00:00.000000Z'\")\n+        self.assertEqual(self.client.get(\"/api/customers\", headers=self.headers).status_code, 401)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n*** Update File: /workspace/README.md\n@@\n-# App\n+# Commonplace\n+\n+A private, shared customer directory built with Flask, SQLite, React, TypeScript, and Tailwind CSS. Team members can manage every customer and log calls, emails, and meetings.\n@@\n Dependencies are pinned: `backend/requirements.lock` holds the resolved versions and is installed as a pip constraints file. The frontend uses `frontend/package-lock.json` (`npm ci`). When you change dependencies, update the lock file as well (or remove it).\n+\n+## Local development\n+\n+```sh\n+python3 -m pip install -r backend/requirements-dev.txt -c backend/requirements.lock\n+python3 backend/app.py\n+```\n+\n+In another terminal, from `frontend/`:\n+\n+```sh\n+npm ci\n+npm run dev\n+```\n+\n+Vite proxies `/api` to Flask on port 8000. For a single-server production run, build the frontend with `npm run build` and run Flask or gunicorn from the workspace root. SQLite data and hashed bearer sessions live in `data/directory.sqlite3`; `DATABASE_PATH` can override this location.\n+\n+## Docker\n+\n+```sh\n+docker build -t commonplace .\n+docker run --rm -p 8000:8000 -v \"$(pwd)/data:/app/data\" commonplace\n+```\n+\n+Open the app on port 8000 and create an account. Registration creates an account; sign in afterward to receive a token. There are no default accounts or seeded customers. Bearer sessions persist across restarts, expire after 30 days, and are revoked on sign-out. Passwords use Werkzeug's scrypt hashing; only token hashes are stored in SQLite.\n+\n+## Verification\n+\n+From the workspace root:\n+\n+```sh\n+python3 -m unittest backend.test_app -v\n+python3 -m ruff check backend\n+python3 -m ruff format --check backend\n+```\n+\n+From `frontend/`:\n+\n+```sh\n+npm run lint\n+npm run typecheck\n+npm run build\n+```\n+\n+## API details\n+\n+All customer, interaction, and workspace endpoints require `Authorization: Bearer <token>`. `/api/health`, registration, and login are public. Validation errors return an `error` message and an `errors` object keyed by field. Invalid input returns 400; duplicate usernames or customer emails return 409; missing customers return 404. Successful customer and interaction creation returns 201; deletion returns 204.\n+\n+Customer names are required. Email, phone, company, and notes are optional and are returned as `null` when empty. Email addresses are validated and unique without regard to case. PUT fully replaces the editable fields and clears omitted optional fields. Search matches name, email, phone, company, and notes; company filtering is an exact, case-insensitive match. Pagination defaults to page 1 and page size 20, with page sizes from 1 to 100.\n+\n+Interaction kinds are `call`, `email`, and `meeting`; summaries are required. `occurred_at` accepts ISO 8601 dates, is normalized to UTC, and defaults to the current time when omitted. A timezone-less timestamp is interpreted as UTC. `logged_by` is the authenticated member's username, never client-supplied. Interactions are sorted by occurrence time descending, then ID descending. `last_contacted_at` is the latest occurrence time, not the time an interaction was entered.\n+\n+The frontend also uses authenticated `/api/auth/me`, `/api/auth/logout`, and `/api/overview` endpoints for the current account, sign-out, directory counts, and company filter options.\n*** End Patch"},"output":"Success. Updated the following files:\nA frontend/src/CustomerDetail.tsx\nA backend/requirements-dev.txt\nA backend/test_app.py\nM README.md","metadata":{"diff":"Index: /workspace/frontend/src/CustomerDetail.tsx\n===================================================================\n--- /workspace/frontend/src/CustomerDetail.tsx\n+++ /workspace/frontend/src/CustomerDetail.tsx\n@@ -0,0 +1,101 @@\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { Link, useNavigate, useOutletContext, useParams } from \"react-router-dom\";\n+import { ArrowLeft, Building2, CalendarDays, Clock3, FileText, LoaderCircle, Mail, MessageSquare, Pencil, Phone, Plus, ShieldCheck, Trash2, Users, Video } from \"lucide-react\";\n+import { api, ApiError, date, initials, message, type Customer, type Interaction } from \"./api\";\n+import { CustomerForm } from \"./CustomerForm\";\n+import type { LayoutContext } from \"./Layout\";\n+import { Alert, Field, inputClass, Modal, primaryButton, secondaryButton, Spinner } from \"./ui\";\n+\n+const kinds = {\n+  call: { label: \"Call\", icon: Phone, color: \"bg-brand-50 text-brand-600\" },\n+  email: { label: \"Email\", icon: Mail, color: \"bg-[#ecf2fa] text-[#6a8cba]\" },\n+  meeting: { label: \"Meeting\", icon: Video, color: \"bg-[#f1eef8] text-[#8b79b4]\" },\n+};\n+\n+function localDateTime() {\n+  const now = new Date();\n+  return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);\n+}\n+\n+function InteractionForm({ customerId, onSaved }: { customerId: number; onSaved: () => void }) {\n+  const [kind, setKind] = useState<Interaction[\"kind\"]>(\"call\");\n+  const [summary, setSummary] = useState(\"\");\n+  const [occurredAt, setOccurredAt] = useState(localDateTime);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({});\n+    try {\n+      const parsedDate = new Date(occurredAt);\n+      await api(`/customers/${customerId}/interactions`, {\n+        method: \"POST\",\n+        body: JSON.stringify({ kind, summary, occurred_at: Number.isNaN(parsedDate.getTime()) ? \"\" : parsedDate.toISOString() }),\n+      });\n+      setSummary(\"\"); setOccurredAt(localDateTime()); onSaved();\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  return <section className=\"rounded-xl border border-slate-200/80 bg-white\"><div className=\"border-b border-slate-100 px-5 py-4\"><h2 className=\"flex items-center gap-2 text-sm font-semibold\"><Plus size={16} className=\"text-brand-600\" />Log an interaction</h2><p className=\"mt-1.5 text-xs text-slate-400\">A quick note now. Helpful context later.</p></div><form onSubmit={submit} noValidate className=\"space-y-5 p-5\">\n+    {error && <Alert>{error}</Alert>}\n+    <fieldset><legend className=\"mb-2 text-xs font-medium text-slate-600\">Interaction type</legend><div className=\"grid grid-cols-3 gap-2\">{Object.entries(kinds).map(([key, { label, icon: Icon }]) => <label key={key} className={`flex cursor-pointer items-center justify-center gap-1.5 rounded-lg border px-2 py-2.5 text-xs transition ${kind === key ? \"border-brand-200 bg-brand-50 font-medium text-brand-700\" : \"border-slate-200 text-slate-500 hover:bg-slate-50\"}`}><input type=\"radio\" name=\"kind\" value={key} checked={kind === key} onChange={() => setKind(key as Interaction[\"kind\"])} disabled={busy} className=\"sr-only\" /><Icon size={14} /><span>{label}</span></label>)}</div>{errors.kind && <p role=\"alert\" className=\"mt-1 text-xs text-red-600\">{errors.kind}</p>}</fieldset>\n+    <Field id=\"interaction-summary\" label=\"What did you talk about?\" required error={errors.summary}><textarea id=\"interaction-summary\" rows={5} placeholder=\"A follow-up, an introduction, a useful detail…\" value={summary} onChange={(event) => setSummary(event.target.value)} disabled={busy} className={`${inputClass} resize-y text-xs leading-6`} aria-invalid={!!errors.summary} aria-describedby={errors.summary ? \"interaction-summary-error\" : undefined} /></Field>\n+    <Field id=\"interaction-date\" label=\"When did it happen?\" required error={errors.occurred_at} hint=\"Date and time in your local timezone.\"><input id=\"interaction-date\" type=\"datetime-local\" value={occurredAt} onChange={(event) => setOccurredAt(event.target.value)} disabled={busy} className={`${inputClass} text-xs`} aria-invalid={!!errors.occurred_at} aria-describedby={errors.occurred_at ? \"interaction-date-error\" : undefined} /></Field>\n+    <button disabled={busy} className={`${primaryButton} w-full`}>{busy ? <LoaderCircle size={15} className=\"animate-spin\" /> : <Plus size={15} />}{busy ? \"Logging…\" : \"Log interaction\"}</button>\n+    <p className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400\"><ShieldCheck size={12} />Logged as you. Visible to the whole team.</p>\n+  </form></section>;\n+}\n+\n+export function CustomerDetail() {\n+  const { id } = useParams();\n+  const navigate = useNavigate();\n+  const { notify } = useOutletContext<LayoutContext>();\n+  const [customer, setCustomer] = useState<Customer | null>(null);\n+  const [interactions, setInteractions] = useState<Interaction[]>([]);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [edit, setEdit] = useState(false);\n+  const [remove, setRemove] = useState(false);\n+  const [deleting, setDeleting] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+  useEffect(() => {\n+    let active = true;\n+    setError(\"\");\n+    Promise.all([api<Customer>(`/customers/${id}`), api<{ items: Interaction[] }>(`/customers/${id}/interactions`)]).then(([data, log]) => {\n+      if (active) { setCustomer(data); setInteractions(log.items); }\n+    }).catch((err) => { if (active) setError(message(err)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [id, revision]);\n+  async function deleteCustomer() {\n+    setDeleting(true); setDeleteError(\"\");\n+    try { await api(`/customers/${id}`, { method: \"DELETE\" }); notify(\"Customer and interaction history deleted.\"); navigate(\"/customers\"); }\n+    catch (err) { setDeleteError(message(err)); }\n+    finally { setDeleting(false); }\n+  }\n+  if (loading) return <Spinner label=\"Opening this customer’s profile…\" />;\n+  if (error || !customer) return <div className=\"space-y-5\"><Link to=\"/customers\" className=\"inline-flex items-center gap-2 text-sm text-slate-500\"><ArrowLeft size={15} />Back to customers</Link><Alert>{error || \"Customer not found.\"}</Alert><button onClick={() => { setLoading(true); setRevision(revision + 1); }} className={secondaryButton}>Try again</button></div>;\n+  return <>\n+    <Link to=\"/customers\" className=\"mb-7 inline-flex items-center gap-1.5 text-xs text-slate-500 transition hover:text-brand-700\"><ArrowLeft size={14} />Back to customers</Link>\n+    <div className=\"mb-8 flex flex-wrap items-center justify-between gap-5\"><div className=\"flex min-w-0 items-center gap-4\"><span className=\"flex size-16 shrink-0 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 text-xl font-medium text-brand-700\">{initials(customer.name)}</span><div className=\"min-w-0\"><p className=\"mb-1 text-[10px] font-semibold tracking-[1.5px] text-brand-600\">CUSTOMER PROFILE</p><h1 className=\"break-words text-[28px] font-semibold tracking-[-0.8px]\">{customer.name}</h1><p className=\"mt-1 flex items-center gap-1.5 text-xs text-slate-400\"><Building2 size={13} />{customer.company || \"No company added\"}</p></div></div><div className=\"flex gap-2\"><button onClick={() => setEdit(true)} className={secondaryButton}><Pencil size={15} />Edit customer</button><button onClick={() => { setDeleteError(\"\"); setRemove(true); }} title=\"Delete customer\" aria-label=\"Delete customer\" className=\"rounded-lg border border-slate-200 bg-white p-2.5 text-slate-400 hover:border-red-200 hover:bg-red-50 hover:text-red-600\"><Trash2 size={17} /></button></div></div>\n+    <div className=\"grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_340px]\">\n+      <div className=\"min-w-0 space-y-6\">\n+        <section className=\"rounded-xl border border-slate-200/80 bg-white\"><h2 className=\"border-b border-slate-100 px-6 py-4 text-sm font-semibold\">The essentials</h2><div className=\"grid gap-x-8 gap-y-6 p-6 sm:grid-cols-2\">{[\n+          { label: \"Email address\", icon: Mail, value: customer.email, href: customer.email ? `mailto:${customer.email}` : undefined },\n+          { label: \"Phone number\", icon: Phone, value: customer.phone, href: customer.phone ? `tel:${customer.phone}` : undefined },\n+          { label: \"Company\", icon: Building2, value: customer.company },\n+          { label: \"Added to directory\", icon: CalendarDays, value: date(customer.created_at) },\n+        ].map(({ label, icon: Icon, value, href }) => <div key={label} className=\"flex min-w-0 items-start gap-3\"><Icon size={16} className=\"mt-0.5 shrink-0 text-slate-400\" strokeWidth={1.7} /><div className=\"min-w-0\"><p className=\"text-[11px] text-slate-400\">{label}</p><p className=\"mt-1.5 break-words text-[13px] text-slate-600\">{href ? <a href={href} className=\"hover:text-brand-700 hover:underline\">{value}</a> : value || <span className=\"text-slate-300\">Not added</span>}</p></div></div>)}</div><div className=\"mx-6 border-t border-slate-100 py-5\"><h3 className=\"flex items-center gap-2 text-xs font-medium text-slate-500\"><FileText size={14} className=\"text-slate-400\" />Notes</h3><p className={`mt-2.5 whitespace-pre-wrap break-words text-xs leading-6 ${customer.notes ? \"text-slate-500\" : \"text-slate-400\"}`}>{customer.notes || \"No notes yet. Add a helpful detail when you edit this customer.\"}</p></div></section>\n+        <section className=\"overflow-hidden rounded-xl border border-slate-200/80 bg-white\"><div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-6 py-4\"><h2 className=\"flex items-center gap-2.5 text-sm font-semibold\">Interaction history<span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-normal text-slate-500\">{customer.interaction_count}</span></h2><span className=\"text-[10px] text-slate-400\">Newest first</span></div>\n+          {interactions.length ? <ol className=\"divide-y divide-slate-100\">{interactions.map((interaction) => {\n+            const { label, icon: Icon, color } = kinds[interaction.kind];\n+            return <li key={interaction.id} className=\"flex gap-3.5 px-6 py-5\"><span className={`mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg ${color}`}><Icon size={16} strokeWidth={1.7} /></span><div className=\"min-w-0 flex-1\"><div className=\"flex flex-wrap items-center justify-between gap-2\"><h3 className=\"text-xs font-semibold text-slate-700\">{label}</h3><time dateTime={interaction.occurred_at} className=\"text-[10px] text-slate-400\">{date(interaction.occurred_at, true)}</time></div><p className=\"mt-2 whitespace-pre-wrap break-words text-xs leading-6 text-slate-500\">{interaction.summary}</p><p className=\"mt-3 flex items-center gap-1.5 text-[10px] text-slate-400\"><span className=\"flex size-4 items-center justify-center rounded-full bg-slate-100 text-[7px] font-medium text-slate-500\">{initials(interaction.logged_by)}</span>Logged by <span className=\"font-medium text-slate-500\">{interaction.logged_by}</span></p></div></li>;\n+          })}</ol> : <div className=\"flex flex-col items-center px-6 py-14 text-center\"><span className=\"mb-4 flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-500\"><MessageSquare size={23} strokeWidth={1.5} /></span><h3 className=\"text-sm font-semibold\">The conversation starts here</h3><p className=\"mt-2 max-w-xs text-xs leading-6 text-slate-400\">Log your first call, email, or meeting to keep everyone in the loop.</p></div>}\n+        </section>\n+      </div>\n+      <div className=\"space-y-5\"><section className=\"rounded-xl border border-brand-100/75 bg-[#f1f7f2] p-5\"><p className=\"flex items-center gap-2 text-[11px] font-medium text-brand-700\"><Clock3 size={14} />Last contacted</p><p className=\"mt-3 text-lg font-semibold tracking-tight text-brand-900\">{date(customer.last_contacted_at)}</p><p className=\"mt-2 text-[11px] text-brand-600/70\">{customer.interaction_count} {customer.interaction_count === 1 ? \"conversation\" : \"conversations\"} remembered</p></section><InteractionForm key={customer.id} customerId={customer.id} onSaved={() => { setRevision(revision + 1); notify(\"Interaction logged. Your team is in the loop.\"); }} /><p className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400\"><Users size={12} />A shared history for stronger relationships.</p></div>\n+    </div>\n+    {edit && <CustomerForm customer={customer} onClose={() => setEdit(false)} onSaved={(saved) => { setCustomer(saved); setEdit(false); notify(\"Customer details updated.\"); }} />}\n+    {remove && <Modal title=\"Delete this customer?\" description=\"This action can’t be undone.\" onClose={() => { if (!deleting) setRemove(false); }}><div className=\"space-y-4 p-6\"><div className=\"flex gap-3 rounded-lg bg-red-50 p-4\"><Trash2 size={20} className=\"mt-0.5 shrink-0 text-red-500\" /><p className=\"text-sm leading-6 text-slate-600\"><strong className=\"font-semibold text-slate-800\">{customer.name}</strong> and all {customer.interaction_count} of their interactions will be permanently removed for your entire team.</p></div>{deleteError && <Alert>{deleteError}</Alert>}</div><div className=\"flex justify-end gap-3 border-t border-slate-100 px-6 py-4\"><button disabled={deleting} onClick={() => setRemove(false)} className={secondaryButton}>Keep customer</button><button disabled={deleting} onClick={deleteCustomer} className=\"inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50\">{deleting ? <LoaderCircle size={15} className=\"animate-spin\" /> : <Trash2 size={15} />}{deleting ? \"Deleting…\" : \"Delete customer\"}</button></div></Modal>}\n+  </>;\n+}\n\nIndex: /workspace/backend/requirements-dev.txt\n===================================================================\n--- /workspace/backend/requirements-dev.txt\n+++ /workspace/backend/requirements-dev.txt\n@@ -0,0 +1,2 @@\n+-r requirements.txt\n+ruff==0.14.8\n\nIndex: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,160 @@\n+import hashlib\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app, get_db\n+\n+\n+class DirectoryTest(unittest.TestCase):\n+    def setUp(self):\n+        self.temp = tempfile.TemporaryDirectory()\n+        self.database = str(Path(self.temp.name) / \"directory.sqlite3\")\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.database})\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.temp.cleanup()\n+\n+    def account(self, username):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + response.json[\"token\"]}\n+\n+    def customer(self, **fields):\n+        response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Alex Morgan\", **fields})\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def test_health_and_authorization(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        customer = self.customer()\n+        paths = [\"/api/customers\", f\"/api/customers/{customer['id']}\", f\"/api/customers/{customer['id']}/interactions\", \"/api/overview\", \"/api/auth/me\"]\n+        for path in paths:\n+            with self.subTest(path=path):\n+                self.assertEqual(self.client.get(path).status_code, 401)\n+                self.assertEqual(self.client.get(path, headers={\"Authorization\": \"Bearer invalid\"}).status_code, 401)\n+        for method, path in [(\"post\", \"/api/customers\"), (\"put\", f\"/api/customers/{customer['id']}\"), (\"delete\", f\"/api/customers/{customer['id']}\"), (\"post\", f\"/api/customers/{customer['id']}/interactions\")]:\n+            self.assertEqual(getattr(self.client, method)(path, json={}).status_code, 401)\n+\n+    def test_accounts_validation_and_logout(self):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 409)\n+        self.assertIn(\"username\", response.json[\"errors\"])\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"short\"}).status_code, 400)\n+        for password in (\"wrongpassword\", \"password123\"):\n+            response = self.client.post(\"/api/auth/login\", json={\"username\": \"nobody\", \"password\": password})\n+            self.assertEqual(response.status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrongpassword\"}).status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.headers).json[\"username\"], \"alice\")\n+        token = self.headers[\"Authorization\"].split()[1]\n+        with self.app.app_context():\n+            user = get_db().execute(\"SELECT * FROM users\").fetchone()\n+            session = get_db().execute(\"SELECT * FROM sessions\").fetchone()\n+            self.assertNotEqual(user[\"password_hash\"], \"password123\")\n+            self.assertEqual(session[\"token_hash\"], hashlib.sha256(token.encode()).hexdigest())\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/customers\", headers=self.headers).status_code, 401)\n+\n+    def test_customer_fields_validation_and_duplicates(self):\n+        self.assertEqual(self.client.post(\"/api/customers\", headers=self.headers, json={}).status_code, 400)\n+        for fields in ({\"name\": \" \"}, {\"email\": \"not-email\"}, {\"phone\": 123}, {\"notes\": []}):\n+            response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Alex\", **fields})\n+            self.assertEqual(response.status_code, 400)\n+        first = self.customer(email=\"alex@example.com\", phone=\"123\", company=\"Acme\", notes=\"Important\")\n+        self.assertEqual(set(first), {\"id\", \"name\", \"email\", \"phone\", \"company\", \"notes\", \"created_at\", \"interaction_count\", \"last_contacted_at\"})\n+        self.assertEqual(first[\"interaction_count\"], 0)\n+        self.assertIsNone(first[\"last_contacted_at\"])\n+        response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Another\", \"email\": \"ALEX@example.com\"})\n+        self.assertEqual(response.status_code, 409)\n+        self.assertIn(\"email\", response.json[\"errors\"])\n+        second = self.customer(name=\"Second\", email=\"second@example.com\")\n+        response = self.client.put(f\"/api/customers/{second['id']}\", headers=self.headers, json={\"name\": \"Second\", \"email\": \"alex@example.com\"})\n+        self.assertEqual(response.status_code, 409)\n+        response = self.client.put(f\"/api/customers/{first['id']}\", headers=self.headers, json={\"name\": \"Renamed\"})\n+        self.assertEqual(response.status_code, 200)\n+        for key in (\"email\", \"phone\", \"company\", \"notes\"):\n+            self.assertIsNone(response.json[key])\n+        self.assertEqual(response.json[\"created_at\"], first[\"created_at\"])\n+        self.customer(email=\"alex@example.com\")\n+        self.customer()\n+\n+    def test_search_company_sorting_and_pagination(self):\n+        self.customer(name=\"Zoe\", company=\"Acme\", notes=\"special 100%\")\n+        self.customer(name=\"amy\", email=\"amy@other.com\", company=\"Other\")\n+        self.customer(name=\"Ben\", phone=\"555\", company=\"Acme\")\n+        response = self.client.get(\"/api/customers?page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json[\"total\"], 3)\n+        self.assertEqual([row[\"name\"] for row in response.json[\"items\"]], [\"amy\", \"Ben\"])\n+        response = self.client.get(\"/api/customers?page=2&page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json[\"items\"][0][\"name\"], \"Zoe\")\n+        response = self.client.get(\"/api/customers?q=ben&company=acme\", headers=self.headers)\n+        self.assertEqual(response.json[\"total\"], 1)\n+        for query in (\"555\", \"100%\", \"amy@\", \"special\"):\n+            response = self.client.get(\"/api/customers\", query_string={\"q\": query}, headers=self.headers)\n+            self.assertEqual(response.json[\"total\"], 1)\n+        for query in (\"page=0\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page_size=2.5\"):\n+            self.assertEqual(self.client.get(\"/api/customers?\" + query, headers=self.headers).status_code, 400)\n+\n+    def test_shared_interactions_and_cascade_delete(self):\n+        customer = self.customer()\n+        path = f\"/api/customers/{customer['id']}\"\n+        bob = self.account(\"bob\")\n+        response = self.client.put(path, headers=bob, json={\"name\": \"Edited by Bob\"})\n+        self.assertEqual(response.status_code, 200)\n+        for kind, when, headers in [(\"call\", \"2026-01-02T12:00:00Z\", self.headers), (\"email\", \"2026-01-01T15:00:00+02:00\", bob), (\"meeting\", \"2026-01-02T12:00:00Z\", bob)]:\n+            response = self.client.post(path + \"/interactions\", headers=headers, json={\"kind\": kind, \"summary\": \"Follow-up\", \"occurred_at\": when, \"logged_by\": \"forged\"})\n+            self.assertEqual(response.status_code, 201)\n+            self.assertEqual(set(response.json), {\"id\", \"customer_id\", \"kind\", \"summary\", \"occurred_at\", \"logged_by\"})\n+            self.assertEqual(response.json[\"logged_by\"], \"alice\" if headers == self.headers else \"bob\")\n+        log = self.client.get(path + \"/interactions\", headers=self.headers).json[\"items\"]\n+        self.assertEqual([row[\"kind\"] for row in log], [\"meeting\", \"call\", \"email\"])\n+        self.assertEqual(log[2][\"occurred_at\"], \"2026-01-01T13:00:00.000000Z\")\n+        result = self.client.get(path, headers=self.headers).json\n+        self.assertEqual(result[\"interaction_count\"], 3)\n+        self.assertEqual(result[\"last_contacted_at\"], \"2026-01-02T12:00:00.000000Z\")\n+        listed = self.client.get(\"/api/customers\", headers=self.headers).json[\"items\"][0]\n+        self.assertEqual(listed, result)\n+        self.assertEqual(self.client.delete(path, headers=bob).status_code, 204)\n+        self.assertEqual(self.client.get(path, headers=self.headers).status_code, 404)\n+        self.assertEqual(self.client.get(path + \"/interactions\", headers=self.headers).status_code, 404)\n+        with self.app.app_context():\n+            self.assertEqual(get_db().execute(\"SELECT COUNT(*) FROM interactions\").fetchone()[0], 0)\n+\n+    def test_interaction_validation_missing_customers_and_json(self):\n+        customer = self.customer()\n+        path = f\"/api/customers/{customer['id']}/interactions\"\n+        for fields in ({}, {\"kind\": \"sms\", \"summary\": \"Hello\"}, {\"kind\": \"call\", \"summary\": \" \"}, {\"kind\": \"email\", \"summary\": \"Hello\", \"occurred_at\": \"not-a-date\"}, {\"kind\": \"call\", \"summary\": \"Hello\", \"occurred_at\": None}):\n+            self.assertEqual(self.client.post(path, headers=self.headers, json=fields).status_code, 400)\n+        self.assertEqual(self.client.post(path, headers=self.headers, json={\"kind\": \"call\", \"summary\": \"Default time\"}).status_code, 201)\n+        for method, path in [(\"get\", \"/api/customers/999\"), (\"put\", \"/api/customers/999\"), (\"delete\", \"/api/customers/999\"), (\"get\", \"/api/customers/999/interactions\"), (\"post\", \"/api/customers/999/interactions\")]:\n+            self.assertEqual(getattr(self.client, method)(path, headers=self.headers).status_code, 404)\n+        for body in ([], \"hello\", None):\n+            self.assertEqual(self.client.post(\"/api/customers\", headers=self.headers, json=body).status_code, 400)\n+        response = self.client.get(\"/api/does-not-exist\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertTrue(response.is_json)\n+\n+    def test_persistence_overview_and_expiration(self):\n+        self.customer(company=\"Acme\")\n+        self.customer(company=\"acme\")\n+        new_app = create_app({\"TESTING\": True, \"DATABASE\": self.database})\n+        response = new_app.test_client().get(\"/api/customers\", headers=self.headers)\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json[\"total\"], 2)\n+        stats = self.client.get(\"/api/overview\", headers=self.headers).json\n+        self.assertEqual(stats[\"customers\"], 2)\n+        self.assertEqual(stats[\"companies\"], 1)\n+        self.assertEqual(len(stats[\"company_options\"]), 1)\n+        with self.app.app_context():\n+            db = get_db()\n+            with db:\n+                db.execute(\"UPDATE sessions SET expires_at = '2000-01-01T00:00:00.000000Z'\")\n+        self.assertEqual(self.client.get(\"/api/customers\", headers=self.headers).status_code, 401)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\nIndex: /workspace/README.md\n===================================================================\n--- /workspace/README.md\n+++ /workspace/README.md\n@@ -1,6 +1,8 @@\n-# App\n+# Commonplace\n \n+A private, shared customer directory built with Flask, SQLite, React, TypeScript, and Tailwind CSS. Team members can manage every customer and log calls, emails, and meetings.\n+\n ## Run contract\n \n - The app is built from `Dockerfile` in this directory and the container listens on port 8000.\n - The API is served under `/api`. `GET /api/health` answers `{\"status\": \"ok\"}` once the app is ready.\n@@ -12,4 +14,57 @@\n - `backend/`: the Flask app (`backend/app.py`, served by gunicorn as `app:app`); dependencies in `backend/requirements.txt`.\n - `frontend/`: a Vite project (React + TypeScript). `npm run build` writes `frontend/dist`, which the image copies next to the backend.\n \n Dependencies are pinned: `backend/requirements.lock` holds the resolved versions and is installed as a pip constraints file. The frontend uses `frontend/package-lock.json` (`npm ci`). When you change dependencies, update the lock file as well (or remove it).\n+\n+## Local development\n+\n+```sh\n+python3 -m pip install -r backend/requirements-dev.txt -c backend/requirements.lock\n+python3 backend/app.py\n+```\n+\n+In another terminal, from `frontend/`:\n+\n+```sh\n+npm ci\n+npm run dev\n+```\n+\n+Vite proxies `/api` to Flask on port 8000. For a single-server production run, build the frontend with `npm run build` and run Flask or gunicorn from the workspace root. SQLite data and hashed bearer sessions live in `data/directory.sqlite3`; `DATABASE_PATH` can override this location.\n+\n+## Docker\n+\n+```sh\n+docker build -t commonplace .\n+docker run --rm -p 8000:8000 -v \"$(pwd)/data:/app/data\" commonplace\n+```\n+\n+Open the app on port 8000 and create an account. Registration creates an account; sign in afterward to receive a token. There are no default accounts or seeded customers. Bearer sessions persist across restarts, expire after 30 days, and are revoked on sign-out. Passwords use Werkzeug's scrypt hashing; only token hashes are stored in SQLite.\n+\n+## Verification\n+\n+From the workspace root:\n+\n+```sh\n+python3 -m unittest backend.test_app -v\n+python3 -m ruff check backend\n+python3 -m ruff format --check backend\n+```\n+\n+From `frontend/`:\n+\n+```sh\n+npm run lint\n+npm run typecheck\n+npm run build\n+```\n+\n+## API details\n+\n+All customer, interaction, and workspace endpoints require `Authorization: Bearer <token>`. `/api/health`, registration, and login are public. Validation errors return an `error` message and an `errors` object keyed by field. Invalid input returns 400; duplicate usernames or customer emails return 409; missing customers return 404. Successful customer and interaction creation returns 201; deletion returns 204.\n+\n+Customer names are required. Email, phone, company, and notes are optional and are returned as `null` when empty. Email addresses are validated and unique without regard to case. PUT fully replaces the editable fields and clears omitted optional fields. Search matches name, email, phone, company, and notes; company filtering is an exact, case-insensitive match. Pagination defaults to page 1 and page size 20, with page sizes from 1 to 100.\n+\n+Interaction kinds are `call`, `email`, and `meeting`; summaries are required. `occurred_at` accepts ISO 8601 dates, is normalized to UTC, and defaults to the current time when omitted. A timezone-less timestamp is interpreted as UTC. `logged_by` is the authenticated member's username, never client-supplied. Interactions are sorted by occurrence time descending, then ID descending. `last_contacted_at` is the latest occurrence time, not the time an interaction was entered.\n+\n+The frontend also uses authenticated `/api/auth/me`, `/api/auth/logout`, and `/api/overview` endpoints for the current account, sign-out, directory counts, and company filter options.\n\n","files":[{"filePath":"/workspace/frontend/src/CustomerDetail.tsx","relativePath":"frontend/src/CustomerDetail.tsx","type":"add","patch":"Index: /workspace/frontend/src/CustomerDetail.tsx\n===================================================================\n--- /workspace/frontend/src/CustomerDetail.tsx\n+++ /workspace/frontend/src/CustomerDetail.tsx\n@@ -0,0 +1,101 @@\n+import { useEffect, useState, type FormEvent } from \"react\";\n+import { Link, useNavigate, useOutletContext, useParams } from \"react-router-dom\";\n+import { ArrowLeft, Building2, CalendarDays, Clock3, FileText, LoaderCircle, Mail, MessageSquare, Pencil, Phone, Plus, ShieldCheck, Trash2, Users, Video } from \"lucide-react\";\n+import { api, ApiError, date, initials, message, type Customer, type Interaction } from \"./api\";\n+import { CustomerForm } from \"./CustomerForm\";\n+import type { LayoutContext } from \"./Layout\";\n+import { Alert, Field, inputClass, Modal, primaryButton, secondaryButton, Spinner } from \"./ui\";\n+\n+const kinds = {\n+  call: { label: \"Call\", icon: Phone, color: \"bg-brand-50 text-brand-600\" },\n+  email: { label: \"Email\", icon: Mail, color: \"bg-[#ecf2fa] text-[#6a8cba]\" },\n+  meeting: { label: \"Meeting\", icon: Video, color: \"bg-[#f1eef8] text-[#8b79b4]\" },\n+};\n+\n+function localDateTime() {\n+  const now = new Date();\n+  return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);\n+}\n+\n+function InteractionForm({ customerId, onSaved }: { customerId: number; onSaved: () => void }) {\n+  const [kind, setKind] = useState<Interaction[\"kind\"]>(\"call\");\n+  const [summary, setSummary] = useState(\"\");\n+  const [occurredAt, setOccurredAt] = useState(localDateTime);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({});\n+    try {\n+      const parsedDate = new Date(occurredAt);\n+      await api(`/customers/${customerId}/interactions`, {\n+        method: \"POST\",\n+        body: JSON.stringify({ kind, summary, occurred_at: Number.isNaN(parsedDate.getTime()) ? \"\" : parsedDate.toISOString() }),\n+      });\n+      setSummary(\"\"); setOccurredAt(localDateTime()); onSaved();\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  return <section className=\"rounded-xl border border-slate-200/80 bg-white\"><div className=\"border-b border-slate-100 px-5 py-4\"><h2 className=\"flex items-center gap-2 text-sm font-semibold\"><Plus size={16} className=\"text-brand-600\" />Log an interaction</h2><p className=\"mt-1.5 text-xs text-slate-400\">A quick note now. Helpful context later.</p></div><form onSubmit={submit} noValidate className=\"space-y-5 p-5\">\n+    {error && <Alert>{error}</Alert>}\n+    <fieldset><legend className=\"mb-2 text-xs font-medium text-slate-600\">Interaction type</legend><div className=\"grid grid-cols-3 gap-2\">{Object.entries(kinds).map(([key, { label, icon: Icon }]) => <label key={key} className={`flex cursor-pointer items-center justify-center gap-1.5 rounded-lg border px-2 py-2.5 text-xs transition ${kind === key ? \"border-brand-200 bg-brand-50 font-medium text-brand-700\" : \"border-slate-200 text-slate-500 hover:bg-slate-50\"}`}><input type=\"radio\" name=\"kind\" value={key} checked={kind === key} onChange={() => setKind(key as Interaction[\"kind\"])} disabled={busy} className=\"sr-only\" /><Icon size={14} /><span>{label}</span></label>)}</div>{errors.kind && <p role=\"alert\" className=\"mt-1 text-xs text-red-600\">{errors.kind}</p>}</fieldset>\n+    <Field id=\"interaction-summary\" label=\"What did you talk about?\" required error={errors.summary}><textarea id=\"interaction-summary\" rows={5} placeholder=\"A follow-up, an introduction, a useful detail…\" value={summary} onChange={(event) => setSummary(event.target.value)} disabled={busy} className={`${inputClass} resize-y text-xs leading-6`} aria-invalid={!!errors.summary} aria-describedby={errors.summary ? \"interaction-summary-error\" : undefined} /></Field>\n+    <Field id=\"interaction-date\" label=\"When did it happen?\" required error={errors.occurred_at} hint=\"Date and time in your local timezone.\"><input id=\"interaction-date\" type=\"datetime-local\" value={occurredAt} onChange={(event) => setOccurredAt(event.target.value)} disabled={busy} className={`${inputClass} text-xs`} aria-invalid={!!errors.occurred_at} aria-describedby={errors.occurred_at ? \"interaction-date-error\" : undefined} /></Field>\n+    <button disabled={busy} className={`${primaryButton} w-full`}>{busy ? <LoaderCircle size={15} className=\"animate-spin\" /> : <Plus size={15} />}{busy ? \"Logging…\" : \"Log interaction\"}</button>\n+    <p className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400\"><ShieldCheck size={12} />Logged as you. Visible to the whole team.</p>\n+  </form></section>;\n+}\n+\n+export function CustomerDetail() {\n+  const { id } = useParams();\n+  const navigate = useNavigate();\n+  const { notify } = useOutletContext<LayoutContext>();\n+  const [customer, setCustomer] = useState<Customer | null>(null);\n+  const [interactions, setInteractions] = useState<Interaction[]>([]);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [edit, setEdit] = useState(false);\n+  const [remove, setRemove] = useState(false);\n+  const [deleting, setDeleting] = useState(false);\n+  const [deleteError, setDeleteError] = useState(\"\");\n+  const [revision, setRevision] = useState(0);\n+  useEffect(() => {\n+    let active = true;\n+    setError(\"\");\n+    Promise.all([api<Customer>(`/customers/${id}`), api<{ items: Interaction[] }>(`/customers/${id}/interactions`)]).then(([data, log]) => {\n+      if (active) { setCustomer(data); setInteractions(log.items); }\n+    }).catch((err) => { if (active) setError(message(err)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [id, revision]);\n+  async function deleteCustomer() {\n+    setDeleting(true); setDeleteError(\"\");\n+    try { await api(`/customers/${id}`, { method: \"DELETE\" }); notify(\"Customer and interaction history deleted.\"); navigate(\"/customers\"); }\n+    catch (err) { setDeleteError(message(err)); }\n+    finally { setDeleting(false); }\n+  }\n+  if (loading) return <Spinner label=\"Opening this customer’s profile…\" />;\n+  if (error || !customer) return <div className=\"space-y-5\"><Link to=\"/customers\" className=\"inline-flex items-center gap-2 text-sm text-slate-500\"><ArrowLeft size={15} />Back to customers</Link><Alert>{error || \"Customer not found.\"}</Alert><button onClick={() => { setLoading(true); setRevision(revision + 1); }} className={secondaryButton}>Try again</button></div>;\n+  return <>\n+    <Link to=\"/customers\" className=\"mb-7 inline-flex items-center gap-1.5 text-xs text-slate-500 transition hover:text-brand-700\"><ArrowLeft size={14} />Back to customers</Link>\n+    <div className=\"mb-8 flex flex-wrap items-center justify-between gap-5\"><div className=\"flex min-w-0 items-center gap-4\"><span className=\"flex size-16 shrink-0 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 text-xl font-medium text-brand-700\">{initials(customer.name)}</span><div className=\"min-w-0\"><p className=\"mb-1 text-[10px] font-semibold tracking-[1.5px] text-brand-600\">CUSTOMER PROFILE</p><h1 className=\"break-words text-[28px] font-semibold tracking-[-0.8px]\">{customer.name}</h1><p className=\"mt-1 flex items-center gap-1.5 text-xs text-slate-400\"><Building2 size={13} />{customer.company || \"No company added\"}</p></div></div><div className=\"flex gap-2\"><button onClick={() => setEdit(true)} className={secondaryButton}><Pencil size={15} />Edit customer</button><button onClick={() => { setDeleteError(\"\"); setRemove(true); }} title=\"Delete customer\" aria-label=\"Delete customer\" className=\"rounded-lg border border-slate-200 bg-white p-2.5 text-slate-400 hover:border-red-200 hover:bg-red-50 hover:text-red-600\"><Trash2 size={17} /></button></div></div>\n+    <div className=\"grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_340px]\">\n+      <div className=\"min-w-0 space-y-6\">\n+        <section className=\"rounded-xl border border-slate-200/80 bg-white\"><h2 className=\"border-b border-slate-100 px-6 py-4 text-sm font-semibold\">The essentials</h2><div className=\"grid gap-x-8 gap-y-6 p-6 sm:grid-cols-2\">{[\n+          { label: \"Email address\", icon: Mail, value: customer.email, href: customer.email ? `mailto:${customer.email}` : undefined },\n+          { label: \"Phone number\", icon: Phone, value: customer.phone, href: customer.phone ? `tel:${customer.phone}` : undefined },\n+          { label: \"Company\", icon: Building2, value: customer.company },\n+          { label: \"Added to directory\", icon: CalendarDays, value: date(customer.created_at) },\n+        ].map(({ label, icon: Icon, value, href }) => <div key={label} className=\"flex min-w-0 items-start gap-3\"><Icon size={16} className=\"mt-0.5 shrink-0 text-slate-400\" strokeWidth={1.7} /><div className=\"min-w-0\"><p className=\"text-[11px] text-slate-400\">{label}</p><p className=\"mt-1.5 break-words text-[13px] text-slate-600\">{href ? <a href={href} className=\"hover:text-brand-700 hover:underline\">{value}</a> : value || <span className=\"text-slate-300\">Not added</span>}</p></div></div>)}</div><div className=\"mx-6 border-t border-slate-100 py-5\"><h3 className=\"flex items-center gap-2 text-xs font-medium text-slate-500\"><FileText size={14} className=\"text-slate-400\" />Notes</h3><p className={`mt-2.5 whitespace-pre-wrap break-words text-xs leading-6 ${customer.notes ? \"text-slate-500\" : \"text-slate-400\"}`}>{customer.notes || \"No notes yet. Add a helpful detail when you edit this customer.\"}</p></div></section>\n+        <section className=\"overflow-hidden rounded-xl border border-slate-200/80 bg-white\"><div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-6 py-4\"><h2 className=\"flex items-center gap-2.5 text-sm font-semibold\">Interaction history<span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-normal text-slate-500\">{customer.interaction_count}</span></h2><span className=\"text-[10px] text-slate-400\">Newest first</span></div>\n+          {interactions.length ? <ol className=\"divide-y divide-slate-100\">{interactions.map((interaction) => {\n+            const { label, icon: Icon, color } = kinds[interaction.kind];\n+            return <li key={interaction.id} className=\"flex gap-3.5 px-6 py-5\"><span className={`mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg ${color}`}><Icon size={16} strokeWidth={1.7} /></span><div className=\"min-w-0 flex-1\"><div className=\"flex flex-wrap items-center justify-between gap-2\"><h3 className=\"text-xs font-semibold text-slate-700\">{label}</h3><time dateTime={interaction.occurred_at} className=\"text-[10px] text-slate-400\">{date(interaction.occurred_at, true)}</time></div><p className=\"mt-2 whitespace-pre-wrap break-words text-xs leading-6 text-slate-500\">{interaction.summary}</p><p className=\"mt-3 flex items-center gap-1.5 text-[10px] text-slate-400\"><span className=\"flex size-4 items-center justify-center rounded-full bg-slate-100 text-[7px] font-medium text-slate-500\">{initials(interaction.logged_by)}</span>Logged by <span className=\"font-medium text-slate-500\">{interaction.logged_by}</span></p></div></li>;\n+          })}</ol> : <div className=\"flex flex-col items-center px-6 py-14 text-center\"><span className=\"mb-4 flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-500\"><MessageSquare size={23} strokeWidth={1.5} /></span><h3 className=\"text-sm font-semibold\">The conversation starts here</h3><p className=\"mt-2 max-w-xs text-xs leading-6 text-slate-400\">Log your first call, email, or meeting to keep everyone in the loop.</p></div>}\n+        </section>\n+      </div>\n+      <div className=\"space-y-5\"><section className=\"rounded-xl border border-brand-100/75 bg-[#f1f7f2] p-5\"><p className=\"flex items-center gap-2 text-[11px] font-medium text-brand-700\"><Clock3 size={14} />Last contacted</p><p className=\"mt-3 text-lg font-semibold tracking-tight text-brand-900\">{date(customer.last_contacted_at)}</p><p className=\"mt-2 text-[11px] text-brand-600/70\">{customer.interaction_count} {customer.interaction_count === 1 ? \"conversation\" : \"conversations\"} remembered</p></section><InteractionForm key={customer.id} customerId={customer.id} onSaved={() => { setRevision(revision + 1); notify(\"Interaction logged. Your team is in the loop.\"); }} /><p className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400\"><Users size={12} />A shared history for stronger relationships.</p></div>\n+    </div>\n+    {edit && <CustomerForm customer={customer} onClose={() => setEdit(false)} onSaved={(saved) => { setCustomer(saved); setEdit(false); notify(\"Customer details updated.\"); }} />}\n+    {remove && <Modal title=\"Delete this customer?\" description=\"This action can’t be undone.\" onClose={() => { if (!deleting) setRemove(false); }}><div className=\"space-y-4 p-6\"><div className=\"flex gap-3 rounded-lg bg-red-50 p-4\"><Trash2 size={20} className=\"mt-0.5 shrink-0 text-red-500\" /><p className=\"text-sm leading-6 text-slate-600\"><strong className=\"font-semibold text-slate-800\">{customer.name}</strong> and all {customer.interaction_count} of their interactions will be permanently removed for your entire team.</p></div>{deleteError && <Alert>{deleteError}</Alert>}</div><div className=\"flex justify-end gap-3 border-t border-slate-100 px-6 py-4\"><button disabled={deleting} onClick={() => setRemove(false)} className={secondaryButton}>Keep customer</button><button disabled={deleting} onClick={deleteCustomer} className=\"inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50\">{deleting ? <LoaderCircle size={15} className=\"animate-spin\" /> : <Trash2 size={15} />}{deleting ? \"Deleting…\" : \"Delete customer\"}</button></div></Modal>}\n+  </>;\n+}\n","additions":101,"deletions":0},{"filePath":"/workspace/backend/requirements-dev.txt","relativePath":"backend/requirements-dev.txt","type":"add","patch":"Index: /workspace/backend/requirements-dev.txt\n===================================================================\n--- /workspace/backend/requirements-dev.txt\n+++ /workspace/backend/requirements-dev.txt\n@@ -0,0 +1,2 @@\n+-r requirements.txt\n+ruff==0.14.8\n","additions":2,"deletions":0},{"filePath":"/workspace/backend/test_app.py","relativePath":"backend/test_app.py","type":"add","patch":"Index: /workspace/backend/test_app.py\n===================================================================\n--- /workspace/backend/test_app.py\n+++ /workspace/backend/test_app.py\n@@ -0,0 +1,160 @@\n+import hashlib\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+from backend.app import create_app, get_db\n+\n+\n+class DirectoryTest(unittest.TestCase):\n+    def setUp(self):\n+        self.temp = tempfile.TemporaryDirectory()\n+        self.database = str(Path(self.temp.name) / \"directory.sqlite3\")\n+        self.app = create_app({\"TESTING\": True, \"DATABASE\": self.database})\n+        self.client = self.app.test_client()\n+        self.headers = self.account(\"alice\")\n+\n+    def tearDown(self):\n+        self.temp.cleanup()\n+\n+    def account(self, username):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": username, \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json={\"username\": username, \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + response.json[\"token\"]}\n+\n+    def customer(self, **fields):\n+        response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Alex Morgan\", **fields})\n+        self.assertEqual(response.status_code, 201, response.json)\n+        return response.json\n+\n+    def test_health_and_authorization(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        customer = self.customer()\n+        paths = [\"/api/customers\", f\"/api/customers/{customer['id']}\", f\"/api/customers/{customer['id']}/interactions\", \"/api/overview\", \"/api/auth/me\"]\n+        for path in paths:\n+            with self.subTest(path=path):\n+                self.assertEqual(self.client.get(path).status_code, 401)\n+                self.assertEqual(self.client.get(path, headers={\"Authorization\": \"Bearer invalid\"}).status_code, 401)\n+        for method, path in [(\"post\", \"/api/customers\"), (\"put\", f\"/api/customers/{customer['id']}\"), (\"delete\", f\"/api/customers/{customer['id']}\"), (\"post\", f\"/api/customers/{customer['id']}/interactions\")]:\n+            self.assertEqual(getattr(self.client, method)(path, json={}).status_code, 401)\n+\n+    def test_accounts_validation_and_logout(self):\n+        response = self.client.post(\"/api/auth/register\", json={\"username\": \"ALICE\", \"password\": \"password123\"})\n+        self.assertEqual(response.status_code, 409)\n+        self.assertIn(\"username\", response.json[\"errors\"])\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"short\"}).status_code, 400)\n+        for password in (\"wrongpassword\", \"password123\"):\n+            response = self.client.post(\"/api/auth/login\", json={\"username\": \"nobody\", \"password\": password})\n+            self.assertEqual(response.status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrongpassword\"}).status_code, 401)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.headers).json[\"username\"], \"alice\")\n+        token = self.headers[\"Authorization\"].split()[1]\n+        with self.app.app_context():\n+            user = get_db().execute(\"SELECT * FROM users\").fetchone()\n+            session = get_db().execute(\"SELECT * FROM sessions\").fetchone()\n+            self.assertNotEqual(user[\"password_hash\"], \"password123\")\n+            self.assertEqual(session[\"token_hash\"], hashlib.sha256(token.encode()).hexdigest())\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.headers).status_code, 204)\n+        self.assertEqual(self.client.get(\"/api/customers\", headers=self.headers).status_code, 401)\n+\n+    def test_customer_fields_validation_and_duplicates(self):\n+        self.assertEqual(self.client.post(\"/api/customers\", headers=self.headers, json={}).status_code, 400)\n+        for fields in ({\"name\": \" \"}, {\"email\": \"not-email\"}, {\"phone\": 123}, {\"notes\": []}):\n+            response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Alex\", **fields})\n+            self.assertEqual(response.status_code, 400)\n+        first = self.customer(email=\"alex@example.com\", phone=\"123\", company=\"Acme\", notes=\"Important\")\n+        self.assertEqual(set(first), {\"id\", \"name\", \"email\", \"phone\", \"company\", \"notes\", \"created_at\", \"interaction_count\", \"last_contacted_at\"})\n+        self.assertEqual(first[\"interaction_count\"], 0)\n+        self.assertIsNone(first[\"last_contacted_at\"])\n+        response = self.client.post(\"/api/customers\", headers=self.headers, json={\"name\": \"Another\", \"email\": \"ALEX@example.com\"})\n+        self.assertEqual(response.status_code, 409)\n+        self.assertIn(\"email\", response.json[\"errors\"])\n+        second = self.customer(name=\"Second\", email=\"second@example.com\")\n+        response = self.client.put(f\"/api/customers/{second['id']}\", headers=self.headers, json={\"name\": \"Second\", \"email\": \"alex@example.com\"})\n+        self.assertEqual(response.status_code, 409)\n+        response = self.client.put(f\"/api/customers/{first['id']}\", headers=self.headers, json={\"name\": \"Renamed\"})\n+        self.assertEqual(response.status_code, 200)\n+        for key in (\"email\", \"phone\", \"company\", \"notes\"):\n+            self.assertIsNone(response.json[key])\n+        self.assertEqual(response.json[\"created_at\"], first[\"created_at\"])\n+        self.customer(email=\"alex@example.com\")\n+        self.customer()\n+\n+    def test_search_company_sorting_and_pagination(self):\n+        self.customer(name=\"Zoe\", company=\"Acme\", notes=\"special 100%\")\n+        self.customer(name=\"amy\", email=\"amy@other.com\", company=\"Other\")\n+        self.customer(name=\"Ben\", phone=\"555\", company=\"Acme\")\n+        response = self.client.get(\"/api/customers?page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json[\"total\"], 3)\n+        self.assertEqual([row[\"name\"] for row in response.json[\"items\"]], [\"amy\", \"Ben\"])\n+        response = self.client.get(\"/api/customers?page=2&page_size=2\", headers=self.headers)\n+        self.assertEqual(response.json[\"items\"][0][\"name\"], \"Zoe\")\n+        response = self.client.get(\"/api/customers?q=ben&company=acme\", headers=self.headers)\n+        self.assertEqual(response.json[\"total\"], 1)\n+        for query in (\"555\", \"100%\", \"amy@\", \"special\"):\n+            response = self.client.get(\"/api/customers\", query_string={\"q\": query}, headers=self.headers)\n+            self.assertEqual(response.json[\"total\"], 1)\n+        for query in (\"page=0\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page_size=2.5\"):\n+            self.assertEqual(self.client.get(\"/api/customers?\" + query, headers=self.headers).status_code, 400)\n+\n+    def test_shared_interactions_and_cascade_delete(self):\n+        customer = self.customer()\n+        path = f\"/api/customers/{customer['id']}\"\n+        bob = self.account(\"bob\")\n+        response = self.client.put(path, headers=bob, json={\"name\": \"Edited by Bob\"})\n+        self.assertEqual(response.status_code, 200)\n+        for kind, when, headers in [(\"call\", \"2026-01-02T12:00:00Z\", self.headers), (\"email\", \"2026-01-01T15:00:00+02:00\", bob), (\"meeting\", \"2026-01-02T12:00:00Z\", bob)]:\n+            response = self.client.post(path + \"/interactions\", headers=headers, json={\"kind\": kind, \"summary\": \"Follow-up\", \"occurred_at\": when, \"logged_by\": \"forged\"})\n+            self.assertEqual(response.status_code, 201)\n+            self.assertEqual(set(response.json), {\"id\", \"customer_id\", \"kind\", \"summary\", \"occurred_at\", \"logged_by\"})\n+            self.assertEqual(response.json[\"logged_by\"], \"alice\" if headers == self.headers else \"bob\")\n+        log = self.client.get(path + \"/interactions\", headers=self.headers).json[\"items\"]\n+        self.assertEqual([row[\"kind\"] for row in log], [\"meeting\", \"call\", \"email\"])\n+        self.assertEqual(log[2][\"occurred_at\"], \"2026-01-01T13:00:00.000000Z\")\n+        result = self.client.get(path, headers=self.headers).json\n+        self.assertEqual(result[\"interaction_count\"], 3)\n+        self.assertEqual(result[\"last_contacted_at\"], \"2026-01-02T12:00:00.000000Z\")\n+        listed = self.client.get(\"/api/customers\", headers=self.headers).json[\"items\"][0]\n+        self.assertEqual(listed, result)\n+        self.assertEqual(self.client.delete(path, headers=bob).status_code, 204)\n+        self.assertEqual(self.client.get(path, headers=self.headers).status_code, 404)\n+        self.assertEqual(self.client.get(path + \"/interactions\", headers=self.headers).status_code, 404)\n+        with self.app.app_context():\n+            self.assertEqual(get_db().execute(\"SELECT COUNT(*) FROM interactions\").fetchone()[0], 0)\n+\n+    def test_interaction_validation_missing_customers_and_json(self):\n+        customer = self.customer()\n+        path = f\"/api/customers/{customer['id']}/interactions\"\n+        for fields in ({}, {\"kind\": \"sms\", \"summary\": \"Hello\"}, {\"kind\": \"call\", \"summary\": \" \"}, {\"kind\": \"email\", \"summary\": \"Hello\", \"occurred_at\": \"not-a-date\"}, {\"kind\": \"call\", \"summary\": \"Hello\", \"occurred_at\": None}):\n+            self.assertEqual(self.client.post(path, headers=self.headers, json=fields).status_code, 400)\n+        self.assertEqual(self.client.post(path, headers=self.headers, json={\"kind\": \"call\", \"summary\": \"Default time\"}).status_code, 201)\n+        for method, path in [(\"get\", \"/api/customers/999\"), (\"put\", \"/api/customers/999\"), (\"delete\", \"/api/customers/999\"), (\"get\", \"/api/customers/999/interactions\"), (\"post\", \"/api/customers/999/interactions\")]:\n+            self.assertEqual(getattr(self.client, method)(path, headers=self.headers).status_code, 404)\n+        for body in ([], \"hello\", None):\n+            self.assertEqual(self.client.post(\"/api/customers\", headers=self.headers, json=body).status_code, 400)\n+        response = self.client.get(\"/api/does-not-exist\")\n+        self.assertEqual(response.status_code, 404)\n+        self.assertTrue(response.is_json)\n+\n+    def test_persistence_overview_and_expiration(self):\n+        self.customer(company=\"Acme\")\n+        self.customer(company=\"acme\")\n+        new_app = create_app({\"TESTING\": True, \"DATABASE\": self.database})\n+        response = new_app.test_client().get(\"/api/customers\", headers=self.headers)\n+        self.assertEqual(response.status_code, 200)\n+        self.assertEqual(response.json[\"total\"], 2)\n+        stats = self.client.get(\"/api/overview\", headers=self.headers).json\n+        self.assertEqual(stats[\"customers\"], 2)\n+        self.assertEqual(stats[\"companies\"], 1)\n+        self.assertEqual(len(stats[\"company_options\"]), 1)\n+        with self.app.app_context():\n+            db = get_db()\n+            with db:\n+                db.execute(\"UPDATE sessions SET expires_at = '2000-01-01T00:00:00.000000Z'\")\n+        self.assertEqual(self.client.get(\"/api/customers\", headers=self.headers).status_code, 401)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n","additions":160,"deletions":0},{"filePath":"/workspace/README.md","relativePath":"README.md","type":"update","patch":"Index: /workspace/README.md\n===================================================================\n--- /workspace/README.md\n+++ /workspace/README.md\n@@ -1,6 +1,8 @@\n-# App\n+# Commonplace\n \n+A private, shared customer directory built with Flask, SQLite, React, TypeScript, and Tailwind CSS. Team members can manage every customer and log calls, emails, and meetings.\n+\n ## Run contract\n \n - The app is built from `Dockerfile` in this directory and the container listens on port 8000.\n - The API is served under `/api`. `GET /api/health` answers `{\"status\": \"ok\"}` once the app is ready.\n@@ -12,4 +14,57 @@\n - `backend/`: the Flask app (`backend/app.py`, served by gunicorn as `app:app`); dependencies in `backend/requirements.txt`.\n - `frontend/`: a Vite project (React + TypeScript). `npm run build` writes `frontend/dist`, which the image copies next to the backend.\n \n Dependencies are pinned: `backend/requirements.lock` holds the resolved versions and is installed as a pip constraints file. The frontend uses `frontend/package-lock.json` (`npm ci`). When you change dependencies, update the lock file as well (or remove it).\n+\n+## Local development\n+\n+```sh\n+python3 -m pip install -r backend/requirements-dev.txt -c backend/requirements.lock\n+python3 backend/app.py\n+```\n+\n+In another terminal, from `frontend/`:\n+\n+```sh\n+npm ci\n+npm run dev\n+```\n+\n+Vite proxies `/api` to Flask on port 8000. For a single-server production run, build the frontend with `npm run build` and run Flask or gunicorn from the workspace root. SQLite data and hashed bearer sessions live in `data/directory.sqlite3`; `DATABASE_PATH` can override this location.\n+\n+## Docker\n+\n+```sh\n+docker build -t commonplace .\n+docker run --rm -p 8000:8000 -v \"$(pwd)/data:/app/data\" commonplace\n+```\n+\n+Open the app on port 8000 and create an account. Registration creates an account; sign in afterward to receive a token. There are no default accounts or seeded customers. Bearer sessions persist across restarts, expire after 30 days, and are revoked on sign-out. Passwords use Werkzeug's scrypt hashing; only token hashes are stored in SQLite.\n+\n+## Verification\n+\n+From the workspace root:\n+\n+```sh\n+python3 -m unittest backend.test_app -v\n+python3 -m ruff check backend\n+python3 -m ruff format --check backend\n+```\n+\n+From `frontend/`:\n+\n+```sh\n+npm run lint\n+npm run typecheck\n+npm run build\n+```\n+\n+## API details\n+\n+All customer, interaction, and workspace endpoints require `Authorization: Bearer <token>`. `/api/health`, registration, and login are public. Validation errors return an `error` message and an `errors` object keyed by field. Invalid input returns 400; duplicate usernames or customer emails return 409; missing customers return 404. Successful customer and interaction creation returns 201; deletion returns 204.\n+\n+Customer names are required. Email, phone, company, and notes are optional and are returned as `null` when empty. Email addresses are validated and unique without regard to case. PUT fully replaces the editable fields and clears omitted optional fields. Search matches name, email, phone, company, and notes; company filtering is an exact, case-insensitive match. Pagination defaults to page 1 and page size 20, with page sizes from 1 to 100.\n+\n+Interaction kinds are `call`, `email`, and `meeting`; summaries are required. `occurred_at` accepts ISO 8601 dates, is normalized to UTC, and defaults to the current time when omitted. A timezone-less timestamp is interpreted as UTC. `logged_by` is the authenticated member's username, never client-supplied. Interactions are sorted by occurrence time descending, then ID descending. `last_contacted_at` is the latest occurrence time, not the time an interaction was entered.\n+\n+The frontend also uses authenticated `/api/auth/me`, `/api/auth/logout`, and `/api/overview` endpoints for the current account, sign-out, directory counts, and company filter options.\n","additions":56,"deletions":1}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nA frontend/src/CustomerDetail.tsx\nA backend/requirements-dev.txt\nA backend/test_app.py\nM README.md","time":{"start":1794319129528,"end":1794319129584}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.summary","summary":"**Evaluating project details**\n\nI","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" need","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" to","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" clarify","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" token","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" budget","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":"—","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":"it's","format":"azure-openai-responses-v1","index":0},{"type"