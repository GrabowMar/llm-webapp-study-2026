uplicate usernames or customer emails return 409; missing customers return 404. Successful customer and interaction creation returns 201; deletion returns 204.\n \n\n","files":[{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -5,16 +5,22 @@\n \"scripts\": {\n   \"dev\": \"vite\",\n   \"build\": \"tsc --noEmit && vite build\",\n   \"typecheck\": \"tsc --noEmit\",\n-  \"lint\": \"eslint .\"\n+  \"lint\": \"eslint .\",\n+  \"test:e2e\": \"playwright test\"\n },\n \"dependencies\": {\n   \"lucide-react\": \"1.71.0\",\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\",\n   \"react-router-dom\": \"7.18.5\"\n },\n+\"overrides\": {\n+  \"@typescript-eslint/typescript-estree\": {\n+    \"minimatch\": \"11.0.5\"\n+  }\n+},\n \"devDependencies\": {\n   \"@eslint/js\": \"9.39.1\",\n   \"@playwright/test\": \"1.65.0\",\n   \"@tailwindcss/vite\": \"4.3.5\",\n","additions":7,"deletions":1},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"update","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -4,4 +4,7 @@\n __pycache__/\n *.pyc\n .venv/\n .ruff_cache/\n+.cache/\n+frontend/test-results/\n+frontend/playwright-report/\n","additions":3,"deletions":0},{"filePath":"/workspace/frontend/playwright.config.ts","relativePath":"frontend/playwright.config.ts","type":"add","patch":"Index: /workspace/frontend/playwright.config.ts\n===================================================================\n--- /workspace/frontend/playwright.config.ts\n+++ /workspace/frontend/playwright.config.ts\n@@ -0,0 +1,14 @@\n+import { defineConfig } from \"@playwright/test\";\n+\n+export default defineConfig({\n+  testDir: \"./tests\",\n+  workers: 1,\n+  use: { baseURL: \"http://127.0.0.1:8001\", viewport: { width: 1440, height: 1000 } },\n+  webServer: {\n+    command: \"python3 -m gunicorn --bind 127.0.0.1:8001 --pythonpath backend app:app\",\n+    cwd: \"..\",\n+    url: \"http://127.0.0.1:8001/api/health\",\n+    env: { DATABASE_PATH: \".cache/browser-tests.sqlite3\" },\n+    reuseExistingServer: false,\n+  },\n+});\n","additions":14,"deletions":0},{"filePath":"/workspace/frontend/tests/directory.spec.ts","relativePath":"frontend/tests/directory.spec.ts","type":"add","patch":"Index: /workspace/frontend/tests/directory.spec.ts\n===================================================================\n--- /workspace/frontend/tests/directory.spec.ts\n+++ /workspace/frontend/tests/directory.spec.ts\n@@ -0,0 +1,84 @@\n+import { expect, test } from \"@playwright/test\";\n+\n+test(\"register, sign in, manage shared customers and conversations\", async ({ page }) => {\n+  const username = `member_${Date.now()}`;\n+  const errors: string[] = [];\n+  page.on(\"pageerror\", (error) => errors.push(error.message));\n+  await page.goto(\"/\");\n+  await expect(page.getByRole(\"heading\", { name: \"Welcome back.\" })).toBeVisible();\n+  await page.screenshot({ path: \"../.cache/login-desktop.png\", fullPage: true });\n+  await page.getByRole(\"button\", { name: \"Create account\", exact: true }).click();\n+  await page.getByLabel(\"Username\", { exact: true }).fill(username);\n+  await page.getByLabel(\"Password\", { exact: true }).fill(\"password123\");\n+  await page.getByRole(\"button\", { name: \"Create your account\" }).click();\n+  await expect(page.getByText(\"Account created. Sign in to join your workspace.\")).toBeVisible();\n+  await page.getByLabel(\"Password\", { exact: true }).fill(\"password123\");\n+  await page.getByRole(\"button\", { name: \"Sign in to your workspace\" }).click();\n+  await expect(page.getByRole(\"heading\", { name: \"Customers\", exact: true })).toBeVisible();\n+  a