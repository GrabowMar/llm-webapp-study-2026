{"type":"tool_use","timestamp":1794319007779,"sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","part":{"type":"tool","tool":"apply_patch","callID":"call_6tUNyZvcmQUUMqVsUtJU8tXi","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Update File: /workspace/frontend/package.json\n@@\n-    \"build\": \"vite build\"\n+    \"build\": \"tsc --noEmit && vite build\",\n+    \"typecheck\": \"tsc --noEmit\",\n+    \"lint\": \"eslint .\"\n*** Update File: /workspace/frontend/vite.config.ts\n@@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n@@\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n*** Add File: /workspace/frontend/tsconfig.json\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"esModuleInterop\": true,\n+    \"resolveJsonModule\": true,\n+    \"isolatedModules\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n*** Add File: /workspace/frontend/eslint.config.js\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist/**\", \"node_modules/**\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  { languageOptions: { globals: { ...globals.browser, ...globals.node } } },\n+);\n*** Add File: /workspace/frontend/src/index.css\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", system-ui, sans-serif;\n+  --color-brand-50: #edf6f0;\n+  --color-brand-100: #daeade;\n+  --color-brand-200: #b8d6c4;\n+  --color-brand-500: #378463;\n+  --color-brand-600: #28694f;\n+  --color-brand-700: #215640;\n+  --color-brand-800: #194533;\n+  --color-brand-900: #173c2e;\n+}\n*** Update File: /workspace/frontend/src/main.tsx\n@@\n import App from \"./App\";\n+import \"./index.css\";\n*** Update File: /workspace/frontend/index.html\n@@\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#215640\" />\n+    <meta name=\"description\" content=\"Commonplace is your team's shared customer directory. Keep contacts, conversations, and relationships in one place.\" />\n+    <title>Commonplace · Customer directory</title>\n*** Add File: /workspace/frontend/src/api.ts\n+export type Customer = {\n+  id: number;\n+  name: string;\n+  email: string | null;\n+  phone: string | null;\n+  company: string | null;\n+  notes: string | null;\n+  created_at: string;\n+  interaction_count: number;\n+  last_contacted_at: string | null;\n+};\n+\n+export type Interaction = {\n+  id: number;\n+  customer_id: number;\n+  kind: \"call\" | \"email\" | \"meeting\";\n+  summary: string;\n+  occurred_at: string;\n+  logged_by: string;\n+};\n+\n+export type CustomerPage = { items: Customer[]; total: number; page: number; page_size: number };\n+export type Overview = { customers: number; companies: number; interactions: number; contacted: number; company_options: string[] };\n+export type User = { id: number; username: string };\n+\n+export class ApiError extends Error {\n+  status: number;\n+  errors: Record<string, string>;\n+  constructor(message: string, status: number, errors: Record<string, string> = {}) {\n+    super(message);\n+    this.status = status;\n+    this.errors = errors;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}): Promise<T> {\n+  const token = localStorage.getItem(\"commonplace-token\");\n+  const response = await fetch(`/api${path}`, {\n+    ...options,\n+    headers: {\n+      ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n+      ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+      ...options.headers,\n+    },\n+  });\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json();\n+  if (!response.ok) {\n+    if (response.status === 401 && !path.startsWith(\"/auth/login\")) {\n+      window.dispatchEvent(new Event(\"commonplace-session-expired\"));\n+    }\n+    throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function message(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n+\n+export function date(value: string | null, withTime = false) {\n+  if (!value) return \"Not contacted yet\";\n+  return new Intl.DateTimeFormat(undefined, {\n+    month: \"short\", day: \"numeric\", year: \"numeric\",\n+    ...(withTime ? { hour: \"numeric\", minute: \"2-digit\" } : {}),\n+  }).format(new Date(value));\n+}\n+\n+export function initials(name: string) {\n+  return name.trim().split(/\\s+/).slice(0, 2).map((part) => part[0]).join(\"\").toUpperCase();\n+}\n*** Add File: /workspace/frontend/src/ui.tsx\n+import { useEffect, useRef, type ReactNode } from \"react\";\n+import { AlertCircle, Check, Leaf, LoaderCircle, X } from \"lucide-react\";\n+\n+export const inputClass = \"w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-3 focus:ring-brand-50 disabled:bg-slate-50\";\n+export const primaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 disabled:cursor-not-allowed disabled:opacity-50\";\n+export const secondaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-brand-500 disabled:cursor-not-allowed disabled:opacity-40\";\n+\n+export function Logo({ light = false }: { light?: boolean }) {\n+  return <span className={`inline-flex items-center gap-2.5 ${light ? \"text-white\" : \"text-brand-900\"}`}>\n+    <span className={`flex size-9 items-center justify-center rounded-xl ${light ? \"bg-white/10\" : \"bg-brand-700\"}`}><Leaf size={20} className=\"text-white\" strokeWidth={1.7} /></span>\n+    <span className=\"text-[21px] font-semibold tracking-[-0.8px]\">commonplace<span className=\"text-brand-500\">.</span></span>\n+  </span>;\n+}\n+\n+export function Spinner({ label = \"Loading…\" }: { label?: string }) {\n+  return <div role=\"status\" className=\"flex items-center justify-center gap-2.5 py-14 text-sm text-slate-500\"><LoaderCircle size={18} className=\"animate-spin\" />{label}</div>;\n+}\n+\n+export function Alert({ children, success = false }: { children: ReactNode; success?: boolean }) {\n+  return <div role={success ? \"status\" : \"alert\"} className={`flex items-start gap-2.5 rounded-lg border p-3 text-sm ${success ? \"border-brand-100 bg-brand-50 text-brand-700\" : \"border-red-100 bg-red-50 text-red-700\"}`}>\n+    {success ? <Check size={17} className=\"mt-0.5 shrink-0\" /> : <AlertCircle size={17} className=\"mt-0.5 shrink-0\" />}<div>{children}</div>\n+  </div>;\n+}\n+\n+export function Field({ label, id, error, hint, required, children }: { label: string; id: string; error?: string; hint?: string; required?: boolean; children: ReactNode }) {\n+  return <div className=\"space-y-1.5\">\n+    <label htmlFor={id} className=\"block text-sm font-medium text-slate-700\">{label}{required && <span className=\"ml-1 text-brand-600\">*</span>}</label>\n+    {children}\n+    {error ? <p id={`${id}-error`} role=\"alert\" className=\"text-xs text-red-600\">{error}</p> : hint ? <p className=\"text-xs text-slate-400\">{hint}</p> : null}\n+  </div>;\n+}\n+\n+export function Modal({ title, description, children, onClose }: { title: string; description?: string; children: ReactNode; onClose: () => void }) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+  useEffect(() => {\n+    ref.current?.showModal();\n+    const old = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => { document.body.style.overflow = old; };\n+  }, []);\n+  return <dialog ref={ref} aria-labelledby=\"modal-title\" onCancel={(event) => { event.preventDefault(); onClose(); }} onClick={(event) => { if (event.target === event.currentTarget) onClose(); }} className=\"fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-2xl bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-950/35 backdrop:backdrop-blur-[3px]\">\n+    <div className=\"flex items-start justify-between border-b border-slate-100 px-6 py-5\">\n+      <div><h2 id=\"modal-title\" className=\"text-lg font-semibold tracking-tight\">{title}</h2>{description && <p className=\"mt-1 text-sm text-slate-500\">{description}</p>}</div>\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"-mr-1 rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700\"><X size={18} /></button>\n+    </div>\n+    {children}\n+  </dialog>;\n+}\n*** Delete File: /workspace/frontend/src/App.tsx\n*** Add File: /workspace/frontend/src/App.tsx\n+import { createContext, useContext, useEffect, useState, type ReactNode } from \"react\";\n+import { BrowserRouter, Navigate, Route, Routes } from \"react-router-dom\";\n+import { api, type User } from \"./api\";\n+import { AuthScreen } from \"./AuthScreen\";\n+import { Layout } from \"./Layout\";\n+import { Customers } from \"./Customers\";\n+import { CustomerDetail } from \"./CustomerDetail\";\n+import { Spinner } from \"./ui\";\n+\n+const AuthContext = createContext<{ user: User | null; signIn: (token: string) => Promise<void>; signOut: () => Promise<void> }>({ user: null, signIn: async () => {}, signOut: async () => {} });\n+export function useAuth() { return useContext(AuthContext); }\n+\n+function AuthProvider({ children }: { children: ReactNode }) {\n+  const [user, setUser] = useState<User | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  useEffect(() => {\n+    const expire = () => { localStorage.removeItem(\"commonplace-token\"); setUser(null); };\n+    window.addEventListener(\"commonplace-session-expired\", expire);\n+    if (localStorage.getItem(\"commonplace-token\")) {\n+      api<User>(\"/auth/me\").then(setUser).catch(expire).finally(() => setLoading(false));\n+    } else setLoading(false);\n+    return () => window.removeEventListener(\"commonplace-session-expired\", expire);\n+  }, []);\n+  async function signIn(token: string) {\n+    localStorage.setItem(\"commonplace-token\", token);\n+    setUser(await api<User>(\"/auth/me\"));\n+  }\n+  async function signOut() {\n+    try { await api(\"/auth/logout\", { method: \"POST\" }); }\n+    finally { localStorage.removeItem(\"commonplace-token\"); setUser(null); }\n+  }\n+  if (loading) return <div className=\"flex min-h-dvh items-center justify-center bg-[#f8faf9]\"><Spinner label=\"Opening your workspace…\" /></div>;\n+  return <AuthContext.Provider value={{ user, signIn, signOut }}>{children}</AuthContext.Provider>;\n+}\n+\n+function AppRoutes() {\n+  const { user } = useAuth();\n+  return <Routes>\n+    <Route path=\"/login\" element={user ? <Navigate to=\"/customers\" replace /> : <AuthScreen />} />\n+    <Route element={user ? <Layout /> : <Navigate to=\"/login\" replace />}>\n+      <Route path=\"/customers\" element={<Customers />} />\n+      <Route path=\"/customers/:id\" element={<CustomerDetail />} />\n+    </Route>\n+    <Route path=\"*\" element={<Navigate to={user ? \"/customers\" : \"/login\"} replace />} />\n+  </Routes>;\n+}\n+\n+export default function App() {\n+  return <BrowserRouter><AuthProvider><AppRoutes /></AuthProvider></BrowserRouter>;\n+}\n*** Add File: /workspace/frontend/src/AuthScreen.tsx\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, Check, Eye, EyeOff, LockKeyhole, Mail, MessageSquare, Users } from \"lucide-react\";\n+import { api, ApiError, message } from \"./api\";\n+import { useAuth } from \"./App\";\n+import { Alert, Field, inputClass, Logo, primaryButton } from \"./ui\";\n+\n+export function AuthScreen() {\n+  const { signIn } = useAuth();\n+  const [register, setRegister] = useState(false);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [visible, setVisible] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  const [success, setSuccess] = useState(\"\");\n+  function changeMode(mode: boolean) { setRegister(mode); setError(\"\"); setErrors({}); setSuccess(\"\"); }\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({}); setSuccess(\"\");\n+    try {\n+      if (register) {\n+        await api(\"/auth/register\", { method: \"POST\", body: JSON.stringify({ username, password }) });\n+        setRegister(false); setPassword(\"\"); setSuccess(\"Account created. Sign in to join your workspace.\");\n+      } else {\n+        const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body: JSON.stringify({ username, password }) });\n+        await signIn(token);\n+      }\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  return <div className=\"min-h-dvh bg-[#fcfcfa] lg:grid lg:grid-cols-[1fr_1fr]\">\n+    <section className=\"relative flex flex-col overflow-hidden bg-brand-900 px-8 py-8 text-white lg:min-h-dvh lg:px-16 lg:py-12 xl:px-20\">\n+      <Logo light />\n+      <div className=\"relative z-10 my-auto max-w-lg py-14 lg:py-20\">\n+        <span className=\"inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-brand-200\"><span className=\"size-1.5 rounded-full bg-brand-200\" /> A shared space for your team</span>\n+        <h1 className=\"mt-7 font-serif text-5xl leading-[1.12] tracking-[-1.5px] xl:text-6xl\">People first.<br />Everything else,<br /><span className=\"text-brand-200\">in one place.</span></h1>\n+        <p className=\"mt-6 max-w-sm text-[15px] leading-7 text-white/60\">A little context makes a big difference. Keep your customers and conversations together, so every relationship feels personal.</p>\n+        <div className=\"relative mt-12 hidden max-w-sm rounded-2xl border border-white/15 bg-white/[0.07] p-6 shadow-xl sm:block\">\n+          <div className=\"flex items-center gap-3\"><div className=\"flex size-11 items-center justify-center rounded-full bg-brand-200 text-brand-800\"><Users size={21} /></div><div><p className=\"text-sm font-medium\">Better together</p><p className=\"mt-1 text-xs text-white/45\">One directory. Your whole team.</p></div><span className=\"ml-auto flex size-7 items-center justify-center rounded-full bg-white/10\"><Check size={14} className=\"text-brand-200\" /></span></div>\n+          <div className=\"mt-5 space-y-3 border-t border-white/10 pt-5\"><p className=\"flex items-center gap-3 text-xs text-white/65\"><Mail size={15} className=\"text-brand-200\" /> Every contact, easy to find</p><p className=\"flex items-center gap-3 text-xs text-white/65\"><MessageSquare size={15} className=\"text-brand-200\" /> Every conversation, remembered</p></div>\n+        </div>\n+      </div>\n+      <div className=\"relative z-10 flex items-center gap-2 text-xs text-white/40\"><LockKeyhole size={13} /> Private to your team. Built around your customers.</div>\n+      <div aria-hidden=\"true\" className=\"pointer-events-none absolute -bottom-48 -right-48 size-[600px] rounded-full border border-white/[0.06]\" /><div aria-hidden=\"true\" className=\"pointer-events-none absolute -bottom-24 -right-24 size-[360px] rounded-full border border-white/[0.06]\" />\n+    </section>\n+    <section className=\"flex flex-col px-7 py-10 sm:px-16 lg:px-20\">\n+      <div className=\"mb-14 flex justify-end text-xs text-slate-400\">THE CUSTOMER DIRECTORY, SIMPLIFIED</div>\n+      <div className=\"mx-auto my-auto w-full max-w-[370px] pb-12\">\n+        <div className=\"mb-8 flex gap-1 rounded-lg bg-slate-100 p-1\"><button disabled={busy} onClick={() => changeMode(false)} className={`flex-1 rounded-md py-2.5 text-sm font-medium transition ${!register ? \"bg-white text-brand-800 shadow-sm\" : \"text-slate-500 hover:text-slate-800\"}`}>Sign in</button><button disabled={busy} onClick={() => changeMode(true)} className={`flex-1 rounded-md py-2.5 text-sm font-medium transition ${register ? \"bg-white text-brand-800 shadow-sm\" : \"text-slate-500 hover:text-slate-800\"}`}>Create account</button></div>\n+        <h2 className=\"text-3xl font-semibold tracking-[-1px] text-slate-800\">{register ? \"Make yourself at home.\" : \"Welcome back.\"}</h2>\n+        <p className=\"mb-8 mt-2.5 text-sm leading-6 text-slate-500\">{register ? \"Join your team’s shared customer directory.\" : \"Sign in to keep your connections close.\"}</p>\n+        <form onSubmit={submit} noValidate className=\"space-y-5\">\n+          {error && <Alert>{error}</Alert>}{success && <Alert success>{success}</Alert>}\n+          <Field label=\"Username\" id=\"username\" error={errors.username}><input autoFocus id=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} disabled={busy} placeholder=\"Your username\" className={inputClass} aria-invalid={!!errors.username} aria-describedby={errors.username ? \"username-error\" : undefined} /></Field>\n+          <Field label=\"Password\" id=\"password\" error={errors.password} hint={register ? \"Use at least 8 characters.\" : undefined}><div className=\"relative\"><input id=\"password\" type={visible ? \"text\" : \"password\"} autoComplete={register ? \"new-password\" : \"current-password\"} value={password} onChange={(event) => setPassword(event.target.value)} disabled={busy} placeholder=\"Your password\" className={`${inputClass} pr-11`} aria-invalid={!!errors.password} aria-describedby={errors.password ? \"password-error\" : undefined} /><button type=\"button\" aria-label={visible ? \"Hide password\" : \"Show password\"} onClick={() => setVisible(!visible)} className=\"absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-700\">{visible ? <EyeOff size={17} /> : <Eye size={17} />}</button></div></Field>\n+          <button disabled={busy} className={`${primaryButton} mt-1 w-full py-3`}>{busy ? \"Please wait…\" : register ? \"Create your account\" : \"Sign in to your workspace\"}{!busy && <ArrowRight size={16} />}</button>\n+        </form>\n+        <p className=\"mt-7 text-center text-xs leading-5 text-slate-400\">{register ? \"Already part of the team?\" : \"New to Commonplace?\"} <button onClick={() => changeMode(!register)} className=\"font-medium text-brand-700 hover:underline\">{register ? \"Sign in\" : \"Create an account\"}</button></p>\n+      </div>\n+      <p className=\"text-center text-xs text-slate-400\">A place for every customer. Context for every conversation.</p>\n+    </section>\n+  </div>;\n+}\n*** Add File: /workspace/frontend/src/Layout.tsx\n+import { useEffect, useRef, useState } from \"react\";\n+import { Link, NavLink, Outlet, useLocation } from \"react-router-dom\";\n+import { ArrowUpRight, BookOpen, CheckCircle2, ChevronRight, CircleHelp, Leaf, LogOut, Menu, ShieldCheck, Users, X } from \"lucide-react\";\n+import { useAuth } from \"./App\";\n+import { initials } from \"./api\";\n+import { Logo, Modal } from \"./ui\";\n+\n+export type LayoutContext = { notify: (text: string) => void };\n+\n+export function Layout() {\n+  const { user, signOut } = useAuth();\n+  const [mobile, setMobile] = useState(false);\n+  const [guide, setGuide] = useState(false);\n+  const [toast, setToast] = useState(\"\");\n+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);\n+  const location = useLocation();\n+  useEffect(() => { setMobile(false); }, [location.pathname]);\n+  useEffect(() => () => clearTimeout(timer.current), []);\n+  function notify(text: string) { setToast(text); clearTimeout(timer.current); timer.current = setTimeout(() => setToast(\"\"), 5000); }\n+  const detail = location.pathname !== \"/customers\";\n+  return <div className=\"min-h-dvh bg-[#f8f9fb] text-slate-800\">\n+    {mobile && <button aria-label=\"Close menu\" onClick={() => setMobile(false)} className=\"fixed inset-0 z-30 bg-slate-950/25 lg:hidden\" />}\n+    <aside className={`fixed inset-y-0 left-0 z-40 flex w-[244px] flex-col border-r border-slate-200/75 bg-white transition-transform lg:translate-x-0 ${mobile ? \"translate-x-0\" : \"-translate-x-full\"}`}>\n+      <Link to=\"/customers\" className=\"flex h-[84px] items-center px-6\"><Logo /></Link>\n+      <div className=\"mx-5 flex items-center gap-3 rounded-lg border border-slate-200/80 px-3 py-3\"><span className=\"flex size-8 items-center justify-center rounded-md bg-[#f1f2ee] text-brand-700\"><Leaf size={17} /></span><div><p className=\"text-[13px] font-semibold\">Team workspace</p><p className=\"mt-0.5 text-[11px] text-slate-400\">Shared customer directory</p></div><ShieldCheck size={14} className=\"ml-auto text-slate-400\" /></div>\n+      <nav aria-label=\"Main navigation\" className=\"mt-8 px-4\"><p className=\"mb-3 px-3 text-[10px] font-semibold tracking-[1.5px] text-slate-400\">WORKSPACE</p><NavLink to=\"/customers\" className=\"flex items-center gap-3 rounded-lg bg-brand-50 px-3 py-3 text-sm font-medium text-brand-700\"><Users size={18} strokeWidth={1.7} />Customers<span className=\"ml-auto size-1.5 rounded-full bg-brand-500\" /></NavLink><button onClick={() => setGuide(true)} className=\"mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-3 text-sm text-slate-500 transition hover:bg-slate-50 hover:text-slate-800\"><BookOpen size={18} strokeWidth={1.7} />Workspace guide<ArrowUpRight size={14} className=\"ml-auto text-slate-400\" /></button></nav>\n+      <div className=\"mx-5 mb-6 mt-auto rounded-xl border border-brand-100/70 bg-[#f7faf7] p-4\"><span className=\"flex size-8 items-center justify-center rounded-lg bg-brand-100/60 text-brand-600\"><MessageIllustration /></span><h3 className=\"mt-3 text-xs font-semibold text-brand-900\">Small details. Stronger connections.</h3><p className=\"mt-2 text-xs leading-5 text-slate-500\">Log a conversation today. Your teammates will thank you tomorrow.</p></div>\n+      <div className=\"border-t border-slate-100 p-4\"><div className=\"flex items-center gap-3 rounded-lg px-2 py-1\"><span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[#ecece6] text-xs font-semibold text-slate-600\">{initials(user!.username)}</span><div className=\"min-w-0\"><p className=\"truncate text-sm font-medium\">{user!.username}</p><p className=\"mt-0.5 text-[11px] text-slate-400\">Team member</p></div><button title=\"Sign out\" aria-label=\"Sign out\" onClick={() => { void signOut().catch(() => {}); }} className=\"ml-auto rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700\"><LogOut size={16} /></button></div></div>\n+    </aside>\n+    <div className=\"lg:ml-[244px]\">\n+      <header className=\"flex h-[72px] items-center justify-between border-b border-slate-200/75 bg-white px-5 sm:px-9\"><div className=\"flex items-center gap-3\"><button onClick={() => setMobile(!mobile)} aria-label=\"Open menu\" className=\"rounded-lg p-2 text-slate-500 lg:hidden\"><Menu size={20} /></button><span className=\"hidden text-[13px] text-slate-400 sm:inline\">Workspace</span><ChevronRight size={14} className=\"hidden text-slate-300 sm:block\" /><Link to=\"/customers\" className={`text-[13px] ${detail ? \"text-slate-500 hover:text-brand-700\" : \"font-medium text-slate-700\"}`}>Customers</Link>{detail && <><ChevronRight size={14} className=\"text-slate-300\" /><span className=\"text-[13px] font-medium\">Customer profile</span></>}</div><div className=\"flex items-center gap-5\"><span className=\"hidden items-center gap-1.5 text-xs text-slate-400 md:inline-flex\"><span className=\"size-1.5 rounded-full bg-brand-500\" /> Your team, in sync</span><button onClick={() => setGuide(true)} title=\"Workspace guide\" aria-label=\"Workspace guide\" className=\"rounded-full p-2 text-slate-400 hover:bg-slate-50 hover:text-brand-700\"><CircleHelp size={18} /></button><span className=\"flex size-8 items-center justify-center rounded-full border border-brand-100 bg-brand-50 text-[11px] font-semibold text-brand-700\">{initials(user!.username)}</span></div></header>\n+      <main className=\"mx-auto max-w-[1500px] px-5 py-8 sm:px-9 lg:py-10\"><Outlet context={{ notify } satisfies LayoutContext} /></main>\n+      <footer className=\"mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-2 px-5 pb-7 pt-4 text-[11px] text-slate-400 sm:px-9\"><span>Made for people, not spreadsheets.</span><span className=\"flex items-center gap-1.5\"><ShieldCheck size={12} /> Private to your team</span></footer>\n+    </div>\n+    {toast && <div role=\"status\" className=\"fixed bottom-6 right-5 z-50 flex max-w-[calc(100%-2.5rem)] items-center gap-3 rounded-xl border border-brand-100 bg-white px-5 py-4 text-sm shadow-lg\"><CheckCircle2 size={18} className=\"text-brand-600\" />{toast}<button onClick={() => setToast(\"\")} aria-label=\"Dismiss notification\" className=\"ml-3 text-slate-400\"><X size={16} /></button></div>}\n+    {guide && <Modal title=\"A little guide to Commonplace\" description=\"Good relationships are a team effort.\" onClose={() => setGuide(false)}><div className=\"space-y-5 p-6 text-sm leading-6 text-slate-500\"><div><h3 className=\"font-semibold text-slate-800\">One directory, shared by everyone</h3><p>Every signed-in member can view, add, edit, and delete customers. Search by name, contact details, company, or notes.</p></div><div><h3 className=\"font-semibold text-slate-800\">Keep the conversation going</h3><p>Open a customer to log a call, email, or meeting. Add a summary and the time it happened; your name is attached automatically.</p></div><div><h3 className=\"font-semibold text-slate-800\">A few thoughtful details</h3><p>Customer emails are unique. Last contacted reflects the latest interaction, even if an older conversation is logged later. Deleting a customer also removes their interaction history.</p></div><div className=\"flex items-center gap-2 border-t border-slate-100 pt-4 text-xs\"><ShieldCheck size={16} className=\"text-brand-600\" /> Your directory is only accessible to signed-in team members.</div></div></Modal>}\n+  </div>;\n+}\n+\n+function MessageIllustration() { return <BookOpen size={17} strokeWidth={1.6} />; }\n*** Add File: /workspace/frontend/src/CustomerForm.tsx\n+import { useState, type FormEvent } from \"react\";\n+import { LoaderCircle, Plus, Save } from \"lucide-react\";\n+import { api, ApiError, message, type Customer } from \"./api\";\n+import { Alert, Field, inputClass, Modal, primaryButton, secondaryButton } from \"./ui\";\n+\n+export function CustomerForm({ customer, onClose, onSaved }: { customer?: Customer; onClose: () => void; onSaved: (customer: Customer) => void }) {\n+  const [values, setValues] = useState({ name: customer?.name || \"\", email: customer?.email || \"\", phone: customer?.phone || \"\", company: customer?.company || \"\", notes: customer?.notes || \"\" });\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  const [busy, setBusy] = useState(false);\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({});\n+    try {\n+      const saved = await api<Customer>(customer ? `/customers/${customer.id}` : \"/customers\", { method: customer ? \"PUT\" : \"POST\", body: JSON.stringify(values) });\n+      onSaved(saved);\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  function field(key: keyof typeof values, label: string, placeholder: string, type = \"text\") {\n+    return <Field label={label} id={`customer-${key}`} error={errors[key]} required={key === \"name\"}>\n+      <input id={`customer-${key}`} type={type} autoFocus={key === \"name\"} value={values[key]} placeholder={placeholder} onChange={(event) => setValues({ ...values, [key]: event.target.value })} disabled={busy} className={`${inputClass} ${errors[key] ? \"border-red-300\" : \"\"}`} aria-invalid={!!errors[key]} aria-describedby={errors[key] ? `customer-${key}-error` : undefined} />\n+    </Field>;\n+  }\n+  return <Modal title={customer ? \"Edit customer\" : \"Add a customer\"} description={customer ? \"Keep their details up to date for your whole team.\" : \"A new connection starts with the essentials.\"} onClose={() => { if (!busy) onClose(); }}>\n+    <form onSubmit={submit} noValidate><div className=\"space-y-5 p-6\">\n+      {error && <Alert>{error}</Alert>}\n+      {field(\"name\", \"Full name\", \"e.g. Alex Morgan\")}\n+      <div className=\"grid gap-5 sm:grid-cols-2\">{field(\"email\", \"Email address\", \"alex@company.com\", \"email\")}{field(\"phone\", \"Phone number\", \"+1 (555) 000-0000\", \"tel\")}</div>\n+      {field(\"company\", \"Company\", \"Where they work\")}\n+      <Field label=\"Notes\" id=\"customer-notes\" error={errors.notes} hint=\"A little context for your teammates.\"><textarea id=\"customer-notes\" rows={3} value={values.notes} onChange={(event) => setValues({ ...values, notes: event.target.value })} disabled={busy} placeholder=\"What would be helpful to remember?\" className={`${inputClass} resize-y`} aria-invalid={!!errors.notes} aria-describedby={errors.notes ? \"customer-notes-error\" : undefined} /></Field>\n+      <p className=\"text-xs text-slate-400\"><span className=\"text-brand-600\">*</span> Required field. All other details are optional.</p>\n+    </div><div className=\"flex justify-end gap-3 border-t border-slate-100 bg-slate-50/50 px-6 py-4\"><button type=\"button\" disabled={busy} onClick={onClose} className={secondaryButton}>Cancel</button><button disabled={busy} className={primaryButton}>{busy ? <LoaderCircle size={16} className=\"animate-spin\" /> : customer ? <Save size={16} /> : <Plus size={16} />}{busy ? \"Saving…\" : customer ? \"Save changes\" : \"Add customer\"}</button></div></form>\n+  </Modal>;\n+}\n*** Add File: /workspace/frontend/src/Customers.tsx\n+import { useEffect, useState } from \"react\";\n+import { Link, useOutletContext, useSearchParams } from \"react-router-dom\";\n+import { ArrowDownAZ, ArrowRight, Building2, ChevronLeft, ChevronRight, Clock3, Filter, MessageSquare, Plus, Search, Users, X } from \"lucide-react\";\n+import { api, date, initials, message, type CustomerPage, type Overview } from \"./api\";\n+import { Alert, inputClass, primaryButton, secondaryButton, Spinner } from \"./ui\";\n+import { CustomerForm } from \"./CustomerForm\";\n+import type { LayoutContext } from \"./Layout\";\n+\n+const avatarColors = [\"bg-[#e8eee5] text-[#697c55]\", \"bg-[#eeebf6] text-[#8671a3]\", \"bg-[#f4eae2] text-[#ac825f]\", \"bg-[#e5edf3] text-[#6985a0]\", \"bg-[#f3e6e7] text-[#ad747e]\"];\n+\n+export function Customers() {\n+  const { notify } = useOutletContext<LayoutContext>();\n+  const [params, setParams] = useSearchParams();\n+  const q = params.get(\"q\") || \"\";\n+  const company = params.get(\"company\") || \"\";\n+  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n+  const pageSize = [10, 20, 50].includes(Number(params.get(\"page_size\"))) ? Number(params.get(\"page_size\")) : 10;\n+  const [search, setSearch] = useState(q);\n+  const [result, setResult] = useState<CustomerPage | null>(null);\n+  const [overview, setOverview] = useState<Overview | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [loading, setLoading] = useState(true);\n+  const [add, setAdd] = useState(false);\n+  const [revision, setRevision] = useState(0);\n+  useEffect(() => { setSearch(q); }, [q]);\n+  useEffect(() => {\n+    if (search === q) return;\n+    const timer = setTimeout(() => {\n+      setParams((old) => { const next = new URLSearchParams(old); if (search.trim()) next.set(\"q\", search.trim()); else next.delete(\"q\"); next.delete(\"page\"); return next; }, { replace: true });\n+    }, 300);\n+    return () => clearTimeout(timer);\n+  }, [search, q, setParams]);\n+  useEffect(() => {\n+    let active = true;\n+    setLoading(true); setError(\"\");\n+    const query = new URLSearchParams({ q, company, page: String(page), page_size: String(pageSize) });\n+    api<CustomerPage>(`/customers?${query}`).then((data) => {\n+      if (!active) return;\n+      if (page > 1 && data.items.length === 0 && data.total > 0) {\n+        setParams((old) => { const next = new URLSearchParams(old); next.set(\"page\", String(Math.ceil(data.total / pageSize))); return next; }, { replace: true });\n+      } else setResult(data);\n+    }).catch((err) => { if (active) setError(message(err)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [q, company, page, pageSize, revision, setParams]);\n+  useEffect(() => {\n+    let active = true;\n+    api<Overview>(\"/overview\").then((data) => { if (active) setOverview(data); }).catch(() => {});\n+    return () => { active = false; };\n+  }, [revision]);\n+  function filter(key: string, value: string) {\n+    setParams((old) => { const next = new URLSearchParams(old); if (value) next.set(key, value); else next.delete(key); if (key !== \"page\") next.delete(\"page\"); return next; });\n+  }\n+  const filtered = !!(q || company);\n+  const total = result?.total || 0;\n+  const pages = Math.max(1, Math.ceil(total / pageSize));\n+  return <>\n+    <div className=\"mb-8 flex flex-wrap items-center justify-between gap-5\"><div><p className=\"mb-2 text-[10px] font-semibold tracking-[1.7px] text-brand-600\">A LITTLE CONTEXT. A BETTER CONNECTION.</p><div className=\"flex items-center gap-3\"><h1 className=\"text-[30px] font-semibold tracking-[-1px]\">Customers</h1><span className=\"rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-medium text-slate-500\">{overview?.customers ?? \"—\"}</span></div><p className=\"mt-2 text-[13px] text-slate-500\">Your people, their details, and every conversation in between.</p></div><button onClick={() => setAdd(true)} className={primaryButton}><Plus size={17} />Add customer</button></div>\n+    <div className=\"mb-8 grid grid-cols-2 gap-3 xl:grid-cols-4 xl:gap-5\">\n+      {[\n+        { label: \"Total customers\", value: overview?.customers, icon: Users, color: \"bg-brand-50 text-brand-600\", note: \"Connections in your directory\" },\n+        { label: \"Companies\", value: overview?.companies, icon: Building2, color: \"bg-[#f1eef8] text-[#8b79b4]\", note: \"Organizations you work with\" },\n+        { label: \"Contacted recently\", value: overview?.contacted, icon: Clock3, color: \"bg-[#fcf3e5] text-[#bd9452]\", note: \"Customers in the last 30 days\" },\n+        { label: \"Interactions logged\", value: overview?.interactions, icon: MessageSquare, color: \"bg-[#ecf2fa] text-[#6a8cba]\", note: \"Conversations, kept together\" },\n+      ].map(({ label, value, icon: Icon, color, note }) => <div key={label} className=\"rounded-xl border border-slate-200/80 bg-white p-4 sm:p-5\"><div className=\"flex items-center justify-between gap-2\"><p className=\"text-xs font-medium text-slate-500\">{label}</p><span className={`flex size-8 shrink-0 items-center justify-center rounded-lg ${color}`}><Icon size={16} strokeWidth={1.7} /></span></div><p className=\"mt-3 text-[28px] font-semibold leading-none tracking-tight\">{value ?? \"—\"}</p><p className=\"mt-3 hidden text-[11px] text-slate-400 sm:block\">{note}</p></div>)}\n+    </div>\n+    <section aria-label=\"Customer directory\" className=\"overflow-hidden rounded-xl border border-slate-200/80 bg-white\">\n+      <div className=\"flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6\"><div className=\"flex items-center gap-2.5\"><h2 className=\"text-sm font-semibold\">All customers</h2><span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500\">{total}</span></div><span className=\"flex items-center gap-1.5 text-[11px] text-slate-400\"><ArrowDownAZ size={14} />Sorted by name</span></div>\n+      <div className=\"flex flex-wrap items-center gap-3 px-5 py-4 sm:px-6\"><div className=\"relative w-full sm:max-w-[330px] sm:flex-1\"><Search size={16} className=\"absolute left-3 top-3 text-slate-400\" /><input aria-label=\"Search customers\" placeholder=\"Search name, email, company…\" value={search} onChange={(event) => setSearch(event.target.value)} className={`${inputClass} py-2.5 pl-9 pr-9 text-xs`} />{search && <button aria-label=\"Clear search\" onClick={() => { setSearch(\"\"); filter(\"q\", \"\"); }} className=\"absolute right-3 top-3 text-slate-400 hover:text-slate-600\"><X size={14} /></button>}</div><div className=\"relative min-w-[175px]\"><Building2 size={14} className=\"pointer-events-none absolute left-3 top-3.5 text-slate-400\" /><select aria-label=\"Filter by company\" value={company} onChange={(event) => filter(\"company\", event.target.value)} className={`${inputClass} appearance-none py-2.5 pl-9 pr-9 text-xs`}><option value=\"\">All companies</option>{company && !overview?.company_options.includes(company) && <option value={company}>{company}</option>}{overview?.company_options.map((item) => <option key={item} value={item}>{item}</option>)}</select><ChevronRight size={14} className=\"pointer-events-none absolute right-3 top-3.5 rotate-90 text-slate-400\" /></div>{filtered && <button onClick={() => { setSearch(\"\"); setParams({}); }} className=\"flex items-center gap-1.5 text-xs text-slate-500 hover:text-brand-700\"><X size={13} />Clear filters</button>}<span className=\"ml-auto hidden text-[11px] text-slate-400 xl:inline\">A shared view for your whole team</span></div>\n+      {error ? <div className=\"px-6 pb-6\"><Alert>{error} <button onClick={() => setRevision(revision + 1)} className=\"ml-2 font-semibold underline\">Try again</button></Alert></div> : loading ? <Spinner label=\"Finding your customers…\" /> : result?.items.length ? <div className=\"overflow-x-auto\"><table className=\"w-full whitespace-nowrap text-left text-xs\"><thead className=\"border-y border-slate-100 bg-[#fafbfc] text-[10px] font-medium uppercase tracking-[0.65px] text-slate-400\"><tr><th scope=\"col\" className=\"px-6 py-3.5 font-medium\">Name <span className=\"ml-1 text-brand-600\">↓</span></th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Email address</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Phone</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Company</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Last contacted</th><th scope=\"col\" className=\"py-3.5 pr-5\"><span className=\"sr-only\">View customer</span></th></tr></thead><tbody className=\"divide-y divide-slate-100\">{result.items.map((customer) => <tr key={customer.id} className=\"group transition hover:bg-brand-50/35\"><td className=\"px-6 py-4\"><Link to={`/customers/${customer.id}`} className=\"flex items-center gap-3 rounded-md focus-visible:outline-brand-500\"><span className={`flex size-9 shrink-0 items-center justify-center rounded-full text-[11px] font-medium ${avatarColors[customer.id % avatarColors.length]}`}>{initials(customer.name)}</span><span className=\"max-w-[220px] truncate text-[13px] font-semibold text-slate-700 group-hover:text-brand-700\">{customer.name}</span></Link></td><td className=\"px-4 py-4 text-slate-500\">{customer.email ? <a href={`mailto:${customer.email}`} className=\"hover:text-brand-700\">{customer.email}</a> : <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4 text-slate-500\">{customer.phone || <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4\">{customer.company ? <span className=\"inline-flex max-w-[180px] items-center gap-1.5 rounded-md border border-slate-200/70 bg-slate-50 px-2 py-1 text-[11px] text-slate-600\"><Building2 size={11} className=\"shrink-0 text-slate-400\" /><span className=\"truncate\">{customer.company}</span></span> : <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4\">{customer.last_contacted_at ? <span className=\"flex items-center gap-1.5 text-slate-500\"><span className=\"size-1.5 rounded-full bg-brand-500/65\" />{date(customer.last_contacted_at)}</span> : <span className=\"text-[11px] text-slate-400\">Not contacted yet</span>}</td><td className=\"pr-5\"><Link to={`/customers/${customer.id}`} aria-label={`View ${customer.name}`} className=\"inline-flex rounded-lg p-2 text-slate-300 hover:bg-brand-50 hover:text-brand-600\"><ChevronRight size={16} /></Link></td></tr>)}</tbody></table></div> : <div className=\"flex min-h-[320px] flex-col items-center justify-center border-t border-slate-100 px-6 py-12 text-center\"><span className=\"mb-5 flex size-16 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 shadow-[0_5px_0_0_#f7faf7]\">{filtered ? <Filter size={27} className=\"text-brand-500\" strokeWidth={1.4} /> : <Users size={28} className=\"text-brand-500\" strokeWidth={1.4} />}</span><h3 className=\"text-base font-semibold\">{filtered ? \"No matching connections\" : \"Your next connection starts here\"}</h3><p className=\"mt-2 max-w-sm text-xs leading-6 text-slate-400\">{filtered ? \"Try a different search or company to find who you’re looking for.\" : \"Add your first customer and give your team a shared place to keep the details that matter.\"}</p><button onClick={() => { if (filtered) { setSearch(\"\"); setParams({}); } else setAdd(true); }} className={`${filtered ? secondaryButton : primaryButton} mt-5`}>{filtered ? \"Clear filters\" : <><Plus size={15} />Add your first customer</>}</button></div>}\n+      <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 px-5 py-4 text-[11px] text-slate-400 sm:px-6\"><div className=\"flex items-center gap-4\"><p>{total ? `Showing ${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, total)} of ${total} customers` : \"0 customers\"}</p><label className=\"hidden items-center gap-2 sm:inline-flex\">Rows per page<select aria-label=\"Rows per page\" value={pageSize} onChange={(event) => filter(\"page_size\", event.target.value)} className=\"rounded-md border border-slate-200 bg-white p-1 text-slate-600 outline-brand-500\"><option>10</option><option>20</option><option>50</option></select></label></div><div className=\"flex items-center gap-2\"><button aria-label=\"Previous page\" disabled={page <= 1 || loading} onClick={() => filter(\"page\", String(page - 1))} className=\"rounded-md border border-slate-200 p-1.5 text-slate-500 transition hover:bg-slate-50 disabled:opacity-35\"><ChevronLeft size={14} /></button><span className=\"px-2 text-slate-500\">Page <span className=\"font-medium text-slate-700\">{page}</span> of {pages}</span><button aria-label=\"Next page\" disabled={page >= pages || loading} onClick={() => filter(\"page\", String(page + 1))} className=\"rounded-md border border-slate-200 p-1.5 text-slate-500 transition hover:bg-slate-50 disabled:opacity-35\"><ChevronRight size={14} /></button></div></div>\n+    </section>\n+    <p className=\"mt-5 flex items-center gap-2 text-[11px] text-slate-400\"><Users size={13} />Every customer is shared with your team. Great relationships don’t happen alone.<ArrowRight size={12} className=\"hidden sm:block\" /></p>\n+    {add && <CustomerForm onClose={() => setAdd(false)} onSaved={() => { setAdd(false); setRevision(revision + 1); notify(\"Customer added to your directory.\"); }} />}\n+  </>;\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/src/api.ts\nA frontend/src/ui.tsx\nD frontend/src/App.tsx\nA frontend/src/App.tsx\nA frontend/src/AuthScreen.tsx\nA frontend/src/Layout.tsx\nA frontend/src/CustomerForm.tsx\nA frontend/src/Customers.tsx","metadata":{"diff":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"lucide-react\": \"1.71.0\",\n   \"react\": \"19.3.1\",\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,19 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"esModuleInterop\": true,\n+    \"resolveJsonModule\": true,\n+    \"isolatedModules\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,10 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist/**\", \"node_modules/**\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  { languageOptions: { globals: { ...globals.browser, ...globals.node } } },\n+);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,13 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", system-ui, sans-serif;\n+  --color-brand-50: #edf6f0;\n+  --color-brand-100: #daeade;\n+  --color-brand-200: #b8d6c4;\n+  --color-brand-500: #378463;\n+  --color-brand-600: #28694f;\n+  --color-brand-700: #215640;\n+  --color-brand-800: #194533;\n+  --color-brand-900: #173c2e;\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,11 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#215640\" />\n+    <meta name=\"description\" content=\"Commonplace is your team's shared customer directory. Keep contacts, conversations, and relationships in one place.\" />\n+    <title>Commonplace · Customer directory</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,71 @@\n+export type Customer = {\n+  id: number;\n+  name: string;\n+  email: string | null;\n+  phone: string | null;\n+  company: string | null;\n+  notes: string | null;\n+  created_at: string;\n+  interaction_count: number;\n+  last_contacted_at: string | null;\n+};\n+\n+export type Interaction = {\n+  id: number;\n+  customer_id: number;\n+  kind: \"call\" | \"email\" | \"meeting\";\n+  summary: string;\n+  occurred_at: string;\n+  logged_by: string;\n+};\n+\n+export type CustomerPage = { items: Customer[]; total: number; page: number; page_size: number };\n+export type Overview = { customers: number; companies: number; interactions: number; contacted: number; company_options: string[] };\n+export type User = { id: number; username: string };\n+\n+export class ApiError extends Error {\n+  status: number;\n+  errors: Record<string, string>;\n+  constructor(message: string, status: number, errors: Record<string, string> = {}) {\n+    super(message);\n+    this.status = status;\n+    this.errors = errors;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}): Promise<T> {\n+  const token = localStorage.getItem(\"commonplace-token\");\n+  const response = await fetch(`/api${path}`, {\n+    ...options,\n+    headers: {\n+      ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n+      ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+      ...options.headers,\n+    },\n+  });\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json();\n+  if (!response.ok) {\n+    if (response.status === 401 && !path.startsWith(\"/auth/login\")) {\n+      window.dispatchEvent(new Event(\"commonplace-session-expired\"));\n+    }\n+    throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function message(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n+\n+export function date(value: string | null, withTime = false) {\n+  if (!value) return \"Not contacted yet\";\n+  return new Intl.DateTimeFormat(undefined, {\n+    month: \"short\", day: \"numeric\", year: \"numeric\",\n+    ...(withTime ? { hour: \"numeric\", minute: \"2-digit\" } : {}),\n+  }).format(new Date(value));\n+}\n+\n+export function initials(name: string) {\n+  return name.trim().split(/\\s+/).slice(0, 2).map((part) => part[0]).join(\"\").toUpperCase();\n+}\n\nIndex: /workspace/frontend/src/ui.tsx\n===================================================================\n--- /workspace/frontend/src/ui.tsx\n+++ /workspace/frontend/src/ui.tsx\n@@ -0,0 +1,48 @@\n+import { useEffect, useRef, type ReactNode } from \"react\";\n+import { AlertCircle, Check, Leaf, LoaderCircle, X } from \"lucide-react\";\n+\n+export const inputClass = \"w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-3 focus:ring-brand-50 disabled:bg-slate-50\";\n+export const primaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 disabled:cursor-not-allowed disabled:opacity-50\";\n+export const secondaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-brand-500 disabled:cursor-not-allowed disabled:opacity-40\";\n+\n+export function Logo({ light = false }: { light?: boolean }) {\n+  return <span className={`inline-flex items-center gap-2.5 ${light ? \"text-white\" : \"text-brand-900\"}`}>\n+    <span className={`flex size-9 items-center justify-center rounded-xl ${light ? \"bg-white/10\" : \"bg-brand-700\"}`}><Leaf size={20} className=\"text-white\" strokeWidth={1.7} /></span>\n+    <span className=\"text-[21px] font-semibold tracking-[-0.8px]\">commonplace<span className=\"text-brand-500\">.</span></span>\n+  </span>;\n+}\n+\n+export function Spinner({ label = \"Loading…\" }: { label?: string }) {\n+  return <div role=\"status\" className=\"flex items-center justify-center gap-2.5 py-14 text-sm text-slate-500\"><LoaderCircle size={18} className=\"animate-spin\" />{label}</div>;\n+}\n+\n+export function Alert({ children, success = false }: { children: ReactNode; success?: boolean }) {\n+  return <div role={success ? \"status\" : \"alert\"} className={`flex items-start gap-2.5 rounded-lg border p-3 text-sm ${success ? \"border-brand-100 bg-brand-50 text-brand-700\" : \"border-red-100 bg-red-50 text-red-700\"}`}>\n+    {success ? <Check size={17} className=\"mt-0.5 shrink-0\" /> : <AlertCircle size={17} className=\"mt-0.5 shrink-0\" />}<div>{children}</div>\n+  </div>;\n+}\n+\n+export function Field({ label, id, error, hint, required, children }: { label: string; id: string; error?: string; hint?: string; required?: boolean; children: ReactNode }) {\n+  return <div className=\"space-y-1.5\">\n+    <label htmlFor={id} className=\"block text-sm font-medium text-slate-700\">{label}{required && <span className=\"ml-1 text-brand-600\">*</span>}</label>\n+    {children}\n+    {error ? <p id={`${id}-error`} role=\"alert\" className=\"text-xs text-red-600\">{error}</p> : hint ? <p className=\"text-xs text-slate-400\">{hint}</p> : null}\n+  </div>;\n+}\n+\n+export function Modal({ title, description, children, onClose }: { title: string; description?: string; children: ReactNode; onClose: () => void }) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+  useEffect(() => {\n+    ref.current?.showModal();\n+    const old = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => { document.body.style.overflow = old; };\n+  }, []);\n+  return <dialog ref={ref} aria-labelledby=\"modal-title\" onCancel={(event) => { event.preventDefault(); onClose(); }} onClick={(event) => { if (event.target === event.currentTarget) onClose(); }} className=\"fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-2xl bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-950/35 backdrop:backdrop-blur-[3px]\">\n+    <div className=\"flex items-start justify-between border-b border-slate-100 px-6 py-5\">\n+      <div><h2 id=\"modal-title\" className=\"text-lg font-semibold tracking-tight\">{title}</h2>{description && <p className=\"mt-1 text-sm text-slate-500\">{description}</p>}</div>\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"-mr-1 rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700\"><X size={18} /></button>\n+    </div>\n+    {children}\n+  </dialog>;\n+}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,50 @@\n+import { createContext, useContext, useEffect, useState, type ReactNode } from \"react\";\n+import { BrowserRouter, Navigate, Route, Routes } from \"react-router-dom\";\n+import { api, type User } from \"./api\";\n+import { AuthScreen } from \"./AuthScreen\";\n+import { Layout } from \"./Layout\";\n+import { Customers } from \"./Customers\";\n+import { CustomerDetail } from \"./CustomerDetail\";\n+import { Spinner } from \"./ui\";\n+\n+const AuthContext = createContext<{ user: User | null; signIn: (token: string) => Promise<void>; signOut: () => Promise<void> }>({ user: null, signIn: async () => {}, signOut: async () => {} });\n+export function useAuth() { return useContext(AuthContext); }\n+\n+function AuthProvider({ children }: { children: ReactNode }) {\n+  const [user, setUser] = useState<User | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  useEffect(() => {\n+    const expire = () => { localStorage.removeItem(\"commonplace-token\"); setUser(null); };\n+    window.addEventListener(\"commonplace-session-expired\", expire);\n+    if (localStorage.getItem(\"commonplace-token\")) {\n+      api<User>(\"/auth/me\").then(setUser).catch(expire).finally(() => setLoading(false));\n+    } else setLoading(false);\n+    return () => window.removeEventListener(\"commonplace-session-expired\", expire);\n+  }, []);\n+  async function signIn(token: string) {\n+    localStorage.setItem(\"commonplace-token\", token);\n+    setUser(await api<User>(\"/auth/me\"));\n+  }\n+  async function signOut() {\n+    try { await api(\"/auth/logout\", { method: \"POST\" }); }\n+    finally { localStorage.removeItem(\"commonplace-token\"); setUser(null); }\n+  }\n+  if (loading) return <div className=\"flex min-h-dvh items-center justify-center bg-[#f8faf9]\"><Spinner label=\"Opening your workspace…\" /></div>;\n+  return <AuthContext.Provider value={{ user, signIn, signOut }}>{children}</AuthContext.Provider>;\n+}\n+\n+function AppRoutes() {\n+  const { user } = useAuth();\n+  return <Routes>\n+    <Route path=\"/login\" element={user ? <Navigate to=\"/customers\" replace /> : <AuthScreen />} />\n+    <Route element={user ? <Layout /> : <Navigate to=\"/login\" replace />}>\n+      <Route path=\"/customers\" element={<Customers />} />\n+      <Route path=\"/customers/:id\" element={<CustomerDetail />} />\n+    </Route>\n+    <Route path=\"*\" element={<Navigate to={user ? \"/customers\" : \"/login\"} replace />} />\n+  </Routes>;\n+}\n+\n+export default function App() {\n+  return <BrowserRouter><AuthProvider><AppRoutes /></AuthProvider></BrowserRouter>;\n+}\n\nIndex: /workspace/frontend/src/AuthScreen.tsx\n===================================================================\n--- /workspace/frontend/src/AuthScreen.tsx\n+++ /workspace/frontend/src/AuthScreen.tsx\n@@ -0,0 +1,63 @@\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, Check, Eye, EyeOff, LockKeyhole, Mail, MessageSquare, Users } from \"lucide-react\";\n+import { api, ApiError, message } from \"./api\";\n+import { useAuth } from \"./App\";\n+import { Alert, Field, inputClass, Logo, primaryButton } from \"./ui\";\n+\n+export function AuthScreen() {\n+  const { signIn } = useAuth();\n+  const [register, setRegister] = useState(false);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [visible, setVisible] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  const [success, setSuccess] = useState(\"\");\n+  function changeMode(mode: boolean) { setRegister(mode); setError(\"\"); setErrors({}); setSuccess(\"\"); }\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({}); setSuccess(\"\");\n+    try {\n+      if (register) {\n+        await api(\"/auth/register\", { method: \"POST\", body: JSON.stringify({ username, password }) });\n+        setRegister(false); setPassword(\"\"); setSuccess(\"Account created. Sign in to join your workspace.\");\n+      } else {\n+        const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body: JSON.stringify({ username, password }) });\n+        await signIn(token);\n+      }\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  return <div className=\"min-h-dvh bg-[#fcfcfa] lg:grid lg:grid-cols-[1fr_1fr]\">\n+    <section className=\"relative flex flex-col overflow-hidden bg-brand-900 px-8 py-8 text-white lg:min-h-dvh lg:px-16 lg:py-12 xl:px-20\">\n+      <Logo light />\n+      <div className=\"relative z-10 my-auto max-w-lg py-14 lg:py-20\">\n+        <span className=\"inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-brand-200\"><span className=\"size-1.5 rounded-full bg-brand-200\" /> A shared space for your team</span>\n+        <h1 className=\"mt-7 font-serif text-5xl leading-[1.12] tracking-[-1.5px] xl:text-6xl\">People first.<br />Everything else,<br /><span className=\"text-brand-200\">in one place.</span></h1>\n+        <p className=\"mt-6 max-w-sm text-[15px] leading-7 text-white/60\">A little context makes a big difference. Keep your customers and conversations together, so every relationship feels personal.</p>\n+        <div className=\"relative mt-12 hidden max-w-sm rounded-2xl border border-white/15 bg-white/[0.07] p-6 shadow-xl sm:block\">\n+          <div className=\"flex items-center gap-3\"><div className=\"flex size-11 items-center justify-center rounded-full bg-brand-200 text-brand-800\"><Users size={21} /></div><div><p className=\"text-sm font-medium\">Better together</p><p className=\"mt-1 text-xs text-white/45\">One directory. Your whole team.</p></div><span className=\"ml-auto flex size-7 items-center justify-center rounded-full bg-white/10\"><Check size={14} className=\"text-brand-200\" /></span></div>\n+          <div className=\"mt-5 space-y-3 border-t border-white/10 pt-5\"><p className=\"flex items-center gap-3 text-xs text-white/65\"><Mail size={15} className=\"text-brand-200\" /> Every contact, easy to find</p><p className=\"flex items-center gap-3 text-xs text-white/65\"><MessageSquare size={15} className=\"text-brand-200\" /> Every conversation, remembered</p></div>\n+        </div>\n+      </div>\n+      <div className=\"relative z-10 flex items-center gap-2 text-xs text-white/40\"><LockKeyhole size={13} /> Private to your team. Built around your customers.</div>\n+      <div aria-hidden=\"true\" className=\"pointer-events-none absolute -bottom-48 -right-48 size-[600px] rounded-full border border-white/[0.06]\" /><div aria-hidden=\"true\" className=\"pointer-events-none absolute -bottom-24 -right-24 size-[360px] rounded-full border border-white/[0.06]\" />\n+    </section>\n+    <section className=\"flex flex-col px-7 py-10 sm:px-16 lg:px-20\">\n+      <div className=\"mb-14 flex justify-end text-xs text-slate-400\">THE CUSTOMER DIRECTORY, SIMPLIFIED</div>\n+      <div className=\"mx-auto my-auto w-full max-w-[370px] pb-12\">\n+        <div className=\"mb-8 flex gap-1 rounded-lg bg-slate-100 p-1\"><button disabled={busy} onClick={() => changeMode(false)} className={`flex-1 rounded-md py-2.5 text-sm font-medium transition ${!register ? \"bg-white text-brand-800 shadow-sm\" : \"text-slate-500 hover:text-slate-800\"}`}>Sign in</button><button disabled={busy} onClick={() => changeMode(true)} className={`flex-1 rounded-md py-2.5 text-sm font-medium transition ${register ? \"bg-white text-brand-800 shadow-sm\" : \"text-slate-500 hover:text-slate-800\"}`}>Create account</button></div>\n+        <h2 className=\"text-3xl font-semibold tracking-[-1px] text-slate-800\">{register ? \"Make yourself at home.\" : \"Welcome back.\"}</h2>\n+        <p className=\"mb-8 mt-2.5 text-sm leading-6 text-slate-500\">{register ? \"Join your team’s shared customer directory.\" : \"Sign in to keep your connections close.\"}</p>\n+        <form onSubmit={submit} noValidate className=\"space-y-5\">\n+          {error && <Alert>{error}</Alert>}{success && <Alert success>{success}</Alert>}\n+          <Field label=\"Username\" id=\"username\" error={errors.username}><input autoFocus id=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} disabled={busy} placeholder=\"Your username\" className={inputClass} aria-invalid={!!errors.username} aria-describedby={errors.username ? \"username-error\" : undefined} /></Field>\n+          <Field label=\"Password\" id=\"password\" error={errors.password} hint={register ? \"Use at least 8 characters.\" : undefined}><div className=\"relative\"><input id=\"password\" type={visible ? \"text\" : \"password\"} autoComplete={register ? \"new-password\" : \"current-password\"} value={password} onChange={(event) => setPassword(event.target.value)} disabled={busy} placeholder=\"Your password\" className={`${inputClass} pr-11`} aria-invalid={!!errors.password} aria-describedby={errors.password ? \"password-error\" : undefined} /><button type=\"button\" aria-label={visible ? \"Hide password\" : \"Show password\"} onClick={() => setVisible(!visible)} className=\"absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-700\">{visible ? <EyeOff size={17} /> : <Eye size={17} />}</button></div></Field>\n+          <button disabled={busy} className={`${primaryButton} mt-1 w-full py-3`}>{busy ? \"Please wait…\" : register ? \"Create your account\" : \"Sign in to your workspace\"}{!busy && <ArrowRight size={16} />}</button>\n+        </form>\n+        <p className=\"mt-7 text-center text-xs leading-5 text-slate-400\">{register ? \"Already part of the team?\" : \"New to Commonplace?\"} <button onClick={() => changeMode(!register)} className=\"font-medium text-brand-700 hover:underline\">{register ? \"Sign in\" : \"Create an account\"}</button></p>\n+      </div>\n+      <p className=\"text-center text-xs text-slate-400\">A place for every customer. Context for every conversation.</p>\n+    </section>\n+  </div>;\n+}\n\nIndex: /workspace/frontend/src/Layout.tsx\n===================================================================\n--- /workspace/frontend/src/Layout.tsx\n+++ /workspace/frontend/src/Layout.tsx\n@@ -0,0 +1,40 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { Link, NavLink, Outlet, useLocation } from \"react-router-dom\";\n+import { ArrowUpRight, BookOpen, CheckCircle2, ChevronRight, CircleHelp, Leaf, LogOut, Menu, ShieldCheck, Users, X } from \"lucide-react\";\n+import { useAuth } from \"./App\";\n+import { initials } from \"./api\";\n+import { Logo, Modal } from \"./ui\";\n+\n+export type LayoutContext = { notify: (text: string) => void };\n+\n+export function Layout() {\n+  const { user, signOut } = useAuth();\n+  const [mobile, setMobile] = useState(false);\n+  const [guide, setGuide] = useState(false);\n+  const [toast, setToast] = useState(\"\");\n+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);\n+  const location = useLocation();\n+  useEffect(() => { setMobile(false); }, [location.pathname]);\n+  useEffect(() => () => clearTimeout(timer.current), []);\n+  function notify(text: string) { setToast(text); clearTimeout(timer.current); timer.current = setTimeout(() => setToast(\"\"), 5000); }\n+  const detail = location.pathname !== \"/customers\";\n+  return <div className=\"min-h-dvh bg-[#f8f9fb] text-slate-800\">\n+    {mobile && <button aria-label=\"Close menu\" onClick={() => setMobile(false)} className=\"fixed inset-0 z-30 bg-slate-950/25 lg:hidden\" />}\n+    <aside className={`fixed inset-y-0 left-0 z-40 flex w-[244px] flex-col border-r border-slate-200/75 bg-white transition-transform lg:translate-x-0 ${mobile ? \"translate-x-0\" : \"-translate-x-full\"}`}>\n+      <Link to=\"/customers\" className=\"flex h-[84px] items-center px-6\"><Logo /></Link>\n+      <div className=\"mx-5 flex items-center gap-3 rounded-lg border border-slate-200/80 px-3 py-3\"><span className=\"flex size-8 items-center justify-center rounded-md bg-[#f1f2ee] text-brand-700\"><Leaf size={17} /></span><div><p className=\"text-[13px] font-semibold\">Team workspace</p><p className=\"mt-0.5 text-[11px] text-slate-400\">Shared customer directory</p></div><ShieldCheck size={14} className=\"ml-auto text-slate-400\" /></div>\n+      <nav aria-label=\"Main navigation\" className=\"mt-8 px-4\"><p className=\"mb-3 px-3 text-[10px] font-semibold tracking-[1.5px] text-slate-400\">WORKSPACE</p><NavLink to=\"/customers\" className=\"flex items-center gap-3 rounded-lg bg-brand-50 px-3 py-3 text-sm font-medium text-brand-700\"><Users size={18} strokeWidth={1.7} />Customers<span className=\"ml-auto size-1.5 rounded-full bg-brand-500\" /></NavLink><button onClick={() => setGuide(true)} className=\"mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-3 text-sm text-slate-500 transition hover:bg-slate-50 hover:text-slate-800\"><BookOpen size={18} strokeWidth={1.7} />Workspace guide<ArrowUpRight size={14} className=\"ml-auto text-slate-400\" /></button></nav>\n+      <div className=\"mx-5 mb-6 mt-auto rounded-xl border border-brand-100/70 bg-[#f7faf7] p-4\"><span className=\"flex size-8 items-center justify-center rounded-lg bg-brand-100/60 text-brand-600\"><MessageIllustration /></span><h3 className=\"mt-3 text-xs font-semibold text-brand-900\">Small details. Stronger connections.</h3><p className=\"mt-2 text-xs leading-5 text-slate-500\">Log a conversation today. Your teammates will thank you tomorrow.</p></div>\n+      <div className=\"border-t border-slate-100 p-4\"><div className=\"flex items-center gap-3 rounded-lg px-2 py-1\"><span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[#ecece6] text-xs font-semibold text-slate-600\">{initials(user!.username)}</span><div className=\"min-w-0\"><p className=\"truncate text-sm font-medium\">{user!.username}</p><p className=\"mt-0.5 text-[11px] text-slate-400\">Team member</p></div><button title=\"Sign out\" aria-label=\"Sign out\" onClick={() => { void signOut().catch(() => {}); }} className=\"ml-auto rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700\"><LogOut size={16} /></button></div></div>\n+    </aside>\n+    <div className=\"lg:ml-[244px]\">\n+      <header className=\"flex h-[72px] items-center justify-between border-b border-slate-200/75 bg-white px-5 sm:px-9\"><div className=\"flex items-center gap-3\"><button onClick={() => setMobile(!mobile)} aria-label=\"Open menu\" className=\"rounded-lg p-2 text-slate-500 lg:hidden\"><Menu size={20} /></button><span className=\"hidden text-[13px] text-slate-400 sm:inline\">Workspace</span><ChevronRight size={14} className=\"hidden text-slate-300 sm:block\" /><Link to=\"/customers\" className={`text-[13px] ${detail ? \"text-slate-500 hover:text-brand-700\" : \"font-medium text-slate-700\"}`}>Customers</Link>{detail && <><ChevronRight size={14} className=\"text-slate-300\" /><span className=\"text-[13px] font-medium\">Customer profile</span></>}</div><div className=\"flex items-center gap-5\"><span className=\"hidden items-center gap-1.5 text-xs text-slate-400 md:inline-flex\"><span className=\"size-1.5 rounded-full bg-brand-500\" /> Your team, in sync</span><button onClick={() => setGuide(true)} title=\"Workspace guide\" aria-label=\"Workspace guide\" className=\"rounded-full p-2 text-slate-400 hover:bg-slate-50 hover:text-brand-700\"><CircleHelp size={18} /></button><span className=\"flex size-8 items-center justify-center rounded-full border border-brand-100 bg-brand-50 text-[11px] font-semibold text-brand-700\">{initials(user!.username)}</span></div></header>\n+      <main className=\"mx-auto max-w-[1500px] px-5 py-8 sm:px-9 lg:py-10\"><Outlet context={{ notify } satisfies LayoutContext} /></main>\n+      <footer className=\"mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-2 px-5 pb-7 pt-4 text-[11px] text-slate-400 sm:px-9\"><span>Made for people, not spreadsheets.</span><span className=\"flex items-center gap-1.5\"><ShieldCheck size={12} /> Private to your team</span></footer>\n+    </div>\n+    {toast && <div role=\"status\" className=\"fixed bottom-6 right-5 z-50 flex max-w-[calc(100%-2.5rem)] items-center gap-3 rounded-xl border border-brand-100 bg-white px-5 py-4 text-sm shadow-lg\"><CheckCircle2 size={18} className=\"text-brand-600\" />{toast}<button onClick={() => setToast(\"\")} aria-label=\"Dismiss notification\" className=\"ml-3 text-slate-400\"><X size={16} /></button></div>}\n+    {guide && <Modal title=\"A little guide to Commonplace\" description=\"Good relationships are a team effort.\" onClose={() => setGuide(false)}><div className=\"space-y-5 p-6 text-sm leading-6 text-slate-500\"><div><h3 className=\"font-semibold text-slate-800\">One directory, shared by everyone</h3><p>Every signed-in member can view, add, edit, and delete customers. Search by name, contact details, company, or notes.</p></div><div><h3 className=\"font-semibold text-slate-800\">Keep the conversation going</h3><p>Open a customer to log a call, email, or meeting. Add a summary and the time it happened; your name is attached automatically.</p></div><div><h3 className=\"font-semibold text-slate-800\">A few thoughtful details</h3><p>Customer emails are unique. Last contacted reflects the latest interaction, even if an older conversation is logged later. Deleting a customer also removes their interaction history.</p></div><div className=\"flex items-center gap-2 border-t border-slate-100 pt-4 text-xs\"><ShieldCheck size={16} className=\"text-brand-600\" /> Your directory is only accessible to signed-in team members.</div></div></Modal>}\n+  </div>;\n+}\n+\n+function MessageIllustration() { return <BookOpen size={17} strokeWidth={1.6} />; }\n\nIndex: /workspace/frontend/src/CustomerForm.tsx\n===================================================================\n--- /workspace/frontend/src/CustomerForm.tsx\n+++ /workspace/frontend/src/CustomerForm.tsx\n@@ -0,0 +1,34 @@\n+import { useState, type FormEvent } from \"react\";\n+import { LoaderCircle, Plus, Save } from \"lucide-react\";\n+import { api, ApiError, message, type Customer } from \"./api\";\n+import { Alert, Field, inputClass, Modal, primaryButton, secondaryButton } from \"./ui\";\n+\n+export function CustomerForm({ customer, onClose, onSaved }: { customer?: Customer; onClose: () => void; onSaved: (customer: Customer) => void }) {\n+  const [values, setValues] = useState({ name: customer?.name || \"\", email: customer?.email || \"\", phone: customer?.phone || \"\", company: customer?.company || \"\", notes: customer?.notes || \"\" });\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  const [busy, setBusy] = useState(false);\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({});\n+    try {\n+      const saved = await api<Customer>(customer ? `/customers/${customer.id}` : \"/customers\", { method: customer ? \"PUT\" : \"POST\", body: JSON.stringify(values) });\n+      onSaved(saved);\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  function field(key: keyof typeof values, label: string, placeholder: string, type = \"text\") {\n+    return <Field label={label} id={`customer-${key}`} error={errors[key]} required={key === \"name\"}>\n+      <input id={`customer-${key}`} type={type} autoFocus={key === \"name\"} value={values[key]} placeholder={placeholder} onChange={(event) => setValues({ ...values, [key]: event.target.value })} disabled={busy} className={`${inputClass} ${errors[key] ? \"border-red-300\" : \"\"}`} aria-invalid={!!errors[key]} aria-describedby={errors[key] ? `customer-${key}-error` : undefined} />\n+    </Field>;\n+  }\n+  return <Modal title={customer ? \"Edit customer\" : \"Add a customer\"} description={customer ? \"Keep their details up to date for your whole team.\" : \"A new connection starts with the essentials.\"} onClose={() => { if (!busy) onClose(); }}>\n+    <form onSubmit={submit} noValidate><div className=\"space-y-5 p-6\">\n+      {error && <Alert>{error}</Alert>}\n+      {field(\"name\", \"Full name\", \"e.g. Alex Morgan\")}\n+      <div className=\"grid gap-5 sm:grid-cols-2\">{field(\"email\", \"Email address\", \"alex@company.com\", \"email\")}{field(\"phone\", \"Phone number\", \"+1 (555) 000-0000\", \"tel\")}</div>\n+      {field(\"company\", \"Company\", \"Where they work\")}\n+      <Field label=\"Notes\" id=\"customer-notes\" error={errors.notes} hint=\"A little context for your teammates.\"><textarea id=\"customer-notes\" rows={3} value={values.notes} onChange={(event) => setValues({ ...values, notes: event.target.value })} disabled={busy} placeholder=\"What would be helpful to remember?\" className={`${inputClass} resize-y`} aria-invalid={!!errors.notes} aria-describedby={errors.notes ? \"customer-notes-error\" : undefined} /></Field>\n+      <p className=\"text-xs text-slate-400\"><span className=\"text-brand-600\">*</span> Required field. All other details are optional.</p>\n+    </div><div className=\"flex justify-end gap-3 border-t border-slate-100 bg-slate-50/50 px-6 py-4\"><button type=\"button\" disabled={busy} onClick={onClose} className={secondaryButton}>Cancel</button><button disabled={busy} className={primaryButton}>{busy ? <LoaderCircle size={16} className=\"animate-spin\" /> : customer ? <Save size={16} /> : <Plus size={16} />}{busy ? \"Saving…\" : customer ? \"Save changes\" : \"Add customer\"}</button></div></form>\n+  </Modal>;\n+}\n\nIndex: /workspace/frontend/src/Customers.tsx\n===================================================================\n--- /workspace/frontend/src/Customers.tsx\n+++ /workspace/frontend/src/Customers.tsx\n@@ -0,0 +1,75 @@\n+import { useEffect, useState } from \"react\";\n+import { Link, useOutletContext, useSearchParams } from \"react-router-dom\";\n+import { ArrowDownAZ, ArrowRight, Building2, ChevronLeft, ChevronRight, Clock3, Filter, MessageSquare, Plus, Search, Users, X } from \"lucide-react\";\n+import { api, date, initials, message, type CustomerPage, type Overview } from \"./api\";\n+import { Alert, inputClass, primaryButton, secondaryButton, Spinner } from \"./ui\";\n+import { CustomerForm } from \"./CustomerForm\";\n+import type { LayoutContext } from \"./Layout\";\n+\n+const avatarColors = [\"bg-[#e8eee5] text-[#697c55]\", \"bg-[#eeebf6] text-[#8671a3]\", \"bg-[#f4eae2] text-[#ac825f]\", \"bg-[#e5edf3] text-[#6985a0]\", \"bg-[#f3e6e7] text-[#ad747e]\"];\n+\n+export function Customers() {\n+  const { notify } = useOutletContext<LayoutContext>();\n+  const [params, setParams] = useSearchParams();\n+  const q = params.get(\"q\") || \"\";\n+  const company = params.get(\"company\") || \"\";\n+  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n+  const pageSize = [10, 20, 50].includes(Number(params.get(\"page_size\"))) ? Number(params.get(\"page_size\")) : 10;\n+  const [search, setSearch] = useState(q);\n+  const [result, setResult] = useState<CustomerPage | null>(null);\n+  const [overview, setOverview] = useState<Overview | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [loading, setLoading] = useState(true);\n+  const [add, setAdd] = useState(false);\n+  const [revision, setRevision] = useState(0);\n+  useEffect(() => { setSearch(q); }, [q]);\n+  useEffect(() => {\n+    if (search === q) return;\n+    const timer = setTimeout(() => {\n+      setParams((old) => { const next = new URLSearchParams(old); if (search.trim()) next.set(\"q\", search.trim()); else next.delete(\"q\"); next.delete(\"page\"); return next; }, { replace: true });\n+    }, 300);\n+    return () => clearTimeout(timer);\n+  }, [search, q, setParams]);\n+  useEffect(() => {\n+    let active = true;\n+    setLoading(true); setError(\"\");\n+    const query = new URLSearchParams({ q, company, page: String(page), page_size: String(pageSize) });\n+    api<CustomerPage>(`/customers?${query}`).then((data) => {\n+      if (!active) return;\n+      if (page > 1 && data.items.length === 0 && data.total > 0) {\n+        setParams((old) => { const next = new URLSearchParams(old); next.set(\"page\", String(Math.ceil(data.total / pageSize))); return next; }, { replace: true });\n+      } else setResult(data);\n+    }).catch((err) => { if (active) setError(message(err)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [q, company, page, pageSize, revision, setParams]);\n+  useEffect(() => {\n+    let active = true;\n+    api<Overview>(\"/overview\").then((data) => { if (active) setOverview(data); }).catch(() => {});\n+    return () => { active = false; };\n+  }, [revision]);\n+  function filter(key: string, value: string) {\n+    setParams((old) => { const next = new URLSearchParams(old); if (value) next.set(key, value); else next.delete(key); if (key !== \"page\") next.delete(\"page\"); return next; });\n+  }\n+  const filtered = !!(q || company);\n+  const total = result?.total || 0;\n+  const pages = Math.max(1, Math.ceil(total / pageSize));\n+  return <>\n+    <div className=\"mb-8 flex flex-wrap items-center justify-between gap-5\"><div><p className=\"mb-2 text-[10px] font-semibold tracking-[1.7px] text-brand-600\">A LITTLE CONTEXT. A BETTER CONNECTION.</p><div className=\"flex items-center gap-3\"><h1 className=\"text-[30px] font-semibold tracking-[-1px]\">Customers</h1><span className=\"rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-medium text-slate-500\">{overview?.customers ?? \"—\"}</span></div><p className=\"mt-2 text-[13px] text-slate-500\">Your people, their details, and every conversation in between.</p></div><button onClick={() => setAdd(true)} className={primaryButton}><Plus size={17} />Add customer</button></div>\n+    <div className=\"mb-8 grid grid-cols-2 gap-3 xl:grid-cols-4 xl:gap-5\">\n+      {[\n+        { label: \"Total customers\", value: overview?.customers, icon: Users, color: \"bg-brand-50 text-brand-600\", note: \"Connections in your directory\" },\n+        { label: \"Companies\", value: overview?.companies, icon: Building2, color: \"bg-[#f1eef8] text-[#8b79b4]\", note: \"Organizations you work with\" },\n+        { label: \"Contacted recently\", value: overview?.contacted, icon: Clock3, color: \"bg-[#fcf3e5] text-[#bd9452]\", note: \"Customers in the last 30 days\" },\n+        { label: \"Interactions logged\", value: overview?.interactions, icon: MessageSquare, color: \"bg-[#ecf2fa] text-[#6a8cba]\", note: \"Conversations, kept together\" },\n+      ].map(({ label, value, icon: Icon, color, note }) => <div key={label} className=\"rounded-xl border border-slate-200/80 bg-white p-4 sm:p-5\"><div className=\"flex items-center justify-between gap-2\"><p className=\"text-xs font-medium text-slate-500\">{label}</p><span className={`flex size-8 shrink-0 items-center justify-center rounded-lg ${color}`}><Icon size={16} strokeWidth={1.7} /></span></div><p className=\"mt-3 text-[28px] font-semibold leading-none tracking-tight\">{value ?? \"—\"}</p><p className=\"mt-3 hidden text-[11px] text-slate-400 sm:block\">{note}</p></div>)}\n+    </div>\n+    <section aria-label=\"Customer directory\" className=\"overflow-hidden rounded-xl border border-slate-200/80 bg-white\">\n+      <div className=\"flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6\"><div className=\"flex items-center gap-2.5\"><h2 className=\"text-sm font-semibold\">All customers</h2><span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500\">{total}</span></div><span className=\"flex items-center gap-1.5 text-[11px] text-slate-400\"><ArrowDownAZ size={14} />Sorted by name</span></div>\n+      <div className=\"flex flex-wrap items-center gap-3 px-5 py-4 sm:px-6\"><div className=\"relative w-full sm:max-w-[330px] sm:flex-1\"><Search size={16} className=\"absolute left-3 top-3 text-slate-400\" /><input aria-label=\"Search customers\" placeholder=\"Search name, email, company…\" value={search} onChange={(event) => setSearch(event.target.value)} className={`${inputClass} py-2.5 pl-9 pr-9 text-xs`} />{search && <button aria-label=\"Clear search\" onClick={() => { setSearch(\"\"); filter(\"q\", \"\"); }} className=\"absolute right-3 top-3 text-slate-400 hover:text-slate-600\"><X size={14} /></button>}</div><div className=\"relative min-w-[175px]\"><Building2 size={14} className=\"pointer-events-none absolute left-3 top-3.5 text-slate-400\" /><select aria-label=\"Filter by company\" value={company} onChange={(event) => filter(\"company\", event.target.value)} className={`${inputClass} appearance-none py-2.5 pl-9 pr-9 text-xs`}><option value=\"\">All companies</option>{company && !overview?.company_options.includes(company) && <option value={company}>{company}</option>}{overview?.company_options.map((item) => <option key={item} value={item}>{item}</option>)}</select><ChevronRight size={14} className=\"pointer-events-none absolute right-3 top-3.5 rotate-90 text-slate-400\" /></div>{filtered && <button onClick={() => { setSearch(\"\"); setParams({}); }} className=\"flex items-center gap-1.5 text-xs text-slate-500 hover:text-brand-700\"><X size={13} />Clear filters</button>}<span className=\"ml-auto hidden text-[11px] text-slate-400 xl:inline\">A shared view for your whole team</span></div>\n+      {error ? <div className=\"px-6 pb-6\"><Alert>{error} <button onClick={() => setRevision(revision + 1)} className=\"ml-2 font-semibold underline\">Try again</button></Alert></div> : loading ? <Spinner label=\"Finding your customers…\" /> : result?.items.length ? <div className=\"overflow-x-auto\"><table className=\"w-full whitespace-nowrap text-left text-xs\"><thead className=\"border-y border-slate-100 bg-[#fafbfc] text-[10px] font-medium uppercase tracking-[0.65px] text-slate-400\"><tr><th scope=\"col\" className=\"px-6 py-3.5 font-medium\">Name <span className=\"ml-1 text-brand-600\">↓</span></th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Email address</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Phone</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Company</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Last contacted</th><th scope=\"col\" className=\"py-3.5 pr-5\"><span className=\"sr-only\">View customer</span></th></tr></thead><tbody className=\"divide-y divide-slate-100\">{result.items.map((customer) => <tr key={customer.id} className=\"group transition hover:bg-brand-50/35\"><td className=\"px-6 py-4\"><Link to={`/customers/${customer.id}`} className=\"flex items-center gap-3 rounded-md focus-visible:outline-brand-500\"><span className={`flex size-9 shrink-0 items-center justify-center rounded-full text-[11px] font-medium ${avatarColors[customer.id % avatarColors.length]}`}>{initials(customer.name)}</span><span className=\"max-w-[220px] truncate text-[13px] font-semibold text-slate-700 group-hover:text-brand-700\">{customer.name}</span></Link></td><td className=\"px-4 py-4 text-slate-500\">{customer.email ? <a href={`mailto:${customer.email}`} className=\"hover:text-brand-700\">{customer.email}</a> : <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4 text-slate-500\">{customer.phone || <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4\">{customer.company ? <span className=\"inline-flex max-w-[180px] items-center gap-1.5 rounded-md border border-slate-200/70 bg-slate-50 px-2 py-1 text-[11px] text-slate-600\"><Building2 size={11} className=\"shrink-0 text-slate-400\" /><span className=\"truncate\">{customer.company}</span></span> : <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4\">{customer.last_contacted_at ? <span className=\"flex items-center gap-1.5 text-slate-500\"><span className=\"size-1.5 rounded-full bg-brand-500/65\" />{date(customer.last_contacted_at)}</span> : <span className=\"text-[11px] text-slate-400\">Not contacted yet</span>}</td><td className=\"pr-5\"><Link to={`/customers/${customer.id}`} aria-label={`View ${customer.name}`} className=\"inline-flex rounded-lg p-2 text-slate-300 hover:bg-brand-50 hover:text-brand-600\"><ChevronRight size={16} /></Link></td></tr>)}</tbody></table></div> : <div className=\"flex min-h-[320px] flex-col items-center justify-center border-t border-slate-100 px-6 py-12 text-center\"><span className=\"mb-5 flex size-16 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 shadow-[0_5px_0_0_#f7faf7]\">{filtered ? <Filter size={27} className=\"text-brand-500\" strokeWidth={1.4} /> : <Users size={28} className=\"text-brand-500\" strokeWidth={1.4} />}</span><h3 className=\"text-base font-semibold\">{filtered ? \"No matching connections\" : \"Your next connection starts here\"}</h3><p className=\"mt-2 max-w-sm text-xs leading-6 text-slate-400\">{filtered ? \"Try a different search or company to find who you’re looking for.\" : \"Add your first customer and give your team a shared place to keep the details that matter.\"}</p><button onClick={() => { if (filtered) { setSearch(\"\"); setParams({}); } else setAdd(true); }} className={`${filtered ? secondaryButton : primaryButton} mt-5`}>{filtered ? \"Clear filters\" : <><Plus size={15} />Add your first customer</>}</button></div>}\n+      <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 px-5 py-4 text-[11px] text-slate-400 sm:px-6\"><div className=\"flex items-center gap-4\"><p>{total ? `Showing ${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, total)} of ${total} customers` : \"0 customers\"}</p><label className=\"hidden items-center gap-2 sm:inline-flex\">Rows per page<select aria-label=\"Rows per page\" value={pageSize} onChange={(event) => filter(\"page_size\", event.target.value)} className=\"rounded-md border border-slate-200 bg-white p-1 text-slate-600 outline-brand-500\"><option>10</option><option>20</option><option>50</option></select></label></div><div className=\"flex items-center gap-2\"><button aria-label=\"Previous page\" disabled={page <= 1 || loading} onClick={() => filter(\"page\", String(page - 1))} className=\"rounded-md border border-slate-200 p-1.5 text-slate-500 transition hover:bg-slate-50 disabled:opacity-35\"><ChevronLeft size={14} /></button><span className=\"px-2 text-slate-500\">Page <span className=\"font-medium text-slate-700\">{page}</span> of {pages}</span><button aria-label=\"Next page\" disabled={page >= pages || loading} onClick={() => filter(\"page\", String(page + 1))} className=\"rounded-md border border-slate-200 p-1.5 text-slate-500 transition hover:bg-slate-50 disabled:opacity-35\"><ChevronRight size={14} /></button></div></div>\n+    </section>\n+    <p className=\"mt-5 flex items-center gap-2 text-[11px] text-slate-400\"><Users size={13} />Every customer is shared with your team. Great relationships don’t happen alone.<ArrowRight size={12} className=\"hidden sm:block\" /></p>\n+    {add && <CustomerForm onClose={() => setAdd(false)} onSaved={() => { setAdd(false); setRevision(revision + 1); notify(\"Customer added to your directory.\"); }} />}\n+  </>;\n+}\n\n","files":[{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"lucide-react\": \"1.71.0\",\n   \"react\": \"19.3.1\",\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,19 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"esModuleInterop\": true,\n+    \"resolveJsonModule\": true,\n+    \"isolatedModules\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":19,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,10 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist/**\", \"node_modules/**\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  { languageOptions: { globals: { ...globals.browser, ...globals.node } } },\n+);\n","additions":10,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,13 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", system-ui, sans-serif;\n+  --color-brand-50: #edf6f0;\n+  --color-brand-100: #daeade;\n+  --color-brand-200: #b8d6c4;\n+  --color-brand-500: #378463;\n+  --color-brand-600: #28694f;\n+  --color-brand-700: #215640;\n+  --color-brand-800: #194533;\n+  --color-brand-900: #173c2e;\n+}\n","additions":13,"deletions":0},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,11 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#215640\" />\n+    <meta name=\"description\" content=\"Commonplace is your team's shared customer directory. Keep contacts, conversations, and relationships in one place.\" />\n+    <title>Commonplace · Customer directory</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,71 @@\n+export type Customer = {\n+  id: number;\n+  name: string;\n+  email: string | null;\n+  phone: string | null;\n+  company: string | null;\n+  notes: string | null;\n+  created_at: string;\n+  interaction_count: number;\n+  last_contacted_at: string | null;\n+};\n+\n+export type Interaction = {\n+  id: number;\n+  customer_id: number;\n+  kind: \"call\" | \"email\" | \"meeting\";\n+  summary: string;\n+  occurred_at: string;\n+  logged_by: string;\n+};\n+\n+export type CustomerPage = { items: Customer[]; total: number; page: number; page_size: number };\n+export type Overview = { customers: number; companies: number; interactions: number; contacted: number; company_options: string[] };\n+export type User = { id: number; username: string };\n+\n+export class ApiError extends Error {\n+  status: number;\n+  errors: Record<string, string>;\n+  constructor(message: string, status: number, errors: Record<string, string> = {}) {\n+    super(message);\n+    this.status = status;\n+    this.errors = errors;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}): Promise<T> {\n+  const token = localStorage.getItem(\"commonplace-token\");\n+  const response = await fetch(`/api${path}`, {\n+    ...options,\n+    headers: {\n+      ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n+      ...(token ? { Authorization: `Bearer ${token}` } : {}),\n+      ...options.headers,\n+    },\n+  });\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json();\n+  if (!response.ok) {\n+    if (response.status === 401 && !path.startsWith(\"/auth/login\")) {\n+      window.dispatchEvent(new Event(\"commonplace-session-expired\"));\n+    }\n+    throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function message(error: unknown) {\n+  return error instanceof Error ? error.message : \"Something went wrong. Please try again.\";\n+}\n+\n+export function date(value: string | null, withTime = false) {\n+  if (!value) return \"Not contacted yet\";\n+  return new Intl.DateTimeFormat(undefined, {\n+    month: \"short\", day: \"numeric\", year: \"numeric\",\n+    ...(withTime ? { hour: \"numeric\", minute: \"2-digit\" } : {}),\n+  }).format(new Date(value));\n+}\n+\n+export function initials(name: string) {\n+  return name.trim().split(/\\s+/).slice(0, 2).map((part) => part[0]).join(\"\").toUpperCase();\n+}\n","additions":71,"deletions":0},{"filePath":"/workspace/frontend/src/ui.tsx","relativePath":"frontend/src/ui.tsx","type":"add","patch":"Index: /workspace/frontend/src/ui.tsx\n===================================================================\n--- /workspace/frontend/src/ui.tsx\n+++ /workspace/frontend/src/ui.tsx\n@@ -0,0 +1,48 @@\n+import { useEffect, useRef, type ReactNode } from \"react\";\n+import { AlertCircle, Check, Leaf, LoaderCircle, X } from \"lucide-react\";\n+\n+export const inputClass = \"w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-3 focus:ring-brand-50 disabled:bg-slate-50\";\n+export const primaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 disabled:cursor-not-allowed disabled:opacity-50\";\n+export const secondaryButton = \"inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-brand-500 disabled:cursor-not-allowed disabled:opacity-40\";\n+\n+export function Logo({ light = false }: { light?: boolean }) {\n+  return <span className={`inline-flex items-center gap-2.5 ${light ? \"text-white\" : \"text-brand-900\"}`}>\n+    <span className={`flex size-9 items-center justify-center rounded-xl ${light ? \"bg-white/10\" : \"bg-brand-700\"}`}><Leaf size={20} className=\"text-white\" strokeWidth={1.7} /></span>\n+    <span className=\"text-[21px] font-semibold tracking-[-0.8px]\">commonplace<span className=\"text-brand-500\">.</span></span>\n+  </span>;\n+}\n+\n+export function Spinner({ label = \"Loading…\" }: { label?: string }) {\n+  return <div role=\"status\" className=\"flex items-center justify-center gap-2.5 py-14 text-sm text-slate-500\"><LoaderCircle size={18} className=\"animate-spin\" />{label}</div>;\n+}\n+\n+export function Alert({ children, success = false }: { children: ReactNode; success?: boolean }) {\n+  return <div role={success ? \"status\" : \"alert\"} className={`flex items-start gap-2.5 rounded-lg border p-3 text-sm ${success ? \"border-brand-100 bg-brand-50 text-brand-700\" : \"border-red-100 bg-red-50 text-red-700\"}`}>\n+    {success ? <Check size={17} className=\"mt-0.5 shrink-0\" /> : <AlertCircle size={17} className=\"mt-0.5 shrink-0\" />}<div>{children}</div>\n+  </div>;\n+}\n+\n+export function Field({ label, id, error, hint, required, children }: { label: string; id: string; error?: string; hint?: string; required?: boolean; children: ReactNode }) {\n+  return <div className=\"space-y-1.5\">\n+    <label htmlFor={id} className=\"block text-sm font-medium text-slate-700\">{label}{required && <span className=\"ml-1 text-brand-600\">*</span>}</label>\n+    {children}\n+    {error ? <p id={`${id}-error`} role=\"alert\" className=\"text-xs text-red-600\">{error}</p> : hint ? <p className=\"text-xs text-slate-400\">{hint}</p> : null}\n+  </div>;\n+}\n+\n+export function Modal({ title, description, children, onClose }: { title: string; description?: string; children: ReactNode; onClose: () => void }) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+  useEffect(() => {\n+    ref.current?.showModal();\n+    const old = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => { document.body.style.overflow = old; };\n+  }, []);\n+  return <dialog ref={ref} aria-labelledby=\"modal-title\" onCancel={(event) => { event.preventDefault(); onClose(); }} onClick={(event) => { if (event.target === event.currentTarget) onClose(); }} className=\"fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-2xl bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-950/35 backdrop:backdrop-blur-[3px]\">\n+    <div className=\"flex items-start justify-between border-b border-slate-100 px-6 py-5\">\n+      <div><h2 id=\"modal-title\" className=\"text-lg font-semibold tracking-tight\">{title}</h2>{description && <p className=\"mt-1 text-sm text-slate-500\">{description}</p>}</div>\n+      <button type=\"button\" onClick={onClose} aria-label=\"Close dialog\" className=\"-mr-1 rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700\"><X size={18} /></button>\n+    </div>\n+    {children}\n+  </dialog>;\n+}\n","additions":48,"deletions":0},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"delete","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n","additions":0,"deletions":4},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"add","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,50 @@\n+import { createContext, useContext, useEffect, useState, type ReactNode } from \"react\";\n+import { BrowserRouter, Navigate, Route, Routes } from \"react-router-dom\";\n+import { api, type User } from \"./api\";\n+import { AuthScreen } from \"./AuthScreen\";\n+import { Layout } from \"./Layout\";\n+import { Customers } from \"./Customers\";\n+import { CustomerDetail } from \"./CustomerDetail\";\n+import { Spinner } from \"./ui\";\n+\n+const AuthContext = createContext<{ user: User | null; signIn: (token: string) => Promise<void>; signOut: () => Promise<void> }>({ user: null, signIn: async () => {}, signOut: async () => {} });\n+export function useAuth() { return useContext(AuthContext); }\n+\n+function AuthProvider({ children }: { children: ReactNode }) {\n+  const [user, setUser] = useState<User | null>(null);\n+  const [loading, setLoading] = useState(true);\n+  useEffect(() => {\n+    const expire = () => { localStorage.removeItem(\"commonplace-token\"); setUser(null); };\n+    window.addEventListener(\"commonplace-session-expired\", expire);\n+    if (localStorage.getItem(\"commonplace-token\")) {\n+      api<User>(\"/auth/me\").then(setUser).catch(expire).finally(() => setLoading(false));\n+    } else setLoading(false);\n+    return () => window.removeEventListener(\"commonplace-session-expired\", expire);\n+  }, []);\n+  async function signIn(token: string) {\n+    localStorage.setItem(\"commonplace-token\", token);\n+    setUser(await api<User>(\"/auth/me\"));\n+  }\n+  async function signOut() {\n+    try { await api(\"/auth/logout\", { method: \"POST\" }); }\n+    finally { localStorage.removeItem(\"commonplace-token\"); setUser(null); }\n+  }\n+  if (loading) return <div className=\"flex min-h-dvh items-center justify-center bg-[#f8faf9]\"><Spinner label=\"Opening your workspace…\" /></div>;\n+  return <AuthContext.Provider value={{ user, signIn, signOut }}>{children}</AuthContext.Provider>;\n+}\n+\n+function AppRoutes() {\n+  const { user } = useAuth();\n+  return <Routes>\n+    <Route path=\"/login\" element={user ? <Navigate to=\"/customers\" replace /> : <AuthScreen />} />\n+    <Route element={user ? <Layout /> : <Navigate to=\"/login\" replace />}>\n+      <Route path=\"/customers\" element={<Customers />} />\n+      <Route path=\"/customers/:id\" element={<CustomerDetail />} />\n+    </Route>\n+    <Route path=\"*\" element={<Navigate to={user ? \"/customers\" : \"/login\"} replace />} />\n+  </Routes>;\n+}\n+\n+export default function App() {\n+  return <BrowserRouter><AuthProvider><AppRoutes /></AuthProvider></BrowserRouter>;\n+}\n","additions":50,"deletions":0},{"filePath":"/workspace/frontend/src/AuthScreen.tsx","relativePath":"frontend/src/AuthScreen.tsx","type":"add","patch":"Index: /workspace/frontend/src/AuthScreen.tsx\n===================================================================\n--- /workspace/frontend/src/AuthScreen.tsx\n+++ /workspace/frontend/src/AuthScreen.tsx\n@@ -0,0 +1,63 @@\n+import { useState, type FormEvent } from \"react\";\n+import { ArrowRight, Check, Eye, EyeOff, LockKeyhole, Mail, MessageSquare, Users } from \"lucide-react\";\n+import { api, ApiError, message } from \"./api\";\n+import { useAuth } from \"./App\";\n+import { Alert, Field, inputClass, Logo, primaryButton } from \"./ui\";\n+\n+export function AuthScreen() {\n+  const { signIn } = useAuth();\n+  const [register, setRegister] = useState(false);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [visible, setVisible] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  const [success, setSuccess] = useState(\"\");\n+  function changeMode(mode: boolean) { setRegister(mode); setError(\"\"); setErrors({}); setSuccess(\"\"); }\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({}); setSuccess(\"\");\n+    try {\n+      if (register) {\n+        await api(\"/auth/register\", { method: \"POST\", body: JSON.stringify({ username, password }) });\n+        setRegister(false); setPassword(\"\"); setSuccess(\"Account created. Sign in to join your workspace.\");\n+      } else {\n+        const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body: JSON.stringify({ username, password }) });\n+        await signIn(token);\n+      }\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  return <div className=\"min-h-dvh bg-[#fcfcfa] lg:grid lg:grid-cols-[1fr_1fr]\">\n+    <section className=\"relative flex flex-col overflow-hidden bg-brand-900 px-8 py-8 text-white lg:min-h-dvh lg:px-16 lg:py-12 xl:px-20\">\n+      <Logo light />\n+      <div className=\"relative z-10 my-auto max-w-lg py-14 lg:py-20\">\n+        <span className=\"inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs text-brand-200\"><span className=\"size-1.5 rounded-full bg-brand-200\" /> A shared space for your team</span>\n+        <h1 className=\"mt-7 font-serif text-5xl leading-[1.12] tracking-[-1.5px] xl:text-6xl\">People first.<br />Everything else,<br /><span className=\"text-brand-200\">in one place.</span></h1>\n+        <p className=\"mt-6 max-w-sm text-[15px] leading-7 text-white/60\">A little context makes a big difference. Keep your customers and conversations together, so every relationship feels personal.</p>\n+        <div className=\"relative mt-12 hidden max-w-sm rounded-2xl border border-white/15 bg-white/[0.07] p-6 shadow-xl sm:block\">\n+          <div className=\"flex items-center gap-3\"><div className=\"flex size-11 items-center justify-center rounded-full bg-brand-200 text-brand-800\"><Users size={21} /></div><div><p className=\"text-sm font-medium\">Better together</p><p className=\"mt-1 text-xs text-white/45\">One directory. Your whole team.</p></div><span className=\"ml-auto flex size-7 items-center justify-center rounded-full bg-white/10\"><Check size={14} className=\"text-brand-200\" /></span></div>\n+          <div className=\"mt-5 space-y-3 border-t border-white/10 pt-5\"><p className=\"flex items-center gap-3 text-xs text-white/65\"><Mail size={15} className=\"text-brand-200\" /> Every contact, easy to find</p><p className=\"flex items-center gap-3 text-xs text-white/65\"><MessageSquare size={15} className=\"text-brand-200\" /> Every conversation, remembered</p></div>\n+        </div>\n+      </div>\n+      <div className=\"relative z-10 flex items-center gap-2 text-xs text-white/40\"><LockKeyhole size={13} /> Private to your team. Built around your customers.</div>\n+      <div aria-hidden=\"true\" className=\"pointer-events-none absolute -bottom-48 -right-48 size-[600px] rounded-full border border-white/[0.06]\" /><div aria-hidden=\"true\" className=\"pointer-events-none absolute -bottom-24 -right-24 size-[360px] rounded-full border border-white/[0.06]\" />\n+    </section>\n+    <section className=\"flex flex-col px-7 py-10 sm:px-16 lg:px-20\">\n+      <div className=\"mb-14 flex justify-end text-xs text-slate-400\">THE CUSTOMER DIRECTORY, SIMPLIFIED</div>\n+      <div className=\"mx-auto my-auto w-full max-w-[370px] pb-12\">\n+        <div className=\"mb-8 flex gap-1 rounded-lg bg-slate-100 p-1\"><button disabled={busy} onClick={() => changeMode(false)} className={`flex-1 rounded-md py-2.5 text-sm font-medium transition ${!register ? \"bg-white text-brand-800 shadow-sm\" : \"text-slate-500 hover:text-slate-800\"}`}>Sign in</button><button disabled={busy} onClick={() => changeMode(true)} className={`flex-1 rounded-md py-2.5 text-sm font-medium transition ${register ? \"bg-white text-brand-800 shadow-sm\" : \"text-slate-500 hover:text-slate-800\"}`}>Create account</button></div>\n+        <h2 className=\"text-3xl font-semibold tracking-[-1px] text-slate-800\">{register ? \"Make yourself at home.\" : \"Welcome back.\"}</h2>\n+        <p className=\"mb-8 mt-2.5 text-sm leading-6 text-slate-500\">{register ? \"Join your team’s shared customer directory.\" : \"Sign in to keep your connections close.\"}</p>\n+        <form onSubmit={submit} noValidate className=\"space-y-5\">\n+          {error && <Alert>{error}</Alert>}{success && <Alert success>{success}</Alert>}\n+          <Field label=\"Username\" id=\"username\" error={errors.username}><input autoFocus id=\"username\" autoComplete=\"username\" value={username} onChange={(event) => setUsername(event.target.value)} disabled={busy} placeholder=\"Your username\" className={inputClass} aria-invalid={!!errors.username} aria-describedby={errors.username ? \"username-error\" : undefined} /></Field>\n+          <Field label=\"Password\" id=\"password\" error={errors.password} hint={register ? \"Use at least 8 characters.\" : undefined}><div className=\"relative\"><input id=\"password\" type={visible ? \"text\" : \"password\"} autoComplete={register ? \"new-password\" : \"current-password\"} value={password} onChange={(event) => setPassword(event.target.value)} disabled={busy} placeholder=\"Your password\" className={`${inputClass} pr-11`} aria-invalid={!!errors.password} aria-describedby={errors.password ? \"password-error\" : undefined} /><button type=\"button\" aria-label={visible ? \"Hide password\" : \"Show password\"} onClick={() => setVisible(!visible)} className=\"absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-700\">{visible ? <EyeOff size={17} /> : <Eye size={17} />}</button></div></Field>\n+          <button disabled={busy} className={`${primaryButton} mt-1 w-full py-3`}>{busy ? \"Please wait…\" : register ? \"Create your account\" : \"Sign in to your workspace\"}{!busy && <ArrowRight size={16} />}</button>\n+        </form>\n+        <p className=\"mt-7 text-center text-xs leading-5 text-slate-400\">{register ? \"Already part of the team?\" : \"New to Commonplace?\"} <button onClick={() => changeMode(!register)} className=\"font-medium text-brand-700 hover:underline\">{register ? \"Sign in\" : \"Create an account\"}</button></p>\n+      </div>\n+      <p className=\"text-center text-xs text-slate-400\">A place for every customer. Context for every conversation.</p>\n+    </section>\n+  </div>;\n+}\n","additions":63,"deletions":0},{"filePath":"/workspace/frontend/src/Layout.tsx","relativePath":"frontend/src/Layout.tsx","type":"add","patch":"Index: /workspace/frontend/src/Layout.tsx\n===================================================================\n--- /workspace/frontend/src/Layout.tsx\n+++ /workspace/frontend/src/Layout.tsx\n@@ -0,0 +1,40 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { Link, NavLink, Outlet, useLocation } from \"react-router-dom\";\n+import { ArrowUpRight, BookOpen, CheckCircle2, ChevronRight, CircleHelp, Leaf, LogOut, Menu, ShieldCheck, Users, X } from \"lucide-react\";\n+import { useAuth } from \"./App\";\n+import { initials } from \"./api\";\n+import { Logo, Modal } from \"./ui\";\n+\n+export type LayoutContext = { notify: (text: string) => void };\n+\n+export function Layout() {\n+  const { user, signOut } = useAuth();\n+  const [mobile, setMobile] = useState(false);\n+  const [guide, setGuide] = useState(false);\n+  const [toast, setToast] = useState(\"\");\n+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);\n+  const location = useLocation();\n+  useEffect(() => { setMobile(false); }, [location.pathname]);\n+  useEffect(() => () => clearTimeout(timer.current), []);\n+  function notify(text: string) { setToast(text); clearTimeout(timer.current); timer.current = setTimeout(() => setToast(\"\"), 5000); }\n+  const detail = location.pathname !== \"/customers\";\n+  return <div className=\"min-h-dvh bg-[#f8f9fb] text-slate-800\">\n+    {mobile && <button aria-label=\"Close menu\" onClick={() => setMobile(false)} className=\"fixed inset-0 z-30 bg-slate-950/25 lg:hidden\" />}\n+    <aside className={`fixed inset-y-0 left-0 z-40 flex w-[244px] flex-col border-r border-slate-200/75 bg-white transition-transform lg:translate-x-0 ${mobile ? \"translate-x-0\" : \"-translate-x-full\"}`}>\n+      <Link to=\"/customers\" className=\"flex h-[84px] items-center px-6\"><Logo /></Link>\n+      <div className=\"mx-5 flex items-center gap-3 rounded-lg border border-slate-200/80 px-3 py-3\"><span className=\"flex size-8 items-center justify-center rounded-md bg-[#f1f2ee] text-brand-700\"><Leaf size={17} /></span><div><p className=\"text-[13px] font-semibold\">Team workspace</p><p className=\"mt-0.5 text-[11px] text-slate-400\">Shared customer directory</p></div><ShieldCheck size={14} className=\"ml-auto text-slate-400\" /></div>\n+      <nav aria-label=\"Main navigation\" className=\"mt-8 px-4\"><p className=\"mb-3 px-3 text-[10px] font-semibold tracking-[1.5px] text-slate-400\">WORKSPACE</p><NavLink to=\"/customers\" className=\"flex items-center gap-3 rounded-lg bg-brand-50 px-3 py-3 text-sm font-medium text-brand-700\"><Users size={18} strokeWidth={1.7} />Customers<span className=\"ml-auto size-1.5 rounded-full bg-brand-500\" /></NavLink><button onClick={() => setGuide(true)} className=\"mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-3 text-sm text-slate-500 transition hover:bg-slate-50 hover:text-slate-800\"><BookOpen size={18} strokeWidth={1.7} />Workspace guide<ArrowUpRight size={14} className=\"ml-auto text-slate-400\" /></button></nav>\n+      <div className=\"mx-5 mb-6 mt-auto rounded-xl border border-brand-100/70 bg-[#f7faf7] p-4\"><span className=\"flex size-8 items-center justify-center rounded-lg bg-brand-100/60 text-brand-600\"><MessageIllustration /></span><h3 className=\"mt-3 text-xs font-semibold text-brand-900\">Small details. Stronger connections.</h3><p className=\"mt-2 text-xs leading-5 text-slate-500\">Log a conversation today. Your teammates will thank you tomorrow.</p></div>\n+      <div className=\"border-t border-slate-100 p-4\"><div className=\"flex items-center gap-3 rounded-lg px-2 py-1\"><span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[#ecece6] text-xs font-semibold text-slate-600\">{initials(user!.username)}</span><div className=\"min-w-0\"><p className=\"truncate text-sm font-medium\">{user!.username}</p><p className=\"mt-0.5 text-[11px] text-slate-400\">Team member</p></div><button title=\"Sign out\" aria-label=\"Sign out\" onClick={() => { void signOut().catch(() => {}); }} className=\"ml-auto rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700\"><LogOut size={16} /></button></div></div>\n+    </aside>\n+    <div className=\"lg:ml-[244px]\">\n+      <header className=\"flex h-[72px] items-center justify-between border-b border-slate-200/75 bg-white px-5 sm:px-9\"><div className=\"flex items-center gap-3\"><button onClick={() => setMobile(!mobile)} aria-label=\"Open menu\" className=\"rounded-lg p-2 text-slate-500 lg:hidden\"><Menu size={20} /></button><span className=\"hidden text-[13px] text-slate-400 sm:inline\">Workspace</span><ChevronRight size={14} className=\"hidden text-slate-300 sm:block\" /><Link to=\"/customers\" className={`text-[13px] ${detail ? \"text-slate-500 hover:text-brand-700\" : \"font-medium text-slate-700\"}`}>Customers</Link>{detail && <><ChevronRight size={14} className=\"text-slate-300\" /><span className=\"text-[13px] font-medium\">Customer profile</span></>}</div><div className=\"flex items-center gap-5\"><span className=\"hidden items-center gap-1.5 text-xs text-slate-400 md:inline-flex\"><span className=\"size-1.5 rounded-full bg-brand-500\" /> Your team, in sync</span><button onClick={() => setGuide(true)} title=\"Workspace guide\" aria-label=\"Workspace guide\" className=\"rounded-full p-2 text-slate-400 hover:bg-slate-50 hover:text-brand-700\"><CircleHelp size={18} /></button><span className=\"flex size-8 items-center justify-center rounded-full border border-brand-100 bg-brand-50 text-[11px] font-semibold text-brand-700\">{initials(user!.username)}</span></div></header>\n+      <main className=\"mx-auto max-w-[1500px] px-5 py-8 sm:px-9 lg:py-10\"><Outlet context={{ notify } satisfies LayoutContext} /></main>\n+      <footer className=\"mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-2 px-5 pb-7 pt-4 text-[11px] text-slate-400 sm:px-9\"><span>Made for people, not spreadsheets.</span><span className=\"flex items-center gap-1.5\"><ShieldCheck size={12} /> Private to your team</span></footer>\n+    </div>\n+    {toast && <div role=\"status\" className=\"fixed bottom-6 right-5 z-50 flex max-w-[calc(100%-2.5rem)] items-center gap-3 rounded-xl border border-brand-100 bg-white px-5 py-4 text-sm shadow-lg\"><CheckCircle2 size={18} className=\"text-brand-600\" />{toast}<button onClick={() => setToast(\"\")} aria-label=\"Dismiss notification\" className=\"ml-3 text-slate-400\"><X size={16} /></button></div>}\n+    {guide && <Modal title=\"A little guide to Commonplace\" description=\"Good relationships are a team effort.\" onClose={() => setGuide(false)}><div className=\"space-y-5 p-6 text-sm leading-6 text-slate-500\"><div><h3 className=\"font-semibold text-slate-800\">One directory, shared by everyone</h3><p>Every signed-in member can view, add, edit, and delete customers. Search by name, contact details, company, or notes.</p></div><div><h3 className=\"font-semibold text-slate-800\">Keep the conversation going</h3><p>Open a customer to log a call, email, or meeting. Add a summary and the time it happened; your name is attached automatically.</p></div><div><h3 className=\"font-semibold text-slate-800\">A few thoughtful details</h3><p>Customer emails are unique. Last contacted reflects the latest interaction, even if an older conversation is logged later. Deleting a customer also removes their interaction history.</p></div><div className=\"flex items-center gap-2 border-t border-slate-100 pt-4 text-xs\"><ShieldCheck size={16} className=\"text-brand-600\" /> Your directory is only accessible to signed-in team members.</div></div></Modal>}\n+  </div>;\n+}\n+\n+function MessageIllustration() { return <BookOpen size={17} strokeWidth={1.6} />; }\n","additions":40,"deletions":0},{"filePath":"/workspace/frontend/src/CustomerForm.tsx","relativePath":"frontend/src/CustomerForm.tsx","type":"add","patch":"Index: /workspace/frontend/src/CustomerForm.tsx\n===================================================================\n--- /workspace/frontend/src/CustomerForm.tsx\n+++ /workspace/frontend/src/CustomerForm.tsx\n@@ -0,0 +1,34 @@\n+import { useState, type FormEvent } from \"react\";\n+import { LoaderCircle, Plus, Save } from \"lucide-react\";\n+import { api, ApiError, message, type Customer } from \"./api\";\n+import { Alert, Field, inputClass, Modal, primaryButton, secondaryButton } from \"./ui\";\n+\n+export function CustomerForm({ customer, onClose, onSaved }: { customer?: Customer; onClose: () => void; onSaved: (customer: Customer) => void }) {\n+  const [values, setValues] = useState({ name: customer?.name || \"\", email: customer?.email || \"\", phone: customer?.phone || \"\", company: customer?.company || \"\", notes: customer?.notes || \"\" });\n+  const [error, setError] = useState(\"\");\n+  const [errors, setErrors] = useState<Record<string, string>>({});\n+  const [busy, setBusy] = useState(false);\n+  async function submit(event: FormEvent) {\n+    event.preventDefault(); setBusy(true); setError(\"\"); setErrors({});\n+    try {\n+      const saved = await api<Customer>(customer ? `/customers/${customer.id}` : \"/customers\", { method: customer ? \"PUT\" : \"POST\", body: JSON.stringify(values) });\n+      onSaved(saved);\n+    } catch (err) { setError(message(err)); if (err instanceof ApiError) setErrors(err.errors); }\n+    finally { setBusy(false); }\n+  }\n+  function field(key: keyof typeof values, label: string, placeholder: string, type = \"text\") {\n+    return <Field label={label} id={`customer-${key}`} error={errors[key]} required={key === \"name\"}>\n+      <input id={`customer-${key}`} type={type} autoFocus={key === \"name\"} value={values[key]} placeholder={placeholder} onChange={(event) => setValues({ ...values, [key]: event.target.value })} disabled={busy} className={`${inputClass} ${errors[key] ? \"border-red-300\" : \"\"}`} aria-invalid={!!errors[key]} aria-describedby={errors[key] ? `customer-${key}-error` : undefined} />\n+    </Field>;\n+  }\n+  return <Modal title={customer ? \"Edit customer\" : \"Add a customer\"} description={customer ? \"Keep their details up to date for your whole team.\" : \"A new connection starts with the essentials.\"} onClose={() => { if (!busy) onClose(); }}>\n+    <form onSubmit={submit} noValidate><div className=\"space-y-5 p-6\">\n+      {error && <Alert>{error}</Alert>}\n+      {field(\"name\", \"Full name\", \"e.g. Alex Morgan\")}\n+      <div className=\"grid gap-5 sm:grid-cols-2\">{field(\"email\", \"Email address\", \"alex@company.com\", \"email\")}{field(\"phone\", \"Phone number\", \"+1 (555) 000-0000\", \"tel\")}</div>\n+      {field(\"company\", \"Company\", \"Where they work\")}\n+      <Field label=\"Notes\" id=\"customer-notes\" error={errors.notes} hint=\"A little context for your teammates.\"><textarea id=\"customer-notes\" rows={3} value={values.notes} onChange={(event) => setValues({ ...values, notes: event.target.value })} disabled={busy} placeholder=\"What would be helpful to remember?\" className={`${inputClass} resize-y`} aria-invalid={!!errors.notes} aria-describedby={errors.notes ? \"customer-notes-error\" : undefined} /></Field>\n+      <p className=\"text-xs text-slate-400\"><span className=\"text-brand-600\">*</span> Required field. All other details are optional.</p>\n+    </div><div className=\"flex justify-end gap-3 border-t border-slate-100 bg-slate-50/50 px-6 py-4\"><button type=\"button\" disabled={busy} onClick={onClose} className={secondaryButton}>Cancel</button><button disabled={busy} className={primaryButton}>{busy ? <LoaderCircle size={16} className=\"animate-spin\" /> : customer ? <Save size={16} /> : <Plus size={16} />}{busy ? \"Saving…\" : customer ? \"Save changes\" : \"Add customer\"}</button></div></form>\n+  </Modal>;\n+}\n","additions":34,"deletions":0},{"filePath":"/workspace/frontend/src/Customers.tsx","relativePath":"frontend/src/Customers.tsx","type":"add","patch":"Index: /workspace/frontend/src/Customers.tsx\n===================================================================\n--- /workspace/frontend/src/Customers.tsx\n+++ /workspace/frontend/src/Customers.tsx\n@@ -0,0 +1,75 @@\n+import { useEffect, useState } from \"react\";\n+import { Link, useOutletContext, useSearchParams } from \"react-router-dom\";\n+import { ArrowDownAZ, ArrowRight, Building2, ChevronLeft, ChevronRight, Clock3, Filter, MessageSquare, Plus, Search, Users, X } from \"lucide-react\";\n+import { api, date, initials, message, type CustomerPage, type Overview } from \"./api\";\n+import { Alert, inputClass, primaryButton, secondaryButton, Spinner } from \"./ui\";\n+import { CustomerForm } from \"./CustomerForm\";\n+import type { LayoutContext } from \"./Layout\";\n+\n+const avatarColors = [\"bg-[#e8eee5] text-[#697c55]\", \"bg-[#eeebf6] text-[#8671a3]\", \"bg-[#f4eae2] text-[#ac825f]\", \"bg-[#e5edf3] text-[#6985a0]\", \"bg-[#f3e6e7] text-[#ad747e]\"];\n+\n+export function Customers() {\n+  const { notify } = useOutletContext<LayoutContext>();\n+  const [params, setParams] = useSearchParams();\n+  const q = params.get(\"q\") || \"\";\n+  const company = params.get(\"company\") || \"\";\n+  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n+  const pageSize = [10, 20, 50].includes(Number(params.get(\"page_size\"))) ? Number(params.get(\"page_size\")) : 10;\n+  const [search, setSearch] = useState(q);\n+  const [result, setResult] = useState<CustomerPage | null>(null);\n+  const [overview, setOverview] = useState<Overview | null>(null);\n+  const [error, setError] = useState(\"\");\n+  const [loading, setLoading] = useState(true);\n+  const [add, setAdd] = useState(false);\n+  const [revision, setRevision] = useState(0);\n+  useEffect(() => { setSearch(q); }, [q]);\n+  useEffect(() => {\n+    if (search === q) return;\n+    const timer = setTimeout(() => {\n+      setParams((old) => { const next = new URLSearchParams(old); if (search.trim()) next.set(\"q\", search.trim()); else next.delete(\"q\"); next.delete(\"page\"); return next; }, { replace: true });\n+    }, 300);\n+    return () => clearTimeout(timer);\n+  }, [search, q, setParams]);\n+  useEffect(() => {\n+    let active = true;\n+    setLoading(true); setError(\"\");\n+    const query = new URLSearchParams({ q, company, page: String(page), page_size: String(pageSize) });\n+    api<CustomerPage>(`/customers?${query}`).then((data) => {\n+      if (!active) return;\n+      if (page > 1 && data.items.length === 0 && data.total > 0) {\n+        setParams((old) => { const next = new URLSearchParams(old); next.set(\"page\", String(Math.ceil(data.total / pageSize))); return next; }, { replace: true });\n+      } else setResult(data);\n+    }).catch((err) => { if (active) setError(message(err)); }).finally(() => { if (active) setLoading(false); });\n+    return () => { active = false; };\n+  }, [q, company, page, pageSize, revision, setParams]);\n+  useEffect(() => {\n+    let active = true;\n+    api<Overview>(\"/overview\").then((data) => { if (active) setOverview(data); }).catch(() => {});\n+    return () => { active = false; };\n+  }, [revision]);\n+  function filter(key: string, value: string) {\n+    setParams((old) => { const next = new URLSearchParams(old); if (value) next.set(key, value); else next.delete(key); if (key !== \"page\") next.delete(\"page\"); return next; });\n+  }\n+  const filtered = !!(q || company);\n+  const total = result?.total || 0;\n+  const pages = Math.max(1, Math.ceil(total / pageSize));\n+  return <>\n+    <div className=\"mb-8 flex flex-wrap items-center justify-between gap-5\"><div><p className=\"mb-2 text-[10px] font-semibold tracking-[1.7px] text-brand-600\">A LITTLE CONTEXT. A BETTER CONNECTION.</p><div className=\"flex items-center gap-3\"><h1 className=\"text-[30px] font-semibold tracking-[-1px]\">Customers</h1><span className=\"rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-medium text-slate-500\">{overview?.customers ?? \"—\"}</span></div><p className=\"mt-2 text-[13px] text-slate-500\">Your people, their details, and every conversation in between.</p></div><button onClick={() => setAdd(true)} className={primaryButton}><Plus size={17} />Add customer</button></div>\n+    <div className=\"mb-8 grid grid-cols-2 gap-3 xl:grid-cols-4 xl:gap-5\">\n+      {[\n+        { label: \"Total customers\", value: overview?.customers, icon: Users, color: \"bg-brand-50 text-brand-600\", note: \"Connections in your directory\" },\n+        { label: \"Companies\", value: overview?.companies, icon: Building2, color: \"bg-[#f1eef8] text-[#8b79b4]\", note: \"Organizations you work with\" },\n+        { label: \"Contacted recently\", value: overview?.contacted, icon: Clock3, color: \"bg-[#fcf3e5] text-[#bd9452]\", note: \"Customers in the last 30 days\" },\n+        { label: \"Interactions logged\", value: overview?.interactions, icon: MessageSquare, color: \"bg-[#ecf2fa] text-[#6a8cba]\", note: \"Conversations, kept together\" },\n+      ].map(({ label, value, icon: Icon, color, note }) => <div key={label} className=\"rounded-xl border border-slate-200/80 bg-white p-4 sm:p-5\"><div className=\"flex items-center justify-between gap-2\"><p className=\"text-xs font-medium text-slate-500\">{label}</p><span className={`flex size-8 shrink-0 items-center justify-center rounded-lg ${color}`}><Icon size={16} strokeWidth={1.7} /></span></div><p className=\"mt-3 text-[28px] font-semibold leading-none tracking-tight\">{value ?? \"—\"}</p><p className=\"mt-3 hidden text-[11px] text-slate-400 sm:block\">{note}</p></div>)}\n+    </div>\n+    <section aria-label=\"Customer directory\" className=\"overflow-hidden rounded-xl border border-slate-200/80 bg-white\">\n+      <div className=\"flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6\"><div className=\"flex items-center gap-2.5\"><h2 className=\"text-sm font-semibold\">All customers</h2><span className=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500\">{total}</span></div><span className=\"flex items-center gap-1.5 text-[11px] text-slate-400\"><ArrowDownAZ size={14} />Sorted by name</span></div>\n+      <div className=\"flex flex-wrap items-center gap-3 px-5 py-4 sm:px-6\"><div className=\"relative w-full sm:max-w-[330px] sm:flex-1\"><Search size={16} className=\"absolute left-3 top-3 text-slate-400\" /><input aria-label=\"Search customers\" placeholder=\"Search name, email, company…\" value={search} onChange={(event) => setSearch(event.target.value)} className={`${inputClass} py-2.5 pl-9 pr-9 text-xs`} />{search && <button aria-label=\"Clear search\" onClick={() => { setSearch(\"\"); filter(\"q\", \"\"); }} className=\"absolute right-3 top-3 text-slate-400 hover:text-slate-600\"><X size={14} /></button>}</div><div className=\"relative min-w-[175px]\"><Building2 size={14} className=\"pointer-events-none absolute left-3 top-3.5 text-slate-400\" /><select aria-label=\"Filter by company\" value={company} onChange={(event) => filter(\"company\", event.target.value)} className={`${inputClass} appearance-none py-2.5 pl-9 pr-9 text-xs`}><option value=\"\">All companies</option>{company && !overview?.company_options.includes(company) && <option value={company}>{company}</option>}{overview?.company_options.map((item) => <option key={item} value={item}>{item}</option>)}</select><ChevronRight size={14} className=\"pointer-events-none absolute right-3 top-3.5 rotate-90 text-slate-400\" /></div>{filtered && <button onClick={() => { setSearch(\"\"); setParams({}); }} className=\"flex items-center gap-1.5 text-xs text-slate-500 hover:text-brand-700\"><X size={13} />Clear filters</button>}<span className=\"ml-auto hidden text-[11px] text-slate-400 xl:inline\">A shared view for your whole team</span></div>\n+      {error ? <div className=\"px-6 pb-6\"><Alert>{error} <button onClick={() => setRevision(revision + 1)} className=\"ml-2 font-semibold underline\">Try again</button></Alert></div> : loading ? <Spinner label=\"Finding your customers…\" /> : result?.items.length ? <div className=\"overflow-x-auto\"><table className=\"w-full whitespace-nowrap text-left text-xs\"><thead className=\"border-y border-slate-100 bg-[#fafbfc] text-[10px] font-medium uppercase tracking-[0.65px] text-slate-400\"><tr><th scope=\"col\" className=\"px-6 py-3.5 font-medium\">Name <span className=\"ml-1 text-brand-600\">↓</span></th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Email address</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Phone</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Company</th><th scope=\"col\" className=\"px-4 py-3.5 font-medium\">Last contacted</th><th scope=\"col\" className=\"py-3.5 pr-5\"><span className=\"sr-only\">View customer</span></th></tr></thead><tbody className=\"divide-y divide-slate-100\">{result.items.map((customer) => <tr key={customer.id} className=\"group transition hover:bg-brand-50/35\"><td className=\"px-6 py-4\"><Link to={`/customers/${customer.id}`} className=\"flex items-center gap-3 rounded-md focus-visible:outline-brand-500\"><span className={`flex size-9 shrink-0 items-center justify-center rounded-full text-[11px] font-medium ${avatarColors[customer.id % avatarColors.length]}`}>{initials(customer.name)}</span><span className=\"max-w-[220px] truncate text-[13px] font-semibold text-slate-700 group-hover:text-brand-700\">{customer.name}</span></Link></td><td className=\"px-4 py-4 text-slate-500\">{customer.email ? <a href={`mailto:${customer.email}`} className=\"hover:text-brand-700\">{customer.email}</a> : <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4 text-slate-500\">{customer.phone || <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4\">{customer.company ? <span className=\"inline-flex max-w-[180px] items-center gap-1.5 rounded-md border border-slate-200/70 bg-slate-50 px-2 py-1 text-[11px] text-slate-600\"><Building2 size={11} className=\"shrink-0 text-slate-400\" /><span className=\"truncate\">{customer.company}</span></span> : <span className=\"text-slate-300\">—</span>}</td><td className=\"px-4 py-4\">{customer.last_contacted_at ? <span className=\"flex items-center gap-1.5 text-slate-500\"><span className=\"size-1.5 rounded-full bg-brand-500/65\" />{date(customer.last_contacted_at)}</span> : <span className=\"text-[11px] text-slate-400\">Not contacted yet</span>}</td><td className=\"pr-5\"><Link to={`/customers/${customer.id}`} aria-label={`View ${customer.name}`} className=\"inline-flex rounded-lg p-2 text-slate-300 hover:bg-brand-50 hover:text-brand-600\"><ChevronRight size={16} /></Link></td></tr>)}</tbody></table></div> : <div className=\"flex min-h-[320px] flex-col items-center justify-center border-t border-slate-100 px-6 py-12 text-center\"><span className=\"mb-5 flex size-16 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 shadow-[0_5px_0_0_#f7faf7]\">{filtered ? <Filter size={27} className=\"text-brand-500\" strokeWidth={1.4} /> : <Users size={28} className=\"text-brand-500\" strokeWidth={1.4} />}</span><h3 className=\"text-base font-semibold\">{filtered ? \"No matching connections\" : \"Your next connection starts here\"}</h3><p className=\"mt-2 max-w-sm text-xs leading-6 text-slate-400\">{filtered ? \"Try a different search or company to find who you’re looking for.\" : \"Add your first customer and give your team a shared place to keep the details that matter.\"}</p><button onClick={() => { if (filtered) { setSearch(\"\"); setParams({}); } else setAdd(true); }} className={`${filtered ? secondaryButton : primaryButton} mt-5`}>{filtered ? \"Clear filters\" : <><Plus size={15} />Add your first customer</>}</button></div>}\n+      <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 px-5 py-4 text-[11px] text-slate-400 sm:px-6\"><div className=\"flex items-center gap-4\"><p>{total ? `Showing ${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, total)} of ${total} customers` : \"0 customers\"}</p><label className=\"hidden items-center gap-2 sm:inline-flex\">Rows per page<select aria-label=\"Rows per page\" value={pageSize} onChange={(event) => filter(\"page_size\", event.target.value)} className=\"rounded-md border border-slate-200 bg-white p-1 text-slate-600 outline-brand-500\"><option>10</option><option>20</option><option>50</option></select></label></div><div className=\"flex items-center gap-2\"><button aria-label=\"Previous page\" disabled={page <= 1 || loading} onClick={() => filter(\"page\", String(page - 1))} className=\"rounded-md border border-slate-200 p-1.5 text-slate-500 transition hover:bg-slate-50 disabled:opacity-35\"><ChevronLeft size={14} /></button><span className=\"px-2 text-slate-500\">Page <span className=\"font-medium text-slate-700\">{page}</span> of {pages}</span><button aria-label=\"Next page\" disabled={page >= pages || loading} onClick={() => filter(\"page\", String(page + 1))} className=\"rounded-md border border-slate-200 p-1.5 text-slate-500 transition hover:bg-slate-50 disabled:opacity-35\"><ChevronRight size={14} /></button></div></div>\n+    </section>\n+    <p className=\"mt-5 flex items-center gap-2 text-[11px] text-slate-400\"><Users size={13} />Every customer is shared with your team. Great relationships don’t happen alone.<ArrowRight size={12} className=\"hidden sm:block\" /></p>\n+    {add && <CustomerForm onClose={() => setAdd(false)} onSaved={() => { setAdd(false); setRevision(revision + 1); notify(\"Customer added to your directory.\"); }} />}\n+  </>;\n+}\n","additions":75,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/src/api.ts\nA frontend/src/ui.tsx\nD frontend/src/App.tsx\nA frontend/src/App.tsx\nA frontend/src/AuthScreen.tsx\nA frontend/src/Layout.tsx\nA frontend/src/CustomerForm.tsx\nA frontend/src/Customers.tsx","time":{"start":1794319007710,"end":1794319007750}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5bc92e5001W31IPMZhkkUIdA","sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","messageID":"msg_1c5bc8b90001SUapBlsdME8hIo"}}
