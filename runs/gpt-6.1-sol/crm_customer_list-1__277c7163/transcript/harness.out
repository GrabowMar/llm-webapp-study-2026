{"type":"tool_use","timestamp":1794319481047,"sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","part":{"type":"tool","tool":"read","callID":"call_d32sqwFK3S5v4dUkIh7yv1Lz","state":{"status":"completed","input":{"filePath":"/workspace/frontend/node_modules/@sparticuz/chromium/build/helper.js","limit":140},"output":"<path>/workspace/frontend/node_modules/@sparticuz/chromium/build/helper.js</path>\n<type>file</type>\n<content>\n1: import { createWriteStream, rm } from \"node:fs\";\n2: import { access, symlink } from \"node:fs/promises\";\n3: import { tmpdir } from \"node:os\";\n4: import { join } from \"node:path\";\n5: import { Readable } from \"node:stream\";\n6: import { pipeline } from \"node:stream/promises\";\n7: import { extract } from \"tar-fs\";\n8: /**\n9:  * Creates a symlink to a file\n10:  */\n11: export const createSymlink = async (source, target) => {\n12:     await access(source);\n13:     await symlink(source, target);\n14: };\n15: /**\n16:  * Downloads a file from a URL\n17:  */\n18: export const downloadFile = async (url, outputPath) => {\n19:     const response = await fetch(url, { redirect: \"follow\" });\n20:     if (!response.ok) {\n21:         throw new Error(`Unexpected status code: ${String(response.status)}.`);\n22:     }\n23:     if (!response.body) {\n24:         throw new Error(\"Response body is empty.\");\n25:     }\n26:     await pipeline(Readable.fromWeb(response.body), createWriteStream(outputPath));\n27: };\n28: /**\n29:  * Adds the proper folders to the environment\n30:  * @param baseLibPath the path to this packages lib folder\n31:  */\n32: export const setupLambdaEnvironment = (baseLibPath) => {\n33:     // If the FONTCONFIG_PATH is not set, set it to /tmp/fonts\n34:     process.env[\"FONTCONFIG_PATH\"] ??= join(tmpdir(), \"fonts\");\n35:     // Set up Home folder if not already set\n36:     process.env[\"HOME\"] ??= tmpdir();\n37:     // If LD_LIBRARY_PATH is undefined, set it to baseLibPath, otherwise, add it\n38:     if (process.env[\"LD_LIBRARY_PATH\"] === undefined) {\n39:         process.env[\"LD_LIBRARY_PATH\"] = baseLibPath;\n40:     }\n41:     else if (!process.env[\"LD_LIBRARY_PATH\"].startsWith(baseLibPath)) {\n42:         process.env[\"LD_LIBRARY_PATH\"] = [\n43:             baseLibPath,\n44:             ...new Set(process.env[\"LD_LIBRARY_PATH\"].split(\":\")),\n45:         ].join(\":\");\n46:     }\n47: };\n48: /**\n49:  * Determines if the input is a valid URL\n50:  * @param input the input to check\n51:  * @returns boolean indicating if the input is a valid URL\n52:  */\n53: export const isValidUrl = (input) => {\n54:     try {\n55:         const url = new URL(input);\n56:         if (url.protocol === \"https:\")\n57:             return true;\n58:         // Allow http:// only for localhost/127.0.0.1 (development/testing)\n59:         if (url.protocol === \"http:\" &&\n60:             (url.hostname === \"localhost\" ||\n61:                 url.hostname === \"127.0.0.1\" ||\n62:                 url.hostname === \"[::1]\")) {\n63:             return true;\n64:         }\n65:         return false;\n66:     }\n67:     catch {\n68:         return false;\n69:     }\n70: };\n71: /**\n72:  * Determines if the running instance is inside an Amazon Linux 2023 container,\n73:  * AWS_EXECUTION_ENV is for native Lambda instances\n74:  * AWS_LAMBDA_JS_RUNTIME is for netlify instances\n75:  * CODEBUILD_BUILD_IMAGE is for CodeBuild instances\n76:  * VERCEL is for Vercel Functions (Node 20 or later enables an AL2023-compatible environment).\n77:  * @returns boolean indicating if the running instance is inside a Lambda container with nodejs20\n78:  */\n79: export const isRunningInAmazonLinux2023 = (nodeMajorVersion) => {\n80:     const awsExecEnv = process.env[\"AWS_EXECUTION_ENV\"] ?? \"\";\n81:     const awsLambdaJsRuntime = process.env[\"AWS_LAMBDA_JS_RUNTIME\"] ?? \"\";\n82:     const codebuildImage = process.env[\"CODEBUILD_BUILD_IMAGE\"] ?? \"\";\n83:     // Check for explicit version substrings, returns on first match\n84:     if (awsExecEnv.includes(\"20.x\") ||\n85:         awsExecEnv.includes(\"22.x\") ||\n86:         awsExecEnv.includes(\"24.x\") ||\n87:         awsLambdaJsRuntime.includes(\"20.x\") ||\n88:         awsLambdaJsRuntime.includes(\"22.x\") ||\n89:         awsLambdaJsRuntime.includes(\"24.x\") ||\n90:         codebuildImage.includes(\"nodejs20\") ||\n91:         codebuildImage.includes(\"nodejs22\") ||\n92:         codebuildImage.includes(\"nodejs24\")) {\n93:         return true;\n94:     }\n95:     // Vercel: Node 20+ is AL2023 compatible\n96:     if (process.env[\"VERCEL\"] && nodeMajorVersion >= 20) {\n97:         return true;\n98:     }\n99:     return false;\n100: };\n101: export const downloadAndExtract = async (url) => {\n102:     const destDir = join(tmpdir(), \"chromium-pack\");\n103:     const response = await fetch(url, {\n104:         redirect: \"follow\",\n105:         signal: AbortSignal.timeout(300_000),\n106:     });\n107:     if (!response.ok) {\n108:         throw new Error(`Unexpected status code: ${String(response.status)}.`);\n109:     }\n110:     if (!response.body) {\n111:         throw new Error(\"Response body is empty.\");\n112:     }\n113:     try {\n114:         await pipeline(Readable.fromWeb(response.body), extract(destDir));\n115:     }\n116:     catch (error) {\n117:         // Clean up partial extraction on failure\n118:         await new Promise((resolve) => {\n119:             rm(destDir, { force: true, recursive: true }, () => {\n120:                 resolve();\n121:             });\n122:         });\n123:         throw error;\n124:     }\n125:     return destDir;\n126: };\n\n(End of file - total 126 lines)\n</content>","metadata":{"preview":"import { createWriteStream, rm } from \"node:fs\";\nimport { access, symlink } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { Readable } from \"node:stream\";\nimport { pipeline } from \"node:stream/