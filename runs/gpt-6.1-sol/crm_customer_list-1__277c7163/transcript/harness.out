{"type":"tool_use","timestamp":1794318538873,"sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","part":{"type":"tool","tool":"apply_patch","callID":"call_Z7hFAoySDAR2pbagFlt4IBRd","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Delete File: /workspace/backend/app.py\n*** Add File: /workspace/backend/app.py\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+CUSTOMER_SELECT = \"\"\"\n+    SELECT c.*, COUNT(i.id) AS interaction_count,\n+           MAX(i.occurred_at) AS last_contacted_at\n+    FROM customers c LEFT JOIN interactions i ON i.customer_id = c.id\n+\"\"\"\n+SCHEMA = \"\"\"\n+CREATE TABLE IF NOT EXISTS users (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n+    password_hash TEXT NOT NULL,\n+    created_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS sessions (\n+    token_hash TEXT PRIMARY KEY,\n+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+    expires_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS customers (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    name TEXT NOT NULL,\n+    email TEXT COLLATE NOCASE UNIQUE,\n+    phone TEXT,\n+    company TEXT,\n+    notes TEXT,\n+    created_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS interactions (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    customer_id INTEGER NOT NULL REFERENCES customers(id) ON DELETE CASCADE,\n+    kind TEXT NOT NULL CHECK(kind IN ('call', 'email', 'meeting')),\n+    summary TEXT NOT NULL,\n+    occurred_at TEXT NOT NULL,\n+    user_id INTEGER NOT NULL REFERENCES users(id)\n+);\n+CREATE INDEX IF NOT EXISTS customer_name ON customers(name COLLATE NOCASE);\n+CREATE INDEX IF NOT EXISTS customer_company ON customers(company COLLATE NOCASE);\n+CREATE INDEX IF NOT EXISTS interaction_customer ON interactions(customer_id, occurred_at DESC);\n+\"\"\"\n+\n+\n+def timestamp(value=None):\n+    return (value or datetime.now(timezone.utc)).astimezone(timezone.utc).isoformat(\n+        timespec=\"microseconds\"\n+    ).replace(\"+00:00\", \"Z\")\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        from flask import current_app\n+\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=30)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def error(message, status=400, errors=None):\n+    result = {\"error\": message}\n+    if errors:\n+        result[\"errors\"] = errors\n+    return result, status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return error(\"Please sign in to continue.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"\"\"SELECT u.id, u.username FROM sessions s JOIN users u ON u.id = s.user_id\n+               WHERE s.token_hash = ? AND s.expires_at > ?\"\"\",\n+            (token_hash, timestamp()),\n+        ).fetchone()\n+        if user is None:\n+            return error(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = token_hash\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    return body if isinstance(body, dict) else None\n+\n+\n+def validate_text(body, field, errors, required=False, limit=255):\n+    value = body.get(field)\n+    label = field.replace(\"_\", \" \").capitalize()\n+    if value is None and not required:\n+        return None\n+    if not isinstance(value, str):\n+        errors[field] = f\"{label} must be text.\" if value is not None else f\"{label} is required.\"\n+        return None\n+    value = value.strip()\n+    if not value:\n+        if required:\n+            errors[field] = f\"{label} is required.\"\n+        return None\n+    if len(value) > limit:\n+        errors[field] = f\"{label} must be {limit} characters or fewer.\"\n+    return value\n+\n+\n+def credentials(body, registering=False):\n+    errors = {}\n+    username = validate_text(body, \"username\", errors, required=True, limit=50)\n+    password = body.get(\"password\")\n+    if not isinstance(password, str) or not password:\n+        errors[\"password\"] = \"Password is required.\"\n+    elif len(password) > 256:\n+        errors[\"password\"] = \"Password must be 256 characters or fewer.\"\n+    elif registering and len(password) < 8:\n+        errors[\"password\"] = \"Password must be at least 8 characters.\"\n+    if registering and username and len(username) < 3:\n+        errors[\"username\"] = \"Username must be at least 3 characters.\"\n+    return username, password, errors\n+\n+\n+def customer_fields(body):\n+    errors = {}\n+    fields = {\n+        key: validate_text(\n+            body, key, errors, required=key == \"name\", limit=10000 if key == \"notes\" else 255\n+        )\n+        for key in (\"name\", \"email\", \"phone\", \"company\", \"notes\")\n+    }\n+    if fields[\"email\"] and not re.fullmatch(r\"[^\\s@]+@[^\\s@]+\\.[^\\s@]+\", fields[\"email\"]):\n+        errors[\"email\"] = \"Enter a valid email address.\"\n+    return fields, errors\n+\n+\n+def find_customer(customer_id):\n+    row = get_db().execute(\n+        CUSTOMER_SELECT + \" WHERE c.id = ? GROUP BY c.id\", (customer_id,)\n+    ).fetchone()\n+    return dict(row) if row else None\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"directory.sqlite3\")),\n+        MAX_CONTENT_LENGTH=128 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = get_db()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(SCHEMA)\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_db(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(exception):\n+        if request.path.startswith(\"/api\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        username, password, errors = credentials(body, registering=True)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        try:\n+            with db:\n+                cursor = db.execute(\n+                    \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n+                    (username, generate_password_hash(password), timestamp()),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\"This username is already taken.\", 409, {\"username\": \"This username is already taken.\"})\n+        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if not check_password_hash(user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"], password) or user is None:\n+            return error(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], timestamp(datetime.now(timezone.utc) + timedelta(days=30))),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return dict(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.get(\"/api/overview\")\n+    @authenticated\n+    def overview():\n+        db = get_db()\n+        stats = db.execute(\n+            \"\"\"SELECT COUNT(*) AS customers, COUNT(DISTINCT NULLIF(LOWER(company), '')) AS companies,\n+               (SELECT COUNT(*) FROM interactions) AS interactions,\n+               (SELECT COUNT(DISTINCT customer_id) FROM interactions WHERE occurred_at >= ?) AS contacted\n+               FROM customers\"\"\",\n+            (timestamp(datetime.now(timezone.utc) - timedelta(days=30)),),\n+        ).fetchone()\n+        companies = db.execute(\n+            \"SELECT MIN(company) AS company FROM customers WHERE company IS NOT NULL GROUP BY company COLLATE NOCASE ORDER BY company COLLATE NOCASE\"\n+        ).fetchall()\n+        return {**dict(stats), \"company_options\": [row[\"company\"] for row in companies]}\n+\n+    @app.get(\"/api/customers\")\n+    @authenticated\n+    def list_customers():\n+        errors = {}\n+        paging = {}\n+        for key, default, maximum in ((\"page\", 1, 1000000), (\"page_size\", 20, 100)):\n+            try:\n+                value = int(request.args.get(key, default))\n+                if not 1 <= value <= maximum:\n+                    raise ValueError\n+                paging[key] = value\n+            except (TypeError, ValueError):\n+                errors[key] = f\"{key.replace('_', ' ').capitalize()} must be an integer between 1 and {maximum}.\"\n+        if errors:\n+            return error(\"Invalid pagination.\", errors=errors)\n+        clauses, params = [], []\n+        query = request.args.get(\"q\", \"\").strip()\n+        company = request.args.get(\"company\", \"\").strip()\n+        if query:\n+            escaped = query.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n+            clauses.append(\"(\" + \" OR \".join(f\"c.{field} LIKE ? ESCAPE '\\\\'\" for field in (\"name\", \"email\", \"phone\", \"company\", \"notes\")) + \")\")\n+            params.extend([f\"%{escaped}%\"] * 5)\n+        if company:\n+            clauses.append(\"c.company = ? COLLATE NOCASE\")\n+            params.append(company)\n+        where = \" WHERE \" + \" AND \".join(clauses) if clauses else \"\"\n+        db = get_db()\n+        total = db.execute(\"SELECT COUNT(*) FROM customers c\" + where, params).fetchone()[0]\n+        rows = db.execute(\n+            CUSTOMER_SELECT + where + \" GROUP BY c.id ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n+            [*params, paging[\"page_size\"], (paging[\"page\"] - 1) * paging[\"page_size\"]],\n+        ).fetchall()\n+        return {\"items\": [dict(row) for row in rows], \"total\": total, **paging}\n+\n+    @app.post(\"/api/customers\")\n+    @authenticated\n+    def add_customer():\n+        return save_customer()\n+\n+    @app.put(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def update_customer(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        return save_customer(customer_id)\n+\n+    def save_customer(customer_id=None):\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        fields, errors = customer_fields(body)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        try:\n+            with db:\n+                if customer_id is None:\n+                    cursor = db.execute(\n+                        \"INSERT INTO customers (name, email, phone, company, notes, created_at) VALUES (?, ?, ?, ?, ?, ?)\",\n+                        (*fields.values(), timestamp()),\n+                    )\n+                    customer_id = cursor.lastrowid\n+                    status = 201\n+                else:\n+                    db.execute(\n+                        \"UPDATE customers SET name = ?, email = ?, phone = ?, company = ?, notes = ? WHERE id = ?\",\n+                        (*fields.values(), customer_id),\n+                    )\n+                    status = 200\n+        except sqlite3.IntegrityError:\n+            return error(\"A customer with this email already exists.\", 409, {\"email\": \"A customer with this email already exists.\"})\n+        return find_customer(customer_id), status\n+\n+    @app.get(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def get_customer(customer_id):\n+        return find_customer(customer_id) or error(\"Customer not found.\", 404)\n+\n+    @app.delete(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def delete_customer(customer_id):\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n+        if not cursor.rowcount:\n+            return error(\"Customer not found.\", 404)\n+        return \"\", 204\n+\n+    @app.get(\"/api/customers/<int:customer_id>/interactions\")\n+    @authenticated\n+    def list_interactions(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        rows = get_db().execute(\n+            \"\"\"SELECT i.id, i.customer_id, i.kind, i.summary, i.occurred_at, u.username AS logged_by\n+               FROM interactions i JOIN users u ON u.id = i.user_id WHERE i.customer_id = ?\n+               ORDER BY i.occurred_at DESC, i.id DESC\"\"\", (customer_id,),\n+        ).fetchall()\n+        return {\"items\": [dict(row) for row in rows]}\n+\n+    @app.post(\"/api/customers/<int:customer_id>/interactions\")\n+    @authenticated\n+    def add_interaction(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        errors = {}\n+        kind = validate_text(body, \"kind\", errors, required=True)\n+        summary = validate_text(body, \"summary\", errors, required=True, limit=10000)\n+        if kind not in (\"call\", \"email\", \"meeting\"):\n+            errors[\"kind\"] = \"Choose call, email, or meeting.\"\n+        occurred_at = timestamp()\n+        if \"occurred_at\" in body:\n+            try:\n+                value = datetime.fromisoformat(body[\"occurred_at\"])\n+                if value.tzinfo is None:\n+                    value = value.replace(tzinfo=timezone.utc)\n+                occurred_at = timestamp(value)\n+            except (ValueError, TypeError, OverflowError):\n+                errors[\"occurred_at\"] = \"Enter a valid ISO 8601 date and time.\"\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, user_id) VALUES (?, ?, ?, ?, ?)\",\n+                (customer_id, kind, summary, occurred_at, g.user[\"id\"]),\n+            )\n+        return {\"id\": cursor.lastrowid, \"customer_id\": customer_id, \"kind\": kind,\n+                \"summary\": summary, \"occurred_at\": occurred_at, \"logged_by\": g.user[\"username\"]}, 201\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_hex(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n*** Add File: /workspace/.gitignore\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n*** End Patch"},"output":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA .gitignore","metadata":{"diff":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n\nIndex: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,417 @@\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+CUSTOMER_SELECT = \"\"\"\n+    SELECT c.*, COUNT(i.id) AS interaction_count,\n+           MAX(i.occurred_at) AS last_contacted_at\n+    FROM customers c LEFT JOIN interactions i ON i.customer_id = c.id\n+\"\"\"\n+SCHEMA = \"\"\"\n+CREATE TABLE IF NOT EXISTS users (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n+    password_hash TEXT NOT NULL,\n+    created_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS sessions (\n+    token_hash TEXT PRIMARY KEY,\n+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+    expires_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS customers (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    name TEXT NOT NULL,\n+    email TEXT COLLATE NOCASE UNIQUE,\n+    phone TEXT,\n+    company TEXT,\n+    notes TEXT,\n+    created_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS interactions (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    customer_id INTEGER NOT NULL REFERENCES customers(id) ON DELETE CASCADE,\n+    kind TEXT NOT NULL CHECK(kind IN ('call', 'email', 'meeting')),\n+    summary TEXT NOT NULL,\n+    occurred_at TEXT NOT NULL,\n+    user_id INTEGER NOT NULL REFERENCES users(id)\n+);\n+CREATE INDEX IF NOT EXISTS customer_name ON customers(name COLLATE NOCASE);\n+CREATE INDEX IF NOT EXISTS customer_company ON customers(company COLLATE NOCASE);\n+CREATE INDEX IF NOT EXISTS interaction_customer ON interactions(customer_id, occurred_at DESC);\n+\"\"\"\n+\n+\n+def timestamp(value=None):\n+    return (value or datetime.now(timezone.utc)).astimezone(timezone.utc).isoformat(\n+        timespec=\"microseconds\"\n+    ).replace(\"+00:00\", \"Z\")\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        from flask import current_app\n+\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=30)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def error(message, status=400, errors=None):\n+    result = {\"error\": message}\n+    if errors:\n+        result[\"errors\"] = errors\n+    return result, status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return error(\"Please sign in to continue.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"\"\"SELECT u.id, u.username FROM sessions s JOIN users u ON u.id = s.user_id\n+               WHERE s.token_hash = ? AND s.expires_at > ?\"\"\",\n+            (token_hash, timestamp()),\n+        ).fetchone()\n+        if user is None:\n+            return error(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = token_hash\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    return body if isinstance(body, dict) else None\n+\n+\n+def validate_text(body, field, errors, required=False, limit=255):\n+    value = body.get(field)\n+    label = field.replace(\"_\", \" \").capitalize()\n+    if value is None and not required:\n+        return None\n+    if not isinstance(value, str):\n+        errors[field] = f\"{label} must be text.\" if value is not None else f\"{label} is required.\"\n+        return None\n+    value = value.strip()\n+    if not value:\n+        if required:\n+            errors[field] = f\"{label} is required.\"\n+        return None\n+    if len(value) > limit:\n+        errors[field] = f\"{label} must be {limit} characters or fewer.\"\n+    return value\n+\n+\n+def credentials(body, registering=False):\n+    errors = {}\n+    username = validate_text(body, \"username\", errors, required=True, limit=50)\n+    password = body.get(\"password\")\n+    if not isinstance(password, str) or not password:\n+        errors[\"password\"] = \"Password is required.\"\n+    elif len(password) > 256:\n+        errors[\"password\"] = \"Password must be 256 characters or fewer.\"\n+    elif registering and len(password) < 8:\n+        errors[\"password\"] = \"Password must be at least 8 characters.\"\n+    if registering and username and len(username) < 3:\n+        errors[\"username\"] = \"Username must be at least 3 characters.\"\n+    return username, password, errors\n+\n+\n+def customer_fields(body):\n+    errors = {}\n+    fields = {\n+        key: validate_text(\n+            body, key, errors, required=key == \"name\", limit=10000 if key == \"notes\" else 255\n+        )\n+        for key in (\"name\", \"email\", \"phone\", \"company\", \"notes\")\n+    }\n+    if fields[\"email\"] and not re.fullmatch(r\"[^\\s@]+@[^\\s@]+\\.[^\\s@]+\", fields[\"email\"]):\n+        errors[\"email\"] = \"Enter a valid email address.\"\n+    return fields, errors\n+\n+\n+def find_customer(customer_id):\n+    row = get_db().execute(\n+        CUSTOMER_SELECT + \" WHERE c.id = ? GROUP BY c.id\", (customer_id,)\n+    ).fetchone()\n+    return dict(row) if row else None\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"directory.sqlite3\")),\n+        MAX_CONTENT_LENGTH=128 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = get_db()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(SCHEMA)\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_db(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(exception):\n+        if request.path.startswith(\"/api\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        username, password, errors = credentials(body, registering=True)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        try:\n+            with db:\n+                cursor = db.execute(\n+                    \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n+                    (username, generate_password_hash(password), timestamp()),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\"This username is already taken.\", 409, {\"username\": \"This username is already taken.\"})\n+        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if not check_password_hash(user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"], password) or user is None:\n+            return error(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], timestamp(datetime.now(timezone.utc) + timedelta(days=30))),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return dict(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.get(\"/api/overview\")\n+    @authenticated\n+    def overview():\n+        db = get_db()\n+        stats = db.execute(\n+            \"\"\"SELECT COUNT(*) AS customers, COUNT(DISTINCT NULLIF(LOWER(company), '')) AS companies,\n+               (SELECT COUNT(*) FROM interactions) AS interactions,\n+               (SELECT COUNT(DISTINCT customer_id) FROM interactions WHERE occurred_at >= ?) AS contacted\n+               FROM customers\"\"\",\n+            (timestamp(datetime.now(timezone.utc) - timedelta(days=30)),),\n+        ).fetchone()\n+        companies = db.execute(\n+            \"SELECT MIN(company) AS company FROM customers WHERE company IS NOT NULL GROUP BY company COLLATE NOCASE ORDER BY company COLLATE NOCASE\"\n+        ).fetchall()\n+        return {**dict(stats), \"company_options\": [row[\"company\"] for row in companies]}\n+\n+    @app.get(\"/api/customers\")\n+    @authenticated\n+    def list_customers():\n+        errors = {}\n+        paging = {}\n+        for key, default, maximum in ((\"page\", 1, 1000000), (\"page_size\", 20, 100)):\n+            try:\n+                value = int(request.args.get(key, default))\n+                if not 1 <= value <= maximum:\n+                    raise ValueError\n+                paging[key] = value\n+            except (TypeError, ValueError):\n+                errors[key] = f\"{key.replace('_', ' ').capitalize()} must be an integer between 1 and {maximum}.\"\n+        if errors:\n+            return error(\"Invalid pagination.\", errors=errors)\n+        clauses, params = [], []\n+        query = request.args.get(\"q\", \"\").strip()\n+        company = request.args.get(\"company\", \"\").strip()\n+        if query:\n+            escaped = query.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n+            clauses.append(\"(\" + \" OR \".join(f\"c.{field} LIKE ? ESCAPE '\\\\'\" for field in (\"name\", \"email\", \"phone\", \"company\", \"notes\")) + \")\")\n+            params.extend([f\"%{escaped}%\"] * 5)\n+        if company:\n+            clauses.append(\"c.company = ? COLLATE NOCASE\")\n+            params.append(company)\n+        where = \" WHERE \" + \" AND \".join(clauses) if clauses else \"\"\n+        db = get_db()\n+        total = db.execute(\"SELECT COUNT(*) FROM customers c\" + where, params).fetchone()[0]\n+        rows = db.execute(\n+            CUSTOMER_SELECT + where + \" GROUP BY c.id ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n+            [*params, paging[\"page_size\"], (paging[\"page\"] - 1) * paging[\"page_size\"]],\n+        ).fetchall()\n+        return {\"items\": [dict(row) for row in rows], \"total\": total, **paging}\n+\n+    @app.post(\"/api/customers\")\n+    @authenticated\n+    def add_customer():\n+        return save_customer()\n+\n+    @app.put(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def update_customer(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        return save_customer(customer_id)\n+\n+    def save_customer(customer_id=None):\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        fields, errors = customer_fields(body)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        try:\n+            with db:\n+                if customer_id is None:\n+                    cursor = db.execute(\n+                        \"INSERT INTO customers (name, email, phone, company, notes, created_at) VALUES (?, ?, ?, ?, ?, ?)\",\n+                        (*fields.values(), timestamp()),\n+                    )\n+                    customer_id = cursor.lastrowid\n+                    status = 201\n+                else:\n+                    db.execute(\n+                        \"UPDATE customers SET name = ?, email = ?, phone = ?, company = ?, notes = ? WHERE id = ?\",\n+                        (*fields.values(), customer_id),\n+                    )\n+                    status = 200\n+        except sqlite3.IntegrityError:\n+            return error(\"A customer with this email already exists.\", 409, {\"email\": \"A customer with this email already exists.\"})\n+        return find_customer(customer_id), status\n+\n+    @app.get(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def get_customer(customer_id):\n+        return find_customer(customer_id) or error(\"Customer not found.\", 404)\n+\n+    @app.delete(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def delete_customer(customer_id):\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n+        if not cursor.rowcount:\n+            return error(\"Customer not found.\", 404)\n+        return \"\", 204\n+\n+    @app.get(\"/api/customers/<int:customer_id>/interactions\")\n+    @authenticated\n+    def list_interactions(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        rows = get_db().execute(\n+            \"\"\"SELECT i.id, i.customer_id, i.kind, i.summary, i.occurred_at, u.username AS logged_by\n+               FROM interactions i JOIN users u ON u.id = i.user_id WHERE i.customer_id = ?\n+               ORDER BY i.occurred_at DESC, i.id DESC\"\"\", (customer_id,),\n+        ).fetchall()\n+        return {\"items\": [dict(row) for row in rows]}\n+\n+    @app.post(\"/api/customers/<int:customer_id>/interactions\")\n+    @authenticated\n+    def add_interaction(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        errors = {}\n+        kind = validate_text(body, \"kind\", errors, required=True)\n+        summary = validate_text(body, \"summary\", errors, required=True, limit=10000)\n+        if kind not in (\"call\", \"email\", \"meeting\"):\n+            errors[\"kind\"] = \"Choose call, email, or meeting.\"\n+        occurred_at = timestamp()\n+        if \"occurred_at\" in body:\n+            try:\n+                value = datetime.fromisoformat(body[\"occurred_at\"])\n+                if value.tzinfo is None:\n+                    value = value.replace(tzinfo=timezone.utc)\n+                occurred_at = timestamp(value)\n+            except (ValueError, TypeError, OverflowError):\n+                errors[\"occurred_at\"] = \"Enter a valid ISO 8601 date and time.\"\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, user_id) VALUES (?, ?, ?, ?, ?)\",\n+                (customer_id, kind, summary, occurred_at, g.user[\"id\"]),\n+            )\n+        return {\"id\": cursor.lastrowid, \"customer_id\": customer_id, \"kind\": kind,\n+                \"summary\": summary, \"occurred_at\": occurred_at, \"logged_by\": g.user[\"username\"]}, 201\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_hex(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n\nIndex: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,417 @@\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+from datetime import datetime, timedelta, timezone\n+from functools import wraps\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_from_directory\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+CUSTOMER_SELECT = \"\"\"\n+    SELECT c.*, COUNT(i.id) AS interaction_count,\n+           MAX(i.occurred_at) AS last_contacted_at\n+    FROM customers c LEFT JOIN interactions i ON i.customer_id = c.id\n+\"\"\"\n+SCHEMA = \"\"\"\n+CREATE TABLE IF NOT EXISTS users (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n+    password_hash TEXT NOT NULL,\n+    created_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS sessions (\n+    token_hash TEXT PRIMARY KEY,\n+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+    expires_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS customers (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    name TEXT NOT NULL,\n+    email TEXT COLLATE NOCASE UNIQUE,\n+    phone TEXT,\n+    company TEXT,\n+    notes TEXT,\n+    created_at TEXT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS interactions (\n+    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+    customer_id INTEGER NOT NULL REFERENCES customers(id) ON DELETE CASCADE,\n+    kind TEXT NOT NULL CHECK(kind IN ('call', 'email', 'meeting')),\n+    summary TEXT NOT NULL,\n+    occurred_at TEXT NOT NULL,\n+    user_id INTEGER NOT NULL REFERENCES users(id)\n+);\n+CREATE INDEX IF NOT EXISTS customer_name ON customers(name COLLATE NOCASE);\n+CREATE INDEX IF NOT EXISTS customer_company ON customers(company COLLATE NOCASE);\n+CREATE INDEX IF NOT EXISTS interaction_customer ON interactions(customer_id, occurred_at DESC);\n+\"\"\"\n+\n+\n+def timestamp(value=None):\n+    return (value or datetime.now(timezone.utc)).astimezone(timezone.utc).isoformat(\n+        timespec=\"microseconds\"\n+    ).replace(\"+00:00\", \"Z\")\n+\n+\n+def get_db():\n+    if \"db\" not in g:\n+        from flask import current_app\n+\n+        g.db = sqlite3.connect(current_app.config[\"DATABASE\"], timeout=30)\n+        g.db.row_factory = sqlite3.Row\n+        g.db.execute(\"PRAGMA foreign_keys = ON\")\n+    return g.db\n+\n+\n+def error(message, status=400, errors=None):\n+    result = {\"error\": message}\n+    if errors:\n+        result[\"errors\"] = errors\n+    return result, status\n+\n+\n+def authenticated(view):\n+    @wraps(view)\n+    def wrapped(*args, **kwargs):\n+        parts = request.headers.get(\"Authorization\", \"\").split()\n+        if len(parts) != 2 or parts[0].lower() != \"bearer\":\n+            return error(\"Please sign in to continue.\", 401)\n+        token_hash = hashlib.sha256(parts[1].encode()).hexdigest()\n+        user = get_db().execute(\n+            \"\"\"SELECT u.id, u.username FROM sessions s JOIN users u ON u.id = s.user_id\n+               WHERE s.token_hash = ? AND s.expires_at > ?\"\"\",\n+            (token_hash, timestamp()),\n+        ).fetchone()\n+        if user is None:\n+            return error(\"Your session has expired. Please sign in again.\", 401)\n+        g.user = user\n+        g.token_hash = token_hash\n+        return view(*args, **kwargs)\n+\n+    return wrapped\n+\n+\n+def json_body():\n+    body = request.get_json(silent=True)\n+    return body if isinstance(body, dict) else None\n+\n+\n+def validate_text(body, field, errors, required=False, limit=255):\n+    value = body.get(field)\n+    label = field.replace(\"_\", \" \").capitalize()\n+    if value is None and not required:\n+        return None\n+    if not isinstance(value, str):\n+        errors[field] = f\"{label} must be text.\" if value is not None else f\"{label} is required.\"\n+        return None\n+    value = value.strip()\n+    if not value:\n+        if required:\n+            errors[field] = f\"{label} is required.\"\n+        return None\n+    if len(value) > limit:\n+        errors[field] = f\"{label} must be {limit} characters or fewer.\"\n+    return value\n+\n+\n+def credentials(body, registering=False):\n+    errors = {}\n+    username = validate_text(body, \"username\", errors, required=True, limit=50)\n+    password = body.get(\"password\")\n+    if not isinstance(password, str) or not password:\n+        errors[\"password\"] = \"Password is required.\"\n+    elif len(password) > 256:\n+        errors[\"password\"] = \"Password must be 256 characters or fewer.\"\n+    elif registering and len(password) < 8:\n+        errors[\"password\"] = \"Password must be at least 8 characters.\"\n+    if registering and username and len(username) < 3:\n+        errors[\"username\"] = \"Username must be at least 3 characters.\"\n+    return username, password, errors\n+\n+\n+def customer_fields(body):\n+    errors = {}\n+    fields = {\n+        key: validate_text(\n+            body, key, errors, required=key == \"name\", limit=10000 if key == \"notes\" else 255\n+        )\n+        for key in (\"name\", \"email\", \"phone\", \"company\", \"notes\")\n+    }\n+    if fields[\"email\"] and not re.fullmatch(r\"[^\\s@]+@[^\\s@]+\\.[^\\s@]+\", fields[\"email\"]):\n+        errors[\"email\"] = \"Enter a valid email address.\"\n+    return fields, errors\n+\n+\n+def find_customer(customer_id):\n+    row = get_db().execute(\n+        CUSTOMER_SELECT + \" WHERE c.id = ? GROUP BY c.id\", (customer_id,)\n+    ).fetchone()\n+    return dict(row) if row else None\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATABASE=os.environ.get(\"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"directory.sqlite3\")),\n+        MAX_CONTENT_LENGTH=128 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    Path(app.config[\"DATABASE\"]).parent.mkdir(parents=True, exist_ok=True)\n+    with app.app_context():\n+        db = get_db()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(SCHEMA)\n+        db.close()\n+        g.pop(\"db\", None)\n+\n+    @app.teardown_appcontext\n+    def close_db(exception=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    @app.after_request\n+    def response_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"same-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        if request.path.startswith(\"/api\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(exception):\n+        if request.path.startswith(\"/api\"):\n+            return error(exception.description, exception.code)\n+        return exception\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        username, password, errors = credentials(body, registering=True)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        try:\n+            with db:\n+                cursor = db.execute(\n+                    \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n+                    (username, generate_password_hash(password), timestamp()),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\"This username is already taken.\", 409, {\"username\": \"This username is already taken.\"})\n+        return {\"id\": cursor.lastrowid, \"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        username, password, errors = credentials(body)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if not check_password_hash(user[\"password_hash\"] if user else app.config[\"DUMMY_HASH\"], password) or user is None:\n+            return error(\"Incorrect username or password.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (timestamp(),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], timestamp(datetime.now(timezone.utc) + timedelta(days=30))),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return dict(g.user)\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return \"\", 204\n+\n+    @app.get(\"/api/overview\")\n+    @authenticated\n+    def overview():\n+        db = get_db()\n+        stats = db.execute(\n+            \"\"\"SELECT COUNT(*) AS customers, COUNT(DISTINCT NULLIF(LOWER(company), '')) AS companies,\n+               (SELECT COUNT(*) FROM interactions) AS interactions,\n+               (SELECT COUNT(DISTINCT customer_id) FROM interactions WHERE occurred_at >= ?) AS contacted\n+               FROM customers\"\"\",\n+            (timestamp(datetime.now(timezone.utc) - timedelta(days=30)),),\n+        ).fetchone()\n+        companies = db.execute(\n+            \"SELECT MIN(company) AS company FROM customers WHERE company IS NOT NULL GROUP BY company COLLATE NOCASE ORDER BY company COLLATE NOCASE\"\n+        ).fetchall()\n+        return {**dict(stats), \"company_options\": [row[\"company\"] for row in companies]}\n+\n+    @app.get(\"/api/customers\")\n+    @authenticated\n+    def list_customers():\n+        errors = {}\n+        paging = {}\n+        for key, default, maximum in ((\"page\", 1, 1000000), (\"page_size\", 20, 100)):\n+            try:\n+                value = int(request.args.get(key, default))\n+                if not 1 <= value <= maximum:\n+                    raise ValueError\n+                paging[key] = value\n+            except (TypeError, ValueError):\n+                errors[key] = f\"{key.replace('_', ' ').capitalize()} must be an integer between 1 and {maximum}.\"\n+        if errors:\n+            return error(\"Invalid pagination.\", errors=errors)\n+        clauses, params = [], []\n+        query = request.args.get(\"q\", \"\").strip()\n+        company = request.args.get(\"company\", \"\").strip()\n+        if query:\n+            escaped = query.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n+            clauses.append(\"(\" + \" OR \".join(f\"c.{field} LIKE ? ESCAPE '\\\\'\" for field in (\"name\", \"email\", \"phone\", \"company\", \"notes\")) + \")\")\n+            params.extend([f\"%{escaped}%\"] * 5)\n+        if company:\n+            clauses.append(\"c.company = ? COLLATE NOCASE\")\n+            params.append(company)\n+        where = \" WHERE \" + \" AND \".join(clauses) if clauses else \"\"\n+        db = get_db()\n+        total = db.execute(\"SELECT COUNT(*) FROM customers c\" + where, params).fetchone()[0]\n+        rows = db.execute(\n+            CUSTOMER_SELECT + where + \" GROUP BY c.id ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n+            [*params, paging[\"page_size\"], (paging[\"page\"] - 1) * paging[\"page_size\"]],\n+        ).fetchall()\n+        return {\"items\": [dict(row) for row in rows], \"total\": total, **paging}\n+\n+    @app.post(\"/api/customers\")\n+    @authenticated\n+    def add_customer():\n+        return save_customer()\n+\n+    @app.put(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def update_customer(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        return save_customer(customer_id)\n+\n+    def save_customer(customer_id=None):\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        fields, errors = customer_fields(body)\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        try:\n+            with db:\n+                if customer_id is None:\n+                    cursor = db.execute(\n+                        \"INSERT INTO customers (name, email, phone, company, notes, created_at) VALUES (?, ?, ?, ?, ?, ?)\",\n+                        (*fields.values(), timestamp()),\n+                    )\n+                    customer_id = cursor.lastrowid\n+                    status = 201\n+                else:\n+                    db.execute(\n+                        \"UPDATE customers SET name = ?, email = ?, phone = ?, company = ?, notes = ? WHERE id = ?\",\n+                        (*fields.values(), customer_id),\n+                    )\n+                    status = 200\n+        except sqlite3.IntegrityError:\n+            return error(\"A customer with this email already exists.\", 409, {\"email\": \"A customer with this email already exists.\"})\n+        return find_customer(customer_id), status\n+\n+    @app.get(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def get_customer(customer_id):\n+        return find_customer(customer_id) or error(\"Customer not found.\", 404)\n+\n+    @app.delete(\"/api/customers/<int:customer_id>\")\n+    @authenticated\n+    def delete_customer(customer_id):\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n+        if not cursor.rowcount:\n+            return error(\"Customer not found.\", 404)\n+        return \"\", 204\n+\n+    @app.get(\"/api/customers/<int:customer_id>/interactions\")\n+    @authenticated\n+    def list_interactions(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        rows = get_db().execute(\n+            \"\"\"SELECT i.id, i.customer_id, i.kind, i.summary, i.occurred_at, u.username AS logged_by\n+               FROM interactions i JOIN users u ON u.id = i.user_id WHERE i.customer_id = ?\n+               ORDER BY i.occurred_at DESC, i.id DESC\"\"\", (customer_id,),\n+        ).fetchall()\n+        return {\"items\": [dict(row) for row in rows]}\n+\n+    @app.post(\"/api/customers/<int:customer_id>/interactions\")\n+    @authenticated\n+    def add_interaction(customer_id):\n+        if find_customer(customer_id) is None:\n+            return error(\"Customer not found.\", 404)\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object.\")\n+        errors = {}\n+        kind = validate_text(body, \"kind\", errors, required=True)\n+        summary = validate_text(body, \"summary\", errors, required=True, limit=10000)\n+        if kind not in (\"call\", \"email\", \"meeting\"):\n+            errors[\"kind\"] = \"Choose call, email, or meeting.\"\n+        occurred_at = timestamp()\n+        if \"occurred_at\" in body:\n+            try:\n+                value = datetime.fromisoformat(body[\"occurred_at\"])\n+                if value.tzinfo is None:\n+                    value = value.replace(tzinfo=timezone.utc)\n+                occurred_at = timestamp(value)\n+            except (ValueError, TypeError, OverflowError):\n+                errors[\"occurred_at\"] = \"Enter a valid ISO 8601 date and time.\"\n+        if errors:\n+            return error(\"Please check the highlighted fields.\", errors=errors)\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, user_id) VALUES (?, ?, ?, ?, ?)\",\n+                (customer_id, kind, summary, occurred_at, g.user[\"id\"]),\n+            )\n+        return {\"id\": cursor.lastrowid, \"customer_id\": customer_id, \"kind\": kind,\n+                \"summary\": summary, \"occurred_at\": occurred_at, \"logged_by\": g.user[\"username\"]}, 201\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    app.config[\"DUMMY_HASH\"] = generate_password_hash(secrets.token_hex(32))\n+    return app\n+\n+\n+app = create_app()\n+\n+\n+if __name__ == \"__main__\":\n+    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n","additions":417,"deletions":0},{"filePath":"/workspace/.gitignore","relativePath":".gitignore","type":"add","patch":"Index: /workspace/.gitignore\n===================================================================\n--- /workspace/.gitignore\n+++ /workspace/.gitignore\n@@ -0,0 +1,7 @@\n+data/\n+frontend/node_modules/\n+frontend/dist/\n+__pycache__/\n+*.pyc\n+.venv/\n+.ruff_cache/\n","additions":7,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nD backend/app.py\nA backend/app.py\nA .gitignore","time":{"start":1794318538828,"end":1794318538848}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5b723f50013TJTdLsaqqgUZT","sessionID":"ses_e3a4b6a66ffe217KTQBOiu6abw","messageID":"msg_1c5b71a0c001MO69ySd386mtqB"}}
