: self.directory.name})\n+        self.client = self.app.test_client()\n+        self.owner = self.account(\"alice\")\n+        self.other = self.account(\"bob\")\n+\n+    def tearDown(self):\n+        self.directory.cleanup()\n+\n+    def account(self, username):\n+        credentials = {\"username\": username, \"password\": \"a-secure-password\"}\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json=credentials).status_code, 201)\n+        response = self.client.post(\"/api/auth/login\", json=credentials)\n+        self.assertEqual(response.status_code, 200)\n+        return {\"Authorization\": \"Bearer \" + response.json[\"token\"]}\n+\n+    def image_bytes(self, format=\"PNG\"):\n+        buffer = BytesIO()\n+        Image.new(\"RGB\", (12, 8), \"coral\").save(buffer, format=format)\n+        return buffer.getvalue()\n+\n+    def upload(self, headers=None, format=\"PNG\", **overrides):\n+        data = {\"filename\": \"same.jpg\", \"data\": base64.b64encode(self.image_bytes(format)).decode()}\n+        data.update(overrides)\n+        return self.client.post(\"/api/images\", json=data, headers=self.owner if headers is None else headers)\n+\n+    def test_health_and_empty_gallery(self):\n+        self.assertEqual(self.client.get(\"/api/health\").json, {\"status\": \"ok\"})\n+        self.assertEqual(self.client.get(\"/api/images\").json, {\"items\": [], \"total\": 0, \"page\": 1, \"page_size\": 12})\n+\n+    def test_authentication_and_logout(self):\n+        self.assertEqual(self.client.post(\"/api/images\", json={}).status_code, 401)\n+        self.assertEqual(self.client.delete(\"/api/images/1\").status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/images\", json={}, headers={\"Authorization\": \"Bearer wrong\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"}).status_code, 401)\n+        self.assertEqual(self.client.post(\"/api/auth/register\", json={\"username\": \"Alice\", \"password\": \"pass\"}).status_code, 409)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.owner).json, {\"username\": \"alice\"})\n+        self.assertEqual(self.client.post(\"/api/auth/logout\", headers=self.owner).status_code, 200)\n+        self.assertEqual(self.client.get(\"/api/auth/me\", headers=self.owner).status_code, 401)\n+\n+    def test_content_detection_metadata_and_unchanged_files(self):\n+        for format, content_type, filename in [(\"PNG\", \"image/png\", \"picture.jpg\"), (\"JPEG\", \"image/jpeg\", \"picture.png\")]:\n+            with self.subTest(format=format):\n+                response = self.upload(format=format, filename=filename, title=\"A quiet moment\")\n+                self.assertEqual(response.status_code, 201)\n+                image = response.json\n+                self.assertEqual(set(image), {\"id\", \"filename\", \"title\", \"content_type\", \"size_bytes\", \"uploaded_at\", \"url\", \"uploader\"})\n+                self.assertEqual(image[\"content_type\"], content_type)\n+                self.assertEqual(image[\"uploader\"], \"alice\")\n+                self.assertEqual(image[\"filename\"], filename)\n+                self.assertEqual(image[\"title\"], \"A quiet moment\")\n+                self.assertEqual(image[\"size_bytes\"], len(self.image_bytes(format)))\n+                file = self.client.get(image[\"url\"])\n+                self.assertEqual(file.data, self.image_bytes(format))\n+                self.assertEqual(file.content_type, content_type)\n+                self.assertEqual(self.client.get(f\"/api/images/{image['id']}\").json, image)\n+\n+    def test_duplicates_pagination_and_search(self):\n+        ids = [self.upload(title=f\"Picture {n}\").json[\"id\"] for n in range(3)]\n+        first = self.client.get(\"/api/images?page=1&page_size=2\").json\n+        self.assertEqual(first[\"total\"], 3)\n+        self.assertEqual([item[\"id\"] for item in first[\"items\"]], ids[::-1][:2])\n+        second = self.client.get(\"/api/images?page=2&page_size=2\").json\n+        self.assertEqual([item[\"id\"] for item in second[\"items\"]], ids[:1])\n+        self.assertEqual(self.client.get(\"/api/images?q=Picture%201\").json[\"total\"], 1)\n+        self.assertEqual(self.client.get(\"/api/images?uploader=bob\").json[\"total\"], 0)\n+        for query in [\"page=0\", \"page=abc\", \"page_size=0\", \"page_size=101\", \"page=-1\"]:\n+            self.assertEqual(self.client.get(\"/api/images?\" + query).status_code, 400)\n+\n+    def test_owner_only_delete_and_file_removed(self):\n+        image = self.upload().json\n+        self.assertEqual(self.client.delete(f\"/api/images/{image['id']}\", headers=self.other).status_code, 403)\n+        self.assertEqual(self.client.get(image[\"url\"]).status_code, 200)\n+        self.assertEqual(self.client.delete(f\"/api/images/{image['id']}\", headers=self.owner).status_code, 200)\n+        self.assertEqual(self.client.get(image[\"url\"]).status_code, 404)\n+        self.assertEqual(self.client.get(f\"/api/images/{image['id']}\").status_code, 404)\n+        self.assertEqual(self.client.get(\"/api/images\").json[\"total\"], 0)\n+        with sqlite3.connect(self.app.config[\"DATABASE\"]) as db:\n+            self.assertEqual(db.execute(\"SELECT COUNT(*) FROM image_files\").fetchone()[0], 0)\n+\n+    def test_reject_invalid_inputs(self):\n+        for body in [None, [], {}, {\"username\": [], \"password\": \"test\"}, {\"username\": \"a\", \"password\": \"\"}]:\n+            self.assertEqual(self.client.post(\"/api/auth/register\", json=body).status_code, 400)\n+        for overrides in [{\"data\": \"!!!\"}, {\"data\": \"a\"}, {\"data\": base64.b64encode(b\"not an image\").decode()}, {\"data\": \"\"}, {\"title\": 42}, {\"filename\": \"\"}, {\"filename\": \"a\\x00.jpg\"}]:\n+            self.assertEqual(self.upload(**overrides).status_code, 400)\n+        self.assertEqual(self.upload(format=\"GIF\").status_code, 400)\n+        raw = self.image_bytes()[:30]\n+        self.assertEqual(self.upload(data=base64.b64encode(raw).decode()).status_code, 400)\n+        self.assertEqual(self.client.get(\"/api/not-real\").status_code, 404)\n+        self.assertEqual(self.client.get(\"/api/not-real\").content_type, \"application/json\")\n+\n+    def test_oversize_rejected(self):\n+        self.assertEqual(self.upload(data=\"A\" * (21 * 1024 * 1024)).status_code, 413)\n+\n+    def test_persistence_across_restart(self):\n+        image = self.upload().json\n+        restarted = create_app({\"TESTING\": True, \"DATA_DIR\": self.directory.name}).test_client()\n+        self.assertEqual(restarted.get(image[\"url\"]).data, self.image_bytes())\n+        self.assertEqual(restarted.get(\"/api/images\").json[\"total\"], 1)\n+        self.assertEqual(restarted.get(\"/api/auth/me\", headers=self.owner).status_code, 200)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n\n","files":[{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"delete","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -1,23 +0,0 @@\n-\"\"\"Flask entry point.\"\"\"\n-\n-from pathlib import Path\n-\n-from flask import Flask\n-from flask import send_from_directory\n-\n-DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n-\n-app = Flask(__name__, static_folder=None)\n-\n-\n-@app.get(\"/api/health\")\n-def health():\n-    return {\"status\": \"ok\"}\n-\n-\n-@app.get(\"/\")\n-@app.get(\"/<path:path>\")\n-def frontend(path: str = \"index.html\"):\n-    if (DIST / path).is_file():\n-        return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n","additions":0,"deletions":24},{"filePath":"/workspace/backend/app.py","relativePath":"backend/app.py","type":"add","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -0,0 +1,335 @@\n+import base64\n+import binascii\n+import hashlib\n+import os\n+import re\n+import secrets\n+import sqlite3\n+import time\n+import warnings\n+from datetime import datetime, timezone\n+from functools import wraps\n+from io import BytesIO\n+from pathlib import Path\n+\n+from flask import Flask, g, request, send_file, send_from_directory\n+from PIL import Image, UnidentifiedImageError\n+from werkzeug.exceptions import HTTPException\n+from werkzeug.security import check_password_hash, generate_password_hash\n+\n+DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n+MAX_IMAGE_BYTES = 15 * 1024 * 1024\n+Image.MAX_IMAGE_PIXELS = 40_000_000\n+\n+\n+def create_app(config=None):\n+    app = Flask(__name__, static_folder=None)\n+    app.config.update(\n+        DATA_DIR=os.environ.get(\"DATA_DIR\", \"./data\"),\n+        MAX_CONTENT_LENGTH=22 * 1024 * 1024,\n+    )\n+    if config:\n+        app.config.update(config)\n+    data_dir = Path(app.config[\"DATA_DIR\"])\n+    data_dir.mkdir(parents=True, exist_ok=True)\n+    app.config[\"DATABASE\"] = str(data_dir / \"gallery.sqlite3\")\n+\n+    def get_db():\n+        if \"db\" not in g:\n+            g.db = sqlite3.connect(app.config[\"DATABASE\"], timeout=15)\n+            g.db.row_factory = sqlite3.Row\n+            g.db.execute(\"PRAGMA foreign_keys = ON\")\n+        return g.db\n+\n+    @app.teardown_appcontext\n+    def close_db(error=None):\n+        db = g.pop(\"db\", None)\n+        if db is not None:\n+            db.close()\n+\n+    with app.app_context():\n+        db = get_db()\n+        db.execute(\"PRAGMA journal_mode = WAL\")\n+        db.executescript(\"\"\"\n+            CREATE TABLE IF NOT EXISTS users (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n+                password_hash TEXT NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS sessions (\n+                token_hash TEXT PRIMARY KEY,\n+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n+                expires_at INTEGER NOT NULL\n+            );\n+            CREATE TABLE IF NOT EXISTS images (\n+                id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                filename TEXT NOT NULL,\n+                title TEXT,\n+                content_type TEXT NOT NULL,\n+                size_bytes INTEGER NOT NULL,\n+                uploaded_at TEXT NOT NULL,\n+                user_id INTEGER NOT NULL REFERENCES users(id)\n+            );\n+            CREATE TABLE IF NOT EXISTS image_files (\n+                image_id INTEGER PRIMARY KEY REFERENCES images(id) ON DELETE CASCADE,\n+                data BLOB NOT NULL\n+            );\n+            CREATE INDEX IF NOT EXISTS images_newest ON images(uploaded_at DESC, id DESC);\n+            CREATE INDEX IF NOT EXISTS images_uploader ON images(user_id);\n+        \"\"\")\n+        db.commit()\n+\n+    def error(message, status=400):\n+        return {\"error\": message}, status\n+\n+    def json_body():\n+        body = request.get_json(silent=True)\n+        return body if isinstance(body, dict) else None\n+\n+    def credentials(body):\n+        if body is None:\n+            return None\n+        username, password = body.get(\"username\"), body.get(\"password\")\n+        if not isinstance(username, str) or not isinstance(password, str):\n+            return None\n+        username = username.strip()\n+        if not re.fullmatch(r\"[A-Za-z0-9_.-]{1,32}\", username):\n+            return None\n+        if not 1 <= len(password) <= 256:\n+            return None\n+        return username, password\n+\n+    def authenticated(view):\n+        @wraps(view)\n+        def wrapped(*args, **kwargs):\n+            auth = request.headers.get(\"Authorization\", \"\").split()\n+            if len(auth) != 2 or auth[0].lower() != \"bearer\" or len(auth[1]) > 128:\n+                return error(\"Please sign in to continue.\", 401)\n+            token_hash = hashlib.sha256(auth[1].encode()).hexdigest()\n+            user = get_db().execute(\n+                \"SELECT users.id, users.username FROM sessions JOIN users \"\n+                \"ON users.id = sessions.user_id WHERE token_hash = ? AND expires_at > ?\",\n+                (token_hash, int(time.time())),\n+            ).fetchone()\n+            if user is None:\n+                return error(\"Your session has expired. Please sign in again.\", 401)\n+            g.user = user\n+            g.token_hash = token_hash\n+            return view(*args, **kwargs)\n+\n+        return wrapped\n+\n+    def description(row):\n+        return {\n+            \"id\": row[\"id\"],\n+            \"filename\": row[\"filename\"],\n+            \"title\": row[\"title\"],\n+            \"content_type\": row[\"content_type\"],\n+            \"size_bytes\": row[\"size_bytes\"],\n+            \"uploaded_at\": row[\"uploaded_at\"],\n+            \"url\": f\"/api/images/{row['id']}/file\",\n+            \"uploader\": row[\"username\"],\n+        }\n+\n+    def find_image(image_id):\n+        return get_db().execute(\n+            \"SELECT images.*, users.username FROM images \"\n+            \"JOIN users ON images.user_id = users.id WHERE images.id = ?\",\n+            (image_id,),\n+        ).fetchone()\n+\n+    @app.errorhandler(HTTPException)\n+    def http_error(exc):\n+        if exc.code == 413:\n+            return error(\"This image is too large. The maximum file size is 15 MB.\", 413)\n+        return error(exc.description, exc.code)\n+\n+    @app.after_request\n+    def security_headers(response):\n+        response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n+        response.headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\"\n+        response.headers[\"X-Frame-Options\"] = \"DENY\"\n+        response.headers[\"Content-Security-Policy\"] = (\n+            \"default-src 'self'; img-src 'self' blob: data:; \"\n+            \"style-src 'self' 'unsafe-inline'; script-src 'self'; \"\n+            \"object-src 'none'; base-uri 'self'; frame-ancestors 'none'\"\n+        )\n+        if request.path.startswith(\"/api/\"):\n+            response.headers[\"Cache-Control\"] = \"no-store\"\n+        return response\n+\n+    @app.get(\"/api/health\")\n+    def health():\n+        return {\"status\": \"ok\"}\n+\n+    @app.post(\"/api/auth/register\")\n+    def register():\n+        values = credentials(json_body())\n+        if values is None:\n+            return error(\n+                \"Use a username of 1–32 letters, numbers, dots, underscores or hyphens \"\n+                \"and a password of 1–256 characters.\"\n+            )\n+        username, password = values\n+        db = get_db()\n+        try:\n+            with db:\n+                db.execute(\n+                    \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n+                    (username, generate_password_hash(password)),\n+                )\n+        except sqlite3.IntegrityError:\n+            return error(\"That username is already taken. Try another one.\", 409)\n+        return {\"username\": username}, 201\n+\n+    @app.post(\"/api/auth/login\")\n+    def login():\n+        values = credentials(json_body())\n+        if values is None:\n+            return error(\"Enter a valid username and password.\")\n+        username, password = values\n+        db = get_db()\n+        user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n+        if user is None or not check_password_hash(user[\"password_hash\"], password):\n+            return error(\"The username or password is incorrect.\", 401)\n+        token = secrets.token_urlsafe(32)\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (int(time.time()),))\n+            db.execute(\n+                \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n+                (hashlib.sha256(token.encode()).hexdigest(), user[\"id\"], int(time.time()) + 2592000),\n+            )\n+        return {\"token\": token}\n+\n+    @app.get(\"/api/auth/me\")\n+    @authenticated\n+    def me():\n+        return {\"username\": g.user[\"username\"]}\n+\n+    @app.post(\"/api/auth/logout\")\n+    @authenticated\n+    def logout():\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n+        return {\"message\": \"Signed out.\"}\n+\n+    @app.get(\"/api/images\")\n+    def list_images():\n+        try:\n+            page = int(request.args.get(\"page\", \"1\"))\n+            page_size = int(request.args.get(\"page_size\", \"12\"))\n+        except ValueError:\n+            return error(\"Page and page_size must be positive integers.\")\n+        if page < 1 or not 1 <= page_size <= 100 or page > 1_000_000:\n+            return error(\"Page must be positive and page_size must be between 1 and 100.\")\n+        conditions, params = [], []\n+        uploader = request.args.get(\"uploader\", \"\").strip()\n+        search = request.args.get(\"q\", \"\").strip()[:200]\n+        if uploader:\n+            conditions.append(\"users.username = ?\")\n+            params.append(uploader)\n+        if search:\n+            pattern = \"%\" + search.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n+            conditions.append(\n+                \"(images.filename LIKE ? ESCAPE '\\\\' OR images.title LIKE ? ESCAPE '\\\\' \"\n+                \"OR users.username LIKE ? ESCAPE '\\\\')\"\n+            )\n+            params.extend([pattern] * 3)\n+        source = \" FROM images JOIN users ON images.user_id = users.id\"\n+        if conditions:\n+            source += \" WHERE \" + \" AND \".join(conditions)\n+        db = get_db()\n+        total = db.execute(\"SELECT COUNT(*)\" + source, params).fetchone()[0]\n+        rows = db.execute(\n+            \"SELECT images.*, users.username\" + source + \" ORDER BY uploaded_at DESC, images.id DESC LIMIT ? OFFSET ?\",\n+            [*params, page_size, (page - 1) * page_size],\n+        ).fetchall()\n+        return {\"items\": [description(row) for row in rows], \"total\": total, \"page\": page, \"page_size\": page_size}\n+\n+    @app.post(\"/api/images\")\n+    @authenticated\n+    def upload_image():\n+        body = json_body()\n+        if body is None:\n+            return error(\"Send a JSON object with filename and base64 data.\")\n+        filename, encoded, title = body.get(\"filename\"), body.get(\"data\"), body.get(\"title\")\n+        if not isinstance(filename, str) or not filename.strip() or len(filename) > 255 or any(ord(c) < 32 for c in filename):\n+            return error(\"Provide a filename of 1–255 characters.\")\n+        if title is not None and (not isinstance(title, str) or len(title) > 200):\n+            return error(\"The title must be text, up to 200 characters.\")\n+        if not isinstance(encoded, str) or not encoded:\n+            return error(\"Provide the image as base64 data.\")\n+        if len(encoded) > 4 * ((MAX_IMAGE_BYTES + 2) // 3):\n+            return error(\"This image is too large. The maximum file size is 15 MB.\", 413)\n+        try:\n+            raw = base64.b64decode(encoded, validate=True)\n+        except (ValueError, binascii.Error):\n+            return error(\"The image data is not valid base64.\")\n+        if len(raw) > MAX_IMAGE_BYTES:\n+            return error(\"This image is too large. The maximum file size is 15 MB.\", 413)\n+        try:\n+            with warnings.catch_warnings():\n+                warnings.simplefilter(\"error\", Image.DecompressionBombWarning)\n+                with Image.open(BytesIO(raw)) as image:\n+                    content_type = {\"PNG\": \"image/png\", \"JPEG\": \"image/jpeg\"}.get(image.format)\n+                    if content_type is None:\n+                        return error(\"Only PNG and JPEG images are supported.\")\n+                    image.verify()\n+                with Image.open(BytesIO(raw)) as image:\n+                    image.load()\n+        except (UnidentifiedImageError, OSError, ValueError, SyntaxError, Image.DecompressionBombError, Image.DecompressionBombWarning):\n+            return error(\"This file is not a valid PNG or JPEG image, or its dimensions are too large.\")\n+        uploaded_at = datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n+        db = get_db()\n+        with db:\n+            cursor = db.execute(\n+                \"INSERT INTO images (filename, title, content_type, size_bytes, uploaded_at, user_id) VALUES (?, ?, ?, ?, ?, ?)\",\n+                (filename.strip(), title.strip() or None if title is not None else None, content_type, len(raw), uploaded_at, g.user[\"id\"]),\n+            )\n+            db.execute(\"INSERT INTO image_files (image_id, data) VALUES (?, ?)\", (cursor.lastrowid, raw))\n+        return description(find_image(cursor.lastrowid)), 201\n+\n+    @app.get(\"/api/images/<int:image_id>\")\n+    def get_image(image_id):\n+        image = find_image(image_id)\n+        if image is None:\n+            return error(\"This image could not be found.\", 404)\n+        return description(image)\n+\n+    @app.get(\"/api/images/<int:image_id>/file\")\n+    def image_file(image_id):\n+        row = get_db().execute(\n+            \"SELECT data, content_type FROM image_files JOIN images ON images.id = image_files.image_id WHERE images.id = ?\",\n+            (image_id,),\n+        ).fetchone()\n+        if row is None:\n+            return error(\"This image could not be found.\", 404)\n+        return send_file(BytesIO(row[\"data\"]), mimetype=row[\"content_type\"], conditional=False)\n+\n+    @app.delete(\"/api/images/<int:image_id>\")\n+    @authenticated\n+    def delete_image(image_id):\n+        image = find_image(image_id)\n+        if image is None:\n+            return error(\"This image could not be found.\", 404)\n+        if image[\"user_id\"] != g.user[\"id\"]:\n+            return error(\"You can only delete images you uploaded.\", 403)\n+        db = get_db()\n+        with db:\n+            db.execute(\"DELETE FROM images WHERE id = ?\", (image_id,))\n+        return {\"message\": \"Image deleted.\"}\n+\n+    @app.get(\"/\")\n+    @app.get(\"/<path:path>\")\n+    def frontend(path=\"index.html\"):\n+        if path == \"api\" or path.startswith(\"api/\"):\n+            return error(\"API endpoint not found.\", 404)\n+        if (DIST / path).is_file():\n+            return send_from_directory(DIST, path)\n+        return send_from_directory(DIST, \"index.html\")\n+\n+    return app\n+\n+\n+app = create_app()\n","additions":335,"deletions":0},{"filePath":"/workspace/backend/requirements.txt","relativePath":"backend/requirements.txt","type":"update","patch":"Index: /workspace/backend/requirements.txt\n===================================================================\n--- /workspace/backend/requirements.txt\n+++ /workspace/backend/requirements.txt\n@@ -1,2 +1,3 @@\n flask==3.1.3\n gunicorn==26.2.0\n+pillow==12.2.0\n","additions":1,"deletions":0},{"filePath":"/workspace/backend/requirements.lock","relativePath":"backend/requirements.lock","type":"delete","patch":"Index: /workspace/backend/requirements.lock\n===================================================================\n--- /workspace/backend/requirements.lock\n+++ /workspace/backend/requirements.lock\n@@ -1,184 +0,0 @@\n-blinker==1.9.0 \\\n-    --hash=sha256:b4ce2265a7abece45e7cc896e98dbebe6cead56bcf805a3d23136d145f5445bf \\\n-    --hash=sha256:ba0efaa9080b619ff2f3459d1d500c57bddea4a6b424b60a91141db6fd2f08bc\n-    # via flask\n-click==8.5.0 \\\n-    --hash=sha256:255bc9599cf7748b4b1a446ccc735421b