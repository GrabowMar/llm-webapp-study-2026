Default();\n+    setError(\"\");\n+    setBusy(true);\n+    const body = JSON.stringify({ username: username.trim(), password });\n+    try {\n+      if (registering) await api(\"/auth/register\", { method: \"POST\", body });\n+      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, token);\n+      onSuccess({ token, username: user.username });\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to sign in. Please try again.\");\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <div className=\"p-7 sm:p-9\">\n+      <Aperture className=\"mb-6 text-accent\" size={34} strokeWidth={1.7} />\n+      <p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[.2em] text-muted\">Your point of view matters</p>\n+      <h2 className=\"font-serif text-3xl tracking-tight\">{registering ? \"Find your little space.\" : \"Welcome back.\"}</h2>\n+      <p className=\"mt-3 text-sm leading-relaxed text-muted\">{registering ? \"Join Folio and share the world through your lens.\" : \"Sign in to share a moment, or revisit your favorites.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+        <label className=\"block text-sm font-medium\">Username<input autoFocus autoComplete=\"username\" required pattern=\"[A-Za-z0-9_.\\-]+\" maxLength={32} value={username} onChange={(event) => setUsername(event.target.value)} placeholder=\"Your username\" className=\"form-input mt-2\" /><span className=\"mt-1.5 block text-xs font-normal text-muted\">Letters, numbers, dots, underscores and hyphens.</span></label>\n+        <label className=\"block text-sm font-medium\">Password<div className=\"relative mt-2\"><input autoComplete={registering ? \"new-password\" : \"current-password\"} type={showPassword ? \"text\" : \"password\"} required maxLength={256} value={password} onChange={(event) => setPassword(event.target.value)} placeholder={registering ? \"Choose a password\" : \"Your password\"} className=\"form-input pr-12\" /><button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute right-3 top-3.5 text-muted\">{showPassword ? <EyeOff size={18} /> : <Eye size={18} />}</button></div></label>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm leading-relaxed text-red-700\">{error}</p>}\n+        <button disabled={busy} className=\"button-primary w-full\">{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : null}{registering ? \"Create your account\" : \"Sign in\"}{!busy && <ArrowRight size={17} />}</button>\n+      </form>\n+      <p className=\"mt-6 text-center text-sm text-muted\">{registering ? \"Already part of the community?\" : \"New around here?\"} <button disabled={busy} onClick={() => { setMode(registering ? \"login\" : \"register\"); setError(\"\"); }} className=\"font-semibold text-accent hover:underline\">{registering ? \"Sign in\" : \"Join Folio\"}</button></p>\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/UploadForm.tsx\n+import { useEffect, useRef, useState, type FormEvent } from \"react\";\n+import { ArrowUpRight, Check, ImagePlus, LoaderCircle, Upload, X } from \"lucide-react\";\n+import { api, formatSize, type GalleryImage } from \"../api\";\n+\n+interface UploadFormProps {\n+  token: string;\n+  onSuccess: (image: GalleryImage) => void;\n+}\n+\n+export default function UploadForm({ token, onSuccess }: UploadFormProps) {\n+  const [file, setFile] = useState<File | null>(null);\n+  const [preview, setPreview] = useState(\"\");\n+  const [title, setTitle] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [dragging, setDragging] = useState(false);\n+  const input = useRef<HTMLInputElement>(null);\n+\n+  useEffect(() => {\n+    if (!file) { setPreview(\"\"); return; }\n+    const url = URL.createObjectURL(file);\n+    setPreview(url);\n+    return () => URL.revokeObjectURL(url);\n+  }, [file]);\n+\n+  function chooseFile(chosen: File | undefined) {\n+    if (!chosen) return;\n+    setError(\"\");\n+    if (![\"image/png\", \"image/jpeg\"].includes(chosen.type) && !/\\.(png|jpe?g)$/i.test(chosen.name)) {\n+      setError(\"Choose a PNG or JPEG image.\");\n+      return;\n+    }\n+    if (chosen.size > 15 * 1024 * 1024) { setError(\"This image is too large. The maximum file size is 15 MB.\"); return; }\n+    setFile(chosen);\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    if (!file) { setError(\"Choose an image to share first.\"); return; }\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      const data = await new Promise<string>((resolve, reject) => {\n+        const reader = new FileReader();\n+        reader.onload = () => resolve((reader.result as string).split(\",\")[1]);\n+        reader.onerror = () => reject(new Error(\"We couldn’t read this file. Try selecting it again.\"));\n+        reader.readAsDataURL(file);\n+      });\n+      const image = await api<GalleryImage>(\"/images\", { method: \"POST\", body: JSON.stringify({ filename: file.name, data, title: title.trim() || null }) }, token);\n+      onSuccess(image);\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to upload. Please try again.\");\n+    } finally { setBusy(false); }\n+  }\n+\n+  return (\n+    <div className=\"p-7 sm:p-9\">\n+      <div className=\"mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-accent/10 text-accent\"><ImagePlus size={24} strokeWidth={1.6} /></div>\n+      <h2 className=\"font-serif text-3xl tracking-tight\">Share your perspective.</h2>\n+      <p className=\"mt-2 text-sm leading-relaxed text-muted\">A place, a feeling, a little moment worth keeping.</p>\n+      <form onSubmit={submit} className=\"mt-6 space-y-5\">\n+        <input ref={input} type=\"file\" accept=\"image/png,image/jpeg,.png,.jpg,.jpeg\" onChange={(event) => { chooseFile(event.target.files?.[0]); event.target.value = \"\"; }} className=\"hidden\" aria-label=\"Choose an image\" />\n+        {preview && file ? (\n+          <div className=\"overflow-hidden rounded-xl border border-line bg-white\">\n+            <div className=\"relative flex h-48 items-center justify-center bg-line/40\"><img src={preview} alt=\"Preview of your selected image\" className=\"h-full w-full object-contain\" /><button type=\"button\" disabled={busy} onClick={() => setFile(null)} aria-label=\"Remove selected image\" className=\"absolute right-2 top-2 rounded-full bg-white/90 p-1.5\"><X size={16} /></button></div>\n+            <div className=\"flex items-center justify-between gap-3 p-3\"><div className=\"min-w-0\"><p className=\"truncate text-xs font-medium\">{file.name}</p><p className=\"mt-1 text-xs text-muted\">{formatSize(file.size)}</p></div><Check size={17} className=\"shrink-0 text-green-700\" /></div>\n+          </div>\n+        ) : (\n+          <button type=\"button\" disabled={busy} onClick={() => input.current?.click()} onDragOver={(event) => { event.preventDefault(); setDragging(true); }} onDragLeave={() => setDragging(false)} onDrop={(event) => { event.preventDefault(); setDragging(false); chooseFile(event.dataTransfer.files[0]); }} className={`flex w-full flex-col items-center rounded-xl border-2 border-dashed px-5 py-9 transition ${dragging ? \"border-accent bg-accent/10\" : \"border-line bg-white hover:border-accent/50 hover:bg-accent/5\"}`}><Upload size={25} strokeWidth={1.4} className=\"mb-3 text-accent\" /><span className=\"text-sm font-medium\">Drop your image here</span><span className=\"mt-1 text-xs text-muted\">or <span className=\"text-accent\">browse files</span></span><span className=\"mt-4 text-[11px] text-muted\">PNG or JPEG · Up to 15 MB</span></button>\n+        )}\n+        <label className=\"block text-sm font-medium\">Give it a title <span className=\"font-normal text-muted\">(optional)</span><input className=\"form-input mt-2\" value={title} onChange={(event) => setTitle(event.target.value)} maxLength={200} placeholder=\"What’s the story?\" disabled={busy} /></label>\n+        <p className=\"flex items-start gap-2 text-xs leading-relaxed text-muted\"><span className=\"mt-0.5 shrink-0\"><ImagePlus size={14} /></span>Your image will be visible to everyone. You can delete it at any time.</p>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+        <button className=\"button-primary w-full\" disabled={busy || !file}>{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : <ArrowUpRight size={17} />}{busy ? \"Sharing your image…\" : \"Share image\"}</button>\n+      </form>\n+    </div>\n+  );\n+}\n*** Add File: /workspace/frontend/src/components/ImageViewer.tsx\n+import { useState } from \"react\";\n+import { ArrowUpRight, CalendarDays, Image, LoaderCircle, Trash2, UserRound } from \"lucide-react\";\n+import { api, formatDate, formatSize, type GalleryImage, type Session } from \"../api\";\n+\n+interface ImageViewerProps {\n+  image: GalleryImage;\n+  session: Session | null;\n+  onDeleted: () => void;\n+}\n+\n+export default function ImageViewer({ image, session, onDeleted }: ImageViewerProps) {\n+  const [confirming, setConfirming] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [broken, setBroken] = useState(false);\n+  const ownImage = session?.username === image.uploader;\n+\n+  async function remove() {\n+    if (!session) return;\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      await api(`/images/${image.id}`, { method: \"DELETE\" }, session.token);\n+      onDeleted();\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to delete this image.\");\n+    } finally { setBusy(false); }\n+  }\n+\n+  return (\n+    <div>\n+      <div className=\"flex min-h-48 items-center justify-center rounded-t-2xl bg-[#e9e9e2] p-3 sm:p-5\">\n+        {broken ? <p className=\"py-20 text-sm text-muted\">This image is no longer available.</p> : <img src={image.url} alt={image.title || image.filename} onError={() => setBroken(true)} className=\"max-h-[64dvh] max-w-full rounded object-contain\" />}\n+      </div>\n+      <div className=\"p-6 sm:p-8\">\n+        <div className=\"flex flex-wrap items-start justify-between gap-4\"><div className=\"min-w-0\"><p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[.16em] text-accent\">A shared perspective</p><h2 className=\"break-words font-serif text-3xl\">{image.title || image.filename}</h2>{image.title && <p className=\"mt-2 break-all text-sm text-muted\">{image.filename}</p>}</div><a href={image.url} target=\"_blank\" rel=\"noreferrer\" className=\"button-secondary text-xs\">View original <ArrowUpRight size={15} /></a></div>\n+        <div className=\"mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-5 text-xs text-muted\"><span className=\"flex items-center gap-2\"><UserRound size={14} /><span className=\"font-medium text-ink\">{image.uploader}</span></span><span className=\"flex items-center gap-2\"><CalendarDays size={14} />{formatDate(image.uploaded_at)}</span><span className=\"flex items-center gap-2\"><Image size={14} />{formatSize(image.size_bytes)} · {image.content_type === \"image/png\" ? \"PNG\" : \"JPEG\"}</span></div>\n+        {ownImage && <div className=\"mt-6 border-t border-line pt-5\">{confirming ? <div className=\"rounded-xl border border-red-100 bg-red-50 p-4\"><p className=\"text-sm font-semibold\">Delete this image?</p><p className=\"mt-1 text-xs leading-relaxed text-muted\">It will be removed from the gallery permanently. This can’t be undone.</p><div className=\"mt-4 flex gap-3\"><button disabled={busy} onClick={remove} className=\"inline-flex items-center gap-2 rounded-lg bg-red-700 px-4 py-2 text-xs font-semibold text-white hover:bg-red-800 disabled:opacity-50\">{busy ? <LoaderCircle size={14} className=\"animate-spin\" /> : <Trash2 size={14} />}Delete image</button><button disabled={busy} onClick={() => setConfirming(false)} className=\"button-secondary py-2 text-xs\">Keep image</button></div></div> : <button onClick={() => setConfirming(true)} className=\"flex items-center gap-2 text-xs font-medium text-red-700 hover:underline\"><Trash2 size={14} />Delete your image</button>}</div>}\n+        {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+      </div>\n+    </div>\n+  );\n+}\n*** Delete File: /workspace/frontend/src/App.tsx\n*** Add File: /workspace/frontend/src/App.tsx\n+import { useEffect, useRef, useState } from \"react\";\n+import { Aperture, ArrowDown, ArrowRight, ArrowUpRight, Check, ChevronLeft, ChevronRight, Globe2, Grid2X2, Heart, ImagePlus, Images, LayoutGrid, Leaf, LoaderCircle, LogOut, Search, Sparkles, UserRound, X } from \"lucide-react\";\n+import { api, formatDate, readToken, saveToken, type GalleryImage, type ImagePage, type Session } from \"./api\";\n+import Modal from \"./components/Modal\";\n+import Landscape from \"./components/Landscape\";\n+import AuthForm from \"./components/AuthForm\";\n+import UploadForm from \"./components/UploadForm\";\n+import ImageViewer from \"./components/ImageViewer\";\n+\n+type Dialog = \"login\" | \"register\" | \"upload\" | \"about\" | null;\n+\n+export default function App() {\n+  const [session, setSession] = useState<Session | null>(null);\n+  const [checkingSession, setCheckingSession] = useState(Boolean(readToken()));\n+  const [dialog, setDialog] = useState<Dialog>(null);\n+  const [selected, setSelected] = useState<GalleryImage | null>(null);\n+  const [result, setResult] = useState<ImagePage>({ items: [], total: 0, page: 1, page_size: 12 });\n+  const [page, setPage] = useState(1);\n+  const [query, setQuery] = useState(\"\");\n+  const [search, setSearch] = useState(\"\");\n+  const [mine, setMine] = useState(false);\n+  const [compact, setCompact] = useState(false);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [refresh, setRefresh] = useState(0);\n+  const [notice, setNotice] = useState(\"\");\n+  const [signingOut, setSigningOut] = useState(false);\n+  const gallery = useRef<HTMLElement>(null);\n+  const uploadAfterLogin = useRef(false);\n+  const uploader = mine ? session?.username : undefined;\n+\n+  useEffect(() => {\n+    const token = readToken();\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<{ username: string }>(\"/auth/me\", { signal: controller.signal }, token)\n+      .then((user) => setSession({ token, username: user.username }))\n+      .catch((error) => { if (error.name !== \"AbortError\") saveToken(null); })\n+      .finally(() => { if (!controller.signal.aborted) setCheckingSession(false); });\n+    return () => controller.abort();\n+  }, []);\n+\n+  useEffect(() => {\n+    function expired() {\n+      saveToken(null);\n+      setSession(null);\n+      setMine(false);\n+      setNotice(\"Your session has expired. Please sign in again.\");\n+    }\n+    window.addEventListener(\"folio:session-expired\", expired);\n+    return () => window.removeEventListener(\"folio:session-expired\", expired);\n+  }, []);\n+\n+  useEffect(() => {\n+    const timeout = window.setTimeout(() => { setSearch(query.trim()); setPage(1); }, 300);\n+    return () => window.clearTimeout(timeout);\n+  }, [query]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    const params = new URLSearchParams({ page: String(page), page_size: \"12\" });\n+    if (search) params.set(\"q\", search);\n+    if (uploader) params.set(\"uploader\", uploader);\n+    api<ImagePage>(`/images?${params}`, { signal: controller.signal })\n+      .then((data) => {\n+        if (page > 1 && data.items.length === 0 && data.total > 0) setPage(Math.ceil(data.total / 12));\n+        else if (page > 1 && data.total === 0) setPage(1);\n+        else setResult(data);\n+      })\n+      .catch((error) => { if (error.name !== \"AbortError\") setError(error.message); })\n+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    return () => controller.abort();\n+  }, [page, search, uploader, refresh]);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 5500);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  function scrollToGallery() {\n+    gallery.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n+  }\n+\n+  function openUpload() {\n+    if (session) setDialog(\"upload\");\n+    else { uploadAfterLogin.current = true; setDialog(\"login\"); }\n+  }\n+\n+  function signedIn(user: Session) {\n+    saveToken(user.token);\n+    setSession(user);\n+    setDialog(uploadAfterLogin.current ? \"upload\" : null);\n+    uploadAfterLogin.current = false;\n+    setNotice(`Welcome to your little space, ${user.username}.`);\n+  }\n+\n+  async function signOut() {\n+    if (!session) return;\n+    setSigningOut(true);\n+    try {\n+      await api(\"/auth/logout\", { method: \"POST\" }, session.token);\n+      saveToken(null);\n+      setSession(null);\n+      setMine(false);\n+      setPage(1);\n+      setNotice(\"You’re signed out. Stay a while and explore.\");\n+    } catch (error) {\n+      setNotice(error instanceof Error ? error.message : \"Unable to sign out. Try again.\");\n+    } finally { setSigningOut(false); }\n+  }\n+\n+  function closeDialog() {\n+    setDialog(null);\n+    uploadAfterLogin.current = false;\n+  }\n+\n+  const totalPages = Math.max(1, Math.ceil(result.total / 12));\n+  const filtered = Boolean(search || mine);\n+\n+  return (\n+    <div className=\"min-h-screen\">\n+      <header className=\"border-b border-line bg-paper/95\">\n+        <div className=\"mx-auto flex h-20 max-w-[1320px] items-center justify-between gap-5 px-5 sm:px-8 lg:px-14\">\n+          <a href=\"/\" aria-label=\"Folio home\" className=\"flex items-center gap-2.5\"><Aperture size={31} className=\"text-accent\" strokeWidth={1.7} /><span className=\"text-[30px] font-semibold tracking-[-1.8px]\">folio<span className=\"text-accent\">.</span></span></a>\n+          <nav className=\"ml-10 hidden h-full items-center gap-8 md:flex\" aria-label=\"Main navigation\"><button onClick={scrollToGallery} className=\"relative flex h-full items-center text-[13px] font-semibold after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-accent\">Discover</button><button onClick={() => setDialog(\"about\")} className=\"text-[13px] text-muted transition hover:text-ink\">Our little space <ArrowUpRight size={12} className=\"ml-1 inline\" /></button></nav>\n+          <div className=\"ml-auto flex items-center gap-3 sm:gap-5\">\n+            {checkingSession ? <LoaderCircle size={19} className=\"animate-spin text-muted\" /> : session ? <><span className=\"flex max-w-44 items-center gap-2 text-xs font-medium sm:text-sm\"><span className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#e9ecdf] text-[#64744e]\"><UserRound size={15} /></span><span className=\"max-w-24 truncate sm:max-w-36\">{session.username}</span></span><button onClick={signOut} disabled={signingOut} className=\"flex items-center gap-1.5 text-xs text-muted hover:text-ink\" aria-label=\"Sign out\">{signingOut ? <LoaderCircle size={15} className=\"animate-spin\" /> : <LogOut size={15} />}<span className=\"hidden sm:inline\">Sign out</span></button></> : <><button onClick={() => setDialog(\"login\")} className=\"text-[13px] font-medium hover:text-accent\">Sign in</button><button onClick={() => setDialog(\"register\")} className=\"button-secondary px-3 py-2 text-xs sm:px-4 sm:text-[13px]\">Join Folio <ArrowUpRight size={14} className=\"hidden sm:block\" /></button></>}\n+          </div>\n+        </div>\n+      </header>\n+\n+      <main className=\"mx-auto max-w-[1320px] px-5 pb-16 pt-10 sm:px-8 sm:pt-12 lg:px-14\">\n+        <section className=\"mb-9 flex flex-col justify-between gap-7 md:flex-row md:items-end lg:mb-10\">\n+          <div><p className=\"mb-4 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[.2em] text-muted\"><span className=\"h-1.5 w-1.5 rounded-full bg-[#8e9a73]\" />A shared point of view</p><h1 className=\"text-[38px] font-medium leading-[1.14] tracking-[-1.6px] sm:text-[48px] sm:tracking-[-2px] lg:text-[53px]\">The everyday.<br />Seen <span className=\"font-serif italic font-normal text-accent\">differently.</span></h1></div>\n+          <div className=\"max-w-[330px] pb-1 md:pb-0\"><p className=\"text-[13px] leading-[1.8] text-muted\">A collection of moments, places, and perspectives.<br className=\"hidden lg:block\" /> Discover something beautiful. Share something you.</p><button onClick={openUpload} disabled={checkingSession} className=\"button-primary mt-5\"><ImagePlus size={17} strokeWidth={1.7} />Upload an image<ArrowUpRight size={16} className=\"ml-4\" /></button></div>\n+        </section>\n+\n+        <section className=\"relative mb-12 grid min-h-[280px] overflow-hidden rounded-xl border border-[#dce0d3] bg-[#eaece1] md:grid-cols-[.95fr_1.7fr]\" aria-label=\"Welcome to Folio\">\n+          <div className=\"absolute bottom-0 right-0 top-0 w-full opacity-60 md:w-[74%] md:opacity-100\"><Landscape /></div>\n+          <div className=\"relative z-1 flex flex-col items-start px-7 py-8 sm:px-9 sm:py-9\"><span className=\"mb-4 flex items-center gap-1.5 rounded-full border border-[#939d7c]/35 bg-[#eaece1]/70 px-2.5 py-1 text-[9px] font-medium uppercase tracking-[.13em] text-[#62714f]\"><Leaf size={11} />Made for your moments</span><h2 className=\"font-serif text-[32px] leading-[1.15] tracking-[-.7px] sm:text-[36px]\">Big adventures.<br />Small observations.<br /><span className=\"italic\">All welcome here.</span></h2><button onClick={scrollToGallery} className=\"mt-6 flex items-center gap-3 text-xs font-medium\"><span className=\"flex h-7 w-7 items-center justify-center rounded-full border border-ink/25 transition hover:bg-white/60\"><ArrowDown size={13} /></span>Take a look around</button></div>\n+          <div className=\"absolute bottom-5 right-6 hidden items-center gap-2 rounded-full border border-white/25 bg-[#284d3d]/35 px-3 py-1.5 text-[9px] tracking-wide text-white/90 backdrop-blur-sm sm:flex\"><Aperture size={12} />A little wonder goes a long way</div>\n+          <span className=\"absolute right-6 top-6 hidden text-[9px] uppercase tracking-[.2em] text-[#53684f] md:block\">Less scrolling. More seeing.</span>\n+        </section>\n+\n+        <section ref={gallery} className=\"scroll-mt-8\" aria-label=\"Image gallery\">\n+          <div className=\"mb-5 flex flex-wrap items-center justify-between gap-4\"><div className=\"flex items-center gap-3\"><h2 className=\"text-[22px] font-semibold tracking-[-.7px]\">The gallery</h2><span className=\"rounded-full border border-line px-2 py-0.5 text-[11px] text-muted\">{loading ? \"…\" : result.total}</span></div><span className=\"flex items-center gap-1.5 text-[11px] text-muted\"><span className=\"h-1 w-1 rounded-full bg-accent/70\" />Fresh perspectives, newest first</span></div>\n+          <div className=\"mb-6 flex flex-col justify-between gap-4 border-b border-line pb-5 sm:flex-row sm:items-center\">\n+            <div className=\"flex items-center gap-2\"><button onClick={() => { setMine(false); setPage(1); }} className={`flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-xs font-medium transition ${!mine ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50\"}`}><Globe2 size={14} />All images</button>{session && <button onClick={() => { setMine(true); setPage(1); }} className={`flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-xs font-medium transition ${mine ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50\"}`}><UserRound size={14} />My uploads</button>}</div>\n+            <div className=\"flex items-center gap-3\"><div className=\"relative min-w-0 flex-1 sm:w-56 sm:flex-none\"><Search size={15} className=\"absolute left-3 top-3 text-muted\" /><input aria-label=\"Search images\" placeholder=\"Find a little inspiration…\" value={query} onChange={(event) => setQuery(event.target.value)} className=\"w-full rounded-lg border border-line bg-transparent py-2.5 pl-9 pr-8 text-xs placeholder:text-muted/80 focus:border-accent\" />{query && <button onClick={() => setQuery(\"\")} aria-label=\"Clear search\" className=\"absolute right-2.5 top-3 text-muted\"><X size={13} /></button>}</div><div className=\"flex items-center rounded-lg border border-line p-1\"><button aria-label=\"Comfortable grid\" aria-pressed={!compact} onClick={() => setCompact(false)} className={`rounded p-1.5 ${!compact ? \"bg-[#eaeae2] text-ink\" : \"text-muted hover:text-ink\"}`}><LayoutGrid size={15} /></button><button aria-label=\"Compact grid\" aria-pressed={compact} onClick={() => setCompact(true)} className={`rounded p-1.5 ${compact ? \"bg-[#eaeae2] text-ink\" : \"text-muted hover:text-ink\"}`}><Grid2X2 size={15} /></button></div></div>\n+          </div>\n+\n+          {loading ? <div role=\"status\" aria-label=\"Loading images\" className={`grid gap-5 ${compact ? \"grid-cols-2 sm:grid-cols-3 lg:grid-cols-4\" : \"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"}`}>{Array.from({ length: 3 }, (_, i) => <div key={i} className=\"animate-pulse overflow-hidden rounded-xl border border-line bg-white\"><div className=\"aspect-[4/3] bg-line/70\" /><div className=\"space-y-3 p-4\"><div className=\"h-3 w-2/3 rounded bg-line\" /><div className=\"h-2 w-1/3 rounded bg-line/70\" /></div></div>)}</div> : error ? <div className=\"flex min-h-64 flex-col items-center justify-center rounded-xl border border-line bg-white p-6 text-center\"><Images size={30} className=\"mb-4 text-muted\" /><h3 className=\"text-lg font-medium\">A little trouble loading the gallery.</h3><p role=\"alert\" className=\"mt-2 max-w-md text-sm text-muted\">{error}</p><button onClick={() => setRefresh(refresh + 1)} className=\"button-secondary mt-5\">Try again <ArrowRight size={14} /></button></div> : result.items.length === 0 ? (\n+            <div className=\"relative flex min-h-[270px] flex-col items-center justify-center overflow-hidden rounded-xl border border-line bg-white/65 px-5 py-9 text-center\">\n+              <div className=\"relative mb-5\"><span className=\"absolute -left-6 top-1 h-1.5 w-1.5 rounded-full bg-[#b6bd9b]\" /><span className=\"absolute -right-5 bottom-1 h-1 w-1 rounded-full bg-accent/45\" /><div className=\"flex h-14 w-14 -rotate-6 items-center justify-center rounded-xl border border-[#dce0d2] bg-[#f0f2e9]\"><Images size={27} strokeWidth={1.2} className=\"text-[#7a8866]\" /></div><Sparkles size={14} strokeWidth={1.4} className=\"absolute -right-3 -top-1 text-accent/65\" /></div>\n+              <h3 className=\"font-serif text-[25px] tracking-[-.4px]\">{search ? \"A different view, perhaps?\" : mine ? \"Your story starts with one image.\" : \"A blank canvas. Endless possibilities.\"}</h3>\n+              <p className=\"mt-2 max-w-sm text-xs leading-[1.8] text-muted\">{search ? `No images found for “${search}”. Try a different word or explore the whole gallery.` : mine ? \"You haven’t shared any images yet. Let us see the world through your lens.\" : \"Every collection starts somewhere. Be the first to share a moment and make this space a little more you.\"}</p>\n+              {filtered ? <div className=\"mt-5 flex items-center gap-4\">{mine && !search && <button onClick={openUpload} className=\"flex items-center gap-2 text-xs font-semibold text-accent hover:underline\">Share your first image <ArrowUpRight size={14} /></button>}<button onClick={() => { setQuery(\"\"); setSearch(\"\"); setMine(false); setPage(1); }} className=\"text-xs font-medium text-muted hover:text-ink\">Explore all images <ArrowRight size={13} className=\"ml-1 inline\" /></button></div> : <button onClick={openUpload} disabled={checkingSession} className=\"mt-5 flex items-center gap-2 text-xs font-semibold text-accent hover:underline\"><ImagePlus size={14} />Share the first image<ArrowUpRight size={14} /></button>}\n+              {!filtered && <span className=\"absolute bottom-5 right-5 hidden text-[9px] uppercase tracking-[.17em] text-muted/50 sm:block\">Good things start small</span>}\n+            </div>\n+          ) : (\n+            <div className={`grid gap-x-5 gap-y-7 ${compact ? \"grid-cols-2 sm:grid-cols-3 lg:grid-cols-4\" : \"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"}`}>\n+              {result.items.map((image) => <article key={image.id} className=\"group min-w-0\"><button onClick={() => setSelected(image)} aria-label={`View ${image.title || image.filename}`} className=\"relative block aspect-[4/3] w-full overflow-hidden rounded-xl bg-[#e9e9e2]\"><img src={image.url} alt={image.title || image.filename} loading=\"lazy\" className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035] motion-reduce:transition-none\" /><span className=\"absolute inset-0 bg-black/0 transition group-hover:bg-black/10\" /><span className=\"absolute bottom-3 right-3 flex h-8 w-8 translate-y-1 items-center justify-center rounded-full bg-white/95 text-ink opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:opacity-100\"><ArrowUpRight size={16} /></span>{image.uploader === session?.username && <span className=\"absolute left-3 top-3 rounded-full bg-white/95 px-2 py-1 text-[9px] font-medium\">Your perspective</span>}<span className=\"absolute right-3 top-3 rounded bg-black/20 px-1.5 py-0.5 text-[9px] font-medium tracking-wide text-white backdrop-blur-sm\">{image.content_type === \"image/png\" ? \"PNG\" : \"JPEG\"}</span></button><div className=\"px-0.5 pt-3.5\"><button onClick={() => setSelected(image)} className=\"block max-w-full truncate text-left text-[14px] font-medium tracking-[-.2px] transition hover:text-accent\">{image.title || image.filename}</button><div className=\"mt-2 flex flex-wrap items-center justify-between gap-2 text-[10px] text-muted\"><span className=\"flex min-w-0 items-center gap-1.5\"><span className=\"flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-line/70\"><UserRound size={9} /></span><span className=\"max-w-32 truncate\">{image.uploader}</span></span><time dateTime={image.uploaded_at}>{formatDate(image.uploaded_at)}</time></div></div></article>)}\n+            </div>\n+          )}\n+\n+          <div className=\"mt-6 flex items-center justify-between gap-3 text-[11px] text-muted\"><p>{result.total ? `Showing ${(page - 1) * 12 + 1}–${Math.min(page * 12, result.total)} of ${result.total} images` : \"A little space, waiting to be filled.\"}</p><nav aria-label=\"Gallery pagination\" className=\"flex items-center gap-3\"><button onClick={() => { setPage(page - 1); scrollToGallery(); }} disabled={loading || page <= 1} aria-label=\"Previous page\" className=\"rounded-md border border-line p-1.5 hover:bg-white disabled:opacity-30\"><ChevronLeft size={14} /></button><span>Page {page} of {totalPages}</span><button onClick={() => { setPage(page + 1); scrollToGallery(); }} disabled={loading || page >= totalPages} aria-label=\"Next page\" className=\"rounded-md border border-line p-1.5 hover:bg-white disabled:opacity-30\"><ChevronRight size={14} /></button></nav></div>\n+        </section>\n+\n+        <div className=\"mt-12 grid grid-cols-1 gap-5 border-t border-line pt-7 sm:grid-cols-3 sm:gap-8\"><div className=\"flex items-start gap-3\"><Globe2 size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Different eyes. One community.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">A gallery for everyone, from everywhere.</p></div></div><div className=\"flex items-start gap-3\"><ImagePlus size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Your images, just as they are.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">Original quality. No filters. All you.</p></div></div><div className=\"flex items-start gap-3\"><Heart size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Keep it thoughtful. Keep it yours.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">Share what you create. Inspire someone else.</p></div></div></div>\n+      </main>\n+\n+      <footer className=\"border-t border-line\"><div className=\"mx-auto flex max-w-[1320px] flex-col items-start justify-between gap-4 px-5 py-6 sm:flex-row sm:items-center sm:px-8 lg:px-14\"><div className=\"flex items-center gap-3\"><Aperture size={20} className=\"text-accent\" strokeWidth={1.6} /><span className=\"text-sm font-semibold tracking-[-.5px]\">folio.</span><span className=\"ml-2 border-l border-line pl-4 text-[10px] text-muted\">A little space for the things you see.</span></div><button onClick={() => setDialog(\"about\")} className=\"flex items-center gap-1.5 text-[10px] text-muted hover:text-accent\">Made for a shared point of view <ArrowUpRight size={12} /></button></div></footer>\n+\n+      {notice && <div role=\"status\" className=\"fixed bottom-5 left-1/2 z-50 flex w-[calc(100%-2rem)] max-w-md -translate-x-1/2 items-center gap-3 rounded-xl border border-line bg-ink px-4 py-3.5 text-xs leading-relaxed text-white shadow-xl\"><Check size={17} className=\"shrink-0 text-[#b4c49a]\" /><span className=\"flex-1\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss message\" className=\"p-1 text-white/70\"><X size={14} /></button></div>}\n+      {(dialog === \"login\" || dialog === \"register\") && <Modal title={dialog === \"login\" ? \"Sign in to Folio\" : \"Join Folio\"} onClose={closeDialog}><AuthForm initialMode={dialog} onSuccess={signedIn} /></Modal>}\n+      {dialog === \"upload\" && session && <Modal title=\"Upload an image\" onClose={closeDialog}><UploadForm token={session.token} onSuccess={() => { setDialog(null); setMine(false); setQuery(\"\"); setSearch(\"\"); setPage(1); setRefresh(refresh + 1); setNotice(\"Your perspective is now part of the gallery.\"); window.setTimeout(scrollToGallery, 100); }} /></Modal>}\n+      {dialog === \"about\" && <Modal title=\"About Folio\" onClose={closeDialog}><div className=\"p-8 sm:p-10\"><Aperture size={36} strokeWidth={1.5} className=\"mb-6 text-accent\" /><p className=\"mb-3 text-[10px] uppercase tracking-[.18em] text-muted\">Our little space</p><h2 className=\"font-serif text-3xl leading-tight\">There’s wonder<br />in the everyday.</h2><div className=\"mt-5 space-y-4 text-sm leading-[1.8] text-muted\"><p>Folio is a shared gallery for the way you see the world. Big adventures, quiet corners, fleeting light — every perspective belongs here.</p><p>Anyone can explore. Create an account to share your own PNG or JPEG images, in their original quality. Your uploads stay yours to delete, whenever you choose.</p><p>Share only images you own or have permission to use, and keep this a thoughtful space for everyone.</p></div><button onClick={() => { closeDialog(); scrollToGallery(); }} className=\"button-primary mt-6\">Find a new perspective <ArrowRight size={16} /></button></div></Modal>}\n+      {selected && <Modal title={selected.title || selected.filename} onClose={() => setSelected(null)} wide><ImageViewer image={selected} session={session} onDeleted={() => { setSelected(null); setRefresh(refresh + 1); setNotice(\"Image deleted. A little room for something new.\"); }} /></Modal>}\n+    </div>\n+  );\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/src/api.ts\nA frontend/src/components/Modal.tsx\nA frontend/src/components/Landscape.tsx\nA frontend/src/components/AuthForm.tsx\nA frontend/src/components/UploadForm.tsx\nA frontend/src/components/ImageViewer.tsx\nD frontend/src/App.tsx\nA frontend/src/App.tsx","metadata":{"diff":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"@tailwindcss/vite\": \"^4.3.5\",\n   \"lucide-react\": \"^1.71.0\",\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,19 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"isolatedModules\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,21 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: globals.browser },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,26 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-paper: #faf9f6;\n+  --color-ink: #292c27;\n+  --color-muted: #797c72;\n+  --color-line: #e5e5dc;\n+  --color-accent: #c85432;\n+  --color-accent-dark: #ad4327;\n+}\n+\n+@layer base {\n+  body { @apply m-0 bg-paper font-sans text-ink antialiased; }\n+  button, a, input, select { @apply outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4; }\n+  button { @apply cursor-pointer disabled:cursor-not-allowed; }\n+  ::selection { @apply bg-accent/20; }\n+  dialog::backdrop { @apply bg-ink/60 backdrop-blur-sm; }\n+}\n+\n+@layer components {\n+  .button-primary { @apply inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-dark disabled:opacity-50; }\n+  .button-secondary { @apply inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-white px-4 py-2.5 text-sm font-medium transition hover:border-ink/30 hover:bg-paper disabled:opacity-40; }\n+  .form-input { @apply w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm placeholder:text-muted/65 focus:border-accent focus:ring-2 focus:ring-accent/15 focus:ring-offset-0; }\n+}\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#faf9f6\" />\n+    <meta name=\"description\" content=\"Folio is a little space for your perspective. Share your photos, discover something beautiful, and see the everyday a little differently.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Folio — A shared point of view</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"10\" fill=\"#c85432\"/><g fill=\"none\" stroke=\"#faf9f6\" stroke-width=\"2.4\"><circle cx=\"20\" cy=\"20\" r=\"12\"/><path d=\"m15 9 12 7-1 14M31 17l-12 7-12-7m8 14V17l12-7\"/></g></svg>\n\nIndex: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,69 @@\n+export interface GalleryImage {\n+  id: number;\n+  filename: string;\n+  title: string | null;\n+  content_type: string;\n+  size_bytes: number;\n+  uploaded_at: string;\n+  url: string;\n+  uploader: string;\n+}\n+\n+export interface ImagePage {\n+  items: GalleryImage[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+}\n+\n+export interface Session {\n+  token: string;\n+  username: string;\n+}\n+\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {\n+  const headers = new Headers(options.headers);\n+  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n+  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, { ...options, headers });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new Error(\"We couldn’t reach the gallery. Check your connection and try again.\");\n+  }\n+  const data = await response.json().catch(() => ({}));\n+  if (!response.ok) {\n+    if (response.status === 401 && token) window.dispatchEvent(new Event(\"folio:session-expired\"));\n+    throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status);\n+  }\n+  return data as T;\n+}\n+\n+export function formatSize(bytes: number) {\n+  return bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n+}\n+\n+export function formatDate(date: string) {\n+  return new Intl.DateTimeFormat(\"en\", { month: \"short\", day: \"numeric\", year: \"numeric\" }).format(new Date(date));\n+}\n+\n+export function readToken() {\n+  try { return localStorage.getItem(\"folio-token\"); } catch { return null; }\n+}\n+\n+export function saveToken(token: string | null) {\n+  try {\n+    if (token) localStorage.setItem(\"folio-token\", token);\n+    else localStorage.removeItem(\"folio-token\");\n+  } catch { return; }\n+}\n\nIndex: /workspace/frontend/src/components/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/components/Modal.tsx\n+++ /workspace/frontend/src/components/Modal.tsx\n@@ -0,0 +1,39 @@\n+import { useEffect, useRef, type ReactNode } from \"react\";\n+import { X } from \"lucide-react\";\n+\n+interface ModalProps {\n+  title: string;\n+  children: ReactNode;\n+  onClose: () => void;\n+  wide?: boolean;\n+}\n+\n+export default function Modal({ title, children, onClose, wide = false }: ModalProps) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+\n+  useEffect(() => {\n+    const dialog = ref.current;\n+    dialog?.showModal();\n+    const previousOverflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => {\n+      dialog?.close();\n+      document.body.style.overflow = previousOverflow;\n+    };\n+  }, []);\n+\n+  return (\n+    <dialog\n+      ref={ref}\n+      aria-label={title}\n+      onCancel={(event) => { event.preventDefault(); onClose(); }}\n+      onClick={(event) => { if (event.target === event.currentTarget) onClose(); }}\n+      className={`fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] overflow-y-auto rounded-2xl bg-paper p-0 text-ink shadow-2xl ${wide ? \"max-w-5xl\" : \"max-w-md\"}`}\n+    >\n+      <div className=\"relative\" onClick={(event) => event.stopPropagation()}>\n+        <button onClick={onClose} aria-label=\"Close dialog\" className=\"absolute right-4 top-4 z-10 rounded-full border border-line bg-paper/95 p-2 text-muted transition hover:text-ink\"><X size={18} /></button>\n+        {children}\n+      </div>\n+    </dialog>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/Landscape.tsx\n===================================================================\n--- /workspace/frontend/src/components/Landscape.tsx\n+++ /workspace/frontend/src/components/Landscape.tsx\n@@ -0,0 +1,28 @@\n+export default function Landscape() {\n+  return (\n+    <svg viewBox=\"0 0 1000 500\" preserveAspectRatio=\"xMidYMid slice\" className=\"h-full w-full\" role=\"img\" aria-label=\"An illustrated sun setting over quiet mountains and a shimmering lake\">\n+      <defs>\n+        <linearGradient id=\"sky\" x2=\"0\" y2=\"1\"><stop stopColor=\"#b6c3b4\" /><stop offset=\".56\" stopColor=\"#e4d7b9\" /><stop offset=\"1\" stopColor=\"#edd2af\" /></linearGradient>\n+        <linearGradient id=\"water\" x2=\"0\" y2=\"1\"><stop stopColor=\"#93a89a\" /><stop offset=\"1\" stopColor=\"#4e756b\" /></linearGradient>\n+        <linearGradient id=\"front\" x2=\".8\" y2=\"1\"><stop stopColor=\"#426054\" /><stop offset=\"1\" stopColor=\"#183a31\" /></linearGradient>\n+        <linearGradient id=\"fade\"><stop stopColor=\"#eaece1\" /><stop offset=\".32\" stopColor=\"#eaece1\" stopOpacity=\"0\" /></linearGradient>\n+        <filter id=\"grain\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".8\" numOctaves=\"3\" stitchTiles=\"stitch\" /><feColorMatrix type=\"saturate\" values=\"0\" /><feComponentTransfer><feFuncA type=\"linear\" slope=\".14\" /></feComponentTransfer><feBlend in=\"SourceGraphic\" mode=\"multiply\" /></filter>\n+      </defs>\n+      <g filter=\"url(#grain)\">\n+        <path fill=\"url(#sky)\" d=\"M0 0h1000v500H0z\" />\n+        <circle cx=\"696\" cy=\"134\" r=\"43\" fill=\"#f6e5bc\" />\n+        <path fill=\"#aeb9a8\" d=\"m0 254 80-65 55 30 88-92 52 50 34-17 76 91 75-42 74 31 85-80 91 58 54-34 92 56 78-69 66 68V500H0Z\" />\n+        <path fill=\"#91a490\" d=\"m0 288 62-37 43 13 101-89 96 121 96-48 44 31 122-98 65 59 42-13 54 47 98-98 80 110 97-46v260H0Z\" />\n+        <path fill=\"#6d8a78\" d=\"m0 320 83-89 88 103 37-31 69 42 65-56 52 15 92-89 30 41 27-13 91 102 57-24 67 30 64-62 91 43 89-79v247H0Z\" />\n+        <path fill=\"url(#water)\" d=\"M0 350q209-37 391 13t609-30v167H0Z\" />\n+        <g fill=\"none\" stroke=\"#e0d8b7\" strokeWidth=\"1\" opacity=\".44\"><path d=\"M542 377h173m-214 13h221m-180 14h194m-145 12h94m-183 12h232m-275 16h326m-391 18h438m-454 17h418\" /></g>\n+        <path fill=\"#466a57\" d=\"m0 361 42-57 28 6 50-72 86 113 78 33 123 33-86 27L0 432Z\" />\n+        <path fill=\"url(#front)\" d=\"m1000 193-60 63-49 19-35 76-83 43-122 48-174 58h523Z\" />\n+        <g fill=\"#284d3d\"><path d=\"m929 243-18 72h13v63h10v-63h14Zm-75 72-17 56h11v49h10v-49h11Zm-60 41-14 43h9v40h9v-40h10Zm-619-58-15 45h10v39h9v-39h11ZM66 283l-22 68h15v57h11v-57h15Z\" /></g>\n+        <path fill=\"#264b3e\" d=\"M0 444q148-50 287-6t130 62H0Z\" />\n+        <path fill=\"url(#fade)\" d=\"M0 0h1000v500H0z\" />\n+      </g>\n+      <g fill=\"none\" stroke=\"#557060\" strokeWidth=\"1.5\" opacity=\".65\"><path d=\"m790 89 7-4 7 4m19 12 6-3 6 3m-59 6 5-3 5 3\" /></g>\n+    </svg>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/AuthForm.tsx\n===================================================================\n--- /workspace/frontend/src/components/AuthForm.tsx\n+++ /workspace/frontend/src/components/AuthForm.tsx\n@@ -0,0 +1,51 @@\n+import { useState, type FormEvent } from \"react\";\n+import { Aperture, ArrowRight, Eye, EyeOff, LoaderCircle } from \"lucide-react\";\n+import { api, type Session } from \"../api\";\n+\n+interface AuthFormProps {\n+  initialMode: \"login\" | \"register\";\n+  onSuccess: (session: Session) => void;\n+}\n+\n+export default function AuthForm({ initialMode, onSuccess }: AuthFormProps) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [showPassword, setShowPassword] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const registering = mode === \"register\";\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setError(\"\");\n+    setBusy(true);\n+    const body = JSON.stringify({ username: username.trim(), password });\n+    try {\n+      if (registering) await api(\"/auth/register\", { method: \"POST\", body });\n+      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, token);\n+      onSuccess({ token, username: user.username });\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to sign in. Please try again.\");\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <div className=\"p-7 sm:p-9\">\n+      <Aperture className=\"mb-6 text-accent\" size={34} strokeWidth={1.7} />\n+      <p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[.2em] text-muted\">Your point of view matters</p>\n+      <h2 className=\"font-serif text-3xl tracking-tight\">{registering ? \"Find your little space.\" : \"Welcome back.\"}</h2>\n+      <p className=\"mt-3 text-sm leading-relaxed text-muted\">{registering ? \"Join Folio and share the world through your lens.\" : \"Sign in to share a moment, or revisit your favorites.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+        <label className=\"block text-sm font-medium\">Username<input autoFocus autoComplete=\"username\" required pattern=\"[A-Za-z0-9_.\\-]+\" maxLength={32} value={username} onChange={(event) => setUsername(event.target.value)} placeholder=\"Your username\" className=\"form-input mt-2\" /><span className=\"mt-1.5 block text-xs font-normal text-muted\">Letters, numbers, dots, underscores and hyphens.</span></label>\n+        <label className=\"block text-sm font-medium\">Password<div className=\"relative mt-2\"><input autoComplete={registering ? \"new-password\" : \"current-password\"} type={showPassword ? \"text\" : \"password\"} required maxLength={256} value={password} onChange={(event) => setPassword(event.target.value)} placeholder={registering ? \"Choose a password\" : \"Your password\"} className=\"form-input pr-12\" /><button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute right-3 top-3.5 text-muted\">{showPassword ? <EyeOff size={18} /> : <Eye size={18} />}</button></div></label>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm leading-relaxed text-red-700\">{error}</p>}\n+        <button disabled={busy} className=\"button-primary w-full\">{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : null}{registering ? \"Create your account\" : \"Sign in\"}{!busy && <ArrowRight size={17} />}</button>\n+      </form>\n+      <p className=\"mt-6 text-center text-sm text-muted\">{registering ? \"Already part of the community?\" : \"New around here?\"} <button disabled={busy} onClick={() => { setMode(registering ? \"login\" : \"register\"); setError(\"\"); }} className=\"font-semibold text-accent hover:underline\">{registering ? \"Sign in\" : \"Join Folio\"}</button></p>\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/UploadForm.tsx\n===================================================================\n--- /workspace/frontend/src/components/UploadForm.tsx\n+++ /workspace/frontend/src/components/UploadForm.tsx\n@@ -0,0 +1,78 @@\n+import { useEffect, useRef, useState, type FormEvent } from \"react\";\n+import { ArrowUpRight, Check, ImagePlus, LoaderCircle, Upload, X } from \"lucide-react\";\n+import { api, formatSize, type GalleryImage } from \"../api\";\n+\n+interface UploadFormProps {\n+  token: string;\n+  onSuccess: (image: GalleryImage) => void;\n+}\n+\n+export default function UploadForm({ token, onSuccess }: UploadFormProps) {\n+  const [file, setFile] = useState<File | null>(null);\n+  const [preview, setPreview] = useState(\"\");\n+  const [title, setTitle] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [dragging, setDragging] = useState(false);\n+  const input = useRef<HTMLInputElement>(null);\n+\n+  useEffect(() => {\n+    if (!file) { setPreview(\"\"); return; }\n+    const url = URL.createObjectURL(file);\n+    setPreview(url);\n+    return () => URL.revokeObjectURL(url);\n+  }, [file]);\n+\n+  function chooseFile(chosen: File | undefined) {\n+    if (!chosen) return;\n+    setError(\"\");\n+    if (![\"image/png\", \"image/jpeg\"].includes(chosen.type) && !/\\.(png|jpe?g)$/i.test(chosen.name)) {\n+      setError(\"Choose a PNG or JPEG image.\");\n+      return;\n+    }\n+    if (chosen.size > 15 * 1024 * 1024) { setError(\"This image is too large. The maximum file size is 15 MB.\"); return; }\n+    setFile(chosen);\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    if (!file) { setError(\"Choose an image to share first.\"); return; }\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      const data = await new Promise<string>((resolve, reject) => {\n+        const reader = new FileReader();\n+        reader.onload = () => resolve((reader.result as string).split(\",\")[1]);\n+        reader.onerror = () => reject(new Error(\"We couldn’t read this file. Try selecting it again.\"));\n+        reader.readAsDataURL(file);\n+      });\n+      const image = await api<GalleryImage>(\"/images\", { method: \"POST\", body: JSON.stringify({ filename: file.name, data, title: title.trim() || null }) }, token);\n+      onSuccess(image);\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to upload. Please try again.\");\n+    } finally { setBusy(false); }\n+  }\n+\n+  return (\n+    <div className=\"p-7 sm:p-9\">\n+      <div className=\"mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-accent/10 text-accent\"><ImagePlus size={24} strokeWidth={1.6} /></div>\n+      <h2 className=\"font-serif text-3xl tracking-tight\">Share your perspective.</h2>\n+      <p className=\"mt-2 text-sm leading-relaxed text-muted\">A place, a feeling, a little moment worth keeping.</p>\n+      <form onSubmit={submit} className=\"mt-6 space-y-5\">\n+        <input ref={input} type=\"file\" accept=\"image/png,image/jpeg,.png,.jpg,.jpeg\" onChange={(event) => { chooseFile(event.target.files?.[0]); event.target.value = \"\"; }} className=\"hidden\" aria-label=\"Choose an image\" />\n+        {preview && file ? (\n+          <div className=\"overflow-hidden rounded-xl border border-line bg-white\">\n+            <div className=\"relative flex h-48 items-center justify-center bg-line/40\"><img src={preview} alt=\"Preview of your selected image\" className=\"h-full w-full object-contain\" /><button type=\"button\" disabled={busy} onClick={() => setFile(null)} aria-label=\"Remove selected image\" className=\"absolute right-2 top-2 rounded-full bg-white/90 p-1.5\"><X size={16} /></button></div>\n+            <div className=\"flex items-center justify-between gap-3 p-3\"><div className=\"min-w-0\"><p className=\"truncate text-xs font-medium\">{file.name}</p><p className=\"mt-1 text-xs text-muted\">{formatSize(file.size)}</p></div><Check size={17} className=\"shrink-0 text-green-700\" /></div>\n+          </div>\n+        ) : (\n+          <button type=\"button\" disabled={busy} onClick={() => input.current?.click()} onDragOver={(event) => { event.preventDefault(); setDragging(true); }} onDragLeave={() => setDragging(false)} onDrop={(event) => { event.preventDefault(); setDragging(false); chooseFile(event.dataTransfer.files[0]); }} className={`flex w-full flex-col items-center rounded-xl border-2 border-dashed px-5 py-9 transition ${dragging ? \"border-accent bg-accent/10\" : \"border-line bg-white hover:border-accent/50 hover:bg-accent/5\"}`}><Upload size={25} strokeWidth={1.4} className=\"mb-3 text-accent\" /><span className=\"text-sm font-medium\">Drop your image here</span><span className=\"mt-1 text-xs text-muted\">or <span className=\"text-accent\">browse files</span></span><span className=\"mt-4 text-[11px] text-muted\">PNG or JPEG · Up to 15 MB</span></button>\n+        )}\n+        <label className=\"block text-sm font-medium\">Give it a title <span className=\"font-normal text-muted\">(optional)</span><input className=\"form-input mt-2\" value={title} onChange={(event) => setTitle(event.target.value)} maxLength={200} placeholder=\"What’s the story?\" disabled={busy} /></label>\n+        <p className=\"flex items-start gap-2 text-xs leading-relaxed text-muted\"><span className=\"mt-0.5 shrink-0\"><ImagePlus size={14} /></span>Your image will be visible to everyone. You can delete it at any time.</p>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+        <button className=\"button-primary w-full\" disabled={busy || !file}>{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : <ArrowUpRight size={17} />}{busy ? \"Sharing your image…\" : \"Share image\"}</button>\n+      </form>\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/src/components/ImageViewer.tsx\n===================================================================\n--- /workspace/frontend/src/components/ImageViewer.tsx\n+++ /workspace/frontend/src/components/ImageViewer.tsx\n@@ -0,0 +1,43 @@\n+import { useState } from \"react\";\n+import { ArrowUpRight, CalendarDays, Image, LoaderCircle, Trash2, UserRound } from \"lucide-react\";\n+import { api, formatDate, formatSize, type GalleryImage, type Session } from \"../api\";\n+\n+interface ImageViewerProps {\n+  image: GalleryImage;\n+  session: Session | null;\n+  onDeleted: () => void;\n+}\n+\n+export default function ImageViewer({ image, session, onDeleted }: ImageViewerProps) {\n+  const [confirming, setConfirming] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [broken, setBroken] = useState(false);\n+  const ownImage = session?.username === image.uploader;\n+\n+  async function remove() {\n+    if (!session) return;\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      await api(`/images/${image.id}`, { method: \"DELETE\" }, session.token);\n+      onDeleted();\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to delete this image.\");\n+    } finally { setBusy(false); }\n+  }\n+\n+  return (\n+    <div>\n+      <div className=\"flex min-h-48 items-center justify-center rounded-t-2xl bg-[#e9e9e2] p-3 sm:p-5\">\n+        {broken ? <p className=\"py-20 text-sm text-muted\">This image is no longer available.</p> : <img src={image.url} alt={image.title || image.filename} onError={() => setBroken(true)} className=\"max-h-[64dvh] max-w-full rounded object-contain\" />}\n+      </div>\n+      <div className=\"p-6 sm:p-8\">\n+        <div className=\"flex flex-wrap items-start justify-between gap-4\"><div className=\"min-w-0\"><p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[.16em] text-accent\">A shared perspective</p><h2 className=\"break-words font-serif text-3xl\">{image.title || image.filename}</h2>{image.title && <p className=\"mt-2 break-all text-sm text-muted\">{image.filename}</p>}</div><a href={image.url} target=\"_blank\" rel=\"noreferrer\" className=\"button-secondary text-xs\">View original <ArrowUpRight size={15} /></a></div>\n+        <div className=\"mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-5 text-xs text-muted\"><span className=\"flex items-center gap-2\"><UserRound size={14} /><span className=\"font-medium text-ink\">{image.uploader}</span></span><span className=\"flex items-center gap-2\"><CalendarDays size={14} />{formatDate(image.uploaded_at)}</span><span className=\"flex items-center gap-2\"><Image size={14} />{formatSize(image.size_bytes)} · {image.content_type === \"image/png\" ? \"PNG\" : \"JPEG\"}</span></div>\n+        {ownImage && <div className=\"mt-6 border-t border-line pt-5\">{confirming ? <div className=\"rounded-xl border border-red-100 bg-red-50 p-4\"><p className=\"text-sm font-semibold\">Delete this image?</p><p className=\"mt-1 text-xs leading-relaxed text-muted\">It will be removed from the gallery permanently. This can’t be undone.</p><div className=\"mt-4 flex gap-3\"><button disabled={busy} onClick={remove} className=\"inline-flex items-center gap-2 rounded-lg bg-red-700 px-4 py-2 text-xs font-semibold text-white hover:bg-red-800 disabled:opacity-50\">{busy ? <LoaderCircle size={14} className=\"animate-spin\" /> : <Trash2 size={14} />}Delete image</button><button disabled={busy} onClick={() => setConfirming(false)} className=\"button-secondary py-2 text-xs\">Keep image</button></div></div> : <button onClick={() => setConfirming(true)} className=\"flex items-center gap-2 text-xs font-medium text-red-700 hover:underline\"><Trash2 size={14} />Delete your image</button>}</div>}\n+        {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+      </div>\n+    </div>\n+  );\n+}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n\nIndex: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,184 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { Aperture, ArrowDown, ArrowRight, ArrowUpRight, Check, ChevronLeft, ChevronRight, Globe2, Grid2X2, Heart, ImagePlus, Images, LayoutGrid, Leaf, LoaderCircle, LogOut, Search, Sparkles, UserRound, X } from \"lucide-react\";\n+import { api, formatDate, readToken, saveToken, type GalleryImage, type ImagePage, type Session } from \"./api\";\n+import Modal from \"./components/Modal\";\n+import Landscape from \"./components/Landscape\";\n+import AuthForm from \"./components/AuthForm\";\n+import UploadForm from \"./components/UploadForm\";\n+import ImageViewer from \"./components/ImageViewer\";\n+\n+type Dialog = \"login\" | \"register\" | \"upload\" | \"about\" | null;\n+\n+export default function App() {\n+  const [session, setSession] = useState<Session | null>(null);\n+  const [checkingSession, setCheckingSession] = useState(Boolean(readToken()));\n+  const [dialog, setDialog] = useState<Dialog>(null);\n+  const [selected, setSelected] = useState<GalleryImage | null>(null);\n+  const [result, setResult] = useState<ImagePage>({ items: [], total: 0, page: 1, page_size: 12 });\n+  const [page, setPage] = useState(1);\n+  const [query, setQuery] = useState(\"\");\n+  const [search, setSearch] = useState(\"\");\n+  const [mine, setMine] = useState(false);\n+  const [compact, setCompact] = useState(false);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [refresh, setRefresh] = useState(0);\n+  const [notice, setNotice] = useState(\"\");\n+  const [signingOut, setSigningOut] = useState(false);\n+  const gallery = useRef<HTMLElement>(null);\n+  const uploadAfterLogin = useRef(false);\n+  const uploader = mine ? session?.username : undefined;\n+\n+  useEffect(() => {\n+    const token = readToken();\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<{ username: string }>(\"/auth/me\", { signal: controller.signal }, token)\n+      .then((user) => setSession({ token, username: user.username }))\n+      .catch((error) => { if (error.name !== \"AbortError\") saveToken(null); })\n+      .finally(() => { if (!controller.signal.aborted) setCheckingSession(false); });\n+    return () => controller.abort();\n+  }, []);\n+\n+  useEffect(() => {\n+    function expired() {\n+      saveToken(null);\n+      setSession(null);\n+      setMine(false);\n+      setNotice(\"Your session has expired. Please sign in again.\");\n+    }\n+    window.addEventListener(\"folio:session-expired\", expired);\n+    return () => window.removeEventListener(\"folio:session-expired\", expired);\n+  }, []);\n+\n+  useEffect(() => {\n+    const timeout = window.setTimeout(() => { setSearch(query.trim()); setPage(1); }, 300);\n+    return () => window.clearTimeout(timeout);\n+  }, [query]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    const params = new URLSearchParams({ page: String(page), page_size: \"12\" });\n+    if (search) params.set(\"q\", search);\n+    if (uploader) params.set(\"uploader\", uploader);\n+    api<ImagePage>(`/images?${params}`, { signal: controller.signal })\n+      .then((data) => {\n+        if (page > 1 && data.items.length === 0 && data.total > 0) setPage(Math.ceil(data.total / 12));\n+        else if (page > 1 && data.total === 0) setPage(1);\n+        else setResult(data);\n+      })\n+      .catch((error) => { if (error.name !== \"AbortError\") setError(error.message); })\n+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    return () => controller.abort();\n+  }, [page, search, uploader, refresh]);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 5500);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  function scrollToGallery() {\n+    gallery.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n+  }\n+\n+  function openUpload() {\n+    if (session) setDialog(\"upload\");\n+    else { uploadAfterLogin.current = true; setDialog(\"login\"); }\n+  }\n+\n+  function signedIn(user: Session) {\n+    saveToken(user.token);\n+    setSession(user);\n+    setDialog(uploadAfterLogin.current ? \"upload\" : null);\n+    uploadAfterLogin.current = false;\n+    setNotice(`Welcome to your little space, ${user.username}.`);\n+  }\n+\n+  async function signOut() {\n+    if (!session) return;\n+    setSigningOut(true);\n+    try {\n+      await api(\"/auth/logout\", { method: \"POST\" }, session.token);\n+      saveToken(null);\n+      setSession(null);\n+      setMine(false);\n+      setPage(1);\n+      setNotice(\"You’re signed out. Stay a while and explore.\");\n+    } catch (error) {\n+      setNotice(error instanceof Error ? error.message : \"Unable to sign out. Try again.\");\n+    } finally { setSigningOut(false); }\n+  }\n+\n+  function closeDialog() {\n+    setDialog(null);\n+    uploadAfterLogin.current = false;\n+  }\n+\n+  const totalPages = Math.max(1, Math.ceil(result.total / 12));\n+  const filtered = Boolean(search || mine);\n+\n+  return (\n+    <div className=\"min-h-screen\">\n+      <header className=\"border-b border-line bg-paper/95\">\n+        <div className=\"mx-auto flex h-20 max-w-[1320px] items-center justify-between gap-5 px-5 sm:px-8 lg:px-14\">\n+          <a href=\"/\" aria-label=\"Folio home\" className=\"flex items-center gap-2.5\"><Aperture size={31} className=\"text-accent\" strokeWidth={1.7} /><span className=\"text-[30px] font-semibold tracking-[-1.8px]\">folio<span className=\"text-accent\">.</span></span></a>\n+          <nav className=\"ml-10 hidden h-full items-center gap-8 md:flex\" aria-label=\"Main navigation\"><button onClick={scrollToGallery} className=\"relative flex h-full items-center text-[13px] font-semibold after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-accent\">Discover</button><button onClick={() => setDialog(\"about\")} className=\"text-[13px] text-muted transition hover:text-ink\">Our little space <ArrowUpRight size={12} className=\"ml-1 inline\" /></button></nav>\n+          <div className=\"ml-auto flex items-center gap-3 sm:gap-5\">\n+            {checkingSession ? <LoaderCircle size={19} className=\"animate-spin text-muted\" /> : session ? <><span className=\"flex max-w-44 items-center gap-2 text-xs font-medium sm:text-sm\"><span className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#e9ecdf] text-[#64744e]\"><UserRound size={15} /></span><span className=\"max-w-24 truncate sm:max-w-36\">{session.username}</span></span><button onClick={signOut} disabled={signingOut} className=\"flex items-center gap-1.5 text-xs text-muted hover:text-ink\" aria-label=\"Sign out\">{signingOut ? <LoaderCircle size={15} className=\"animate-spin\" /> : <LogOut size={15} />}<span className=\"hidden sm:inline\">Sign out</span></button></> : <><button onClick={() => setDialog(\"login\")} className=\"text-[13px] font-medium hover:text-accent\">Sign in</button><button onClick={() => setDialog(\"register\")} className=\"button-secondary px-3 py-2 text-xs sm:px-4 sm:text-[13px]\">Join Folio <ArrowUpRight size={14} className=\"hidden sm:block\" /></button></>}\n+          </div>\n+        </div>\n+      </header>\n+\n+      <main className=\"mx-auto max-w-[1320px] px-5 pb-16 pt-10 sm:px-8 sm:pt-12 lg:px-14\">\n+        <section className=\"mb-9 flex flex-col justify-between gap-7 md:flex-row md:items-end lg:mb-10\">\n+          <div><p className=\"mb-4 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[.2em] text-muted\"><span className=\"h-1.5 w-1.5 rounded-full bg-[#8e9a73]\" />A shared point of view</p><h1 className=\"text-[38px] font-medium leading-[1.14] tracking-[-1.6px] sm:text-[48px] sm:tracking-[-2px] lg:text-[53px]\">The everyday.<br />Seen <span className=\"font-serif italic font-normal text-accent\">differently.</span></h1></div>\n+          <div className=\"max-w-[330px] pb-1 md:pb-0\"><p className=\"text-[13px] leading-[1.8] text-muted\">A collection of moments, places, and perspectives.<br className=\"hidden lg:block\" /> Discover something beautiful. Share something you.</p><button onClick={openUpload} disabled={checkingSession} className=\"button-primary mt-5\"><ImagePlus size={17} strokeWidth={1.7} />Upload an image<ArrowUpRight size={16} className=\"ml-4\" /></button></div>\n+        </section>\n+\n+        <section className=\"relative mb-12 grid min-h-[280px] overflow-hidden rounded-xl border border-[#dce0d3] bg-[#eaece1] md:grid-cols-[.95fr_1.7fr]\" aria-label=\"Welcome to Folio\">\n+          <div className=\"absolute bottom-0 right-0 top-0 w-full opacity-60 md:w-[74%] md:opacity-100\"><Landscape /></div>\n+          <div className=\"relative z-1 flex flex-col items-start px-7 py-8 sm:px-9 sm:py-9\"><span className=\"mb-4 flex items-center gap-1.5 rounded-full border border-[#939d7c]/35 bg-[#eaece1]/70 px-2.5 py-1 text-[9px] font-medium uppercase tracking-[.13em] text-[#62714f]\"><Leaf size={11} />Made for your moments</span><h2 className=\"font-serif text-[32px] leading-[1.15] tracking-[-.7px] sm:text-[36px]\">Big adventures.<br />Small observations.<br /><span className=\"italic\">All welcome here.</span></h2><button onClick={scrollToGallery} className=\"mt-6 flex items-center gap-3 text-xs font-medium\"><span className=\"flex h-7 w-7 items-center justify-center rounded-full border border-ink/25 transition hover:bg-white/60\"><ArrowDown size={13} /></span>Take a look around</button></div>\n+          <div className=\"absolute bottom-5 right-6 hidden items-center gap-2 rounded-full border border-white/25 bg-[#284d3d]/35 px-3 py-1.5 text-[9px] tracking-wide text-white/90 backdrop-blur-sm sm:flex\"><Aperture size={12} />A little wonder goes a long way</div>\n+          <span className=\"absolute right-6 top-6 hidden text-[9px] uppercase tracking-[.2em] text-[#53684f] md:block\">Less scrolling. More seeing.</span>\n+        </section>\n+\n+        <section ref={gallery} className=\"scroll-mt-8\" aria-label=\"Image gallery\">\n+          <div className=\"mb-5 flex flex-wrap items-center justify-between gap-4\"><div className=\"flex items-center gap-3\"><h2 className=\"text-[22px] font-semibold tracking-[-.7px]\">The gallery</h2><span className=\"rounded-full border border-line px-2 py-0.5 text-[11px] text-muted\">{loading ? \"…\" : result.total}</span></div><span className=\"flex items-center gap-1.5 text-[11px] text-muted\"><span className=\"h-1 w-1 rounded-full bg-accent/70\" />Fresh perspectives, newest first</span></div>\n+          <div className=\"mb-6 flex flex-col justify-between gap-4 border-b border-line pb-5 sm:flex-row sm:items-center\">\n+            <div className=\"flex items-center gap-2\"><button onClick={() => { setMine(false); setPage(1); }} className={`flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-xs font-medium transition ${!mine ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50\"}`}><Globe2 size={14} />All images</button>{session && <button onClick={() => { setMine(true); setPage(1); }} className={`flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-xs font-medium transition ${mine ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50\"}`}><UserRound size={14} />My uploads</button>}</div>\n+            <div className=\"flex items-center gap-3\"><div className=\"relative min-w-0 flex-1 sm:w-56 sm:flex-none\"><Search size={15} className=\"absolute left-3 top-3 text-muted\" /><input aria-label=\"Search images\" placeholder=\"Find a little inspiration…\" value={query} onChange={(event) => setQuery(event.target.value)} className=\"w-full rounded-lg border border-line bg-transparent py-2.5 pl-9 pr-8 text-xs placeholder:text-muted/80 focus:border-accent\" />{query && <button onClick={() => setQuery(\"\")} aria-label=\"Clear search\" className=\"absolute right-2.5 top-3 text-muted\"><X size={13} /></button>}</div><div className=\"flex items-center rounded-lg border border-line p-1\"><button aria-label=\"Comfortable grid\" aria-pressed={!compact} onClick={() => setCompact(false)} className={`rounded p-1.5 ${!compact ? \"bg-[#eaeae2] text-ink\" : \"text-muted hover:text-ink\"}`}><LayoutGrid size={15} /></button><button aria-label=\"Compact grid\" aria-pressed={compact} onClick={() => setCompact(true)} className={`rounded p-1.5 ${compact ? \"bg-[#eaeae2] text-ink\" : \"text-muted hover:text-ink\"}`}><Grid2X2 size={15} /></button></div></div>\n+          </div>\n+\n+          {loading ? <div role=\"status\" aria-label=\"Loading images\" className={`grid gap-5 ${compact ? \"grid-cols-2 sm:grid-cols-3 lg:grid-cols-4\" : \"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"}`}>{Array.from({ length: 3 }, (_, i) => <div key={i} className=\"animate-pulse overflow-hidden rounded-xl border border-line bg-white\"><div className=\"aspect-[4/3] bg-line/70\" /><div className=\"space-y-3 p-4\"><div className=\"h-3 w-2/3 rounded bg-line\" /><div className=\"h-2 w-1/3 rounded bg-line/70\" /></div></div>)}</div> : error ? <div className=\"flex min-h-64 flex-col items-center justify-center rounded-xl border border-line bg-white p-6 text-center\"><Images size={30} className=\"mb-4 text-muted\" /><h3 className=\"text-lg font-medium\">A little trouble loading the gallery.</h3><p role=\"alert\" className=\"mt-2 max-w-md text-sm text-muted\">{error}</p><button onClick={() => setRefresh(refresh + 1)} className=\"button-secondary mt-5\">Try again <ArrowRight size={14} /></button></div> : result.items.length === 0 ? (\n+            <div className=\"relative flex min-h-[270px] flex-col items-center justify-center overflow-hidden rounded-xl border border-line bg-white/65 px-5 py-9 text-center\">\n+              <div className=\"relative mb-5\"><span className=\"absolute -left-6 top-1 h-1.5 w-1.5 rounded-full bg-[#b6bd9b]\" /><span className=\"absolute -right-5 bottom-1 h-1 w-1 rounded-full bg-accent/45\" /><div className=\"flex h-14 w-14 -rotate-6 items-center justify-center rounded-xl border border-[#dce0d2] bg-[#f0f2e9]\"><Images size={27} strokeWidth={1.2} className=\"text-[#7a8866]\" /></div><Sparkles size={14} strokeWidth={1.4} className=\"absolute -right-3 -top-1 text-accent/65\" /></div>\n+              <h3 className=\"font-serif text-[25px] tracking-[-.4px]\">{search ? \"A different view, perhaps?\" : mine ? \"Your story starts with one image.\" : \"A blank canvas. Endless possibilities.\"}</h3>\n+              <p className=\"mt-2 max-w-sm text-xs leading-[1.8] text-muted\">{search ? `No images found for “${search}”. Try a different word or explore the whole gallery.` : mine ? \"You haven’t shared any images yet. Let us see the world through your lens.\" : \"Every collection starts somewhere. Be the first to share a moment and make this space a little more you.\"}</p>\n+              {filtered ? <div className=\"mt-5 flex items-center gap-4\">{mine && !search && <button onClick={openUpload} className=\"flex items-center gap-2 text-xs font-semibold text-accent hover:underline\">Share your first image <ArrowUpRight size={14} /></button>}<button onClick={() => { setQuery(\"\"); setSearch(\"\"); setMine(false); setPage(1); }} className=\"text-xs font-medium text-muted hover:text-ink\">Explore all images <ArrowRight size={13} className=\"ml-1 inline\" /></button></div> : <button onClick={openUpload} disabled={checkingSession} className=\"mt-5 flex items-center gap-2 text-xs font-semibold text-accent hover:underline\"><ImagePlus size={14} />Share the first image<ArrowUpRight size={14} /></button>}\n+              {!filtered && <span className=\"absolute bottom-5 right-5 hidden text-[9px] uppercase tracking-[.17em] text-muted/50 sm:block\">Good things start small</span>}\n+            </div>\n+          ) : (\n+            <div className={`grid gap-x-5 gap-y-7 ${compact ? \"grid-cols-2 sm:grid-cols-3 lg:grid-cols-4\" : \"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"}`}>\n+              {result.items.map((image) => <article key={image.id} className=\"group min-w-0\"><button onClick={() => setSelected(image)} aria-label={`View ${image.title || image.filename}`} className=\"relative block aspect-[4/3] w-full overflow-hidden rounded-xl bg-[#e9e9e2]\"><img src={image.url} alt={image.title || image.filename} loading=\"lazy\" className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035] motion-reduce:transition-none\" /><span className=\"absolute inset-0 bg-black/0 transition group-hover:bg-black/10\" /><span className=\"absolute bottom-3 right-3 flex h-8 w-8 translate-y-1 items-center justify-center rounded-full bg-white/95 text-ink opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:opacity-100\"><ArrowUpRight size={16} /></span>{image.uploader === session?.username && <span className=\"absolute left-3 top-3 rounded-full bg-white/95 px-2 py-1 text-[9px] font-medium\">Your perspective</span>}<span className=\"absolute right-3 top-3 rounded bg-black/20 px-1.5 py-0.5 text-[9px] font-medium tracking-wide text-white backdrop-blur-sm\">{image.content_type === \"image/png\" ? \"PNG\" : \"JPEG\"}</span></button><div className=\"px-0.5 pt-3.5\"><button onClick={() => setSelected(image)} className=\"block max-w-full truncate text-left text-[14px] font-medium tracking-[-.2px] transition hover:text-accent\">{image.title || image.filename}</button><div className=\"mt-2 flex flex-wrap items-center justify-between gap-2 text-[10px] text-muted\"><span className=\"flex min-w-0 items-center gap-1.5\"><span className=\"flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-line/70\"><UserRound size={9} /></span><span className=\"max-w-32 truncate\">{image.uploader}</span></span><time dateTime={image.uploaded_at}>{formatDate(image.uploaded_at)}</time></div></div></article>)}\n+            </div>\n+          )}\n+\n+          <div className=\"mt-6 flex items-center justify-between gap-3 text-[11px] text-muted\"><p>{result.total ? `Showing ${(page - 1) * 12 + 1}–${Math.min(page * 12, result.total)} of ${result.total} images` : \"A little space, waiting to be filled.\"}</p><nav aria-label=\"Gallery pagination\" className=\"flex items-center gap-3\"><button onClick={() => { setPage(page - 1); scrollToGallery(); }} disabled={loading || page <= 1} aria-label=\"Previous page\" className=\"rounded-md border border-line p-1.5 hover:bg-white disabled:opacity-30\"><ChevronLeft size={14} /></button><span>Page {page} of {totalPages}</span><button onClick={() => { setPage(page + 1); scrollToGallery(); }} disabled={loading || page >= totalPages} aria-label=\"Next page\" className=\"rounded-md border border-line p-1.5 hover:bg-white disabled:opacity-30\"><ChevronRight size={14} /></button></nav></div>\n+        </section>\n+\n+        <div className=\"mt-12 grid grid-cols-1 gap-5 border-t border-line pt-7 sm:grid-cols-3 sm:gap-8\"><div className=\"flex items-start gap-3\"><Globe2 size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Different eyes. One community.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">A gallery for everyone, from everywhere.</p></div></div><div className=\"flex items-start gap-3\"><ImagePlus size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Your images, just as they are.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">Original quality. No filters. All you.</p></div></div><div className=\"flex items-start gap-3\"><Heart size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Keep it thoughtful. Keep it yours.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">Share what you create. Inspire someone else.</p></div></div></div>\n+      </main>\n+\n+      <footer className=\"border-t border-line\"><div className=\"mx-auto flex max-w-[1320px] flex-col items-start justify-between gap-4 px-5 py-6 sm:flex-row sm:items-center sm:px-8 lg:px-14\"><div className=\"flex items-center gap-3\"><Aperture size={20} className=\"text-accent\" strokeWidth={1.6} /><span className=\"text-sm font-semibold tracking-[-.5px]\">folio.</span><span className=\"ml-2 border-l border-line pl-4 text-[10px] text-muted\">A little space for the things you see.</span></div><button onClick={() => setDialog(\"about\")} className=\"flex items-center gap-1.5 text-[10px] text-muted hover:text-accent\">Made for a shared point of view <ArrowUpRight size={12} /></button></div></footer>\n+\n+      {notice && <div role=\"status\" className=\"fixed bottom-5 left-1/2 z-50 flex w-[calc(100%-2rem)] max-w-md -translate-x-1/2 items-center gap-3 rounded-xl border border-line bg-ink px-4 py-3.5 text-xs leading-relaxed text-white shadow-xl\"><Check size={17} className=\"shrink-0 text-[#b4c49a]\" /><span className=\"flex-1\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss message\" className=\"p-1 text-white/70\"><X size={14} /></button></div>}\n+      {(dialog === \"login\" || dialog === \"register\") && <Modal title={dialog === \"login\" ? \"Sign in to Folio\" : \"Join Folio\"} onClose={closeDialog}><AuthForm initialMode={dialog} onSuccess={signedIn} /></Modal>}\n+      {dialog === \"upload\" && session && <Modal title=\"Upload an image\" onClose={closeDialog}><UploadForm token={session.token} onSuccess={() => { setDialog(null); setMine(false); setQuery(\"\"); setSearch(\"\"); setPage(1); setRefresh(refresh + 1); setNotice(\"Your perspective is now part of the gallery.\"); window.setTimeout(scrollToGallery, 100); }} /></Modal>}\n+      {dialog === \"about\" && <Modal title=\"About Folio\" onClose={closeDialog}><div className=\"p-8 sm:p-10\"><Aperture size={36} strokeWidth={1.5} className=\"mb-6 text-accent\" /><p className=\"mb-3 text-[10px] uppercase tracking-[.18em] text-muted\">Our little space</p><h2 className=\"font-serif text-3xl leading-tight\">There’s wonder<br />in the everyday.</h2><div className=\"mt-5 space-y-4 text-sm leading-[1.8] text-muted\"><p>Folio is a shared gallery for the way you see the world. Big adventures, quiet corners, fleeting light — every perspective belongs here.</p><p>Anyone can explore. Create an account to share your own PNG or JPEG images, in their original quality. Your uploads stay yours to delete, whenever you choose.</p><p>Share only images you own or have permission to use, and keep this a thoughtful space for everyone.</p></div><button onClick={() => { closeDialog(); scrollToGallery(); }} className=\"button-primary mt-6\">Find a new perspective <ArrowRight size={16} /></button></div></Modal>}\n+      {selected && <Modal title={selected.title || selected.filename} onClose={() => setSelected(null)} wide><ImageViewer image={selected} session={session} onDeleted={() => { setSelected(null); setRefresh(refresh + 1); setNotice(\"Image deleted. A little room for something new.\"); }} /></Modal>}\n+    </div>\n+  );\n+}\n\n","files":[{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"@tailwindcss/vite\": \"^4.3.5\",\n   \"lucide-react\": \"^1.71.0\",\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n import react from \"@vitejs/plugin-react\";\n+import tailwindcss from \"@tailwindcss/vite\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,19 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"resolveJsonModule\": true,\n+    \"isolatedModules\": true,\n+    \"noEmit\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":19,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,21 @@\n+import js from \"@eslint/js\";\n+import globals from \"globals\";\n+import tseslint from \"typescript-eslint\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: { globals: globals.browser },\n+    plugins: { \"react-hooks\": reactHooks, \"react-refresh\": reactRefresh },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n","additions":21,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,26 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-paper: #faf9f6;\n+  --color-ink: #292c27;\n+  --color-muted: #797c72;\n+  --color-line: #e5e5dc;\n+  --color-accent: #c85432;\n+  --color-accent-dark: #ad4327;\n+}\n+\n+@layer base {\n+  body { @apply m-0 bg-paper font-sans text-ink antialiased; }\n+  button, a, input, select { @apply outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-4; }\n+  button { @apply cursor-pointer disabled:cursor-not-allowed; }\n+  ::selection { @apply bg-accent/20; }\n+  dialog::backdrop { @apply bg-ink/60 backdrop-blur-sm; }\n+}\n+\n+@layer components {\n+  .button-primary { @apply inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-dark disabled:opacity-50; }\n+  .button-secondary { @apply inline-flex items-center justify-center gap-2 rounded-lg border border-line bg-white px-4 py-2.5 text-sm font-medium transition hover:border-ink/30 hover:bg-paper disabled:opacity-40; }\n+  .form-input { @apply w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm placeholder:text-muted/65 focus:border-accent focus:ring-2 focus:ring-accent/15 focus:ring-offset-0; }\n+}\n","additions":26,"deletions":0},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#faf9f6\" />\n+    <meta name=\"description\" content=\"Folio is a little space for your perspective. Share your photos, discover something beautiful, and see the everyday a little differently.\" />\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n+    <title>Folio — A shared point of view</title>\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":4,"deletions":1},{"filePath":"/workspace/frontend/public/favicon.svg","relativePath":"frontend/public/favicon.svg","type":"add","patch":"Index: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"10\" fill=\"#c85432\"/><g fill=\"none\" stroke=\"#faf9f6\" stroke-width=\"2.4\"><circle cx=\"20\" cy=\"20\" r=\"12\"/><path d=\"m15 9 12 7-1 14M31 17l-12 7-12-7m8 14V17l12-7\"/></g></svg>\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,69 @@\n+export interface GalleryImage {\n+  id: number;\n+  filename: string;\n+  title: string | null;\n+  content_type: string;\n+  size_bytes: number;\n+  uploaded_at: string;\n+  url: string;\n+  uploader: string;\n+}\n+\n+export interface ImagePage {\n+  items: GalleryImage[];\n+  total: number;\n+  page: number;\n+  page_size: number;\n+}\n+\n+export interface Session {\n+  token: string;\n+  username: string;\n+}\n+\n+export class ApiError extends Error {\n+  status: number;\n+\n+  constructor(message: string, status: number) {\n+    super(message);\n+    this.status = status;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {\n+  const headers = new Headers(options.headers);\n+  if (options.body) headers.set(\"Content-Type\", \"application/json\");\n+  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, { ...options, headers });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new Error(\"We couldn’t reach the gallery. Check your connection and try again.\");\n+  }\n+  const data = await response.json().catch(() => ({}));\n+  if (!response.ok) {\n+    if (response.status === 401 && token) window.dispatchEvent(new Event(\"folio:session-expired\"));\n+    throw new ApiError(data.error || \"Something went wrong. Please try again.\", response.status);\n+  }\n+  return data as T;\n+}\n+\n+export function formatSize(bytes: number) {\n+  return bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n+}\n+\n+export function formatDate(date: string) {\n+  return new Intl.DateTimeFormat(\"en\", { month: \"short\", day: \"numeric\", year: \"numeric\" }).format(new Date(date));\n+}\n+\n+export function readToken() {\n+  try { return localStorage.getItem(\"folio-token\"); } catch { return null; }\n+}\n+\n+export function saveToken(token: string | null) {\n+  try {\n+    if (token) localStorage.setItem(\"folio-token\", token);\n+    else localStorage.removeItem(\"folio-token\");\n+  } catch { return; }\n+}\n","additions":69,"deletions":0},{"filePath":"/workspace/frontend/src/components/Modal.tsx","relativePath":"frontend/src/components/Modal.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/components/Modal.tsx\n+++ /workspace/frontend/src/components/Modal.tsx\n@@ -0,0 +1,39 @@\n+import { useEffect, useRef, type ReactNode } from \"react\";\n+import { X } from \"lucide-react\";\n+\n+interface ModalProps {\n+  title: string;\n+  children: ReactNode;\n+  onClose: () => void;\n+  wide?: boolean;\n+}\n+\n+export default function Modal({ title, children, onClose, wide = false }: ModalProps) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+\n+  useEffect(() => {\n+    const dialog = ref.current;\n+    dialog?.showModal();\n+    const previousOverflow = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => {\n+      dialog?.close();\n+      document.body.style.overflow = previousOverflow;\n+    };\n+  }, []);\n+\n+  return (\n+    <dialog\n+      ref={ref}\n+      aria-label={title}\n+      onCancel={(event) => { event.preventDefault(); onClose(); }}\n+      onClick={(event) => { if (event.target === event.currentTarget) onClose(); }}\n+      className={`fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] overflow-y-auto rounded-2xl bg-paper p-0 text-ink shadow-2xl ${wide ? \"max-w-5xl\" : \"max-w-md\"}`}\n+    >\n+      <div className=\"relative\" onClick={(event) => event.stopPropagation()}>\n+        <button onClick={onClose} aria-label=\"Close dialog\" className=\"absolute right-4 top-4 z-10 rounded-full border border-line bg-paper/95 p-2 text-muted transition hover:text-ink\"><X size={18} /></button>\n+        {children}\n+      </div>\n+    </dialog>\n+  );\n+}\n","additions":39,"deletions":0},{"filePath":"/workspace/frontend/src/components/Landscape.tsx","relativePath":"frontend/src/components/Landscape.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/Landscape.tsx\n===================================================================\n--- /workspace/frontend/src/components/Landscape.tsx\n+++ /workspace/frontend/src/components/Landscape.tsx\n@@ -0,0 +1,28 @@\n+export default function Landscape() {\n+  return (\n+    <svg viewBox=\"0 0 1000 500\" preserveAspectRatio=\"xMidYMid slice\" className=\"h-full w-full\" role=\"img\" aria-label=\"An illustrated sun setting over quiet mountains and a shimmering lake\">\n+      <defs>\n+        <linearGradient id=\"sky\" x2=\"0\" y2=\"1\"><stop stopColor=\"#b6c3b4\" /><stop offset=\".56\" stopColor=\"#e4d7b9\" /><stop offset=\"1\" stopColor=\"#edd2af\" /></linearGradient>\n+        <linearGradient id=\"water\" x2=\"0\" y2=\"1\"><stop stopColor=\"#93a89a\" /><stop offset=\"1\" stopColor=\"#4e756b\" /></linearGradient>\n+        <linearGradient id=\"front\" x2=\".8\" y2=\"1\"><stop stopColor=\"#426054\" /><stop offset=\"1\" stopColor=\"#183a31\" /></linearGradient>\n+        <linearGradient id=\"fade\"><stop stopColor=\"#eaece1\" /><stop offset=\".32\" stopColor=\"#eaece1\" stopOpacity=\"0\" /></linearGradient>\n+        <filter id=\"grain\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".8\" numOctaves=\"3\" stitchTiles=\"stitch\" /><feColorMatrix type=\"saturate\" values=\"0\" /><feComponentTransfer><feFuncA type=\"linear\" slope=\".14\" /></feComponentTransfer><feBlend in=\"SourceGraphic\" mode=\"multiply\" /></filter>\n+      </defs>\n+      <g filter=\"url(#grain)\">\n+        <path fill=\"url(#sky)\" d=\"M0 0h1000v500H0z\" />\n+        <circle cx=\"696\" cy=\"134\" r=\"43\" fill=\"#f6e5bc\" />\n+        <path fill=\"#aeb9a8\" d=\"m0 254 80-65 55 30 88-92 52 50 34-17 76 91 75-42 74 31 85-80 91 58 54-34 92 56 78-69 66 68V500H0Z\" />\n+        <path fill=\"#91a490\" d=\"m0 288 62-37 43 13 101-89 96 121 96-48 44 31 122-98 65 59 42-13 54 47 98-98 80 110 97-46v260H0Z\" />\n+        <path fill=\"#6d8a78\" d=\"m0 320 83-89 88 103 37-31 69 42 65-56 52 15 92-89 30 41 27-13 91 102 57-24 67 30 64-62 91 43 89-79v247H0Z\" />\n+        <path fill=\"url(#water)\" d=\"M0 350q209-37 391 13t609-30v167H0Z\" />\n+        <g fill=\"none\" stroke=\"#e0d8b7\" strokeWidth=\"1\" opacity=\".44\"><path d=\"M542 377h173m-214 13h221m-180 14h194m-145 12h94m-183 12h232m-275 16h326m-391 18h438m-454 17h418\" /></g>\n+        <path fill=\"#466a57\" d=\"m0 361 42-57 28 6 50-72 86 113 78 33 123 33-86 27L0 432Z\" />\n+        <path fill=\"url(#front)\" d=\"m1000 193-60 63-49 19-35 76-83 43-122 48-174 58h523Z\" />\n+        <g fill=\"#284d3d\"><path d=\"m929 243-18 72h13v63h10v-63h14Zm-75 72-17 56h11v49h10v-49h11Zm-60 41-14 43h9v40h9v-40h10Zm-619-58-15 45h10v39h9v-39h11ZM66 283l-22 68h15v57h11v-57h15Z\" /></g>\n+        <path fill=\"#264b3e\" d=\"M0 444q148-50 287-6t130 62H0Z\" />\n+        <path fill=\"url(#fade)\" d=\"M0 0h1000v500H0z\" />\n+      </g>\n+      <g fill=\"none\" stroke=\"#557060\" strokeWidth=\"1.5\" opacity=\".65\"><path d=\"m790 89 7-4 7 4m19 12 6-3 6 3m-59 6 5-3 5 3\" /></g>\n+    </svg>\n+  );\n+}\n","additions":28,"deletions":0},{"filePath":"/workspace/frontend/src/components/AuthForm.tsx","relativePath":"frontend/src/components/AuthForm.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/AuthForm.tsx\n===================================================================\n--- /workspace/frontend/src/components/AuthForm.tsx\n+++ /workspace/frontend/src/components/AuthForm.tsx\n@@ -0,0 +1,51 @@\n+import { useState, type FormEvent } from \"react\";\n+import { Aperture, ArrowRight, Eye, EyeOff, LoaderCircle } from \"lucide-react\";\n+import { api, type Session } from \"../api\";\n+\n+interface AuthFormProps {\n+  initialMode: \"login\" | \"register\";\n+  onSuccess: (session: Session) => void;\n+}\n+\n+export default function AuthForm({ initialMode, onSuccess }: AuthFormProps) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [showPassword, setShowPassword] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const registering = mode === \"register\";\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setError(\"\");\n+    setBusy(true);\n+    const body = JSON.stringify({ username: username.trim(), password });\n+    try {\n+      if (registering) await api(\"/auth/register\", { method: \"POST\", body });\n+      const { token } = await api<{ token: string }>(\"/auth/login\", { method: \"POST\", body });\n+      const user = await api<{ username: string }>(\"/auth/me\", {}, token);\n+      onSuccess({ token, username: user.username });\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to sign in. Please try again.\");\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <div className=\"p-7 sm:p-9\">\n+      <Aperture className=\"mb-6 text-accent\" size={34} strokeWidth={1.7} />\n+      <p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[.2em] text-muted\">Your point of view matters</p>\n+      <h2 className=\"font-serif text-3xl tracking-tight\">{registering ? \"Find your little space.\" : \"Welcome back.\"}</h2>\n+      <p className=\"mt-3 text-sm leading-relaxed text-muted\">{registering ? \"Join Folio and share the world through your lens.\" : \"Sign in to share a moment, or revisit your favorites.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\">\n+        <label className=\"block text-sm font-medium\">Username<input autoFocus autoComplete=\"username\" required pattern=\"[A-Za-z0-9_.\\-]+\" maxLength={32} value={username} onChange={(event) => setUsername(event.target.value)} placeholder=\"Your username\" className=\"form-input mt-2\" /><span className=\"mt-1.5 block text-xs font-normal text-muted\">Letters, numbers, dots, underscores and hyphens.</span></label>\n+        <label className=\"block text-sm font-medium\">Password<div className=\"relative mt-2\"><input autoComplete={registering ? \"new-password\" : \"current-password\"} type={showPassword ? \"text\" : \"password\"} required maxLength={256} value={password} onChange={(event) => setPassword(event.target.value)} placeholder={registering ? \"Choose a password\" : \"Your password\"} className=\"form-input pr-12\" /><button type=\"button\" aria-label={showPassword ? \"Hide password\" : \"Show password\"} onClick={() => setShowPassword(!showPassword)} className=\"absolute right-3 top-3.5 text-muted\">{showPassword ? <EyeOff size={18} /> : <Eye size={18} />}</button></div></label>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm leading-relaxed text-red-700\">{error}</p>}\n+        <button disabled={busy} className=\"button-primary w-full\">{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : null}{registering ? \"Create your account\" : \"Sign in\"}{!busy && <ArrowRight size={17} />}</button>\n+      </form>\n+      <p className=\"mt-6 text-center text-sm text-muted\">{registering ? \"Already part of the community?\" : \"New around here?\"} <button disabled={busy} onClick={() => { setMode(registering ? \"login\" : \"register\"); setError(\"\"); }} className=\"font-semibold text-accent hover:underline\">{registering ? \"Sign in\" : \"Join Folio\"}</button></p>\n+    </div>\n+  );\n+}\n","additions":51,"deletions":0},{"filePath":"/workspace/frontend/src/components/UploadForm.tsx","relativePath":"frontend/src/components/UploadForm.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/UploadForm.tsx\n===================================================================\n--- /workspace/frontend/src/components/UploadForm.tsx\n+++ /workspace/frontend/src/components/UploadForm.tsx\n@@ -0,0 +1,78 @@\n+import { useEffect, useRef, useState, type FormEvent } from \"react\";\n+import { ArrowUpRight, Check, ImagePlus, LoaderCircle, Upload, X } from \"lucide-react\";\n+import { api, formatSize, type GalleryImage } from \"../api\";\n+\n+interface UploadFormProps {\n+  token: string;\n+  onSuccess: (image: GalleryImage) => void;\n+}\n+\n+export default function UploadForm({ token, onSuccess }: UploadFormProps) {\n+  const [file, setFile] = useState<File | null>(null);\n+  const [preview, setPreview] = useState(\"\");\n+  const [title, setTitle] = useState(\"\");\n+  const [error, setError] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [dragging, setDragging] = useState(false);\n+  const input = useRef<HTMLInputElement>(null);\n+\n+  useEffect(() => {\n+    if (!file) { setPreview(\"\"); return; }\n+    const url = URL.createObjectURL(file);\n+    setPreview(url);\n+    return () => URL.revokeObjectURL(url);\n+  }, [file]);\n+\n+  function chooseFile(chosen: File | undefined) {\n+    if (!chosen) return;\n+    setError(\"\");\n+    if (![\"image/png\", \"image/jpeg\"].includes(chosen.type) && !/\\.(png|jpe?g)$/i.test(chosen.name)) {\n+      setError(\"Choose a PNG or JPEG image.\");\n+      return;\n+    }\n+    if (chosen.size > 15 * 1024 * 1024) { setError(\"This image is too large. The maximum file size is 15 MB.\"); return; }\n+    setFile(chosen);\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    if (!file) { setError(\"Choose an image to share first.\"); return; }\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      const data = await new Promise<string>((resolve, reject) => {\n+        const reader = new FileReader();\n+        reader.onload = () => resolve((reader.result as string).split(\",\")[1]);\n+        reader.onerror = () => reject(new Error(\"We couldn’t read this file. Try selecting it again.\"));\n+        reader.readAsDataURL(file);\n+      });\n+      const image = await api<GalleryImage>(\"/images\", { method: \"POST\", body: JSON.stringify({ filename: file.name, data, title: title.trim() || null }) }, token);\n+      onSuccess(image);\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to upload. Please try again.\");\n+    } finally { setBusy(false); }\n+  }\n+\n+  return (\n+    <div className=\"p-7 sm:p-9\">\n+      <div className=\"mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-accent/10 text-accent\"><ImagePlus size={24} strokeWidth={1.6} /></div>\n+      <h2 className=\"font-serif text-3xl tracking-tight\">Share your perspective.</h2>\n+      <p className=\"mt-2 text-sm leading-relaxed text-muted\">A place, a feeling, a little moment worth keeping.</p>\n+      <form onSubmit={submit} className=\"mt-6 space-y-5\">\n+        <input ref={input} type=\"file\" accept=\"image/png,image/jpeg,.png,.jpg,.jpeg\" onChange={(event) => { chooseFile(event.target.files?.[0]); event.target.value = \"\"; }} className=\"hidden\" aria-label=\"Choose an image\" />\n+        {preview && file ? (\n+          <div className=\"overflow-hidden rounded-xl border border-line bg-white\">\n+            <div className=\"relative flex h-48 items-center justify-center bg-line/40\"><img src={preview} alt=\"Preview of your selected image\" className=\"h-full w-full object-contain\" /><button type=\"button\" disabled={busy} onClick={() => setFile(null)} aria-label=\"Remove selected image\" className=\"absolute right-2 top-2 rounded-full bg-white/90 p-1.5\"><X size={16} /></button></div>\n+            <div className=\"flex items-center justify-between gap-3 p-3\"><div className=\"min-w-0\"><p className=\"truncate text-xs font-medium\">{file.name}</p><p className=\"mt-1 text-xs text-muted\">{formatSize(file.size)}</p></div><Check size={17} className=\"shrink-0 text-green-700\" /></div>\n+          </div>\n+        ) : (\n+          <button type=\"button\" disabled={busy} onClick={() => input.current?.click()} onDragOver={(event) => { event.preventDefault(); setDragging(true); }} onDragLeave={() => setDragging(false)} onDrop={(event) => { event.preventDefault(); setDragging(false); chooseFile(event.dataTransfer.files[0]); }} className={`flex w-full flex-col items-center rounded-xl border-2 border-dashed px-5 py-9 transition ${dragging ? \"border-accent bg-accent/10\" : \"border-line bg-white hover:border-accent/50 hover:bg-accent/5\"}`}><Upload size={25} strokeWidth={1.4} className=\"mb-3 text-accent\" /><span className=\"text-sm font-medium\">Drop your image here</span><span className=\"mt-1 text-xs text-muted\">or <span className=\"text-accent\">browse files</span></span><span className=\"mt-4 text-[11px] text-muted\">PNG or JPEG · Up to 15 MB</span></button>\n+        )}\n+        <label className=\"block text-sm font-medium\">Give it a title <span className=\"font-normal text-muted\">(optional)</span><input className=\"form-input mt-2\" value={title} onChange={(event) => setTitle(event.target.value)} maxLength={200} placeholder=\"What’s the story?\" disabled={busy} /></label>\n+        <p className=\"flex items-start gap-2 text-xs leading-relaxed text-muted\"><span className=\"mt-0.5 shrink-0\"><ImagePlus size={14} /></span>Your image will be visible to everyone. You can delete it at any time.</p>\n+        {error && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+        <button className=\"button-primary w-full\" disabled={busy || !file}>{busy ? <LoaderCircle size={17} className=\"animate-spin\" /> : <ArrowUpRight size={17} />}{busy ? \"Sharing your image…\" : \"Share image\"}</button>\n+      </form>\n+    </div>\n+  );\n+}\n","additions":78,"deletions":0},{"filePath":"/workspace/frontend/src/components/ImageViewer.tsx","relativePath":"frontend/src/components/ImageViewer.tsx","type":"add","patch":"Index: /workspace/frontend/src/components/ImageViewer.tsx\n===================================================================\n--- /workspace/frontend/src/components/ImageViewer.tsx\n+++ /workspace/frontend/src/components/ImageViewer.tsx\n@@ -0,0 +1,43 @@\n+import { useState } from \"react\";\n+import { ArrowUpRight, CalendarDays, Image, LoaderCircle, Trash2, UserRound } from \"lucide-react\";\n+import { api, formatDate, formatSize, type GalleryImage, type Session } from \"../api\";\n+\n+interface ImageViewerProps {\n+  image: GalleryImage;\n+  session: Session | null;\n+  onDeleted: () => void;\n+}\n+\n+export default function ImageViewer({ image, session, onDeleted }: ImageViewerProps) {\n+  const [confirming, setConfirming] = useState(false);\n+  const [busy, setBusy] = useState(false);\n+  const [error, setError] = useState(\"\");\n+  const [broken, setBroken] = useState(false);\n+  const ownImage = session?.username === image.uploader;\n+\n+  async function remove() {\n+    if (!session) return;\n+    setBusy(true);\n+    setError(\"\");\n+    try {\n+      await api(`/images/${image.id}`, { method: \"DELETE\" }, session.token);\n+      onDeleted();\n+    } catch (error) {\n+      setError(error instanceof Error ? error.message : \"Unable to delete this image.\");\n+    } finally { setBusy(false); }\n+  }\n+\n+  return (\n+    <div>\n+      <div className=\"flex min-h-48 items-center justify-center rounded-t-2xl bg-[#e9e9e2] p-3 sm:p-5\">\n+        {broken ? <p className=\"py-20 text-sm text-muted\">This image is no longer available.</p> : <img src={image.url} alt={image.title || image.filename} onError={() => setBroken(true)} className=\"max-h-[64dvh] max-w-full rounded object-contain\" />}\n+      </div>\n+      <div className=\"p-6 sm:p-8\">\n+        <div className=\"flex flex-wrap items-start justify-between gap-4\"><div className=\"min-w-0\"><p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[.16em] text-accent\">A shared perspective</p><h2 className=\"break-words font-serif text-3xl\">{image.title || image.filename}</h2>{image.title && <p className=\"mt-2 break-all text-sm text-muted\">{image.filename}</p>}</div><a href={image.url} target=\"_blank\" rel=\"noreferrer\" className=\"button-secondary text-xs\">View original <ArrowUpRight size={15} /></a></div>\n+        <div className=\"mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-5 text-xs text-muted\"><span className=\"flex items-center gap-2\"><UserRound size={14} /><span className=\"font-medium text-ink\">{image.uploader}</span></span><span className=\"flex items-center gap-2\"><CalendarDays size={14} />{formatDate(image.uploaded_at)}</span><span className=\"flex items-center gap-2\"><Image size={14} />{formatSize(image.size_bytes)} · {image.content_type === \"image/png\" ? \"PNG\" : \"JPEG\"}</span></div>\n+        {ownImage && <div className=\"mt-6 border-t border-line pt-5\">{confirming ? <div className=\"rounded-xl border border-red-100 bg-red-50 p-4\"><p className=\"text-sm font-semibold\">Delete this image?</p><p className=\"mt-1 text-xs leading-relaxed text-muted\">It will be removed from the gallery permanently. This can’t be undone.</p><div className=\"mt-4 flex gap-3\"><button disabled={busy} onClick={remove} className=\"inline-flex items-center gap-2 rounded-lg bg-red-700 px-4 py-2 text-xs font-semibold text-white hover:bg-red-800 disabled:opacity-50\">{busy ? <LoaderCircle size={14} className=\"animate-spin\" /> : <Trash2 size={14} />}Delete image</button><button disabled={busy} onClick={() => setConfirming(false)} className=\"button-secondary py-2 text-xs\">Keep image</button></div></div> : <button onClick={() => setConfirming(true)} className=\"flex items-center gap-2 text-xs font-medium text-red-700 hover:underline\"><Trash2 size={14} />Delete your image</button>}</div>}\n+        {error && <p role=\"alert\" className=\"mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700\">{error}</p>}\n+      </div>\n+    </div>\n+  );\n+}\n","additions":43,"deletions":0},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"delete","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -1,3 +0,0 @@\n-export default function App() {\n-  return <h1>App</h1>;\n-}\n","additions":0,"deletions":4},{"filePath":"/workspace/frontend/src/App.tsx","relativePath":"frontend/src/App.tsx","type":"add","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -0,0 +1,184 @@\n+import { useEffect, useRef, useState } from \"react\";\n+import { Aperture, ArrowDown, ArrowRight, ArrowUpRight, Check, ChevronLeft, ChevronRight, Globe2, Grid2X2, Heart, ImagePlus, Images, LayoutGrid, Leaf, LoaderCircle, LogOut, Search, Sparkles, UserRound, X } from \"lucide-react\";\n+import { api, formatDate, readToken, saveToken, type GalleryImage, type ImagePage, type Session } from \"./api\";\n+import Modal from \"./components/Modal\";\n+import Landscape from \"./components/Landscape\";\n+import AuthForm from \"./components/AuthForm\";\n+import UploadForm from \"./components/UploadForm\";\n+import ImageViewer from \"./components/ImageViewer\";\n+\n+type Dialog = \"login\" | \"register\" | \"upload\" | \"about\" | null;\n+\n+export default function App() {\n+  const [session, setSession] = useState<Session | null>(null);\n+  const [checkingSession, setCheckingSession] = useState(Boolean(readToken()));\n+  const [dialog, setDialog] = useState<Dialog>(null);\n+  const [selected, setSelected] = useState<GalleryImage | null>(null);\n+  const [result, setResult] = useState<ImagePage>({ items: [], total: 0, page: 1, page_size: 12 });\n+  const [page, setPage] = useState(1);\n+  const [query, setQuery] = useState(\"\");\n+  const [search, setSearch] = useState(\"\");\n+  const [mine, setMine] = useState(false);\n+  const [compact, setCompact] = useState(false);\n+  const [loading, setLoading] = useState(true);\n+  const [error, setError] = useState(\"\");\n+  const [refresh, setRefresh] = useState(0);\n+  const [notice, setNotice] = useState(\"\");\n+  const [signingOut, setSigningOut] = useState(false);\n+  const gallery = useRef<HTMLElement>(null);\n+  const uploadAfterLogin = useRef(false);\n+  const uploader = mine ? session?.username : undefined;\n+\n+  useEffect(() => {\n+    const token = readToken();\n+    if (!token) return;\n+    const controller = new AbortController();\n+    api<{ username: string }>(\"/auth/me\", { signal: controller.signal }, token)\n+      .then((user) => setSession({ token, username: user.username }))\n+      .catch((error) => { if (error.name !== \"AbortError\") saveToken(null); })\n+      .finally(() => { if (!controller.signal.aborted) setCheckingSession(false); });\n+    return () => controller.abort();\n+  }, []);\n+\n+  useEffect(() => {\n+    function expired() {\n+      saveToken(null);\n+      setSession(null);\n+      setMine(false);\n+      setNotice(\"Your session has expired. Please sign in again.\");\n+    }\n+    window.addEventListener(\"folio:session-expired\", expired);\n+    return () => window.removeEventListener(\"folio:session-expired\", expired);\n+  }, []);\n+\n+  useEffect(() => {\n+    const timeout = window.setTimeout(() => { setSearch(query.trim()); setPage(1); }, 300);\n+    return () => window.clearTimeout(timeout);\n+  }, [query]);\n+\n+  useEffect(() => {\n+    const controller = new AbortController();\n+    setLoading(true);\n+    setError(\"\");\n+    const params = new URLSearchParams({ page: String(page), page_size: \"12\" });\n+    if (search) params.set(\"q\", search);\n+    if (uploader) params.set(\"uploader\", uploader);\n+    api<ImagePage>(`/images?${params}`, { signal: controller.signal })\n+      .then((data) => {\n+        if (page > 1 && data.items.length === 0 && data.total > 0) setPage(Math.ceil(data.total / 12));\n+        else if (page > 1 && data.total === 0) setPage(1);\n+        else setResult(data);\n+      })\n+      .catch((error) => { if (error.name !== \"AbortError\") setError(error.message); })\n+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });\n+    return () => controller.abort();\n+  }, [page, search, uploader, refresh]);\n+\n+  useEffect(() => {\n+    if (!notice) return;\n+    const timeout = window.setTimeout(() => setNotice(\"\"), 5500);\n+    return () => window.clearTimeout(timeout);\n+  }, [notice]);\n+\n+  function scrollToGallery() {\n+    gallery.current?.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n+  }\n+\n+  function openUpload() {\n+    if (session) setDialog(\"upload\");\n+    else { uploadAfterLogin.current = true; setDialog(\"login\"); }\n+  }\n+\n+  function signedIn(user: Session) {\n+    saveToken(user.token);\n+    setSession(user);\n+    setDialog(uploadAfterLogin.current ? \"upload\" : null);\n+    uploadAfterLogin.current = false;\n+    setNotice(`Welcome to your little space, ${user.username}.`);\n+  }\n+\n+  async function signOut() {\n+    if (!session) return;\n+    setSigningOut(true);\n+    try {\n+      await api(\"/auth/logout\", { method: \"POST\" }, session.token);\n+      saveToken(null);\n+      setSession(null);\n+      setMine(false);\n+      setPage(1);\n+      setNotice(\"You’re signed out. Stay a while and explore.\");\n+    } catch (error) {\n+      setNotice(error instanceof Error ? error.message : \"Unable to sign out. Try again.\");\n+    } finally { setSigningOut(false); }\n+  }\n+\n+  function closeDialog() {\n+    setDialog(null);\n+    uploadAfterLogin.current = false;\n+  }\n+\n+  const totalPages = Math.max(1, Math.ceil(result.total / 12));\n+  const filtered = Boolean(search || mine);\n+\n+  return (\n+    <div className=\"min-h-screen\">\n+      <header className=\"border-b border-line bg-paper/95\">\n+        <div className=\"mx-auto flex h-20 max-w-[1320px] items-center justify-between gap-5 px-5 sm:px-8 lg:px-14\">\n+          <a href=\"/\" aria-label=\"Folio home\" className=\"flex items-center gap-2.5\"><Aperture size={31} className=\"text-accent\" strokeWidth={1.7} /><span className=\"text-[30px] font-semibold tracking-[-1.8px]\">folio<span className=\"text-accent\">.</span></span></a>\n+          <nav className=\"ml-10 hidden h-full items-center gap-8 md:flex\" aria-label=\"Main navigation\"><button onClick={scrollToGallery} className=\"relative flex h-full items-center text-[13px] font-semibold after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-accent\">Discover</button><button onClick={() => setDialog(\"about\")} className=\"text-[13px] text-muted transition hover:text-ink\">Our little space <ArrowUpRight size={12} className=\"ml-1 inline\" /></button></nav>\n+          <div className=\"ml-auto flex items-center gap-3 sm:gap-5\">\n+            {checkingSession ? <LoaderCircle size={19} className=\"animate-spin text-muted\" /> : session ? <><span className=\"flex max-w-44 items-center gap-2 text-xs font-medium sm:text-sm\"><span className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#e9ecdf] text-[#64744e]\"><UserRound size={15} /></span><span className=\"max-w-24 truncate sm:max-w-36\">{session.username}</span></span><button onClick={signOut} disabled={signingOut} className=\"flex items-center gap-1.5 text-xs text-muted hover:text-ink\" aria-label=\"Sign out\">{signingOut ? <LoaderCircle size={15} className=\"animate-spin\" /> : <LogOut size={15} />}<span className=\"hidden sm:inline\">Sign out</span></button></> : <><button onClick={() => setDialog(\"login\")} className=\"text-[13px] font-medium hover:text-accent\">Sign in</button><button onClick={() => setDialog(\"register\")} className=\"button-secondary px-3 py-2 text-xs sm:px-4 sm:text-[13px]\">Join Folio <ArrowUpRight size={14} className=\"hidden sm:block\" /></button></>}\n+          </div>\n+        </div>\n+      </header>\n+\n+      <main className=\"mx-auto max-w-[1320px] px-5 pb-16 pt-10 sm:px-8 sm:pt-12 lg:px-14\">\n+        <section className=\"mb-9 flex flex-col justify-between gap-7 md:flex-row md:items-end lg:mb-10\">\n+          <div><p className=\"mb-4 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[.2em] text-muted\"><span className=\"h-1.5 w-1.5 rounded-full bg-[#8e9a73]\" />A shared point of view</p><h1 className=\"text-[38px] font-medium leading-[1.14] tracking-[-1.6px] sm:text-[48px] sm:tracking-[-2px] lg:text-[53px]\">The everyday.<br />Seen <span className=\"font-serif italic font-normal text-accent\">differently.</span></h1></div>\n+          <div className=\"max-w-[330px] pb-1 md:pb-0\"><p className=\"text-[13px] leading-[1.8] text-muted\">A collection of moments, places, and perspectives.<br className=\"hidden lg:block\" /> Discover something beautiful. Share something you.</p><button onClick={openUpload} disabled={checkingSession} className=\"button-primary mt-5\"><ImagePlus size={17} strokeWidth={1.7} />Upload an image<ArrowUpRight size={16} className=\"ml-4\" /></button></div>\n+        </section>\n+\n+        <section className=\"relative mb-12 grid min-h-[280px] overflow-hidden rounded-xl border border-[#dce0d3] bg-[#eaece1] md:grid-cols-[.95fr_1.7fr]\" aria-label=\"Welcome to Folio\">\n+          <div className=\"absolute bottom-0 right-0 top-0 w-full opacity-60 md:w-[74%] md:opacity-100\"><Landscape /></div>\n+          <div className=\"relative z-1 flex flex-col items-start px-7 py-8 sm:px-9 sm:py-9\"><span className=\"mb-4 flex items-center gap-1.5 rounded-full border border-[#939d7c]/35 bg-[#eaece1]/70 px-2.5 py-1 text-[9px] font-medium uppercase tracking-[.13em] text-[#62714f]\"><Leaf size={11} />Made for your moments</span><h2 className=\"font-serif text-[32px] leading-[1.15] tracking-[-.7px] sm:text-[36px]\">Big adventures.<br />Small observations.<br /><span className=\"italic\">All welcome here.</span></h2><button onClick={scrollToGallery} className=\"mt-6 flex items-center gap-3 text-xs font-medium\"><span className=\"flex h-7 w-7 items-center justify-center rounded-full border border-ink/25 transition hover:bg-white/60\"><ArrowDown size={13} /></span>Take a look around</button></div>\n+          <div className=\"absolute bottom-5 right-6 hidden items-center gap-2 rounded-full border border-white/25 bg-[#284d3d]/35 px-3 py-1.5 text-[9px] tracking-wide text-white/90 backdrop-blur-sm sm:flex\"><Aperture size={12} />A little wonder goes a long way</div>\n+          <span className=\"absolute right-6 top-6 hidden text-[9px] uppercase tracking-[.2em] text-[#53684f] md:block\">Less scrolling. More seeing.</span>\n+        </section>\n+\n+        <section ref={gallery} className=\"scroll-mt-8\" aria-label=\"Image gallery\">\n+          <div className=\"mb-5 flex flex-wrap items-center justify-between gap-4\"><div className=\"flex items-center gap-3\"><h2 className=\"text-[22px] font-semibold tracking-[-.7px]\">The gallery</h2><span className=\"rounded-full border border-line px-2 py-0.5 text-[11px] text-muted\">{loading ? \"…\" : result.total}</span></div><span className=\"flex items-center gap-1.5 text-[11px] text-muted\"><span className=\"h-1 w-1 rounded-full bg-accent/70\" />Fresh perspectives, newest first</span></div>\n+          <div className=\"mb-6 flex flex-col justify-between gap-4 border-b border-line pb-5 sm:flex-row sm:items-center\">\n+            <div className=\"flex items-center gap-2\"><button onClick={() => { setMine(false); setPage(1); }} className={`flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-xs font-medium transition ${!mine ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50\"}`}><Globe2 size={14} />All images</button>{session && <button onClick={() => { setMine(true); setPage(1); }} className={`flex items-center gap-2 rounded-lg px-3.5 py-2.5 text-xs font-medium transition ${mine ? \"bg-ink text-white\" : \"text-muted hover:bg-line/50\"}`}><UserRound size={14} />My uploads</button>}</div>\n+            <div className=\"flex items-center gap-3\"><div className=\"relative min-w-0 flex-1 sm:w-56 sm:flex-none\"><Search size={15} className=\"absolute left-3 top-3 text-muted\" /><input aria-label=\"Search images\" placeholder=\"Find a little inspiration…\" value={query} onChange={(event) => setQuery(event.target.value)} className=\"w-full rounded-lg border border-line bg-transparent py-2.5 pl-9 pr-8 text-xs placeholder:text-muted/80 focus:border-accent\" />{query && <button onClick={() => setQuery(\"\")} aria-label=\"Clear search\" className=\"absolute right-2.5 top-3 text-muted\"><X size={13} /></button>}</div><div className=\"flex items-center rounded-lg border border-line p-1\"><button aria-label=\"Comfortable grid\" aria-pressed={!compact} onClick={() => setCompact(false)} className={`rounded p-1.5 ${!compact ? \"bg-[#eaeae2] text-ink\" : \"text-muted hover:text-ink\"}`}><LayoutGrid size={15} /></button><button aria-label=\"Compact grid\" aria-pressed={compact} onClick={() => setCompact(true)} className={`rounded p-1.5 ${compact ? \"bg-[#eaeae2] text-ink\" : \"text-muted hover:text-ink\"}`}><Grid2X2 size={15} /></button></div></div>\n+          </div>\n+\n+          {loading ? <div role=\"status\" aria-label=\"Loading images\" className={`grid gap-5 ${compact ? \"grid-cols-2 sm:grid-cols-3 lg:grid-cols-4\" : \"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"}`}>{Array.from({ length: 3 }, (_, i) => <div key={i} className=\"animate-pulse overflow-hidden rounded-xl border border-line bg-white\"><div className=\"aspect-[4/3] bg-line/70\" /><div className=\"space-y-3 p-4\"><div className=\"h-3 w-2/3 rounded bg-line\" /><div className=\"h-2 w-1/3 rounded bg-line/70\" /></div></div>)}</div> : error ? <div className=\"flex min-h-64 flex-col items-center justify-center rounded-xl border border-line bg-white p-6 text-center\"><Images size={30} className=\"mb-4 text-muted\" /><h3 className=\"text-lg font-medium\">A little trouble loading the gallery.</h3><p role=\"alert\" className=\"mt-2 max-w-md text-sm text-muted\">{error}</p><button onClick={() => setRefresh(refresh + 1)} className=\"button-secondary mt-5\">Try again <ArrowRight size={14} /></button></div> : result.items.length === 0 ? (\n+            <div className=\"relative flex min-h-[270px] flex-col items-center justify-center overflow-hidden rounded-xl border border-line bg-white/65 px-5 py-9 text-center\">\n+              <div className=\"relative mb-5\"><span className=\"absolute -left-6 top-1 h-1.5 w-1.5 rounded-full bg-[#b6bd9b]\" /><span className=\"absolute -right-5 bottom-1 h-1 w-1 rounded-full bg-accent/45\" /><div className=\"flex h-14 w-14 -rotate-6 items-center justify-center rounded-xl border border-[#dce0d2] bg-[#f0f2e9]\"><Images size={27} strokeWidth={1.2} className=\"text-[#7a8866]\" /></div><Sparkles size={14} strokeWidth={1.4} className=\"absolute -right-3 -top-1 text-accent/65\" /></div>\n+              <h3 className=\"font-serif text-[25px] tracking-[-.4px]\">{search ? \"A different view, perhaps?\" : mine ? \"Your story starts with one image.\" : \"A blank canvas. Endless possibilities.\"}</h3>\n+              <p className=\"mt-2 max-w-sm text-xs leading-[1.8] text-muted\">{search ? `No images found for “${search}”. Try a different word or explore the whole gallery.` : mine ? \"You haven’t shared any images yet. Let us see the world through your lens.\" : \"Every collection starts somewhere. Be the first to share a moment and make this space a little more you.\"}</p>\n+              {filtered ? <div className=\"mt-5 flex items-center gap-4\">{mine && !search && <button onClick={openUpload} className=\"flex items-center gap-2 text-xs font-semibold text-accent hover:underline\">Share your first image <ArrowUpRight size={14} /></button>}<button onClick={() => { setQuery(\"\"); setSearch(\"\"); setMine(false); setPage(1); }} className=\"text-xs font-medium text-muted hover:text-ink\">Explore all images <ArrowRight size={13} className=\"ml-1 inline\" /></button></div> : <button onClick={openUpload} disabled={checkingSession} className=\"mt-5 flex items-center gap-2 text-xs font-semibold text-accent hover:underline\"><ImagePlus size={14} />Share the first image<ArrowUpRight size={14} /></button>}\n+              {!filtered && <span className=\"absolute bottom-5 right-5 hidden text-[9px] uppercase tracking-[.17em] text-muted/50 sm:block\">Good things start small</span>}\n+            </div>\n+          ) : (\n+            <div className={`grid gap-x-5 gap-y-7 ${compact ? \"grid-cols-2 sm:grid-cols-3 lg:grid-cols-4\" : \"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"}`}>\n+              {result.items.map((image) => <article key={image.id} className=\"group min-w-0\"><button onClick={() => setSelected(image)} aria-label={`View ${image.title || image.filename}`} className=\"relative block aspect-[4/3] w-full overflow-hidden rounded-xl bg-[#e9e9e2]\"><img src={image.url} alt={image.title || image.filename} loading=\"lazy\" className=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.035] motion-reduce:transition-none\" /><span className=\"absolute inset-0 bg-black/0 transition group-hover:bg-black/10\" /><span className=\"absolute bottom-3 right-3 flex h-8 w-8 translate-y-1 items-center justify-center rounded-full bg-white/95 text-ink opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:opacity-100\"><ArrowUpRight size={16} /></span>{image.uploader === session?.username && <span className=\"absolute left-3 top-3 rounded-full bg-white/95 px-2 py-1 text-[9px] font-medium\">Your perspective</span>}<span className=\"absolute right-3 top-3 rounded bg-black/20 px-1.5 py-0.5 text-[9px] font-medium tracking-wide text-white backdrop-blur-sm\">{image.content_type === \"image/png\" ? \"PNG\" : \"JPEG\"}</span></button><div className=\"px-0.5 pt-3.5\"><button onClick={() => setSelected(image)} className=\"block max-w-full truncate text-left text-[14px] font-medium tracking-[-.2px] transition hover:text-accent\">{image.title || image.filename}</button><div className=\"mt-2 flex flex-wrap items-center justify-between gap-2 text-[10px] text-muted\"><span className=\"flex min-w-0 items-center gap-1.5\"><span className=\"flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-line/70\"><UserRound size={9} /></span><span className=\"max-w-32 truncate\">{image.uploader}</span></span><time dateTime={image.uploaded_at}>{formatDate(image.uploaded_at)}</time></div></div></article>)}\n+            </div>\n+          )}\n+\n+          <div className=\"mt-6 flex items-center justify-between gap-3 text-[11px] text-muted\"><p>{result.total ? `Showing ${(page - 1) * 12 + 1}–${Math.min(page * 12, result.total)} of ${result.total} images` : \"A little space, waiting to be filled.\"}</p><nav aria-label=\"Gallery pagination\" className=\"flex items-center gap-3\"><button onClick={() => { setPage(page - 1); scrollToGallery(); }} disabled={loading || page <= 1} aria-label=\"Previous page\" className=\"rounded-md border border-line p-1.5 hover:bg-white disabled:opacity-30\"><ChevronLeft size={14} /></button><span>Page {page} of {totalPages}</span><button onClick={() => { setPage(page + 1); scrollToGallery(); }} disabled={loading || page >= totalPages} aria-label=\"Next page\" className=\"rounded-md border border-line p-1.5 hover:bg-white disabled:opacity-30\"><ChevronRight size={14} /></button></nav></div>\n+        </section>\n+\n+        <div className=\"mt-12 grid grid-cols-1 gap-5 border-t border-line pt-7 sm:grid-cols-3 sm:gap-8\"><div className=\"flex items-start gap-3\"><Globe2 size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Different eyes. One community.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">A gallery for everyone, from everywhere.</p></div></div><div className=\"flex items-start gap-3\"><ImagePlus size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Your images, just as they are.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">Original quality. No filters. All you.</p></div></div><div className=\"flex items-start gap-3\"><Heart size={19} strokeWidth={1.4} className=\"mt-0.5 shrink-0 text-[#84916d]\" /><div><h3 className=\"text-xs font-medium\">Keep it thoughtful. Keep it yours.</h3><p className=\"mt-1.5 text-[11px] leading-relaxed text-muted\">Share what you create. Inspire someone else.</p></div></div></div>\n+      </main>\n+\n+      <footer className=\"border-t border-line\"><div className=\"mx-auto flex max-w-[1320px] flex-col items-start justify-between gap-4 px-5 py-6 sm:flex-row sm:items-center sm:px-8 lg:px-14\"><div className=\"flex items-center gap-3\"><Aperture size={20} className=\"text-accent\" strokeWidth={1.6} /><span className=\"text-sm font-semibold tracking-[-.5px]\">folio.</span><span className=\"ml-2 border-l border-line pl-4 text-[10px] text-muted\">A little space for the things you see.</span></div><button onClick={() => setDialog(\"about\")} className=\"flex items-center gap-1.5 text-[10px] text-muted hover:text-accent\">Made for a shared point of view <ArrowUpRight size={12} /></button></div></footer>\n+\n+      {notice && <div role=\"status\" className=\"fixed bottom-5 left-1/2 z-50 flex w-[calc(100%-2rem)] max-w-md -translate-x-1/2 items-center gap-3 rounded-xl border border-line bg-ink px-4 py-3.5 text-xs leading-relaxed text-white shadow-xl\"><Check size={17} className=\"shrink-0 text-[#b4c49a]\" /><span className=\"flex-1\">{notice}</span><button onClick={() => setNotice(\"\")} aria-label=\"Dismiss message\" className=\"p-1 text-white/70\"><X size={14} /></button></div>}\n+      {(dialog === \"login\" || dialog === \"register\") && <Modal title={dialog === \"login\" ? \"Sign in to Folio\" : \"Join Folio\"} onClose={closeDialog}><AuthForm initialMode={dialog} onSuccess={signedIn} /></Modal>}\n+      {dialog === \"upload\" && session && <Modal title=\"Upload an image\" onClose={closeDialog}><UploadForm token={session.token} onSuccess={() => { setDialog(null); setMine(false); setQuery(\"\"); setSearch(\"\"); setPage(1); setRefresh(refresh + 1); setNotice(\"Your perspective is now part of the gallery.\"); window.setTimeout(scrollToGallery, 100); }} /></Modal>}\n+      {dialog === \"about\" && <Modal title=\"About Folio\" onClose={closeDialog}><div className=\"p-8 sm:p-10\"><Aperture size={36} strokeWidth={1.5} className=\"mb-6 text-accent\" /><p className=\"mb-3 text-[10px] uppercase tracking-[.18em] text-muted\">Our little space</p><h2 className=\"font-serif text-3xl leading-tight\">There’s wonder<br />in the everyday.</h2><div className=\"mt-5 space-y-4 text-sm leading-[1.8] text-muted\"><p>Folio is a shared gallery for the way you see the world. Big adventures, quiet corners, fleeting light — every perspective belongs here.</p><p>Anyone can explore. Create an account to share your own PNG or JPEG images, in their original quality. Your uploads stay yours to delete, whenever you choose.</p><p>Share only images you own or have permission to use, and keep this a thoughtful space for everyone.</p></div><button onClick={() => { closeDialog(); scrollToGallery(); }} className=\"button-primary mt-6\">Find a new perspective <ArrowRight size={16} /></button></div></Modal>}\n+      {selected && <Modal title={selected.title || selected.filename} onClose={() => setSelected(null)} wide><ImageViewer image={selected} session={session} onDeleted={() => { setSelected(null); setRefresh(refresh + 1); setNotice(\"Image deleted. A little room for something new.\"); }} /></Modal>}\n+    </div>\n+  );\n+}\n","additions":184,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/src/api.ts\nA frontend/src/components/Modal.tsx\nA frontend/src/components/Landscape.tsx\nA frontend/src/components/AuthForm.tsx\nA frontend/src/components/UploadForm.tsx\nA frontend/src/components/ImageViewer.tsx\nD frontend/src/App.tsx\nA frontend/src/App.tsx","time":{"start":1794319601403,"end":1794319601540}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"gAAAAABq8yQ2_2LF5tkV76pVp1WFUYLC0_HxrmPIFkVRas-5h2hN7ht_MZq0yCB