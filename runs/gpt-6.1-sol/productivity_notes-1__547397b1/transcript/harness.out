'Pin note', exact: true }).click();\n+  await expect(page.getByRole('button', { name: 'Unpin', exact: true })).toBeVisible();\n+  await page.getByRole('link', { name: 'Back to the notebook', exact: true }).click();\n+  await expect(page.getByRole('link', { name: 'An edited thought', exact: true })).toBeVisible();\n+  await page.getByRole('searchbox', { name: 'Search notes' }).fill('missingthought');\n+  await expect(page.getByRole('heading', { name: 'No notes on this page.' })).toBeVisible();\n+  await page.getByRole('searchbox', { name: 'Search notes' }).fill('edited');\n+  await expect(page.getByRole('link', { name: 'An edited thought', exact: true })).toBeVisible();\n+  await page.getByRole('button', { name: 'Clear filters', exact: true }).click();\n+  await page.getByLabel('Filter by author', { exact: true }).fill('someoneelse');\n+  await expect(page.getByRole('heading', { name: 'No notes on this page.' })).toBeVisible();\n+  await page.getByRole('button', { name: 'Clear author filter' }).click();\n+  await expect(page.getByRole('link', { name: 'An edited thought', exact: true })).toBeVisible();\n+  await page.locator('aside').getByRole('button', { name: '#ideas 1', exact: true }).click();\n+  await expect(page.getByRole('heading', { name: 'Notes tagged “ideas”' })).toBeVisible();\n+  await page.getByRole('button', { name: 'Clear tag filter' }).click();\n+  const session = await page.evaluate(() => JSON.parse(localStorage.getItem('marginalia-session')));\n+  for (let count = 0; count < 10; count++) {\n+    const response = await fetch('http://127.0.0.1:8000/api/notes', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.token}` }, body: JSON.stringify({ title: `A passing thought ${count + 1}`, content: 'A small discovery worth remembering.\\nAnother day, another little idea.', tags: [count % 2 ? 'everyday' : 'inspiration'], pinned: count === 0 }) });\n+    assert.equal(response.status, 201);\n+  }\n+  await page.reload();\n+  await expect(page.locator('article')).toHaveCount(9);\n+  await page.screenshot({ path: '/tmp/opencode/populated-desktop.png', fullPage: true });\n+  await page.getByRole('button', { name: 'Next page' }).click();\n+  await expect(page.locator('article')).toHaveCount(2);\n+  await expect(page.getByText('Page 2 of 2')).toBeVisible();\n+  await page.getByRole('button', { name: 'Previous page' }).click();\n+  await expect(page.locator('article')).toHaveCount(9);\n+  await page.getByRole('button', { name: 'List view', exact: true }).click();\n+  await expect(page.getByRole('button', { name: 'List view', exact: true })).toHaveAttribute('aria-pressed', 'true');\n+  const visitor = await browser.newContext({ viewport: { width: 390, height: 844 } });\n+  const mobile = await visitor.newPage();\n+  await mobile.goto(noteUrl);\n+  await expect(mobile.getByRole('heading', { name: 'An edited thought' })).toBeVisible();\n+  assert.equal(await mobile.getByRole('button', { name: 'Delete', exact: true }).count(), 0);\n+  assert.equal(await mobile.getByRole('link', { name: 'Edit', exact: true }).count(), 0);\n+  await mobile.goto('http://127.0.0.1:8000');\n+  await expect(mobile.locator('article')).toHaveCount(9);\n+  assert.equal(await mobile.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth), true);\n+  await mobile.screenshot({ path: '/tmp/opencode/mobile.png', fullPage: true });\n+  await mobile.getByRole('button', { name: 'Open navigation' }).click();\n+  await mobile.locator('aside').getByRole('button', { name: '#ideas 1', exact: true }).click();\n+  await expect(mobile.getByRole('heading', { name: 'Notes tagged “ideas”' })).toBeVisible();\n+  await visitor.close();\n+  await page.goto(noteUrl);\n+  await page.getByRole('button', { name: 'Delete', exact: true }).click();\n+  await expect(page.getByRole('heading', { name: 'Let this thought go?' })).toBeVisible();\n+  await page.getByRole('button', { name: 'Keep note', exact: true }).click();\n+ 