 true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n*** Add File: /workspace/frontend/eslint.config.js\n+import js from \"@eslint/js\";\n+import tseslint from \"typescript-eslint\";\n+import hooks from \"eslint-plugin-react-hooks\";\n+import refresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    plugins: { \"react-hooks\": hooks, \"react-refresh\": refresh },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n*** Add File: /workspace/frontend/src/index.css\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-paper: #f8f9f5;\n+  --color-ink: #293b31;\n+  --color-muted: #7c8178;\n+  --color-line: #e4e7de;\n+  --color-leaf: #e9efdc;\n+  --color-moss: #354b3e;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input, textarea {\n+    @apply outline-offset-4 focus-visible:outline-2 focus-visible:outline-moss;\n+  }\n+  button:not(:disabled), a {\n+    @apply cursor-pointer;\n+  }\n+  button:disabled {\n+    @apply cursor-not-allowed opacity-50;\n+  }\n+  ::selection {\n+    @apply bg-leaf text-ink;\n+  }\n+  dialog::backdrop {\n+    @apply bg-ink/35 backdrop-blur-sm;\n+  }\n+}\n*** Add File: /workspace/frontend/src/api.ts\n+export type Note = {\n+  id: number;\n+  title: string;\n+  content: string;\n+  tags: string[];\n+  pinned: boolean;\n+  created_at: string;\n+  updated_at: string;\n+  author: string;\n+};\n+\n+export type NotePage = { items: Note[]; total: number; page: number; page_size: number };\n+export type Tag = { tag: string; count: number };\n+export type Session = { token: string; username: string };\n+export type FieldErrors = Record<string, string>;\n+export type NoteDraft = Pick<Note, \"title\" | \"content\" | \"tags\" | \"pinned\">;\n+\n+export class ApiError extends Error {\n+  status: number;\n+  errors: FieldErrors;\n+\n+  constructor(message: string, status: number, errors: FieldErrors = {}) {\n+    super(message);\n+    this.status = status;\n+    this.errors = errors;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: { method?: string; body?: unknown; token?: string; signal?: AbortSignal } = {}): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      headers: {\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),\n+      },\n+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n+      signal: options.signal,\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"We couldn’t reach the notebook. Please try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => ({ error: \"Something went wrong. Please try again.\" }));\n+  if (!response.ok) {\n+    if (response.status === 401 && options.token) window.dispatchEvent(new Event(\"session-expired\"));\n+    throw new ApiError(data.error ?? \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function readSession(): Session | null {\n+  try {\n+    const value = JSON.parse(localStorage.getItem(\"marginalia-session\") ?? \"null\");\n+    return typeof value?.token === \"string\" && typeof value?.username === \"string\" ? value : null;\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function storeSession(session: Session | null) {\n+  try {\n+    if (session) localStorage.setItem(\"marginalia-session\", JSON.stringify(session));\n+    else localStorage.removeItem(\"marginalia-session\");\n+  } catch {\n+    return;\n+  }\n+}\n+\n+export function dateLabel(date: string) {\n+  return new Date(date).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" });\n+}\n+\n+export function relativeDate(date: string) {\n+  const days = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);\n+  if (days === 0) return \"Today\";\n+  if (days === 1) return \"Yesterday\";\n+  return new Date(date).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" });\n+}\n*** Add File: /workspace/frontend/src/Icons.tsx\n+import type { SVGProps } from \"react\";\n+\n+const paths = {\n+  book: <><path d=\"M5 3h13a2 2 0 0 1 2 2v16H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z\" /><path d=\"M7 3v18M11 8h5M11 12h5M11 16h3\" /></>,\n+  notes: <><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\" /><path d=\"M9 8h6M9 12h6M9 16h3\" /></>,\n+  plus: <path d=\"M12 5v14M5 12h14\" />,\n+  search: <><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" /><path d=\"m16 16 4.5 4.5\" /></>,\n+  pin: <><path d=\"m9 3 9 3-3 4 1 5-5-1-4 3-3-9 5 1Z\" /><path d=\"m11 14-7 7\" /></>,\n+  tag: <><path d=\"M3 3h8l10 10-8 8L3 11V3Z\" /><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" /></>,\n+  arrow: <path d=\"M4 12h16m-6-6 6 6-6 6\" />,\n+  back: <path d=\"M20 12H4m6-6-6 6 6 6\" />,\n+  chevron: <path d=\"m9 5 7 7-7 7\" />,\n+  down: <path d=\"m6 9 6 6 6-6\" />,\n+  close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+  user: <><circle cx=\"12\" cy=\"8\" r=\"4\" /><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\" /></>,\n+  globe: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a19 19 0 0 1 0 18 19 19 0 0 1 0-18\" /></>,\n+  edit: <><path d=\"m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-4-4L5 15l-1 5Z\" /><path d=\"M13 20h8\" /></>,\n+  trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7\" /></>,\n+  check: <path d=\"m5 12 4 4L19 6\" />,\n+  logout: <><path d=\"M9 4H4v16h5M10 12h11m-4-4 4 4-4 4\" /></>,\n+  menu: <path d=\"M4 6h16M4 12h16M4 18h16\" />,\n+  sparkle: <><path d=\"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z\" /><path d=\"m20 2 .5 1.5L22 4l-1.5.5L20 6l-.5-1.5L18 4l1.5-.5L20 2Z\" /></>,\n+  grid: <><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /></>,\n+  list: <><path d=\"M9 5h12M9 12h12M9 19h12M3 5h1M3 12h1M3 19h1\" /></>,\n+  clock: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 7v5l3 2\" /></>,\n+};\n+\n+export default function Icon({ name, className = \"size-5\", ...props }: SVGProps<SVGSVGElement> & { name: keyof typeof paths }) {\n+  return <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className={className} aria-hidden=\"true\" {...props}>{paths[name]}</svg>;\n+}\n*** Add File: /workspace/frontend/src/Modal.tsx\n+import { useEffect, useRef } from \"react\";\n+import type { ReactNode } from \"react\";\n+import Icon from \"./Icons\";\n+\n+export default function Modal({ title, children, onClose, busy = false }: { title: string; children: ReactNode; onClose: () => void; busy?: boolean }) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+\n+  useEffect(() => {\n+    const dialog = ref.current;\n+    dialog?.showModal();\n+    const original = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => {\n+      dialog?.close();\n+      document.body.style.overflow = original;\n+    };\n+  }, []);\n+\n+  return (\n+    <dialog ref={ref} aria-label={title} onCancel={event => { event.preventDefault(); if (!busy) onClose(); }} onClick={event => { if (event.target === event.currentTarget && !busy) onClose(); }} className=\"fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-paper p-0 text-ink shadow-2xl\">\n+      <div className=\"relative p-7 sm:p-9\">\n+        <button type=\"button\" aria-label=\"Close dialog\" onClick={onClose} disabled={busy} className=\"absolute right-4 top-4 rounded-full p-2 text-muted transition hover:bg-leaf hover:text-ink\"><Icon name=\"close\" className=\"size-4\" /></button>\n+        {children}\n+      </div>\n+    </dialog>\n+  );\n+}\n*** Add File: /workspace/frontend/src/AuthModal.tsx\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, ApiError } from \"./api\";\n+import type { FieldErrors, Session } from \"./api\";\n+import Icon from \"./Icons\";\n+import Modal from \"./Modal\";\n+\n+export default function AuthModal({ initialMode, onClose, onSuccess }: { initialMode: \"login\" | \"register\"; onClose: () => void; onSuccess: (session: Session) => void }) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [message, setMessage] = useState(\"\");\n+  const [errors, setErrors] = useState<FieldErrors>({});\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setMessage(\"\");\n+    setErrors({});\n+    try {\n+      const body = { username, password };\n+      if (mode === \"register\") await api(\"/auth/register\", { method: \"POST\", body });\n+      const session = await api<Session>(\"/auth/login\", { method: \"POST\", body });\n+      onSuccess(session);\n+    } catch (error) {\n+      setMessage(error instanceof Error ? error.message : \"Please try again.\");\n+      if (error instanceof ApiError) setErrors(error.errors);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <Modal title={mode === \"login\" ? \"Sign in\" : \"Create an account\"} onClose={onClose} busy={busy}>\n+      <div className=\"mb-6 flex size-12 items-center justify-center rounded-xl bg-leaf\"><Icon name=\"book\" className=\"size-6\" /></div>\n+      <p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted\">Your thoughts belong here</p>\n+      <h2 className=\"font-serif text-3xl\">{mode === \"login\" ? \"Welcome back.\" : \"Make a little space.\"}</h2>\n+      <p className=\"mt-3 text-sm leading-6 text-muted\">{mode === \"login\" ? \"Sign in to pick up where you left off.\" : \"Create an account to write, tag, and share your notes.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\" noValidate>\n+        <div>\n+          <label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label>\n+          <input id=\"username\" name=\"username\" autoFocus autoComplete=\"username\" value={username} onChange={event => setUsername(event.target.value)} disabled={busy} placeholder=\"Your username\" aria-invalid={!!errors.username} aria-describedby={errors.username ? \"username-error\" : undefined} className={`w-full rounded-lg border bg-white px-3.5 py-3 text-sm focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10 ${errors.username ? \"border-red-400\" : \"border-line\"}`} />\n+          {errors.username && <p id=\"username-error\" className=\"mt-1.5 text-xs text-red-700\">{errors.username}</p>}\n+        </div>\n+        <div>\n+          <label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label>\n+          <input id=\"password\" name=\"password\" type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={event => setPassword(event.target.value)} disabled={busy} placeholder={mode === \"register\" ? \"At least 8 characters\" : \"Your password\"} aria-invalid={!!errors.password} aria-describedby={errors.password ? \"password-error\" : undefined} className={`w-full rounded-lg border bg-white px-3.5 py-3 text-sm focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10 ${errors.password ? \"border-red-400\" : \"border-line\"}`} />\n+          {errors.password && <p id=\"password-error\" className=\"mt-1.5 text-xs text-red-700\">{errors.password}</p>}\n+        </div>\n+        {message && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{message}</p>}\n+        <button disabled={busy} className=\"flex w-full items-center justify-center gap-2 rounded-lg bg-moss py-3 text-sm font-medium text-white transition hover:bg-ink\">{busy ? \"One moment…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" className=\"size-4\" /></button>\n+      </form>\n+      <p className=\"mt-6 text-center text-xs text-muted\">{mode === \"login\" ? \"A new page? \" : \"Already have an account? \"}<button type=\"button\" disabled={busy} onClick={() => { setMode(mode === \"login\" ? \"register\" : \"login\"); setErrors({}); setMessage(\"\"); }} className=\"font-medium text-moss underline decoration-moss/30 underline-offset-4\">{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n+    </Modal>\n+  );\n+}\n*** Add File: /workspace/frontend/src/NoteEditor.tsx\n+import { useState } from \"react\";\n+import type { FormEvent, KeyboardEvent } from \"react\";\n+import { api, ApiError } from \"./api\";\n+import type { FieldErrors, Note, Session } from \"./api\";\n+import Icon from \"./Icons\";\n+\n+export default function NoteEditor({ note, session, onSave, onCancel }: { note?: Note; session: Session; onSave: (note: Note) => void; onCancel: () => void }) {\n+  const [title, setTitle] = useState(note?.title ?? \"\");\n+  const [content, setContent] = useState(note?.content ?? \"\");\n+  const [tags, setTags] = useState<string[]>(note?.tags ?? []);\n+  const [tagInput, setTagInput] = useState(\"\");\n+  const [pinned, setPinned] = useState(note?.pinned ?? false);\n+  const [busy, setBusy] = useState(false);\n+  const [errors, setErrors] = useState<FieldErrors>({});\n+  const [message, setMessage] = useState(\"\");\n+\n+  function combinedTags() {\n+    return [...new Set([...tags, ...tagInput.split(\",\").map(tag => tag.trim().toLowerCase()).filter(Boolean)])];\n+  }\n+\n+  function addTags() {\n+    setTags(combinedTags());\n+    setTagInput(\"\");\n+  }\n+\n+  function tagKey(event: KeyboardEvent<HTMLInputElement>) {\n+    if (event.key === \"Enter\" || event.key === \",\") {\n+      event.preventDefault();\n+      addTags();\n+    }\n+    if (event.key === \"Backspace\" && !tagInput) setTags(tags.slice(0, -1));\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setErrors({});\n+    setMessage(\"\");\n+    try {\n+      const saved = await api<Note>(note ? `/notes/${note.id}` : \"/notes\", {\n+        method: note ? \"PATCH\" : \"POST\", token: session.token,\n+        body: { title, content, tags: combinedTags(), pinned },\n+      });\n+      onSave(saved);\n+    } catch (error) {\n+      setMessage(error instanceof Error ? error.message : \"Please try again.\");\n+      if (error instanceof ApiError) setErrors(error.errors);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <div className=\"mx-auto max-w-3xl\">\n+      <button onClick={onCancel} disabled={busy} className=\"mb-8 flex items-center gap-2 text-xs text-muted transition hover:text-ink\"><Icon name=\"back\" className=\"size-4\" />{note ? \"Back to note\" : \"Back to all notes\"}</button>\n+      <p className=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted\">{note ? \"A little refinement\" : \"A fresh page\"}</p>\n+      <h1 className=\"font-serif text-4xl tracking-tight\">{note ? \"Edit your note.\" : \"What’s on your mind?\"}</h1>\n+      <p className=\"mt-3 text-sm text-muted\">{note ? \"Good thoughts can always grow.\" : \"An idea, a reminder, a small discovery. Keep it here.\"}</p>\n+      <form onSubmit={submit} className=\"mt-8 overflow-hidden rounded-xl border border-line bg-white\" noValidate>\n+        <div className=\"space-y-7 p-6 sm:p-9\">\n+          <div>\n+            <label htmlFor=\"note-title\" className=\"mb-2 block text-xs font-semibold\">Title <span className=\"font-normal text-muted\">(required)</span></label>\n+            <input id=\"note-title\" autoFocus placeholder=\"Give your thought a title…\" value={title} onChange={event => setTitle(event.target.value)} disabled={busy} aria-invalid={!!errors.title} aria-describedby={errors.title ? \"title-error\" : undefined} className=\"w-full border-b border-line bg-transparent pb-3 font-serif text-2xl placeholder:text-muted/50 focus:border-moss focus:outline-none\" />\n+            {errors.title && <p id=\"title-error\" className=\"mt-2 text-xs text-red-700\">{errors.title}</p>}\n+          </div>\n+          <div>\n+            <label htmlFor=\"note-content\" className=\"mb-3 block text-xs font-semibold\">Your note</label>\n+            <textarea id=\"note-content\" rows={11} placeholder=\"Start writing. There’s no right way to begin.\" value={content} onChange={event => setContent(event.target.value)} disabled={busy} aria-invalid={!!errors.content} aria-describedby={errors.content ? \"content-error\" : undefined} className=\"min-h-60 w-full resize-y rounded-lg border border-line bg-paper/50 p-4 text-sm leading-7 placeholder:text-muted/65 focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10\" />\n+            {errors.content && <p id=\"content-error\" className=\"mt-2 text-xs text-red-700\">{errors.content}</p>}\n+            <p className=\"mt-2 flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"notes\" className=\"size-3\" />Plain text. Just your words, as you wrote them.</p>\n+          </div>\n+          <div>\n+            <label htmlFor=\"note-tags\" className=\"mb-2 block text-xs font-semibold\">Tags <span className=\"font-normal text-muted\">(optional)</span></label>\n+            <div className={`flex min-h-12 flex-wrap items-center gap-2 rounded-lg border p-2 focus-within:border-moss focus-within:ring-2 focus-within:ring-moss/10 ${errors.tags ? \"border-red-400\" : \"border-line\"}`}>\n+              {tags.map(tag => <span key={tag} className=\"flex max-w-full items-center gap-1.5 rounded-md bg-leaf px-2.5 py-1.5 text-xs\"><span className=\"truncate\">#{tag}</span><button type=\"button\" aria-label={`Remove ${tag} tag`} onClick={() => setTags(tags.filter(value => value !== tag))} disabled={busy} className=\"rounded p-0.5 hover:bg-moss/10\"><Icon name=\"close\" className=\"size-3\" /></button></span>)}\n+              <input id=\"note-tags\" placeholder={tags.length ? \"Add another…\" : \"ideas, work, little things…\"} value={tagInput} onChange={event => setTagInput(event.target.value)} onKeyDown={tagKey} onBlur={addTags} disabled={busy} aria-invalid={!!errors.tags} aria-describedby={errors.tags ? \"tags-error\" : \"tags-help\"} className=\"min-w-32 flex-1 bg-transparent px-2 py-1 text-sm placeholder:text-muted/65 focus:outline-none\" />\n+            </div>\n+            {errors.tags && <p id=\"tags-error\" className=\"mt-2 text-xs text-red-700\">{errors.tags}</p>}\n+            <p id=\"tags-help\" className=\"mt-2 text-[11px] text-muted\">Press Enter or use a comma to add a tag. Up to 12 tags, 40 characters each.</p>\n+          </div>\n+          <label className=\"flex cursor-pointer items-center gap-3 rounded-lg bg-paper p-4\">\n+            <input type=\"checkbox\" checked={pinned} onChange={event => setPinned(event.target.checked)} disabled={busy} className=\"size-4 accent-moss\" />\n+            <Icon name=\"pin\" className=\"size-4\" /><span><span className=\"block text-xs font-medium\">Pin this note</span><span className=\"mt-1 block text-[11px] text-muted\">Keep the important things at the top.</span></span>\n+          </label>\n+          {message && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{message}{errors.fields && <span className=\"mt-1 block\">{errors.fields}</span>}</p>}\n+        </div>\n+        <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-line bg-paper/50 px-6 py-5 sm:px-9\">\n+          <span className=\"flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"globe\" className=\"size-3.5\" />This note will be public.</span>\n+          <div className=\"flex items-center gap-4\"><button type=\"button\" onClick={onCancel} disabled={busy} className=\"text-xs text-muted hover:text-ink\">Cancel</button><button disabled={busy} className=\"flex items-center gap-2 rounded-lg bg-moss px-5 py-3 text-xs font-medium text-white transition hover:bg-ink\">{busy ? \"Saving…\" : note ? \"Save changes\" : \"Publish note\"}<Icon name=\"check\" className=\"size-4\" /></button></div>\n+        </div>\n+      </form>\n+    </div>\n+  );\n+}\n*** End Patch"},"output":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nA frontend/src/api.ts\nA frontend/src/Icons.tsx\nA frontend/src/Modal.tsx\nA frontend/src/AuthModal.tsx\nA frontend/src/NoteEditor.tsx","metadata":{"diff":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n\nIndex: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n+import tailwindcss from \"@tailwindcss/vite\";\n import react from \"@vitejs/plugin-react\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n\nIndex: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n\nIndex: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f8f9f5\" />\n+    <meta name=\"description\" content=\"A little space for big ideas. Capture, tag, and share your thoughts with Marginalia.\" />\n+    <title>Marginalia — A place for your thoughts</title>\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n\nIndex: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" rx=\"18\" fill=\"#354b3e\"/><path d=\"M17 15h30v37H17z\" fill=\"#edf2dd\"/><path d=\"M23 15v37M29 25h12M29 32h12M29 39h8\" stroke=\"#354b3e\" stroke-width=\"3\"/><path d=\"M39 12v13l4-3 4 3V12\" fill=\"#dce9a1\"/></svg>\n\nIndex: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,18 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2023\",\n+    \"lib\": [\"ES2023\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n\nIndex: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,19 @@\n+import js from \"@eslint/js\";\n+import tseslint from \"typescript-eslint\";\n+import hooks from \"eslint-plugin-react-hooks\";\n+import refresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    plugins: { \"react-hooks\": hooks, \"react-refresh\": refresh },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n\nIndex: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,33 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-paper: #f8f9f5;\n+  --color-ink: #293b31;\n+  --color-muted: #7c8178;\n+  --color-line: #e4e7de;\n+  --color-leaf: #e9efdc;\n+  --color-moss: #354b3e;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input, textarea {\n+    @apply outline-offset-4 focus-visible:outline-2 focus-visible:outline-moss;\n+  }\n+  button:not(:disabled), a {\n+    @apply cursor-pointer;\n+  }\n+  button:disabled {\n+    @apply cursor-not-allowed opacity-50;\n+  }\n+  ::selection {\n+    @apply bg-leaf text-ink;\n+  }\n+  dialog::backdrop {\n+    @apply bg-ink/35 backdrop-blur-sm;\n+  }\n+}\n\nIndex: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,81 @@\n+export type Note = {\n+  id: number;\n+  title: string;\n+  content: string;\n+  tags: string[];\n+  pinned: boolean;\n+  created_at: string;\n+  updated_at: string;\n+  author: string;\n+};\n+\n+export type NotePage = { items: Note[]; total: number; page: number; page_size: number };\n+export type Tag = { tag: string; count: number };\n+export type Session = { token: string; username: string };\n+export type FieldErrors = Record<string, string>;\n+export type NoteDraft = Pick<Note, \"title\" | \"content\" | \"tags\" | \"pinned\">;\n+\n+export class ApiError extends Error {\n+  status: number;\n+  errors: FieldErrors;\n+\n+  constructor(message: string, status: number, errors: FieldErrors = {}) {\n+    super(message);\n+    this.status = status;\n+    this.errors = errors;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: { method?: string; body?: unknown; token?: string; signal?: AbortSignal } = {}): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      headers: {\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),\n+      },\n+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n+      signal: options.signal,\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"We couldn’t reach the notebook. Please try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => ({ error: \"Something went wrong. Please try again.\" }));\n+  if (!response.ok) {\n+    if (response.status === 401 && options.token) window.dispatchEvent(new Event(\"session-expired\"));\n+    throw new ApiError(data.error ?? \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function readSession(): Session | null {\n+  try {\n+    const value = JSON.parse(localStorage.getItem(\"marginalia-session\") ?? \"null\");\n+    return typeof value?.token === \"string\" && typeof value?.username === \"string\" ? value : null;\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function storeSession(session: Session | null) {\n+  try {\n+    if (session) localStorage.setItem(\"marginalia-session\", JSON.stringify(session));\n+    else localStorage.removeItem(\"marginalia-session\");\n+  } catch {\n+    return;\n+  }\n+}\n+\n+export function dateLabel(date: string) {\n+  return new Date(date).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" });\n+}\n+\n+export function relativeDate(date: string) {\n+  const days = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);\n+  if (days === 0) return \"Today\";\n+  if (days === 1) return \"Yesterday\";\n+  return new Date(date).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" });\n+}\n\nIndex: /workspace/frontend/src/Icons.tsx\n===================================================================\n--- /workspace/frontend/src/Icons.tsx\n+++ /workspace/frontend/src/Icons.tsx\n@@ -0,0 +1,30 @@\n+import type { SVGProps } from \"react\";\n+\n+const paths = {\n+  book: <><path d=\"M5 3h13a2 2 0 0 1 2 2v16H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z\" /><path d=\"M7 3v18M11 8h5M11 12h5M11 16h3\" /></>,\n+  notes: <><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\" /><path d=\"M9 8h6M9 12h6M9 16h3\" /></>,\n+  plus: <path d=\"M12 5v14M5 12h14\" />,\n+  search: <><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" /><path d=\"m16 16 4.5 4.5\" /></>,\n+  pin: <><path d=\"m9 3 9 3-3 4 1 5-5-1-4 3-3-9 5 1Z\" /><path d=\"m11 14-7 7\" /></>,\n+  tag: <><path d=\"M3 3h8l10 10-8 8L3 11V3Z\" /><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" /></>,\n+  arrow: <path d=\"M4 12h16m-6-6 6 6-6 6\" />,\n+  back: <path d=\"M20 12H4m6-6-6 6 6 6\" />,\n+  chevron: <path d=\"m9 5 7 7-7 7\" />,\n+  down: <path d=\"m6 9 6 6 6-6\" />,\n+  close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+  user: <><circle cx=\"12\" cy=\"8\" r=\"4\" /><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\" /></>,\n+  globe: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a19 19 0 0 1 0 18 19 19 0 0 1 0-18\" /></>,\n+  edit: <><path d=\"m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-4-4L5 15l-1 5Z\" /><path d=\"M13 20h8\" /></>,\n+  trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7\" /></>,\n+  check: <path d=\"m5 12 4 4L19 6\" />,\n+  logout: <><path d=\"M9 4H4v16h5M10 12h11m-4-4 4 4-4 4\" /></>,\n+  menu: <path d=\"M4 6h16M4 12h16M4 18h16\" />,\n+  sparkle: <><path d=\"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z\" /><path d=\"m20 2 .5 1.5L22 4l-1.5.5L20 6l-.5-1.5L18 4l1.5-.5L20 2Z\" /></>,\n+  grid: <><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /></>,\n+  list: <><path d=\"M9 5h12M9 12h12M9 19h12M3 5h1M3 12h1M3 19h1\" /></>,\n+  clock: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 7v5l3 2\" /></>,\n+};\n+\n+export default function Icon({ name, className = \"size-5\", ...props }: SVGProps<SVGSVGElement> & { name: keyof typeof paths }) {\n+  return <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className={className} aria-hidden=\"true\" {...props}>{paths[name]}</svg>;\n+}\n\nIndex: /workspace/frontend/src/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/Modal.tsx\n+++ /workspace/frontend/src/Modal.tsx\n@@ -0,0 +1,27 @@\n+import { useEffect, useRef } from \"react\";\n+import type { ReactNode } from \"react\";\n+import Icon from \"./Icons\";\n+\n+export default function Modal({ title, children, onClose, busy = false }: { title: string; children: ReactNode; onClose: () => void; busy?: boolean }) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+\n+  useEffect(() => {\n+    const dialog = ref.current;\n+    dialog?.showModal();\n+    const original = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => {\n+      dialog?.close();\n+      document.body.style.overflow = original;\n+    };\n+  }, []);\n+\n+  return (\n+    <dialog ref={ref} aria-label={title} onCancel={event => { event.preventDefault(); if (!busy) onClose(); }} onClick={event => { if (event.target === event.currentTarget && !busy) onClose(); }} className=\"fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-paper p-0 text-ink shadow-2xl\">\n+      <div className=\"relative p-7 sm:p-9\">\n+        <button type=\"button\" aria-label=\"Close dialog\" onClick={onClose} disabled={busy} className=\"absolute right-4 top-4 rounded-full p-2 text-muted transition hover:bg-leaf hover:text-ink\"><Icon name=\"close\" className=\"size-4\" /></button>\n+        {children}\n+      </div>\n+    </dialog>\n+  );\n+}\n\nIndex: /workspace/frontend/src/AuthModal.tsx\n===================================================================\n--- /workspace/frontend/src/AuthModal.tsx\n+++ /workspace/frontend/src/AuthModal.tsx\n@@ -0,0 +1,57 @@\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, ApiError } from \"./api\";\n+import type { FieldErrors, Session } from \"./api\";\n+import Icon from \"./Icons\";\n+import Modal from \"./Modal\";\n+\n+export default function AuthModal({ initialMode, onClose, onSuccess }: { initialMode: \"login\" | \"register\"; onClose: () => void; onSuccess: (session: Session) => void }) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [message, setMessage] = useState(\"\");\n+  const [errors, setErrors] = useState<FieldErrors>({});\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setMessage(\"\");\n+    setErrors({});\n+    try {\n+      const body = { username, password };\n+      if (mode === \"register\") await api(\"/auth/register\", { method: \"POST\", body });\n+      const session = await api<Session>(\"/auth/login\", { method: \"POST\", body });\n+      onSuccess(session);\n+    } catch (error) {\n+      setMessage(error instanceof Error ? error.message : \"Please try again.\");\n+      if (error instanceof ApiError) setErrors(error.errors);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <Modal title={mode === \"login\" ? \"Sign in\" : \"Create an account\"} onClose={onClose} busy={busy}>\n+      <div className=\"mb-6 flex size-12 items-center justify-center rounded-xl bg-leaf\"><Icon name=\"book\" className=\"size-6\" /></div>\n+      <p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted\">Your thoughts belong here</p>\n+      <h2 className=\"font-serif text-3xl\">{mode === \"login\" ? \"Welcome back.\" : \"Make a little space.\"}</h2>\n+      <p className=\"mt-3 text-sm leading-6 text-muted\">{mode === \"login\" ? \"Sign in to pick up where you left off.\" : \"Create an account to write, tag, and share your notes.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\" noValidate>\n+        <div>\n+          <label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label>\n+          <input id=\"username\" name=\"username\" autoFocus autoComplete=\"username\" value={username} onChange={event => setUsername(event.target.value)} disabled={busy} placeholder=\"Your username\" aria-invalid={!!errors.username} aria-describedby={errors.username ? \"username-error\" : undefined} className={`w-full rounded-lg border bg-white px-3.5 py-3 text-sm focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10 ${errors.username ? \"border-red-400\" : \"border-line\"}`} />\n+          {errors.username && <p id=\"username-error\" className=\"mt-1.5 text-xs text-red-700\">{errors.username}</p>}\n+        </div>\n+        <div>\n+          <label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label>\n+          <input id=\"password\" name=\"password\" type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={event => setPassword(event.target.value)} disabled={busy} placeholder={mode === \"register\" ? \"At least 8 characters\" : \"Your password\"} aria-invalid={!!errors.password} aria-describedby={errors.password ? \"password-error\" : undefined} className={`w-full rounded-lg border bg-white px-3.5 py-3 text-sm focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10 ${errors.password ? \"border-red-400\" : \"border-line\"}`} />\n+          {errors.password && <p id=\"password-error\" className=\"mt-1.5 text-xs text-red-700\">{errors.password}</p>}\n+        </div>\n+        {message && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{message}</p>}\n+        <button disabled={busy} className=\"flex w-full items-center justify-center gap-2 rounded-lg bg-moss py-3 text-sm font-medium text-white transition hover:bg-ink\">{busy ? \"One moment…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" className=\"size-4\" /></button>\n+      </form>\n+      <p className=\"mt-6 text-center text-xs text-muted\">{mode === \"login\" ? \"A new page? \" : \"Already have an account? \"}<button type=\"button\" disabled={busy} onClick={() => { setMode(mode === \"login\" ? \"register\" : \"login\"); setErrors({}); setMessage(\"\"); }} className=\"font-medium text-moss underline decoration-moss/30 underline-offset-4\">{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n+    </Modal>\n+  );\n+}\n\nIndex: /workspace/frontend/src/NoteEditor.tsx\n===================================================================\n--- /workspace/frontend/src/NoteEditor.tsx\n+++ /workspace/frontend/src/NoteEditor.tsx\n@@ -0,0 +1,94 @@\n+import { useState } from \"react\";\n+import type { FormEvent, KeyboardEvent } from \"react\";\n+import { api, ApiError } from \"./api\";\n+import type { FieldErrors, Note, Session } from \"./api\";\n+import Icon from \"./Icons\";\n+\n+export default function NoteEditor({ note, session, onSave, onCancel }: { note?: Note; session: Session; onSave: (note: Note) => void; onCancel: () => void }) {\n+  const [title, setTitle] = useState(note?.title ?? \"\");\n+  const [content, setContent] = useState(note?.content ?? \"\");\n+  const [tags, setTags] = useState<string[]>(note?.tags ?? []);\n+  const [tagInput, setTagInput] = useState(\"\");\n+  const [pinned, setPinned] = useState(note?.pinned ?? false);\n+  const [busy, setBusy] = useState(false);\n+  const [errors, setErrors] = useState<FieldErrors>({});\n+  const [message, setMessage] = useState(\"\");\n+\n+  function combinedTags() {\n+    return [...new Set([...tags, ...tagInput.split(\",\").map(tag => tag.trim().toLowerCase()).filter(Boolean)])];\n+  }\n+\n+  function addTags() {\n+    setTags(combinedTags());\n+    setTagInput(\"\");\n+  }\n+\n+  function tagKey(event: KeyboardEvent<HTMLInputElement>) {\n+    if (event.key === \"Enter\" || event.key === \",\") {\n+      event.preventDefault();\n+      addTags();\n+    }\n+    if (event.key === \"Backspace\" && !tagInput) setTags(tags.slice(0, -1));\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setErrors({});\n+    setMessage(\"\");\n+    try {\n+      const saved = await api<Note>(note ? `/notes/${note.id}` : \"/notes\", {\n+        method: note ? \"PATCH\" : \"POST\", token: session.token,\n+        body: { title, content, tags: combinedTags(), pinned },\n+      });\n+      onSave(saved);\n+    } catch (error) {\n+      setMessage(error instanceof Error ? error.message : \"Please try again.\");\n+      if (error instanceof ApiError) setErrors(error.errors);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <div className=\"mx-auto max-w-3xl\">\n+      <button onClick={onCancel} disabled={busy} className=\"mb-8 flex items-center gap-2 text-xs text-muted transition hover:text-ink\"><Icon name=\"back\" className=\"size-4\" />{note ? \"Back to note\" : \"Back to all notes\"}</button>\n+      <p className=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted\">{note ? \"A little refinement\" : \"A fresh page\"}</p>\n+      <h1 className=\"font-serif text-4xl tracking-tight\">{note ? \"Edit your note.\" : \"What’s on your mind?\"}</h1>\n+      <p className=\"mt-3 text-sm text-muted\">{note ? \"Good thoughts can always grow.\" : \"An idea, a reminder, a small discovery. Keep it here.\"}</p>\n+      <form onSubmit={submit} className=\"mt-8 overflow-hidden rounded-xl border border-line bg-white\" noValidate>\n+        <div className=\"space-y-7 p-6 sm:p-9\">\n+          <div>\n+            <label htmlFor=\"note-title\" className=\"mb-2 block text-xs font-semibold\">Title <span className=\"font-normal text-muted\">(required)</span></label>\n+            <input id=\"note-title\" autoFocus placeholder=\"Give your thought a title…\" value={title} onChange={event => setTitle(event.target.value)} disabled={busy} aria-invalid={!!errors.title} aria-describedby={errors.title ? \"title-error\" : undefined} className=\"w-full border-b border-line bg-transparent pb-3 font-serif text-2xl placeholder:text-muted/50 focus:border-moss focus:outline-none\" />\n+            {errors.title && <p id=\"title-error\" className=\"mt-2 text-xs text-red-700\">{errors.title}</p>}\n+          </div>\n+          <div>\n+            <label htmlFor=\"note-content\" className=\"mb-3 block text-xs font-semibold\">Your note</label>\n+            <textarea id=\"note-content\" rows={11} placeholder=\"Start writing. There’s no right way to begin.\" value={content} onChange={event => setContent(event.target.value)} disabled={busy} aria-invalid={!!errors.content} aria-describedby={errors.content ? \"content-error\" : undefined} className=\"min-h-60 w-full resize-y rounded-lg border border-line bg-paper/50 p-4 text-sm leading-7 placeholder:text-muted/65 focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10\" />\n+            {errors.content && <p id=\"content-error\" className=\"mt-2 text-xs text-red-700\">{errors.content}</p>}\n+            <p className=\"mt-2 flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"notes\" className=\"size-3\" />Plain text. Just your words, as you wrote them.</p>\n+          </div>\n+          <div>\n+            <label htmlFor=\"note-tags\" className=\"mb-2 block text-xs font-semibold\">Tags <span className=\"font-normal text-muted\">(optional)</span></label>\n+            <div className={`flex min-h-12 flex-wrap items-center gap-2 rounded-lg border p-2 focus-within:border-moss focus-within:ring-2 focus-within:ring-moss/10 ${errors.tags ? \"border-red-400\" : \"border-line\"}`}>\n+              {tags.map(tag => <span key={tag} className=\"flex max-w-full items-center gap-1.5 rounded-md bg-leaf px-2.5 py-1.5 text-xs\"><span className=\"truncate\">#{tag}</span><button type=\"button\" aria-label={`Remove ${tag} tag`} onClick={() => setTags(tags.filter(value => value !== tag))} disabled={busy} className=\"rounded p-0.5 hover:bg-moss/10\"><Icon name=\"close\" className=\"size-3\" /></button></span>)}\n+              <input id=\"note-tags\" placeholder={tags.length ? \"Add another…\" : \"ideas, work, little things…\"} value={tagInput} onChange={event => setTagInput(event.target.value)} onKeyDown={tagKey} onBlur={addTags} disabled={busy} aria-invalid={!!errors.tags} aria-describedby={errors.tags ? \"tags-error\" : \"tags-help\"} className=\"min-w-32 flex-1 bg-transparent px-2 py-1 text-sm placeholder:text-muted/65 focus:outline-none\" />\n+            </div>\n+            {errors.tags && <p id=\"tags-error\" className=\"mt-2 text-xs text-red-700\">{errors.tags}</p>}\n+            <p id=\"tags-help\" className=\"mt-2 text-[11px] text-muted\">Press Enter or use a comma to add a tag. Up to 12 tags, 40 characters each.</p>\n+          </div>\n+          <label className=\"flex cursor-pointer items-center gap-3 rounded-lg bg-paper p-4\">\n+            <input type=\"checkbox\" checked={pinned} onChange={event => setPinned(event.target.checked)} disabled={busy} className=\"size-4 accent-moss\" />\n+            <Icon name=\"pin\" className=\"size-4\" /><span><span className=\"block text-xs font-medium\">Pin this note</span><span className=\"mt-1 block text-[11px] text-muted\">Keep the important things at the top.</span></span>\n+          </label>\n+          {message && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{message}{errors.fields && <span className=\"mt-1 block\">{errors.fields}</span>}</p>}\n+        </div>\n+        <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-line bg-paper/50 px-6 py-5 sm:px-9\">\n+          <span className=\"flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"globe\" className=\"size-3.5\" />This note will be public.</span>\n+          <div className=\"flex items-center gap-4\"><button type=\"button\" onClick={onCancel} disabled={busy} className=\"text-xs text-muted hover:text-ink\">Cancel</button><button disabled={busy} className=\"flex items-center gap-2 rounded-lg bg-moss px-5 py-3 text-xs font-medium text-white transition hover:bg-ink\">{busy ? \"Saving…\" : note ? \"Save changes\" : \"Publish note\"}<Icon name=\"check\" className=\"size-4\" /></button></div>\n+        </div>\n+      </form>\n+    </div>\n+  );\n+}\n\n","files":[{"filePath":"/workspace/frontend/package.json","relativePath":"frontend/package.json","type":"update","patch":"Index: /workspace/frontend/package.json\n===================================================================\n--- /workspace/frontend/package.json\n+++ /workspace/frontend/package.json\n@@ -3,9 +3,11 @@\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n   \"dev\": \"vite\",\n-  \"build\": \"vite build\"\n+  \"build\": \"tsc --noEmit && vite build\",\n+  \"typecheck\": \"tsc --noEmit\",\n+  \"lint\": \"eslint .\"\n },\n \"dependencies\": {\n   \"react\": \"19.3.1\",\n   \"react-dom\": \"19.3.1\"\n","additions":3,"deletions":1},{"filePath":"/workspace/frontend/vite.config.ts","relativePath":"frontend/vite.config.ts","type":"update","patch":"Index: /workspace/frontend/vite.config.ts\n===================================================================\n--- /workspace/frontend/vite.config.ts\n+++ /workspace/frontend/vite.config.ts\n@@ -1,7 +1,8 @@\n+import tailwindcss from \"@tailwindcss/vite\";\n import react from \"@vitejs/plugin-react\";\n import { defineConfig } from \"vite\";\n \n export default defineConfig({\n-  plugins: [react()],\n+  plugins: [react(), tailwindcss()],\n   server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n });\n","additions":2,"deletions":1},{"filePath":"/workspace/frontend/src/main.tsx","relativePath":"frontend/src/main.tsx","type":"update","patch":"Index: /workspace/frontend/src/main.tsx\n===================================================================\n--- /workspace/frontend/src/main.tsx\n+++ /workspace/frontend/src/main.tsx\n@@ -1,4 +1,5 @@\n import { createRoot } from \"react-dom/client\";\n import App from \"./App\";\n+import \"./index.css\";\n \n createRoot(document.getElementById(\"root\")!).render(<App />);\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/index.html","relativePath":"frontend/index.html","type":"update","patch":"Index: /workspace/frontend/index.html\n===================================================================\n--- /workspace/frontend/index.html\n+++ /workspace/frontend/index.html\n@@ -2,9 +2,12 @@\n <html lang=\"en\">\n   <head>\n     <meta charset=\"utf-8\" />\n     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n-    <title>App</title>\n+    <meta name=\"theme-color\" content=\"#f8f9f5\" />\n+    <meta name=\"description\" content=\"A little space for big ideas. Capture, tag, and share your thoughts with Marginalia.\" />\n+    <title>Marginalia — A place for your thoughts</title>\n+    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n   </head>\n   <body>\n     <div id=\"root\"></div>\n     <script type=\"module\" src=\"/src/main.tsx\"></script>\n","additions":4,"deletions":1},{"filePath":"/workspace/frontend/public/favicon.svg","relativePath":"frontend/public/favicon.svg","type":"add","patch":"Index: /workspace/frontend/public/favicon.svg\n===================================================================\n--- /workspace/frontend/public/favicon.svg\n+++ /workspace/frontend/public/favicon.svg\n@@ -0,0 +1,1 @@\n+<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" rx=\"18\" fill=\"#354b3e\"/><path d=\"M17 15h30v37H17z\" fill=\"#edf2dd\"/><path d=\"M23 15v37M29 25h12M29 32h12M29 39h8\" stroke=\"#354b3e\" stroke-width=\"3\"/><path d=\"M39 12v13l4-3 4 3V12\" fill=\"#dce9a1\"/></svg>\n","additions":1,"deletions":0},{"filePath":"/workspace/frontend/tsconfig.json","relativePath":"frontend/tsconfig.json","type":"add","patch":"Index: /workspace/frontend/tsconfig.json\n===================================================================\n--- /workspace/frontend/tsconfig.json\n+++ /workspace/frontend/tsconfig.json\n@@ -0,0 +1,18 @@\n+{\n+  \"compilerOptions\": {\n+    \"target\": \"ES2023\",\n+    \"lib\": [\"ES2023\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"skipLibCheck\": true,\n+    \"noEmit\": true,\n+    \"allowImportingTsExtensions\": true,\n+    \"verbatimModuleSyntax\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"types\": [\"vite/client\", \"node\"]\n+  },\n+  \"include\": [\"src\", \"vite.config.ts\"]\n+}\n","additions":18,"deletions":0},{"filePath":"/workspace/frontend/eslint.config.js","relativePath":"frontend/eslint.config.js","type":"add","patch":"Index: /workspace/frontend/eslint.config.js\n===================================================================\n--- /workspace/frontend/eslint.config.js\n+++ /workspace/frontend/eslint.config.js\n@@ -0,0 +1,19 @@\n+import js from \"@eslint/js\";\n+import tseslint from \"typescript-eslint\";\n+import hooks from \"eslint-plugin-react-hooks\";\n+import refresh from \"eslint-plugin-react-refresh\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \"node_modules\"] },\n+  js.configs.recommended,\n+  ...tseslint.configs.recommended,\n+  {\n+    files: [\"**/*.{ts,tsx}\"],\n+    plugins: { \"react-hooks\": hooks, \"react-refresh\": refresh },\n+    rules: {\n+      \"react-hooks/rules-of-hooks\": \"error\",\n+      \"react-hooks/exhaustive-deps\": \"warn\",\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }]\n+    }\n+  }\n+);\n","additions":19,"deletions":0},{"filePath":"/workspace/frontend/src/index.css","relativePath":"frontend/src/index.css","type":"add","patch":"Index: /workspace/frontend/src/index.css\n===================================================================\n--- /workspace/frontend/src/index.css\n+++ /workspace/frontend/src/index.css\n@@ -0,0 +1,33 @@\n+@import \"tailwindcss\";\n+\n+@theme {\n+  --font-sans: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n+  --font-serif: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n+  --color-paper: #f8f9f5;\n+  --color-ink: #293b31;\n+  --color-muted: #7c8178;\n+  --color-line: #e4e7de;\n+  --color-leaf: #e9efdc;\n+  --color-moss: #354b3e;\n+}\n+\n+@layer base {\n+  body {\n+    @apply m-0 bg-paper font-sans text-ink antialiased;\n+  }\n+  button, a, input, textarea {\n+    @apply outline-offset-4 focus-visible:outline-2 focus-visible:outline-moss;\n+  }\n+  button:not(:disabled), a {\n+    @apply cursor-pointer;\n+  }\n+  button:disabled {\n+    @apply cursor-not-allowed opacity-50;\n+  }\n+  ::selection {\n+    @apply bg-leaf text-ink;\n+  }\n+  dialog::backdrop {\n+    @apply bg-ink/35 backdrop-blur-sm;\n+  }\n+}\n","additions":33,"deletions":0},{"filePath":"/workspace/frontend/src/api.ts","relativePath":"frontend/src/api.ts","type":"add","patch":"Index: /workspace/frontend/src/api.ts\n===================================================================\n--- /workspace/frontend/src/api.ts\n+++ /workspace/frontend/src/api.ts\n@@ -0,0 +1,81 @@\n+export type Note = {\n+  id: number;\n+  title: string;\n+  content: string;\n+  tags: string[];\n+  pinned: boolean;\n+  created_at: string;\n+  updated_at: string;\n+  author: string;\n+};\n+\n+export type NotePage = { items: Note[]; total: number; page: number; page_size: number };\n+export type Tag = { tag: string; count: number };\n+export type Session = { token: string; username: string };\n+export type FieldErrors = Record<string, string>;\n+export type NoteDraft = Pick<Note, \"title\" | \"content\" | \"tags\" | \"pinned\">;\n+\n+export class ApiError extends Error {\n+  status: number;\n+  errors: FieldErrors;\n+\n+  constructor(message: string, status: number, errors: FieldErrors = {}) {\n+    super(message);\n+    this.status = status;\n+    this.errors = errors;\n+  }\n+}\n+\n+export async function api<T>(path: string, options: { method?: string; body?: unknown; token?: string; signal?: AbortSignal } = {}): Promise<T> {\n+  let response: Response;\n+  try {\n+    response = await fetch(`/api${path}`, {\n+      method: options.method ?? \"GET\",\n+      headers: {\n+        ...(options.body !== undefined ? { \"Content-Type\": \"application/json\" } : {}),\n+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),\n+      },\n+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n+      signal: options.signal,\n+    });\n+  } catch (error) {\n+    if (error instanceof DOMException && error.name === \"AbortError\") throw error;\n+    throw new ApiError(\"We couldn’t reach the notebook. Please try again.\", 0);\n+  }\n+  if (response.status === 204) return undefined as T;\n+  const data = await response.json().catch(() => ({ error: \"Something went wrong. Please try again.\" }));\n+  if (!response.ok) {\n+    if (response.status === 401 && options.token) window.dispatchEvent(new Event(\"session-expired\"));\n+    throw new ApiError(data.error ?? \"Something went wrong. Please try again.\", response.status, data.errors);\n+  }\n+  return data as T;\n+}\n+\n+export function readSession(): Session | null {\n+  try {\n+    const value = JSON.parse(localStorage.getItem(\"marginalia-session\") ?? \"null\");\n+    return typeof value?.token === \"string\" && typeof value?.username === \"string\" ? value : null;\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function storeSession(session: Session | null) {\n+  try {\n+    if (session) localStorage.setItem(\"marginalia-session\", JSON.stringify(session));\n+    else localStorage.removeItem(\"marginalia-session\");\n+  } catch {\n+    return;\n+  }\n+}\n+\n+export function dateLabel(date: string) {\n+  return new Date(date).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" });\n+}\n+\n+export function relativeDate(date: string) {\n+  const days = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);\n+  if (days === 0) return \"Today\";\n+  if (days === 1) return \"Yesterday\";\n+  return new Date(date).toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" });\n+}\n","additions":81,"deletions":0},{"filePath":"/workspace/frontend/src/Icons.tsx","relativePath":"frontend/src/Icons.tsx","type":"add","patch":"Index: /workspace/frontend/src/Icons.tsx\n===================================================================\n--- /workspace/frontend/src/Icons.tsx\n+++ /workspace/frontend/src/Icons.tsx\n@@ -0,0 +1,30 @@\n+import type { SVGProps } from \"react\";\n+\n+const paths = {\n+  book: <><path d=\"M5 3h13a2 2 0 0 1 2 2v16H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z\" /><path d=\"M7 3v18M11 8h5M11 12h5M11 16h3\" /></>,\n+  notes: <><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\" /><path d=\"M9 8h6M9 12h6M9 16h3\" /></>,\n+  plus: <path d=\"M12 5v14M5 12h14\" />,\n+  search: <><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" /><path d=\"m16 16 4.5 4.5\" /></>,\n+  pin: <><path d=\"m9 3 9 3-3 4 1 5-5-1-4 3-3-9 5 1Z\" /><path d=\"m11 14-7 7\" /></>,\n+  tag: <><path d=\"M3 3h8l10 10-8 8L3 11V3Z\" /><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" /></>,\n+  arrow: <path d=\"M4 12h16m-6-6 6 6-6 6\" />,\n+  back: <path d=\"M20 12H4m6-6-6 6 6 6\" />,\n+  chevron: <path d=\"m9 5 7 7-7 7\" />,\n+  down: <path d=\"m6 9 6 6 6-6\" />,\n+  close: <path d=\"m6 6 12 12M6 18 18 6\" />,\n+  user: <><circle cx=\"12\" cy=\"8\" r=\"4\" /><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\" /></>,\n+  globe: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a19 19 0 0 1 0 18 19 19 0 0 1 0-18\" /></>,\n+  edit: <><path d=\"m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-4-4L5 15l-1 5Z\" /><path d=\"M13 20h8\" /></>,\n+  trash: <><path d=\"M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7\" /></>,\n+  check: <path d=\"m5 12 4 4L19 6\" />,\n+  logout: <><path d=\"M9 4H4v16h5M10 12h11m-4-4 4 4-4 4\" /></>,\n+  menu: <path d=\"M4 6h16M4 12h16M4 18h16\" />,\n+  sparkle: <><path d=\"m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z\" /><path d=\"m20 2 .5 1.5L22 4l-1.5.5L20 6l-.5-1.5L18 4l1.5-.5L20 2Z\" /></>,\n+  grid: <><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\" /></>,\n+  list: <><path d=\"M9 5h12M9 12h12M9 19h12M3 5h1M3 12h1M3 19h1\" /></>,\n+  clock: <><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 7v5l3 2\" /></>,\n+};\n+\n+export default function Icon({ name, className = \"size-5\", ...props }: SVGProps<SVGSVGElement> & { name: keyof typeof paths }) {\n+  return <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className={className} aria-hidden=\"true\" {...props}>{paths[name]}</svg>;\n+}\n","additions":30,"deletions":0},{"filePath":"/workspace/frontend/src/Modal.tsx","relativePath":"frontend/src/Modal.tsx","type":"add","patch":"Index: /workspace/frontend/src/Modal.tsx\n===================================================================\n--- /workspace/frontend/src/Modal.tsx\n+++ /workspace/frontend/src/Modal.tsx\n@@ -0,0 +1,27 @@\n+import { useEffect, useRef } from \"react\";\n+import type { ReactNode } from \"react\";\n+import Icon from \"./Icons\";\n+\n+export default function Modal({ title, children, onClose, busy = false }: { title: string; children: ReactNode; onClose: () => void; busy?: boolean }) {\n+  const ref = useRef<HTMLDialogElement>(null);\n+\n+  useEffect(() => {\n+    const dialog = ref.current;\n+    dialog?.showModal();\n+    const original = document.body.style.overflow;\n+    document.body.style.overflow = \"hidden\";\n+    return () => {\n+      dialog?.close();\n+      document.body.style.overflow = original;\n+    };\n+  }, []);\n+\n+  return (\n+    <dialog ref={ref} aria-label={title} onCancel={event => { event.preventDefault(); if (!busy) onClose(); }} onClick={event => { if (event.target === event.currentTarget && !busy) onClose(); }} className=\"fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-paper p-0 text-ink shadow-2xl\">\n+      <div className=\"relative p-7 sm:p-9\">\n+        <button type=\"button\" aria-label=\"Close dialog\" onClick={onClose} disabled={busy} className=\"absolute right-4 top-4 rounded-full p-2 text-muted transition hover:bg-leaf hover:text-ink\"><Icon name=\"close\" className=\"size-4\" /></button>\n+        {children}\n+      </div>\n+    </dialog>\n+  );\n+}\n","additions":27,"deletions":0},{"filePath":"/workspace/frontend/src/AuthModal.tsx","relativePath":"frontend/src/AuthModal.tsx","type":"add","patch":"Index: /workspace/frontend/src/AuthModal.tsx\n===================================================================\n--- /workspace/frontend/src/AuthModal.tsx\n+++ /workspace/frontend/src/AuthModal.tsx\n@@ -0,0 +1,57 @@\n+import { useState } from \"react\";\n+import type { FormEvent } from \"react\";\n+import { api, ApiError } from \"./api\";\n+import type { FieldErrors, Session } from \"./api\";\n+import Icon from \"./Icons\";\n+import Modal from \"./Modal\";\n+\n+export default function AuthModal({ initialMode, onClose, onSuccess }: { initialMode: \"login\" | \"register\"; onClose: () => void; onSuccess: (session: Session) => void }) {\n+  const [mode, setMode] = useState(initialMode);\n+  const [username, setUsername] = useState(\"\");\n+  const [password, setPassword] = useState(\"\");\n+  const [busy, setBusy] = useState(false);\n+  const [message, setMessage] = useState(\"\");\n+  const [errors, setErrors] = useState<FieldErrors>({});\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setMessage(\"\");\n+    setErrors({});\n+    try {\n+      const body = { username, password };\n+      if (mode === \"register\") await api(\"/auth/register\", { method: \"POST\", body });\n+      const session = await api<Session>(\"/auth/login\", { method: \"POST\", body });\n+      onSuccess(session);\n+    } catch (error) {\n+      setMessage(error instanceof Error ? error.message : \"Please try again.\");\n+      if (error instanceof ApiError) setErrors(error.errors);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <Modal title={mode === \"login\" ? \"Sign in\" : \"Create an account\"} onClose={onClose} busy={busy}>\n+      <div className=\"mb-6 flex size-12 items-center justify-center rounded-xl bg-leaf\"><Icon name=\"book\" className=\"size-6\" /></div>\n+      <p className=\"mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted\">Your thoughts belong here</p>\n+      <h2 className=\"font-serif text-3xl\">{mode === \"login\" ? \"Welcome back.\" : \"Make a little space.\"}</h2>\n+      <p className=\"mt-3 text-sm leading-6 text-muted\">{mode === \"login\" ? \"Sign in to pick up where you left off.\" : \"Create an account to write, tag, and share your notes.\"}</p>\n+      <form onSubmit={submit} className=\"mt-7 space-y-5\" noValidate>\n+        <div>\n+          <label htmlFor=\"username\" className=\"mb-2 block text-sm font-medium\">Username</label>\n+          <input id=\"username\" name=\"username\" autoFocus autoComplete=\"username\" value={username} onChange={event => setUsername(event.target.value)} disabled={busy} placeholder=\"Your username\" aria-invalid={!!errors.username} aria-describedby={errors.username ? \"username-error\" : undefined} className={`w-full rounded-lg border bg-white px-3.5 py-3 text-sm focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10 ${errors.username ? \"border-red-400\" : \"border-line\"}`} />\n+          {errors.username && <p id=\"username-error\" className=\"mt-1.5 text-xs text-red-700\">{errors.username}</p>}\n+        </div>\n+        <div>\n+          <label htmlFor=\"password\" className=\"mb-2 block text-sm font-medium\">Password</label>\n+          <input id=\"password\" name=\"password\" type=\"password\" autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"} value={password} onChange={event => setPassword(event.target.value)} disabled={busy} placeholder={mode === \"register\" ? \"At least 8 characters\" : \"Your password\"} aria-invalid={!!errors.password} aria-describedby={errors.password ? \"password-error\" : undefined} className={`w-full rounded-lg border bg-white px-3.5 py-3 text-sm focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10 ${errors.password ? \"border-red-400\" : \"border-line\"}`} />\n+          {errors.password && <p id=\"password-error\" className=\"mt-1.5 text-xs text-red-700\">{errors.password}</p>}\n+        </div>\n+        {message && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{message}</p>}\n+        <button disabled={busy} className=\"flex w-full items-center justify-center gap-2 rounded-lg bg-moss py-3 text-sm font-medium text-white transition hover:bg-ink\">{busy ? \"One moment…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}<Icon name=\"arrow\" className=\"size-4\" /></button>\n+      </form>\n+      <p className=\"mt-6 text-center text-xs text-muted\">{mode === \"login\" ? \"A new page? \" : \"Already have an account? \"}<button type=\"button\" disabled={busy} onClick={() => { setMode(mode === \"login\" ? \"register\" : \"login\"); setErrors({}); setMessage(\"\"); }} className=\"font-medium text-moss underline decoration-moss/30 underline-offset-4\">{mode === \"login\" ? \"Create an account\" : \"Sign in\"}</button></p>\n+    </Modal>\n+  );\n+}\n","additions":57,"deletions":0},{"filePath":"/workspace/frontend/src/NoteEditor.tsx","relativePath":"frontend/src/NoteEditor.tsx","type":"add","patch":"Index: /workspace/frontend/src/NoteEditor.tsx\n===================================================================\n--- /workspace/frontend/src/NoteEditor.tsx\n+++ /workspace/frontend/src/NoteEditor.tsx\n@@ -0,0 +1,94 @@\n+import { useState } from \"react\";\n+import type { FormEvent, KeyboardEvent } from \"react\";\n+import { api, ApiError } from \"./api\";\n+import type { FieldErrors, Note, Session } from \"./api\";\n+import Icon from \"./Icons\";\n+\n+export default function NoteEditor({ note, session, onSave, onCancel }: { note?: Note; session: Session; onSave: (note: Note) => void; onCancel: () => void }) {\n+  const [title, setTitle] = useState(note?.title ?? \"\");\n+  const [content, setContent] = useState(note?.content ?? \"\");\n+  const [tags, setTags] = useState<string[]>(note?.tags ?? []);\n+  const [tagInput, setTagInput] = useState(\"\");\n+  const [pinned, setPinned] = useState(note?.pinned ?? false);\n+  const [busy, setBusy] = useState(false);\n+  const [errors, setErrors] = useState<FieldErrors>({});\n+  const [message, setMessage] = useState(\"\");\n+\n+  function combinedTags() {\n+    return [...new Set([...tags, ...tagInput.split(\",\").map(tag => tag.trim().toLowerCase()).filter(Boolean)])];\n+  }\n+\n+  function addTags() {\n+    setTags(combinedTags());\n+    setTagInput(\"\");\n+  }\n+\n+  function tagKey(event: KeyboardEvent<HTMLInputElement>) {\n+    if (event.key === \"Enter\" || event.key === \",\") {\n+      event.preventDefault();\n+      addTags();\n+    }\n+    if (event.key === \"Backspace\" && !tagInput) setTags(tags.slice(0, -1));\n+  }\n+\n+  async function submit(event: FormEvent) {\n+    event.preventDefault();\n+    setBusy(true);\n+    setErrors({});\n+    setMessage(\"\");\n+    try {\n+      const saved = await api<Note>(note ? `/notes/${note.id}` : \"/notes\", {\n+        method: note ? \"PATCH\" : \"POST\", token: session.token,\n+        body: { title, content, tags: combinedTags(), pinned },\n+      });\n+      onSave(saved);\n+    } catch (error) {\n+      setMessage(error instanceof Error ? error.message : \"Please try again.\");\n+      if (error instanceof ApiError) setErrors(error.errors);\n+    } finally {\n+      setBusy(false);\n+    }\n+  }\n+\n+  return (\n+    <div className=\"mx-auto max-w-3xl\">\n+      <button onClick={onCancel} disabled={busy} className=\"mb-8 flex items-center gap-2 text-xs text-muted transition hover:text-ink\"><Icon name=\"back\" className=\"size-4\" />{note ? \"Back to note\" : \"Back to all notes\"}</button>\n+      <p className=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted\">{note ? \"A little refinement\" : \"A fresh page\"}</p>\n+      <h1 className=\"font-serif text-4xl tracking-tight\">{note ? \"Edit your note.\" : \"What’s on your mind?\"}</h1>\n+      <p className=\"mt-3 text-sm text-muted\">{note ? \"Good thoughts can always grow.\" : \"An idea, a reminder, a small discovery. Keep it here.\"}</p>\n+      <form onSubmit={submit} className=\"mt-8 overflow-hidden rounded-xl border border-line bg-white\" noValidate>\n+        <div className=\"space-y-7 p-6 sm:p-9\">\n+          <div>\n+            <label htmlFor=\"note-title\" className=\"mb-2 block text-xs font-semibold\">Title <span className=\"font-normal text-muted\">(required)</span></label>\n+            <input id=\"note-title\" autoFocus placeholder=\"Give your thought a title…\" value={title} onChange={event => setTitle(event.target.value)} disabled={busy} aria-invalid={!!errors.title} aria-describedby={errors.title ? \"title-error\" : undefined} className=\"w-full border-b border-line bg-transparent pb-3 font-serif text-2xl placeholder:text-muted/50 focus:border-moss focus:outline-none\" />\n+            {errors.title && <p id=\"title-error\" className=\"mt-2 text-xs text-red-700\">{errors.title}</p>}\n+          </div>\n+          <div>\n+            <label htmlFor=\"note-content\" className=\"mb-3 block text-xs font-semibold\">Your note</label>\n+            <textarea id=\"note-content\" rows={11} placeholder=\"Start writing. There’s no right way to begin.\" value={content} onChange={event => setContent(event.target.value)} disabled={busy} aria-invalid={!!errors.content} aria-describedby={errors.content ? \"content-error\" : undefined} className=\"min-h-60 w-full resize-y rounded-lg border border-line bg-paper/50 p-4 text-sm leading-7 placeholder:text-muted/65 focus:border-moss focus:outline-none focus:ring-2 focus:ring-moss/10\" />\n+            {errors.content && <p id=\"content-error\" className=\"mt-2 text-xs text-red-700\">{errors.content}</p>}\n+            <p className=\"mt-2 flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"notes\" className=\"size-3\" />Plain text. Just your words, as you wrote them.</p>\n+          </div>\n+          <div>\n+            <label htmlFor=\"note-tags\" className=\"mb-2 block text-xs font-semibold\">Tags <span className=\"font-normal text-muted\">(optional)</span></label>\n+            <div className={`flex min-h-12 flex-wrap items-center gap-2 rounded-lg border p-2 focus-within:border-moss focus-within:ring-2 focus-within:ring-moss/10 ${errors.tags ? \"border-red-400\" : \"border-line\"}`}>\n+              {tags.map(tag => <span key={tag} className=\"flex max-w-full items-center gap-1.5 rounded-md bg-leaf px-2.5 py-1.5 text-xs\"><span className=\"truncate\">#{tag}</span><button type=\"button\" aria-label={`Remove ${tag} tag`} onClick={() => setTags(tags.filter(value => value !== tag))} disabled={busy} className=\"rounded p-0.5 hover:bg-moss/10\"><Icon name=\"close\" className=\"size-3\" /></button></span>)}\n+              <input id=\"note-tags\" placeholder={tags.length ? \"Add another…\" : \"ideas, work, little things…\"} value={tagInput} onChange={event => setTagInput(event.target.value)} onKeyDown={tagKey} onBlur={addTags} disabled={busy} aria-invalid={!!errors.tags} aria-describedby={errors.tags ? \"tags-error\" : \"tags-help\"} className=\"min-w-32 flex-1 bg-transparent px-2 py-1 text-sm placeholder:text-muted/65 focus:outline-none\" />\n+            </div>\n+            {errors.tags && <p id=\"tags-error\" className=\"mt-2 text-xs text-red-700\">{errors.tags}</p>}\n+            <p id=\"tags-help\" className=\"mt-2 text-[11px] text-muted\">Press Enter or use a comma to add a tag. Up to 12 tags, 40 characters each.</p>\n+          </div>\n+          <label className=\"flex cursor-pointer items-center gap-3 rounded-lg bg-paper p-4\">\n+            <input type=\"checkbox\" checked={pinned} onChange={event => setPinned(event.target.checked)} disabled={busy} className=\"size-4 accent-moss\" />\n+            <Icon name=\"pin\" className=\"size-4\" /><span><span className=\"block text-xs font-medium\">Pin this note</span><span className=\"mt-1 block text-[11px] text-muted\">Keep the important things at the top.</span></span>\n+          </label>\n+          {message && <p role=\"alert\" className=\"rounded-lg bg-red-50 p-3 text-sm text-red-700\">{message}{errors.fields && <span className=\"mt-1 block\">{errors.fields}</span>}</p>}\n+        </div>\n+        <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-line bg-paper/50 px-6 py-5 sm:px-9\">\n+          <span className=\"flex items-center gap-1.5 text-[11px] text-muted\"><Icon name=\"globe\" className=\"size-3.5\" />This note will be public.</span>\n+          <div className=\"flex items-center gap-4\"><button type=\"button\" onClick={onCancel} disabled={busy} className=\"text-xs text-muted hover:text-ink\">Cancel</button><button disabled={busy} className=\"flex items-center gap-2 rounded-lg bg-moss px-5 py-3 text-xs font-medium text-white transition hover:bg-ink\">{busy ? \"Saving…\" : note ? \"Save changes\" : \"Publish note\"}<Icon name=\"check\" className=\"size-4\" /></button></div>\n+        </div>\n+      </form>\n+    </div>\n+  );\n+}\n","additions":94,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM frontend/package.json\nM frontend/vite.config.ts\nM frontend/src/main.tsx\nM frontend/index.html\nA frontend/public/favicon.svg\nA frontend/tsconfig.json\nA frontend/eslint.config.js\nA frontend/src/index.css\nA frontend/src/api.ts\nA frontend/src/Icons.tsx\nA frontend/src/Modal.tsx\nA frontend/src/AuthModal.tsx\nA frontend/src/NoteEditor.tsx","time":{"start":1794318805478,"end":1794318805532}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.summary","summary":"**Configuring TypeScript and ESLint**\n\nI'm","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" thinking","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" about","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" using","format":"azure-openai-responses-v1","index":0},{"type":"reasoning.summary","summary":" the","format":"azu