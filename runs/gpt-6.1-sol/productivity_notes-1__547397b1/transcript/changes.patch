+        </div>}
+
+        {!loading && !filtered && data?.total === 0 && <div className="mt-7 grid gap-5 sm:grid-cols-3">{[{ icon: "edit" as const, title: "Catch a thought", copy: "Big ideas or everyday reminders. Just start writing." }, { icon: "tag" as const, title: "Give it a little order", copy: "Add a few tags. Find what matters when you need it." }, { icon: "pin" as const, title: "Keep the good ones close", copy: "Pin your favorites so they never get lost in the pages." }].map(item => <div key={item.title} className="flex items-start gap-3 p-1"><div className="flex size-8 shrink-0 items-center justify-center rounded-lg border border-line bg-white/50 text-moss/65"><Icon name={item.icon} className="size-4" /></div><div><h3 className="text-[11px] font-medium">{item.title}</h3><p className="mt-1 text-[10px] leading-[1.8] text-muted">{item.copy}</p></div></div>)}</div>}
+      </section>
+    </>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..8fc6b26
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,81 @@
+export type Note = {
+  id: number;
+  title: string;
+  content: string;
+  tags: string[];
+  pinned: boolean;
+  created_at: string;
+  updated_at: string;
+  author: string;
+};
+
+export type NotePage = { items: Note[]; total: number; page: number; page_size: number };
+export type Tag = { tag: string; count: number };
+export type Session = { token: string; username: string };
+export type FieldErrors = Record<string, string>;
+export type NoteDraft = Pick<Note, "title" | "content" | "tags" | "pinned">;
+
+export class ApiError extends Error {
+  status: number;
+  errors: FieldErrors;
+
+  constructor(message: string, status: number, errors: FieldErrors = {}) {
+    super(message);
+    this.status = status;
+    this.errors = errors;
+  }
+}
+
+export async function api<T>(path: string, options: { method?: string; body?: unknown; token?: string; signal?: AbortSignal } = {}): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`/api${path}`, {
+      method: options.method ?? "GET",
+      headers: {
+        ...(options.body !== undefined ? { "Content-Type": "application/json" } : {}),
+        ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}),
+      },
+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,
+      signal: options.signal,
+    });
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "AbortError") throw error;
+    throw new ApiError("We couldn’t reach the notebook. Please try again.", 0);
+  }
+  if (response.status === 204) return undefined as T;
+  const data = await response.json().catch(() => ({ error: "Something went wrong. Please try again." }));
+  if (!response.ok) {
+    if (response.status === 401 && options.token) window.dispatchEvent(new Event("session-expired"));
+    throw new ApiError(data.error ?? "Something went wrong. Please try again.", response.status, data.errors);
+  }
+  return data as T;
+}
+
+export function readSession(): Session | null {
+  try {
+    const value = JSON.parse(localStorage.getItem("marginalia-session") ?? "null");
+    return typeof value?.token === "string" && typeof value?.username === "string" ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+export function storeSession(session: Session | null) {
+  try {
+    if (session) localStorage.setItem("marginalia-session", JSON.stringify(session));
+    else localStorage.removeItem("marginalia-session");
+  } catch {
+    return;
+  }
+}
+
+export function dateLabel(date: string) {
+  return new Date(date).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
+}
+
+export function relativeDate(date: string) {
+  const days = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);
+  if (days === 0) return "Today";
+  if (days === 1) return "Yesterday";
+  return new Date(date).toLocaleDateString(undefined, { month: "short", day: "numeric" });
+}
