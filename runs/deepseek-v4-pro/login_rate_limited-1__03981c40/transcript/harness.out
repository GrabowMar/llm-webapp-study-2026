{"type":"tool_use","timestamp":1794340263408,"sessionID":"ses_e3900b81affeKKr7RVC6CbZhl7","part":{"type":"tool","tool":"write","callID":"call_nv760i8axzk4h2llvki5zgje","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Account service with sign-in lockout and rate limiting.\"\"\"\n\nimport os\nimport sqlite3\nimport threading\nimport time\nfrom collections import defaultdict, deque\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request\nfrom itsdangerous import BadSignature, SignatureExpired, URLSafeTimedSerializer\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", Path.cwd() / \"data\"))\nLOCKOUT_SECONDS = 15 * 60\nMAX_CONSECUTIVE_FAILURES = 5\nRATE_LIMIT = 20\nRATE_WINDOW_SECONDS = 60\nTOKEN_MAX_AGE = 60 * 60 * 24 * 30\n\napp = Flask(__name__, static_folder=None)\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\n\ndef _iso(epoch):\n    if epoch is None:\n        return None\n    return datetime.fromtimestamp(epoch, tz=timezone.utc).isoformat()\n\n\n# ---------------------------------------------------------------------------\n# Persistence\n# ---------------------------------------------------------------------------\n\ndef _secret_key():\n    key_file = DATA_DIR / \"secret_key\"\n    if key_file.exists():\n        return key_file.read_text().strip()\n    key = os.urandom(32).hex()\n    key_file.write_text(key)\n    return key\n\n\nserializer = URLSafeTimedSerializer(_secret_key(), salt=\"auth-service\")\n\n_SCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT UNIQUE NOT NULL,\n    password_hash TEXT NOT NULL,\n    failed_attempts INTEGER NOT NULL DEFAULT 0,\n    locked_until REAL,\n    created_at REAL NOT NULL,\n    last_login_at REAL\n);\n\nCREATE TABLE IF NOT EXISTS login_attempts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL,\n    at REAL NOT NULL,\n    success INTEGER NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users (id)\n);\n\nCREATE INDEX IF NOT EXISTS idx_attempts_user ON login_attempts (user_id, id);\n\"\"\"\n\n\ndef _connect():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DATA_DIR / \"app.db\")\n    conn.row_factory = sqlite3.Row\n    return conn\n\n\ndef init_db():\n    conn = _connect()\n    conn.executescript(_SCHEMA)\n    admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n    if admin_password:\n        conn.execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, created_at)\n            VALUES (?, ?, ?)\n            ON CONFLICT(username) DO UPDATE SET password_hash = excluded.password_hash\n            \"\"\",\n            (\"admin\", generate_password_hash(admin_password), time.time()),\n        )\n    conn.commit()\n    conn.close()\n\n\ndef get_db():\n    if \"db\" not in g:\n        g.db = _connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\n# ---------------------------------------------------------------------------\n# Client rate limiting (in-memory)\n# ---------------------------------------------------------------------------\n\n_rate_lock = threading.Lock()\n_rate_buckets = defaultdict(deque)\n\n\ndef _rate_limit_status(client_id):\n    now = time.time()\n    with _rate_lock:\n        bucket = _rate_buckets[client_id]\n        while bucket and bucket[0] <= now - RATE_WINDOW_SECONDS:\n            bucket.popleft()\n        if len(bucket) >= RATE_LIMIT:\n            return max(1, int((bucket[0] + RATE_WINDOW_SECONDS - now) + 0.999999))\n        return None\n\n\ndef _record_rate_limit(client_id):\n    with _rate_lock:\n        _rate_buckets[client_id].append(time.time())\n\n\ndef _client_id():\n    return request.headers.get(\"X-Forwarded-For\", request.remote_addr or \"unknown\")\n\n\n# ---------------------------------------------------------------------------\n# Auth helpers\n# ---------------------------------------------------------------------------\n\ndef _current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    try:\n        data = serializer.loads(token, max_age=TOKEN_MAX_AGE)\n    except (BadSignature, SignatureExpired):\n        return None\n    uid = data.get(\"uid\")\n    if uid is None:\n        return None\n    return get_db().execute(\"SELECT * FROM users WHERE id = ?\", (uid,)).fetchone()\n\n\ndef _require_user():\n    user = _current_user()\n    if user is None:\n        return None\n    return user\n\n\ndef _json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef _record_attempt(db, user_id, success):\n    db.execute(\n        \"INSERT INTO login_attempts (user_id, at, success) VALUES (?, ?, ?)\",\n        (user_id, time.time(), 1 if success else 0),\n    )\n\n\ndef _retry_after_response(seconds):\n    resp = jsonify({\"error\": \"too_many_attempts\"})\n    resp.status_code = 429\n    resp.headers[\"Retry-After\"] = str(int(seconds))\n    return resp\n\n\n# ---------------------------------------------------------------------------\n# Routes\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _json_body()\n    if data is None:\n        return jsonify({\"error\": \"invalid_json\"}), 400\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username or not password:\n        return jsonify({\"error\": \"username_and_password_required\"}), 400\n    if username == \"admin\":\n        return jsonify({\"error\": \"username_taken\"}), 409\n\n    db = get_db()\n    existing = db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone()\n    if existing:\n        return jsonify({\"error\": \"username_taken\"}), 409\n\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), time.time()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _json_body()\n    if data is None:\n        return jsonify({\"error\": \"invalid_json\"}), 400\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username or not password:\n        return jsonify({\"error\": \"username_and_password_required\"}), 400\n\n    client_id = _client_id()\n    wait = _rate_limit_status(client_id)\n    if wait is not None:\n        return _retry_after_response(wait)\n    _record_rate_limit(client_id)\n\n    db = get_db()\n    now = time.time()\n    user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n\n    if user is None:\n        return jsonify({\"error\": \"invalid_credentials\"}), 401\n\n    locked_until = user[\"locked_until\"]\n    if locked_until is not None and locked_until > now:\n        _record_attempt(db, user[\"id\"], False)\n        db.commit()\n        return _retry_after_response(locked_until - now)\n\n    if locked_until is not None:\n        db.execute(\n            \"UPDATE users SET locked_until = NULL, failed_attempts = 0 WHERE id = ?\",\n            (user[\"id\"],),\n        )\n        db.commit()\n        user = db.execute(\"SELECT * FROM users WHERE id = ?\", (user[\"id\"],)).fetchone()\n\n    admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n    if username == \"admin\" and not admin_password:\n        _record_attempt(db, user[\"id\"], False)\n        db.commit()\n        return jsonify({\"error\": \"invalid_credentials\"}), 401\n\n    if check_password_hash(user[\"password_hash\"], password):\n        db.execute(\n            \"UPDATE users SET failed_attempts = 0, locked_until = NULL, last_login_at = ? WHERE id = ?\",\n            (now, user[\"id\"]),\n        )\n        _record_attempt(db, user[\"id\"], True)\n        db.commit()\n        token = serializer.dumps({\"uid\": user[\"id\"]})\n        return jsonify({\"token\": token}), 200\n\n    failures = user[\"failed_attempts\"] + 1\n    new_locked_until = None\n    if failures >= MAX_CONSECUTIVE_FAILURES:\n        new_locked_until = now + LOCKOUT_SECONDS\n    db.execute(\n        \"UPDATE users SET failed_attempts = ?, locked_until = ? WHERE id = ?\",\n        (failures, new_locked_until, user[\"id\"]),\n    )\n    _record_attempt(db, user[\"id\"], False)\n    db.commit()\n    return jsonify({\"error\": \"invalid_credentials\"}), 401\n\n\n@app.get(\"/api/me\")\ndef me():\n    user = _require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    return jsonify(\n        {\n            \"id\": user[\"id\"],\n            \"username\": user[\"username\"],\n            \"last_login_at\": _iso(user[\"last_login_at\"]),\n        }\n    )\n\n\n@app.get(\"/api/me/login-attempts\")\ndef login_attempts():\n    user = _require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    rows = get_db().execute(\n        \"SELECT at, success FROM login_attempts WHERE user_id = ? ORDER BY id DESC LIMIT 20\",\n        (user[\"id\"],),\n    ).fetchall()\n    items = [\n        {\"at\": _iso(row[\"at\"]), \"success\": bool(row[\"success\"])} for row in rows\n    ]\n    return jsonify({\"items\": items})\n\n\ndef _require_admin():\n    user = _require_user()\n    if user is None or user[\"username\"] != \"admin\":\n        return None\n    return user\n\n\n@app.get(\"/api/admin/locks\")\ndef admin_locks():\n    admin = _require_admin()\n    if admin is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    now = time.time()\n    rows = get_db().execute(\n        \"SELECT username, locked_until FROM users WHERE locked_until > ? ORDER BY username\",\n        (now,),\n    ).fetchall()\n    items = [\n        {\"username\": row[\"username\"], \"locked_until\": _iso(row[\"locked_until\"])}\n        for row in rows\n    ]\n    return jsonify({\"items\": items})\n\n\n@app.post(\"/api/admin/locks/<username>/unlock\")\ndef admin_unlock(username):\n    admin = _require_admin()\n    if admin is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    db = get_db()\n    cur = db.execute(\n        \"UPDATE users SET locked_until = NULL, failed_attempts = 0 WHERE username = ?\",\n        (username,),\n    )\n    if cur.rowcount == 0:\n        return jsonify({\"error\": \"not_found\"}), 404\n    db.commit()\n    return jsonify({\"unlocked\": username})\n\n\n# ---------------------------------------------------------------------------\n# Frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    from flask import send_from_directory\n\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794340263370,"end":1794340263389}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c70395c3001oDrwh5vTNztlHG","sessionID":"ses_e3900b81affeKKr7RVC6CbZhl7","messageID":"msg_1c70226b7001b1Yn1MzVYJ5ayB"}}
