{"type":"tool_use","timestamp":1794350797439,"sessionID":"ses_e385e4d12ffeiHsNMk6NgnXuXd","part":{"type":"tool","tool":"write","callID":"call_wuql1aasmi9vi9fipjik8xc8","state":{"status":"completed","input":{"content":"import { getToken } from \"./auth\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport async function api<T>(\n  path: string,\n  options: RequestInit = {},\n): Promise<T> {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  const token = getToken();\n  if (token) {\n    headers.Authorization = `Bearer ${token}`;\n  }\n\n  const res = await fetch(`/api${path}`, { ...options, headers });\n\n  if (res.status === 401 && token) {\n    const { clearSession } = await import(\"./auth\");\n    clearSession();\n    window.location.href = \"/\";\n    throw new ApiError(401, \"Session expired\");\n  }\n\n  if (!res.ok) {\n    let message = `Request failed (${res.status})`;\n    try {\n      const data = await res.json();\n      if (data && data.error) message = data.error;\n    } catch {\n      // ignore\n    }\n    throw new ApiError(res.status, message);\n  }\n\n  if (res.status === 204) {\n    return undefined as T;\n  }\n\n  return (await res.json()) as T;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794350797410,"end":1794350797418}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7a4525a001WmNrl4Q1N34QIp","sessionID":"ses_e385e4d12ffeiHsNMk6NgnXuXd","messageID":"msg_1c7a43d35001i71Z7InxLJ7qXu"}}
