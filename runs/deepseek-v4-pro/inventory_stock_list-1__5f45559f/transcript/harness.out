{"type":"tool_use","timestamp":1794350722256,"sessionID":"ses_e385e4d12ffeiHsNMk6NgnXuXd","part":{"type":"tool","tool":"write","callID":"call_cv4vyqcd4p61u9pdbapwr6lb","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Warehouse inventory API and frontend host.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime\nfrom datetime import timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", Path(__file__).resolve().parent.parent / \"data\"))\nDATA_DIR.mkdir(parents=True, exist_ok=True)\nDB_PATH = DATA_DIR / \"inventory.db\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT UNIQUE NOT NULL,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    sku TEXT UNIQUE NOT NULL,\n    location TEXT NOT NULL DEFAULT '',\n    quantity INTEGER NOT NULL DEFAULT 0,\n    reorder_level INTEGER NOT NULL DEFAULT 0\n);\nCREATE TABLE IF NOT EXISTS movements (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    item_id INTEGER NOT NULL,\n    user_id INTEGER NOT NULL,\n    delta INTEGER NOT NULL,\n    reason TEXT NOT NULL DEFAULT '',\n    quantity_after INTEGER NOT NULL,\n    created_at TEXT NOT NULL\n);\n\"\"\"\n\n\ndef get_db():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(SCHEMA)\n    db.commit()\n    db.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef auth_error(message=\"Authentication required\", status=401):\n    return jsonify({\"error\": message}), status\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM sessions s JOIN users u ON u.id = s.user_id \"\n        \"WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return auth_error()\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef item_to_dict(row):\n    quantity = row[\"quantity\"]\n    reorder = row[\"reorder_level\"]\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"sku\": row[\"sku\"],\n        \"location\": row[\"location\"],\n        \"quantity\": quantity,\n        \"reorder_level\": reorder,\n        \"low_stock\": quantity <= reorder,\n    }\n\n\ndef movement_to_dict(row):\n    return {\n        \"id\": row[\"id\"],\n        \"item_id\": row[\"item_id\"],\n        \"delta\": row[\"delta\"],\n        \"reason\": row[\"reason\"],\n        \"quantity_after\": row[\"quantity_after\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": row[\"username\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username:\n        return jsonify({\"error\": \"Username is required\"}), 400\n    if not password:\n        return jsonify({\"error\": \"Password is required\"}), 400\n    db = get_db()\n    exists = db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone()\n    if exists:\n        return jsonify({\"error\": \"Username already taken\"}), 409\n    db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"Invalid username or password\"}), 401\n    token = secrets.token_hex(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/items\")\ndef list_items():\n    db = get_db()\n    conditions = []\n    params = []\n\n    q = (request.args.get(\"q\") or \"\").strip()\n    if q:\n        conditions.append(\"(name LIKE ? OR sku LIKE ?)\")\n        params += [f\"%{q}%\", f\"%{q}%\"]\n\n    location = (request.args.get(\"location\") or \"\").strip()\n    if location:\n        conditions.append(\"location = ?\")\n        params.append(location)\n\n    low_stock = request.args.get(\"low_stock\")\n    if low_stock in (\"true\", \"1\", \"yes\"):\n        conditions.append(\"quantity <= reorder_level\")\n\n    where = (\"WHERE \" + \" AND \".join(conditions)) if conditions else \"\"\n\n    total = db.execute(f\"SELECT COUNT(*) AS c FROM items {where}\", params).fetchone()[\"c\"]\n\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 20))\n    except (TypeError, ValueError):\n        page_size = 20\n    page_size = max(1, min(page_size, 100))\n\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"SELECT * FROM items {where} ORDER BY name COLLATE NOCASE, id LIMIT ? OFFSET ?\",\n        params + [page_size, offset],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [item_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\ndef validate_item(data, db, item_id=None):\n    errors = []\n    name = (data.get(\"name\") or \"\").strip()\n    sku = (data.get(\"sku\") or \"\").strip()\n    if not name:\n        errors.append(\"Name is required\")\n    if not sku:\n        errors.append(\"SKU is required\")\n    if sku:\n        row = db.execute(\n            \"SELECT id FROM items WHERE sku = ? AND id != ?\",\n            (sku, item_id or -1),\n        ).fetchone()\n        if row:\n            errors.append(\"SKU already exists\")\n\n    location = (data.get(\"location\") or \"\").strip()\n    return name, sku, location, errors\n\n\n@app.post(\"/api/items\")\n@login_required\ndef create_item():\n    data = body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n    db = get_db()\n    name, sku, location, errors = validate_item(data, db)\n    quantity = data.get(\"quantity\", 0)\n    reorder_level = data.get(\"reorder_level\", 0)\n\n    try:\n        quantity = int(quantity)\n    except (TypeError, ValueError):\n        errors.append(\"Quantity must be an integer\")\n    try:\n        reorder_level = int(reorder_level)\n    except (TypeError, ValueError):\n        errors.append(\"Reorder level must be an integer\")\n\n    if errors:\n        return jsonify({\"error\": \"; \".join(errors)}), 400\n    if quantity < 0:\n        return jsonify({\"error\": \"Quantity cannot be negative\"}), 400\n    if reorder_level < 0:\n        return jsonify({\"error\": \"Reorder level cannot be negative\"}), 400\n\n    cur = db.execute(\n        \"INSERT INTO items (name, sku, location, quantity, reorder_level) VALUES (?, ?, ?, ?, ?)\",\n        (name, sku, location, quantity, reorder_level),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM items WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(item_to_dict(row)), 201\n\n\n@app.get(\"/api/items/<int:item_id>\")\ndef get_item(item_id):\n    row = get_db().execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Item not found\"}), 404\n    return jsonify(item_to_dict(row))\n\n\n@app.put(\"/api/items/<int:item_id>\")\n@login_required\ndef update_item(item_id):\n    data = body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n    db = get_db()\n    existing = db.execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n    if existing is None:\n        return jsonify({\"error\": \"Item not found\"}), 404\n\n    name, sku, location, errors = validate_item(data, db, item_id=item_id)\n    try:\n        reorder_level = int(data.get(\"reorder_level\", 0))\n    except (TypeError, ValueError):\n        errors.append(\"Reorder level must be an integer\")\n\n    if errors:\n        return jsonify({\"error\": \"; \".join(errors)}), 400\n    if reorder_level < 0:\n        return jsonify({\"error\": \"Reorder level cannot be negative\"}), 400\n\n    db.execute(\n        \"UPDATE items SET name = ?, sku = ?, location = ?, reorder_level = ? WHERE id = ?\",\n        (name, sku, location, reorder_level, item_id),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n    return jsonify(item_to_dict(row))\n\n\n@app.delete(\"/api/items/<int:item_id>\")\n@login_required\ndef delete_item(item_id):\n    db = get_db()\n    existing = db.execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n    if existing is None:\n        return jsonify({\"error\": \"Item not found\"}), 404\n    db.execute(\"DELETE FROM movements WHERE item_id = ?\", (item_id,))\n    db.execute(\"DELETE FROM items WHERE id = ?\", (item_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/items/<int:item_id>/movements\")\ndef list_movements(item_id):\n    db = get_db()\n    existing = db.execute(\"SELECT id FROM items WHERE id = ?\", (item_id,)).fetchone()\n    if existing is None:\n        return jsonify({\"error\": \"Item not found\"}), 404\n    rows = db.execute(\n        \"SELECT m.*, u.username FROM movements m JOIN users u ON u.id = m.user_id \"\n        \"WHERE m.item_id = ? ORDER BY m.id DESC\",\n        (item_id,),\n    ).fetchall()\n    return jsonify({\"items\": [movement_to_dict(r) for r in rows]})\n\n\n@app.post(\"/api/items/<int:item_id>/movements\")\n@login_required\ndef create_movement(item_id):\n    data = body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n    db = get_db()\n    existing = db.execute(\"SELECT * FROM items WHERE id = ?\", (item_id,)).fetchone()\n    if existing is None:\n        return jsonify({\"error\": \"Item not found\"}), 404\n\n    try:\n        delta = int(data.get(\"delta\"))\n    except (TypeError, ValueError):\n        return jsonify({\"error\": \"Delta must be an integer\"}), 400\n    if delta == 0:\n        return jsonify({\"error\": \"Delta cannot be zero\"}), 400\n\n    reason = (data.get(\"reason\") or \"\").strip()\n    quantity_after = existing[\"quantity\"] + delta\n    if quantity_after < 0:\n        return jsonify({\"error\": \"Not enough stock\"}), 400\n\n    cur = db.execute(\n        \"INSERT INTO movements (item_id, user_id, delta, reason, quantity_after, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?)\",\n        (item_id, g.user[\"id\"], delta, reason, quantity_after, now_iso()),\n    )\n    db.execute(\"UPDATE items SET quantity = ? WHERE id = ?\", (quantity_after, item_id))\n    db.commit()\n\n    row = db.execute(\n        \"SELECT m.*, u.username FROM movements m JOIN users u ON u.id = m.user_id \"\n        \"WHERE m.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(movement_to_dict(row)), 201\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794350722219,"end":1794350722236}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7a32ca40016fYjmpMyKjiaxD","sessionID":"ses_e385e4d12ffeiHsNMk6NgnXuXd","messageID":"msg_1c7a26f010013H5iAwgAm1BJzO"}}
