{"type":"tool_use","timestamp":1794345638006,"sessionID":"ses_e38adadffffeuJMM0oNg2CGQ4Z","part":{"type":"tool","tool":"write","callID":"call_ep9bte8mgwva8inyo12nr9dn","state":{"status":"completed","input":{"content":"export interface Transfer {\n  id: number;\n  from_username: string;\n  to_username: string;\n  amount: number;\n  memo: string | null;\n  created_at: string;\n  direction: \"in\" | \"out\";\n}\n\nexport interface TransferList {\n  items: Transfer[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Account {\n  username: string;\n  balance: number;\n}\n\nlet token: string | null = localStorage.getItem(\"token\");\n\nexport function getToken(): string | null {\n  return token;\n}\n\nexport function setToken(value: string | null) {\n  token = value;\n  if (value) {\n    localStorage.setItem(\"token\", value);\n  } else {\n    localStorage.removeItem(\"token\");\n  }\n}\n\nasync function api<T>(\n  path: string,\n  options: RequestInit = {}\n): Promise<T> {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string>),\n  };\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(path, { ...options, headers });\n  const data = await res.json().catch(() => ({}));\n  if (!res.ok) {\n    throw new Error(\n      (data && (data.error as string)) || `Request failed (${res.status})`\n    );\n  }\n  return data as T;\n}\n\nexport async function register(\n  username: string,\n  password: string\n): Promise<Account> {\n  return api<Account>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport async function login(username: string, password: string): Promise<void> {\n  const data = await api<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n  setToken(data.token);\n}\n\nexport async function logout(): Promise<void> {\n  await api(\"/api/auth/logout\", { method: \"POST\" });\n  setToken(null);\n}\n\nexport async function getCsrf(): Promise<string> {\n  const data = await api<{ csrf_token: string }>(\"/api/auth/csrf\");\n  return data.csrf_token;\n}\n\nexport async function getAccount(): Promise<Account> {\n  return api<Account>(\"/api/account\");\n}\n\nexport async function createTransfer(payload: {\n  to_username: string;\n  amount: number;\n  memo?: string;\n}): Promise<Transfer> {\n  return api<Transfer>(\"/api/transfers\", {\n    method: \"POST\",\n    body: JSON.stringify(payload),\n  });\n}\n\nexport async function listTransfers(\n  page: number,\n  pageSize: number\n): Promise<TransferList> {\n  return api<TransferList>(\n    `/api/transfers?page=${page}&page_size=${pageSize}`\n  );\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794345637983,"end":1794345637989}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c755985a001g4T2G0C8tanIyS","sessionID":"ses_e38adadffffeuJMM0oNg2CGQ4Z","messageID":"msg_1c7557401001FFiDKK16Eg21K2"}}
