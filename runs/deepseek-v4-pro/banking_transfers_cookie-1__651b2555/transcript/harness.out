{"type":"tool_use","timestamp":1794345598528,"sessionID":"ses_e38adadffffeuJMM0oNg2CGQ4Z","part":{"type":"tool","tool":"write","callID":"call_0qqfeop2m48smi9u0c4eyeci","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Online bank: Flask JSON API plus the built React frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom itsdangerous import BadSignature, URLSafeTimedSerializer\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\nDB_PATH = DATA_DIR / \"bank.sqlite3\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nINITIAL_BALANCE_CENTS = 100_000  # 1000.00\n\nSECRET_KEY = os.environ.get(\"SECRET_KEY\", secrets.token_hex(32))\n# CSRF token serializer is signed with a stable key so tokens survive restart.\nCSRF_SERIALIZER = URLSafeTimedSerializer(SECRET_KEY, salt=\"bank-csrf\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"SECRET_KEY\"] = SECRET_KEY\n\n\n# --------------------------------------------------------------------------- #\n# Database\n# --------------------------------------------------------------------------- #\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            balance_cents INTEGER NOT NULL DEFAULT 100000,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS transfers (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            from_user_id INTEGER NOT NULL REFERENCES users(id),\n            to_user_id INTEGER NOT NULL REFERENCES users(id),\n            amount_cents INTEGER NOT NULL,\n            memo TEXT,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE INDEX IF NOT EXISTS idx_transfers_from ON transfers(from_user_id);\n        CREATE INDEX IF NOT EXISTS idx_transfers_to ON transfers(to_user_id);\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\n# --------------------------------------------------------------------------- #\n# Helpers\n# --------------------------------------------------------------------------- #\ndef parse_amount(value) -> int:\n    \"\"\"Parse a monetary amount into integer cents. Raises ValueError on bad input.\"\"\"\n    if value is None:\n        raise ValueError(\"amount is required\")\n    try:\n        if isinstance(value, bool):\n            raise ValueError(\"invalid amount\")\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"invalid amount\")\n    if not amount.is_finite():\n        raise ValueError(\"invalid amount\")\n    cents = amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    if cents <= 0:\n        raise ValueError(\"amount must be greater than zero\")\n    return int(cents * 100)\n\n\ndef cents_to_number(cents: int) -> float:\n    return round(cents / 100, 2)\n\n\ndef user_to_public(row) -> dict:\n    return {\"username\": row[\"username\"], \"balance\": cents_to_number(row[\"balance_cents\"])}\n\n\ndef transfer_to_dict(row, current_user_id: int) -> dict:\n    incoming = row[\"to_user_id\"] == current_user_id\n    other_username = row[\"from_username\"] if incoming else row[\"to_username\"]\n    return {\n        \"id\": row[\"id\"],\n        \"from_username\": row[\"from_username\"],\n        \"to_username\": row[\"to_username\"],\n        \"amount\": cents_to_number(row[\"amount_cents\"]),\n        \"memo\": row[\"memo\"],\n        \"created_at\": row[\"created_at\"],\n        \"direction\": \"in\" if incoming else \"out\",\n    }\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\n# --------------------------------------------------------------------------- #\n# Auth\n# --------------------------------------------------------------------------- #\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"SELECT u.* FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username:\n        return error(\"username is required\", 400)\n    if not password:\n        return error(\"password is required\", 400)\n\n    db = get_db()\n    exists = db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if exists:\n        return error(\"Username already taken\", 409)\n\n    password_hash = generate_password_hash(password)\n    db.execute(\n        \"INSERT INTO users (username, password_hash, balance_cents, created_at) \"\n        \"VALUES (?, ?, ?, ?)\",\n        (username, password_hash, INITIAL_BALANCE_CENTS, now_iso()),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    return jsonify({\"username\": row[\"username\"], \"balance\": cents_to_number(row[\"balance_cents\"])}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username or not password:\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    row = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    auth = request.headers.get(\"Authorization\", \"\")\n    token = auth[len(\"Bearer \"):].strip()\n    db = get_db()\n    db.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    db.commit()\n    return jsonify({\"status\": \"ok\"}), 200\n\n\n@app.get(\"/api/auth/csrf\")\n@login_required\ndef csrf():\n    token = CSRF_SERIALIZER.dumps({\"uid\": g.user[\"id\"]})\n    return jsonify({\"csrf_token\": token})\n\n\n# --------------------------------------------------------------------------- #\n# Account\n# --------------------------------------------------------------------------- #\n@app.get(\"/api/account\")\n@login_required\ndef account():\n    return jsonify(user_to_public(g.user))\n\n\n# --------------------------------------------------------------------------- #\n# Transfers\n# --------------------------------------------------------------------------- #\n@app.post(\"/api/transfers\")\n@login_required\ndef create_transfer():\n    data = request.get_json(silent=True) or {}\n    to_username = (data.get(\"to_username\") or \"\").strip()\n    memo = data.get(\"memo\") or None\n    if memo is not None:\n        memo = str(memo)\n\n    try:\n        amount_cents = parse_amount(data.get(\"amount\"))\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    if not to_username:\n        return error(\"to_username is required\", 400)\n\n    db = get_db()\n    to_user = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (to_username,)\n    ).fetchone()\n    if to_user is None:\n        return error(\"Recipient not found\", 404)\n\n    from_user = g.user\n    if from_user[\"id\"] == to_user[\"id\"]:\n        return error(\"You cannot send money to yourself\", 400)\n\n    if from_user[\"balance_cents\"] < amount_cents:\n        return error(\"Insufficient balance\", 400)\n\n    created_at = now_iso()\n    with db:  # atomic transaction\n        db.execute(\n            \"UPDATE users SET balance_cents = balance_cents - ? WHERE id = ?\",\n            (amount_cents, from_user[\"id\"]),\n        )\n        db.execute(\n            \"UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?\",\n            (amount_cents, to_user[\"id\"]),\n        )\n        cursor = db.execute(\n            \"INSERT INTO transfers (from_user_id, to_user_id, amount_cents, memo, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (from_user[\"id\"], to_user[\"id\"], amount_cents, memo, created_at),\n        )\n        transfer_id = cursor.lastrowid\n\n    row = db.execute(\n        \"\"\"\n        SELECT t.*, fu.username AS from_username, tu.username AS to_username\n        FROM transfers t\n        JOIN users fu ON fu.id = t.from_user_id\n        JOIN users tu ON tu.id = t.to_user_id\n        WHERE t.id = ?\n        \"\"\",\n        (transfer_id,),\n    ).fetchone()\n    return jsonify(transfer_to_dict(row, from_user[\"id\"])), 201\n\n\ndef _transfer_row(transfer_id: int):\n    db = get_db()\n    return db.execute(\n        \"\"\"\n        SELECT t.*, fu.username AS from_username, tu.username AS to_username\n        FROM transfers t\n        JOIN users fu ON fu.id = t.from_user_id\n        JOIN users tu ON tu.id = t.to_user_id\n        WHERE t.id = ?\n        \"\"\",\n        (transfer_id,),\n    ).fetchone()\n\n\n@app.get(\"/api/transfers\")\n@login_required\ndef list_transfers():\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except ValueError:\n        page = 1\n    try:\n        page_size = max(1, int(request.args.get(\"page_size\", 20)))\n    except ValueError:\n        page_size = 20\n    page_size = min(page_size, 100)\n\n    user_id = g.user[\"id\"]\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM transfers WHERE from_user_id = ? OR to_user_id = ?\",\n        (user_id, user_id),\n    ).fetchone()[0]\n\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        \"\"\"\n        SELECT t.*, fu.username AS from_username, tu.username AS to_username\n        FROM transfers t\n        JOIN users fu ON fu.id = t.from_user_id\n        JOIN users tu ON tu.id = t.to_user_id\n        WHERE t.from_user_id = ? OR t.to_user_id = ?\n        ORDER BY t.id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        (user_id, user_id, page_size, offset),\n    ).fetchall()\n\n    items = [transfer_to_dict(r, user_id) for r in rows]\n    return jsonify(\n        {\n            \"items\": items,\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/transfers/<int:transfer_id>\")\n@login_required\ndef get_transfer(transfer_id: int):\n    user_id = g.user[\"id\"]\n    row = db_execute_single(transfer_id, user_id)\n    if row is None:\n        return error(\"Transfer not found\", 404)\n    return jsonify(transfer_to_dict(row, user_id))\n\n\ndef db_execute_single(transfer_id: int, user_id: int):\n    db = get_db()\n    return db.execute(\n        \"\"\"\n        SELECT t.*, fu.username AS from_username, tu.username AS to_username\n        FROM transfers t\n        JOIN users fu ON fu.id = t.from_user_id\n        JOIN users tu ON tu.id = t.to_user_id\n        WHERE t.id = ? AND (t.from_user_id = ? OR t.to_user_id = ?)\n        \"\"\",\n        (transfer_id, user_id, user_id),\n    ).fetchone()\n\n\n# --------------------------------------------------------------------------- #\n# Health & frontend\n# --------------------------------------------------------------------------- #\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794345598489,"end":1794345598507}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c754fe13001L7R3HwKh4cFlcr","sessionID":"ses_e38adadffffeuJMM0oNg2CGQ4Z","messageID":"msg_1c754245b001TNg9y1IWsxPTL6"}}
