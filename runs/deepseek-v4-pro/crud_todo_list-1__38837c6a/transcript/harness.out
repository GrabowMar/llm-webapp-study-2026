{"type":"tool_use","timestamp":1794318610950,"sessionID":"ses_e3a4b6b3effetosjIkRTOmK673","part":{"type":"tool","tool":"write","callID":"call_xrz7w8hg6jk1l7bdsvekx46p","state":{"status":"completed","input":{"content":"export type Priority = \"low\" | \"medium\" | \"high\";\n\nexport interface Todo {\n  id: number;\n  title: string;\n  description: string;\n  priority: Priority;\n  due_date: string | null;\n  completed: boolean;\n  completed_at: string | null;\n  created_at: string;\n}\n\nexport interface TodoListResponse {\n  items: Todo[];\n  total: number;\n  page: number;\n  page_size: number;\n  remaining: number;\n}\n\nexport interface TodoInput {\n  title?: string;\n  description?: string;\n  priority?: Priority;\n  due_date?: string | null;\n  completed?: boolean;\n}\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nconst TOKEN_KEY = \"todo_token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) {\n    localStorage.setItem(TOKEN_KEY, token);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n  }\n}\n\nasync function request<T>(\n  method: string,\n  path: string,\n  body?: unknown,\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(path, {\n    method,\n    headers,\n    body: body !== undefined ? JSON.stringify(body) : undefined,\n  });\n  if (res.status === 204) {\n    return undefined as T;\n  }\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const message =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, message);\n  }\n  return data as T;\n}\n\nexport function apiRegister(username: string, password: string) {\n  return request<{ id: number; username: string }>(\"POST\", \"/api/auth/register\", {\n    username,\n    password,\n  });\n}\n\nexport function apiLogin(username: string, password: string) {\n  return request<{ token: string }>(\"POST\", \"/api/auth/login\", {\n    username,\n    password,\n  });\n}\n\nexport interface TodoQuery {\n  completed?: boolean;\n  priority?: Priority | \"\";\n  page?: number;\n  pageSize?: number;\n}\n\nexport function apiListTodos(query: TodoQuery = {}) {\n  const params = new URLSearchParams();\n  if (query.completed !== undefined) {\n    params.set(\"completed\", String(query.completed));\n  }\n  if (query.priority) {\n    params.set(\"priority\", query.priority);\n  }\n  if (query.page !== undefined) {\n    params.set(\"page\", String(query.page));\n  }\n  if (query.pageSize !== undefined) {\n    params.set(\"page_size\", String(query.pageSize));\n  }\n  const qs = params.toString();\n  return request<TodoListResponse>(\"GET\", `/api/todos${qs ? `?${qs}` : \"\"}`);\n}\n\nexport function apiCreateTodo(input: TodoInput) {\n  return request<Todo>(\"POST\", \"/api/todos\", input);\n}\n\nexport function apiUpdateTodo(id: number, input: TodoInput) {\n  return request<Todo>(\"PATCH\", `/api/todos/${id}`, input);\n}\n\nexport function apiDeleteTodo(id: number) {\n  return request<void>(\"DELETE\", `/api/todos/${id}`);\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794318610923,"end":1794318610931}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5b931e50013uL53folSCufR3","sessionID":"ses_e3a4b6b3effetosjIkRTOmK673","messageID":"msg_1c5b9017a001jEtqqDeNHX6AT9"}}
