{"type":"tool_use","timestamp":1794318527444,"sessionID":"ses_e3a4b6b3effetosjIkRTOmK673","part":{"type":"tool","tool":"write","callID":"call_0xsoxcbl0qqyedyvzfbmyoq4","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Todo list app: Flask JSON API + SQLite storage + static frontend.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime\nfrom datetime import date\nfrom datetime import timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.sqlite3\"\n\nPRIORITIES = (\"low\", \"medium\", \"high\")\nDEFAULT_PRIORITY = \"medium\"\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\n\ndef get_db():\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            token TEXT UNIQUE\n        );\n\n        CREATE TABLE IF NOT EXISTS todos (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            title TEXT NOT NULL,\n            description TEXT NOT NULL DEFAULT '',\n            priority TEXT NOT NULL DEFAULT 'medium',\n            due_date TEXT,\n            completed INTEGER NOT NULL DEFAULT 0,\n            completed_at TEXT,\n            created_at TEXT NOT NULL\n        );\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef error(message, status):\n    return jsonify({\"error\": message}), status\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT * FROM users WHERE token = ?\", (token,)\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef parse_bool(value):\n    if isinstance(value, bool):\n        return value\n    if value in (True, 1, \"1\", \"true\", \"True\", \"yes\", \"on\"):\n        return True\n    if value in (False, 0, \"0\", \"false\", \"False\", \"no\", \"off\", \"\"):\n        return False\n    return None\n\n\ndef validate_due_date(value):\n    if value is None:\n        return None, None\n    if value == \"\":\n        return None, None\n    if not isinstance(value, str):\n        return None, \"due_date must be a date string (YYYY-MM-DD)\"\n    if not re.fullmatch(r\"\\d{4}-\\d{2}-\\d{2}\", value):\n        return None, \"due_date must be a date string (YYYY-MM-DD)\"\n    try:\n        date.fromisoformat(value)\n    except ValueError:\n        return None, \"due_date must be a valid date (YYYY-MM-DD)\"\n    return value, None\n\n\ndef validate_priority(value):\n    if value is None:\n        return None, None\n    if value not in PRIORITIES:\n        return None, f\"priority must be one of: {', '.join(PRIORITIES)}\"\n    return value, None\n\n\ndef todo_to_dict(row):\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"priority\": row[\"priority\"],\n        \"due_date\": row[\"due_date\"],\n        \"completed\": bool(row[\"completed\"]),\n        \"completed_at\": row[\"completed_at\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef get_todo_or_none(todo_id):\n    return get_db().execute(\n        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\",\n        (todo_id, g.user[\"id\"]),\n    ).fetchone()\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(\"Request body must be a JSON object\", 400)\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n\n    username = username.strip()\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return error(\"Username already taken\", 409)\n\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO users (username, password_hash, token) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), token),\n    )\n    db.commit()\n    return jsonify({\"id\": db.execute(\"SELECT last_insert_rowid() AS id\").fetchone()[\"id\"], \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(\"Request body must be a JSON object\", 400)\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_hex(32)\n    db.execute(\"UPDATE users SET token = ? WHERE id = ?\", (token, row[\"id\"]))\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/todos\")\n@login_required\ndef list_todos():\n    db = get_db()\n    where = [\"user_id = ?\"]\n    params = [g.user[\"id\"]]\n\n    completed = parse_bool(request.args.get(\"completed\"))\n    if completed is not None:\n        where.append(\"completed = ?\")\n        params.append(1 if completed else 0)\n\n    priority = request.args.get(\"priority\")\n    if priority:\n        where.append(\"priority = ?\")\n        params.append(priority)\n\n    where_sql = \" AND \".join(where)\n\n    total = db.execute(\n        f\"SELECT COUNT(*) AS c FROM todos WHERE {where_sql}\", params\n    ).fetchone()[\"c\"]\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    if page < 1:\n        page = 1\n\n    try:\n        page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n    except (TypeError, ValueError):\n        page_size = DEFAULT_PAGE_SIZE\n    if page_size < 1:\n        page_size = 1\n    if page_size > MAX_PAGE_SIZE:\n        page_size = MAX_PAGE_SIZE\n\n    offset = (page - 1) * page_size\n\n    rows = db.execute(\n        f\"\"\"\n        SELECT * FROM todos\n        WHERE {where_sql}\n        ORDER BY completed ASC,\n                 CASE WHEN due_date IS NULL THEN 1 ELSE 0 END ASC,\n                 due_date ASC,\n                 id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        params + [page_size, offset],\n    ).fetchall()\n\n    remaining = max(0, total - page * page_size)\n\n    return jsonify(\n        {\n            \"items\": [todo_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"remaining\": remaining,\n        }\n    )\n\n\n@app.post(\"/api/todos\")\n@login_required\ndef create_todo():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(\"Request body must be a JSON object\", 400)\n\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        return error(\"title is required\", 400)\n    title = title.strip()\n\n    description = data.get(\"description\", \"\")\n    if description is None:\n        description = \"\"\n    if not isinstance(description, str):\n        return error(\"description must be a string\", 400)\n\n    priority = data.get(\"priority\", DEFAULT_PRIORITY)\n    if priority is None or priority == \"\":\n        priority = DEFAULT_PRIORITY\n    priority, err = validate_priority(priority)\n    if err:\n        return error(err, 400)\n\n    due_date, err = validate_due_date(data.get(\"due_date\"))\n    if err:\n        return error(err, 400)\n\n    completed = data.get(\"completed\", False)\n    if not isinstance(completed, bool):\n        return error(\"completed must be a boolean\", 400)\n\n    completed_at = now_iso() if completed else None\n\n    db = get_db()\n    db.execute(\n        \"\"\"\n        INSERT INTO todos\n            (user_id, title, description, priority, due_date, completed, completed_at, created_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            g.user[\"id\"],\n            title,\n            description,\n            priority,\n            due_date,\n            1 if completed else 0,\n            completed_at,\n            now_iso(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM todos WHERE id = last_insert_rowid()\"\n    ).fetchone()\n    return jsonify(todo_to_dict(row)), 201\n\n\n@app.get(\"/api/todos/<int:todo_id>\")\n@login_required\ndef get_todo(todo_id):\n    row = get_todo_or_none(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n    return jsonify(todo_to_dict(row))\n\n\n@app.patch(\"/api/todos/<int:todo_id>\")\n@login_required\ndef update_todo(todo_id):\n    row = get_todo_or_none(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return error(\"Request body must be a JSON object\", 400)\n\n    fields = {}\n    if \"title\" in data:\n        title = data[\"title\"]\n        if not isinstance(title, str) or not title.strip():\n            return error(\"title is required\", 400)\n        fields[\"title\"] = title.strip()\n\n    if \"description\" in data:\n        description = data[\"description\"]\n        if description is None:\n            description = \"\"\n        if not isinstance(description, str):\n            return error(\"description must be a string\", 400)\n        fields[\"description\"] = description\n\n    if \"priority\" in data:\n        priority = data[\"priority\"]\n        if priority is None or priority == \"\":\n            priority = DEFAULT_PRIORITY\n        priority, err = validate_priority(priority)\n        if err:\n            return error(err, 400)\n        fields[\"priority\"] = priority\n\n    if \"due_date\" in data:\n        due_date, err = validate_due_date(data[\"due_date\"])\n        if err:\n            return error(err, 400)\n        fields[\"due_date\"] = due_date\n\n    if \"completed\" in data:\n        completed = data[\"completed\"]\n        if not isinstance(completed, bool):\n            return error(\"completed must be a boolean\", 400)\n        fields[\"completed\"] = 1 if completed else 0\n\n    if not fields:\n        return jsonify(todo_to_dict(row))\n\n    db = get_db()\n    assignments = []\n    values = []\n    for key, value in fields.items():\n        assignments.append(f\"{key} = ?\")\n        values.append(value)\n\n    if \"completed\" in fields:\n        if fields[\"completed\"]:\n            assignments.append(\"completed_at = ?\")\n            values.append(now_iso())\n        else:\n            assignments.append(\"completed_at = ?\")\n            values.append(None)\n\n    values.append(todo_id)\n    values.append(g.user[\"id\"])\n    db.execute(\n        f\"UPDATE todos SET {', '.join(assignments)} WHERE id = ? AND user_id = ?\",\n        values,\n    )\n    db.commit()\n\n    row = get_todo_or_none(todo_id)\n    return jsonify(todo_to_dict(row))\n\n\n@app.delete(\"/api/todos/<int:todo_id>\")\n@login_required\ndef delete_todo(todo_id):\n    row = get_todo_or_none(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n    db = get_db()\n    db.execute(\n        \"DELETE FROM todos WHERE id = ? AND user_id = ?\",\n        (todo_id, g.user[\"id\"]),\n    )\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794318527406,"end":1794318527424}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5b7eba6001vAQ03BJHs4wDSw","sessionID":"ses_e3a4b6b3effetosjIkRTOmK673","messageID":"msg_1c5b70211001Nhh7QwuhDWNTDy"}}
