{"type":"tool_use","timestamp":1794324508031,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"type":"tool","tool":"write","callID":"call_y32wwn1auny42cxdrf50r5bu","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { clearSession, getUsername } from \"./api\";\nimport Auth from \"./Auth\";\nimport AvailabilityPanel from \"./Availability\";\nimport MyReservations from \"./MyReservations\";\nimport AdminPanel from \"./AdminPanel\";\n\nfunction todayISO(): string {\n  const d = new Date();\n  const off = d.getTimezoneOffset();\n  const local = new Date(d.getTime() - off * 60000);\n  return local.toISOString().slice(0, 10);\n}\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(getUsername());\n  const [date, setDate] = useState(todayISO());\n  const [refresh, setRefresh] = useState(0);\n\n  const isAdmin = username === \"admin\";\n\n  if (!username) {\n    return (\n      <div className=\"min-h-screen bg-gray-50\">\n        <header className=\"border-b border-gray-200 bg-white\">\n          <div className=\"mx-auto max-w-5xl px-4 py-4\">\n            <h1 className=\"text-xl font-bold text-gray-900\">\n              Table Reservations\n            </h1>\n          </div>\n        </header>\n        <Auth onSuccess={() => setUsername(getUsername())} />\n      </div>\n    );\n  }\n\n  function bump() {\n    setRefresh((r) => r + 1);\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      <header className=\"border-b border-gray-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between px-4 py-4\">\n          <h1 className=\"text-xl font-bold text-gray-900\">\n            Table Reservations\n          </h1>\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-sm text-gray-700\">\n              Signed in as{\" \"}\n              <span className=\"font-semibold\">{username}</span>\n              {isAdmin && (\n                <span className=\"ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700\">\n                  admin\n                </span>\n              )}\n            </span>\n            <button\n              className=\"rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50\"\n              onClick={() => {\n                clearSession();\n                setUsername(null);\n              }}\n            >\n              Sign out\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-5xl space-y-6 px-4 py-6\">\n        {isAdmin ? (\n          <AdminPanel date={date} refreshTrigger={refresh} />\n        ) : (\n          <div className=\"grid gap-6 lg:grid-cols-2\">\n            <AvailabilityPanel\n              date={date}\n              onDateChange={setDate}\n              onBooked={bump}\n              refreshTrigger={refresh}\n            />\n            <MyReservations refreshTrigger={refresh} onChanged={bump} />\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794324507998,"end":1794324508007}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6132d57001sGMDDFwBge1VmK","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","messageID":"msg_1c6130cb0001eA4liRcDlHty0l"}}
