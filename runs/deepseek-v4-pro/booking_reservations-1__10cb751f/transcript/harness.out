{"type":"step_start","timestamp":1794324436362,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"id":"prt_1c6121579001SnnCO7GDMvWW50","messageID":"msg_1c611d9eb001vSZSDhb1al6Udx","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","type":"step-start"}}
{"type":"tool_use","timestamp":1794324436394,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"type":"tool","tool":"write","callID":"call_vr5deveo49f7s3vn0r48atio","state":{"status":"completed","input":{"content":"import { FormEvent, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  Availability,\n  AvailabilityItem,\n  ReservationInput,\n} from \"./api\";\nimport { Button, Card, ErrorBox, SuccessBox, TextArea, TextInput } from \"./ui\";\n\nexport const SLOT_TIMES = [\n  \"17:00\",\n  \"17:30\",\n  \"18:00\",\n  \"18:30\",\n  \"19:00\",\n  \"19:30\",\n  \"20:00\",\n  \"20:30\",\n  \"21:00\",\n  \"21:30\",\n];\n\nfunction todayISO(): string {\n  const d = new Date();\n  const off = d.getTimezoneOffset();\n  const local = new Date(d.getTime() - off * 60000);\n  return local.toISOString().slice(0, 10);\n}\n\nfunction fullSlotOptions(\n  items: AvailabilityItem[],\n  partySize: number\n): Set<string> {\n  const full = new Set<string>();\n  for (const it of items) {\n    if (it.remaining < partySize) full.add(it.time);\n  }\n  return full;\n}\n\ninterface BookingFormProps {\n  date: string;\n  availability: Availability;\n  initial?: ReservationInput & { id: number };\n  onSaved: () => void;\n  onCancel?: () => void;\n}\n\nfunction BookingForm({\n  date,\n  availability,\n  initial,\n  onSaved,\n  onCancel,\n}: BookingFormProps) {\n  const [name, setName] = useState(initial?.name ?? \"\");\n  const [email, setEmail] = useState(initial?.email ?? \"\");\n  const [time, setTime] = useState(initial?.time ?? SLOT_TIMES[0]);\n  const [partySize, setPartySize] = useState(initial?.party_size ?? 2);\n  const [notes, setNotes] = useState(initial?.notes ?? \"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const full = fullSlotOptions(availability.items, partySize);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    const payload: ReservationInput = {\n      name,\n      email,\n      date,\n      time,\n      party_size: partySize,\n      notes: notes || null,\n    };\n    try {\n      if (initial) {\n        await api.updateReservation(initial.id, payload);\n      } else {\n        await api.createReservation(payload);\n      }\n      if (!initial) {\n        setName(\"\");\n        setEmail(\"\");\n        setNotes(\"\");\n        setTime(SLOT_TIMES[0]);\n        setPartySize(2);\n      }\n      onSaved();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Unexpected error\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4\">\n      <ErrorBox message={error} />\n      <div className=\"grid gap-4 sm:grid-cols-2\">\n        <TextInput\n          label=\"Name\"\n          value={name}\n          onChange={(e) => setName(e.target.value)}\n          required\n        />\n        <TextInput\n          label=\"Email\"\n          type=\"email\"\n          value={email}\n          onChange={(e) => setEmail(e.target.value)}\n          required\n        />\n        <TextInput label=\"Date\" value={date} disabled />\n        <div className=\"grid grid-cols-2 gap-4\">\n          <label className=\"block\">\n            <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n              Time\n            </span>\n            <select\n              className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n              value={time}\n              onChange={(e) => setTime(e.target.value)}\n            >\n              {SLOT_TIMES.map((t) => {\n                const item = availability.items.find((i) => i.time === t);\n                const remaining = item ? item.remaining : 20;\n                return (\n                  <option\n                    key={t}\n                    value={t}\n                    disabled={full.has(t) && t !== initial?.time}\n                  >\n                    {t}\n                    {item\n                      ? ` (${remaining} left)`\n                      : \" (20 left)\"}\n                  </option>\n                );\n              })}\n            </select>\n          </label>\n          <label className=\"block\">\n            <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n              Party size\n            </span>\n            <select\n              className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n              value={partySize}\n              onChange={(e) => setPartySize(Number(e.target.value))}\n            >\n              {Array.from({ length: 20 }, (_, i) => i + 1).map((n) => (\n                <option key={n} value={n}>\n                  {n}\n                </option>\n              ))}\n            </select>\n          </label>\n        </div>\n      </div>\n      <TextArea\n        label=\"Notes\"\n        value={notes}\n        onChange={(e) => setNotes(e.target.value)}\n      />\n      <div className=\"flex gap-2\">\n        <Button type=\"submit\" disabled={busy}>\n          {initial ? \"Save changes\" : \"Book table\"}\n        </Button>\n        {onCancel && (\n          <Button type=\"button\" variant=\"secondary\" onClick={onCancel}>\n            Cancel\n          </Button>\n        )}\n      </div>\n    </form>\n  );\n}\n\nexport default function AvailabilityPanel({\n  date,\n  onDateChange,\n  refreshTrigger,\n}: {\n  date: string;\n  onDateChange: (d: string) => void;\n  refreshTrigger: number;\n}) {\n  const [availability, setAvailability] = useState<Availability | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [message, setMessage] = useState<string | null>(null);\n\n  const [refreshAvailability, refreshReservations] =\n    useState(refreshTrigger);\n  void refreshReservations;\n  void refreshAvailability;\n\n  return null;\n}\n","filePath":"/workspace/frontend/src/Availability.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Availability.tsx","exists":false,"truncated":false},"title":"frontend/src/Availability.tsx","time":{"start":1794324436355,"end":1794324436367}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c612157c001TEkcNiq5PRFrcS","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","messageID":"msg_1c611d9eb001vSZSDhb1al6Udx"}}
