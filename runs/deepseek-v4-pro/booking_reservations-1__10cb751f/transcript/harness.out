{"type":"step_start","timestamp":1794324455668,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"id":"prt_1c61260e80015kf5uxb8oQVghb","messageID":"msg_1c61215a2001EqseGu4KFFb2LZ","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","type":"step-start"}}
{"type":"tool_use","timestamp":1794324455692,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"type":"tool","tool":"write","callID":"call_gmexv3bujkbq5kmzuaclj83w","state":{"status":"completed","input":{"content":"import { FormEvent, useEffect, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  Availability,\n  AvailabilityItem,\n  ReservationInput,\n} from \"./api\";\nimport { Button, Card, ErrorBox, Spinner, SuccessBox, TextArea, TextInput } from \"./ui\";\n\nexport const SLOT_TIMES = [\n  \"17:00\",\n  \"17:30\",\n  \"18:00\",\n  \"18:30\",\n  \"19:00\",\n  \"19:30\",\n  \"20:00\",\n  \"20:30\",\n  \"21:00\",\n  \"21:30\",\n];\n\nfunction todayISO(): string {\n  const d = new Date();\n  const off = d.getTimezoneOffset();\n  const local = new Date(d.getTime() - off * 60000);\n  return local.toISOString().slice(0, 10);\n}\n\nfunction fullSlotOptions(\n  items: AvailabilityItem[],\n  partySize: number\n): Set<string> {\n  const full = new Set<string>();\n  for (const it of items) {\n    if (it.remaining < partySize) full.add(it.time);\n  }\n  return full;\n}\n\nfunction BookingForm({\n  date,\n  availability,\n  initial,\n  onSaved,\n  onCancel,\n}: {\n  date: string;\n  availability: Availability;\n  initial?: ReservationInput & { id: number };\n  onSaved: () => void;\n  onCancel?: () => void;\n}) {\n  const [name, setName] = useState(initial?.name ?? \"\");\n  const [email, setEmail] = useState(initial?.email ?? \"\");\n  const [time, setTime] = useState(initial?.time ?? SLOT_TIMES[0]);\n  const [partySize, setPartySize] = useState(initial?.party_size ?? 2);\n  const [notes, setNotes] = useState(initial?.notes ?? \"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const full = fullSlotOptions(availability.items, partySize);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    const payload: ReservationInput = {\n      name,\n      email,\n      date,\n      time,\n      party_size: partySize,\n      notes: notes || null,\n    };\n    try {\n      if (initial) {\n        await api.updateReservation(initial.id, payload);\n      } else {\n        await api.createReservation(payload);\n      }\n      if (!initial) {\n        setName(\"\");\n        setEmail(\"\");\n        setNotes(\"\");\n        setTime(SLOT_TIMES[0]);\n        setPartySize(2);\n      }\n      onSaved();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Unexpected error\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4\">\n      <ErrorBox message={error} />\n      <div className=\"grid gap-4 sm:grid-cols-2\">\n        <TextInput\n          label=\"Name\"\n          value={name}\n          onChange={(e) => setName(e.target.value)}\n          required\n        />\n        <TextInput\n          label=\"Email\"\n          type=\"email\"\n          value={email}\n          onChange={(e) => setEmail(e.target.value)}\n          required\n        />\n        <TextInput label=\"Date\" value={date} disabled />\n        <div className=\"grid grid-cols-2 gap-4\">\n          <label className=\"block\">\n            <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n              Time\n            </span>\n            <select\n              className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n              value={time}\n              onChange={(e) => setTime(e.target.value)}\n            >\n              {SLOT_TIMES.map((t) => {\n                const item = availability.items.find((i) => i.time === t);\n                const remaining = item ? item.remaining : 20;\n                return (\n                  <option\n                    key={t}\n                    value={t}\n                    disabled={full.has(t) && t !== initial?.time}\n                  >\n                    {t} ({remaining} left)\n                  </option>\n                );\n              })}\n            </select>\n          </label>\n          <label className=\"block\">\n            <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n              Party size\n            </span>\n            <select\n              className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n              value={partySize}\n              onChange={(e) => setPartySize(Number(e.target.value))}\n            >\n              {Array.from({ length: 20 }, (_, i) => i + 1).map((n) => (\n                <option key={n} value={n}>\n                  {n}\n                </option>\n              ))}\n            </select>\n          </label>\n        </div>\n      </div>\n      <TextArea\n        label=\"Notes\"\n        value={notes}\n        onChange={(e) => setNotes(e.target.value)}\n      />\n      <div className=\"flex gap-2\">\n        <Button type=\"submit\" disabled={busy}>\n          {initial ? \"Save changes\" : \"Book table\"}\n        </Button>\n        {onCancel && (\n          <Button type=\"button\" variant=\"secondary\" onClick={onCancel}>\n            Cancel\n          </Button>\n        )}\n      </div>\n    </form>\n  );\n}\n\nexport default function AvailabilityPanel({\n  date,\n  onDateChange,\n  refreshTrigger,\n}: {\n  date: string;\n  onDateChange: (d: string) => void;\n  refreshTrigger: number;\n}) {\n  const [availability, setAvailability] = useState<Availability | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [message, setMessage] = useState<string | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    api\n      .availability(date)\n      .then((data) => {\n        if (!cancelled) setAvailability(data);\n      })\n      .catch((err) => {\n        if (!cancelled)\n          setError(err instanceof ApiError ? err.message : \"Failed to load\");\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [date, refreshTrigger]);\n\n  return (\n    <Card title=\"Availability\">\n      <div className=\"mb-4 flex items-center gap-2\">\n        <label className=\"text-sm font-medium text-gray-700\">Day</label>\n        <input\n          type=\"date\"\n          className=\"rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n          value={date}\n          onChange={(e) => onDateChange(e.target.value || todayISO())}\n        />\n      </div>\n\n      {loading ? (\n        <Spinner />\n      ) : error ? (\n        <ErrorBox message={error} />\n      ) : (\n        availability && (\n          <div className=\"mb-6\">\n            {availability.items.length === 0 ? (\n              <p className=\"text-sm text-gray-500\">\n                No reservations on this day yet. Every slot is fully open.\n              </p>\n            ) : (\n              <div className=\"grid gap-2 sm:grid-cols-2\">\n                {availability.items.map((it) => (\n                  <div\n                    key={it.time}\n                    className=\"flex items-center justify-between rounded-md border border-gray-200 px-3 py-2\"\n                  >\n                    <span className=\"font-medium text-gray-800\">{it.time}</span>\n                    <span className=\"text-sm text-gray-600\">\n                      {it.booked} booked · {it.remaining} left\n                    </span>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        )\n      )}\n\n      <h3 className=\"mb-3 text-sm font-semibold text-gray-800\">\n        Book a table\n      </h3>\n      <SuccessBox message={message} />\n      {availability && (\n        <BookingForm\n          date={date}\n          availability={availability}\n          onSaved={() => {\n            setMessage(\"Reservation confirmed.\");\n            onDateChange(date);\n          }}\n        />\n      )}\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/Availability.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Availability.tsx","exists":true,"truncated":false},"title":"frontend/src/Availability.tsx","time":{"start":1794324455664,"end":1794324455674}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61260eb001GI9POpI06wcLVw","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","messageID":"msg_1c61215a2001EqseGu4KFFb2LZ"}}
