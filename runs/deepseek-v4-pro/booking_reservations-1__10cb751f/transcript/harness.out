{"type":"tool_use","timestamp":1794324403661,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"type":"tool","tool":"write","callID":"call_9hbrlneut29ns327o6iqmta6","state":{"status":"completed","input":{"content":"export interface Reservation {\n  id: number;\n  name: string;\n  email: string;\n  date: string;\n  time: string;\n  party_size: number;\n  notes: string | null;\n  created_at: string;\n}\n\nexport interface ReservationList {\n  items: Reservation[];\n  total: number;\n}\n\nexport interface AvailabilityItem {\n  time: string;\n  booked: number;\n  remaining: number;\n}\n\nexport interface Availability {\n  items: AvailabilityItem[];\n}\n\nexport interface AdminList extends ReservationList {\n  page: number;\n  page_size: number;\n}\n\nconst TOKEN_KEY = \"reservation_token\";\nconst USER_KEY = \"reservation_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USER_KEY, username);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USER_KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nasync function request<T>(\n  method: string,\n  path: string,\n  body?: unknown,\n  auth = true\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (auth && token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  let res: Response;\n  try {\n    res = await fetch(path, {\n      method,\n      headers,\n      body: body !== undefined ? JSON.stringify(body) : undefined,\n    });\n  } catch {\n    throw new ApiError(\"Network error\", 0);\n  }\n\n  if (res.status === 204) return undefined as T;\n\n  let data: unknown = null;\n  const text = await res.text();\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = text;\n    }\n  }\n\n  if (!res.ok) {\n    const message =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(message, res.status);\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\n      \"POST\",\n      \"/api/auth/register\",\n      { username, password },\n      false\n    ),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\n      \"POST\",\n      \"/api/auth/login\",\n      { username, password },\n      false\n    ),\n  createReservation: (data: ReservationInput) =>\n    request<Reservation>(\"POST\", \"/api/reservations\", data),\n  listReservations: (date?: string) =>\n    request<ReservationList>(\n      \"GET\",\n      \"/api/reservations\" + (date ? `?date=${encodeURIComponent(date)}` : \"\")\n    ),\n  updateReservation: (id: number, data: ReservationInput) =>\n    request<Reservation>(\"PUT\", `/api/reservations/${id}`, data),\n  deleteReservation: (id: number) =>\n    request<void>(\"DELETE\", `/api/reservations/${id}`),\n  availability: (date: string) =>\n    request<Availability>(\n      \"GET\",\n      \"/api/availability?date=\" + encodeURIComponent(date),\n      undefined,\n      false\n    ),\n  adminReservations: (date?: string, page = 1, pageSize = 50) =>\n    request<AdminList>(\n      \"GET\",\n      \"/api/admin/reservations\" +\n        `?date=${encodeURIComponent(date ?? \"\")}` +\n        `&page=${page}&page_size=${pageSize}`\n    ),\n};\n\nexport interface ReservationInput {\n  name: string;\n  email: string;\n  date: string;\n  time: string;\n  party_size: number;\n  notes?: string | null;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794324403635,"end":1794324403643}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61195ae001L9XkhUWTLut9xn","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","messageID":"msg_1c61166d80016PqoeFfQz2FLON"}}
