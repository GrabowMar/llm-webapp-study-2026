{"type":"text","timestamp":1794324488184,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"id":"prt_1c612dfe3001Wptbtez4GdmCW3","messageID":"msg_1c61291730019uR2yrNX5a2lzB","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","type":"text","text":"Now the My Reservations component:\n\n","time":{"start":1794324488163,"end":1794324488179}}}
{"type":"tool_use","timestamp":1794324488205,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"type":"tool","tool":"write","callID":"call_22ls91ji1x32uc3ef6uilrcg","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  Reservation,\n  ReservationInput,\n} from \"./api\";\nimport { SLOT_TIMES } from \"./Availability\";\nimport { Button, Card, ErrorBox, Spinner, TextArea, TextInput } from \"./ui\";\n\ninterface Group {\n  date: string;\n  reservations: Reservation[];\n}\n\nfunction groupByDate(items: Reservation[]): Group[] {\n  const map = new Map<string, Reservation[]>();\n  for (const r of items) {\n    const list = map.get(r.date) ?? [];\n    list.push(r);\n    map.set(r.date, list);\n  }\n  return Array.from(map.entries()).map(([date, reservations]) => ({\n    date,\n    reservations,\n  }));\n}\n\nfunction EditForm({\n  reservation,\n  onSaved,\n  onCancel,\n}: {\n  reservation: Reservation;\n  onSaved: () => void;\n  onCancel: () => void;\n}) {\n  const [name, setName] = useState(reservation.name);\n  const [email, setEmail] = useState(reservation.email);\n  const [date, setDate] = useState(reservation.date);\n  const [time, setTime] = useState(reservation.time);\n  const [partySize, setPartySize] = useState(reservation.party_size);\n  const [notes, setNotes] = useState(reservation.notes ?? \"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit() {\n    setError(null);\n    setBusy(true);\n    const payload: ReservationInput = {\n      name,\n      email,\n      date,\n      time,\n      party_size: partySize,\n      notes: notes || null,\n    };\n    try {\n      await api.updateReservation(reservation.id, payload);\n      onSaved();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Unexpected error\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"space-y-4 rounded-md border border-blue-200 bg-blue-50 p-4\">\n      <ErrorBox message={error} />\n      <div className=\"grid gap-4 sm:grid-cols-2\">\n        <TextInput\n          label=\"Name\"\n          value={name}\n          onChange={(e) => setName(e.target.value)}\n        />\n        <TextInput\n          label=\"Email\"\n          type=\"email\"\n          value={email}\n          onChange={(e) => setEmail(e.target.value)}\n        />\n        <TextInput\n          label=\"Date\"\n          type=\"date\"\n          value={date}\n          onChange={(e) => setDate(e.target.value)}\n        />\n        <div className=\"grid grid-cols-2 gap-4\">\n          <label className=\"block\">\n            <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n              Time\n            </span>\n            <select\n              className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n              value={time}\n              onChange={(e) => setTime(e.target.value)}\n            >\n              {SLOT_TIMES.map((t) => (\n                <option key={t} value={t}>\n                  {t}\n                </option>\n              ))}\n            </select>\n          </label>\n          <label className=\"block\">\n            <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n              Party size\n            </span>\n            <select\n              className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm\"\n              value={partySize}\n              onChange={(e) => setPartySize(Number(e.target.value))}\n            >\n              {Array.from({ length: 20 }, (_, i) => i + 1).map((n) => (\n                <option key={n} value={n}>\n                  {n}\n                </option>\n              ))}\n            </select>\n          </label>\n        </div>\n      </div>\n      <TextArea\n        label=\"Notes\"\n        value={notes}\n        onChange={(e) => setNotes(e.target.value)}\n      />\n      <div className=\"flex gap-2\">\n        <Button onClick={submit} disabled={busy}>\n          Save changes\n        </Button>\n        <Button variant=\"secondary\" onClick={onCancel}>\n          Cancel\n        </Button>\n      </div>\n    </div>\n  );\n}\n\nfunction ReservationRow({\n  reservation,\n  onChanged,\n}: {\n  reservation: Reservation;\n  onChanged: () => void;\n}) {\n  const [editing, setEditing] = useState(false);\n  const [confirming, setConfirming] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function cancel() {\n    setError(null);\n    setBusy(true);\n    try {\n      await api.deleteReservation(reservation.id);\n      onChanged();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Unexpected error\");\n      setBusy(false);\n    }\n  }\n\n  if (editing) {\n    return (\n      <EditForm\n        reservation={reservation}\n        onSaved={() => {\n          setEditing(false);\n          onChanged();\n        }}\n        onCancel={() => setEditing(false)}\n      />\n    );\n  }\n\n  return (\n    <div className=\"rounded-md border border-gray-200 px-4 py-3\">\n      <div className=\"flex items-start justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-semibold text-gray-800\">{reservation.time}</span>\n            <span className=\"rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600\">\n              party of {reservation.party_size}\n            </span>\n          </div>\n          <div className=\"mt-1 text-sm text-gray-600\">\n            {reservation.name} · {reservation.email}\n          </div>\n          {reservation.notes && (\n            <div className=\"mt-1 text-sm text-gray-500\">\n              Notes: {reservation.notes}\n            </div>\n          )}\n        </div>\n        <div className=\"flex shrink-0 gap-2\">\n          {!confirming ? (\n            <>\n              <Button\n                variant=\"secondary\"\n                onClick={() => setEditing(true)}\n              >\n                Edit\n              </Button>\n              <Button variant=\"danger\" onClick={() => setConfirming(true)}>\n                Cancel\n              </Button>\n            </>\n          ) : (\n            <>\n              <span className=\"self-center text-sm text-gray-600\">\n                Cancel reservation?\n              </span>\n              <Button variant=\"danger\" onClick={cancel} disabled={busy}>\n                Yes\n              </Button>\n              <Button\n                variant=\"secondary\"\n                onClick={() => setConfirming(false)}\n              >\n                No\n              </Button>\n            </>\n          )}\n        </div>\n      </div>\n      {error && (\n        <div className=\"mt-2\">\n          <ErrorBox message={error} />\n        </div>\n      )}\n    </div>\n  );\n}\n\nexport default function MyReservations({\n  refreshTrigger,\n  onChanged,\n}: {\n  refreshTrigger: number;\n  onChanged: () => void;\n}) {\n  const [groups, setGroups] = useState<Group[]>([]);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    api\n      .listReservations()\n      .then((data) => {\n        if (!cancelled) setGroups(groupByDate(data.items));\n      })\n      .catch((err) => {\n        if (!cancelled)\n          setError(err instanceof ApiError ? err.message : \"Failed to load\");\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [refreshTrigger]);\n\n  function reload() {\n    onChanged();\n  }\n\n  return (\n    <Card title=\"My reservations\">\n      {loading ? (\n        <Spinner />\n      ) : error ? (\n        <ErrorBox message={error} />\n      ) : groups.length === 0 ? (\n        <p className=\"text-sm text-gray-500\">You have no reservations.</p>\n      ) : (\n        <div className=\"space-y-6\">\n          {groups.map((g) => (\n            <div key={g.date}>\n              <h3 className=\"mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500\">\n                {g.date}\n              </h3>\n              <div className=\"space-y-3\">\n                {g.reservations.map((r) => (\n                  <ReservationRow\n                    key={r.id}\n                    reservation={r}\n                    onChanged={reload}\n                  />\n                ))}\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/MyReservations.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/MyReservations.tsx","exists":false,"truncated":false},"title":"frontend/src/MyReservations.tsx","time":{"start":1794324488174,"end":1794324488187}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c612dfe7001e3tQZHjDCSQNyZ","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","messageID":"msg_1c61291730019uR2yrNX5a2lzB"}}
{"type":"step_finish","timestamp":1794324488205,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"id":"prt_1c612dffe001wIpNHgLjoHSOgt","reason":"tool-calls","messageID":"msg_1c61291730019uR2yrNX5a2lzB","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","type":"step-finish","tokens":{"total":30392,"input":451,"output":2037,"reasoning":0,"cache":{"write":0,"read":27904}},"cost":0}}
{"type":"step_start","timestamp":1794324499618,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"id":"prt_1c6130c96001iNv1aVWG4m0NXR","messageID":"msg_1c612e007001L7l6mkypdhF2Kz","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","type":"step-start"}}
{"type":"tool_use","timestamp":1794324499637,"sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","part":{"type":"tool","tool":"write","callID":"call_njcaz84a20shupwtup9skf49","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { api, ApiError, Reservation } from \"./api\";\nimport { Button, Card, ErrorBox, Spinner } from \"./ui\";\n\nexport default function AdminPanel({\n  date,\n  refreshTrigger,\n}: {\n  date: string;\n  refreshTrigger: number;\n}) {\n  const [items, setItems] = useState<Reservation[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [pageSize] = useState(20);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    setPage(1);\n  }, [date]);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    api\n      .adminReservations(date, page, pageSize)\n      .then((data) => {\n        if (cancelled) return;\n        setItems(data.items);\n        setTotal(data.total);\n      })\n      .catch((err) => {\n        if (!cancelled)\n          setError(err instanceof ApiError ? err.message : \"Failed to load\");\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [date, page, pageSize, refreshTrigger]);\n\n  const guestTotal = items.reduce((sum, r) => sum + r.party_size, 0);\n  const totalPages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <Card\n      title=\"All reservations (admin)\"\n      actions={\n        items.length > 0 ? (\n          <span className=\"text-sm text-gray-600\">\n            {guestTotal} guests on this page\n          </span>\n        ) : undefined\n      }\n    >\n      {loading ? (\n        <Spinner />\n      ) : error ? (\n        <ErrorBox message={error} />\n      ) : items.length === 0 ? (\n        <p className=\"text-sm text-gray-500\">No reservations on this day.</p>\n      ) : (\n        <>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-sm\">\n              <thead>\n                <tr className=\"border-b border-gray-200 text-gray-500\">\n                  <th className=\"py-2 pr-4 font-medium\">Time</th>\n                  <th className=\"py-2 pr-4 font-medium\">Name</th>\n                  <th className=\"py-2 pr-4 font-medium\">Email</th>\n                  <th className=\"py-2 pr-4 font-medium\">Party</th>\n                  <th className=\"py-2 pr-4 font-medium\">Notes</th>\n                </tr>\n              </thead>\n              <tbody>\n                {items.map((r) => (\n                  <tr\n                    key={r.id}\n                    className=\"border-b border-gray-100 text-gray-700\"\n                  >\n                    <td className=\"py-2 pr-4 font-medium\">{r.time}</td>\n                    <td className=\"py-2 pr-4\">{r.name}</td>\n                    <td className=\"py-2 pr-4\">{r.email}</td>\n                    <td className=\"py-2 pr-4\">{r.party_size}</td>\n                    <td className=\"py-2 pr-4 text-gray-500\">\n                      {r.notes ?? \"—\"}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n          <div className=\"mt-4 flex items-center justify-between text-sm text-gray-600\">\n            <span>\n              {total} total reservation{total === 1 ? \"\" : \"s\"}\n            </span>\n            <div className=\"flex items-center gap-2\">\n              <Button\n                variant=\"secondary\"\n                disabled={page <= 1}\n                onClick={() => setPage((p) => p - 1)}\n              >\n                Prev\n              </Button>\n              <span>\n                Page {page} of {totalPages}\n              </span>\n              <Button\n                variant=\"secondary\"\n                disabled={page >= totalPages}\n                onClick={() => setPage((p) => p + 1)}\n              >\n                Next\n              </Button>\n            </div>\n          </div>\n        </>\n      )}\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/AdminPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/AdminPanel.tsx","time":{"start":1794324499614,"end":1794324499621}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6130c99001TW0JWiC7aIH4cv","sessionID":"ses_e39f5a086ffeim6W4a20z0t8Ow","messageID":"msg_1c612e007001L7l6mkypdhF2Kz"}}
