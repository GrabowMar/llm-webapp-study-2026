{"type":"step_start","timestamp":1794320863391,"sessionID":"ses_e3a2b415bffe23UXKXB73CTgQL","part":{"id":"prt_1c5db908a001YT1NpxiJ4iyQov","messageID":"msg_1c5db6101001qEQgv57IFyq2VB","sessionID":"ses_e3a2b415bffe23UXKXB73CTgQL","type":"step-start"}}
{"type":"tool_use","timestamp":1794320863422,"sessionID":"ses_e3a2b415bffe23UXKXB73CTgQL","part":{"type":"tool","tool":"write","callID":"call_oorjwnx2y4bhk5izgtdtmvvs","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, type Recipe } from \"../api\";\nimport { useAuth } from \"../auth\";\n\nexport default function RecipeDetail() {\n  const { id } = useParams();\n  const { username } = useAuth();\n  const navigate = useNavigate();\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [confirming, setConfirming] = useState(false);\n  const [deleting, setDeleting] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    api\n      .getRecipe(Number(id))\n      .then((r) => {\n        if (!cancelled) setRecipe(r);\n      })\n      .catch(() => {\n        if (!cancelled) setError(\"Recipe not found.\");\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [id]);\n\n  if (error) {\n    return <p className=\"text-stone-500\">{error}</p>;\n  }\n  if (!recipe) {\n    return <p className=\"text-stone-500\">Loading…</p>;\n  }\n\n  const isAuthor = username !== null && username === recipe.author;\n\n  async function handleDelete() {\n    setDeleting(true);\n    try {\n      await api.deleteRecipe(recipe!.id);\n      navigate(\"/\");\n    } catch {\n      setError(\"Could not delete the recipe.\");\n      setDeleting(false);\n    }\n  }\n\n  return (\n    <div>\n      <Link to=\"/\" className=\"text-sm text-amber-700 hover:underline\">\n        ← Back to recipes\n      </Link>\n      <div className=\"mt-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n        <div className=\"flex items-start justify-between gap-4\">\n          <div>\n            <h1 className=\"text-3xl font-bold\">{recipe.title}</h1>\n            <p className=\"mt-2 text-sm text-stone-600\">\n              <span className=\"mr-2 rounded bg-amber-100 px-2 py-0.5 text-amber-800\">\n                {recipe.category}\n              </span>\n              {recipe.prep_minutes != null && (\n                <span className=\"mr-2\">Prep: {recipe.prep_minutes} min</span>\n              )}\n              {recipe.servings != null && <span>Serves {recipe.servings}</span>}\n            </p>\n            <p className=\"mt-1 text-sm text-stone-500\">by {recipe.author}</p>\n          </div>\n          {isAuthor && (\n            <div className=\"flex gap-2\">\n              <Link\n                to={`/recipes/${recipe.id}/edit`}\n                className=\"rounded-md bg-amber-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-700\"\n              >\n                Edit\n              </Link>\n              <button\n                onClick={() => setConfirming(true)}\n                className=\"rounded-md border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50\"\n              >\n                Delete\n              </button>\n            </div>\n          )}\n        </div>\n\n        <div className=\"mt-6 grid grid-cols-1 gap-8 md:grid-cols-2\">\n          <section>\n            <h2 className=\"mb-3 text-lg font-semibold\">Ingredients</h2>\n            <ul className=\"list-inside list-disc space-y-1\">\n              {recipe.ingredients.map((ing, i) => (\n                <li key={i}>{ing}</li>\n              ))}\n            </ul>\n          </section>\n          <section>\n            <h2 className=\"mb-3 text-lg font-semibold\">Instructions</h2>\n            <p className=\"whitespace-pre-line\">{recipe.instructions}</p>\n          </section>\n        </div>\n      </div>\n\n      {confirming && (\n        <div className=\"fixed inset-0 flex items-center justify-center bg-black/40 p-4\">\n          <div className=\"w-full max-w-sm rounded-lg bg-white p-6 shadow\">\n            <h3 className=\"text-lg font-semibold\">Delete recipe?</h3>\n            <p className=\"mt-2 text-sm text-stone-600\">\n              This will permanently delete “{recipe.title}”. This cannot be undone.\n            </p>\n            {error && <p className=\"mt-2 text-sm text-red-700\">{error}</p>}\n            <div className=\"mt-4 flex justify-end gap-2\">\n              <button\n                onClick={() => {\n                  setConfirming(false);\n                  setError(null);\n                }}\n                className=\"rounded-md border border-stone-300 px-3 py-1.5 text-sm\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleDelete}\n                disabled={deleting}\n                className=\"rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50\"\n              >\n                {deleting ? \"Deleting…\" : \"Delete\"}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/RecipeDetail.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/RecipeDetail.tsx","exists":false,"truncated":false},"title":"frontend/src/components/RecipeDetail.tsx","time":{"start":1794320863385,"end":1794320863396}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5db9090001rYw20Hf00NRkIW","sessionID":"ses_e3a2b415bffe23UXKXB73CTgQL","messageID":"msg_1c5db6101001qEQgv57IFyq2VB"}}
