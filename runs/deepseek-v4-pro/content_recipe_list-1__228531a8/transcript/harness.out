{"type":"tool_use","timestamp":1794320816462,"sessionID":"ses_e3a2b415bffe23UXKXB73CTgQL","part":{"type":"tool","tool":"write","callID":"call_8hzatdwigtxom3kgcp1x7evq","state":{"status":"completed","input":{"content":"export interface RecipeListItem {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number | null;\n  author: string;\n}\n\nexport interface Recipe extends RecipeListItem {\n  ingredients: string[];\n  instructions: string;\n  servings: number | null;\n  created_at: string;\n}\n\nexport interface RecipeListResponse {\n  items: RecipeListItem[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface RecipeInput {\n  title: string;\n  ingredients: string[];\n  instructions: string;\n  category: string;\n  prep_minutes: number | null;\n  servings: number | null;\n}\n\nconst TOKEN_KEY = \"recipebook_token\";\nconst USER_KEY = \"recipebook_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUser(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USER_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USER_KEY);\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  if (options.body !== undefined) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(`/api${path}`, { ...options, headers });\n  if (res.status === 204) {\n    return undefined as T;\n  }\n  const data = await res.json().catch(() => ({}));\n  if (!res.ok) {\n    throw new ApiError((data as { error?: string }).error ?? \"Request failed.\", res.status);\n  }\n  return data as T;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  listRecipes: (params: {\n    category?: string;\n    q?: string;\n    page?: number;\n    page_size?: number;\n  }) => {\n    const sp = new URLSearchParams();\n    if (params.category) sp.set(\"category\", params.category);\n    if (params.q) sp.set(\"q\", params.q);\n    if (params.page) sp.set(\"page\", String(params.page));\n    if (params.page_size) sp.set(\"page_size\", String(params.page_size));\n    const qs = sp.toString();\n    return request<RecipeListResponse>(`/recipes${qs ? `?${qs}` : \"\"}`);\n  },\n  getRecipe: (id: number) => request<Recipe>(`/recipes/${id}`),\n  createRecipe: (input: RecipeInput) =>\n    request<Recipe>(\"/recipes\", { method: \"POST\", body: JSON.stringify(input) }),\n  updateRecipe: (id: number, input: RecipeInput) =>\n    request<Recipe>(`/recipes/${id}`, { method: \"PUT\", body: JSON.stringify(input) }),\n  deleteRecipe: (id: number) =>\n    request<void>(`/recipes/${id}`, { method: \"DELETE\" }),\n  categories: () => request<{ categories: string[] }>(\"/categories\"),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794320816416,"end":1794320816431}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5dad919001aQyqzVbAquQtpX","sessionID":"ses_e3a2b415bffe23UXKXB73CTgQL","messageID":"msg_1c5dab1ae001B0JU9YxUuKJEsZ"}}
