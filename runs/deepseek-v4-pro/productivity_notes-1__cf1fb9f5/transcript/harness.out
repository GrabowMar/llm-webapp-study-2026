{"type":"tool_use","timestamp":1794371084494,"sessionID":"ses_e372861f1ffewXE71Hb3fQs2Ms","part":{"type":"tool","tool":"write","callID":"call_vwagcvtoha6p2y0d4msdydi4","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Tagged notes: Flask API + frontend server.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport json\nimport os\nimport secrets\nimport sqlite3\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"notes.db\"\n\napp = Flask(__name__, static_folder=None)\napp.config[\"JSON_SORT_KEYS\"] = False\n\n_SCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS notes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    content TEXT NOT NULL,\n    tags TEXT NOT NULL,\n    pinned INTEGER NOT NULL DEFAULT 0,\n    author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_notes_updated ON notes(updated_at);\n\"\"\"\n\n_PEPPER = os.environ.get(\"APP_PEPPER\", \"tagged-notes-pepper\")\n\n\ndef now() -> str:\n    import datetime\n\n    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(_SCHEMA)\n    db.commit()\n    db.close()\n\n\ndef _hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib.scrypt(\n        password.encode(\"utf-8\"), salt=salt.encode(\"utf-8\"), n=16384, r=8, p=1\n    )\n    return f\"{salt}${digest.hex()}\"\n\n\ndef _verify_password(password: str, stored: str) -> bool:\n    try:\n        salt, expected = stored.split(\"$\", 1)\n    except ValueError:\n        return False\n    digest = hashlib.scrypt(\n        password.encode(\"utf-8\"), salt=salt.encode(\"utf-8\"), n=16384, r=8, p=1\n    )\n    return hmac.compare_digest(digest.hex(), expected)\n\n\ndef _issue_token(db: sqlite3.Connection, user_id: int) -> str:\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, now()),\n    )\n    db.commit()\n    return token\n\n\ndef _current_user() -> sqlite3.Row | None:\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"SELECT u.id, u.username FROM users u \"\n        \"JOIN tokens t ON t.user_id = u.id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = _current_user()\n        if user is None:\n            return jsonify({\"error\": \"Authentication required\"}), 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef _json_body() -> dict | None:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef _note_to_dict(row: sqlite3.Row) -> dict:\n    tags = json.loads(row[\"tags\"]) if row[\"tags\"] else []\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"content\": row[\"content\"],\n        \"tags\": tags,\n        \"pinned\": bool(row[\"pinned\"]),\n        \"created_at\": row[\"created_at\"],\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\ndef _normalize_tags(tags) -> list[str] | None:\n    if tags is None:\n        return None\n    if not isinstance(tags, list):\n        raise ValueError(\"tags must be a list\")\n    normalized: list[str] = []\n    for tag in tags:\n        if not isinstance(tag, str):\n            raise ValueError(\"tags must be strings\")\n        t = tag.strip().lower()\n        if t and t not in normalized:\n            normalized.append(t)\n    return normalized\n\n\ndef _title_error(title) -> str | None:\n    if title is None:\n        return \"title is required\"\n    if not isinstance(title, str):\n        return \"title must be a string\"\n    if not title.strip():\n        return \"title must not be empty\"\n    return None\n\n\ndef _content_error(content) -> str | None:\n    if content is None:\n        return \"content is required\"\n    if not isinstance(content, str):\n        return \"content must be a string\"\n    return None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _json_body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"username is required\"}), 400\n    username = username.strip()\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"password is required\"}), 400\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if existing:\n        return jsonify({\"error\": \"username is already taken\"}), 409\n\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, _hash_password(password), now()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _json_body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"Invalid credentials\"}), 401\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not _verify_password(password, row[\"password_hash\"]):\n        return jsonify({\"error\": \"Invalid credentials\"}), 401\n\n    token = _issue_token(db, row[\"id\"])\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    tag = request.args.get(\"tag\")\n    author = request.args.get(\"author\")\n    q = request.args.get(\"q\")\n\n    try:\n        page = max(1, int(request.args.get(\"page\", \"1\")))\n    except ValueError:\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", \"10\"))\n    except ValueError:\n        page_size = 10\n    page_size = min(max(1, page_size), 100)\n\n    db = get_db()\n\n    where = []\n    params: list = []\n    if tag:\n        where.append(\n            \"EXISTS (SELECT 1 FROM json_each(n.tags) je \"\n            \"WHERE lower(je.value) = lower(?))\"\n        )\n        params.append(tag.strip())\n    if author:\n        where.append(\"n.author = ? COLLATE NOCASE\")\n        params.append(author.strip())\n    if q:\n        where.append(\"(n.title LIKE ? OR n.content LIKE ?)\")\n        like = f\"%{q}%\"\n        params.append(like)\n        params.append(like)\n\n    where_sql = (\"WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    total = db.execute(\n        f\"SELECT COUNT(*) FROM notes n {where_sql}\", params\n    ).fetchone()[0]\n\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"\"\"\n        SELECT n.id, n.title, n.content, n.tags, n.pinned,\n               n.created_at, n.updated_at, u.username AS author\n        FROM notes n JOIN users u ON u.id = n.author_id\n        {where_sql}\n        ORDER BY n.pinned DESC, n.updated_at DESC, n.id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        params + [page_size, offset],\n    ).fetchall()\n\n    items = [_note_to_dict(r) for r in rows]\n    return jsonify(\n        {\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size}\n    )\n\n\n@app.post(\"/api/notes\")\n@login_required\ndef create_note():\n    data = _json_body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n\n    title = data.get(\"title\")\n    content = data.get(\"content\")\n\n    err = _title_error(title) or _content_error(content)\n    if err:\n        return jsonify({\"error\": err}), 400\n\n    try:\n        tags = _normalize_tags(data.get(\"tags\", []))\n    except ValueError as e:\n        return jsonify({\"error\": str(e)}), 400\n\n    pinned = data.get(\"pinned\", False)\n    if not isinstance(pinned, bool):\n        return jsonify({\"error\": \"pinned must be a boolean\"}), 400\n\n    ts = now()\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notes (title, content, tags, pinned, author_id, created_at, updated_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            title,\n            content,\n            json.dumps(tags),\n            1 if pinned else 0,\n            g.user[\"id\"],\n            ts,\n            ts,\n        ),\n    )\n    db.commit()\n\n    row = db.execute(\n        \"SELECT n.id, n.title, n.content, n.tags, n.pinned, \"\n        \"n.created_at, n.updated_at, u.username AS author \"\n        \"FROM notes n JOIN users u ON u.id = n.author_id WHERE n.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(_note_to_dict(row)), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    db = get_db()\n    row = db.execute(\n        \"SELECT n.id, n.title, n.content, n.tags, n.pinned, \"\n        \"n.created_at, n.updated_at, u.username AS author \"\n        \"FROM notes n JOIN users u ON u.id = n.author_id WHERE n.id = ?\",\n        (note_id,),\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Note not found\"}), 404\n    return jsonify(_note_to_dict(row))\n\n\ndef _load_note(db, note_id: int) -> sqlite3.Row | None:\n    return db.execute(\n        \"SELECT n.id, n.title, n.content, n.tags, n.pinned, \"\n        \"n.created_at, n.updated_at, n.author_id, u.username AS author \"\n        \"FROM notes n JOIN users u ON u.id = n.author_id WHERE n.id = ?\",\n        (note_id,),\n    ).fetchone()\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\n@login_required\ndef update_note(note_id: int):\n    db = get_db()\n    row = _load_note(db, note_id)\n    if row is None:\n        return jsonify({\"error\": \"Note not found\"}), 404\n    if row[\"author_id\"] != g.user[\"id\"]:\n        return jsonify({\"error\": \"Only the author may edit this note\"}), 403\n\n    data = _json_body()\n    if data is None:\n        return jsonify({\"error\": \"Invalid JSON body\"}), 400\n    if not data:\n        return jsonify({\"error\": \"No fields to update\"}), 400\n\n    allowed = {\"title\", \"content\", \"tags\", \"pinned\"}\n    unknown = set(data) - allowed\n    if unknown:\n        return jsonify({\"error\": f\"Unknown fields: {', '.join(sorted(unknown))}\"}), 400\n\n    updates = []\n    params: list = []\n\n    if \"title\" in data:\n        err = _title_error(data[\"title\"])\n        if err:\n            return jsonify({\"error\": err}), 400\n        updates.append(\"title = ?\")\n        params.append(data[\"title\"])\n\n    if \"content\" in data:\n        err = _content_error(data[\"content\"])\n        if err:\n            return jsonify({\"error\": err}), 400\n        updates.append(\"content = ?\")\n        params.append(data[\"content\"])\n\n    if \"tags\" in data:\n        try:\n            tags = _normalize_tags(data[\"tags\"])\n        except ValueError as e:\n            return jsonify({\"error\": str(e)}), 400\n        updates.append(\"tags = ?\")\n        params.append(json.dumps(tags))\n\n    if \"pinned\" in data:\n        if not isinstance(data[\"pinned\"], bool):\n            return jsonify({\"error\": \"pinned must be a boolean\"}), 400\n        updates.append(\"pinned = ?\")\n        params.append(1 if data[\"pinned\"] else 0)\n\n    if not updates:\n        return jsonify({\"error\": \"No valid fields to update\"}), 400\n\n    updates.append(\"updated_at = ?\")\n    params.append(now())\n    params.append(note_id)\n\n    db.execute(\n        f\"UPDATE notes SET {', '.join(updates)} WHERE id = ?\", params\n    )\n    db.commit()\n\n    updated = _load_note(db, note_id)\n    return jsonify(_note_to_dict(updated))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\n@login_required\ndef delete_note(note_id: int):\n    db = get_db()\n    row = _load_note(db, note_id)\n    if row is None:\n        return jsonify({\"error\": \"Note not found\"}), 404\n    if row[\"author_id\"] != g.user[\"id\"]:\n        return jsonify({\"error\": \"Only the author may delete this note\"}), 403\n\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (note_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/tags\")\ndef list_tags():\n    db = get_db()\n    rows = db.execute(\n        \"SELECT je.value AS tag, COUNT(*) AS count \"\n        \"FROM notes n, json_each(n.tags) je \"\n        \"GROUP BY lower(je.value) \"\n        \"ORDER BY count DESC, lower(je.value) ASC\"\n    ).fetchall()\n    items = [{\"tag\": r[\"tag\"], \"count\": r[\"count\"]} for r in rows]\n    return jsonify({\"items\": items})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794371084434,"end":1794371084467}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8d9e087001M1Wqy3s10Qrapi","sessionID":"ses_e372861f1ffewXE71Hb3fQs2Ms","messageID":"msg_1c8d94cb4001V0x5szq83lzowV"}}
