'py'}]}\nupdated_at changed: True\npublic get: 200\nOK\n","metadata":{"output":"order pinned first: True ids [1, 2]\nauthor=bob: 1\ntag=go: 2\nq=two: 1\ntags: {'items': [{'count': 2, 'tag': 'go'}, {'count': 1, 'tag': 'py'}]}\nupdated_at changed: True\npublic get: 200\nOK\n","exit":0,"truncated":false},"title":"cd /workspace && python3 -c \"\nimport backend.app as m\nfrom pathlib import Path\nimport tempfile\nm.DB_PATH = Path(tempfile.mkdtemp())/'notes.db'\nm.DATA_DIR = m.DB_PATH.parent\nm.init_db()\nc = m.app.test_client()\n\nc.post('/api/auth/register', json={'username':'alice','password':'pw'})\nc.post('/api/auth/register', json={'username':'bob','password':'pw'})\na = c.post('/api/auth/login', json={'username':'alice','password':'pw'}).get_json()['token']\nb = c.post('/api/auth/login', json={'username':'bob','password':'pw'}).get_json()['token']\nah={'Authorization':'Bearer '+a}; bh={'Authorization':'Bearer '+b}\n\nn1=c.post('/api/notes', json={'title':'Alpha','content':'one','tags':['go']}, headers=ah).get_json()\nn2=c.post('/api/notes', json={'title':'Beta','content':'two','tags':['go','py']}, headers=bh).get_json()\nc.patch(f\\\"/api/notes/{n1['id']}\\\", json={'pinned':True}, headers=ah)\n\nr=c.get('/api/notes').get_json()\nprint('order pinned first:', r['items'][0]['pinned']==True, 'ids', [i['id'] for i in r['items']])\n\nprint('author=bob:', c.get('/api/notes?author=bob').get_json()['total'])\nprint('tag=go:', c.get('/api/notes?tag=go').get_json()['total'])\nprint('q=two:', c.get('/api/notes?q=two').get_json()['total'])\nprint('tags:', c.get('/api/tags').get_json())\n\n# updated_at changes on patch\nimport time\ntime.sleep(0.01)\nr=c.patch(f\\\"/api/notes/{n2['id']}\\\", json={'content':'two updated'}, headers=bh).get_json()\nprint('updated_at changed:', r['updated_at'] != n2['updated_at'])\n\n# unauth read allowed\nprint('public get:', c.get(f\\\"/api/notes/{n1['id']}\\\").status_code)\nprint('OK')\n\"","time":{"start":1794371528538,"end":1794371529087}},"