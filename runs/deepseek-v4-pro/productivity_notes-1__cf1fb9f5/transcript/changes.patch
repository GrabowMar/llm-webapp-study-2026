@@ -0,0 +1,78 @@
+import { useState, type FormEvent } from "react";
+import { useNavigate } from "react-router-dom";
+import { login, register, ApiError } from "../api";
+import { useAuth } from "../auth";
+
+export function AuthForm({ mode }: { mode: "login" | "register" }) {
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const navigate = useNavigate();
+  const { signIn } = useAuth();
+
+  const isLogin = mode === "login";
+
+  async function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setBusy(true);
+    try {
+      if (isLogin) {
+        const res = await login(username, password);
+        signIn(username, res.token);
+        navigate("/");
+      } else {
+        await register(username, password);
+        const res = await login(username, password);
+        signIn(username, res.token);
+        navigate("/");
+      }
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : "Something went wrong");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="mx-auto max-w-sm">
+      <h1 className="mb-4 text-2xl font-bold">
+        {isLogin ? "Sign in" : "Create an account"}
+      </h1>
+      <form onSubmit={onSubmit} className="space-y-4">
+        <div>
+          <label className="mb-1 block text-sm font-medium">Username</label>
+          <input
+            value={username}
+            onChange={(e) => setUsername(e.target.value)}
+            className="w-full rounded-md border border-slate-300 px-3 py-2"
+            autoComplete="username"
+          />
+        </div>
+        <div>
+          <label className="mb-1 block text-sm font-medium">Password</label>
+          <input
+            type="password"
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            className="w-full rounded-md border border-slate-300 px-3 py-2"
+            autoComplete={isLogin ? "current-password" : "new-password"}
+          />
+        </div>
+        {error && (
+          <p className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+            {error}
+          </p>
+        )}
+        <button
+          type="submit"
+          disabled={busy}
+          className="w-full rounded-md bg-slate-900 px-3 py-2 font-medium text-white hover:bg-slate-700 disabled:opacity-50"
+        >
+          {busy ? "Please wait…" : isLogin ? "Sign in" : "Register"}
+        </button>
+      </form>
+    </div>
+  );
+}
