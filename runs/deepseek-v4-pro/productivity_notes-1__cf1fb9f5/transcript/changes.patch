+
+def now() -> str:
+    import datetime
+
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+def get_db() -> sqlite3.Connection:
+    if "db" not in g:
+        g.db = sqlite3.connect(DB_PATH)
+        g.db.row_factory = sqlite3.Row
+        g.db.execute("PRAGMA foreign_keys = ON")
+    return g.db
+
+
+@app.teardown_appcontext
+def close_db(exc=None):
+    db = g.pop("db", None)
+    if db is not None:
+        db.close()
+
+
+def init_db() -> None:
+    DATA_DIR.mkdir(parents=True, exist_ok=True)
+    db = sqlite3.connect(DB_PATH)
+    db.executescript(_SCHEMA)
+    db.commit()
+    db.close()
+
+
+def _hash_password(password: str) -> str:
+    salt = secrets.token_hex(16)
+    digest = hashlib.scrypt(
+        password.encode("utf-8"), salt=salt.encode("utf-8"), n=16384, r=8, p=1
+    )
+    return f"{salt}${digest.hex()}"
+
+
+def _verify_password(password: str, stored: str) -> bool:
+    try:
+        salt, expected = stored.split("$", 1)
+    except ValueError:
+        return False
+    digest = hashlib.scrypt(
+        password.encode("utf-8"), salt=salt.encode("utf-8"), n=16384, r=8, p=1
+    )
+    return hmac.compare_digest(digest.hex(), expected)
+
+
+def _issue_token(db: sqlite3.Connection, user_id: int) -> str:
+    token = secrets.token_hex(32)
+    db.execute(
+        "INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)",
+        (token, user_id, now()),
+    )
+    db.commit()
+    return token
+
+
+def _current_user() -> sqlite3.Row | None:
+    auth = request.headers.get("Authorization", "")
+    if not auth.startswith("Bearer "):
+        return None
+    token = auth[len("Bearer "):].strip()
+    if not token:
+        return None
+    db = get_db()
+    row = db.execute(
+        "SELECT u.id, u.username FROM users u "
+        "JOIN tokens t ON t.user_id = u.id WHERE t.token = ?",
+        (token,),
+    ).fetchone()
+    return row
+
+
+def login_required(view):
+    @wraps(view)
+    def wrapped(*args, **kwargs):
+        user = _current_user()
+        if user is None:
+            return jsonify({"error": "Authentication required"}), 401
+        g.user = user
+        return view(*args, **kwargs)
+
+    return wrapped
+
+
+def _json_body() -> dict | None:
+    data = request.get_json(silent=True)
+    if not isinstance(data, dict):
+        return None
+    return data
+
+
+def _note_to_dict(row: sqlite3.Row) -> dict:
+    tags = json.loads(row["tags"]) if row["tags"] else []
+    return {
+        "id": row["id"],
+        "title": row["title"],
+        "content": row["content"],
+        "tags": tags,
+        "pinned": bool(row["pinned"]),
+        "created_at": row["created_at"],
+        "updated_at": row["updated_at"],
+        "author": row["author"],
+    }
+
+
+def _normalize_tags(tags) -> list[str] | None:
+    if tags is None:
+        return None
+    if not isinstance(tags, list):
+        raise ValueError("tags must be a list")
+    normalized: list[str] = []
+    for tag in tags:
+        if not isinstance(tag, str):
+            raise ValueError("tags must be strings")
+        t = tag.strip().lower()
+        if t and t not in normalized:
+            normalized.append(t)
+    return normalized
+
+
+def _title_error(title) -> str | None:
+    if title is None:
+        return "title is required"
+    if not isinstance(title, str):
+        return "title must be a string"
+    if not title.strip():
+        return "title must not be empty"
+    return None
+
+
+def _content_error(content) -> str | None:
+    if content is None:
+        return "content is required"
+    if not isinstance(content, str):
+        return "content must be a string"
+    return None
 
 
