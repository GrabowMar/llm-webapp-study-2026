{"type":"tool_use","timestamp":1794347763909,"sessionID":"ses_e388bbbcaffecfYJCf1mdrz6Gq","part":{"type":"tool","tool":"write","callID":"call_vx6hiwtiz8od2mr7bv9n79b6","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the notification center.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"app.db\"\n\nADMIN_USERNAME = \"admin\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS notifications (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                message TEXT NOT NULL,\n                type TEXT NOT NULL,\n                read INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_notifications_user\n                ON notifications (user_id, created_at DESC);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef row_to_notification(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (user_id, token) VALUES (?, ?)\",\n        (user_id, token),\n    )\n    db.commit()\n    return token\n\n\ndef create_user(username: str, password: str) -> int:\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return cur.lastrowid\n\n\ndef current_user() -> sqlite3.Row | None:\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"\"\"\n        SELECT u.id, u.username\n        FROM tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef is_admin(user) -> bool:\n    return user is not None and user[\"username\"] == ADMIN_USERNAME\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"unauthorized\"}), 401\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef admin_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"unauthorized\"}), 401\n        if not is_admin(user):\n            return jsonify({\"error\": \"forbidden\"}), 403\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef parse_notification_body(data) -> tuple[str, str] | None:\n    if not isinstance(data, dict):\n        return None\n    message = data.get(\"message\")\n    ntype = data.get(\"type\", \"info\")\n    if not isinstance(message, str) or not message.strip():\n        return None\n    if not isinstance(ntype, str) or not ntype.strip():\n        ntype = \"info\"\n    return message.strip(), ntype.strip()\n\n\ndef find_notification_for_user(notification_id: int, user_id: int) -> sqlite3.Row | None:\n    db = get_db()\n    return db.execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, user_id),\n    ).fetchone()\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return jsonify({\"error\": \"invalid body\"}), 400\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"username required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"password required\"}), 400\n    username = username.strip()\n\n    db = get_db()\n    exists = db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if exists:\n        return jsonify({\"error\": \"username taken\"}), 409\n\n    user_id = create_user(username, password)\n    token = issue_token(user_id)\n    return jsonify({\"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return jsonify({\"error\": \"invalid body\"}), 400\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n    username = username.strip()\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n\n    token = issue_token(row[\"id\"])\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/notifications\")\n@login_required\ndef list_notifications():\n    user_id = g.user[\"id\"]\n    db = get_db()\n\n    read_filter = request.args.get(\"read\")\n    type_filter = request.args.get(\"type\")\n    page = request.args.get(\"page\", 1, type=int)\n    page_size = request.args.get(\"page_size\", 20, type=int)\n\n    if page < 1:\n        page = 1\n    if page_size < 1:\n        page_size = 20\n\n    conditions = [\"user_id = ?\"]\n    params: list = [user_id]\n    if read_filter == \"true\":\n        conditions.append(\"read = 1\")\n    elif read_filter == \"false\":\n        conditions.append(\"read = 0\")\n    if type_filter:\n        conditions.append(\"type = ?\")\n        params.append(type_filter)\n\n    where = \" AND \".join(conditions)\n\n    unread_row = db.execute(\n        \"SELECT COUNT(*) AS c FROM notifications WHERE user_id = ? AND read = 0\",\n        (user_id,),\n    ).fetchone()\n    unread_count = unread_row[\"c\"]\n\n    total_row = db.execute(\n        f\"SELECT COUNT(*) AS c FROM notifications WHERE {where}\", params\n    ).fetchone()\n    total = total_row[\"c\"]\n\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"SELECT * FROM notifications WHERE {where} ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, offset],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [row_to_notification(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread_count,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@login_required\ndef create_notification():\n    data = request.get_json(silent=True)\n    parsed = parse_notification_body(data)\n    if parsed is None:\n        return jsonify({\"error\": \"message required\"}), 400\n    message, ntype = parsed\n\n    db = get_db()\n    created_at = utcnow()\n    cur = db.execute(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at) VALUES (?, ?, ?, 0, ?)\",\n        (g.user[\"id\"], message, ntype, created_at),\n    )\n    db.commit()\n\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(row_to_notification(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@login_required\ndef read_all():\n    db = get_db()\n    cur = db.execute(\n        \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\",\n        (g.user[\"id\"],),\n    )\n    db.commit()\n    return jsonify({\"updated\": cur.rowcount})\n\n\n@app.get(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef get_notification(notification_id):\n    row = find_notification_for_user(notification_id, g.user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify(row_to_notification(row))\n\n\n@app.patch(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef update_notification(notification_id):\n    row = find_notification_for_user(notification_id, g.user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict) or \"read\" not in data:\n        return jsonify({\"error\": \"read required\"}), 400\n    read_value = data[\"read\"]\n    if not isinstance(read_value, bool):\n        return jsonify({\"error\": \"read must be boolean\"}), 400\n\n    db = get_db()\n    db.execute(\n        \"UPDATE notifications SET read = ? WHERE id = ? AND user_id = ?\",\n        (1 if read_value else 0, notification_id, g.user[\"id\"]),\n    )\n    db.commit()\n\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (notification_id,)\n    ).fetchone()\n    return jsonify(row_to_notification(row))\n\n\n@app.delete(\"/api/notifications/<int:notification_id>\")\n@login_required\ndef delete_notification(notification_id):\n    row = find_notification_for_user(notification_id, g.user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n\n    db = get_db()\n    db.execute(\n        \"DELETE FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, g.user[\"id\"]),\n    )\n    db.commit()\n    return \"\", 204\n\n\n@app.post(\"/api/admin/broadcast\")\n@admin_required\ndef broadcast():\n    data = request.get_json(silent=True)\n    parsed = parse_notification_body(data)\n    if parsed is None:\n        return jsonify({\"error\": \"message required\"}), 400\n    message, ntype = parsed\n\n    db = get_db()\n    user_ids = [r[\"id\"] for r in db.execute(\"SELECT id FROM users\").fetchall()]\n    if user_ids:\n        created_at = utcnow()\n        db.executemany(\n            \"INSERT INTO notifications (user_id, message, type, read, created_at) VALUES (?, ?, ?, 0, ?)\",\n            [(uid, message, ntype, created_at) for uid in user_ids],\n        )\n        db.commit()\n    return jsonify({\"delivered\": len(user_ids)})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794347763862,"end":1794347763886}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c776088e0010b0J15o3SkP9qB","sessionID":"ses_e388bbbcaffecfYJCf1mdrz6Gq","messageID":"msg_1c775a0e6001IhupU1e7VYcVF5"}}
