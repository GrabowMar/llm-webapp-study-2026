{"type":"tool_use","timestamp":1794387689851,"sessionID":"ses_e362cbcc5ffetEet2s6HUfeign","part":{"type":"tool","tool":"write","callID":"call_vof1pab4g73zus8acpiam9zb","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the XML well-formedness checker.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom xml.parsers import expat\nfrom xml.parsers.expat import errors\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------- #\n# Database\n# --------------------------------------------------------------------------- #\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS sessions (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS validations (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            xml_preview TEXT NOT NULL,\n            valid INTEGER NOT NULL,\n            error TEXT,\n            line INTEGER,\n            column INTEGER,\n            root_element TEXT,\n            created_at TEXT NOT NULL\n        );\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\n@app.teardown_appcontext\ndef close_db(exception=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef _now() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\n# --------------------------------------------------------------------------- #\n# XML well-formedness\n# --------------------------------------------------------------------------- #\n\ndef validate_xml(xml: str) -> dict:\n    \"\"\"Return a result dict for the given XML string (well-formedness only).\"\"\"\n    parser = expat.ParserCreate()\n    root_element = None\n\n    def start_element(name, attrs):\n        nonlocal root_element\n        if root_element is None:\n            root_element = name\n\n    parser.StartElementHandler = start_element\n\n    try:\n        parser.Parse(xml, True)\n    except expat.ExpatError as exc:\n        message = errors.messages.get(exc.code, str(exc))\n        return {\n            \"valid\": False,\n            \"error\": message,\n            \"line\": exc.lineno,\n            \"column\": exc.offset + 1,\n            \"root_element\": root_element,\n        }\n\n    return {\n        \"valid\": True,\n        \"error\": None,\n        \"line\": None,\n        \"column\": None,\n        \"root_element\": root_element,\n    }\n\n\n# --------------------------------------------------------------------------- #\n# Auth helpers\n# --------------------------------------------------------------------------- #\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM sessions s \"\n        \"JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"unauthorized\"}), 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\n# --------------------------------------------------------------------------- #\n# API routes\n# --------------------------------------------------------------------------- #\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return jsonify({\"error\": \"username already taken\"}), 409\n\n    db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), _now()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], _now()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/validate/xml\")\ndef validate_endpoint():\n    data = request.get_json(silent=True) or {}\n    xml = data.get(\"xml\")\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"xml is required\"}), 400\n    return jsonify(validate_xml(xml))\n\n\n@app.post(\"/api/validations\")\n@login_required\ndef create_validation():\n    data = request.get_json(silent=True) or {}\n    xml = data.get(\"xml\")\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"xml is required\"}), 400\n\n    result = validate_xml(xml)\n    xml_preview = xml[:200]\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO validations \"\n        \"(user_id, xml_preview, valid, error, line, column, root_element, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            g.user[\"id\"],\n            xml_preview,\n            1 if result[\"valid\"] else 0,\n            result[\"error\"],\n            result[\"line\"],\n            result[\"column\"],\n            result[\"root_element\"],\n            _now(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM validations WHERE id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(_serialize(row)), 201\n\n\n@app.get(\"/api/validations\")\n@login_required\ndef list_validations():\n    valid_param = request.args.get(\"valid\")\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = max(1, min(100, int(request.args.get(\"page_size\", 10))))\n    except (TypeError, ValueError):\n        page_size = 10\n\n    db = get_db()\n    where = \"user_id = ?\"\n    params = [g.user[\"id\"]]\n\n    if valid_param in (\"true\", \"false\"):\n        where += \" AND valid = ?\"\n        params.append(1 if valid_param == \"true\" else 0)\n\n    total = db.execute(\n        f\"SELECT COUNT(*) AS c FROM validations WHERE {where}\", params\n    ).fetchone()[\"c\"]\n\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"SELECT * FROM validations WHERE {where} \"\n        \"ORDER BY id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, offset],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [_serialize(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.delete(\"/api/validations/<int:validation_id>\")\n@login_required\ndef delete_validation(validation_id):\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM validations WHERE id = ? AND user_id = ?\",\n        (validation_id, g.user[\"id\"]),\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify({\"deleted\": True})\n\n\ndef _serialize(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n# --------------------------------------------------------------------------- #\n# Frontend\n# --------------------------------------------------------------------------- #\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794387689784,"end":1794387689812}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9d74131001oCmQC6AjdN7xjw","sessionID":"ses_e362cbcc5ffetEet2s6HUfeign","messageID":"msg_1c9d68b0e001BBjzNLiup4LOCr"}}
