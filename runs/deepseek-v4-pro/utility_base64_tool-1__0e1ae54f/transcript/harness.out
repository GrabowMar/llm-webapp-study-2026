{"type":"tool_use","timestamp":1794358503391,"sessionID":"ses_e37e816c5ffeg3OB6PExrifaO4","part":{"type":"tool","tool":"write","callID":"call_gq8a129lyaf4fwoj43wvx48d","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\n\ninterface Conversion {\n  id: number;\n  direction: \"encode\" | \"decode\";\n  input_preview: string;\n  output_preview: string;\n  created_at: string;\n  output?: string;\n}\n\ninterface Page {\n  items: Conversion[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst TOKEN_KEY = \"b64_token\";\n\nfunction api<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const token = localStorage.getItem(TOKEN_KEY);\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  return fetch(`/api${path}`, { ...options, headers }).then(async (res) => {\n    const data = await res.json().catch(() => ({}));\n    if (!res.ok) {\n      throw new Error((data as { error?: string }).error || \"Request failed\");\n    }\n    return data as T;\n  });\n}\n\nfunction copyToClipboard(text: string) {\n  if (navigator.clipboard) {\n    return navigator.clipboard.writeText(text);\n  }\n  const el = document.createElement(\"textarea\");\n  el.value = text;\n  document.body.appendChild(el);\n  el.select();\n  document.execCommand(\"copy\");\n  document.body.removeChild(el);\n  return Promise.resolve();\n}\n\nexport default function App() {\n  const [token, setToken] = useState<string | null>(() =>\n    localStorage.getItem(TOKEN_KEY)\n  );\n  const [username, setUsername] = useState(\"\");\n  const [authUsername, setAuthUsername] = useState(\"\");\n  const [authPassword, setAuthPassword] = useState(\"\");\n  const [authError, setAuthError] = useState(\"\");\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n\n  const [input, setInput] = useState(\"\");\n  const [output, setOutput] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [copied, setCopied] = useState(false);\n  const [saveHistory, setSaveHistory] = useState(false);\n\n  const [history, setHistory] = useState<Page | null>(null);\n  const [page, setPage] = useState(1);\n  const [pageSize] = useState(5);\n  const [historyError, setHistoryError] = useState(\"\");\n\n  const loadHistory = useCallback(\n    async (p: number) => {\n      if (!token) return;\n      try {\n        const data = await api<Page>(`/conversions?page=${p}&page_size=${pageSize}`);\n        setHistory(data);\n        setPage(data.page);\n        setHistoryError(\"\");\n      } catch (e) {\n        setHistoryError((e as Error).message);\n      }\n    },\n    [token, pageSize]\n  );\n\n  useEffect(() => {\n    loadHistory(1);\n  }, [token, loadHistory]);\n\n  const signOut = () => {\n    localStorage.removeItem(TOKEN_KEY);\n    setToken(null);\n    setHistory(null);\n  };\n\n  const handleAuth = async () => {\n    setAuthError(\"\");\n    try {\n      if (mode === \"register\") {\n        await api(\"/auth/register\", {\n          method: \"POST\",\n          body: JSON.stringify({ username: authUsername, password: authPassword }),\n        });\n      }\n      const data = await api<{ token: string }>(\"/auth/login\", {\n        method: \"POST\",\n        body: JSON.stringify({ username: authUsername, password: authPassword }),\n      });\n      localStorage.setItem(TOKEN_KEY, data.token);\n      setToken(data.token);\n      setUsername(authUsername);\n      setAuthPassword(\"\");\n    } catch (e) {\n      setAuthError((e as Error).message);\n    }\n  };\n\n  const run = async (direction: \"encode\" | \"decode\") => {\n    setError(\"\");\n    setCopied(false);\n    const body = direction === \"encode\" ? { text: input } : { encoded: input };\n    try {\n      if (token && saveHistory) {\n        const data = await api<Conversion>(\"/conversions\", {\n          method: \"POST\",\n          body: JSON.stringify({ direction, input }),\n        });\n        setOutput(data.output ?? \"\");\n        loadHistory(1);\n      } else if (direction === \"encode\") {\n        const data = await api<{ encoded: string }>(\"/base64/encode\", {\n          method: \"POST\",\n          body: JSON.stringify(body),\n        });\n        setOutput(data.encoded);\n      } else {\n        const data = await api<{ text: string }>(\"/base64/decode\", {\n          method: \"POST\",\n          body: JSON.stringify(body),\n        });\n        setOutput(data.text);\n      }\n    } catch (e) {\n      setError((e as Error).message);\n    }\n  };\n\n  const handleDelete = async (id: number) => {\n    try {\n      await api(`/conversions/${id}`, { method: \"DELETE\" });\n      loadHistory(page);\n    } catch (e) {\n      setHistoryError((e as Error).message);\n    }\n  };\n\n  const totalPages = history ? Math.max(1, Math.ceil(history.total / history.page_size)) : 1;\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <header className=\"bg-slate-900 text-white\">\n        <div className=\"mx-auto flex max-w-4xl items-center justify-between px-4 py-4\">\n          <h1 className=\"text-xl font-bold\">Base64 Converter</h1>\n          {token && (\n            <div className=\"flex items-center gap-4\">\n              <span className=\"text-sm text-slate-300\">Signed in as {username}</span>\n              <button\n                onClick={signOut}\n                className=\"rounded bg-slate-700 px-3 py-1 text-sm hover:bg-slate-600\"\n              >\n                Sign out\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-4xl space-y-6 px-4 py-6\">\n        {!token && (\n          <section className=\"rounded-lg bg-white p-6 shadow\">\n            <h2 className=\"mb-4 text-lg font-semibold\">\n              {mode === \"login\" ? \"Sign in\" : \"Register\"}\n            </h2>\n            <div className=\"flex flex-col gap-3 sm:flex-row\">\n              <input\n                className=\"flex-1 rounded border border-slate-300 px-3 py-2\"\n                placeholder=\"Username\"\n                value={authUsername}\n                onChange={(e) => setAuthUsername(e.target.value)}\n              />\n              <input\n                className=\"flex-1 rounded border border-slate-300 px-3 py-2\"\n                type=\"password\"\n                placeholder=\"Password\"\n                value={authPassword}\n                onChange={(e) => setAuthPassword(e.target.value)}\n              />\n            </div>\n            {authError && <p className=\"mt-3 text-sm text-red-600\">{authError}</p>}\n            <div className=\"mt-4 flex items-center gap-3\">\n              <button\n                onClick={handleAuth}\n                className=\"rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700\"\n              >\n                {mode === \"login\" ? \"Sign in\" : \"Register\"}\n              </button>\n              <button\n                onClick={() => {\n                  setMode(mode === \"login\" ? \"register\" : \"login\");\n                  setAuthError(\"\");\n                }}\n                className=\"text-sm text-blue-600 hover:underline\"\n              >\n                {mode === \"login\" ? \"Create an account\" : \"Have an account? Sign in\"}\n              </button>\n            </div>\n          </section>\n        )}\n\n        <section className=\"rounded-lg bg-white p-6 shadow\">\n          <h2 className=\"mb-4 text-lg font-semibold\">Convert</h2>\n          <div className=\"flex gap-3\">\n            <textarea\n              className=\"min-h-32 flex-1 rounded border border-slate-300 p-3 font-mono\"\n              placeholder=\"Input text / base64\"\n              value={input}\n              onChange={(e) => setInput(e.target.value)}\n            />\n            <textarea\n              className=\"min-h-32 flex-1 rounded border border-slate-300 p-3 font-mono\"\n              placeholder=\"Output\"\n              value={output}\n              readOnly\n            />\n          </div>\n          {error && <p className=\"mt-3 text-sm text-red-600\">{error}</p>}\n          <div className=\"mt-4 flex flex-wrap items-center gap-3\">\n            <button\n              onClick={() => run(\"encode\")}\n              className=\"rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700\"\n            >\n              Encode\n            </button>\n            <button\n              onClick={() => run(\"decode\")}\n              className=\"rounded bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-700\"\n            >\n              Decode\n            </button>\n            <button\n              onClick={() => {\n                copyToClipboard(output);\n                setCopied(true);\n                setTimeout(() => setCopied(false), 1500);\n              }}\n              className=\"rounded border border-slate-300 px-4 py-2 hover:bg-slate-50\"\n            >\n              {copied ? \"Copied!\" : \"Copy\"}\n            </button>\n            {token && (\n              <label className=\"flex items-center gap-2 text-sm\">\n                <input\n                  type=\"checkbox\"\n                  checked={saveHistory}\n                  onChange={(e) => setSaveHistory(e.target.checked)}\n                />\n                Save to history\n              </label>\n            )}\n          </div>\n        </section>\n\n        {token && (\n          <section className=\"rounded-lg bg-white p-6 shadow\">\n            <h2 className=\"mb-4 text-lg font-semibold\">History</h2>\n            {historyError && <p className=\"mb-3 text-sm text-red-600\">{historyError}</p>}\n            {history && history.items.length === 0 && (\n              <p className=\"text-sm text-slate-500\">No saved conversions yet.</p>\n            )}\n            {history && history.items.length > 0 && (\n              <ul className=\"divide-y divide-slate-200\">\n                {history.items.map((c) => (\n                  <li key={c.id} className=\"flex items-center justify-between gap-4 py-3\">\n                    <div className=\"min-w-0 flex-1\">\n                      <span className=\"mr-2 rounded bg-slate-100 px-2 py-0.5 text-xs font-medium uppercase\">\n                        {c.direction}\n                      </span>\n                      <span className=\"text-sm text-slate-700\">\n                        {c.input_preview} &rarr; {c.output_preview}\n                      </span>\n                      <div className=\"mt-1 text-xs text-slate-400\">\n                        {new Date(c.created_at).toLocaleString()}\n                      </div>\n                    </div>\n                    <button\n                      onClick={() => handleDelete(c.id)}\n                      className=\"rounded border border-red-300 px-3 py-1 text-sm text-red-600 hover:bg-red-50\"\n                    >\n                      Delete\n                    </button>\n                  </li>\n                ))}\n              </ul>\n            )}\n            {history && totalPages > 1 && (\n              <div className=\"mt-4 flex items-center gap-3\">\n                <button\n                  disabled={page <= 1}\n                  onClick={() => loadHistory(page - 1)}\n                  className=\"rounded border border-slate-300 px-3 py-1 text-sm disabled:opacity-40\"\n                >\n                  Previous\n                </button>\n                <span className=\"text-sm text-slate-600\">\n                  Page {page} of {totalPages}\n                </span>\n                <button\n                  disabled={page >= totalPages}\n                  onClick={() => loadHistory(page + 1)}\n                  className=\"rounded border border-slate-300 px-3 py-1 text-sm disabled:opacity-40\"\n                >\n                  Next\n                </button>\n              </div>\n            )}\n          </section>\n        )}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794358503364,"end":1794358503373}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c819e7be001YiNfCKREMQq8bc","sessionID":"ses_e37e816c5ffeg3OB6PExrifaO4","messageID":"msg_1c8198f54001otEIIyAYoDjvaU"}}
