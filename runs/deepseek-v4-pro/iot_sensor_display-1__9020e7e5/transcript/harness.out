{"type":"tool_use","timestamp":1794373451876,"sessionID":"ses_e37041b37ffeSv7ZGxKRNhyHIU","part":{"type":"tool","tool":"write","callID":"call_l63xcya9m368f9pu5asa01bu","state":{"status":"completed","input":{"content":"export interface Sensor {\n  id: number;\n  name: string;\n  unit: string;\n  location: string;\n  owner: string;\n  last_value: number | null;\n  last_updated: string | null;\n}\n\nexport interface Reading {\n  id: number;\n  sensor_id: number;\n  value: number;\n  recorded_at: string;\n}\n\nexport async function api<T>(\n  path: string,\n  options: { method?: string; body?: unknown; token?: string | null } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.token) headers[\"Authorization\"] = `Bearer ${options.token}`;\n\n  const res = await fetch(`/api${path}`, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n  });\n\n  if (res.status === 204) return undefined as T;\n\n  const text = await res.text();\n  const data = text ? JSON.parse(text) : null;\n\n  if (!res.ok) {\n    throw new Error(data?.error ?? `Request failed (${res.status})`);\n  }\n  return data as T;\n}\n\nexport function timeAgo(iso: string | null): string {\n  if (!iso) return \"never\";\n  const diff = Date.now() - new Date(iso).getTime();\n  const seconds = Math.floor(diff / 1000);\n  if (seconds < 5) return \"just now\";\n  if (seconds < 60) return `${seconds}s ago`;\n  const minutes = Math.floor(seconds / 60);\n  if (minutes < 60) return `${minutes}m ago`;\n  const hours = Math.floor(minutes / 60);\n  if (hours < 24) return `${hours}h ago`;\n  const days = Math.floor(hours / 24);\n  return `${days}d ago`;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794373451832,"end":1794373451850}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8fe0032001etm6a5QxL0n7Zf","sessionID":"ses_e37041b37ffeSv7ZGxKRNhyHIU","messageID":"msg_1c8fdd107001z8wRfemnkyFvGA"}}
{"type":"tool_use","timestamp":1794373451876,"sessionID":"ses_e37041b37ffeSv7ZGxKRNhyHIU","part":{"type":"tool","tool":"write","callID":"call_tnrovshfd9hwsk5l7b65h92q","state":{"status":"completed","input":{"content":"import {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useState,\n  type ReactNode,\n} from \"react\";\n\ninterface AuthState {\n  token: string | null;\n  username: string | null;\n  signIn: (token: string, username: string) => void;\n  signOut: () => void;\n}\n\nconst AuthContext = createContext<AuthState>({\n  token: null,\n  username: null,\n  signIn: () => {},\n  signOut: () => {},\n});\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [token, setToken] = useState<string | null>(() =>\n    localStorage.getItem(\"token\"),\n  );\n  const [username, setUsername] = useState<string | null>(() =>\n    localStorage.getItem(\"username\"),\n  );\n\n  const signIn = useCallback((nextToken: string, nextUsername: string) => {\n    localStorage.setItem(\"token\", nextToken);\n    localStorage.setItem(\"username\", nextUsername);\n    setToken(nextToken);\n    setUsername(nextUsername);\n  }, []);\n\n  const signOut = useCallback(() => {\n    localStorage.removeItem(\"token\");\n    localStorage.removeItem(\"username\");\n    setToken(null);\n    setUsername(null);\n  }, []);\n\n  return (\n    <AuthContext.Provider value={{ token, username, signIn, signOut }}>\n      {children}\n    </AuthContext.Provider>\n  );\n}\n\nexport function useAuth() {\n  return useContext(AuthContext);\n}\n","filePath":"/workspace/frontend/src/auth.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/auth.tsx","exists":false,"truncated":false},"title":"frontend/src/auth.tsx","time":{"start":1794373451842,"end":1794373451855}},"id":"prt_1c8fe003b001s6t815xkYEgZLk","sessionID":"ses_e37041b37ffeSv7ZGxKRNhyHIU","messageID":"msg_1c8fdd107001z8wRfemnkyFvGA"}}
