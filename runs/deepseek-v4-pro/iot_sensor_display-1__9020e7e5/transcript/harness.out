{"type":"tool_use","timestamp":1794373432899,"sessionID":"ses_e37041b37ffeSv7ZGxKRNhyHIU","part":{"type":"tool","tool":"write","callID":"call_csewgwwa5aqpy6t8rwvnxfit","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the sensor dashboard.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS sessions (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\n\nCREATE TABLE IF NOT EXISTS sensors (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    name TEXT NOT NULL,\n    unit TEXT NOT NULL,\n    location TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS readings (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n    value REAL NOT NULL,\n    recorded_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_sensors_owner ON sensors(owner_id);\nCREATE INDEX IF NOT EXISTS idx_readings_sensor ON readings(sensor_id);\n\"\"\"\n\n\ndef get_db():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(SCHEMA)\n    db.commit()\n    db.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM sessions s JOIN users u ON u.id = s.user_id \"\n        \"WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef sensor_payload(row, owner_username):\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"owner\": owner_username,\n        \"last_value\": row[\"last_value\"],\n        \"last_updated\": row[\"last_updated\"],\n    }\n\n\nSENSOR_SELECT = \"\"\"\nSELECT s.id, s.name, s.unit, s.location, u.username AS owner,\n       (SELECT r.value FROM readings r WHERE r.sensor_id = s.id\n        ORDER BY r.id DESC LIMIT 1) AS last_value,\n       (SELECT r.recorded_at FROM readings r WHERE r.sensor_id = s.id\n        ORDER BY r.id DESC LIMIT 1) AS last_updated\nFROM sensors s\nJOIN users u ON u.id = s.owner_id\n\"\"\"\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    db = get_db()\n    exists = db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if exists:\n        return jsonify({\"error\": \"username already taken\"}), 409\n\n    db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return {\"username\": username}, 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO sessions (token, user_id) VALUES (?, ?)\", (token, row[\"id\"])\n    )\n    db.commit()\n    return {\"token\": token, \"username\": row[\"username\"]}\n\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = get_db().execute(SENSOR_SELECT + \" ORDER BY s.name\").fetchall()\n    return {\"items\": [sensor_payload(r, r[\"owner\"]) for r in rows]}\n\n\n@app.post(\"/api/sensors\")\n@require_user\ndef create_sensor():\n    data = request.get_json(silent=True) or {}\n    name = (data.get(\"name\") or \"\").strip()\n    unit = (data.get(\"unit\") or \"\").strip()\n    location = (data.get(\"location\") or \"\").strip()\n\n    if not name:\n        return jsonify({\"error\": \"name is required\"}), 400\n\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO sensors (owner_id, name, unit, location) VALUES (?, ?, ?, ?)\",\n        (g.user[\"id\"], name, unit, location),\n    )\n    db.commit()\n    sensor_id = cur.lastrowid\n    return jsonify(get_sensor(sensor_id)[0].get_json()), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef get_sensor(sensor_id):\n    row = get_db().execute(\n        SENSOR_SELECT + \" WHERE s.id = ?\", (sensor_id,)\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"sensor not found\"}), 404\n    return jsonify(sensor_payload(row, row[\"owner\"]))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\n@require_user\ndef delete_sensor(sensor_id):\n    db = get_db()\n    row = db.execute(\n        \"SELECT id FROM sensors WHERE id = ? AND owner_id = ?\",\n        (sensor_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"sensor not found\"}), 404\n    db.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id):\n    db = get_db()\n    sensor = db.execute(\n        \"SELECT id FROM sensors WHERE id = ?\", (sensor_id,)\n    ).fetchone()\n    if sensor is None:\n        return jsonify({\"error\": \"sensor not found\"}), 404\n\n    try:\n        limit = int(request.args.get(\"limit\", 100))\n    except (TypeError, ValueError):\n        limit = 100\n    limit = max(1, min(limit, 1000))\n\n    total = db.execute(\n        \"SELECT COUNT(*) AS c FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[\"c\"]\n\n    rows = db.execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings \"\n        \"WHERE sensor_id = ? ORDER BY id DESC LIMIT ?\",\n        (sensor_id, limit),\n    ).fetchall()\n\n    items = [\n        {\n            \"id\": r[\"id\"],\n            \"sensor_id\": r[\"sensor_id\"],\n            \"value\": r[\"value\"],\n            \"recorded_at\": r[\"recorded_at\"],\n        }\n        for r in rows\n    ]\n    return {\"items\": items, \"total\": total}\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\n@require_user\ndef create_reading(sensor_id):\n    db = get_db()\n    sensor = db.execute(\n        \"SELECT id FROM sensors WHERE id = ? AND owner_id = ?\",\n        (sensor_id, g.user[\"id\"]),\n    ).fetchone()\n    if sensor is None:\n        return jsonify({\"error\": \"sensor not found\"}), 404\n\n    data = request.get_json(silent=True) or {}\n    value = data.get(\"value\")\n    if value is None:\n        return jsonify({\"error\": \"value is required\"}), 400\n    try:\n        value = float(value)\n    except (TypeError, ValueError):\n        return jsonify({\"error\": \"value must be a number\"}), 400\n\n    cur = db.execute(\n        \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n        (sensor_id, value, now_iso()),\n    )\n    db.commit()\n    reading_id = cur.lastrowid\n\n    row = db.execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings WHERE id = ?\",\n        (reading_id,),\n    ).fetchone()\n    return (\n        jsonify(\n            {\n                \"id\": row[\"id\"],\n                \"sensor_id\": row[\"sensor_id\"],\n                \"value\": row[\"value\"],\n                \"recorded_at\": row[\"recorded_at\"],\n            }\n        ),\n        201,\n    )\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794373432808,"end":1794373432832}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8fdb5e0001swkPH6QydPUDdZ","sessionID":"ses_e37041b37ffeSv7ZGxKRNhyHIU","messageID":"msg_1c8fd5a95001auAsVrCc4Bt1c3"}}
