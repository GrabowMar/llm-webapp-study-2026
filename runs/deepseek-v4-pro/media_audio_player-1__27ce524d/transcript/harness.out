{"type":"tool_use","timestamp":1794383074051,"sessionID":"ses_e3672e1a6ffehdb0VczbWI4BJw","part":{"type":"tool","tool":"write","callID":"call_iz53yi7ilzw43j9ybm2l3ds6","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useRef, useState } from \"react\";\nimport {\n  Track,\n  addTrack,\n  clearSession,\n  deleteTrack,\n  formatDuration,\n  getToken,\n  getUsername,\n  listTracks,\n  login,\n  recordPlay,\n  register,\n  saveSession,\n} from \"./api\";\n\nconst PAGE_SIZE = 10;\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(getUsername());\n  const [tracks, setTracks] = useState<Track[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [query, setQuery] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n\n  const [current, setCurrent] = useState<Track | null>(null);\n  const [index, setIndex] = useState(-1);\n\n  const fetchTracks = useCallback(async () => {\n    setLoading(true);\n    try {\n      const res = await listTracks(search, page, PAGE_SIZE);\n      setTracks(res.items);\n      setTotal(res.total);\n    } catch {\n      setTracks([]);\n      setTotal(0);\n    } finally {\n      setLoading(false);\n    }\n  }, [search, page]);\n\n  useEffect(() => {\n    fetchTracks();\n  }, [fetchTracks]);\n\n  function onAuthed(token: string, name: string) {\n    saveSession(token, name);\n    setUsername(name);\n  }\n\n  function signOut() {\n    clearSession();\n    setUsername(null);\n  }\n\n  function playTrack(track: Track, i: number) {\n    setCurrent(track);\n    setIndex(i);\n  }\n\n  function playNext() {\n    if (index >= 0 && index < tracks.length - 1) {\n      playTrack(tracks[index + 1], index + 1);\n    }\n  }\n\n  function playPrev() {\n    if (index > 0) {\n      playTrack(tracks[index - 1], index - 1);\n    }\n  }\n\n  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));\n\n  return (\n    <div className=\"min-h-screen bg-neutral-950 text-neutral-100\">\n      <header className=\"border-b border-neutral-800\">\n        <div className=\"mx-auto flex max-w-4xl items-center justify-between px-4 py-4\">\n          <h1 className=\"text-xl font-semibold tracking-tight\">Audio Player</h1>\n          {username ? (\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-sm text-neutral-300\">\n                Signed in as{\" \"}\n                <span className=\"font-medium text-emerald-400\">{username}</span>\n              </span>\n              <button\n                onClick={signOut}\n                className=\"rounded-md border border-neutral-700 px-3 py-1.5 text-sm hover:bg-neutral-800\"\n              >\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <AuthForms onAuthed={onAuthed} />\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-4xl px-4 pb-40 pt-6\">\n        {username && <AddTrackForm onAdded={fetchTracks} />}\n\n        <section className=\"mt-8\">\n          <div className=\"mb-4 flex items-center justify-between\">\n            <h2 className=\"text-lg font-medium\">Tracks</h2>\n            <form\n              onSubmit={(e) => {\n                e.preventDefault();\n                setPage(1);\n                setSearch(query);\n              }}\n              className=\"flex gap-2\"\n            >\n              <input\n                value={query}\n                onChange={(e) => setQuery(e.target.value)}\n                placeholder=\"Search title, artist…\"\n                className=\"w-64 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-1.5 text-sm outline-none focus:border-emerald-500\"\n              />\n              <button\n                type=\"submit\"\n                className=\"rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium hover:bg-emerald-500\"\n              >\n                Search\n              </button>\n            </form>\n          </div>\n\n          {loading ? (\n            <p className=\"py-10 text-center text-neutral-400\">Loading…</p>\n          ) : tracks.length === 0 ? (\n            <p className=\"py-10 text-center text-neutral-400\">No tracks yet.</p>\n          ) : (\n            <ul className=\"divide-y divide-neutral-800 rounded-lg border border-neutral-800\">\n              {tracks.map((track, i) => (\n                <TrackRow\n                  key={track.id}\n                  track={track}\n                  isCurrent={current?.id === track.id}\n                  canDelete={username != null && track.added_by === username}\n                  onPlay={() => playTrack(track, i)}\n                  onDeleted={() => {\n                    if (current?.id === track.id) setCurrent(null);\n                    fetchTracks();\n                  }}\n                />\n              ))}\n            </ul>\n          )}\n\n          {totalPages > 1 && (\n            <div className=\"mt-6 flex items-center justify-center gap-3\">\n              <button\n                disabled={page <= 1}\n                onClick={() => setPage((p) => p - 1)}\n                className=\"rounded-md border border-neutral-700 px-3 py-1.5 text-sm disabled:opacity-40\"\n              >\n                Previous\n              </button>\n              <span className=\"text-sm text-neutral-300\">\n                Page {page} of {totalPages}\n              </span>\n              <button\n                disabled={page >= totalPages}\n                onClick={() => setPage((p) => p + 1)}\n                className=\"rounded-md border border-neutral-700 px-3 py-1.5 text-sm disabled:opacity-40\"\n              >\n                Next\n              </button>\n            </div>\n          )}\n        </section>\n      </main>\n\n      <PlayerBar\n        track={current}\n        onNext={playNext}\n        onPrev={playPrev}\n        hasNext={index < tracks.length - 1}\n        hasPrev={index > 0}\n      />\n    </div>\n  );\n}\n\nfunction AuthForms({ onAuthed }: { onAuthed: (t: string, u: string) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setBusy(true);\n    try {\n      const res =\n        mode === \"login\"\n          ? await login(username, password)\n          : await register(username, password);\n      onAuthed(res.token, res.username);\n    } catch (err) {\n      setError((err as Error).message);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"flex items-center gap-2\">\n      <input\n        value={username}\n        onChange={(e) => setUsername(e.target.value)}\n        placeholder=\"Username\"\n        className=\"w-32 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-1.5 text-sm outline-none focus:border-emerald-500\"\n        required\n      />\n      <input\n        type=\"password\"\n        value={password}\n        onChange={(e) => setPassword(e.target.value)}\n        placeholder=\"Password\"\n        className=\"w-32 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-1.5 text-sm outline-none focus:border-emerald-500\"\n        required\n      />\n      <button\n        type=\"submit\"\n        disabled={busy}\n        className=\"rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium hover:bg-emerald-500 disabled:opacity-50\"\n      >\n        {mode === \"login\" ? \"Sign in\" : \"Register\"}\n      </button>\n      <button\n        type=\"button\"\n        onClick={() => {\n          setMode(mode === \"login\" ? \"register\" : \"login\");\n          setError(\"\");\n        }}\n        className=\"text-sm text-neutral-400 underline hover:text-neutral-200\"\n      >\n        {mode === \"login\" ? \"Register\" : \"Sign in\"}\n      </button>\n      {error && <span className=\"text-xs text-red-400\">{error}</span>}\n    </form>\n  );\n}\n\nfunction AddTrackForm({ onAdded }: { onAdded: () => void }) {\n  const [title, setTitle] = useState(\"\");\n  const [artist, setArtist] = useState(\"\");\n  const [url, setUrl] = useState(\"\");\n  const [duration, setDuration] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setBusy(true);\n    try {\n      await addTrack({\n        title,\n        artist,\n        url,\n        duration: duration ? Number(duration) : undefined,\n      });\n      setTitle(\"\");\n      setArtist(\"\");\n      setUrl(\"\");\n      setDuration(\"\");\n      onAdded();\n    } catch (err) {\n      setError((err as Error).message);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"rounded-lg border border-neutral-800 bg-neutral-900/50 p-4\"\n    >\n      <h2 className=\"mb-3 text-lg font-medium\">Add a track</h2>\n      <div className=\"grid gap-3 sm:grid-cols-2\">\n        <input\n          value={title}\n          onChange={(e) => setTitle(e.target.value)}\n          placeholder=\"Title\"\n          className=\"rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm outline-none focus:border-emerald-500\"\n          required\n        />\n        <input\n          value={artist}\n          onChange={(e) => setArtist(e.target.value)}\n          placeholder=\"Artist\"\n          className=\"rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm outline-none focus:border-emerald-500\"\n        />\n        <input\n          value={url}\n          onChange={(e) => setUrl(e.target.value)}\n          placeholder=\"Audio URL (http/https)\"\n          className=\"rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm outline-none focus:border-emerald-500 sm:col-span-2\"\n          required\n        />\n        <input\n          value={duration}\n          onChange={(e) => setDuration(e.target.value)}\n          placeholder=\"Duration in seconds (optional)\"\n          type=\"number\"\n          min=\"0\"\n          className=\"rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm outline-none focus:border-emerald-500\"\n        />\n      </div>\n      {error && <p className=\"mt-2 text-sm text-red-400\">{error}</p>}\n      <button\n        type=\"submit\"\n        disabled={busy}\n        className=\"mt-3 rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium hover:bg-emerald-500 disabled:opacity-50\"\n      >\n        Add track\n      </button>\n    </form>\n  );\n}\n\nfunction TrackRow({\n  track,\n  isCurrent,\n  canDelete,\n  onPlay,\n  onDeleted,\n}: {\n  track: Track;\n  isCurrent: boolean;\n  canDelete: boolean;\n  onPlay: () => void;\n  onDeleted: () => void;\n}) {\n  const [confirming, setConfirming] = useState(false);\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState(\"\");\n\n  async function doDelete() {\n    setBusy(true);\n    setError(\"\");\n    try {\n      await deleteTrack(track.id);\n      onDeleted();\n    } catch (err) {\n      setError((err as Error).message);\n      setBusy(false);\n    }\n  }\n\n  return (\n    <li\n      className={`flex items-center gap-4 px-4 py-3 ${\n        isCurrent ? \"bg-emerald-950/40\" : \"\"\n      }`}\n    >\n      <button\n        onClick={onPlay}\n        title=\"Play\"\n        className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white hover:bg-emerald-500\"\n      >\n        {isCurrent ? \"❚❚\" : \"▶\"}\n      </button>\n      <div className=\"min-w-0 flex-1\">\n        <p className=\"truncate font-medium\">{track.title}</p>\n        <p className=\"truncate text-sm text-neutral-400\">\n          {track.artist || \"Unknown artist\"}\n        </p>\n      </div>\n      <div className=\"hidden text-right text-sm text-neutral-400 sm:block\">\n        <p>{formatDuration(track.duration)}</p>\n        <p>{track.play_count} plays</p>\n      </div>\n      {canDelete && (\n        <div className=\"flex items-center gap-2\">\n          {error && <span className=\"text-xs text-red-400\">{error}</span>}\n          {confirming ? (\n            <>\n              <button\n                onClick={doDelete}\n                disabled={busy}\n                className=\"rounded-md bg-red-600 px-2 py-1 text-xs font-medium hover:bg-red-500 disabled:opacity-50\"\n              >\n                Confirm\n              </button>\n              <button\n                onClick={() => setConfirming(false)}\n                className=\"rounded-md border border-neutral-700 px-2 py-1 text-xs hover:bg-neutral-800\"\n              >\n                Cancel\n              </button>\n            </>\n          ) : (\n            <button\n              onClick={() => setConfirming(true)}\n              className=\"rounded-md border border-neutral-700 px-2 py-1 text-xs text-neutral-300 hover:bg-neutral-800\"\n            >\n              Delete\n            </button>\n          )}\n        </div>\n      )}\n    </li>\n  );\n}\n\nfunction PlayerBar({\n  track,\n  onNext,\n  onPrev,\n  hasNext,\n  hasPrev,\n}: {\n  track: Track | null;\n  onNext: () => void;\n  onPrev: () => void;\n  hasNext: boolean;\n  hasPrev: boolean;\n}) {\n  const audioRef = useRef<HTMLAudioElement | null>(null);\n  const [playing, setPlaying] = useState(false);\n  const [time, setTime] = useState(0);\n  const [duration, setDuration] = useState(0);\n  const [volume, setVolume] = useState(1);\n  const recordedRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    if (track) {\n      setPlaying(false);\n      setTime(0);\n      setDuration(track.duration || 0);\n      recordedRef.current = null;\n    }\n  }, [track]);\n\n  function toggle() {\n    const el = audioRef.current;\n    if (!el || !track) return;\n    if (el.paused) {\n      el.play();\n    } else {\n      el.pause();\n    }\n  }\n\n  function handlePlay() {\n    setPlaying(true);\n    if (track && recordedRef.current !== track.id) {\n      recordedRef.current = track.id;\n      recordPlay(track.id).catch(() => {});\n    }\n  }\n\n  function handleTime() {\n    const el = audioRef.current;\n    if (el) setTime(el.currentTime);\n  }\n\n  function handleLoaded() {\n    const el = audioRef.current;\n    if (el && (!track?.duration || !isFinite(el.duration) || el.duration === 0)) {\n      setDuration(el.duration || 0);\n    }\n  }\n\n  function handleSeek(e: React.ChangeEvent<HTMLInputElement>) {\n    const el = audioRef.current;\n    const v = Number(e.target.value);\n    setTime(v);\n    if (el) el.currentTime = v;\n  }\n\n  function handleVolume(e: React.ChangeEvent<HTMLInputElement>) {\n    const v = Number(e.target.value);\n    setVolume(v);\n    if (audioRef.current) audioRef.current.volume = v;\n  }\n\n  const durationTotal = duration || track?.duration || 0;\n\n  return (\n    <div className=\"fixed bottom-0 left-0 right-0 border-t border-neutral-800 bg-neutral-900/95 backdrop-blur\">\n      {track ? (\n        <audio\n          ref={audioRef}\n          src={track.url}\n          onPlay={handlePlay}\n          onPause={() => setPlaying(false)}\n          onTimeUpdate={handleTime}\n          onLoadedMetadata={handleLoaded}\n          onEnded={onNext}\n          autoPlay\n        />\n      ) : null}\n      <div className=\"mx-auto max-w-4xl px-4 py-3\">\n        <div className=\"mb-2 flex items-center justify-between\">\n          <span className=\"text-xs tabular-nums text-neutral-400\">\n            {formatDuration(time)}\n          </span>\n          <input\n            type=\"range\"\n            min={0}\n            max={durationTotal || 0}\n            step={1}\n            value={Math.min(time, durationTotal || 0)}\n            onChange={handleSeek}\n            disabled={!track || durationTotal === 0}\n            className=\"mx-4 flex-1\"\n          />\n          <span className=\"text-xs tabular-nums text-neutral-400\">\n            {formatDuration(durationTotal)}\n          </span>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={onPrev}\n              disabled={!hasPrev}\n              className=\"rounded-md border border-neutral-700 px-3 py-1.5 text-sm disabled:opacity-40\"\n            >\n              ⏮\n            </button>\n            <button\n              onClick={toggle}\n              disabled={!track}\n              className=\"flex h-10 w-10 items-center justify-center rounded-full bg-emerald-600 text-white hover:bg-emerald-500 disabled:opacity-40\"\n            >\n              {playing ? \"❚❚\" : \"▶\"}\n            </button>\n            <button\n              onClick={onNext}\n              disabled={!hasNext}\n              className=\"rounded-md border border-neutral-700 px-3 py-1.5 text-sm disabled:opacity-40\"\n            >\n              ⏭\n            </button>\n          </div>\n          <div className=\"min-w-0 flex-1\">\n            <p className=\"truncate text-sm font-medium\">\n              {track ? track.title : \"Nothing playing\"}\n            </p>\n            <p className=\"truncate text-xs text-neutral-400\">\n              {track ? track.artist || \"Unknown artist\" : \"\"}\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs text-neutral-400\">🔊</span>\n            <input\n              type=\"range\"\n              min={0}\n              max={1}\n              step={0.01}\n              value={volume}\n              onChange={handleVolume}\n              className=\"w-24\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n// keep getToken referenced for potential future use\nvoid getToken;\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794383074018,"end":1794383074029}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c990d2dd001ZaoNXSEVKt407C","sessionID":"ses_e3672e1a6ffehdb0VczbWI4BJw","messageID":"msg_1c99039ba001v8NPk4PryCzOJT"}}
