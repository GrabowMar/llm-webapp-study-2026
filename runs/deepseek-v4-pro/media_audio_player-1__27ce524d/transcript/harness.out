{"type":"tool_use","timestamp":1794383034816,"sessionID":"ses_e3672e1a6ffehdb0VczbWI4BJw","part":{"type":"tool","tool":"write","callID":"call_8wlm4ev5df8kcusorvu0haey","state":{"status":"completed","input":{"content":"export interface Track {\n  id: number;\n  title: string;\n  artist: string;\n  url: string;\n  duration: number;\n  play_count: number;\n  created_at: string;\n  added_by: string;\n}\n\nexport interface TrackPage {\n  items: Track[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\ninterface AuthResponse {\n  token: string;\n  username: string;\n}\n\nconst TOKEN_KEY = \"audio_player_token\";\nconst USERNAME_KEY = \"audio_player_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function saveSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.body ? { \"Content-Type\": \"application/json\" } : {}),\n    ...((options.headers as Record<string, string>) || {}),\n  };\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const res = await fetch(path, { ...options, headers });\n  const data = await res.json().catch(() => ({}));\n  if (!res.ok) {\n    const message =\n      (data as { error?: string }).error || `Request failed (${res.status})`;\n    throw new Error(message);\n  }\n  return data as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<AuthResponse>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<AuthResponse>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function listTracks(\n  q: string,\n  page: number,\n  pageSize: number,\n): Promise<TrackPage> {\n  const params = new URLSearchParams();\n  if (q) params.set(\"q\", q);\n  params.set(\"page\", String(page));\n  params.set(\"page_size\", String(pageSize));\n  return request<TrackPage>(`/api/tracks?${params.toString()}`);\n}\n\nexport function addTrack(input: {\n  title: string;\n  artist: string;\n  url: string;\n  duration?: number;\n}): Promise<Track> {\n  return request<Track>(\"/api/tracks\", {\n    method: \"POST\",\n    body: JSON.stringify(input),\n  });\n}\n\nexport function deleteTrack(id: number): Promise<{ deleted: boolean }> {\n  return request<{ deleted: boolean }>(`/api/tracks/${id}`, {\n    method: \"DELETE\",\n  });\n}\n\nexport function recordPlay(id: number): Promise<Track> {\n  return request<Track>(`/api/tracks/${id}/plays`, { method: \"POST\" });\n}\n\nexport function formatDuration(seconds: number): string {\n  const s = Math.max(0, Math.floor(seconds));\n  const m = Math.floor(s / 60);\n  const r = s % 60;\n  return `${m}:${r.toString().padStart(2, \"0\")}`;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794383034789,"end":1794383034797}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c99039a0001fU3XfyrwheI1gK","sessionID":"ses_e3672e1a6ffehdb0VczbWI4BJw","messageID":"msg_1c9901556001naA1zO64tnK5Jd"}}
