{"type":"tool_use","timestamp":1794363652553,"sessionID":"ses_e379b3931ffegOfSsp4ywBnfbO","part":{"type":"tool","tool":"write","callID":"call_4tddeknrwgh1pqhg6lhieei2","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\n\ntype Preview = {\n  id: number;\n  url: string;\n  final_url: string;\n  status_code: number | null;\n  title: string | null;\n  description: string | null;\n  image_url: string | null;\n  fetched_at: string;\n};\n\ntype ListResponse = {\n  items: Preview[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nconst TOKEN_KEY = \"token\";\nconst USERNAME_KEY = \"username\";\n\nfunction getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nfunction getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nasync function api<T>(\n  path: string,\n  options: RequestInit = {},\n): Promise<{ ok: boolean; status: number; data: T | { error?: string } }> {\n  const token = getToken();\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(path, { ...options, headers });\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  return { ok: res.ok, status: res.status, data: data as T };\n}\n\nfunction hostOf(url: string): string {\n  try {\n    return new URL(url).host;\n  } catch {\n    return url;\n  }\n}\n\nfunction formatDate(iso: string): string {\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return iso;\n  return d.toLocaleString();\n}\n\nfunction AuthScreen({\n  onAuthed,\n}: {\n  onAuthed: (username: string) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setLoading(true);\n    try {\n      const res = await api<{ token?: string; error?: string }>(\n        `/api/auth/${mode}`,\n        {\n          method: \"POST\",\n          body: JSON.stringify({ username, password }),\n        },\n      );\n      if (mode === \"register\") {\n        if (res.ok) {\n          setMode(\"login\");\n          setPassword(\"\");\n          setError(\"Account created — sign in below.\");\n          return;\n        }\n        setError((res.data as { error?: string }).error ?? \"Registration failed\");\n      } else {\n        if (res.ok && (res.data as { token?: string }).token) {\n          localStorage.setItem(TOKEN_KEY, (res.data as { token: string }).token);\n          localStorage.setItem(USERNAME_KEY, username);\n          onAuthed(username);\n          return;\n        }\n        setError((res.data as { error?: string }).error ?? \"Invalid credentials\");\n      }\n    } catch {\n      setError(\"Network error\");\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center bg-slate-50 p-4\">\n      <form\n        onSubmit={submit}\n        className=\"w-full max-w-sm bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4\"\n      >\n        <div className=\"flex gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\"login\");\n              setError(null);\n            }}\n            className={`flex-1 py-2 rounded-lg text-sm font-medium ${\n              mode === \"login\"\n                ? \"bg-slate-900 text-white\"\n                : \"bg-slate-100 text-slate-600\"\n            }`}\n          >\n            Sign in\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\"register\");\n              setError(null);\n            }}\n            className={`flex-1 py-2 rounded-lg text-sm font-medium ${\n              mode === \"register\"\n                ? \"bg-slate-900 text-white\"\n                : \"bg-slate-100 text-slate-600\"\n            }`}\n          >\n            Register\n          </button>\n        </div>\n\n        <div>\n          <label className=\"block text-sm font-medium text-slate-700 mb-1\">\n            Username\n          </label>\n          <input\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-400\"\n            autoComplete=\"username\"\n          />\n        </div>\n        <div>\n          <label className=\"block text-sm font-medium text-slate-700 mb-1\">\n            Password\n          </label>\n          <input\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-400\"\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n          />\n        </div>\n\n        {error && (\n          <p className=\"text-sm text-red-600\">{error}</p>\n        )}\n\n        <button\n          type=\"submit\"\n          disabled={loading || !username || !password}\n          className=\"w-full py-2 rounded-lg bg-slate-900 text-white text-sm font-medium disabled:opacity-50\"\n        >\n          {loading\n            ? \"Please wait…\"\n            : mode === \"login\"\n              ? \"Sign in\"\n              : \"Create account\"}\n        </button>\n      </form>\n    </div>\n  );\n}\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(getUsername());\n  const [token, setToken] = useState<string | null>(getToken());\n\n  const [url, setUrl] = useState(\"\");\n  const [adding, setAdding] = useState(false);\n  const [addError, setAddError] = useState<string | null>(null);\n\n  const [items, setItems] = useState<Preview[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [pageSize] = useState(10);\n  const [loading, setLoading] = useState(false);\n\n  const load = useCallback(async (pageNum: number) => {\n    setLoading(true);\n    try {\n      const res = await api<ListResponse>(\n        `/api/previews?page=${pageNum}&page_size=${pageSize}`,\n      );\n      if (res.ok) {\n        const data = res.data as ListResponse;\n        setItems(data.items);\n        setTotal(data.total);\n        setPage(data.page);\n      } else if (res.status === 401) {\n        signOut();\n      }\n    } catch {\n      /* ignore */\n    } finally {\n      setLoading(false);\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [pageSize]);\n\n  function signOut() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USERNAME_KEY);\n    setToken(null);\n    setUsername(null);\n    setItems([]);\n    setTotal(0);\n  }\n\n  useEffect(() => {\n    if (token) load(1);\n  }, [token, load]);\n\n  async function add(e: React.FormEvent) {\n    e.preventDefault();\n    if (!url.trim()) return;\n    setAddError(null);\n    setAdding(true);\n    try {\n      const res = await api<Preview>(\"/api/previews\", {\n        method: \"POST\",\n        body: JSON.stringify({ url: url.trim() }),\n      });\n      if (res.ok) {\n        setUrl(\"\");\n        await load(1);\n      } else if (res.status === 401) {\n        signOut();\n      } else {\n        setAddError((res.data as { error?: string }).error ?? \"Could not add link\");\n      }\n    } catch {\n      setAddError(\"Network error\");\n    } finally {\n      setAdding(false);\n    }\n  }\n\n  async function refresh(id: number) {\n    setAddError(null);\n    const res = await api<Preview>(`/api/previews/${id}/refresh`, {\n      method: \"POST\",\n    });\n    if (res.ok) {\n      await load(page);\n    } else if (res.status === 401) {\n      signOut();\n    }\n  }\n\n  async function remove(id: number) {\n    setAddError(null);\n    const res = await api(`/api/previews/${id}`, { method: \"DELETE\" });\n    if (res.ok) {\n      if (items.length === 1 && page > 1) {\n        await load(page - 1);\n      } else {\n        await load(page);\n      }\n    } else if (res.status === 401) {\n      signOut();\n    }\n  }\n\n  if (!token || !username) {\n    return (\n      <AuthScreen\n        onAuthed={(name) => {\n          setUsername(name);\n          setToken(getToken());\n        }}\n      />\n    );\n  }\n\n  const totalPages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <div className=\"min-h-screen bg-slate-50\">\n      <header className=\"bg-white border-b border-slate-200\">\n        <div className=\"max-w-3xl mx-auto px-4 py-4 flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-lg font-semibold text-slate-900\">Links</h1>\n            <p className=\"text-sm text-slate-500\">Signed in as {username}</p>\n          </div>\n          <button\n            onClick={signOut}\n            className=\"text-sm font-medium text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg border border-slate-300\"\n          >\n            Sign out\n          </button>\n        </div>\n      </header>\n\n      <main className=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n        <form onSubmit={add} className=\"flex gap-2\">\n          <input\n            value={url}\n            onChange={(e) => setUrl(e.target.value)}\n            placeholder=\"Paste a link (https://…)\"\n            className=\"flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-400\"\n          />\n          <button\n            type=\"submit\"\n            disabled={adding || !url.trim()}\n            className=\"px-5 py-2 rounded-lg bg-slate-900 text-white text-sm font-medium disabled:opacity-50\"\n          >\n            {adding ? \"Adding…\" : \"Add\"}\n          </button>\n        </form>\n        {addError && <p className=\"text-sm text-red-600\">{addError}</p>}\n\n        {loading && items.length === 0 ? (\n          <p className=\"text-sm text-slate-500\">Loading…</p>\n        ) : items.length === 0 ? (\n          <p className=\"text-sm text-slate-500\">No links saved yet.</p>\n        ) : (\n          <ul className=\"space-y-4\">\n            {items.map((p) => (\n              <li\n                key={p.id}\n                className=\"bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden\"\n              >\n                <div className=\"flex\">\n                  {p.image_url && (\n                    <img\n                      src={p.image_url}\n                      alt=\"\"\n                      className=\"w-32 h-24 object-cover shrink-0 bg-slate-100\"\n                      onError={(e) => {\n                        (e.target as HTMLImageElement).style.display = \"none\";\n                      }}\n                    />\n                  )}\n                  <div className=\"flex-1 min-w-0 p-4\">\n                    <a\n                      href={p.final_url}\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                      className=\"font-semibold text-slate-900 hover:underline\"\n                    >\n                      {p.title || hostOf(p.final_url)}\n                    </a>\n                    <p className=\"text-xs text-slate-400 mt-0.5\">\n                      {hostOf(p.final_url)}\n                    </p>\n                    {p.description && (\n                      <p className=\"text-sm text-slate-600 mt-2 line-clamp-2\">\n                        {p.description}\n                      </p>\n                    )}\n                    <div className=\"flex items-center gap-3 mt-3\">\n                      <span className=\"text-xs text-slate-400\">\n                        {formatDate(p.fetched_at)}\n                      </span>\n                      <button\n                        onClick={() => refresh(p.id)}\n                        className=\"text-xs font-medium text-slate-600 hover:text-slate-900\"\n                      >\n                        Refresh\n                      </button>\n                      <button\n                        onClick={() => remove(p.id)}\n                        className=\"text-xs font-medium text-red-600 hover:text-red-700\"\n                      >\n                        Delete\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </li>\n            ))}\n          </ul>\n        )}\n\n        {total > 0 && (\n          <div className=\"flex items-center justify-between\">\n            <button\n              disabled={page <= 1}\n              onClick={() => load(page - 1)}\n              className=\"text-sm font-medium text-slate-600 disabled:opacity-40\"\n            >\n              Previous\n            </button>\n            <span className=\"text-sm text-slate-500\">\n              Page {page} of {totalPages}\n            </span>\n            <button\n              disabled={page >= totalPages}\n              onClick={() => load(page + 1)}\n              className=\"text-sm font-medium text-slate-600 disabled:opacity-40\"\n            >\n              Next\n            </button>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794363652523,"end":1794363652533}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c86879a6001LsjzGtJf1xeYHC","sessionID":"ses_e379b3931ffegOfSsp4ywBnfbO","messageID":"msg_1c86806bb001ePgpDkEAEqtC8t"}}
