rwin-x64\": \"1.2.16\",\n        \"@rolldown/binding-freebsd-x64\": \"1.2.16\",\n        \"@rolldown/binding-linux-arm-gnueabihf\": \"1.2.16\",\n        \"@rolldown/binding-linux-arm64-gnu\": \"1.2.16\",\n        \"@rolldown/binding-linux-arm64-musl\": \"1.2.16\",\n        \"@rolldown/binding-linux-ppc64-gnu\": \"1.2.16\",\n        \"@rolldown/binding-linux-s390x-gnu\": \"1.2.16\",\n        \"@rolldown/binding-linux-x64-gnu\": \"1.2.16\",\n        \"@rolldown/binding-linux-x64-musl\": \"1.2.16\",\n        \"@rolldown/binding-openharmony-arm64\": \"1.2.16\",\n        \"@rolldown/binding-win32-arm64-msvc\": \"1.2.16\",\n        \"@rolldown/binding-win32-x64-msvc\": \"1.2.16\"\n      }\n    },\n    \"node_modules/scheduler\": {\n      \"version\": \"0.28.0\",\n      \"resolved\": \"https://registry.npmjs.org/scheduler/-/scheduler-0.28.0.tgz\",\n      \"integrity\": \"sha512-juorfCmIkIw8tT+p5BXSm6PJjQF/ycEYmKyzURCIt/RaZIhL+PulbQ9Yu2z1HdOJDdqDTlxA1+xKBmHXJsczAw==\",\n      \"license\": \"MIT\"\n    },\n    \"node_modules/source-map-js\": {\n      \"version\": \"1.2.2\",\n      \"resolved\": \"https://registry.npmjs.org/source-map-js/-/source-map-js-1.2.2.tgz\",\n      \"integrity\": \"sha512-KGj/8Y43x35aZVDtt+J4mK1hoLGHULMYfSkODJNQjNDC3oW1PqPoxMwo0pLUsWM/UEGzON/NxeHywEfNXNP3Vw==\",\n      \"dev\": true,\n      \"license\": \"BSD-3-Clause\",\n      \"engines\": {\n        \"node\": \">=0.10.0\"\n      }\n    },\n    \"node_modules/tinyglobby\": {\n      \"version\": \"0.2.17\",\n      \"resolved\": \"https://registry.npmjs.org/tinyglobby/-/tinyglobby-0.2.17.tgz\",\n      \"integrity\": \"sha512-wXR/dYpcqKmfWpEdZjiKJOwCNFndD0DMnrW/cYjVGttEkBfVgcLFHoNrlj47mjOVic9yyNu65alsgF4NQyTa2g==\",\n      \"dev\": true,\n      \"license\": \"MIT\",\n      \"dependencies\": {\n        \"fdir\": \"^6.5.0\",\n        \"picomatch\": \"^4.0.4\"\n      },\n      \"engines\": {\n        \"node\": \">=12.0.0\"\n      },\n      \"funding\": {\n        \"url\": \"https://github.com/sponsors/SuperchupuDev\"\n      }\n    },\n    \"node_modules/vite\": {\n      \"version\": \"8.3.5\",\n      \"resolved\": \"https://registry.npmjs.org/vite/-/vite-8.3.5.tgz\",\n      \"integrity\": \"sha512-z1YpjieJ9g0ebTmQpLBv/oq9E3F9EIlOe+7LahW8SrE3LTiG3udBRUXQOlYXP9b+IC2q2phHeVxj9xGlw34OEQ==\",\n      \"dev\": true,\n      \"license\": \"MIT\",\n      \"dependencies\": {\n        \"lightningcss\": \"^1.33.0\",\n        \"picomatch\": \"^4.0.7\",\n        \"postcss\": \"^8.5.30\",\n        \"rolldown\": \"~1.2.14\",\n        \"tinyglobby\": \"^0.2.17\"\n      },\n      \"bin\": {\n        \"vite\": \"bin/vite.js\"\n      },\n      \"engines\": {\n        \"node\": \"^20.19.0 || >=22.12.0\"\n      },\n      \"funding\": {\n        \"url\": \"https://github.com/vitejs/vite?sponsor=1\"\n      },\n      \"optionalDependencies\": {\n        \"fsevents\": \"~2.3.3\"\n      },\n      \"peerDependencies\": {\n        \"@types/node\": \"^20.19.0 || >=22.12.0\",\n        \"@vitejs/devtools\": \"^0.7.1 || ^0.8.0\",\n        \"esbuild\": \"^0.27.0 || ^0.28.0\",\n        \"jiti\": \">=1.21.0\",\n        \"less\": \"^4.0.0\",\n        \"sass\": \"^1.70.0\",\n        \"sass-embedded\": \"^1.70.0\",\n        \"stylus\": \">=0.54.8\",\n        \"sugarss\": \"^5.0.0\",\n        \"terser\": \"^5.16.0\",\n        \"tsx\": \"^4.8.1\",\n        \"yaml\": \"^2.4.2\"\n      },\n      \"peerDependenciesMeta\": {\n        \"@types/node\": {\n          \"optional\": true\n        },\n        \"@vitejs/devtools\": {\n          \"optional\": true\n        },\n        \"esbuild\": {\n          \"optional\": true\n        },\n        \"jiti\": {\n          \"optional\": true\n        },\n        \"less\": {\n          \"optional\": true\n        },\n        \"sass\": {\n          \"optional\": true\n        },\n        \"sass-embedded\": {\n          \"optional\": true\n        },\n        \"stylus\": {\n          \"optional\": true\n        },\n        \"sugarss\": {\n          \"optional\": true\n      