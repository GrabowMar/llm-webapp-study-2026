{"type":"tool_use","timestamp":1794363602744,"sessionID":"ses_e379b3931ffegOfSsp4ywBnfbO","part":{"type":"tool","tool":"write","callID":"call_thseabqefgpn4xmooyyydg4u","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Link preview bookmarking app.\"\"\"\n\nimport html\nimport re\nimport secrets\nimport sqlite3\nimport urllib.error\nimport urllib.parse\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"app.db\"\n\napp = Flask(__name__, static_folder=None)\n\nUSER_AGENT = (\n    \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0; +https://example.com)\"\n)\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS previews (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                url TEXT NOT NULL,\n                final_url TEXT NOT NULL,\n                status_code INTEGER,\n                title TEXT,\n                description TEXT,\n                image_url TEXT,\n                fetched_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_previews_user ON previews(user_id, id);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef get_user_by_token(token: str):\n    row = get_db().execute(\n        \"SELECT u.* FROM users u JOIN sessions s ON s.user_id = u.id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_auth(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        auth = request.headers.get(\"Authorization\", \"\")\n        if not auth.startswith(\"Bearer \"):\n            return jsonify({\"error\": \"unauthorized\"}), 401\n        token = auth[len(\"Bearer \"):].strip()\n        user = get_user_by_token(token)\n        if user is None:\n            return jsonify({\"error\": \"unauthorized\"}), 401\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return jsonify({\"error\": \"username already taken\"}), 409\n\n    password_hash = generate_password_hash(password)\n    cursor = db.execute(\n        \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n        (username, password_hash),\n    )\n    db.commit()\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\ndef clean_text(value: str) -> str:\n    if value is None:\n        return None\n    value = html.unescape(value)\n    value = re.sub(r\"\\s+\", \" \", value).strip()\n    return value or None\n\n\ndef _fetch(url: str):\n    req = urllib.request.Request(url, headers={\"User-Agent\": USER_AGENT})\n    with urllib.request.urlopen(req, timeout=10) as resp:\n        final_url = resp.geturl()\n        status_code = resp.getcode()\n        content_type = resp.headers.get(\"Content-Type\", \"\")\n        data = resp.read(1024 * 1024)\n        if \"charset=\" in content_type:\n            match = re.search(r\"charset=([\\w-]+)\", content_type, re.IGNORECASE)\n            encoding = match.group(1) if match else \"utf-8\"\n        else:\n            encoding = \"utf-8\"\n        try:\n            text = data.decode(encoding, errors=\"replace\")\n        except LookupError:\n            text = data.decode(\"utf-8\", errors=\"replace\")\n    return final_url, status_code, text\n\n\ndef _extract_meta(text: str) -> dict:\n    title = None\n    m = re.search(r\"<title[^>]*>(.*?)</title>\", text, re.IGNORECASE | re.DOTALL)\n    if m:\n        title = clean_text(re.sub(r\"<[^>]+>\", \"\", m.group(1)))\n\n    description = None\n    m = re.search(\n        r'<meta[^>]+name=[\"\\']description[\"\\'][^>]*content=[\"\\'](.*?)[\"\\']',\n        text,\n        re.IGNORECASE | re.DOTALL,\n    )\n    if not m:\n        m = re.search(\n            r'<meta[^>]+content=[\"\\'](.*?)[\"\\'][^>]*name=[\"\\']description[\"\\']',\n            text,\n            re.IGNORECASE | re.DOTALL,\n        )\n    if m:\n        description = clean_text(m.group(1))\n\n    og_title = None\n    m = re.search(\n        r'<meta[^>]+(?:property|name)=[\"\\']og:title[\"\\'][^>]*content=[\"\\'](.*?)[\"\\']',\n        text,\n        re.IGNORECASE | re.DOTALL,\n    )\n    if not m:\n        m = re.search(\n            r'<meta[^>]+content=[\"\\'](.*?)[\"\\'][^>]*(?:property|name)=[\"\\']og:title[\"\\']',\n            text,\n            re.IGNORECASE | re.DOTALL,\n        )\n    if m:\n        og_title = clean_text(m.group(1))\n\n    og_description = None\n    m = re.search(\n        r'<meta[^>]+(?:property|name)=[\"\\']og:description[\"\\'][^>]*content=[\"\\'](.*?)[\"\\']',\n        text,\n        re.IGNORECASE | re.DOTALL,\n    )\n    if not m:\n        m = re.search(\n            r'<meta[^>]+content=[\"\\'](.*?)[\"\\'][^>]*(?:property|name)=[\"\\']og:description[\"\\']',\n            text,\n            re.IGNORECASE | re.DOTALL,\n        )\n    if m:\n        og_description = clean_text(m.group(1))\n\n    og_image = None\n    m = re.search(\n        r'<meta[^>]+(?:property|name)=[\"\\']og:image[\"\\'][^>]*content=[\"\\'](.*?)[\"\\']',\n        text,\n        re.IGNORECASE | re.DOTALL,\n    )\n    if not m:\n        m = re.search(\n            r'<meta[^>]+content=[\"\\'](.*?)[\"\\'][^>]*(?:property|name)=[\"\\']og:image[\"\\']',\n            text,\n            re.IGNORECASE | re.DOTALL,\n        )\n    if m:\n        og_image = clean_text(m.group(1))\n\n    return {\n        \"title\": og_title or title,\n        \"description\": og_description or description,\n        \"image_url\": og_image,\n    }\n\n\ndef fetch_preview(url: str) -> dict:\n    final_url, status_code, text = _fetch(url)\n    meta = _extract_meta(text)\n    return {\n        \"final_url\": final_url,\n        \"status_code\": status_code,\n        \"title\": meta[\"title\"],\n        \"description\": meta[\"description\"],\n        \"image_url\": meta[\"image_url\"],\n    }\n\n\ndef preview_to_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\n@app.post(\"/api/previews\")\n@require_auth\ndef create_preview():\n    data = request.get_json(silent=True) or {}\n    url = (data.get(\"url\") or \"\").strip()\n    if not url:\n        return jsonify({\"error\": \"url is required\"}), 400\n    parsed = urllib.parse.urlparse(url)\n    if parsed.scheme not in (\"http\", \"https\") or not parsed.netloc:\n        return jsonify({\"error\": \"invalid url\"}), 400\n\n    try:\n        info = fetch_preview(url)\n    except urllib.error.HTTPError as exc:\n        info = {\n            \"final_url\": exc.geturl(),\n            \"status_code\": exc.code,\n            \"title\": None,\n            \"description\": None,\n            \"image_url\": None,\n        }\n    except Exception as exc:\n        return jsonify({\"error\": f\"could not fetch url: {exc}\"}), 422\n\n    db = get_db()\n    cursor = db.execute(\n        \"\"\"\n        INSERT INTO previews\n            (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            g.user[\"id\"],\n            url,\n            info[\"final_url\"],\n            info[\"status_code\"],\n            info[\"title\"],\n            info[\"description\"],\n            info[\"image_url\"],\n            now_iso(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM previews WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(preview_to_dict(row)), 201\n\n\n@app.get(\"/api/previews\")\n@require_auth\ndef list_previews():\n    page = request.args.get(\"page\", 1, type=int)\n    page_size = request.args.get(\"page_size\", 20, type=int)\n    if page < 1:\n        page = 1\n    if page_size < 1:\n        page_size = 20\n    if page_size > 100:\n        page_size = 100\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user[\"id\"],)\n    ).fetchone()[0]\n    rows = db.execute(\n        \"\"\"\n        SELECT * FROM previews WHERE user_id = ?\n        ORDER BY id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        (g.user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [preview_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\ndef _own_preview(preview_id):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, g.user[\"id\"]),\n    ).fetchone()\n    return row\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@require_auth\ndef get_preview(preview_id):\n    row = _own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify(preview_to_dict(row))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@require_auth\ndef refresh_preview(preview_id):\n    row = _own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    try:\n        info = fetch_preview(row[\"url\"])\n    except urllib.error.HTTPError as exc:\n        info = {\n            \"final_url\": exc.geturl(),\n            \"status_code\": exc.code,\n            \"title\": None,\n            \"description\": None,\n            \"image_url\": None,\n        }\n    except Exception as exc:\n        return jsonify({\"error\": f\"could not fetch url: {exc}\"}), 422\n\n    db = get_db()\n    db.execute(\n        \"\"\"\n        UPDATE previews\n        SET final_url = ?, status_code = ?, title = ?, description = ?, image_url = ?, fetched_at = ?\n        WHERE id = ?\n        \"\"\",\n        (\n            info[\"final_url\"],\n            info[\"status_code\"],\n            info[\"title\"],\n            info[\"description\"],\n            info[\"image_url\"],\n            now_iso(),\n            preview_id,\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM previews WHERE id = ?\", (preview_id,)).fetchone()\n    return jsonify(preview_to_dict(row))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@require_auth\ndef delete_preview(preview_id):\n    row = _own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    db = get_db()\n    db.execute(\"DELETE FROM previews WHERE id = ?\", (preview_id,))\n    db.commit()\n    return jsonify({\"deleted\": preview_id})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794363602692,"end":1794363602721}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c867b6fd001MdMaEzLNkkFUzE","sessionID":"ses_e379b3931ffegOfSsp4ywBnfbO","messageID":"msg_1c8670052001erhK6a9vDw3sta"}}
