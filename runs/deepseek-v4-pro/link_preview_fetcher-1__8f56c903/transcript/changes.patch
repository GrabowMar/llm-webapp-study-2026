index fee9f48..825e3f1 100644
--- a/frontend/src/App.tsx
+++ b/frontend/src/App.tsx
@@ -1,3 +1,429 @@
+import { useCallback, useEffect, useState } from "react";
+
+type Preview = {
+  id: number;
+  url: string;
+  final_url: string;
+  status_code: number | null;
+  title: string | null;
+  description: string | null;
+  image_url: string | null;
+  fetched_at: string;
+};
+
+type ListResponse = {
+  items: Preview[];
+  total: number;
+  page: number;
+  page_size: number;
+};
+
+const TOKEN_KEY = "token";
+const USERNAME_KEY = "username";
+
+function getToken(): string | null {
+  return localStorage.getItem(TOKEN_KEY);
+}
+
+function getUsername(): string | null {
+  return localStorage.getItem(USERNAME_KEY);
+}
+
+async function api<T>(
+  path: string,
+  options: RequestInit = {},
+): Promise<{ ok: boolean; status: number; data: T | { error?: string } }> {
+  const token = getToken();
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+    ...(options.headers as Record<string, string> | undefined),
+  };
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  const res = await fetch(path, { ...options, headers });
+  let data: unknown = null;
+  try {
+    data = await res.json();
+  } catch {
+    data = null;
+  }
+  return { ok: res.ok, status: res.status, data: data as T };
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).host;
+  } catch {
+    return url;
+  }
+}
+
+function formatDate(iso: string): string {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return iso;
+  return d.toLocaleString();
+}
+
+function AuthScreen({
+  onAuthed,
+}: {
+  onAuthed: (username: string) => void;
+}) {
+  const [mode, setMode] = useState<"login" | "register">("login");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      const res = await api<{ token?: string; error?: string }>(
+        `/api/auth/${mode}`,
+        {
+          method: "POST",
+          body: JSON.stringify({ username, password }),
+        },
+      );
+      if (mode === "register") {
+        if (res.ok) {
+          setMode("login");
+          setPassword("");
+          setError("Account created — sign in below.");
+          return;
+        }
+        setError((res.data as { error?: string }).error ?? "Registration failed");
+      } else {
+        if (res.ok && (res.data as { token?: string }).token) {
+          localStorage.setItem(TOKEN_KEY, (res.data as { token: string }).token);
+          localStorage.setItem(USERNAME_KEY, username);
+          onAuthed(username);
+          return;
+        }
+        setError((res.data as { error?: string }).error ?? "Invalid credentials");
+      }
+    } catch {
+      setError("Network error");
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  return (
+    <div className="min-h-screen flex items-center justify-center bg-slate-50 p-4">
+      <form
+        onSubmit={submit}
+        className="w-full max-w-sm bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4"
+      >
+        <div className="flex gap-2">
+          <button
+            type="button"
+            onClick={() => {
+              setMode("login");
+              setError(null);
+            }}
+            className={`flex-1 py-2 rounded-lg text-sm font-medium ${
+              mode === "login"
+                ? "bg-slate-900 text-white"
