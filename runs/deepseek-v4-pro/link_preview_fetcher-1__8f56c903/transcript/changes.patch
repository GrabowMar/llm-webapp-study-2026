+              Previous
+            </button>
+            <span className="text-sm text-slate-500">
+              Page {page} of {totalPages}
+            </span>
+            <button
+              disabled={page >= totalPages}
+              onClick={() => load(page + 1)}
+              className="text-sm font-medium text-slate-600 disabled:opacity-40"
+            >
+              Next
+            </button>
+          </div>
+        )}
+      </main>
+    </div>
+  );
 }
