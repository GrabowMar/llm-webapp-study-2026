{"type":"text","timestamp":1794384808779,"sessionID":"ses_e36593cbfffeDJ07ROdb5qGDwP","part":{"id":"prt_1c9ab4b37001WZiQttxg0oNB7s","messageID":"msg_1c9aaebdc001DeJxYKsB0zEEqL","sessionID":"ses_e36593cbfffeDJ07ROdb5qGDwP","type":"text","text":"Now the main App component:\n\n","time":{"start":1794384808759,"end":1794384808776}}}
{"type":"tool_use","timestamp":1794384808817,"sessionID":"ses_e36593cbfffeDJ07ROdb5qGDwP","part":{"type":"tool","tool":"write","callID":"call_vi6okdunfuj9l43jy41xnbw7","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  createStore,\n  deleteStore,\n  getToken,\n  listStores,\n  login,\n  setToken,\n  updateStore,\n} from \"./api\";\nimport type { ApiError } from \"./api\";\nimport type { Store, StoreInput, LatLng } from \"./types\";\nimport Plot from \"./Plot\";\nimport StoreForm from \"./StoreForm\";\n\nexport default function App() {\n  const [stores, setStores] = useState<Store[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [q, setQ] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [visitor, setVisitor] = useState<LatLng | null>(null);\n  const [radius, setRadius] = useState(10);\n  const [locError, setLocError] = useState<string | null>(null);\n\n  const [token, setTokenState] = useState<string | null>(getToken());\n  const [authError, setAuthError] = useState<string | null>(null);\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n\n  const [editing, setEditing] = useState<Store | null>(null);\n  const [adding, setAdding] = useState(false);\n  const [formError, setFormError] = useState<string | null>(null);\n  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});\n  const [submitting, setSubmitting] = useState(false);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params: { q?: string; lat?: number; lng?: number; radius?: number } = {};\n      if (search) params.q = search;\n      if (visitor) {\n        params.lat = visitor.lat;\n        params.lng = visitor.lng;\n        params.radius = radius;\n      }\n      const res = await listStores(params);\n      setStores(res.items);\n    } catch (e) {\n      console.error(e);\n    } finally {\n      setLoading(false);\n    }\n  }, [search, visitor, radius]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  function handleUseLocation() {\n    setLocError(null);\n    if (!navigator.geolocation) {\n      setLocError(\"Location is not supported by this browser.\");\n      return;\n    }\n    navigator.geolocation.getCurrentPosition(\n      (pos) => setVisitor({ lat: pos.coords.latitude, lng: pos.coords.longitude }),\n      () => setLocError(\"Could not access your location, showing all stores.\"),\n    );\n  }\n\n  async function handleLogin(e: React.FormEvent) {\n    e.preventDefault();\n    setAuthError(null);\n    try {\n      const res = await login(username, password);\n      setToken(res.token);\n      setTokenState(res.token);\n      setPassword(\"\");\n    } catch (err) {\n      setAuthError((err as ApiError).message);\n    }\n  }\n\n  function handleLogout() {\n    setToken(null);\n    setTokenState(null);\n    setEditing(null);\n    setAdding(false);\n  }\n\n  function resetFormState() {\n    setFormError(null);\n    setFieldErrors({});\n    setAdding(false);\n    setEditing(null);\n  }\n\n  async function handleSubmit(input: StoreInput) {\n    setSubmitting(true);\n    setFormError(null);\n    setFieldErrors({});\n    try {\n      if (editing) {\n        await updateStore(editing.id, input);\n      } else {\n        await createStore(input);\n      }\n      resetFormState();\n      await load();\n    } catch (err) {\n      const e = err as ApiError;\n      if (e.status === 401) {\n        setToken(null);\n        setTokenState(null);\n        setFormError(\"Your session expired. Please sign in again.\");\n      } else {\n        setFormError(e.data?.error || e.message);\n        setFieldErrors(e.data?.errors || {});\n      }\n    } finally {\n      setSubmitting(false);\n    }\n  }\n\n  async function handleDelete(store: Store) {\n    if (!window.confirm(`Delete \"${store.name}\"?`)) return;\n    try {\n      await deleteStore(store.id);\n      await load();\n    } catch (err) {\n      const e = err as ApiError;\n      if (e.status === 401) {\n        setToken(null);\n        setTokenState(null);\n      } else {\n        alert(e.message);\n      }\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-4xl items-center justify-between px-4 py-4\">\n          <h1 className=\"text-xl font-bold\">Store Finder</h1>\n          {token ? (\n            <button\n              onClick={handleLogout}\n              className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50\"\n            >\n              Sign out\n            </button>\n          ) : null}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-4xl px-4 py-8\">\n        {!token && (\n          <section className=\"mb-8 rounded-lg border border-slate-200 bg-white p-5\">\n            <h2 className=\"mb-4 text-lg font-semibold\">Admin sign in</h2>\n            <form onSubmit={handleLogin} className=\"flex flex-wrap items-end gap-3\">\n              <div>\n                <label className=\"block text-sm font-medium text-slate-700\">Username</label>\n                <input\n                  value={username}\n                  onChange={(e) => setUsername(e.target.value)}\n                  autoComplete=\"username\"\n                  className=\"mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-sm font-medium text-slate-700\">Password</label>\n                <input\n                  type=\"password\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  autoComplete=\"current-password\"\n                  className=\"mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm\"\n                />\n              </div>\n              <button\n                type=\"submit\"\n                className=\"rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700\"\n              >\n                Sign in\n              </button>\n            </form>\n            {authError && <p className=\"mt-3 text-sm text-red-600\">{authError}</p>}\n          </section>\n        )}\n\n        <section className=\"mb-6 flex flex-wrap items-center gap-3\">\n          <input\n            value={q}\n            onChange={(e) => setQ(e.target.value)}\n            onKeyDown={(e) => {\n              if (e.key === \"Enter\") setSearch(q);\n            }}\n            placeholder=\"Search by name or address\"\n            className=\"w-64 rounded-md border border-slate-300 px-3 py-2 text-sm\"\n          />\n          <button\n            onClick={() => setSearch(q)}\n            className=\"rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700\"\n          >\n            Search\n          </button>\n          <button\n            onClick={handleUseLocation}\n            className=\"rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700\"\n          >\n            Use my location\n          </button>\n          <label className=\"flex items-center gap-2 text-sm text-slate-700\">\n            Radius\n            <select\n              value={radius}\n              onChange={(e) => setRadius(Number(e.target.value))}\n              className=\"rounded-md border border-slate-300 px-2 py-2 text-sm\"\n            >\n              {[1, 5, 10, 25, 50, 100, 250].map((r) => (\n                <option key={r} value={r}>\n                  {r} km\n                </option>\n              ))}\n            </select>\n          </label>\n        </section>\n\n        {locError && <p className=\"mb-4 text-sm text-amber-700\">{locError}</p>}\n\n        {visitor && (\n          <p className=\"mb-4 text-sm text-slate-600\">\n            Showing stores within {radius} km of your location.\n          </p>\n        )}\n\n        <Plot stores={stores} visitor={visitor} />\n\n        {token && (\n          <section className=\"mt-8\">\n            {adding || editing ? (\n              <StoreForm\n                initial={editing ?? undefined}\n                error={formError}\n                fieldErrors={fieldErrors}\n                submitting={submitting}\n                onSubmit={handleSubmit}\n                onCancel={resetFormState}\n              />\n            ) : (\n              <button\n                onClick={() => setAdding(true)}\n                className=\"rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700\"\n              >\n                Add store\n              </button>\n            )}\n          </section>\n        )}\n\n        <section className=\"mt-8\">\n          {loading ? (\n            <p className=\"text-sm text-slate-500\">Loading stores…</p>\n          ) : stores.length === 0 ? (\n            <p className=\"text-sm text-slate-500\">No stores found.</p>\n          ) : (\n            <ul className=\"divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white\">\n              {stores.map((s) => (\n                <li key={s.id} className=\"flex items-start justify-between gap-4 px-5 py-4\">\n                  <div>\n                    <h3 className=\"font-semibold text-slate-800\">{s.name}</h3>\n                    <p className=\"text-sm text-slate-600\">{s.address}</p>\n                    {s.phone && <p className=\"text-sm text-slate-500\">{s.phone}</p>}\n                    {s.distance_km != null && (\n                      <p className=\"mt-1 text-sm font-medium text-indigo-600\">\n                        {s.distance_km.toFixed(1)} km away\n                      </p>\n                    )}\n                  </div>\n                  {token && (\n                    <div className=\"flex shrink-0 gap-2\">\n                      <button\n                        onClick={() => {\n                          setEditing(s);\n                          setAdding(false);\n                          setFormError(null);\n                          setFieldErrors({});\n                        }}\n                        className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50\"\n                      >\n                        Edit\n                      </button>\n                      <button\n                        onClick={() => handleDelete(s)}\n                        className=\"rounded-md border border-red-300 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50\"\n                      >\n                        Delete\n                      </button>\n                    </div>\n                  )}\n                </li>\n              ))}\n            </ul>\n          )}\n        </section>\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794384808770,"end":1794384808790}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9ab4b3b001fklkMWJTjq3fJ3","sessionID":"ses_e36593cbfffeDJ07ROdb5qGDwP","messageID":"msg_1c9aaebdc001DeJxYKsB0zEEqL"}}
