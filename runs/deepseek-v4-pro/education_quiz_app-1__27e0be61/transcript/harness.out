{"type":"tool_use","timestamp":1794302765181,"sessionID":"ses_e3b3de4c9ffekfjzaZP6rZ8fp0","part":{"type":"tool","tool":"write","callID":"call_8rrwagzg5fynvl7n19ocfnus","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { adminAddQuestion, adminListQuestions, Question } from \"./api\";\n\nconst OPTIONS = [\"A\", \"B\", \"C\", \"D\"] as const;\n\nexport default function Admin() {\n  const [text, setText] = useState(\"\");\n  const [options, setOptions] = useState({ a: \"\", b: \"\", c: \"\", d: \"\" });\n  const [correct, setCorrect] = useState(\"A\");\n  const [message, setMessage] = useState<{ kind: \"ok\" | \"err\"; text: string } | null>(\n    null\n  );\n  const [questions, setQuestions] = useState<Question[]>([]);\n  const [page, setPage] = useState(1);\n  const [total, setTotal] = useState(0);\n  const pageSize = 10;\n\n  async function load() {\n    const res = await adminListQuestions(page, pageSize);\n    if (res.ok) {\n      setQuestions(res.data.items);\n      setTotal(res.data.total);\n    }\n  }\n\n  useEffect(() => {\n    load();\n  }, [page]);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setMessage(null);\n    const res = await adminAddQuestion({\n      text,\n      option_a: options.a,\n      option_b: options.b,\n      option_c: options.c,\n      option_d: options.d,\n      correct_option: correct,\n    });\n    if (res.ok) {\n      setText(\"\");\n      setOptions({ a: \"\", b: \"\", c: \"\", d: \"\" });\n      setCorrect(\"A\");\n      setMessage({ kind: \"ok\", text: \"Question added.\" });\n      load();\n    } else {\n      setMessage({\n        kind: \"err\",\n        text: (res.data as { error?: string }).error ?? \"Failed to add question.\",\n      });\n    }\n  }\n\n  const totalPages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <div className=\"max-w-2xl mx-auto mt-10\">\n      <h1 className=\"text-2xl font-bold mb-6\">Admin</h1>\n\n      <form onSubmit={submit} className=\"border rounded p-4 mb-8 space-y-3\">\n        <h2 className=\"font-semibold\">Add question</h2>\n        <input\n          className=\"w-full border rounded px-3 py-2\"\n          placeholder=\"Question text\"\n          value={text}\n          onChange={(e) => setText(e.target.value)}\n        />\n        {OPTIONS.map((letter) => (\n          <input\n            key={letter}\n            className=\"w-full border rounded px-3 py-2\"\n            placeholder={`Option ${letter}`}\n            value={options[letter.toLowerCase() as keyof typeof options]}\n            onChange={(e) =>\n              setOptions({\n                ...options,\n                [letter.toLowerCase()]: e.target.value,\n              })\n            }\n          />\n        ))}\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-sm text-gray-600\">Correct option:</span>\n          {OPTIONS.map((letter) => (\n            <label key={letter} className=\"flex items-center gap-1 text-sm\">\n              <input\n                type=\"radio\"\n                className=\"accent-blue-600\"\n                checked={correct === letter}\n                onChange={() => setCorrect(letter)}\n              />\n              {letter}\n            </label>\n          ))}\n        </div>\n        {message && (\n          <p\n            className={\n              message.kind === \"ok\" ? \"text-green-700 text-sm\" : \"text-red-600 text-sm\"\n            }\n          >\n            {message.text}\n          </p>\n        )}\n        <button\n          type=\"submit\"\n          className=\"bg-blue-600 text-white px-4 py-2 rounded\"\n        >\n          Add question\n        </button>\n      </form>\n\n      <h2 className=\"font-semibold mb-2\">Questions ({total})</h2>\n      <ul className=\"space-y-2\">\n        {questions.map((q) => (\n          <li key={q.id} className=\"border rounded p-3\">\n            <p className=\"font-medium\">{q.text}</p>\n            <p className=\"text-sm text-gray-600\">\n              A: {q.option_a} · B: {q.option_b} · C: {q.option_c} · D: {q.option_d}\n            </p>\n            <p className=\"text-sm text-green-700\">\n              Correct: {q.correct_option}\n            </p>\n          </li>\n        ))}\n      </ul>\n\n      <div className=\"flex gap-2 mt-4 items-center\">\n        <button\n          disabled={page <= 1}\n          onClick={() => setPage(page - 1)}\n          className=\"px-3 py-1 rounded border disabled:opacity-40\"\n        >\n          Prev\n        </button>\n        <span className=\"text-sm\">\n          Page {page} of {totalPages}\n        </span>\n        <button\n          disabled={page >= totalPages}\n          onClick={() => setPage(page + 1)}\n          className=\"px-3 py-1 rounded border disabled:opacity-40\"\n        >\n          Next\n        </button>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/Admin.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Admin.tsx","exists":false,"truncated":false},"title":"frontend/src/Admin.tsx","time":{"start":1794302765156,"end":1794302765164}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4c7685f0012qZYnGgob8P5aE","sessionID":"ses_e3b3de4c9ffekfjzaZP6rZ8fp0","messageID":"msg_1c4c7394c0015MsIMXSD0tN2iJ"}}
