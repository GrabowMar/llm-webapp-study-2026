{"type":"tool_use","timestamp":1794302714605,"sessionID":"ses_e3b3de4c9ffekfjzaZP6rZ8fp0","part":{"type":"tool","tool":"write","callID":"call_wy3fzelpk8drxohyd8y93f0z","state":{"status":"completed","input":{"content":"export interface Question {\n  id: number;\n  text: string;\n  option_a: string;\n  option_b: string;\n  option_c: string;\n  option_d: string;\n  correct_option?: string;\n}\n\nexport interface AnswerReview {\n  question_id: number;\n  text: string;\n  option_a: string;\n  option_b: string;\n  option_c: string;\n  option_d: string;\n  correct_option: string;\n  selected: string;\n  is_correct: boolean;\n}\n\nexport interface Attempt {\n  id: number;\n  score: number;\n  correct: number;\n  total_questions: number;\n  submitted_at: string;\n  answers: AnswerReview[];\n}\n\nconst TOKEN_KEY = \"quiz_token\";\nconst USERNAME_KEY = \"quiz_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function setAuth(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearAuth() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {}\n): Promise<{ ok: boolean; status: number; data: T; error?: string }> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  const res = await fetch(path, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n  });\n\n  let data: T = null as T;\n  try {\n    data = (await res.json()) as T;\n  } catch {\n    data = null as T;\n  }\n\n  return { ok: res.ok, status: res.status, data };\n}\n\nexport async function register(username: string, password: string) {\n  return request<{ id: number; username: string } | { error: string }>(\n    \"/api/auth/register\",\n    { method: \"POST\", body: { username, password } }\n  );\n}\n\nexport async function login(username: string, password: string) {\n  return request<{ token: string; username: string } | { error: string }>(\n    \"/api/auth/login\",\n    { method: \"POST\", body: { username, password } }\n  );\n}\n\nexport async function fetchQuiz(count: number) {\n  return request<{ items: Question[] }>(`/api/quiz?count=${count}`);\n}\n\nexport async function submitAttempt(\n  answers: { question_id: number; selected: string }[]\n) {\n  return request<Attempt>(`/api/attempts`, { method: \"POST\", body: { answers } });\n}\n\nexport async function fetchAttempts() {\n  return request<{ items: Attempt[] }>(`/api/attempts`);\n}\n\nexport async function fetchAttempt(id: number) {\n  return request<Attempt>(`/api/attempts/${id}`);\n}\n\nexport async function adminAddQuestion(q: {\n  text: string;\n  option_a: string;\n  option_b: string;\n  option_c: string;\n  option_d: string;\n  correct_option: string;\n}) {\n  return request<Question | { error: string }>(`/api/admin/questions`, {\n    method: \"POST\",\n    body: q,\n  });\n}\n\nexport async function adminListQuestions(page: number, pageSize: number) {\n  return request<{ items: Question[]; total: number; page: number; page_size: number }>(\n    `/api/admin/questions?page=${page}&page_size=${pageSize}`\n  );\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794302714580,"end":1794302714587}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4c6a2cf001xK4k8H8SNSenf5","sessionID":"ses_e3b3de4c9ffekfjzaZP6rZ8fp0","messageID":"msg_1c4c6739f001GHpc6sxV6xSH4Y"}}
