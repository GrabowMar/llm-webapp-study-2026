{"type":"tool_use","timestamp":1794315928759,"sessionID":"ses_e3a7164a0ffeGzBXMRKesHHNFV","part":{"type":"tool","tool":"write","callID":"call_cufq3nzg1d0lhsdeif7rg2bx","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: account service with password reset.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport json\nimport os\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\nDATA_DIR.mkdir(parents=True, exist_ok=True)\nDB_PATH = DATA_DIR / \"app.db\"\n\nSESSION_TTL = 60 * 60 * 24 * 30  # 30 days\nRESET_TTL = 60 * 60  # 1 hour\n\napp = Flask(__name__, static_folder=None)\n\n\ndef get_db() -> sqlite3.Connection:\n    db = getattr(g, \"_db\", None)\n    if db is None:\n        db = g._db = sqlite3.connect(DB_PATH)\n        db.row_factory = sqlite3.Row\n        db.execute(\"PRAGMA foreign_keys = ON\")\n    return db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = getattr(g, \"_db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS accounts (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            email TEXT UNIQUE,\n            password_hash TEXT NOT NULL,\n            password_salt TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS sessions (\n            token_hash TEXT PRIMARY KEY,\n            account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS reset_tokens (\n            token_hash TEXT PRIMARY KEY,\n            account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS outbox (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            to_addr TEXT NOT NULL,\n            subject TEXT NOT NULL,\n            body TEXT NOT NULL,\n            sent_at TEXT NOT NULL\n        );\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef hash_password(password: str, salt: str) -> str:\n    return hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt.encode(), 200_000).hex()\n\n\ndef normalize_email(email: str | None) -> str | None:\n    if email is None:\n        return None\n    value = email.strip()\n    return value.lower() if value else None\n\n\ndef valid_password(password: str | None) -> bool:\n    return isinstance(password, str) and len(password) >= 8\n\n\ndef get_json() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef generate_session_token(account_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO sessions (token_hash, account_id, created_at) VALUES (?, ?, ?)\",\n        (hash_token(token), account_id, utcnow()),\n    )\n    db.commit()\n    return token\n\n\ndef current_account():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"SELECT a.* FROM sessions s JOIN accounts a ON a.id = s.account_id \"\n        \"WHERE s.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None:\n        return None\n    return row\n\n\ndef require_auth(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        account = current_account()\n        if account is None:\n            return jsonify({\"error\": \"unauthorized\"}), 401\n        g.account = account\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef send_outbox(to_addr: str, subject: str, body: str) -> int:\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO outbox (to_addr, subject, body, sent_at) VALUES (?, ?, ?, ?)\",\n        (to_addr, subject, body, utcnow()),\n    )\n    db.commit()\n    return cur.lastrowid\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = get_json()\n    username = str(data.get(\"username\", \"\")).strip()\n    password = data.get(\"password\")\n    email = normalize_email(data.get(\"email\"))\n\n    if not username:\n        return jsonify({\"error\": \"username is required\"}), 400\n    if not valid_password(password):\n        return jsonify({\"error\": \"password must be at least 8 characters\"}), 400\n\n    salt = secrets.token_hex(16)\n    password_hash = hash_password(password, salt)\n\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO accounts (username, email, password_hash, password_salt, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (username, email, password_hash, salt, utcnow()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username or email already taken\"}), 409\n\n    account_id = cur.lastrowid\n    return jsonify({\"id\": account_id, \"username\": username, \"email\": email}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = get_json()\n    username = str(data.get(\"username\", \"\")).strip()\n    password = data.get(\"password\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    row = get_db().execute(\n        \"SELECT * FROM accounts WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not hmac.compare_digest(\n        row[\"password_hash\"], hash_password(password, row[\"password_salt\"])\n    ):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n\n    token = generate_session_token(row[\"id\"])\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/me\")\n@require_auth\ndef me():\n    account = g.account\n    return jsonify(\n        {\"id\": account[\"id\"], \"username\": account[\"username\"], \"email\": account[\"email\"]}\n    )\n\n\n@app.patch(\"/api/me\")\n@require_auth\ndef update_me():\n    data = get_json()\n    account = g.account\n\n    email = account[\"email\"]\n    changed = False\n\n    if \"email\" in data:\n        new_email = normalize_email(data.get(\"email\"))\n        db = get_db()\n        try:\n            db.execute(\n                \"UPDATE accounts SET email = ? WHERE id = ?\",\n                (new_email, account[\"id\"]),\n            )\n            db.commit()\n        except sqlite3.IntegrityError:\n            return jsonify({\"error\": \"email already taken\"}), 409\n        email = new_email\n        changed = True\n\n    if \"username\" in data:\n        new_username = str(data.get(\"username\", \"\")).strip()\n        if new_username and new_username != account[\"username\"]:\n            db = get_db()\n            try:\n                db.execute(\n                    \"UPDATE accounts SET username = ? WHERE id = ?\",\n                    (new_username, account[\"id\"]),\n                )\n                db.commit()\n            except sqlite3.IntegrityError:\n                return jsonify({\"error\": \"username already taken\"}), 409\n\n    if not changed and \"email\" not in data and \"username\" not in data:\n        pass\n\n    row = get_db().execute(\n        \"SELECT * FROM accounts WHERE id = ?\", (account[\"id\"],)\n    ).fetchone()\n    return jsonify(\n        {\"id\": row[\"id\"], \"username\": row[\"username\"], \"email\": row[\"email\"]}\n    )\n\n\n@app.post(\"/api/me/password\")\n@require_auth\ndef change_password():\n    data = get_json()\n    account = g.account\n    current = data.get(\"current_password\")\n    new_password = data.get(\"new_password\")\n\n    if not hmac.compare_digest(\n        account[\"password_hash\"],\n        hash_password(current or \"\", account[\"password_salt\"]),\n    ):\n        return jsonify({\"error\": \"current password is incorrect\"}), 401\n    if not valid_password(new_password):\n        return jsonify({\"error\": \"new password must be at least 8 characters\"}), 400\n\n    salt = secrets.token_hex(16)\n    password_hash = hash_password(new_password, salt)\n    db = get_db()\n    db.execute(\n        \"UPDATE accounts SET password_hash = ?, password_salt = ? WHERE id = ?\",\n        (password_hash, salt, account[\"id\"]),\n    )\n    db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.post(\"/api/auth/password-reset\")\ndef password_reset():\n    data = get_json()\n    username = str(data.get(\"username\", \"\")).strip()\n    email = normalize_email(data.get(\"email\"))\n\n    db = get_db()\n    account = None\n    if username:\n        account = db.execute(\n            \"SELECT * FROM accounts WHERE username = ?\", (username,)\n        ).fetchone()\n    elif email:\n        account = db.execute(\n            \"SELECT * FROM accounts WHERE email = ?\", (email,)\n        ).fetchone()\n\n    if account is None or not account[\"email\"]:\n        return jsonify({\"ok\": True})\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO reset_tokens (token_hash, account_id, created_at) VALUES (?, ?, ?)\",\n        (hash_token(token), account[\"id\"], utcnow()),\n    )\n    db.commit()\n\n    reset_url = f\"{request.host_url.rstrip('/')}/reset?token={token}\"\n    body = (\n        f\"Hello {account['username']},\\n\\n\"\n        f\"To reset your password, follow this link:\\n{reset_url}\\n\\n\"\n        f\"This link expires in one hour.\"\n    )\n    send_outbox(account[\"email\"], \"Password reset\", body)\n\n    return jsonify({\"ok\": True})\n\n\n@app.post(\"/api/auth/password-reset/confirm\")\ndef password_reset_confirm():\n    data = get_json()\n    token = data.get(\"token\")\n    new_password = data.get(\"new_password\")\n\n    if not token or not valid_password(new_password):\n        return jsonify({\"error\": \"invalid request\"}), 400\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM reset_tokens WHERE token_hash = ?\", (hash_token(token),)\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"invalid or expired token\"}), 400\n\n    created = datetime.fromisoformat(row[\"created_at\"])\n    if (datetime.now(timezone.utc) - created).total_seconds() > RESET_TTL:\n        db.execute(\"DELETE FROM reset_tokens WHERE token_hash = ?\", (row[\"token_hash\"],))\n        db.commit()\n        return jsonify({\"error\": \"invalid or expired token\"}), 400\n\n    salt = secrets.token_hex(16)\n    password_hash = hash_password(new_password, salt)\n    db.execute(\n        \"UPDATE accounts SET password_hash = ?, password_salt = ? WHERE id = ?\",\n        (password_hash, salt, row[\"account_id\"]),\n    )\n    db.execute(\"DELETE FROM reset_tokens WHERE token_hash = ?\", (row[\"token_hash\"],))\n    db.commit()\n\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/outbox\")\ndef outbox():\n    to_addr = request.args.get(\"to\")\n    if not to_addr:\n        return jsonify({\"items\": []})\n    rows = get_db().execute(\n        \"SELECT id, to_addr AS 'to', subject, body, sent_at FROM outbox \"\n        \"WHERE to_addr = ? ORDER BY sent_at DESC, id DESC\",\n        (to_addr,),\n    ).fetchall()\n    items = [dict(row) for row in rows]\n    return jsonify({\"items\": items})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794315928687,"end":1794315928742}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5904461001k68tzQ4WAE2n31","sessionID":"ses_e3a7164a0ffeGzBXMRKesHHNFV","messageID":"msg_1c58fdb26001FzRDucp2dgDnxF"}}
