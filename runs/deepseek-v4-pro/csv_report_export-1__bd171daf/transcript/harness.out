{"type":"tool_use","timestamp":1794362436264,"sessionID":"ses_e37aea3c2ffeiafVDVvH1TRXi1","part":{"type":"tool","tool":"write","callID":"call_1nkpp0weo0vbph7feowfrzey","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Personal timesheet: Flask API + static frontend.\"\"\"\n\nimport csv\nimport io\nimport math\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, Response, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"timesheet.db\"\n\napp = Flask(__name__, static_folder=None)\n\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = get_db()\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS entries (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            project TEXT NOT NULL,\n            description TEXT NOT NULL,\n            hours REAL NOT NULL,\n            date TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_entries_user_date ON entries(user_id, date);\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ninit_db()\n\n\ndef get_json() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef json_error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef require_user() -> int | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    conn = get_db()\n    row = conn.execute(\n        \"SELECT user_id FROM tokens WHERE token = ?\", (token,)\n    ).fetchone()\n    conn.close()\n    return row[\"user_id\"] if row else None\n\n\ndef current_user() -> int:\n    user_id = require_user()\n    if user_id is None:\n        json_error(\"sign in required\", 401)\n    return user_id\n\n\ndef parse_date(value) -> str | None:\n    if not isinstance(value, str) or not DATE_RE.match(value):\n        return None\n    try:\n        datetime.strptime(value, \"%Y-%m-%d\")\n    except ValueError:\n        return None\n    return value\n\n\ndef parse_hours(value):\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, (int, float)):\n        num = float(value)\n    elif isinstance(value, str):\n        try:\n            num = float(value)\n        except ValueError:\n            return None\n    else:\n        return None\n    if not math.isfinite(num) or num <= 0:\n        return None\n    return num\n\n\ndef parse_text(value) -> str | None:\n    if not isinstance(value, str):\n        return None\n    text = value.strip()\n    if not text:\n        return None\n    return text\n\n\ndef validate_entry_fields(data: dict, partial: bool) -> tuple[dict, str | None]:\n    fields = {}\n    for key in (\"project\", \"description\", \"hours\", \"date\"):\n        if key not in data:\n            if partial:\n                continue\n            return {}, f\"{key} is required\"\n\n        value = data[key]\n        if key == \"project\":\n            text = parse_text(value)\n            if text is None:\n                return {}, \"project must be a non-empty string\"\n            fields[\"project\"] = text\n        elif key == \"description\":\n            if not isinstance(value, str):\n                return {}, \"description must be a string\"\n            fields[\"description\"] = value\n        elif key == \"hours\":\n            num = parse_hours(value)\n            if num is None:\n                return {}, \"hours must be a positive number\"\n            fields[\"hours\"] = num\n        elif key == \"date\":\n            date = parse_date(value)\n            if date is None:\n                return {}, \"date must be a valid date in YYYY-MM-DD format\"\n            fields[\"date\"] = date\n    return fields, None\n\n\ndef entry_to_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"project\": row[\"project\"],\n        \"description\": row[\"description\"],\n        \"hours\": row[\"hours\"],\n        \"date\": row[\"date\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef apply_filters(query: str, args: list, start_date=None, end_date=None, project=None):\n    conditions = []\n    if start_date:\n        conditions.append(\"date >= ?\")\n        args.append(start_date)\n    if end_date:\n        conditions.append(\"date <= ?\")\n        args.append(end_date)\n    if project:\n        conditions.append(\"project = ?\")\n        args.append(project)\n    if conditions:\n        query += \" AND \" + \" AND \".join(conditions)\n    return query\n\n\n# ---- auth ----\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = get_json()\n    if data is None:\n        return json_error(\"invalid JSON body\", 400)\n    username = parse_text(data.get(\"username\"))\n    password = data.get(\"password\")\n    if username is None:\n        return json_error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return json_error(\"password is required\", 400)\n\n    conn = get_db()\n    existing = conn.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing:\n        conn.close()\n        return json_error(\"username already taken\", 409)\n    conn.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), now_iso()),\n    )\n    conn.commit()\n    conn.close()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = get_json()\n    if data is None:\n        return json_error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"username and password are required\", 400)\n\n    conn = get_db()\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        conn.close()\n        return json_error(\"invalid username or password\", 401)\n\n    token = secrets.token_hex(32)\n    conn.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    conn.commit()\n    conn.close()\n    return jsonify({\"token\": token}), 200\n\n\n# ---- entries ----\n\n\n@app.get(\"/api/entries\")\ndef list_entries():\n    user_id = require_user()\n    if user_id is None:\n        return json_error(\"sign in required\", 401)\n\n    start_date = request.args.get(\"start_date\") or None\n    end_date = request.args.get(\"end_date\") or None\n    project = request.args.get(\"project\") or None\n\n    if start_date and parse_date(start_date) is None:\n        return json_error(\"start_date must be a valid date in YYYY-MM-DD format\", 400)\n    if end_date and parse_date(end_date) is None:\n        return json_error(\"end_date must be a valid date in YYYY-MM-DD format\", 400)\n\n    try:\n        page = int(request.args.get(\"page\", \"1\"))\n        page_size = int(request.args.get(\"page_size\", \"20\"))\n    except ValueError:\n        return json_error(\"page and page_size must be integers\", 400)\n    page = max(1, page)\n    page_size = min(max(1, page_size), 100)\n\n    conn = get_db()\n    base = \"FROM entries WHERE user_id = ?\"\n    args = [user_id]\n    where = apply_filters(base, args, start_date, end_date, project)\n\n    total = conn.execute(f\"SELECT COUNT(*) {where}\", args).fetchone()[0]\n\n    rows = conn.execute(\n        f\"SELECT * {where} ORDER BY date DESC, id DESC LIMIT ? OFFSET ?\",\n        args + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    conn.close()\n\n    return jsonify(\n        {\n            \"items\": [entry_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/entries\")\ndef create_entry():\n    user_id = require_user()\n    if user_id is None:\n        return json_error(\"sign in required\", 401)\n\n    data = get_json()\n    if data is None:\n        return json_error(\"invalid JSON body\", 400)\n\n    fields, error = validate_entry_fields(data, partial=False)\n    if error:\n        return json_error(error, 400)\n\n    conn = get_db()\n    cursor = conn.execute(\n        \"INSERT INTO entries (user_id, project, description, hours, date, created_at)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            user_id,\n            fields[\"project\"],\n            fields[\"description\"],\n            fields[\"hours\"],\n            fields[\"date\"],\n            now_iso(),\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\n        \"SELECT * FROM entries WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    conn.close()\n    return jsonify(entry_to_dict(row)), 201\n\n\n@app.patch(\"/api/entries/<int:entry_id>\")\ndef update_entry(entry_id: int):\n    user_id = require_user()\n    if user_id is None:\n        return json_error(\"sign in required\", 401)\n\n    data = get_json()\n    if data is None:\n        return json_error(\"invalid JSON body\", 400)\n\n    fields, error = validate_entry_fields(data, partial=True)\n    if error:\n        return json_error(error, 400)\n    if not fields:\n        return json_error(\"no valid fields to update\", 400)\n\n    conn = get_db()\n    row = conn.execute(\n        \"SELECT * FROM entries WHERE id = ? AND user_id = ?\", (entry_id, user_id)\n    ).fetchone()\n    if row is None:\n        conn.close()\n        return json_error(\"entry not found\", 404)\n\n    assignments = []\n    args = []\n    for key, value in fields.items():\n        assignments.append(f\"{key} = ?\")\n        args.append(value)\n    args += [entry_id, user_id]\n    conn.execute(\n        f\"UPDATE entries SET {', '.join(assignments)} WHERE id = ? AND user_id = ?\",\n        args,\n    )\n    conn.commit()\n    updated = conn.execute(\n        \"SELECT * FROM entries WHERE id = ?\", (entry_id,)\n    ).fetchone()\n    conn.close()\n    return jsonify(entry_to_dict(updated))\n\n\n@app.delete(\"/api/entries/<int:entry_id>\")\ndef delete_entry(entry_id: int):\n    user_id = require_user()\n    if user_id is None:\n        return json_error(\"sign in required\", 401)\n\n    conn = get_db()\n    cursor = conn.execute(\n        \"DELETE FROM entries WHERE id = ? AND user_id = ?\", (entry_id, user_id)\n    )\n    conn.commit()\n    deleted = cursor.rowcount > 0\n    conn.close()\n    if not deleted:\n        return json_error(\"entry not found\", 404)\n    return \"\", 204\n\n\n# ---- CSV export ----\n\n\ndef csv_cell(value) -> str:\n    s = \"\" if value is None else str(value)\n    if s and s[0] in \"=+-@\\t\\r\":\n        s = \"'\" + s\n    return s\n\n\ndef format_hours(h) -> str:\n    if h is None:\n        return \"\"\n    f = float(h)\n    s = f\"{f:.10f}\".rstrip(\"0\").rstrip(\".\")\n    return s or \"0\"\n\n\ndef build_csv_response(header: list[str], rows: list[list]) -> Response:\n    buf = io.StringIO()\n    writer = csv.writer(buf, lineterminator=\"\\r\\n\")\n    writer.writerow(header)\n    for row in rows:\n        writer.writerow([csv_cell(c) for c in row])\n    body = buf.getvalue()\n    return Response(\n        body,\n        mimetype=\"text/csv\",\n        headers={\"Content-Type\": \"text/csv; charset=utf-8\"},\n    )\n\n\ndef export_filters():\n    start_date = request.args.get(\"start_date\") or None\n    end_date = request.args.get(\"end_date\") or None\n    project = request.args.get(\"project\") or None\n    if start_date and parse_date(start_date) is None:\n        return None, json_error(\"start_date must be a valid date in YYYY-MM-DD format\", 400)\n    if end_date and parse_date(end_date) is None:\n        return None, json_error(\"end_date must be a valid date in YYYY-MM-DD format\", 400)\n    return (start_date, end_date, project), None\n\n\n@app.get(\"/api/exports/entries.csv\")\ndef export_entries():\n    user_id = require_user()\n    if user_id is None:\n        return json_error(\"sign in required\", 401)\n\n    filters, err = export_filters()\n    if err:\n        return err\n    start_date, end_date, project = filters\n\n    conn = get_db()\n    args = [user_id]\n    where = apply_filters(\"FROM entries WHERE user_id = ?\", args, start_date, end_date, project)\n    rows = conn.execute(f\"SELECT * {where} ORDER BY date ASC, id ASC\", args).fetchall()\n    conn.close()\n\n    data = [[r[\"date\"], r[\"project\"], r[\"description\"], format_hours(r[\"hours\"])] for r in rows]\n    resp = build_csv_response([\"date\", \"project\", \"description\", \"hours\"], data)\n    resp.headers[\"Content-Disposition\"] = \"attachment; filename=entries.csv\"\n    return resp\n\n\n@app.get(\"/api/exports/summary.csv\")\ndef export_summary():\n    user_id = require_user()\n    if user_id is None:\n        return json_error(\"sign in required\", 401)\n\n    filters, err = export_filters()\n    if err:\n        return err\n    start_date, end_date, project = filters\n\n    conn = get_db()\n    args = [user_id]\n    where = apply_filters(\"FROM entries WHERE user_id = ?\", args, start_date, end_date, project)\n    rows = conn.execute(\n        f\"SELECT project, SUM(hours) AS hours {where} GROUP BY project ORDER BY project ASC\",\n        args,\n    ).fetchall()\n    conn.close()\n\n    data = [[r[\"project\"], format_hours(r[\"hours\"])] for r in rows]\n    resp = build_csv_response([\"project\", \"hours\"], data)\n    resp.headers[\"Content-Disposition\"] = \"attachment; filename=summary.csv\"\n    return resp\n\n\n# ---- health + frontend ----\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\ndef index():\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/<path:path>\")\ndef frontend(path: str):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return json_error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794362436223,"end":1794362436243}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c855ea79001dkJLcKSQaJq0ut","sessionID":"ses_e37aea3c2ffeiafVDVvH1TRXi1","messageID":"msg_1c8538c6b0017lL4Pb35CbTyJY"}}
