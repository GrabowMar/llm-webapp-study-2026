{"type":"step_start","timestamp":1794362477781,"sessionID":"ses_e37aea3c2ffeiafVDVvH1TRXi1","part":{"id":"prt_1c8568cc5001uM4VD4b4OfOI72","messageID":"msg_1c8565649001IXh1x7dCm2C7PD","sessionID":"ses_e37aea3c2ffeiafVDVvH1TRXi1","type":"step-start"}}
{"type":"tool_use","timestamp":1794362477803,"sessionID":"ses_e37aea3c2ffeiafVDVvH1TRXi1","part":{"type":"tool","tool":"write","callID":"call_73a8uz5xa8zpnyfp5i6ovq7w","state":{"status":"completed","input":{"content":"export interface Entry {\n  id: number;\n  project: string;\n  description: string;\n  hours: number;\n  date: string;\n  created_at: string;\n}\n\nexport interface EntryPage {\n  items: Entry[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst TOKEN_KEY = \"timesheet_token\";\nconst USERNAME_KEY = \"timesheet_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function saveSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function request(path: string, options: RequestInit = {}): Promise<Response> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  if (options.body && typeof options.body === \"string\") {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const resp = await fetch(path, { ...options, headers });\n  if (resp.status === 401) {\n    clearSession();\n  }\n  return resp;\n}\n\nexport async function apiError(resp: Response): Promise<string> {\n  try {\n    const data = await resp.json();\n    if (data && typeof data.error === \"string\") {\n      return data.error;\n    }\n  } catch {\n    // ignore\n  }\n  return `Request failed (${resp.status})`;\n}\n\nexport async function register(\n  username: string,\n  password: string,\n): Promise<{ ok: boolean; error?: string }> {\n  const resp = await fetch(\"/api/auth/register\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  });\n  if (resp.ok) return { ok: true };\n  return { ok: false, error: await apiError(resp) };\n}\n\nexport async function login(\n  username: string,\n  password: string,\n): Promise<{ ok: boolean; token?: string; error?: string }> {\n  const resp = await fetch(\"/api/auth/login\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  });\n  if (resp.ok) {\n    const data = await resp.json();\n    return { ok: true, token: data.token };\n  }\n  return { ok: false, error: await apiError(resp) };\n}\n\nexport interface Filters {\n  start_date?: string;\n  end_date?: string;\n  project?: string;\n}\n\nfunction buildQuery(params: Record<string, string | number | undefined>): string {\n  const parts: string[] = [];\n  for (const [key, value] of Object.entries(params)) {\n    if (value !== undefined && value !== null && value !== \"\") {\n      parts.push(`${encodeURIComponent(key)}=${encodeURIComponent(String(value))}`);\n    }\n  }\n  return parts.length ? `?${parts.join(\"&\")}` : \"\";\n}\n\nexport async function fetchEntries(\n  filters: Filters,\n  page: number,\n  pageSize: number,\n): Promise<EntryPage> {\n  const resp = await request(\n    `/api/entries${buildQuery({\n      start_date: filters.start_date,\n      end_date: filters.end_date,\n      project: filters.project,\n      page,\n      page_size: pageSize,\n    })}`,\n  );\n  if (!resp.ok) throw new Error(await apiError(resp));\n  return resp.json();\n}\n\nexport async function createEntry(data: {\n  project: string;\n  description: string;\n  hours: number;\n  date: string;\n}): Promise<{ ok: boolean; error?: string }> {\n  const resp = await request(\"/api/entries\", {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (resp.ok) return { ok: true };\n  return { ok: false, error: await apiError(resp) };\n}\n\nexport async function updateEntry(\n  id: number,\n  fields: Partial<{ project: string; description: string; hours: number; date: string }>,\n): Promise<{ ok: boolean; error?: string }> {\n  const resp = await request(`/api/entries/${id}`, {\n    method: \"PATCH\",\n    body: JSON.stringify(fields),\n  });\n  if (resp.ok) return { ok: true };\n  return { ok: false, error: await apiError(resp) };\n}\n\nexport async function deleteEntry(id: number): Promise<{ ok: boolean; error?: string }> {\n  const resp = await request(`/api/entries/${id}`, { method: \"DELETE\" });\n  if (resp.ok) return { ok: true };\n  return { ok: false, error: await apiError(resp) };\n}\n\nexport async function downloadCsv(kind: \"entries\" | \"summary\", filters: Filters) {\n  const resp = await request(\n    `/api/exports/${kind}.csv${buildQuery({\n      start_date: filters.start_date,\n      end_date: filters.end_date,\n      project: filters.project,\n    })}`,\n  );\n  if (!resp.ok) throw new Error(await apiError(resp));\n  const blob = await resp.blob();\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement(\"a\");\n  a.href = url;\n  a.download = `${kind}.csv`;\n  document.body.appendChild(a);\n  a.click();\n  a.remove();\n  URL.revokeObjectURL(url);\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794362477774,"end":1794362477783}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8568cc8001TjnvCoxrLjD3Vn","sessionID":"ses_e37aea3c2ffeiafVDVvH1TRXi1","messageID":"msg_1c8565649001IXh1x7dCm2C7PD"}}
