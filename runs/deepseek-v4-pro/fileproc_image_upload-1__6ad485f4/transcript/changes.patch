-DIST = Path(__file__).resolve().parent.parent / "frontend" / "dist"
+PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
+JPEG_SIGNATURE = b"\xff\xd8\xff"
 
 app = Flask(__name__, static_folder=None)
+app.config["MAX_CONTENT_LENGTH"] = 32 * 1024 * 1024
+
+
+def now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def get_db() -> sqlite3.Connection:
+    conn = sqlite3.connect(DB_PATH)
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA foreign_keys = ON")
+    return conn
+
+
+def init_db() -> None:
+    DATA_DIR.mkdir(parents=True, exist_ok=True)
+    FILES_DIR.mkdir(parents=True, exist_ok=True)
+    with get_db() as conn:
+        conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS users (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                username TEXT NOT NULL UNIQUE,
+                password_hash TEXT NOT NULL,
+                created_at TEXT NOT NULL
+            )
+            """
+        )
+        conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS sessions (
+                token TEXT PRIMARY KEY,
+                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+                created_at TEXT NOT NULL
+            )
+            """
+        )
+        conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS images (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                filename TEXT NOT NULL,
+                title TEXT,
+                content_type TEXT NOT NULL,
+                size_bytes INTEGER NOT NULL,
+                uploaded_at TEXT NOT NULL,
+                uploader_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+                storage_name TEXT NOT NULL
+            )
+            """
+        )
+
+
+def image_dict(row: sqlite3.Row) -> dict:
+    return {
+        "id": row["id"],
+        "filename": row["filename"],
+        "title": row["title"],
+        "content_type": row["content_type"],
+        "size_bytes": row["size_bytes"],
+        "uploaded_at": row["uploaded_at"],
+        "url": f"/api/images/{row['id']}/file",
+        "uploader": row["username"],
+    }
+
+
+def current_user() -> sqlite3.Row | None:
+    auth = request.headers.get("Authorization", "")
+    if not auth.startswith("Bearer "):
+        return None
+    token = auth[len("Bearer "):].strip()
+    if not token:
+        return None
+    with get_db() as conn:
+        row = conn.execute(
+            """
+            SELECT u.id, u.username
+            FROM sessions s
+            JOIN users u ON u.id = s.user_id
+            WHERE s.token = ?
+            """,
+            (token,),
+        ).fetchone()
+    return row
+
+
+def require_user() -> sqlite3.Row:
+    user = current_user()
+    if user is None:
+        raise ApiError(401, "authentication required")
+    return user
+
+
+class ApiError(Exception):
+    def __init__(self, status: int, message: str):
+        super().__init__(message)
+        self.status = status
+        self.message = message
+
+
+@app.errorhandler(ApiError)
+def handle_api_error(err: ApiError):
+    return jsonify({"error": err.message}), err.status
+
+
+@app.errorhandler(413)
+def handle_too_large(_err):
+    return jsonify({"error": "file too large"}), 413
+
+
+def detect_content_type(data: bytes) -> str | None:
+    if data.startswith(PNG_SIGNATURE):
+        return "image/png"
+    if data.startswith(JPEG_SIGNATURE):
+        return "image/jpeg"
+    return None
+
+
+def decode_data(raw: str) -> bytes:
+    if not isinstance(raw, str) or not raw.strip():
+        raise ApiError(400, "data is required")
+    raw = raw.strip()
+    if raw.startswith("data:"):
+        if "," not in raw:
+            raise ApiError(400, "invalid data")
+        raw = raw.split(",", 1)[1]
+    try:
+        return base64.b64decode(raw, validate=True)
+    except (binascii.Error, ValueError):
+        raise ApiError(400, "data is not valid base64")
 
 
