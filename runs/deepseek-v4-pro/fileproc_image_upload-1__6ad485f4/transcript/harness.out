{"type":"tool_use","timestamp":1794342097307,"sessionID":"ses_e38e260b1ffeHzblIyyPT60RUy","part":{"type":"tool","tool":"write","callID":"call_q8c16ijharbgndyrc99f217j","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Image gallery: Flask API + static frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, Response, jsonify, request, send_file, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE = Path(__file__).resolve().parent.parent\nDIST = BASE / \"frontend\" / \"dist\"\nDATA_DIR = BASE / \"data\"\nFILES_DIR = DATA_DIR / \"files\"\nDB_PATH = DATA_DIR / \"gallery.db\"\n\nPNG_SIGNATURE = b\"\\x89PNG\\r\\n\\x1a\\n\"\nJPEG_SIGNATURE = b\"\\xff\\xd8\\xff\"\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 32 * 1024 * 1024\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    FILES_DIR.mkdir(parents=True, exist_ok=True)\n    with get_db() as conn:\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            )\n            \"\"\"\n        )\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            )\n            \"\"\"\n        )\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS images (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                filename TEXT NOT NULL,\n                title TEXT,\n                content_type TEXT NOT NULL,\n                size_bytes INTEGER NOT NULL,\n                uploaded_at TEXT NOT NULL,\n                uploader_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                storage_name TEXT NOT NULL\n            )\n            \"\"\"\n        )\n\n\ndef image_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"filename\": row[\"filename\"],\n        \"title\": row[\"title\"],\n        \"content_type\": row[\"content_type\"],\n        \"size_bytes\": row[\"size_bytes\"],\n        \"uploaded_at\": row[\"uploaded_at\"],\n        \"url\": f\"/api/images/{row['id']}/file\",\n        \"uploader\": row[\"username\"],\n    }\n\n\ndef current_user() -> sqlite3.Row | None:\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    with get_db() as conn:\n        row = conn.execute(\n            \"\"\"\n            SELECT u.id, u.username\n            FROM sessions s\n            JOIN users u ON u.id = s.user_id\n            WHERE s.token = ?\n            \"\"\",\n            (token,),\n        ).fetchone()\n    return row\n\n\ndef require_user() -> sqlite3.Row:\n    user = current_user()\n    if user is None:\n        raise ApiError(401, \"authentication required\")\n    return user\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err: ApiError):\n    return jsonify({\"error\": err.message}), err.status\n\n\n@app.errorhandler(413)\ndef handle_too_large(_err):\n    return jsonify({\"error\": \"file too large\"}), 413\n\n\ndef detect_content_type(data: bytes) -> str | None:\n    if data.startswith(PNG_SIGNATURE):\n        return \"image/png\"\n    if data.startswith(JPEG_SIGNATURE):\n        return \"image/jpeg\"\n    return None\n\n\ndef decode_data(raw: str) -> bytes:\n    if not isinstance(raw, str) or not raw.strip():\n        raise ApiError(400, \"data is required\")\n    raw = raw.strip()\n    if raw.startswith(\"data:\"):\n        if \",\" not in raw:\n            raise ApiError(400, \"invalid data\")\n        raw = raw.split(\",\", 1)[1]\n    try:\n        return base64.b64decode(raw, validate=True)\n    except (binascii.Error, ValueError):\n        raise ApiError(400, \"data is not valid base64\")\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = request.get_json(silent=True) or {}\n    username = (body.get(\"username\") or \"\").strip()\n    password = body.get(\"password\") or \"\"\n    if not username:\n        raise ApiError(400, \"username is required\")\n    if not password:\n        raise ApiError(400, \"password is required\")\n\n    password_hash = generate_password_hash(password)\n    try:\n        with get_db() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, password_hash, now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        raise ApiError(409, \"username already exists\")\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = request.get_json(silent=True) or {}\n    username = (body.get(\"username\") or \"\").strip()\n    password = body.get(\"password\") or \"\"\n    if not username or not password:\n        raise ApiError(400, \"username and password are required\")\n\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n            (username,),\n        ).fetchone()\n\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"invalid username or password\")\n\n    token = secrets.token_hex(32)\n    with get_db() as conn:\n        conn.execute(\n            \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n            (token, row[\"id\"], now_iso()),\n        )\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/images\")\ndef list_images():\n    page = request.args.get(\"page\", 1, type=int)\n    page_size = request.args.get(\"page_size\", 20, type=int)\n    if page < 1:\n        page = 1\n    if page_size < 1:\n        page_size = 1\n    if page_size > 100:\n        page_size = 100\n\n    with get_db() as conn:\n        total = conn.execute(\"SELECT COUNT(*) AS c FROM images\").fetchone()[\"c\"]\n        rows = conn.execute(\n            \"\"\"\n            SELECT i.*, u.username\n            FROM images i\n            JOIN users u ON u.id = i.uploader_id\n            ORDER BY i.id DESC\n            LIMIT ? OFFSET ?\n            \"\"\",\n            (page_size, (page - 1) * page_size),\n        ).fetchall()\n\n    items = [image_dict(r) for r in rows]\n    return jsonify(\n        {\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size}\n    )\n\n\n@app.post(\"/api/images\")\ndef create_image():\n    user = require_user()\n    body = request.get_json(silent=True) or {}\n    filename = (body.get(\"filename\") or \"\").strip()\n    if not filename:\n        raise ApiError(400, \"filename is required\")\n    title = body.get(\"title\")\n    if title is not None:\n        title = str(title).strip() or None\n\n    data = decode_data(body.get(\"data\", \"\"))\n    content_type = detect_content_type(data)\n    if content_type is None:\n        raise ApiError(400, \"only PNG and JPEG images are supported\")\n\n    storage_name = secrets.token_hex(16)\n    path = FILES_DIR / storage_name\n    path.write_bytes(data)\n\n    try:\n        with get_db() as conn:\n            cur = conn.execute(\n                \"\"\"\n                INSERT INTO images\n                    (filename, title, content_type, size_bytes, uploaded_at, uploader_id, storage_name)\n                VALUES (?, ?, ?, ?, ?, ?, ?)\n                \"\"\",\n                (\n                    filename,\n                    title,\n                    content_type,\n                    len(data),\n                    now_iso(),\n                    user[\"id\"],\n                    storage_name,\n                ),\n            )\n            image_id = cur.lastrowid\n            row = conn.execute(\n                \"\"\"\n                SELECT i.*, u.username\n                FROM images i\n                JOIN users u ON u.id = i.uploader_id\n                WHERE i.id = ?\n                \"\"\",\n                (image_id,),\n            ).fetchone()\n    except Exception:\n        path.unlink(missing_ok=True)\n        raise\n\n    return jsonify(image_dict(row)), 201\n\n\n@app.get(\"/api/images/<int:image_id>\")\ndef get_image(image_id: int):\n    with get_db() as conn:\n        row = conn.execute(\n            \"\"\"\n            SELECT i.*, u.username\n            FROM images i\n            JOIN users u ON u.id = i.uploader_id\n            WHERE i.id = ?\n            \"\"\",\n            (image_id,),\n        ).fetchone()\n    if row is None:\n        raise ApiError(404, \"image not found\")\n    return jsonify(image_dict(row))\n\n\n@app.get(\"/api/images/<int:image_id>/file\")\ndef get_image_file(image_id: int):\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT storage_name, content_type, filename FROM images WHERE id = ?\",\n            (image_id,),\n        ).fetchone()\n    if row is None:\n        raise ApiError(404, \"image not found\")\n    path = FILES_DIR / row[\"storage_name\"]\n    if not path.is_file():\n        raise ApiError(404, \"image file not found\")\n    return send_file(path, mimetype=row[\"content_type\"])\n\n\n@app.delete(\"/api/images/<int:image_id>\")\ndef delete_image(image_id: int):\n    user = require_user()\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT id, uploader_id, storage_name FROM images WHERE id = ?\",\n            (image_id,),\n        ).fetchone()\n        if row is None:\n            raise ApiError(404, \"image not found\")\n        if row[\"uploader_id\"] != user[\"id\"]:\n            raise ApiError(403, \"only the uploader may delete this image\")\n        conn.execute(\"DELETE FROM images WHERE id = ?\", (image_id,))\n\n    (FILES_DIR / row[\"storage_name\"]).unlink(missing_ok=True)\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794342097260,"end":1794342097284}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c71f9163001TCAFmLZLrUKb0l","sessionID":"ses_e38e260b1ffeHzblIyyPT60RUy","messageID":"msg_1c71ed2eb001KbYIZ29CYhBUHU"}}
