s']))\nimg = d['items'][0]\nprint('item keys', sorted(img.keys()))\nprint('newest first', [i['filename'] for i in d['items']])\n\n# get one\nr = c.get('/api/images/'+str(img['id']))\nprint('get one', r.status_code, r.get_json()['filename'])\n\n# get file\nr = c.get(img['url'])\nprint('file', r.status_code, r.content_type, r.data[:8])\n\n# delete by non-uploader\nc.post('/api/auth/register', json={'username':'bob','password':'pw'})\nrb = c.post('/api/auth/login', json={'username':'bob','password':'pw'})\nbtok = rb.get_json()['token']\nr = c.delete('/api/images/'+str(img['id']), headers={'Authorization':'Bearer '+btok})\nprint('delete by other', r.status_code, r.get_json())\n\n# delete own\nr = c.delete('/api/images/'+str(img['id']), headers={'Authorization':'Bearer '+tok})\nprint('delete own', r.status_code)\n\n# 404\nr = c.get('/api/images/99999')\nprint('get missing', r.status_code, r.get_json())\n\" 2>&1"},"output":"health 200 {'status': 'ok'}\nregister 201 {'username': 'alice'}\nregister dup 409 {'error': 'username already exists'}\nlogin 200 {'token': 'c60364ffe6d5690347b923d7836482c59da0767c26a9dcb2c06fbb413aaa596f'}\nlogin bad 401 {'error': 'invalid username or password'}\nupload png 201 {'content_type': 'image/png', 'filename': 'a.png', 'id': 1, 'size_bytes': 19, 'title': None, 'uploaded_at': '2026-11-10T20:26:03.722185+00:00', 'uploader': 'alice', 'url': '/api/images/1/file'}\nupload jpg 201 {'content_type': 'image/jpeg', 'filename': 'b.jpg', 'id': 2, 'size_bytes': 11, 'title': 'Hello', 'uploaded_at': '2026-11-10T20:26:03.725056+00:00', 'uploader': 'alice', 'url': '/api/images/2/file'}\nupload bad 400 {'error': 'only PNG and JPEG images are supported'}\nupload noauth 401 {'error': 'authentication required'}\nlist 200 total 2 n 2\nitem keys ['content_type', 'filename', 'id', 'size_bytes', 'title', 'uploaded_at', 'uploader', 'url']\nnewest first ['b.jpg', 'a.png']\nget one 200 b.jpg\nfile 200 image/jpeg b'\\xff\\xd8\\xff\\xe0fakj'\ndelete by other 403 {'error'