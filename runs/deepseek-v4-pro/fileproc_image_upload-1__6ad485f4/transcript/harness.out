{"type":"tool_use","timestamp":1794342200641,"sessionID":"ses_e38e260b1ffeHzblIyyPT60RUy","part":{"type":"tool","tool":"write","callID":"call_ekexju5uyxevppiyrj628jj5","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n\ntype Image = {\n  id: number;\n  filename: string;\n  title: string | null;\n  content_type: string;\n  size_bytes: number;\n  uploaded_at: string;\n  url: string;\n  uploader: string;\n};\n\ntype ListResponse = {\n  items: Image[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nconst TOKEN_KEY = \"gallery_token\";\nconst USERNAME_KEY = \"gallery_username\";\n\nfunction getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nfunction getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nfunction setAuth(token: string | null, username: string | null) {\n  if (token && username) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USERNAME_KEY, username);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USERNAME_KEY);\n  }\n}\n\nasync function api<T>(\n  path: string,\n  options: RequestInit = {}\n): Promise<{ ok: boolean; status: number; data: T | null; error: string | null }> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string>),\n  };\n  if (options.body && !headers[\"Content-Type\"]) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n\n  let res: Response;\n  try {\n    res = await fetch(path, { ...options, headers });\n  } catch {\n    return { ok: false, status: 0, data: null, error: \"network error\" };\n  }\n\n  if (res.status === 204) {\n    return { ok: true, status: 204, data: null, error: null };\n  }\n  const text = await res.text();\n  let data: any = null;\n  try {\n    data = text ? JSON.parse(text) : null;\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const message =\n      data && typeof data.error === \"string\"\n        ? data.error\n        : `request failed (${res.status})`;\n    return { ok: false, status: res.status, data, error: message };\n  }\n  return { ok: true, status: res.status, data: data as T, error: null };\n}\n\nfunction formatBytes(bytes: number): string {\n  if (bytes < 1024) return `${bytes} B`;\n  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n}\n\nfunction formatDate(iso: string): string {\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return iso;\n  return d.toLocaleString();\n}\n\nfunction Field(props: {\n  label: string;\n  type?: string;\n  value: string;\n  onChange: (v: string) => void;\n  autoComplete?: string;\n}) {\n  return (\n    <label className=\"block\">\n      <span className=\"mb-1 block text-sm font-medium text-gray-700\">\n        {props.label}\n      </span>\n      <input\n        type={props.type ?? \"text\"}\n        value={props.value}\n        autoComplete={props.autoComplete}\n        onChange={(e) => props.onChange(e.target.value)}\n        className=\"w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n      />\n    </label>\n  );\n}\n\nfunction ErrorBanner({ message }: { message: string }) {\n  if (!message) return null;\n  return (\n    <div className=\"rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </div>\n  );\n}\n\nfunction AuthForms({\n  onAuthed,\n}: {\n  onAuthed: (username: string) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        const res = await api(\"/api/auth/register\", {\n          method: \"POST\",\n          body: JSON.stringify({ username, password }),\n        });\n        if (!res.ok) {\n          setError(res.error ?? \"registration failed\");\n          return;\n        }\n      }\n      const login = await api(\"/api/auth/login\", {\n        method: \"POST\",\n        body: JSON.stringify({ username, password }),\n      });\n      if (!login.ok || !login.data || !login.data.token) {\n        setError(login.error ?? \"sign in failed\");\n        return;\n      }\n      setAuth(login.data.token, username);\n      onAuthed(username);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto mt-16 max-w-sm\">\n      <h1 className=\"mb-6 text-center text-2xl font-semibold text-gray-900\">\n        Image gallery\n      </h1>\n      <div className=\"rounded-xl border border-gray-200 bg-white p-6 shadow-sm\">\n        <div className=\"mb-4 flex rounded-lg bg-gray-100 p-1 text-sm font-medium\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\"login\");\n              setError(\"\");\n            }}\n            className={`flex-1 rounded-md py-1.5 ${\n              mode === \"login\" ? \"bg-white shadow\" : \"text-gray-600\"\n            }`}\n          >\n            Sign in\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\"register\");\n              setError(\"\");\n            }}\n            className={`flex-1 rounded-md py-1.5 ${\n              mode === \"register\" ? \"bg-white shadow\" : \"text-gray-600\"\n            }`}\n          >\n            Register\n          </button>\n        </div>\n        <form onSubmit={submit} className=\"space-y-4\">\n          <Field\n            label=\"Username\"\n            value={username}\n            onChange={setUsername}\n            autoComplete=\"username\"\n          />\n          <Field\n            label=\"Password\"\n            type=\"password\"\n            value={password}\n            onChange={setPassword}\n            autoComplete={\n              mode === \"login\" ? \"current-password\" : \"new-password\"\n            }\n          />\n          <ErrorBanner message={error} />\n          <button\n            type=\"submit\"\n            disabled={busy || !username || !password}\n            className=\"w-full rounded-md bg-indigo-600 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}\n\nfunction UploadForm({ onUploaded }: { onUploaded: () => void }) {\n  const [filename, setFilename] = useState(\"\");\n  const [title, setTitle] = useState(\"\");\n  const [preview, setPreview] = useState<string | null>(null);\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const fileRef = useRef<HTMLInputElement>(null);\n\n  function handleFile(file: File | null) {\n    setError(\"\");\n    if (!file) {\n      setPreview(null);\n      setFilename(\"\");\n      return;\n    }\n    const lower = file.name.toLowerCase();\n    const ok = lower.endsWith(\".png\") || lower.endsWith(\".jpg\") || lower.endsWith(\".jpeg\");\n    if (!ok) {\n      setError(\"only PNG and JPEG images are supported\");\n      setPreview(null);\n      setFilename(file.name);\n      if (fileRef.current) fileRef.current.value = \"\";\n      return;\n    }\n    setFilename(file.name);\n    const reader = new FileReader();\n    reader.onload = () => setPreview(reader.result as string);\n    reader.readAsDataURL(file);\n  }\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    if (!preview) {\n      setError(\"choose a PNG or JPEG image\");\n      return;\n    }\n    setBusy(true);\n    try {\n      const res = await api(\"/api/images\", {\n        method: \"POST\",\n        body: JSON.stringify({\n          filename: filename || \"image\",\n          title: title || undefined,\n          data: preview,\n        }),\n      });\n      if (!res.ok) {\n        setError(res.error ?? \"upload failed\");\n        return;\n      }\n      setFilename(\"\");\n      setTitle(\"\");\n      setPreview(null);\n      if (fileRef.current) fileRef.current.value = \"\";\n      onUploaded();\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <section className=\"rounded-xl border border-gray-200 bg-white p-5 shadow-sm\">\n      <h2 className=\"mb-4 text-lg font-semibold text-gray-900\">Upload image</h2>\n      <form onSubmit={submit} className=\"space-y-4\">\n        <input\n          ref={fileRef}\n          type=\"file\"\n          accept=\".png,.jpg,.jpeg,image/png,image/jpeg\"\n          onChange={(e) => handleFile(e.target.files?.[0] ?? null)}\n          className=\"block w-full text-sm text-gray-600 file:mr-3 file:rounded-md file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100\"\n        />\n        {preview && (\n          <img\n            src={preview}\n            alt=\"Preview\"\n            className=\"max-h-48 rounded-lg border border-gray-200 object-contain\"\n          />\n        )}\n        <Field label=\"Filename\" value={filename} onChange={setFilename} />\n        <Field label=\"Title (optional)\" value={title} onChange={setTitle} />\n        <ErrorBanner message={error} />\n        <button\n          type=\"submit\"\n          disabled={busy || !preview}\n          className=\"rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\"\n        >\n          Upload\n        </button>\n      </form>\n    </section>\n  );\n}\n\nfunction Viewer({ image, onClose }: { image: Image; onClose: () => void }) {\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.key === \"Escape\") onClose();\n    };\n    window.addEventListener(\"keydown\", onKey);\n    return () => window.removeEventListener(\"keydown\", onKey);\n  }, [onClose]);\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4\"\n      onClick={onClose}\n    >\n      <div\n        className=\"max-h-full max-w-4xl overflow-hidden rounded-xl bg-white shadow-xl\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <div className=\"flex items-center justify-between border-b border-gray-200 px-4 py-3\">\n          <div className=\"min-w-0\">\n            <h3 className=\"truncate font-semibold text-gray-900\">\n              {image.title || image.filename}\n            </h3>\n            <p className=\"text-xs text-gray-500\">\n              {image.filename} · {formatBytes(image.size_bytes)} ·{\" \"}\n              {formatDate(image.uploaded_at)}\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"ml-4 rounded-md px-2 py-1 text-gray-500 hover:bg-gray-100 hover:text-gray-800\"\n            aria-label=\"Close\"\n          >\n            ✕\n          </button>\n        </div>\n        <div className=\"flex max-h-[80vh] items-center justify-center bg-gray-900 p-4\">\n          <img\n            src={image.url}\n            alt={image.title || image.filename}\n            className=\"max-h-[75vh] max-w-full object-contain\"\n          />\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction Gallery({ username }: { username: string | null }) {\n  const [data, setData] = useState<ListResponse | null>(null);\n  const [page, setPage] = useState(1);\n  const [pageSize, setPageSize] = useState(12);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n  const [viewer, setViewer] = useState<Image | null>(null);\n  const [deleting, setDeleting] = useState<number | null>(null);\n  const [confirmDelete, setConfirmDelete] = useState<number | null>(null);\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  const load = useCallback(\n    async (p: number, size: number) => {\n      setLoading(true);\n      setError(\"\");\n      const res = await api<ListResponse>(\n        `/api/images?page=${p}&page_size=${size}`\n      );\n      if (!res.ok) {\n        setError(res.error ?? \"failed to load images\");\n        setData(null);\n      } else {\n        setData(res.data);\n      }\n      setLoading(false);\n    },\n    []\n  );\n\n  useEffect(() => {\n    load(page, pageSize);\n  }, [page, pageSize, load]);\n\n  useEffect(() => {\n    setPage(1);\n  }, [pageSize]);\n\n  async function handleDelete(id: number) {\n    setDeleting(id);\n    setError(\"\");\n    try {\n      const res = await api(`/api/images/${id}`, { method: \"DELETE\" });\n      if (!res.ok) {\n        setError(res.error ?? \"delete failed\");\n        return;\n      }\n      setConfirmDelete(null);\n      await load(page, pageSize);\n    } finally {\n      setDeleting(null);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-6xl px-4 py-8\">\n      <div className=\"grid gap-8 lg:grid-cols-[320px_1fr]\">\n        <div className=\"space-y-6\">\n          {username ? (\n            <UploadForm onUploaded={() => load(page, pageSize)} />\n          ) : (\n            <p className=\"rounded-xl border border-gray-200 bg-white p-4 text-sm text-gray-600 shadow-sm\">\n              Sign in to upload your own images.\n            </p>\n          )}\n        </div>\n\n        <div>\n          <div className=\"mb-4 flex items-center justify-between\">\n            <h2 className=\"text-lg font-semibold text-gray-900\">Gallery</h2>\n            <label className=\"flex items-center gap-2 text-sm text-gray-600\">\n              Per page\n              <select\n                value={pageSize}\n                onChange={(e) => setPageSize(Number(e.target.value))}\n                className=\"rounded-md border border-gray-300 px-2 py-1 text-sm\"\n              >\n                {[12, 24, 48].map((n) => (\n                  <option key={n} value={n}>\n                    {n}\n                  </option>\n                ))}\n              </select>\n            </label>\n          </div>\n\n          <ErrorBanner message={error} />\n\n          {loading ? (\n            <p className=\"py-12 text-center text-gray-500\">Loading…</p>\n          ) : !data || data.items.length === 0 ? (\n            <div className=\"rounded-xl border border-dashed border-gray-300 py-16 text-center\">\n              <p className=\"text-gray-500\">No images yet.</p>\n              {username ? (\n                <p className=\"mt-1 text-sm text-gray-400\">\n                  Upload the first one to get started.\n                </p>\n              ) : (\n                <p className=\"mt-1 text-sm text-gray-400\">\n                  Sign in and upload the first image.\n                </p>\n              )}\n            </div>\n          ) : (\n            <>\n              <div className=\"grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4\">\n                {data.items.map((img) => (\n                  <button\n                    key={img.id}\n                    onClick={() => setViewer(img)}\n                    className=\"group overflow-hidden rounded-lg border border-gray-200 bg-white text-left shadow-sm transition hover:shadow-md\"\n                  >\n                    <div className=\"aspect-square w-full bg-gray-100\">\n                      <img\n                        src={img.url}\n                        alt={img.title || img.filename}\n                        loading=\"lazy\"\n                        className=\"h-full w-full object-cover\"\n                      />\n                    </div>\n                    <div className=\"p-2\">\n                      <p className=\"truncate text-sm font-medium text-gray-900\">\n                        {img.title || img.filename}\n                      </p>\n                      <p className=\"truncate text-xs text-gray-500\">\n                        {img.uploader} · {formatDate(img.uploaded_at)}\n                      </p>\n                    </div>\n                  </button>\n                ))}\n              </div>\n\n              <div className=\"mt-6 flex items-center justify-between\">\n                <p className=\"text-sm text-gray-500\">\n                  {data.total} image{data.total === 1 ? \"\" : \"s\"}\n                </p>\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    disabled={page <= 1}\n                    onClick={() => setPage((p) => p - 1)}\n                    className=\"rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40\"\n                  >\n                    Previous\n                  </button>\n                  <span className=\"text-sm text-gray-600\">\n                    Page {data.page} of {totalPages}\n                  </span>\n                  <button\n                    disabled={page >= totalPages}\n                    onClick={() => setPage((p) => p + 1)}\n                    className=\"rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40\"\n                  >\n                    Next\n                  </button>\n                </div>\n              </div>\n            </>\n          )}\n        </div>\n      </div>\n\n      {viewer && (\n        <Viewer\n          image={viewer}\n          onClose={() => {\n            setViewer(null);\n            setConfirmDelete(null);\n          }}\n        />\n      )}\n\n      {viewer && username === viewer.uploader && (\n        <div className=\"fixed inset-x-0 bottom-0 z-50 flex justify-center p-4\">\n          {confirmDelete === viewer.id ? (\n            <div className=\"flex items-center gap-3 rounded-lg border border-red-300 bg-white px-4 py-3 shadow-lg\">\n              <span className=\"text-sm text-gray-700\">\n                Delete this image?\n              </span>\n              <button\n                onClick={() => setConfirmDelete(null)}\n                className=\"rounded-md border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={() => handleDelete(viewer.id)}\n                disabled={deleting === viewer.id}\n                className=\"rounded-md bg-red-600 px-3 py-1 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50\"\n              >\n                Delete\n              </button>\n            </div>\n          ) : (\n            <button\n              onClick={() => setConfirmDelete(viewer.id)}\n              className=\"rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-lg hover:bg-red-700\"\n            >\n              Delete\n            </button>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(getUsername());\n\n  const token = getToken();\n\n  const signOut = () => {\n    setAuth(null, null);\n    setUsername(null);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 text-gray-900\">\n      {token && username ? (\n        <>\n          <header className=\"border-b border-gray-200 bg-white\">\n            <div className=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-3\">\n              <h1 className=\"text-xl font-semibold\">Image gallery</h1>\n              <div className=\"flex items-center gap-3\">\n                <span className=\"text-sm text-gray-600\">\n                  Signed in as{\" \"}\n                  <span className=\"font-medium text-gray-900\">{username}</span>\n                </span>\n                <button\n                  onClick={signOut}\n                  className=\"rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50\"\n                >\n                  Sign out\n                </button>\n              </div>\n            </div>\n          </header>\n          <Gallery username={username} />\n        </>\n      ) : (\n        <AuthForms onAuthed={setUsername} />\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794342200588,"end":1794342200623}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7212504001RRamhK94RMfrC3","sessionID":"ses_e38e260b1ffeHzblIyyPT60RUy","messageID":"msg_1c7207f960018PdhftQL7XvUEl"}}
