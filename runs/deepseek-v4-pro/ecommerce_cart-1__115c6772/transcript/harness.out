{"type":"tool_use","timestamp":1794378954110,"sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","part":{"type":"tool","tool":"write","callID":"call_jqvtsmwvu8zbae69xrc2rect","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Shop backend: JSON API + frontend static serving.\"\"\"\n\nimport os\nimport re\nimport sqlite3\nimport secrets\nimport hashlib\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import generate_password_hash, check_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"shop.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\n\n# --------------------------------------------------------------------------\n# Database helpers\n# --------------------------------------------------------------------------\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\n\nCREATE TABLE IF NOT EXISTS products (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    price REAL NOT NULL,\n    stock INTEGER NOT NULL DEFAULT 0,\n    is_active INTEGER NOT NULL DEFAULT 1\n);\n\nCREATE TABLE IF NOT EXISTS cart_items (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n    quantity INTEGER NOT NULL DEFAULT 1,\n    UNIQUE (user_id, product_id)\n);\n\"\"\"\n\nSEED_PRODUCTS = [\n    (\"Espresso Cup\", \"A small ceramic cup for espresso.\", 12.50, 40),\n    (\"French Press\", \"1 litre glass and steel press.\", 29.99, 25),\n    (\"Coffee Grinder\", \"Burr grinder for consistent grounds.\", 74.00, 15),\n    (\"Moka Pot\", \"3-cup stovetop espresso maker.\", 24.95, 30),\n    (\"Pour-over Dripper\", \"Ceramic cone dripper.\", 18.00, 20),\n    (\"Gooseneck Kettle\", \"Stainless steel pouring kettle.\", 55.50, 12),\n    (\"Beans 250g\", \"Single-origin medium roast.\", 9.90, 100),\n    (\"Travel Mug\", \"Insulated 350ml travel mug.\", 21.00, 35),\n    (\"Milk Frother\", \"Handheld battery frother.\", 13.25, 18),\n    (\"Digital Scale\", \"Coffee scale with timer.\", 39.00, 10),\n]\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(SCHEMA)\n    count = conn.execute(\"SELECT COUNT(*) AS c FROM products\").fetchone()[\"c\"]\n    if count == 0:\n        conn.executemany(\n            \"INSERT INTO products (name, description, price, stock, is_active) \"\n            \"VALUES (?, ?, ?, ?, 1)\",\n            SEED_PRODUCTS,\n        )\n    conn.commit()\n    conn.close()\n\n\n# --------------------------------------------------------------------------\n# Auth helpers\n# --------------------------------------------------------------------------\n\ndef _hash_password(password: str) -> str:\n    return generate_password_hash(password)\n\n\ndef _verify_password(password: str, stored: str) -> bool:\n    return check_password_hash(stored, password)\n\n\ndef _issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id))\n    db.commit()\n    return token\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"SELECT u.id, u.username, u.is_admin FROM users u \"\n        \"JOIN tokens t ON t.user_id = u.id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef _require_user():\n    user = current_user()\n    if user is None:\n        return None\n    return user\n\n\ndef _require_admin():\n    user = current_user()\n    if user is None or not user[\"is_admin\"]:\n        return None\n    return user\n\n\n# --------------------------------------------------------------------------\n# Error helpers\n# --------------------------------------------------------------------------\n\ndef _error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\n# --------------------------------------------------------------------------\n# Auth routes\n# --------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not username.strip():\n        return _error(\"username is required\", 400)\n    username = username.strip()\n    if not isinstance(password, str) or not password:\n        return _error(\"password is required\", 400)\n    if not re.match(r\"^[A-Za-z0-9_.-]{1,64}$\", username):\n        return _error(\"invalid username\", 400)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing:\n        return _error(\"username already taken\", 409)\n\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n        (username, _hash_password(password)),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not isinstance(password, str):\n        return _error(\"username and password are required\", 400)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash, is_admin FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n\n    if user is None or not _verify_password(password, user[\"password_hash\"]):\n        return _error(\"invalid username or password\", 401)\n\n    token = _issue_token(user[\"id\"])\n    return jsonify({\"token\": token})\n\n\n# --------------------------------------------------------------------------\n# Product serialization\n# --------------------------------------------------------------------------\n\ndef _product_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": row[\"price\"],\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\n# --------------------------------------------------------------------------\n# Product routes\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/products\")\ndef list_products():\n    q = request.args.get(\"q\", \"\").strip()\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 20))\n    except (TypeError, ValueError):\n        page_size = 20\n    page_size = max(1, min(100, page_size))\n\n    db = get_db()\n    where = \"WHERE is_active = 1\"\n    params = []\n    if q:\n        where += \" AND name LIKE ?\"\n        params.append(f\"%{q}%\")\n\n    total = db.execute(\n        f\"SELECT COUNT(*) AS c FROM products {where}\", params\n    ).fetchone()[\"c\"]\n\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"SELECT * FROM products {where} ORDER BY name COLLATE NOCASE, id \"\n        \"LIMIT ? OFFSET ?\",\n        params + [page_size, offset],\n    ).fetchall()\n\n    return jsonify({\n        \"items\": [_product_dict(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    })\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef get_product(product_id):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return _error(\"product not found\", 404)\n    return jsonify(_product_dict(row))\n\n\n# --------------------------------------------------------------------------\n# Cart routes\n# --------------------------------------------------------------------------\n\ndef _cart_item_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": row[\"quantity\"],\n        \"name\": row[\"name\"],\n        \"unit_price\": row[\"price\"],\n        \"line_total\": round(row[\"price\"] * row[\"quantity\"], 2),\n    }\n\n\n@app.get(\"/api/cart\")\ndef get_cart():\n    user = _require_user()\n    if user is None:\n        return _error(\"authentication required\", 401)\n\n    db = get_db()\n    rows = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price \"\n        \"FROM cart_items ci \"\n        \"JOIN products p ON p.id = ci.product_id \"\n        \"WHERE ci.user_id = ? AND p.is_active = 1 \"\n        \"ORDER BY ci.id\",\n        (user[\"id\"],),\n    ).fetchall()\n\n    items = [_cart_item_dict(r) for r in rows]\n    subtotal = round(sum(i[\"line_total\"] for i in items), 2)\n    return jsonify({\"items\": items, \"subtotal\": subtotal})\n\n\n@app.post(\"/api/cart\")\ndef add_to_cart():\n    user = _require_user()\n    if user is None:\n        return _error(\"authentication required\", 401)\n\n    data = request.get_json(silent=True) or {}\n    product_id = data.get(\"product_id\")\n    quantity = data.get(\"quantity\", 1)\n\n    if not isinstance(product_id, int):\n        return _error(\"product_id is required\", 400)\n    if not isinstance(quantity, int) or quantity <= 0:\n        return _error(\"quantity must be a positive integer\", 400)\n\n    db = get_db()\n    product = db.execute(\n        \"SELECT id FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if product is None:\n        return _error(\"product not found\", 404)\n\n    existing = db.execute(\n        \"SELECT id, quantity FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (user[\"id\"], product_id),\n    ).fetchone()\n\n    if existing:\n        new_qty = existing[\"quantity\"] + quantity\n        db.execute(\n            \"UPDATE cart_items SET quantity = ? WHERE id = ?\",\n            (new_qty, existing[\"id\"]),\n        )\n        item_id = existing[\"id\"]\n    else:\n        cur = db.execute(\n            \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n            (user[\"id\"], product_id, quantity),\n        )\n        item_id = cur.lastrowid\n    db.commit()\n\n    row = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price \"\n        \"FROM cart_items ci JOIN products p ON p.id = ci.product_id \"\n        \"WHERE ci.id = ?\",\n        (item_id,),\n    ).fetchone()\n    return jsonify(_cart_item_dict(row)), 200\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\ndef update_cart_item(item_id):\n    user = _require_user()\n    if user is None:\n        return _error(\"authentication required\", 401)\n\n    data = request.get_json(silent=True) or {}\n    quantity = data.get(\"quantity\")\n    if not isinstance(quantity, int) or quantity <= 0:\n        return _error(\"quantity must be a positive integer\", 400)\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT ci.id, ci.quantity FROM cart_items ci \"\n        \"JOIN products p ON p.id = ci.product_id \"\n        \"WHERE ci.id = ? AND ci.user_id = ? AND p.is_active = 1\",\n        (item_id, user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return _error(\"cart item not found\", 404)\n\n    db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n    db.commit()\n\n    updated = db.execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price \"\n        \"FROM cart_items ci JOIN products p ON p.id = ci.product_id \"\n        \"WHERE ci.id = ?\",\n        (item_id,),\n    ).fetchone()\n    return jsonify(_cart_item_dict(updated))\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\ndef remove_cart_item(item_id):\n    user = _require_user()\n    if user is None:\n        return _error(\"authentication required\", 401)\n\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM cart_items WHERE id = ? AND user_id = ?\",\n        (item_id, user[\"id\"]),\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        return _error(\"cart item not found\", 404)\n    return jsonify({\"ok\": True})\n\n\n# --------------------------------------------------------------------------\n# Admin routes\n# --------------------------------------------------------------------------\n\ndef _normalize_product_fields(data, existing=None):\n    fields = {}\n    if \"name\" in data:\n        name = data[\"name\"]\n        if not isinstance(name, str) or not name.strip():\n            raise ValueError(\"name is required\")\n        fields[\"name\"] = name.strip()\n    if \"description\" in data:\n        desc = data[\"description\"]\n        if not isinstance(desc, str):\n            raise ValueError(\"description must be a string\")\n        fields[\"description\"] = desc\n    if \"price\" in data:\n        price = data[\"price\"]\n        if not isinstance(price, (int, float)) or isinstance(price, bool) or price < 0:\n            raise ValueError(\"price must be a non-negative number\")\n        fields[\"price\"] = round(float(price), 2)\n    if \"stock\" in data:\n        stock = data[\"stock\"]\n        if not isinstance(stock, int) or isinstance(stock, bool) or stock < 0:\n            raise ValueError(\"stock must be a non-negative integer\")\n        fields[\"stock\"] = stock\n    if \"is_active\" in data:\n        act = data[\"is_active\"]\n        if not isinstance(act, bool):\n            raise ValueError(\"is_active must be a boolean\")\n        fields[\"is_active\"] = 1 if act else 0\n    return fields\n\n\n@app.post(\"/api/admin/products\")\ndef admin_create_product():\n    admin = _require_admin()\n    if admin is None:\n        return _error(\"admin authentication required\", 401)\n\n    data = request.get_json(silent=True) or {}\n    if \"name\" not in data or \"price\" not in data:\n        return _error(\"name and price are required\", 400)\n\n    try:\n        fields = _normalize_product_fields(data)\n    except ValueError as e:\n        return _error(str(e), 400)\n\n    if \"name\" not in fields or \"price\" not in fields:\n        return _error(\"name and price are required\", 400)\n\n    fields.setdefault(\"description\", \"\")\n    fields.setdefault(\"stock\", 0)\n    fields.setdefault(\"is_active\", 1)\n\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO products (name, description, price, stock, is_active) \"\n        \"VALUES (:name, :description, :price, :stock, :is_active)\",\n        fields,\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(_product_dict(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\ndef admin_update_product(product_id):\n    admin = _require_admin()\n    if admin is None:\n        return _error(\"admin authentication required\", 401)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT * FROM products WHERE id = ?\", (product_id,)\n    ).fetchone()\n    if existing is None:\n        return _error(\"product not found\", 404)\n\n    data = request.get_json(silent=True) or {}\n    try:\n        fields = _normalize_product_fields(data)\n    except ValueError as e:\n        return _error(str(e), 400)\n\n    if not fields:\n        return _error(\"no valid fields to update\", 400)\n\n    assignments = \", \".join(f\"{k} = :{k}\" for k in fields)\n    fields[\"id\"] = product_id\n    db.execute(\n        f\"UPDATE products SET {assignments} WHERE id = :id\", fields\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return jsonify(_product_dict(row))\n\n\n# --------------------------------------------------------------------------\n# Admin login bootstrap\n# --------------------------------------------------------------------------\n\ndef ensure_admin():\n    \"\"\"Create the admin account if it does not exist and ADMIN_PASSWORD is set.\"\"\"\n    if not ADMIN_PASSWORD:\n        return\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    admin = conn.execute(\n        \"SELECT id FROM users WHERE username = 'admin'\"\n    ).fetchone()\n    if admin is None:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1)\",\n            (\"admin\", _hash_password(ADMIN_PASSWORD)),\n        )\n        conn.commit()\n    else:\n        conn.execute(\n            \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE username = 'admin'\",\n            (_hash_password(ADMIN_PASSWORD),),\n        )\n        conn.commit()\n    conn.close()\n\n\n# --------------------------------------------------------------------------\n# Health + frontend\n# --------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return _error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nensure_admin()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794378953983,"end":1794378954084}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c951f4f60013l4m0lKkFFa3bd","sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","messageID":"msg_1c951503e001F0ly1QGj5Ce5la"}}
