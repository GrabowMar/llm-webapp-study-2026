{"type":"tool_use","timestamp":1794379007471,"sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","part":{"type":"tool","tool":"write","callID":"call_cdiiw2y8rqrhntny7p0eafvd","state":{"status":"completed","input":{"content":"export interface Product {\n  id: number;\n  name: string;\n  description: string;\n  price: number;\n  stock: number;\n  is_active: boolean;\n}\n\nexport interface ProductsPage {\n  items: Product[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface CartItem {\n  id: number;\n  product_id: number;\n  quantity: number;\n  name: string;\n  unit_price: number;\n  line_total: number;\n}\n\nexport interface Cart {\n  items: CartItem[];\n  subtotal: number;\n}\n\nconst TOKEN_KEY = \"shop_token\";\nconst USER_KEY = \"shop_user\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) {\n    localStorage.setItem(TOKEN_KEY, token);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n  }\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setUsername(name: string | null) {\n  if (name) {\n    localStorage.setItem(USER_KEY, name);\n  } else {\n    localStorage.removeItem(USER_KEY);\n  }\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string>),\n  };\n  if (options.body) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(`/api${path}`, { ...options, headers });\n  if (!res.ok) {\n    let message = `Request failed (${res.status})`;\n    try {\n      const body = await res.json();\n      if (body && typeof body.error === \"string\") {\n        message = body.error;\n      }\n    } catch {\n      // ignore\n    }\n    throw new ApiError(message, res.status);\n  }\n  if (res.status === 204) {\n    return undefined as T;\n  }\n  return (await res.json()) as T;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n\n  products: (q: string, page: number, pageSize: number) => {\n    const params = new URLSearchParams();\n    if (q) params.set(\"q\", q);\n    params.set(\"page\", String(page));\n    params.set(\"page_size\", String(pageSize));\n    return request<ProductsPage>(`/products?${params.toString()}`);\n  },\n\n  cart: () => request<Cart>(\"/cart\"),\n\n  addToCart: (productId: number, quantity: number) =>\n    request<CartItem>(\"/cart\", {\n      method: \"POST\",\n      body: JSON.stringify({ product_id: productId, quantity }),\n    }),\n\n  updateCartItem: (itemId: number, quantity: number) =>\n    request<CartItem>(`/cart/${itemId}`, {\n      method: \"PATCH\",\n      body: JSON.stringify({ quantity }),\n    }),\n\n  removeCartItem: (itemId: number) =>\n    request<{ ok: boolean }>(`/cart/${itemId}`, { method: \"DELETE\" }),\n\n  adminCreateProduct: (product: {\n    name: string;\n    description?: string;\n    price: number;\n    stock?: number;\n    is_active?: boolean;\n  }) =>\n    request<Product>(\"/admin/products\", {\n      method: \"POST\",\n      body: JSON.stringify(product),\n    }),\n\n  adminUpdateProduct: (\n    id: number,\n    fields: Partial<{\n      name: string;\n      description: string;\n      price: number;\n      stock: number;\n      is_active: boolean;\n    }>,\n  ) =>\n    request<Product>(`/admin/products/${id}`, {\n      method: \"PATCH\",\n      body: JSON.stringify(fields),\n    }),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794379007445,"end":1794379007453}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c952c5d0001xi7jJuVgABo53k","sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","messageID":"msg_1c95299b7001pG9TfgyXyc6Igi"}}
{"type":"step_finish","timestamp":1794379007471,"sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","part":{"id":"prt_1c952c5e0001zYVcLFN7OKxCDf","reason":"tool-calls","messageID":"msg_1c95299b7001pG9TfgyXyc6Igi","sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","type":"step-finish","tokens":{"total":38229,"input":316,"output":1049,"reasoning":0,"cache":{"write":0,"read":36864}},"cost":0}}
{"type":"step_start","timestamp":1794379065844,"sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","part":{"id":"prt_1c953a9de001K0zmdPaeGltxES","messageID":"msg_1c952c5e90012BmrvSPAaEUyf5","sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","type":"step-start"}}
{"type":"tool_use","timestamp":1794379065880,"sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","part":{"type":"tool","tool":"write","callID":"call_dd5cgb5k94x76q6app3n2srm","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  Cart,\n  CartItem,\n  Product,\n  ProductsPage,\n  getToken,\n  setToken,\n  getUsername,\n  setUsername,\n} from \"./api\";\n\nconst PAGE_SIZE = 8;\n\nfunction money(n: number): string {\n  return `$${n.toFixed(2)}`;\n}\n\nexport default function App() {\n  const [user, setUser] = useState<string | null>(() => {\n    if (getToken() && getUsername()) return getUsername();\n    return null;\n  });\n  const [isAdmin, setIsAdmin] = useState(false);\n  const [authOpen, setAuthOpen] = useState(false);\n  const [cart, setCart] = useState<Cart | null>(null);\n  const [cartOpen, setCartOpen] = useState(false);\n  const [cartError, setCartError] = useState<string | null>(null);\n  const [adminView, setAdminView] = useState(false);\n\n  const refreshCart = useCallback(async () => {\n    if (!getToken()) {\n      setCart(null);\n      return;\n    }\n    try {\n      const c = await api.cart();\n      setCart(c);\n    } catch {\n      setCart(null);\n    }\n  }, []);\n\n  useEffect(() => {\n    refreshCart();\n  }, [refreshCart, user]);\n\n  const handleLogin = (username: string, token: string, admin: boolean) => {\n    setToken(token);\n    setUsername(username);\n    setUser(username);\n    setIsAdmin(admin);\n    setAuthOpen(false);\n    refreshCart();\n  };\n\n  const handleLogout = () => {\n    setToken(null);\n    setUsername(null);\n    setUser(null);\n    setIsAdmin(false);\n    setCart(null);\n    setAdminView(false);\n  };\n\n  const cartCount = cart\n    ? cart.items.reduce((sum, i) => sum + i.quantity, 0)\n    : 0;\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 text-gray-900\">\n      <header className=\"sticky top-0 z-20 border-b border-gray-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3\">\n          <button\n            className=\"text-xl font-bold tracking-tight\"\n            onClick={() => setAdminView(false)}\n          >\n            Shop\n          </button>\n\n          <div className=\"flex items-center gap-2\">\n            {user && isAdmin && (\n              <button\n                className={`rounded-lg px-3 py-1.5 text-sm font-medium ${\n                  adminView\n                    ? \"bg-gray-900 text-white\"\n                    : \"bg-gray-100 hover:bg-gray-200\"\n                }`}\n                onClick={() => setAdminView((v) => !v)}\n              >\n                Admin\n              </button>\n            )}\n\n            {user ? (\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-sm text-gray-600\">\n                  Signed in as <span className=\"font-medium\">{user}</span>\n                </span>\n                <button\n                  className=\"rounded-lg px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50\"\n                  onClick={handleLogout}\n                >\n                  Sign out\n                </button>\n              </div>\n            ) : (\n              <button\n                className=\"rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700\"\n                onClick={() => setAuthOpen(true)}\n              >\n                Sign in\n              </button>\n            )}\n\n            <button\n              className=\"relative rounded-lg bg-gray-100 p-2 hover:bg-gray-200\"\n              onClick={() => setCartOpen(true)}\n              aria-label=\"Open cart\"\n            >\n              <svg\n                className=\"h-5 w-5\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                viewBox=\"0 0 24 24\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  strokeWidth={2}\n                  d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 3.5a1 1 0 00.8 1.5h11\"\n                />\n                <circle cx=\"9\" cy=\"20\" r=\"1\" />\n                <circle cx=\"17\" cy=\"20\" r=\"1\" />\n              </svg>\n              {cartCount > 0 && (\n                <span className=\"absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-red-500 px-1 text-xs font-bold text-white\">\n                  {cartCount}\n                </span>\n              )}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-6\">\n        {adminView ? (\n          <AdminPanel />\n        ) : (\n          <ProductGrid onCartChanged={refreshCart} />\n        )}\n      </main>\n\n      {authOpen && (\n        <AuthModal\n          onClose={() => setAuthOpen(false)}\n          onLogin={handleLogin}\n        />\n      )}\n\n      {cartOpen && (\n        <CartPanel\n          cart={cart}\n          error={cartError}\n          onClose={() => {\n            setCartOpen(false);\n            setCartError(null);\n          }}\n          onChanged={() => {\n            refreshCart();\n          }}\n          onError={(m) => setCartError(m)}\n        />\n      )}\n    </div>\n  );\n}\n\n/* ------------------------------------------------------------------ */\n/* Auth                                                                */\n/* ------------------------------------------------------------------ */\n\nfunction AuthModal({\n  onClose,\n  onLogin,\n}: {\n  onClose: () => void;\n  onLogin: (username: string, token: string, admin: boolean) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsernameState] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api.register(username, password);\n        const { token } = await api.login(username, password);\n        onLogin(username, token, false);\n      } else {\n        const { token } = await api.login(username, password);\n        onLogin(username, token, username === \"admin\");\n      }\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-40 flex items-center justify-center bg-black/40 p-4\">\n      <div className=\"w-full max-w-sm rounded-xl bg-white p-6 shadow-xl\">\n        <div className=\"mb-4 flex justify-between\">\n          <h2 className=\"text-lg font-semibold\">\n            {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n          </h2>\n          <button\n            className=\"text-gray-400 hover:text-gray-600\"\n            onClick={onClose}\n          >\n            ✕\n          </button>\n        </div>\n\n        <div className=\"mb-4 flex rounded-lg bg-gray-100 p-1\">\n          {([\"login\", \"register\"] as const).map((m) => (\n            <button\n              key={m}\n              className={`flex-1 rounded-md py-1.5 text-sm font-medium ${\n                mode === m ? \"bg-white shadow\" : \"text-gray-500\"\n              }`}\n              onClick={() => {\n                setMode(m);\n                setError(null);\n              }}\n            >\n              {m === \"login\" ? \"Sign in\" : \"Register\"}\n            </button>\n          ))}\n        </div>\n\n        <form onSubmit={submit} className=\"space-y-3\">\n          <input\n            className=\"w-full rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n            placeholder=\"Username\"\n            value={username}\n            onChange={(e) => setUsernameState(e.target.value)}\n            autoFocus\n          />\n          <input\n            className=\"w-full rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n            placeholder=\"Password\"\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n          />\n          {error && <p className=\"text-sm text-red-600\">{error}</p>}\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"w-full rounded-lg bg-gray-900 py-2 text-sm font-medium text-white hover:bg-gray-700 disabled:opacity-50\"\n          >\n            {busy ? \"Please wait…\" : mode === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}\n\n/* ------------------------------------------------------------------ */\n/* Product grid                                                        */\n/* ------------------------------------------------------------------ */\n\nfunction ProductGrid({ onCartChanged }: { onCartChanged: () => void }) {\n  const [q, setQ] = useState(\"\");\n  const [input, setInput] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<ProductsPage | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [message, setMessage] = useState<string | null>(null);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    api\n      .products(q, page, PAGE_SIZE)\n      .then((d) => {\n        if (!cancelled) setData(d);\n      })\n      .catch(() => {\n        if (!cancelled) setData(null);\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [q, page]);\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / PAGE_SIZE)) : 1;\n\n  async function addToCart(product: Product) {\n    setMessage(null);\n    try {\n      await api.addToCart(product.id, 1);\n      onCartChanged();\n    } catch (err) {\n      setMessage(err instanceof ApiError ? err.message : \"Could not add item\");\n    }\n  }\n\n  return (\n    <div>\n      <div className=\"mb-5 flex flex-wrap items-center gap-3\">\n        <form\n          className=\"flex-1\"\n          onSubmit={(e) => {\n            e.preventDefault();\n            setQ(input.trim());\n            setPage(1);\n          }}\n        >\n          <input\n            className=\"w-full max-w-sm rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n            placeholder=\"Search products…\"\n            value={input}\n            onChange={(e) => setInput(e.target.value)}\n          />\n        </form>\n        <span className=\"text-sm text-gray-500\">\n          {data ? `${data.total} product${data.total === 1 ? \"\" : \"s\"}` : \"\"}\n        </span>\n      </div>\n\n      {message && (\n        <p className=\"mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600\">\n          {message}\n        </p>\n      )}\n\n      {loading ? (\n        <p className=\"py-12 text-center text-gray-400\">Loading…</p>\n      ) : data && data.items.length === 0 ? (\n        <p className=\"py-12 text-center text-gray-400\">No products found.</p>\n      ) : (\n        <div className=\"grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4\">\n          {data?.items.map((p) => (\n            <div\n              key={p.id}\n              className=\"flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white\"\n            >\n              <div className=\"relative flex aspect-square items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 text-4xl text-gray-400\">\n                🛍️\n                {p.stock === 0 && (\n                  <span className=\"absolute right-2 top-2 rounded-full bg-red-500 px-2 py-0.5 text-xs font-semibold text-white\">\n                    Out of stock\n                  </span>\n                )}\n              </div>\n              <div className=\"flex flex-1 flex-col p-3\">\n                <h3 className=\"font-medium leading-snug\">{p.name}</h3>\n                <p className=\"mb-2 text-sm text-gray-500\">{money(p.price)}</p>\n                <button\n                  className=\"mt-auto rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:bg-gray-300\"\n                  disabled={p.stock === 0}\n                  onClick={() => addToCart(p)}\n                >\n                  Add to cart\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {totalPages > 1 && (\n        <div className=\"mt-6 flex items-center justify-center gap-2\">\n          <button\n            className=\"rounded-lg border border-gray-300 px-3 py-1.5 text-sm disabled:opacity-40\"\n            disabled={page <= 1}\n            onClick={() => setPage((p) => p - 1)}\n          >\n            Prev\n          </button>\n          <span className=\"text-sm text-gray-600\">\n            Page {page} of {totalPages}\n          </span>\n          <button\n            className=\"rounded-lg border border-gray-300 px-3 py-1.5 text-sm disabled:opacity-40\"\n            disabled={page >= totalPages}\n            onClick={() => setPage((p) => p + 1)}\n          >\n            Next\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n\n/* ------------------------------------------------------------------ */\n/* Cart panel                                                          */\n/* ------------------------------------------------------------------ */\n\nfunction CartPanel({\n  cart,\n  error,\n  onClose,\n  onChanged,\n  onError,\n}: {\n  cart: Cart | null;\n  error: string | null;\n  onClose: () => void;\n  onChanged: () => void;\n  onError: (m: string) => void;\n}) {\n  const [busyId, setBusyId] = useState<number | null>(null);\n\n  async function setQuantity(item: CartItem, quantity: number) {\n    setBusyId(item.id);\n    onError(null);\n    try {\n      await api.updateCartItem(item.id, quantity);\n      onChanged();\n    } catch (err) {\n      onError(err instanceof ApiError ? err.message : \"Could not update item\");\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  async function remove(item: CartItem) {\n    setBusyId(item.id);\n    onError(null);\n    try {\n      await api.removeCartItem(item.id);\n      onChanged();\n    } catch (err) {\n      onError(err instanceof ApiError ? err.message : \"Could not remove item\");\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-30 flex justify-end bg-black/40\">\n      <div className=\"flex h-full w-full max-w-md flex-col bg-white shadow-xl\">\n        <div className=\"flex items-center justify-between border-b border-gray-200 px-4 py-3\">\n          <h2 className=\"text-lg font-semibold\">Your cart</h2>\n          <button\n            className=\"text-gray-400 hover:text-gray-600\"\n            onClick={onClose}\n          >\n            ✕\n          </button>\n        </div>\n\n        <div className=\"flex-1 overflow-y-auto px-4 py-3\">\n          {!cart || cart.items.length === 0 ? (\n            <p className=\"py-8 text-center text-gray-400\">Your cart is empty.</p>\n          ) : (\n            <ul className=\"space-y-3\">\n              {cart.items.map((item) => (\n                <li\n                  key={item.id}\n                  className=\"rounded-lg border border-gray-200 p-3\"\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div>\n                      <p className=\"font-medium\">{item.name}</p>\n                      <p className=\"text-sm text-gray-500\">\n                        {money(item.unit_price)} each\n                      </p>\n                    </div>\n                    <button\n                      className=\"text-sm text-red-600 hover:underline\"\n                      onClick={() => remove(item)}\n                      disabled={busyId === item.id}\n                    >\n                      Remove\n                    </button>\n                  </div>\n                  <div className=\"mt-2 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        className=\"h-7 w-7 rounded-lg border border-gray-300 text-sm font-semibold disabled:opacity-40\"\n                        disabled={busyId === item.id || item.quantity <= 1}\n                        onClick={() => setQuantity(item, item.quantity - 1)}\n                      >\n                        −\n                      </button>\n                      <span className=\"w-8 text-center text-sm\">\n                        {item.quantity}\n                      </span>\n                      <button\n                        className=\"h-7 w-7 rounded-lg border border-gray-300 text-sm font-semibold disabled:opacity-40\"\n                        disabled={busyId === item.id}\n                        onClick={() => setQuantity(item, item.quantity + 1)}\n                      >\n                        +\n                      </button>\n                    </div>\n                    <span className=\"font-medium\">\n                      {money(item.line_total)}\n                    </span>\n                  </div>\n                </li>\n              ))}\n            </ul>\n          )}\n        </div>\n\n        <div className=\"border-t border-gray-200 px-4 py-3\">\n          {error && <p className=\"mb-2 text-sm text-red-600\">{error}</p>}\n          <div className=\"flex items-center justify-between text-lg font-semibold\">\n            <span>Subtotal</span>\n            <span>{money(cart?.subtotal ?? 0)}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/* ------------------------------------------------------------------ */\n/* Admin panel                                                         */\n/* ------------------------------------------------------------------ */\n\nfunction AdminPanel() {\n  const [products, setProducts] = useState<Product[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [message, setMessage] = useState<string | null>(null);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const res = await api.products(\"\", 1, 100);\n      setProducts(res.items);\n    } catch {\n      setProducts([]);\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function run(action: () => Promise<unknown>) {\n    setMessage(null);\n    try {\n      await action();\n      await load();\n    } catch (err) {\n      setMessage(err instanceof ApiError ? err.message : \"Request failed\");\n    }\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <h2 className=\"text-xl font-semibold\">Admin</h2>\n\n      <AdminCreateForm\n        onCreated={(m) => {\n          setMessage(m);\n          load();\n        }}\n      />\n\n      {message && (\n        <p className=\"rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-700\">\n          {message}\n        </p>\n      )}\n\n      {loading ? (\n        <p className=\"py-8 text-center text-gray-400\">Loading…</p>\n      ) : (\n        <div className=\"overflow-x-auto rounded-xl border border-gray-200 bg-white\">\n          <table className=\"w-full text-sm\">\n            <thead className=\"border-b border-gray-200 bg-gray-50 text-left\">\n              <tr>\n                <th className=\"px-3 py-2 font-medium\">Name</th>\n                <th className=\"px-3 py-2 font-medium\">Price</th>\n                <th className=\"px-3 py-2 font-medium\">Stock</th>\n                <th className=\"px-3 py-2 font-medium\">Active</th>\n              </tr>\n            </thead>\n            <tbody>\n              {products.map((p) => (\n                <AdminRow\n                  key={p.id}\n                  product={p}\n                  onError={(m) => setMessage(m)}\n                  onSaved={() => load()}\n                />\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction AdminCreateForm({ onCreated }: { onCreated: (m: string) => void }) {\n  const [name, setName] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [price, setPrice] = useState(\"\");\n  const [stock, setStock] = useState(\"0\");\n  const [error, setError] = useState<string | null>(null);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    try {\n      await api.adminCreateProduct({\n        name,\n        description,\n        price: Number(price),\n        stock: Number(stock),\n      });\n      setName(\"\");\n      setDescription(\"\");\n      setPrice(\"\");\n      setStock(\"0\");\n      onCreated(\"Product created.\");\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Could not create product\");\n    }\n  }\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"rounded-xl border border-gray-200 bg-white p-4\"\n    >\n      <h3 className=\"mb-3 font-medium\">Add product</h3>\n      <div className=\"grid gap-3 sm:grid-cols-2\">\n        <input\n          className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n          placeholder=\"Name\"\n          value={name}\n          onChange={(e) => setName(e.target.value)}\n        />\n        <input\n          className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n          placeholder=\"Description\"\n          value={description}\n          onChange={(e) => setDescription(e.target.value)}\n        />\n        <input\n          className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n          placeholder=\"Price\"\n          type=\"number\"\n          step=\"0.01\"\n          min=\"0\"\n          value={price}\n          onChange={(e) => setPrice(e.target.value)}\n        />\n        <input\n          className=\"rounded-lg border border-gray-300 px-3 py-2 text-sm\"\n          placeholder=\"Stock\"\n          type=\"number\"\n          min=\"0\"\n          value={stock}\n          onChange={(e) => setStock(e.target.value)}\n        />\n      </div>\n      {error && <p className=\"mt-2 text-sm text-red-600\">{error}</p>}\n      <button\n        type=\"submit\"\n        className=\"mt-3 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700\"\n      >\n        Add product\n      </button>\n    </form>\n  );\n}\n\nfunction AdminRow({\n  product,\n  onError,\n  onSaved,\n}: {\n  product: Product;\n  onError: (m: string) => void;\n  onSaved: () => void;\n}) {\n  const [price, setPrice] = useState(String(product.price));\n  const [stock, setStock] = useState(String(product.stock));\n  const [active, setActive] = useState(product.is_active);\n  const [saving, setSaving] = useState(false);\n\n  useEffect(() => {\n    setPrice(String(product.price));\n    setStock(String(product.stock));\n    setActive(product.is_active);\n  }, [product]);\n\n  async function save(fields: Partial<{\n    name: string;\n    description: string;\n    price: number;\n    stock: number;\n    is_active: boolean;\n  }>) {\n    setSaving(true);\n    try {\n      await api.adminUpdateProduct(product.id, fields);\n      onSaved();\n    } catch (err) {\n      onError(err instanceof ApiError ? err.message : \"Could not update product\");\n    } finally {\n      setSaving(false);\n    }\n  }\n\n  return (\n    <tr className=\"border-b border-gray-100 last:border-0\">\n      <td className=\"px-3 py-2\">\n        <div className=\"font-medium\">{product.name}</div>\n        {product.description && (\n          <div className=\"text-xs text-gray-500\">{product.description}</div>\n        )}\n      </td>\n      <td className=\"px-3 py-2\">\n        <input\n          className=\"w-24 rounded-lg border border-gray-300 px-2 py-1 text-sm\"\n          type=\"number\"\n          step=\"0.01\"\n          min=\"0\"\n          value={price}\n          onChange={(e) => setPrice(e.target.value)}\n          onBlur={() => {\n            const v = Number(price);\n            if (v !== product.price) save({ price: v });\n          }}\n        />\n      </td>\n      <td className=\"px-3 py-2\">\n        <input\n          className=\"w-24 rounded-lg border border-gray-300 px-2 py-1 text-sm\"\n          type=\"number\"\n          min=\"0\"\n          value={stock}\n          onChange={(e) => setStock(e.target.value)}\n          onBlur={() => {\n            const v = Number(stock);\n            if (v !== product.stock) save({ stock: Math.floor(v) });\n          }}\n        />\n      </td>\n      <td className=\"px-3 py-2\">\n        <button\n          disabled={saving}\n          onClick={() => save({ is_active: !active })}\n          className={`rounded-full px-3 py-1 text-xs font-medium ${\n            active\n              ? \"bg-green-100 text-green-700\"\n              : \"bg-gray-200 text-gray-500\"\n          }`}\n        >\n          {active ? \"Active\" : \"Inactive\"}\n        </button>\n      </td>\n    </tr>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794379065837,"end":1794379065855}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c953a9e2001lubhfY54X8YxP4","sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","messageID":"msg_1c952c5e90012BmrvSPAaEUyf5"}}
