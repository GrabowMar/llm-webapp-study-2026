   return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":23,"totalLines":23,"truncated":false}},"title":"backend/app.py","time":{"start":1794378755836,"end":1794378756251}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c94eeee1001lVczCRM2NN3bSm","sessionID":"ses_e36b14f4affeg9xKBjwU4fqPG9","messageID":"msg_1c94ed329001oy86y3JmQTwMOA"}}
