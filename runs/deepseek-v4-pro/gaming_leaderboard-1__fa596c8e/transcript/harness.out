{"type":"tool_use","timestamp":1794368618966,"sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","part":{"type":"tool","tool":"write","callID":"call_c9n9bi978jnnghosjzw7dx7i","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the game leaderboard.\"\"\"\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\ndef get_db():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS players (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            is_admin INTEGER NOT NULL DEFAULT 0,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            player_id INTEGER NOT NULL,\n            created_at TEXT NOT NULL,\n            FOREIGN KEY (player_id) REFERENCES players(id)\n        );\n        CREATE TABLE IF NOT EXISTS scores (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            player_id INTEGER NOT NULL,\n            score INTEGER NOT NULL,\n            achieved_at TEXT NOT NULL,\n            is_hidden INTEGER NOT NULL DEFAULT 0,\n            FOREIGN KEY (player_id) REFERENCES players(id)\n        );\n        CREATE INDEX IF NOT EXISTS idx_scores_player ON scores(player_id);\n        CREATE INDEX IF NOT EXISTS idx_scores_hidden ON scores(is_hidden);\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Password / tokens\n# ---------------------------------------------------------------------------\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 200_000\n    )\n    return f\"{salt}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt, digest = stored.split(\"$\", 1)\n    except ValueError:\n        return False\n    check = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 200_000\n    )\n    return secrets.compare_digest(check.hex(), digest)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef parse_dt(value: str) -> datetime:\n    return datetime.fromisoformat(value)\n\n\n# ---------------------------------------------------------------------------\n# Auth helpers\n# ---------------------------------------------------------------------------\n\ndef current_player():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    row = get_db().execute(\n        \"SELECT p.* FROM tokens t JOIN players p ON p.id = t.player_id \"\n        \"WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_player(f):\n    @wraps(f)\n    def wrapper(*args, **kwargs):\n        player = current_player()\n        if player is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.player = player\n        return f(*args, **kwargs)\n\n    return wrapper\n\n\ndef require_admin(f):\n    @wraps(f)\n    def wrapper(*args, **kwargs):\n        player = current_player()\n        if player is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        if not player[\"is_admin\"]:\n            return jsonify({\"error\": \"admin access required\"}), 403\n        g.player = player\n        return f(*args, **kwargs)\n\n    return wrapper\n\n\n# ---------------------------------------------------------------------------\n# Leaderboard / ranking\n# ---------------------------------------------------------------------------\n\nPERIODS = {\"all_time\", \"all\", \"all-time\", \"week\", \"today\"}\n\n\ndef normalize_period(period):\n    if not period:\n        return \"all_time\"\n    p = period.strip().lower().replace(\"-\", \"_\")\n    if p in (\"all\", \"all_time\", \"all-time\"):\n        return \"all_time\"\n    if p == \"week\":\n        return \"week\"\n    if p == \"today\":\n        return \"today\"\n    return \"all_time\"\n\n\ndef period_cutoff(period):\n    now = datetime.now(timezone.utc)\n    if period == \"today\":\n        return now.replace(hour=0, minute=0, second=0, microsecond=0)\n    if period == \"week\":\n        monday = now - timedelta(days=now.weekday())\n        return monday.replace(hour=0, minute=0, second=0, microsecond=0)\n    return None\n\n\ndef visible_scores():\n    return get_db().execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, \"\n        \"p.username AS username \"\n        \"FROM scores s JOIN players p ON p.id = s.player_id \"\n        \"WHERE s.is_hidden = 0 \"\n        \"ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\"\n    ).fetchall()\n\n\ndef build_ranking(period=\"all_time\", player_filter=None):\n    cutoff = period_cutoff(period)\n    ranking = []\n    seen = set()\n    for row in visible_scores():\n        if cutoff is not None and parse_dt(row[\"achieved_at\"]) < cutoff:\n            continue\n        if row[\"player_id\"] in seen:\n            continue\n        seen.add(row[\"player_id\"])\n        ranking.append(\n            {\n                \"player_id\": row[\"player_id\"],\n                \"username\": row[\"username\"],\n                \"score\": row[\"score\"],\n                \"achieved_at\": row[\"achieved_at\"],\n            }\n        )\n    if player_filter:\n        needle = player_filter.strip().lower()\n        if needle:\n            ranking = [\n                r for r in ranking if needle in r[\"username\"].lower()\n            ]\n    for i, entry in enumerate(ranking):\n        entry[\"rank\"] = i + 1\n    return ranking\n\n\ndef player_rank(player_id):\n    ranking = build_ranking(\"all_time\")\n    for entry in ranking:\n        if entry[\"player_id\"] == player_id:\n            return entry[\"rank\"]\n    return None\n\n\ndef best_visible_score(player_id):\n    row = get_db().execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE player_id = ? \"\n        \"AND is_hidden = 0\",\n        (player_id,),\n    ).fetchone()\n    return row[\"best\"]\n\n\ndef score_to_dict(row):\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"achieved_at\": row[\"achieved_at\"],\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n\n\n# ---------------------------------------------------------------------------\n# Routes\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    username = username.strip()\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    if username.lower() == \"admin\":\n        return jsonify({\"error\": \"username already taken\"}), 409\n\n    db = get_db()\n    exists = db.execute(\n        \"SELECT id FROM players WHERE username = ?\", (username,)\n    ).fetchone()\n    if exists:\n        return jsonify({\"error\": \"username already taken\"}), 409\n\n    cur = db.execute(\n        \"INSERT INTO players (username, password_hash, is_admin, created_at) \"\n        \"VALUES (?, ?, 0, ?)\",\n        (username, hash_password(password), utcnow()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n    username = username.strip()\n\n    db = get_db()\n    player = db.execute(\n        \"SELECT * FROM players WHERE username = ?\", (username,)\n    ).fetchone()\n    if player is None or not verify_password(password, player[\"password_hash\"]):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO tokens (token, player_id, created_at) VALUES (?, ?, ?)\",\n        (token, player[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    period = normalize_period(request.args.get(\"period\"))\n    player_filter = request.args.get(\"player\")\n    ranking = build_ranking(period, player_filter)\n\n    limit = request.args.get(\"limit\")\n    items = ranking\n    if limit is not None:\n        try:\n            limit = int(limit)\n        except (TypeError, ValueError):\n            limit = None\n        if limit is not None and limit > 0:\n            items = ranking[:limit]\n\n    payload = [\n        {\n            \"rank\": entry[\"rank\"],\n            \"player\": entry[\"username\"],\n            \"score\": entry[\"score\"],\n            \"achieved_at\": entry[\"achieved_at\"],\n        }\n        for entry in items\n    ]\n    return jsonify({\"items\": payload, \"total\": len(ranking)})\n\n\n@app.post(\"/api/scores\")\n@require_player\ndef submit_score():\n    data = request.get_json(silent=True) or {}\n    raw = data.get(\"score\")\n    if isinstance(raw, bool) or not isinstance(raw, (int, float)):\n        return jsonify({\"error\": \"score must be a number\"}), 400\n    try:\n        score = int(raw)\n    except (TypeError, ValueError):\n        return jsonify({\"error\": \"score must be a number\"}), 400\n\n    player = g.player\n    prev_best = best_visible_score(player[\"id\"])\n    achieved_at = utcnow()\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO scores (player_id, score, achieved_at, is_hidden) \"\n        \"VALUES (?, ?, ?, 0)\",\n        (player[\"id\"], score, achieved_at),\n    )\n    db.commit()\n\n    row = db.execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, \"\n        \"p.username AS username \"\n        \"FROM scores s JOIN players p ON p.id = s.player_id \"\n        \"WHERE s.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n\n    result = score_to_dict(row)\n    result[\"rank\"] = player_rank(player[\"id\"])\n    result[\"personal_best\"] = prev_best is None or score > prev_best\n    return jsonify(result), 201\n\n\n@app.get(\"/api/scores\")\n@require_player\ndef list_scores():\n    player = g.player\n    rows = get_db().execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, \"\n        \"p.username AS username \"\n        \"FROM scores s JOIN players p ON p.id = s.player_id \"\n        \"WHERE s.player_id = ? ORDER BY s.id DESC\",\n        (player[\"id\"],),\n    ).fetchall()\n    items = [score_to_dict(r) for r in rows]\n    best = best_visible_score(player[\"id\"])\n    return jsonify({\"items\": items, \"best_score\": best})\n\n\n@app.get(\"/api/admin/scores\")\n@require_admin\ndef admin_scores():\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        page_size = 10\n    page = max(page, 1)\n    page_size = max(page_size, 1)\n\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS c FROM scores\").fetchone()[\"c\"]\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, \"\n        \"p.username AS username \"\n        \"FROM scores s JOIN players p ON p.id = s.player_id \"\n        \"ORDER BY s.id DESC LIMIT ? OFFSET ?\",\n        (page_size, offset),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n@require_admin\ndef toggle_score(score_id):\n    db = get_db()\n    row = db.execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, \"\n        \"p.username AS username \"\n        \"FROM scores s JOIN players p ON p.id = s.player_id \"\n        \"WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"score not found\"}), 404\n    new_hidden = 0 if row[\"is_hidden\"] else 1\n    db.execute(\n        \"UPDATE scores SET is_hidden = ? WHERE id = ?\", (new_hidden, score_id)\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT s.id, s.player_id, s.score, s.achieved_at, s.is_hidden, \"\n        \"p.username AS username \"\n        \"FROM scores s JOIN players p ON p.id = s.player_id \"\n        \"WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    return jsonify(score_to_dict(row))\n\n\n# ---------------------------------------------------------------------------\n# Frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n# ---------------------------------------------------------------------------\n# Startup\n# ---------------------------------------------------------------------------\n\ndef seed_admin():\n    password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n    if not password:\n        return\n    db = sqlite3.connect(DB_PATH)\n    existing = db.execute(\n        \"SELECT id FROM players WHERE username = 'admin'\"\n    ).fetchone()\n    pw_hash = hash_password(password)\n    if existing:\n        db.execute(\n            \"UPDATE players SET password_hash = ?, is_admin = 1 \"\n            \"WHERE username = 'admin'\",\n            (pw_hash,),\n        )\n    else:\n        db.execute(\n            \"INSERT INTO players (username, password_hash, is_admin, created_at) \"\n            \"VALUES ('admin', ?, 1, ?)\",\n            (pw_hash, utcnow()),\n        )\n    db.commit()\n    db.close()\n\n\ninit_db()\nseed_admin()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794368618927,"end":1794368618947}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b441a60016md6VW3q45z602","sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","messageID":"msg_1c8b266c0001N0A2cJBS6B6Bdt"}}
