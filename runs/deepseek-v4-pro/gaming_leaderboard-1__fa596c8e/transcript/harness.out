{"type":"tool_use","timestamp":1794368686761,"sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","part":{"type":"tool","tool":"write","callID":"call_x4qgeidq4uidls9a5k4ufbdf","state":{"status":"completed","input":{"content":"export interface Score {\n  id: number;\n  score: number;\n  achieved_at: string;\n  is_hidden: boolean;\n  player: string;\n}\n\nexport interface ScoreResult extends Score {\n  rank: number | null;\n  personal_best: boolean;\n}\n\nexport interface LeaderboardEntry {\n  rank: number;\n  player: string;\n  score: number;\n  achieved_at: string;\n}\n\nexport interface LeaderboardResponse {\n  items: LeaderboardEntry[];\n  total: number;\n}\n\nexport interface ScoresResponse {\n  items: Score[];\n  best_score: number | null;\n}\n\nexport interface AdminScoresResponse {\n  items: Score[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst TOKEN_KEY = \"leaderboard_token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) {\n    localStorage.setItem(TOKEN_KEY, token);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n  }\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string>),\n  };\n  if (options.body) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(path, { ...options, headers });\n  if (res.status === 401) {\n    setToken(null);\n  }\n  const text = await res.text();\n  const data = text ? JSON.parse(text) : null;\n  if (!res.ok) {\n    throw new Error(data?.error ?? `Request failed (${res.status})`);\n  }\n  return data as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ id: number; username: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function getLeaderboard(params: {\n  period?: string;\n  player?: string;\n  limit?: number;\n}) {\n  const q = new URLSearchParams();\n  if (params.period) q.set(\"period\", params.period);\n  if (params.player) q.set(\"player\", params.player);\n  if (params.limit) q.set(\"limit\", String(params.limit));\n  const qs = q.toString();\n  return request<LeaderboardResponse>(`/api/leaderboard${qs ? `?${qs}` : \"\"}`);\n}\n\nexport function submitScore(score: number) {\n  return request<ScoreResult>(\"/api/scores\", {\n    method: \"POST\",\n    body: JSON.stringify({ score }),\n  });\n}\n\nexport function getMyScores() {\n  return request<ScoresResponse>(\"/api/scores\");\n}\n\nexport function getAdminScores(page = 1, pageSize = 10) {\n  return request<AdminScoresResponse>(\n    `/api/admin/scores?page=${page}&page_size=${pageSize}`\n  );\n}\n\nexport function toggleScore(id: number) {\n  return request<Score>(`/api/admin/scores/${id}/toggle`, { method: \"POST\" });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794368686731,"end":1794368686741}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b54a85001GeT62ZUzupcfR4","sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","messageID":"msg_1c8b52210001QSNfVLXXCNmejf"}}
