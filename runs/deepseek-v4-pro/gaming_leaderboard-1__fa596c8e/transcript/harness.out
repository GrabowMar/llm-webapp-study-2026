{"type":"tool_use","timestamp":1794368745314,"sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","part":{"type":"tool","tool":"write","callID":"call_4cq6nabt4yuxag0wtr679k9h","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport type { Score } from \"./api\";\n\nfunction formatDate(iso: string): string {\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return iso;\n  return d.toLocaleString();\n}\n\nexport default function AdminPanel() {\n  const [items, setItems] = useState<Score[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [pageSize] = useState(20);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  async function load(p: number) {\n    setLoading(true);\n    setError(null);\n    try {\n      const { getAdminScores } = await import(\"./api\");\n      const res = await getAdminScores(p, pageSize);\n      setItems(res.items);\n      setTotal(res.total);\n      setPage(res.page);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Error\");\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  useEffect(() => {\n    load(1);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  async function toggle(id: number) {\n    try {\n      const { toggleScore } = await import(\"./api\");\n      const updated = await toggleScore(id);\n      setItems((prev) => prev.map((s) => (s.id === id ? updated : s)));\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Error\");\n    }\n  }\n\n  const totalPages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <section className=\"rounded-xl bg-white p-4 shadow-sm\">\n      <h2 className=\"text-lg font-semibold text-slate-800\">\n        Admin: all scores\n      </h2>\n      <p className=\"text-sm text-slate-500\">{total} total</p>\n\n      {error && (\n        <p className=\"mt-2 rounded-md bg-red-50 px-3 py-2 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n\n      <div className=\"mt-3 overflow-x-auto\">\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr className=\"border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500\">\n              <th className=\"px-2 py-2 font-medium\">ID</th>\n              <th className=\"px-2 py-2 font-medium\">Player</th>\n              <th className=\"px-2 py-2 font-medium\">Score</th>\n              <th className=\"px-2 py-2 font-medium\">Date</th>\n              <th className=\"px-2 py-2 font-medium\">Status</th>\n              <th className=\"px-2 py-2 font-medium\"></th>\n            </tr>\n          </thead>\n          <tbody>\n            {items.map((s) => (\n              <tr key={s.id} className=\"border-b border-slate-100\">\n                <td className=\"px-2 py-2 tabular-nums text-slate-400\">{s.id}</td>\n                <td className=\"px-2 py-2\">{s.player}</td>\n                <td className=\"px-2 py-2 font-semibold tabular-nums\">\n                  {s.score}\n                </td>\n                <td className=\"px-2 py-2 text-slate-500\">\n                  {formatDate(s.achieved_at)}\n                </td>\n                <td className=\"px-2 py-2\">\n                  {s.is_hidden ? (\n                    <span className=\"rounded bg-slate-200 px-2 py-0.5 text-xs text-slate-600\">\n                      hidden\n                    </span>\n                  ) : (\n                    <span className=\"rounded bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700\">\n                      visible\n                    </span>\n                  )}\n                </td>\n                <td className=\"px-2 py-2 text-right\">\n                  <button\n                    onClick={() => toggle(s.id)}\n                    className=\"rounded-md border border-slate-300 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100\"\n                  >\n                    {s.is_hidden ? \"Show\" : \"Hide\"}\n                  </button>\n                </td>\n              </tr>\n            ))}\n            {!loading && items.length === 0 && (\n              <tr>\n                <td colSpan={6} className=\"px-2 py-4 text-center text-slate-400\">\n                  No scores yet.\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      {totalPages > 1 && (\n        <div className=\"mt-3 flex items-center gap-2 text-sm\">\n          <button\n            disabled={page <= 1 || loading}\n            onClick={() => load(page - 1)}\n            className=\"rounded-md border border-slate-300 px-2 py-1 hover:bg-slate-100 disabled:opacity-40\"\n          >\n            Prev\n          </button>\n          <span className=\"text-slate-600\">\n            Page {page} / {totalPages}\n          </span>\n          <button\n            disabled={page >= totalPages || loading}\n            onClick={() => load(page + 1)}\n            className=\"rounded-md border border-slate-300 px-2 py-1 hover:bg-slate-100 disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      )}\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/AdminPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/AdminPanel.tsx","time":{"start":1794368745286,"end":1794368745297}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b62f3f001YaHU24UBwAQ2vQ","sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","messageID":"msg_1c8b5fb600010e7kqzGDy5OdEe"}}
