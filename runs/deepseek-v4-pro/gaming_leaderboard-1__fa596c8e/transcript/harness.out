{"type":"tool_use","timestamp":1794368714362,"sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","part":{"type":"tool","tool":"write","callID":"call_mqau9ue44dxtoi63wayspukj","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\n\nexport default function Auth({\n  onAuthed,\n}: {\n  onAuthed: (username: string) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      const { register, login, setToken } = await import(\"./api\");\n      if (mode === \"register\") {\n        await register(username, password);\n        const res = await login(username, password);\n        setToken(res.token);\n      } else {\n        const res = await login(username, password);\n        setToken(res.token);\n      }\n      onAuthed(username);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto mt-16 w-full max-w-sm rounded-xl bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-bold text-slate-800\">Sign in</h1>\n      <p className=\"mt-1 text-sm text-slate-500\">\n        {mode === \"login\"\n          ? \"Sign in to submit scores.\"\n          : \"Create an account to start playing.\"}\n      </p>\n\n      <div className=\"mt-4 flex gap-1 rounded-lg bg-slate-100 p-1\">\n        {([\"login\", \"register\"] as const).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            onClick={() => {\n              setMode(m);\n              setError(null);\n            }}\n            className={`flex-1 rounded-md px-3 py-1.5 text-sm font-medium transition ${\n              mode === m\n                ? \"bg-white text-indigo-700 shadow-sm\"\n                : \"text-slate-600 hover:text-slate-900\"\n            }`}\n          >\n            {m === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        ))}\n      </div>\n\n      <form onSubmit={submit} className=\"mt-4 space-y-3\">\n        <input\n          value={username}\n          onChange={(e) => setUsername(e.target.value)}\n          placeholder=\"Username\"\n          autoComplete=\"username\"\n          required\n          className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n        />\n        <input\n          type=\"password\"\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          placeholder=\"Password\"\n          autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n          required\n          className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n        />\n        {error && (\n          <p className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-600\">\n            {error}\n          </p>\n        )}\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\"\n        >\n          {busy\n            ? \"Please wait...\"\n            : mode === \"login\"\n              ? \"Sign in\"\n              : \"Create account\"}\n        </button>\n      </form>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/Auth.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Auth.tsx","exists":false,"truncated":false},"title":"frontend/src/Auth.tsx","time":{"start":1794368714336,"end":1794368714345}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b5b659001ntSbiy3JXF84ow","sessionID":"ses_e37507a62ffeEqvIvV7GnKj0yS","messageID":"msg_1c8b589d4001FWyuGMxZA0dIpq"}}
