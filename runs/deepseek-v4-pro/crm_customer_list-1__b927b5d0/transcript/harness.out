{"type":"tool_use","timestamp":1794342715389,"sessionID":"ses_e38daf826ffeth1zlvvxB2lzX3","part":{"type":"tool","tool":"write","callID":"call_kblqdhhtbalfhfz2xds9fh3c","state":{"status":"completed","input":{"content":"export interface Customer {\n  id: number;\n  name: string;\n  email: string | null;\n  phone: string | null;\n  company: string | null;\n  notes: string | null;\n  created_at: string;\n  interaction_count: number;\n  last_contacted_at: string | null;\n}\n\nexport interface Interaction {\n  id: number;\n  customer_id: number;\n  kind: string;\n  summary: string;\n  occurred_at: string;\n  logged_by: string;\n}\n\nexport interface CustomerList {\n  items: Customer[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst TOKEN_KEY = \"directory_token\";\nconst USERNAME_KEY = \"directory_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function saveSession(token: string, username: string): void {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession(): void {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  body: unknown;\n\n  constructor(status: number, body: unknown) {\n    super(`Request failed with status ${status}`);\n    this.status = status;\n    this.body = body;\n  }\n}\n\nasync function request<T>(path: string, options: RequestInit = {}): Promise<T> {\n  const token = getToken();\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  if (token) headers.Authorization = `Bearer ${token}`;\n\n  const res = await fetch(path, { ...options, headers });\n  if (res.status === 401) {\n    clearSession();\n  }\n  if (!res.ok) {\n    let body: unknown = null;\n    try {\n      body = await res.json();\n    } catch {\n      body = null;\n    }\n    throw new ApiError(res.status, body);\n  }\n  if (res.status === 204) return undefined as T;\n  return (await res.json()) as T;\n}\n\nexport interface FieldErrors {\n  [field: string]: string;\n}\n\nexport function extractErrors(body: unknown): FieldErrors {\n  if (body && typeof body === \"object\" && \"errors\" in body) {\n    const errors = (body as { errors: unknown }).errors;\n    if (errors && typeof errors === \"object\") {\n      return errors as FieldErrors;\n    }\n  }\n  if (body && typeof body === \"object\" && \"error\" in body) {\n    return { form: (body as { error: string }).error };\n  }\n  return {};\n}\n\nexport const api = {\n  register(username: string, password: string) {\n    return request<{ id: number; username: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    });\n  },\n  login(username: string, password: string) {\n    return request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    });\n  },\n  listCustomers(params: { q?: string; company?: string; page?: number; page_size?: number }) {\n    const query = new URLSearchParams();\n    if (params.q) query.set(\"q\", params.q);\n    if (params.company) query.set(\"company\", params.company);\n    if (params.page) query.set(\"page\", String(params.page));\n    if (params.page_size) query.set(\"page_size\", String(params.page_size));\n    const qs = query.toString();\n    return request<CustomerList>(`/api/customers${qs ? `?${qs}` : \"\"}`);\n  },\n  getCustomer(id: number) {\n    return request<Customer>(`/api/customers/${id}`);\n  },\n  createCustomer(data: Partial<Customer>) {\n    return request<Customer>(\"/api/customers\", {\n      method: \"POST\",\n      body: JSON.stringify(data),\n    });\n  },\n  updateCustomer(id: number, data: Partial<Customer>) {\n    return request<Customer>(`/api/customers/${id}`, {\n      method: \"PUT\",\n      body: JSON.stringify(data),\n    });\n  },\n  deleteCustomer(id: number) {\n    return request<{ ok: boolean }>(`/api/customers/${id}`, { method: \"DELETE\" });\n  },\n  listInteractions(customerId: number) {\n    return request<{ items: Interaction[] }>(`/api/customers/${customerId}/interactions`);\n  },\n  createInteraction(customerId: number, data: { kind: string; summary: string; occurred_at?: string }) {\n    return request<Interaction>(`/api/customers/${customerId}/interactions`, {\n      method: \"POST\",\n      body: JSON.stringify(data),\n    });\n  },\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794342715357,"end":1794342715366}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c728ffd5001Dx29XW19TGrEgQ","sessionID":"ses_e38daf826ffeth1zlvvxB2lzX3","messageID":"msg_1c728cf300016CPRsJf4pchYxN"}}
