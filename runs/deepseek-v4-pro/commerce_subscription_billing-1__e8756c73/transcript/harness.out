{"type":"tool_use","timestamp":1794325851691,"sessionID":"ses_e39ddd04fffedSRzcNX7IDW6j2","part":{"type":"tool","tool":"write","callID":"call_r6h9rkjx3hfrd05w4e8llbhc","state":{"status":"completed","input":{"content":"export interface Subscription {\n  id: number;\n  customer_name: string;\n  plan: string;\n  monthly_amount: number;\n  renewal_date: string;\n  status: string;\n  failed_payment_count: number;\n  created_at: string;\n}\n\nexport interface Invoice {\n  id: number;\n  subscription_id: number;\n  amount_due: number;\n  due_date: string;\n  status: string;\n  paid_at: string | null;\n}\n\nexport interface PublicStats {\n  mrr: number;\n  counts: Record<string, number>;\n}\n\nexport interface SubscriptionList {\n  items: Subscription[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst TOKEN_KEY = \"billing_token\";\nconst USERNAME_KEY = \"billing_username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function setSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n): Promise<T> {\n  const headers: Record<string, string> = {\n    ...(options.headers as Record<string, string> | undefined),\n  };\n  if (options.body && !headers[\"Content-Type\"]) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  const res = await fetch(path, { ...options, headers });\n  if (!res.ok) {\n    let message = `Request failed (${res.status})`;\n    try {\n      const body = await res.json();\n      if (body && body.error) message = body.error;\n    } catch {\n      /* ignore */\n    }\n    throw new Error(message);\n  }\n  if (res.status === 204) {\n    return undefined as T;\n  }\n  return res.json() as Promise<T>;\n}\n\nfunction qs(params: Record<string, string | number | undefined>) {\n  const parts: string[] = [];\n  for (const [k, v] of Object.entries(params)) {\n    if (v !== undefined && v !== \"\") parts.push(`${k}=${encodeURIComponent(v)}`);\n  }\n  return parts.length ? `?${parts.join(\"&\")}` : \"\";\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: JSON.stringify({ username, password }),\n    }),\n  listSubscriptions: (params: {\n    q?: string;\n    status?: string;\n    plan?: string;\n    page?: number;\n    page_size?: number;\n  }) => request<SubscriptionList>(`/api/subscriptions${qs(params)}`),\n  getSubscription: (id: number) =>\n    request<Subscription>(`/api/subscriptions/${id}`),\n  createSubscription: (body: Partial<Subscription>) =>\n    request<Subscription>(\"/api/subscriptions\", {\n      method: \"POST\",\n      body: JSON.stringify(body),\n    }),\n  patchSubscription: (id: number, body: Partial<Subscription>) =>\n    request<Subscription>(`/api/subscriptions/${id}`, {\n      method: \"PATCH\",\n      body: JSON.stringify(body),\n    }),\n  listInvoices: (id: number) =>\n    request<{ items: Invoice[] }>(`/api/subscriptions/${id}/invoices`),\n  issueInvoice: (id: number, body: { amount_due?: number; due_date?: string }) =>\n    request<Invoice>(`/api/subscriptions/${id}/invoices`, {\n      method: \"POST\",\n      body: JSON.stringify(body),\n    }),\n  recordCollection: (id: number, outcome: \"failed\" | \"succeeded\") =>\n    request<Subscription>(`/api/subscriptions/${id}/collections`, {\n      method: \"POST\",\n      body: JSON.stringify({ outcome }),\n    }),\n  publicStats: () => request<PublicStats>(\"/api/public/stats\"),\n};\n\nexport const STATUS_OPTIONS = [\n  \"active\",\n  \"past_due\",\n  \"trial\",\n  \"cancelled\",\n] as const;\n\nexport function formatMoney(value: number): string {\n  return `$${value.toFixed(2)}`;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794325851666,"end":1794325851673}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c627ae0d001sl1ugGurHDghks","sessionID":"ses_e39ddd04fffedSRzcNX7IDW6j2","messageID":"msg_1c6277c1d001Nu2e1kG6ysDxSY"}}
