{"type":"text","timestamp":1794375290658,"sessionID":"ses_e36ea1112ffeB2k4BRmbWFhQdW","part":{"id":"prt_1c91a0f11001Bre8pXzUoqbAVM","messageID":"msg_1c919a989001mG7MBWIrFwsa5B","sessionID":"ses_e36ea1112ffeB2k4BRmbWFhQdW","type":"text","text":"Now let me write the backend:\n\n","time":{"start":1794375290641,"end":1794375290655}}}
{"type":"tool_use","timestamp":1794375290694,"sessionID":"ses_e36ea1112ffeB2k4BRmbWFhQdW","part":{"type":"tool","tool":"write","callID":"call_r31qtf1hlzyc1b4gxzom1tka","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Markdown notes app — Flask backend.\"\"\"\n\nimport hmac\nimport secrets\nimport sqlite3\nfrom pathlib import Path\n\nimport mistune\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent\nDATA_DIR = Path(\"/app/data\") if Path(\"/app/data\").exists() or BASE_DIR.name == \"app\" else BASE_DIR.parent / \"data\"\nDB_PATH = DATA_DIR / \"notes.db\"\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\nrenderer = mistune.create_markdown(escape=False)\n\nTOKEN_BYTES = 32\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        db = sqlite3.connect(DB_PATH)\n        db.row_factory = sqlite3.Row\n        db.execute(\"PRAGMA foreign_keys = ON\")\n        db.execute(\"PRAGMA journal_mode = WAL\")\n        db.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL DEFAULT (datetime('now'))\n            )\n            \"\"\"\n        )\n        db.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS tokens (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                token_hash TEXT NOT NULL UNIQUE,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL DEFAULT (datetime('now'))\n            )\n            \"\"\"\n        )\n        db.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS notes (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                title TEXT NOT NULL DEFAULT '',\n                body TEXT NOT NULL DEFAULT '',\n                published INTEGER NOT NULL DEFAULT 0,\n                updated_at TEXT NOT NULL DEFAULT (datetime('now'))\n            )\n            \"\"\"\n        )\n        db.commit()\n        g.db = db\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc=None):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hmac.new(salt.encode(), password.encode(), \"sha256\").hexdigest()\n    return f\"{salt}${digest}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt, digest = stored.split(\"$\", 1)\n    except ValueError:\n        return False\n    return hmac.compare_digest(\n        digest, hmac.new(salt.encode(), password.encode(), \"sha256\").hexdigest()\n    )\n\n\ndef hash_token(token: str) -> str:\n    return hmac.new(b\"\", token.encode(), \"sha256\").hexdigest()\n\n\ndef note_dict(row: sqlite3.Row, with_body: bool = True) -> dict:\n    data = {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"published\": bool(row[\"published\"]),\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"username\"],\n    }\n    if with_body:\n        data[\"body\"] = row[\"body\"]\n    return data\n\n\ndef require_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"\"\"\n        SELECT u.id, u.username\n        FROM tokens t JOIN users u ON u.id = t.user_id\n        WHERE t.token_hash = ?\n        \"\"\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None:\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, hash_password(password)),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n    token = secrets.token_urlsafe(TOKEN_BYTES)\n    db.execute(\n        \"INSERT INTO tokens (token_hash, user_id) VALUES (?, ?)\",\n        (hash_token(token), row[\"id\"]),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    db = get_db()\n    rows = db.execute(\n        \"SELECT * FROM notes WHERE author_id = ? ORDER BY updated_at DESC, id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    items = [\n        {\n            \"id\": r[\"id\"],\n            \"title\": r[\"title\"],\n            \"published\": bool(r[\"published\"]),\n            \"updated_at\": r[\"updated_at\"],\n        }\n        for r in rows\n    ]\n    return jsonify({\"items\": items})\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    data = request.get_json(silent=True) or {}\n    title = data.get(\"title\")\n    body = data.get(\"body\")\n    if title is None:\n        title = \"\"\n    if body is None:\n        body = \"\"\n    if not isinstance(title, str) or not isinstance(body, str):\n        return jsonify({\"error\": \"title and body must be strings\"}), 400\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO notes (author_id, title, body) VALUES (?, ?, ?)\",\n        (user[\"id\"], title, body),\n    )\n    db.commit()\n    row = db.execute(\n        \"\"\"\n        SELECT n.*, u.username\n        FROM notes n JOIN users u ON u.id = n.author_id\n        WHERE n.id = ?\n        \"\"\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(note_dict(row)), 201\n\n\ndef _get_note(db, note_id: int, user_id: int | None):\n    row = db.execute(\n        \"\"\"\n        SELECT n.*, u.username\n        FROM notes n JOIN users u ON u.id = n.author_id\n        WHERE n.id = ?\n        \"\"\",\n        (note_id,),\n    ).fetchone()\n    if row is None:\n        return None\n    if user_id is None or row[\"author_id\"] != user_id:\n        return None\n    return row\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    row = _get_note(get_db(), note_id, user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify(note_dict(row))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\ndef update_note(note_id: int):\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    db = get_db()\n    row = _get_note(db, note_id, user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    data = request.get_json(silent=True) or {}\n    fields = {}\n    if \"title\" in data:\n        if not isinstance(data[\"title\"], str):\n            return jsonify({\"error\": \"title must be a string\"}), 400\n        fields[\"title\"] = data[\"title\"]\n    if \"body\" in data:\n        if not isinstance(data[\"body\"], str):\n            return jsonify({\"error\": \"body must be a string\"}), 400\n        fields[\"body\"] = data[\"body\"]\n    if \"published\" in data:\n        if not isinstance(data[\"published\"], bool):\n            return jsonify({\"error\": \"published must be a boolean\"}), 400\n        fields[\"published\"] = 1 if data[\"published\"] else 0\n    if fields:\n        assignments = \", \".join(f\"{k} = ?\" for k in fields)\n        params = list(fields.values()) + [datetime_now()]\n        db.execute(\n            f\"UPDATE notes SET {assignments}, updated_at = ? WHERE id = ?\",\n            params + [note_id],\n        )\n        db.commit()\n    row = db.execute(\n        \"\"\"\n        SELECT n.*, u.username\n        FROM notes n JOIN users u ON u.id = n.author_id\n        WHERE n.id = ?\n        \"\"\",\n        (note_id,),\n    ).fetchone()\n    return jsonify(note_dict(row))\n\n\ndef datetime_now() -> str:\n    return get_db().execute(\"SELECT datetime('now')\").fetchone()[0]\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\ndef delete_note(note_id: int):\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    db = get_db()\n    row = _get_note(db, note_id, user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (note_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/notes/<int:note_id>/html\")\ndef note_html(note_id: int):\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    row = _get_note(get_db(), note_id, user[\"id\"])\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return _render_html(row)\n\n\n@app.get(\"/api/public/notes/<int:note_id>/html\")\ndef public_note_html(note_id: int):\n    db = get_db()\n    row = db.execute(\n        \"\"\"\n        SELECT n.*, u.username\n        FROM notes n JOIN users u ON u.id = n.author_id\n        WHERE n.id = ? AND n.published = 1\n        \"\"\",\n        (note_id,),\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return _render_html(row)\n\n\ndef _render_html(row: sqlite3.Row):\n    html = renderer(row[\"body\"])\n    return jsonify({\"id\": row[\"id\"], \"html\": html}), {\"Content-Type\": \"text/html\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000, debug=True)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794375290650,"end":1794375290672}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c91a0f140016eIVhi2JT1eYrE","sessionID":"ses_e36ea1112ffeB2k4BRmbWFhQdW","messageID":"msg_1c919a989001mG7MBWIrFwsa5B"}}
