{"type":"tool_use","timestamp":1794305517193,"sessionID":"ses_e3b11e6dfffeWcbapUoSOODIDW","part":{"type":"tool","tool":"write","callID":"call_0xxswdplox5r9jz4si1kdulu","state":{"status":"completed","input":{"content":"export interface Book {\n  id: number;\n  title: string;\n  author: string;\n  year: number | null;\n  isbn: string | null;\n  created_at: string;\n  review_count: number;\n  average_rating: number | null;\n}\n\nexport interface Review {\n  id: number;\n  book_id: number;\n  rating: number;\n  comment: string;\n  created_at: string;\n  username: string;\n}\n\nexport interface BookList {\n  items: Book[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface ReviewList {\n  items: Review[];\n}\n\nexport interface AuthState {\n  username: string | null;\n  token: string | null;\n}\n\nexport function readAuth(): AuthState {\n  const raw = localStorage.getItem(\"auth\");\n  if (!raw) return { username: null, token: null };\n  try {\n    return JSON.parse(raw);\n  } catch {\n    return { username: null, token: null };\n  }\n}\n\nexport function writeAuth(auth: AuthState) {\n  if (auth.token && auth.username) {\n    localStorage.setItem(\"auth\", JSON.stringify(auth));\n  } else {\n    localStorage.removeItem(\"auth\");\n  }\n}\n\nfunction authHeaders(): HeadersInit {\n  const { token } = readAuth();\n  return token ? { Authorization: `Bearer ${token}` } : {};\n}\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n\n  constructor(message: string, status: number, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nasync function handle<T>(res: Response): Promise<T> {\n  if (!res.ok) {\n    let body: { error?: string; fields?: Record<string, string> } = {};\n    try {\n      body = await res.json();\n    } catch {\n      // ignore parse errors\n    }\n    throw new ApiError(body.error || `Request failed (${res.status})`, res.status, body.fields || {});\n  }\n  return res.json() as Promise<T>;\n}\n\nexport function apiLogin(username: string, password: string) {\n  return fetch(\"/api/auth/login\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  }).then((r) => handle<{ token: string }>(r));\n}\n\nexport function apiRegister(username: string, password: string) {\n  return fetch(\"/api/auth/register\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  }).then((r) => handle<{ username: string }>(r));\n}\n\nexport function apiBooks(q: string, page: number, pageSize: number) {\n  const params = new URLSearchParams();\n  if (q) params.set(\"q\", q);\n  params.set(\"page\", String(page));\n  params.set(\"page_size\", String(pageSize));\n  return fetch(`/api/books?${params.toString()}`).then((r) => handle<BookList>(r));\n}\n\nexport function apiBook(id: number) {\n  return fetch(`/api/books/${id}`).then((r) => handle<Book>(r));\n}\n\nexport function apiCreateBook(input: { title: string; author: string; year: number | null; isbn: string | null }) {\n  return fetch(\"/api/books\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\", ...authHeaders() },\n    body: JSON.stringify(input),\n  }).then((r) => handle<Book>(r));\n}\n\nexport function apiUpdateBook(\n  id: number,\n  input: { title: string; author: string; year: number | null; isbn: string | null }\n) {\n  return fetch(`/api/books/${id}`, {\n    method: \"PUT\",\n    headers: { \"Content-Type\": \"application/json\", ...authHeaders() },\n    body: JSON.stringify(input),\n  }).then((r) => handle<Book>(r));\n}\n\nexport function apiDeleteBook(id: number) {\n  return fetch(`/api/books/${id}`, {\n    method: \"DELETE\",\n    headers: authHeaders(),\n  }).then((r) => handle<{ deleted: boolean }>(r));\n}\n\nexport function apiReviews(bookId: number) {\n  return fetch(`/api/books/${bookId}/reviews`).then((r) => handle<ReviewList>(r));\n}\n\nexport function apiCreateReview(bookId: number, input: { rating: number; comment: string }) {\n  return fetch(`/api/books/${bookId}/reviews`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\", ...authHeaders() },\n    body: JSON.stringify(input),\n  }).then((r) => handle<Review>(r));\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794305517154,"end":1794305517170}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4f1665a001ppV837HdrlWjAd","sessionID":"ses_e3b11e6dfffeWcbapUoSOODIDW","messageID":"msg_1c4f138f3001tzaO7qk6BOrqiH"}}
