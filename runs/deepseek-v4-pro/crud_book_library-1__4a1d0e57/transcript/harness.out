{"type":"tool_use","timestamp":1794305436711,"sessionID":"ses_e3b11e6dfffeWcbapUoSOODIDW","part":{"type":"tool","tool":"write","callID":"call_zrp5aykqpdfoi86i3avbzrgg","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the book library app.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", Path(__file__).resolve().parent.parent / \"data\"))\nDATA_DIR.mkdir(parents=True, exist_ok=True)\nDB_PATH = DATA_DIR / \"library.sqlite\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef get_db():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS books (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            author TEXT NOT NULL,\n            year INTEGER,\n            isbn TEXT,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS reviews (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            rating INTEGER NOT NULL,\n            comment TEXT NOT NULL,\n            created_at TEXT NOT NULL,\n            UNIQUE (book_id, user_id)\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        \"\"\"\n    )\n    db.commit()\n    db.close()\n\n\ninit_db()\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t JOIN users u ON u.id = t.user_id \"\n        \"WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, jsonify({\"error\": \"Authentication required\"}), 401\n    return user, None, None\n\n\ndef book_to_dict(row):\n    book_id = row[\"id\"]\n    review_count, average = get_db().execute(\n        \"SELECT COUNT(*), ROUND(AVG(rating), 1) FROM reviews WHERE book_id = ?\",\n        (book_id,),\n    ).fetchone()\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"author\": row[\"author\"],\n        \"year\": row[\"year\"],\n        \"isbn\": row[\"isbn\"],\n        \"created_at\": row[\"created_at\"],\n        \"review_count\": review_count,\n        \"average_rating\": average,\n    }\n\n\ndef review_to_dict(row):\n    username = get_db().execute(\n        \"SELECT username FROM users WHERE id = ?\", (row[\"user_id\"],)\n    ).fetchone()[\"username\"]\n    return {\n        \"id\": row[\"id\"],\n        \"book_id\": row[\"book_id\"],\n        \"rating\": row[\"rating\"],\n        \"comment\": row[\"comment\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": username,\n    }\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username:\n        return jsonify({\"error\": \"Username is required\"}), 400\n    if not password:\n        return jsonify({\"error\": \"Password is required\"}), 400\n\n    db = get_db()\n    existing = db.execute(\"SELECT id FROM users WHERE username = ?\", (username,)).fetchone()\n    if existing:\n        return jsonify({\"error\": \"Username is already taken\"}), 409\n\n    db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), utcnow()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    db = get_db()\n    row = db.execute(\"SELECT id, password_hash FROM users WHERE username = ?\", (username,)).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"Invalid username or password\"}), 401\n\n    token = secrets.token_hex(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/books\")\ndef list_books():\n    q = (request.args.get(\"q\") or \"\").strip()\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = max(1, int(request.args.get(\"page_size\", 10)))\n    except (TypeError, ValueError):\n        page_size = 10\n\n    db = get_db()\n    where = \"\"\n    params = []\n    if q:\n        where = \"WHERE title LIKE ? OR author LIKE ?\"\n        like = f\"%{q}%\"\n        params = [like, like]\n\n    total = db.execute(f\"SELECT COUNT(*) FROM books {where}\", params).fetchone()[0]\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"SELECT * FROM books {where} ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, offset],\n    ).fetchall()\n\n    return jsonify({\n        \"items\": [book_to_dict(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    })\n\n\ndef parse_book_payload(data, partial=False):\n    errors = {}\n    title = data.get(\"title\")\n    author = data.get(\"author\")\n\n    if not partial or \"title\" in data:\n        if not isinstance(title, str) or not title.strip():\n            errors[\"title\"] = \"Title is required\"\n    if not partial or \"author\" in data:\n        if not isinstance(author, str) or not author.strip():\n            errors[\"author\"] = \"Author is required\"\n\n    year = data.get(\"year\")\n    if \"year\" in data and year is not None:\n        if isinstance(year, bool) or not isinstance(year, int):\n            errors[\"year\"] = \"Year must be an integer\"\n\n    isbn = data.get(\"isbn\")\n    if \"isbn\" in data and isbn is not None and not isinstance(isbn, str):\n        errors[\"isbn\"] = \"ISBN must be a string\"\n\n    return errors\n\n\n@app.post(\"/api/books\")\ndef create_book():\n    user, err, status = require_user()\n    if user is None:\n        return err, status\n\n    data = request.get_json(silent=True) or {}\n    errors = parse_book_payload(data)\n    if errors:\n        return jsonify({\"error\": \"Validation failed\", \"fields\": errors}), 400\n\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO books (title, author, year, isbn, created_at) VALUES (?, ?, ?, ?, ?)\",\n        (\n            data[\"title\"].strip(),\n            data[\"author\"].strip(),\n            data.get(\"year\"),\n            data.get(\"isbn\"),\n            utcnow(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM books WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(book_to_dict(row)), 201\n\n\n@app.get(\"/api/books/<int:book_id>\")\ndef get_book(book_id):\n    row = get_db().execute(\"SELECT * FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Book not found\"}), 404\n    return jsonify(book_to_dict(row))\n\n\n@app.put(\"/api/books/<int:book_id>\")\ndef update_book(book_id):\n    user, err, status = require_user()\n    if user is None:\n        return err, status\n\n    row = get_db().execute(\"SELECT * FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Book not found\"}), 404\n\n    data = request.get_json(silent=True) or {}\n    errors = parse_book_payload(data, partial=True)\n    if errors:\n        return jsonify({\"error\": \"Validation failed\", \"fields\": errors}), 400\n\n    title = data[\"title\"].strip() if \"title\" in data else row[\"title\"]\n    author = data[\"author\"].strip() if \"author\" in data else row[\"author\"]\n    year = data.get(\"year\") if \"year\" in data else row[\"year\"]\n    isbn = data.get(\"isbn\") if \"isbn\" in data else row[\"isbn\"]\n\n    db = get_db()\n    db.execute(\n        \"UPDATE books SET title = ?, author = ?, year = ?, isbn = ? WHERE id = ?\",\n        (title, author, year, isbn, book_id),\n    )\n    db.commit()\n    updated = db.execute(\"SELECT * FROM books WHERE id = ?\", (book_id,)).fetchone()\n    return jsonify(book_to_dict(updated))\n\n\n@app.delete(\"/api/books/<int:book_id>\")\ndef delete_book(book_id):\n    user, err, status = require_user()\n    if user is None:\n        return err, status\n\n    row = get_db().execute(\"SELECT id FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Book not found\"}), 404\n\n    db = get_db()\n    db.execute(\"DELETE FROM reviews WHERE book_id = ?\", (book_id,))\n    db.execute(\"DELETE FROM books WHERE id = ?\", (book_id,))\n    db.commit()\n    return jsonify({\"deleted\": True})\n\n\n@app.get(\"/api/books/<int:book_id>/reviews\")\ndef list_reviews(book_id):\n    row = get_db().execute(\"SELECT id FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"Book not found\"}), 404\n    rows = get_db().execute(\n        \"SELECT * FROM reviews WHERE book_id = ? ORDER BY created_at DESC, id DESC\",\n        (book_id,),\n    ).fetchall()\n    return jsonify({\"items\": [review_to_dict(r) for r in rows]})\n\n\n@app.post(\"/api/books/<int:book_id>/reviews\")\ndef create_review(book_id):\n    user, err, status = require_user()\n    if user is None:\n        return err, status\n\n    book = get_db().execute(\"SELECT id FROM books WHERE id = ?\", (book_id,)).fetchone()\n    if book is None:\n        return jsonify({\"error\": \"Book not found\"}), 404\n\n    data = request.get_json(silent=True) or {}\n    rating = data.get(\"rating\")\n    comment = data.get(\"comment\")\n    errors = {}\n\n    if isinstance(rating, bool) or not isinstance(rating, int) or rating < 1 or rating > 5:\n        errors[\"rating\"] = \"Rating must be an integer between 1 and 5\"\n    if not isinstance(comment, str) or not comment.strip():\n        errors[\"comment\"] = \"Comment is required\"\n\n    if errors:\n        return jsonify({\"error\": \"Validation failed\", \"fields\": errors}), 400\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM reviews WHERE book_id = ? AND user_id = ?\",\n        (book_id, user[\"id\"]),\n    ).fetchone()\n    if existing:\n        return jsonify({\"error\": \"You have already reviewed this book\"}), 409\n\n    cur = db.execute(\n        \"INSERT INTO reviews (book_id, user_id, rating, comment, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?)\",\n        (book_id, user[\"id\"], rating, comment.strip(), utcnow()),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM reviews WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(review_to_dict(row)), 201\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794305436673,"end":1794305436693}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4f02bf7001UjuRvyujJ6kWt3","sessionID":"ses_e3b11e6dfffeWcbapUoSOODIDW","messageID":"msg_1c4ef9f97001o5wUxs77hKLVYJ"}}
