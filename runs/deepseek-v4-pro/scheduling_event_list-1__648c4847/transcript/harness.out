{"type":"tool_use","timestamp":1794353318484,"sessionID":"ses_e383ae324ffewqnrqIrn1kRZV2","part":{"type":"tool","tool":"write","callID":"call_tj72xfho68740vwsq5e5lqac","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { ApiError, fieldErrors } from \"../api\";\nimport { EventInput } from \"../api\";\n\nexport interface EventFormValues {\n  title: string;\n  description: string;\n  location: string;\n  start_time: string;\n  end_time: string;\n}\n\nconst EMPTY: EventFormValues = {\n  title: \"\",\n  description: \"\",\n  location: \"\",\n  start_time: \"\",\n  end_time: \"\",\n};\n\nexport default function EventForm({\n  initial,\n  submitLabel,\n  onSubmit,\n  onCancel,\n}: {\n  initial?: Partial<EventFormValues>;\n  submitLabel: string;\n  onSubmit: (values: EventFormValues) => Promise<void>;\n  onCancel: () => void;\n}) {\n  const [values, setValues] = useState<EventFormValues>({\n    ...EMPTY,\n    ...initial,\n  });\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [formError, setFormError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  function set<K extends keyof EventFormValues>(\n    key: K,\n    value: EventFormValues[K]\n  ) {\n    setValues((v) => ({ ...v, [key]: value }));\n  }\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setErrors({});\n    setFormError(null);\n    setBusy(true);\n    try {\n      await onSubmit({\n        ...values,\n        description: values.description || \"\",\n        location: values.location || \"\",\n      });\n    } catch (err) {\n      if (err instanceof ApiError && err.body) {\n        const fe = fieldErrors(err.body);\n        if (Object.keys(fe).length) {\n          setErrors(fe);\n        } else {\n          setFormError(\"Could not save the event.\");\n        }\n      } else {\n        setFormError(\"Could not save the event.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const input =\n    \"w-full rounded-lg border bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\";\n  const inputError = \"border-red-400\";\n  const inputOk = \"border-slate-300\";\n\n  function field(k: keyof EventFormValues) {\n    return `${input} ${errors[k] ? inputError : inputOk}`;\n  }\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4\">\n      <div>\n        <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n          Title\n        </label>\n        <input\n          className={field(\"title\")}\n          value={values.title}\n          onChange={(e) => set(\"title\", e.target.value)}\n          required\n        />\n        {errors.title && <FieldError msg={errors.title} />}\n      </div>\n\n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n        <div>\n          <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n            Start time\n          </label>\n          <input\n            type=\"datetime-local\"\n            className={field(\"start_time\")}\n            value={values.start_time}\n            onChange={(e) => set(\"start_time\", e.target.value)}\n            required\n          />\n          {errors.start_time && <FieldError msg={errors.start_time} />}\n        </div>\n        <div>\n          <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n            End time\n          </label>\n          <input\n            type=\"datetime-local\"\n            className={field(\"end_time\")}\n            value={values.end_time}\n            onChange={(e) => set(\"end_time\", e.target.value)}\n            required\n          />\n          {errors.end_time && <FieldError msg={errors.end_time} />}\n        </div>\n      </div>\n\n      <div>\n        <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n          Location\n        </label>\n        <input\n          className={field(\"location\")}\n          value={values.location}\n          onChange={(e) => set(\"location\", e.target.value)}\n          placeholder=\"Optional\"\n        />\n        {errors.location && <FieldError msg={errors.location} />}\n      </div>\n\n      <div>\n        <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n          Description\n        </label>\n        <textarea\n          className={field(\"description\")}\n          rows={3}\n          value={values.description}\n          onChange={(e) => set(\"description\", e.target.value)}\n          placeholder=\"Optional\"\n        />\n        {errors.description && <FieldError msg={errors.description} />}\n      </div>\n\n      {formError && (\n        <p className=\"rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600\">\n          {formError}\n        </p>\n      )}\n\n      <div className=\"flex justify-end gap-2 pt-2\">\n        <button\n          type=\"button\"\n          onClick={onCancel}\n          className=\"rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n        >\n          Cancel\n        </button>\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50\"\n        >\n          {busy ? \"Saving…\" : submitLabel}\n        </button>\n      </div>\n    </form>\n  );\n}\n\nfunction FieldError({ msg }: { msg: string }) {\n  return <p className=\"mt-1 text-xs text-red-600\">{msg}</p>;\n}\n","filePath":"/workspace/frontend/src/components/EventForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/EventForm.tsx","exists":false,"truncated":false},"title":"frontend/src/components/EventForm.tsx","time":{"start":1794353318460,"end":1794353318467}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7caca37001Ru7rSKkG5knLeK","sessionID":"ses_e383ae324ffewqnrqIrn1kRZV2","messageID":"msg_1c7ca94c8001J2SET0RucIM1sE"}}
