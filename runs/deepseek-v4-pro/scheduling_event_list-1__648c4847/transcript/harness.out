{"type":"tool_use","timestamp":1794353209643,"sessionID":"ses_e383ae324ffewqnrqIrn1kRZV2","part":{"type":"tool","tool":"write","callID":"call_f5w98y55dpssfdke08kclq5p","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Shared event calendar: Flask JSON API + static frontend.\"\"\"\n\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"calendar.db\"\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef get_db():\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n        _init_db(g.db)\n    return g.db\n\n\ndef _init_db(db):\n    db.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS sessions (\n            token TEXT PRIMARY KEY,\n            username TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS events (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            description TEXT,\n            location TEXT,\n            start_time TEXT NOT NULL,\n            end_time TEXT NOT NULL,\n            created_at TEXT NOT NULL,\n            created_by TEXT NOT NULL\n        );\n        \"\"\"\n    )\n    db.commit()\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef now_utc() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef parse_datetime(value):\n    \"\"\"Parse an ISO-8601 date-time, defaulting to UTC when no offset is given.\n\n    Returns a naive-free UTC datetime. Raises ValueError on invalid input.\n    \"\"\"\n    if value is None:\n        raise ValueError(\"must be a date-time string\")\n    text = value.strip()\n    if not text:\n        raise ValueError(\"must not be empty\")\n    try:\n        dt = datetime.fromisoformat(text)\n    except ValueError:\n        raise ValueError(\"must be an ISO-8601 date-time\") from None\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    else:\n        dt = dt.astimezone(timezone.utc)\n    return dt\n\n\ndef serialize_datetime(dt) -> str:\n    return dt.astimezone(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef event_to_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": row[\"start_time\"],\n        \"end_time\": row[\"end_time\"],\n        \"created_at\": row[\"created_at\"],\n        \"created_by\": row[\"created_by\"],\n    }\n\n\ndef get_current_user():\n    \"\"\"Return the username for a valid bearer token, or None.\"\"\"\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"SELECT username FROM sessions WHERE token = ?\", (token,)\n    ).fetchone()\n    return row[\"username\"] if row else None\n\n\ndef require_user():\n    user = get_current_user()\n    if user is None:\n        return None\n    return user\n\n\ndef json_error(message, status=400, errors=None):\n    body = {}\n    if errors is not None:\n        body[\"errors\"] = errors\n    else:\n        body[\"error\"] = message\n    return jsonify(body), status\n\n\n# --------------------------------------------------------------------------- #\n# Health + frontend\n# --------------------------------------------------------------------------- #\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    candidate = DIST / path\n    if candidate.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n# --------------------------------------------------------------------------- #\n# Auth\n# --------------------------------------------------------------------------- #\n\n\ndef validate_credentials(data):\n    if not isinstance(data, dict):\n        return None, \"request body must be a JSON object\"\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return None, \"username is required\"\n    if not isinstance(password, str) or not password:\n        return None, \"password is required\"\n    return (username.strip(), password), None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True)\n    creds, err = validate_credentials(data)\n    if err:\n        return json_error(err)\n    username, password = creds\n    db = get_db()\n    existing = db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing:\n        return json_error(\"username is already taken\", status=409)\n    db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), now_utc()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True)\n    creds, err = validate_credentials(data)\n    if err:\n        return json_error(err)\n    username, password = creds\n    db = get_db()\n    row = db.execute(\n        \"SELECT password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return json_error(\"invalid username or password\", status=401)\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO sessions (token, username, created_at) VALUES (?, ?, ?)\",\n        (token, username, now_utc()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": username})\n\n\n# --------------------------------------------------------------------------- #\n# Events\n# --------------------------------------------------------------------------- #\n\n\ndef parse_event_body(data):\n    \"\"\"Validate an event body, returning (fields, error_dict_or_None).\"\"\"\n    if not isinstance(data, dict):\n        return None, {\"body\": \"request body must be a JSON object\"}\n\n    errors = {}\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"title is required\"\n\n    fields = {}\n    try:\n        fields[\"start_time\"] = serialize_datetime(parse_datetime(data.get(\"start_time\")))\n    except ValueError as exc:\n        errors[\"start_time\"] = str(exc)\n    try:\n        fields[\"end_time\"] = serialize_datetime(parse_datetime(data.get(\"end_time\")))\n    except ValueError as exc:\n        errors[\"end_time\"] = str(exc)\n\n    if \"start_time\" not in errors and \"end_time\" not in errors:\n        start = parse_datetime(data.get(\"start_time\"))\n        end = parse_datetime(data.get(\"end_time\"))\n        if end <= start:\n            errors[\"end_time\"] = \"end_time must be after start_time\"\n\n    fields[\"title\"] = title.strip() if isinstance(title, str) else None\n    fields[\"description\"] = data.get(\"description\")\n    fields[\"location\"] = data.get(\"location\")\n    for key in (\"description\", \"location\"):\n        val = data.get(key)\n        if val is None:\n            fields[key] = None\n        elif isinstance(val, str):\n            fields[key] = val\n        else:\n            errors[key] = f\"{key} must be a string\"\n\n    if errors:\n        return None, errors\n    return fields, None\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    db = get_db()\n    start_date = request.args.get(\"start_date\")\n    end_date = request.args.get(\"end_date\")\n\n    clauses = []\n    params = []\n    if start_date:\n        try:\n            start = parse_datetime(start_date)\n        except ValueError:\n            return json_error(\"start_date must be a valid date-time\", status=400)\n        clauses.append(\"start_time >= ?\")\n        params.append(serialize_datetime(start))\n    if end_date:\n        try:\n            end = parse_datetime(end_date)\n        except ValueError:\n            return json_error(\"end_date must be a valid date-time\", status=400)\n        # Include the full end day when only a date is supplied.\n        if len(end_date.strip()) <= 10:\n            end = end + timedelta(days=1)\n        clauses.append(\"start_time < ?\")\n        params.append(serialize_datetime(end))\n\n    where = (\"WHERE \" + \" AND \".join(clauses)) if clauses else \"\"\n    query = f\"SELECT * FROM events {where} ORDER BY start_time ASC, id ASC\"\n    rows = db.execute(query, params).fetchall()\n    items = [event_to_dict(r) for r in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\n@app.post(\"/api/events\")\ndef create_event():\n    user = require_user()\n    if user is None:\n        return json_error(\"authentication required\", status=401)\n    fields, errors = parse_event_body(request.get_json(silent=True))\n    if errors:\n        return jsonify({\"errors\": errors}), 400\n    db = get_db()\n    cur = db.execute(\n        \"\"\"\n        INSERT INTO events\n            (title, description, location, start_time, end_time, created_at, created_by)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            now_utc(),\n            user,\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM events WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(event_to_dict(row)), 201\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id):\n    db = get_db()\n    row = db.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return json_error(\"event not found\", status=404)\n    return jsonify(event_to_dict(row))\n\n\n@app.put(\"/api/events/<int:event_id>\")\ndef update_event(event_id):\n    user = require_user()\n    if user is None:\n        return json_error(\"authentication required\", status=401)\n    db = get_db()\n    row = db.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return json_error(\"event not found\", status=404)\n    fields, errors = parse_event_body(request.get_json(silent=True))\n    if errors:\n        return jsonify({\"errors\": errors}), 400\n    db.execute(\n        \"\"\"\n        UPDATE events\n        SET title = ?, description = ?, location = ?, start_time = ?, end_time = ?\n        WHERE id = ?\n        \"\"\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            event_id,\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    return jsonify(event_to_dict(row))\n\n\n@app.delete(\"/api/events/<int:event_id>\")\ndef delete_event(event_id):\n    user = require_user()\n    if user is None:\n        return json_error(\"authentication required\", status=401)\n    db = get_db()\n    row = db.execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return json_error(\"event not found\", status=404)\n    db.execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    db.commit()\n    return jsonify({\"deleted\": True})\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794353209597,"end":1794353209619}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7c920f3001qDr6h3pR9Dm9Jr","sessionID":"ses_e383ae324ffewqnrqIrn1kRZV2","messageID":"msg_1c7c885ff001472EIkLpKCm2B3"}}
