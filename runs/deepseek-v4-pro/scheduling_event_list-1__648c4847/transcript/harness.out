{"type":"tool_use","timestamp":1794353304782,"sessionID":"ses_e383ae324ffewqnrqIrn1kRZV2","part":{"type":"tool","tool":"write","callID":"call_4lkm94a370kw52s84b8ud0tk","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { ApiError, fieldErrors, login, register } from \"../api\";\n\nexport default function Auth({\n  onAuthed,\n}: {\n  onAuthed: (username: string) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await register(username, password);\n        const res = await login(username, password);\n        onAuthed(res.username);\n      } else {\n        const res = await login(username, password);\n        onAuthed(res.username);\n      }\n    } catch (err) {\n      setError(message(err));\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  function message(err: unknown): string {\n    if (err instanceof ApiError && err.status === 401) {\n      return \"Invalid username or password.\";\n    }\n    if (err instanceof ApiError && err.status === 409) {\n      return \"That username is already taken.\";\n    }\n    if (err instanceof ApiError && err.body) {\n      const fe = fieldErrors(err.body);\n      if (fe.username) return fe.username;\n      if (fe.password) return fe.password;\n    }\n    return \"Something went wrong. Please try again.\";\n  }\n\n  const input =\n    \"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200\";\n\n  return (\n    <div className=\"flex min-h-screen items-center justify-center bg-slate-100 px-4\">\n      <div className=\"w-full max-w-sm rounded-2xl bg-white p-8 shadow-lg\">\n        <h1 className=\"mb-1 text-2xl font-bold text-slate-900\">Event Calendar</h1>\n        <p className=\"mb-6 text-sm text-slate-500\">\n          {mode === \"login\" ? \"Sign in to your account\" : \"Create a new account\"}\n        </p>\n\n        <div className=\"mb-6 flex rounded-lg bg-slate-100 p-1\">\n          {([\"login\", \"register\"] as const).map((m) => (\n            <button\n              key={m}\n              type=\"button\"\n              onClick={() => {\n                setMode(m);\n                setError(null);\n              }}\n              className={`flex-1 rounded-md px-3 py-1.5 text-sm font-medium transition ${\n                mode === m\n                  ? \"bg-white text-slate-900 shadow\"\n                  : \"text-slate-500 hover:text-slate-700\"\n              }`}\n            >\n              {m === \"login\" ? \"Sign in\" : \"Register\"}\n            </button>\n          ))}\n        </div>\n\n        <form onSubmit={submit} className=\"space-y-4\">\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Username\n            </label>\n            <input\n              className={input}\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              autoComplete=\"username\"\n              required\n            />\n          </div>\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Password\n            </label>\n            <input\n              className={input}\n              type=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              autoComplete={\n                mode === \"login\" ? \"current-password\" : \"new-password\"\n              }\n              required\n            />\n          </div>\n\n          {error && (\n            <p className=\"rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600\">\n              {error}\n            </p>\n          )}\n\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50\"\n          >\n            {busy ? \"Please wait…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/Auth.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Auth.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Auth.tsx","time":{"start":1794353304753,"end":1794353304763}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ca94aa00119EUViN5dGqNCx","sessionID":"ses_e383ae324ffewqnrqIrn1kRZV2","messageID":"msg_1c7ca657c001hGvB2JFh4qziBq"}}
