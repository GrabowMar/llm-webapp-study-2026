{"type":"tool_use","timestamp":1794383441891,"sessionID":"ses_e366b492affevb5EwqV3r4nKgS","part":{"type":"tool","tool":"write","callID":"call_6ybfbsoit4fqpffnr0e97uyc","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point.\"\"\"\n\nimport os\nimport re\nimport secrets\nfrom datetime import datetime\nfrom datetime import timezone\nfrom pathlib import Path\n\nimport jwt\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"app.sqlite\"\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"JWT_SECRET\"] = os.environ.get(\"JWT_SECRET\") or secrets.token_hex(32)\n\nURL_RE = re.compile(r\"^https?://\", re.IGNORECASE)\nMAX_URL_LENGTH = 2048\nSHORT_CODE_LENGTH = 6\n\n\n# ---------------------------------------------------------------------------\n# database\n# ---------------------------------------------------------------------------\n\ndef get_db():\n    if \"db\" not in g:\n        import sqlite3\n\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    import sqlite3\n\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS links (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            owner_id INTEGER NOT NULL,\n            original_url TEXT NOT NULL,\n            short_code TEXT NOT NULL UNIQUE,\n            click_count INTEGER NOT NULL DEFAULT 0,\n            active INTEGER NOT NULL DEFAULT 1,\n            created_at TEXT NOT NULL,\n            FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE CASCADE\n        );\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef generate_short_code():\n    alphabet = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\"\n    db = get_db()\n    while True:\n        code = \"\".join(secrets.choice(alphabet) for _ in range(SHORT_CODE_LENGTH))\n        row = db.execute(\n            \"SELECT 1 FROM links WHERE short_code = ?\", (code,)\n        ).fetchone()\n        if row is None:\n            return code\n\n\ndef generate_token(user_id):\n    payload = {\n        \"sub\": str(user_id),\n        \"iat\": datetime.now(timezone.utc),\n    }\n    return jwt.encode(payload, app.config[\"JWT_SECRET\"], algorithm=\"HS256\")\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    try:\n        payload = jwt.decode(\n            token, app.config[\"JWT_SECRET\"], algorithms=[\"HS256\"]\n        )\n        user_id = int(payload[\"sub\"])\n    except (jwt.InvalidTokenError, KeyError, ValueError):\n        return None\n    db = get_db()\n    return db.execute(\n        \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n    ).fetchone()\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None\n    return user\n\n\ndef require_admin():\n    user = current_user()\n    if user is None or user[\"username\"] != \"admin\":\n        return None\n    return user\n\n\ndef serialize_link(row, base_url):\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"{base_url}/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef base_url():\n    scheme = request.headers.get(\"X-Forwarded-Proto\", request.scheme)\n    host = request.headers.get(\"X-Forwarded-Host\", request.host)\n    return f\"{scheme}://{host}\"\n\n\n# ---------------------------------------------------------------------------\n# auth\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    if len(username) > 64:\n        return jsonify({\"error\": \"username is too long\"}), 400\n    if username == \"admin\":\n        return jsonify({\"error\": \"username is taken\"}), 409\n\n    db = get_db()\n    if db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone():\n        return jsonify({\"error\": \"username is taken\"}), 409\n\n    from werkzeug.security import generate_password_hash\n\n    db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), now_iso()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    if username == \"admin\":\n        if not ADMIN_PASSWORD:\n            return jsonify({\"error\": \"invalid credentials\"}), 401\n        if not secrets.compare_digest(password, ADMIN_PASSWORD):\n            return jsonify({\"error\": \"invalid credentials\"}), 401\n        db = get_db()\n        row = db.execute(\n            \"SELECT id, username FROM users WHERE username = ?\", (\"admin\",)\n        ).fetchone()\n        if row is None:\n            from werkzeug.security import generate_password_hash\n\n            cur = db.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (\"admin\", generate_password_hash(ADMIN_PASSWORD), now_iso()),\n            )\n            db.commit()\n            admin_id = cur.lastrowid\n        else:\n            admin_id = row[\"id\"]\n        return jsonify({\"token\": generate_token(admin_id), \"username\": \"admin\"}), 200\n\n    from werkzeug.security import check_password_hash\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n\n    return jsonify({\"token\": generate_token(row[\"id\"]), \"username\": row[\"username\"]}), 200\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n\n\n# ---------------------------------------------------------------------------\n# links\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/links\")\ndef create_link():\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n\n    data = request.get_json(silent=True) or {}\n    original_url = (data.get(\"original_url\") or \"\").strip()\n\n    if not original_url:\n        return jsonify({\"error\": \"original_url is required\"}), 400\n    if len(original_url) > MAX_URL_LENGTH:\n        return jsonify({\"error\": \"original_url is too long\"}), 400\n    if not URL_RE.match(original_url):\n        return jsonify({\"error\": \"only http and https addresses are accepted\"}), 400\n\n    db = get_db()\n    short_code = generate_short_code()\n    cur = db.execute(\n        \"INSERT INTO links (owner_id, original_url, short_code, created_at) \"\n        \"VALUES (?, ?, ?, ?)\",\n        (user[\"id\"], original_url, short_code, now_iso()),\n    )\n    db.commit()\n\n    row = db.execute(\n        \"SELECT l.*, u.username AS owner FROM links l \"\n        \"JOIN users u ON u.id = l.owner_id WHERE l.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(serialize_link(row, base_url())), 201\n\n\n@app.get(\"/api/links\")\ndef list_links():\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n\n    page = max(1, request.args.get(\"page\", 1, type=int))\n    page_size = min(100, max(1, request.args.get(\"page_size\", 20, type=int)))\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM links WHERE owner_id = ? AND active = 1\",\n        (user[\"id\"],),\n    ).fetchone()[0]\n    rows = db.execute(\n        \"SELECT l.*, u.username AS owner FROM links l \"\n        \"JOIN users u ON u.id = l.owner_id \"\n        \"WHERE l.owner_id = ? AND l.active = 1 \"\n        \"ORDER BY l.id DESC LIMIT ? OFFSET ?\",\n        (user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [serialize_link(r, base_url()) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/links/<int:link_id>\")\ndef get_link(link_id):\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT l.*, u.username AS owner FROM links l \"\n        \"JOIN users u ON u.id = l.owner_id \"\n        \"WHERE l.id = ? AND l.owner_id = ? AND l.active = 1\",\n        (link_id, user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n\n    return jsonify(serialize_link(row, base_url()))\n\n\n@app.delete(\"/api/links/<int:link_id>\")\ndef delete_link(link_id):\n    user = require_user()\n    if user is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, owner_id FROM links WHERE id = ?\", (link_id,)\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    if row[\"owner_id\"] != user[\"id\"]:\n        return jsonify({\"error\": \"forbidden\"}), 403\n\n    db.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n    db.commit()\n    return jsonify({\"deleted\": True})\n\n\n# ---------------------------------------------------------------------------\n# admin\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/admin/links\")\ndef admin_list_links():\n    admin = require_admin()\n    if admin is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n\n    page = max(1, request.args.get(\"page\", 1, type=int))\n    page_size = min(100, max(1, request.args.get(\"page_size\", 20, type=int)))\n\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) FROM links\").fetchone()[0]\n    rows = db.execute(\n        \"SELECT l.*, u.username AS owner FROM links l \"\n        \"JOIN users u ON u.id = l.owner_id \"\n        \"ORDER BY l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [serialize_link(r, base_url()) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/links/<int:link_id>/toggle\")\ndef admin_toggle_link(link_id):\n    admin = require_admin()\n    if admin is None:\n        return jsonify({\"error\": \"unauthorized\"}), 401\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, active FROM links WHERE id = ?\", (link_id,)\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n\n    db.execute(\n        \"UPDATE links SET active = ? WHERE id = ?\",\n        (0 if row[\"active\"] else 1, link_id),\n    )\n    db.commit()\n\n    row = db.execute(\n        \"SELECT l.*, u.username AS owner FROM links l \"\n        \"JOIN users u ON u.id = l.owner_id WHERE l.id = ?\",\n        (link_id,),\n    ).fetchone()\n    return jsonify(serialize_link(row, base_url()))\n\n\n# ---------------------------------------------------------------------------\n# redirect\n# ---------------------------------------------------------------------------\n\n@app.get(\"/r/<code>\")\ndef redirect_link(code):\n    db = get_db()\n    row = db.execute(\n        \"SELECT original_url, active FROM links WHERE short_code = ?\", (code,)\n    ).fetchone()\n    if row is None or not row[\"active\"]:\n        return jsonify({\"error\": \"not found\"}), 404\n\n    db.execute(\n        \"UPDATE links SET click_count = click_count + 1 WHERE short_code = ?\",\n        (code,),\n    )\n    db.commit()\n\n    from flask import redirect\n\n    return redirect(row[\"original_url\"], code=302)\n\n\n# ---------------------------------------------------------------------------\n# frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path.startswith(\"r/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794383441851,"end":1794383441870}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9966fb4001n5HdRMZTY7vB0A","sessionID":"ses_e366b492affevb5EwqV3r4nKgS","messageID":"msg_1c995df26001lnB014lG1SLc2B"}}
