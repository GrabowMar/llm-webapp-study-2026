{"type":"tool_use","timestamp":1794383634395,"sessionID":"ses_e366b492affevb5EwqV3r4nKgS","part":{"type":"tool","tool":"write","callID":"call_tzjptnoebtmd9f6xq9x429uk","state":{"status":"completed","input":{"content":"export interface Link {\n  id: number;\n  original_url: string;\n  short_code: string;\n  click_count: number;\n  created_at: string;\n  short_url: string;\n  owner: string;\n  active?: number;\n}\n\nexport interface PagedLinks {\n  items: Link[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface AuthState {\n  token: string;\n  username: string;\n}\n\nconst TOKEN_KEY = \"token\";\nconst USERNAME_KEY = \"username\";\n\nexport function getAuth(): AuthState | null {\n  const token = localStorage.getItem(TOKEN_KEY);\n  const username = localStorage.getItem(USERNAME_KEY);\n  if (!token || !username) return null;\n  return { token, username };\n}\n\nexport function setAuth(auth: AuthState) {\n  localStorage.setItem(TOKEN_KEY, auth.token);\n  localStorage.setItem(USERNAME_KEY, auth.username);\n}\n\nexport function clearAuth() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nasync function handle<T>(res: Response): Promise<T> {\n  if (res.ok) {\n    if (res.status === 204) return undefined as T;\n    return (await res.json()) as T;\n  }\n  let message = `Request failed (${res.status})`;\n  try {\n    const body = await res.json();\n    if (body && typeof body.error === \"string\") message = body.error;\n  } catch {\n    /* ignore */\n  }\n  throw new ApiError(res.status, message);\n}\n\nfunction headers(auth?: AuthState | null): HeadersInit {\n  const h: HeadersInit = { \"Content-Type\": \"application/json\" };\n  if (auth?.token) h[\"Authorization\"] = `Bearer ${auth.token}`;\n  return h;\n}\n\nexport async function register(\n  username: string,\n  password: string,\n): Promise<void> {\n  const res = await fetch(\"/api/auth/register\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  });\n  await handle(res);\n}\n\nexport async function login(\n  username: string,\n  password: string,\n): Promise<AuthState> {\n  const res = await fetch(\"/api/auth/login\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  });\n  const body = await handle<{ token: string; username?: string }>(res);\n  return { token: body.token, username: body.username ?? username };\n}\n\nexport async function createLink(\n  auth: AuthState,\n  originalUrl: string,\n): Promise<Link> {\n  const res = await fetch(\"/api/links\", {\n    method: \"POST\",\n    headers: headers(auth),\n    body: JSON.stringify({ original_url: originalUrl }),\n  });\n  return handle<Link>(res);\n}\n\nexport async function listLinks(\n  auth: AuthState,\n  page: number,\n  pageSize: number,\n): Promise<PagedLinks> {\n  const res = await fetch(\n    `/api/links?page=${page}&page_size=${pageSize}`,\n    { headers: headers(auth) },\n  );\n  return handle<PagedLinks>(res);\n}\n\nexport async function deleteLink(auth: AuthState, id: number): Promise<void> {\n  const res = await fetch(`/api/links/${id}`, {\n    method: \"DELETE\",\n    headers: headers(auth),\n  });\n  await handle(res);\n}\n\nexport async function listAdminLinks(\n  auth: AuthState,\n  page: number,\n  pageSize: number,\n): Promise<PagedLinks> {\n  const res = await fetch(\n    `/api/admin/links?page=${page}&page_size=${pageSize}`,\n    { headers: headers(auth) },\n  );\n  return handle<PagedLinks>(res);\n}\n\nexport async function toggleLink(auth: AuthState, id: number): Promise<Link> {\n  const res = await fetch(`/api/admin/links/${id}/toggle`, {\n    method: \"POST\",\n    headers: headers(auth),\n  });\n  return handle<Link>(res);\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794383634364,"end":1794383634375}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9995faf001BS8aG3eZ7U7CfU","sessionID":"ses_e366b492affevb5EwqV3r4nKgS","messageID":"msg_1c9993069001dBi5lDnzU6rA9g"}}
