{"type":"tool_use","timestamp":1794383672466,"sessionID":"ses_e366b492affevb5EwqV3r4nKgS","part":{"type":"tool","tool":"write","callID":"call_fm4jzonlgbn3lloj2eyuzp16","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport type { AuthState, Link, PagedLinks } from \"./api\";\nimport {\n  createLink,\n  deleteLink,\n  listLinks,\n} from \"./api\";\n\ninterface Props {\n  auth: AuthState;\n}\n\nconst PAGE_SIZE = 10;\n\nfunction truncate(url: string, max = 60): string {\n  return url.length > max ? url.slice(0, max) + \"…\" : url;\n}\n\nfunction formatDate(iso: string): string {\n  const d = new Date(iso);\n  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString();\n}\n\nexport default function Dashboard({ auth }: Props) {\n  const [url, setUrl] = useState(\"\");\n  const [created, setCreated] = useState<Link | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [copied, setCopied] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const [data, setData] = useState<PagedLinks | null>(null);\n  const [page, setPage] = useState(1);\n  const [loading, setLoading] = useState(false);\n\n  const refresh = useCallback(async () => {\n    setLoading(true);\n    try {\n      setData(await listLinks(auth, page, PAGE_SIZE));\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to load links\");\n    } finally {\n      setLoading(false);\n    }\n  }, [auth, page]);\n\n  useEffect(() => {\n    refresh();\n  }, [refresh]);\n\n  async function onShorten(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      const link = await createLink(auth, url);\n      setCreated(link);\n      setUrl(\"\");\n      setPage(1);\n      refresh();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to shorten\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function onCopy() {\n    if (!created) return;\n    try {\n      await navigator.clipboard.writeText(created.short_url);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 1500);\n    } catch {\n      /* ignore */\n    }\n  }\n\n  async function onDelete(link: Link) {\n    if (!window.confirm(`Delete this link? ${link.short_url}`)) return;\n    try {\n      await deleteLink(auth, link.id);\n      refresh();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete\");\n    }\n  }\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / PAGE_SIZE)) : 1;\n\n  return (\n    <div className=\"space-y-8\">\n      <section>\n        <h1 className=\"mb-4 text-2xl font-bold\">Shorten a link</h1>\n        <form onSubmit={onShorten} className=\"flex flex-col gap-3 sm:flex-row\">\n          <input\n            value={url}\n            onChange={(e) => setUrl(e.target.value)}\n            placeholder=\"https://example.com/very/long/path\"\n            className=\"flex-1 rounded border border-slate-300 px-3 py-2 text-sm\"\n          />\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"rounded bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 disabled:opacity-50\"\n          >\n            Shorten\n          </button>\n        </form>\n        {error && <p className=\"mt-2 text-sm text-red-600\">{error}</p>}\n        {created && (\n          <div className=\"mt-4 flex items-center gap-2 rounded border border-green-200 bg-green-50 p-3\">\n            <a\n              href={created.short_url}\n              className=\"text-sm font-medium text-green-800 underline\"\n            >\n              {created.short_url}\n            </a>\n            <button\n              onClick={onCopy}\n              className=\"rounded bg-white px-3 py-1 text-sm font-medium text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50\"\n            >\n              {copied ? \"Copied!\" : \"Copy\"}\n            </button>\n          </div>\n        )}\n      </section>\n\n      <section>\n        <h2 className=\"mb-4 text-xl font-bold\">Recent links</h2>\n        {loading && <p className=\"text-sm text-slate-500\">Loading…</p>}\n        {!loading && data && data.items.length === 0 && (\n          <p className=\"text-sm text-slate-500\">No links yet.</p>\n        )}\n        {!loading && data && data.items.length > 0 && (\n          <div className=\"overflow-hidden rounded-lg border border-slate-200 bg-white\">\n            <table className=\"w-full text-left text-sm\">\n              <thead className=\"bg-slate-50 text-xs uppercase text-slate-500\">\n                <tr>\n                  <th className=\"px-4 py-2\">Short</th>\n                  <th className=\"px-4 py-2\">Original</th>\n                  <th className=\"px-4 py-2 text-right\">Clicks</th>\n                  <th className=\"px-4 py-2\">Created</th>\n                  <th className=\"px-4 py-2\" />\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {data.items.map((link) => (\n                  <tr key={link.id} className=\"hover:bg-slate-50\">\n                    <td className=\"px-4 py-2\">\n                      <a\n                        href={link.short_url}\n                        className=\"text-indigo-600 underline\"\n                      >\n                        /r/{link.short_code}\n                      </a>\n                    </td>\n                    <td className=\"px-4 py-2\">\n                      <a\n                        href={link.original_url}\n                        title={link.original_url}\n                        className=\"text-slate-600 hover:text-slate-900\"\n                      >\n                        {truncate(link.original_url)}\n                      </a>\n                    </td>\n                    <td className=\"px-4 py-2 text-right\">\n                      {link.click_count}\n                    </td>\n                    <td className=\"px-4 py-2 text-slate-500\">\n                      {formatDate(link.created_at)}\n                    </td>\n                    <td className=\"px-4 py-2 text-right\">\n                      <button\n                        onClick={() => onDelete(link)}\n                        className=\"rounded px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50\"\n                      >\n                        Delete\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n        {data && (\n          <div className=\"mt-3 flex items-center justify-between text-sm\">\n            <button\n              disabled={page <= 1}\n              onClick={() => setPage(page - 1)}\n              className=\"rounded border border-slate-300 px-3 py-1 font-medium hover:bg-slate-50 disabled:opacity-40\"\n            >\n              Previous\n            </button>\n            <span className=\"text-slate-500\">\n              Page {data.page} of {totalPages} ({data.total} links)\n            </span>\n            <button\n              disabled={page >= totalPages}\n              onClick={() => setPage(page + 1)}\n              className=\"rounded border border-slate-300 px-3 py-1 font-medium hover:bg-slate-50 disabled:opacity-40\"\n            >\n              Next\n            </button>\n          </div>\n        )}\n      </section>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/Dashboard.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Dashboard.tsx","exists":false,"truncated":false},"title":"frontend/src/Dashboard.tsx","time":{"start":1794383672401,"end":1794383672412}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c999f44a001U5FUNqQPk1b3Mp","sessionID":"ses_e366b492affevb5EwqV3r4nKgS","messageID":"msg_1c999a6a5001KOKXeS5LOQXS7F"}}
