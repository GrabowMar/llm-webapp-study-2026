{"type":"step_start","timestamp":1794383686621,"sessionID":"ses_e366b492affevb5EwqV3r4nKgS","part":{"id":"prt_1c99a2bd0001rP03iYu4nN72uD","messageID":"msg_1c999f46e001VyMLbvIi0NBXHg","sessionID":"ses_e366b492affevb5EwqV3r4nKgS","type":"step-start"}}
{"type":"tool_use","timestamp":1794383686646,"sessionID":"ses_e366b492affevb5EwqV3r4nKgS","part":{"type":"tool","tool":"write","callID":"call_0gbv66zkt5ozbltk2j2zt3ga","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport type { AuthState, PagedLinks } from \"./api\";\nimport { listAdminLinks, toggleLink } from \"./api\";\n\ninterface Props {\n  auth: AuthState;\n}\n\nconst PAGE_SIZE = 10;\n\nfunction truncate(url: string, max = 60): string {\n  return url.length > max ? url.slice(0, max) + \"…\" : url;\n}\n\nexport default function Admin({ auth }: Props) {\n  const [data, setData] = useState<PagedLinks | null>(null);\n  const [page, setPage] = useState(1);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const refresh = useCallback(async () => {\n    setLoading(true);\n    try {\n      setData(await listAdminLinks(auth, page, PAGE_SIZE));\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to load links\");\n    } finally {\n      setLoading(false);\n    }\n  }, [auth, page]);\n\n  useEffect(() => {\n    refresh();\n  }, [refresh]);\n\n  async function onToggle(id: number) {\n    setError(null);\n    try {\n      await toggleLink(auth, id);\n      refresh();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to toggle\");\n    }\n  }\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / PAGE_SIZE)) : 1;\n\n  return (\n    <div>\n      <h1 className=\"mb-4 text-2xl font-bold\">All links</h1>\n      {error && <p className=\"mb-3 text-sm text-red-600\">{error}</p>}\n      {loading && <p className=\"text-sm text-slate-500\">Loading…</p>}\n      {!loading && data && data.items.length === 0 && (\n        <p className=\"text-sm text-slate-500\">No links yet.</p>\n      )}\n      {!loading && data && data.items.length > 0 && (\n        <div className=\"overflow-hidden rounded-lg border border-slate-200 bg-white\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"bg-slate-50 text-xs uppercase text-slate-500\">\n              <tr>\n                <th className=\"px-4 py-2\">Short</th>\n                <th className=\"px-4 py-2\">Original</th>\n                <th className=\"px-4 py-2\">Owner</th>\n                <th className=\"px-4 py-2 text-right\">Clicks</th>\n                <th className=\"px-4 py-2\">Status</th>\n                <th className=\"px-4 py-2\" />\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {data.items.map((link) => (\n                <tr key={link.id} className=\"hover:bg-slate-50\">\n                  <td className=\"px-4 py-2\">\n                    <a href={link.short_url} className=\"text-indigo-600 underline\">\n                      /r/{link.short_code}\n                    </a>\n                  </td>\n                  <td className=\"px-4 py-2\">\n                    <a\n                      href={link.original_url}\n                      title={link.original_url}\n                      className=\"text-slate-600 hover:text-slate-900\"\n                    >\n                      {truncate(link.original_url)}\n                    </a>\n                  </td>\n                  <td className=\"px-4 py-2 font-medium\">{link.owner}</td>\n                  <td className=\"px-4 py-2 text-right\">{link.click_count}</td>\n                  <td className=\"px-4 py-2\">\n                    {link.active ? (\n                      <span className=\"rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800\">\n                        Active\n                      </span>\n                    ) : (\n                      <span className=\"rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800\">\n                        Disabled\n                      </span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-2 text-right\">\n                    <button\n                      onClick={() => onToggle(link.id)}\n                      className=\"rounded px-2 py-1 text-xs font-medium text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50\"\n                    >\n                      {link.active ? \"Disable\" : \"Enable\"}\n                    </button>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n      {data && (\n        <div className=\"mt-3 flex items-center justify-between text-sm\">\n          <button\n            disabled={page <= 1}\n            onClick={() => setPage(page - 1)}\n            className=\"rounded border border-slate-300 px-3 py-1 font-medium hover:bg-slate-50 disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <span className=\"text-slate-500\">\n            Page {data.page} of {totalPages} ({data.total} links)\n          </span>\n          <button\n            disabled={page >= totalPages}\n            onClick={() => setPage(page + 1)}\n            className=\"rounded border border-slate-300 px-3 py-1 font-medium hover:bg-slate-50 disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/Admin.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/Admin.tsx","exists":false,"truncated":false},"title":"frontend/src/Admin.tsx","time":{"start":1794383686616,"end":1794383686625}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c99a2bd3001PZUtMZZqPNY7TH","sessionID":"ses_e366b492affevb5EwqV3r4nKgS","messageID":"msg_1c999f46e001VyMLbvIi0NBXHg"}}
