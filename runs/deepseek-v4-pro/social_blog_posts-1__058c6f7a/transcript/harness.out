{"type":"step_start","timestamp":1794365237485,"sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","part":{"id":"prt_1c880a8e2001gAyf2Tj62MFaoa","messageID":"msg_1c8807819001E1XG97kp2UtLqA","sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","type":"step-start"}}
{"type":"tool_use","timestamp":1794365237512,"sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","part":{"type":"tool","tool":"write","callID":"call_l11jy0p2dgrszz39okqymzt5","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { api, formatDate, type Post } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Link, navigate } from \"../router\";\n\nexport default function PostPage({ id }: { id: string }) {\n  const { user } = useAuth();\n  const [post, setPost] = useState<Post | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [deleting, setDeleting] = useState(false);\n\n  useEffect(() => {\n    setLoading(true);\n    setError(null);\n    api\n      .getPost(id)\n      .then(setPost)\n      .catch((err) =>\n        setError(\n          err instanceof Error && err.status === 404\n            ? \"Post not found\"\n            : err instanceof Error\n              ? err.message\n              : \"Failed to load post\",\n        ),\n      )\n      .finally(() => setLoading(false));\n  }, [id]);\n\n  async function handleDelete() {\n    if (!window.confirm(\"Delete this post? This cannot be undone.\")) return;\n    setDeleting(true);\n    try {\n      await api.deletePost(id);\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete post\");\n      setDeleting(false);\n    }\n  }\n\n  async function handleToggle() {\n    try {\n      const updated = await api.togglePost(id);\n      setPost(updated);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to update post\");\n    }\n  }\n\n  if (loading) {\n    return <p className=\"mx-auto max-w-3xl px-4 py-8 text-sm text-slate-500\">Loading…</p>;\n  }\n\n  if (error) {\n    return (\n      <div className=\"mx-auto max-w-3xl px-4 py-8\">\n        <p className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n        <Link to=\"/\" className=\"mt-4 inline-block text-sm text-indigo-600 hover:underline\">\n          ← Back to posts\n        </Link>\n      </div>\n    );\n  }\n\n  if (!post) return null;\n\n  const isOwner = user?.username === post.author;\n\n  return (\n    <article className=\"mx-auto max-w-3xl px-4 py-8\">\n      <Link to=\"/\" className=\"text-sm text-indigo-600 hover:underline\">\n        ← Back to posts\n      </Link>\n      <h1 className=\"mt-4 text-3xl font-bold text-slate-900\">{post.title}</h1>\n      <p className=\"mt-2 text-sm text-slate-500\">\n        {post.author} · {formatDate(post.created_at)}\n      </p>\n      {post.tags.length > 0 && (\n        <div className=\"mt-3 flex flex-wrap gap-1.5\">\n          {post.tags.map((t) => (\n            <span\n              key={t}\n              className=\"rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700\"\n            >\n              {t}\n            </span>\n          ))}\n        </div>\n      )}\n\n      <div className=\"mt-6 whitespace-pre-wrap text-slate-800\">\n        {post.content}\n      </div>\n\n      <div className=\"mt-8 flex flex-wrap items-center gap-3\">\n        {isOwner && (\n          <>\n            <Link\n              to={`/posts/${post.id}/edit`}\n              className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n            >\n              Edit\n            </Link>\n            <button\n              onClick={handleDelete}\n              disabled={deleting}\n              className=\"rounded-md border border-red-300 px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 disabled:opacity-50\"\n            >\n              {deleting ? \"Deleting…\" : \"Delete\"}\n            </button>\n          </>\n        )}\n        {user?.is_admin && (\n          <button\n            onClick={handleToggle}\n            className={\n              post.taken_down\n                ? \"rounded-md border border-green-300 px-3 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50\"\n                : \"rounded-md border border-amber-300 px-3 py-1.5 text-sm font-medium text-amber-700 hover:bg-amber-50\"\n            }\n          >\n            {post.taken_down ? \"Restore post\" : \"Take down\"}\n          </button>\n        )}\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/PostPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/PostPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/PostPage.tsx","time":{"start":1794365237481,"end":1794365237488}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c880a8e4001jR0bEmJQbQjOHc","sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","messageID":"msg_1c8807819001E1XG97kp2UtLqA"}}
