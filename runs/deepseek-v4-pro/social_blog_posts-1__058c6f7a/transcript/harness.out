{"type":"tool_use","timestamp":1794365176244,"sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","part":{"type":"tool","tool":"write","callID":"call_utbj89wk1dgjgi3zu2oy0f8w","state":{"status":"completed","input":{"content":"export type Post = {\n  id: number;\n  title: string;\n  content: string;\n  tags: string[];\n  created_at: string;\n  updated_at: string;\n  author: string;\n  excerpt: string;\n};\n\nexport type PostList = {\n  items: Post[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type User = {\n  username: string;\n  is_admin: boolean;\n};\n\nconst TOKEN_KEY = \"blog_token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) {\n    localStorage.setItem(TOKEN_KEY, token);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n  }\n}\n\ntype ApiErrorBody = { error?: string };\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nasync function request<T>(\n  method: string,\n  path: string,\n  body?: unknown,\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n\n  const res = await fetch(`/api${path}`, {\n    method,\n    headers,\n    body: body !== undefined ? JSON.stringify(body) : undefined,\n  });\n\n  if (res.status === 204) return undefined as T;\n\n  let data: unknown = null;\n  const text = await res.text();\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n\n  if (!res.ok) {\n    const msg =\n      data && typeof data === \"object\" && (data as ApiErrorBody).error\n        ? (data as ApiErrorBody).error\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, msg as string);\n  }\n\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"POST\", \"/auth/register\", { username, password }),\n\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"POST\", \"/auth/login\", { username, password }),\n\n  logout: () => request<{ status: string }>(\"POST\", \"/auth/logout\"),\n\n  me: () => request<User>(\"GET\", \"/auth/me\"),\n\n  listPosts: (params: {\n    q?: string;\n    tag?: string;\n    author?: string;\n    page?: number;\n    page_size?: number;\n  }) => {\n    const sp = new URLSearchParams();\n    if (params.q) sp.set(\"q\", params.q);\n    if (params.tag) sp.set(\"tag\", params.tag);\n    if (params.author) sp.set(\"author\", params.author);\n    if (params.page) sp.set(\"page\", String(params.page));\n    if (params.page_size) sp.set(\"page_size\", String(params.page_size));\n    const qs = sp.toString();\n    return request<PostList>(\"GET\", `/posts${qs ? `?${qs}` : \"\"}`);\n  },\n\n  getPost: (id: number | string) => request<Post>(\"GET\", `/posts/${id}`),\n\n  createPost: (data: { title: string; content: string; tags: string[] }) =>\n    request<Post>(\"POST\", \"/posts\", data),\n\n  updatePost: (\n    id: number | string,\n    data: { title: string; content: string; tags: string[] },\n  ) => request<Post>(\"PUT\", `/posts/${id}`, data),\n\n  deletePost: (id: number | string) =>\n    request<{ status: string }>(\"DELETE\", `/posts/${id}`),\n\n  togglePost: (id: number | string) =>\n    request<Post>(\"POST\", `/admin/posts/${id}/toggle`),\n};\n\nexport function formatDate(iso: string): string {\n  const d = new Date(iso);\n  if (Number.isNaN(d.getTime())) return iso;\n  return d.toLocaleDateString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n  });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794365176221,"end":1794365176228}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c87fb998001O2nVQP2hVhPfLV","sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","messageID":"msg_1c87f8708001yJkZXayZIYFiw6"}}
