{"type":"text","timestamp":1794365028877,"sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","part":{"id":"prt_1c87d79fa001nVtksU5VqakM0O","messageID":"msg_1c87c63c8001Q6jsguUymK2nHS","sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","type":"text","text":"Now I'll write the backend.\n\n","time":{"start":1794365028858,"end":1794365028874}}}
{"type":"tool_use","timestamp":1794365028914,"sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","part":{"type":"tool","tool":"write","callID":"call_7e9bg70garhrh0a1b73wjbrv","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the multi-author blog.\"\"\"\n\nimport json\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"blog.db\"\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\napp = Flask(__name__, static_folder=None)\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef get_db():\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT,\n            is_admin INTEGER NOT NULL DEFAULT 0,\n            created_at TEXT NOT NULL\n        );\n\n        CREATE TABLE IF NOT EXISTS sessions (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL,\n            created_at TEXT NOT NULL,\n            FOREIGN KEY (user_id) REFERENCES users (id)\n        );\n\n        CREATE TABLE IF NOT EXISTS posts (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            author_id INTEGER NOT NULL,\n            title TEXT NOT NULL,\n            content TEXT NOT NULL,\n            tags TEXT NOT NULL DEFAULT '[]',\n            taken_down INTEGER NOT NULL DEFAULT 0,\n            created_at TEXT NOT NULL,\n            updated_at TEXT NOT NULL,\n            FOREIGN KEY (author_id) REFERENCES users (id)\n        );\n        \"\"\"\n    )\n    conn.execute(\n        \"INSERT OR IGNORE INTO users (username, password_hash, is_admin, created_at) \"\n        \"VALUES ('admin', NULL, 1, ?)\",\n        (now_iso(),),\n    )\n    if ADMIN_PASSWORD:\n        conn.execute(\n            \"UPDATE users SET password_hash = ? WHERE username = 'admin'\",\n            (generate_password_hash(ADMIN_PASSWORD),),\n        )\n    else:\n        conn.execute(\n            \"UPDATE users SET password_hash = NULL WHERE username = 'admin'\",\n        )\n    conn.commit()\n    conn.close()\n\n\ndef make_excerpt(content: str) -> str:\n    text = re.sub(r\"\\r\\n|\\r|\\n\", \" \", content)\n    return text[:200]\n\n\ndef post_to_dict(row) -> dict:\n    tags = []\n    if row[\"tags\"]:\n        try:\n            tags = json.loads(row[\"tags\"])\n        except (json.JSONDecodeError, TypeError):\n            tags = []\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"content\": row[\"content\"],\n        \"tags\": tags,\n        \"created_at\": row[\"created_at\"],\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"username\"],\n        \"excerpt\": make_excerpt(row[\"content\"]),\n    }\n\n\ndef current_user():\n    auth = request.headers.get(\"Authorization\", \"\")\n    if not auth.startswith(\"Bearer \"):\n        return None\n    token = auth[7:].strip()\n    if not token:\n        return None\n    db = get_db()\n    row = db.execute(\n        \"SELECT u.id, u.username, u.is_admin FROM sessions s \"\n        \"JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    if row is None:\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"is_admin\": bool(row[\"is_admin\"])}\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None\n    return user\n\n\ndef error(message, status):\n    return jsonify({\"error\": message}), status\n\n\ndef body_json():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body_json()\n    if data is None:\n        return error(\"Invalid JSON body\", 400)\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    if not username:\n        return error(\"Username is required\", 400)\n    if not password:\n        return error(\"Password is required\", 400)\n    if username == \"admin\":\n        return error(\"Username is taken\", 409)\n    db = get_db()\n    exists = db.execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if exists:\n        return error(\"Username is taken\", 409)\n    db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n        \"VALUES (?, ?, 0, ?)\",\n        (username, generate_password_hash(password), now_iso()),\n    )\n    db.commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body_json()\n    if data is None:\n        return error(\"Invalid JSON body\", 400)\n    username = (data.get(\"username\") or \"\").strip()\n    password = data.get(\"password\") or \"\"\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash, is_admin FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if user is None or not user[\"password_hash\"]:\n        return error(\"Invalid username or password\", 401)\n    if not check_password_hash(user[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    user = current_user()\n    if user is not None:\n        auth = request.headers.get(\"Authorization\", \"\")\n        token = auth[7:].strip()\n        db = get_db()\n        db.execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n        db.commit()\n    return jsonify({\"status\": \"ok\"}), 200\n\n\n@app.get(\"/api/posts\")\ndef list_posts():\n    user = current_user()\n    is_admin = bool(user and user[\"is_admin\"])\n    q = request.args.get(\"q\", \"\").strip()\n    tag = request.args.get(\"tag\", \"\").strip()\n    author = request.args.get(\"author\", \"\").strip()\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except ValueError:\n        page = 1\n    try:\n        page_size = max(1, min(100, int(request.args.get(\"page_size\", 10))))\n    except ValueError:\n        page_size = 10\n\n    db = get_db()\n    clauses = []\n    params = []\n    if not is_admin:\n        clauses.append(\"p.taken_down = 0\")\n    if q:\n        clauses.append(\"(p.title LIKE ? OR p.content LIKE ?)\")\n        like = f\"%{q}%\"\n        params.extend([like, like])\n    if author:\n        clauses.append(\"u.username = ?\")\n        params.append(author)\n    where = \"\"\n    if clauses:\n        where = \"WHERE \" + \" AND \".join(clauses)\n\n    rows = db.execute(\n        f\"SELECT p.*, u.username FROM posts p JOIN users u ON u.id = p.author_id \"\n        f\"{where} ORDER BY p.created_at DESC, p.id DESC\",\n        params,\n    ).fetchall()\n\n    items = [post_to_dict(r) for r in rows]\n    if tag:\n        items = [p for p in items if tag in p[\"tags\"]]\n\n    total = len(items)\n    start = (page - 1) * page_size\n    page_items = items[start : start + page_size]\n\n    return jsonify(\n        {\n            \"items\": page_items,\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/posts\")\ndef create_post():\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required\", 401)\n    data = body_json()\n    if data is None:\n        return error(\"Invalid JSON body\", 400)\n    title = (data.get(\"title\") or \"\").strip()\n    content = data.get(\"content\") or \"\"\n    if not title:\n        return error(\"Title is required\", 400)\n    if not content:\n        return error(\"Content is required\", 400)\n    tags = data.get(\"tags\", [])\n    if tags is None:\n        tags = []\n    if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):\n        return error(\"Tags must be a list of strings\", 400)\n    tags = [t.strip() for t in tags if t.strip()]\n\n    ts = now_iso()\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO posts (author_id, title, content, tags, taken_down, created_at, updated_at) \"\n        \"VALUES (?, ?, ?, ?, 0, ?, ?)\",\n        (user[\"id\"], title, content, json.dumps(tags), ts, ts),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT p.*, u.username FROM posts p JOIN users u ON u.id = p.author_id WHERE p.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(post_to_dict(row)), 201\n\n\ndef get_post_or_404(db, post_id, is_admin):\n    row = db.execute(\n        \"SELECT p.*, u.username FROM posts p JOIN users u ON u.id = p.author_id WHERE p.id = ?\",\n        (post_id,),\n    ).fetchone()\n    if row is None:\n        return None\n    if row[\"taken_down\"] and not is_admin:\n        return None\n    return row\n\n\n@app.get(\"/api/posts/<int:post_id>\")\ndef get_post(post_id):\n    user = current_user()\n    is_admin = bool(user and user[\"is_admin\"])\n    row = get_post_or_404(get_db(), post_id, is_admin)\n    if row is None:\n        return error(\"Not found\", 404)\n    return jsonify(post_to_dict(row))\n\n\n@app.put(\"/api/posts/<int:post_id>\")\ndef update_post(post_id):\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required\", 401)\n    data = body_json()\n    if data is None:\n        return error(\"Invalid JSON body\", 400)\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM posts WHERE id = ?\", (post_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"Not found\", 404)\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(\"Forbidden\", 403)\n    title = (data.get(\"title\") or \"\").strip()\n    content = data.get(\"content\") or \"\"\n    if not title:\n        return error(\"Title is required\", 400)\n    if not content:\n        return error(\"Content is required\", 400)\n    tags = data.get(\"tags\", [])\n    if tags is None:\n        tags = []\n    if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):\n        return error(\"Tags must be a list of strings\", 400)\n    tags = [t.strip() for t in tags if t.strip()]\n\n    ts = now_iso()\n    db.execute(\n        \"UPDATE posts SET title = ?, content = ?, tags = ?, updated_at = ? WHERE id = ?\",\n        (title, content, json.dumps(tags), ts, post_id),\n    )\n    db.commit()\n    updated = db.execute(\n        \"SELECT p.*, u.username FROM posts p JOIN users u ON u.id = p.author_id WHERE p.id = ?\",\n        (post_id,),\n    ).fetchone()\n    return jsonify(post_to_dict(updated))\n\n\n@app.delete(\"/api/posts/<int:post_id>\")\ndef delete_post(post_id):\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required\", 401)\n    db = get_db()\n    row = db.execute(\"SELECT * FROM posts WHERE id = ?\", (post_id,)).fetchone()\n    if row is None:\n        return error(\"Not found\", 404)\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(\"Forbidden\", 403)\n    db.execute(\"DELETE FROM posts WHERE id = ?\", (post_id,))\n    db.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/admin/posts/<int:post_id>/toggle\")\ndef toggle_post(post_id):\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required\", 401)\n    if not user[\"is_admin\"]:\n        return error(\"Forbidden\", 403)\n    db = get_db()\n    row = db.execute(\"SELECT * FROM posts WHERE id = ?\", (post_id,)).fetchone()\n    if row is None:\n        return error(\"Not found\", 404)\n    new_state = 0 if row[\"taken_down\"] else 1\n    db.execute(\n        \"UPDATE posts SET taken_down = ?, updated_at = ? WHERE id = ?\",\n        (new_state, now_iso(), post_id),\n    )\n    db.commit()\n    updated = db.execute(\n        \"SELECT p.*, u.username FROM posts p JOIN users u ON u.id = p.author_id WHERE p.id = ?\",\n        (post_id,),\n    ).fetchone()\n    return jsonify(post_to_dict(updated))\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794365028869,"end":1794365028892}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c87d79fe0011QQkp5t3eI7QZk","sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","messageID":"msg_1c87c63c8001Q6jsguUymK2nHS"}}
