{"type":"tool_use","timestamp":1794365224992,"sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","part":{"type":"tool","tool":"write","callID":"call_5oeywz2hd2nvbryxrf2n2fwu","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, formatDate, type Post } from \"../api\";\nimport { Link } from \"../router\";\n\nexport default function PostList() {\n  const [q, setQ] = useState(\"\");\n  const [tag, setTag] = useState(\"\");\n  const [author, setAuthor] = useState(\"\");\n  const [page, setPage] = useState(1);\n\n  const [data, setData] = useState<{\n    items: Post[];\n    total: number;\n    page: number;\n    page_size: number;\n  } | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const res = await api.listPosts({ q, tag, author, page });\n      setData(res);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to load posts\");\n    } finally {\n      setLoading(false);\n    }\n  }, [q, tag, author, page]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  const pageSize = data?.page_size ?? 10;\n  const total = data?.total ?? 0;\n  const pages = Math.max(1, Math.ceil(total / pageSize));\n\n  function goTo(p: number) {\n    setPage(p);\n    window.scrollTo({ top: 0 });\n  }\n\n  return (\n    <div className=\"mx-auto max-w-3xl px-4 py-8\">\n      <div className=\"mb-6 space-y-3\">\n        <input\n          value={q}\n          onChange={(e) => {\n            setQ(e.target.value);\n            setPage(1);\n          }}\n          placeholder=\"Search posts…\"\n          className=\"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n        />\n        <div className=\"flex flex-wrap gap-3\">\n          <input\n            value={tag}\n            onChange={(e) => {\n              setTag(e.target.value);\n              setPage(1);\n            }}\n            placeholder=\"Filter by tag\"\n            className=\"rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n          />\n          <input\n            value={author}\n            onChange={(e) => {\n              setAuthor(e.target.value);\n              setPage(1);\n            }}\n            placeholder=\"Filter by author\"\n            className=\"rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n          />\n        </div>\n      </div>\n\n      {loading && <p className=\"py-8 text-sm text-slate-500\">Loading…</p>}\n      {error && (\n        <p className=\"rounded-md bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n      {!loading && !error && data && data.items.length === 0 && (\n        <p className=\"py-8 text-sm text-slate-500\">No posts found.</p>\n      )}\n\n      <ul className=\"space-y-4\">\n        {data?.items.map((post) => (\n          <li key={post.id}>\n            <Link\n              to={`/posts/${post.id}`}\n              className=\"block rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-300 hover:shadow-sm\"\n            >\n              <h2 className=\"text-lg font-semibold text-slate-900\">\n                {post.title}\n              </h2>\n              <p className=\"mt-1 text-sm text-slate-500\">\n                {post.author} · {formatDate(post.created_at)}\n              </p>\n              <p className=\"mt-2 text-sm text-slate-600\">{post.excerpt}</p>\n              {post.tags.length > 0 && (\n                <div className=\"mt-3 flex flex-wrap gap-1.5\">\n                  {post.tags.map((t) => (\n                    <span\n                      key={t}\n                      className=\"rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700\"\n                    >\n                      {t}\n                    </span>\n                  ))}\n                </div>\n              )}\n            </Link>\n          </li>\n        ))}\n      </ul>\n\n      {pages > 1 && (\n        <div className=\"mt-8 flex items-center justify-center gap-2\">\n          <button\n            disabled={page <= 1}\n            onClick={() => goTo(page - 1)}\n            className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <span className=\"text-sm text-slate-600\">\n            Page {page} of {pages}\n          </span>\n          <button\n            disabled={page >= pages}\n            onClick={() => goTo(page + 1)}\n            className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/PostList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/PostList.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/PostList.tsx","time":{"start":1794365224958,"end":1794365224968}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c88077f6001DX1lv0jEGFChXC","sessionID":"ses_e378656c8ffeGtYdaPC77uGrl1","messageID":"msg_1c8804311001o1h9Gw1O9OZ4a5"}}
