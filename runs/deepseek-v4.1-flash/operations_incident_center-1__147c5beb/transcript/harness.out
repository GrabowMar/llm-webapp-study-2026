{"type":"tool_use","timestamp":1794378072207,"sessionID":"ses_e36bf4aaaffeoJzVcyvbt67PH0","part":{"type":"tool","tool":"write","callID":"call_3cb5da05adac4e99a1790f00","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\n\nexport const SEVERITIES = [\"sev1\", \"sev2\", \"sev3\", \"sev4\"] as const;\nexport const STATUSES = [\"investigating\", \"identified\", \"monitoring\", \"resolved\"] as const;\n\nexport function severityBadge(severity: string): string {\n  switch (severity) {\n    case \"sev1\":\n      return \"bg-red-100 text-red-800 ring-red-600/20\";\n    case \"sev2\":\n      return \"bg-orange-100 text-orange-800 ring-orange-600/20\";\n    case \"sev3\":\n      return \"bg-yellow-100 text-yellow-800 ring-yellow-600/20\";\n    default:\n      return \"bg-sky-100 text-sky-800 ring-sky-600/20\";\n  }\n}\n\nexport function statusBadge(status: string): string {\n  switch (status) {\n    case \"resolved\":\n      return \"bg-emerald-100 text-emerald-800 ring-emerald-600/20\";\n    case \"monitoring\":\n      return \"bg-blue-100 text-blue-800 ring-blue-600/20\";\n    case \"identified\":\n      return \"bg-purple-100 text-purple-800 ring-purple-600/20\";\n    default:\n      return \"bg-slate-100 text-slate-800 ring-slate-600/20\";\n  }\n}\n\nexport function formatDate(value: string | null): string {\n  if (!value) return \"—\";\n  return new Date(value).toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n  });\n}\n\nexport function humanStatus(status: string): string {\n  return status.replace(/_/g, \" \").replace(/\\b\\w/g, (c) => c.toUpperCase());\n}\n\nexport function useNow(intervalMs = 30000): Date {\n  const [now, setNow] = useState(() => new Date());\n  useEffect(() => {\n    const handle = window.setInterval(() => setNow(new Date()), intervalMs);\n    return () => window.clearInterval(handle);\n  }, [intervalMs]);\n  return now;\n}\n\nexport interface NoticeProps {\n  tone: \"error\" | \"success\" | \"info\";\n  children: React.ReactNode;\n}\n\nexport function Notice({ tone, children }: NoticeProps) {\n  const tones = {\n    error: \"bg-red-50 text-red-800 ring-red-600/20\",\n    success: \"bg-emerald-50 text-emerald-800 ring-emerald-600/20\",\n    info: \"bg-sky-50 text-sky-800 ring-sky-600/20\",\n  } as const;\n  return (\n    <div className={`rounded-md px-3 py-2 text-sm ring-1 ${tones[tone]}`}>\n      {children}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/ui.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/ui.tsx","exists":false,"truncated":false},"title":"frontend/src/ui.tsx","time":{"start":1794378072173,"end":1794378072184}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9448067001OP1m1M7HMS0TCy","sessionID":"ses_e36bf4aaaffeoJzVcyvbt67PH0","messageID":"msg_1c9444ea7001e6OaUF9xtItsQy"}}
