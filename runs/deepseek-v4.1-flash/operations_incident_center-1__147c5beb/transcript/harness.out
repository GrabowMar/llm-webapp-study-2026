{"type":"tool_use","timestamp":1794379290702,"sessionID":"ses_e36bf4aaaffeoJzVcyvbt67PH0","part":{"type":"tool","tool":"bash","callID":"call_cff1280ff28746dda4366ca0","state":{"status":"completed","input":{"command":"cd /workspace && sed -n '1,80p' backend/app.py && echo ... && sed -n '80,200p' backend/app.py"},"output":"\"\"\"Incident center API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"incident_center.db\"\n\nSEVERITIES = (\"sev1\", \"sev2\", \"sev3\", \"sev4\")\nSLA_MINUTES = {\"sev1\": 60, \"sev2\": 240, \"sev3\": 1440, \"sev4\": 4320}\nOPEN_STATUSES_SQL = \"status != 'resolved'\"\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(value: datetime) -> str:\n    return value.isoformat()\n\n\ndef parse_iso(value: str) -> datetime:\n    parsed = datetime.fromisoformat(value)\n    if parsed.tzinfo is None:\n        parsed = parsed.replace(tzinfo=timezone.utc)\n    return parsed\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS incidents (\n...\n            CREATE TABLE IF NOT EXISTS incidents (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                title TEXT NOT NULL,\n                service TEXT NOT NULL,\n                severity TEXT NOT NULL,\n                status TEXT NOT NULL,\n                commander TEXT,\n                impact_summary TEXT,\n                opened_at TEXT NOT NULL,\n                resolved_at TEXT,\n                reopen_count INTEGER NOT NULL DEFAULT 0,\n                opened_by TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS timeline_events (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                incident_id INTEGER NOT NULL REFERENCES incidents(id) ON DELETE CASCADE,\n                type TEXT NOT NULL,\n                message TEXT NOT NULL,\n                created_at TEXT NOT NULL,\n                author TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_incidents_opened\n                ON incidents(opened_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_incidents_severity\n                ON incidents(severity);\n            CREATE INDEX IF NOT EXISTS idx_incidents_status\n                ON incidents(status);\n            CREATE INDEX IF NOT EXISTS idx_timeline_incident\n                ON timeline_events(incident_id, created_at, id);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef api_error(message: str, status: int, errors: dict[str, str] | None = None):\n    payload: dict[str, Any] = {\"error\": message}\n    if errors:\n        payload[\"errors\"] = errors\n    return jsonify(payload), status\n\n\ndef json_body() -> dict[str, Any] | None:\n    if not request.is_json:\n        return None\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return None\n    return body\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    token = token.strip()\n    row = get_db().execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM tokens JOIN users ON users.id = tokens.user_id\n        WHERE tokens.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef auth_required(view: Callable[..., Any]):\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        user = current_user()\n        if user is None:\n            return api_error(\"Authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef incident_payload(row: sqlite3.Row) -> dict[str, Any]:\n    opened_at = parse_iso(row[\"opened_at\"])\n    due_at = opened_at + timedelta(minutes=SLA_MINUTES.get(row[\"severity\"], 0))\n    if row[\"resolved_at\"] is not None:\n        resolved_at = parse_iso(row[\"resolved_at\"])\n        breached = resolved_at > due_at\n    else:\n        breached = now() > due_at\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"service\": row[\"service\"],\n        \"severity\": row[\"severity\"],\n        \"status\": row[\"status\"],\n        \"commander\": row[\"commander\"],\n        \"impact_summary\": row[\"impact_summary\"],\n        \"opened_at\": row[\"opened_at\"],\n        \"resolved_at\": row[\"resolved_at\"],\n        \"reopen_count\": row[\"reopen_count\"],\n        \"opened_by\": row[\"opened_by\"],\n        \"sla_due_at\": iso(due_at),\n        \"sla_breached\": breached,\n    }\n\n\ndef event_payload(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"type\": row[\"type\"],\n        \"message\": row[\"message\"],\n        \"created_at\": row[\"created_at\"],\n        \"author\": row[\"author\"],\n    }\n\n","metadata":{"output":"\"\"\"Incident center API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"incident_center.db\"\n\nSEVERITIES = (\"sev1\", \"sev2\", \"sev3\", \"sev4\")\nSLA_MINUTES = {\"sev1\": 60, \"sev2\": 240, \"sev3\": 1440, \"sev4\": 4320}\nOPEN_STATUSES_SQL = \"status != 'resolved'\"\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(value: datetime) -> str:\n    return value.isoformat()\n\n\ndef parse_iso(value: str) -> datetime:\n    parsed = datetime.fromisoformat(value)\n    if parsed.tzinfo is None:\n        parsed = parsed.replace(tzinfo=timezone.utc)\n    return parsed\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS incidents (\n...\n            CREATE TABLE IF NOT EXISTS incidents (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                title TEXT NOT NULL,\n                service TEXT NOT NULL,\n                severity TEXT NOT NULL,\n                status TEXT NOT NULL,\n                commander TEXT,\n                impact_summary TEXT,\n                opened_at TEXT NOT NULL,\n                resolved_at TEXT,\n                reopen_count INTEGER NOT NULL DEFAULT 0,\n                opened_by TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS timeline_events (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                incident_id INTEGER NOT NULL REFERENCES incidents(id) ON DELETE CASCADE,\n                type TEXT NOT NULL,\n                message TEXT NOT NULL,\n                created_at TEXT NOT NULL,\n                author TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_incidents_opened\n                ON incidents(opened_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_incidents_severity\n                ON incidents(severity);\n            CREATE INDEX IF NOT EXISTS idx_incidents_status\n                ON incidents(status);\n            CREATE INDEX IF NOT EXISTS idx_timeline_incident\n                ON timeline_events(incident_id, created_at, id);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef api_error(message: str, status: int, errors: dict[str, str] | None = None):\n    payload: dict[str, Any] = {\"error\": message}\n    if errors:\n        payload[\"errors\"] = errors\n    return jsonify(payload), status\n\n\ndef json_body() -> dict[str, Any] | None:\n    if not request.is_json:\n        return None\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return None\n    return body\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    token = token.strip()\n    row = get_db().execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM tokens JOIN users ON users.id = tokens.user_id\n        WHERE tokens.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef auth_required(view: Callable[..., Any]):\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        user = current_user()\n        if user is None:\n            return api_error(\"Authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef incident_payload(row: sqlite3.Row) -> dict[str, Any]:\n    opened_at = parse_iso(row[\"opened_at\"])\n    due_at = opened_at + timedelta(minutes=SLA_MINUTES.get(row[\"severity\"], 0))\n    if row[\"resolved_at\"] is not None:\n        resolved_at = parse_iso(row[\"resolved_at\"])\n        breached = resolved_at > due_at\n    else:\n        breached = now() > due_at\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"service\": row[\"service\"],\n        \"severity\": row[\"severity\"],\n        \"status\": row[\"status\"],\n        \"commander\": row[\"commander\"],\n        \"impact_summary\": row[\"impact_summary\"],\n        \"opened_at\": row[\"opened_at\"],\n        \"resolved_at\": row[\"resolved_at\"],\n        \"reopen_count\": row[\"reopen_count\"],\n        \"opened_by\": row[\"opened_by\"],\n        \"sla_due_at\": iso(due_at),\n        \"sla_breached\": breached,\n    }\n\n\ndef event_payload(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"type\": row[\"type\"],\n        \"message\": row[\"message\"],\n        \"created_at\": row[\"created_at\"],\n        \"author\": row[\"author\"],\n    }\n\n","exit":0,"truncated":false},"title":"cd /workspace && sed -n '1,80p' backend/app.py && echo ... && sed -n '80,200p' backend/app.py","time":{"start":1794379290658,"end":1794379290676}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c957181b001mKn4vG22Clb13e","sessionID":"ses_e36bf4aaaffeoJzVcyvbt67PH0","messageID":"msg_1c956b525001kP3cO26Aofgm6y"}}
