{"type":"tool_use","timestamp":1794370412321,"sessionID":"ses_e3734403fffeP2TzeAjnl49j89","part":{"type":"tool","tool":"write","callID":"call_47c74a2d964b45eba475e39a","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Tagged notes: Flask JSON API plus the built React frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"notes.db\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\n\ndef get_db():\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    db.executescript(\n        \"\"\"\n        PRAGMA journal_mode = WAL;\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tokens (\n            token TEXT PRIMARY KEY,\n            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS notes (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            content TEXT NOT NULL,\n            pinned INTEGER NOT NULL DEFAULT 0,\n            author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n            created_at TEXT NOT NULL,\n            updated_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS tags (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            name TEXT NOT NULL UNIQUE\n        );\n        CREATE TABLE IF NOT EXISTS note_tags (\n            note_id INTEGER NOT NULL REFERENCES notes(id) ON DELETE CASCADE,\n            tag_id INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,\n            PRIMARY KEY (note_id, tag_id)\n        );\n        CREATE INDEX IF NOT EXISTS idx_notes_updated ON notes(updated_at DESC);\n        CREATE INDEX IF NOT EXISTS idx_note_tags_tag ON note_tags(tag_id);\n        \"\"\"\n    )\n    db.commit()\n    db.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef hash_password(password, salt=None):\n    salt = salt or secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), 200_000\n    ).hex()\n    return f\"{salt}${digest}\"\n\n\ndef verify_password(password, stored):\n    try:\n        salt, _ = stored.split(\"$\", 1)\n    except ValueError:\n        return False\n    return hmac.compare_digest(hash_password(password, salt), stored)\n\n\n# ---------------------------------------------------------------------------\n# Request helpers\n# ---------------------------------------------------------------------------\n\n\ndef error(message, status=400, field=None):\n    body = {\"error\": message}\n    if field:\n        body[\"errors\"] = {field: message}\n    return jsonify(body), status\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef current_auth():\n    \"\"\"Return (user_row, token) or (None, None).\"\"\"\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None, None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None, None\n    db = get_db()\n    row = db.execute(\n        \"\"\"\n        SELECT u.id, u.username FROM tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    if row is None:\n        return None, None\n    return row, token\n\n\ndef require_user():\n    user, _ = current_auth()\n    return user\n\n\ndef note_tags(note_id):\n    rows = get_db().execute(\n        \"\"\"\n        SELECT t.name FROM tags t\n        JOIN note_tags nt ON nt.tag_id = t.id\n        WHERE nt.note_id = ?\n        ORDER BY t.name COLLATE NOCASE\n        \"\"\",\n        (note_id,),\n    ).fetchall()\n    return [r[\"name\"] for r in rows]\n\n\ndef serialize_note(row):\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"content\": row[\"content\"],\n        \"tags\": note_tags(row[\"id\"]),\n        \"pinned\": bool(row[\"pinned\"]),\n        \"created_at\": row[\"created_at\"],\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\ndef note_by_id(db, note_id):\n    return db.execute(\n        \"\"\"\n        SELECT n.*, u.username AS author FROM notes n\n        JOIN users u ON u.id = n.author_id\n        WHERE n.id = ?\n        \"\"\",\n        (note_id,),\n    ).fetchone()\n\n\ndef normalize_tags(raw):\n    \"\"\"Validate and normalize a tag list. Returns (tags, error_message).\"\"\"\n    if raw is None:\n        return [], None\n    if not isinstance(raw, list):\n        return None, \"Tags must be a list of strings.\"\n    result = []\n    seen = set()\n    for item in raw:\n        if not isinstance(item, str):\n            return None, \"Tags must be a list of strings.\"\n        tag = item.strip()\n        if not tag:\n            continue\n        if len(tag) > 50:\n            return None, \"Tags must be at most 50 characters long.\"\n        if len(tag.split()) > 1:\n            # Tags are single words; join internal whitespace with dashes.\n            tag = re.sub(r\"\\s+\", \"-\", tag)\n        key = tag.lower()\n        if key not in seen:\n            seen.add(key)\n            result.append(tag)\n    if len(result) > 20:\n        return None, \"A note may have at most 20 tags.\"\n    return result, None\n\n\ndef set_tags(db, note_id, tags):\n    db.execute(\"DELETE FROM note_tags WHERE note_id = ?\", (note_id,))\n    for tag in tags:\n        db.execute(\"INSERT OR IGNORE INTO tags(name) VALUES (?)\", (tag,))\n        tag_id = db.execute(\"SELECT id FROM tags WHERE name = ?\", (tag,)).fetchone()[\n            \"id\"\n        ]\n        db.execute(\n            \"INSERT OR IGNORE INTO note_tags(note_id, tag_id) VALUES (?, ?)\",\n            (note_id, tag_id),\n        )\n\n\ndef validate_note_fields(data, partial):\n    \"\"\"Return (fields, error_response) for create/patch payloads.\"\"\"\n    fields = {}\n\n    if not partial or \"title\" in data:\n        title = data.get(\"title\")\n        if not isinstance(title, str) or not title.strip():\n            return None, error(\"Title is required.\", 400, \"title\")\n        title = title.strip()\n        if len(title) > 200:\n            return None, error(\"Title must be at most 200 characters.\", 400, \"title\")\n        fields[\"title\"] = title\n\n    if not partial or \"content\" in data:\n        content = data.get(\"content\")\n        if not isinstance(content, str):\n            return None, error(\"Content is required.\", 400, \"content\")\n        if len(content) > 100_000:\n            return None, error(\"Content is too long.\", 400, \"content\")\n        fields[\"content\"] = content\n\n    if \"tags\" in data or not partial:\n        tags, message = normalize_tags(data.get(\"tags\"))\n        if message:\n            return None, error(message, 400, \"tags\")\n        fields[\"tags\"] = tags\n\n    if \"pinned\" in data:\n        pinned = data.get(\"pinned\")\n        if not isinstance(pinned, bool):\n            return None, error(\"Pinned must be a boolean.\", 400, \"pinned\")\n        fields[\"pinned\"] = pinned\n    elif not partial:\n        fields[\"pinned\"] = False\n\n    return fields, None\n\n\n# ---------------------------------------------------------------------------\n# Auth API\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"A JSON object is required.\")\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required.\", 400, \"username\")\n    username = username.strip()\n    if len(username) > 80:\n        return error(\"Username must be at most 80 characters.\", 400, \"username\")\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required.\", 400, \"password\")\n    if len(password) > 500:\n        return error(\"Password is too long.\", 400, \"password\")\n\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return error(\"That username is already taken.\", 409, \"username\")\n\n    created = now_iso()\n    cur = db.execute(\n        \"INSERT INTO users(username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, hash_password(password), created),\n    )\n    user_id = cur.lastrowid\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens(token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, created),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"A JSON object is required.\")\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required.\")\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if user is None or not verify_password(password, user[\"password_hash\"]):\n        return error(\"Invalid username or password.\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens(token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]})\n\n\n# ---------------------------------------------------------------------------\n# Notes API\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    db = get_db()\n    tag = request.args.get(\"tag\", \"\").strip()\n    author = request.args.get(\"author\", \"\").strip()\n    q = request.args.get(\"q\", \"\").strip()\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        return error(\"page and page_size must be integers.\")\n    if page < 1:\n        return error(\"page must be at least 1.\")\n    if page_size < 1 or page_size > 100:\n        return error(\"page_size must be between 1 and 100.\")\n\n    where = []\n    params = []\n    if tag:\n        where.append(\n            \"EXISTS (SELECT 1 FROM note_tags nt JOIN tags t ON t.id = nt.tag_id \"\n            \"WHERE nt.note_id = n.id AND lower(t.name) = lower(?))\"\n        )\n        params.append(tag)\n    if author:\n        where.append(\"lower(u.username) = lower(?)\")\n        params.append(author)\n    if q:\n        where.append(\"(n.title LIKE ? OR n.content LIKE ?)\")\n        like = f\"%{q}%\"\n        params.extend([like, like])\n\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n    base = (\n        \"FROM notes n JOIN users u ON u.id = n.author_id\" + clause\n    )\n    total = db.execute(\"SELECT COUNT(*) AS c \" + base, params).fetchone()[\"c\"]\n    rows = db.execute(\n        \"SELECT n.*, u.username AS author \"\n        + base\n        + \" ORDER BY n.pinned DESC, n.updated_at DESC, n.id DESC \"\n        + \" LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [serialize_note(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n\n    data = json_body()\n    if data is None:\n        return error(\"A JSON object is required.\")\n    fields, err = validate_note_fields(data, partial=False)\n    if err is not None:\n        return err\n\n    db = get_db()\n    now = now_iso()\n    cur = db.execute(\n        \"INSERT INTO notes(title, content, pinned, author_id, created_at, updated_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            fields[\"title\"],\n            fields[\"content\"],\n            1 if fields[\"pinned\"] else 0,\n            user[\"id\"],\n            now,\n            now,\n        ),\n    )\n    note_id = cur.lastrowid\n    set_tags(db, note_id, fields[\"tags\"])\n    db.commit()\n\n    return jsonify(serialize_note(note_by_id(db, note_id))), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id):\n    row = note_by_id(get_db(), note_id)\n    if row is None:\n        return error(\"Note not found.\", 404)\n    return jsonify(serialize_note(row))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\ndef update_note(note_id):\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n\n    db = get_db()\n    row = note_by_id(db, note_id)\n    if row is None:\n        return error(\"Note not found.\", 404)\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(\"Only the author may edit this note.\", 403)\n\n    data = json_body()\n    if data is None:\n        return error(\"A JSON object is required.\")\n    fields, err = validate_note_fields(data, partial=True)\n    if err is not None:\n        return err\n\n    assignments = []\n    params = []\n    for field in (\"title\", \"content\", \"pinned\"):\n        if field in fields:\n            value = fields[field]\n            if field == \"pinned\":\n                value = 1 if value else 0\n            assignments.append(f\"{field} = ?\")\n            params.append(value)\n    assignments.append(\"updated_at = ?\")\n    params.append(now_iso())\n    params.append(note_id)\n    db.execute(\"UPDATE notes SET \" + \", \".join(assignments) + \" WHERE id = ?\", params)\n\n    if \"tags\" in fields:\n        set_tags(db, note_id, fields[\"tags\"])\n    db.commit()\n\n    return jsonify(serialize_note(note_by_id(db, note_id)))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\ndef delete_note(note_id):\n    user = require_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n\n    db = get_db()\n    row = note_by_id(db, note_id)\n    if row is None:\n        return error(\"Note not found.\", 404)\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(\"Only the author may delete this note.\", 403)\n\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (note_id,))\n    db.execute(\n        \"DELETE FROM tags WHERE id NOT IN (SELECT DISTINCT tag_id FROM note_tags)\"\n    )\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# Tags API\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/tags\")\ndef list_tags():\n    rows = get_db().execute(\n        \"\"\"\n        SELECT t.name AS tag, COUNT(nt.note_id) AS count\n        FROM tags t\n        JOIN note_tags nt ON nt.tag_id = t.id\n        GROUP BY t.id, t.name\n        ORDER BY count DESC, t.name COLLATE NOCASE ASC\n        \"\"\"\n    ).fetchall()\n    return jsonify({\"items\": [{\"tag\": r[\"tag\"], \"count\": r[\"count\"]} for r in rows]})\n\n\n# ---------------------------------------------------------------------------\n# Health and frontend\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return \"Frontend build not found. Run `npm run build` in frontend/.\", 503\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794370412212,"end":1794370412252}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8cf9ea9001JAhASPizw082ql","sessionID":"ses_e3734403fffeP2TzeAjnl49j89","messageID":"msg_1c8ce63e9001tLs3JFzSztGQGT"}}
