es from DB to get 3/3\nimport sqlite3\ndb = sqlite3.connect(mod.DB_PATH)\ncorrect = {r[0]: r[1] for r in db.execute('select id, correct_option from questions')}\na = [{'question_id': x['id'], 'selected': correct[x['id']]} for x in q]\nr1 = c.post('/api/attempts', json={'answers': a}, headers=h).get_json()\nassert r1['score'] == 100 and r1['correct'] == 3, r1\ntime.sleep(0.01)\nr2 = c.post('/api/attempts', json={'answers': a[:2]}, headers=h).get_json()\nitems = c.get('/api/attempts', headers=h).get_json()['items']\nassert [i['id'] for i in items] == [r2['id'], r1['id']], [i['id'] for i in items]\nprint('ordering ok; scores', r1['score'], r2['score'])\nPY\nrm -rf .ord backend/__pycache__","time":{"start":1794303097157,"end":1794303097794}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4cc793e001ax4vIU5P17h7vB","sessionID":"ses_e3b418569ffeuDigYKxcm2a7GO","messageID":"msg_1c4cc411a001I2py3ZrpMLQnBH"}}
