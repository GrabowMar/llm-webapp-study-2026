{"type":"tool_use","timestamp":1794302628364,"sessionID":"ses_e3b418569ffeuDigYKxcm2a7GO","part":{"type":"tool","tool":"write","callID":"call_00_BUF1HdAFiz3ehHivZJj81532","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport type { AttemptAnswerInput, Option, QuizQuestion } from \"../types\";\nimport { OPTION_KEYS, optionText } from \"../types\";\n\ninterface Props {\n  questions: QuizQuestion[];\n  onSubmit: (answers: AttemptAnswerInput[]) => Promise<void>;\n  onCancel: () => void;\n}\n\nexport default function QuizView({ questions, onSubmit, onCancel }: Props) {\n  const [index, setIndex] = useState(0);\n  const [answers, setAnswers] = useState<Record<number, Option>>({});\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const question = questions[index];\n  const total = questions.length;\n  const isLast = index === total - 1;\n  const selected = answers[question.id];\n\n  async function handleNext() {\n    if (!selected) {\n      setError(\"Please choose an answer before continuing.\");\n      return;\n    }\n    setError(null);\n    if (!isLast) {\n      setIndex(index + 1);\n      return;\n    }\n    setBusy(true);\n    try {\n      await onSubmit(\n        questions.map((item) => ({\n          question_id: item.id,\n          selected: answers[item.id],\n        })),\n      );\n    } catch (err) {\n      setError((err as Error).message || \"Could not submit your answers.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const progress = Math.round(((index + 1) / total) * 100);\n\n  return (\n    <div className=\"mx-auto max-w-2xl\">\n      <div className=\"mb-6 flex items-center justify-between\">\n        <span className=\"text-sm font-semibold text-indigo-600\">\n          Question {index + 1} of {total}\n        </span>\n        <button\n          type=\"button\"\n          onClick={onCancel}\n          className=\"text-sm font-medium text-slate-500 transition hover:text-slate-800\"\n        >\n          Quit quiz\n        </button>\n      </div>\n\n      <div className=\"mb-8 h-2 w-full overflow-hidden rounded-full bg-slate-200\">\n        <div\n          className=\"h-full rounded-full bg-indigo-600 transition-all duration-300\"\n          style={{ width: `${progress}%` }}\n        />\n      </div>\n\n      <div className=\"rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8\">\n        <h2 className=\"mb-6 text-xl font-semibold text-slate-900 sm:text-2xl\">\n          {question.text}\n        </h2>\n\n        <div className=\"space-y-3\">\n          {OPTION_KEYS.map((option) => {\n            const isActive = selected === option;\n            return (\n              <label\n                key={option}\n                className={`flex cursor-pointer items-center gap-4 rounded-xl border px-4 py-3 transition ${\n                  isActive\n                    ? \"border-indigo-500 bg-indigo-50 ring-2 ring-indigo-200\"\n                    : \"border-slate-200 bg-white hover:border-indigo-300 hover:bg-slate-50\"\n                }`}\n              >\n                <input\n                  type=\"radio\"\n                  name={`question-${question.id}`}\n                  value={option}\n                  checked={isActive}\n                  onChange={() =>\n                    setAnswers((current) => ({\n                      ...current,\n                      [question.id]: option,\n                    }))\n                  }\n                  className=\"h-4 w-4 accent-indigo-600\"\n                />\n                <span className=\"flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-600\">\n                  {option}\n                </span>\n                <span className=\"text-slate-800\">{optionText(question, option)}</span>\n              </label>\n            );\n          })}\n        </div>\n\n        {error && (\n          <div className=\"mt-5 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">\n            {error}\n          </div>\n        )}\n\n        <div className=\"mt-8 flex items-center justify-between\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setIndex(Math.max(0, index - 1));\n              setError(null);\n            }}\n            disabled={index === 0 || busy}\n            className=\"rounded-lg px-4 py-2 font-medium text-slate-600 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40\"\n          >\n            Back\n          </button>\n          <button\n            type=\"button\"\n            onClick={handleNext}\n            disabled={busy}\n            className=\"rounded-lg bg-indigo-600 px-6 py-2.5 font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60\"\n          >\n            {busy ? \"Submitting…\" : isLast ? \"Submit\" : \"Next\"}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/QuizView.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/QuizView.tsx","exists":false,"truncated":false},"title":"frontend/src/components/QuizView.tsx","time":{"start":1794302628332,"end":1794302628342}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4c551e50017KHfocjFK4Xrze","sessionID":"ses_e3b418569ffeuDigYKxcm2a7GO","messageID":"msg_1c4c528cb001T37wAN55gfb7Fo"}}
