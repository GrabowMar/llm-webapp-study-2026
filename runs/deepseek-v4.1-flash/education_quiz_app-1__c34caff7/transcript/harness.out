{"type":"tool_use","timestamp":1794302617808,"sessionID":"ses_e3b418569ffeuDigYKxcm2a7GO","part":{"type":"tool","tool":"write","callID":"call_00_IZfQ9hr5RAInSUa2eHnd2952","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { api, setToken } from \"../api\";\nimport type { User } from \"../types\";\n\ninterface Props {\n  onAuthenticated: (user: User) => void;\n  onClose: () => void;\n  initialMode?: \"login\" | \"register\";\n}\n\nexport default function AuthModal({\n  onAuthenticated,\n  onClose,\n  initialMode = \"login\",\n}: Props) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(initialMode);\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  async function handleSubmit(event: React.FormEvent) {\n    event.preventDefault();\n    setError(null);\n    setFieldErrors({});\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api(\"/api/auth/register\", {\n          method: \"POST\",\n          auth: false,\n          body: { username, password },\n        });\n      }\n      const { token } = await api<{ token: string }>(\"/api/auth/login\", {\n        method: \"POST\",\n        auth: false,\n        body: { username, password },\n      });\n      setToken(token);\n      const user = await api<User>(\"/api/auth/me\");\n      onAuthenticated(user);\n    } catch (err) {\n      const apiErr = err as {\n        message?: string;\n        errors?: Record<string, string>;\n      };\n      setError(apiErr.message ?? \"Something went wrong.\");\n      setFieldErrors(apiErr.errors ?? {});\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const inputClass =\n    \"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\";\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4\"\n      onClick={onClose}\n    >\n      <div\n        className=\"w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl\"\n        onClick={(event) => event.stopPropagation()}\n      >\n        <div className=\"mb-4 flex items-center justify-between\">\n          <h2 className=\"text-xl font-bold text-slate-900\">\n            {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n          </h2>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700\"\n            aria-label=\"Close\"\n          >\n            <svg\n              className=\"h-5 w-5\"\n              viewBox=\"0 0 20 20\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n            >\n              <path d=\"M5 5l10 10M15 5L5 15\" strokeLinecap=\"round\" />\n            </svg>\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Username\n            </label>\n            <input\n              className={inputClass}\n              value={username}\n              onChange={(event) => setUsername(event.target.value)}\n              autoComplete=\"username\"\n              autoFocus\n            />\n            {fieldErrors.username && (\n              <p className=\"mt-1 text-sm text-rose-600\">{fieldErrors.username}</p>\n            )}\n          </div>\n          <div>\n            <label className=\"mb-1 block text-sm font-medium text-slate-700\">\n              Password\n            </label>\n            <input\n              className={inputClass}\n              type=\"password\"\n              value={password}\n              onChange={(event) => setPassword(event.target.value)}\n              autoComplete={\n                mode === \"login\" ? \"current-password\" : \"new-password\"\n              }\n            />\n            {fieldErrors.password && (\n              <p className=\"mt-1 text-sm text-rose-600\">{fieldErrors.password}</p>\n            )}\n          </div>\n\n          {error && (\n            <div className=\"rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">\n              {error}\n            </div>\n          )}\n\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"w-full rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60\"\n          >\n            {busy\n              ? \"Please wait…\"\n              : mode === \"login\"\n                ? \"Sign in\"\n                : \"Create account\"}\n          </button>\n        </form>\n\n        <p className=\"mt-4 text-center text-sm text-slate-600\">\n          {mode === \"login\" ? \"New here?\" : \"Already have an account?\"}{\" \"}\n          <button\n            type=\"button\"\n            className=\"font-semibold text-indigo-600 hover:text-indigo-700\"\n            onClick={() => {\n              setMode(mode === \"login\" ? \"register\" : \"login\");\n              setError(null);\n              setFieldErrors({});\n            }}\n          >\n            {mode === \"login\" ? \"Create an account\" : \"Sign in\"}\n          </button>\n        </p>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AuthModal.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AuthModal.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AuthModal.tsx","time":{"start":1794302617783,"end":1794302617791}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4c528b1001PXJ0cua7TFl9Hv","sessionID":"ses_e3b418569ffeuDigYKxcm2a7GO","messageID":"msg_1c4c507e7001L2PNj0HXKf8McJ"}}
