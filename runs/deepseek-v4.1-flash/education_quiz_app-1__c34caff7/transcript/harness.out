h/register', json={'username':'x','password':'y'}).status_code == 201\nt = c.post('/api/auth/login', json={'username':'x','password':'y'}).get_json()['token']\nh = {'Authorization': f'Bearer {t}'}\nr = c.post('/api/attempts', json={'answers':[{'question_id':qs[0]['id'],'selected':'A'}]}, headers=h).get_json()\nassert r['id'] is not None and r['total_questions'] == 1\nassert c.get('/api/attempts', headers=h).get_json()['items'][0]['id'] == r['id']\nprint('smoke ok', r['score'], r['correct'])\nPY\nrm -rf /workspace/.smoke /workspace/backend/__pycache__","time":{"start":1794302939997,"end":1794302940577}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4ca1356001vE22CkvCehUIPl","sessionID":"ses_e3b418569ffeuDigYKxcm2a7GO","messageID":"msg_1c4c9efa8001Yj9dzzZtIK3SSl"}}
