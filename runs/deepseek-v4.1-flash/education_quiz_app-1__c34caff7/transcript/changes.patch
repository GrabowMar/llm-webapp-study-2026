+            </div>
+            <AdminView refreshKey={historyRefresh} />
+          </div>
+        )}
+      </main>
+
+      {authOpen && (
+        <AuthModal
+          initialMode={authMode}
+          onClose={() => setAuthOpen(false)}
+          onAuthenticated={handleAuthenticated}
+        />
+      )}
+    </div>
+  );
 }
