@@ -0,0 +1,140 @@
+import { useState } from "react";
+import type { AttemptAnswerInput, Option, QuizQuestion } from "../types";
+import { OPTION_KEYS, optionText } from "../types";
+
+interface Props {
+  questions: QuizQuestion[];
+  onSubmit: (answers: AttemptAnswerInput[]) => Promise<void>;
+  onCancel: () => void;
+}
+
+export default function QuizView({ questions, onSubmit, onCancel }: Props) {
+  const [index, setIndex] = useState(0);
+  const [answers, setAnswers] = useState<Record<number, Option>>({});
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const question = questions[index];
+  const total = questions.length;
+  const isLast = index === total - 1;
+  const selected = answers[question.id];
+
+  async function handleNext() {
+    if (!selected) {
+      setError("Please choose an answer before continuing.");
+      return;
+    }
+    setError(null);
+    if (!isLast) {
+      setIndex(index + 1);
+      return;
+    }
+    setBusy(true);
+    try {
+      await onSubmit(
+        questions.map((item) => ({
+          question_id: item.id,
+          selected: answers[item.id],
+        })),
+      );
+    } catch (err) {
+      setError((err as Error).message || "Could not submit your answers.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const progress = Math.round(((index + 1) / total) * 100);
+
+  return (
+    <div className="mx-auto max-w-2xl">
+      <div className="mb-6 flex items-center justify-between">
+        <span className="text-sm font-semibold text-indigo-600">
+          Question {index + 1} of {total}
+        </span>
+        <button
+          type="button"
+          onClick={onCancel}
+          className="text-sm font-medium text-slate-500 transition hover:text-slate-800"
+        >
+          Quit quiz
+        </button>
+      </div>
+
+      <div className="mb-8 h-2 w-full overflow-hidden rounded-full bg-slate-200">
+        <div
+          className="h-full rounded-full bg-indigo-600 transition-all duration-300"
+          style={{ width: `${progress}%` }}
+        />
+      </div>
+
+      <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
+        <h2 className="mb-6 text-xl font-semibold text-slate-900 sm:text-2xl">
+          {question.text}
+        </h2>
+
+        <div className="space-y-3">
+          {OPTION_KEYS.map((option) => {
+            const isActive = selected === option;
+            return (
+              <label
+                key={option}
+                className={`flex cursor-pointer items-center gap-4 rounded-xl border px-4 py-3 transition ${
+                  isActive
+                    ? "border-indigo-500 bg-indigo-50 ring-2 ring-indigo-200"
+                    : "border-slate-200 bg-white hover:border-indigo-300 hover:bg-slate-50"
+                }`}
+              >
+                <input
+                  type="radio"
+                  name={`question-${question.id}`}
+                  value={option}
+                  checked={isActive}
+                  onChange={() =>
+                    setAnswers((current) => ({
+                      ...current,
+                      [question.id]: option,
+                    }))
+                  }
+                  className="h-4 w-4 accent-indigo-600"
+                />
+                <span className="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-600">
+                  {option}
+                </span>
+                <span className="text-slate-800">{optionText(question, option)}</span>
+              </label>
+            );
+          })}
+        </div>
+
+        {error && (
+          <div className="mt-5 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">
+            {error}
+          </div>
+        )}
+
+        <div className="mt-8 flex items-center justify-between">
+          <button
+            type="button"
+            onClick={() => {
+              setIndex(Math.max(0, index - 1));
+              setError(null);
+            }}
+            disabled={index === 0 || busy}
+            className="rounded-lg px-4 py-2 font-medium text-slate-600 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            Back
+          </button>
+          <button
+            type="button"
+            onClick={handleNext}
+            disabled={busy}
+            className="rounded-lg bg-indigo-600 px-6 py-2.5 font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60"
+          >
+            {busy ? "Submitting…" : isLast ? "Submit" : "Next"}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/ResultView.tsx b/frontend/src/components/ResultView.tsx
new file mode 100644
index 0000000..e7e8082
--- /dev/null
+++ b/frontend/src/components/ResultView.tsx
@@ -0,0 +1,127 @@
+import type { Attempt } from "../types";
+import { OPTION_KEYS, optionText } from "../types";
+
+interface Props {
+  attempt: Attempt;
+  isGuest: boolean;
+  signedIn: boolean;
+  onSignIn: () => void;
+  onRestart: () => void;
+  title?: string;
+}
+
+export default function ResultView({
+  attempt,
+  isGuest,
+  signedIn,
+  onSignIn,
+  onRestart,
+  title = "Your result",
+}: Props) {
+  return (
+    <div className="mx-auto max-w-3xl">
+      <div className="mb-8 rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 p-8 text-white shadow-lg">
+        <div className="flex flex-wrap items-end justify-between gap-4">
+          <div>
+            <p className="text-sm font-medium uppercase tracking-wide text-indigo-200">
+              {title}
+            </p>
+            <p className="mt-2 text-5xl font-extrabold">{attempt.score}%</p>
+            <p className="mt-1 text-indigo-100">
+              {attempt.correct} of {attempt.total_questions} correct
+            </p>
+          </div>
+          <button
+            type="button"
+            onClick={onRestart}
+            className="rounded-lg bg-white/15 px-5 py-2.5 font-semibold text-white backdrop-blur transition hover:bg-white/25"
+          >
+            Take another quiz
+          </button>
+        </div>
+      </div>
+
+      {isGuest && !signedIn && (
+        <div className="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4">
+          <p className="font-medium text-amber-900">
+            Sign in to save your results
+          </p>
+          <button
+            type="button"
+            onClick={onSignIn}
+            className="rounded-lg bg-amber-500 px-4 py-2 font-semibold text-white transition hover:bg-amber-600"
+          >
+            Sign in
+          </button>
+        </div>
+      )}
+      {isGuest && signedIn && (
+        <div className="mb-8 rounded-2xl border border-slate-200 bg-white px-5 py-4 text-sm text-slate-600">
+          This result was played as a visitor, so it wasn't saved. Take another
+          quiz while signed in to keep it in your history.
+        </div>
+      )}
+
+      <div className="space-y-4">
+        {attempt.answers.map((answer, index) => (
+          <div
+            key={`${answer.question_id}-${index}`}
+            className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
+          >
+            <div className="mb-4 flex items-start gap-3">
+              <span
+                className={`mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white ${
+                  answer.is_correct ? "bg-emerald-500" : "bg-rose-500"
+                }`}
+              >
+                {answer.is_correct ? "✓" : "✕"}
+              </span>
+              <h3 className="font-semibold text-slate-900">
+                {index + 1}. {answer.text}
+              </h3>
+            </div>
+
+            <ul className="space-y-2">
+              {OPTION_KEYS.map((option) => {
+                const isChosen = answer.selected === option;
+                const isCorrect = answer.correct_option === option;
+                let classes =
+                  "flex items-center gap-3 rounded-lg border px-3 py-2 text-sm";
+                if (isCorrect) {
+                  classes += " border-emerald-300 bg-emerald-50 text-emerald-900";
+                } else if (isChosen) {
+                  classes += " border-rose-300 bg-rose-50 text-rose-900";
+                } else {
+                  classes += " border-slate-200 bg-white text-slate-600";
+                }
+                return (
+                  <li key={option} className={classes}>
+                    <span className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white text-xs font-bold text-slate-600 shadow-sm">
+                      {option}
+                    </span>
+                    <span className="flex-1">{optionText(answer, option)}</span>
+                    {isChosen && (
+                      <span className="text-xs font-semibold uppercase tracking-wide">
+                        Your answer
+                      </span>
+                    )}
+                    {isCorrect && !isChosen && (
+                      <span className="text-xs font-semibold uppercase tracking-wide">
+                        Correct
+                      </span>
+                    )}
+                    {isCorrect && isChosen && (
+                      <span className="text-xs font-semibold uppercase tracking-wide">
+                        Correct
+                      </span>
+                    )}
+                  </li>
+                );
+              })}
+            </ul>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
