{"type":"tool_use","timestamp":1794347991011,"sessionID":"ses_e388b8a4effe7FoUEQZCymnuBR","part":{"type":"tool","tool":"write","callID":"call_82b2c6e1599e44bab62eeb16","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask application: notification center API and frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport hmac\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"notifications.db\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\nADMIN_USERNAME = \"admin\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        connection = sqlite3.connect(DB_PATH, timeout=30)\n        connection.row_factory = sqlite3.Row\n        connection.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = connection\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(exception: BaseException | None = None) -> None:\n    connection = g.pop(\"db\", None)\n    if connection is not None:\n        connection.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    connection = sqlite3.connect(DB_PATH, timeout=30)\n    connection.row_factory = sqlite3.Row\n    try:\n        connection.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL,\n                created_at TEXT NOT NULL,\n                FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n            );\n\n            CREATE TABLE IF NOT EXISTS notifications (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL,\n                message TEXT NOT NULL,\n                type TEXT NOT NULL,\n                read INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_notifications_user\n                ON notifications (user_id, created_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens (user_id);\n            \"\"\"\n        )\n        admin = connection.execute(\n            \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n        ).fetchone()\n        if admin is None:\n            connection.execute(\n                \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n                \" VALUES (?, NULL, 1, ?)\",\n                (ADMIN_USERNAME, now_iso()),\n            )\n        else:\n            connection.execute(\n                \"UPDATE users SET is_admin = 1 WHERE id = ?\", (admin[\"id\"],)\n            )\n        connection.commit()\n    finally:\n        connection.close()\n\n\ndef json_error(message: str, status: int = 400):\n    return jsonify({\"error\": message}), status\n\n\ndef serialize_user(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"username\": row[\"username\"],\n        \"is_admin\": bool(row[\"is_admin\"]),\n    }\n\n\ndef serialize_notification(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, value = header.partition(\" \")\n    if scheme.lower() != \"bearer\":\n        return None\n    token = value.strip()\n    return token or None\n\n\ndef resolve_user() -> sqlite3.Row | None:\n    token = bearer_token()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT users.* FROM tokens JOIN users ON users.id = tokens.user_id\"\n        \" WHERE tokens.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef auth_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        user = resolve_user()\n        if user is None:\n            return json_error(\"Unauthorized\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    @auth_required\n    def wrapped(*args: Any, **kwargs: Any):\n        if not g.user[\"is_admin\"]:\n            return json_error(\"Forbidden\", 403)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, now_iso()),\n    )\n    db.commit()\n    return token\n\n\ndef body_json() -> dict[str, Any]:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef notification_payload() -> tuple[str, str] | None:\n    data = body_json()\n    message = data.get(\"message\")\n    type_value = data.get(\"type\", \"info\")\n    if not isinstance(message, str) or not message.strip():\n        return None\n    if not isinstance(type_value, str) or not type_value.strip():\n        type_value = \"info\"\n    return message, type_value.strip()\n\n\ndef parse_bool(value: Any) -> bool | None:\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    if isinstance(value, str):\n        lowered = value.strip().lower()\n        if lowered in (\"true\", \"1\", \"read\"):\n            return True\n        if lowered in (\"false\", \"0\", \"unread\"):\n            return False\n    return None\n\n\ndef parse_positive_int(value: Any, default: int, maximum: int | None = None) -> int:\n    try:\n        number = int(value)\n    except (TypeError, ValueError):\n        return default\n    if number < 1:\n        return default\n    if maximum is not None and number > maximum:\n        return maximum\n    return number\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body_json()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return json_error(\"username is required\")\n    if not isinstance(password, str) or not password:\n        return json_error(\"password is required\")\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        return json_error(\"username is not available\", 409)\n\n    db = get_db()\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n            \" VALUES (?, ?, 0, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return json_error(\"username is already taken\", 409)\n\n    row = db.execute(\"SELECT * FROM users WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(serialize_user(row)), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body_json()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"username and password are required\")\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n\n    if row is not None and row[\"is_admin\"]:\n        if not ADMIN_PASSWORD or not hmac.compare_digest(password, ADMIN_PASSWORD):\n            return json_error(\"Invalid credentials\", 401)\n    else:\n        if row is None or not row[\"password_hash\"]:\n            return json_error(\"Invalid credentials\", 401)\n        if not check_password_hash(row[\"password_hash\"], password):\n            return json_error(\"Invalid credentials\", 401)\n\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\n@app.get(\"/api/auth/me\")\n@auth_required\ndef me():\n    return jsonify(serialize_user(g.user))\n\n\n@app.get(\"/api/notifications\")\n@auth_required\ndef list_notifications():\n    db = get_db()\n    user_id = g.user[\"id\"]\n\n    clauses = [\"user_id = ?\"]\n    params: list[Any] = [user_id]\n\n    read_filter = request.args.get(\"read\")\n    if read_filter is not None and read_filter.strip() != \"\":\n        parsed = parse_bool(read_filter)\n        if parsed is not None:\n            clauses.append(\"read = ?\")\n            params.append(1 if parsed else 0)\n\n    type_filter = request.args.get(\"type\")\n    if type_filter is not None and type_filter.strip() != \"\":\n        clauses.append(\"type = ?\")\n        params.append(type_filter.strip())\n\n    where = \" WHERE \" + \" AND \".join(clauses)\n    page = parse_positive_int(request.args.get(\"page\"), 1)\n    page_size = parse_positive_int(request.args.get(\"page_size\"), 20, 100)\n    offset = (page - 1) * page_size\n\n    total = db.execute(\n        \"SELECT COUNT(*) AS count FROM notifications\" + where, params\n    ).fetchone()[\"count\"]\n    rows = db.execute(\n        \"SELECT * FROM notifications\"\n        + where\n        + \" ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, offset],\n    ).fetchall()\n    unread_count = db.execute(\n        \"SELECT COUNT(*) AS count FROM notifications WHERE user_id = ? AND read = 0\",\n        (user_id,),\n    ).fetchone()[\"count\"]\n\n    return jsonify(\n        {\n            \"items\": [serialize_notification(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread_count,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@auth_required\ndef create_notification():\n    payload = notification_payload()\n    if payload is None:\n        return json_error(\"message is required\")\n    message, type_value = payload\n\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at)\"\n        \" VALUES (?, ?, ?, 0, ?)\",\n        (g.user[\"id\"], message, type_value, now_iso()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(serialize_notification(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@auth_required\ndef read_all():\n    db = get_db()\n    cursor = db.execute(\n        \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\",\n        (g.user[\"id\"],),\n    )\n    db.commit()\n    return jsonify({\"updated\": cursor.rowcount})\n\n\n@app.get(\"/api/notifications/<int:notification_id>\")\n@auth_required\ndef get_notification(notification_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return json_error(\"Not found\", 404)\n    return jsonify(serialize_notification(row))\n\n\n@app.patch(\"/api/notifications/<int:notification_id>\")\n@auth_required\ndef update_notification(notification_id: int):\n    data = body_json()\n    if \"read\" not in data:\n        return json_error(\"read is required\")\n    read = parse_bool(data.get(\"read\"))\n    if read is None:\n        return json_error(\"read must be a boolean\")\n\n    db = get_db()\n    cursor = db.execute(\n        \"UPDATE notifications SET read = ? WHERE id = ? AND user_id = ?\",\n        (1 if read else 0, notification_id, g.user[\"id\"]),\n    )\n    if cursor.rowcount == 0:\n        db.rollback()\n        return json_error(\"Not found\", 404)\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM notifications WHERE id = ?\", (notification_id,)\n    ).fetchone()\n    return jsonify(serialize_notification(row))\n\n\n@app.delete(\"/api/notifications/<int:notification_id>\")\n@auth_required\ndef delete_notification(notification_id: int):\n    db = get_db()\n    cursor = db.execute(\n        \"DELETE FROM notifications WHERE id = ? AND user_id = ?\",\n        (notification_id, g.user[\"id\"]),\n    )\n    if cursor.rowcount == 0:\n        db.rollback()\n        return json_error(\"Not found\", 404)\n    db.commit()\n    return jsonify({\"deleted\": True, \"id\": notification_id})\n\n\n@app.post(\"/api/admin/broadcast\")\n@admin_required\ndef broadcast():\n    payload = notification_payload()\n    if payload is None:\n        return json_error(\"message is required\")\n    message, type_value = payload\n\n    db = get_db()\n    users = db.execute(\"SELECT id FROM users\").fetchall()\n    created_at = now_iso()\n    db.executemany(\n        \"INSERT INTO notifications (user_id, message, type, read, created_at)\"\n        \" VALUES (?, ?, ?, 0, ?)\",\n        [(user[\"id\"], message, type_value, created_at) for user in users],\n    )\n    db.commit()\n    return jsonify({\"delivered\": len(users)})\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path == \"api\":\n        return json_error(\"Not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794347990916,"end":1794347990945}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7797f79001CGJ0XbAloElC0U","sessionID":"ses_e388b8a4effe7FoUEQZCymnuBR","messageID":"msg_1c7788035001DY2Zz1UpnshHrO"}}
