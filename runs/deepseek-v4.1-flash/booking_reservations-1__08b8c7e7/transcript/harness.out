{"type":"tool_use","timestamp":1794323272546,"sessionID":"ses_e3a013904ffelr9NSWjQE3rzm2","part":{"type":"tool","tool":"write","callID":"call_00_d5mn7u48y7aakhy4xzfxjw06","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask API and frontend host for the table reservation app.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import date as date_cls\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"reservations.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or None\n\nSLOT_CAPACITY = 20\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\nTIME_RE = re.compile(r\"^([01]\\d|2[0-3]):[0-5]\\d$\")\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS reservations (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                name TEXT NOT NULL,\n                email TEXT NOT NULL,\n                date TEXT NOT NULL,\n                time TEXT NOT NULL,\n                party_size INTEGER NOT NULL,\n                notes TEXT,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_reservations_slot\n                ON reservations (date, time);\n            CREATE INDEX IF NOT EXISTS idx_reservations_user\n                ON reservations (user_id, date, time);\n            \"\"\"\n        )\n        conn.execute(\n            \"INSERT OR IGNORE INTO users (username, password_hash, created_at) \"\n            \"VALUES (?, ?, ?)\",\n            (ADMIN_USERNAME, \"!\", now_iso()),\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef body() -> dict[str, Any]:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef clean_text(value: Any) -> str | None:\n    if not isinstance(value, str):\n        return None\n    value = value.strip()\n    return value or None\n\n\ndef parse_date(value: Any) -> str | None:\n    if not isinstance(value, str) or not DATE_RE.match(value):\n        return None\n    try:\n        return date_cls.fromisoformat(value).isoformat()\n    except ValueError:\n        return None\n\n\ndef parse_time(value: Any) -> str | None:\n    if not isinstance(value, str) or not TIME_RE.match(value):\n        return None\n    return value\n\n\ndef parse_party_size(value: Any) -> int | None:\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, int):\n        return value if value > 0 else None\n    if isinstance(value, str) and value.strip().isdigit():\n        number = int(value.strip())\n        return number if number > 0 else None\n    return None\n\n\ndef parse_positive_int(value: Any, default: int, maximum: int | None = None) -> int | None:\n    if value is None or value == \"\":\n        return default\n    if isinstance(value, bool):\n        return None\n    try:\n        number = int(value)\n    except (TypeError, ValueError):\n        return None\n    if number < 1:\n        return None\n    if maximum is not None and number > maximum:\n        return None\n    return number\n\n\ndef query_date(name: str = \"date\") -> tuple[str | None, Any]:\n    \"\"\"Return (date, error_response) for an optional date query parameter.\"\"\"\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return None, None\n    parsed = parse_date(raw)\n    if parsed is None:\n        return None, error(\"Invalid date. Expected YYYY-MM-DD.\", 400)\n    return parsed, None\n\n\ndef reservation_json(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"email\": row[\"email\"],\n        \"date\": row[\"date\"],\n        \"time\": row[\"time\"],\n        \"party_size\": row[\"party_size\"],\n        \"notes\": row[\"notes\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    conn = connect()\n    try:\n        return conn.execute(\n            \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id \"\n            \"WHERE s.token = ?\",\n            (token,),\n        ).fetchone()\n    finally:\n        conn.close()\n\n\ndef login_required(view: Callable):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required.\", 401)\n        request.user = user  # type: ignore[attr-defined]\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view: Callable):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required.\", 401)\n        if user[\"username\"] != ADMIN_USERNAME:\n            return error(\"Admin access required.\", 403)\n        request.user = user  # type: ignore[attr-defined]\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef validate_reservation(data: dict[str, Any]) -> tuple[dict[str, Any] | None, Any]:\n    name = clean_text(data.get(\"name\"))\n    email = clean_text(data.get(\"email\"))\n    date_value = parse_date(data.get(\"date\"))\n    time_value = parse_time(data.get(\"time\"))\n    party_size = parse_party_size(data.get(\"party_size\"))\n\n    notes_raw = data.get(\"notes\")\n    if notes_raw is not None and not isinstance(notes_raw, str):\n        return None, error(\"Notes must be text.\", 400)\n    notes = clean_text(notes_raw) if notes_raw is not None else None\n\n    if name is None:\n        return None, error(\"Name is required.\", 400)\n    if email is None:\n        return None, error(\"Email is required.\", 400)\n    if date_value is None:\n        return None, error(\"A valid date is required (YYYY-MM-DD).\", 400)\n    if time_value is None:\n        return None, error(\"A valid time is required (HH:MM).\", 400)\n    if party_size is None:\n        return None, error(\"Party size must be a positive whole number.\", 400)\n\n    return {\n        \"name\": name,\n        \"email\": email,\n        \"date\": date_value,\n        \"time\": time_value,\n        \"party_size\": party_size,\n        \"notes\": notes,\n    }, None\n\n\ndef capacity_message(booked: int, party_size: int) -> str:\n    remaining = SLOT_CAPACITY - booked\n    if remaining <= 0:\n        return \"This time slot is full.\"\n    return f\"Only {remaining} seats remain in this time slot.\"\n\n\n# ---------------------------------------------------------------------------\n# Auth\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = clean_text(data.get(\"username\"))\n    password = data.get(\"password\")\n\n    if username is None:\n        return error(\"Username is required.\", 400)\n    if not isinstance(password, str) or password == \"\":\n        return error(\"Password is required.\", 400)\n    if username.lower() == ADMIN_USERNAME:\n        return error(\"That username is not available.\", 409)\n\n    conn = connect()\n    try:\n        existing = conn.execute(\n            \"SELECT id FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n        if existing is not None:\n            return error(\"That username is already taken.\", 409)\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        conn.commit()\n        return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n    except sqlite3.IntegrityError:\n        return error(\"That username is already taken.\", 409)\n    finally:\n        conn.close()\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = clean_text(data.get(\"username\"))\n    password = data.get(\"password\")\n\n    if username is None or not isinstance(password, str) or password == \"\":\n        return error(\"Invalid username or password.\", 401)\n\n    conn = connect()\n    try:\n        if username == ADMIN_USERNAME:\n            if ADMIN_PASSWORD is None or not secrets.compare_digest(\n                password, ADMIN_PASSWORD\n            ):\n                return error(\"Invalid username or password.\", 401)\n            user = conn.execute(\n                \"SELECT * FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n        else:\n            user = conn.execute(\n                \"SELECT * FROM users WHERE username = ?\", (username,)\n            ).fetchone()\n            if user is None or not check_password_hash(\n                user[\"password_hash\"], password\n            ):\n                return error(\"Invalid username or password.\", 401)\n\n        if user is None:\n            return error(\"Invalid username or password.\", 401)\n\n        token = secrets.token_urlsafe(32)\n        conn.execute(\n            \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n            (token, user[\"id\"], now_iso()),\n        )\n        conn.commit()\n        return jsonify({\"token\": token})\n    finally:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Reservations\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/reservations\")\n@login_required\ndef create_reservation():\n    data, validation_error = validate_reservation(body())\n    if validation_error is not None:\n        return validation_error\n\n    user_id = request.user[\"id\"]  # type: ignore[attr-defined]\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        booked = conn.execute(\n            \"SELECT COALESCE(SUM(party_size), 0) AS total FROM reservations \"\n            \"WHERE date = ? AND time = ?\",\n            (data[\"date\"], data[\"time\"]),\n        ).fetchone()[\"total\"]\n        if booked + data[\"party_size\"] > SLOT_CAPACITY:\n            conn.rollback()\n            return error(capacity_message(booked, data[\"party_size\"]), 409)\n\n        cur = conn.execute(\n            \"INSERT INTO reservations \"\n            \"(user_id, name, email, date, time, party_size, notes, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (\n                user_id,\n                data[\"name\"],\n                data[\"email\"],\n                data[\"date\"],\n                data[\"time\"],\n                data[\"party_size\"],\n                data[\"notes\"],\n                now_iso(),\n            ),\n        )\n        row = conn.execute(\n            \"SELECT * FROM reservations WHERE id = ?\", (cur.lastrowid,)\n        ).fetchone()\n        conn.commit()\n        return jsonify(reservation_json(row)), 201\n    except Exception:\n        conn.rollback()\n        raise\n    finally:\n        conn.close()\n\n\n@app.get(\"/api/reservations\")\n@login_required\ndef list_reservations():\n    date_value, date_error = query_date()\n    if date_error is not None:\n        return date_error\n\n    user_id = request.user[\"id\"]  # type: ignore[attr-defined]\n    conn = connect()\n    try:\n        if date_value is None:\n            rows = conn.execute(\n                \"SELECT * FROM reservations WHERE user_id = ? \"\n                \"ORDER BY date, time, created_at, id\",\n                (user_id,),\n            ).fetchall()\n        else:\n            rows = conn.execute(\n                \"SELECT * FROM reservations WHERE user_id = ? AND date = ? \"\n                \"ORDER BY date, time, created_at, id\",\n                (user_id, date_value),\n            ).fetchall()\n        items = [reservation_json(row) for row in rows]\n        return jsonify({\"items\": items, \"total\": len(items)})\n    finally:\n        conn.close()\n\n\n@app.get(\"/api/reservations/<int:reservation_id>\")\n@login_required\ndef get_reservation(reservation_id: int):\n    user_id = request.user[\"id\"]  # type: ignore[attr-defined]\n    conn = connect()\n    try:\n        row = conn.execute(\n            \"SELECT * FROM reservations WHERE id = ? AND user_id = ?\",\n            (reservation_id, user_id),\n        ).fetchone()\n        if row is None:\n            return error(\"Reservation not found.\", 404)\n        return jsonify(reservation_json(row))\n    finally:\n        conn.close()\n\n\n@app.put(\"/api/reservations/<int:reservation_id>\")\n@login_required\ndef replace_reservation(reservation_id: int):\n    data, validation_error = validate_reservation(body())\n    if validation_error is not None:\n        return validation_error\n\n    user_id = request.user[\"id\"]  # type: ignore[attr-defined]\n    conn = connect()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        existing = conn.execute(\n            \"SELECT * FROM reservations WHERE id = ? AND user_id = ?\",\n            (reservation_id, user_id),\n        ).fetchone()\n        if existing is None:\n            conn.rollback()\n            return error(\"Reservation not found.\", 404)\n\n        booked = conn.execute(\n            \"SELECT COALESCE(SUM(party_size), 0) AS total FROM reservations \"\n            \"WHERE date = ? AND time = ? AND id <> ?\",\n            (data[\"date\"], data[\"time\"], reservation_id),\n        ).fetchone()[\"total\"]\n        if booked + data[\"party_size\"] > SLOT_CAPACITY:\n            conn.rollback()\n            return error(capacity_message(booked, data[\"party_size\"]), 409)\n\n        conn.execute(\n            \"UPDATE reservations SET name = ?, email = ?, date = ?, time = ?, \"\n            \"party_size = ?, notes = ? WHERE id = ?\",\n            (\n                data[\"name\"],\n                data[\"email\"],\n                data[\"date\"],\n                data[\"time\"],\n                data[\"party_size\"],\n                data[\"notes\"],\n                reservation_id,\n            ),\n        )\n        row = conn.execute(\n            \"SELECT * FROM reservations WHERE id = ?\", (reservation_id,)\n        ).fetchone()\n        conn.commit()\n        return jsonify(reservation_json(row))\n    except Exception:\n        conn.rollback()\n        raise\n    finally:\n        conn.close()\n\n\n@app.delete(\"/api/reservations/<int:reservation_id>\")\n@login_required\ndef delete_reservation(reservation_id: int):\n    user_id = request.user[\"id\"]  # type: ignore[attr-defined]\n    conn = connect()\n    try:\n        cur = conn.execute(\n            \"DELETE FROM reservations WHERE id = ? AND user_id = ?\",\n            (reservation_id, user_id),\n        )\n        conn.commit()\n        if cur.rowcount == 0:\n            return error(\"Reservation not found.\", 404)\n        return \"\", 204\n    finally:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Availability and admin\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/availability\")\ndef availability():\n    raw = request.args.get(\"date\")\n    if raw is None or raw == \"\":\n        return error(\"A date is required (YYYY-MM-DD).\", 400)\n    date_value = parse_date(raw)\n    if date_value is None:\n        return error(\"Invalid date. Expected YYYY-MM-DD.\", 400)\n\n    conn = connect()\n    try:\n        rows = conn.execute(\n            \"SELECT time, COALESCE(SUM(party_size), 0) AS booked \"\n            \"FROM reservations WHERE date = ? GROUP BY time ORDER BY time\",\n            (date_value,),\n        ).fetchall()\n        items = [\n            {\n                \"time\": row[\"time\"],\n                \"booked\": row[\"booked\"],\n                \"remaining\": SLOT_CAPACITY - row[\"booked\"],\n            }\n            for row in rows\n        ]\n        return jsonify({\"items\": items})\n    finally:\n        conn.close()\n\n\n@app.get(\"/api/admin/reservations\")\n@admin_required\ndef admin_reservations():\n    date_value, date_error = query_date()\n    if date_error is not None:\n        return date_error\n\n    page = parse_positive_int(request.args.get(\"page\"), 1)\n    page_size = parse_positive_int(request.args.get(\"page_size\"), 20, maximum=1000)\n    if page is None:\n        return error(\"Page must be a positive whole number.\", 400)\n    if page_size is None:\n        return error(\"Page size must be between 1 and 1000.\", 400)\n\n    where = \"\"\n    params: list[Any] = []\n    if date_value is not None:\n        where = \" WHERE date = ?\"\n        params.append(date_value)\n\n    conn = connect()\n    try:\n        total = conn.execute(\n            f\"SELECT COUNT(*) AS count FROM reservations{where}\", params\n        ).fetchone()[\"count\"]\n        rows = conn.execute(\n            f\"SELECT * FROM reservations{where} \"\n            \"ORDER BY date, time, created_at, id LIMIT ? OFFSET ?\",\n            [*params, page_size, (page - 1) * page_size],\n        ).fetchall()\n        return jsonify(\n            {\n                \"items\": [reservation_json(row) for row in rows],\n                \"total\": total,\n                \"page\": page,\n                \"page_size\": page_size,\n            }\n        )\n    finally:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Static frontend and health\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    target = DIST / path\n    if target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794323272451,"end":1794323272503}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c60052fa001PG8OMDObsUgny2","sessionID":"ses_e3a013904ffelr9NSWjQE3rzm2","messageID":"msg_1c5ff225c001gLD4M978MnU8Lh"}}
