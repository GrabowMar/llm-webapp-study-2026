-"""Flask entry point."""
+"""Audio library API and frontend host."""
 
+from __future__ import annotations
+
+import math
+import os
+import re
+import secrets
+import sqlite3
+from datetime import datetime, timezone
 from pathlib import Path
+from urllib.parse import urlparse
 
-from flask import Flask
