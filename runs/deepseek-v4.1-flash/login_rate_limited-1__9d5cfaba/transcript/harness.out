{"type":"tool_use","timestamp":1794327615714,"sessionID":"ses_e39c0874fffefk6JJfDw1Lex68","part":{"type":"tool","tool":"write","callID":"call_00_mnqr8jv3i2gqy7hrb31tv58n","state":{"status":"completed","input":{"content":"export type LoginAttempt = { at: string; success: boolean };\nexport type Account = {\n  id: number;\n  username: string;\n  last_login_at: string | null;\n};\nexport type Lock = { username: string; locked_until: string };\n\nexport class ApiError extends Error {\n  status: number;\n  code: string | null;\n  retryAfter: number | null;\n\n  constructor(\n    message: string,\n    status: number,\n    code: string | null,\n    retryAfter: number | null,\n  ) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n    this.code = code;\n    this.retryAfter = retryAfter;\n  }\n}\n\nlet authToken: string | null = localStorage.getItem(\"token\");\n\nexport function getToken(): string | null {\n  return authToken;\n}\n\nexport function setToken(token: string | null): void {\n  authToken = token;\n  if (token) {\n    localStorage.setItem(\"token\", token);\n  } else {\n    localStorage.removeItem(\"token\");\n  }\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit & { body?: unknown } = {},\n): Promise<T> {\n  const headers = new Headers(options.headers);\n  headers.set(\"Accept\", \"application/json\");\n  if (options.body !== undefined) {\n    headers.set(\"Content-Type\", \"application/json\");\n  }\n  if (authToken) {\n    headers.set(\"Authorization\", `Bearer ${authToken}`);\n  }\n\n  let response: Response;\n  try {\n    response = await fetch(path, {\n      ...options,\n      headers,\n      body:\n        options.body !== undefined ? JSON.stringify(options.body) : undefined,\n    });\n  } catch {\n    throw new ApiError(\"Could not reach the server.\", 0, null, null);\n  }\n\n  const retryHeader = response.headers.get(\"Retry-After\");\n  const retryAfter = retryHeader ? Number.parseInt(retryHeader, 10) : null;\n\n  let payload: unknown = null;\n  const text = await response.text();\n  if (text) {\n    try {\n      payload = JSON.parse(text);\n    } catch {\n      payload = null;\n    }\n  }\n\n  if (!response.ok) {\n    const data = (payload ?? {}) as { error?: string; code?: string };\n    throw new ApiError(\n      data.error || `Request failed (${response.status})`,\n      response.status,\n      data.code ?? null,\n      Number.isFinite(retryAfter) ? retryAfter : null,\n    );\n  }\n\n  return payload as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ id: number; username: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: { username, password },\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: { username, password },\n  });\n}\n\nexport function logout() {\n  setToken(null);\n}\n\nexport function fetchMe() {\n  return request<Account>(\"/api/me\");\n}\n\nexport function fetchAttempts() {\n  return request<{ items: LoginAttempt[] }>(\"/api/me/login-attempts\");\n}\n\nexport function fetchLocks() {\n  return request<{ items: Lock[] }>(\"/api/admin/locks\");\n}\n\nexport function unlockUser(username: string) {\n  return request<{ status: string; username: string }>(\n    `/api/admin/locks/${encodeURIComponent(username)}/unlock`,\n    { method: \"POST\" },\n  );\n}\n\nexport function formatDate(value: string | null): string {\n  if (!value) return \"Never\";\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return value;\n  return date.toLocaleString();\n}\n\nexport function formatCountdown(seconds: number): string {\n  const total = Math.max(0, Math.ceil(seconds));\n  const minutes = Math.floor(total / 60);\n  const rest = total % 60;\n  if (minutes > 0) {\n    return `${minutes}m ${rest.toString().padStart(2, \"0\")}s`;\n  }\n  return `${rest}s`;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794327615656,"end":1794327615670}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c642989f001kZfhyiq1tPj4vn","sessionID":"ses_e39c0874fffefk6JJfDw1Lex68","messageID":"msg_1c6428135001AEssGf6vF4IdAn"}}
