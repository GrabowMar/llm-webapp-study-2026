@@ -0,0 +1,64 @@
+import type { EventItem } from "../types";
+import { fmtTime, sameDay } from "../date";
+
+interface Props {
+  day: Date;
+  events: EventItem[];
+  isToday: boolean;
+  onSelect: (event: EventItem) => void;
+}
+
+export function EventCard({
+  event,
+  onSelect,
+}: {
+  event: EventItem;
+  onSelect: (event: EventItem) => void;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={() => onSelect(event)}
+      className="w-full rounded-lg border-l-4 border-indigo-500 bg-indigo-50 px-2 py-1.5 text-left shadow-sm transition hover:bg-indigo-100"
+    >
+      <div className="text-[11px] font-semibold text-indigo-700">{fmtTime(event.start_time)}</div>
+      <div className="truncate text-sm font-medium text-slate-800">{event.title}</div>
+      {event.location && (
+        <div className="truncate text-[11px] text-slate-500">{event.location}</div>
+      )}
+    </button>
+  );
+}
+
+export default function WeekDayColumn({ day, events, isToday, onSelect }: Props) {
+  return (
+    <div className="flex min-h-[18rem] flex-col border-r border-slate-200 last:border-r-0">
+      <div
+        className={`border-b border-slate-200 px-2 py-2 text-center ${
+          isToday ? "bg-indigo-50" : "bg-slate-50"
+        }`}
+      >
+        <div className="text-xs font-medium text-slate-500">
+          {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][day.getUTCDay()]}
+        </div>
+        <div
+          className={`mx-auto mt-0.5 flex h-7 w-7 items-center justify-center rounded-full text-sm font-semibold ${
+            isToday ? "bg-indigo-600 text-white" : "text-slate-800"
+          }`}
+        >
+          {day.getUTCDate()}
+        </div>
+      </div>
+      <div className="flex flex-1 flex-col gap-1.5 p-1.5">
+        {events
+          .filter((event) => sameDay(new Date(event.start_time), day))
+          .map((event) => (
+            <EventCard key={event.id} event={event} onSelect={onSelect} />
+          ))}
+        {events.filter((event) => sameDay(new Date(event.start_time), day)).length === 0 && (
+          <span className="mt-1 text-center text-[11px] text-slate-300">No events</span>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/date.ts b/frontend/src/date.ts
new file mode 100644
index 0000000..7f10803
--- /dev/null
+++ b/frontend/src/date.ts
@@ -0,0 +1,117 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+export const MONTHS = [
+  "January",
+  "February",
+  "March",
+  "April",
+  "May",
+  "June",
+  "July",
+  "August",
+  "September",
+  "October",
+  "November",
+  "December",
+];
+
+export function startOfDay(date: Date): Date {
+  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
+}
+
+export function addDays(date: Date, days: number): Date {
+  return new Date(date.getTime() + days * DAY_MS);
+}
+
+export function addMonths(date: Date, months: number): Date {
+  const year = date.getUTCFullYear();
+  const month = date.getUTCMonth() + months;
+  const first = new Date(Date.UTC(year, month, 1));
+  const lastDay = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 0)).getUTCDate();
+  return new Date(
+    Date.UTC(
+      first.getUTCFullYear(),
+      first.getUTCMonth(),
+      Math.min(date.getUTCDate(), lastDay),
+    ),
+  );
+}
+
+export function startOfWeek(date: Date): Date {
+  return addDays(startOfDay(date), -date.getUTCDay());
+}
+
+export function startOfMonth(date: Date): Date {
+  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1));
+}
+
+export function monthGridStart(date: Date): Date {
+  return startOfWeek(startOfMonth(date));
+}
+
+export function sameDay(a: Date, b: Date): boolean {
+  return (
+    a.getUTCFullYear() === b.getUTCFullYear() &&
+    a.getUTCMonth() === b.getUTCMonth() &&
+    a.getUTCDate() === b.getUTCDate()
+  );
+}
+
+export function isoDay(date: Date): string {
+  return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}-${String(
+    date.getUTCDate(),
+  ).padStart(2, "0")}`;
+}
+
+export function dayRangeIso(date: Date): { start: string; end: string } {
+  const start = startOfDay(date);
+  return { start: `${isoDay(start)}T00:00:00Z`, end: `${isoDay(addDays(start, 1))}T00:00:00Z` };
+}
+
+export function fmtTime(iso: string): string {
+  const d = new Date(iso);
+  return `${String(d.getUTCHours()).padStart(2, "0")}:${String(d.getUTCMinutes()).padStart(2, "0")}`;
+}
+
+export function fmtDateTime(iso: string): string {
+  const d = new Date(iso);
+  return `${isoDay(d)} ${fmtTime(iso)} UTC`;
+}
+
+export function fmtDateLong(date: Date): string {
+  return `${WEEKDAYS[date.getUTCDay()]}, ${MONTHS[date.getUTCMonth()]} ${date.getUTCDate()}, ${date.getUTCFullYear()}`;
+}
+
+export function fmtPeriodLabel(view: "month" | "week" | "day", anchor: Date): string {
+  if (view === "month") {
+    return `${MONTHS[anchor.getUTCMonth()]} ${anchor.getUTCFullYear()}`;
+  }
+  if (view === "day") {
+    return fmtDateLong(anchor);
+  }
+  const start = startOfWeek(anchor);
+  const end = addDays(start, 6);
+  const startLabel = `${MONTHS[start.getUTCMonth()].slice(0, 3)} ${start.getUTCDate()}`;
+  const endLabel = `${MONTHS[end.getUTCMonth()].slice(0, 3)} ${end.getUTCDate()}, ${end.getUTCFullYear()}`;
+  return `${startLabel} – ${endLabel}`;
+}
+
+export function isoToInput(iso: string): string {
+  const d = new Date(iso);
+  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(
+    d.getUTCDate(),
+  ).padStart(2, "0")}T${String(d.getUTCHours()).padStart(2, "0")}:${String(
+    d.getUTCMinutes(),
+  ).padStart(2, "0")}`;
+}
+
+export function inputToIso(value: string): string {
+  if (!value) return "";
+  const withSeconds = value.length === 16 ? `${value}:00` : value;
+  return `${withSeconds}Z`;
+}
+
+export function defaultInputFor(date: Date, hour: number): string {
+  return `${isoDay(date)}T${String(hour).padStart(2, "0")}:00`;
+}
