+            </button>
+          )}
+        </div>
+      </header>
+
+      <main className="mx-auto max-w-7xl px-4 py-6">
+        <div className="mb-4 flex items-center justify-between">
+          <p className="text-sm text-slate-500">
+            {loading ? "Loading events…" : `${events.length} event${events.length === 1 ? "" : "s"} in view`}
+          </p>
+          <button
+            type="button"
+            onClick={openCreate}
+            className="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700"
+          >
+            + New event
+          </button>
+        </div>
+
+        {loadError && (
+          <div className="mb-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700" role="alert">
+            {loadError}
+          </div>
+        )}
+
+        {view === "month" && (
+          <div className="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
+            <div className="grid grid-cols-7 border-b border-slate-200 bg-slate-50">
+              {WEEKDAYS.map((day) => (
+                <div
+                  key={day}
+                  className="py-2 text-center text-xs font-semibold uppercase tracking-wide text-slate-500"
+                >
+                  {day}
+                </div>
+              ))}
+            </div>
+            <div className="grid grid-cols-7">
+              {days.map((day) => (
+                <MonthView
+                  key={isoDay(day)}
+                  date={day}
+                  events={eventsFor(day)}
+                  isToday={sameDay(day, today)}
+                  inMonth={day.getUTCMonth() === anchor.getUTCMonth()}
+                  onSelect={openEvent}
+                  onOpenDay={(d) => {
+                    setAnchor(startOfDay(d));
+                    setView("day");
+                  }}
+                />
+              ))}
+            </div>
+          </div>
+        )}
+
+        {view === "week" && (
+          <div className="grid grid-cols-7 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
+            {days.map((day) => (
+              <WeekDayColumn
+                key={isoDay(day)}
+                day={day}
+                events={eventsFor(day)}
+                isToday={sameDay(day, today)}
+                onSelect={openEvent}
+              />
+            ))}
+          </div>
+        )}
+
+        {view === "day" && <DayView events={eventsFor(anchor)} onSelect={openEvent} />}
+      </main>
+
+      {showAuth && (
+        <div
+          className="fixed inset-0 z-40 flex items-center justify-center bg-slate-900/40 p-4"
+          onClick={() => setShowAuth(false)}
+        >
+          <div onClick={(e) => e.stopPropagation()} className="w-full max-w-md">
+            <AuthPanel
+              onAuthenticated={(token, username) => {
+                saveSession({ token, username });
+                setShowAuth(false);
+              }}
+            />
+            <button
+              type="button"
+              onClick={() => setShowAuth(false)}
+              className="mt-3 w-full text-center text-sm text-white/80 hover:text-white"
+            >
+              Cancel
+            </button>
+          </div>
+        </div>
+      )}
+
+      {modalOpen && (
+        <EventModal
+          event={selected}
+          day={anchor}
+          token={session?.token ?? null}
+          onClose={() => {
+            setModalOpen(false);
+            setSelected(null);
+          }}
+          onSaved={afterSaved}
+          onDeleted={afterDeleted}
+        />
+      )}
+    </div>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..cbaddf2
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,86 @@
+import type { EventInput, EventItem, EventList } from "./types";
+
+export class ApiError extends Error {
+  status: number;
+  fieldErrors: Record<string, string>;
+
+  constructor(status: number, message: string, fieldErrors: Record<string, string> = {}) {
+    super(message);
+    this.name = "ApiError";
+    this.status = status;
+    this.fieldErrors = fieldErrors;
+  }
+}
+
+async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const headers = new Headers(options.headers);
+  if (options.body && !headers.has("Content-Type")) {
+    headers.set("Content-Type", "application/json");
+  }
+  const response = await fetch(path, { ...options, headers });
+  if (response.status === 204) {
+    return undefined as T;
+  }
+  const contentType = response.headers.get("Content-Type") ?? "";
+  const data = contentType.includes("application/json") ? await response.json() : null;
+  if (!response.ok) {
+    const message =
+      data && typeof data.error === "string" ? data.error : `Request failed (${response.status})`;
+    const fields =
+      data && typeof data.errors === "object" && data.errors !== null
+        ? (data.errors as Record<string, string>)
+        : {};
+    throw new ApiError(response.status, message, fields);
+  }
+  return data as T;
+}
+
+function authHeaders(token: string | null): Record<string, string> {
+  return token ? { Authorization: `Bearer ${token}` } : {};
+}
+
+export function register(username: string, password: string): Promise<{ username: string }> {
+  return request("/api/auth/register", {
+    method: "POST",
+    body: JSON.stringify({ username, password }),
+  });
+}
+
+export function login(username: string, password: string): Promise<{ token: string; username?: string }> {
+  return request("/api/auth/login", {
+    method: "POST",
+    body: JSON.stringify({ username, password }),
+  });
+}
+
+export function listEvents(
+  startDate: string,
+  endDate: string,
+  signal?: AbortSignal,
+): Promise<EventList> {
+  const params = new URLSearchParams({ start_date: startDate, end_date: endDate });
+  return request(`/api/events?${params.toString()}`, { signal });
+}
+
+export function createEvent(token: string, input: EventInput): Promise<EventItem> {
+  return request("/api/events", {
+    method: "POST",
+    headers: authHeaders(token),
+    body: JSON.stringify(input),
+  });
+}
+
+export function updateEvent(token: string, id: number, input: EventInput): Promise<EventItem> {
+  return request(`/api/events/${id}`, {
+    method: "PUT",
+    headers: authHeaders(token),
+    body: JSON.stringify(input),
+  });
+}
+
+export function deleteEvent(token: string, id: number): Promise<void> {
+  return request(`/api/events/${id}`, {
+    method: "DELETE",
+    headers: authHeaders(token),
+  });
+}
diff --git a/frontend/src/components/AuthPanel.tsx b/frontend/src/components/AuthPanel.tsx
