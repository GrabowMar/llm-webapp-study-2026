{"type":"step_start","timestamp":1794378065766,"sessionID":"ses_e36c02081ffe09qh34Gp0gnGgn","part":{"id":"prt_1c9446755001Uw06UAYHa1OWS5","messageID":"msg_1c944099c0010B2exV0MV05WUm","sessionID":"ses_e36c02081ffe09qh34Gp0gnGgn","type":"step-start"}}
{"type":"tool_use","timestamp":1794378065802,"sessionID":"ses_e36c02081ffe09qh34Gp0gnGgn","part":{"type":"tool","tool":"write","callID":"call_03956f0fd2f8413287756fdf","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\nimport { ApiError, listEvents } from \"./api\";\nimport type { CalendarView, EventItem } from \"./types\";\nimport {\n  addDays,\n  addMonths,\n  fmtPeriodLabel,\n  isoDay,\n  monthGridStart,\n  sameDay,\n  startOfDay,\n  startOfMonth,\n  startOfWeek,\n  WEEKDAYS,\n} from \"./date\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport EventModal from \"./components/EventModal\";\nimport MonthView from \"./components/MonthView\";\nimport WeekDayColumn from \"./components/WeekView\";\nimport DayView from \"./components/DayView\";\n\nconst STORAGE_KEY = \"calendar-auth\";\n\ninterface Session {\n  token: string;\n  username: string;\n}\n\nfunction loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    const parsed = JSON.parse(raw);\n    if (typeof parsed.token === \"string\" && typeof parsed.username === \"string\") {\n      return parsed;\n    }\n  } catch {\n    /* ignore */\n  }\n  return null;\n}\n\nconst VIEWS: { id: CalendarView; label: string }[] = [\n  { id: \"month\", label: \"Month\" },\n  { id: \"week\", label: \"Week\" },\n  { id: \"day\", label: \"Day\" },\n];\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(() => loadSession());\n  const [view, setView] = useState<CalendarView>(\"month\");\n  const [anchor, setAnchor] = useState<Date>(() => startOfDay(new Date()));\n  const [events, setEvents] = useState<EventItem[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [loadError, setLoadError] = useState(\"\");\n  const [modalOpen, setModalOpen] = useState(false);\n  const [selected, setSelected] = useState<EventItem | null>(null);\n  const [showAuth, setShowAuth] = useState(false);\n  const [reloadKey, setReloadKey] = useState(0);\n  const requestId = useRef(0);\n\n  const range = useMemo(() => {\n    let first: Date;\n    let days: number;\n    if (view === \"month\") {\n      first = monthGridStart(anchor);\n      days = 42;\n    } else if (view === \"week\") {\n      first = startOfWeek(anchor);\n      days = 7;\n    } else {\n      first = startOfDay(anchor);\n      days = 1;\n    }\n    return { first, days, last: addDays(first, days - 1) };\n  }, [view, anchor]);\n\n  useEffect(() => {\n    const controller = new AbortController();\n    const id = ++requestId.current;\n    setLoading(true);\n    setLoadError(\"\");\n    const start = `${isoDay(range.first)}T00:00:00Z`;\n    const end = `${isoDay(addDays(range.last, 1))}T00:00:00Z`;\n    listEvents(start, end, controller.signal)\n      .then((data) => {\n        if (id !== requestId.current) return;\n        setEvents(data.items);\n      })\n      .catch((err) => {\n        if (controller.signal.aborted) return;\n        if (id !== requestId.current) return;\n        setLoadError(err instanceof ApiError ? err.message : \"Could not load events.\");\n      })\n      .finally(() => {\n        if (id === requestId.current) setLoading(false);\n      });\n    return () => controller.abort();\n  }, [range, reloadKey]);\n\n  const authenticated = session !== null;\n\n  function saveSession(next: Session) {\n    setSession(next);\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(next));\n  }\n\n  function signOut() {\n    setSession(null);\n    localStorage.removeItem(STORAGE_KEY);\n    setShowAuth(false);\n  }\n\n  function goToToday() {\n    setAnchor(startOfDay(new Date()));\n  }\n\n  function navigate(direction: -1 | 1) {\n    setAnchor((current) => {\n      if (view === \"month\") return startOfMonth(addMonths(current, direction));\n      if (view === \"week\") return addDays(current, 7 * direction);\n      return addDays(current, direction);\n    });\n  }\n\n  const eventsFor = useCallback(\n    (day: Date) => events.filter((event) => sameDay(new Date(event.start_time), day)),\n    [events],\n  );\n\n  const days = useMemo(\n    () => Array.from({ length: range.days }, (_, i) => addDays(range.first, i)),\n    [range],\n  );\n\n  function openEvent(event: EventItem) {\n    setSelected(event);\n    setModalOpen(true);\n  }\n\n  function openCreate() {\n    if (!authenticated) {\n      setShowAuth(true);\n      return;\n    }\n    setSelected(null);\n    setModalOpen(true);\n  }\n\n  function afterSaved(saved: EventItem) {\n    setModalOpen(false);\n    setSelected(null);\n    setReloadKey((k) => k + 1);\n    void saved;\n  }\n\n  function afterDeleted() {\n    setModalOpen(false);\n    setSelected(null);\n    setReloadKey((k) => k + 1);\n  }\n\n  const today = startOfDay(new Date());\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white shadow-sm\">\n        <div className=\"mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 py-3\">\n          <h1 className=\"mr-2 text-lg font-bold tracking-tight\">Event Calendar</h1>\n          <div className=\"flex items-center rounded-lg border border-slate-300\">\n            <button\n              type=\"button\"\n              onClick={() => navigate(-1)}\n              aria-label=\"Previous period\"\n              className=\"rounded-l-lg px-3 py-1.5 text-slate-600 hover:bg-slate-50\"\n            >\n              ‹\n            </button>\n            <button\n              type=\"button\"\n              onClick={goToToday}\n              className=\"border-x border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n            >\n              Today\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => navigate(1)}\n              aria-label=\"Next period\"\n              className=\"rounded-r-lg px-3 py-1.5 text-slate-600 hover:bg-slate-50\"\n            >\n              ›\n            </button>\n          </div>\n          <h2 className=\"min-w-40 text-base font-semibold text-slate-800\">\n            {fmtPeriodLabel(view, anchor)}\n          </h2>\n          <div className=\"ml-auto flex items-center gap-1 rounded-lg bg-slate-100 p-1\">\n            {VIEWS.map((option) => (\n              <button\n                key={option.id}\n                type=\"button\"\n                onClick={() => setView(option.id)}\n                className={`rounded-md px-3 py-1.5 text-sm font-medium transition ${\n                  view === option.id\n                    ? \"bg-white text-slate-900 shadow-sm\"\n                    : \"text-slate-600 hover:text-slate-900\"\n                }`}\n              >\n                {option.label}\n              </button>\n            ))}\n          </div>\n          {authenticated ? (\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-sm text-slate-600\">\n                Signed in as <span className=\"font-semibold\">{session.username}</span>\n              </span>\n              <button\n                type=\"button\"\n                onClick={signOut}\n                className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n              >\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={() => setShowAuth(true)}\n              className=\"rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700\"\n            >\n              Sign in\n            </button>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-7xl px-4 py-6\">\n        <div className=\"mb-4 flex items-center justify-between\">\n          <p className=\"text-sm text-slate-500\">\n            {loading ? \"Loading events…\" : `${events.length} event${events.length === 1 ? \"\" : \"s\"} in view`}\n          </p>\n          <button\n            type=\"button\"\n            onClick={openCreate}\n            className=\"rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700\"\n          >\n            + New event\n          </button>\n        </div>\n\n        {loadError && (\n          <div className=\"mb-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700\" role=\"alert\">\n            {loadError}\n          </div>\n        )}\n\n        {view === \"month\" && (\n          <div className=\"overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm\">\n            <div className=\"grid grid-cols-7 border-b border-slate-200 bg-slate-50\">\n              {WEEKDAYS.map((day) => (\n                <div\n                  key={day}\n                  className=\"py-2 text-center text-xs font-semibold uppercase tracking-wide text-slate-500\"\n                >\n                  {day}\n                </div>\n              ))}\n            </div>\n            <div className=\"grid grid-cols-7\">\n              {days.map((day) => (\n                <MonthView\n                  key={isoDay(day)}\n                  date={day}\n                  events={eventsFor(day)}\n                  isToday={sameDay(day, today)}\n                  inMonth={day.getUTCMonth() === anchor.getUTCMonth()}\n                  onSelect={openEvent}\n                  onOpenDay={(d) => {\n                    setAnchor(startOfDay(d));\n                    setView(\"day\");\n                  }}\n                />\n              ))}\n            </div>\n          </div>\n        )}\n\n        {view === \"week\" && (\n          <div className=\"grid grid-cols-7 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm\">\n            {days.map((day) => (\n              <WeekDayColumn\n                key={isoDay(day)}\n                day={day}\n                events={eventsFor(day)}\n                isToday={sameDay(day, today)}\n                onSelect={openEvent}\n              />\n            ))}\n          </div>\n        )}\n\n        {view === \"day\" && <DayView events={eventsFor(anchor)} onSelect={openEvent} />}\n      </main>\n\n      {showAuth && (\n        <div\n          className=\"fixed inset-0 z-40 flex items-center justify-center bg-slate-900/40 p-4\"\n          onClick={() => setShowAuth(false)}\n        >\n          <div onClick={(e) => e.stopPropagation()} className=\"w-full max-w-md\">\n            <AuthPanel\n              onAuthenticated={(token, username) => {\n                saveSession({ token, username });\n                setShowAuth(false);\n              }}\n            />\n            <button\n              type=\"button\"\n              onClick={() => setShowAuth(false)}\n              className=\"mt-3 w-full text-center text-sm text-white/80 hover:text-white\"\n            >\n              Cancel\n            </button>\n          </div>\n        </div>\n      )}\n\n      {modalOpen && (\n        <EventModal\n          event={selected}\n          day={anchor}\n          token={session?.token ?? null}\n          onClose={() => {\n            setModalOpen(false);\n            setSelected(null);\n          }}\n          onSaved={afterSaved}\n          onDeleted={afterDeleted}\n        />\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794378065760,"end":1794378065774}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9446758001y9QaYZb4rv0dPR","sessionID":"ses_e36c02081ffe09qh34Gp0gnGgn","messageID":"msg_1c944099c0010B2exV0MV05WUm"}}
