 users').fetchall())\nprint('token rows', con.execute('select substr(token_hash,1,8) from tokens').fetchall())\nPY\nkill $(cat .gunicorn.pid); cat .error.log","time":{"start":1794386368457,"end":1794386370028}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9c317c2001rokW7FHETpQo4V","sessionID":"ses_e364812deffeyzFyXs37o8dGsB","messageID":"msg_1c9c2c8690010PbWi51TYJpZwq"}}
