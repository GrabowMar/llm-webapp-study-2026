{"type":"tool_use","timestamp":1794386104817,"sessionID":"ses_e364812deffeyzFyXs37o8dGsB","part":{"type":"tool","tool":"bash","callID":"call_fb56a37e4cd046649f95437b","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'PY'\n\"\"\"XML well-formedness checker API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\nfrom xml.parsers import expat\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\nPREVIEW_LENGTH = 200\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n\n\ndef connect_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect_db()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                token_hash TEXT NOT NULL UNIQUE,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS validations (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                xml_preview TEXT NOT NULL,\n                valid INTEGER NOT NULL,\n                error TEXT,\n                line INTEGER,\n                column INTEGER,\n                root_element TEXT,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_validations_user_created\n                ON validations (user_id, created_at DESC, id DESC);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ninit_db()\n\n\ndef json_body() -> dict[str, Any]:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    return token or None\n\n\ndef get_current_user() -> sqlite3.Row | None:\n    token = bearer_token()\n    if token is None:\n        return None\n    row = get_db().execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM tokens\n        JOIN users ON users.id = tokens.user_id\n        WHERE tokens.token_hash = ?\n        \"\"\",\n        (hash_token(token),),\n    ).fetchone()\n    return row\n\n\ndef login_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any) -> Any:\n        if get_current_user() is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n_ERROR_SUFFIX = re.compile(r\": line \\d+, column \\d+$\")\n\n\ndef validate_xml(xml: str) -> dict[str, Any]:\n    \"\"\"Check XML syntax only. External entities are never fetched or resolved.\"\"\"\n    parser = expat.ParserCreate()\n    parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)\n    parser.ExternalEntityRefHandler = lambda *args: 1\n\n    root_element: list[str | None] = [None]\n\n    def on_start(name: str, _attrs: dict[str, str]) -> None:\n        if root_element[0] is None:\n            root_element[0] = name\n\n    parser.StartElementHandler = on_start\n\n    try:\n        parser.Parse(xml, True)\n    except expat.ExpatError as exc:\n        message = _ERROR_SUFFIX.sub(\"\", str(exc)).strip()\n        if not message:\n            message = expat.ErrorString(exc.code)\n        return {\n            \"valid\": False,\n            \"error\": message,\n            \"line\": exc.lineno,\n            \"column\": exc.offset,\n            \"root_element\": None,\n        }\n\n    return {\n        \"valid\": True,\n        \"error\": None,\n        \"line\": None,\n        \"column\": None,\n        \"root_element\": root_element[0],\n    }\n\n\ndef validation_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health() -> Any:\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/auth/register\")\ndef register() -> Any:\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    username = username.strip()\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    if len(username) > 150:\n        return jsonify({\"error\": \"username is too long\"}), 400\n\n    try:\n        conn = get_db()\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utc_now()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already exists\"}), 409\n\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login() -> Any:\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    username = username.strip()\n\n    conn = get_db()\n    user = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n\n    token = secrets.token_urlsafe(32)\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, created_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user[\"id\"], utc_now()),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me() -> Any:\n    user = get_current_user()\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n\n\n@app.post(\"/api/validate/xml\")\ndef validate() -> Any:\n    data = json_body()\n    xml = data.get(\"xml\")\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"xml must be a string\"}), 400\n    return jsonify(validate_xml(xml))\n\n\n@app.post(\"/api/validations\")\n@login_required\ndef create_validation() -> Any:\n    data = json_body()\n    xml = data.get(\"xml\")\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"xml must be a string\"}), 400\n\n    result = validate_xml(xml)\n    user = get_current_user()\n    created_at = utc_now()\n    conn = get_db()\n    cursor = conn.execute(\n        \"\"\"\n        INSERT INTO validations\n            (user_id, xml_preview, valid, error, line, column, root_element, created_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            user[\"id\"],\n            xml[:PREVIEW_LENGTH],\n            1 if result[\"valid\"] else 0,\n            result[\"error\"],\n            result[\"line\"],\n            result[\"column\"],\n            result[\"root_element\"],\n            created_at,\n        ),\n    )\n    conn.commit()\n\n    row = conn.execute(\"SELECT * FROM validations WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(validation_to_dict(row)), 201\n\n\ndef parse_positive_int(name: str, default: int) -> int | None:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except (TypeError, ValueError):\n        return None\n    if value < 1:\n        return None\n    return value\n\n\ndef parse_valid_filter() -> bool | None:\n    raw = request.args.get(\"valid\")\n    if raw is None or raw == \"\":\n        return None\n    lowered = raw.strip().lower()\n    if lowered in {\"true\", \"1\", \"yes\"}:\n        return True\n    if lowered in {\"false\", \"0\", \"no\"}:\n        return False\n    return None\n\n\n@app.get(\"/api/validations\")\n@login_required\ndef list_validations() -> Any:\n    valid_filter = parse_valid_filter()\n    raw_valid = request.args.get(\"valid\")\n    if raw_valid not in (None, \"\") and valid_filter is None:\n        return jsonify({\"error\": \"valid must be true or false\"}), 400\n\n    page = parse_positive_int(\"page\", 1)\n    if page is None:\n        return jsonify({\"error\": \"page must be a positive integer\"}), 400\n    page_size = parse_positive_int(\"page_size\", DEFAULT_PAGE_SIZE)\n    if page_size is None:\n        return jsonify({\"error\": \"page_size must be a positive integer\"}), 400\n    page_size = min(page_size, 100)\n\n    user = get_current_user()\n    where = \"user_id = ?\"\n    params: list[Any] = [user[\"id\"]]\n    if valid_filter is not None:\n        where += \" AND valid = ?\"\n        params.append(1 if valid_filter else 0)\n\n    conn = get_db()\n    total = conn.execute(f\"SELECT COUNT(*) AS count FROM validations WHERE {where}\", params).fetchone()[\n        \"count\"\n    ]\n    rows = conn.execute(\n        f\"\"\"\n        SELECT * FROM validations\n        WHERE {where}\n        ORDER BY created_at DESC, id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [validation_to_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.delete(\"/api/validations/<int:validation_id>\")\n@login_required\ndef delete_validation(validation_id: int) -> Any:\n    user = get_current_user()\n    conn = get_db()\n    cursor = conn.execute(\n        \"DELETE FROM validations WHERE id = ? AND user_id = ?\", (validation_id, user[\"id\"])\n    )\n    conn.commit()\n    if cursor.rowcount == 0:\n        return jsonify({\"error\": \"validation not found\"}), 404\n    return jsonify({\"deleted\": True})\n\n\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str) -> Any:\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\") -> Any:\n    if path.startswith(\"api/\"):\n        abort(404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\nPY\npython3 -m py_compile backend/app.py && echo 'ok'"},"output":"ok\n","metadata":{"output":"ok\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'PY'\n\"\"\"XML well-formedness checker API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\nfrom xml.parsers import expat\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\nPREVIEW_LENGTH = 200\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n\n\ndef connect_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect_db()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                token_hash TEXT NOT NULL UNIQUE,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS validations (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                xml_preview TEXT NOT NULL,\n                valid INTEGER NOT NULL,\n                error TEXT,\n                line INTEGER,\n                column INTEGER,\n                root_element TEXT,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_validations_user_created\n                ON validations (user_id, created_at DESC, id DESC);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ninit_db()\n\n\ndef json_body() -> dict[str, Any]:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    return token or None\n\n\ndef get_current_user() -> sqlite3.Row | None:\n    token = bearer_token()\n    if token is None:\n        return None\n    row = get_db().execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM tokens\n        JOIN users ON users.id = tokens.user_id\n        WHERE tokens.token_hash = ?\n        \"\"\",\n        (hash_token(token),),\n    ).fetchone()\n    return row\n\n\ndef login_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any) -> Any:\n        if get_current_user() is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\n_ERROR_SUFFIX = re.compile(r\": line \\d+, column \\d+$\")\n\n\ndef validate_xml(xml: str) -> dict[str, Any]:\n    \"\"\"Check XML syntax only. External entities are never fetched or resolved.\"\"\"\n    parser = expat.ParserCreate()\n    parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)\n    parser.ExternalEntityRefHandler = lambda *args: 1\n\n    root_element: list[str | None] = [None]\n\n    def on_start(name: str, _attrs: dict[str, str]) -> None:\n        if root_element[0] is None:\n            root_element[0] = name\n\n    parser.StartElementHandler = on_start\n\n    try:\n        parser.Parse(xml, True)\n    except expat.ExpatError as exc:\n        message = _ERROR_SUFFIX.sub(\"\", str(exc)).strip()\n        if not message:\n            message = expat.ErrorString(exc.code)\n        return {\n            \"valid\": False,\n            \"error\": message,\n            \"line\": exc.lineno,\n            \"column\": exc.offset,\n            \"root_element\": None,\n        }\n\n    return {\n        \"valid\": True,\n        \"error\": None,\n        \"line\": None,\n        \"column\": None,\n        \"root_element\": root_element[0],\n    }\n\n\ndef validation_to_dict(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health() -> Any:\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.post(\"/api/auth/register\")\ndef register() -> Any:\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    username = username.strip()\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    if len(username) > 150:\n        return jsonify({\"error\": \"username is too long\"}), 400\n\n    try:\n        conn = get_db()\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utc_now()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already exists\"}), 409\n\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login() -> Any:\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    username = username.strip()\n\n    conn = get_db()\n    user = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n\n    token = secrets.token_urlsafe(32)\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, created_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user[\"id\"], utc_now()),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me() -> Any:\n    user = get_current_user()\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n\n\n@app.post(\"/api/validate/xml\")\ndef validate() -> Any:\n    data = json_body()\n    xml = data.get(\"xml\")\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"xml must be a string\"}), 400\n    return jsonify(validate_xml(xml))\n\n\n@app.post(\"/api/validations\")\n@login_required\ndef create_validation() -> Any:\n    data = json_body()\n    xml = data.get(\"xml\")\n    if not isinstance(xml, str):\n        return jsonify({\"error\": \"xml must be a string\"}), 400\n\n    result = validate_xml(xml)\n    user = get_current_user()\n    created_at = utc_now()\n    conn = get_db()\n    cursor = conn.execute(\n        \"\"\"\n        INSERT INTO validations\n            (user_id, xml_preview, valid, error, line, column, root_element, created_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            user[\"id\"],\n            xml[:PREVIEW_LENGTH],\n            1 if result[\"valid\"] else 0,\n            result[\"error\"],\n            result[\"line\"],\n            result[\"column\"],\n            result[\"root_element\"],\n            created_at,\n        ),\n    )\n    conn.commit()\n\n    row = conn.execute(\"SELECT * FROM validations WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(validation_to_dict(row)), 201\n\n\ndef parse_positive_int(name: str, default: int) -> int | None:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except (TypeError, ValueError):\n        return None\n    if value < 1:\n        return None\n    return value\n\n\ndef parse_valid_filter() -> bool | None:\n    raw = request.args.get(\"valid\")\n    if raw is None or raw == \"\":\n        return None\n    lowered = raw.strip().lower()\n    if lowered in {\"true\", \"1\", \"yes\"}:\n        return True\n    if lowered in {\"false\", \"0\", \"no\"}:\n        return False\n    return None\n\n\n@app.get(\"/api/validations\")\n@login_required\ndef list_validations() -> Any:\n    valid_filter = parse_valid_filter()\n    raw_valid = request.args.get(\"valid\")\n    if raw_valid not in (None, \"\") and valid_filter is None:\n        return jsonify({\"error\": \"valid must be true or false\"}), 400\n\n    page = parse_positive_int(\"page\", 1)\n    if page is None:\n        return jsonify({\"error\": \"page must be a positive integer\"}), 400\n    page_size = parse_positive_int(\"page_size\", DEFAULT_PAGE_SIZE)\n    if page_size is None:\n        return jsonify({\"error\": \"page_size must be a positive integer\"}), 400\n    page_size = min(page_size, 100)\n\n    user = get_current_user()\n    where = \"user_id = ?\"\n    params: list[Any] = [user[\"id\"]]\n    if valid_filter is not None:\n        where += \" AND valid = ?\"\n        params.append(1 if valid_filter else 0)\n\n    conn = get_db()\n    total = conn.execute(f\"SELECT COUNT(*) AS count FROM validations WHERE {where}\", params).fetchone()[\n        \"count\"\n    ]\n    rows = conn.execute(\n        f\"\"\"\n        SELECT * FROM validations\n        WHERE {where}\n        ORDER BY created_at DESC, id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [validation_to_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.delete(\"/api/validations/<int:validation_id>\")\n@login_required\ndef delete_validation(validation_id: int) -> Any:\n    user = get_current_user()\n    conn = get_db()\n    cursor = conn.execute(\n        \"DELETE FROM validations WHERE id = ? AND user_id = ?\", (validation_id, user[\"id\"])\n    )\n    conn.commit()\n    if cursor.rowcount == 0:\n        return jsonify({\"error\": \"validation not found\"}), 404\n    return jsonify({\"deleted\": True})\n\n\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str) -> Any:\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\") -> Any:\n    if path.startswith(\"api/\"):\n        abort(404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\nPY\npython3 -m py_compile backend/app.py && echo 'ok'","time":{"start":1794386104688,"end":1794386104773}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9bf1165001BtkrVCsjMjZmJN","sessionID":"ses_e364812deffeyzFyXs37o8dGsB","messageID":"msg_1c9bd8b6b001rmYFCmQi8th2Em"}}
