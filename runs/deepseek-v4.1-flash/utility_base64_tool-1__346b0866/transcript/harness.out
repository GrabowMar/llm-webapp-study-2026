{"type":"tool_use","timestamp":1794359551434,"sessionID":"ses_e37d908adffevt5SKz66hGNbR8","part":{"type":"tool","tool":"write","callID":"call_ef4b8876ab164b5da33c4d23","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the Base64 converter.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport hashlib\nimport hmac\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.sqlite3\"\n\nPREVIEW_LENGTH = 100\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 8 * 1024 * 1024\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.execute(\"PRAGMA busy_timeout = 30000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sessions (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS conversions (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                direction TEXT NOT NULL,\n                input TEXT NOT NULL,\n                output TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_conversions_user\n                ON conversions (user_id, id DESC);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef error(message: str, status: int = 400):\n    return jsonify({\"error\": message}), status\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_bytes(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, 240_000)\n    return f\"pbkdf2_sha256$240000${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        algorithm, iterations, salt_hex, digest_hex = stored.split(\"$\", 3)\n        if algorithm != \"pbkdf2_sha256\":\n            return False\n        digest = hashlib.pbkdf2_hmac(\n            \"sha256\",\n            password.encode(\"utf-8\"),\n            bytes.fromhex(salt_hex),\n            int(iterations),\n        )\n        return hmac.compare_digest(digest.hex(), digest_hex)\n    except (ValueError, TypeError):\n        return False\n\n\ndef token_digest(token: str) -> str:\n    return hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    db = get_db()\n    return db.execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM sessions JOIN users ON users.id = sessions.user_id\n        WHERE sessions.token_hash = ?\n        \"\"\",\n        (token_digest(token.strip()),),\n    ).fetchone()\n\n\ndef require_user() -> tuple[sqlite3.Row | None, tuple | None]:\n    user = current_user()\n    if user is None:\n        return None, error(\"Authentication required\", 401)\n    return user, None\n\n\ndef json_body() -> dict:\n    body = request.get_json(silent=True)\n    return body if isinstance(body, dict) else {}\n\n\ndef preview(value: str) -> str:\n    if len(value) <= PREVIEW_LENGTH:\n        return value\n    return value[:PREVIEW_LENGTH] + \"...\"\n\n\ndef encode_text(text: str) -> str:\n    return base64.b64encode(text.encode(\"utf-8\")).decode(\"ascii\")\n\n\ndef decode_text(encoded: str) -> str:\n    compact = \"\".join(encoded.split())\n    try:\n        raw = base64.b64decode(compact, validate=True)\n    except (binascii.Error, ValueError) as exc:\n        raise ValueError(\"Invalid base64 input\") from exc\n    try:\n        return raw.decode(\"utf-8\")\n    except UnicodeDecodeError as exc:\n        raise ValueError(\"Decoded data is not valid UTF-8 text\") from exc\n\n\ndef convert(direction: object, value: object) -> str:\n    if direction not in (\"encode\", \"decode\"):\n        raise ValueError(\"direction must be 'encode' or 'decode'\")\n    if not isinstance(value, str):\n        raise ValueError(\"input must be a string\")\n    return encode_text(value) if direction == \"encode\" else decode_text(value)\n\n\ndef conversion_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"direction\": row[\"direction\"],\n        \"input_preview\": preview(row[\"input\"]),\n        \"output_preview\": preview(row[\"output\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\")\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required\")\n    username = username.strip()\n    if len(username) > 150:\n        return error(\"Username is too long\")\n    if len(password) > 1024:\n        return error(\"Password is too long\")\n\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return error(\"Username is already taken\", 409)\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, hash_password(password), utcnow()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        db.rollback()\n        return error(\"Username is already taken\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\")\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if user is None or not verify_password(password, user[\"password_hash\"]):\n        return error(\"Invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO sessions (token_hash, user_id, created_at) VALUES (?, ?, ?)\",\n        (token_digest(token), user[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user, failure = require_user()\n    if failure:\n        return failure\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() == \"bearer\" and token.strip():\n        db = get_db()\n        db.execute(\"DELETE FROM sessions WHERE token_hash = ?\", (token_digest(token.strip()),))\n        db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.post(\"/api/base64/encode\")\ndef base64_encode():\n    body = json_body()\n    text = body.get(\"text\")\n    if not isinstance(text, str):\n        return error(\"text must be a string\")\n    return jsonify({\"encoded\": encode_text(text)})\n\n\n@app.post(\"/api/base64/decode\")\ndef base64_decode():\n    body = json_body()\n    encoded = body.get(\"encoded\")\n    if not isinstance(encoded, str):\n        return error(\"encoded must be a string\")\n    try:\n        text = decode_text(encoded)\n    except ValueError as exc:\n        return error(str(exc))\n    return jsonify({\"text\": text})\n\n\n@app.post(\"/api/conversions\")\ndef create_conversion():\n    user, failure = require_user()\n    if failure:\n        return failure\n    body = json_body()\n    direction = body.get(\"direction\")\n    value = body.get(\"input\")\n    try:\n        output = convert(direction, value)\n    except ValueError as exc:\n        return error(str(exc))\n\n    db = get_db()\n    cursor = db.execute(\n        \"\"\"\n        INSERT INTO conversions (user_id, direction, input, output, created_at)\n        VALUES (?, ?, ?, ?, ?)\n        \"\"\",\n        (user[\"id\"], direction, value, output, utcnow()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM conversions WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    result = conversion_dict(row)\n    result[\"output\"] = row[\"output\"]\n    return jsonify(result), 201\n\n\n@app.get(\"/api/conversions\")\ndef list_conversions():\n    user, failure = require_user()\n    if failure:\n        return failure\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n    except (TypeError, ValueError):\n        return error(\"page and page_size must be integers\")\n    page = max(1, page)\n    page_size = min(max(1, page_size), MAX_PAGE_SIZE)\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM conversions WHERE user_id = ?\", (user[\"id\"],)\n    ).fetchone()[0]\n    rows = db.execute(\n        \"\"\"\n        SELECT * FROM conversions\n        WHERE user_id = ?\n        ORDER BY id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        (user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [conversion_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.delete(\"/api/conversions/<int:conversion_id>\")\ndef delete_conversion(conversion_id: int):\n    user, failure = require_user()\n    if failure:\n        return failure\n    db = get_db()\n    cursor = db.execute(\n        \"DELETE FROM conversions WHERE id = ? AND user_id = ?\",\n        (conversion_id, user[\"id\"]),\n    )\n    db.commit()\n    if cursor.rowcount == 0:\n        return error(\"Conversion not found\", 404)\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794359551393,"end":1794359551413}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c829e5900011JcNHC8TmolJPt","sessionID":"ses_e37d908adffevt5SKz66hGNbR8","messageID":"msg_1c829508b0010206M3cFCEO0i1"}}
