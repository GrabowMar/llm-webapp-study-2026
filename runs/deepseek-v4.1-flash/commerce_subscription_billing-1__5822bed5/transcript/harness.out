{"type":"step_start","timestamp":1794325683905,"sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","part":{"id":"prt_1c6251eae001tq4OnfF5oMiTvm","messageID":"msg_1c624ea61001YzC2lLb4qx2wjv","sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","type":"step-start"}}
{"type":"tool_use","timestamp":1794325683942,"sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","part":{"type":"tool","tool":"write","callID":"call_7e8abc607fed4be9a48e178c","state":{"status":"completed","input":{"content":"import { useEffect, useMemo, useState } from \"react\";\nimport { api } from \"../api\";\nimport type { Paged, Status, Subscription } from \"../types\";\n\nconst STATUS_TABS: { value: string; label: string }[] = [\n  { value: \"\", label: \"All\" },\n  { value: \"trial\", label: \"Trial\" },\n  { value: \"active\", label: \"Active\" },\n  { value: \"past_due\", label: \"Past due\" },\n  { value: \"cancelled\", label: \"Cancelled\" },\n];\n\nconst STATUS_STYLES: Record<Status, string> = {\n  trial: \"bg-sky-100 text-sky-800\",\n  active: \"bg-emerald-100 text-emerald-800\",\n  past_due: \"bg-amber-100 text-amber-800\",\n  cancelled: \"bg-slate-200 text-slate-700\",\n};\n\nconst STATUS_LABELS: Record<Status, string> = {\n  trial: \"Trial\",\n  active: \"Active\",\n  past_due: \"Past due\",\n  cancelled: \"Cancelled\",\n};\n\nconst PAGE_SIZE = 10;\n\nexport function SubscriptionsPage({ navigate }: { navigate: (p: string) => void }) {\n  const [status, setStatus] = useState(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [searchInput, setSearchInput] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Paged<Subscription> | null>(null);\n  const [plans, setPlans] = useState<string[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [showCreate, setShowCreate] = useState(false);\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(searchInput.trim());\n      setPage(1);\n    }, 300);\n    return () => clearTimeout(t);\n  }, [searchInput]);\n\n  useEffect(() => {\n    setPage(1);\n  }, [status, plan]);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    const params = new URLSearchParams();\n    if (q) params.set(\"q\", q);\n    if (status) params.set(\"status\", status);\n    if (plan) params.set(\"plan\", plan);\n    params.set(\"page\", String(page));\n    params.set(\"page_size\", String(PAGE_SIZE));\n\n    api<Paged<Subscription>>(`/subscriptions?${params.toString()}`)\n      .then((res) => {\n        if (!cancelled) setData(res);\n      })\n      .catch((e) => {\n        if (!cancelled) setError(e instanceof Error ? e.message : \"Failed to load\");\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [q, status, plan, page]);\n\n  const loadPlans = () => {\n    api<Paged<Subscription>>(\"/subscriptions?page=1&page_size=100\")\n      .then((res) => {\n        const unique = Array.from(new Set(res.items.map((s) => s.plan))).sort();\n        setPlans(unique);\n      })\n      .catch(() => {\n        /* ignore */\n      });\n  };\n\n  useEffect(loadPlans, []);\n\n  const totalPages = useMemo(() => {\n    if (!data) return 1;\n    return Math.max(1, Math.ceil(data.total / data.page_size));\n  }, [data]);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <h1 className=\"text-2xl font-semibold tracking-tight\">Subscriptions</h1>\n          <p className=\"mt-1 text-sm text-slate-500\">\n            {data ? `${data.total} subscription${data.total === 1 ? \"\" : \"s\"}` : \"Loading…\"}\n          </p>\n        </div>\n        <button\n          onClick={() => setShowCreate((v) => !v)}\n          className=\"rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700\"\n        >\n          {showCreate ? \"Close\" : \"New subscription\"}\n        </button>\n      </div>\n\n      {showCreate && (\n        <CreateSubscription\n          onCreated={() => {\n            setShowCreate(false);\n            setPage(1);\n            loadPlans();\n            api<Paged<Subscription>>(\n              `/subscriptions?page=1&page_size=${PAGE_SIZE}`,\n            ).then(setData);\n          }}\n        />\n      )}\n\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <div className=\"flex flex-wrap rounded-lg border border-slate-200 bg-white p-1\">\n          {STATUS_TABS.map((tab) => (\n            <button\n              key={tab.value}\n              onClick={() => setStatus(tab.value)}\n              className={`rounded-md px-3 py-1.5 text-sm font-medium ${\n                status === tab.value\n                  ? \"bg-slate-900 text-white\"\n                  : \"text-slate-600 hover:bg-slate-100\"\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n        <select\n          value={plan}\n          onChange={(e) => setPlan(e.target.value)}\n          className=\"rounded-md border border-slate-300 bg-white px-3 py-2 text-sm\"\n        >\n          <option value=\"\">All plans</option>\n          {plans.map((p) => (\n            <option key={p} value={p}>\n              {p}\n            </option>\n          ))}\n        </select>\n        <input\n          value={searchInput}\n          onChange={(e) => setSearchInput(e.target.value)}\n          placeholder=\"Search customer…\"\n          className=\"min-w-48 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none\"\n        />\n      </div>\n\n      {error && (\n        <div className=\"rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700\">\n          {error}\n        </div>\n      )}\n\n      <div className=\"overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm\">\n        <table className=\"min-w-full divide-y divide-slate-200 text-sm\">\n          <thead className=\"bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500\">\n            <tr>\n              <th className=\"px-4 py-3\">Customer</th>\n              <th className=\"px-4 py-3\">Plan</th>\n              <th className=\"px-4 py-3\">Monthly</th>\n              <th className=\"px-4 py-3\">Renewal</th>\n              <th className=\"px-4 py-3\">Status</th>\n              <th className=\"px-4 py-3\">Failures</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {data?.items.map((sub) => (\n              <tr\n                key={sub.id}\n                onClick={() => navigate(`/subscriptions/${sub.id}`)}\n                className=\"cursor-pointer hover:bg-slate-50\"\n              >\n                <td className=\"px-4 py-3 font-medium text-slate-900\">\n                  {sub.customer_name}\n                </td>\n                <td className=\"px-4 py-3 text-slate-600\">{sub.plan}</td>\n                <td className=\"px-4 py-3 text-slate-600\">\n                  ${sub.monthly_amount.toFixed(2)}\n                </td>\n                <td className=\"px-4 py-3 text-slate-600\">{sub.renewal_date}</td>\n                <td className=\"px-4 py-3\">\n                  <span\n                    className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${STATUS_STYLES[sub.status]}`}\n                  >\n                    {STATUS_LABELS[sub.status]}\n                  </span>\n                </td>\n                <td className=\"px-4 py-3 text-slate-600\">{sub.failed_payment_count}</td>\n              </tr>\n            ))}\n            {data && data.items.length === 0 && (\n              <tr>\n                <td colSpan={6} className=\"px-4 py-10 text-center text-slate-500\">\n                  {loading ? \"Loading…\" : \"No subscriptions match your filters.\"}\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      <div className=\"flex items-center justify-between text-sm text-slate-600\">\n        <span>\n          Page {data?.page ?? 1} of {totalPages}\n        </span>\n        <div className=\"flex gap-2\">\n          <button\n            disabled={(data?.page ?? 1) <= 1}\n            onClick={() => setPage((p) => Math.max(1, p - 1))}\n            className=\"rounded-md border border-slate-300 px-3 py-1.5 font-medium hover:bg-slate-100 disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <button\n            disabled={(data?.page ?? 1) >= totalPages}\n            onClick={() => setPage((p) => p + 1)}\n            className=\"rounded-md border border-slate-300 px-3 py-1.5 font-medium hover:bg-slate-100 disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction CreateSubscription({ onCreated }: { onCreated: () => void }) {\n  const [form, setForm] = useState({\n    customer_name: \"\",\n    plan: \"basic\",\n    monthly_amount: \"29\",\n    renewal_date: new Date().toISOString().slice(0, 10),\n    status: \"trial\",\n  });\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    try {\n      await api(\"/subscriptions\", {\n        method: \"POST\",\n        body: {\n          ...form,\n          monthly_amount: Number(form.monthly_amount),\n        },\n      });\n      onCreated();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to create\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const field =\n    \"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none\";\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"grid gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-3\"\n    >\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">Customer name</span>\n        <input\n          required\n          value={form.customer_name}\n          onChange={(e) => setForm({ ...form, customer_name: e.target.value })}\n          className={field}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">Plan</span>\n        <input\n          required\n          value={form.plan}\n          onChange={(e) => setForm({ ...form, plan: e.target.value })}\n          className={field}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">Monthly amount</span>\n        <input\n          required\n          type=\"number\"\n          step=\"0.01\"\n          min=\"0\"\n          value={form.monthly_amount}\n          onChange={(e) => setForm({ ...form, monthly_amount: e.target.value })}\n          className={field}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">Renewal date</span>\n        <input\n          required\n          type=\"date\"\n          value={form.renewal_date}\n          onChange={(e) => setForm({ ...form, renewal_date: e.target.value })}\n          className={field}\n        />\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-xs font-medium text-slate-600\">Status</span>\n        <select\n          value={form.status}\n          onChange={(e) => setForm({ ...form, status: e.target.value })}\n          className={field}\n        >\n          <option value=\"trial\">Trial</option>\n          <option value=\"active\">Active</option>\n          <option value=\"past_due\">Past due</option>\n          <option value=\"cancelled\">Cancelled</option>\n        </select>\n      </label>\n      <div className=\"flex items-end\">\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"w-full rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\"\n        >\n          {busy ? \"Creating…\" : \"Create subscription\"}\n        </button>\n      </div>\n      {error && <p className=\"text-sm text-red-600 sm:col-span-2 lg:col-span-3\">{error}</p>}\n    </form>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/SubscriptionsPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/SubscriptionsPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/SubscriptionsPage.tsx","time":{"start":1794325683899,"end":1794325683921}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6251eb2001igF5vWMic8lnP1","sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","messageID":"msg_1c624ea61001YzC2lLb4qx2wjv"}}
{"type":"step_finish","timestamp":1794325683942,"sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","part":{"id":"prt_1c6251ed4001hwvcfnKjkbmoWH","reason":"tool-calls","messageID":"msg_1c624ea61001YzC2lLb4qx2wjv","sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","type":"step-finish","tokens":{"total":27777,"input":1879,"output":3109,"reasoning":261,"cache":{"write":0,"read":22528}},"cost":0}}
{"type":"step_start","timestamp":1794325695008,"sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","part":{"id":"prt_1c6254a0d001DOu6R7fu4OOIQP","messageID":"msg_1c6251ede001LAYR2NtYk5zvkG","sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","type":"step-start"}}
{"type":"tool_use","timestamp":1794325695033,"sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","part":{"type":"tool","tool":"write","callID":"call_2cf84fa50a2c4ec29c4697f4","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api } from \"../api\";\nimport type { Invoice, Status, Subscription } from \"../types\";\n\nconst STATUS_OPTIONS: { value: Status; label: string }[] = [\n  { value: \"trial\", label: \"Trial\" },\n  { value: \"active\", label: \"Active\" },\n  { value: \"past_due\", label: \"Past due\" },\n  { value: \"cancelled\", label: \"Cancelled\" },\n];\n\nconst STATUS_STYLES: Record<Status, string> = {\n  trial: \"bg-sky-100 text-sky-800\",\n  active: \"bg-emerald-100 text-emerald-800\",\n  past_due: \"bg-amber-100 text-amber-800\",\n  cancelled: \"bg-slate-200 text-slate-700\",\n};\n\nconst STATUS_LABELS: Record<Status, string> = {\n  trial: \"Trial\",\n  active: \"Active\",\n  past_due: \"Past due\",\n  cancelled: \"Cancelled\",\n};\n\nexport function SubscriptionPage({\n  id,\n  navigate,\n}: {\n  id: number;\n  navigate: (p: string) => void;\n}) {\n  const [sub, setSub] = useState<Subscription | null>(null);\n  const [invoices, setInvoices] = useState<Invoice[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const [s, inv] = await Promise.all([\n        api<Subscription>(`/subscriptions/${id}`),\n        api<{ items: Invoice[] }>(`/subscriptions/${id}/invoices`),\n      ]);\n      setSub(s);\n      setInvoices(inv.items);\n    } catch (e) {\n      setError(e instanceof Error ? e.message : \"Failed to load\");\n    } finally {\n      setLoading(false);\n    }\n  }, [id]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  const flash = (message: string) => {\n    setNotice(message);\n    setTimeout(() => setNotice(null), 3000);\n  };\n\n  const recordCollection = async (outcome: \"failed\" | \"succeeded\") => {\n    setError(null);\n    try {\n      await api(`/subscriptions/${id}/collections`, {\n        method: \"POST\",\n        body: { outcome },\n      });\n      flash(\n        outcome === \"succeeded\"\n          ? \"Collection succeeded; open invoices marked paid.\"\n          : \"Failed collection recorded.\",\n      );\n      await load();\n    } catch (e) {\n      setError(e instanceof Error ? e.message : \"Failed to record collection\");\n    }\n  };\n\n  if (loading && !sub) {\n    return <p className=\"text-sm text-slate-500\">Loading…</p>;\n  }\n  if (!sub) {\n    return (\n      <div className=\"space-y-4\">\n        <div className=\"rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700\">\n          {error ?? \"Subscription not found.\"}\n        </div>\n        <button\n          onClick={() => navigate(\"/subscriptions\")}\n          className=\"text-sm font-medium text-slate-700 hover:underline\"\n        >\n          ← Back to subscriptions\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <button\n        onClick={() => navigate(\"/subscriptions\")}\n        className=\"text-sm font-medium text-slate-600 hover:underline\"\n      >\n        ← Back to subscriptions\n      </button>\n\n      <div className=\"flex flex-wrap items-start justify-between gap-3\">\n        <div>\n          <h1 className=\"text-2xl font-semibold tracking-tight\">{sub.customer_name}</h1>\n          <p className=\"mt-1 text-sm text-slate-500\">\n            {sub.plan} · ${sub.monthly_amount.toFixed(2)} / month · renews{\" \"}\n            {sub.renewal_date}\n          </p>\n        </div>\n        <span\n          className={`inline-flex rounded-full px-3 py-1 text-sm font-medium ${STATUS_STYLES[sub.status]}`}\n        >\n          {STATUS_LABELS[sub.status]}\n        </span>\n      </div>\n\n      {notice && (\n        <div className=\"rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800\">\n          {notice}\n        </div>\n      )}\n      {error && (\n        <div className=\"rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700\">\n          {error}\n        </div>\n      )}\n\n      <div className=\"grid gap-6 lg:grid-cols-2\">\n        <EditForm sub={sub} onSaved={(s) => { setSub(s); flash(\"Subscription updated.\"); }} onError={setError} />\n\n        <div className=\"space-y-4\">\n          <div className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\">\n            <h2 className=\"text-sm font-semibold uppercase tracking-wide text-slate-500\">\n              Collection runs\n            </h2>\n            <p className=\"mt-1 text-sm text-slate-500\">\n              Record the outcome of a collection attempt over all open invoices.\n            </p>\n            <div className=\"mt-3 flex flex-wrap gap-2\">\n              <button\n                onClick={() => recordCollection(\"succeeded\")}\n                className=\"rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500\"\n              >\n                Record successful collection\n              </button>\n              <button\n                onClick={() => recordCollection(\"failed\")}\n                className=\"rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500\"\n              >\n                Record failed collection\n              </button>\n            </div>\n            <dl className=\"mt-4 grid grid-cols-2 gap-3 text-sm\">\n              <div>\n                <dt className=\"text-slate-500\">Failed payments</dt>\n                <dd className=\"font-medium\">{sub.failed_payment_count}</dd>\n              </div>\n              <div>\n                <dt className=\"text-slate-500\">Open invoices</dt>\n                <dd className=\"font-medium\">\n                  {invoices.filter((i) => i.status === \"open\").length}\n                </dd>\n              </div>\n            </dl>\n          </div>\n\n          <IssueInvoice sub={sub} onIssued={load} onError={setError} onDone={() => flash(\"Invoice issued.\")} />\n        </div>\n      </div>\n\n      <div>\n        <h2 className=\"mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500\">\n          Invoice history\n        </h2>\n        <div className=\"overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm\">\n          <table className=\"min-w-full divide-y divide-slate-200 text-sm\">\n            <thead className=\"bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500\">\n              <tr>\n                <th className=\"px-4 py-3\">Invoice</th>\n                <th className=\"px-4 py-3\">Amount</th>\n                <th className=\"px-4 py-3\">Due date</th>\n                <th className=\"px-4 py-3\">Status</th>\n                <th className=\"px-4 py-3\">Paid at</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {invoices.map((inv) => (\n                <tr key={inv.id}>\n                  <td className=\"px-4 py-3 font-medium text-slate-900\">#{inv.id}</td>\n                  <td className=\"px-4 py-3 text-slate-600\">\n                    ${inv.amount_due.toFixed(2)}\n                  </td>\n                  <td className=\"px-4 py-3 text-slate-600\">{inv.due_date}</td>\n                  <td className=\"px-4 py-3\">\n                    <span\n                      className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${\n                        inv.status === \"paid\"\n                          ? \"bg-emerald-100 text-emerald-800\"\n                          : \"bg-slate-200 text-slate-700\"\n                      }`}\n                    >\n                      {inv.status}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3 text-slate-600\">\n                    {inv.paid_at ? new Date(inv.paid_at).toLocaleString() : \"—\"}\n                  </td>\n                </tr>\n              ))}\n              {invoices.length === 0 && (\n                <tr>\n                  <td colSpan={5} className=\"px-4 py-10 text-center text-slate-500\">\n                    No invoices yet.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction EditForm({\n  sub,\n  onSaved,\n  onError,\n}: {\n  sub: Subscription;\n  onSaved: (s: Subscription) => void;\n  onError: (msg: string) => void;\n}) {\n  const [form, setForm] = useState({\n    customer_name: sub.customer_name,\n    plan: sub.plan,\n    monthly_amount: String(sub.monthly_amount),\n    renewal_date: sub.renewal_date,\n    status: sub.status,\n  });\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    try {\n      const updated = await api<Subscription>(`/subscriptions/${sub.id}`, {\n        method: \"PATCH\",\n        body: {\n          ...form,\n          monthly_amount: Number(form.monthly_amount),\n        },\n      });\n      onSaved(updated);\n    } catch (err) {\n      onError(err instanceof Error ? err.message : \"Failed to update\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const field =\n    \"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none\";\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\"\n    >\n      <h2 className=\"text-sm font-semibold uppercase tracking-wide text-slate-500\">\n        Edit subscription\n      </h2>\n      <div className=\"mt-3 grid gap-3 sm:grid-cols-2\">\n        <label className=\"block sm:col-span-2\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Customer name</span>\n          <input\n            required\n            value={form.customer_name}\n            onChange={(e) => setForm({ ...form, customer_name: e.target.value })}\n            className={field}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Plan</span>\n          <input\n            required\n            value={form.plan}\n            onChange={(e) => setForm({ ...form, plan: e.target.value })}\n            className={field}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Monthly amount</span>\n          <input\n            required\n            type=\"number\"\n            step=\"0.01\"\n            min=\"0\"\n            value={form.monthly_amount}\n            onChange={(e) => setForm({ ...form, monthly_amount: e.target.value })}\n            className={field}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Renewal date</span>\n          <input\n            required\n            type=\"date\"\n            value={form.renewal_date}\n            onChange={(e) => setForm({ ...form, renewal_date: e.target.value })}\n            className={field}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Status</span>\n          <select\n            value={form.status}\n            onChange={(e) => setForm({ ...form, status: e.target.value as Status })}\n            className={field}\n          >\n            {STATUS_OPTIONS.map((o) => (\n              <option key={o.value} value={o.value}>\n                {o.label}\n              </option>\n            ))}\n          </select>\n        </label>\n      </div>\n      <button\n        type=\"submit\"\n        disabled={busy}\n        className=\"mt-4 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\"\n      >\n        {busy ? \"Saving…\" : \"Save changes\"}\n      </button>\n    </form>\n  );\n}\n\nfunction IssueInvoice({\n  sub,\n  onIssued,\n  onError,\n  onDone,\n}: {\n  sub: Subscription;\n  onIssued: () => Promise<void>;\n  onError: (msg: string) => void;\n  onDone: () => void;\n}) {\n  const [amount, setAmount] = useState(String(sub.monthly_amount));\n  const [dueDate, setDueDate] = useState(sub.renewal_date);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    try {\n      await api(`/subscriptions/${sub.id}/invoices`, {\n        method: \"POST\",\n        body: { amount_due: Number(amount), due_date: dueDate },\n      });\n      onDone();\n      await onIssued();\n    } catch (err) {\n      onError(err instanceof Error ? err.message : \"Failed to issue invoice\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const field =\n    \"w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none\";\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\"\n    >\n      <h2 className=\"text-sm font-semibold uppercase tracking-wide text-slate-500\">\n        Issue invoice\n      </h2>\n      <div className=\"mt-3 grid gap-3 sm:grid-cols-2\">\n        <label className=\"block\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Amount due</span>\n          <input\n            required\n            type=\"number\"\n            step=\"0.01\"\n            min=\"0\"\n            value={amount}\n            onChange={(e) => setAmount(e.target.value)}\n            className={field}\n          />\n        </label>\n        <label className=\"block\">\n          <span className=\"mb-1 block text-xs font-medium text-slate-600\">Due date</span>\n          <input\n            required\n            type=\"date\"\n            value={dueDate}\n            onChange={(e) => setDueDate(e.target.value)}\n            className={field}\n          />\n        </label>\n      </div>\n      <button\n        type=\"submit\"\n        disabled={busy}\n        className=\"mt-4 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\"\n      >\n        {busy ? \"Issuing…\" : \"Issue open invoice\"}\n      </button>\n    </form>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/SubscriptionPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/SubscriptionPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/SubscriptionPage.tsx","time":{"start":1794325695001,"end":1794325695013}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6254a110013mh7zxZfMw27bz","sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","messageID":"msg_1c6251ede001LAYR2NtYk5zvkG"}}
