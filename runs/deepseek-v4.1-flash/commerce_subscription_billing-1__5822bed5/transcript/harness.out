auth/login\", json={\"username\":\"alice\",\"password\":\"secret\"}))\ntok=r.get_json()[\"token\"]\nh={\"Authorization\":f\"Bearer {tok}\"}\nshow(c.get(\"/api/me\", headers=h))\nshow(c.get(\"/api/me\"))\n# create subs\nfor i,(name,plan,amt,st) in enumerate([\n    (\"Acme\",\"basic\",29.5,\"active\"),\n    (\"Globex\",\"pro\",99,\"past_due\"),\n    (\"Initech\",\"basic\",29.5,\"trial\"),\n    (\"Umbrella\",\"enterprise\",250.75,\"cancelled\"),\n    (\"Acme Two\",\"pro\",99,\"active\"),\n]):\n    show(c.post(\"/api/subscriptions\", headers=h, json={\"customer_name\":name,\"plan\":plan,\"monthly_amount\":amt,\"renewal_date\":\"2026-12-01\",\"status\":st}))\nshow(c.get(\"/api/public/stats\"))\nshow(c.get(\"/api/subscriptions?page=1&page_size=2\", headers=h))\nshow(c.get(\"/api/subscriptions?q=acme\", headers=h))\nshow(c.get(\"/api/subscriptions?status=past_due\", headers=h))\nshow(c.get(\"/api/subscriptions?plan=pro\", headers=h))\nshow(c.get(\"/api/subscriptions?status=bogus\", headers=h))\n# get one\nshow(c.get(\"/api/subscriptions/1\", headers=h))\n# patch\nshow(c.patch(\"/api/subscriptions/1\", headers=h, json={\"monthly_amount\":49.99}))\nshow(c.get(\"/api/subscriptions/1\", headers=h))\n# invoice\nshow(c.post(\"/api/subscriptions/1/invoices\", headers=h, json={\"amount_due\":49.99,\"due_date\":\"2026-12-01\"}))\nshow(c.post(\"/api/subscriptions/1/invoices\", headers=h, json={\"amount_due\":10}))\nshow(c.get(\"/api/subscriptions/1/invoices\", headers=h))\n# failed collection\nshow(c.post(\"/api/subscriptions/1/collections\", headers=h, json={\"outcome\":\"failed\"}))\nshow(c.get(\"/api/subscriptions/1\", headers=h))\nshow(c.get(\"/api/subscriptions/1/invoices\", headers=h))\n# successful\nshow(c.post(\"/api/subscriptions/1/collections\", headers=h, json={\"outcome\":\"succeeded\"}))\nshow(c.get(\"/api/subscriptions/1\", headers=h))\nshow(c.get(\"/api/subscriptions/1/invoices\", headers=h))\n# invalid outcome\nshow(c.post(\"/api/subscriptions/1/collections\", headers=h, json={\"outcome\":\"nope\"}))\n# not found\nshow(c.get(\"/api/subscriptions/999\", headers=h))\nshow(c.get(\"/api/subscriptions/999/invoices\", headers=h))\n# frontend\nr=c.get(\"/\"); print(\"frontend\", r.status_code, r.content_type, len(r.data))\nr=c.get(\"/subscriptions/1\"); print(\"spa\", r.status_code, len(r.data))\nr=c.get(\"/api/nope\"); print(\"api404\", r.status_code, r.get_json())\nEOF","time":{"start":1794325730932,"end":1794325731613}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c625d66a001p016TqpOVWDZy2","sessionID":"ses_e39dedc56ffeqhuaUFtNr06Dw7","messageID":"msg_1c625c2190019ys8OpxtHosHnF"}}
