um text-slate-700 transition hover:bg-slate-50\"\n              >\n                Sign out\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n    ),\n    [session],\n  );\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      {header}\n      <main className=\"mx-auto max-w-5xl space-y-6 px-4 py-6\">\n        {checking ? (\n          <p className=\"py-16 text-center text-sm text-slate-400\">Loading…</p>\n        ) : session ? (\n          <>\n            <div className=\"grid gap-6 md:grid-cols-2\">\n              <ScoreForm onSubmitted={handleScore} />\n              <MyScores refreshKey={refreshKey} bestOverride={bestOverride} />\n            </div>\n            <Leaderboard session={session} refreshKey={refreshKey} />\n            {session.is_admin && <AdminPanel refreshKey={refreshKey} />}\n          </>\n        ) : (\n          <div className=\"grid gap-6 md:grid-cols-[minmax(0,1fr)_20rem]\">\n            <Leaderboard session={session} refreshKey={refreshKey} />\n            <div className=\"space-y-4\">\n              <AuthPanel onSignedIn={handleSignedIn} />","lineStart":630,"lineEnd":699,"totalLines":709,"truncated":true}},"title":"frontend/src/App.tsx","time":{"start":1794368225919,"end":1794368225938}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8ae42740014jSp99vCHMLVfh","sessionID":"ses_e37599830ffeoTNV55QPHo6Lm3","messageID":"msg_1c8ae2e95001jUGl80HN1lfvSR"}}
