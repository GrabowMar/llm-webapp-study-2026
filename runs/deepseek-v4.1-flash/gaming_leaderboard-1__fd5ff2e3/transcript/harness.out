{"type":"tool_use","timestamp":1794368104573,"sessionID":"ses_e37599830ffeoTNV55QPHo6Lm3","part":{"type":"tool","tool":"write","callID":"call_6f1cfa14e90d4e90900f7dc4","state":{"status":"completed","input":{"content":"export type Period = \"all\" | \"week\" | \"today\";\n\nexport interface Score {\n  id: number;\n  score: number;\n  achieved_at: string;\n  is_hidden: boolean;\n  player: string;\n}\n\nexport interface NewScore extends Score {\n  rank: number | null;\n  personal_best: boolean;\n}\n\nexport interface LeaderboardItem {\n  rank: number;\n  player: string;\n  score: number;\n  achieved_at: string;\n}\n\nexport interface LeaderboardResponse {\n  items: LeaderboardItem[];\n  total: number;\n}\n\nexport interface MyScoresResponse {\n  items: Score[];\n  best_score: number | null;\n}\n\nexport interface AdminScoresResponse {\n  items: Score[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Session {\n  username: string;\n  is_admin: boolean;\n}\n\nconst TOKEN_KEY = \"leaderboard.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n  auth = true,\n): Promise<T> {\n  const headers = new Headers(options.headers);\n  if (options.body !== undefined) headers.set(\"Content-Type\", \"application/json\");\n  if (auth) {\n    const token = getToken();\n    if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  }\n  const response = await fetch(`/api${path}`, { ...options, headers });\n  const text = await response.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n  if (!response.ok) {\n    const message =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${response.status})`;\n    throw new ApiError(message, response.status);\n  }\n  return data as T;\n}\n\nexport const api = {\n  register(username: string, password: string) {\n    return request<{ id: number; username: string }>(\n      \"/auth/register\",\n      { method: \"POST\", body: JSON.stringify({ username, password }) },\n      false,\n    );\n  },\n  async login(username: string, password: string) {\n    const result = await request<{ token: string }>(\n      \"/auth/login\",\n      { method: \"POST\", body: JSON.stringify({ username, password }) },\n      false,\n    );\n    setToken(result.token);\n    return result;\n  },\n  me() {\n    return request<Session>(\"/auth/me\");\n  },\n  logout() {\n    return request<{ status: string }>(\"/auth/logout\", { method: \"POST\" });\n  },\n  leaderboard(period: Period, player: string, limit?: number) {\n    const params = new URLSearchParams({ period });\n    if (player.trim()) params.set(\"player\", player.trim());\n    if (limit !== undefined) params.set(\"limit\", String(limit));\n    return request<LeaderboardResponse>(`/leaderboard?${params}`);\n  },\n  submitScore(score: number) {\n    return request<NewScore>(\"/scores\", {\n      method: \"POST\",\n      body: JSON.stringify({ score }),\n    });\n  },\n  myScores() {\n    return request<MyScoresResponse>(\"/scores\");\n  },\n  adminScores(page: number, pageSize: number) {\n    const params = new URLSearchParams({\n      page: String(page),\n      page_size: String(pageSize),\n    });\n    return request<AdminScoresResponse>(`/admin/scores?${params}`);\n  },\n  toggleScore(id: number) {\n    return request<Score>(`/admin/scores/${id}/toggle`, { method: \"POST\" });\n  },\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794368104541,"end":1794368104550}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8ac68570014hg5s5cLXUlOWS","sessionID":"ses_e37599830ffeoTNV55QPHo6Lm3","messageID":"msg_1c8ac3a4f001BYQX9BazLMfXXa"}}
