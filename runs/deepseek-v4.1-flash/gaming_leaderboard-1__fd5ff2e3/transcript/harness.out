{"type":"tool_use","timestamp":1794368548025,"sessionID":"ses_e37599830ffeoTNV55QPHo6Lm3","part":{"type":"tool","tool":"read","callID":"call_3bad7d450df342ebbf6b140f","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Game leaderboard API and frontend server.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import secrets\n7: import sqlite3\n8: from datetime import datetime, timedelta, timezone\n9: from pathlib import Path\n10: from typing import Any\n11: \n12: from flask import Flask, g, jsonify, request, send_from_directory\n13: from werkzeug.security import check_password_hash, generate_password_hash\n14: \n15: BASE_DIR = Path(__file__).resolve().parent\n16: DIST = BASE_DIR.parent / \"frontend\" / \"dist\"\n17: DATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\n18: DB_PATH = DATA_DIR / \"leaderboard.db\"\n19: \n20: ADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\").strip()\n21: \n22: app = Flask(__name__, static_folder=None)\n23: app.config[\"JSON_SORT_KEYS\"] = False\n24: \n25: \n26: def utc_now() -> datetime:\n27:     return datetime.now(timezone.utc)\n28: \n29: \n30: def timestamp(value: datetime | None = None) -> str:\n31:     value = value or utc_now()\n32:     return value.astimezone(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n33: \n34: \n35: def cutoff_for_period(period: str | None) -> str | None:\n36:     key = (period or \"all\").strip().lower().replace(\"_\", \"-\")\n37:     if key in {\"\", \"all\", \"all-time\", \"alltime\"}:\n38:         return None\n39:     now = utc_now()\n40:     if key in {\"today\", \"day\", \"daily\"}:\n41:         start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n42:     elif key in {\"week\", \"weekly\", \"this-week\"}:\n43:         start = now.replace(hour=0, minute=0, second=0, microsecond=0) - timedelta(\n44:             days=now.weekday()\n45:         )\n46:     else:\n47:         raise ValueError(\"invalid period\")\n48:     return start.strftime(\"%Y-%m-%d %H:%M:%S\")\n49: \n50: \n51: def get_db() -> sqlite3.Connection:\n52:     if \"db\" not in g:\n53:         connection = sqlite3.connect(DB_PATH, timeout=30)\n54:         connection.row_factory = sqlite3.Row\n55:         connection.execute(\"PRAGMA foreign_keys = ON\")\n56:         connection.execute(\"PRAGMA journal_mode = WAL\")\n57:         g.db = connection\n58:     return g.db\n59: \n60: \n61: @app.teardown_appcontext\n62: def close_db(_error: BaseException | None) -> None:\n63:     connection = g.pop(\"db\", None)\n64:     if connection is not None:\n65:         connection.close()\n66: \n67: \n68: def init_db() -> None:\n69:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n70:     connection = sqlite3.connect(DB_PATH, timeout=30)\n71:     try:\n72:         connection.row_factory = sqlite3.Row\n73:         connection.execute(\"PRAGMA journal_mode = WAL\")\n74:         connection.executescript(\n75:             \"\"\"\n76:             CREATE TABLE IF NOT EXISTS users (\n77:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n78:                 username TEXT NOT NULL UNIQUE,\n79:                 password_hash TEXT NOT NULL,\n80:                 is_admin INTEGER NOT NULL DEFAULT 0,\n81:                 created_at TEXT NOT NULL\n82:             );\n83: \n84:             CREATE TABLE IF NOT EXISTS sessions (\n85:                 token TEXT PRIMARY KEY,\n86:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n87:                 created_at TEXT NOT NULL\n88:             );\n89: \n90:             CREATE TABLE IF NOT EXISTS scores (\n91:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n92:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n93:                 score INTEGER NOT NULL,\n94:                 achieved_at TEXT NOT NULL,\n95:                 is_hidden INTEGER NOT NULL DEFAULT 0\n96:             );\n97: \n98:             CREATE INDEX IF NOT EXISTS scores_user_idx ON scores(user_id);\n99:             CREATE INDEX IF NOT EXISTS scores_visible_idx ON scores(is_hidden, score);\n100:             \"\"\"\n101:         )\n102:         admin = connection.execute(\n103:             \"SELECT id FROM users WHERE lower(username) = 'admin'\"\n104:         ).fetchone()\n105:         if ADMIN_PASSWORD:\n106:             password_hash = generate_password_hash(ADMIN_PASSWORD)\n107:             if admin is None:\n108:                 connection.execute(\n109:                     \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n110:                     \"VALUES (?, ?, 1, ?)\",\n111:                     (\"admin\", password_hash, timestamp()),\n112:                 )\n113:             else:\n114:                 connection.execute(\n115:                     \"UPDATE users SET username = 'admin', password_hash = ?, is_admin = 1 \"\n116:                     \"WHERE id = ?\",\n117:                     (password_hash, admin[\"id\"]),\n118:                 )\n119:         elif admin is not None:\n120:             # No configured password: make sure any previously configured admin\n121:             # credentials and sessions can no longer be used.\n122:             connection.execute(\n123:                 \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n124:                 (generate_password_hash(secrets.token_urlsafe(32)), admin[\"id\"]),\n125:             )\n126:             connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n127:         connection.commit()\n128:     finally:\n129:         connection.close()\n130: \n131: \n132: def json_error(message: str, status: int = 400):\n133:     return jsonify({\"error\": message}), status\n134: \n135: \n136: def request_json() -> dict[str, Any] | None:\n137:     payload = request.get_json(silent=True)\n138:     if not isinstance(payload, dict):\n139:         return None\n140:     return payload\n141: \n142: \n143: def bearer_token() -> str | None:\n144:     header = request.headers.get(\"Authorization\", \"\")\n145:     if not header:\n146:         return None\n147:     scheme, _, token = header.partition(\" \")\n148:     if scheme.lower() != \"bearer\" or not token.strip():\n149:         return None\n150:     return token.strip()\n151: \n152: \n153: def current_user() -> sqlite3.Row | None:\n154:     token = bearer_token()\n155:     if token is None:\n156:         return None\n157:     return get_db().execute(\n158:         \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n159:         (token,),\n160:     ).fetchone()\n161: \n162: \n163: def require_user() -> sqlite3.Row | None:\n164:     return current_user()\n165: \n166: \n167: def admin_guard():\n168:     \"\"\"Return (user, None) for an admin, otherwise (None, error response).\"\"\"\n169:     user = current_user()\n170:     if user is None:\n171:         return None, json_error(\"authentication required\", 401)\n172:     if not user[\"is_admin\"]:\n173:         return None, json_error(\"admin access required\", 403)\n174:     return user, None\n175: \n176: \n177: def parse_score(value: Any) -> int | None:\n178:     if isinstance(value, bool):\n179:         return None\n180:     if isinstance(value, int):\n181:         return value\n182:     if isinstance(value, float) and value.is_integer():\n183:         return int(value)\n184:     if isinstance(value, str):\n185:         text = value.strip()\n186:         try:\n187:             return int(text)\n188:         except ValueError:\n189:             return None\n190:     return None\n191: \n192: \n193: def score_dict(row: sqlite3.Row, **extra: Any) -> dict[str, Any]:\n194:     item = {\n195:         \"id\": row[\"id\"],\n196:         \"score\": row[\"score\"],\n197:         \"achieved_at\": row[\"achieved_at\"],\n198:         \"is_hidden\": bool(row[\"is_hidden\"]),\n199:         \"player\": row[\"username\"],\n200:     }\n201:     item.update(extra)\n202:     return item\n203: \n204: \n205: def leaderboard_rows(period: str | None, player: str | None) -> list[sqlite3.Row]:\n206:     cutoff = cutoff_for_period(period)\n207:     sql = [\n208:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username\",\n209:         \"FROM scores s JOIN users u ON u.id = s.user_id\",\n210:         \"WHERE s.is_hidden = 0\",\n211:     ]\n212:     params: list[Any] = []\n213:     if cutoff is not None:\n214:         sql.append(\"AND datetime(s.achieved_at) >= datetime(?)\")\n215:         params.append(cutoff)\n216:     if player:\n217:         escaped = player.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n218:         sql.append(\"AND u.username LIKE ? ESCAPE '\\\\'\")\n219:         params.append(f\"%{escaped}%\")\n220:     sql.append(\"ORDER BY s.score DESC, datetime(s.achieved_at) ASC, s.id ASC\")\n221:     rows = get_db().execute(\" \".join(sql), params).fetchall()\n222: \n223:     best_by_user: list[sqlite3.Row] = []\n224:     seen: set[int] = set()\n225:     for row in rows:\n226:         if row[\"user_id\"] in seen:\n227:             continue\n228:         seen.add(row[\"user_id\"])\n229:         best_by_user.append(row)\n230:     return best_by_user\n231: \n232: \n233: def compose_leaderboard(period: str | None, player: str | None, limit: int | None):\n234:     best = leaderboard_rows(period, player)\n235:     total = len(best)\n236:     if limit is not None:\n237:         best = best[:limit]\n238:     items = [\n239:         {\n240:             \"rank\": index + 1,\n241:             \"player\": row[\"username\"],\n242:             \"score\": row[\"score\"],\n243:             \"achieved_at\": row[\"achieved_at\"],\n244:         }\n245:         for index, row in enumerate(best)\n246:     ]\n247:     return items, total\n248: \n249: \n250: @app.get(\"/api/health\")\n251: def health():\n252:     return {\"status\": \"ok\"}\n253: \n254: \n255: @app.post(\"/api/auth/register\")\n256: def register():\n257:     payload = request_json()\n258:     if payload is None:\n259:         return json_error(\"invalid JSON body\")\n260:     username = payload.get(\"username\")\n261:     password = payload.get(\"password\")\n262:     if not isinstance(username, str) or not username.strip():\n263:         return json_error(\"username is required\")\n264:     if not isinstance(password, str) or not password:\n265:         return json_error(\"password is required\")\n266:     username = username.strip()\n267:     if username.lower() == \"admin\":\n268:         return json_error(\"username is reserved\", 409)\n269: \n270:     db = get_db()\n271:     existing = db.execute(\n272:         \"SELECT id FROM users WHERE username = ?\", (username,)\n273:     ).fetchone()\n274:     if existing is not None:\n275:         return json_error(\"username already taken\", 409)\n276: \n277:     try:\n278:         cursor = db.execute(\n279:             \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n280:             \"VALUES (?, ?, 0, ?)\",\n281:             (username, generate_password_hash(password), timestamp()),\n282:         )\n283:         db.commit()\n284:     except sqlite3.IntegrityError:\n285:         db.rollback()\n286:         return json_error(\"username already taken\", 409)\n287: \n288:     return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n289: \n290: \n291: @app.post(\"/api/auth/login\")\n292: def login():\n293:     payload = request_json()\n294:     if payload is None:\n295:         return json_error(\"invalid JSON body\")\n296:     username = payload.get(\"username\")\n297:     password = payload.get(\"password\")\n298:     if not isinstance(username, str) or not isinstance(password, str):\n299:         return json_error(\"username and password are required\")\n300:     username = username.strip()\n301: \n302:     db = get_db()\n303:     user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n304:     if user is None or not check_password_hash(user[\"password_hash\"], password):\n305:         return json_error(\"invalid credentials\", 401)\n306:     if user[\"is_admin\"] and not ADMIN_PASSWORD:\n307:         return json_error(\"admin sign-in is disabled\", 401)\n308: \n309:     token = secrets.token_urlsafe(32)\n310:     db.execute(\n311:         \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n312:         (token, user[\"id\"], timestamp()),\n313:     )\n314:     db.commit()\n315:     return jsonify({\"token\": token})\n316: \n317: \n318: @app.get(\"/api/auth/me\")\n319: def me():\n320:     user = current_user()\n321:     if user is None:\n322:         return json_error(\"authentication required\", 401)\n323:     return jsonify({\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])})\n324: \n325: \n326: @app.post(\"/api/auth/logout\")\n327: def logout():\n328:     token = bearer_token()\n329:     if token is not None:\n330:         db = get_db()\n331:         db.execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n332:         db.commit()\n333:     return jsonify({\"status\": \"ok\"})\n334: \n335: \n336: @app.get(\"/api/leaderboard\")\n337: def leaderboard():\n338:     period = request.args.get(\"period\", \"all\")\n339:     player = request.args.get(\"player\")\n340:     if player is not None:\n341:         player = player.strip() or None\n342:     limit_value = request.args.get(\"limit\")\n343:     limit: int | None = None\n344:     if limit_value is not None and limit_value != \"\":\n345:         try:\n346:             limit = int(limit_value)\n347:         except ValueError:\n348:             return json_error(\"limit must be an integer\")\n349:         if limit < 0:\n350:             return json_error(\"limit must be non-negative\")\n351:     try:\n352:         items, total = compose_leaderboard(period, player, limit)\n353:     except ValueError:\n354:         return json_error(\"invalid period\")\n355:     return jsonify({\"items\": items, \"total\": total})\n356: \n357: \n358: @app.post(\"/api/scores\")\n359: def create_score():\n360:     user = require_user()\n361:     if user is None:\n362:         return json_error(\"authentication required\", 401)\n363: \n364:     payload = request_json()\n365:     if payload is None:\n366:         return json_error(\"invalid JSON body\")\n367:     score = parse_score(payload.get(\"score\"))\n368:     if score is None:\n369:         return json_error(\"score must be an integer\")\n370: \n371:     db = get_db()\n372:     existing_best = db.execute(\n373:         \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n374:         (user[\"id\"],),\n375:     ).fetchone()[\"best\"]\n376:     cursor = db.execute(\n377:         \"INSERT INTO scores (user_id, score, achieved_at, is_hidden) VALUES (?, ?, ?, 0)\",\n378:         (user[\"id\"], score, timestamp()),\n379:     )\n380:     db.commit()\n381:     row = db.execute(\n382:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n383:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n384:         (cursor.lastrowid,),\n385:     ).fetchone()\n386: \n387:     personal_best = existing_best is None or score >= existing_best\n388:     items, _total = compose_leaderboard(\"all\", None, None)\n389:     rank = next(\n390:         (item[\"rank\"] for item in items if item[\"player\"] == user[\"username\"]),\n391:         None,\n392:     )\n393:     return jsonify(score_dict(row, rank=rank, personal_best=personal_best)), 201\n394: \n395: \n396: @app.get(\"/api/scores\")\n397: def my_scores():\n398:     user = require_user()\n399:     if user is None:\n400:         return json_error(\"authentication required\", 401)\n401: \n402:     db = get_db()\n403:     rows = db.execute(\n404:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n405:         \"FROM scores s JOIN users u ON u.id = s.user_id \"\n406:         \"WHERE s.user_id = ? \"\n407:         \"ORDER BY datetime(s.achieved_at) DESC, s.id DESC\",\n408:         (user[\"id\"],),\n409:     ).fetchall()\n410:     best = db.execute(\n411:         \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n412:         (user[\"id\"],),\n413:     ).fetchone()[\"best\"]\n414:     return jsonify(\n415:         {\"items\": [score_dict(row) for row in rows], \"best_score\": best}\n416:     )\n417: \n418: \n419: @app.get(\"/api/admin/scores\")\n420: def admin_scores():\n421:     _user, error = admin_guard()\n422:     if error is not None:\n423:         return error\n424: \n425:     try:\n426:         page = int(request.args.get(\"page\", 1))\n427:         page_size = int(request.args.get(\"page_size\", 20))\n428:     except ValueError:\n429:         return json_error(\"page and page_size must be integers\")\n430:     page = max(page, 1)\n431:     if page_size < 1:\n432:         return json_error(\"page_size must be positive\")\n433:     page_size = min(page_size, 200)\n434: \n435:     db = get_db()\n436:     total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n437:     rows = db.execute(\n438:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n439:         \"FROM scores s JOIN users u ON u.id = s.user_id \"\n440:         \"ORDER BY datetime(s.achieved_at) DESC, s.id DESC \"\n441:         \"LIMIT ? OFFSET ?\",\n442:         (page_size, (page - 1) * page_size),\n443:     ).fetchall()\n444:     return jsonify(\n445:         {\n446:             \"items\": [score_dict(row) for row in rows],\n447:             \"total\": total,\n448:             \"page\": page,\n449:             \"page_size\": page_size,\n450:         }\n451:     )\n452: \n453: \n454: @app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n455: def toggle_score(score_id: int):\n456:     _user, error = admin_guard()\n457:     if error is not None:\n458:         return error\n459: \n460:     db = get_db()\n461:     row = db.execute(\n462:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n463:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n464:         (score_id,),\n465:     ).fetchone()\n466:     if row is None:\n467:         return json_error(\"score not found\", 404)\n468: \n469:     db.execute(\n470:         \"UPDATE scores SET is_hidden = ? WHERE id = ?\",\n471:         (0 if row[\"is_hidden\"] else 1, score_id),\n472:     )\n473:     db.commit()\n474:     updated = db.execute(\n475:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n476:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n477:         (score_id,),\n478:     ).fetchone()\n479:     return jsonify(score_dict(updated))\n480: \n481: \n482: @app.get(\"/\")\n483: @app.get(\"/<path:path>\")\n484: def frontend(path: str = \"index.html\"):\n485:     if path.startswith(\"api/\"):\n486:         return json_error(\"not found\", 404)\n487:     if (DIST / path).is_file():\n488:         return send_from_directory(DIST, path)\n489:     return send_from_directory(DIST, \"index.html\")\n490: \n491: \n492: init_db()\n493: \n494: \n495: if __name__ == \"__main__\":\n496:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")), debug=True)\n\n(End of file - total 496 lines)\n</content>","metadata":{"preview":"\"\"\"Game leaderboard API and frontend server.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\").strip()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Game leaderboard API and frontend server.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\").strip()\n\napp = Flask(__name__, static_folder=None)\napp.config[\"JSON_SORT_KEYS\"] = False\n\n\ndef utc_now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef timestamp(value: datetime | None = None) -> str:\n    value = value or utc_now()\n    return value.astimezone(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef cutoff_for_period(period: str | None) -> str | None:\n    key = (period or \"all\").strip().lower().replace(\"_\", \"-\")\n    if key in {\"\", \"all\", \"all-time\", \"alltime\"}:\n        return None\n    now = utc_now()\n    if key in {\"today\", \"day\", \"daily\"}:\n        start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n    elif key in {\"week\", \"weekly\", \"this-week\"}:\n        start = now.replace(hour=0, minute=0, second=0, microsecond=0) - timedelta(\n            days=now.weekday()\n        )\n    else:\n        raise ValueError(\"invalid period\")\n    return start.strftime(\"%Y-%m-%d %H:%M:%S\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        connection = sqlite3.connect(DB_PATH, timeout=30)\n        connection.row_factory = sqlite3.Row\n        connection.execute(\"PRAGMA foreign_keys = ON\")\n        connection.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = connection\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error: BaseException | None) -> None:\n    connection = g.pop(\"db\", None)\n    if connection is not None:\n        connection.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    connection = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        connection.row_factory = sqlite3.Row\n        connection.execute(\"PRAGMA journal_mode = WAL\")\n        connection.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS scores (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                score INTEGER NOT NULL,\n                achieved_at TEXT NOT NULL,\n                is_hidden INTEGER NOT NULL DEFAULT 0\n            );\n\n            CREATE INDEX IF NOT EXISTS scores_user_idx ON scores(user_id);\n            CREATE INDEX IF NOT EXISTS scores_visible_idx ON scores(is_hidden, score);\n            \"\"\"\n        )\n        admin = connection.execute(\n            \"SELECT id FROM users WHERE lower(username) = 'admin'\"\n        ).fetchone()\n        if ADMIN_PASSWORD:\n            password_hash = generate_password_hash(ADMIN_PASSWORD)\n            if admin is None:\n                connection.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n                    \"VALUES (?, ?, 1, ?)\",\n                    (\"admin\", password_hash, timestamp()),\n                )\n            else:\n                connection.execute(\n                    \"UPDATE users SET username = 'admin', password_hash = ?, is_admin = 1 \"\n                    \"WHERE id = ?\",\n                    (password_hash, admin[\"id\"]),\n                )\n        elif admin is not None:\n            # No configured password: make sure any previously configured admin\n            # credentials and sessions can no longer be used.\n            connection.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(secrets.token_urlsafe(32)), admin[\"id\"]),\n            )\n            connection.execute(\"DELETE FROM sessions WHERE user_id = ?\", (admin[\"id\"],))\n        connection.commit()\n    finally:\n        connection.close()\n\n\ndef json_error(message: str, status: int = 400):\n    return jsonify({\"error\": message}), status\n\n\ndef request_json() -> dict[str, Any] | None:\n    payload = request.get_json(silent=True)\n    if not isinstance(payload, dict):\n        return None\n    return payload\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header:\n        return None\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    return token.strip()\n\n\ndef current_user() -> sqlite3.Row | None:\n    token = bearer_token()\n    if token is None:\n        return None\n    return get_db().execute(\n        \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n\n\ndef require_user() -> sqlite3.Row | None:\n    return current_user()\n\n\ndef admin_guard():\n    \"\"\"Return (user, None) for an admin, otherwise (None, error response).\"\"\"\n    user = current_user()\n    if user is None:\n        return None, json_error(\"authentication required\", 401)\n    if not user[\"is_admin\"]:\n        return None, json_error(\"admin access required\", 403)\n    return user, None\n\n\ndef parse_score(value: Any) -> int | None:\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n    if isinstance(value, str):\n        text = value.strip()\n        try:\n            return int(text)\n        except ValueError:\n            return None\n    return None\n\n\ndef score_dict(row: sqlite3.Row, **extra: Any) -> dict[str, Any]:\n    item = {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"achieved_at\": row[\"achieved_at\"],\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n    item.update(extra)\n    return item\n\n\ndef leaderboard_rows(period: str | None, player: str | None) -> list[sqlite3.Row]:\n    cutoff = cutoff_for_period(period)\n    sql = [\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username\",\n        \"FROM scores s JOIN users u ON u.id = s.user_id\",\n        \"WHERE s.is_hidden = 0\",\n    ]\n    params: list[Any] = []\n    if cutoff is not None:\n        sql.append(\"AND datetime(s.achieved_at) >= datetime(?)\")\n        params.append(cutoff)\n    if player:\n        escaped = player.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        sql.append(\"AND u.username LIKE ? ESCAPE '\\\\'\")\n        params.append(f\"%{escaped}%\")\n    sql.append(\"ORDER BY s.score DESC, datetime(s.achieved_at) ASC, s.id ASC\")\n    rows = get_db().execute(\" \".join(sql), params).fetchall()\n\n    best_by_user: list[sqlite3.Row] = []\n    seen: set[int] = set()\n    for row in rows:\n        if row[\"user_id\"] in seen:\n            continue\n        seen.add(row[\"user_id\"])\n        best_by_user.append(row)\n    return best_by_user\n\n\ndef compose_leaderboard(period: str | None, player: str | None, limit: int | None):\n    best = leaderboard_rows(period, player)\n    total = len(best)\n    if limit is not None:\n        best = best[:limit]\n    items = [\n        {\n            \"rank\": index + 1,\n            \"player\": row[\"username\"],\n            \"score\": row[\"score\"],\n            \"achieved_at\": row[\"achieved_at\"],\n        }\n        for index, row in enumerate(best)\n    ]\n    return items, total\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    payload = request_json()\n    if payload is None:\n        return json_error(\"invalid JSON body\")\n    username = payload.get(\"username\")\n    password = payload.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return json_error(\"username is required\")\n    if not isinstance(password, str) or not password:\n        return json_error(\"password is required\")\n    username = username.strip()\n    if username.lower() == \"admin\":\n        return json_error(\"username is reserved\", 409)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return json_error(\"username already taken\", 409)\n\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n            \"VALUES (?, ?, 0, ?)\",\n            (username, generate_password_hash(password), timestamp()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        db.rollback()\n        return json_error(\"username already taken\", 409)\n\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    payload = request_json()\n    if payload is None:\n        return json_error(\"invalid JSON body\")\n    username = payload.get(\"username\")\n    password = payload.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"username and password are required\")\n    username = username.strip()\n\n    db = get_db()\n    user = db.execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return json_error(\"invalid credentials\", 401)\n    if user[\"is_admin\"] and not ADMIN_PASSWORD:\n        return json_error(\"admin sign-in is disabled\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], timestamp()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return json_error(\"authentication required\", 401)\n    return jsonify({\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])})\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    token = bearer_token()\n    if token is not None:\n        db = get_db()\n        db.execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n        db.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    period = request.args.get(\"period\", \"all\")\n    player = request.args.get(\"player\")\n    if player is not None:\n        player = player.strip() or None\n    limit_value = request.args.get(\"limit\")\n    limit: int | None = None\n    if limit_value is not None and limit_value != \"\":\n        try:\n            limit = int(limit_value)\n        except ValueError:\n            return json_error(\"limit must be an integer\")\n        if limit < 0:\n            return json_error(\"limit must be non-negative\")\n    try:\n        items, total = compose_leaderboard(period, player, limit)\n    except ValueError:\n        return json_error(\"invalid period\")\n    return jsonify({\"items\": items, \"total\": total})\n\n\n@app.post(\"/api/scores\")\ndef create_score():\n    user = require_user()\n    if user is None:\n        return json_error(\"authentication required\", 401)\n\n    payload = request_json()\n    if payload is None:\n        return json_error(\"invalid JSON body\")\n    score = parse_score(payload.get(\"score\"))\n    if score is None:\n        return json_error(\"score must be an integer\")\n\n    db = get_db()\n    existing_best = db.execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n        (user[\"id\"],),\n    ).fetchone()[\"best\"]\n    cursor = db.execute(\n        \"INSERT INTO scores (user_id, score, achieved_at, is_hidden) VALUES (?, ?, ?, 0)\",\n        (user[\"id\"], score, timestamp()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n\n    personal_best = existing_best is None or score >= existing_best\n    items, _total = compose_leaderboard(\"all\", None, None)\n    rank = next(\n        (item[\"rank\"] for item in items if item[\"player\"] == user[\"username\"]),\n        None,\n    )\n    return jsonify(score_dict(row, rank=rank, personal_best=personal_best)), 201\n\n\n@app.get(\"/api/scores\")\ndef my_scores():\n    user = require_user()\n    if user is None:\n        return json_error(\"authentication required\", 401)\n\n    db = get_db()\n    rows = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"WHERE s.user_id = ? \"\n        \"ORDER BY datetime(s.achieved_at) DESC, s.id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    best = db.execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n        (user[\"id\"],),\n    ).fetchone()[\"best\"]\n    return jsonify(\n        {\"items\": [score_dict(row) for row in rows], \"best_score\": best}\n    )\n\n\n@app.get(\"/api/admin/scores\")\ndef admin_scores():\n    _user, error = admin_guard()\n    if error is not None:\n        return error\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 20))\n    except ValueError:\n        return json_error(\"page and page_size must be integers\")\n    page = max(page, 1)\n    if page_size < 1:\n        return json_error(\"page_size must be positive\")\n    page_size = min(page_size, 200)\n\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"ORDER BY datetime(s.achieved_at) DESC, s.id DESC \"\n        \"LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\ndef toggle_score(score_id: int):\n    _user, error = admin_guard()\n    if error is not None:\n        return error\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    if row is None:\n        return json_error(\"score not found\", 404)\n\n    db.execute(\n        \"UPDATE scores SET is_hidden = ? WHERE id = ?\",\n        (0 if row[\"is_hidden\"] else 1, score_id),\n    )\n    db.commit()\n    updated = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    return jsonify(score_dict(updated))\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return json_error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")), debug=True)","lineStart":1,"lineEnd":496,"totalLines":496,"truncated":false}},"title":"backend/app.py","time":{"start":1794368547997,"end":1794368548006}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b32c97001Mwx2ltllSfhk8u","sessionID":"ses_e37599830ffeoTNV55QPHo6Lm3","messageID":"msg_1c8b317d6001SSK59idM6xpEQJ"}}
