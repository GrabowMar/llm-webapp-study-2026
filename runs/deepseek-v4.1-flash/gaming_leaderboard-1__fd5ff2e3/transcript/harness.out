 \n458:     db = get_db()\n459:     row = db.execute(\n460:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n461:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n462:         (score_id,),\n463:     ).fetchone()\n464:     if row is None:\n465:         return json_error(\"score not found\", 404)\n466: \n467:     db.execute(\n468:         \"UPDATE scores SET is_hidden = ? WHERE id = ?\",\n469:         (0 if row[\"is_hidden\"] else 1, score_id),\n470:     )\n471:     db.commit()\n472:     updated = db.execute(\n473:         \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n474:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n\n(Showing lines 415-474 of 494. Use offset=475 to continue.)\n</content>","metadata":{"preview":"        {\"items\": [score_dict(row) for row in rows], \"best_score\": best}\n    )\n\n\n@app.get(\"/api/admin/scores\")\ndef admin_scores():\n    if require_admin() is None:\n        return json_error(\"admin authentication required\", 401)\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 20))\n    except ValueError:\n        return json_error(\"page and page_size must be integers\")\n    page = max(page, 1)\n    if page_size < 1:\n        return json_error(\"page_size must be positive\")\n    page_size = min(page_size, 200)\n\n    db = get_db()","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"        {\"items\": [score_dict(row) for row in rows], \"best_score\": best}\n    )\n\n\n@app.get(\"/api/admin/scores\")\ndef admin_scores():\n    if require_admin() is None:\n        return json_error(\"admin authentication required\", 401)\n\n    try:\n        page = int(request.args.get(\"page\", 1))\n        page_size = int(request.args.get(\"page_size\", 20))\n    except ValueError:\n        return json_error(\"page and page_size must be integers\")\n    page = max(page, 1)\n    if page_size < 1:\n        return json_error(\"page_size must be positive\")\n    page_size = min(page_size, 200)\n\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"ORDER BY datetime(s.achieved_at) DESC, s.id DESC \"\n        \"LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\ndef toggle_score(score_id: int):\n    if require_admin() is None:\n        return json_error(\"admin authentication required\", 401)\n\n    db = get_db()\n    row = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    if row is None:\n        return json_error(\"score not found\", 404)\n\n    db.execute(\n        \"UPDATE scores SET is_hidden = ? WHERE id = ?\",\n        (0 if row[\"is_hidden\"] else 1, score_id),\n    )\n    db.commit()\n    updated = db.execute(\n        \"SELECT s.id, s.user_id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",","lineStart":415,"lineEnd":474,"totalLines":494,"truncated":true}},"title":"backend/app.py","time":{"start":1794368345769,"end":1794368345780}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b016a3001Jg8v1gzXEHVJpK","sessionID":"ses_e37599830ffeoTNV55QPHo6Lm3","messageID":"msg_1c8b00256001fumqiS2lfdAMqz"}}
