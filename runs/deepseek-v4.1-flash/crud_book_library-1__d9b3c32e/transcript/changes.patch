diff --git a/frontend/src/App.tsx b/frontend/src/App.tsx
index fee9f48..783c7a7 100644
--- a/frontend/src/App.tsx
+++ b/frontend/src/App.tsx
@@ -1,3 +1,53 @@
+import { useEffect } from "react";
+import { AuthProvider } from "./auth";
+import { Layout } from "./components/Layout";
+import { useLocation } from "./router";
+import BooksPage from "./pages/BooksPage";
+import BookPage from "./pages/BookPage";
+import BookFormPage from "./pages/BookFormPage";
+import AuthPage from "./pages/AuthPage";
+
+function Router() {
+  const location = useLocation();
+  const path = location.split("?")[0];
+
+  useEffect(() => {
+    window.scrollTo({ top: 0 });
+  }, [path]);
+
+  let element: React.ReactNode;
+  let match: RegExpMatchArray | null;
+
+  if (path === "/" || path === "") {
+    element = <BooksPage />;
+  } else if ((match = path.match(/^\/books\/new$/))) {
+    element = <BookFormPage />;
+  } else if ((match = path.match(/^\/books\/(\d+)\/edit$/))) {
+    element = <BookFormPage id={Number(match[1])} />;
+  } else if ((match = path.match(/^\/books\/(\d+)$/))) {
+    element = <BookPage id={Number(match[1])} />;
+  } else if (path === "/auth" || path === "/login") {
+    element = <AuthPage initialMode="login" />;
+  } else if (path === "/register") {
+    element = <AuthPage initialMode="register" />;
+  } else {
+    element = (
+      <div className="space-y-4 text-center">
+        <h1 className="text-2xl font-bold">Page not found</h1>
+        <a href="/" className="text-indigo-600 hover:underline">
+          Back to books
+        </a>
+      </div>
+    );
+  }
+
+  return <Layout>{element}</Layout>;
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  return (
+    <AuthProvider>
+      <Router />
+    </AuthProvider>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..d15d024
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,167 @@
+export type Book = {
+  id: number;
+  title: string;
+  author: string;
+  year: number | null;
+  isbn: string | null;
+  created_at: string;
+  review_count: number;
+  average_rating: number | null;
+};
+
+export type Review = {
+  id: number;
+  book_id: number;
+  rating: number;
+  comment: string;
+  created_at: string;
+  username: string;
+};
+
+export type PagedBooks = {
+  items: Book[];
+  total: number;
+  page: number;
+  page_size: number;
+};
+
+export type BookInput = {
+  title: string;
+  author: string;
+  year: string;
+  isbn: string;
+};
+
+const TOKEN_KEY = "library.token";
+const USER_KEY = "library.username";
+
+export function getToken(): string | null {
+  return localStorage.getItem(TOKEN_KEY);
+}
+
+export function getUsername(): string | null {
+  return localStorage.getItem(USER_KEY);
+}
+
+export function setSession(token: string, username: string) {
+  localStorage.setItem(TOKEN_KEY, token);
+  localStorage.setItem(USER_KEY, username);
+}
+
+export function clearSession() {
+  localStorage.removeItem(TOKEN_KEY);
+  localStorage.removeItem(USER_KEY);
+}
+
+export class ApiError extends Error {
+  status: number;
+  constructor(message: string, status: number) {
+    super(message);
+    this.status = status;
+  }
+}
+
+async function request<T>(
+  path: string,
+  options: RequestInit = {},
+  auth = true,
+): Promise<T> {
+  const headers = new Headers(options.headers);
+  if (options.body) headers.set("Content-Type", "application/json");
+  const token = getToken();
+  if (auth && token) headers.set("Authorization", `Bearer ${token}`);
+
+  const res = await fetch(path, { ...options, headers });
+  const text = await res.text();
+  let data: any = null;
+  if (text) {
+    try {
+      data = JSON.parse(text);
+    } catch {
+      data = null;
+    }
+  }
+  if (!res.ok) {
+    const message =
+      (data && (data.error || data.message)) ||
+      `Request failed (${res.status}).`;
+    throw new ApiError(message, res.status);
+  }
+  return data as T;
+}
+
+export function register(username: string, password: string) {
+  return request(
+    "/api/auth/register",
+    { method: "POST", body: JSON.stringify({ username, password }) },
+    false,
+  );
+}
+
+export async function login(username: string, password: string) {
+  const data = await request<{ token: string }>(
+    "/api/auth/login",
+    { method: "POST", body: JSON.stringify({ username, password }) },
+    false,
+  );
+  setSession(data.token, username);
+  return data;
+}
+
+export function logout() {
+  clearSession();
+}
+
+export function listBooks(params: {
+  q?: string;
+  page?: number;
+  page_size?: number;
+}) {
+  const search = new URLSearchParams();
+  if (params.q) search.set("q", params.q);
+  if (params.page) search.set("page", String(params.page));
+  if (params.page_size) search.set("page_size", String(params.page_size));
+  const qs = search.toString();
+  return request<PagedBooks>(`/api/books${qs ? `?${qs}` : ""}`, {}, false);
+}
+
+export function getBook(id: number) {
+  return request<Book>(`/api/books/${id}`, {}, false);
+}
+
+export function createBook(input: BookInput) {
+  return request<Book>("/api/books", {
+    method: "POST",
+    body: JSON.stringify(input),
+  });
+}
+
+export function updateBook(id: number, input: BookInput) {
+  return request<Book>(`/api/books/${id}`, {
+    method: "PUT",
+    body: JSON.stringify(input),
+  });
+}
+
+export function deleteBook(id: number) {
+  return request<{ ok: boolean }>(`/api/books/${id}`, { method: "DELETE" });
+}
+
+export function listReviews(bookId: number) {
+  return request<{ items: Review[] }>(
+    `/api/books/${bookId}/reviews`,
+    {},
+    false,
+  );
+}
+
+export function createReview(
+  bookId: number,
+  rating: number,
+  comment: string,
+) {
+  return request<Review>(`/api/books/${bookId}/reviews`, {
+    method: "POST",
+    body: JSON.stringify({ rating, comment }),
+  });
+}
diff --git a/frontend/src/auth.tsx b/frontend/src/auth.tsx
new file mode 100644
index 0000000..481e1b4
--- /dev/null
+++ b/frontend/src/auth.tsx
@@ -0,0 +1,60 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useState,
+} from "react";
+import {
+  clearSession,
+  getUsername,
+  login as apiLogin,
+  register as apiRegister,
+} from "./api";
+
+type AuthContextValue = {
+  username: string | null;
+  signIn: (username: string, password: string) => Promise<void>;
+  signUp: (username: string, password: string) => Promise<void>;
+  signOut: () => void;
+};
+
+const AuthContext = createContext<AuthContextValue | null>(null);
+
+export function AuthProvider({ children }: { children: React.ReactNode }) {
+  const [username, setUsername] = useState<string | null>(() => getUsername());
+
+  const signIn = useCallback(async (u: string, p: string) => {
+    await apiLogin(u, p);
+    setUsername(u);
+  }, []);
+
+  const signUp = useCallback(async (u: string, p: string) => {
+    await apiRegister(u, p);
+    await apiLogin(u, p);
+    setUsername(u);
+  }, []);
+
+  const signOut = useCallback(() => {
+    clearSession();
+    setUsername(null);
+  }, []);
+
+  return (
+    <AuthContext.Provider value={{ username, signIn, signUp, signOut }}>
+      {children}
+    </AuthContext.Provider>
+  );
+}
+
+export function useAuth() {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error("useAuth must be used within AuthProvider");
+  return ctx;
+}
+
+export function useDocumentTitle(title: string) {
+  useEffect(() => {
+    document.title = title ? `${title} · Book Library` : "Book Library";
+  }, [title]);
+}
diff --git a/frontend/src/components/Layout.tsx b/frontend/src/components/Layout.tsx
new file mode 100644
index 0000000..73a5b3c
--- /dev/null
+++ b/frontend/src/components/Layout.tsx
@@ -0,0 +1,71 @@
+import { Link, useLocation } from "../router";
+import { useAuth } from "../auth";
+
+export function Layout({ children }: { children: React.ReactNode }) {
+  const { username, signOut } = useAuth();
+  const location = useLocation();
+  const isActive = (path: string) =>
+    path === "/"
+      ? location === "/" || location.startsWith("/?")
+      : location.startsWith(path);
+
+  return (
+    <div className="min-h-screen bg-slate-50 text-slate-900">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
+          <Link to="/" className="flex items-center gap-2">
+            <span className="text-2xl" aria-hidden>
+              📚
+            </span>
+            <span className="text-lg font-semibold tracking-tight">
+              Book Library
+            </span>
+          </Link>
+          <nav className="flex items-center gap-3 text-sm">
+            <Link
+              to="/"
+              className={`rounded-md px-3 py-1.5 font-medium hover:bg-slate-100 ${
+                isActive("/") ? "text-indigo-600" : "text-slate-600"
+              }`}
+            >
+              Books
+            </Link>
+            {username ? (
+              <>
+                <Link
+                  to="/books/new"
+                  className="rounded-md bg-indigo-600 px-3 py-1.5 font-medium text-white hover:bg-indigo-700"
+                >
+                  Add book
+                </Link>
+                <span className="hidden text-slate-500 sm:inline">
+                  Signed in as{" "}
+                  <span className="font-medium text-slate-800">
+                    {username}
+                  </span>
+                </span>
+                <button
+                  onClick={() => {
+                    signOut();
+                    window.location.href = "/";
+                  }}
+                  className="rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-100"
+                >
+                  Sign out
+                </button>
+              </>
+            ) : (
+              <Link
+                to="/auth"
+                className="rounded-md bg-indigo-600 px-3 py-1.5 font-medium text-white hover:bg-indigo-700"
+              >
+                Sign in
+              </Link>
+            )}
+          </nav>
+        </div>
+      </header>
+      <main className="mx-auto max-w-5xl px-4 py-8">{children}</main>
+    </div>
+  );
+}
