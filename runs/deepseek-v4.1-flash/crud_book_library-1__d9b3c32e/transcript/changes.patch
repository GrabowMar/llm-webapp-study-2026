@@ -0,0 +1,130 @@
+import { useEffect, useState } from "react";
+import { useAuth, useDocumentTitle } from "../auth";
+import { navigate } from "../router";
+import { ErrorMessage, errorText } from "../components/ui";
+
+export default function AuthPage({ initialMode }: { initialMode: "login" | "register" }) {
+  const { signIn, signUp, username } = useAuth();
+  const [mode, setMode] = useState<"login" | "register">(initialMode);
+  const [user, setUser] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  useDocumentTitle(mode === "login" ? "Sign in" : "Register");
+
+  useEffect(() => {
+    if (username) navigate("/", true);
+  }, [username]);
+
+  if (username) return null;
+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setSubmitting(true);
+    setError(null);
+    try {
+      if (mode === "login") {
+        await signIn(user.trim(), password);
+      } else {
+        await signUp(user.trim(), password);
+      }
+      navigate("/");
+    } catch (err) {
+      setError(errorText(err));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const inputClass =
+    "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100";
+
+  return (
+    <div className="mx-auto max-w-sm space-y-6">
+      <div className="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
+        <div className="mb-4 flex rounded-md bg-slate-100 p-1 text-sm font-medium">
+          <button
+            type="button"
+            onClick={() => {
+              setMode("login");
+              setError(null);
+            }}
+            className={`flex-1 rounded px-3 py-1.5 ${
+              mode === "login"
+                ? "bg-white text-slate-900 shadow-sm"
+                : "text-slate-500 hover:text-slate-700"
+            }`}
+          >
+            Sign in
+          </button>
+          <button
+            type="button"
+            onClick={() => {
+              setMode("register");
+              setError(null);
+            }}
+            className={`flex-1 rounded px-3 py-1.5 ${
+              mode === "register"
+                ? "bg-white text-slate-900 shadow-sm"
+                : "text-slate-500 hover:text-slate-700"
+            }`}
+          >
+            Register
+          </button>
+        </div>
+
+        <h1 className="text-xl font-bold tracking-tight">
+          {mode === "login" ? "Welcome back" : "Create an account"}
+        </h1>
+        <p className="mt-1 text-sm text-slate-500">
+          {mode === "login"
+            ? "Sign in to add books and write reviews."
+            : "Register to start building the catalogue."}
+        </p>
+
+        <form onSubmit={submit} className="mt-5 space-y-4">
+          <ErrorMessage message={error} />
+          <div>
+            <label className="mb-1 block text-sm font-medium text-slate-700">
+              Username
+            </label>
+            <input
+              value={user}
+              onChange={(e) => setUser(e.target.value)}
+              autoComplete="username"
+              className={inputClass}
+              placeholder="reader"
+            />
+          </div>
+          <div>
+            <label className="mb-1 block text-sm font-medium text-slate-700">
+              Password
+            </label>
+            <input
+              type="password"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              autoComplete={
+                mode === "login" ? "current-password" : "new-password"
+              }
+              className={inputClass}
+              placeholder="••••••••"
+            />
+          </div>
+          <button
+            type="submit"
+            disabled={submitting}
+            className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+          >
+            {submitting
+              ? "Please wait…"
+              : mode === "login"
+                ? "Sign in"
+                : "Create account"}
+          </button>
+        </form>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/pages/BookFormPage.tsx b/frontend/src/pages/BookFormPage.tsx
