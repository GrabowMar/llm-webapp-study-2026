{"type":"tool_use","timestamp":1794305963302,"sessionID":"ses_e3b08d956ffeqBpchyJ84FWxbB","part":{"type":"tool","tool":"write","callID":"call_e232005dd681414cade7e93b","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: JSON API and frontend static serving.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDB_PATH = os.environ.get(\n    \"DATABASE_PATH\", str(Path.cwd() / \"data\" / \"library.db\")\n)\n\napp = Flask(__name__, static_folder=None)\napp.config[\"JSON_SORT_KEYS\"] = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS books (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    author TEXT NOT NULL,\n    year INTEGER,\n    isbn TEXT,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS reviews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    rating INTEGER NOT NULL,\n    comment TEXT NOT NULL DEFAULT '',\n    created_at TEXT NOT NULL,\n    UNIQUE (book_id, user_id)\n);\n\"\"\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        Path(DB_PATH).parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    Path(DB_PATH).parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef hash_password(password: str, salt: str | None = None) -> str:\n    salt = salt or secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 120_000\n    )\n    return f\"{salt}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt, _digest = stored.split(\"$\", 1)\n    except ValueError:\n        return False\n    return hmac.compare_digest(hash_password(password, salt), stored)\n\n\nclass ApiError(Exception):\n    def __init__(self, message: str, status: int = 400):\n        super().__init__(message)\n        self.message = message\n        self.status = status\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err: ApiError):\n    return jsonify({\"error\": err.message}), err.status\n\n\n@app.errorhandler(404)\ndef handle_404(_err):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": \"Not found.\"}), 404\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(405)\ndef handle_405(_err):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": \"Method not allowed.\"}), 405\n    return send_from_directory(DIST, \"index.html\")\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(\"A JSON object is required.\")\n    return data\n\n\ndef clean_str(value) -> str:\n    if value is None:\n        return \"\"\n    if not isinstance(value, str):\n        raise ApiError(\"Expected a string value.\")\n    return value.strip()\n\n\ndef parse_year(value):\n    if value is None or value == \"\":\n        return None\n    if isinstance(value, bool):\n        raise ApiError(\"Year must be a number.\")\n    if isinstance(value, int):\n        year = value\n    elif isinstance(value, float) and value.is_integer():\n        year = int(value)\n    elif isinstance(value, str) and value.strip().lstrip(\"-\").isdigit():\n        year = int(value.strip())\n    else:\n        raise ApiError(\"Year must be a number.\")\n    if year < 1 or year > 9999:\n        raise ApiError(\"Year must be between 1 and 9999.\")\n    return year\n\n\ndef parse_optional_str(value) -> str | None:\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        raise ApiError(\"ISBN must be a string.\")\n    value = value.strip()\n    return value or None\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT users.id, users.username FROM tokens \"\n        \"JOIN users ON users.id = tokens.user_id WHERE tokens.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            raise ApiError(\"Authentication required.\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef book_row_to_dict(row: sqlite3.Row) -> dict:\n    avg = row[\"average_rating\"]\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"author\": row[\"author\"],\n        \"year\": row[\"year\"],\n        \"isbn\": row[\"isbn\"],\n        \"created_at\": row[\"created_at\"],\n        \"review_count\": row[\"review_count\"],\n        \"average_rating\": round(avg, 1) if avg is not None else None,\n    }\n\n\nBOOK_SELECT = \"\"\"\nSELECT b.id, b.title, b.author, b.year, b.isbn, b.created_at,\n       COUNT(r.id) AS review_count,\n       AVG(r.rating) AS average_rating\nFROM books b\nLEFT JOIN reviews r ON r.book_id = b.id\n\"\"\"\n\n\ndef get_book_or_404(book_id: int):\n    row = get_db().execute(\n        BOOK_SELECT + \" WHERE b.id = ? GROUP BY b.id\", (book_id,)\n    ).fetchone()\n    if row is None:\n        raise ApiError(\"Book not found.\", 404)\n    return row\n\n\ndef review_row_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"book_id\": row[\"book_id\"],\n        \"rating\": row[\"rating\"],\n        \"comment\": row[\"comment\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": row[\"username\"],\n    }\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = clean_str(data.get(\"username\"))\n    password = data.get(\"password\")\n    if not username:\n        raise ApiError(\"Username is required.\")\n    if len(username) > 50:\n        raise ApiError(\"Username must be at most 50 characters.\")\n    if not isinstance(password, str) or not password:\n        raise ApiError(\"Password is required.\")\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        raise ApiError(\"Username is already taken.\", 409)\n\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, hash_password(password), now_iso()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = clean_str(data.get(\"username\"))\n    password = data.get(\"password\")\n    if not username or not isinstance(password, str) or not password:\n        raise ApiError(\"Username and password are required.\", 401)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if user is None or not verify_password(password, user[\"password_hash\"]):\n        raise ApiError(\"Invalid username or password.\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/books\")\ndef list_books():\n    db = get_db()\n    q = clean_str(request.args.get(\"q\"))\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        page_size = 10\n    page_size = min(max(page_size, 1), 100)\n\n    where = \"\"\n    params: list = []\n    if q:\n        like = f\"%{q}%\"\n        where = \" WHERE (b.title LIKE ? OR b.author LIKE ? OR b.isbn LIKE ?)\"\n        params = [like, like, like]\n\n    total = db.execute(\n        \"SELECT COUNT(*) FROM books b\" + where, params\n    ).fetchone()[0]\n    rows = db.execute(\n        BOOK_SELECT\n        + where\n        + \" GROUP BY b.id ORDER BY b.created_at DESC, b.id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [book_row_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\ndef validate_book(data: dict):\n    title = clean_str(data.get(\"title\"))\n    author = clean_str(data.get(\"author\"))\n    if not title:\n        raise ApiError(\"Title is required.\")\n    if not author:\n        raise ApiError(\"Author is required.\")\n    year = parse_year(data.get(\"year\"))\n    isbn = parse_optional_str(data.get(\"isbn\"))\n    return title, author, year, isbn\n\n\n@app.post(\"/api/books\")\n@login_required\ndef create_book():\n    data = json_body()\n    title, author, year, isbn = validate_book(data)\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO books (title, author, year, isbn, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?)\",\n        (title, author, year, isbn, now_iso()),\n    )\n    db.commit()\n    return jsonify(book_row_to_dict(get_book_or_404(cur.lastrowid))), 201\n\n\n@app.get(\"/api/books/<int:book_id>\")\ndef get_book(book_id: int):\n    return jsonify(book_row_to_dict(get_book_or_404(book_id)))\n\n\n@app.put(\"/api/books/<int:book_id>\")\n@login_required\ndef update_book(book_id: int):\n    get_book_or_404(book_id)\n    data = json_body()\n    title, author, year, isbn = validate_book(data)\n    db = get_db()\n    db.execute(\n        \"UPDATE books SET title = ?, author = ?, year = ?, isbn = ? WHERE id = ?\",\n        (title, author, year, isbn, book_id),\n    )\n    db.commit()\n    return jsonify(book_row_to_dict(get_book_or_404(book_id)))\n\n\n@app.delete(\"/api/books/<int:book_id>\")\n@login_required\ndef delete_book(book_id: int):\n    get_book_or_404(book_id)\n    db = get_db()\n    db.execute(\"DELETE FROM reviews WHERE book_id = ?\", (book_id,))\n    db.execute(\"DELETE FROM books WHERE id = ?\", (book_id,))\n    db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/books/<int:book_id>/reviews\")\ndef list_reviews(book_id: int):\n    get_book_or_404(book_id)\n    rows = get_db().execute(\n        \"SELECT r.id, r.book_id, r.rating, r.comment, r.created_at, \"\n        \"u.username FROM reviews r JOIN users u ON u.id = r.user_id \"\n        \"WHERE r.book_id = ? ORDER BY r.created_at DESC, r.id DESC\",\n        (book_id,),\n    ).fetchall()\n    return jsonify({\"items\": [review_row_to_dict(r) for r in rows]})\n\n\n@app.post(\"/api/books/<int:book_id>/reviews\")\n@login_required\ndef create_review(book_id: int):\n    get_book_or_404(book_id)\n    data = json_body()\n    rating = data.get(\"rating\")\n    if isinstance(rating, float) and rating.is_integer():\n        rating = int(rating)\n    if isinstance(rating, str) and rating.strip().lstrip(\"-\").isdigit():\n        rating = int(rating.strip())\n    if isinstance(rating, bool) or not isinstance(rating, int):\n        raise ApiError(\"Rating must be a number between 1 and 5.\")\n    if rating < 1 or rating > 5:\n        raise ApiError(\"Rating must be between 1 and 5.\")\n    comment = clean_str(data.get(\"comment\"))\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM reviews WHERE book_id = ? AND user_id = ?\",\n        (book_id, g.user[\"id\"]),\n    ).fetchone()\n    if existing is not None:\n        raise ApiError(\"You have already reviewed this book.\", 409)\n\n    cur = db.execute(\n        \"INSERT INTO reviews (book_id, user_id, rating, comment, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?)\",\n        (book_id, g.user[\"id\"], rating, comment, now_iso()),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT r.id, r.book_id, r.rating, r.comment, r.created_at, \"\n        \"u.username FROM reviews r JOIN users u ON u.id = r.user_id \"\n        \"WHERE r.id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(review_row_to_dict(row)), 201\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", 8000)), debug=True)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794305963238,"end":1794305963279}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4f834dc001VNbUFCEUci9bo8","sessionID":"ses_e3b08d956ffeqBpchyJ84FWxbB","messageID":"msg_1c4f7bccd001Lkp28PRUprCCPh"}}
