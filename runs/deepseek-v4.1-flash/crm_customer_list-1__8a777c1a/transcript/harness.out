{"type":"tool_use","timestamp":1794342821273,"sessionID":"ses_e38dab8d8ffeqbD0B35tdn7Zzi","part":{"type":"tool","tool":"write","callID":"call_e0a277e6f3ae4fb9b2e4bd20","state":{"status":"completed","input":{"content":"import { api, ApiError, clearSession, getUsername } from \"../api\";\nimport { Link, useNavigate } from \"../router\";\nimport { buttonPrimary } from \"../ui\";\n\nexport default function Layout({\n  username,\n  onSignedOut,\n  children,\n}: {\n  username: string;\n  onSignedOut: () => void;\n  children: React.ReactNode;\n}) {\n  const navigate = useNavigate();\n\n  function signOut() {\n    clearSession();\n    onSignedOut();\n    navigate(\"/\");\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-50\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6\">\n          <Link to=\"/\" className=\"flex items-center gap-3\">\n            <span className=\"flex h-9 w-9 items-center justify-center rounded-lg bg-sky-600 text-sm font-bold text-white shadow-sm\">\n              CD\n            </span>\n            <span className=\"text-lg font-semibold text-slate-900\">\n              Customer Directory\n            </span>\n          </Link>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"hidden text-sm text-slate-600 sm:inline\">\n              Signed in as <span className=\"font-medium text-slate-900\">{username}</span>\n            </span>\n            <Link to=\"/customers/new\" className={buttonPrimary}>\n              <span aria-hidden=\"true\">+</span> Add customer\n            </Link>\n            <button\n              type=\"button\"\n              onClick={signOut}\n              className=\"rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900\"\n            >\n              Sign out\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-8 sm:px-6\">{children}</main>\n    </div>\n  );\n}\n\nexport function useSignedOutGuard(onSignedOut: () => void) {\n  return async function guard<T>(run: () => Promise<T>): Promise<T | null> {\n    try {\n      return await run();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) {\n        onSignedOut();\n        return null;\n      }\n      throw err;\n    }\n  };\n}\n\nexport { api, getUsername };\n","filePath":"/workspace/frontend/src/components/Layout.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Layout.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Layout.tsx","time":{"start":1794342821249,"end":1794342821256}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c72a9d7b001ivjpwmWWTBS4JN","sessionID":"ses_e38dab8d8ffeqbD0B35tdn7Zzi","messageID":"msg_1c72a8858001u8J6WxsNlDm6AF"}}
