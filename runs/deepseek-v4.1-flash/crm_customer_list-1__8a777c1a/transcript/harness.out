ber can log', r.status_code==201)\nr = c.get(f'/api/customers/{cid}', headers=h); check('interaction_count 1', r.get_json()['interaction_count']==1)\ncheck('last_contacted not null', r.get_json()['last_contacted_at'] is not None)\ncheck('optional cleared', r.get_json()['email'] is None)\n# newest first\nc.post(f'/api/customers/{cid}/interactions', headers=h, json={'kind':'call','summary':'new','occurred_at':'2030-01-01T00:00:00Z'})\nr = c.get(f'/api/customers/{cid}/interactions', headers=h)\nitems=r.get_json()['items']; check('newest first', items[0]['summary']=='new' and items[1]['summary']=='met')\ncheck('logged_by username', items[0]['logged_by']=='u2')\n# delete cascades\nc.delete(f'/api/customers/{cid}', headers=h2)\nimport sqlite3\ncon=sqlite3.connect('/workspace/.tmp-e2e/data/app.db')\ncheck('interactions deleted', con.execute('select count(*) from interactions where customer_id=?',(cid,)).fetchone()[0]==0)\n# unknown api 404\nr=c.get('/api/nope', headers=h); check('unknown api 404', r.status_code==404)\n# page shape\nr=c.get('/api/customers', headers=h); b=r.get_json(); check('page keys', set(b)>= {'items','total','page','page_size'})\nPY\nrm -rf .tmp-e2e .venv","timeout":180000,"workdir":"/workspace"},"output":"PASS register 201\nPASS register dup 400\nPASS register blank user 400\nPASS register no pw 400\nPASS login wrong 401\nPASS login token\nPASS create 201\nPASS other member can update\nPASS other member can log\nPASS interaction_count 1\nPASS last_contacted not null\nPASS optional cleared\nPASS newest first\nFAIL logged_by username\nPASS interactions deleted\nPASS unknown api 404\nPASS page keys\n","metadata":{"output":"PASS register 201\nPASS register dup 400\nPASS register blank user 400\nPASS register no pw 400\nPASS login wrong 401\nPASS login token\nPASS create 201\nPASS other member can update\nPASS other member can log\nPASS interaction_count 1\nPASS last_contacted not null\nPASS optional cleared\nPASS newest first\nFAIL logged_by username\nPAS