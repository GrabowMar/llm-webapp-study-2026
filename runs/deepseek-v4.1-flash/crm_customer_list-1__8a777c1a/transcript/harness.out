[errors, setErrors] = useState<Record<string, string>>({});\n   const [formError, setFormError] = useState(\"\");\n   const [busy, setBusy] = useState(false);\n-  const nameRef = useRef<HTMLInputElement | null>(null);\n \n-  useEffect(() => {\n-    nameRef.current?.focus();\n-  }, []);\n-\n   async function submit(event: React.FormEvent) {\n     event.preventDefault();\n     setBusy(true);\n     setErrors({});\n","additions":1,"deletions":6},"truncated":false},"title":"frontend/src/pages/CustomerNewPage.tsx","time":{"start":1794342815807,"end":1794342815820}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c72a8838001jfiS5JLtlBhG0F","sessionID":"ses_e38dab8d8ffeqbD0B35tdn7Zzi","messageID":"msg_1c72a74ed001UBnksWmlBa0ZQv"}}
