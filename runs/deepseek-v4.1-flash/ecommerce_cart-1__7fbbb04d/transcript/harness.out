{"type":"tool_use","timestamp":1794379459804,"sessionID":"ses_e36a85f40ffeBA2H34N7XzCnhY","part":{"type":"tool","tool":"bash","callID":"call_127e7737d0be43e7b951b11a","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'PY'\n\"\"\"Flask API and frontend host for the shop app.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable, TypeVar\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", str(DATA_DIR / \"shop.db\")))\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nT = TypeVar(\"T\")\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef cents_to_price(cents: int) -> float:\n    return float(Decimal(cents) / Decimal(100))\n\n\ndef price_to_cents(value: Any) -> int:\n    if value is None or isinstance(value, bool):\n        raise ValueError(\"Invalid price\")\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"Invalid price\") from None\n    if not amount.is_finite() or amount < 0:\n        raise ValueError(\"Price must be a non-negative number\")\n    return int((amount * 100).to_integral_value(rounding=ROUND_HALF_UP))\n\n\ndef parse_int(value: Any) -> int:\n    if isinstance(value, bool):\n        raise ValueError(\"Invalid integer\")\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n    if isinstance(value, str) and re.fullmatch(r\"[+-]?\\d+\", value.strip()):\n        return int(value.strip())\n    raise ValueError(\"Invalid integer\")\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\n# ---------------------------------------------------------------------------\n# Database\n\n\ndef connect() -> sqlite3.Connection:\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 30000\")\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None = None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\nSEED_PRODUCTS = [\n    (\"Aurora Desk Lamp\", \"A warm, dimmable lamp with a brushed brass base.\", 4999, 24),\n    (\"Canvas Tote Bag\", \"Sturdy organic cotton tote with an inner pocket.\", 2499, 40),\n    (\"Cedar Notebook\", \"A5 dot-grid notebook with 160 pages of thick paper.\", 1499, 60),\n    (\"Cloud Ceramic Mug\", \"Hand-glazed 350 ml mug that keeps coffee warm.\", 1899, 35),\n    (\"Drift Wool Scarf\", \"Soft merino scarf woven in a muted charcoal stripe.\", 3999, 18),\n    (\"Evergreen Water Bottle\", \"Insulated stainless bottle, 750 ml, leak proof.\", 2999, 30),\n    (\"Fjord Backpack\", \"Weather-resistant daypack with a padded laptop sleeve.\", 8999, 16),\n    (\"Grove Cutting Board\", \"Solid oak board with a juice groove and hanging loop.\", 3499, 22),\n    (\"Harbor Bluetooth Speaker\", \"Pocket speaker with 12 hours of playback.\", 5999, 27),\n    (\"Meadow Candle\", \"Soy wax candle scented with lavender and sage.\", 2199, 50),\n    (\"Orbit Wall Clock\", \"Minimal sweep-movement clock, 30 cm diameter.\", 4299, 14),\n    (\"Page Turner Book Light\", \"Clip-on reading light with three brightness levels.\", 1699, 45),\n]\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.isolation_level = None\n        conn.execute(\"BEGIN IMMEDIATE\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS auth_tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS products (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL,\n                description TEXT NOT NULL DEFAULT '',\n                price_cents INTEGER NOT NULL,\n                stock INTEGER NOT NULL DEFAULT 0,\n                is_active INTEGER NOT NULL DEFAULT 1,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS cart_items (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n                quantity INTEGER NOT NULL,\n                created_at TEXT NOT NULL,\n                UNIQUE(user_id, product_id)\n            );\n            CREATE INDEX IF NOT EXISTS idx_products_active_name\n                ON products(is_active, name);\n            CREATE INDEX IF NOT EXISTS idx_cart_user\n                ON cart_items(user_id, id);\n            \"\"\"\n        )\n\n        count = conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\n        if count == 0:\n            now = utcnow()\n            conn.executemany(\n                \"\"\"\n                INSERT INTO products\n                    (name, description, price_cents, stock, is_active, created_at)\n                VALUES (?, ?, ?, ?, 1, ?)\n                \"\"\",\n                [(name, desc, price, stock, now) for name, desc, price, stock in SEED_PRODUCTS],\n            )\n\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        if admin_password:\n            admin_hash = generate_password_hash(admin_password)\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = 'admin'\"\n            ).fetchone()\n            if row is None:\n                conn.execute(\n                    \"\"\"\n                    INSERT INTO users (username, password_hash, is_admin, created_at)\n                    VALUES ('admin', ?, 1, ?)\n                    \"\"\",\n                    (admin_hash, utcnow()),\n                )\n            else:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (admin_hash, row[\"id\"]),\n                )\n        else:\n            conn.execute(\"DELETE FROM users WHERE username = 'admin'\")\n        conn.execute(\"COMMIT\")\n    except Exception:\n        try:\n            conn.execute(\"ROLLBACK\")\n        except sqlite3.Error:\n            pass\n        raise\n    finally:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Authentication helpers\n\n\ndef current_user() -> sqlite3.Row | None:\n    if \"current_user\" in g:\n        return g.current_user\n    header = request.headers.get(\"Authorization\", \"\")\n    user = None\n    if header.lower().startswith(\"bearer \"):\n        token = header[7:].strip()\n        if token:\n            user = get_db().execute(\n                \"\"\"\n                SELECT u.id, u.username, u.is_admin\n                FROM auth_tokens t\n                JOIN users u ON u.id = t.user_id\n                WHERE t.token = ?\n                \"\"\",\n                (token,),\n            ).fetchone()\n    g.current_user = user\n    return user\n\n\ndef login_required(view: Callable[..., T]) -> Callable[..., T]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        if current_user() is None:\n            return error(\"Authentication required\", 401)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view: Callable[..., T]) -> Callable[..., T]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return error(\"Admin access required\", 403)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef body() -> dict[str, Any] | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\n# ---------------------------------------------------------------------------\n# Serializers\n\n\ndef product_json(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": cents_to_price(row[\"price_cents\"]),\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\nCART_ITEM_SELECT = \"\"\"\n    SELECT c.id, c.product_id, c.quantity, p.name, p.price_cents,\n           (p.price_cents * c.quantity) AS line_cents\n    FROM cart_items c\n    JOIN products p ON p.id = c.product_id\n\"\"\"\n\n\ndef cart_item_json(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": row[\"quantity\"],\n        \"name\": row[\"name\"],\n        \"unit_price\": cents_to_price(row[\"price_cents\"]),\n        \"line_total\": cents_to_price(row[\"line_cents\"]),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Health and auth\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required\", 400)\n    username = username.strip()\n    if username.lower() == \"admin\":\n        return error(\"That username is not available\", 409)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return error(\"Username is already taken\", 409)\n    cur = db.execute(\n        \"\"\"\n        INSERT INTO users (username, password_hash, is_admin, created_at)\n        VALUES (?, ?, 0, ?)\n        \"\"\",\n        (username, generate_password_hash(password), utcnow()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\", 400)\n    username = username.strip()\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n        (username,),\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO auth_tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]}), 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    user = current_user()\n    return {\n        \"id\": user[\"id\"],\n        \"username\": user[\"username\"],\n        \"is_admin\": bool(user[\"is_admin\"]),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Products\n\n\n@app.get(\"/api/products\")\ndef list_products():\n    q = request.args.get(\"q\", \"\").strip()\n    try:\n        page = parse_int(request.args.get(\"page\", 1))\n        page_size = parse_int(request.args.get(\"page_size\", 12))\n    except ValueError:\n        return error(\"Invalid pagination\", 400)\n    if page < 1:\n        return error(\"Page must be at least 1\", 400)\n    if page_size < 1 or page_size > 100:\n        return error(\"Page size must be between 1 and 100\", 400)\n\n    where = [\"is_active = 1\"]\n    params: list[Any] = []\n    if q:\n        like = f\"%{q}%\"\n        where.append(\"(name LIKE ? COLLATE NOCASE OR description LIKE ? COLLATE NOCASE)\")\n        params.extend([like, like])\n    clause = \" AND \".join(where)\n\n    db = get_db()\n    total = db.execute(\n        f\"SELECT COUNT(*) FROM products WHERE {clause}\", params\n    ).fetchone()[0]\n    rows = db.execute(\n        f\"\"\"\n        SELECT * FROM products\n        WHERE {clause}\n        ORDER BY name COLLATE NOCASE, id\n        LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return {\n        \"items\": [product_json(row) for row in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef get_product(product_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"Product not found\", 404)\n    return product_json(row)\n\n\n# ---------------------------------------------------------------------------\n# Cart\n\n\ndef find_cart_item(db: sqlite3.Connection, user_id: int, item_id: int):\n    return db.execute(\n        CART_ITEM_SELECT\n        + \" WHERE c.id = ? AND c.user_id = ? AND p.is_active = 1\",\n        (item_id, user_id),\n    ).fetchone()\n\n\n@app.get(\"/api/cart\")\n@login_required\ndef get_cart():\n    user = current_user()\n    rows = get_db().execute(\n        CART_ITEM_SELECT\n        + \"\"\"\n        WHERE c.user_id = ? AND p.is_active = 1\n        ORDER BY c.id\n        \"\"\",\n        (user[\"id\"],),\n    ).fetchall()\n    items = [cart_item_json(row) for row in rows]\n    subtotal_cents = sum(row[\"line_cents\"] for row in rows)\n    return {\"items\": items, \"subtotal\": cents_to_price(subtotal_cents)}\n\n\n@app.post(\"/api/cart\")\n@login_required\ndef add_to_cart():\n    user = current_user()\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    try:\n        product_id = parse_int(data.get(\"product_id\"))\n        quantity = parse_int(data.get(\"quantity\", 1))\n    except ValueError:\n        return error(\"product_id and quantity are required\", 400)\n    if quantity < 1:\n        return error(\"Quantity must be at least 1\", 400)\n\n    db = get_db()\n    product = db.execute(\n        \"SELECT id, is_active FROM products WHERE id = ?\", (product_id,)\n    ).fetchone()\n    if product is None:\n        return error(\"Product not found\", 404)\n    if not product[\"is_active\"]:\n        return error(\"Product is not available\", 400)\n\n    existing = db.execute(\n        \"SELECT id FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (user[\"id\"], product_id),\n    ).fetchone()\n    if existing is None:\n        cur = db.execute(\n            \"\"\"\n            INSERT INTO cart_items (user_id, product_id, quantity, created_at)\n            VALUES (?, ?, ?, ?)\n            \"\"\",\n            (user[\"id\"], product_id, quantity, utcnow()),\n        )\n        item_id = cur.lastrowid\n    else:\n        item_id = existing[\"id\"]\n        db.execute(\n            \"UPDATE cart_items SET quantity = quantity + ? WHERE id = ?\",\n            (quantity, item_id),\n        )\n    db.commit()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    return jsonify(cart_item_json(row)), 201\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\n@login_required\ndef update_cart_item(item_id: int):\n    user = current_user()\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    if \"quantity\" not in data:\n        return error(\"Quantity is required\", 400)\n    try:\n        quantity = parse_int(data.get(\"quantity\"))\n    except ValueError:\n        return error(\"Quantity must be a whole number\", 400)\n    if quantity < 1:\n        return error(\"Quantity must be at least 1\", 400)\n\n    db = get_db()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    if row is None:\n        return error(\"Cart item not found\", 404)\n    db.execute(\n        \"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id)\n    )\n    db.commit()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    return cart_item_json(row)\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\n@login_required\ndef delete_cart_item(item_id: int):\n    user = current_user()\n    db = get_db()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    if row is None:\n        return error(\"Cart item not found\", 404)\n    db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# Admin products\n\n\ndef validate_product_fields(data: dict[str, Any], partial: bool) -> tuple[dict[str, Any], str | None]:\n    fields: dict[str, Any] = {}\n    if not partial or \"name\" in data:\n        name = data.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return {}, \"Name is required\"\n        fields[\"name\"] = name.strip()\n    if \"description\" in data or not partial:\n        description = data.get(\"description\", \"\")\n        if description is None:\n            description = \"\"\n        if not isinstance(description, str):\n            return {}, \"Description must be a string\"\n        fields[\"description\"] = description\n    if \"price\" in data or not partial:\n        if \"price\" not in data:\n            return {}, \"Price is required\"\n        try:\n            fields[\"price_cents\"] = price_to_cents(data.get(\"price\"))\n        except ValueError as exc:\n            return {}, str(exc)\n    if \"stock\" in data or not partial:\n        if \"stock\" not in data:\n            return {}, \"Stock is required\"\n        try:\n            stock = parse_int(data.get(\"stock\"))\n        except ValueError:\n            return {}, \"Stock must be a whole number\"\n        if stock < 0:\n            return {}, \"Stock must be non-negative\"\n        fields[\"stock\"] = stock\n    if \"is_active\" in data:\n        active = data.get(\"is_active\")\n        if not isinstance(active, bool):\n            return {}, \"is_active must be a boolean\"\n        fields[\"is_active\"] = 1 if active else 0\n    elif not partial:\n        fields[\"is_active\"] = 1\n    return fields, None\n\n\n@app.post(\"/api/admin/products\")\n@admin_required\ndef create_product():\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    fields, message = validate_product_fields(data, partial=False)\n    if message:\n        return error(message, 400)\n    db = get_db()\n    cur = db.execute(\n        \"\"\"\n        INSERT INTO products\n            (name, description, price_cents, stock, is_active, created_at)\n        VALUES (?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            fields[\"name\"],\n            fields.get(\"description\", \"\"),\n            fields[\"price_cents\"],\n            fields[\"stock\"],\n            fields.get(\"is_active\", 1),\n            utcnow(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(product_json(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\n@admin_required\ndef update_product(product_id: int):\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    db = get_db()\n    existing = db.execute(\n        \"SELECT * FROM products WHERE id = ?\", (product_id,)\n    ).fetchone()\n    if existing is None:\n        return error(\"Product not found\", 404)\n\n    fields, message = validate_product_fields(data, partial=True)\n    if message:\n        return error(message, 400)\n    if not fields:\n        return product_json(existing)\n\n    assignments = \", \".join(f\"{column} = ?\" for column in fields)\n    db.execute(\n        f\"UPDATE products SET {assignments} WHERE id = ?\",\n        [*fields.values(), product_id],\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return product_json(row)\n\n\n# ---------------------------------------------------------------------------\n# Frontend\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    candidate = DIST / path\n    if candidate.is_file() and DIST in candidate.resolve().parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\nPY\npython3 -m py_compile backend/app.py && echo OK"},"output":"OK\n","metadata":{"output":"OK\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'PY'\n\"\"\"Flask API and frontend host for the shop app.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable, TypeVar\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", str(DATA_DIR / \"shop.db\")))\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nT = TypeVar(\"T\")\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef cents_to_price(cents: int) -> float:\n    return float(Decimal(cents) / Decimal(100))\n\n\ndef price_to_cents(value: Any) -> int:\n    if value is None or isinstance(value, bool):\n        raise ValueError(\"Invalid price\")\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"Invalid price\") from None\n    if not amount.is_finite() or amount < 0:\n        raise ValueError(\"Price must be a non-negative number\")\n    return int((amount * 100).to_integral_value(rounding=ROUND_HALF_UP))\n\n\ndef parse_int(value: Any) -> int:\n    if isinstance(value, bool):\n        raise ValueError(\"Invalid integer\")\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n    if isinstance(value, str) and re.fullmatch(r\"[+-]?\\d+\", value.strip()):\n        return int(value.strip())\n    raise ValueError(\"Invalid integer\")\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\n# ---------------------------------------------------------------------------\n# Database\n\n\ndef connect() -> sqlite3.Connection:\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 30000\")\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None = None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\nSEED_PRODUCTS = [\n    (\"Aurora Desk Lamp\", \"A warm, dimmable lamp with a brushed brass base.\", 4999, 24),\n    (\"Canvas Tote Bag\", \"Sturdy organic cotton tote with an inner pocket.\", 2499, 40),\n    (\"Cedar Notebook\", \"A5 dot-grid notebook with 160 pages of thick paper.\", 1499, 60),\n    (\"Cloud Ceramic Mug\", \"Hand-glazed 350 ml mug that keeps coffee warm.\", 1899, 35),\n    (\"Drift Wool Scarf\", \"Soft merino scarf woven in a muted charcoal stripe.\", 3999, 18),\n    (\"Evergreen Water Bottle\", \"Insulated stainless bottle, 750 ml, leak proof.\", 2999, 30),\n    (\"Fjord Backpack\", \"Weather-resistant daypack with a padded laptop sleeve.\", 8999, 16),\n    (\"Grove Cutting Board\", \"Solid oak board with a juice groove and hanging loop.\", 3499, 22),\n    (\"Harbor Bluetooth Speaker\", \"Pocket speaker with 12 hours of playback.\", 5999, 27),\n    (\"Meadow Candle\", \"Soy wax candle scented with lavender and sage.\", 2199, 50),\n    (\"Orbit Wall Clock\", \"Minimal sweep-movement clock, 30 cm diameter.\", 4299, 14),\n    (\"Page Turner Book Light\", \"Clip-on reading light with three brightness levels.\", 1699, 45),\n]\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.isolation_level = None\n        conn.execute(\"BEGIN IMMEDIATE\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS auth_tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS products (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL,\n                description TEXT NOT NULL DEFAULT '',\n                price_cents INTEGER NOT NULL,\n                stock INTEGER NOT NULL DEFAULT 0,\n                is_active INTEGER NOT NULL DEFAULT 1,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS cart_items (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n                quantity INTEGER NOT NULL,\n                created_at TEXT NOT NULL,\n                UNIQUE(user_id, product_id)\n            );\n            CREATE INDEX IF NOT EXISTS idx_products_active_name\n                ON products(is_active, name);\n            CREATE INDEX IF NOT EXISTS idx_cart_user\n                ON cart_items(user_id, id);\n            \"\"\"\n        )\n\n        count = conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\n        if count == 0:\n            now = utcnow()\n            conn.executemany(\n                \"\"\"\n                INSERT INTO products\n                    (name, description, price_cents, stock, is_active, created_at)\n                VALUES (?, ?, ?, ?, 1, ?)\n                \"\"\",\n                [(name, desc, price, stock, now) for name, desc, price, stock in SEED_PRODUCTS],\n            )\n\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        if admin_password:\n            admin_hash = generate_password_hash(admin_password)\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = 'admin'\"\n            ).fetchone()\n            if row is None:\n                conn.execute(\n                    \"\"\"\n                    INSERT INTO users (username, password_hash, is_admin, created_at)\n                    VALUES ('admin', ?, 1, ?)\n                    \"\"\",\n                    (admin_hash, utcnow()),\n                )\n            else:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (admin_hash, row[\"id\"]),\n                )\n        else:\n            conn.execute(\"DELETE FROM users WHERE username = 'admin'\")\n        conn.execute(\"COMMIT\")\n    except Exception:\n        try:\n            conn.execute(\"ROLLBACK\")\n        except sqlite3.Error:\n            pass\n        raise\n    finally:\n        conn.close()\n\n\n# ---------------------------------------------------------------------------\n# Authentication helpers\n\n\ndef current_user() -> sqlite3.Row | None:\n    if \"current_user\" in g:\n        return g.current_user\n    header = request.headers.get(\"Authorization\", \"\")\n    user = None\n    if header.lower().startswith(\"bearer \"):\n        token = header[7:].strip()\n        if token:\n            user = get_db().execute(\n                \"\"\"\n                SELECT u.id, u.username, u.is_admin\n                FROM auth_tokens t\n                JOIN users u ON u.id = t.user_id\n                WHERE t.token = ?\n                \"\"\",\n                (token,),\n            ).fetchone()\n    g.current_user = user\n    return user\n\n\ndef login_required(view: Callable[..., T]) -> Callable[..., T]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        if current_user() is None:\n            return error(\"Authentication required\", 401)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view: Callable[..., T]) -> Callable[..., T]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return error(\"Admin access required\", 403)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef body() -> dict[str, Any] | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\n# ---------------------------------------------------------------------------\n# Serializers\n\n\ndef product_json(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": cents_to_price(row[\"price_cents\"]),\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\nCART_ITEM_SELECT = \"\"\"\n    SELECT c.id, c.product_id, c.quantity, p.name, p.price_cents,\n           (p.price_cents * c.quantity) AS line_cents\n    FROM cart_items c\n    JOIN products p ON p.id = c.product_id\n\"\"\"\n\n\ndef cart_item_json(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": row[\"quantity\"],\n        \"name\": row[\"name\"],\n        \"unit_price\": cents_to_price(row[\"price_cents\"]),\n        \"line_total\": cents_to_price(row[\"line_cents\"]),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Health and auth\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required\", 400)\n    username = username.strip()\n    if username.lower() == \"admin\":\n        return error(\"That username is not available\", 409)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return error(\"Username is already taken\", 409)\n    cur = db.execute(\n        \"\"\"\n        INSERT INTO users (username, password_hash, is_admin, created_at)\n        VALUES (?, ?, 0, ?)\n        \"\"\",\n        (username, generate_password_hash(password), utcnow()),\n    )\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\", 400)\n    username = username.strip()\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n        (username,),\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO auth_tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": user[\"username\"]}), 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    user = current_user()\n    return {\n        \"id\": user[\"id\"],\n        \"username\": user[\"username\"],\n        \"is_admin\": bool(user[\"is_admin\"]),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Products\n\n\n@app.get(\"/api/products\")\ndef list_products():\n    q = request.args.get(\"q\", \"\").strip()\n    try:\n        page = parse_int(request.args.get(\"page\", 1))\n        page_size = parse_int(request.args.get(\"page_size\", 12))\n    except ValueError:\n        return error(\"Invalid pagination\", 400)\n    if page < 1:\n        return error(\"Page must be at least 1\", 400)\n    if page_size < 1 or page_size > 100:\n        return error(\"Page size must be between 1 and 100\", 400)\n\n    where = [\"is_active = 1\"]\n    params: list[Any] = []\n    if q:\n        like = f\"%{q}%\"\n        where.append(\"(name LIKE ? COLLATE NOCASE OR description LIKE ? COLLATE NOCASE)\")\n        params.extend([like, like])\n    clause = \" AND \".join(where)\n\n    db = get_db()\n    total = db.execute(\n        f\"SELECT COUNT(*) FROM products WHERE {clause}\", params\n    ).fetchone()[0]\n    rows = db.execute(\n        f\"\"\"\n        SELECT * FROM products\n        WHERE {clause}\n        ORDER BY name COLLATE NOCASE, id\n        LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return {\n        \"items\": [product_json(row) for row in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef get_product(product_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"Product not found\", 404)\n    return product_json(row)\n\n\n# ---------------------------------------------------------------------------\n# Cart\n\n\ndef find_cart_item(db: sqlite3.Connection, user_id: int, item_id: int):\n    return db.execute(\n        CART_ITEM_SELECT\n        + \" WHERE c.id = ? AND c.user_id = ? AND p.is_active = 1\",\n        (item_id, user_id),\n    ).fetchone()\n\n\n@app.get(\"/api/cart\")\n@login_required\ndef get_cart():\n    user = current_user()\n    rows = get_db().execute(\n        CART_ITEM_SELECT\n        + \"\"\"\n        WHERE c.user_id = ? AND p.is_active = 1\n        ORDER BY c.id\n        \"\"\",\n        (user[\"id\"],),\n    ).fetchall()\n    items = [cart_item_json(row) for row in rows]\n    subtotal_cents = sum(row[\"line_cents\"] for row in rows)\n    return {\"items\": items, \"subtotal\": cents_to_price(subtotal_cents)}\n\n\n@app.post(\"/api/cart\")\n@login_required\ndef add_to_cart():\n    user = current_user()\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    try:\n        product_id = parse_int(data.get(\"product_id\"))\n        quantity = parse_int(data.get(\"quantity\", 1))\n    except ValueError:\n        return error(\"product_id and quantity are required\", 400)\n    if quantity < 1:\n        return error(\"Quantity must be at least 1\", 400)\n\n    db = get_db()\n    product = db.execute(\n        \"SELECT id, is_active FROM products WHERE id = ?\", (product_id,)\n    ).fetchone()\n    if product is None:\n        return error(\"Product not found\", 404)\n    if not product[\"is_active\"]:\n        return error(\"Product is not available\", 400)\n\n    existing = db.execute(\n        \"SELECT id FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (user[\"id\"], product_id),\n    ).fetchone()\n    if existing is None:\n        cur = db.execute(\n            \"\"\"\n            INSERT INTO cart_items (user_id, product_id, quantity, created_at)\n            VALUES (?, ?, ?, ?)\n            \"\"\",\n            (user[\"id\"], product_id, quantity, utcnow()),\n        )\n        item_id = cur.lastrowid\n    else:\n        item_id = existing[\"id\"]\n        db.execute(\n            \"UPDATE cart_items SET quantity = quantity + ? WHERE id = ?\",\n            (quantity, item_id),\n        )\n    db.commit()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    return jsonify(cart_item_json(row)), 201\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\n@login_required\ndef update_cart_item(item_id: int):\n    user = current_user()\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    if \"quantity\" not in data:\n        return error(\"Quantity is required\", 400)\n    try:\n        quantity = parse_int(data.get(\"quantity\"))\n    except ValueError:\n        return error(\"Quantity must be a whole number\", 400)\n    if quantity < 1:\n        return error(\"Quantity must be at least 1\", 400)\n\n    db = get_db()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    if row is None:\n        return error(\"Cart item not found\", 404)\n    db.execute(\n        \"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id)\n    )\n    db.commit()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    return cart_item_json(row)\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\n@login_required\ndef delete_cart_item(item_id: int):\n    user = current_user()\n    db = get_db()\n    row = find_cart_item(db, user[\"id\"], item_id)\n    if row is None:\n        return error(\"Cart item not found\", 404)\n    db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# Admin products\n\n\ndef validate_product_fields(data: dict[str, Any], partial: bool) -> tuple[dict[str, Any], str | None]:\n    fields: dict[str, Any] = {}\n    if not partial or \"name\" in data:\n        name = data.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return {}, \"Name is required\"\n        fields[\"name\"] = name.strip()\n    if \"description\" in data or not partial:\n        description = data.get(\"description\", \"\")\n        if description is None:\n            description = \"\"\n        if not isinstance(description, str):\n            return {}, \"Description must be a string\"\n        fields[\"description\"] = description\n    if \"price\" in data or not partial:\n        if \"price\" not in data:\n            return {}, \"Price is required\"\n        try:\n            fields[\"price_cents\"] = price_to_cents(data.get(\"price\"))\n        except ValueError as exc:\n            return {}, str(exc)\n    if \"stock\" in data or not partial:\n        if \"stock\" not in data:\n            return {}, \"Stock is required\"\n        try:\n            stock = parse_int(data.get(\"stock\"))\n        except ValueError:\n            return {}, \"Stock must be a whole number\"\n        if stock < 0:\n            return {}, \"Stock must be non-negative\"\n        fields[\"stock\"] = stock\n    if \"is_active\" in data:\n        active = data.get(\"is_active\")\n        if not isinstance(active, bool):\n            return {}, \"is_active must be a boolean\"\n        fields[\"is_active\"] = 1 if active else 0\n    elif not partial:\n        fields[\"is_active\"] = 1\n    return fields, None\n\n\n@app.post(\"/api/admin/products\")\n@admin_required\ndef create_product():\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    fields, message = validate_product_fields(data, partial=False)\n    if message:\n        return error(message, 400)\n    db = get_db()\n    cur = db.execute(\n        \"\"\"\n        INSERT INTO products\n            (name, description, price_cents, stock, is_active, created_at)\n        VALUES (?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            fields[\"name\"],\n            fields.get(\"description\", \"\"),\n            fields[\"price_cents\"],\n            fields[\"stock\"],\n            fields.get(\"is_active\", 1),\n            utcnow(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(product_json(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\n@admin_required\ndef update_product(product_id: int):\n    data = body()\n    if data is None:\n        return error(\"Expected a JSON object\", 400)\n    db = get_db()\n    existing = db.execute(\n        \"SELECT * FROM products WHERE id = ?\", (product_id,)\n    ).fetchone()\n    if existing is None:\n        return error(\"Product not found\", 404)\n\n    fields, message = validate_product_fields(data, partial=True)\n    if message:\n        return error(message, 400)\n    if not fields:\n        return product_json(existing)\n\n    assignments = \", \".join(f\"{column} = ?\" for column in fields)\n    db.execute(\n        f\"UPDATE products SET {assignments} WHERE id = ?\",\n        [*fields.values(), product_id],\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return product_json(row)\n\n\n# ---------------------------------------------------------------------------\n# Frontend\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    candidate = DIST / path\n    if candidate.is_file() and DIST in candidate.resolve().parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\nPY\npython3 -m py_compile backend/app.py && echo OK","time":{"start":1794379459654,"end":1794379459728}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c959ac39001tp3QwLlCVLjhN4","sessionID":"ses_e36a85f40ffeBA2H34N7XzCnhY","messageID":"msg_1c9586435001fjdGZpBgq5UOpS"}}
