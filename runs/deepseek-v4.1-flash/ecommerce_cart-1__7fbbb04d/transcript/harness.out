>\n                Sign in\n              </button>''')\ns=s.replace('''      <main className=\"mx-auto max-w-6xl space-y-8 px-4 py-8\">\n        {globalError && (\n          <p role=\"alert\" className=\"rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">\n            {globalError}\n          </p>\n        )}\n\n        {checking ? (''','''      <main className=\"mx-auto max-w-6xl space-y-8 px-4 py-8\">\n        {checking ? (''')\ns=s.replace('''            {!user && (\n              <div ref={authRef} className=\"scroll-mt-24\">\n                {showAuth ? (\n                  <AuthPanel onAuthenticated={handleAuthenticated} />\n                ) : (\n                  <section className=\"flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-white px-6 py-10 text-center shadow-sm\">\n                    <h1 className=\"text-2xl font-semibold text-slate-900\">\n                      Browse freely, sign in to save a cart\n                    </h1>\n                    <p className=\"max-w-xl text-sm text-slate-500\">\n                      Prices always come from the live catalogue, so what you see is what you pay.\n                    </p>\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowAuth(true)}\n                      className=\"mt-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700\"\n                    >\n                      Create an account or sign in\n                    </button>\n                  </section>\n                )}\n              </div>\n            )}''','''            {!user && (\n              <div ref={authRef} className=\"scroll-mt-24\">\n                <AuthPanel onAuthenticated={handleAuthenticated} />\n              </div>\n            )}''')\ns=s.replace('''              signedIn={user !== null}\n              onRequireSignIn={() => {\n                setShowAuth(true);\n                window.