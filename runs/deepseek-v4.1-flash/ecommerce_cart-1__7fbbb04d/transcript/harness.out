r\n    return user\n\n\ndef login_required(view: Callable[..., T]) -> Callable[..., T]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        if current_user() is None:\n            return error(\"Authentication required\", 401)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef admin_required(view: Callable[..., T]) -> Callable[..., T]:\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        user = current_user()\n        if user is None:\n","exit":0,"truncated":false},"title":"cd /workspace && sed -n '120,230p' backend/app.py","time":{"start":1794379899448,"end":1794379899462}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c96062320015RfxB2m2tlJwB4","sessionID":"ses_e36a85f40ffeBA2H34N7XzCnhY","messageID":"msg_1c95ff4190016cNBUuEptrf4V5"}}
