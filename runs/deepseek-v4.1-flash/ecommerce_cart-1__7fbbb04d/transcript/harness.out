"is_active\" not in data:\n        data = {**data, \"is_active\": data[\"active\"]}\n    if \"is_active\" in data:\n        active = data.get(\"is_active\")''')\np.write_text(s)\nPY\npython3 -m py_compile backend/app.py && sed -n '/def validate_product_fields/,/return fields, None/p' backend/app.py"},"output":"def validate_product_fields(data: dict[str, Any], partial: bool) -> tuple[dict[str, Any], str | None]:\n    fields: dict[str, Any] = {}\n    if not partial or \"name\" in data:\n        name = data.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return {}, \"Name is required\"\n        fields[\"name\"] = name.strip()\n    if \"description\" in data or not partial:\n        description = data.get(\"description\", \"\")\n        if description is None:\n            description = \"\"\n        if not isinstance(description, str):\n            return {}, \"Description must be a string\"\n        fields[\"description\"] = description\n    if \"price\" in data or not partial:\n        if \"price\" not in data:\n            return {}, \"Price is required\"\n        try:\n            fields[\"price_cents\"] = price_to_cents(data.get(\"price\"))\n        except ValueError as exc:\n            return {}, str(exc)\n    if \"stock\" in data:\n        try:\n            stock = parse_int(data.get(\"stock\"))\n        except ValueError:\n            return {}, \"Stock must be a whole number\"\n        if stock < 0:\n            return {}, \"Stock must be non-negative\"\n        fields[\"stock\"] = stock\n    elif not partial:\n        fields[\"stock\"] = 0\n    if \"active\" in data and \"is_active\" not in data:\n        data = {**data, \"is_active\": data[\"active\"]}\n    if \"is_active\" in data:\n        active = data.get(\"is_active\")\n        if isinstance(active, bool):\n            fields[\"is_active\"] = 1 if active else 0\n        elif isinstance(active, int) and active in (0, 1):\n            fields[\"is_active\"] = active\n        else:\n            return {}, \"is_active must be a boolean\"\n    elif not partial:\n        fields[\"is_active\"] = 1\n    return fields, None\n","metadata":{"output":"def validate_product_fields(data: dict[str, Any], partial: bool) -> tuple[dict[str, Any], str | None]:\n    fields: dict[str, Any] = {}\n    if not partial or \"name\" in data:\n        name = data.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return {}, \"Name is required\"\n        fields[\"name\"] = name.strip()\n    if \"description\" in data or not partial:\n        description = data.get(\"description\", \"\")\n        if description is None:\n            description = \"\"\n        if not isinstance(description, str):\n            return {}, \"Description must be a string\"\n        fields[\"description\"] = description\n    if \"price\" in data or not partial:\n        if \"price\" not in data:\n            return {}, \"Price is required\"\n        try:\n            fields[\"price_cents\"] = price_to_cents(data.get(\"price\"))\n        except ValueError as exc:\n            return {}, str(exc)\n    if \"stock\" in data:\n        try:\n            stock = parse_int(data.get(\"stock\"))\n        except ValueError:\n            return {}, \"Stock must be a whole number\"\n        if stock < 0:\n            return {}, \"Stock must be non-negative\"\n        fields[\"stock\"] = stock\n    elif not partial:\n        fields[\"stock\"] = 0\n    if \"active\" in data and \"is_active\" not in data:\n        data = {**data, \"is_active\": data[\"active\"]}\n    if \"is_active\" in data:\n        active = data.get(\"is_active\")\n        if isinstance(active, bool):\n            fields[\"is_active\"] = 1 if active else 0\n        elif isinstance(active, int) and active in (0, 1):\n            fields[\"is_active\"] = active\n        else:\n            return {}, \"is_active must be a boolean\"\n    elif not partial:\n        fields[\"is_active\"] = 1\n    return fields, None\n","exit":0,"truncated":false},"title":"cd /workspace && python3 - <<'PY'\nfrom pathlib import Path\np=Path('backend/app.py')\ns=p.read_text()\ns=s.replace('''    if \"stock\" in data or not partial:\n        if \"stock\" not in data:\n            return {}, \"Stock is required\"\n        try:\n            stock = parse_int(data.get(\"stock\"))''','''    if \"stock\" in data or not partial:\n        if \"stock\" not in data and partial:\n            stock = None\n        else:\n            stock = parse_int(data.get(\"stock\", 0)) if \"stock\" in data else 0\n        try:\n            if stock is None:\n                raise ValueError(\"Invalid integer\")\n            stock = parse_int(stock)''')\n# The replace above is messy; rewrite the stock block directly instead.\ns=s.replace('''    if \"stock\" in data or not partial:\n        if \"stock\" not in data and partial:\n            stock = None\n        else:\n            stock = parse_int(data.get(\"stock\", 0)) if \"stock\" in data else 0\n        try:\n            if stock is None:\n                raise ValueError(\"Invalid integer\")\n            stock = parse_int(stock)\n        except ValueError:\n            return {}, \"Stock must be a whole number\"\n        if stock < 0:\n            return {}, \"Stock must be non-negative\"\n        fields[\"stock\"] = stock''','''    if \"stock\" in data:\n        try:\n            stock = parse_int(data.get(\"stock\"))\n        except ValueError:\n            return {}, \"Stock must be a whole number\"\n        if stock < 0:\n            return {}, \"Stock must be non-negative\"\n        fields[\"stock\"] = stock\n    elif not partial:\n        fields[\"stock\"] = 0''')\ns=s.replace('''    if \"is_active\" in data:\n        active = data.get(\"is_active\")''','''    if \"active\" in data and \"is_active\" not in data:\n        data = {**data, \"is_active\": data[\"active\"]}\n    if \"is_active\" in data:\n        active = data.get(\"is_active\")''