{"type":"tool_use","timestamp":1794366486714,"sessionID":"ses_e376e6433ffeibGYAqJ5ZTtj28","part":{"type":"tool","tool":"bash","callID":"call_42d983e66ed04f02844c1f52","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'PY'\n\"\"\"Flask API and frontend host for the multi-author blog.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", str(DATA_DIR / \"blog.db\")))\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS sessions (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id);\n\nCREATE TABLE IF NOT EXISTS posts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL,\n    title TEXT NOT NULL,\n    content TEXT NOT NULL,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL,\n    taken_down INTEGER NOT NULL DEFAULT 0,\n    FOREIGN KEY (user_id) REFERENCES users(id)\n);\nCREATE INDEX IF NOT EXISTS idx_posts_created ON posts(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS idx_posts_user ON posts(user_id);\n\nCREATE TABLE IF NOT EXISTS post_tags (\n    post_id INTEGER NOT NULL,\n    tag TEXT NOT NULL,\n    position INTEGER NOT NULL DEFAULT 0,\n    PRIMARY KEY (post_id, tag),\n    FOREIGN KEY (post_id) REFERENCES posts(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS idx_post_tags_tag ON post_tags(tag COLLATE NOCASE);\n\"\"\"\n\n\ndef utcnow() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt: datetime) -> str:\n    return dt.isoformat(timespec=\"microseconds\")\n\n\ndef next_timestamp(previous: str | None = None) -> str:\n    now = utcnow()\n    if previous:\n        try:\n            prev = datetime.fromisoformat(previous)\n            if prev.tzinfo is None:\n                prev = prev.replace(tzinfo=timezone.utc)\n            if now <= prev:\n                now = prev + timedelta(microseconds=1)\n        except ValueError:\n            pass\n    return iso(now)\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.executescript(SCHEMA)\n        row = conn.execute(\n            \"SELECT id FROM users WHERE username = 'admin' COLLATE NOCASE\"\n        ).fetchone()\n        if ADMIN_PASSWORD:\n            password_hash = generate_password_hash(ADMIN_PASSWORD)\n            if row:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (password_hash, row[0]),\n                )\n            else:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n                    \"VALUES ('admin', ?, 1, ?)\",\n                    (password_hash, iso(utcnow())),\n                )\n        elif row:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(secrets.token_urlsafe(32)), row[0]),\n            )\n            conn.execute(\"DELETE FROM sessions WHERE user_id = ?\", (row[0],))\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef current_user() -> dict | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        return None\n    token = parts[1].strip()\n    row = get_db().execute(\n        \"SELECT u.id, u.username, u.is_admin \"\n        \"FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    if row is None:\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"is_admin\": bool(row[\"is_admin\"])}\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef json_body() -> dict | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef post_row(post_id: int):\n    return get_db().execute(\n        \"SELECT p.*, u.username AS author FROM posts p \"\n        \"JOIN users u ON u.id = p.user_id WHERE p.id = ?\",\n        (post_id,),\n    ).fetchone()\n\n\ndef serialize_post(row: sqlite3.Row) -> dict:\n    tags = [\n        r[\"tag\"]\n        for r in get_db().execute(\n            \"SELECT tag FROM post_tags WHERE post_id = ? ORDER BY position, rowid\",\n            (row[\"id\"],),\n        ).fetchall()\n    ]\n    content = row[\"content\"]\n    excerpt = content.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\").replace(\"\\n\", \" \")[:200]\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"content\": content,\n        \"tags\": tags,\n        \"created_at\": row[\"created_at\"],\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n        \"excerpt\": excerpt,\n        \"taken_down\": bool(row[\"taken_down\"]),\n    }\n\n\ndef parse_tags(value) -> list[str]:\n    if value is None:\n        return []\n    if not isinstance(value, list):\n        raise ValueError(\"Tags must be a list of strings.\")\n    tags: list[str] = []\n    seen: set[str] = set()\n    for item in value:\n        if not isinstance(item, str):\n            raise ValueError(\"Tags must be a list of strings.\")\n        tag = item.strip()\n        if not tag:\n            continue\n        if len(tag) > 50:\n            raise ValueError(\"Tags must be at most 50 characters long.\")\n        key = tag.casefold()\n        if key in seen:\n            continue\n        seen.add(key)\n        tags.append(tag)\n    return tags\n\n\ndef clean_text(data: dict, key: str, label: str):\n    value = data.get(key)\n    if not isinstance(value, str) or not value.strip():\n        return None, f\"{label} is required.\"\n    return value, None\n\n\ndef like_pattern(value: str) -> str:\n    escaped = value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n    return f\"%{escaped}%\"\n\n\ndef page_int(name: str, default: int, maximum: int) -> int:\n    raw = request.args.get(name)\n    try:\n        value = int(raw) if raw is not None else default\n    except (TypeError, ValueError):\n        return default\n    if value < 1:\n        return default\n    return min(value, maximum)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required.\", 400)\n    username = username.strip()\n    if len(username) > 50:\n        return error(\"Username must be at most 50 characters long.\", 400)\n    if username.casefold() == \"admin\":\n        return error(\"That username is reserved.\", 409)\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required.\", 400)\n    if len(password) > 200:\n        return error(\"Password must be at most 200 characters long.\", 400)\n\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n            \"VALUES (?, ?, 0, ?)\",\n            (username, generate_password_hash(password), iso(utcnow())),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        db.rollback()\n        return error(\"That username is already taken.\", 409)\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required.\", 400)\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password.\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], iso(utcnow())),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    return jsonify(user)\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) == 2 and parts[0].lower() == \"bearer\":\n        db = get_db()\n        db.execute(\"DELETE FROM sessions WHERE token = ?\", (parts[1].strip(),))\n        db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/posts\")\ndef list_posts():\n    user = current_user()\n    page = page_int(\"page\", 1, 1_000_000)\n    page_size = page_int(\"page_size\", 10, 100)\n    q = (request.args.get(\"q\") or \"\").strip()\n    tag = (request.args.get(\"tag\") or \"\").strip()\n    author = (request.args.get(\"author\") or \"\").strip()\n\n    conditions: list[str] = []\n    params: list[object] = []\n    if not (user and user[\"is_admin\"]):\n        conditions.append(\"p.taken_down = 0\")\n    if q:\n        conditions.append(\"(p.title LIKE ? ESCAPE '\\\\' OR p.content LIKE ? ESCAPE '\\\\')\")\n        pattern = like_pattern(q)\n        params.extend([pattern, pattern])\n    if tag:\n        conditions.append(\n            \"EXISTS (SELECT 1 FROM post_tags t WHERE t.post_id = p.id \"\n            \"AND t.tag = ? COLLATE NOCASE)\"\n        )\n        params.append(tag)\n    if author:\n        conditions.append(\"u.username = ? COLLATE NOCASE\")\n        params.append(author)\n    where = (\" WHERE \" + \" AND \".join(conditions)) if conditions else \"\"\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM posts p JOIN users u ON u.id = p.user_id\" + where,\n        params,\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT p.*, u.username AS author FROM posts p \"\n        \"JOIN users u ON u.id = p.user_id\" + where +\n        \" ORDER BY p.created_at DESC, p.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_post(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/posts\")\ndef create_post():\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    title, title_error = clean_text(data, \"title\", \"Title\")\n    if title_error:\n        return error(title_error, 400)\n    content, content_error = clean_text(data, \"content\", \"Content\")\n    if content_error:\n        return error(content_error, 400)\n    try:\n        tags = parse_tags(data.get(\"tags\"))\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    db = get_db()\n    created = iso(utcnow())\n    cur = db.execute(\n        \"INSERT INTO posts (user_id, title, content, created_at, updated_at, taken_down) \"\n        \"VALUES (?, ?, ?, ?, ?, 0)\",\n        (user[\"id\"], title.strip(), content, created, created),\n    )\n    post_id = cur.lastrowid\n    for position, tag in enumerate(tags):\n        db.execute(\n            \"INSERT INTO post_tags (post_id, tag, position) VALUES (?, ?, ?)\",\n            (post_id, tag, position),\n        )\n    db.commit()\n    return jsonify(serialize_post(post_row(post_id))), 201\n\n\n@app.get(\"/api/posts/<int:post_id>\")\ndef get_post(post_id: int):\n    user = current_user()\n    row = post_row(post_id)\n    if row is None or (row[\"taken_down\"] and not (user and user[\"is_admin\"])):\n        return error(\"Post not found.\", 404)\n    return jsonify(serialize_post(row))\n\n\n@app.put(\"/api/posts/<int:post_id>\")\ndef update_post(post_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    row = post_row(post_id)\n    if row is None or (row[\"taken_down\"] and not user[\"is_admin\"]):\n        return error(\"Post not found.\", 404)\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(\"Only the author may edit this post.\", 403)\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    title, title_error = clean_text(data, \"title\", \"Title\")\n    if title_error:\n        return error(title_error, 400)\n    content, content_error = clean_text(data, \"content\", \"Content\")\n    if content_error:\n        return error(content_error, 400)\n    try:\n        tags = parse_tags(data.get(\"tags\"))\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    updated = next_timestamp(row[\"updated_at\"])\n    db = get_db()\n    db.execute(\n        \"UPDATE posts SET title = ?, content = ?, updated_at = ? WHERE id = ?\",\n        (title.strip(), content, updated, post_id),\n    )\n    db.execute(\"DELETE FROM post_tags WHERE post_id = ?\", (post_id,))\n    for position, tag in enumerate(tags):\n        db.execute(\n            \"INSERT INTO post_tags (post_id, tag, position) VALUES (?, ?, ?)\",\n            (post_id, tag, position),\n        )\n    db.commit()\n    return jsonify(serialize_post(post_row(post_id)))\n\n\n@app.delete(\"/api/posts/<int:post_id>\")\ndef delete_post(post_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    row = post_row(post_id)\n    if row is None or (row[\"taken_down\"] and not user[\"is_admin\"]):\n        return error(\"Post not found.\", 404)\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(\"Only the author may delete this post.\", 403)\n    db = get_db()\n    db.execute(\"DELETE FROM posts WHERE id = ?\", (post_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.post(\"/api/admin/posts/<int:post_id>/toggle\")\ndef admin_toggle_post(post_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    if not user[\"is_admin\"]:\n        return error(\"Administrator access required.\", 403)\n    row = post_row(post_id)\n    if row is None:\n        return error(\"Post not found.\", 404)\n    db = get_db()\n    db.execute(\n        \"UPDATE posts SET taken_down = ? WHERE id = ?\",\n        (0 if row[\"taken_down\"] else 1, post_id),\n    )\n    db.commit()\n    return jsonify(serialize_post(post_row(post_id)))\n\n\n@app.get(\"/\")\ndef frontend_index():\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/<path:path>\")\ndef frontend_file(path: str):\n    if path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nPY\npython -m py_compile backend/app.py && echo OK"},"output":"/usr/bin/bash: line 505: python: command not found\n","metadata":{"output":"/usr/bin/bash: line 505: python: command not found\n","exit":127,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'PY'\n\"\"\"Flask API and frontend host for the multi-author blog.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", str(DATA_DIR / \"blog.db\")))\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS sessions (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id);\n\nCREATE TABLE IF NOT EXISTS posts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL,\n    title TEXT NOT NULL,\n    content TEXT NOT NULL,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL,\n    taken_down INTEGER NOT NULL DEFAULT 0,\n    FOREIGN KEY (user_id) REFERENCES users(id)\n);\nCREATE INDEX IF NOT EXISTS idx_posts_created ON posts(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS idx_posts_user ON posts(user_id);\n\nCREATE TABLE IF NOT EXISTS post_tags (\n    post_id INTEGER NOT NULL,\n    tag TEXT NOT NULL,\n    position INTEGER NOT NULL DEFAULT 0,\n    PRIMARY KEY (post_id, tag),\n    FOREIGN KEY (post_id) REFERENCES posts(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS idx_post_tags_tag ON post_tags(tag COLLATE NOCASE);\n\"\"\"\n\n\ndef utcnow() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt: datetime) -> str:\n    return dt.isoformat(timespec=\"microseconds\")\n\n\ndef next_timestamp(previous: str | None = None) -> str:\n    now = utcnow()\n    if previous:\n        try:\n            prev = datetime.fromisoformat(previous)\n            if prev.tzinfo is None:\n                prev = prev.replace(tzinfo=timezone.utc)\n            if now <= prev:\n                now = prev + timedelta(microseconds=1)\n        except ValueError:\n            pass\n    return iso(now)\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.executescript(SCHEMA)\n        row = conn.execute(\n            \"SELECT id FROM users WHERE username = 'admin' COLLATE NOCASE\"\n        ).fetchone()\n        if ADMIN_PASSWORD:\n            password_hash = generate_password_hash(ADMIN_PASSWORD)\n            if row:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (password_hash, row[0]),\n                )\n            else:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n                    \"VALUES ('admin', ?, 1, ?)\",\n                    (password_hash, iso(utcnow())),\n                )\n        elif row:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(secrets.token_urlsafe(32)), row[0]),\n            )\n            conn.execute(\"DELETE FROM sessions WHERE user_id = ?\", (row[0],))\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef current_user() -> dict | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        return None\n    token = parts[1].strip()\n    row = get_db().execute(\n        \"SELECT u.id, u.username, u.is_admin \"\n        \"FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    if row is None:\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"is_admin\": bool(row[\"is_admin\"])}\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef json_body() -> dict | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef post_row(post_id: int):\n    return get_db().execute(\n        \"SELECT p.*, u.username AS author FROM posts p \"\n        \"JOIN users u ON u.id = p.user_id WHERE p.id = ?\",\n        (post_id,),\n    ).fetchone()\n\n\ndef serialize_post(row: sqlite3.Row) -> dict:\n    tags = [\n        r[\"tag\"]\n        for r in get_db().execute(\n            \"SELECT tag FROM post_tags WHERE post_id = ? ORDER BY position, rowid\",\n            (row[\"id\"],),\n        ).fetchall()\n    ]\n    content = row[\"content\"]\n    excerpt = content.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\").replace(\"\\n\", \" \")[:200]\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"content\": content,\n        \"tags\": tags,\n        \"created_at\": row[\"created_at\"],\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n        \"excerpt\": excerpt,\n        \"taken_down\": bool(row[\"taken_down\"]),\n    }\n\n\ndef parse_tags(value) -> list[str]:\n    if value is None:\n        return []\n    if not isinstance(value, list):\n        raise ValueError(\"Tags must be a list of strings.\")\n    tags: list[str] = []\n    seen: set[str] = set()\n    for item in value:\n        if not isinstance(item, str):\n            raise ValueError(\"Tags must be a list of strings.\")\n        tag = item.strip()\n        if not tag:\n            continue\n        if len(tag) > 50:\n            raise ValueError(\"Tags must be at most 50 characters long.\")\n        key = tag.casefold()\n        if key in seen:\n            continue\n        seen.add(key)\n        tags.append(tag)\n    return tags\n\n\ndef clean_text(data: dict, key: str, label: str):\n    value = data.get(key)\n    if not isinstance(value, str) or not value.strip():\n        return None, f\"{label} is required.\"\n    return value, None\n\n\ndef like_pattern(value: str) -> str:\n    escaped = value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n    return f\"%{escaped}%\"\n\n\ndef page_int(name: str, default: int, maximum: int) -> int:\n    raw = request.args.get(name)\n    try:\n        value = int(raw) if raw is not None else default\n    except (TypeError, ValueError):\n        return default\n    if value < 1:\n        return default\n    return min(value, maximum)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required.\", 400)\n    username = username.strip()\n    if len(username) > 50:\n        return error(\"Username must be at most 50 characters long.\", 400)\n    if username.casefold() == \"admin\":\n        return error(\"That username is reserved.\", 409)\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required.\", 400)\n    if len(password) > 200:\n        return error(\"Password must be at most 200 characters long.\", 400)\n\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n            \"VALUES (?, ?, 0, ?)\",\n            (username, generate_password_hash(password), iso(utcnow())),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        db.rollback()\n        return error(\"That username is already taken.\", 409)\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required.\", 400)\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password.\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], iso(utcnow())),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    return jsonify(user)\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) == 2 and parts[0].lower() == \"bearer\":\n        db = get_db()\n        db.execute(\"DELETE FROM sessions WHERE token = ?\", (parts[1].strip(),))\n        db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/posts\")\ndef list_posts():\n    user = current_user()\n    page = page_int(\"page\", 1, 1_000_000)\n    page_size = page_int(\"page_size\", 10, 100)\n    q = (request.args.get(\"q\") or \"\").strip()\n    tag = (request.args.get(\"tag\") or \"\").strip()\n    author = (request.args.get(\"author\") or \"\").strip()\n\n    conditions: list[str] = []\n    params: list[object] = []\n    if not (user and user[\"is_admin\"]):\n        conditions.append(\"p.taken_down = 0\")\n    if q:\n        conditions.append(\"(p.title LIKE ? ESCAPE '\\\\' OR p.content LIKE ? ESCAPE '\\\\')\")\n        pattern = like_pattern(q)\n        params.extend([pattern, pattern])\n    if tag:\n        conditions.append(\n            \"EXISTS (SELECT 1 FROM post_tags t WHERE t.post_id = p.id \"\n            \"AND t.tag = ? COLLATE NOCASE)\"\n        )\n        params.append(tag)\n    if author:\n        conditions.append(\"u.username = ? COLLATE NOCASE\")\n        params.append(author)\n    where = (\" WHERE \" + \" AND \".join(conditions)) if conditions else \"\"\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM posts p JOIN users u ON u.id = p.user_id\" + where,\n        params,\n    ).fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT p.*, u.username AS author FROM posts p \"\n        \"JOIN users u ON u.id = p.user_id\" + where +\n        \" ORDER BY p.created_at DESC, p.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_post(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/posts\")\ndef create_post():\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    title, title_error = clean_text(data, \"title\", \"Title\")\n    if title_error:\n        return error(title_error, 400)\n    content, content_error = clean_text(data, \"content\", \"Content\")\n    if content_error:\n        return error(content_error, 400)\n    try:\n        tags = parse_tags(data.get(\"tags\"))\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    db = get_db()\n    created = iso(utcnow())\n    cur = db.execute(\n        \"INSERT INTO posts (user_id, title, content, created_at, updated_at, taken_down) \"\n        \"VALUES (?, ?, ?, ?, ?, 0)\",\n        (user[\"id\"], title.strip(), content, created, created),\n    )\n    post_id = cur.lastrowid\n    for position, tag in enumerate(tags):\n        db.execute(\n            \"INSERT INTO post_tags (post_id, tag, position) VALUES (?, ?, ?)\",\n            (post_id, tag, position),\n        )\n    db.commit()\n    return jsonify(serialize_post(post_row(post_id))), 201\n\n\n@app.get(\"/api/posts/<int:post_id>\")\ndef get_post(post_id: int):\n    user = current_user()\n    row = post_row(post_id)\n    if row is None or (row[\"taken_down\"] and not (user and user[\"is_admin\"])):\n        return error(\"Post not found.\", 404)\n    return jsonify(serialize_post(row))\n\n\n@app.put(\"/api/posts/<int:post_id>\")\ndef update_post(post_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    row = post_row(post_id)\n    if row is None or (row[\"taken_down\"] and not user[\"is_admin\"]):\n        return error(\"Post not found.\", 404)\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(\"Only the author may edit this post.\", 403)\n    data = json_body()\n    if data is None:\n        return error(\"Expected a JSON object.\", 400)\n    title, title_error = clean_text(data, \"title\", \"Title\")\n    if title_error:\n        return error(title_error, 400)\n    content, content_error = clean_text(data, \"content\", \"Content\")\n    if content_error:\n        return error(content_error, 400)\n    try:\n        tags = parse_tags(data.get(\"tags\"))\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    updated = next_timestamp(row[\"updated_at\"])\n    db = get_db()\n    db.execute(\n        \"UPDATE posts SET title = ?, content = ?, updated_at = ? WHERE id = ?\",\n        (title.strip(), content, updated, post_id),\n    )\n    db.execute(\"DELETE FROM post_tags WHERE post_id = ?\", (post_id,))\n    for position, tag in enumerate(tags):\n        db.execute(\n            \"INSERT INTO post_tags (post_id, tag, position) VALUES (?, ?, ?)\",\n            (post_id, tag, position),\n        )\n    db.commit()\n    return jsonify(serialize_post(post_row(post_id)))\n\n\n@app.delete(\"/api/posts/<int:post_id>\")\ndef delete_post(post_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    row = post_row(post_id)\n    if row is None or (row[\"taken_down\"] and not user[\"is_admin\"]):\n        return error(\"Post not found.\", 404)\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(\"Only the author may delete this post.\", 403)\n    db = get_db()\n    db.execute(\"DELETE FROM posts WHERE id = ?\", (post_id,))\n    db.commit()\n    return \"\", 204\n\n\n@app.post(\"/api/admin/posts/<int:post_id>/toggle\")\ndef admin_toggle_post(post_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n    if not user[\"is_admin\"]:\n        return error(\"Administrator access required.\", 403)\n    row = post_row(post_id)\n    if row is None:\n        return error(\"Post not found.\", 404)\n    db = get_db()\n    db.execute(\n        \"UPDATE posts SET taken_down = ? WHERE id = ?\",\n        (0 if row[\"taken_down\"] else 1, post_id),\n    )\n    db.commit()\n    return jsonify(serialize_post(post_row(post_id)))\n\n\n@app.get(\"/\")\ndef frontend_index():\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/<path:path>\")\ndef frontend_file(path: str):\n    if path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nPY\npython -m py_compile backend/app.py && echo OK","time":{"start":1794366486654,"end":1794366486675}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c893b86e0012cRrIbJ1tCQuvC","sessionID":"ses_e376e6433ffeibGYAqJ5ZTtj28","messageID":"msg_1c891d4df001UHnncwrs3LIDWm"}}
