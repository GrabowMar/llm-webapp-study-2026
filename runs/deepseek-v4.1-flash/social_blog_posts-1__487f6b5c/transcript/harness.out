r();\n  const [title, setTitle] = useState(\"\");\n  const [content, setContent] = useState(\"\");\n  const [tags, setTags] = useState<string[]>([]);\n  const [tagDraft, setTagDraft] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(Boolean(id));\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (!authLoading && !user) {\n      navigate(`/login?next=${encodeURIComponent(id ? `/posts/${id}/edit` : \"/new\")}`);\n    }\n  }, [authLoading, user, id, navigate]);\n\n  useEffect(() => {\n    if (!id) return;\n    let active = true;\n    request<Post>(`/api/posts/${id}`)\n      .then((post) => {\n        if (!active) return;\n        setTitle(post.title);\n        setContent(post.content);\n        setTags(post.tags);\n      })\n      .catch((err) => {\n        if (active) setError(err instanceof Error ? err.message : \"Failed to load post.\");\n      })\n      .finally(() => {\n        if (active) setLoading(false);\n      });\n    return () => {\n      active = false;\n    };\n  }, [id]);\n\n  function addTags(raw: string) {\n    const parts = raw\n      .split(\",\")\n      .map((part) => part.trim())\n      .filter(Boolean);\n    if (parts.length === 0) return;\n    setTags((current) => {\n      const seen = new Set(current.map((t) => t.toLowerCase()));\n      const next = [...current];\n      for (const part of parts) {\n        const key = part.toLowerCase();\n        if (seen.has(key)) continue;\n        seen.add(key);\n        next.push(part);\n      }\n      return next;\n    });\n  }\n\n  function onTagKeyDown(event: React.KeyboardEvent<HTMLInputElement>) {\n    if (event.key === \"Enter\" || event.key === \",\") {\n      event.preventDefault();\n      addTags(tagDraft);\n      setTagDraft(\"\");\n    } else if (event.key === \"Backspace\" && !tagDraft && tags.length > 0) {\n      setTags((current) => current.slice(0, -1));\n    }\n  }\n\n  async function submit(event: FormEvent) {\n    event.preventDefault();\n    setError(null);\n    const finalTags = [...tags];\n    if (tagDraft.trim()) {\n      const extra = tagDraft\n        .split(\",\")\n        .map((p) => p.trim())\n        .filter(Boolean);\n      for (const tag of extra) {\n        if (!finalTags.some((t) => t.toLowerCase() === tag.toLowerCase())) {\n          finalTags.push(tag);\n        }\n      }\n    }\n    setBusy(true);\n    try {\n      const body = { title, content, tags: finalTags };\n      if (id) {\n        const updated = await request<Post>(`/api/posts/${id}`, {\n          method: \"PUT\",\n          body,\n        });\n        navigate(`/posts/${updated.id}`);\n      } else {\n        const created = await request<Post>(\"/api/posts\", {\n          method: \"POST\",\n          body,\n        });\n        navigate(`/posts/${created.id}`);\n      }\n    } catch (err) {\n      setError(\n        err instanceof ApiError || err instanceof Error\n          ? err.message\n          : \"Failed to save the post.\",\n      );\n      setBusy(false);\n    }\n  }\n\n  if (authLoading || loading) return <Spinner />;\n  if (!user) return null;\n\n  return (\n    <div className=\"mx-auto max-w-3xl\">\n      <h1 className=\"mb-6 text-2xl font-bold\">{id ? \"Edit post\" : \"New post\"}</h1>\n      <form\n        onSubmit={submit}\n        className=\"space-y-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm\"\n      >\n        {error && <Alert>{error}</Alert>}\n        <Field label=\"Title\">\n          <TextInput\n            value={title}\n            onChange={(e) => setTitle(e.target.value)}\n            required\n            maxLength={200}\n            placeholder=\"An eye-catching title\"\n          />\n        </Field>\n        <Field label=\"Content\" hint=\"Line breaks are preserved when the post is displayed.\">\n          <TextArea\n            value={content}\n            onChange={(e) => setContent(e.target.value)}\n            required\n           