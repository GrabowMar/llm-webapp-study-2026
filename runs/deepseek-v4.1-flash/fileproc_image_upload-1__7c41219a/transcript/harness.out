der_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_images_uploader\n                ON images(uploader_id);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    return jsonify(error=message), status\n\n\ndef json_body() -> dict | None:\n    body = request.get_json(silent=True)\n    return body if isinstance(body, dict) else None\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    return get_db().execute(\n        \"\"\"\n        SELECT u.id, u.username\n        FROM tokens AS t\n        JOIN users AS u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token.strip(),),\n    ).fetchone()\n\n\ndef require_user() -> sqlite3.Row | None:\n    return current_user()\n","exit":0,"truncated":false},"title":"cd /workspace && git diff --stat && git status --short && sed -n '1,120p' backend/app.py","time":{"start":1794342335398,"end":1794342335441}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c723339e001hZL3x1p0g17cPo","sessionID":"ses_e38e72f74ffeKXuCEiKDNu9kHQ","messageID":"msg_1c722fdc1001jizkAlmWMsw53E"}}
