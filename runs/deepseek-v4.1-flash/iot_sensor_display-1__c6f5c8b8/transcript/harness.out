sors SET last_value = ?, last_updated = ? WHERE id = ?\",\n        (value, recorded_at, sensor_id),\n    )\n    db.commit()\n    reading = db.execute(\n        \"SELECT * FROM readings WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(reading_json(reading)), 201\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"    recorded_at = utcnow()\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n        (sensor_id, value, recorded_at),\n    )\n    db.execute(\n        \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n        (value, recorded_at, sensor_id),\n    )\n    db.commit()\n    reading = db.execute(\n        \"SELECT * FROM readings WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(reading_json(reading)), 201\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return error(\"not found\", 404)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))","lineStart":330,"lineEnd":368,"totalLines":368,"truncated":false}},"title":"backend/app.py","time":{"start":1794372218853,"end":1794372218861}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8eb2fe0001sjGtF0qhdzHDd9","sessionID":"ses_e371ecd85ffetuxErfgozmd2zb","messageID":"msg_1c8eb0df1001zqVlxapheth3af"}}
