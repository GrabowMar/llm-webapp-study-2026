{"type":"tool_use","timestamp":1794371678242,"sessionID":"ses_e371ecd85ffetuxErfgozmd2zb","part":{"type":"tool","tool":"write","callID":"call_23ea364c73a34d80950b986d","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the sensor dashboard.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"dashboard.db\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exception=None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sensors (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL,\n                unit TEXT NOT NULL DEFAULT '',\n                location TEXT NOT NULL DEFAULT '',\n                owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                last_value REAL,\n                last_updated TEXT,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS readings (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n                value REAL NOT NULL,\n                recorded_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_readings_sensor\n                ON readings(sensor_id, recorded_at DESC, id DESC);\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\":\n        return None\n    token = token.strip()\n    return token or None\n\n\ndef current_user() -> sqlite3.Row | None:\n    token = bearer_token()\n    if token is None:\n        return None\n    return get_db().execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM tokens JOIN users ON users.id = tokens.user_id\n        WHERE tokens.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef sensor_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"last_value\": row[\"last_value\"],\n        \"last_updated\": row[\"last_updated\"],\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef reading_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"sensor_id\": row[\"sensor_id\"],\n        \"value\": row[\"value\"],\n        \"recorded_at\": row[\"recorded_at\"],\n    }\n\n\nSENSOR_SELECT = \"\"\"\n    SELECT sensors.*, users.username AS owner\n    FROM sensors JOIN users ON users.id = sensors.owner_id\n\"\"\"\n\n\ndef fetch_sensor(sensor_id: int) -> sqlite3.Row | None:\n    return get_db().execute(\n        SENSOR_SELECT + \" WHERE sensors.id = ?\", (sensor_id,)\n    ).fetchone()\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    if db.execute(\"SELECT 1 FROM users WHERE username = ?\", (username,)).fetchone():\n        return error(\"username already taken\", 409)\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utcnow()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already taken\", 409)\n    return jsonify({\"id\": db.execute(\"SELECT last_insert_rowid()\").fetchone()[0], \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n    username = username.strip()\n\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = get_db().execute(SENSOR_SELECT + \" ORDER BY sensors.name ASC, sensors.id ASC\").fetchall()\n    return jsonify({\"items\": [sensor_json(row) for row in rows]})\n\n\n@app.post(\"/api/sensors\")\n@login_required\ndef create_sensor():\n    data = json_body()\n    name = data.get(\"name\")\n    unit = data.get(\"unit\", \"\")\n    location = data.get(\"location\", \"\")\n    if not isinstance(name, str) or not name.strip():\n        return error(\"name is required\", 400)\n    if not isinstance(unit, str) or not isinstance(location, str):\n        return error(\"unit and location must be strings\", 400)\n\n    db = get_db()\n    cursor = db.execute(\n        \"\"\"\n        INSERT INTO sensors (name, unit, location, owner_id, last_value, last_updated, created_at)\n        VALUES (?, ?, ?, ?, NULL, NULL, ?)\n        \"\"\",\n        (name.strip(), unit, location, g.user[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify(sensor_json(fetch_sensor(cursor.lastrowid))), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef get_sensor(sensor_id: int):\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    return jsonify(sensor_json(row))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\n@login_required\ndef delete_sensor(sensor_id: int):\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    if row[\"owner_id\"] != g.user[\"id\"]:\n        return error(\"not allowed\", 403)\n\n    db = get_db()\n    db.execute(\"DELETE FROM readings WHERE sensor_id = ?\", (sensor_id,))\n    db.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n    db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id: int):\n    if fetch_sensor(sensor_id) is None:\n        return error(\"sensor not found\", 404)\n\n    limit_arg = request.args.get(\"limit\")\n    limit = None\n    if limit_arg is not None and limit_arg != \"\":\n        try:\n            limit = int(limit_arg)\n        except ValueError:\n            return error(\"limit must be an integer\", 400)\n        if limit < 0:\n            return error(\"limit must be non-negative\", 400)\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[0]\n    query = (\n        \"SELECT * FROM readings WHERE sensor_id = ? \"\n        \"ORDER BY recorded_at DESC, id DESC\"\n    )\n    params: tuple = (sensor_id,)\n    if limit is not None:\n        query += \" LIMIT ?\"\n        params += (limit,)\n    rows = db.execute(query, params).fetchall()\n    return jsonify({\"items\": [reading_json(row) for row in rows], \"total\": total})\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\n@login_required\ndef create_reading(sensor_id: int):\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(\"sensor not found\", 404)\n    if row[\"owner_id\"] != g.user[\"id\"]:\n        return error(\"not allowed\", 403)\n\n    data = json_body()\n    value = data.get(\"value\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return error(\"value must be a number\", 400)\n    value = float(value)\n    if value != value or value in (float(\"inf\"), float(\"-inf\")):\n        return error(\"value must be a number\", 400)\n\n    recorded_at = utcnow()\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n        (sensor_id, value, recorded_at),\n    )\n    db.execute(\n        \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n        (value, recorded_at, sensor_id),\n    )\n    db.commit()\n    reading = db.execute(\n        \"SELECT * FROM readings WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(reading_json(reading)), 201\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return error(\"not found\", 404)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794371678185,"end":1794371678209}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8e2efdd001AupZ5tTOqHaLv1","sessionID":"ses_e371ecd85ffetuxErfgozmd2zb","messageID":"msg_1c8e24ab90018IfOLHarnlNqtl"}}
