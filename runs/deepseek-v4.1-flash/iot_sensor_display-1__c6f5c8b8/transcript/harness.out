RIMARY KEY AUTOINCREMENT,\n51:                 username TEXT NOT NULL UNIQUE,\n52:                 password_hash TEXT NOT NULL,\n53:                 created_at TEXT NOT NULL\n54:             );\n55: \n56:             CREATE TABLE IF NOT EXISTS sensors (\n57:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n58:                 name TEXT NOT NULL,\n59:                 unit TEXT NOT NULL DEFAULT '',\n60:                 location TEXT NOT NULL DEFAULT '',\n61:                 owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n62:                 last_value REAL,\n63:                 last_updated TEXT,\n64:                 created_at TEXT NOT NULL\n65:             );\n66: \n67:             CREATE TABLE IF NOT EXISTS readings (\n68:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n69:                 sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n70:                 value REAL NOT NULL,\n71:                 recorded_at TEXT NOT NULL\n72:             );\n73: \n74:             CREATE INDEX IF NOT EXISTS idx_readings_sensor\n75:                 ON readings(sensor_id, recorded_at DESC, id DESC);\n76: \n77:             CREATE TABLE IF NOT EXISTS tokens (\n78:                 token TEXT PRIMARY KEY,\n79:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n80:                 created_at TEXT NOT NULL\n\n(Showing lines 1-80 of 368. Use offset=81 to continue.)\n</content>","metadata":{"preview":"\"\"\"Flask entry point for the sensor dashboard.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"dashboard.db\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point for the sensor dashboard.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"dashboard.db\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exception=None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sensors (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL,\n                unit TEXT NOT NULL DEFAULT '',\n                location TEXT NOT NULL DEFAULT '',\n                owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                last_value REAL,\n                last_updated TEXT,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS readings (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n                value REAL NOT NULL,\n                recorded_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_readings_sensor\n                ON readings(sensor_id, recorded_at DESC, id DESC);\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL","lineStart":1,"lineEnd":80,"totalLines":368,"truncated":true}},"title":"backend/app.py","time":{"start":1794372207165,"end":1794372207181}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8eb0234001IAmlQi2hGNDCnA","sessionID":"ses_e371ecd85ffetuxErfgozmd2zb","messageID":"msg_1c8eaf111001fzcoxaoSIkpof5"}}
