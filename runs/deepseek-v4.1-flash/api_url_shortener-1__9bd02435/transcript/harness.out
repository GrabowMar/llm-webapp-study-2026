 /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -120,11 +120,12 @@\n \n \n def auth_user():\n     header = request.headers.get(\"Authorization\", \"\")\n-    if not header.startswith(\"Bearer \"):\n+    parts = header.split(None, 1)\n+    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n         return None\n-    token = header[7:].strip()\n+    token = parts[1].strip()\n     if not token:\n         return None\n     row = get_db().execute(\n         \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n","additions":3,"deletions":2},"truncated":false},"title":"backend/app.py","time":{"start":1794383510521,"end":1794383510536}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9977bf300141NhadDyWtLmcD","sessionID":"ses_e36719fe5ffeGDO7c1n5zTwGad","messageID":"msg_1c99728eb001NH7HuB5ZYOtMue"}}
