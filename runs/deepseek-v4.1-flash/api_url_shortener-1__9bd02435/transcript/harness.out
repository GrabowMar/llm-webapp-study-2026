{"type":"tool_use","timestamp":1794383528867,"sessionID":"ses_e36719fe5ffeGDO7c1n5zTwGad","part":{"type":"tool","tool":"bash","callID":"call_8a350a9e419e409ca0bf5912","state":{"status":"completed","input":{"command":"cd /workspace && sed -n '1,220p' backend/app.py"},"output":"\"\"\"Flask entry point for the URL shortener.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nimport string\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\nCODE_ALPHABET = string.ascii_letters + string.digits\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 30000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS links (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                original_url TEXT NOT NULL,\n                short_code TEXT NOT NULL UNIQUE,\n                click_count INTEGER NOT NULL DEFAULT 0,\n                disabled INTEGER NOT NULL DEFAULT 0,\n                owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_links_owner ON links(owner_id);\n            CREATE INDEX IF NOT EXISTS idx_links_created ON links(created_at DESC, id DESC);\n            \"\"\"\n        )\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        existing = conn.execute(\n            \"SELECT id FROM users WHERE username = 'admin' COLLATE NOCASE\"\n        ).fetchone()\n        if admin_password:\n            password_hash = generate_password_hash(admin_password)\n            if existing is None:\n                try:\n                    conn.execute(\n                        \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n                        \"VALUES ('admin', ?, 1, ?)\",\n                        (password_hash, utcnow()),\n                    )\n                except sqlite3.IntegrityError:\n                    conn.execute(\n                        \"UPDATE users SET password_hash = ?, is_admin = 1 \"\n                        \"WHERE username = 'admin' COLLATE NOCASE\",\n                        (password_hash,),\n                    )\n            else:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (password_hash, existing[\"id\"]),\n                )\n        elif existing is not None:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(secrets.token_urlsafe(32)), existing[\"id\"]),\n            )\n            conn.execute(\"DELETE FROM sessions WHERE user_id = ?\", (existing[\"id\"],))\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef json_error(message: str, status: int):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\ndef auth_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user():\n    user = auth_user()\n    if user is None:\n        return None, json_error(\"Authentication required\", 401)\n    return user, None\n\n\ndef require_admin():\n    user, error = require_user()\n    if error is not None:\n        return None, error\n    if not user[\"is_admin\"]:\n        return None, json_error(\"Admin access required\", 403)\n    return user, None\n\n\ndef new_short_code(db: sqlite3.Connection) -> str:\n    while True:\n        code = \"\".join(secrets.choice(CODE_ALPHABET) for _ in range(7))\n        exists = db.execute(\n            \"SELECT 1 FROM links WHERE short_code = ?\", (code,)\n        ).fetchone()\n        if exists is None:\n            return code\n\n\ndef link_dict(row: sqlite3.Row) -> dict:\n    keys = row.keys()\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"] if \"owner\" in keys else row[\"owner_username\"],\n        \"disabled\": bool(row[\"disabled\"]),\n        \"active\": not bool(row[\"disabled\"]),\n    }\n\n\nLINK_SELECT = (\n    \"SELECT l.*, u.username AS owner FROM links l \"\n    \"JOIN users u ON u.id = l.owner_id\"\n)\n\n\ndef pagination_args():\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        page_size = 10\n    page = max(page, 1)\n    page_size = min(max(page_size, 1), 100)\n    return page, page_size\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(error: HTTPException):\n    if request.path.startswith(\"/api/\"):\n        return json_error(error.description or error.name, error.code or 500)\n    return error\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    payload = request.get_json(silent=True) or {}\n    username = payload.get(\"username\")\n    password = payload.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"Username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return json_error(\"Username and password are required\", 400)\n    if len(username) > 64:\n","metadata":{"output":"\"\"\"Flask entry point for the URL shortener.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nimport string\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\nCODE_ALPHABET = string.ascii_letters + string.digits\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 30000\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS links (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                original_url TEXT NOT NULL,\n                short_code TEXT NOT NULL UNIQUE,\n                click_count INTEGER NOT NULL DEFAULT 0,\n                disabled INTEGER NOT NULL DEFAULT 0,\n                owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_links_owner ON links(owner_id);\n            CREATE INDEX IF NOT EXISTS idx_links_created ON links(created_at DESC, id DESC);\n            \"\"\"\n        )\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        existing = conn.execute(\n            \"SELECT id FROM users WHERE username = 'admin' COLLATE NOCASE\"\n        ).fetchone()\n        if admin_password:\n            password_hash = generate_password_hash(admin_password)\n            if existing is None:\n                try:\n                    conn.execute(\n                        \"INSERT INTO users (username, password_hash, is_admin, created_at) \"\n                        \"VALUES ('admin', ?, 1, ?)\",\n                        (password_hash, utcnow()),\n                    )\n                except sqlite3.IntegrityError:\n                    conn.execute(\n                        \"UPDATE users SET password_hash = ?, is_admin = 1 \"\n                        \"WHERE username = 'admin' COLLATE NOCASE\",\n                        (password_hash,),\n                    )\n            else:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (password_hash, existing[\"id\"]),\n                )\n        elif existing is not None:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(secrets.token_urlsafe(32)), existing[\"id\"]),\n            )\n            conn.execute(\"DELETE FROM sessions WHERE user_id = ?\", (existing[\"id\"],))\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef json_error(message: str, status: int):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\ndef auth_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user():\n    user = auth_user()\n    if user is None:\n        return None, json_error(\"Authentication required\", 401)\n    return user, None\n\n\ndef require_admin():\n    user, error = require_user()\n    if error is not None:\n        return None, error\n    if not user[\"is_admin\"]:\n        return None, json_error(\"Admin access required\", 403)\n    return user, None\n\n\ndef new_short_code(db: sqlite3.Connection) -> str:\n    while True:\n        code = \"\".join(secrets.choice(CODE_ALPHABET) for _ in range(7))\n        exists = db.execute(\n            \"SELECT 1 FROM links WHERE short_code = ?\", (code,)\n        ).fetchone()\n        if exists is None:\n            return code\n\n\ndef link_dict(row: sqlite3.Row) -> dict:\n    keys = row.keys()\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"] if \"owner\" in keys else row[\"owner_username\"],\n        \"disabled\": bool(row[\"disabled\"]),\n        \"active\": not bool(row[\"disabled\"]),\n    }\n\n\nLINK_SELECT = (\n    \"SELECT l.*, u.username AS owner FROM links l \"\n    \"JOIN users u ON u.id = l.owner_id\"\n)\n\n\ndef pagination_args():\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        page_size = 10\n    page = max(page, 1)\n    page_size = min(max(page_size, 1), 100)\n    return page, page_size\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(error: HTTPException):\n    if request.path.startswith(\"/api/\"):\n        return json_error(error.description or error.name, error.code or 500)\n    return error\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    payload = request.get_json(silent=True) or {}\n    username = payload.get(\"username\")\n    password = payload.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return json_error(\"Username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return json_error(\"Username and password are required\", 400)\n    if len(username) > 64:\n","exit":0,"truncated":false},"title":"cd /workspace && sed -n '1,220p' backend/app.py","time":{"start":1794383528831,"end":1794383528851}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c997c376001GM0vFVDbFGe3XK","sessionID":"ses_e36719fe5ffeGDO7c1n5zTwGad","messageID":"msg_1c9977c15001TlHR79czgl3wOx"}}
