ame':'u','password':'p'}); assert r.status_code == 201\nt = c.post('/api/auth/login', json={'username':'u','password':'p'}).get_json()['token']\nh = {'Authorization': 'Bearer ' + t}\nids = [c.post('/api/tasks', json={'title': f't{i}'}, headers=h).get_json()['id'] for i in range(3)]\nc.patch(f'/api/tasks/{ids[2]}', json={'position': 1}, headers=h)\nd = c.get('/api/tasks').get_json()\nassert [(x['id'], x['position']) for x in d['items']] == [(ids[2],1),(ids[0],2),(ids[1],3)], d\nc.patch(f'/api/tasks/{ids[0]}', json={'status':'done'}, headers=h)\nd = c.get('/api/tasks').get_json()\nassert d['counts'] == {'todo':2,'in_progress':0,'done':1}, d\nassert c.delete(f'/api/tasks/{ids[2]}', headers=h).status_code == 204\nd = c.get('/api/tasks').get_json()\nassert [(x['id'], x['position']) for x in d['items']] == [(ids[1],1),(ids[0],1)], d\nprint('ALL_OK')\nPY\nrm -rf /workspace/.tmp-final /workspace/frontend/dist /workspace/backend/__pycache__","time":{"start":1794378985028,"end":1794378986251}},"id":"prt_1c9526e3d0018ztbCrXMCvhtke","sessionID":"ses_e36bef94cffeuwdxbP45OM42u3","messageID":"msg_1c95227c8001Ai3ZlvpiucWly5"}}
