{"type":"tool_use","timestamp":1794378238845,"sessionID":"ses_e36bef94cffeuwdxbP45OM42u3","part":{"type":"tool","tool":"write","callID":"call_84f77ca8cf3140fe94da9b57","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the shared kanban board.\"\"\"\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"kanban.db\"\n\nSTATUSES = (\"todo\", \"in_progress\", \"done\")\nSTATUS_ORDER = {status: index for index, status in enumerate(STATUSES)}\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens(user_id);\n\nCREATE TABLE IF NOT EXISTS tasks (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    status TEXT NOT NULL,\n    priority TEXT NOT NULL DEFAULT 'medium',\n    position INTEGER NOT NULL DEFAULT 1,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_tasks_column\n    ON tasks(status, position);\n\"\"\"\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef connect() -> sqlite3.Connection:\n    connection = sqlite3.connect(DB_PATH, timeout=30)\n    connection.row_factory = sqlite3.Row\n    connection.execute(\"PRAGMA foreign_keys = ON\")\n    connection.execute(\"PRAGMA busy_timeout = 30000\")\n    return connection\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    connection = connect()\n    try:\n        connection.executescript(SCHEMA)\n        connection.commit()\n    finally:\n        connection.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_error=None) -> None:\n    connection = g.pop(\"db\", None)\n    if connection is not None:\n        connection.close()\n\n\ninit_db()\n\n\ndef error(message: str, status: int = 400):\n    return jsonify({\"error\": message}), status\n\n\ndef task_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"status\": row[\"status\"],\n        \"priority\": row[\"priority\"],\n        \"position\": row[\"position\"],\n        \"updated_at\": row[\"updated_at\"],\n    }\n\n\ndef renumber(connection: sqlite3.Connection, status: str) -> None:\n    rows = connection.execute(\n        \"SELECT id FROM tasks WHERE status = ? ORDER BY position, id\", (status,)\n    ).fetchall()\n    for index, row in enumerate(rows, start=1):\n        connection.execute(\n            \"UPDATE tasks SET position = ? WHERE id = ?\", (index, row[\"id\"])\n        )\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split()\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    return get_db().execute(\n        \"\"\"\n        SELECT users.id, users.username\n        FROM tokens\n        JOIN users ON users.id = tokens.user_id\n        WHERE tokens.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef validate_title(value):\n    if not isinstance(value, str) or not value.strip():\n        return None, \"Title is required\"\n    title = value.strip()\n    if len(title) > 500:\n        return None, \"Title must be 500 characters or fewer\"\n    return title, None\n\n\ndef validate_description(value):\n    if value is None:\n        return \"\", None\n    if not isinstance(value, str):\n        return None, \"Description must be text\"\n    return value, None\n\n\ndef validate_priority(value):\n    if not isinstance(value, str) or not value.strip():\n        return None, \"Priority is required\"\n    priority = value.strip()\n    if len(priority) > 50:\n        return None, \"Priority must be 50 characters or fewer\"\n    return priority, None\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"A JSON body is required\")\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\")\n    username = username.strip()\n    if len(username) > 100:\n        return error(\"Username must be 100 characters or fewer\")\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required\")\n    if len(password) > 1000:\n        return error(\"Password is too long\")\n\n    connection = get_db()\n    try:\n        cursor = connection.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utcnow()),\n        )\n        connection.commit()\n    except sqlite3.IntegrityError:\n        connection.rollback()\n        return error(\"Username is already taken\", 409)\n\n    user_id = cursor.lastrowid\n    token = secrets.token_urlsafe(32)\n    connection.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, utcnow()),\n    )\n    connection.commit()\n    return jsonify({\"id\": user_id, \"username\": username, \"token\": token}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"A JSON body is required\")\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\")\n    if not isinstance(password, str) or not password:\n        return error(\"Password is required\")\n\n    connection = get_db()\n    row = connection.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    connection.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    connection.commit()\n    return jsonify(\n        {\"token\": token, \"id\": row[\"id\"], \"username\": row[\"username\"]}\n    )\n\n\n@app.get(\"/api/tasks\")\ndef list_tasks():\n    status = request.args.get(\"status\")\n    priority = request.args.get(\"priority\")\n\n    if status is not None and status != \"\" and status not in STATUSES:\n        return error(\"Invalid status filter\")\n\n    connection = get_db()\n    clauses = []\n    params = []\n    if status:\n        clauses.append(\"status = ?\")\n        params.append(status)\n    if priority:\n        clauses.append(\"priority = ?\")\n        params.append(priority)\n\n    where = f\"WHERE {' AND '.join(clauses)}\" if clauses else \"\"\n    rows = connection.execute(\n        f\"\"\"\n        SELECT * FROM tasks\n        {where}\n        ORDER BY CASE status\n            WHEN 'todo' THEN 0\n            WHEN 'in_progress' THEN 1\n            WHEN 'done' THEN 2\n            ELSE 3\n        END, position, id\n        \"\"\",\n        params,\n    ).fetchall()\n\n    counts = {name: 0 for name in STATUSES}\n    for row in rows:\n        if row[\"status\"] in counts:\n            counts[row[\"status\"]] += 1\n\n    return jsonify(\n        {\n            \"items\": [task_json(row) for row in rows],\n            \"total\": len(rows),\n            \"counts\": counts,\n        }\n    )\n\n\n@app.get(\"/api/tasks/<int:task_id>\")\ndef get_task(task_id: int):\n    row = get_db().execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    if row is None:\n        return error(\"Task not found\", 404)\n    return jsonify(task_json(row))\n\n\n@app.post(\"/api/tasks\")\n@login_required\ndef create_task():\n    data = json_body()\n    if data is None:\n        return error(\"A JSON body is required\")\n\n    title, message = validate_title(data.get(\"title\"))\n    if message:\n        return error(message)\n    description, message = validate_description(data.get(\"description\", \"\"))\n    if message:\n        return error(message)\n    priority, message = validate_priority(data.get(\"priority\", \"medium\"))\n    if message:\n        return error(message)\n    status = data.get(\"status\", \"todo\")\n    if status not in STATUSES:\n        return error(\"Invalid status\")\n\n    connection = get_db()\n    now = utcnow()\n    position = connection.execute(\n        \"SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE status = ?\",\n        (status,),\n    ).fetchone()[0]\n    cursor = connection.execute(\n        \"\"\"\n        INSERT INTO tasks\n            (title, description, status, priority, position, created_at, updated_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (title, description, status, priority, position, now, now),\n    )\n    connection.commit()\n    row = connection.execute(\n        \"SELECT * FROM tasks WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(task_json(row)), 201\n\n\n@app.patch(\"/api/tasks/<int:task_id>\")\n@login_required\ndef update_task(task_id: int):\n    data = json_body()\n    if data is None:\n        return error(\"A JSON body is required\")\n\n    connection = get_db()\n    existing = connection.execute(\n        \"SELECT * FROM tasks WHERE id = ?\", (task_id,)\n    ).fetchone()\n    if existing is None:\n        return error(\"Task not found\", 404)\n\n    updates = {}\n\n    if \"title\" in data:\n        title, message = validate_title(data[\"title\"])\n        if message:\n            return error(message)\n        updates[\"title\"] = title\n\n    if \"description\" in data:\n        description, message = validate_description(data[\"description\"])\n        if message:\n            return error(message)\n        updates[\"description\"] = description\n\n    if \"priority\" in data:\n        priority, message = validate_priority(data[\"priority\"])\n        if message:\n            return error(message)\n        updates[\"priority\"] = priority\n\n    new_status = existing[\"status\"]\n    if \"status\" in data:\n        if data[\"status\"] not in STATUSES:\n            return error(\"Invalid status\")\n        new_status = data[\"status\"]\n\n    requested_position = None\n    if \"position\" in data:\n        position = data[\"position\"]\n        if isinstance(position, bool) or not isinstance(position, int):\n            return error(\"Position must be an integer\")\n        requested_position = position\n\n    relocate = new_status != existing[\"status\"] or requested_position is not None\n\n    if relocate:\n        target_rows = connection.execute(\n            \"\"\"\n            SELECT id FROM tasks\n            WHERE status = ? AND id <> ?\n            ORDER BY position, id\n            \"\"\",\n            (new_status, task_id),\n        ).fetchall()\n        target_ids = [row[\"id\"] for row in target_rows]\n\n        if requested_position is None:\n            insert_index = len(target_ids)\n        else:\n            insert_index = max(1, min(requested_position, len(target_ids) + 1)) - 1\n\n        if new_status != existing[\"status\"]:\n            source_rows = connection.execute(\n                \"\"\"\n                SELECT id FROM tasks\n                WHERE status = ? AND id <> ?\n                ORDER BY position, id\n                \"\"\",\n                (existing[\"status\"], task_id),\n            ).fetchall()\n            for index, row in enumerate(source_rows, start=1):\n                connection.execute(\n                    \"UPDATE tasks SET position = ? WHERE id = ?\",\n                    (index, row[\"id\"]),\n                )\n\n        target_ids.insert(insert_index, task_id)\n        for index, target_id in enumerate(target_ids, start=1):\n            connection.execute(\n                \"UPDATE tasks SET position = ? WHERE id = ?\",\n                (index, target_id),\n            )\n\n        updates[\"status\"] = new_status\n        updates[\"position\"] = insert_index + 1\n\n    if updates:\n        updates[\"updated_at\"] = utcnow()\n        assignments = \", \".join(f\"{column} = ?\" for column in updates)\n        connection.execute(\n            f\"UPDATE tasks SET {assignments} WHERE id = ?\",\n            (*updates.values(), task_id),\n        )\n        connection.commit()\n\n    row = connection.execute(\"SELECT * FROM tasks WHERE id = ?\", (task_id,)).fetchone()\n    return jsonify(task_json(row))\n\n\n@app.delete(\"/api/tasks/<int:task_id>\")\n@login_required\ndef delete_task(task_id: int):\n    connection = get_db()\n    row = connection.execute(\n        \"SELECT status FROM tasks WHERE id = ?\", (task_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"Task not found\", 404)\n\n    connection.execute(\"DELETE FROM tasks WHERE id = ?\", (task_id,))\n    renumber(connection, row[\"status\"])\n    connection.commit()\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    target = (DIST / path).resolve()\n    try:\n        target.relative_to(DIST.resolve())\n    except ValueError:\n        return error(\"Not found\", 404)\n    if target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")), debug=True)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794378238743,"end":1794378238763}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9470b0d001CuTRoRI5ohCftj","sessionID":"ses_e36bef94cffeuwdxbP45OM42u3","messageID":"msg_1c9455542001Bhpgih43SnJ3k9"}}
