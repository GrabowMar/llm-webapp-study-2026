{"type":"tool_use","timestamp":1794361191915,"sessionID":"ses_e37c3318cffepkbIZ3j04W7UeH","part":{"type":"tool","tool":"write","callID":"call_3a474d4dc7da44ecabf99e13","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Timesheet API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport io\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import date, datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", DATA_DIR / \"timesheet.db\"))\nTOKEN_TTL = timedelta(days=30)\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS entries (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    project TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    hours REAL NOT NULL,\n    entry_date TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_entries_user_date ON entries(user_id, entry_date);\n\"\"\"\n\n\ndef utcnow() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso_now() -> str:\n    return utcnow().isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    conn = getattr(g, \"_db\", None)\n    if conn is None:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        g._db = conn\n    return conn\n\n\n@app.teardown_appcontext\ndef close_db(exception):\n    conn = getattr(g, \"_db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef error(message, status=400, fields=None):\n    payload = {\"error\": message}\n    if fields:\n        payload[\"fields\"] = fields\n    return jsonify(payload), status\n\n\ndef parse_date(value, field):\n    if not isinstance(value, str) or not value.strip():\n        raise ValueError(f\"{field} is required\")\n    try:\n        parsed = date.fromisoformat(value.strip())\n    except ValueError:\n        raise ValueError(f\"{field} must be a date in YYYY-MM-DD format\")\n    return parsed\n\n\ndef parse_hours(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError(\"hours is required\")\n    try:\n        hours = float(value)\n    except (TypeError, ValueError):\n        raise ValueError(\"hours must be a number\")\n    if hours != hours or hours in (float(\"inf\"), float(\"-inf\")):\n        raise ValueError(\"hours must be a number\")\n    if hours <= 0:\n        raise ValueError(\"hours must be greater than 0\")\n    if hours > 24:\n        raise ValueError(\"hours must be at most 24\")\n    return round(hours, 2)\n\n\ndef clean_text(value, field, max_length, required=True):\n    if value is None:\n        value = \"\"\n    if not isinstance(value, str):\n        raise ValueError(f\"{field} must be text\")\n    value = value.strip()\n    if required and not value:\n        raise ValueError(f\"{field} is required\")\n    if len(value) > max_length:\n        raise ValueError(f\"{field} must be at most {max_length} characters\")\n    return value\n\n\ndef entry_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"project\": row[\"project\"],\n        \"description\": row[\"description\"],\n        \"hours\": row[\"hours\"],\n        \"date\": row[\"entry_date\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef auth_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        if not header.startswith(\"Bearer \"):\n            return error(\"Authentication required\", 401)\n        token = header[len(\"Bearer \"):].strip()\n        if not token:\n            return error(\"Authentication required\", 401)\n        db = get_db()\n        row = db.execute(\n            \"SELECT user_id FROM tokens WHERE token = ?\", (token,)\n        ).fetchone()\n        if row is None:\n            return error(\"Authentication required\", 401)\n        user = db.execute(\n            \"SELECT id, username FROM users WHERE id = ?\", (row[\"user_id\"],)\n        ).fetchone()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user_id = user[\"id\"]\n        g.username = user[\"username\"]\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef build_filters():\n    \"\"\"Return (where_clause, params) for entry filters from the query string.\"\"\"\n    clauses = [\"user_id = ?\"]\n    params: list = [g.user_id]\n    start = request.args.get(\"start_date\")\n    end = request.args.get(\"end_date\")\n    project = request.args.get(\"project\")\n    if start:\n        try:\n            params.append(parse_date(start, \"start_date\").isoformat())\n        except ValueError as exc:\n            raise ValueError(str(exc))\n        clauses.append(\"entry_date >= ?\")\n    if end:\n        try:\n            params.append(parse_date(end, \"end_date\").isoformat())\n        except ValueError as exc:\n            raise ValueError(str(exc))\n        clauses.append(\"entry_date <= ?\")\n    if project:\n        clauses.append(\"project = ?\")\n        params.append(project)\n    return \" AND \".join(clauses), params\n\n\ndef csv_cell(value) -> str:\n    \"\"\"Neutralise spreadsheet formula injection so cells are read as text.\"\"\"\n    text = str(value)\n    if text and text[0] in (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\"):\n        return \"'\" + text\n    return text\n\n\ndef csv_response(rows, filename) -> Response:\n    buffer = io.StringIO()\n    writer = csv.writer(buffer, lineterminator=\"\\r\\n\")\n    writer.writerows(rows)\n    body = buffer.getvalue()\n    return Response(\n        body,\n        mimetype=\"text/csv\",\n        headers={\n            \"Content-Type\": \"text/csv; charset=utf-8\",\n            \"Content-Disposition\": f'attachment; filename=\"{filename}\"',\n        },\n    )\n\n\ndef format_hours(value) -> str:\n    number = float(value)\n    if number.is_integer():\n        return str(int(number))\n    return (\"%.2f\" % number).rstrip(\"0\").rstrip(\".\")\n\n\n# ---------------------------------------------------------------------------\n# Auth\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    fields = {}\n    if not isinstance(username, str) or not username.strip():\n        fields[\"username\"] = \"Username is required\"\n    elif len(username.strip()) > 100:\n        fields[\"username\"] = \"Username must be at most 100 characters\"\n    if not isinstance(password, str) or not password:\n        fields[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        fields[\"password\"] = \"Password must be at least 6 characters\"\n    if fields:\n        return error(\"Please correct the highlighted fields\", 400, fields)\n\n    username = username.strip()\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), iso_now()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\n            \"Username is already taken\",\n            409,\n            {\"username\": \"Username is already taken\"},\n        )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\", 400)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], iso_now()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@auth_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    token = header[len(\"Bearer \"):].strip()\n    db = get_db()\n    db.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    db.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/auth/me\")\n@auth_required\ndef me():\n    return jsonify({\"username\": g.username})\n\n\n# ---------------------------------------------------------------------------\n# Entries\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/entries\")\n@auth_required\ndef list_entries():\n    try:\n        where, params = build_filters()\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        return error(\"page must be a positive integer\", 400)\n    try:\n        page_size = int(request.args.get(\"page_size\", 20))\n    except (TypeError, ValueError):\n        return error(\"page_size must be a positive integer\", 400)\n    page_size = max(1, min(page_size, 200))\n\n    db = get_db()\n    total = db.execute(\n        f\"SELECT COUNT(*) AS c FROM entries WHERE {where}\", params\n    ).fetchone()[\"c\"]\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"\"\"SELECT * FROM entries WHERE {where}\n            ORDER BY entry_date DESC, id DESC\n            LIMIT ? OFFSET ?\"\"\",\n        [*params, page_size, offset],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [entry_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/entries\")\n@auth_required\ndef create_entry():\n    data = json_body()\n    fields = {}\n    project = description = entry_date = hours = None\n\n    try:\n        project = clean_text(data.get(\"project\"), \"project\", 200)\n    except ValueError as exc:\n        fields[\"project\"] = str(exc)\n    try:\n        description = clean_text(\n            data.get(\"description\"), \"description\", 2000, required=False\n        )\n    except ValueError as exc:\n        fields[\"description\"] = str(exc)\n    try:\n        hours = parse_hours(data.get(\"hours\"))\n    except ValueError as exc:\n        fields[\"hours\"] = str(exc)\n    try:\n        entry_date = parse_date(data.get(\"date\"), \"date\").isoformat()\n    except ValueError as exc:\n        fields[\"date\"] = str(exc)\n\n    if fields:\n        return error(\"Please correct the highlighted fields\", 400, fields)\n\n    db = get_db()\n    cur = db.execute(\n        \"\"\"INSERT INTO entries (user_id, project, description, hours, entry_date, created_at)\n           VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (g.user_id, project, description, hours, entry_date, iso_now()),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM entries WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(entry_to_dict(row)), 201\n\n\n@app.patch(\"/api/entries/<int:entry_id>\")\n@auth_required\ndef update_entry(entry_id: int):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM entries WHERE id = ? AND user_id = ?\",\n        (entry_id, g.user_id),\n    ).fetchone()\n    if row is None:\n        return error(\"Entry not found\", 404)\n\n    data = json_body()\n    fields = {}\n    updates = {}\n\n    if \"project\" in data:\n        try:\n            updates[\"project\"] = clean_text(data.get(\"project\"), \"project\", 200)\n        except ValueError as exc:\n            fields[\"project\"] = str(exc)\n    if \"description\" in data:\n        try:\n            updates[\"description\"] = clean_text(\n                data.get(\"description\"), \"description\", 2000, required=False\n            )\n        except ValueError as exc:\n            fields[\"description\"] = str(exc)\n    if \"hours\" in data:\n        try:\n            updates[\"hours\"] = parse_hours(data.get(\"hours\"))\n        except ValueError as exc:\n            fields[\"hours\"] = str(exc)\n    if \"date\" in data:\n        try:\n            updates[\"date\"] = parse_date(data.get(\"date\"), \"date\").isoformat()\n        except ValueError as exc:\n            fields[\"date\"] = str(exc)\n\n    if fields:\n        return error(\"Please correct the highlighted fields\", 400, fields)\n    if not updates:\n        return jsonify(entry_to_dict(row))\n\n    column_map = {\"date\": \"entry_date\"}\n    assignments = []\n    params = []\n    for key, value in updates.items():\n        assignments.append(f\"{column_map.get(key, key)} = ?\")\n        params.append(value)\n    params.extend([entry_id, g.user_id])\n    db.execute(\n        f\"UPDATE entries SET {', '.join(assignments)} WHERE id = ? AND user_id = ?\",\n        params,\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM entries WHERE id = ?\", (entry_id,)).fetchone()\n    return jsonify(entry_to_dict(row))\n\n\n@app.delete(\"/api/entries/<int:entry_id>\")\n@auth_required\ndef delete_entry(entry_id: int):\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM entries WHERE id = ? AND user_id = ?\", (entry_id, g.user_id)\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        return error(\"Entry not found\", 404)\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/projects\")\n@auth_required\ndef list_projects():\n    db = get_db()\n    rows = db.execute(\n        \"\"\"SELECT project, SUM(hours) AS total, COUNT(*) AS count\n           FROM entries WHERE user_id = ?\n           GROUP BY project ORDER BY project COLLATE NOCASE\"\"\",\n        (g.user_id,),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\"project\": r[\"project\"], \"hours\": round(r[\"total\"], 2), \"count\": r[\"count\"]}\n                for r in rows\n            ]\n        }\n    )\n\n\n# ---------------------------------------------------------------------------\n# Exports\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/exports/entries.csv\")\n@auth_required\ndef export_entries():\n    try:\n        where, params = build_filters()\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    db = get_db()\n    rows = db.execute(\n        f\"\"\"SELECT * FROM entries WHERE {where}\n            ORDER BY entry_date ASC, id ASC\"\"\",\n        params,\n    ).fetchall()\n\n    csv_rows = [(\"date\", \"project\", \"description\", \"hours\")]\n    for r in rows:\n        csv_rows.append(\n            (\n                r[\"entry_date\"],\n                csv_cell(r[\"project\"]),\n                csv_cell(r[\"description\"]),\n                format_hours(r[\"hours\"]),\n            )\n        )\n    return csv_response(csv_rows, \"entries.csv\")\n\n\n@app.get(\"/api/exports/summary.csv\")\n@auth_required\ndef export_summary():\n    try:\n        where, params = build_filters()\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    db = get_db()\n    rows = db.execute(\n        f\"\"\"SELECT project, SUM(hours) AS total FROM entries\n            WHERE {where}\n            GROUP BY project ORDER BY project COLLATE NOCASE\"\"\",\n        params,\n    ).fetchall()\n\n    csv_rows = [(\"project\", \"hours\")]\n    for r in rows:\n        csv_rows.append((csv_cell(r[\"project\"]), format_hours(r[\"total\"])))\n    return csv_response(csv_rows, \"summary.csv\")\n\n\n# ---------------------------------------------------------------------------\n# Health & frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    candidate = (DIST / path).resolve()\n    try:\n        candidate.relative_to(DIST.resolve())\n    except ValueError:\n        return send_from_directory(DIST, \"index.html\")\n    if candidate.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794361191852,"end":1794361191895}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c842eda3001GON9vSRlg1LZYU","sessionID":"ses_e37c3318cffepkbIZ3j04W7UeH","messageID":"msg_1c841b98a0010QfJwSIYUr1CzT"}}
