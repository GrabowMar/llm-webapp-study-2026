{"type":"tool_use","timestamp":1794362463309,"sessionID":"ses_e37c3318cffepkbIZ3j04W7UeH","part":{"type":"tool","tool":"read","callID":"call_3ddb351786ff4d84ae930459","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Timesheet API and frontend host.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import csv\n6: import io\n7: import os\n8: import secrets\n9: import sqlite3\n10: from datetime import date, datetime, timezone\n11: from functools import wraps\n12: from pathlib import Path\n13: \n14: from flask import Flask, Response, g, jsonify, request, send_from_directory\n15: from werkzeug.security import check_password_hash, generate_password_hash\n16: \n17: BASE_DIR = Path(__file__).resolve().parent.parent\n18: DIST = BASE_DIR / \"frontend\" / \"dist\"\n19: DATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\n20: DB_PATH = Path(os.environ.get(\"DATABASE_PATH\", DATA_DIR / \"timesheet.db\"))\n21: \n22: app = Flask(__name__, static_folder=None)\n23: \n24: \n25: # ---------------------------------------------------------------------------\n26: # Database\n27: # ---------------------------------------------------------------------------\n28: \n29: SCHEMA = \"\"\"\n30: CREATE TABLE IF NOT EXISTS users (\n31:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n32:     username TEXT NOT NULL UNIQUE,\n33:     password_hash TEXT NOT NULL,\n34:     created_at TEXT NOT NULL\n35: );\n36: CREATE TABLE IF NOT EXISTS tokens (\n37:     token TEXT PRIMARY KEY,\n38:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n39:     created_at TEXT NOT NULL\n40: );\n41: CREATE TABLE IF NOT EXISTS entries (\n42:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n43:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n44:     project TEXT NOT NULL,\n45:     description TEXT NOT NULL DEFAULT '',\n46:     hours REAL NOT NULL,\n47:     entry_date TEXT NOT NULL,\n48:     created_at TEXT NOT NULL\n49: );\n50: CREATE INDEX IF NOT EXISTS idx_entries_user_date ON entries(user_id, entry_date);\n51: \"\"\"\n52: \n53: \n54: def utcnow() -> datetime:\n55:     return datetime.now(timezone.utc)\n56: \n57: \n58: def iso_now() -> str:\n59:     return utcnow().isoformat()\n60: \n61: \n62: def get_db() -> sqlite3.Connection:\n63:     conn = getattr(g, \"_db\", None)\n64:     if conn is None:\n65:         DATA_DIR.mkdir(parents=True, exist_ok=True)\n66:         conn = sqlite3.connect(DB_PATH, timeout=10)\n67:         conn.row_factory = sqlite3.Row\n68:         conn.execute(\"PRAGMA foreign_keys = ON\")\n69:         conn.execute(\"PRAGMA busy_timeout = 10000\")\n70:         conn.execute(\"PRAGMA journal_mode = WAL\")\n71:         g._db = conn\n72:     return conn\n73: \n74: \n75: @app.teardown_appcontext\n76: def close_db(exception):\n77:     conn = getattr(g, \"_db\", None)\n78:     if conn is not None:\n79:         conn.close()\n80: \n81: \n82: def init_db() -> None:\n83:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n84:     conn = sqlite3.connect(DB_PATH, timeout=10)\n85:     try:\n86:         conn.execute(\"PRAGMA journal_mode = WAL\")\n87:         conn.executescript(SCHEMA)\n88:         conn.commit()\n89:     finally:\n90:         conn.close()\n91: \n92: \n93: init_db()\n94: \n95: \n96: # ---------------------------------------------------------------------------\n97: # Helpers\n98: # ---------------------------------------------------------------------------\n99: \n100: def json_body() -> dict:\n101:     data = request.get_json(silent=True)\n102:     return data if isinstance(data, dict) else {}\n103: \n104: \n105: def error(message, status=400, fields=None):\n106:     payload = {\"error\": message}\n107:     if fields:\n108:         payload[\"fields\"] = fields\n109:     return jsonify(payload), status\n110: \n111: \n112: def parse_date(value, field):\n113:     if not isinstance(value, str) or not value.strip():\n114:         raise ValueError(f\"{field} is required\")\n115:     try:\n116:         parsed = date.fromisoformat(value.strip())\n117:     except ValueError:\n118:         raise ValueError(f\"{field} must be a date in YYYY-MM-DD format\")\n119:     return parsed\n120: \n121: \n122: def parse_hours(value):\n123:     if isinstance(value, bool) or value is None:\n124:         raise ValueError(\"hours is required\")\n125:     try:\n126:         hours = float(value)\n127:     except (TypeError, ValueError):\n128:         raise ValueError(\"hours must be a number\")\n129:     if hours != hours or hours in (float(\"inf\"), float(\"-inf\")):\n130:         raise ValueError(\"hours must be a number\")\n131:     if hours <= 0:\n132:         raise ValueError(\"hours must be greater than 0\")\n133:     return hours\n134: \n135: \n136: def clean_text(value, field, max_length, required=True):\n137:     if value is None:\n138:         value = \"\"\n139:     if not isinstance(value, str):\n140:         raise ValueError(f\"{field} must be text\")\n141:     value = value.strip()\n142:     if required and not value:\n143:         raise ValueError(f\"{field} is required\")\n144:     if len(value) > max_length:\n145:         raise ValueError(f\"{field} must be at most {max_length} characters\")\n146:     return value\n147: \n148: \n149: def entry_to_dict(row: sqlite3.Row) -> dict:\n150:     return {\n151:         \"id\": row[\"id\"],\n152:         \"project\": row[\"project\"],\n153:         \"description\": row[\"description\"],\n154:         \"hours\": row[\"hours\"],\n155:         \"date\": row[\"entry_date\"],\n156:         \"created_at\": row[\"created_at\"],\n157:     }\n158: \n159: \n160: def auth_required(fn):\n161:     @wraps(fn)\n162:     def wrapper(*args, **kwargs):\n163:         header = request.headers.get(\"Authorization\", \"\")\n164:         if not header.startswith(\"Bearer \"):\n165:             return error(\"Authentication required\", 401)\n166:         token = header[len(\"Bearer \"):].strip()\n167:         if not token:\n168:             return error(\"Authentication required\", 401)\n169:         db = get_db()\n170:         row = db.execute(\n171:             \"SELECT user_id FROM tokens WHERE token = ?\", (token,)\n172:         ).fetchone()\n173:         if row is None:\n174:             return error(\"Authentication required\", 401)\n175:         user = db.execute(\n176:             \"SELECT id, username FROM users WHERE id = ?\", (row[\"user_id\"],)\n177:         ).fetchone()\n178:         if user is None:\n179:             return error(\"Authentication required\", 401)\n180:         g.user_id = user[\"id\"]\n181:         g.username = user[\"username\"]\n182:         return fn(*args, **kwargs)\n183: \n184:     return wrapper\n185: \n186: \n187: def build_filters(include_project: bool = True):\n188:     \"\"\"Return (where_clause, params) for entry filters from the query string.\"\"\"\n189:     clauses = [\"user_id = ?\"]\n190:     params: list = [g.user_id]\n191:     start = request.args.get(\"start_date\")\n192:     end = request.args.get(\"end_date\")\n193:     project = request.args.get(\"project\") if include_project else None\n194:     if start:\n195:         try:\n196:             params.append(parse_date(start, \"start_date\").isoformat())\n197:         except ValueError as exc:\n198:             raise ValueError(str(exc))\n199:         clauses.append(\"entry_date >= ?\")\n200:     if end:\n201:         try:\n202:             params.append(parse_date(end, \"end_date\").isoformat())\n203:         except ValueError as exc:\n204:             raise ValueError(str(exc))\n205:         clauses.append(\"entry_date <= ?\")\n206:     if project:\n207:         clauses.append(\"project = ?\")\n208:         params.append(project)\n209:     return \" AND \".join(clauses), params\n210: \n211: \n212: def csv_cell(value) -> str:\n213:     \"\"\"Neutralise spreadsheet formula injection so cells are read as text.\"\"\"\n214:     text = str(value)\n215:     if text and text[0] in (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\", \"\\n\"):\n216:         return \"'\" + text\n217:     return text\n218: \n219: \n220: def csv_response(rows, filename) -> Response:\n221:     buffer = io.StringIO()\n222:     writer = csv.writer(buffer, lineterminator=\"\\r\\n\")\n223:     writer.writerows(rows)\n224:     body = buffer.getvalue()\n225:     return Response(\n226:         body,\n227:         mimetype=\"text/csv\",\n228:         headers={\n229:             \"Content-Type\": \"text/csv; charset=utf-8\",\n230:             \"Content-Disposition\": f'attachment; filename=\"{filename}\"',\n231:         },\n232:     )\n233: \n234: \n235: def format_hours(value) -> str:\n236:     number = float(value)\n237:     if number.is_integer():\n238:         return str(int(number))\n239:     return (\"%.2f\" % number).rstrip(\"0\").rstrip(\".\")\n240: \n241: \n242: # ---------------------------------------------------------------------------\n243: # Auth\n244: # ---------------------------------------------------------------------------\n245: \n246: @app.post(\"/api/auth/register\")\n247: def register():\n248:     data = json_body()\n249:     username = data.get(\"username\")\n250:     password = data.get(\"password\")\n251: \n252:     fields = {}\n253:     if not isinstance(username, str) or not username.strip():\n254:         fields[\"username\"] = \"Username is required\"\n255:     elif len(username.strip()) > 100:\n256:         fields[\"username\"] = \"Username must be at most 100 characters\"\n257:     if not isinstance(password, str) or not password:\n258:         fields[\"password\"] = \"Password is required\"\n259:     elif len(password) > 200:\n260:         fields[\"password\"] = \"Password must be at most 200 characters\"\n261:     if fields:\n262:         return error(\"Please correct the highlighted fields\", 400, fields)\n263: \n264:     username = username.strip()\n265:     db = get_db()\n266:     try:\n267:         db.execute(\n268:             \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n269:             (username, generate_password_hash(password), iso_now()),\n270:         )\n271:         db.commit()\n272:     except sqlite3.IntegrityError:\n273:         return error(\n274:             \"Username is already taken\",\n275:             409,\n276:             {\"username\": \"Username is already taken\"},\n277:         )\n278:     return jsonify({\"username\": username}), 201\n279: \n280: \n281: @app.post(\"/api/auth/login\")\n282: def login():\n283:     data = json_body()\n284:     username = data.get(\"username\")\n285:     password = data.get(\"password\")\n286:     if not isinstance(username, str) or not isinstance(password, str):\n287:         return error(\"Username and password are required\", 400)\n288: \n289:     db = get_db()\n290:     user = db.execute(\n291:         \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n292:         (username.strip(),),\n293:     ).fetchone()\n294:     if user is None or not check_password_hash(user[\"password_hash\"], password):\n295:         return error(\"Invalid username or password\", 401)\n296: \n297:     token = secrets.token_urlsafe(32)\n298:     db.execute(\n299:         \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n300:         (token, user[\"id\"], iso_now()),\n301:     )\n302:     db.commit()\n303:     return jsonify({\"token\": token})\n304: \n305: \n306: @app.post(\"/api/auth/logout\")\n307: @auth_required\n308: def logout():\n309:     header = request.headers.get(\"Authorization\", \"\")\n310:     token = header[len(\"Bearer \"):].strip()\n311:     db = get_db()\n312:     db.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n313:     db.commit()\n314:     return jsonify({\"status\": \"ok\"})\n315: \n316: \n317: @app.get(\"/api/auth/me\")\n318: @auth_required\n319: def me():\n320:     return jsonify({\"username\": g.username})\n321: \n322: \n323: # ---------------------------------------------------------------------------\n324: # Entries\n325: # ---------------------------------------------------------------------------\n326: \n327: @app.get(\"/api/entries\")\n328: @auth_required\n329: def list_entries():\n330:     try:\n331:         where, params = build_filters()\n332:     except ValueError as exc:\n333:         return error(str(exc), 400)\n334: \n335:     try:\n336:         page = max(1, int(request.args.get(\"page\", 1)))\n337:     except (TypeError, ValueError):\n338:         return error(\"page must be a positive integer\", 400)\n339:     try:\n340:         page_size = int(request.args.get(\"page_size\", 20))\n341:     except (TypeError, ValueError):\n342:         return error(\"page_size must be a positive integer\", 400)\n343:     page_size = max(1, min(page_size, 200))\n344: \n345:     db = get_db()\n346:     total = db.execute(\n347:         f\"SELECT COUNT(*) AS c FROM entries WHERE {where}\", params\n348:     ).fetchone()[\"c\"]\n349:     offset = (page - 1) * page_size\n350:     rows = db.execute(\n351:         f\"\"\"SELECT * FROM entries WHERE {where}\n352:             ORDER BY entry_date DESC, id DESC\n353:             LIMIT ? OFFSET ?\"\"\",\n354:         [*params, page_size, offset],\n355:     ).fetchall()\n356: \n357:     return jsonify(\n358:         {\n359:             \"items\": [entry_to_dict(r) for r in rows],\n360:             \"total\": total,\n361:             \"page\": page,\n362:             \"page_size\": page_size,\n363:         }\n364:     )\n365: \n366: \n367: @app.post(\"/api/entries\")\n368: @auth_required\n369: def create_entry():\n370:     data = json_body()\n371:     fields = {}\n372:     project = description = entry_date = hours = None\n373: \n374:     try:\n375:         project = clean_text(data.get(\"project\"), \"project\", 200)\n376:     except ValueError as exc:\n377:         fields[\"project\"] = str(exc)\n378:     try:\n379:         description = clean_text(\n380:             data.get(\"description\"), \"description\", 2000, required=False\n381:         )\n382:     except ValueError as exc:\n383:         fields[\"description\"] = str(exc)\n384:     try:\n385:         hours = parse_hours(data.get(\"hours\"))\n386:     except ValueError as exc:\n387:         fields[\"hours\"] = str(exc)\n388:     try:\n389:         entry_date = parse_date(data.get(\"date\"), \"date\").isoformat()\n390:     except ValueError as exc:\n391:         fields[\"date\"] = str(exc)\n392: \n393:     if fields:\n394:         return error(\"Please correct the highlighted fields\", 400, fields)\n395: \n396:     db = get_db()\n397:     cur = db.execute(\n398:         \"\"\"INSERT INTO entries (user_id, project, description, hours, entry_date, created_at)\n399:            VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n400:         (g.user_id, project, description, hours, entry_date, iso_now()),\n401:     )\n402:     db.commit()\n403:     row = db.execute(\"SELECT * FROM entries WHERE id = ?\", (cur.lastrowid,)).fetchone()\n404:     return jsonify(entry_to_dict(row)), 201\n405: \n406: \n407: @app.patch(\"/api/entries/<int:entry_id>\")\n408: @auth_required\n409: def update_entry(entry_id: int):\n410:     db = get_db()\n411:     row = db.execute(\n412:         \"SELECT * FROM entries WHERE id = ? AND user_id = ?\",\n413:         (entry_id, g.user_id),\n414:     ).fetchone()\n415:     if row is None:\n416:         return error(\"Entry not found\", 404)\n417: \n418:     data = json_body()\n419:     fields = {}\n420:     updates = {}\n421: \n422:     if \"project\" in data:\n423:         try:\n424:             updates[\"project\"] = clean_text(data.get(\"project\"), \"project\", 200)\n425:         except ValueError as exc:\n426:             fields[\"project\"] = str(exc)\n427:     if \"description\" in data:\n428:         try:\n429:             updates[\"description\"] = clean_text(\n430:                 data.get(\"description\"), \"description\", 2000, required=False\n431:             )\n432:         except ValueError as exc:\n433:             fields[\"description\"] = str(exc)\n434:     if \"hours\" in data:\n435:         try:\n436:             updates[\"hours\"] = parse_hours(data.get(\"hours\"))\n437:         except ValueError as exc:\n438:             fields[\"hours\"] = str(exc)\n439:     if \"date\" in data:\n440:         try:\n441:             updates[\"date\"] = parse_date(data.get(\"date\"), \"date\").isoformat()\n442:         except ValueError as exc:\n443:             fields[\"date\"] = str(exc)\n444: \n445:     if fields:\n446:         return error(\"Please correct the highlighted fields\", 400, fields)\n447:     if not updates:\n448:         return jsonify(entry_to_dict(row))\n449: \n450:     column_map = {\"date\": \"entry_date\"}\n451:     assignments = []\n452:     params = []\n453:     for key, value in updates.items():\n454:         assignments.append(f\"{column_map.get(key, key)} = ?\")\n455:         params.append(value)\n456:     params.extend([entry_id, g.user_id])\n457:     db.execute(\n458:         f\"UPDATE entries SET {', '.join(assignments)} WHERE id = ? AND user_id = ?\",\n459:         params,\n460:     )\n461:     db.commit()\n462:     row = db.execute(\"SELECT * FROM entries WHERE id = ?\", (entry_id,)).fetchone()\n463:     return jsonify(entry_to_dict(row))\n464: \n465: \n466: @app.delete(\"/api/entries/<int:entry_id>\")\n467: @auth_required\n468: def delete_entry(entry_id: int):\n469:     db = get_db()\n470:     cur = db.execute(\n471:         \"DELETE FROM entries WHERE id = ? AND user_id = ?\", (entry_id, g.user_id)\n472:     )\n473:     db.commit()\n474:     if cur.rowcount == 0:\n475:         return error(\"Entry not found\", 404)\n476:     return jsonify({\"status\": \"ok\"})\n477: \n478: \n479: @app.get(\"/api/projects\")\n480: @auth_required\n481: def list_projects():\n482:     try:\n483:         where, params = build_filters()\n484:     except ValueError as exc:\n485:         return error(str(exc), 400)\n486:     db = get_db()\n487:     rows = db.execute(\n488:         f\"\"\"SELECT project, SUM(hours) AS total, COUNT(*) AS count\n489:            FROM entries WHERE {where}\n490:            GROUP BY project ORDER BY project \"\"\",\n491:         params,\n492:     ).fetchall()\n493:     return jsonify(\n494:         {\n495:             \"items\": [\n496:                 {\"project\": r[\"project\"], \"hours\": round(r[\"total\"], 6), \"count\": r[\"count\"]}\n497:                 for r in rows\n498:             ]\n499:         }\n500:     )\n501: \n502: \n503: # ---------------------------------------------------------------------------\n504: # Exports\n505: # ---------------------------------------------------------------------------\n506: \n507: @app.get(\"/api/exports/entries.csv\")\n508: @auth_required\n509: def export_entries():\n510:     try:\n511:         where, params = build_filters()\n512:     except ValueError as exc:\n513:         return error(str(exc), 400)\n514: \n515:     db = get_db()\n516:     rows = db.execute(\n517:         f\"\"\"SELECT * FROM entries WHERE {where}\n518:             ORDER BY entry_date ASC, id ASC\"\"\",\n519:         params,\n520:     ).fetchall()\n521: \n522:     csv_rows = [(\"date\", \"project\", \"description\", \"hours\")]\n523:     for r in rows:\n524:         csv_rows.append(\n525:             (\n526:                 r[\"entry_date\"],\n527:                 csv_cell(r[\"project\"]),\n528:                 csv_cell(r[\"description\"]),\n529:                 format_hours(r[\"hours\"]),\n530:             )\n531:         )\n532:     return csv_response(csv_rows, \"entries.csv\")\n533: \n534: \n535: @app.get(\"/api/exports/summary.csv\")\n536: @auth_required\n537: def export_summary():\n538:     try:\n539:         where, params = build_filters(include_project=False)\n540:     except ValueError as exc:\n541:         return error(str(exc), 400)\n542: \n543:     db = get_db()\n544:     rows = db.execute(\n545:         f\"\"\"SELECT project, SUM(hours) AS total FROM entries\n546:             WHERE {where}\n547:             GROUP BY project ORDER BY project \"\"\",\n548:         params,\n549:     ).fetchall()\n550: \n551:     csv_rows = [(\"project\", \"hours\")]\n552:     for r in rows:\n553:         csv_rows.append((csv_cell(r[\"project\"]), format_hours(r[\"total\"])))\n554:     return csv_response(csv_rows, \"summary.csv\")\n555: \n556: \n557: # ---------------------------------------------------------------------------\n558: # Health & frontend\n559: # ---------------------------------------------------------------------------\n560: \n561: @app.get(\"/api/health\")\n562: def health():\n563:     return {\"status\": \"ok\"}\n564: \n565: \n566: @app.get(\"/\")\n567: @app.get(\"/<path:path>\")\n568: def frontend(path: str = \"index.html\"):\n569:     if path.startswith(\"api/\"):\n570:         return error(\"Not found\", 404)\n571:     candidate = (DIST / path).resolve()\n572:     try:\n573:         candidate.relative_to(DIST.resolve())\n574:     except ValueError:\n575:         return send_from_directory(DIST, \"index.html\")\n576:     if candidate.is_file():\n577:         return send_from_directory(DIST, path)\n578:     return send_from_directory(DIST, \"index.html\")\n\n(End of file - total 578 lines)\n</content>","metadata":{"preview":"\"\"\"Timesheet API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport io\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import date, datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", DATA_DIR / \"timesheet.db\"))","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Timesheet API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport io\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import date, datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", BASE_DIR / \"data\"))\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", DATA_DIR / \"timesheet.db\"))\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS entries (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    project TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    hours REAL NOT NULL,\n    entry_date TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_entries_user_date ON entries(user_id, entry_date);\n\"\"\"\n\n\ndef utcnow() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso_now() -> str:\n    return utcnow().isoformat()\n\n\ndef get_db() -> sqlite3.Connection:\n    conn = getattr(g, \"_db\", None)\n    if conn is None:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=10)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        conn.execute(\"PRAGMA busy_timeout = 10000\")\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        g._db = conn\n    return conn\n\n\n@app.teardown_appcontext\ndef close_db(exception):\n    conn = getattr(g, \"_db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=10)\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef error(message, status=400, fields=None):\n    payload = {\"error\": message}\n    if fields:\n        payload[\"fields\"] = fields\n    return jsonify(payload), status\n\n\ndef parse_date(value, field):\n    if not isinstance(value, str) or not value.strip():\n        raise ValueError(f\"{field} is required\")\n    try:\n        parsed = date.fromisoformat(value.strip())\n    except ValueError:\n        raise ValueError(f\"{field} must be a date in YYYY-MM-DD format\")\n    return parsed\n\n\ndef parse_hours(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError(\"hours is required\")\n    try:\n        hours = float(value)\n    except (TypeError, ValueError):\n        raise ValueError(\"hours must be a number\")\n    if hours != hours or hours in (float(\"inf\"), float(\"-inf\")):\n        raise ValueError(\"hours must be a number\")\n    if hours <= 0:\n        raise ValueError(\"hours must be greater than 0\")\n    return hours\n\n\ndef clean_text(value, field, max_length, required=True):\n    if value is None:\n        value = \"\"\n    if not isinstance(value, str):\n        raise ValueError(f\"{field} must be text\")\n    value = value.strip()\n    if required and not value:\n        raise ValueError(f\"{field} is required\")\n    if len(value) > max_length:\n        raise ValueError(f\"{field} must be at most {max_length} characters\")\n    return value\n\n\ndef entry_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"project\": row[\"project\"],\n        \"description\": row[\"description\"],\n        \"hours\": row[\"hours\"],\n        \"date\": row[\"entry_date\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef auth_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        if not header.startswith(\"Bearer \"):\n            return error(\"Authentication required\", 401)\n        token = header[len(\"Bearer \"):].strip()\n        if not token:\n            return error(\"Authentication required\", 401)\n        db = get_db()\n        row = db.execute(\n            \"SELECT user_id FROM tokens WHERE token = ?\", (token,)\n        ).fetchone()\n        if row is None:\n            return error(\"Authentication required\", 401)\n        user = db.execute(\n            \"SELECT id, username FROM users WHERE id = ?\", (row[\"user_id\"],)\n        ).fetchone()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user_id = user[\"id\"]\n        g.username = user[\"username\"]\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef build_filters(include_project: bool = True):\n    \"\"\"Return (where_clause, params) for entry filters from the query string.\"\"\"\n    clauses = [\"user_id = ?\"]\n    params: list = [g.user_id]\n    start = request.args.get(\"start_date\")\n    end = request.args.get(\"end_date\")\n    project = request.args.get(\"project\") if include_project else None\n    if start:\n        try:\n            params.append(parse_date(start, \"start_date\").isoformat())\n        except ValueError as exc:\n            raise ValueError(str(exc))\n        clauses.append(\"entry_date >= ?\")\n    if end:\n        try:\n            params.append(parse_date(end, \"end_date\").isoformat())\n        except ValueError as exc:\n            raise ValueError(str(exc))\n        clauses.append(\"entry_date <= ?\")\n    if project:\n        clauses.append(\"project = ?\")\n        params.append(project)\n    return \" AND \".join(clauses), params\n\n\ndef csv_cell(value) -> str:\n    \"\"\"Neutralise spreadsheet formula injection so cells are read as text.\"\"\"\n    text = str(value)\n    if text and text[0] in (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\", \"\\n\"):\n        return \"'\" + text\n    return text\n\n\ndef csv_response(rows, filename) -> Response:\n    buffer = io.StringIO()\n    writer = csv.writer(buffer, lineterminator=\"\\r\\n\")\n    writer.writerows(rows)\n    body = buffer.getvalue()\n    return Response(\n        body,\n        mimetype=\"text/csv\",\n        headers={\n            \"Content-Type\": \"text/csv; charset=utf-8\",\n            \"Content-Disposition\": f'attachment; filename=\"{filename}\"',\n        },\n    )\n\n\ndef format_hours(value) -> str:\n    number = float(value)\n    if number.is_integer():\n        return str(int(number))\n    return (\"%.2f\" % number).rstrip(\"0\").rstrip(\".\")\n\n\n# ---------------------------------------------------------------------------\n# Auth\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    fields = {}\n    if not isinstance(username, str) or not username.strip():\n        fields[\"username\"] = \"Username is required\"\n    elif len(username.strip()) > 100:\n        fields[\"username\"] = \"Username must be at most 100 characters\"\n    if not isinstance(password, str) or not password:\n        fields[\"password\"] = \"Password is required\"\n    elif len(password) > 200:\n        fields[\"password\"] = \"Password must be at most 200 characters\"\n    if fields:\n        return error(\"Please correct the highlighted fields\", 400, fields)\n\n    username = username.strip()\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), iso_now()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\n            \"Username is already taken\",\n            409,\n            {\"username\": \"Username is already taken\"},\n        )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\", 400)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], iso_now()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@auth_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    token = header[len(\"Bearer \"):].strip()\n    db = get_db()\n    db.execute(\"DELETE FROM tokens WHERE token = ?\", (token,))\n    db.commit()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/auth/me\")\n@auth_required\ndef me():\n    return jsonify({\"username\": g.username})\n\n\n# ---------------------------------------------------------------------------\n# Entries\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/entries\")\n@auth_required\ndef list_entries():\n    try:\n        where, params = build_filters()\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    try:\n        page = max(1, int(request.args.get(\"page\", 1)))\n    except (TypeError, ValueError):\n        return error(\"page must be a positive integer\", 400)\n    try:\n        page_size = int(request.args.get(\"page_size\", 20))\n    except (TypeError, ValueError):\n        return error(\"page_size must be a positive integer\", 400)\n    page_size = max(1, min(page_size, 200))\n\n    db = get_db()\n    total = db.execute(\n        f\"SELECT COUNT(*) AS c FROM entries WHERE {where}\", params\n    ).fetchone()[\"c\"]\n    offset = (page - 1) * page_size\n    rows = db.execute(\n        f\"\"\"SELECT * FROM entries WHERE {where}\n            ORDER BY entry_date DESC, id DESC\n            LIMIT ? OFFSET ?\"\"\",\n        [*params, page_size, offset],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [entry_to_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/entries\")\n@auth_required\ndef create_entry():\n    data = json_body()\n    fields = {}\n    project = description = entry_date = hours = None\n\n    try:\n        project = clean_text(data.get(\"project\"), \"project\", 200)\n    except ValueError as exc:\n        fields[\"project\"] = str(exc)\n    try:\n        description = clean_text(\n            data.get(\"description\"), \"description\", 2000, required=False\n        )\n    except ValueError as exc:\n        fields[\"description\"] = str(exc)\n    try:\n        hours = parse_hours(data.get(\"hours\"))\n    except ValueError as exc:\n        fields[\"hours\"] = str(exc)\n    try:\n        entry_date = parse_date(data.get(\"date\"), \"date\").isoformat()\n    except ValueError as exc:\n        fields[\"date\"] = str(exc)\n\n    if fields:\n        return error(\"Please correct the highlighted fields\", 400, fields)\n\n    db = get_db()\n    cur = db.execute(\n        \"\"\"INSERT INTO entries (user_id, project, description, hours, entry_date, created_at)\n           VALUES (?, ?, ?, ?, ?, ?)\"\"\",\n        (g.user_id, project, description, hours, entry_date, iso_now()),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM entries WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(entry_to_dict(row)), 201\n\n\n@app.patch(\"/api/entries/<int:entry_id>\")\n@auth_required\ndef update_entry(entry_id: int):\n    db = get_db()\n    row = db.execute(\n        \"SELECT * FROM entries WHERE id = ? AND user_id = ?\",\n        (entry_id, g.user_id),\n    ).fetchone()\n    if row is None:\n        return error(\"Entry not found\", 404)\n\n    data = json_body()\n    fields = {}\n    updates = {}\n\n    if \"project\" in data:\n        try:\n            updates[\"project\"] = clean_text(data.get(\"project\"), \"project\", 200)\n        except ValueError as exc:\n            fields[\"project\"] = str(exc)\n    if \"description\" in data:\n        try:\n            updates[\"description\"] = clean_text(\n                data.get(\"description\"), \"description\", 2000, required=False\n            )\n        except ValueError as exc:\n            fields[\"description\"] = str(exc)\n    if \"hours\" in data:\n        try:\n            updates[\"hours\"] = parse_hours(data.get(\"hours\"))\n        except ValueError as exc:\n            fields[\"hours\"] = str(exc)\n    if \"date\" in data:\n        try:\n            updates[\"date\"] = parse_date(data.get(\"date\"), \"date\").isoformat()\n        except ValueError as exc:\n            fields[\"date\"] = str(exc)\n\n    if fields:\n        return error(\"Please correct the highlighted fields\", 400, fields)\n    if not updates:\n        return jsonify(entry_to_dict(row))\n\n    column_map = {\"date\": \"entry_date\"}\n    assignments = []\n    params = []\n    for key, value in updates.items():\n        assignments.append(f\"{column_map.get(key, key)} = ?\")\n        params.append(value)\n    params.extend([entry_id, g.user_id])\n    db.execute(\n        f\"UPDATE entries SET {', '.join(assignments)} WHERE id = ? AND user_id = ?\",\n        params,\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM entries WHERE id = ?\", (entry_id,)).fetchone()\n    return jsonify(entry_to_dict(row))\n\n\n@app.delete(\"/api/entries/<int:entry_id>\")\n@auth_required\ndef delete_entry(entry_id: int):\n    db = get_db()\n    cur = db.execute(\n        \"DELETE FROM entries WHERE id = ? AND user_id = ?\", (entry_id, g.user_id)\n    )\n    db.commit()\n    if cur.rowcount == 0:\n        return error(\"Entry not found\", 404)\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/projects\")\n@auth_required\ndef list_projects():\n    try:\n        where, params = build_filters()\n    except ValueError as exc:\n        return error(str(exc), 400)\n    db = get_db()\n    rows = db.execute(\n        f\"\"\"SELECT project, SUM(hours) AS total, COUNT(*) AS count\n           FROM entries WHERE {where}\n           GROUP BY project ORDER BY project \"\"\",\n        params,\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\"project\": r[\"project\"], \"hours\": round(r[\"total\"], 6), \"count\": r[\"count\"]}\n                for r in rows\n            ]\n        }\n    )\n\n\n# ---------------------------------------------------------------------------\n# Exports\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/exports/entries.csv\")\n@auth_required\ndef export_entries():\n    try:\n        where, params = build_filters()\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    db = get_db()\n    rows = db.execute(\n        f\"\"\"SELECT * FROM entries WHERE {where}\n            ORDER BY entry_date ASC, id ASC\"\"\",\n        params,\n    ).fetchall()\n\n    csv_rows = [(\"date\", \"project\", \"description\", \"hours\")]\n    for r in rows:\n        csv_rows.append(\n            (\n                r[\"entry_date\"],\n                csv_cell(r[\"project\"]),\n                csv_cell(r[\"description\"]),\n                format_hours(r[\"hours\"]),\n            )\n        )\n    return csv_response(csv_rows, \"entries.csv\")\n\n\n@app.get(\"/api/exports/summary.csv\")\n@auth_required\ndef export_summary():\n    try:\n        where, params = build_filters(include_project=False)\n    except ValueError as exc:\n        return error(str(exc), 400)\n\n    db = get_db()\n    rows = db.execute(\n        f\"\"\"SELECT project, SUM(hours) AS total FROM entries\n            WHERE {where}\n            GROUP BY project ORDER BY project \"\"\",\n        params,\n    ).fetchall()\n\n    csv_rows = [(\"project\", \"hours\")]\n    for r in rows:\n        csv_rows.append((csv_cell(r[\"project\"]), format_hours(r[\"total\"])))\n    return csv_response(csv_rows, \"summary.csv\")\n\n\n# ---------------------------------------------------------------------------\n# Health & frontend\n# ---------------------------------------------------------------------------\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    candidate = (DIST / path).resolve()\n    try:\n        candidate.relative_to(DIST.resolve())\n    except ValueError:\n        return send_from_directory(DIST, \"index.html\")\n    if candidate.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":578,"totalLines":578,"truncated":false}},"title":"backend/app.py","time":{"start":1794362463240,"end":1794362463283}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c85653fc001J3KQYeF0uEGhXX","sessionID":"ses_e37c3318cffepkbIZ3j04W7UeH","messageID":"msg_1c8559b17001xm2pJKAdBkXl4I"}}
