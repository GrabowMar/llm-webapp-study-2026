{"type":"tool_use","timestamp":1794361276399,"sessionID":"ses_e37c3318cffepkbIZ3j04W7UeH","part":{"type":"tool","tool":"write","callID":"call_17bcba93fcba4392969e12ea","state":{"status":"completed","input":{"content":"export type Entry = {\n  id: number;\n  project: string;\n  description: string;\n  hours: number;\n  date: string;\n  created_at: string;\n};\n\nexport type EntryPage = {\n  items: Entry[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type ProjectTotal = {\n  project: string;\n  hours: number;\n  count: number;\n};\n\nexport type Filters = {\n  start_date: string;\n  end_date: string;\n  project: string;\n};\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n\n  constructor(\n    message: string,\n    status: number,\n    fields: Record<string, string> = {},\n  ) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"timesheet_token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n): Promise<T> {\n  const headers = new Headers(options.headers);\n  const token = getToken();\n  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  if (options.body && !headers.has(\"Content-Type\")) {\n    headers.set(\"Content-Type\", \"application/json\");\n  }\n  const response = await fetch(path, { ...options, headers });\n  const contentType = response.headers.get(\"Content-Type\") || \"\";\n  const data = contentType.includes(\"application/json\")\n    ? await response.json().catch(() => ({}))\n    : await response.text();\n  if (!response.ok) {\n    if (response.status === 401 && getToken()) {\n      setToken(null);\n    }\n    const payload = (typeof data === \"object\" && data) || {};\n    throw new ApiError(\n      payload.error || \"Something went wrong\",\n      response.status,\n      payload.fields || {},\n    );\n  }\n  return data as T;\n}\n\nexport function register(username: string, password: string) {\n  return request<{ username: string }>(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function login(username: string, password: string) {\n  return request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function logout() {\n  return request<{ status: string }>(\"/api/auth/logout\", { method: \"POST\" });\n}\n\nexport function me() {\n  return request<{ username: string }>(\"/api/auth/me\");\n}\n\nfunction filterQuery(filters: Filters, includeProject = true): string {\n  const params = new URLSearchParams();\n  if (filters.start_date) params.set(\"start_date\", filters.start_date);\n  if (filters.end_date) params.set(\"end_date\", filters.end_date);\n  if (includeProject && filters.project) params.set(\"project\", filters.project);\n  return params.toString();\n}\n\nexport function listEntries(\n  filters: Filters,\n  page: number,\n  pageSize: number,\n) {\n  const params = new URLSearchParams(filterQuery(filters));\n  params.set(\"page\", String(page));\n  params.set(\"page_size\", String(pageSize));\n  return request<EntryPage>(`/api/entries?${params.toString()}`);\n}\n\nexport function listProjects(filters: Filters) {\n  return request<{ items: ProjectTotal[] }>(\n    `/api/projects?${filterQuery(filters, false)}`,\n  );\n}\n\nexport type EntryInput = {\n  project: string;\n  description: string;\n  hours: number | string;\n  date: string;\n};\n\nexport function createEntry(input: EntryInput) {\n  return request<Entry>(\"/api/entries\", {\n    method: \"POST\",\n    body: JSON.stringify(input),\n  });\n}\n\nexport function updateEntry(id: number, input: Partial<EntryInput>) {\n  return request<Entry>(`/api/entries/${id}`, {\n    method: \"PATCH\",\n    body: JSON.stringify(input),\n  });\n}\n\nexport function deleteEntry(id: number) {\n  return request<{ status: string }>(`/api/entries/${id}`, {\n    method: \"DELETE\",\n  });\n}\n\nexport async function downloadCsv(path: string, filename: string) {\n  const headers = new Headers();\n  const token = getToken();\n  if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  const response = await fetch(path, { headers });\n  if (!response.ok) {\n    throw new ApiError(\"Export failed\", response.status);\n  }\n  const blob = await response.blob();\n  const url = URL.createObjectURL(blob);\n  const anchor = document.createElement(\"a\");\n  anchor.href = url;\n  anchor.download = filename;\n  document.body.appendChild(anchor);\n  anchor.click();\n  anchor.remove();\n  URL.revokeObjectURL(url);\n}\n\nexport function entriesCsvUrl(filters: Filters) {\n  return `/api/exports/entries.csv?${filterQuery(filters)}`;\n}\n\nexport function summaryCsvUrl(filters: Filters) {\n  return `/api/exports/summary.csv?${filterQuery(filters, false)}`;\n}\n\nexport function todayISO(): string {\n  const now = new Date();\n  const offset = now.getTimezoneOffset();\n  return new Date(now.getTime() - offset * 60000).toISOString().slice(0, 10);\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794361276371,"end":1794361276380}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c84437cd001CGbxAEB6YzWwtj","sessionID":"ses_e37c3318cffepkbIZ3j04W7UeH","messageID":"msg_1c843c307001YolfJOkUNu4t93"}}
