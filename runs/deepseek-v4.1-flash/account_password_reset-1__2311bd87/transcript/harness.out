ad\",\"new_password\":\"abcdefgh\"}))\nshow(\"change pw ok\", c.post(\"/api/me/password\", headers=h, json={\"current_password\":\"secret12\",\"new_password\":\"secret123\"}))\nshow(\"login old pw\", c.post(\"/api/auth/login\", json={\"username\":\"alice\",\"password\":\"secret12\"}))\nr = c.post(\"/api/auth/login\", json={\"username\":\"alice\",\"password\":\"secret123\"}); tok = r.get_json()[\"token\"]; h={\"Authorization\":f\"Bearer {tok}\"}\nshow(\"reset bob (no email)\", c.post(\"/api/auth/password-reset\", json={\"username\":\"bob\"}))\nshow(\"outbox bob\", c.get(\"/api/outbox?to=bob@example.com\"))\nshow(\"reset unknown\", c.post(\"/api/auth/password-reset\", json={\"username\":\"nobody\"}))\nshow(\"reset alice email\", c.post(\"/api/auth/password-reset\", json={\"email\":\"ALICE@example.com\"}))\nout = c.get(\"/api/outbox?to=alice@example.com\").get_json()\nprint(\"outbox keys\", sorted(out[\"items\"][0].keys()))\nbody = out[\"items\"][0][\"body\"]\nrtok = re.search(r\"token=([^\\s]+)\", body).group(1)\nshow(\"confirm short\", c.post(\"/api/auth/password-reset/confirm\", json={\"token\":rtok,\"new_password\":\"short\"}))\nshow(\"confirm ok\", c.post(\"/api/auth/password-reset/confirm\", json={\"token\":rtok,\"new_password\":\"resetpass1\"}))\nshow(\"confirm reuse\", c.post(\"/api/auth/password-reset/confirm\", json={\"token\":rtok,\"new_password\":\"resetpass2\"}))\nshow(\"login reset pw\", c.post(\"/api/auth/login\", json={\"username\":\"alice\",\"password\":\"resetpass1\"}))\nshow(\"logout\", c.post(\"/api/auth/logout\", headers=h))\nshow(\"me after logout\", c.get(\"/api/me\", headers=h))\nshow(\"register missing email allowed\", c.post(\"/api/auth/register\", json={\"username\":\"eve\",\"password\":\"secret12\"}))\nshow(\"spa /reset\", c.get(\"/reset?token=x\"))\nshow(\"spa /account\", c.get(\"/account\"))\nshow(\"api 404\", c.get(\"/api/nope\"))\nprint(\"outbox newest first:\", [x[\"id\"] for x in c.get(\"/api/outbox?to=alice@example.com\").get_json()[\