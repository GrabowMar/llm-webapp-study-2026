{"type":"tool_use","timestamp":1794315217471,"sessionID":"ses_e3a7cb2adffeL9tgWqyJUcMBfG","part":{"type":"tool","tool":"write","callID":"call_ded229b0f21343b1bca647e1","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point for the account service.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\n\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+$\")\nMIN_PASSWORD_LENGTH = 8\n\napp = Flask(__name__, static_folder=None)\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS accounts (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                email TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE UNIQUE INDEX IF NOT EXISTS ux_accounts_email\n                ON accounts(lower(email)) WHERE email IS NOT NULL;\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS password_resets (\n                token TEXT PRIMARY KEY,\n                account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL,\n                used INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE TABLE IF NOT EXISTS outbox (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                recipient TEXT NOT NULL,\n                subject TEXT NOT NULL,\n                body TEXT NOT NULL,\n                sent_at TEXT NOT NULL\n            );\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef error(message: str, status: int = 400):\n    return jsonify({\"error\": message}), status\n\n\ndef account_json(row: sqlite3.Row) -> dict:\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"], \"email\": row[\"email\"]}\n\n\ndef normalize_email(value):\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        raise ValueError(\"Invalid email address\")\n    value = value.strip()\n    if value == \"\":\n        return None\n    if not EMAIL_RE.match(value):\n        raise ValueError(\"Invalid email address\")\n    return value\n\n\ndef current_account() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    conn = connect()\n    try:\n        return conn.execute(\n            \"\"\"\n            SELECT accounts.id, accounts.username, accounts.email\n            FROM sessions JOIN accounts ON accounts.id = sessions.account_id\n            WHERE sessions.token = ?\n            \"\"\",\n            (token,),\n        ).fetchone()\n    finally:\n        conn.close()\n\n\ndef require_account():\n    account = current_account()\n    if account is None:\n        return None, error(\"Authentication required\", 401)\n    return account, None\n\n\ndef validate_password(password) -> str | None:\n    if not isinstance(password, str) or len(password) < MIN_PASSWORD_LENGTH:\n        return f\"Password must be at least {MIN_PASSWORD_LENGTH} characters long\"\n    return None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not username.strip():\n        return error(\"Username is required\")\n    username = username.strip()\n    message = validate_password(password)\n    if message:\n        return error(message)\n\n    try:\n        email = normalize_email(data.get(\"email\"))\n    except ValueError as exc:\n        return error(str(exc))\n\n    conn = connect()\n    try:\n        if conn.execute(\n            \"SELECT 1 FROM accounts WHERE username = ?\", (username,)\n        ).fetchone():\n            return error(\"Username is already taken\", 409)\n        if email is not None and conn.execute(\n            \"SELECT 1 FROM accounts WHERE lower(email) = lower(?)\", (email,)\n        ).fetchone():\n            return error(\"Email address is already in use\", 409)\n\n        try:\n            cur = conn.execute(\n                \"INSERT INTO accounts (username, password_hash, email, created_at)\"\n                \" VALUES (?, ?, ?, ?)\",\n                (username, generate_password_hash(password), email, now_iso()),\n            )\n            conn.commit()\n        except sqlite3.IntegrityError:\n            conn.rollback()\n            return error(\"Username or email address is already in use\", 409)\n\n        row = conn.execute(\n            \"SELECT id, username, email FROM accounts WHERE id = ?\",\n            (cur.lastrowid,),\n        ).fetchone()\n        return jsonify(account_json(row)), 201\n    finally:\n        conn.close()\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required\")\n\n    conn = connect()\n    try:\n        row = conn.execute(\n            \"SELECT id, password_hash FROM accounts WHERE username = ?\",\n            (username.strip(),),\n        ).fetchone()\n        if row is None or not check_password_hash(row[\"password_hash\"], password):\n            return error(\"Invalid username or password\", 401)\n\n        token = secrets.token_urlsafe(32)\n        conn.execute(\n            \"INSERT INTO sessions (token, account_id, created_at) VALUES (?, ?, ?)\",\n            (token, row[\"id\"], now_iso()),\n        )\n        conn.commit()\n        return jsonify({\"token\": token})\n    finally:\n        conn.close()\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    if header.startswith(\"Bearer \"):\n        token = header[len(\"Bearer \"):].strip()\n        conn = connect()\n        try:\n            conn.execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n            conn.commit()\n        finally:\n            conn.close()\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/me\")\ndef get_me():\n    account, err = require_account()\n    if err:\n        return err\n    return jsonify(account_json(account))\n\n\n@app.patch(\"/api/me\")\ndef update_me():\n    account, err = require_account()\n    if err:\n        return err\n\n    data = json_body()\n    if \"email\" not in data:\n        return error(\"Email is required\")\n    try:\n        email = normalize_email(data.get(\"email\"))\n    except ValueError as exc:\n        return error(str(exc))\n\n    conn = connect()\n    try:\n        if email is not None and conn.execute(\n            \"SELECT 1 FROM accounts WHERE lower(email) = lower(?) AND id != ?\",\n            (email, account[\"id\"]),\n        ).fetchone():\n            return error(\"Email address is already in use\", 409)\n        try:\n            conn.execute(\n                \"UPDATE accounts SET email = ? WHERE id = ?\",\n                (email, account[\"id\"]),\n            )\n            conn.commit()\n        except sqlite3.IntegrityError:\n            conn.rollback()\n            return error(\"Email address is already in use\", 409)\n\n        row = conn.execute(\n            \"SELECT id, username, email FROM accounts WHERE id = ?\",\n            (account[\"id\"],),\n        ).fetchone()\n        return jsonify(account_json(row))\n    finally:\n        conn.close()\n\n\n@app.post(\"/api/me/password\")\ndef change_password():\n    account, err = require_account()\n    if err:\n        return err\n\n    data = json_body()\n    current_password = data.get(\"current_password\")\n    new_password = data.get(\"new_password\")\n    if not isinstance(current_password, str):\n        return error(\"Current password is required\")\n    message = validate_password(new_password)\n    if message:\n        return error(message)\n\n    conn = connect()\n    try:\n        row = conn.execute(\n            \"SELECT password_hash FROM accounts WHERE id = ?\", (account[\"id\"],)\n        ).fetchone()\n        if row is None or not check_password_hash(\n            row[\"password_hash\"], current_password\n        ):\n            return error(\"Current password is incorrect\", 400)\n\n        conn.execute(\n            \"UPDATE accounts SET password_hash = ? WHERE id = ?\",\n            (generate_password_hash(new_password), account[\"id\"]),\n        )\n        conn.commit()\n        return jsonify({\"status\": \"ok\"})\n    finally:\n        conn.close()\n\n\n@app.post(\"/api/auth/password-reset\")\ndef request_password_reset():\n    data = json_body()\n    username = data.get(\"username\")\n    email = data.get(\"email\")\n    if not username and not email:\n        return error(\"A username or email address is required\")\n\n    conn = connect()\n    try:\n        row = None\n        if isinstance(username, str) and username.strip():\n            row = conn.execute(\n                \"SELECT id, email FROM accounts WHERE username = ?\",\n                (username.strip(),),\n            ).fetchone()\n        if row is None and isinstance(email, str) and email.strip():\n            row = conn.execute(\n                \"SELECT id, email FROM accounts WHERE lower(email) = lower(?)\",\n                (email.strip(),),\n            ).fetchone()\n\n        if row is not None and row[\"email\"]:\n            token = secrets.token_urlsafe(32)\n            sent_at = now_iso()\n            reset_url = f\"{request.host_url.rstrip('/')}/reset?token={token}\"\n            body = (\n                \"Someone requested a password reset for your account.\\n\\n\"\n                f\"Reset your password using this link:\\n{reset_url}\\n\\n\"\n                \"This link can only be used once. If you did not request this, \"\n                \"you can ignore this message.\"\n            )\n            conn.execute(\n                \"INSERT INTO password_resets (token, account_id, created_at, used)\"\n                \" VALUES (?, ?, ?, 0)\",\n                (token, row[\"id\"], sent_at),\n            )\n            conn.execute(\n                \"INSERT INTO outbox (recipient, subject, body, sent_at)\"\n                \" VALUES (?, ?, ?, ?)\",\n                (row[\"email\"], \"Password reset\", body, sent_at),\n            )\n            conn.commit()\n\n        return jsonify(\n            {\"message\": \"If the account exists, a reset link is on its way\"}\n        )\n    finally:\n        conn.close()\n\n\n@app.post(\"/api/auth/password-reset/confirm\")\ndef confirm_password_reset():\n    data = json_body()\n    token = data.get(\"token\")\n    new_password = data.get(\"new_password\")\n    if not isinstance(token, str) or not token:\n        return error(\"Token is required\")\n    message = validate_password(new_password)\n    if message:\n        return error(message)\n\n    conn = connect()\n    try:\n        row = conn.execute(\n            \"SELECT account_id FROM password_resets WHERE token = ? AND used = 0\",\n            (token,),\n        ).fetchone()\n        if row is None:\n            return error(\"Invalid or already used reset token\", 400)\n\n        conn.execute(\n            \"UPDATE accounts SET password_hash = ? WHERE id = ?\",\n            (generate_password_hash(new_password), row[\"account_id\"]),\n        )\n        conn.execute(\n            \"UPDATE password_resets SET used = 1 WHERE account_id = ?\",\n            (row[\"account_id\"],),\n        )\n        conn.commit()\n        return jsonify({\"status\": \"ok\"})\n    finally:\n        conn.close()\n\n\n@app.get(\"/api/outbox\")\ndef outbox():\n    to = request.args.get(\"to\")\n    conn = connect()\n    try:\n        if to is None or to.strip() == \"\":\n            rows = conn.execute(\n                \"SELECT id, recipient, subject, body, sent_at FROM outbox\"\n                \" ORDER BY sent_at DESC, id DESC\"\n            ).fetchall()\n        else:\n            rows = conn.execute(\n                \"SELECT id, recipient, subject, body, sent_at FROM outbox\"\n                \" WHERE lower(recipient) = lower(?)\"\n                \" ORDER BY sent_at DESC, id DESC\",\n                (to.strip(),),\n            ).fetchall()\n        items = [\n            {\n                \"id\": row[\"id\"],\n                \"to\": row[\"recipient\"],\n                \"subject\": row[\"subject\"],\n                \"body\": row[\"body\"],\n                \"sent_at\": row[\"sent_at\"],\n            }\n            for row in rows\n        ]\n        return jsonify({\"items\": items})\n    finally:\n        conn.close()\n\n\n@app.errorhandler(404)\ndef not_found(_exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"Not found\", 404)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794315217413,"end":1794315217442}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c58569fa001H5cOtHr0QsU4uy","sessionID":"ses_e3a7cb2adffeL9tgWqyJUcMBfG","messageID":"msg_1c584b1e1001mUofXUaBAmJAO5"}}
