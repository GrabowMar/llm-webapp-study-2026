     setLoading(false);\n          return;\n        }\n        setForm({\n          title: recipe.title,\n          category: recipe.category,\n          prep_minutes: String(recipe.prep_minutes),\n    const payload: RecipeInput = {\n      title: form.title,\n      category: form.category,\n      prep_minutes: Number(form.prep_minutes),\n      servings: Number(form.servings),\n      ingredients: form.ingredients\n        .map((ingredient) => ingredient.trim())\n        .filter((ingredient) => ingredient.length > 0),\n      instructions: form.instructions,\n    };\n\n    if (payload.ingredients.length === 0) {\n      setIngredientError(\"At least one ingredient is required.\");\n      setSubmitting(false);\n      return;\n    }\n\n    try {\n      const recipe = isEdit\n        ? await updateRecipe(recipeId, payload)\n        : await createRecipe(payload);\n      navigate(`/recipes/${recipe.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        const fieldErrors = { ...err.fields };\n        if (fieldErrors.ingredients) {\n          setIngredientError(fieldErrors.ingredients);\n          delete fieldErrors.ingredients;\n        }\n        setErrors(fieldErrors);\n        if (!Object.keys(fieldErrors).length) setFormError(err.message);\n      } else {\n        setFormError(\"Could not save the recipe. Please try again.\");\n      }\n      setSubmitting(false);\n    }\n  }\n\n  if (loading) {\n    return (\n      <p className=\"py-16 text-center text-sm text-stone-500\">\n        Loading recipe…\n      </p>\n    );\n  }\n\n.venv/\n.tmp/\n__pycache__/\n*.pyc\ndata/\nfrontend/node_modules/\nfrontend/dist/\ntotal 44\ndrwxr-xr-x 1 node node 4096 Nov 10 14:48 .\ndrwxr-xr-x 1 root root 4096 Nov 10 14:38 ..\n-rw-r--r-- 1 node node  118 Jan  1  1970 .dockerignore\ndrwxr-xr-x 8 node node 4096 Nov 10 14:44 .git\n-rw-r--r-- 1 node node   76 Nov 10 14:47 .gitignore\ndrwxr-xr-x 3 node node 4096 Nov 10 14:48 .tmp\ndrwxr-xr-x 5 node node 4096 Nov 10 14:47 .venv\n-