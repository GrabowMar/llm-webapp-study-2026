{"type":"tool_use","timestamp":1794321753527,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_01_2kd6n3p948t4ew6y9q5kyhxa","state":{"status":"completed","input":{"content":"@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n}\n\nbody {\n  @apply bg-stone-50 text-stone-800 antialiased;\n}\n","filePath":"/workspace/frontend/src/index.css"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/index.css","exists":false,"truncated":false},"title":"frontend/src/index.css","time":{"start":1794321753451,"end":1794321753490}},"id":"prt_1c5e92566001YcOmTQ6vb6LUMp","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e90478001ebuEkRygCQNNB0"}}
{"type":"tool_use","timestamp":1794321753527,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_03_wtd7r90sz3p7sn37rbyh1t10","state":{"status":"completed","input":{"content":"export interface RecipeSummary {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number;\n  author: string;\n}\n\nexport interface Recipe extends RecipeSummary {\n  ingredients: string[];\n  instructions: string;\n  servings: number;\n  created_at: string;\n}\n\nexport interface RecipeInput {\n  title: string;\n  category: string;\n  ingredients: string[];\n  instructions: string;\n  prep_minutes: number;\n  servings: number;\n}\n\nexport interface RecipePage {\n  items: RecipeSummary[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface FieldError {\n  error?: string;\n  errors?: Record<string, string>;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n\n  constructor(status: number, message: string, fields: Record<string, string>) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"recipe-book-token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n  authenticated = false,\n): Promise<T> {\n  const headers = new Headers(options.headers);\n  if (options.body !== undefined) {\n    headers.set(\"Content-Type\", \"application/json\");\n  }\n  if (authenticated) {\n    const token = getToken();\n    if (token) headers.set(\"Authorization\", `Bearer ${token}`);\n  }\n\n  const response = await fetch(`/api${path}`, { ...options, headers });\n  const text = await response.text();\n  const data = text ? JSON.parse(text) : null;\n\n  if (!response.ok) {\n    const body = (data ?? {}) as FieldError;\n    throw new ApiError(\n      response.status,\n      body.error ?? `Request failed (${response.status}).`,\n      body.errors ?? {},\n    );\n  }\n  return data as T;\n}\n\nexport function listRecipes(params: {\n  category?: string;\n  q?: string;\n  page?: number;\n  page_size?: number;\n}): Promise<RecipePage> {\n  const search = new URLSearchParams();\n  if (params.category) search.set(\"category\", params.category);\n  if (params.q) search.set(\"q\", params.q);\n  if (params.page) search.set(\"page\", String(params.page));\n  if (params.page_size) search.set(\"page_size\", String(params.page_size));\n  const query = search.toString();\n  return request<RecipePage>(`/recipes${query ? `?${query}` : \"\"}`);\n}\n\nexport function getRecipe(id: number): Promise<Recipe> {\n  return request<Recipe>(`/recipes/${id}`);\n}\n\nexport function getCategories(): Promise<string[]> {\n  return request<string[]>(\"/categories\");\n}\n\nexport function createRecipe(input: RecipeInput): Promise<Recipe> {\n  return request<Recipe>(\n    \"/recipes\",\n    { method: \"POST\", body: JSON.stringify(input) },\n    true,\n  );\n}\n\nexport function updateRecipe(id: number, input: RecipeInput): Promise<Recipe> {\n  return request<Recipe>(\n    `/recipes/${id}`,\n    { method: \"PUT\", body: JSON.stringify(input) },\n    true,\n  );\n}\n\nexport function deleteRecipe(id: number): Promise<void> {\n  return request<void>(`/recipes/${id}`, { method: \"DELETE\" }, true);\n}\n\nexport function login(\n  username: string,\n  password: string,\n): Promise<{ token: string; username: string }> {\n  return request(\"/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function register(\n  username: string,\n  password: string,\n): Promise<{ token: string; username: string }> {\n  return request(\"/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport function me(): Promise<{ username: string }> {\n  return request(\"/auth/me\", {}, true);\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794321753466,"end":1794321753496}},"id":"prt_1c5e92575001MsldC8EP9z5Pil","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e90478001ebuEkRygCQNNB0"}}
{"type":"tool_use","timestamp":1794321753527,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_04_yk8du9d7yugqtb7jury4jqv8","state":{"status":"completed","input":{"content":"import {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useState,\n  type ReactNode,\n} from \"react\";\nimport { getToken, me, setToken } from \"./api\";\n\ninterface AuthContextValue {\n  username: string | null;\n  ready: boolean;\n  signIn: (token: string, username: string) => void;\n  signOut: () => void;\n}\n\nconst AuthContext = createContext<AuthContextValue | null>(null);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [username, setUsername] = useState<string | null>(null);\n  const [ready, setReady] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    const token = getToken();\n    if (!token) {\n      setReady(true);\n      return;\n    }\n    me()\n      .then((user) => {\n        if (!cancelled) setUsername(user.username);\n      })\n      .catch(() => {\n        if (!cancelled) setToken(null);\n      })\n      .finally(() => {\n        if (!cancelled) setReady(true);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, []);\n\n  const signIn = useCallback((token: string, name: string) => {\n    setToken(token);\n    setUsername(name);\n  }, []);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setUsername(null);\n  }, []);\n\n  const value = useMemo(\n    () => ({ username, ready, signIn, signOut }),\n    [username, ready, signIn, signOut],\n  );\n\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n}\n\nexport function useAuth(): AuthContextValue {\n  const context = useContext(AuthContext);\n  if (!context) throw new Error(\"useAuth must be used inside AuthProvider\");\n  return context;\n}\n","filePath":"/workspace/frontend/src/auth.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/auth.tsx","exists":false,"truncated":false},"title":"frontend/src/auth.tsx","time":{"start":1794321753473,"end":1794321753500}},"id":"prt_1c5e9257c0011HqXknFAwdROFf","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e90478001ebuEkRygCQNNB0"}}
{"type":"tool_use","timestamp":1794321753527,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_00_2svslimwnzycz5i0z9drl6dd","state":{"status":"completed","input":{"content":"import { defineConfig } from \"vite\";\nimport react from \"@vitejs/plugin-react\";\nimport tailwindcss from \"@tailwindcss/vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\n","filePath":"/workspace/frontend/vite.config.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/vite.config.ts","exists":true,"truncated":false},"title":"frontend/vite.config.ts","time":{"start":1794321753443,"end":1794321753504}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e9255d001XItu1LPgD9kAMj","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e90478001ebuEkRygCQNNB0"}}
{"type":"tool_use","timestamp":1794321753527,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_02_tai6j4wkv8wiljcgf0qii24e","state":{"status":"completed","input":{"content":"import { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\n","filePath":"/workspace/frontend/src/main.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/main.tsx","exists":true,"truncated":false},"title":"frontend/src/main.tsx","time":{"start":1794321753459,"end":1794321753509}},"id":"prt_1c5e9256e0014i2Q3dTBkoaA3V","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e90478001ebuEkRygCQNNB0"}}
