{"type":"step_start","timestamp":1794321776398,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"id":"prt_1c5e97ef10013YGGz2ZQrQiYy7","messageID":"msg_1c5e9479c001a0c1MQpvHkjff8","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","type":"step-start"}}
{"type":"tool_use","timestamp":1794321776435,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_00_lpmqviz84k4oq3fjxvuv5fym","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { getCategories, listRecipes, type RecipePage } from \"../api\";\nimport Pagination from \"../components/Pagination\";\nimport RecipeCard from \"../components/RecipeCard\";\nimport { Alert } from \"../components/ui\";\nimport { useAuth } from \"../auth\";\n\nconst PAGE_SIZE = 6;\n\nexport default function HomePage() {\n  const { username } = useAuth();\n  const [searchParams, setSearchParams] = useSearchParams();\n  const [categories, setCategories] = useState<string[]>([]);\n  const [data, setData] = useState<RecipePage | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [searchText, setSearchText] = useState(searchParams.get(\"q\") ?? \"\");\n\n  const category = searchParams.get(\"category\") ?? \"\";\n  const query = searchParams.get(\"q\") ?? \"\";\n  const page = Math.max(1, Number(searchParams.get(\"page\") ?? \"1\") || 1);\n\n  useEffect(() => {\n    setSearchText(query);\n  }, [query]);\n\n  useEffect(() => {\n    getCategories()\n      .then(setCategories)\n      .catch(() => setCategories([]));\n  }, []);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    listRecipes({\n      category: category || undefined,\n      q: query || undefined,\n      page,\n      page_size: PAGE_SIZE,\n    })\n      .then((result) => {\n        if (cancelled) return;\n        if (result.items.length === 0 && result.total > 0 && page > 1) {\n          setSearchParams((params) => {\n            const next = new URLSearchParams(params);\n            next.set(\"page\", \"1\");\n            return next;\n          });\n          return;\n        }\n        setData(result);\n      })\n      .catch((err: Error) => {\n        if (!cancelled) setError(err.message);\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [category, query, page, setSearchParams]);\n\n  useEffect(() => {\n    if (searchText === query) return;\n    const timer = window.setTimeout(() => {\n      setSearchParams((params) => {\n        const next = new URLSearchParams(params);\n        if (searchText.trim()) next.set(\"q\", searchText.trim());\n        else next.delete(\"q\");\n        next.delete(\"page\");\n        return next;\n      });\n    }, 300);\n    return () => window.clearTimeout(timer);\n  }, [searchText, query, setSearchParams]);\n\n  function updateFilter(key: \"category\" | \"q\", value: string) {\n    setSearchParams((params) => {\n      const next = new URLSearchParams(params);\n      if (value) next.set(key, value);\n      else next.delete(key);\n      next.delete(\"page\");\n      return next;\n    });\n  }\n\n  return (\n    <div>\n      <div className=\"mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold tracking-tight text-stone-900\">\n            Recipes\n          </h1>\n          <p className=\"mt-1 text-sm text-stone-500\">\n            Browse the collection, or share a dish of your own.\n          </p>\n        </div>\n        {username && (\n          <Link\n            to=\"/recipes/new\"\n            className=\"inline-flex items-center justify-center rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-700\"\n          >\n            Add recipe\n          </Link>\n        )}\n      </div>\n\n      <div className=\"mb-6 flex flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:flex-row\">\n        <div className=\"relative flex-1\">\n          <span className=\"pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-stone-400\">\n            ⌕\n          </span>\n          <input\n            type=\"search\"\n            value={searchText}\n            onChange={(event) => setSearchText(event.target.value)}\n            placeholder=\"Search recipes by title…\"\n            aria-label=\"Search recipes by title\"\n            className=\"w-full rounded-lg border border-stone-300 bg-white py-2 pl-9 pr-3 text-sm text-stone-900 shadow-sm outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200\"\n          />\n        </div>\n        <select\n          value={category}\n          onChange={(event) => updateFilter(\"category\", event.target.value)}\n          aria-label=\"Filter by category\"\n          className=\"rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 shadow-sm outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200 sm:w-56\"\n        >\n          <option value=\"\">All categories</option>\n          {categories.map((name) => (\n            <option key={name} value={name}>\n              {name}\n            </option>\n          ))}\n        </select>\n      </div>\n\n      {error && <Alert>{error}</Alert>}\n\n      {loading && !data ? (\n        <p className=\"py-16 text-center text-sm text-stone-500\">\n          Loading recipes…\n        </p>\n      ) : data && data.items.length === 0 ? (\n        <div className=\"rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center\">\n          <p className=\"text-lg font-semibold text-stone-700\">\n            No recipes found\n          </p>\n          <p className=\"mt-1 text-sm text-stone-500\">\n            Try a different search or category.\n          </p>\n        </div>\n      ) : (\n        <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {data?.items.map((recipe) => (\n            <RecipeCard key={recipe.id} recipe={recipe} />\n          ))}\n        </div>\n      )}\n\n      {data && (\n        <Pagination\n          page={data.page}\n          pageSize={data.page_size}\n          total={data.total}\n          onPageChange={(next) => {\n            setSearchParams((params) => {\n              const updated = new URLSearchParams(params);\n              updated.set(\"page\", String(next));\n              return updated;\n            });\n            window.scrollTo({ top: 0, behavior: \"smooth\" });\n          }}\n        />\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/HomePage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/HomePage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/HomePage.tsx","time":{"start":1794321776379,"end":1794321776415}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e97ef4001Ofpw5ORhMU07D2","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e9479c001a0c1MQpvHkjff8"}}
{"type":"tool_use","timestamp":1794321776435,"sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","part":{"type":"tool","tool":"write","callID":"call_01_dsisy3hwi4w7zgq4j5h2tz0z","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { deleteRecipe, getRecipe, type Recipe } from \"../api\";\nimport { Alert, Button } from \"../components/ui\";\nimport { useAuth } from \"../auth\";\n\nexport default function RecipeDetailPage() {\n  const { id } = useParams();\n  const recipeId = Number(id);\n  const navigate = useNavigate();\n  const { username } = useAuth();\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [deleting, setDeleting] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    setError(null);\n    getRecipe(recipeId)\n      .then((result) => {\n        if (!cancelled) setRecipe(result);\n      })\n      .catch((err: Error) => {\n        if (!cancelled) setError(err.message);\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [recipeId]);\n\n  async function handleDelete() {\n    if (!recipe) return;\n    if (!window.confirm(`Delete “${recipe.title}”? This cannot be undone.`)) {\n      return;\n    }\n    setDeleting(true);\n    setError(null);\n    try {\n      await deleteRecipe(recipe.id);\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Could not delete recipe.\");\n      setDeleting(false);\n    }\n  }\n\n  if (loading) {\n    return (\n      <p className=\"py-16 text-center text-sm text-stone-500\">\n        Loading recipe…\n      </p>\n    );\n  }\n\n  if (error && !recipe) {\n    return (\n      <div className=\"space-y-4\">\n        <Alert>{error}</Alert>\n        <Link to=\"/\" className=\"text-sm font-medium text-amber-700 hover:underline\">\n          ← Back to recipes\n        </Link>\n      </div>\n    );\n  }\n\n  if (!recipe) return null;\n\n  const canEdit = username === recipe.author;\n\n  return (\n    <article>\n      <Link\n        to=\"/\"\n        className=\"text-sm font-medium text-amber-700 hover:underline\"\n      >\n        ← Back to recipes\n      </Link>\n\n      <div className=\"mt-4 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8\">\n        <div className=\"flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between\">\n          <div>\n            <span className=\"inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800\">\n              {recipe.category}\n            </span>\n            <h1 className=\"mt-3 text-3xl font-bold tracking-tight text-stone-900\">\n              {recipe.title}\n            </h1>\n            <p className=\"mt-2 text-sm text-stone-500\">\n              by{\" \"}\n              <span className=\"font-medium text-stone-700\">{recipe.author}</span>{\" \"}\n              · {new Date(recipe.created_at).toLocaleDateString()}\n            </p>\n          </div>\n\n          {canEdit && (\n            <div className=\"flex gap-2\">\n              <Link\n                to={`/recipes/${recipe.id}/edit`}\n                className=\"inline-flex items-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-700 shadow-sm transition hover:bg-stone-100\"\n              >\n                Edit\n              </Link>\n              <Button\n                type=\"button\"\n                variant=\"danger\"\n                onClick={handleDelete}\n                disabled={deleting}\n              >\n                {deleting ? \"Deleting…\" : \"Delete\"}\n              </Button>\n            </div>\n          )}\n        </div>\n\n        {error && (\n          <div className=\"mt-4\">\n            <Alert>{error}</Alert>\n          </div>\n        )}\n\n        <div className=\"mt-6 flex flex-wrap gap-3 border-y border-stone-100 py-4 text-sm\">\n          <div className=\"rounded-lg bg-stone-50 px-3 py-2\">\n            <span className=\"text-stone-500\">Prep time:</span>{\" \"}\n            <span className=\"font-semibold text-stone-800\">\n              {recipe.prep_minutes} min\n            </span>\n          </div>\n          <div className=\"rounded-lg bg-stone-50 px-3 py-2\">\n            <span className=\"text-stone-500\">Servings:</span>{\" \"}\n            <span className=\"font-semibold text-stone-800\">\n              {recipe.servings}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]\">\n          <section>\n            <h2 className=\"text-lg font-semibold text-stone-900\">Ingredients</h2>\n            <ul className=\"mt-3 space-y-2\">\n              {recipe.ingredients.map((ingredient, index) => (\n                <li\n                  key={`${index}-${ingredient}`}\n                  className=\"flex items-start gap-2 text-sm text-stone-700\"\n                >\n                  <span className=\"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500\" />\n                  <span>{ingredient}</span>\n                </li>\n              ))}\n            </ul>\n          </section>\n\n          <section>\n            <h2 className=\"text-lg font-semibold text-stone-900\">\n              Instructions\n            </h2>\n            <div className=\"mt-3 whitespace-pre-line text-sm leading-relaxed text-stone-700\">\n              {recipe.instructions}\n            </div>\n          </section>\n        </div>\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipeDetailPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipeDetailPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipeDetailPage.tsx","time":{"start":1794321776390,"end":1794321776419}},"id":"prt_1c5e97f00001XpjBgdonmN8r05","sessionID":"ses_e3a1a5bf5ffeDmCqw06IcUdMp9","messageID":"msg_1c5e9479c001a0c1MQpvHkjff8"}}
