+                data["final_url"],
+                data["status_code"],
+                data["title"],
+                data["description"],
+                data["image_url"],
+                data["fetched_at"],
+                now,
+            ),
+        )
+        connection.commit()
+        row = connection.execute(
+            "SELECT * FROM previews WHERE id = ?", (cursor.lastrowid,)
+        ).fetchone()
+    finally:
+        connection.close()
+    return jsonify(preview_dict(row)), 201
