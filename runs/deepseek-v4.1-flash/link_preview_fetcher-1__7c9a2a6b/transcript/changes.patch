+        return jsonify({"error": "username is too long"}), 400
+    if len(password) > 1024:
+        return jsonify({"error": "password is too long"}), 400
+
+    connection = get_db()
+    try:
+        cursor = connection.execute(
+            "INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)",
