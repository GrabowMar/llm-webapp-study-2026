{"type":"tool_use","timestamp":1794378845580,"sessionID":"ses_e36b26a08ffei4Ld1UzXPs7TQt","part":{"type":"tool","tool":"write","callID":"call_7b8378b831df4304b7509e81","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Link preview bookmarking app: Flask API plus frontend build.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom html import unescape\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom urllib.error import HTTPError, URLError\nfrom urllib.parse import urljoin, urlparse\nfrom urllib.request import Request, urlopen\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent\nDIST = BASE_DIR.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\n\nMAX_FETCH_BYTES = 5 * 1024 * 1024\nFETCH_TIMEOUT = 15\nUSER_AGENT = (\n    \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0; +https://example.com/bot)\"\n)\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\n\nclass FetchError(Exception):\n    pass\n\n\nclass PreviewParser(HTMLParser):\n    def __init__(self) -> None:\n        super().__init__(convert_charrefs=True)\n        self.title_parts: list[str] = []\n        self.in_title = False\n        self.meta: dict[str, str] = {}\n\n    def handle_starttag(self, tag: str, attrs) -> None:\n        tag = tag.lower()\n        if tag == \"title\":\n            self.in_title = True\n            return\n        if tag != \"meta\":\n            return\n        values = {key.lower(): (value or \"\") for key, value in attrs}\n        content = values.get(\"content\")\n        if content is None:\n            return\n        key = (values.get(\"property\") or values.get(\"name\") or \"\").strip().lower()\n        if key and key not in self.meta:\n            self.meta[key] = content\n\n    def handle_startendtag(self, tag: str, attrs) -> None:\n        self.handle_starttag(tag, attrs)\n\n    def handle_endtag(self, tag: str) -> None:\n        if tag.lower() == \"title\":\n            self.in_title = False\n\n    def handle_data(self, data: str) -> None:\n        if self.in_title:\n            self.title_parts.append(data)\n\n\ndef utc_now() -> str:\n    return (\n        datetime.now(timezone.utc)\n        .isoformat(timespec=\"seconds\")\n        .replace(\"+00:00\", \"Z\")\n    )\n\n\ndef clean_text(value: str | None) -> str | None:\n    if value is None:\n        return None\n    value = unescape(value)\n    value = re.sub(r\"<[^>]*>\", \" \", value)\n    value = \" \".join(value.split())\n    return value or None\n\n\ndef get_db() -> sqlite3.Connection:\n    connection = sqlite3.connect(DB_PATH, timeout=30)\n    connection.row_factory = sqlite3.Row\n    connection.execute(\"PRAGMA foreign_keys = ON\")\n    connection.execute(\"PRAGMA busy_timeout = 30000\")\n    return connection\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    connection = get_db()\n    try:\n        connection.execute(\"PRAGMA journal_mode = WAL\")\n        connection.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS tokens (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                token_hash TEXT NOT NULL UNIQUE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS previews (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                url TEXT NOT NULL,\n                final_url TEXT,\n                status_code INTEGER,\n                title TEXT,\n                description TEXT,\n                image_url TEXT,\n                fetched_at TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_previews_user\n                ON previews (user_id, id DESC);\n            CREATE INDEX IF NOT EXISTS idx_tokens_hash\n                ON tokens (token_hash);\n            \"\"\"\n        )\n        connection.commit()\n    finally:\n        connection.close()\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode(\"utf-8\")).hexdigest()\n\n\ndef current_user() -> sqlite3.Row:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        abort(401)\n    connection = get_db()\n    try:\n        row = connection.execute(\n            \"\"\"\n            SELECT users.*\n            FROM tokens\n            JOIN users ON users.id = tokens.user_id\n            WHERE tokens.token_hash = ?\n            \"\"\",\n            (hash_token(token.strip()),),\n        ).fetchone()\n    finally:\n        connection.close()\n    if row is None:\n        abort(401)\n    g.user = row\n    return row\n\n\ndef preview_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\ndef normalise_url(value: object) -> str:\n    if not isinstance(value, str):\n        raise ValueError(\"url must be a string\")\n    url = value.strip()\n    if not url:\n        raise ValueError(\"url is required\")\n    parsed = urlparse(url)\n    if parsed.scheme not in (\"http\", \"https\") or not parsed.netloc:\n        raise ValueError(\"url must be an absolute http(s) URL\")\n    return url\n\n\ndef decode_body(raw: bytes, charset: str | None) -> str:\n    if not charset:\n        match = re.search(rb\"charset=[\\\"']?([\\w.-]+)\", raw[:4096], re.IGNORECASE)\n        if match:\n            charset = match.group(1).decode(\"ascii\", \"ignore\")\n    for encoding in (charset, \"utf-8\", \"latin-1\"):\n        if not encoding:\n            continue\n        try:\n            return raw.decode(encoding)\n        except (LookupError, UnicodeDecodeError):\n            continue\n    return raw.decode(\"utf-8\", errors=\"replace\")\n\n\ndef fetch_preview(url: str) -> dict:\n    req = Request(\n        url,\n        headers={\n            \"User-Agent\": USER_AGENT,\n            \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n            \"Accept-Language\": \"en-US,en;q=0.9\",\n            \"Accept-Encoding\": \"identity\",\n        },\n    )\n    try:\n        try:\n            response = urlopen(req, timeout=FETCH_TIMEOUT)\n        except HTTPError as error:\n            response = error\n        with response:\n            status_code = getattr(response, \"status\", None) or response.getcode()\n            final_url = response.geturl() or url\n            raw = response.read(MAX_FETCH_BYTES)\n            charset = response.headers.get_content_charset()\n    except (URLError, ValueError, OSError) as error:\n        raise FetchError(str(error)) from error\n\n    html = decode_body(raw, charset)\n    parser = PreviewParser()\n    try:\n        parser.feed(html)\n        parser.close()\n    except Exception:\n        pass\n\n    title = clean_text(parser.meta.get(\"og:title\")) or clean_text(\n        \"\".join(parser.title_parts)\n    )\n    description = clean_text(parser.meta.get(\"og:description\")) or clean_text(\n        parser.meta.get(\"description\")\n    )\n    image = parser.meta.get(\"og:image\") or parser.meta.get(\"og:image:url\")\n    image_url = None\n    if image and image.strip():\n        image_url = urljoin(final_url, image.strip())\n\n    return {\n        \"final_url\": final_url,\n        \"status_code\": int(status_code),\n        \"title\": title,\n        \"description\": description,\n        \"image_url\": image_url,\n        \"fetched_at\": utc_now(),\n    }\n\n\ndef json_body() -> dict:\n    body = request.get_json(silent=True)\n    return body if isinstance(body, dict) else {}\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(error: HTTPException):\n    if request.path.startswith(\"/api\") or request.path == \"/api\":\n        return jsonify({\"error\": error.description}), error.code\n    return error\n\n\n@app.errorhandler(FetchError)\ndef handle_fetch_error(error: FetchError):\n    return jsonify({\"error\": \"could not fetch the page\"}), 502\n\n\n@app.errorhandler(404)\ndef handle_not_found(error):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"password is required\"}), 400\n    username = username.strip()\n    if len(username) > 150:\n        return jsonify({\"error\": \"username is too long\"}), 400\n    if len(password) > 1024:\n        return jsonify({\"error\": \"password is too long\"}), 400\n\n    connection = get_db()\n    try:\n        cursor = connection.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utc_now()),\n        )\n        connection.commit()\n        user_id = cursor.lastrowid\n    except sqlite3.IntegrityError:\n        connection.rollback()\n        return jsonify({\"error\": \"username is already taken\"}), 409\n    finally:\n        connection.close()\n    return jsonify({\"id\": user_id, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return jsonify({\"error\": \"username and password are required\"}), 400\n\n    connection = get_db()\n    try:\n        user = connection.execute(\n            \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n        ).fetchone()\n        if user is None or not check_password_hash(user[\"password_hash\"], password):\n            return jsonify({\"error\": \"invalid username or password\"}), 401\n        token = secrets.token_urlsafe(32)\n        connection.execute(\n            \"INSERT INTO tokens (user_id, token_hash, created_at) VALUES (?, ?, ?)\",\n            (user[\"id\"], hash_token(token), utc_now()),\n        )\n        connection.commit()\n    finally:\n        connection.close()\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    return jsonify({\"username\": user[\"username\"]})\n\n\n@app.post(\"/api/previews\")\ndef create_preview():\n    user = current_user()\n    body = json_body()\n    try:\n        url = normalise_url(body.get(\"url\"))\n    except ValueError as error:\n        return jsonify({\"error\": str(error)}), 400\n\n    data = fetch_preview(url)\n    now = utc_now()\n    connection = get_db()\n    try:\n        cursor = connection.execute(\n            \"\"\"\n            INSERT INTO previews\n                (user_id, url, final_url, status_code, title, description,\n                 image_url, fetched_at, created_at)\n            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n            \"\"\",\n            (\n                user[\"id\"],\n                url,\n                data[\"final_url\"],\n                data[\"status_code\"],\n                data[\"title\"],\n                data[\"description\"],\n                data[\"image_url\"],\n                data[\"fetched_at\"],\n                now,\n            ),\n        )\n        connection.commit()\n        row = connection.execute(\n            \"SELECT * FROM previews WHERE id = ?\", (cursor.lastrowid,)\n        ).fetchone()\n    finally:\n        connection.close()\n    return jsonify(preview_dict(row)), 201\n\n\n@app.get(\"/api/previews\")\ndef list_previews():\n    user = current_user()\n\n    def positive_int(name: str, default: int) -> int:\n        raw = request.args.get(name)\n        if raw is None or raw == \"\":\n            return default\n        try:\n            value = int(raw)\n        except (TypeError, ValueError):\n            return default\n        return value if value > 0 else default\n\n    page = positive_int(\"page\", 1)\n    page_size = min(positive_int(\"page_size\", DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE)\n    offset = (page - 1) * page_size\n\n    connection = get_db()\n    try:\n        total = connection.execute(\n            \"SELECT COUNT(*) AS count FROM previews WHERE user_id = ?\",\n            (user[\"id\"],),\n        ).fetchone()[\"count\"]\n        rows = connection.execute(\n            \"\"\"\n            SELECT * FROM previews\n            WHERE user_id = ?\n            ORDER BY id DESC\n            LIMIT ? OFFSET ?\n            \"\"\",\n            (user[\"id\"], page_size, offset),\n        ).fetchall()\n    finally:\n        connection.close()\n\n    return jsonify(\n        {\n            \"items\": [preview_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\ndef owned_preview(preview_id: int) -> sqlite3.Row:\n    user = current_user()\n    connection = get_db()\n    try:\n        row = connection.execute(\n            \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n            (preview_id, user[\"id\"]),\n        ).fetchone()\n    finally:\n        connection.close()\n    if row is None:\n        abort(404)\n    return row\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\ndef get_preview(preview_id: int):\n    return jsonify(preview_dict(owned_preview(preview_id)))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\ndef refresh_preview(preview_id: int):\n    row = owned_preview(preview_id)\n    data = fetch_preview(row[\"url\"])\n    connection = get_db()\n    try:\n        connection.execute(\n            \"\"\"\n            UPDATE previews\n            SET final_url = ?, status_code = ?, title = ?, description = ?,\n                image_url = ?, fetched_at = ?\n            WHERE id = ? AND user_id = ?\n            \"\"\",\n            (\n                data[\"final_url\"],\n                data[\"status_code\"],\n                data[\"title\"],\n                data[\"description\"],\n                data[\"image_url\"],\n                data[\"fetched_at\"],\n                preview_id,\n                row[\"user_id\"],\n            ),\n        )\n        connection.commit()\n        updated = connection.execute(\n            \"SELECT * FROM previews WHERE id = ?\", (preview_id,)\n        ).fetchone()\n    finally:\n        connection.close()\n    return jsonify(preview_dict(updated))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\ndef delete_preview(preview_id: int):\n    row = owned_preview(preview_id)\n    connection = get_db()\n    try:\n        connection.execute(\n            \"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n            (preview_id, row[\"user_id\"]),\n        )\n        connection.commit()\n    finally:\n        connection.close()\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\") or path == \"api\":\n        abort(404)\n    target = (DIST / path).resolve()\n    try:\n        target.relative_to(DIST.resolve())\n    except ValueError:\n        abort(404)\n    if target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794378845511,"end":1794378845561}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9504d3d001yC436i76Dtxz2c","sessionID":"ses_e36b26a08ffei4Ld1UzXPs7TQt","messageID":"msg_1c94ee181001Kguzk8zlgX7kCL"}}
