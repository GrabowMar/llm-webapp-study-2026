{"type":"tool_use","timestamp":1794379014767,"sessionID":"ses_e36b26a08ffei4Ld1UzXPs7TQt","part":{"type":"tool","tool":"write","callID":"call_d057eabb75ea409c99268d6d","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useRef, useState } from \"react\";\nimport AuthScreen from \"./AuthScreen\";\nimport PreviewCard from \"./PreviewCard\";\nimport {\n  ApiError,\n  createPreview,\n  deletePreview,\n  getToken,\n  listPreviews,\n  me,\n  refreshPreview,\n  setToken,\n} from \"./api\";\nimport type { Preview, PreviewPage } from \"./api\";\n\nconst PAGE_SIZE = 9;\n\nexport default function App() {\n  const [token, setTokenState] = useState<string | null>(getToken());\n  const [username, setUsername] = useState<string | null>(null);\n  const [checking, setChecking] = useState<boolean>(Boolean(getToken()));\n\n  const [previews, setPreviews] = useState<Preview[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [loading, setLoading] = useState(false);\n  const [listError, setListError] = useState<string | null>(null);\n\n  const [url, setUrl] = useState(\"\");\n  const [adding, setAdding] = useState(false);\n  const [addError, setAddError] = useState<string | null>(null);\n\n  const requestSeq = useRef(0);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setTokenState(null);\n    setUsername(null);\n    setPreviews([]);\n    setTotal(0);\n    setPage(1);\n  }, []);\n\n  const loadPage = useCallback(\n    async (targetPage: number) => {\n      const seq = ++requestSeq.current;\n      setLoading(true);\n      setListError(null);\n      try {\n        const data = await listPreviews(targetPage, PAGE_SIZE);\n        if (seq !== requestSeq.current) {\n          return;\n        }\n        const lastPage = Math.max(1, Math.ceil(data.total / data.page_size));\n        if (data.items.length === 0 && targetPage > lastPage) {\n          setPage(lastPage);\n          return;\n        }\n        setPreviews(data.items);\n        setTotal(data.total);\n        setPage(data.page);\n      } catch (error) {\n        if (seq !== requestSeq.current) {\n          return;\n        }\n        if (error instanceof ApiError && error.status === 401) {\n          signOut();\n          return;\n        }\n        setListError(\n          error instanceof Error ? error.message : \"Could not load previews\",\n        );\n      } finally {\n        if (seq === requestSeq.current) {\n          setLoading(false);\n        }\n      }\n    },\n    [signOut],\n  );\n\n  useEffect(() => {\n    if (!token) {\n      return;\n    }\n    if (username) {\n      return;\n    }\n    let active = true;\n    me()\n      .then((data) => {\n        if (active) {\n          setUsername(data.username);\n        }\n      })\n      .catch((error) => {\n        if (active && error instanceof ApiError && error.status === 401) {\n          signOut();\n        }\n      })\n      .finally(() => {\n        if (active) {\n          setChecking(false);\n        }\n      });\n    return () => {\n      active = false;\n    };\n  }, [token, username, signOut]);\n\n  useEffect(() => {\n    if (token && username) {\n      void loadPage(page);\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [token, username, page]);\n\n  function handleAuthenticated(newToken: string) {\n    setToken(newToken);\n    setTokenState(newToken);\n    setUsername(null);\n    setChecking(true);\n    setPage(1);\n  }\n\n  async function handleAdd(event: React.FormEvent) {\n    event.preventDefault();\n    const trimmed = url.trim();\n    if (!trimmed || adding) {\n      return;\n    }\n    setAdding(true);\n    setAddError(null);\n    try {\n      await createPreview(trimmed);\n      setUrl(\"\");\n      if (page !== 1) {\n        setPage(1);\n      } else {\n        await loadPage(1);\n      }\n    } catch (error) {\n      if (error instanceof ApiError && error.status === 401) {\n        signOut();\n        return;\n      }\n      setAddError(\n        error instanceof Error ? error.message : \"Could not add that link\",\n      );\n    } finally {\n      setAdding(false);\n    }\n  }\n\n  async function handleRefresh(id: number) {\n    try {\n      const updated = await refreshPreview(id);\n      setPreviews((current) =>\n        current.map((item) => (item.id === id ? updated : item)),\n      );\n    } catch (error) {\n      if (error instanceof ApiError && error.status === 401) {\n        signOut();\n        return;\n      }\n      setListError(\n        error instanceof Error ? error.message : \"Could not refresh preview\",\n      );\n    }\n  }\n\n  async function handleDelete(id: number) {\n    try {\n      await deletePreview(id);\n      const remaining = previews.filter((item) => item.id !== id);\n      if (remaining.length === 0 && page > 1) {\n        setPage(page - 1);\n      } else {\n        setPreviews(remaining);\n        setTotal((value) => Math.max(0, value - 1));\n        await loadPage(page);\n      }\n    } catch (error) {\n      if (error instanceof ApiError && error.status === 401) {\n        signOut();\n        return;\n      }\n      setListError(\n        error instanceof Error ? error.message : \"Could not delete preview\",\n      );\n    }\n  }\n\n  if (checking) {\n    return (\n      <div className=\"flex min-h-screen items-center justify-center bg-slate-900\">\n        <div className=\"flex items-center gap-3 text-slate-300\">\n          <span className=\"h-5 w-5 animate-spin rounded-full border-2 border-slate-500 border-t-white\" />\n          Loading…\n        </div>\n      </div>\n    );\n  }\n\n  if (!token) {\n    return <AuthScreen onAuthenticated={handleAuthenticated} />;\n  }\n\n  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));\n\n  return (\n    <div className=\"min-h-screen bg-slate-100\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl items-center justify-between px-4 py-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-lg\">\n              🔗\n            </span>\n            <h1 className=\"text-lg font-bold text-slate-900\">Link Previews</h1>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-sm text-slate-600\">\n              Signed in as{\" \"}\n              <span className=\"font-semibold text-slate-900\">{username}</span>\n            </span>\n            <button\n              type=\"button\"\n              onClick={signOut}\n              className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50\"\n            >\n              Sign out\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-8\">\n        <form\n          onSubmit={handleAdd}\n          className=\"mb-8 rounded-xl border border-slate-200 bg-white p-4 shadow-sm\"\n        >\n          <div className=\"flex flex-col gap-3 sm:flex-row\">\n            <div className=\"relative flex-1\">\n              <span className=\"pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\">\n                🔗\n              </span>\n              <input\n                type=\"url\"\n                value={url}\n                onChange={(event) => setUrl(event.target.value)}\n                placeholder=\"Paste a link to save…\"\n                required\n                className=\"w-full rounded-lg border border-slate-300 py-2.5 pl-9 pr-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\"\n              />\n            </div>\n            <button\n              type=\"submit\"\n              disabled={adding || !url.trim()}\n              className=\"flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-6 py-2.5 font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60\"\n            >\n              {adding && (\n                <span className=\"h-4 w-4 animate-spin rounded-full border-2 border-indigo-200 border-t-white\" />\n              )}\n              {adding ? \"Adding…\" : \"Add\"}\n            </button>\n          </div>\n          {addError && (\n            <p className=\"mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">\n              {addError}\n            </p>\n          )}\n        </form>\n\n        {listError && (\n          <p className=\"mb-6 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {listError}\n          </p>\n        )}\n\n        {loading && previews.length === 0 ? (\n          <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {Array.from({ length: 3 }).map((_, index) => (\n              <div\n                key={index}\n                className=\"h-72 animate-pulse rounded-xl border border-slate-200 bg-white\"\n              />\n            ))}\n          </div>\n        ) : previews.length === 0 ? (\n          <div className=\"rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center\">\n            <p className=\"text-lg font-semibold text-slate-700\">\n              No previews yet\n            </p>\n            <p className=\"mt-1 text-sm text-slate-500\">\n              Paste a link above to save your first one.\n            </p>\n          </div>\n        ) : (\n          <div\n            className={`grid gap-4 sm:grid-cols-2 lg:grid-cols-3 ${\n              loading ? \"opacity-60\" : \"\"\n            }`}\n          >\n            {previews.map((preview) => (\n              <PreviewCard\n                key={preview.id}\n                preview={preview}\n                onRefresh={handleRefresh}\n                onDelete={handleDelete}\n              />\n            ))}\n          </div>\n        )}\n\n        {total > 0 && (\n          <div className=\"mt-8 flex items-center justify-between\">\n            <span className=\"text-sm text-slate-500\">\n              Page {page} of {totalPages} · {total}{\" \"}\n              {total === 1 ? \"preview\" : \"previews\"}\n            </span>\n            <div className=\"flex gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => setPage((value) => Math.max(1, value - 1))}\n                disabled={page <= 1 || loading}\n                className=\"rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n              >\n                Previous\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setPage((value) => Math.min(totalPages, value + 1))}\n                disabled={page >= totalPages || loading}\n                className=\"rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n              >\n                Next\n              </button>\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794379014727,"end":1794379014741}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c952e23f001EirvFZq0TdzuvP","sessionID":"ses_e36b26a08ffei4Ld1UzXPs7TQt","messageID":"msg_1c9528a2e001rc6T0X5jva3sNk"}}
