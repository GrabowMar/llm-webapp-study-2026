{"type":"text","timestamp":1794373426807,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"id":"prt_1c8fd9e5c001ZShPitqP9606Hp","messageID":"msg_1c8fa812b001Hvv7GMNqemYbxb","sessionID":"ses_e37071251ffetjKxIhfb93728N","type":"text","text":"Environment is ready (Node 24, Python 3.13, npm registry reachable). Now writing the backend API.","time":{"start":1794373426780,"end":1794373426800}}}
{"type":"tool_use","timestamp":1794373426938,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_9ce79765872a48a4a7994096","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.security import check_password_hash\nfrom werkzeug.security import generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"dashboard.db\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id            INTEGER PRIMARY KEY AUTOINCREMENT,\n    username      TEXT    NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT    NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token   TEXT    PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\n\nCREATE TABLE IF NOT EXISTS sensors (\n    id           INTEGER PRIMARY KEY AUTOINCREMENT,\n    name         TEXT    NOT NULL,\n    unit         TEXT    NOT NULL DEFAULT '',\n    location     TEXT    NOT NULL DEFAULT '',\n    last_value   TEXT,\n    last_updated TEXT,\n    owner_id     INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\n\nCREATE TABLE IF NOT EXISTS readings (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    sensor_id   INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n    value       TEXT    NOT NULL,\n    recorded_at TEXT    NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_sensors_owner ON sensors(owner_id);\nCREATE INDEX IF NOT EXISTS idx_sensors_name ON sensors(name COLLATE NOCASE);\nCREATE INDEX IF NOT EXISTS idx_readings_sensor\n    ON readings(sensor_id, recorded_at DESC, id DESC);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\n# ----------------------------------------------------------------- helpers\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef now_iso() -> str:\n    return (\n        datetime.now(timezone.utc)\n        .isoformat(timespec=\"milliseconds\")\n        .replace(\"+00:00\", \"Z\")\n    )\n\n\ndef encode(value: Any) -> str:\n    return json.dumps(value, ensure_ascii=False)\n\n\ndef decode(raw: str | None) -> Any:\n    if raw is None:\n        return None\n    try:\n        return json.loads(raw)\n    except (TypeError, ValueError):\n        return raw\n\n\ndef body() -> dict[str, Any]:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef text_field(data: dict[str, Any], key: str) -> str | None:\n    \"\"\"Return a non-empty stripped string, or None when invalid.\"\"\"\n    value = data.get(key)\n    if isinstance(value, str) and value.strip():\n        return value.strip()\n    return None\n\n\ndef connect_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None = None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect_db()\n    try:\n        conn.executes(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef row_to_sensor(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"last_value\": decode(row[\"last_value\"]),\n        \"last_updated\": row[\"last_updated\"],\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef row_to_reading(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"sensor_id\": row[\"sensor_id\"],\n        \"value\": decode(row[\"value\"]),\n        \"recorded_at\": row[\"recorded_at\"],\n    }\n\n\nSENSOR_SELECT = \"\"\"\n    SELECT s.id, s.name, s.unit, s.location, s.last_value, s.last_updated,\n           u.username AS owner\n    FROM sensors s\n    JOIN users u ON u.id = s.owner_id\n\"\"\"\n\n\n# -------------------------------------------------------------------- auth\n\n\ndef current_user() -> dict[str, Any] | None:\n    if \"user\" in g:\n        return g.user\n\n    found: dict[str, Any] | None = None\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, raw = header.partition(\" \")\n    token = raw.strip()\n    if scheme.lower() == \"bearer\" and token:\n        row = get_db().execute(\n            \"\"\"\n            SELECT u.id, u.username\n            FROM tokens t\n            JOIN users u ON u.id = t.user_id\n            WHERE t.token = ?\n            \"\"\",\n            (token,),\n        ).fetchone()\n        if row is not None:\n            found = {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n\n    g.user = found\n    return found\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        if current_user() is None:\n            return error(\"authentication required\", 401)\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef owned_sensor(sensor_id: int):\n    \"\"\"Fetch a sensor for the signed-in user.\n\n    Returns (sensor_row, None) when found and owned, (None, response)\n    otherwise.\n    \"\"\"\n    row = get_db().execute(\n        SENSOR_SELECT + \" WHERE s.id = ?\", (sensor_id,)\n    ).fetchone()\n    if row is None:\n        return None, error(\"sensor not found\", 404)\n    user = current_user()\n    if user is None or row[\"owner\"].lower() != user[\"username\"].lower():\n        return None, error(\"you do not own this sensor\", 403)\n    return row, None\n\n\n# ------------------------------------------------------------------ routes\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = text_field(data, \"username\")\n    password = text_field(data, \"password\")\n    if username is None:\n        return error(\"username is required\", 400)\n    if password is None:\n        return error(\"password is required\", 400)\n\n    db = get_db()\n    try:\n        cur = db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    db.commit()\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = text_field(data, \"username\")\n    password = text_field(data, \"password\")\n    if username is None or password is None:\n        return error(\"username and password are required\", 400)\n\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, row[\"id\"])\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = get_db().execute(\n        SENSOR_SELECT + \" ORDER BY s.name COLLATE NOCASE ASC, s.name ASC, s.id ASC\"\n    ).fetchall()\n    return jsonify({\"items\": [row_to_sensor(r) for r in rows]})\n\n\n@app.post(\"/api/sensors\")\n@require_auth\ndef create_sensor():\n    data = body()\n    name = text_field(data, \"name\")\n    if name is None:\n        return error(\"name is required\", 400)\n    unit = data.get(\"unit\", \"\")\n    location = data.get(\"location\", \"\")\n    if not isinstance(unit, str) or not isinstance(location, str):\n        return error(\"unit and location must be strings\", 400)\n\n    user = current_user()\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO sensors (name, unit, location, owner_id) VALUES (?, ?, ?, ?)\",\n        (name, unit, location, user[\"id\"]),\n    )\n    db.commit()\n    row = db.execute(\n        SENSOR_SELECT + \" WHERE s.id = ?\", (cur.lastrowid,)\n    ).fetchone()\n    return jsonify(row_to_sensor(row)), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef get_sensor(sensor_id: int):\n    row = get_db().execute(\n        SENSOR_SELECT + \" WHERE s.id = ?\", (sensor_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"sensor not found\", 404)\n    return jsonify(row_to_sensor(row))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\n@require_auth\ndef delete_sensor(sensor_id: int):\n    row, failure = owned_sensor(sensor_id)\n    if failure is not None:\n        return failure\n    db = get_db()\n    db.execute(\"DELETE FROM sensors WHERE id = ?\", (row[\"id\"],))\n    db.commit()\n    return jsonify({\"ok\": True}), 200\n\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id: int):\n    db = get_db()\n    sensor = db.execute(\n        \"SELECT id FROM sensors WHERE id = ?\", (sensor_id,)\n    ).fetchone()\n    if sensor is None:\n        return error(\"sensor not found\", 404)\n\n    limit: int | None = None\n    raw_limit = request.args.get(\"limit\")\n    if raw_limit is not None:\n        try:\n            limit = int(raw_limit)\n        except ValueError:\n            return error(\"limit must be an integer\", 400)\n        if limit < 0:\n            return error(\"limit must not be negative\", 400)\n\n    total = db.execute(\n        \"SELECT COUNT(*) AS n FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[\"n\"]\n\n    query = (\n        \"SELECT id, sensor_id, value, recorded_at FROM readings \"\n        \"WHERE sensor_id = ? ORDER BY recorded_at DESC, id DESC\"\n    )\n    params: list[Any] = [sensor_id]\n    if limit is not None:\n        query += \" LIMIT ?\"\n        params.append(limit)\n    rows = db.execute(query, params).fetchall()\n    return jsonify({\"items\": [row_to_reading(r) for r in rows], \"total\": total})\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\n@require_auth\ndef create_reading(sensor_id: int):\n    _row, failure = owned_sensor(sensor_id)\n    if failure is not None:\n        return failure\n\n    data = body()\n    if \"value\" not in data or data.get(\"value\") is None:\n        return error(\"value is required\", 400)\n\n    recorded_at = now_iso()\n    value = encode(data.get(\"value\"))\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n        (sensor_id, value, recorded_at),\n    )\n    db.execute(\n        \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n        (value, recorded_at, sensor_id),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings WHERE id = ?\",\n        (cur.lastrowid,),\n    ).fetchone()\n    return jsonify(row_to_reading(row)), 201\n\n\n# ------------------------------------------------- unknown API routes / SPA\n\n\n@app.get(\"/api/<path:rest>\")\ndef api_not_found(rest: str):\n    return error(\"not found\", 404)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794373426794,"end":1794373426911}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8fd9e60001Ct3T6Z9xRbwUcj","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c8fa812b001Hvv7GMNqemYbxb"}}
