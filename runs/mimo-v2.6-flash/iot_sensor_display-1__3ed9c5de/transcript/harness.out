{"type":"text","timestamp":1794374119022,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"id":"prt_1c9082e5a001MW4G0gOqzwmYPq","messageID":"msg_1c907c4da001j6h7xdasCyyG3N","sessionID":"ses_e37071251ffetjKxIhfb93728N","type":"text","text":"Server runs. Now a comprehensive API test suite:","time":{"start":1794374119002,"end":1794374119017}}}
{"type":"tool_use","timestamp":1794374119046,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_68435f95495a49b2946af035","state":{"status":"completed","input":{"content":"\"\"\"End-to-end API checks against the running server on :8000.\"\"\"\n\nimport json\nimport sys\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://localhost:8000\"\nfailures = []\nchecks = 0\n\n\ndef call(method, path, body=None, token=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(req, data=data, timeout=10) as res:\n            raw = res.read().decode()\n            return res.status, json.loads(raw) if raw else None\n    except urllib.error.HTTPError as exc:\n        raw = exc.read().decode()\n        try:\n            return exc.code, json.loads(raw) if raw else None\n        except json.JSONDecodeError:\n            return exc.code, raw\n    except Exception as exc:  # noqa: BLE001\n        return None, repr(exc)\n\n\ndef check(label, condition, detail=\"\"):\n    global checks\n    checks += 1\n    if condition:\n        return\n    failures.append(f\"{label}: {detail}\")\n\n\n# health + frontend hosting\nstatus, payload = call(\"GET\", \"/api/health\")\ncheck(\"health\", status == 200 and payload == {\"status\": \"ok\"}, f\"{status} {payload}\")\n\n# registration / login\nstatus, payload = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret123\"})\ncheck(\"register 201\", status == 201, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"})\ncheck(\"duplicate register 409\", status == 409, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"empty username 400\", status == 400, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/auth/register\", {\"username\": \"nopass\"})\ncheck(\"missing password 400\", status == 400, f\"{status} {payload}\")\n\nstatus, payload = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"bad login 401\", status == 401, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/auth/login\", {\"username\": \"ghost\", \"password\": \"x\"})\ncheck(\"unknown login 401\", status == 401, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret123\"})\ncheck(\"login 200\", status == 200 and isinstance(payload.get(\"token\"), str), f\"{status} {payload}\")\ntoken_a = payload.get(\"token\", \"\")\n\n# unauthenticated access\nstatus, payload = call(\"GET\", \"/api/sensors\")\ncheck(\"public list\", status == 200 and payload == {\"items\": []}, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/sensors\", {\"name\": \"nope\"})\ncheck(\"create requires auth\", status == 401, f\"{status} {payload}\")\nstatus, payload = call(\"GET\", \"/api/sensors/1\", token=\"bogus-token\")\ncheck(\"bogus token ignored for public GET\", status == 404, f\"{status} {payload}\")\n\n# sensor registration (names deliberately out of order for the sort check)\nsensor_ids = {}\nfor name, unit, location in [\n    (\"gamma\", \"rpm\", \"Roof\"),\n    (\"Alpha\", \"C\", \"Lab\"),\n    (\"beta\", \"%\", \"Cellar\"),\n]:\n    status, payload = call(\n        \"POST\", \"/api/sensors\", {\"name\": name, \"unit\": unit, \"location\": location}, token_a\n    )\n    check(f\"create {name}\", status == 201, f\"{status} {payload}\")\n    sensor_ids[name] = payload.get(\"id\")\n    check(\n        f\"new sensor {name} shape\",\n        payload.get(\"last_value\") is None\n        and payload.get(\"last_updated\") is None\n        and payload.get(\"owner\") == \"alice\"\n        and payload.get(\"unit\") == unit\n        and payload.get(\"location\") == location\n        and isinstance(payload.get(\"id\"), int),\n        f\"{status} {payload}\",\n    )\n\nalpha = sensor_ids[\"Alpha\"]\n\n# list + sorting\nstatus, payload = call(\"GET\", \"/api/sensors\")\nitems = payload.get(\"items\", [])\nnames = [item[\"name\"] for item in items]\ncheck(\"sorted by name\", names == [\"Alpha\", \"beta\", \"gamma\"], f\"{names}\")\ncheck(\n    \"list item shape\",\n    all(\n        set(item) == {\"id\", \"name\", \"unit\", \"location\", \"last_value\", \"last_updated\", \"owner\"}\n        for item in items\n    ),\n    f\"{items}\",\n)\n\n# single sensor\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}\")\ncheck(\"get sensor\", status == 200 and payload[\"name\"] == \"Alpha\", f\"{status} {payload}\")\nstatus, payload = call(\"GET\", \"/api/sensors/999999\")\ncheck(\"missing sensor 404\", status == 404 and \"error\" in payload, f\"{status} {payload}\")\nstatus, payload = call(\"GET\", \"/api/sensors/notanumber\")\ncheck(\"bad sensor id 404\", status == 404, f\"{status} {payload}\")\n\n# readings: auth + ownership\nstatus, payload = call(\"POST\", f\"/api/sensors/{alpha}/readings\", {\"value\": 1})\ncheck(\"reading requires auth\", status == 401, f\"{status} {payload}\")\n\nrecorded = []\nfor value in [21.5, 22, 23.25, 24]:\n    status, payload = call(\n        \"POST\",\n        f\"/api/sensors/{alpha}/readings\",\n        {\"value\": value, \"recorded_at\": \"1999-01-01T00:00:00Z\", \"id\": 12345},\n        token_a,\n    )\n    check(f\"post reading {value}\", status == 201, f\"{status} {payload}\")\n    check(\n        f\"reading shape {value}\",\n        isinstance(payload.get(\"id\"), int)\n        and payload.get(\"sensor_id\") == alpha\n        and payload.get(\"value\") == value\n        and isinstance(payload.get(\"recorded_at\"), str)\n        and payload[\"recorded_at\"] != \"1999-01-01T00:00:00Z\",\n        f\"{status} {payload}\",\n    )\n    recorded.append(payload.get(\"recorded_at\"))\n\nstatus, payload = call(\"POST\", f\"/api/sensors/{alpha}/readings\", {}, token_a)\ncheck(\"missing value 400\", status == 400, f\"{status} {payload}\")\n\nstatus, payload = call(\"POST\", f\"/api/sensors/{alpha}/readings\", {\"value\": \"warm\"}, token_a)\ncheck(\"string value roundtrip\", status == 201 and payload.get(\"value\") == \"warm\", f\"{status} {payload}\")\n\n# sensor latest value updated\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}\")\ncheck(\n    \"sensor latest updated\",\n    payload.get(\"last_value\") == \"warm\" and payload.get(\"last_updated\") is not None,\n    f\"{status} {payload}\",\n)\n\n# readings listing: newest first, total, limit\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}/readings\")\nitems = payload.get(\"items\", [])\ncheck(\"readings total\", payload.get(\"total\") == 5, f\"{status} {payload}\")\ncheck(\"readings count\", len(items) == 5, f\"{len(items)}\")\ncheck(\n    \"newest first\",\n    [r[\"value\"] for r in items] == [\"warm\", 24, 23.25, 22, 21.5],\n    f\"{[r['value'] for r in items]}\",\n)\ncheck(\n    \"timestamps descending\",\n    all(\n        items[i][\"recorded_at\"] >= items[i + 1][\"recorded_at\"]\n        for i in range(len(items) - 1)\n    ),\n    f\"{[r['recorded_at'] for r in items]}\",\n)\ncheck(\n    \"reading item shape\",\n    all(set(r) == {\"id\", \"sensor_id\", \"value\", \"recorded_at\"} for r in items),\n    f\"{items[:1]}\",\n)\n\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}/readings?limit=2\")\ncheck(\n    \"limit param\",\n    len(payload.get(\"items\", [])) == 2\n    and payload.get(\"total\") == 5\n    and payload[\"items\"][0][\"value\"] == \"warm\",\n    f\"{status} {payload}\",\n)\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}/readings?limit=bogus\")\ncheck(\"bad limit 400\", status == 400, f\"{status} {payload}\")\nstatus, payload = call(\"GET\", \"/api/sensors/999999/readings\")\ncheck(\"readings of missing sensor 404\", status == 404, f\"{status} {payload}\")\n\n# second user: cannot touch alice's sensors, public reads still work\nstatus, payload = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"hunter22\"})\ncheck(\"register bob\", status == 201, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"hunter22\"})\ntoken_b = payload.get(\"token\", \"\")\ncheck(\"login bob\", status == 200 and token_b, f\"{status} {payload}\")\n\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}\", token=token_b)\ncheck(\"public sensor read for other user\", status == 200, f\"{status} {payload}\")\nstatus, payload = call(\"POST\", f\"/api/sensors/{alpha}/readings\", {\"value\": 1}, token_b)\ncheck(\"foreign reading forbidden\", status == 403, f\"{status} {payload}\")\nstatus, payload = call(\"DELETE\", f\"/api/sensors/{alpha}\", token=token_b)\ncheck(\"foreign delete forbidden\", status == 403, f\"{status} {payload}\")\nstatus, payload = call(\"DELETE\", f\"/api/sensors/{alpha}\")\ncheck(\"anonymous delete 401\", status == 401, f\"{status} {payload}\")\nstatus, payload = call(\"DELETE\", \"/api/sensors/999999\", token=token_a)\ncheck(\"delete missing 404\", status == 404, f\"{status} {payload}\")\n\n# bob's own sensor posts fine\nstatus, payload = call(\"POST\", \"/api/sensors\", {\"name\": \"delta\"}, token_b)\ncheck(\"bob creates sensor\", status == 201 and payload.get(\"owner\") == \"bob\", f\"{status} {payload}\")\n\n# delete own sensor removes its readings\nstatus, payload = call(\"DELETE\", f\"/api/sensors/{alpha}\", token_a)\ncheck(\"owner delete 200\", status == 200, f\"{status} {payload}\")\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}\")\ncheck(\"deleted sensor gone\", status == 404, f\"{status} {payload}\")\nstatus, payload = call(\"GET\", f\"/api/sensors/{alpha}/readings\")\ncheck(\"deleted readings gone\", status == 404, f\"{status} {payload}\")\nstatus, payload = call(\"GET\", \"/api/sensors\")\ncheck(\n    \"remaining sensors\",\n    [item[\"name\"] for item in payload[\"items\"]] == [\"beta\", \"delta\", \"gamma\"],\n    f\"{payload}\",\n)\n\n# auth edge cases\nstatus, payload = call(\"GET\", \"/api/sensors\", token=\"\")\ncheck(\"empty bearer header 401 on protected\", status == 200, f\"{status}\")\n\nprint(f\"{checks - len(failures)}/{checks} checks passed\")\nfor failure in failures:\n    print(\"FAIL -\", failure)\nsys.exit(1 if failures else 0)\n","filePath":"/workspace/.venv/test_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.venv/test_api.py","exists":false,"truncated":false},"title":".venv/test_api.py","time":{"start":1794374119012,"end":1794374119026}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9082e5e00175QMn3UJwPSZIh","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c907c4da001j6h7xdasCyyG3N"}}
