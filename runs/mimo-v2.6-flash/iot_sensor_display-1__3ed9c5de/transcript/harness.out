{"type":"tool_use","timestamp":1794373514166,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_ed7ddeda28b14fbfa73408dd","state":{"status":"completed","input":{"content":"export type Sensor = {\n  id: number;\n  name: string;\n  unit: string;\n  location: string;\n  last_value: number | string | null;\n  last_updated: string | null;\n  owner: string;\n};\n\nexport type Reading = {\n  id: number;\n  sensor_id: number;\n  value: number | string;\n  recorded_at: string;\n};\n\nexport type Auth = { token: string; username: string };\n\nconst AUTH_KEY = \"sensor-dashboard.auth\";\n\nlet auth: Auth | null = null;\ntry {\n  const raw = localStorage.getItem(AUTH_KEY);\n  if (raw) auth = JSON.parse(raw) as Auth;\n} catch {\n  auth = null;\n}\n\nexport function getAuth(): Auth | null {\n  return auth;\n}\n\nexport function setAuth(next: Auth | null): void {\n  auth = next;\n  try {\n    if (next) localStorage.setItem(AUTH_KEY, JSON.stringify(next));\n    else localStorage.removeItem(AUTH_KEY);\n  } catch {\n    /* storage unavailable: keep in-memory session */\n  }\n}\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\nasync function request<T>(path: string, init: RequestInit = {}): Promise<T> {\n  const headers = new Headers(init.headers);\n  if (init.body && !headers.has(\"Content-Type\")) {\n    headers.set(\"Content-Type\", \"application/json\");\n  }\n  if (auth) headers.set(\"Authorization\", `Bearer ${auth.token}`);\n\n  const res = await fetch(path, { ...init, headers });\n  const text = await res.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n  if (!res.ok) {\n    let message = `Request failed (HTTP ${res.status})`;\n    if (data && typeof data === \"object\" && \"error\" in data) {\n      const reason = (data as { error: unknown }).error;\n      if (typeof reason === \"string\" && reason) message = reason;\n    }\n    throw new ApiError(message, res.status);\n  }\n  return data as T;\n}\n\nfunction post<T>(path: string, payload: unknown): Promise<T> {\n  return request<T>(path, {\n    method: \"POST\",\n    body: JSON.stringify(payload ?? {}),\n  });\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    post<{ id: number; username: string }>(\"/api/auth/register\", {\n      username,\n      password,\n    }),\n\n  login: (username: string, password: string) =>\n    post<{ token: string }>(\"/api/auth/login\", { username, password }),\n\n  getSensors: () => request<{ items: Sensor[] }>(\"/api/sensors\"),\n\n  createSensor: (input: { name: string; unit: string; location: string }) =>\n    post<Sensor>(\"/api/sensors\", input),\n\n  getSensor: (id: number) => request<Sensor>(`/api/sensors/${id}`),\n\n  deleteSensor: (id: number) =>\n    request<{ ok: boolean }>(`/api/sensors/${id}`, { method: \"DELETE\" }),\n\n  getReadings: (id: number, limit?: number) =>\n    request<{ items: Reading[]; total: number }>(\n      `/api/sensors/${id}/readings${limit === undefined ? \"\" : `?limit=${limit}`}`,\n    ),\n\n  createReading: (id: number, value: number | string) =>\n    post<Reading>(`/api/sensors/${id}/readings`, { value }),\n};\n","filePath":"/workspace/frontend/src/lib/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/lib/api.ts","exists":false,"truncated":false},"title":"frontend/src/lib/api.ts","time":{"start":1794373514051,"end":1794373514092}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8fef33d0018LNdGQzfoD0CxE","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c8fecbf7001RN8uBf7oPx3Pft"}}
{"type":"tool_use","timestamp":1794373514166,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_1df5d2f441514322a0be884c","state":{"status":"completed","input":{"content":"export function timeAgo(iso: string | null): string {\n  if (!iso) return \"never\";\n  const then = Date.parse(iso);\n  if (Number.isNaN(then)) return \"unknown\";\n  const seconds = Math.max(0, Math.floor((Date.now() - then) / 1000));\n  if (seconds < 5) return \"just now\";\n  if (seconds < 60) return `${seconds}s ago`;\n  const minutes = Math.floor(seconds / 60);\n  if (minutes < 60) return `${minutes}m ago`;\n  const hours = Math.floor(minutes / 60);\n  if (hours < 24) return `${hours}h ago`;\n  const days = Math.floor(hours / 24);\n  if (days < 30) return `${days}d ago`;\n  return formatDate(iso);\n}\n\nexport function formatDate(iso: string): string {\n  const date = new Date(iso);\n  if (Number.isNaN(date.getTime())) return iso;\n  return date.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\",\n  });\n}\n\nexport function formatClock(iso: string): string {\n  const date = new Date(iso);\n  if (Number.isNaN(date.getTime())) return iso;\n  return date.toLocaleTimeString(undefined, {\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\",\n  });\n}\n","filePath":"/workspace/frontend/src/lib/time.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/lib/time.ts","exists":false,"truncated":false},"title":"frontend/src/lib/time.ts","time":{"start":1794373514059,"end":1794373514098}},"id":"prt_1c8fef3460014WHqhqjdXgM8H4","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c8fecbf7001RN8uBf7oPx3Pft"}}
{"type":"tool_use","timestamp":1794373514166,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_683231541fda42728060310f","state":{"status":"completed","input":{"content":"import { useEffect, useRef, useState } from \"react\";\n\ntype PollState<T> = {\n  data: T | null;\n  error: string | null;\n  loading: boolean;\n  refresh: () => void;\n};\n\nexport function usePoll<T>(\n  load: () => Promise<T>,\n  deps: unknown[],\n  intervalMs = 10000,\n): PollState<T> {\n  const [data, setData] = useState<T | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [tick, setTick] = useState(0);\n  const loadRef = useRef(load);\n  loadRef.current = load;\n\n  useEffect(() => {\n    let alive = true;\n\n    const run = async () => {\n      try {\n        const next = await loadRef.current();\n        if (alive) {\n          setData(next);\n          setError(null);\n        }\n      } catch (err) {\n        if (alive) {\n          setError(err instanceof Error ? err.message : String(err));\n        }\n      } finally {\n        if (alive) setLoading(false);\n      }\n    };\n\n    void run();\n    const timer = window.setInterval(() => void run(), intervalMs);\n    return () => {\n      alive = false;\n      window.clearInterval(timer);\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [...deps, tick, intervalMs]);\n\n  return {\n    data,\n    error,\n    loading,\n    refresh: () => setTick((value) => value + 1),\n  };\n}\n","filePath":"/workspace/frontend/src/hooks/usePoll.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/hooks/usePoll.ts","exists":false,"truncated":false},"title":"frontend/src/hooks/usePoll.ts","time":{"start":1794373514069,"end":1794373514103}},"id":"prt_1c8fef34e001g0x4SXQIwLj9oD","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c8fecbf7001RN8uBf7oPx3Pft"}}
{"type":"tool_use","timestamp":1794373514166,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_2cd2a33305e9404e9e7e291e","state":{"status":"completed","input":{"content":"import type { AnchorMouseEvent, ReactNode } from \"react\";\n\nexport function navigate(to: string): void {\n  window.history.pushState({}, \"\", to);\n  window.dispatchEvent(new PopStateEvent(\"popstate\"));\n}\n\nexport function Link({\n  to,\n  className,\n  children,\n}: {\n  to: string;\n  className?: string;\n  children: ReactNode;\n}) {\n  return (\n    <a\n      href={to}\n      className={className}\n      onClick={(event: AnchorMouseEvent) => {\n        if (\n          event.metaKey ||\n          event.ctrlKey ||\n          event.shiftKey ||\n          event.altKey ||\n          event.button !== 0\n        ) {\n          return;\n        }\n        event.preventDefault();\n        navigate(to);\n      }}\n    >\n      {children}\n    </a>\n  );\n}\n","filePath":"/workspace/frontend/src/lib/router.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/lib/router.tsx","exists":false,"truncated":false},"title":"frontend/src/lib/router.tsx","time":{"start":1794373514079,"end":1794373514108}},"id":"prt_1c8fef359001CwLY7QQ2lWJtR4","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c8fecbf7001RN8uBf7oPx3Pft"}}
