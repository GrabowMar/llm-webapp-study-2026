{"type":"step_start","timestamp":1794373558240,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"id":"prt_1c8ff9fc8001vKbQ9phQptds4S","messageID":"msg_1c8ff63f4001Ut1TX3eZnwXCgq","sessionID":"ses_e37071251ffetjKxIhfb93728N","type":"step-start"}}
{"type":"tool_use","timestamp":1794373558287,"sessionID":"ses_e37071251ffetjKxIhfb93728N","part":{"type":"tool","tool":"write","callID":"call_daa1cdea26bc4310af524d3f","state":{"status":"completed","input":{"content":"import { useState, type FormEvent } from \"react\";\nimport { usePoll } from \"../hooks/usePoll\";\nimport { api, type Auth, type Sensor } from \"../lib/api\";\nimport { Link, navigate } from \"../lib/router\";\nimport { timeAgo } from \"../lib/time\";\nimport AuthForms from \"./AuthForms\";\nimport ReadingForm from \"./ReadingForm\";\n\nfunction RegisterSensorForm({ onDone }: { onDone: () => void }) {\n  const [name, setName] = useState(\"\");\n  const [unit, setUnit] = useState(\"\");\n  const [location, setLocation] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(event: FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setError(null);\n    try {\n      await api.createSensor({\n        name: name.trim(),\n        unit: unit.trim(),\n        location: location.trim(),\n      });\n      setName(\"\");\n      setUnit(\"\");\n      setLocation(\"\");\n      onDone();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : String(err));\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"space-y-3\">\n      <div>\n        <label\n          htmlFor=\"sensor-name\"\n          className=\"mb-1 block text-sm font-medium text-slate-700\"\n        >\n          Name\n        </label>\n        <input\n          id=\"sensor-name\"\n          type=\"text\"\n          value={name}\n          onChange={(event) => setName(event.target.value)}\n          placeholder=\"Living room thermometer\"\n          required\n          className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-200\"\n        />\n      </div>\n      <div className=\"grid grid-cols-2 gap-3\">\n        <div>\n          <label\n            htmlFor=\"sensor-unit\"\n            className=\"mb-1 block text-sm font-medium text-slate-700\"\n          >\n            Unit\n          </label>\n          <input\n            id=\"sensor-unit\"\n            type=\"text\"\n            value={unit}\n            onChange={(event) => setUnit(event.target.value)}\n            placeholder=\"°C\"\n            className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-200\"\n          />\n        </div>\n        <div>\n          <label\n            htmlFor=\"sensor-location\"\n            className=\"mb-1 block text-sm font-medium text-slate-700\"\n          >\n            Location\n          </label>\n          <input\n            id=\"sensor-location\"\n            type=\"text\"\n            value={location}\n            onChange={(event) => setLocation(event.target.value)}\n            placeholder=\"Kitchen\"\n            className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-200\"\n          />\n        </div>\n      </div>\n\n      {error && (\n        <p className=\"rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">\n          {error}</p>\n      )}\n\n      <button\n        type=\"submit\"\n        disabled={busy || name.trim() === \"\"}\n        className=\"w-full rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-60\"\n      >\n        {busy ? \"Registering...\" : \"Register sensor\"}\n      </button>\n    </form>\n  );\n}\n\nfunction SensorCard({\n  sensor,\n  isOwner,\n  onDelete,\n}: {\n  sensor: Sensor;\n  isOwner: boolean;\n  onDelete: (sensor: Sensor) => void;\n}) {\n  return (\n    <article className=\"flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md\">\n      <div className=\"mb-3 flex items-start justify-between gap-3\">\n        <div>\n          <Link\n            to={`/sensors/${sensor.id}`}\n            className=\"text-base font-semibold text-slate-900 hover:text-sky-600\"\n          >\n            {sensor.name}\n          </Link>\n          <p className=\"text-xs text-slate-500\">\n            Owned by {sensor.owner}\n            {sensor.location ? ` · ${sensor.location}` : \"\"}\n          </p>\n        </div>\n        <span className=\"shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600\">\n          {sensor.unit || \"unit n/a\"}\n        </span>\n      </div>\n\n      <div className=\"mb-3 flex items-baseline gap-2\">\n        <span className=\"text-3xl font-bold tracking-tight text-slate-900\">\n          {sensor.last_value ?? \"—\"}\n        </span>\n        {sensor.last_value !== null && sensor.unit && (\n          <span className=\"text-sm font-medium text-slate-500\">\n            {sensor.unit}\n          </span>\n        )}\n      </div>\n\n      <p className=\"text-xs text-slate-500\">\n        {sensor.last_updated\n          ? `Updated ${timeAgo(sensor.last_updated)}`\n          : \"No readings yet\"}\n      </p>\n\n      <div className=\"mt-4 flex items-center justify-between gap-2 border-t border-slate-100 pt-3\">\n        <Link\n          to={`/sensors/${sensor.id}`}\n          className=\"text-sm font-medium text-sky-600 hover:text-sky-700\"\n        >\n          View details →\n        </Link>\n        {isOwner && (\n          <button\n            type=\"button\"\n            onClick={() => onDelete(sensor)}\n            className=\"rounded-lg border border-rose-200 px-3 py-1.5 text-sm font-medium text-rose-600 hover:bg-rose-50\"\n          >\n            Delete\n          </button>\n        )}\n      </div>\n    </article>\n  );\n}\n\nexport default function Dashboard({\n  auth,\n  onAuth,\n}: {\n  auth: Auth | null;\n  onAuth: (auth: Auth) => void;\n}) {\n  const { data, error, refresh } = usePoll(\n    () => api.getSensors(),\n    [auth],\n    10000,\n  );\n  const [actionError, setActionError] = useState<string | null>(null);\n  const sensors = data?.items ?? [];\n  const mine = auth\n    ? sensors.filter(\n        (sensor) => sensor.owner.toLowerCase() === auth.username.toLowerCase(),\n      )\n    : [];\n\n  async function handleDelete(sensor: Sensor) {\n    const confirmed = window.confirm(\n      `Delete sensor \"${sensor.name}\" and all of its readings? This cannot be undone.`,\n    );\n    if (!confirmed) return;\n    setActionError(null);\n    try {\n      await api.deleteSensor(sensor.id);\n      refresh();\n    } catch (err) {\n      setActionError(err instanceof Error ? err.message : String(err));\n    }\n  }\n\n  return (\n    <div className=\"space-y-8\">\n      {auth ? (\n        <div className=\"grid gap-4 lg:grid-cols-2\">\n          <section className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\">\n            <h2 className=\"mb-4 text-lg font-semibold text-slate-900\">\n              Register a sensor\n            </h2>\n            <RegisterSensorForm onDone={refresh} />\n          </section>\n          <section className=\"rounded-xl border border-slate-200 bg-white p-5 shadow-sm\">\n            <h2 className=\"mb-4 text-lg font-semibold text-slate-900\">\n              Post a reading\n            </h2>\n            <ReadingForm sensors={mine} onDone={refresh} />\n          </section>\n        </div>\n      ) : (\n        <div className=\"grid gap-4 lg:grid-cols-2\">\n          <AuthForms onAuth={onAuth} />\n          <section className=\"rounded-xl border border-slate-200 bg-slate-50 p-5\">\n            <h2 className=\"mb-2 text-lg font-semibold text-slate-900\">\n              Watch live sensor data\n            </h2>\n            <p className=\"text-sm text-slate-600\">\n              Anyone can browse the sensors below and their recent history.\n              Create an account to register your own sensors and post readings\n              to them.\n            </p>\n          </section>\n        </div>\n      )}\n\n      <div>\n        <div className=\"mb-4 flex items-center justify-between gap-3\">\n          <h2 className=\"text-lg font-semibold text-slate-900\">Sensors</h2>\n          <span className=\"text-xs text-slate-500\">\n            Auto-refreshes every 10 seconds\n          </span>\n        </div>\n\n        {actionError && (\n          <p className=\"mb-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">\n            {actionError}\n          </p>\n        )}\n        {error && (\n          <p className=\"mb-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">\n            {error}\n          </p>\n        )}\n\n        {!data && !error ? (\n          <p className=\"text-sm text-slate-500\">Loading sensors…</p>\n        ) : sensors.length === 0 ? (\n          <div className=\"rounded-xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500\">\n            No sensors registered yet.\n            {auth && \" Use the form above to register the first one.\"}\n          </div>\n        ) : (\n          <div className=\"grid gap-4 sm:grid-cols-2 xl:grid-cols-3\">\n            {sensors.map((sensor) => (\n              <SensorCard\n                key={sensor.id}\n                sensor={sensor}\n                isOwner={\n                  auth !== null &&\n                  sensor.owner.toLowerCase() === auth.username.toLowerCase()\n                }\n                onDelete={handleDelete}\n              />\n            ))}\n          </div>\n        )}\n      </div>\n\n      {auth && sensors.length > 0 && (\n        <button\n          type=\"button\"\n          onClick={() => navigate(`/sensors/${sensors[0].id}`)}\n          className=\"hidden\"\n        >\n          hidden\n        </button>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/Dashboard.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Dashboard.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Dashboard.tsx","time":{"start":1794373558230,"end":1794373558244}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8ff9fcf001ilGwVOsvKqJ125","sessionID":"ses_e37071251ffetjKxIhfb93728N","messageID":"msg_1c8ff63f4001Ut1TX3eZnwXCgq"}}
