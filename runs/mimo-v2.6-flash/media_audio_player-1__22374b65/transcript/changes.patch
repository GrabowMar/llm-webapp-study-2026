+import { useState, type FormEvent } from "react";
+import { api, ApiError, saveSession } from "../api";
+
+interface Props {
+  onSignedIn: (token: string, username: string) => void;
+}
+
+const inputClass =
+  "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 placeholder-slate-500 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40";
+const buttonClass =
+  "w-full rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-400 disabled:cursor-not-allowed disabled:opacity-50";
+
+export default function AuthPanel({ onSignedIn }: Props) {
+  const [regUser, setRegUser] = useState("");
+  const [regPass, setRegPass] = useState("");
+  const [regError, setRegError] = useState<string | null>(null);
+  const [regDone, setRegDone] = useState<string | null>(null);
+  const [regBusy, setRegBusy] = useState(false);
+
+  const [logUser, setLogUser] = useState("");
+  const [logPass, setLogPass] = useState("");
+  const [logError, setLogError] = useState<string | null>(null);
+  const [logBusy, setLogBusy] = useState(false);
+
+  async function handleRegister(event: FormEvent) {
+    event.preventDefault();
+    setRegError(null);
+    setRegDone(null);
+    setRegBusy(true);
+    try {
+      await api.register(regUser.trim(), regPass);
+      setRegDone("Account created. You can sign in now.");
+      setRegPass("");
+    } catch (err) {
+      setRegError(err instanceof ApiError ? err.message : "Registration failed.");
+    } finally {
+      setRegBusy(false);
+    }
+  }
+
+  async function handleLogin(event: FormEvent) {
+    event.preventDefault();
+    setLogError(null);
+    setLogBusy(true);
+    try {
+      const result = await api.login(logUser.trim(), logPass);
+      saveSession(result.token, logUser.trim());
+      onSignedIn(result.token, logUser.trim());
+    } catch (err) {
+      setLogError(err instanceof ApiError ? err.message : "Sign in failed.");
+    } finally {
+      setLogBusy(false);
+    }
+  }
+
+  return (
+    <div className="grid gap-4 md:grid-cols-2">
+      <section className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
+        <h2 className="mb-4 text-lg font-semibold text-slate-100">Create account</h2>
+        <form onSubmit={handleRegister} className="space-y-3">
+          <div>
+            <label className="mb-1 block text-xs font-medium text-slate-400" htmlFor="reg-username">
+              Username
+            </label>
+            <input
+              id="reg-username"
+              className={inputClass}
+              value={regUser}
+              onChange={(e) => setRegUser(e.target.value)}
+              autoComplete="username"
+              required
+            />
+          </div>
+          <div>
+            <label className="mb-1 block text-xs font-medium text-slate-400" htmlFor="reg-password">
+              Password
+            </label>
+            <input
+              id="reg-password"
+              type="password"
+              className={inputClass}
+              value={regPass}
+              onChange={(e) => setRegPass(e.target.value)}
+              autoComplete="new-password"
+              required
+            />
+          </div>
+          {regError && (
+            <p className="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-300">
+              {regError}
+            </p>
+          )}
+          {regDone && (
+            <p className="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-300">
+              {regDone}
+            </p>
+          )}
+          <button type="submit" className={buttonClass} disabled={regBusy}>
+            {regBusy ? "Creating…" : "Register"}
+          </button>
+        </form>
+      </section>
+
+      <section className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
+        <h2 className="mb-4 text-lg font-semibold text-slate-100">Sign in</h2>
+        <form onSubmit={handleLogin} className="space-y-3">
+          <div>
+            <label className="mb-1 block text-xs font-medium text-slate-400" htmlFor="log-username">
+              Username
+            </label>
+            <input
+              id="log-username"
+              className={inputClass}
+              value={logUser}
+              onChange={(e) => setLogUser(e.target.value)}
+              autoComplete="username"
+              required
+            />
+          </div>
+          <div>
+            <label className="mb-1 block text-xs font-medium text-slate-400" htmlFor="log-password">
+              Password
+            </label>
+            <input
+              id="log-password"
+              type="password"
+              className={inputClass}
+              value={logPass}
+              onChange={(e) => setLogPass(e.target.value)}
+              autoComplete="current-password"
+              required
+            />
+          </div>
+          {logError && (
+            <p className="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-300">
+              {logError}
+            </p>
+          )}
+          <button type="submit" className={buttonClass} disabled={logBusy}>
+            {logBusy ? "Signing in…" : "Sign in"}
+          </button>
+        </form>
+      </section>
+    </div>
+  );
+}
diff --git a/frontend/src/components/PlayerBar.tsx b/frontend/src/components/PlayerBar.tsx
new file mode 100644
index 0000000..a7633fd
--- /dev/null
+++ b/frontend/src/components/PlayerBar.tsx
@@ -0,0 +1,122 @@
+import { formatDuration } from "../format";
+import type { Track } from "../types";
+
+interface Props {
+  track: Track | null;
+  isPlaying: boolean;
+  currentTime: number;
+  duration: number;
+  volume: number;
+  error: string | null;
+  onToggle: () => void;
+  onPrevious: () => void;
+  onNext: () => void;
+  onSeek: (seconds: number) => void;
+  onVolume: (value: number) => void;
+}
+
+export default function PlayerBar({
+  track,
+  isPlaying,
+  currentTime,
+  duration,
+  volume,
+  error,
+  onToggle,
+  onPrevious,
+  onNext,
+  onSeek,
+  onVolume,
+}: Props) {
+  const max = duration > 0 ? duration : 0;
+  const canControl = track !== null;
+
+  return (
+    <div className="fixed inset-x-0 bottom-0 z-30 border-t border-slate-800 bg-slate-950/95 backdrop-blur">
+      {error && (
+        <p className="border-t border-red-500/30 bg-red-500/10 px-4 py-1 text-center text-xs text-red-300">
+          {error}
+        </p>
+      )}
+      <div className="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
+        <div className="min-w-0 w-40 sm:w-56">
+          <p className="truncate text-sm font-medium text-slate-100">
+            {track ? track.title : "Nothing playing"}
+          </p>
+          <p className="truncate text-xs text-slate-400">
+            {track ? track.artist || "Unknown artist" : "Pick a track to start listening"}
+          </p>
+        </div>
+
+        <div className="flex items-center gap-2">
+          <button
+            type="button"
+            onClick={onPrevious}
+            disabled={!canControl}
+            aria-label="Previous track"
+            title="Previous"
+            className="flex h-9 w-9 items-center justify-center rounded-full text-slate-300 transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            ⏮
+          </button>
+          <button
+            type="button"
+            onClick={onToggle}
+            disabled={!canControl}
+            aria-label={isPlaying ? "Pause" : "Play"}
+            title={isPlaying ? "Pause" : "Play"}
+            className="flex h-11 w-11 items-center justify-center rounded-full bg-indigo-500 text-base text-white transition hover:bg-indigo-400 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            {isPlaying ? "❚❚" : "▶"}
+          </button>
+          <button
+            type="button"
+            onClick={onNext}
+            disabled={!canControl}
+            aria-label="Next track"
+            title="Next"
+            className="flex h-9 w-9 items-center justify-center rounded-full text-slate-300 transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            ⏭
+          </button>
+        </div>
+
+        <div className="flex min-w-52 flex-1 items-center gap-3">
+          <span className="w-11 shrink-0 text-right text-xs tabular-nums text-slate-400">
+            {formatDuration(currentTime)}
+          </span>
+          <input
+            type="range"
+            min={0}
+            max={max > 0 ? max : 1}
+            step={0.1}
+            value={Math.min(currentTime, max > 0 ? max : 1)}
+            onChange={(e) => onSeek(Number(e.target.value))}
+            disabled={!canControl || max <= 0}
+            aria-label="Seek"
+            className="h-1.5 w-full cursor-pointer appearance-none rounded-full bg-slate-700 accent-indigo-500 disabled:cursor-not-allowed disabled:opacity-40"
+          />
+          <span className="w-11 shrink-0 text-xs tabular-nums text-slate-400">
+            {formatDuration(max)}
+          </span>
+        </div>
+
+        <div className="flex w-36 items-center gap-2">
+          <span aria-hidden className="text-sm text-slate-400">
+            {volume === 0 ? "🔇" : "🔊"}
+          </span>
+          <input
+            type="range"
+            min={0}
+            max={1}
+            step={0.01}
+            value={volume}
+            onChange={(e) => onVolume(Number(e.target.value))}
+            aria-label="Volume"
+            className="h-1.5 w-full cursor-pointer appearance-none rounded-full bg-slate-700 accent-indigo-500"
+          />
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/TrackList.tsx b/frontend/src/components/TrackList.tsx
new file mode 100644
index 0000000..67f6ec3
--- /dev/null
+++ b/frontend/src/components/TrackList.tsx
@@ -0,0 +1,114 @@
+import { formatDate, formatDuration } from "../format";
+import type { Track } from "../types";
+
+interface Props {
+  tracks: Track[];
+  username: string | null;
+  currentId: number | null;
+  isPlaying: boolean;
+  loading: boolean;
+  error: string | null;
+  onPlay: (track: Track) => void;
+  onDelete: (track: Track) => void;
+}
+
+export default function TrackList({
+  tracks,
+  username,
+  currentId,
+  isPlaying,
+  loading,
+  error,
+  onPlay,
+  onDelete,
+}: Props) {
+  if (loading) {
+    return (
+      <div className="rounded-2xl border border-slate-800 bg-slate-900/60 p-10 text-center text-sm text-slate-400">
+        Loading tracks…
+      </div>
+    );
+  }
+
+  if (error) {
+    return (
+      <div className="rounded-2xl border border-red-500/40 bg-red-500/10 p-6 text-center text-sm text-red-300">
+        {error}
+      </div>
+    );
+  }
+
+  if (tracks.length === 0) {
+    return (
+      <div className="rounded-2xl border border-dashed border-slate-700 bg-slate-900/40 p-10 text-center text-sm text-slate-400">
+        No tracks found.
+      </div>
+    );
+  }
+
+  return (
+    <div className="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60">
+      <ul className="divide-y divide-slate-800">
+        {tracks.map((track) => {
+          const isCurrent = currentId === track.id;
+          const owns =
+            username !== null &&
+            track.added_by.toLowerCase() === username.trim().toLowerCase();
+          return (
+            <li
+              key={track.id}
+              className={`flex flex-wrap items-center gap-3 px-4 py-3 transition ${
+                isCurrent ? "bg-indigo-500/10" : "hover:bg-slate-800/50"
+              }`}
+            >
+              <button
+                type="button"
+                onClick={() => onPlay(track)}
+                aria-label={isCurrent && isPlaying ? `Pause ${track.title}` : `Play ${track.title}`}
+                title={isCurrent && isPlaying ? "Pause" : "Play"}
+                className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm transition ${
+                  isCurrent
+                    ? "bg-indigo-500 text-white hover:bg-indigo-400"
+                    : "bg-slate-800 text-slate-200 hover:bg-slate-700"
+                }`}
+              >
+                {isCurrent && isPlaying ? "❚❚" : "▶"}
+              </button>
+
+              <div className="min-w-0 flex-1">
+                <p
+                  className={`truncate text-sm font-medium ${
+                    isCurrent ? "text-indigo-300" : "text-slate-100"
+                  }`}
+                >
+                  {track.title}
+                </p>
+                <p className="truncate text-xs text-slate-400">
+                  {track.artist || "Unknown artist"} · added by {track.added_by} ·{" "}
+                  {formatDate(track.created_at)}
+                </p>
+              </div>
+
+              <span className="w-16 shrink-0 text-right text-sm tabular-nums text-slate-300">
+                {formatDuration(track.duration)}
+              </span>
+              <span className="w-20 shrink-0 text-right text-xs tabular-nums text-slate-400">
+                {track.play_count} {track.play_count === 1 ? "play" : "plays"}
+              </span>
+
+              {owns && (
+                <button
+                  type="button"
+                  onClick={() => onDelete(track)}
+                  className="shrink-0 rounded-lg border border-red-500/40 px-3 py-1.5 text-xs font-medium text-red-300 transition hover:bg-red-500/15"
+                >
+                  Delete
+                </button>
+              )}
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
diff --git a/frontend/src/format.ts b/frontend/src/format.ts
new file mode 100644
index 0000000..c519b9f
--- /dev/null
+++ b/frontend/src/format.ts
@@ -0,0 +1,24 @@
+export function formatDuration(seconds: number | null | undefined): string {
+  if (seconds === null || seconds === undefined || !Number.isFinite(seconds) || seconds < 0) {
+    return "–";
+  }
+  const total = Math.floor(seconds);
+  const hours = Math.floor(total / 3600);
+  const minutes = Math.floor((total % 3600) / 60);
+  const secs = total % 60;
+  const padded = (n: number) => String(n).padStart(2, "0");
+  if (hours > 0) {
+    return `${hours}:${padded(minutes)}:${padded(secs)}`;
+  }
+  return `${minutes}:${padded(secs)}`;
+}
+
+export function formatDate(iso: string): string {
+  const date = new Date(iso);
+  if (Number.isNaN(date.getTime())) return iso;
+  return date.toLocaleDateString(undefined, {
+    year: "numeric",
+    month: "short",
+    day: "numeric",
+  });
+}
