{"type":"tool_use","timestamp":1794377042377,"sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","part":{"type":"tool","tool":"read","callID":"call_8203e6033e514ae7acfc68a1","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import re\n6: import secrets\n7: import sqlite3\n8: from pathlib import Path\n9: from urllib.parse import urlsplit\n10: \n11: from flask import Flask, jsonify, request, send_from_directory\n12: from werkzeug.security import check_password_hash, generate_password_hash\n13: \n14: import db\n15: from db import get_db, utcnow\n16: \n17: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n18: \n19: DEFAULT_PAGE_SIZE = 20\n20: MAX_PAGE_SIZE = 1000\n21: \n22: app = Flask(__name__, static_folder=None)\n23: app.teardown_appcontext(db.close_db)\n24: \n25: USERNAME_RE = re.compile(r\"^[A-Za-z0-9_.\\-]{1,64}$\")\n26: \n27: \n28: # ---------------------------------------------------------------- helpers\n29: \n30: \n31: def error(message: str, status: int):\n32:     return jsonify({\"error\": message, \"message\": message}), status\n33: \n34: \n35: def body() -> dict:\n36:     data = request.get_json(silent=True)\n37:     if data is None or not isinstance(data, dict):\n38:         return {}\n39:     return data\n40: \n41: \n42: def text_field(data: dict, key: str) -> str:\n43:     value = data.get(key)\n44:     if not isinstance(value, str):\n45:         return \"\"\n46:     return value.strip()\n47: \n48: \n49: def current_user():\n50:     \"\"\"Return the signed-in user row for the request, or None.\"\"\"\n51:     header = request.headers.get(\"Authorization\", \"\")\n52:     if not header:\n53:         return None\n54:     scheme, _, token = header.partition(\" \")\n55:     if scheme.lower() != \"bearer\":\n56:         return None\n57:     token = token.strip()\n58:     if not token:\n59:         return None\n60:     row = get_db().execute(\n61:         \"SELECT u.id, u.username FROM tokens t\"\n62:         \" JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n63:         (token,),\n64:     ).fetchone()\n65:     return row\n66: \n67: \n68: def serialize_track(row) -> dict:\n69:     duration = row[\"duration\"]\n70:     if isinstance(duration, float) and duration.is_integer():\n71:         duration = int(duration)\n72:     return {\n73:         \"id\": row[\"id\"],\n74:         \"title\": row[\"title\"],\n75:         \"artist\": row[\"artist\"],\n76:         \"url\": row[\"url\"],\n77:         \"duration\": duration,\n78:         \"play_count\": row[\"play_count\"],\n79:         \"created_at\": row[\"created_at\"],\n80:         \"added_by\": row[\"username\"],\n81:     }\n82: \n83: \n84: def valid_audio_url(value: str) -> bool:\n85:     try:\n86:         parts = urlsplit(value)\n87:     except ValueError:\n88:         return False\n89:     if parts.scheme not in (\"http\", \"https\"):\n90:         return False\n91:     if not parts.netloc or \" \" in value:\n92:         return False\n93:     return True\n94: \n95: \n96: def parse_duration(value) -> float | None:\n97:     \"\"\"Accept seconds (int/float/numeric string) or an ``m:ss`` string.\"\"\"\n98:     if value is None or value == \"\":\n99:         return 0.0\n100:     if isinstance(value, bool):\n101:         return None\n102:     if isinstance(value, (int, float)):\n103:         seconds = float(value)\n104:     elif isinstance(value, str):\n105:         raw = value.strip()\n106:         if re.fullmatch(r\"\\d+(\\.\\d+)?\", raw):\n107:             seconds = float(raw)\n108:         elif re.fullmatch(r\"\\d+:\\d{1,2}(:\\d{1,2})?\", raw):\n109:             parts = [int(part) for part in raw.split(\":\")]\n110:             seconds = 0.0\n111:             for part in parts:\n112:                 seconds = seconds * 60 + part\n113:         else:\n114:             return None\n115:     else:\n116:         return None\n117:     if seconds < 0 or seconds != seconds or seconds == float(\"inf\"):\n118:         return None\n119:     return seconds\n120: \n121: \n122: # ---------------------------------------------------------------- accounts\n123: \n124: \n125: @app.post(\"/api/auth/register\")\n126: def register():\n127:     data = body()\n128:     username = text_field(data, \"username\")\n129:     password = text_field(data, \"password\")\n130:     if not username:\n131:         return error(\"Username is required.\", 400)\n132:     if not password:\n133:         return error(\"Password is required.\", 400)\n134:     if len(password) > 200:\n135:         return error(\"Password is too long.\", 400)\n136: \n137:     conn = get_db()\n138:     existing = conn.execute(\n139:         \"SELECT id FROM users WHERE username = ?\", (username,)\n140:     ).fetchone()\n141:     if existing is not None:\n142:         return error(\"Username is already taken.\", 409)\n143:     try:\n144:         cursor = conn.execute(\n145:             \"INSERT INTO users (username, password_hash, created_at)\"\n146:             \" VALUES (?, ?, ?)\",\n147:             (username, generate_password_hash(password), utcnow()),\n148:         )\n149:     except sqlite3.IntegrityError:\n150:         return error(\"Username is already taken.\", 409)\n151:     conn.commit()\n152:     return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n153: \n154: \n155: @app.post(\"/api/auth/login\")\n156: def login():\n157:     data = body()\n158:     username = text_field(data, \"username\")\n159:     password = text_field(data, \"password\")\n160:     if not username or not password:\n161:         return error(\"Username and password are required.\", 400)\n162: \n163:     conn = get_db()\n164:     user = conn.execute(\n165:         \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n166:         (username,),\n167:     ).fetchone()\n168:     if user is None or not check_password_hash(user[\"password_hash\"], password):\n169:         return error(\"Invalid username or password.\", 401)\n170: \n171:     token = secrets.token_urlsafe(32)\n172:     conn.execute(\n173:         \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n174:         (token, user[\"id\"], utcnow()),\n175:     )\n176:     conn.commit()\n177:     return jsonify({\"token\": token}), 200\n178: \n179: \n180: @app.post(\"/api/auth/logout\")\n181: def logout():\n182:     header = request.headers.get(\"Authorization\", \"\")\n183:     scheme, _, token = header.partition(\" \")\n184:     if scheme.lower() == \"bearer\" and token.strip():\n185:         conn = get_db()\n186:         conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token.strip(),))\n187:         conn.commit()\n188:     return jsonify({\"ok\": True}), 200\n189: \n190: \n191: # ---------------------------------------------------------------- tracks\n192: \n193: \n194: @app.get(\"/api/tracks\")\n195: def list_tracks():\n196:     raw_q = request.args.get(\"q\", \"\")\n197:     q = raw_q.strip() if isinstance(raw_q, str) else \"\"\n198: \n199:     raw_page = request.args.get(\"page\", \"1\")\n200:     raw_size = request.args.get(\"page_size\", str(DEFAULT_PAGE_SIZE))\n201:     try:\n202:         page = int(raw_page)\n203:         page_size = int(raw_size)\n204:     except (TypeError, ValueError):\n205:         return error(\"page and page_size must be integers.\", 400)\n206:     if page < 1:\n207:         page = 1\n208:     if page_size < 1:\n209:         page_size = 1\n210:     page_size = min(page_size, MAX_PAGE_SIZE)\n211: \n212:     where = \"\"\n213:     params: list = []\n214:     if q:\n215:         pattern = \"%\" + q.lower().replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n216:         where = (\n217:             \" WHERE LOWER(t.title) LIKE ? ESCAPE '\\\\'\"\n218:             \" OR LOWER(t.artist) LIKE ? ESCAPE '\\\\'\"\n219:             \" OR LOWER(u.username) LIKE ? ESCAPE '\\\\'\"\n220:         )\n221:         params = [pattern, pattern, pattern]\n222: \n223:     conn = get_db()\n224:     total = conn.execute(\n225:         \"SELECT COUNT(*) AS n FROM tracks t\"\n226:         \" JOIN users u ON u.id = t.user_id\" + where,\n227:         params,\n228:     ).fetchone()[\"n\"]\n229:     rows = conn.execute(\n230:         \"SELECT t.*, u.username FROM tracks t\"\n231:         \" JOIN users u ON u.id = t.user_id\"\n232:         + where\n233:         + \" ORDER BY t.created_at DESC, t.id DESC LIMIT ? OFFSET ?\",\n234:         [*params, page_size, (page - 1) * page_size],\n235:     ).fetchall()\n236:     return jsonify(\n237:         {\n238:             \"items\": [serialize_track(row) for row in rows],\n239:             \"total\": total,\n240:             \"page\": page,\n241:             \"page_size\": page_size,\n242:         }\n243:     ), 200\n244: \n245: \n246: @app.post(\"/api/tracks\")\n247: def create_track():\n248:     user = current_user()\n249:     if user is None:\n250:         return error(\"Authentication required.\", 401)\n251: \n252:     data = body()\n253:     title = text_field(data, \"title\")\n254:     artist = text_field(data, \"artist\")\n255:     url = text_field(data, \"url\")\n256: \n257:     if not title:\n258:         return error(\"Title is required.\", 400)\n259:     if len(title) > 300:\n260:         return error(\"Title is too long.\", 400)\n261:     if len(artist) > 300:\n262:         return error(\"Artist is too long.\", 400)\n263:     if not url:\n264:         return error(\"URL is required.\", 400)\n265:     if not valid_audio_url(url):\n266:         return error(\"Only http and https audio URLs are allowed.\", 400)\n267: \n268:     duration = parse_duration(data.get(\"duration\"))\n269:     if duration is None:\n270:         return error(\"Duration must be a non-negative number of seconds.\", 400)\n271: \n272:     conn = get_db()\n273:     cursor = conn.execute(\n274:         \"INSERT INTO tracks (user_id, title, artist, url, duration, play_count, created_at)\"\n275:         \" VALUES (?, ?, ?, ?, ?, 0, ?)\",\n276:         (user[\"id\"], title, artist, url, duration, utcnow()),\n277:     )\n278:     conn.commit()\n279:     row = conn.execute(\n280:         \"SELECT t.*, u.username FROM tracks t\"\n281:         \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n282:         (cursor.lastrowid,),\n283:     ).fetchone()\n284:     return jsonify(serialize_track(row)), 201\n285: \n286: \n287: @app.get(\"/api/tracks/<int:track_id>\")\n288: def get_track(track_id: int):\n289:     row = get_db().execute(\n290:         \"SELECT t.*, u.username FROM tracks t\"\n291:         \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n292:         (track_id,),\n293:     ).fetchone()\n294:     if row is None:\n295:         return error(\"Track not found.\", 404)\n296:     return jsonify(serialize_track(row)), 200\n297: \n298: \n299: @app.delete(\"/api/tracks/<int:track_id>\")\n300: def delete_track(track_id: int):\n301:     user = current_user()\n302:     if user is None:\n303:         return error(\"Authentication required.\", 401)\n304: \n305:     conn = get_db()\n306:     row = conn.execute(\n307:         \"SELECT t.*, u.username FROM tracks t\"\n308:         \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n309:         (track_id,),\n310:     ).fetchone()\n311:     if row is None:\n312:         return error(\"Track not found.\", 404)\n313:     if row[\"user_id\"] != user[\"id\"]:\n314:         return error(\"You can only delete your own tracks.\", 403)\n315:     conn.execute(\"DELETE FROM tracks WHERE id = ?\", (track_id,))\n316:     conn.commit()\n317:     return jsonify({\"ok\": True, \"id\": track_id}), 200\n318: \n319: \n320: @app.post(\"/api/tracks/<int:track_id>/plays\")\n321: def add_play(track_id: int):\n322:     conn = get_db()\n323:     row = conn.execute(\n324:         \"SELECT t.*, u.username FROM tracks t\"\n325:         \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n326:         (track_id,),\n327:     ).fetchone()\n328:     if row is None:\n329:         return error(\"Track not found.\", 404)\n330:     conn.execute(\n331:         \"UPDATE tracks SET play_count = play_count + 1 WHERE id = ?\", (track_id,)\n332:     )\n333:     conn.commit()\n334:     row = conn.execute(\n335:         \"SELECT t.*, u.username FROM tracks t\"\n336:         \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n337:         (track_id,),\n338:     ).fetchone()\n339:     return jsonify(serialize_track(row)), 200\n340: \n341: \n342: @app.get(\"/api/health\")\n343: def health():\n344:     return {\"status\": \"ok\"}\n345: \n346: \n347: # ---------------------------------------------------------------- frontend\n348: \n349: \n350: @app.get(\"/\")\n351: @app.get(\"/<path:path>\")\n352: def frontend(path: str = \"index.html\"):\n353:     if path.startswith(\"api/\"):\n354:         return error(\"Not found.\", 404)\n355:     if path != \"index.html\" and (DIST / path).is_file():\n356:         return send_from_directory(DIST, path)\n357:     index = DIST / \"index.html\"\n358:     if index.is_file():\n359:         return send_from_directory(DIST, \"index.html\")\n360:     return error(\"Frontend build not found.\", 404)\n361: \n362: \n363: db.init_db()\n\n(End of file - total 363 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport secrets\nimport sqlite3\nfrom pathlib import Path\nfrom urllib.parse import urlsplit\n\nfrom flask import Flask, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nimport db\nfrom db import get_db, utcnow\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 1000","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport secrets\nimport sqlite3\nfrom pathlib import Path\nfrom urllib.parse import urlsplit\n\nfrom flask import Flask, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nimport db\nfrom db import get_db, utcnow\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 1000\n\napp = Flask(__name__, static_folder=None)\napp.teardown_appcontext(db.close_db)\n\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.\\-]{1,64}$\")\n\n\n# ---------------------------------------------------------------- helpers\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\ndef body() -> dict:\n    data = request.get_json(silent=True)\n    if data is None or not isinstance(data, dict):\n        return {}\n    return data\n\n\ndef text_field(data: dict, key: str) -> str:\n    value = data.get(key)\n    if not isinstance(value, str):\n        return \"\"\n    return value.strip()\n\n\ndef current_user():\n    \"\"\"Return the signed-in user row for the request, or None.\"\"\"\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header:\n        return None\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\":\n        return None\n    token = token.strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef serialize_track(row) -> dict:\n    duration = row[\"duration\"]\n    if isinstance(duration, float) and duration.is_integer():\n        duration = int(duration)\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"artist\": row[\"artist\"],\n        \"url\": row[\"url\"],\n        \"duration\": duration,\n        \"play_count\": row[\"play_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"added_by\": row[\"username\"],\n    }\n\n\ndef valid_audio_url(value: str) -> bool:\n    try:\n        parts = urlsplit(value)\n    except ValueError:\n        return False\n    if parts.scheme not in (\"http\", \"https\"):\n        return False\n    if not parts.netloc or \" \" in value:\n        return False\n    return True\n\n\ndef parse_duration(value) -> float | None:\n    \"\"\"Accept seconds (int/float/numeric string) or an ``m:ss`` string.\"\"\"\n    if value is None or value == \"\":\n        return 0.0\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, (int, float)):\n        seconds = float(value)\n    elif isinstance(value, str):\n        raw = value.strip()\n        if re.fullmatch(r\"\\d+(\\.\\d+)?\", raw):\n            seconds = float(raw)\n        elif re.fullmatch(r\"\\d+:\\d{1,2}(:\\d{1,2})?\", raw):\n            parts = [int(part) for part in raw.split(\":\")]\n            seconds = 0.0\n            for part in parts:\n                seconds = seconds * 60 + part\n        else:\n            return None\n    else:\n        return None\n    if seconds < 0 or seconds != seconds or seconds == float(\"inf\"):\n        return None\n    return seconds\n\n\n# ---------------------------------------------------------------- accounts\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = text_field(data, \"username\")\n    password = text_field(data, \"password\")\n    if not username:\n        return error(\"Username is required.\", 400)\n    if not password:\n        return error(\"Password is required.\", 400)\n    if len(password) > 200:\n        return error(\"Password is too long.\", 400)\n\n    conn = get_db()\n    existing = conn.execute(\n        \"SELECT id FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return error(\"Username is already taken.\", 409)\n    try:\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at)\"\n            \" VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utcnow()),\n        )\n    except sqlite3.IntegrityError:\n        return error(\"Username is already taken.\", 409)\n    conn.commit()\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = text_field(data, \"username\")\n    password = text_field(data, \"password\")\n    if not username or not password:\n        return error(\"Username and password are required.\", 400)\n\n    conn = get_db()\n    user = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return error(\"Invalid username or password.\", 401)\n\n    token = secrets.token_urlsafe(32)\n    conn.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], utcnow()),\n    )\n    conn.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() == \"bearer\" and token.strip():\n        conn = get_db()\n        conn.execute(\"DELETE FROM tokens WHERE token = ?\", (token.strip(),))\n        conn.commit()\n    return jsonify({\"ok\": True}), 200\n\n\n# ---------------------------------------------------------------- tracks\n\n\n@app.get(\"/api/tracks\")\ndef list_tracks():\n    raw_q = request.args.get(\"q\", \"\")\n    q = raw_q.strip() if isinstance(raw_q, str) else \"\"\n\n    raw_page = request.args.get(\"page\", \"1\")\n    raw_size = request.args.get(\"page_size\", str(DEFAULT_PAGE_SIZE))\n    try:\n        page = int(raw_page)\n        page_size = int(raw_size)\n    except (TypeError, ValueError):\n        return error(\"page and page_size must be integers.\", 400)\n    if page < 1:\n        page = 1\n    if page_size < 1:\n        page_size = 1\n    page_size = min(page_size, MAX_PAGE_SIZE)\n\n    where = \"\"\n    params: list = []\n    if q:\n        pattern = \"%\" + q.lower().replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n        where = (\n            \" WHERE LOWER(t.title) LIKE ? ESCAPE '\\\\'\"\n            \" OR LOWER(t.artist) LIKE ? ESCAPE '\\\\'\"\n            \" OR LOWER(u.username) LIKE ? ESCAPE '\\\\'\"\n        )\n        params = [pattern, pattern, pattern]\n\n    conn = get_db()\n    total = conn.execute(\n        \"SELECT COUNT(*) AS n FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id\" + where,\n        params,\n    ).fetchone()[\"n\"]\n    rows = conn.execute(\n        \"SELECT t.*, u.username FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id\"\n        + where\n        + \" ORDER BY t.created_at DESC, t.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_track(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    ), 200\n\n\n@app.post(\"/api/tracks\")\ndef create_track():\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n\n    data = body()\n    title = text_field(data, \"title\")\n    artist = text_field(data, \"artist\")\n    url = text_field(data, \"url\")\n\n    if not title:\n        return error(\"Title is required.\", 400)\n    if len(title) > 300:\n        return error(\"Title is too long.\", 400)\n    if len(artist) > 300:\n        return error(\"Artist is too long.\", 400)\n    if not url:\n        return error(\"URL is required.\", 400)\n    if not valid_audio_url(url):\n        return error(\"Only http and https audio URLs are allowed.\", 400)\n\n    duration = parse_duration(data.get(\"duration\"))\n    if duration is None:\n        return error(\"Duration must be a non-negative number of seconds.\", 400)\n\n    conn = get_db()\n    cursor = conn.execute(\n        \"INSERT INTO tracks (user_id, title, artist, url, duration, play_count, created_at)\"\n        \" VALUES (?, ?, ?, ?, ?, 0, ?)\",\n        (user[\"id\"], title, artist, url, duration, utcnow()),\n    )\n    conn.commit()\n    row = conn.execute(\n        \"SELECT t.*, u.username FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n    return jsonify(serialize_track(row)), 201\n\n\n@app.get(\"/api/tracks/<int:track_id>\")\ndef get_track(track_id: int):\n    row = get_db().execute(\n        \"SELECT t.*, u.username FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n        (track_id,),\n    ).fetchone()\n    if row is None:\n        return error(\"Track not found.\", 404)\n    return jsonify(serialize_track(row)), 200\n\n\n@app.delete(\"/api/tracks/<int:track_id>\")\ndef delete_track(track_id: int):\n    user = current_user()\n    if user is None:\n        return error(\"Authentication required.\", 401)\n\n    conn = get_db()\n    row = conn.execute(\n        \"SELECT t.*, u.username FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n        (track_id,),\n    ).fetchone()\n    if row is None:\n        return error(\"Track not found.\", 404)\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(\"You can only delete your own tracks.\", 403)\n    conn.execute(\"DELETE FROM tracks WHERE id = ?\", (track_id,))\n    conn.commit()\n    return jsonify({\"ok\": True, \"id\": track_id}), 200\n\n\n@app.post(\"/api/tracks/<int:track_id>/plays\")\ndef add_play(track_id: int):\n    conn = get_db()\n    row = conn.execute(\n        \"SELECT t.*, u.username FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n        (track_id,),\n    ).fetchone()\n    if row is None:\n        return error(\"Track not found.\", 404)\n    conn.execute(\n        \"UPDATE tracks SET play_count = play_count + 1 WHERE id = ?\", (track_id,)\n    )\n    conn.commit()\n    row = conn.execute(\n        \"SELECT t.*, u.username FROM tracks t\"\n        \" JOIN users u ON u.id = t.user_id WHERE t.id = ?\",\n        (track_id,),\n    ).fetchone()\n    return jsonify(serialize_track(row)), 200\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n# ---------------------------------------------------------------- frontend\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    if path != \"index.html\" and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return error(\"Frontend build not found.\", 404)\n\n\ndb.init_db()","lineStart":1,"lineEnd":363,"totalLines":363,"truncated":false}},"title":"backend/app.py","time":{"start":1794377042348,"end":1794377042359}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c934c9a7001bi31F9lm878Igl","sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","messageID":"msg_1c934a2e5001xKBY73iUOCVaF3"}}
