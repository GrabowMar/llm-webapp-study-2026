{"type":"tool_use","timestamp":1794376295815,"sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","part":{"type":"tool","tool":"write","callID":"call_a06740906ad4447b9af62a7c","state":{"status":"completed","input":{"content":"\"\"\"SQLite storage helpers for the audio library.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import g\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or \"data\")\nDB_PATH = DATA_DIR / \"library.db\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tracks (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL,\n    artist TEXT NOT NULL DEFAULT '',\n    url TEXT NOT NULL,\n    duration REAL NOT NULL DEFAULT 0,\n    play_count INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_tracks_created ON tracks(created_at DESC, id DESC);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\ndef close_db(_exc) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n","filePath":"/workspace/backend/db.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/db.py","exists":false,"truncated":false},"title":"backend/db.py","time":{"start":1794376295726,"end":1794376295809}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9296523001UAkQLu9edOw89T","sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","messageID":"msg_1c928c536001zymvsMcxVsK1sH"}}
