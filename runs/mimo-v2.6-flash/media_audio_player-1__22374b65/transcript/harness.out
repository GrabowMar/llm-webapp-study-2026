{"type":"step_start","timestamp":1794376448359,"sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","part":{"id":"prt_1c92bb92f0016F6a2UkfJzQX5T","messageID":"msg_1c92b1fed001JhFC5Otc6sNoM0","sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","type":"step-start"}}
{"type":"tool_use","timestamp":1794376448359,"sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","part":{"type":"tool","tool":"write","callID":"call_7741ee659c1c482dbf55190f","state":{"status":"completed","input":{"content":"import { useEffect, useRef, useState, type FormEvent } from \"react\";\nimport { api, ApiError, getUsername, getToken, saveSession } from \"./api\";\nimport AddTrackForm from \"./components/AddTrackForm\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport PlayerBar from \"./components/PlayerBar\";\nimport TrackList from \"./components/TrackList\";\nimport type { Track } from \"./types\";\n\nconst PAGE_SIZE = 10;\n\nconst searchInputClass =\n  \"min-w-0 flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 placeholder-slate-500 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/40\";\n\nexport default function App() {\n  const [token, setToken] = useState<string | null>(() => getToken());\n  const [username, setUsername] = useState<string | null>(() => getUsername());\n  const signedIn = token !== null;\n\n  const [tracks, setTracks] = useState<Track[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [query, setQuery] = useState(\"\");\n  const [activeQuery, setActiveQuery] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [listError, setListError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [reloadKey, setReloadKey] = useState(0);\n\n  const audioRef = useRef<HTMLAudioElement | null>(null);\n  const [current, setCurrent] = useState<Track | null>(null);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [currentTime, setCurrentTime] = useState(0);\n  const [duration, setDuration] = useState(0);\n  const [volume, setVolume] = useState(1);\n  const [playerError, setPlayerError] = useState<string | null>(null);\n\n  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    api\n      .listTracks({ q: activeQuery, page, page_size: PAGE_SIZE })\n      .then((result) => {\n        if (cancelled) return;\n        setTracks(result.items);\n        setTotal(result.total);\n        setListError(null);\n        if (result.items.length === 0 && result.page > 1) {\n          const lastPage = Math.max(1, Math.ceil(result.total / result.page_size));\n          if (lastPage !== result.page) {\n            setPage(lastPage);\n          }\n        }\n      })\n      .catch((err: unknown) => {\n        if (!cancelled) {\n          setListError(\n            err instanceof ApiError ? err.message : \"Could not load the track list.\",\n          );\n        }\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [activeQuery, page, reloadKey]);\n\n  useEffect(() => {\n    const handle = window.setTimeout(() => {\n      const trimmed = query.trim();\n      setActiveQuery((previous) => (previous === trimmed ? previous : trimmed));\n      setPage(1);\n    }, 350);\n    return () => window.clearTimeout(handle);\n  }, [query]);\n\n  useEffect(() => {\n    const audio = audioRef.current;\n    if (audio) audio.volume = volume;\n  }, [volume]);\n\n  useEffect(() => {\n    const audio = audioRef.current;\n    if (!audio) return;\n    setPlayerError(null);\n    if (!current) {\n      audio.pause();\n      audio.removeAttribute(\"src\");\n      audio.load();\n      setIsPlaying(false);\n      setCurrentTime(0);\n      setDuration(0);\n      return;\n    }\n    audio.src = current.url;\n    audio.load();\n    setCurrentTime(0);\n    setDuration(current.duration || 0);\n    audio\n      .play()\n      .then(() => {\n        api\n          .addPlay(current.id)\n          .then((updated) => {\n            setTracks((existing) =>\n              existing.map((track) =>\n                track.id === updated.id\n                  ? { ...track, play_count: updated.play_count }\n                  : track,\n              ),\n            );\n            setCurrent((previous) =>\n              previous && previous.id === updated.id\n                ? { ...previous, play_count: updated.play_count }\n                : previous,\n            );\n          })\n          .catch(() => {\n            // play counting is best effort\n          });\n      })\n      .catch(() => {\n        setIsPlaying(false);\n        setPlayerError(\"This track could not be played from its address.\");\n      });\n  }, [current]);\n\n  const currentIndex =\n    current === null ? -1 : tracks.findIndex((track) => track.id === current.id);\n\n  function handlePlayTrack(track: Track) {\n    if (current && current.id === track.id) {\n      const audio = audioRef.current;\n      if (!audio) return;\n      if (audio.paused) {\n        audio.play().catch(() =>\n          setPlayerError(\"This track could not be played from its address.\"),\n        );\n      } else {\n        audio.pause();\n      }\n      return;\n    }\n    setCurrent(track);\n  }\n\n  function handleToggle() {\n    if (!current) {\n      if (tracks.length > 0) setCurrent(tracks[0]);\n      return;\n    }\n    const audio = audioRef.current;\n    if (!audio) return;\n    if (audio.paused) {\n      audio.play().catch(() =>\n        setPlayerError(\"This track could not be played from its address.\"),\n      );\n    } else {\n      audio.pause();\n    }\n  }\n\n  function handleNext() {\n    if (currentIndex >= 0 && currentIndex < tracks.length - 1) {\n      setCurrent(tracks[currentIndex + 1]);\n    }\n  }\n\n  function handlePrevious() {\n    if (currentIndex > 0) {\n      setCurrent(tracks[currentIndex - 1]);\n    } else {\n      const audio = audioRef.current;\n      if (audio) audio.currentTime = 0;\n      setCurrentTime(0);\n    }\n  }\n\n  function handleSeek(seconds: number) {\n    const audio = audioRef.current;\n    if (audio) audio.currentTime = seconds;\n    setCurrentTime(seconds);\n  }\n\n  function handleVolume(value: number) {\n    setVolume(value);\n    const audio = audioRef.current;\n    if (audio) audio.volume = value;\n  }\n\n  async function handleSignOut() {\n    try {\n      await api.logout();\n    } catch {\n      // signing out locally is enough\n    }\n    saveSession(null, null);\n    setToken(null);\n    setUsername(null);\n    setNotice(null);\n  }\n\n  function handleSignedIn(newToken: string, newUsername: string) {\n    setToken(newToken);\n    setUsername(newUsername);\n    setNotice(null);\n    setReloadKey((key) => key + 1);\n  }\n\n  function handleAdded(track: Track) {\n    setNotice(null);\n    setQuery(\"\");\n    setActiveQuery(\"\");\n    setPage(1);\n    setReloadKey((key) => key + 1);\n    if (!current) setCurrent(track);\n  }\n\n  async function handleDelete(track: Track) {\n    const confirmed = window.confirm(\n      `Delete \"${track.title}\" by ${track.artist || \"unknown artist\"}? This cannot be undone.`,\n    );\n    if (!confirmed) return;\n    try {\n      await api.deleteTrack(track.id);\n      setNotice(null);\n      setTracks((existing) => existing.filter((item) => item.id !== track.id));\n      setTotal((value) => Math.max(0, value - 1));\n      if (current && current.id === track.id) setCurrent(null);\n      setReloadKey((key) => key + 1);\n    } catch (err) {\n      setNotice(\n        err instanceof ApiError ? err.message : \"Could not delete the track.\",\n      );\n    }\n  }\n\n  function handleSearch(event: FormEvent) {\n    event.preventDefault();\n    const trimmed = query.trim();\n    setActiveQuery(trimmed);\n    setPage(1);\n  }\n\n  return (\n    <div className=\"flex min-h-screen flex-col bg-slate-950 text-slate-100\">\n      <audio\n        ref={audioRef}\n        preload=\"metadata\"\n        hidden\n        onPlay={() => setIsPlaying(true)}\n        onPause={() => setIsPlaying(false)}\n        onTimeUpdate={(e) => setCurrentTime(e.currentTarget.currentTime)}\n        onLoadedMetadata={(e) => {\n          const value = e.currentTarget.duration;\n          if (Number.isFinite(value) && value > 0) setDuration(value);\n        }}\n        onEnded={handleNext}\n        onError={() => {\n          if (current) {\n            setIsPlaying(false);\n            setPlayerError(\"This track could not be played from its address.\");\n          }\n        }}\n      />\n\n      <header className=\"sticky top-0 z-20 border-b border-slate-800 bg-slate-950/90 backdrop-blur\">\n        <div className=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-500 text-lg font-bold text-white\">\n              ♪\n            </span>\n            <div>\n              <h1 className=\"text-base font-semibold leading-tight\">Audio Library</h1>\n              <p className=\"hidden text-xs text-slate-400 sm:block\">\n                Play tracks straight from their source\n              </p>\n            </div>\n          </div>\n          {signedIn ? (\n            <div className=\"flex items-center gap-3\">\n              <span className=\"hidden text-sm text-slate-400 sm:inline\">Signed in as</span>\n              <span className=\"max-w-40 truncate rounded-lg bg-slate-800 px-2.5 py-1 text-sm font-medium text-slate-100\">\n                {username}\n              </span>\n              <button\n                type=\"button\"\n                onClick={handleSignOut}\n                className=\"rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-200 transition hover:border-slate-500 hover:bg-slate-800\"\n              >\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <span className=\"text-xs text-slate-500\">Browsing as guest</span>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto w-full max-w-6xl flex-1 space-y-5 px-4 py-6 pb-40\">\n        {!signedIn && <AuthPanel onSignedIn={handleSignedIn} />}\n        {signedIn && username && <AddTrackForm onAdded={handleAdded} />}\n\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <form onSubmit={handleSearch} className=\"flex min-w-64 flex-1 gap-2\">\n            <input\n              type=\"search\"\n              value={query}\n              onChange={(event) => setQuery(event.target.value)}\n              placeholder=\"Search by title, artist or username\"\n              aria-label=\"Search tracks\"\n              className={searchInputClass}\n            />\n            <button\n              type=\"submit\"\n              className=\"shrink-0 rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-slate-200 transition hover:bg-slate-700\"\n            >\n              Search\n            </button>\n          </form>\n          <div className=\"flex items-center gap-2 text-sm text-slate-400\">\n            <button\n              type=\"button\"\n              onClick={() => setPage((value) => Math.max(1, value - 1))}\n              disabled={page <= 1}\n              className=\"rounded-lg border border-slate-700 px-3 py-1.5 transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40\"\n            >\n              ← Prev\n            </button>\n            <span className=\"tabular-nums\">\n              Page {page} of {totalPages}\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => setPage((value) => value + 1)}\n              disabled={page >= totalPages}\n              className=\"rounded-lg border border-slate-700 px-3 py-1.5 transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40\"\n            >\n              Next →\n            </button>\n          </div>\n        </div>\n\n        {notice && (\n          <p className=\"rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-300\">\n            {notice}\n          </p>\n        )}\n\n        <TrackList\n          tracks={tracks}\n          username={username}\n          currentId={current ? current.id : null}\n          isPlaying={isPlaying}\n          loading={loading}\n          error={listError}\n          onPlay={handlePlayTrack}\n          onDelete={handleDelete}\n        />\n\n        <p className=\"text-xs text-slate-500\">\n          {total} {total === 1 ? \"track\" : \"tracks\"} in the library\n          {activeQuery ? ` matching “${activeQuery}”` : \"\"}\n        </p>\n      </main>\n\n      <PlayerBar\n        track={current}\n        isPlaying={isPlaying}\n        currentTime={currentTime}\n        duration={duration}\n        volume={volume}\n        error={playerError}\n        onToggle={handleToggle}\n        onPrevious={handlePrevious}\n        onNext={handleNext}\n        onSeek={handleSeek}\n        onVolume={handleVolume}\n      />\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794376448315,"end":1794376448333}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c92bb935001rvqVrHc586nmHr","sessionID":"ses_e36d8b1f5ffeJsKUFKIjoFPcuM","messageID":"msg_1c92b1fed001JhFC5Otc6sNoM0"}}
