{"type":"tool_use","timestamp":1794360084542,"sessionID":"ses_e37d8c494ffei3PgkfJdxtwcx1","part":{"type":"tool","tool":"write","callID":"call_96c3545dc88e4548b8162d08","state":{"status":"completed","input":{"content":"\"\"\"End-to-end smoke test for the running server.\"\"\"\n\nimport base64\nimport json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nfailures = []\n\n\ndef call(method, path, body=None, token=None, expect=None, raw_body=None, content_type=\"application/json\"):\n    headers = {}\n    data = raw_body\n    if body is not None:\n        data = json.dumps(body).encode()\n        headers[\"Content-Type\"] = content_type\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    req = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req) as resp:\n            status, payload = resp.status, resp.read().decode()\n    except urllib.error.HTTPError as exc:\n        status, payload = exc.code, exc.read().decode()\n    parsed = None\n    if payload:\n        try:\n            parsed = json.loads(payload)\n        except json.JSONDecodeError:\n            parsed = payload\n    if expect is not None and status not in expect:\n        failures.append(f\"{method} {path} -> {status} (expected {expect}): {payload[:300]}\")\n    return status, parsed\n\n\ndef check(name, cond, detail=\"\"):\n    if not cond:\n        failures.append(f\"{name}: {detail}\")\n\n\n# health + frontend\ns, body = call(\"GET\", \"/api/health\")\ncheck(\"health\", s == 200 and body == {\"status\": \"ok\"}, f\"{s} {body}\")\n\nreq = urllib.request.Request(BASE + \"/\")\nwith urllib.request.urlopen(req) as resp:\n    html = resp.read().decode()\ncheck(\"index html\", resp.status == 200 and 'id=\"root\"' in html, html[:200])\ncheck(\"title\", \"Base64 Converter\" in html, html[:300])\n\n# auth\nuname = \"alice-\" + str(abs(hash(\"x\")) % 100000)\ns, body = call(\"POST\", \"/api/auth/register\", {\"username\": uname, \"password\": \"pw1234\"}, expect=[201])\ncheck(\"register 201\", s == 201, body)\n\ns, body = call(\"POST\", \"/api/auth/register\", {\"username\": uname, \"password\": \"pw1234\"})\ncheck(\"register duplicate 4xx\", s in (400, 409), body)\n\ns, body = call(\"POST\", \"/api/auth/login\", {\"username\": uname, \"password\": \"wrong\"}, expect=[401])\ncheck(\"login bad creds\", s == 401 and isinstance(body, dict) and \"error\" in body, body)\n\ns, body = call(\"POST\", \"/api/auth/login\", {\"username\": uname, \"password\": \"pw1234\"}, expect=[200])\ntoken = body.get(\"token\") if isinstance(body, dict) else None\ncheck(\"login token\", s == 200 and isinstance(token, str) and len(token) > 10, body)\n\ns, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"\"}, expect=[400])\ncheck(\"register empty\", s == 400, body)\n\ns, body = call(\"POST\", \"/api/auth/login\", {\"username\": uname, \"password\": \"pw1234\"}, raw_body=b\"not json\")\ncheck(\"login bad json\", s == 400, body)\n\n# encode / decode\ns, body = call(\"POST\", \"/api/base64/encode\", {\"text\": \"hello world\"}, expect=[200])\ncheck(\"encode hello\", body == {\"encoded\": \"aGVsbG8gd29ybGQ=\"}, body)\n\ns, body = call(\"POST\", \"/api/base64/encode\", {\"text\": \"\"}, expect=[200])\ncheck(\"encode empty\", body == {\"encoded\": \"\"}, body)\n\ns, body = call(\"POST\", \"/api/base64/encode\", {\"text\": \"héllo ☃\"}, expect=[200])\nexpected = base64.b64encode(\"héllo ☃\".encode()).decode()\ncheck(\"encode unicode\", body == {\"encoded\": expected}, f\"{body} vs {expected}\")\n\ns, body = call(\"POST\", \"/api/base64/decode\", {\"encoded\": \"aGVsbG8gd29ybGQ=\"}, expect=[200])\ncheck(\"decode hello\", body == {\"text\": \"hello world\"}, body)\n\ns, body = call(\"POST\", \"/api/base64/decode\", {\"encoded\": expected}, expect=[200])\ncheck(\"decode unicode\", body == {\"text\": \"héllo ☃\"}, body)\n\ns, body = call(\"POST\", \"/api/base64/decode\", {\"encoded\": \"\"}, expect=[200])\ncheck(\"decode empty\", body == {\"text\": \"\"}, body)\n\ns, body = call(\"POST\", \"/api/base64/decode\", {\"encoded\": \"not base64!!!\"}, expect=[400])\ncheck(\"decode invalid 400\", s == 400 and isinstance(body, dict) and \"error\" in body, body)\n\ns, body = call(\"POST\", \"/api/base64/decode\", {\"encoded\": base64.b64encode(b\"\\xff\\xfe\").decode()}, expect=[400])\ncheck(\"decode non-utf8 400\", s == 400 and \"error\" in body, body)\n\ns, body = call(\"POST\", \"/api/base64/encode\", {\"texte\": \"x\"}, expect=[400])\ncheck(\"encode missing field\", s == 400, body)\n\ns, body = call(\"POST\", \"/api/base64/encode\", {\"text\": 42}, expect=[400])\ncheck(\"encode non-string\", s == 400, body)\n\n# conversions auth required\ns, body = call(\"POST\", \"/api/conversions\", {\"direction\": \"encode\", \"input\": \"hi\"}, expect=[401])\ncheck(\"conversions no auth\", s == 401, body)\ns, body = call(\"GET\", \"/api/conversions\", expect=[401])\ncheck(\"list no auth\", s == 401, body)\ns, body = call(\"DELETE\", \"/api/conversions/1\", expect=[401])\ncheck(\"delete no auth\", s == 401, body)\ns, body = call(\"GET\", \"/api/conversions\", token=\"bogus\", expect=[401])\ncheck(\"bad token\", s == 401, body)\n\n# create conversions\ns, body = call(\n    \"POST\",\n    \"/api/conversions\",\n    {\"direction\": \"encode\", \"input\": \"saved text\"},\n    token=token,\n    expect=[201],\n)\ncheck(\"create encode conv\", s == 201, body)\nconv_id = body.get(\"id\") if isinstance(body, dict) else None\ncheck(\n    \"conv fields\",\n    isinstance(body, dict)\n    and set(body) == {\"id\", \"direction\", \"input_preview\", \"output_preview\", \"created_at\", \"output\"}\n    and body[\"output\"] == base64.b64encode(b\"saved text\").decode()\n    and body[\"input_preview\"] == \"saved text\",\n    body,\n)\n\nlong_text = \"z\" * 250\ns, body = call(\n    \"POST\", \"/api/conversions\", {\"direction\": \"encode\", \"input\": long_text}, token=token, expect=[201]\n)\ncheck(\"preview truncates\", body.get(\"input_preview\") == \"z\" * 100, body)\ncheck(\"output full in create\", body.get(\"output\") == base64.b64encode(long_text.encode()).decode(), str(body)[:200])\n\ns, body = call(\n    \"POST\", \"/api/conversions\", {\"direction\": \"decode\", \"input\": \"aGVsbG8=\"}, token=token, expect=[201]\n)\ncheck(\"create decode conv\", s == 201 and body.get(\"output\") == \"hello\", body)\n\ns, body = call(\n    \"POST\", \"/api/conversions\", {\"direction\": \"reverse\", \"input\": \"x\"}, token=token, expect=[400]\n)\ncheck(\"bad direction\", s == 400, body)\n\ns, body = call(\n    \"POST\", \"/api/conversions\", {\"direction\": \"decode\", \"input\": \"???bad\"}, token=token, expect=[400]\n)\ncheck(\"bad decode not saved\", s == 400, body)\n\n# second user\nuname2 = \"bob-\" + str(abs(hash(\"y\")) % 100000)\ncall(\"POST\", \"/api/auth/register\", {\"username\": uname2, \"password\": \"pw1234\"}, expect=[201])\n_, body = call(\"POST\", \"/api/auth/login\", {\"username\": uname2, \"password\": \"pw1234\"}, expect=[200])\ntoken2 = body[\"token\"]\n\ns, body = call(\n    \"POST\", \"/api/conversions\", {\"direction\": \"encode\", \"input\": \"bob data\"}, token=token2, expect=[201]\n)\nbob_conv = body[\"id\"]\n\ns, body = call(\"GET\", \"/api/conversions?page=1&page_size=2\", token=token, expect=[200])\ncheck(\"list shape\", isinstance(body, dict) and set(body) == {\"items\", \"total\", \"page\", \"page_size\"}, body)\ncheck(\"list total\", body.get(\"total\") == 3, body)\ncheck(\"list page echo\", body.get(\"page\") == 1 and body.get(\"page_size\") == 2, body)\ncheck(\"list page size\", len(body.get(\"items\", [])) == 2, body)\ncheck(\"list newest first\", body[\"items\"][0][\"id\"] > body[\"items\"][1][\"id\"], body)\ncheck(\"list item keys\", set(body[\"items\"][0]) == {\"id\", \"direction\", \"input_preview\", \"output_preview\", \"created_at\"}, body)\ncheck(\"list no output\", \"output\" not in body[\"items\"][0], body[\"items\"][0])\n\ns, body = call(\"GET\", \"/api/conversions?page=2&page_size=2\", token=token, expect=[200])\ncheck(\"page 2\", len(body.get(\"items\", [])) == 1 and body.get(\"page\") == 2, body)\n\ns, body = call(\"GET\", \"/api/conversions?page=99&page_size=2\", token=token, expect=[200])\ncheck(\"page beyond end\", body.get(\"items\") == [], body)\n\ns, body = call(\"GET\", \"/api/conversions?page=0\", token=token, expect=[400])\ncheck(\"page 0 rejected\", s == 400, body)\n\ns, body = call(\"GET\", \"/api/conversions?page_size=100\", token=token, expect=[200])\ncheck(\"page_size honored\", body.get(\"page_size\") == 100 and len(body[\"items\"]) == 3, body)\n\n# isolation: bob sees only his own\ns, body = call(\"GET\", \"/api/conversions\", token=token2, expect=[200])\ncheck(\"bob total\", body.get(\"total\") == 1 and body[\"items\"][0][\"id\"] == bob_conv, body)\n\n# isolation: bob cannot delete alice's\ns, body = call(\"DELETE\", f\"/api/conversions/{conv_id}\", token=token2, expect=[404])\ncheck(\"foreign delete 404\", s == 404, body)\ns, body = call(\"GET\", \"/api/conversions\", token=token, expect=[200])\ncheck(\"alice item intact\", body.get(\"total\") == 3, body)\n\n# alice deletes her own\ns, body = call(\"DELETE\", f\"/api/conversions/{conv_id}\", token=token, expect=[200, 204])\ncheck(\"own delete\", s in (200, 204), body)\ns, body = call(\"GET\", \"/api/conversions\", token=token, expect=[200])\ncheck(\"deleted gone\", body.get(\"total\") == 2, body)\ns, body = call(\"DELETE\", f\"/api/conversions/{conv_id}\", token=token, expect=[404])\ncheck(\"double delete 404\", s == 404, body)\n\n# unknown api route\ns, body = call(\"GET\", \"/api/nope\", expect=[404])\ncheck(\"unknown api 404 json\", s == 404 and isinstance(body, dict) and \"error\" in body, body)\n\n# method not allowed on api\ns, body = call(\"GET\", \"/api/base64/encode\", expect=[405])\ncheck(\"405 json\", s == 405 and isinstance(body, dict), body)\n\n# asset served\ns, _ = call(\"GET\", \"/\")\ncheck(\"root 200\", s == 200, s)\n\nprint(\"FAILURES:\" if failures else \"ALL CHECKS PASSED\")\nfor f in failures:\n    print(\" -\", f)\n","filePath":"/workspace/test_e2e.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/test_e2e.py","exists":false,"truncated":false},"title":"test_e2e.py","time":{"start":1794360084505,"end":1794360084520}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8320812001mrRLHbsNrAWqGn","sessionID":"ses_e37d8c494ffei3PgkfJdxtwcx1","messageID":"msg_1c83169de001DNgtsrsK9hArrE"}}
