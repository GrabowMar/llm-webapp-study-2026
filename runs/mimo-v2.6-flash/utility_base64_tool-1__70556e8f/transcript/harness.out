{"type":"text","timestamp":1794359617266,"sessionID":"ses_e37d8c494ffei3PgkfJdxtwcx1","part":{"id":"prt_1c82ae6e0001Ad1xJETyKfcCbI","messageID":"msg_1c829739c0012Lsh6nQQXFU8tu","sessionID":"ses_e37d8c494ffei3PgkfJdxtwcx1","type":"text","text":"Now I'll write the backend:","time":{"start":1794359617248,"end":1794359617262}}}
{"type":"tool_use","timestamp":1794359617304,"sessionID":"ses_e37d8c494ffei3PgkfJdxtwcx1","part":{"type":"tool","tool":"write","callID":"call_baf9b62294b54b3db53e50d4","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: base64 converter API, accounts and frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport hashlib\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask\nfrom flask import g\nfrom flask import jsonify\nfrom flask import request\nfrom flask import send_from_directory\nfrom werkzeug.exceptions import HTTPException\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path.cwd() / \"data\"\nDB_PATH = DATA_DIR / \"app.db\"\n\nPREVIEW_LENGTH = 100\nDEFAULT_PAGE_SIZE = 10\nPBKDF2_ITERATIONS = 120_000\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS conversions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    direction TEXT NOT NULL,\n    input TEXT NOT NULL,\n    output TEXT NOT NULL,\n    input_preview TEXT NOT NULL,\n    output_preview TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_conversions_user\n    ON conversions (user_id, id DESC);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\nclass ApiError(Exception):\n    \"\"\"Raised to answer with a JSON error payload.\"\"\"\n\n    def __init__(self, status: int, message: str) -> None:\n        super().__init__(message)\n        self.status = status\n        self.message = message\n\n\ndef now() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    con = sqlite3.connect(DB_PATH)\n    try:\n        con.execute(\"PRAGMA journal_mode=WAL\")\n        con.executescript(SCHEMA)\n        con.commit()\n    finally:\n        con.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef require_str(data: dict, field: str) -> str:\n    if field not in data:\n        raise ApiError(400, f\"'{field}' is required\")\n    value = data[field]\n    if not isinstance(value, str):\n        raise ApiError(400, f\"'{field}' must be a string\")\n    return value\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ITERATIONS\n    )\n    return f\"{salt}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        salt_hex, digest_hex = stored.split(\"$\", 1)\n        digest = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt_hex), PBKDF2_ITERATIONS\n        )\n    except (ValueError, TypeError):\n        return False\n    return secrets.compare_digest(digest.hex(), digest_hex)\n\n\ndef encode_text(text: str) -> str:\n    return base64.b64encode(text.encode(\"utf-8\")).decode(\"ascii\")\n\n\ndef decode_encoded(encoded: str) -> str:\n    compact = \"\".join(encoded.split())\n    compact += \"=\" * (-len(compact) % 4)\n    try:\n        raw = base64.b64decode(compact, validate=True)\n    except (binascii.Error, ValueError) as exc:\n        raise ApiError(400, \"Invalid base64 input\") from exc\n    try:\n        return raw.decode(\"utf-8\")\n    except UnicodeDecodeError as exc:\n        raise ApiError(400, \"Decoded data is not valid UTF-8 text\") from exc\n\n\ndef preview(text: str) -> str:\n    return text[:PREVIEW_LENGTH]\n\n\ndef conversion_payload(row: sqlite3.Row, include_output: bool = False) -> dict:\n    payload = {\n        \"id\": row[\"id\"],\n        \"direction\": row[\"direction\"],\n        \"input_preview\": row[\"input_preview\"],\n        \"output_preview\": row[\"output_preview\"],\n        \"created_at\": row[\"created_at\"],\n    }\n    if include_output:\n        payload[\"output\"] = row[\"output\"]\n    return payload\n\n\ndef authenticated_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        return None\n    token = parts[1].strip()\n    row = get_db().execute(\n        \"SELECT u.id, u.username FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = authenticated_user()\n        if user is None:\n            raise ApiError(401, \"Authentication required\")\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef positive_int(value: str | None, default: int, name: str) -> int:\n    if value is None or value == \"\":\n        return default\n    try:\n        parsed = int(value)\n    except (TypeError, ValueError) as exc:\n        raise ApiError(400, f\"'{name}' must be an integer\") from exc\n    if parsed < 1:\n        raise ApiError(400, f\"'{name}' must be >= 1\")\n    return parsed\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(error: ApiError):\n    return jsonify({\"error\": error.message}), error.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(error: HTTPException):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": error.description}), error.code\n    return error.get_response(request.environ)\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = require_str(data, \"username\").strip()\n    password = require_str(data, \"password\")\n    if not username:\n        raise ApiError(400, \"'username' must not be empty\")\n    if not password:\n        raise ApiError(400, \"'password' must not be empty\")\n    if len(username) > 150:\n        raise ApiError(400, \"'username' is too long\")\n    db = get_db()\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, hash_password(password), now()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError as exc:\n        raise ApiError(409, \"Username is already taken\") from exc\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = require_str(data, \"username\").strip()\n    password = require_str(data, \"password\")\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now()),\n    )\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/base64/encode\")\ndef api_encode():\n    data = json_body()\n    text = require_str(data, \"text\")\n    return jsonify({\"encoded\": encode_text(text)})\n\n\n@app.post(\"/api/base64/decode\")\ndef api_decode():\n    data = json_body()\n    encoded = require_str(data, \"encoded\")\n    return jsonify({\"text\": decode_encoded(encoded)})\n\n\n@app.post(\"/api/conversions\")\n@require_auth\ndef create_conversion():\n    data = json_body()\n    direction = require_str(data, \"direction\")\n    if direction not in (\"encode\", \"decode\"):\n        raise ApiError(400, \"'direction' must be 'encode' or 'decode'\")\n    value = require_str(data, \"input\")\n    output = encode_text(value) if direction == \"encode\" else decode_encoded(value)\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO conversions \"\n        \"(user_id, direction, input, output, input_preview, output_preview, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            g.user[\"id\"],\n            direction,\n            value,\n            output,\n            preview(value),\n            preview(output),\n            now(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT id, direction, input_preview, output_preview, created_at, output \"\n        \"FROM conversions WHERE id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n    return jsonify(conversion_payload(row, include_output=True)), 201\n\n\n@app.get(\"/api/conversions\")\n@require_auth\ndef list_conversions():\n    page = positive_int(request.args.get(\"page\"), 1, \"page\")\n    page_size = positive_int(request.args.get(\"page_size\"), DEFAULT_PAGE_SIZE, \"page_size\")\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM conversions WHERE user_id = ?\", (g.user[\"id\"],)\n    ).fetchone()[0]\n    rows = db.execute(\n        \"SELECT id, direction, input_preview, output_preview, created_at \"\n        \"FROM conversions WHERE user_id = ? \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        (g.user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [conversion_payload(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.delete(\"/api/conversions/<int:conversion_id>\")\n@require_auth\ndef delete_conversion(conversion_id: int):\n    db = get_db()\n    cursor = db.execute(\n        \"DELETE FROM conversions WHERE id = ? AND user_id = ?\",\n        (conversion_id, g.user[\"id\"]),\n    )\n    db.commit()\n    if cursor.rowcount == 0:\n        raise ApiError(404, \"Conversion not found\")\n    return jsonify({\"status\": \"deleted\"})\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        raise ApiError(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794359617258,"end":1794359617279}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c82ae6e30013BBqcn1CbyOpYP","sessionID":"ses_e37d8c494ffei3PgkfJdxtwcx1","messageID":"msg_1c829739c0012Lsh6nQQXFU8tu"}}
