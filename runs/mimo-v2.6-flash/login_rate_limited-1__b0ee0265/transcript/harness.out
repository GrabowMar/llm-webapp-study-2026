{"type":"tool_use","timestamp":1794341804402,"sessionID":"ses_e38efc4fdffeqXVhq3G1tPpRUd","part":{"type":"tool","tool":"write","callID":"call_97cfe2d792cf4259b8b3fb6f","state":{"status":"completed","input":{"content":"import json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nfrom datetime import datetime\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent\nBASE = \"http://127.0.0.1:8000\"\nDATA_DIR = ROOT / \"data\"\n\n\ndef req(method, path, body=None, token=None, headers=None, raw=False):\n    url = BASE + path\n    data = json.dumps(body).encode() if body is not None else None\n    final_headers = dict(headers or {})\n    if data is not None:\n        final_headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        final_headers[\"Authorization\"] = \"Bearer \" + token\n    request = urllib.request.Request(url, data=data, method=method,\n                                     headers=final_headers)\n    try:\n        with urllib.request.urlopen(request, timeout=10) as response:\n            status = response.status\n            resp_headers = dict(response.headers)\n            payload = response.read()\n    except urllib.error.HTTPError as exc:\n        status = exc.code\n        resp_headers = dict(exc.headers)\n        payload = exc.read()\n    parsed = payload if raw else None\n    if not raw and payload:\n        try:\n            parsed = json.loads(payload)\n        except ValueError:\n            parsed = payload.decode()\n    return status, resp_headers, parsed\n\n\ndef start_server(admin_password=None, clear_data=False):\n    if clear_data and DATA_DIR.exists():\n        shutil.rmtree(DATA_DIR)\n    env = dict(os.environ)\n    env.pop(\"ADMIN_PASSWORD\", None)\n    if admin_password is not None:\n        env[\"ADMIN_PASSWORD\"] = admin_password\n    process = subprocess.Popen(\n        [\"gunicorn\", \"--bind\", \"127.0.0.1:8000\", \"--pythonpath\", \"backend\",\n         \"app:app\"],\n        cwd=ROOT, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n    )\n    for _ in range(100):\n        try:\n            status, _, body = req(\"GET\", \"/api/health\")\n            if status == 200 and body.get(\"status\") == \"ok\":\n                return process\n        except Exception:\n            time.sleep(0.1)\n    process.kill()\n    raise RuntimeError(\"server failed to start\")\n\n\ndef stop_server(process):\n    process.terminate()\n    try:\n        process.wait(timeout=10)\n    except subprocess.TimeoutExpired:\n        process.kill()\n        process.wait(timeout=10)\n\n\ndef check(condition, message):\n    if not condition:\n        raise AssertionError(message)\n    print(\"ok -\", message)\n\n\ndef client(ip):\n    return {\"X-Forwarded-For\": ip}\n\n\ndef main():\n    process = start_server(admin_password=\"admin-secret\", clear_data=True)\n    try:\n        status, headers, body = req(\"GET\", \"/api/health\")\n        check(status == 200 and body == {\"status\": \"ok\"}, \"health endpoint\")\n\n        status, headers, body = req(\"GET\", \"/\")\n        check(status == 200 and \"text/html\" in headers.get(\"Content-Type\", \"\"),\n              \"frontend index served at /\")\n        html = body if isinstance(body, str) else body.decode()\n        check('id=\"root\"' in html, \"index html has root element\")\n\n        status, headers, body = req(\"GET\", \"/api/does-not-exist\")\n        check(status == 404, \"unknown api path answers 404\")\n\n        status, _, _ = req(\"GET\", \"/some/spa/route\")\n        check(status == 200, \"spa route falls back to index\")\n\n        status, _, body = req(\"POST\", \"/api/auth/register\",\n                              {\"username\": \"\", \"password\": \"x\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 400, \"empty username rejected\")\n\n        status, _, body = req(\"POST\", \"/api/auth/register\",\n                              {\"username\": \"alice\", \"password\": \"pw12345\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 201 and body[\"username\"] == \"alice\"\n              and isinstance(body[\"id\"], int), \"register answers 201\")\n\n        status, _, body = req(\"POST\", \"/api/auth/register\",\n                              {\"username\": \"alice\", \"password\": \"pw12345\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 409, \"duplicate register answers 409\")\n\n        status, _, body = req(\"POST\", \"/api/auth/register\",\n                              {\"username\": \"admin\", \"password\": \"pw12345\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 409, \"registering reserved admin name rejected\")\n\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"alice\", \"password\": \"nope\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 401, \"wrong password answers 401\")\n\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"ghost\", \"password\": \"nope\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 401, \"unknown username answers 401\")\n\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"alice\", \"password\": \"pw12345\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 200 and isinstance(body.get(\"token\"), str)\n              and len(body[\"token\"]) > 20, \"login answers 200 with token\")\n        token = body[\"token\"]\n\n        status, _, body = req(\"GET\", \"/api/me\")\n        check(status == 401, \"/api/me without token answers 401\")\n        status, _, body = req(\"GET\", \"/api/me\", token=\"bogus\")\n        check(status == 401, \"/api/me with bad token answers 401\")\n\n        status, _, body = req(\"GET\", \"/api/me\", token=token)\n        check(status == 200 and set(body) == {\"id\", \"username\", \"last_login_at\"}\n              and body[\"username\"] == \"alice\"\n              and isinstance(body[\"last_login_at\"], str),\n              \"/api/me returns id, username, last_login_at\")\n\n        status, _, body = req(\"GET\", \"/api/me/login-attempts\", token=token)\n        check(status == 200 and isinstance(body.get(\"items\"), list)\n              and len(body[\"items\"]) == 1\n              and set(body[\"items\"][0]) == {\"at\", \"success\"}\n              and body[\"items\"][0][\"success\"] is True,\n              \"login attempts list first successful sign-in\")\n\n        for i in range(4):\n            status, _, _ = req(\"POST\", \"/api/auth/login\",\n                               {\"username\": \"alice\", \"password\": \"nope\"},\n                               headers=client(\"10.0.0.1\"))\n            check(status == 401, f\"failure {i + 1} answers 401\")\n\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"alice\", \"password\": \"pw12345\"},\n                              headers=client(\"10.0.0.1\"))\n        retry = int(headers[\"Retry-After\"]) if False else None\n        status, headers, body = req(\"POST\", \"/api/auth/login\",\n                                    {\"username\": \"alice\", \"password\": \"pw12345\"},\n                                    headers=client(\"10.0.0.1\"))\n        check(status == 429, \"locked username answers 429 even with right password\")\n        check(\"Retry-After\" in headers, \"429 carries Retry-After header\")\n        retry = int(headers[\"Retry-After\"])\n        check(800 <= retry <= 900, f\"lock Retry-After near 15 minutes ({retry})\")\n\n        status, _, body = req(\"GET\", \"/api/admin/locks\", token=token)\n        check(status == 403, \"non-admin cannot list locks\")\n\n        status, _, body = req(\"GET\", \"/api/admin/locks\")\n        check(status == 401, \"locks without token answers 401\")\n\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"admin\", \"password\": \"admin-secret\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 200, \"admin sign-in with ADMIN_PASSWORD works\")\n        admin_token = body[\"token\"]\n\n        status, _, body = req(\"GET\", \"/api/me\", token=admin_token)\n        check(status == 200 and body[\"username\"] == \"admin\",\n              \"admin /api/me works\")\n\n        status, _, body = req(\"GET\", \"/api/admin/locks\", token=admin_token)\n        items = body[\"items\"]\n        alice_lock = [i for i in items if i[\"username\"] == \"alice\"]\n        check(status == 200 and set(body) == {\"items\"} and alice_lock\n              and set(alice_lock[0]) == {\"username\", \"locked_until\"},\n              \"admin sees alice in locks\")\n        until = datetime.fromisoformat(\n            alice_lock[0][\"locked_until\"].replace(\"Z\", \"+00:00\"))\n        check((until - datetime.now(until.tzinfo)).total_seconds() > 800,\n              \"locked_until is about 15 minutes ahead\")\n\n        status, _, body = req(\"POST\", \"/api/admin/locks/alice/unlock\",\n                              token=admin_token)\n        check(status == 200, \"unlock answers 200\")\n\n        status, _, body = req(\"GET\", \"/api/admin/locks\", token=admin_token)\n        check(status == 200 and not any(\n            i[\"username\"] == \"alice\" for i in body[\"items\"]),\n            \"alice no longer locked after unlock\")\n\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"alice\", \"password\": \"pw12345\"},\n                              headers=client(\"10.0.0.1\"))\n        check(status == 200, \"sign-in works after early unlock\")\n\n        status, _, body = req(\"GET\", \"/api/me/login-attempts\", token=token)\n        items = body[\"items\"]\n        check(len(items) == 6 and items[0][\"success\"] is True\n              and [i[\"success\"] for i in items] == [True, False, False, False,\n                                                    False, True],\n              \"attempts newest first with successes and failures\")\n\n        rotate = 0\n        for i in range(24):\n            rotate += 1\n            password = \"pw12345\" if i % 2 == 0 else \"nope\"\n            req(\"POST\", \"/api/auth/login\",\n                {\"username\": \"alice\", \"password\": password},\n                headers=client(f\"10.1.{rotate // 250}.{rotate % 250 + 1}\"))\n        status, _, body = req(\"GET\", \"/api/me/login-attempts\", token=token)\n        items = body[\"items\"]\n        times = [datetime.fromisoformat(i[\"at\"].replace(\"Z\", \"+00:00\"))\n                 for i in items]\n        check(len(items) == 20, \"attempts capped at 20 items\")\n        check(all(times[i] >= times[i + 1] for i in range(len(times) - 1)),\n              \"attempts ordered newest first\")\n\n        for i in range(20):\n            status, _, _ = req(\"POST\", \"/api/auth/login\",\n                               {\"username\": \"alice\", \"password\": \"pw12345\"},\n                               headers=client(\"10.2.0.1\"))\n            check(status == 200, f\"sign-in {i + 1} of 20 allowed\")\n        status, headers, body = req(\n            \"POST\", \"/api/auth/login\",\n            {\"username\": \"alice\", \"password\": \"pw12345\"},\n            headers=client(\"10.2.0.1\"))\n        check(status == 429, \"21st sign-in inside a minute answers 429\")\n        retry = int(headers[\"Retry-After\"])\n        check(1 <= retry <= 60, f\"rate limit Retry-After within a minute ({retry})\")\n        check(body.get(\"code\") == \"rate_limited\",\n              \"rate limit body marks rate_limited\")\n\n        status, headers, _ = req(\n            \"POST\", \"/api/auth/login\",\n            {\"username\": \"alice\", \"password\": \"pw12345\"},\n            headers=client(\"10.2.0.1\"))\n        check(status == 429 and 1 <= int(headers[\"Retry-After\"]) <= 60,\n              \"still rate limited afterwards\")\n\n        status, _, _ = req(\"POST\", \"/api/auth/login\",\n                           {\"username\": \"alice\", \"password\": \"pw12345\"},\n                           headers=client(\"10.2.0.2\"))\n        check(status == 200, \"other clients are not rate limited\")\n\n        print(\"restarting server to verify persistence...\")\n        stop_server(process)\n        process = start_server(admin_password=\"admin-secret\")\n\n        status, _, body = req(\"GET\", \"/api/me\", token=token)\n        check(status == 200 and body[\"username\"] == \"alice\",\n              \"session survives restart\")\n        status, _, body = req(\"POST\", \"/api/auth/register\",\n                              {\"username\": \"alice\", \"password\": \"pw12345\"})\n        check(status == 409, \"accounts survive restart\")\n    finally:\n        stop_server(process)\n\n    process = start_server(admin_password=None, clear_data=True)\n    try:\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"admin\", \"password\": \"admin-secret\"},\n                              headers=client(\"10.3.0.1\"))\n        check(status == 401, \"admin sign-in disabled without ADMIN_PASSWORD\")\n        status, _, body = req(\"POST\", \"/api/auth/register\",\n                              {\"username\": \"bob\", \"password\": \"pw12345\"},\n                              headers=client(\"10.3.0.1\"))\n        check(status == 201, \"regular registration still works\")\n        status, _, body = req(\"POST\", \"/api/auth/login\",\n                              {\"username\": \"bob\", \"password\": \"pw12345\"},\n                              headers=client(\"10.3.0.1\"))\n        token = body[\"token\"]\n        status, _, body = req(\"GET\", \"/api/admin/locks\", token=token)\n        check(status == 403, \"non-admin still blocked when admin disabled\")\n    finally:\n        stop_server(process)\n\n    print(\"ALL CHECKS PASSED\")\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","filePath":"/workspace/e2e_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/e2e_test.py","exists":false,"truncated":false},"title":"e2e_test.py","time":{"start":1794341804358,"end":1794341804379}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c71b1936001rl5FAXwQyZ2IgF","sessionID":"ses_e38efc4fdffeqXVhq3G1tPpRUd","messageID":"msg_1c71a82be001Ujn3EH79zN71OP"}}
