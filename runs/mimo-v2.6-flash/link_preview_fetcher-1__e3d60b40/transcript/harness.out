{"type":"step_start","timestamp":1794363612638,"sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","part":{"id":"prt_1c867ddc2001oSgX3P1m7pZfj6","messageID":"msg_1c8668dcf001PMlQfv4q0xpOlA","sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","type":"step-start"}}
{"type":"tool_use","timestamp":1794363612664,"sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","part":{"type":"tool","tool":"write","callID":"call_90082493e28944648b92ec22","state":{"status":"completed","input":{"content":"\"\"\"End-to-end API tests for the link preview app.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nFIXTURE = \"http://127.0.0.1:8123\"\n\npassed = 0\nfailed: list[str] = []\n\n\ndef check(label: str, condition: bool, detail: str = \"\") -> None:\n    global passed\n    if condition:\n        passed += 1\n    else:\n        failed.append(f\"{label}: {detail}\")\n        print(f\"FAIL  {label}  {detail}\")\n\n\ndef call(method: str, path: str, body=None, token: str | None = None):\n    data = json.dumps(body).encode() if body is not None else None\n    request = urllib.request.Request(BASE + path, data=data, method=method)\n    if data is not None:\n        request.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        request.add_header(\"Authorization\", f\"Bearer {token}\")\n    try:\n        with urllib.request.urlopen(request, timeout=20) as response:\n            raw = response.read()\n            status = response.status\n    except urllib.error.HTTPError as error:\n        raw = error.read()\n        status = error.code\n    payload = None\n    if raw:\n        try:\n            payload = json.loads(raw)\n        except ValueError:\n            payload = raw.decode(errors=\"replace\")\n    return status, payload\n\n\ndef expect(label: str, method: str, path: str, want_status: int, body=None, token=None):\n    status, payload = call(method, path, body, token)\n    check(label, status == want_status, f\"status={status} body={payload!r}\")\n    return payload\n\n\ndef main() -> None:\n    # health + frontend\n    status, payload = call(\"GET\", \"/api/health\")\n    check(\"health\", status == 200 and payload == {\"status\": \"ok\"}, f\"{status} {payload}\")\n\n    with urllib.request.urlopen(BASE + \"/\", timeout=10) as response:\n        html = response.read().decode()\n        root_status = response.status\n    check(\"frontend index\", root_status == 200 and 'id=\"root\"' in html, html[:200])\n    status, payload = call(\"GET\", \"/api/does-not-exist\")\n    check(\"unknown api route\", status == 404 and isinstance(payload, dict), f\"{status}\")\n\n    # auth\n    expect(\"register ok\", \"POST\", \"/api/auth/register\", 201, {\"username\": \"alice\", \"password\": \"secret1\"})\n    expect(\"register duplicate\", \"POST\", \"/api/auth/register\", 409, {\"username\": \"alice\", \"password\": \"secret1\"})\n    expect(\"register missing\", \"POST\", \"/api/auth/register\", 400, {\"username\": \"alice\"})\n    expect(\"register bob\", \"POST\", \"/api/auth/register\", 201, {\"username\": \"bob\", \"password\": \"hunter2\"})\n    expect(\"login bad\", \"POST\", \"/api/auth/login\", 401, {\"username\": \"alice\", \"password\": \"wrong\"})\n\n    status, payload = expect(\n        \"login ok\", \"POST\", \"/api/auth/login\", 200, {\"username\": \"alice\", \"password\": \"secret1\"}\n    )\n    token_a = payload[\"token\"] if isinstance(payload, dict) else None\n    check(\"login token\", isinstance(token_a, str) and len(token_a) > 20, repr(payload))\n\n    status, payload = expect(\n        \"login bob\", \"POST\", \"/api/auth/login\", 200, {\"username\": \"bob\", \"password\": \"hunter2\"}\n    )\n    token_b = payload[\"token\"]\n\n    # auth enforcement\n    expect(\"no token list\", \"GET\", \"/api/previews\", 401)\n    expect(\"bad token list\", \"GET\", \"/api/previews\", 401, token=\"not-a-token\")\n    expect(\"no token create\", \"POST\", \"/api/previews\", 401, {\"url\": f\"{FIXTURE}/full\"})\n    expect(\"no token get\", \"GET\", \"/api/previews/1\", 401)\n    expect(\"no token delete\", \"DELETE\", \"/api/previews/1\", 401)\n    expect(\"no token refresh\", \"POST\", \"/api/previews/1/refresh\", 401)\n\n    # create previews\n    full = expect(\"create full\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/full\"}, token_a)\n    check(\"full fields\", isinstance(full, dict), repr(full))\n    check(\"full title\", full[\"title\"] == \"OG Title & More\", repr(full.get(\"title\")))\n    check(\n        \"full description\",\n        full[\"description\"] == \"OG description text\",\n        repr(full.get(\"description\")),\n    )\n    check(\"full image\", full[\"image_url\"] == f\"{FIXTURE}/images/pic.png\", repr(full.get(\"image_url\")))\n    check(\"full final_url\", full[\"final_url\"] == f\"{FIXTURE}/full\", repr(full.get(\"final_url\")))\n    check(\"full status\", full[\"status_code\"] == 200, repr(full.get(\"status_code\")))\n    check(\"full url\", full[\"url\"] == f\"{FIXTURE}/full\", repr(full.get(\"url\")))\n    check(\"full fetched_at\", isinstance(full.get(\"fetched_at\"), str) and full[\"fetched_at\"], repr(full))\n    check(\"full id\", isinstance(full.get(\"id\"), int), repr(full))\n\n    basic = expect(\"create basic\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/basic\"}, token_a)\n    check(\"basic title\", basic[\"title\"] == \"Basic Page Title\", repr(basic.get(\"title\")))\n    check(\n        \"basic description\",\n        basic[\"description\"] == \"Just a meta description.\",\n        repr(basic.get(\"description\")),\n    )\n    check(\"basic image empty\", basic[\"image_url\"] == \"\", repr(basic.get(\"image_url\")))\n\n    entities = expect(\n        \"create entities\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/entities\"}, token_a\n    )\n    check(\"entities title\", entities[\"title\"] == \"Rocks & Rolls\", repr(entities.get(\"title\")))\n    check(\n        \"entities description\",\n        entities[\"description\"] == \"A bold claim & more\",\n        repr(entities.get(\"description\")),\n    )\n\n    no_desc = expect(\n        \"create no description\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/no-desc\"}, token_a\n    )\n    check(\"no description empty\", no_desc[\"description\"] == \"\", repr(no_desc.get(\"description\")))\n\n    redirected = expect(\n        \"create redirect\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/redirect\"}, token_a\n    )\n    check(\"redirect final_url\", redirected[\"final_url\"] == f\"{FIXTURE}/full\", repr(redirected.get(\"final_url\")))\n    check(\"redirect keeps url\", redirected[\"url\"] == f\"{FIXTURE}/redirect\", repr(redirected.get(\"url\")))\n    check(\"redirect status\", redirected[\"status_code\"] == 200, repr(redirected.get(\"status_code\")))\n\n    relative = expect(\n        \"create relative image\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/relative\"}, token_a\n    )\n    check(\n        \"relative image resolved\",\n        relative[\"image_url\"] == f\"{FIXTURE}/images/pic2.png\",\n        repr(relative.get(\"image_url\")),\n    )\n\n    notfound = expect(\n        \"create 404 page\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/notfound\"}, token_a\n    )\n    check(\"404 status stored\", notfound[\"status_code\"] == 404, repr(notfound.get(\"status_code\")))\n    check(\"404 title stored\", notfound[\"title\"] == \"Not Found Here\", repr(notfound.get(\"title\")))\n\n    json_page = expect(\n        \"create non-html\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/data.json\"}, token_a\n    )\n    check(\"non-html title empty\", json_page[\"title\"] == \"\", repr(json_page.get(\"title\")))\n\n    expect(\"create schemeless\", \"POST\", \"/api/previews\", 400, {\"url\": \"ftp://example.com/x\"}, token_a)\n    expect(\"create missing url\", \"POST\", \"/api/previews\", 400, {}, token_a)\n    expect(\"create unreachable\", \"POST\", \"/api/previews\", 502, {\"url\": \"http://127.0.0.1:1/none\"}, token_a)\n\n    # one duplicate URL so totals are a convenient shape\n    expect(\"create full again\", \"POST\", \"/api/previews\", 201, {\"url\": f\"{FIXTURE}/full\"}, token_a)\n\n    # pagination: newest first\n    status, page1 = call(\"GET\", \"/api/previews?page=1&page_size=4\", token=token_a)\n    check(\"list status\", status == 200, str(status))\n    ids = [item[\"id\"] for item in page1[\"items\"]]\n    check(\"page1 size\", len(ids) == 4, repr(ids))\n    check(\"page1 newest first\", ids == sorted(ids, reverse=True), repr(ids))\n    check(\n        \"page1 meta\",\n        page1[\"page\"] == 1 and page1[\"page_size\"] == 4,\n        repr({k: page1[k] for k in (\"page\", \"page_size\")}),\n    )\n    total = page1[\"total\"]\n    check(\"total\", total == 9, repr(total))\n\n    status, page2 = call(\"GET\", \"/api/previews?page=2&page_size=4\", token=token_a)\n    ids2 = [item[\"id\"] for item in page2[\"items\"]]\n    check(\"page2 size\", len(ids2) == 4, repr(ids2))\n    check(\"page2 offset\", max(ids2) < min(ids), repr((ids, ids2)))\n    status, page3 = call(\"GET\", \"/api/previews?page=3&page_size=4\", token=token_a)\n    check(\"page3 size\", len(page3[\"items\"]) == 1, repr(page3[\"items\"]))\n    status, page9 = call(\"GET\", \"/api/previews?page=9&page_size=4\", token=token_a)\n    check(\"page beyond end\", page9[\"items\"] == [] and page9[\"total\"] == total, repr(page9))\n    status, defaults = call(\"GET\", \"/api/previews\", token=token_a)\n    check(\"default paging\", defaults[\"page\"] == 1 and defaults[\"page_size\"] == 10, repr(defaults))\n\n    # single preview\n    target_id = full[\"id\"]\n    status, fetched = call(\"GET\", f\"/api/previews/{target_id}\", token=token_a)\n    check(\"get own\", status == 200 and fetched[\"id\"] == target_id, f\"{status} {fetched}\")\n    check(\"get own title\", fetched[\"title\"] == \"OG Title & More\", repr(fetched.get(\"title\")))\n    expect(\"get missing\", \"GET\", \"/api/previews/999999\", 404, token=token_a)\n    expect(\"get non-int id\", \"GET\", \"/api/previews/abc\", 404, token=token_a)\n\n    # cross-user isolation\n    expect(\"other get\", \"GET\", f\"/api/previews/{target_id}\", 404, token=token_b)\n    expect(\"other refresh\", \"POST\", f\"/api/previews/{target_id}/refresh\", 404, token=token_b)\n    expect(\"other delete\", \"DELETE\", f\"/api/previews/{target_id}\", 404, token=token_b)\n    status, bob_list = call(\"GET\", \"/api/previews\", token=token_b)\n    check(\"bob sees nothing\", bob_list[\"items\"] == [] and bob_list[\"total\"] == 0, repr(bob_list))\n\n    # refresh\n    before = fetched[\"fetched_at\"]\n    time.sleep(1.1)\n    status, refreshed = call(\"POST\", f\"/api/previews/{target_id}/refresh\", body={}, token=token_a)\n    check(\"refresh status\", status == 200, f\"{status} {refreshed}\")\n    check(\"refresh keeps title\", refreshed[\"title\"] == \"OG Title & More\", repr(refreshed.get(\"title\")))\n    check(\n        \"refresh updates fetched_at\",\n        refreshed[\"fetched_at\"] > before,\n        f\"{before} -> {refreshed['fetched_at']}\",\n    )\n\n    # delete\n    status, _ = call(\"DELETE\", f\"/api/previews/{target_id}\", token=token_a)\n    check(\"delete status\", status == 204, str(status))\n    expect(\"get after delete\", \"GET\", f\"/api/previews/{target_id}\", 404, token=token_a)\n    status, after = call(\"GET\", \"/api/previews\", token=token_a)\n    check(\"delete reduces total\", after[\"total\"] == total - 1, repr(after[\"total\"]))\n    status, _ = call(\"DELETE\", f\"/api/previews/{target_id}\", token=token_a)\n    check(\"delete twice\", status == 404, str(status))\n\n    # bob still sees nothing after alice's activity\n    status, bob_list = call(\"GET\", \"/api/previews\", token=token_b)\n    check(\"bob still empty\", bob_list[\"total\"] == 0, repr(bob_list))\n\n    print(f\"\\n{passed} checks passed, {len(failed)} failed\")\n    if failed:\n        for item in failed:\n            print(\" -\", item)\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/workspace/.scratch/test_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.scratch/test_api.py","exists":false,"truncated":false},"title":".scratch/test_api.py","time":{"start":1794363612627,"end":1794363612642}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c867ddc9001snx84hNwi8gpwd","sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","messageID":"msg_1c8668dcf001PMlQfv4q0xpOlA"}}
