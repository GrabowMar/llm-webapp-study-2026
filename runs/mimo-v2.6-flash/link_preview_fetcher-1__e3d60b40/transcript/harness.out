{"type":"tool_use","timestamp":1794363209047,"sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","part":{"type":"tool","tool":"write","callID":"call_260004570496402692b7892d","state":{"status":"completed","input":{"content":"import type { Preview } from \"../api\";\nimport PreviewCard from \"./PreviewCard\";\n\ninterface Props {\n  items: Preview[];\n  total: number;\n  page: number;\n  pageSize: number;\n  loading: boolean;\n  error: string | null;\n  onPageChange: (page: number) => void;\n  onRefresh: (id: number) => Promise<void>;\n  onDelete: (id: number) => Promise<void>;\n}\n\nexport default function PreviewList({\n  items,\n  total,\n  page,\n  pageSize,\n  loading,\n  error,\n  onPageChange,\n  onRefresh,\n  onDelete,\n}: Props) {\n  const pages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <section className=\"space-y-4\">\n      {error && (\n        <p className=\"rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n\n      {loading && items.length === 0 && (\n        <p className=\"py-8 text-center text-sm text-slate-500\">Loading previews…</p>\n      )}\n\n      {!loading && items.length === 0 && !error && (\n        <p className=\"rounded-xl border border-dashed border-slate-300 bg-white px-4 py-10 text-center text-sm text-slate-500\">\n          No previews yet. Paste a link above to save one.\n        </p>\n      )}\n\n      {items.length > 0 && (\n        <div className=\"grid gap-4 sm:grid-cols-2\">\n          {items.map((preview) => (\n            <PreviewCard\n              key={preview.id}\n              preview={preview}\n              onRefresh={onRefresh}\n              onDelete={onDelete}\n            />\n          ))}\n        </div>\n      )}\n\n      {pages > 1 && (\n        <nav className=\"flex items-center justify-between gap-3\" aria-label=\"Pagination\">\n          <button\n            type=\"button\"\n            onClick={() => onPageChange(page - 1)}\n            disabled={page <= 1}\n            className=\"rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            Previous\n          </button>\n          <span className=\"text-sm text-slate-500\">\n            Page {page} of {pages}\n          </span>\n          <button\n            type=\"button\"\n            onClick={() => onPageChange(page + 1)}\n            disabled={page >= pages}\n            className=\"rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            Next\n          </button>\n        </nav>\n      )}\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/PreviewList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/PreviewList.tsx","exists":false,"truncated":false},"title":"frontend/src/components/PreviewList.tsx","time":{"start":1794363209009,"end":1794363209024}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c861b52c001wlVB6Tn8I1Y3Kq","sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","messageID":"msg_1c86115b7001rfVJ4bwDIMzrUS"}}
{"type":"tool_use","timestamp":1794363209048,"sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","part":{"type":"tool","tool":"write","callID":"call_126dee3151c5429baa631f51","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  TOKEN_KEY,\n  USERNAME_KEY,\n  createPreview,\n  deletePreview,\n  listPreviews,\n  messageOf,\n  refreshPreview,\n  type Preview,\n  type Session,\n} from \"./api\";\nimport AddLinkForm from \"./components/AddLinkForm\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport PreviewList from \"./components/PreviewList\";\n\nconst PAGE_SIZE = 10;\n\nfunction loadSession(): Session | null {\n  const token = localStorage.getItem(TOKEN_KEY);\n  const username = localStorage.getItem(USERNAME_KEY);\n  return token && username ? { token, username } : null;\n}\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n  const [items, setItems] = useState<Preview[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [loading, setLoading] = useState(false);\n  const [listError, setListError] = useState<string | null>(null);\n\n  const signOut = useCallback(() => {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USERNAME_KEY);\n    setSession(null);\n    setItems([]);\n    setTotal(0);\n    setPage(1);\n    setListError(null);\n  }, []);\n\n  const loadPage = useCallback(\n    async (target: number) => {\n      setLoading(true);\n      setListError(null);\n      try {\n        const data = await listPreviews(target, PAGE_SIZE);\n        setItems(data.items);\n        setTotal(data.total);\n        setPage(data.page);\n      } catch (error) {\n        if (error instanceof ApiError && error.status === 401) {\n          signOut();\n          return;\n        }\n        setListError(messageOf(error));\n      } finally {\n        setLoading(false);\n      }\n    },\n    [signOut],\n  );\n\n  useEffect(() => {\n    if (session) {\n      void loadPage(1);\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [session]);\n\n  function handleAuth(next: Session) {\n    localStorage.setItem(TOKEN_KEY, next.token);\n    localStorage.setItem(USERNAME_KEY, next.username);\n    setSession(next);\n  }\n\n  async function guard<T>(work: () => Promise<T>): Promise<T> {\n    try {\n      return await work();\n    } catch (error) {\n      if (error instanceof ApiError && error.status === 401) signOut();\n      throw error;\n    }\n  }\n\n  const handleAdd = async (url: string) => {\n    await guard(() => createPreview(url));\n    await loadPage(1);\n  };\n\n  const handleRefresh = async (id: number) => {\n    const updated = await guard(() => refreshPreview(id));\n    setItems((current) => current.map((item) => (item.id === id ? updated : item)));\n  };\n\n  const handleDelete = async (id: number) => {\n    await guard(() => deletePreview(id));\n    if (items.length === 1 && page > 1) {\n      await loadPage(page - 1);\n    } else {\n      await loadPage(page);\n    }\n  };\n\n  if (!session) {\n    return <AuthPanel onAuth={handleAuth} />;\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-3\">\n          <h1 className=\"text-lg font-semibold\">Link previews</h1>\n          <div className=\"flex items-center gap-3\">\n            <span className=\"max-w-40 truncate text-sm text-slate-600\">\n              {session.username}\n            </span>\n            <button\n              type=\"button\"\n              onClick={signOut}\n              className=\"rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50\"\n            >\n              Sign out\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-4xl space-y-6 px-4 py-6\">\n        <AddLinkForm onAdd={handleAdd} />\n        <PreviewList\n          items={items}\n          total={total}\n          page={page}\n          pageSize={PAGE_SIZE}\n          loading={loading}\n          error={listError}\n          onPageChange={(next) => void loadPage(next)}\n          onRefresh={handleRefresh}\n          onDelete={handleDelete}\n        />\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794363209015,"end":1794363209029}},"id":"prt_1c861b533001Es35bM5pRhtAQI","sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","messageID":"msg_1c86115b7001rfVJ4bwDIMzrUS"}}
