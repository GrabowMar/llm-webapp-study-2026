{"type":"tool_use","timestamp":1794362963005,"sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","part":{"type":"tool","tool":"write","callID":"call_3b5cc8abb38e4a8eb3a4d7da","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nfrom db import close_db, get_db, init_db\nfrom fetcher import FetchError, InvalidURL, fetch_preview\nfrom security import hash_password, new_token, verify_password\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_PATH = Path(__file__).resolve().parent.parent / \"data\"\n\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.teardown_appcontext(close_db)\ninit_db()\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef _token_user_id() -> int | None:\n    scheme, _, token = request.headers.get(\"Authorization\", \"\").partition(\" \")\n    token = token.strip()\n    if scheme.strip().lower() != \"bearer\" or not token:\n        return None\n    row = get_db().execute(\n        \"SELECT user_id FROM sessions WHERE token = ?\", (token,)\n    ).fetchone()\n    return int(row[\"user_id\"]) if row else None\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user_id = _token_user_id()\n        if user_id is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user_id = user_id\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef _preview_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\ndef _get_own_preview(preview_id: int) -> sqlite3.Row | None:\n    return get_db().execute(\n        \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, g.user_id),\n    ).fetchone()\n\n\ndef _page_params() -> tuple[int, int]:\n    def parse(name: str, default: int, low: int, high: int) -> int:\n        raw = request.args.get(name)\n        if raw is None or not str(raw).strip():\n            return default\n        try:\n            value = int(raw)\n        except (TypeError, ValueError):\n            return default\n        return max(low, min(value, high))\n\n    page = parse(\"page\", 1, 1, 1_000_000)\n    page_size = parse(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    return page, page_size\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _json_body()\n    username = str(data.get(\"username\") or \"\").strip()\n    password = str(data.get(\"password\") or \"\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    try:\n        cursor = get_db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, hash_password(password), utc_now()),\n        )\n        get_db().commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _json_body()\n    username = str(data.get(\"username\") or \"\").strip()\n    password = str(data.get(\"password\") or \"\")\n    row = None\n    if username and password:\n        row = get_db().execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    token = new_token()\n    get_db().execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utc_now()),\n    )\n    get_db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/previews\")\n@login_required\ndef create_preview():\n    data = _json_body()\n    url = str(data.get(\"url\") or \"\").strip()\n    if not url:\n        return jsonify({\"error\": \"url is required\"}), 400\n    try:\n        fetched = fetch_preview(url)\n    except InvalidURL as error:\n        return jsonify({\"error\": str(error)}), 400\n    except FetchError as error:\n        return jsonify({\"error\": str(error)}), 502\n\n    now = utc_now()\n    cursor = get_db().execute(\n        \"\"\"\n        INSERT INTO previews\n            (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            g.user_id,\n            url,\n            fetched.final_url,\n            fetched.status_code,\n            fetched.title,\n            fetched.description,\n            fetched.image_url,\n            now,\n        ),\n    )\n    get_db().commit()\n    row = _get_own_preview(int(cursor.lastrowid))\n    return jsonify(_preview_json(row)), 201\n\n\n@app.get(\"/api/previews\")\n@login_required\ndef list_previews():\n    page, page_size = _page_params()\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user_id,)\n    ).fetchone()[0]\n    rows = db.execute(\n        \"\"\"\n        SELECT * FROM previews WHERE user_id = ?\n        ORDER BY id DESC LIMIT ? OFFSET ?\n        \"\"\",\n        (g.user_id, page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [_preview_json(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@login_required\ndef get_preview(preview_id: int):\n    row = _get_own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"preview not found\"}), 404\n    return jsonify(_preview_json(row))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@login_required\ndef refresh_preview(preview_id: int):\n    row = _get_own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"preview not found\"}), 404\n    try:\n        fetched = fetch_preview(row[\"url\"])\n    except InvalidURL as error:\n        return jsonify({\"error\": str(error)}), 400\n    except FetchError as error:\n        return jsonify({\"error\": str(error)}), 502\n    get_db().execute(\n        \"\"\"\n        UPDATE previews\n        SET final_url = ?, status_code = ?, title = ?, description = ?,\n            image_url = ?, fetched_at = ?\n        WHERE id = ? AND user_id = ?\n        \"\"\",\n        (\n            fetched.final_url,\n            fetched.status_code,\n            fetched.title,\n            fetched.description,\n            fetched.image_url,\n            utc_now(),\n            preview_id,\n            g.user_id,\n        ),\n    )\n    get_db().commit()\n    return jsonify(_preview_json(_get_own_preview(preview_id)))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@login_required\ndef delete_preview(preview_id: int):\n    row = _get_own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"preview not found\"}), 404\n    get_db().execute(\n        \"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, g.user_id),\n    )\n    get_db().commit()\n    return \"\", 204\n\n\n@app.route(\"/api/<path:rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef unknown_api(rest: str):\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794362962940,"end":1794362962982}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c85df3f5001erzX9I69Hsknro","sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","messageID":"msg_1c85ce170001TkLNGGgZVRRZ8P"}}
