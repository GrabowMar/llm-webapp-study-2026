{"type":"tool_use","timestamp":1794364564394,"sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","part":{"type":"tool","tool":"read","callID":"call_9342d7b548a14e18aaeb89da","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import sqlite3\n6: from datetime import datetime, timezone\n7: from functools import wraps\n8: from pathlib import Path\n9: \n10: from flask import Flask, g, jsonify, request, send_from_directory\n11: \n12: from db import close_db, get_db, init_db\n13: from fetcher import FetchError, InvalidURL, fetch_preview\n14: from security import hash_password, new_token, verify_password\n15: \n16: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n17: \n18: DEFAULT_PAGE_SIZE = 10\n19: MAX_PAGE_SIZE = 100\n20: \n21: app = Flask(__name__, static_folder=None)\n22: app.teardown_appcontext(close_db)\n23: init_db()\n24: \n25: \n26: def utc_now() -> str:\n27:     return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n28: \n29: \n30: def _json_body() -> dict:\n31:     data = request.get_json(silent=True, force=True)\n32:     return data if isinstance(data, dict) else {}\n33: \n34: \n35: def _token_user_id() -> int | None:\n36:     scheme, _, token = request.headers.get(\"Authorization\", \"\").partition(\" \")\n37:     token = token.strip()\n38:     if scheme.strip().lower() != \"bearer\" or not token:\n39:         return None\n40:     row = get_db().execute(\n41:         \"SELECT user_id FROM sessions WHERE token = ?\", (token,)\n42:     ).fetchone()\n43:     return int(row[\"user_id\"]) if row else None\n44: \n45: \n46: def login_required(view):\n47:     @wraps(view)\n48:     def wrapped(*args, **kwargs):\n49:         user_id = _token_user_id()\n50:         if user_id is None:\n51:             return jsonify({\"error\": \"authentication required\"}), 401\n52:         g.user_id = user_id\n53:         return view(*args, **kwargs)\n54: \n55:     return wrapped\n56: \n57: \n58: def _preview_json(row: sqlite3.Row) -> dict:\n59:     return {\n60:         \"id\": row[\"id\"],\n61:         \"url\": row[\"url\"],\n62:         \"final_url\": row[\"final_url\"],\n63:         \"status_code\": row[\"status_code\"],\n64:         \"title\": row[\"title\"],\n65:         \"description\": row[\"description\"],\n66:         \"image_url\": row[\"image_url\"],\n67:         \"fetched_at\": row[\"fetched_at\"],\n68:     }\n69: \n70: \n71: def _get_own_preview(preview_id: int) -> sqlite3.Row | None:\n72:     return get_db().execute(\n73:         \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n74:         (preview_id, g.user_id),\n75:     ).fetchone()\n76: \n77: \n78: def _page_params() -> tuple[int, int]:\n79:     def parse(name: str, default: int, low: int, high: int) -> int:\n80:         raw = request.args.get(name)\n81:         if raw is None or not str(raw).strip():\n82:             return default\n83:         try:\n84:             value = int(raw)\n85:         except (TypeError, ValueError):\n86:             return default\n87:         return max(low, min(value, high))\n88: \n89:     page = parse(\"page\", 1, 1, 1_000_000)\n90:     page_size = parse(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n91:     return page, page_size\n92: \n93: \n94: @app.get(\"/api/health\")\n95: def health():\n96:     return {\"status\": \"ok\"}\n97: \n98: \n99: @app.post(\"/api/auth/register\")\n100: def register():\n101:     data = _json_body()\n102:     username = str(data.get(\"username\") or \"\").strip()\n103:     password = str(data.get(\"password\") or \"\")\n104:     if not username or not password:\n105:         return jsonify({\"error\": \"username and password are required\"}), 400\n106:     try:\n107:         cursor = get_db().execute(\n108:             \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n109:             (username, hash_password(password), utc_now()),\n110:         )\n111:         get_db().commit()\n112:     except sqlite3.IntegrityError:\n113:         return jsonify({\"error\": \"username already taken\"}), 409\n114:     return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n115: \n116: \n117: @app.post(\"/api/auth/login\")\n118: def login():\n119:     data = _json_body()\n120:     username = str(data.get(\"username\") or \"\").strip()\n121:     password = str(data.get(\"password\") or \"\")\n122:     row = None\n123:     if username and password:\n124:         row = get_db().execute(\n125:             \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n126:         ).fetchone()\n127:     if row is None or not verify_password(password, row[\"password_hash\"]):\n128:         return jsonify({\"error\": \"invalid username or password\"}), 401\n129:     token = new_token()\n130:     get_db().execute(\n131:         \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n132:         (token, row[\"id\"], utc_now()),\n133:     )\n134:     get_db().commit()\n135:     return jsonify({\"token\": token}), 200\n136: \n137: \n138: @app.post(\"/api/previews\")\n139: @login_required\n140: def create_preview():\n141:     data = _json_body()\n142:     url = str(data.get(\"url\") or \"\").strip()\n143:     if not url:\n144:         return jsonify({\"error\": \"url is required\"}), 400\n145:     try:\n146:         fetched = fetch_preview(url)\n147:     except InvalidURL as error:\n148:         return jsonify({\"error\": str(error)}), 400\n149:     except FetchError as error:\n150:         return jsonify({\"error\": str(error)}), 502\n151: \n152:     now = utc_now()\n153:     cursor = get_db().execute(\n154:         \"\"\"\n155:         INSERT INTO previews\n156:             (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\n157:         VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n158:         \"\"\",\n159:         (\n160:             g.user_id,\n161:             url,\n162:             fetched.final_url,\n163:             fetched.status_code,\n164:             fetched.title,\n165:             fetched.description,\n166:             fetched.image_url,\n167:             now,\n168:         ),\n169:     )\n170:     get_db().commit()\n171:     row = _get_own_preview(int(cursor.lastrowid))\n172:     return jsonify(_preview_json(row)), 201\n173: \n174: \n175: @app.get(\"/api/previews\")\n176: @login_required\n177: def list_previews():\n178:     page, page_size = _page_params()\n179:     db = get_db()\n180:     total = db.execute(\n181:         \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user_id,)\n182:     ).fetchone()[0]\n183:     rows = db.execute(\n184:         \"\"\"\n185:         SELECT * FROM previews WHERE user_id = ?\n186:         ORDER BY id DESC LIMIT ? OFFSET ?\n187:         \"\"\",\n188:         (g.user_id, page_size, (page - 1) * page_size),\n189:     ).fetchall()\n190:     return jsonify(\n191:         {\n192:             \"items\": [_preview_json(row) for row in rows],\n193:             \"total\": total,\n194:             \"page\": page,\n195:             \"page_size\": page_size,\n196:         }\n197:     )\n198: \n199: \n200: @app.get(\"/api/previews/<int:preview_id>\")\n201: @login_required\n202: def get_preview(preview_id: int):\n203:     row = _get_own_preview(preview_id)\n204:     if row is None:\n205:         return jsonify({\"error\": \"preview not found\"}), 404\n206:     return jsonify(_preview_json(row))\n207: \n208: \n209: @app.post(\"/api/previews/<int:preview_id>/refresh\")\n210: @login_required\n211: def refresh_preview(preview_id: int):\n212:     row = _get_own_preview(preview_id)\n213:     if row is None:\n214:         return jsonify({\"error\": \"preview not found\"}), 404\n215:     try:\n216:         fetched = fetch_preview(row[\"url\"])\n217:     except InvalidURL as error:\n218:         return jsonify({\"error\": str(error)}), 400\n219:     except FetchError as error:\n220:         return jsonify({\"error\": str(error)}), 502\n221:     get_db().execute(\n222:         \"\"\"\n223:         UPDATE previews\n224:         SET final_url = ?, status_code = ?, title = ?, description = ?,\n225:             image_url = ?, fetched_at = ?\n226:         WHERE id = ? AND user_id = ?\n227:         \"\"\",\n228:         (\n229:             fetched.final_url,\n230:             fetched.status_code,\n231:             fetched.title,\n232:             fetched.description,\n233:             fetched.image_url,\n234:             utc_now(),\n235:             preview_id,\n236:             g.user_id,\n237:         ),\n238:     )\n239:     get_db().commit()\n240:     return jsonify(_preview_json(_get_own_preview(preview_id)))\n241: \n242: \n243: @app.delete(\"/api/previews/<int:preview_id>\")\n244: @login_required\n245: def delete_preview(preview_id: int):\n246:     row = _get_own_preview(preview_id)\n247:     if row is None:\n248:         return jsonify({\"error\": \"preview not found\"}), 404\n249:     get_db().execute(\n250:         \"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n251:         (preview_id, g.user_id),\n252:     )\n253:     get_db().commit()\n254:     return \"\", 204\n255: \n256: \n257: @app.route(\"/api/<path:rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\n258: def unknown_api(rest: str):\n259:     return jsonify({\"error\": \"not found\"}), 404\n260: \n261: \n262: @app.get(\"/\")\n263: @app.get(\"/<path:path>\")\n264: def frontend(path: str = \"index.html\"):\n265:     if (DIST / path).is_file():\n266:         return send_from_directory(DIST, path)\n267:     return send_from_directory(DIST, \"index.html\")\n\n(End of file - total 267 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nfrom db import close_db, get_db, init_db\nfrom fetcher import FetchError, InvalidURL, fetch_preview\nfrom security import hash_password, new_token, verify_password\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nfrom db import close_db, get_db, init_db\nfrom fetcher import FetchError, InvalidURL, fetch_preview\nfrom security import hash_password, new_token, verify_password\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.teardown_appcontext(close_db)\ninit_db()\n\n\ndef utc_now() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _json_body() -> dict:\n    data = request.get_json(silent=True, force=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef _token_user_id() -> int | None:\n    scheme, _, token = request.headers.get(\"Authorization\", \"\").partition(\" \")\n    token = token.strip()\n    if scheme.strip().lower() != \"bearer\" or not token:\n        return None\n    row = get_db().execute(\n        \"SELECT user_id FROM sessions WHERE token = ?\", (token,)\n    ).fetchone()\n    return int(row[\"user_id\"]) if row else None\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapped(*args, **kwargs):\n        user_id = _token_user_id()\n        if user_id is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user_id = user_id\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef _preview_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\ndef _get_own_preview(preview_id: int) -> sqlite3.Row | None:\n    return get_db().execute(\n        \"SELECT * FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, g.user_id),\n    ).fetchone()\n\n\ndef _page_params() -> tuple[int, int]:\n    def parse(name: str, default: int, low: int, high: int) -> int:\n        raw = request.args.get(name)\n        if raw is None or not str(raw).strip():\n            return default\n        try:\n            value = int(raw)\n        except (TypeError, ValueError):\n            return default\n        return max(low, min(value, high))\n\n    page = parse(\"page\", 1, 1, 1_000_000)\n    page_size = parse(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    return page, page_size\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _json_body()\n    username = str(data.get(\"username\") or \"\").strip()\n    password = str(data.get(\"password\") or \"\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    try:\n        cursor = get_db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, hash_password(password), utc_now()),\n        )\n        get_db().commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _json_body()\n    username = str(data.get(\"username\") or \"\").strip()\n    password = str(data.get(\"password\") or \"\")\n    row = None\n    if username and password:\n        row = get_db().execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n    if row is None or not verify_password(password, row[\"password_hash\"]):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    token = new_token()\n    get_db().execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utc_now()),\n    )\n    get_db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/previews\")\n@login_required\ndef create_preview():\n    data = _json_body()\n    url = str(data.get(\"url\") or \"\").strip()\n    if not url:\n        return jsonify({\"error\": \"url is required\"}), 400\n    try:\n        fetched = fetch_preview(url)\n    except InvalidURL as error:\n        return jsonify({\"error\": str(error)}), 400\n    except FetchError as error:\n        return jsonify({\"error\": str(error)}), 502\n\n    now = utc_now()\n    cursor = get_db().execute(\n        \"\"\"\n        INSERT INTO previews\n            (user_id, url, final_url, status_code, title, description, image_url, fetched_at)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (\n            g.user_id,\n            url,\n            fetched.final_url,\n            fetched.status_code,\n            fetched.title,\n            fetched.description,\n            fetched.image_url,\n            now,\n        ),\n    )\n    get_db().commit()\n    row = _get_own_preview(int(cursor.lastrowid))\n    return jsonify(_preview_json(row)), 201\n\n\n@app.get(\"/api/previews\")\n@login_required\ndef list_previews():\n    page, page_size = _page_params()\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user_id,)\n    ).fetchone()[0]\n    rows = db.execute(\n        \"\"\"\n        SELECT * FROM previews WHERE user_id = ?\n        ORDER BY id DESC LIMIT ? OFFSET ?\n        \"\"\",\n        (g.user_id, page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [_preview_json(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@login_required\ndef get_preview(preview_id: int):\n    row = _get_own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"preview not found\"}), 404\n    return jsonify(_preview_json(row))\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@login_required\ndef refresh_preview(preview_id: int):\n    row = _get_own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"preview not found\"}), 404\n    try:\n        fetched = fetch_preview(row[\"url\"])\n    except InvalidURL as error:\n        return jsonify({\"error\": str(error)}), 400\n    except FetchError as error:\n        return jsonify({\"error\": str(error)}), 502\n    get_db().execute(\n        \"\"\"\n        UPDATE previews\n        SET final_url = ?, status_code = ?, title = ?, description = ?,\n            image_url = ?, fetched_at = ?\n        WHERE id = ? AND user_id = ?\n        \"\"\",\n        (\n            fetched.final_url,\n            fetched.status_code,\n            fetched.title,\n            fetched.description,\n            fetched.image_url,\n            utc_now(),\n            preview_id,\n            g.user_id,\n        ),\n    )\n    get_db().commit()\n    return jsonify(_preview_json(_get_own_preview(preview_id)))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@login_required\ndef delete_preview(preview_id: int):\n    row = _get_own_preview(preview_id)\n    if row is None:\n        return jsonify({\"error\": \"preview not found\"}), 404\n    get_db().execute(\n        \"DELETE FROM previews WHERE id = ? AND user_id = ?\",\n        (preview_id, g.user_id),\n    )\n    get_db().commit()\n    return \"\", 204\n\n\n@app.route(\"/api/<path:rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef unknown_api(rest: str):\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":267,"totalLines":267,"truncated":false}},"title":"backend/app.py","time":{"start":1794364564319,"end":1794364564391}},"id":"prt_1c8766358001BktrrflerbFfgc","sessionID":"ses_e37ac4e01ffeXNi8x5cqzCz6dT","messageID":"msg_1c875f5f1001CUqSEs4O76c9jH"}}
