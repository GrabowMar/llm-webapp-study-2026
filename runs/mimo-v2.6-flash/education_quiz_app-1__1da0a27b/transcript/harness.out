{"type":"tool_use","timestamp":1794303596508,"sessionID":"ses_e3b52291effew79zs8gkkk9TtK","part":{"type":"tool","tool":"write","callID":"call_4cc53f51b34143b3969e2a16","state":{"status":"completed","input":{"content":"import json\nimport os\nimport re\nimport signal\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8012\"\nBACKEND_DIR = \"/workspace/backend\"\nGUNICORN = \"/workspace/.venv/bin/gunicorn\"\n\npassed = 0\nfailed = 0\n\n\ndef check(label, condition, detail=\"\"):\n    global passed, failed\n    if condition:\n        passed += 1\n        print(f\"PASS {label}\")\n    else:\n        failed += 1\n        print(f\"FAIL {label} {detail}\")\n\n\ndef request(method, path, body=None, token=None, expect=200):\n    data = json.dumps(body).encode() if body is not None else None\n    headers = {\"Content-Type\": \"application/json\"}\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    req = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req, timeout=10) as resp:\n            status = resp.status\n            raw = resp.read()\n    except urllib.error.HTTPError as e:\n        status = e.code\n        raw = e.read()\n    try:\n        parsed = json.loads(raw) if raw else None\n    except json.JSONDecodeError:\n        parsed = None\n    return status, parsed, raw\n\n\ndef main():\n    env = dict(os.environ, ADMIN_PASSWORD=\"secret-admin\")\n    proc = subprocess.Popen(\n        [GUNICORN, \"--bind\", \"127.0.0.1:8012\", \"--pythonpath\", BACKEND_DIR, \"app:app\"],\n        cwd=\"/workspace\",\n        env=env,\n        stdout=subprocess.DEVNULL,\n        stderr=subprocess.DEVNULL,\n        start_new_session=True,\n    )\n    try:\n        for _ in range(50):\n            try:\n                status, _, _ = request(\"GET\", \"/api/health\")\n                if status == 200:\n                    break\n            except Exception:\n                pass\n            time.sleep(0.2)\n        else:\n            print(\"server did not start\")\n            return 1\n\n        # Health + frontend serving\n        status, health, _ = request(\"GET\", \"/api/health\")\n        check(\"health 200\", status == 200 and health == {\"status\": \"ok\"}, str(health))\n\n        req = urllib.request.Request(BASE + \"/\")\n        with urllib.request.urlopen(req, timeout=10) as resp:\n            html = resp.read().decode()\n        check(\"GET / serves SPA\", resp.status == 200 and 'id=\"root\"' in html)\n        check(\"index title Quiz\", \"<title>Quiz</title>\" in html)\n\n        asset = re.search(r'src=\"(/assets/[^\"]+\\.js)\"', html)\n        check(\"js asset referenced\", asset is not None)\n        if asset:\n            areq = urllib.request.Request(BASE + asset.group(1))\n            with urllib.request.urlopen(areq, timeout=10) as aresp:\n                js = aresp.read()\n            check(\"js asset served\", aresp.status == 200 and len(js) > 1000)\n        css = re.search(r'href=\"(/assets/[^\"]+\\.css)\"', html)\n        check(\"css asset referenced\", css is not None)\n        if css:\n            creq = urllib.request.Request(BASE + css.group(1))\n            with urllib.request.urlopen(creq, timeout=10) as cresp:\n                csstext = cresp.read().decode()\n            check(\"css has tailwind utilities\", \"bg-indigo-600\" in csstext)\n\n        # SPA fallback for deep links, API still guarded\n        status, _, _ = request(\"GET\", \"/some/deep/link\")\n        check(\"SPA fallback deep link\", status == 200)\n        status, body, _ = request(\"GET\", \"/api/nope\")\n        check(\"unknown API 404 json\", status == 404 and body and \"error\" in body, str(body))\n        status, body, _ = request(\"POST\", \"/api/health\")\n        check(\"method not allowed 405\", status == 405 and body and \"error\" in body, str(body))\n\n        # Quiz draw\n        status, quiz, _ = request(\"GET\", \"/api/quiz?count=5\")\n        items = (quiz or {}).get(\"items\", [])\n        check(\"quiz draw 200\", status == 200)\n        check(\"quiz count 5\", len(items) == 5, str(len(items)))\n        check(\n            \"quiz no correct_option\",\n            items and all(\"correct_option\" not in q for q in items),\n        )\n        check(\"quiz has options\", items and all(all(f\"option_{c}\" in q for c in \"abcd\") for q in items))\n        check(\"quiz ids unique\", len({q[\"id\"] for q in items}) == 5)\n\n        status, body, _ = request(\"GET\", \"/api/quiz?count=0\")\n        check(\"quiz count=0 400\", status == 400 and body and \"error\" in body, str(body))\n        status, body, _ = request(\"GET\", \"/api/quiz?count=101\")\n        check(\"quiz count=101 400\", status == 400 and body and \"error\" in body, str(body))\n\n        # Auth flow\n        status, body, _ = request(\n            \"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123456\"}\n        )\n        check(\"register 201\", status == 201, str(body))\n        status, body, _ = request(\n            \"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123456\"}\n        )\n        check(\"register dup 409\", status == 409 and body.get(\"error\") == \"username already taken\", str(body))\n        status, body, _ = request(\n            \"POST\", \"/api/auth/register\", {\"username\": \"Admin\", \"password\": \"pw123456\"}\n        )\n        check(\"register reserved 409\", status == 409 and body.get(\"error\") == \"username is reserved\", str(body))\n\n        status, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\n        check(\"login bad password 401\", status == 401, str(body))\n\n        status, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw123456\"})\n        check(\"login 200 token\", status == 200 and re.fullmatch(r\"[0-9a-f]{64}\", body.get(\"token\", \"\")), str(body))\n        alice_token = body[\"token\"]\n        check(\"login body only token\", set(body.keys()) == {\"token\"}, str(list(body.keys())))\n\n        status, me, _ = request(\"GET\", \"/api/auth/me\", token=alice_token)\n        check(\"me 200\", status == 200 and me == {\"username\": \"alice\", \"is_admin\": False}, str(me))\n        status, body, _ = request(\"GET\", \"/api/auth/me\")\n        check(\"me no token 401\", status == 401, str(body))\n        status, body, _ = request(\"GET\", \"/api/auth/me\", token=\"b\" * 64)\n        check(\"me bad token 401\", status == 401, str(body))\n\n        # Admin auth\n        status, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"secret-admin\"})\n        check(\"admin login 200\", status == 200 and \"token\" in body, str(body))\n        admin_token = body.get(\"token\", \"\")\n        status, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"nope\"})\n        check(\"admin bad pw 401\", status == 401, str(body))\n        status, me, _ = request(\"GET\", \"/api/auth/me\", token=admin_token)\n        check(\"admin me is_admin\", status == 200 and me.get(\"is_admin\") is True, str(me))\n\n        # Anonymous attempt\n        status, anon, _ = request(\"POST\", \"/api/attempts\", {\"answers\": [\n            {\"question_id\": q[\"id\"], \"selected\": \"A\"} for q in items\n        ]})\n        check(\"anon attempt 200 id null\", status == 200 and anon.get(\"id\") is None, str(anon))\n        check(\n            \"attempt score keys\",\n            anon is not None\n            and set(anon.keys()) >= {\"id\", \"score\", \"correct\", \"total_questions\", \"answers\", \"submitted_at\"}\n            and isinstance(anon.get(\"score\"), (int, float)),\n            str(list(anon.keys()) if anon else None),\n        )\n        check(\"anon attempt not listed\", status == 200 and anon.get(\"id\") is None)\n        status, body, _ = request(\"GET\", \"/api/attempts\")\n        check(\"attempts no token 401\", status == 401, str(body))\n\n        # Signed-in attempt with known correctness (select correct option for Q1, wrong for rest)\n        correct_ids = {q[\"id\"]: q.get(\"correct_option\") for q in request(\"GET\", \"/api/quiz?count=5\")[1][\"items\"]}\n        # Use admin-created question later; here just submit all-A\n        answers = [{\"question_id\": q[\"id\"], \"selected\": \"A\"} for q in items]\n        status, attempt, _ = request(\"POST\", \"/api/attempts\", {\"answers\": answers}, token=alice_token)\n        check(\"signed attempt 200\", status == 200, str(attempt))\n        check(\"attempt id int\", isinstance(attempt.get(\"id\"), int), str(attempt.get(\"id\")))\n        check(\n            \"attempt score float 0-100\",\n            isinstance(attempt.get(\"score\"), float) and 0 <= attempt[\"score\"] <= 100,\n            str(attempt.get(\"score\")),\n        )\n        check(\n            \"attempt counts consistent\",\n            attempt.get(\"total_questions\") == 5\n            and isinstance(attempt.get(\"correct\"), int)\n            and attempt[\"correct\"] <= 5,\n            str(attempt),\n        )\n        check(\n            \"attempt answers fields\",\n            attempt.get(\"answers\")\n            and all(\n                set(a.keys())\n                >= {\n                    \"question_id\",\n                    \"text\",\n                    \"option_a\",\n                    \"option_b\",\n                    \"option_c\",\n                    \"option_d\",\n                    \"selected\",\n                    \"correct_option\",\n                    \"is_correct\",\n                }\n                for a in attempt[\"answers\"]\n            ),\n            str(attempt.get(\"answers\", [{}])[0].keys() if attempt.get(\"answers\") else None),\n        )\n        check(\"no correct_option in answers text field\", \"correct_option\" not in [a.get(\"text\") for a in attempt.get(\"answers\", [])])\n        alice_attempt_id = attempt[\"id\"]\n\n        # List + detail access rules\n        status, listing, _ = request(\"GET\", \"/api/attempts\", token=alice_token)\n        check(\"attempts list 200\", status == 200, str(listing))\n        check(\"list has items\", listing and len(listing.get(\"items\", [])) >= 1, str(listing))\n        check(\n            \"list items have answers\",\n            listing and all(\"answers\" in it for it in listing[\"items\"]),\n        )\n        status, detail, _ = request(\"GET\", f\"/api/attempts/{alice_attempt_id}\", token=alice_token)\n        check(\"own detail 200\", status == 200 and detail.get(\"id\") == alice_attempt_id, str(detail))\n\n        status, body, _ = request(\"GET\", \"/api/attempts/999999\", token=alice_token)\n        check(\"missing attempt 404\", status == 404 and body and \"error\" in body, str(body))\n\n        # Other user cannot read alice's attempt\n        status, _, _ = request(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw123456\"})\n        status, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw123456\"})\n        bob_token = body[\"token\"]\n        status, body, _ = request(\"GET\", f\"/api/attempts/{alice_attempt_id}\", token=bob_token)\n        check(\"other user detail 404\", status == 404, str(body))\n\n        # Admin routes: alice (non-admin) gets 403, no token 401\n        status, body, _ = request(\"GET\", \"/api/admin/questions\", token=alice_token)\n        check(\"non-admin list 403\", status == 403, str(body))\n        status, body, _ = request(\"POST\", \"/api/admin/questions\", {\"text\": \"x\", \"option_a\": \"1\", \"option_b\": \"2\", \"option_c\": \"3\", \"option_d\": \"4\", \"correct_option\": \"A\"}, token=alice_token)\n        check(\"non-admin create 403\", status == 403, str(body))\n        status, body, _ = request(\"GET\", \"/api/admin/questions\")\n        check(\"admin list no token 401\", status == 401, str(body))\n\n        # Admin create + validation\n        new_q = {\n            \"text\": \"What is 2 + 2?\",\n            \"option_a\": \"3\",\n            \"option_b\": \"4\",\n            \"option_c\": \"5\",\n            \"option_d\": \"6\",\n            \"correct_option\": \"B\",\n        }\n        status, body, _ = request(\"POST\", \"/api/admin/questions\", new_q, token=admin_token)\n        check(\"admin create 201\", status == 201, str(body))\n        created_id = body.get(\"id\") if isinstance(body, dict) else None\n        check(\"created id int\", isinstance(created_id, int), str(body))\n\n        status, body, _ = request(\"POST\", \"/api/admin/questions\", {\"text\": \"no options\"}, token=admin_token)\n        check(\"admin create missing fields 400\", status == 400 and body and \"error\" in body, str(body))\n        status, body, _ = request(\"POST\", \"/api/admin/questions\", dict(new_q, correct_option=\"Z\"), token=admin_token)\n        check(\"admin create bad correct 400\", status == 400 and body and \"error\" in body, str(body))\n        status, body, _ = request(\"POST\", \"/api/admin/questions\", dict(new_q, text=\"  \"), token=admin_token)\n        check(\"admin create empty text 400\", status == 400 and body and \"error\" in body, str(body))\n\n        status, qlist, _ = request(\"GET\", \"/api/admin/questions?page=1&page_size=10\", token=admin_token)\n        check(\"admin list 200\", status == 200 and \"items\" in qlist and \"total\" in qlist, str(qlist and list(qlist.keys())))\n        check(\"admin list page 1 size 10\", qlist and len(qlist[\"items\"]) == 10, str(qlist and len(qlist[\"items\"])))\n        check(\"admin list total >= 21\", qlist and qlist[\"total\"] >= 21, str(qlist and qlist.get(\"total\")))\n        check(\n            \"admin list has correct_option\",\n            qlist and all(\"correct_option\" in q for q in qlist[\"items\"]),\n        )\n        check(\n            \"admin list ordered id asc\",\n            qlist and [q[\"id\"] for q in qlist[\"items\"]] == sorted(q[\"id\"] for q in qlist[\"items\"]),\n        )\n        status, page2, _ = request(\"GET\", \"/api/admin/questions?page=2&page_size=10\", token=admin_token)\n        check(\"admin list page 2\", status == 200 and page2 and len(page2[\"items\"]) >= 1, str(page2 and len(page2.get(\"items\", []))))\n        status, body, _ = request(\"GET\", \"/api/admin/questions?page=0\", token=admin_token)\n        check(\"admin list page=0 400\", status == 400 and body and \"error\" in body, str(body))\n\n        # New question appears in draw eventually (draw 50 to check inclusion)\n        status, big, _ = request(\"GET\", \"/api/quiz?count=50\")\n        big_items = (big or {}).get(\"items\", [])\n        check(\"new question in pool\", any(q[\"id\"] == created_id for q in big_items), str(created_id))\n        status, drawn, _ = request(\"GET\", \"/api/quiz?count=50\")\n        drawn_ids = [q[\"id\"] for q in (drawn or {}).get(\"items\", [])]\n        check(\"draw unique ids\", len(drawn_ids) == len(set(drawn_ids)), str(drawn_ids))\n        check(\"draw excludes correct_option\", all(\"correct_option\" not in q for q in (drawn or {}).get(\"items\", [])))\n\n        # Submit against known question to verify score math (1/1 correct = 100.0)\n        status, one, _ = request(\"GET\", \"/api/quiz?count=1\")\n        q1 = one[\"items\"][0]\n        status, at1, _ = request(\n            \"POST\",\n            \"/api/attempts\",\n            {\"answers\": [{\"question_id\": q1[\"id\"], \"selected\": q1.get(\"correct_option\") or \"A\"}]},\n            token=alice_token,\n        )\n        # quiz draw has no correct_option, so selected may be wrong; just verify schema\n        check(\"single answer attempt\", status == 200 and at1.get(\"total_questions\") == 1, str(at1))\n\n        # Create a deterministic attempt: admin question id created_id has correct B\n        status, at2, _ = request(\n            \"POST\",\n            \"/api/attempts\",\n            {\"answers\": [{\"question_id\": created_id, \"selected\": \"B\"}]},\n            token=alice_token,\n        )\n        check(\"correct answer score 100\", status == 200 and at2.get(\"correct\") == 1 and at2.get(\"score\") == 100.0, str(at2))\n        status, at3, _ = request(\n            \"POST\",\n            \"/api/attempts\",\n            {\"answers\": [{\"question_id\": created_id, \"selected\": \"A\"}]},\n            token=alice_token,\n        )\n        check(\"wrong answer score 0.0\", status == 200 and at3.get(\"correct\") == 0 and at3.get(\"score\") == 0.0, str(at3))\n        status, at4, _ = request(\n            \"POST\",\n            \"/api/attempts\",\n            {\"answers\": [{\"question_id\": created_id, \"selected\": \"A\"}, {\"question_id\": q1[\"id\"], \"selected\": \"A\"}]},\n            token=alice_token,\n        )\n        check(\n            \"mixed attempt score\",\n            status == 200 and at4.get(\"total_questions\") == 2 and at4.get(\"score\") in (0.0, 50.0, 100.0),\n            str(at4),\n        )\n\n        # Empty answers\n        status, at5, _ = request(\"POST\", \"/api/attempts\", {\"answers\": []}, token=alice_token)\n        check(\"empty answers 200 total 0\", status == 200 and at5.get(\"total_questions\") == 0 and at5.get(\"score\") == 0.0, str(at5))\n\n        # Invalid answers payload\n        status, body, _ = request(\"POST\", \"/api/attempts\", {\"answers\": [{\"question_id\": \"x\", \"selected\": \"A\"}]}, token=alice_token)\n        check(\"bad answers 400\", status == 400 and body and \"error\" in body, str(body))\n        status, body, _ = request(\"POST\", \"/api/attempts\", {\"answers\": [{\"question_id\": 999999, \"selected\": \"A\"}]}, token=alice_token)\n        check(\"unknown question answers 400\", status == 400 and body and \"error\" in body, str(body))\n        status, body, _ = request(\"POST\", \"/api/attempts\", {\"answers\": [{\"question_id\": created_id, \"selected\": \"Z\"}]}, token=alice_token)\n        check(\"bad selection 400\", status == 400 and body and \"error\" in body, str(body))\n\n        # Missing body\n        status, body, _ = request(\"POST\", \"/api/attempts\")\n        check(\"missing body 400\", status == 400 and body and \"error\" in body, str(body))\n\n        # Attempt list ordering: latest first (alice has several attempts now)\n        status, listing2, _ = request(\"GET\", \"/api/attempts\", token=alice_token)\n        times = [it[\"submitted_at\"] for it in listing2[\"items\"]]\n        check(\"list sorted desc\", times == sorted(times, reverse=True), str(times))\n\n        # 401 on attempt routes with bad token\n        status, body, _ = request(\"GET\", \"/api/attempts\", token=\"z\" * 64)\n        check(\"attempts bad token 401\", status == 401, str(body))\n\n        print(f\"\\n{passed} passed, {failed} failed\")\n        return 0 if failed == 0 else 1\n    finally:\n        try:\n            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)\n        except Exception:\n            proc.terminate()\n        try:\n            proc.wait(timeout=5)\n        except Exception:\n            proc.kill()\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","filePath":"/workspace/.e2e_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.e2e_test.py","exists":false,"truncated":false},"title":".e2e_test.py","time":{"start":1794303596459,"end":1794303596473}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4d417a3001zzCsNV3K31UgEx","sessionID":"ses_e3b52291effew79zs8gkkk9TtK","messageID":"msg_1c4d27ec1001Pg8zhAKyehFtb0"}}
