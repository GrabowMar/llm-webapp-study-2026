{"type":"step_start","timestamp":1794384810607,"sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","part":{"id":"prt_1c9ab525e001kmUnxI7irWNjd6","messageID":"msg_1c9aac1be0013SN6V5gQ3GlLCk","sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","type":"step-start"}}
{"type":"tool_use","timestamp":1794384810633,"sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","part":{"type":"tool","tool":"write","callID":"call_7e006ae4e9be4843818d5c99","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { api, ApiError, type Store } from \"../api\";\n\ninterface StoreFormProps {\n  token: string;\n  initial: Store | null;\n  onSaved: () => void;\n  onCancel: () => void;\n}\n\ninterface FormState {\n  name: string;\n  address: string;\n  phone: string;\n  latitude: string;\n  longitude: string;\n}\n\nconst EMPTY: FormState = { name: \"\", address: \"\", phone: \"\", latitude: \"\", longitude: \"\" };\n\nfunction toNumber(value: string): number | string | null {\n  const trimmed = value.trim();\n  if (trimmed === \"\") return null;\n  const parsed = Number(trimmed);\n  return Number.isFinite(parsed) ? parsed : trimmed;\n}\n\nfunction fieldError(fields: Record<string, string>, key: string): string | undefined {\n  return fields[key];\n}\n\nexport default function StoreForm({ token, initial, onSaved, onCancel }: StoreFormProps) {\n  const [form, setForm] = useState<FormState>(\n    initial\n      ? {\n          name: initial.name,\n          address: initial.address,\n          phone: initial.phone ?? \"\",\n          latitude: String(initial.latitude),\n          longitude: String(initial.longitude),\n        }\n      : EMPTY,\n  );\n  const [error, setError] = useState<string | null>(null);\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  const set = (key: keyof FormState) => (event: { target: { value: string } }) =>\n    setForm((prev) => ({ ...prev, [key]: event.target.value }));\n\n  async function submit(event: React.FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFields({});\n    const body = {\n      name: form.name,\n      address: form.address,\n      phone: form.phone.trim() || null,\n      latitude: toNumber(form.latitude),\n      longitude: toNumber(form.longitude),\n    };\n    try {\n      if (initial) {\n        await api.put(`/api/admin/stores/${initial.id}`, body, token);\n      } else {\n        await api.post(\"/api/admin/stores\", body, token);\n      }\n      onSaved();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else {\n        setError(\"Something went wrong. Please try again.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const inputClass =\n    \"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500\";\n\n  const renderField = (key: keyof FormState, label: string, props: Record<string, unknown> = {}) => (\n    <label className=\"block\">\n      <span className=\"mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500\">\n        {label}\n      </span>\n      <input\n        className={inputClass}\n        value={form[key]}\n        onChange={set(key)}\n        aria-invalid={fieldError(fields, key) ? true : undefined}\n        {...props}\n      />\n      {fieldError(fields, key) && (\n        <span className=\"mt-1 block text-xs text-red-600\">{fields[key]}</span>\n      )}\n    </label>\n  );\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"rounded-xl border border-slate-200 bg-white p-4 shadow-sm\"\n    >\n      <h3 className=\"mb-3 text-sm font-semibold text-slate-900\">\n        {initial ? `Edit ${initial.name}` : \"Add store\"}\n      </h3>\n\n      {error && (\n        <div\n          role=\"alert\"\n          className=\"mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\"\n        >\n          {error}\n        </div>\n      )}\n\n      <div className=\"grid gap-3 sm:grid-cols-2\">\n        <div className=\"sm:col-span-2\">{renderField(\"name\", \"Name\")}</div>\n        <div className=\"sm:col-span-2\">{renderField(\"address\", \"Address\")}</div>\n        {renderField(\"phone\", \"Phone (optional)\", { placeholder: \"Omitted phone is cleared\" })}\n        <div className=\"grid grid-cols-2 gap-3 sm:col-span-2 sm:grid-cols-2\">\n          {renderField(\"latitude\", \"Latitude\", { inputMode: \"decimal\", placeholder: \"51.5\" })}\n          {renderField(\"longitude\", \"Longitude\", { inputMode: \"decimal\", placeholder: \"-0.12\" })}\n        </div>\n      </div>\n\n      <div className=\"mt-4 flex gap-2\">\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 disabled:opacity-50\"\n        >\n          {busy ? \"Saving…\" : initial ? \"Save changes\" : \"Add store\"}\n        </button>\n        <button\n          type=\"button\"\n          onClick={onCancel}\n          className=\"rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n        >\n          Cancel\n        </button>\n      </div>\n    </form>\n  );\n}\n","filePath":"/workspace/frontend/src/components/StoreForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/StoreForm.tsx","exists":false,"truncated":false},"title":"frontend/src/components/StoreForm.tsx","time":{"start":1794384810600,"end":1794384810618}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9ab5264001Dd167IK42OLPcG","sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","messageID":"msg_1c9aac1be0013SN6V5gQ3GlLCk"}}
