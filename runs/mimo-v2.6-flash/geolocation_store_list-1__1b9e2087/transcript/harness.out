{"type":"tool_use","timestamp":1794384715243,"sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","part":{"type":"tool","tool":"write","callID":"call_a7495485786d4c599979ce14","state":{"status":"completed","input":{"content":"import type { Store } from \"../api\";\n\ninterface StoreListProps {\n  stores: Store[];\n  loading: boolean;\n  error: string | null;\n  locationLabel: string | null;\n  admin: boolean;\n  onEdit: (store: Store) => void;\n  onDelete: (store: Store) => void;\n  emptyMessage: string;\n}\n\nfunction formatDistance(distanceKm: number): string {\n  if (distanceKm < 10) return `${distanceKm.toFixed(1)} km`;\n  return `${Math.round(distanceKm)} km`;\n}\n\nexport default function StoreList({\n  stores,\n  loading,\n  error,\n  locationLabel,\n  admin,\n  onEdit,\n  onDelete,\n  emptyMessage,\n}: StoreListProps) {\n  if (loading && stores.length === 0) {\n    return (\n      <p className=\"rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500\">\n        Loading stores…\n      </p>\n    );\n  }\n\n  if (error) {\n    return (\n      <p className=\"rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700\">\n        {error}\n      </p>\n    );\n  }\n\n  if (stores.length === 0) {\n    return (\n      <p className=\"rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500\">\n        {emptyMessage}\n      </p>\n    );\n  }\n\n  return (\n    <ul className=\"divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white\">\n      {stores.map((store) => (\n        <li key={store.id} className=\"flex flex-wrap items-start gap-3 p-4\">\n          <div className=\"min-w-0 flex-1\">\n            <div className=\"flex flex-wrap items-center gap-2\">\n              <h3 className=\"font-semibold text-slate-900\">{store.name}</h3>\n              {store.distance_km !== null && (\n                <span className=\"rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800\">\n                  {formatDistance(store.distance_km)}\n                </span>\n              )}\n            </div>\n            <p className=\"mt-1 text-sm text-slate-600\">{store.address}</p>\n            <p className=\"mt-1 text-sm text-slate-500\">\n              {store.phone ?? <span className=\"text-slate-400\">No phone listed</span>}\n            </p>\n            {locationLabel && (\n              <p className=\"mt-1 text-xs text-slate-400\">\n                {store.latitude.toFixed(4)}, {store.longitude.toFixed(4)}\n              </p>\n            )}\n          </div>\n          {admin && (\n            <div className=\"flex shrink-0 gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => onEdit(store)}\n                className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50\"\n              >\n                Edit\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onDelete(store)}\n                className=\"rounded-lg border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50\"\n              >\n                Delete\n              </button>\n            </div>\n          )}\n        </li>\n      ))}\n    </ul>\n  );\n}\n","filePath":"/workspace/frontend/src/components/StoreList.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/StoreList.tsx","exists":false,"truncated":false},"title":"frontend/src/components/StoreList.tsx","time":{"start":1794384715140,"end":1794384715156}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9a9dd7c001Yw9JCstXN7r5oY","sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","messageID":"msg_1c9a95bcb001Pom7UDT6mO7XsP"}}
