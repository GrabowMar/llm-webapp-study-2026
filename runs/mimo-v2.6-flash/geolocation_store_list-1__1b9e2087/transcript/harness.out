 263, 1016 GV Amsterdam, Netherlands\", \"+31 20 555 0143\", 52.3740, 4.8840),\n35: ]\n36: \n37: \n38: # ---------------------------------------------------------------- database\n39: \n40: \n41: @contextmanager\n42: def db() -> Iterator[sqlite3.Connection]:\n43:     conn = sqlite3.connect(DB_PATH)\n44:     conn.row_factory = sqlite3.Row\n45:     try:\n46:         yield conn\n47:         conn.commit()\n48:     finally:\n49:         conn.close()\n50: \n51: \n52: def hash_password(password: str) -> str:\n53:     salt = secrets.token_bytes(16)\n54:     digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt, 200_000)\n55:     return f\"pbkdf2:{salt.hex()}:{digest.hex()}\"\n56: \n57: \n58: def verify_password(password: str, stored: str) -> bool:\n59:     try:\n60:         scheme, salt_hex, digest_hex = stored.split(\":\")\n61:         if scheme != \"pbkdf2\":\n62:             return False\n63:         digest = hashlib.pbkdf2_hmac(\n64:             \"sha256\", password.encode(), bytes.fromhex(salt_hex), 200_000\n65:         )\n66:         return hmac.compare_digest(digest.hex(), digest_hex)\n67:     except (ValueError, TypeError):\n68:         return False\n69: \n70: \n71: def init_db() -> None:\n72:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n73:     fresh = not DB_PATH.exists()\n74:     with db() as conn:\n75:         conn.execute(\n76:             \"\"\"\n77:             CREATE TABLE IF NOT EXISTS stores (\n78:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n79:                 name TEXT NOT NULL,\n80:                 address TEXT NOT NULL,\n81:                 phone TEXT,\n82:                 latitude REAL NOT NULL,\n83:                 longitude REAL NOT NULL\n84:             )\n85:             \"\"\"\n86:         )\n87:         conn.execute(\n88:             \"\"\"\n89:             CREATE TABLE IF NOT EXISTS users (\n90:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n91:                 username TEXT NOT NULL UNIQUE,\n92:                 password_hash TEXT NOT NULL,\n93:                 is_admin INTEGER NOT NULL DEFAULT 0\n94:             )\n95:             \"\"\"\n96:         )\n97:         conn.execute(\n98:             \"\"\"\n99:             CREATE TABLE IF NOT EXISTS sessions (\n100:                 token TEXT PRIMARY KEY,\n101:                 user_id INTEGER NOT NULL,\n102:                 FOREIGN KEY (user_id) REFERENCES users (id)\n103:             )\n104:             \"\"\"\n105:         )\n106:         if fresh:\n107:             conn.executemany(\n108:                 \"INSERT INTO stores (name, address, phone, latitude, longitude) \"\n109:                 \"VALUES (?, ?, ?, ?, ?)\",\n110:                 SAMPLE_STORES,\n111:             )\n112:     if ADMIN_ENABLED:\n113:         with db() as conn:\n114:             existing = conn.execute(\n115:                 \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n116:             ).fetchone()\n117:             if existing:\n118:                 conn.execute(\n119:                     \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n120:                     (hash_password(ADMIN_PASSWORD), existing[\"id\"]),\n\n(Showing lines 1-120 of 483. Use offset=121 to continue.)\n</content>","metadata":{"preview":"\"\"\"Store finder: Flask API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom contextlib import contextmanager\nfrom pathlib import Path\nfrom typing import Any, Iterator\n\nfrom flask import Flask, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"storefinder.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Store finder: Flask API and frontend host.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom contextlib import contextmanager\nfrom pathlib import Path\nfrom typing import Any, Iterator\n\nfrom flask import Flask, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"storefinder.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\nADMIN_ENABLED = bool(ADMIN_PASSWORD.strip())\n\nSAMPLE_STORES = [\n    (\"Baker Street Books\", \"221 Baker Street, London NW1 6XE, United Kingdom\", \"+44 20 7946 0958\", 51.5238, -0.1585),\n    (\"Camden Market Goods\", \"54 Camden High Street, London NW1 0JH, United Kingdom\", \"+44 20 7485 8585\", 51.5390, -0.1426),\n    (\"Thames Side Outfitters\", \"18 Lower Thames Street, London EC3R 6HD, United Kingdom\", None, 51.5081, -0.0870),\n    (\"Le Marais Boutique\", \"12 Rue des Francs Bourgeois, 75004 Paris, France\", \"+33 1 42 78 12 45\", 48.8566, 2.3522),\n    (\"Saint-Germain Supply\", \"45 Rue de Seine, 75006 Paris, France\", \"+33 1 43 26 66 66\", 48.8530, 2.3345),\n    (\"Mitte Werkstatt\", \"Torstrasse 101, 10119 Berlin, Germany\", \"+49 30 1234567\", 52.5251, 13.4010),\n    (\"Kreuzberg Kiosk\", \"Oranienstrasse 42, 10999 Berlin, Germany\", None, 52.5024, 13.4170),\n    (\"Jordaan Decor\", \"Prinsengracht 263, 1016 GV Amsterdam, Netherlands\", \"+31 20 555 0143\", 52.3740, 4.8840),\n]\n\n\n# ---------------------------------------------------------------- database\n\n\n@contextmanager\ndef db() -> Iterator[sqlite3.Connection]:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    try:\n        yield conn\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef hash_password(password: str) -> str:\n    salt = secrets.token_bytes(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt, 200_000)\n    return f\"pbkdf2:{salt.hex()}:{digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        scheme, salt_hex, digest_hex = stored.split(\":\")\n        if scheme != \"pbkdf2\":\n            return False\n        digest = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(), bytes.fromhex(salt_hex), 200_000\n        )\n        return hmac.compare_digest(digest.hex(), digest_hex)\n    except (ValueError, TypeError):\n        return False\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    fresh = not DB_PATH.exists()\n    with db() as conn:\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS stores (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL,\n                address TEXT NOT NULL,\n                phone TEXT,\n                latitude REAL NOT NULL,\n                longitude REAL NOT NULL\n            )\n            \"\"\"\n        )\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                is_admin INTEGER NOT NULL DEFAULT 0\n            )\n            \"\"\"\n        )\n        conn.execute(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS sessions (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL,\n                FOREIGN KEY (user_id) REFERENCES users (id)\n            )\n            \"\"\"\n        )\n        if fresh:\n            conn.executemany(\n                \"INSERT INTO stores (name, address, phone, latitude, longitude) \"\n                \"VALUES (?, ?, ?, ?, ?)\",\n                SAMPLE_STORES,\n            )\n    if ADMIN_ENABLED:\n        with db() as conn:\n            existing = conn.execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n            if existing:\n                conn.execute(\n                    \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                    (hash_password(ADMIN_PASSWORD), existing[\"id\"]),","lineStart":1,"lineEnd":120,"totalLines":483,"truncated":true}},"title":"backend/app.py","time":{"start":1794385341190,"end":1794385341209}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9b36b01001WRUSL7RtELFNSa","sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","messageID":"msg_1c9b34724001ONEt4QOekzeHVY"}}
