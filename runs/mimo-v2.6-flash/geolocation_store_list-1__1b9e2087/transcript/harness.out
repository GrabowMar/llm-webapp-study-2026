{"type":"tool_use","timestamp":1794384681937,"sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","part":{"type":"tool","tool":"write","callID":"call_6de5bf3e6e494d948599823e","state":{"status":"completed","input":{"content":"export interface Store {\n  id: number;\n  name: string;\n  address: string;\n  phone: string | null;\n  latitude: number;\n  longitude: number;\n  distance_km: number | null;\n}\n\nexport interface GeoPoint {\n  lat: number;\n  lng: number;\n}\n\ninterface ApiFailure {\n  error?: string;\n  fields?: Record<string, string>;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nasync function call<T>(\n  method: string,\n  path: string,\n  body?: unknown,\n  token?: string | null,\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const response = await fetch(path, {\n    method,\n    headers,\n    body: body !== undefined ? JSON.stringify(body) : undefined,\n  });\n  const text = await response.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n  if (!response.ok) {\n    const failure = (data ?? {}) as ApiFailure;\n    throw new ApiError(\n      response.status,\n      failure.error ?? `Request failed (${response.status})`,\n      failure.fields ?? {},\n    );\n  }\n  return data as T;\n}\n\nexport const api = {\n  get: <T>(path: string, token?: string | null): Promise<T> =>\n    call<T>(\"GET\", path, undefined, token),\n  post: <T>(path: string, body: unknown, token?: string | null): Promise<T> =>\n    call<T>(\"POST\", path, body, token),\n  put: <T>(path: string, body: unknown, token?: string | null): Promise<T> =>\n    call<T>(\"PUT\", path, body, token),\n  del: <T>(path: string, token?: string | null): Promise<T> =>\n    call<T>(\"DELETE\", path, undefined, token),\n};\n\nexport function storesUrl(query: string, position: GeoPoint | null, radius: number): string {\n  const params = new URLSearchParams();\n  const trimmed = query.trim();\n  if (trimmed) params.set(\"q\", trimmed);\n  if (position) {\n    params.set(\"lat\", String(position.lat));\n    params.set(\"lng\", String(position.lng));\n    params.set(\"radius\", String(radius));\n  }\n  const suffix = params.toString();\n  return suffix ? `/api/stores?${suffix}` : \"/api/stores\";\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794384681840,"end":1794384681864}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9a95b6a001FdUtOB3imt5Qtu","sessionID":"ses_e366441f7ffehK8yTN5q5r0ksE","messageID":"msg_1c9a901ad001ykQ81ggpyHi2P9"}}
