N body\", 400)\n331:     fields: list[str] = []\n332:     values: list[Any] = []\n333:     if \"title\" in data:\n334:         if not isinstance(data[\"title\"], str):\n335:             return error(\"title must be a string\", 400)\n336:         fields.append(\"title = ?\")\n337:         values.append(data[\"title\"])\n338:     if \"body\" in data:\n339:         if not isinstance(data[\"body\"], str):\n340:             return error(\"body must be a string\", 400)\n341:         fields.append(\"body = ?\")\n342:         values.append(data[\"body\"])\n343:     if \"published\" in data:\n344:         published = as_bool(data.get(\"published\"))\n345:         if published is None:\n346:             return error(\"published must be a boolean\", 400)\n347:         fields.append(\"published = ?\")\n348:         values.append(int(published))\n349:     if fields:\n350:         fields.append(\"updated_at = ?\")\n351:         values.append(utcnow())\n352:         db = get_db()\n353:         db.execute(f\"UPDATE notes SET {', '.join(fields)} WHERE id = ?\", (*values, row[\"id\"]))\n354:         db.commit()\n355:         row = owned_note(note_id)\n356:     return jsonify(full_note(row))\n357: \n358: \n359: @app.delete(\"/api/notes/<int:note_id>\")\n360: @auth_required\n361: def delete_note(note_id: int):\n362:     row = owned_note(note_id)\n363:     if row is None:\n364:         return error(\"note not found\", 404)\n365:     db = get_db()\n366:     db.execute(\"DELETE FROM notes WHERE id = ?\", (row[\"id\"],))\n367:     db.commit()\n368:     return \"\", 204\n369: \n370: \n371: @app.get(\"/api/notes/<int:note_id>/html\")\n372: @auth_required\n373: def note_html(note_id: int):\n374:     row = owned_note(note_id)\n375:     if row is None:\n376:         return error(\"note not found\", 404)\n377:     return Response(render_markdown(row[\"body\"]), mimetype=\"text/html\")\n378: \n379: \n380: @app.get(\"/api/public/notes/<int:note_id>\")\n381: def public_note(note_id: int):\n382:     row = published_note(note_id)\n383:     if row is None:\n384:         return error(\"note not found\", 404)\n385:     return jsonify(full_note(row))\n386: \n387: \n388: @app.get(\"/api/public/notes/<int:note_id>/html\")\n389: def public_note_html(note_id: int):\n\n(Showing lines 240-389 of 407. Use offset=390 to continue.)\n</content>","metadata":{"preview":"        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str) or not username or not password:\n        return error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str) or not username or not password:\n        return error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]}), 200\n\n\n@app.get(\"/api/notes\")\n@auth_required\ndef list_notes():\n    rows = get_db().execute(\n        \"SELECT id, title, published, updated_at FROM notes WHERE user_id = ?\"\n        \" ORDER BY updated_at DESC, id DESC\",\n        (current_user()[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [list_item(row) for row in rows]})\n\n\n@app.post(\"/api/notes\")\n@auth_required\ndef create_note():\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    title = data.get(\"title\", \"\")\n    body = data.get(\"body\", \"\")\n    if not isinstance(title, str) or not isinstance(body, str):\n        return error(\"title and body must be strings\", 400)\n    published = False\n    if \"published\" in data:\n        published = as_bool(data.get(\"published\"))\n        if published is None:\n            return error(\"published must be a boolean\", 400)\n    timestamp = utcnow()\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO notes (user_id, title, body, published, created_at, updated_at)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (current_user()[\"id\"], title, body, int(published), timestamp, timestamp),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT n.id, n.title, n.body, n.published, n.updated_at, u.username AS author\"\n        \" FROM notes n JOIN users u ON u.id = n.user_id WHERE n.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n    return jsonify(full_note(row)), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\n@auth_required\ndef get_note(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return jsonify(full_note(row))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\n@auth_required\ndef update_note(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    fields: list[str] = []\n    values: list[Any] = []\n    if \"title\" in data:\n        if not isinstance(data[\"title\"], str):\n            return error(\"title must be a string\", 400)\n        fields.append(\"title = ?\")\n        values.append(data[\"title\"])\n    if \"body\" in data:\n        if not isinstance(data[\"body\"], str):\n            return error(\"body must be a string\", 400)\n        fields.append(\"body = ?\")\n        values.append(data[\"body\"])\n    if \"published\" in data:\n        published = as_bool(data.get(\"published\"))\n        if published is None:\n            return error(\"published must be a boolean\", 400)\n        fields.append(\"published = ?\")\n        values.append(int(published))\n    if fields:\n        fields.append(\"updated_at = ?\")\n        values.append(utcnow())\n        db = get_db()\n        db.execute(f\"UPDATE notes SET {', '.join(fields)} WHERE id = ?\", (*values, row[\"id\"]))\n        db.commit()\n        row = owned_note(note_id)\n    return jsonify(full_note(row))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\n@auth_required\ndef delete_note(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    db = get_db()\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (row[\"id\"],))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/notes/<int:note_id>/html\")\n@auth_required\ndef note_html(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return Response(render_markdown(row[\"body\"]), mimetype=\"text/html\")\n\n\n@app.get(\"/api/public/notes/<int:note_id>\")\ndef public_note(note_id: int):\n    row = published_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return jsonify(full_note(row))\n\n\n@app.get(\"/api/public/notes/<int:note_id>/html\")\ndef public_note_html(note_id: int):","lineStart":240,"lineEnd":389,"totalLines":407,"truncated":true}},"title":"backend/app.py","time":{"start":1794375251922,"end":1794375251947}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c91977c9001mdG44QfKrpYhSO","sessionID":"ses_e370068abffeXZLNWZFrPAqi4U","messageID":"msg_1c91950640013aC15aeMwi2usB"}}
