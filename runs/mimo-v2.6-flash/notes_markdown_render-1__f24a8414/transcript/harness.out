{"type":"tool_use","timestamp":1794374145030,"sessionID":"ses_e370068abffeXZLNWZFrPAqi4U","part":{"type":"tool","tool":"write","callID":"call_c4f2ca8604324c54bb42d21e","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any\n\nimport nh3\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom markdown import markdown\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"NOTES_DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"notes.db\"\n\nMARKDOWN_EXTENSIONS = [\"fenced_code\", \"tables\"]\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS notes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL DEFAULT '',\n    body TEXT NOT NULL DEFAULT '',\n    published INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_notes_user_updated ON notes(user_id, updated_at DESC);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = sqlite3.connect(DB_PATH)\n    try:\n        db.executescript(SCHEMA)\n        db.commit()\n    finally:\n        db.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA journal_mode=WAL\")\n        g.db.execute(\"PRAGMA busy_timeout=5000\")\n        g.db.execute(\"PRAGMA foreign_keys=ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exception: BaseException | None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef current_user() -> dict[str, Any] | None:\n    if \"user\" in g:\n        return g.user\n    user: dict[str, Any] | None = None\n    header = request.headers.get(\"Authorization\", \"\")\n    if header[:7].lower() == \"bearer \":\n        token = header[7:].strip()\n        if token:\n            row = get_db().execute(\n                \"SELECT u.id AS id, u.username AS username\"\n                \" FROM tokens t JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n                (token,),\n            ).fetchone()\n            if row is not None:\n                user = {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n    g.user = user\n    return user\n\n\ndef auth_required(view):\n    @wraps(view)\n    def wrapped(*args: Any, **kwargs: Any):\n        if current_user() is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        return view(*args, **kwargs)\n\n    return wrapped\n\n\ndef request_json() -> dict[str, Any] | None:\n    if not request.data:\n        return {}\n    data = request.get_json(silent=True)\n    if isinstance(data, dict):\n        return data\n    return None\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef as_bool(value: Any) -> bool | None:\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    return None\n\n\ndef full_note(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"body\": row[\"body\"],\n        \"published\": bool(row[\"published\"]),\n        \"updated_at\": row[\"updated_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\ndef list_item(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"published\": bool(row[\"published\"]),\n        \"updated_at\": row[\"updated_at\"],\n    }\n\n\ndef owned_note(note_id: int) -> sqlite3.Row | None:\n    user = current_user()\n    if user is None:\n        return None\n    row = get_db().execute(\n        \"SELECT n.id, n.title, n.body, n.published, n.updated_at, n.user_id,\"\n        \" u.username AS author\"\n        \" FROM notes n JOIN users u ON u.id = n.user_id WHERE n.id = ?\",\n        (note_id,),\n    ).fetchone()\n    if row is None or row[\"user_id\"] != user[\"id\"]:\n        return None\n    return row\n\n\ndef published_note(note_id: int) -> sqlite3.Row | None:\n    row = get_db().execute(\n        \"SELECT n.id, n.title, n.body, n.published, n.updated_at,\"\n        \" u.username AS author\"\n        \" FROM notes n JOIN users u ON u.id = n.user_id\"\n        \" WHERE n.id = ? AND n.published = 1\",\n        (note_id,),\n    ).fetchone()\n    return row\n\n\ndef render_markdown(body: str) -> str:\n    html = markdown(body, extensions=MARKDOWN_EXTENSIONS)\n    return nh3.clean(html)\n\n\n@app.after_request\ndef set_headers(response: Response) -> Response:\n    if request.path.startswith(\"/api/\"):\n        response.headers[\"Cache-Control\"] = \"no-store\"\n    response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n    return response\n\n\n@app.errorhandler(404)\ndef not_found(_exception: Any):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_exception: Any):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": \"method not allowed\"}), 405\n    return jsonify({\"error\": \"method not allowed\"}), 405\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    username = username.strip()\n    db = get_db()\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), utcnow()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already exists\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str) or not username or not password:\n        return error(\"username and password are required\", 400)\n    row = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]}), 200\n\n\n@app.get(\"/api/notes\")\n@auth_required\ndef list_notes():\n    rows = get_db().execute(\n        \"SELECT id, title, published, updated_at FROM notes WHERE user_id = ?\"\n        \" ORDER BY updated_at DESC, id DESC\",\n        (current_user()[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [list_item(row) for row in rows]})\n\n\n@app.post(\"/api/notes\")\n@auth_required\ndef create_note():\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    title = data.get(\"title\", \"\")\n    body = data.get(\"body\", \"\")\n    if not isinstance(title, str) or not isinstance(body, str):\n        return error(\"title and body must be strings\", 400)\n    published = False\n    if \"published\" in data:\n        published = as_bool(data.get(\"published\"))\n        if published is None:\n            return error(\"published must be a boolean\", 400)\n    timestamp = utcnow()\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO notes (user_id, title, body, published, created_at, updated_at)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (current_user()[\"id\"], title, body, int(published), timestamp, timestamp),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT n.id, n.title, n.body, n.published, n.updated_at, u.username AS author\"\n        \" FROM notes n JOIN users u ON u.id = n.user_id WHERE n.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n    return jsonify(full_note(row)), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\n@auth_required\ndef get_note(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return jsonify(full_note(row))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\n@auth_required\ndef update_note(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    data = request_json()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n    fields: list[str] = []\n    values: list[Any] = []\n    if \"title\" in data:\n        if not isinstance(data[\"title\"], str):\n            return error(\"title must be a string\", 400)\n        fields.append(\"title = ?\")\n        values.append(data[\"title\"])\n    if \"body\" in data:\n        if not isinstance(data[\"body\"], str):\n            return error(\"body must be a string\", 400)\n        fields.append(\"body = ?\")\n        values.append(data[\"body\"])\n    if \"published\" in data:\n        published = as_bool(data.get(\"published\"))\n        if published is None:\n            return error(\"published must be a boolean\", 400)\n        fields.append(\"published = ?\")\n        values.append(int(published))\n    if fields:\n        fields.append(\"updated_at = ?\")\n        values.append(utcnow())\n        db = get_db()\n        db.execute(f\"UPDATE notes SET {', '.join(fields)} WHERE id = ?\", (*values, row[\"id\"]))\n        db.commit()\n        row = owned_note(note_id)\n    return jsonify(full_note(row))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\n@auth_required\ndef delete_note(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    db = get_db()\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (row[\"id\"],))\n    db.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/notes/<int:note_id>/html\")\n@auth_required\ndef note_html(note_id: int):\n    row = owned_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return Response(render_markdown(row[\"body\"]), mimetype=\"text/html\")\n\n\n@app.get(\"/api/public/notes/<int:note_id>\")\ndef public_note(note_id: int):\n    row = published_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return jsonify(full_note(row))\n\n\n@app.get(\"/api/public/notes/<int:note_id>/html\")\ndef public_note_html(note_id: int):\n    row = published_note(note_id)\n    if row is None:\n        return error(\"note not found\", 404)\n    return Response(render_markdown(row[\"body\"]), mimetype=\"text/html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    target = (DIST / path).resolve()\n    if target.is_relative_to(DIST.resolve()) and target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794374144986,"end":1794374145007}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c90893d2001XV66zngJczCtXc","sessionID":"ses_e370068abffeXZLNWZFrPAqi4U","messageID":"msg_1c9084fcb001yCUgdJPlwkiLy9"}}
