ancelAnimationFrame\",\n   \"CustomEvent\",\n ]) {\n-  if (dom.window[key] !== undefined) {\n-    globalThis[key] =\n-      typeof dom.window[key] === \"function\" && key === \"getComputedStyle\"\n-        ? dom.window[key].bind(dom.window)\n-        : dom.window[key];\n+  if (dom.window[key] === undefined) continue;\n+  const value =\n+    key === \"getComputedStyle\"\n+      ? dom.window[key].bind(dom.window)\n+      : dom.window[key];\n+  try {\n+    Object.defineProperty(globalThis, key, {\n+      value,\n+      configurable: true,\n+      writable: true,\n+    });\n+  } catch {\n+    /* leave Node's own global in place */\n   }\n }\n globalThis.window.confirm = () => true;\n \n","filediff":{"file":"/workspace/frontend/.fe_smoke.mjs","patch":"Index: /workspace/frontend/.fe_smoke.mjs\n===================================================================\n--- /workspace/frontend/.fe_smoke.mjs\n+++ /workspace/frontend/.fe_smoke.mjs\n@@ -95,13 +95,21 @@\n   \"requestAnimationFrame\",\n   \"cancelAnimationFrame\",\n   \"CustomEvent\",\n ]) {\n-  if (dom.window[key] !== undefined) {\n-    globalThis[key] =\n-      typeof dom.window[key] === \"function\" && key === \"getComputedStyle\"\n-        ? dom.window[key].bind(dom.window)\n-        : dom.window[key];\n+  if (dom.window[key] === undefined) continue;\n+  const value =\n+    key === \"getComputedStyle\"\n+      ? dom.window[key].bind(dom.window)\n+      : dom.window[key];\n+  try {\n+    Object.defineProperty(globalThis, key, {\n+      value,\n+      configurable: true,\n+      writable: true,\n+    });\n+  } catch {\n+    /* leave Node's own global in place */\n   }\n }\n globalThis.window.confirm = () => true;\n \n","additions":13,"deletions":5},"truncated":false},"title":"frontend/.fe_smoke.mjs","time":{"start":1794317495850,"end":1794317495865}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5a82e23001bj9PL8B17F5fVs","sessionID":"ses_e3a6c3a5fffeccW8fg8yb88t39","messageID":"msg_1c5a7f806001iC7VnV