{"type":"tool_use","timestamp":1794362625977,"sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","part":{"type":"tool","tool":"write","callID":"call_edbfdc7950914d0395dcf880","state":{"status":"completed","input":{"content":"\"\"\"End-to-end API checks for the timesheet backend.\"\"\"\n\nimport csv\nimport io\nimport json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nfailures = []\n\n\ndef check(name, condition, detail=\"\"):\n    status = \"ok\" if condition else \"FAIL\"\n    print(f\"[{status}] {name}\" + (\"\" if condition else f\" -- {detail}\"))\n    if not condition:\n        failures.append(name)\n\n\ndef call(method, path, body=None, token=None, expect=None):\n    url = BASE + path\n    data = None\n    headers = {}\n    if body is not None:\n        data = json.dumps(body).encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    req = urllib.request.Request(url, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req) as resp:\n            status = resp.status\n            raw = resp.read()\n            ctype = resp.headers.get(\"Content-Type\", \"\")\n            disposition = resp.headers.get(\"Content-Disposition\", \"\")\n    except urllib.error.HTTPError as exc:\n        status = exc.code\n        raw = exc.read()\n        ctype = exc.headers.get(\"Content-Type\", \"\")\n        disposition = exc.headers.get(\"Content-Disposition\", \"\")\n    parsed = None\n    if \"json\" in ctype:\n        try:\n            parsed = json.loads(raw)\n        except Exception:\n            parsed = None\n    if expect is not None and status != expect:\n        failures.append(f\"{method} {path} expected {expect} got {status}: {raw[:200]!r}\")\n    return status, parsed, raw, ctype, disposition\n\n\ndef csv_rows(raw):\n    text = raw.decode(\"utf-8\")\n    return list(csv.reader(io.StringIO(text)))\n\n\n# health -----------------------------------------------------------------\nstatus, body, *_ = call(\"GET\", \"/api/health\", expect=200)\ncheck(\"health\", status == 200 and body == {\"status\": \"ok\"}, body)\n\n# unknown api route -------------------------------------------------------\nstatus, body, raw, ctype, _ = call(\"GET\", \"/api/nope\", expect=404)\ncheck(\"unknown api route is json 404\", status == 404 and \"json\" in ctype and body == {\"error\": \"not found\"}, (status, body))\n\n# auth validation ----------------------------------------------------------\nstatus, body, *_ = call(\"POST\", \"/api/auth/register\", {\"username\": \"\"}, expect=400)\ncheck(\"register validates fields\", status == 400 and \"error\" in body, body)\n\n# register / login ---------------------------------------------------------\nstatus, body, *_ = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw-alice\"}, expect=201)\ncheck(\"register alice\", status == 201, body)\n\nstatus, body, *_ = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\ncheck(\"duplicate register 409\", status == 409, (status, body))\n\nstatus, body, *_ = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw-bob\"}, expect=201)\ncheck(\"register bob\", status == 201, body)\n\nstatus, body, *_ = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"nope\"}, expect=401)\ncheck(\"bad login 401\", status == 401 and \"error\" in body, body)\n\nstatus, body, *_ = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw-alice\"}, expect=200)\ncheck(\"alice login\", status == 200 and isinstance(body.get(\"token\"), str), body)\nalice = body.get(\"token\", \"\")\n\nstatus, body, *_ = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw-bob\"}, expect=200)\nbob = body.get(\"token\", \"\")\ncheck(\"bob login\", status == 200 and isinstance(bob, str), body)\n\n# no token ----------------------------------------------------------------\nstatus, body, *_ = call(\"GET\", \"/api/entries\", expect=401)\ncheck(\"entries without token 401\", status == 401, (status, body))\nstatus, body, *_ = call(\"GET\", \"/api/entries\", token=\"garbage\", expect=401)\ncheck(\"entries bad token 401\", status == 401, (status, body))\nstatus, body, *_ = call(\"POST\", \"/api/entries\", {\"project\": \"p\"}, expect=401)\ncheck(\"post without token 401\", status == 401, (status, body))\nstatus, *_ = call(\"GET\", \"/api/exports/entries.csv\", expect=401)\ncheck(\"export without token 401\", status == 401, status)\n\n# empty list --------------------------------------------------------------\nstatus, body, *_ = call(\"GET\", \"/api/entries\", token=alice, expect=200)\ncheck(\n    \"empty list shape\",\n    status == 200 and body == {\"items\": [], \"total\": 0, \"page\": 1, \"page_size\": 100},\n    body,\n)\n\n# entry validation ---------------------------------------------------------\nstatus, body, *_ = call(\"POST\", \"/api/entries\", {}, token=alice, expect=400)\ncheck(\n    \"create validates all fields\",\n    status == 400 and set(body.get(\"errors\", {})) == {\"project\", \"description\", \"hours\", \"date\"},\n    body,\n)\nstatus, body, *_ = call(\n    \"POST\",\n    \"/api/entries\",\n    {\"project\": \"p\", \"description\": \"d\", \"hours\": \"abc\", \"date\": \"2024-02-30\"},\n    token=alice,\n    expect=400,\n)\ncheck(\"bad hours and date rejected\", status == 400 and \"hours\" in body.get(\"errors\", {}) and \"date\" in body.get(\"errors\", {}), body)\nstatus, body, *_ = call(\n    \"POST\",\n    \"/api/entries\",\n    {\"project\": \"p\", \"description\": \"d\", \"hours\": -2, \"date\": \"2024-01-01\"},\n    token=alice,\n    expect=400,\n)\ncheck(\"negative hours rejected\", status == 400, (status, body))\n\n# create entries -----------------------------------------------------------\ndef add(project, description, hours, date, token=alice):\n    status, body, *_ = call(\n        \"POST\",\n        \"/api/entries\",\n        {\"project\": project, \"description\": description, \"hours\": hours, \"date\": date},\n        token=token,\n        expect=201,\n    )\n    if status != 201:\n        failures.append(f\"create {project}/{date}: {body}\")\n        return None\n    return body\n\n\ne1 = add(\"alpha\", \"first task\", 1.5, \"2024-03-05\")\ne2 = add(\"beta\", \"second task\", 2, \"2024-03-01\")\ne3 = add(\"alpha\", \"=1+1\", 0.5, \"2024-03-10\")\ne4 = add(\"007\", \"with, comma and \\\"quotes\\\"\", 4, \"2024-03-07\")\nadd(\"beta\", \"bob entry\", 3, \"2024-03-02\", token=bob)\n\ncheck(\n    \"entry shape\",\n    e1 is not None\n    and set(e1) == {\"id\", \"project\", \"description\", \"hours\", \"date\", \"created_at\"}\n    and e1[\"project\"] == \"alpha\"\n    and e1[\"hours\"] == 1.5\n    and e1[\"date\"] == \"2024-03-05\"\n    and isinstance(e1[\"created_at\"], str),\n    e1,\n)\n\n# list ordering & isolation ------------------------------------------------\nstatus, body, *_ = call(\"GET\", \"/api/entries\", token=alice, expect=200)\ndates = [item[\"date\"] for item in body[\"items\"]]\ncheck(\"newest date first\", dates == sorted(dates, reverse=True), dates)\ncheck(\"alice sees only her entries\", body[\"total\"] == 4 and all(i[\"project\"] != \"bob\" for i in body[\"items\"]) and len(body[\"items\"]) == 4, body)\n\n# filters ------------------------------------------------------------------\nstatus, body, *_ = call(\n    \"GET\", \"/api/entries?start_date=2024-03-06&end_date=2024-03-09\", token=alice, expect=200\n)\ncheck(\n    \"date range filter\",\n    body[\"total\"] == 1 and body[\"items\"][0][\"project\"] == \"007\",\n    body,\n)\nstatus, body, *_ = call(\"GET\", \"/api/entries?project=alpha\", token=alice, expect=200)\ncheck(\"project filter\", body[\"total\"] == 2 and all(i[\"project\"] == \"alpha\" for i in body[\"items\"]), body)\nstatus, body, *_ = call(\"GET\", \"/api/entries?page=2&page_size=3\", token=alice, expect=200)\ncheck(\"paging\", body[\"page\"] == 2 and body[\"page_size\"] == 3 and body[\"total\"] == 4 and len(body[\"items\"]) == 1, body)\nstatus, *_ = call(\"GET\", \"/api/entries?start_date=2024-13-01\", token=alice, expect=400)\ncheck(\"bad filter date 400\", status == 400, status)\n\n# patch --------------------------------------------------------------------\nstatus, body, *_ = call(\"PATCH\", f\"/api/entries/{e1['id']}\", {\"hours\": 2.5}, token=alice, expect=200)\ncheck(\n    \"patch only given fields\",\n    status == 200 and body[\"hours\"] == 2.5 and body[\"project\"] == \"alpha\" and body[\"description\"] == \"first task\" and body[\"date\"] == \"2024-03-05\",\n    body,\n)\nstatus, body, *_ = call(\"PATCH\", f\"/api/entries/{e1['id']}\", {\"description\": \"renamed\"}, token=alice, expect=200)\ncheck(\"patch description\", status == 200 and body[\"description\"] == \"renamed\" and body[\"hours\"] == 2.5, body)\nstatus, body, *_ = call(\"PATCH\", f\"/api/entries/{e1['id']}\", {\"hours\": \"nope\"}, token=alice, expect=400)\ncheck(\"patch validation\", status == 400 and \"hours\" in body.get(\"errors\", {}), body)\nstatus, *_ = call(\"PATCH\", f\"/api/entries/{e1['id']}\", {\"hours\": 3}, token=bob, expect=404)\ncheck(\"other user patch 404\", status == 404, status)\n\n# cross-user isolation ------------------------------------------------------\nstatus, body, *_ = call(\"DELETE\", f\"/api/entries/{e1['id']}\", token=bob, expect=404)\ncheck(\"other user delete 404\", status == 404, (status, body))\nstatus, body, *_ = call(\"GET\", \"/api/entries\", token=bob, expect=200)\ncheck(\"bob sees only own\", body[\"total\"] == 1 and body[\"items\"][0][\"project\"] == \"beta\", body)\n\n# delete -------------------------------------------------------------------\nstatus, body, *_ = call(\"DELETE\", f\"/api/entries/{e1['id']}\", token=alice, expect=200)\ncheck(\"delete own entry\", status == 200 and body.get(\"ok\") is True, (status, body))\nstatus, *_ = call(\"DELETE\", f\"/api/entries/{e1['id']}\", token=alice, expect=404)\ncheck(\"delete twice 404\", status == 404, status)\ne1 = None\n\n# recreate a couple for export tests ---------------------------------------\nadd(\"alpha\", \"second task\", 2, \"2024-03-01\")\nadd(\"alpha\", \"third task\", 0.25, \"2024-03-11\")\n\n# projects / totals ---------------------------------------------------------\nstatus, body, *_ = call(\"GET\", \"/api/projects\", token=alice, expect=200)\ncheck(\"project suggestions\", status == 200 and body == {\"items\": [\"007\", \"alpha\", \"beta\"]}, body)\nstatus, body, *_ = call(\"GET\", \"/api/totals\", token=alice, expect=200)\ntotals = {row[\"project\"]: row[\"hours\"] for row in body.get(\"items\", [])}\ncheck(\"totals\", status == 200 and totals.get(\"alpha\") == 2.75 and totals.get(\"007\") == 4 and totals.get(\"beta\") == 2, body)\nstatus, body, *_ = call(\"GET\", \"/api/totals?project=alpha\", token=alice, expect=200)\ncheck(\"totals project filter\", len(body.get(\"items\", [])) == 1 and body[\"items\"][0][\"project\"] == \"alpha\", body)\n\n# exports -------------------------------------------------------------------\nstatus, body, raw, ctype, disposition = call(\"GET\", \"/api/exports/entries.csv\", token=alice, expect=200)\ncheck(\"entries.csv content type\", \"text/csv\" in ctype and \"charset=utf-8\" in ctype, ctype)\ncheck(\"entries.csv disposition\", \"entries.csv\" in disposition, disposition)\nrows = csv_rows(raw)\ncheck(\n    \"entries.csv header + oldest first\",\n    rows[0] == [\"date\", \"project\", \"description\", \"hours\"]\n    and [r[0] for r in rows[1:]] == sorted(r[0] for r in rows[1:]),\n    rows,\n)\ncheck(\n    \"entries.csv values\",\n    [\"2024-03-01\", \"alpha\", \"second task\", \"2.0\"] in rows\n    and [\"2024-03-10\", \"alpha\", \"=1+1\", \"0.5\"] in rows\n    and [\"2024-03-07\", \"007\", 'with, comma and \"quotes\"', \"4.0\"] in rows,\n    rows,\n)\ncheck(\"entries.csv excludes bob\", all(\"bob\" not in \",\".join(r) for r in rows), rows)\n\nstatus, body, raw, ctype, _ = call(\"GET\", \"/api/exports/entries.csv?start_date=2024-03-06\", token=alice, expect=200)\nrows = csv_rows(raw)\ncheck(\"entries.csv date filter\", len(rows) == 3 and all(r[0] >= \"2024-03-06\" for r in rows[1:]), rows)\nstatus, body, raw, _, _ = call(\"GET\", \"/api/exports/entries.csv?project=beta\", token=alice, expect=200)\nrows = csv_rows(raw)\ncheck(\"entries.csv project filter\", len(rows) == 2 and all(r[1] == \"beta\" for r in rows[1:]), rows)\n\nstatus, body, raw, ctype, disposition = call(\"GET\", \"/api/exports/summary.csv\", token=alice, expect=200)\ncheck(\"summary.csv content type\", \"text/csv\" in ctype, ctype)\nrows = csv_rows(raw)\ncheck(\"summary.csv header + sorted\", rows[0] == [\"project\", \"hours\"] and [r[0] for r in rows[1:]] == sorted(r[0] for r in rows[1:]), rows)\nsummary = {r[0]: float(r[1]) for r in rows[1:]}\ncheck(\"summary.csv totals\", summary == {\"007\": 4.0, \"alpha\": 2.75, \"beta\": 2.0}, rows)\n\nstatus, body, raw, _, _ = call(\"GET\", \"/api/exports/summary.csv?start_date=2024-03-02&end_date=2024-03-06\", token=alice, expect=200)\nrows = csv_rows(raw)\nsummary = {r[0]: float(r[1]) for r in rows[1:]}\ncheck(\"summary.csv date filter\", summary == {\"alpha\": 2.0}, rows)\n\n# csv injection ------------------------------------------------------------\nstatus, _, raw, _, _ = call(\"GET\", \"/api/exports/entries.csv\", token=alice, expect=200)\nrows = csv_rows(raw)\ndangerous = [\n    (row[2], row[2][0] in (\"'\", \"=\", \"+\", \"-\", \"@\"))\n    for row in rows[1:]\n    if row[2][:1] in (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\")\n]\ncheck(\"formula cells neutralised\", all(flag for _, flag in dangerous) and dangerous, dangerous)\ninjected = [row for row in rows[1:] if row[2] == \"'=1+1\"]\ncheck(\"typed text preserved as apostrophe-prefixed cell\", len(injected) == 1, rows)\n\n# auth re-check ------------------------------------------------------------\nstatus, *_ = call(\"GET\", \"/api/entries\", token=alice, expect=200)\ncheck(\"token still valid\", status == 200, status)\n\nprint()\nif failures:\n    print(f\"{len(failures)} FAILURES:\")\n    for name in failures:\n        print(f\"  - {name}\")\n    raise SystemExit(1)\nprint(\"ALL CHECKS PASSED\")\n","filePath":"/workspace/.tmp_test_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.tmp_test_api.py","exists":false,"truncated":false},"title":".tmp_test_api.py","time":{"start":1794362625942,"end":1794362625956}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c858cf90001xwVBE4j6WnBLRQ","sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","messageID":"msg_1c85750fc001b2cHPR6vfsbFyh"}}
