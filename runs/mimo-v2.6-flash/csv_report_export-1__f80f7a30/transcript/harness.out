{"type":"tool_use","timestamp":1794363538921,"sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","part":{"type":"tool","tool":"write","callID":"call_b7618f16940f42c3a1097417","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  downloadFile,\n  fetchEntries,\n  fetchProjects,\n  fetchTotals,\n  filterQuery,\n  type EntriesPage,\n  type Filters,\n  type ProjectTotal,\n} from \"../api\";\nimport EntryTable from \"./EntryTable\";\nimport QuickEntryForm from \"./QuickEntryForm\";\nimport TotalsCard from \"./TotalsCard\";\n\nconst PAGE_SIZE = 10;\n\nconst filterFieldClass =\n  \"mt-1 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\";\n\ntype Props = {\n  username: string;\n  onSignOut: () => void;\n};\n\nexport default function Timesheet({ username, onSignOut }: Props) {\n  const [filters, setFilters] = useState<Filters>({\n    start_date: \"\",\n    end_date: \"\",\n    project: \"\",\n  });\n  const [page, setPage] = useState(1);\n  const [reloadKey, setReloadKey] = useState(0);\n  const [entries, setEntries] = useState<EntriesPage | null>(null);\n  const [totals, setTotals] = useState<ProjectTotal[]>([]);\n  const [projects, setProjects] = useState<string[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  const handleUnauthorized = useCallback(() => {\n    onSignOut();\n  }, [onSignOut]);\n\n  useEffect(() => {\n    let cancelled = false;\n\n    async function load() {\n      try {\n        const [pageData, projectTotals, projectNames] = await Promise.all([\n          fetchEntries(filters, page, PAGE_SIZE),\n          fetchTotals(filters),\n          fetchProjects(),\n        ]);\n        if (cancelled) {\n          return;\n        }\n        setEntries(pageData);\n        setTotals(projectTotals);\n        setProjects(projectNames);\n        setError(null);\n      } catch (err) {\n        if (cancelled) {\n          return;\n        }\n        if (err instanceof ApiError && err.status === 401) {\n          onSignOut();\n          return;\n        }\n        setError(err instanceof Error ? err.message : \"Failed to load entries\");\n      } finally {\n        if (!cancelled) {\n          setLoading(false);\n        }\n      }\n    }\n\n    void load();\n    return () => {\n      cancelled = true;\n    };\n  }, [filters, page, reloadKey, onSignOut]);\n\n  const reload = useCallback(() => {\n    setReloadKey((key) => key + 1);\n  }, []);\n\n  function updateFilter<K extends keyof Filters>(key: K, value: Filters[K]) {\n    setFilters((current) => ({ ...current, [key]: value }));\n    setPage(1);\n  }\n\n  function clearFilters() {\n    setFilters({ start_date: \"\", end_date: \"\", project: \"\" });\n    setPage(1);\n  }\n\n  async function handleExport(kind: \"entries\" | \"summary\") {\n    setError(null);\n    setNotice(null);\n    try {\n      if (kind === \"entries\") {\n        await downloadFile(\n          `/api/exports/entries.csv${filterQuery(filters)}`,\n          \"entries.csv\",\n        );\n        setNotice(\"entries.csv downloaded\");\n      } else {\n        await downloadFile(\n          `/api/exports/summary.csv${filterQuery({\n            start_date: filters.start_date,\n            end_date: filters.end_date,\n          })}`,\n          \"summary.csv\",\n        );\n        setNotice(\"summary.csv downloaded\");\n      }\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) {\n        onSignOut();\n        return;\n      }\n      setError(err instanceof Error ? err.message : \"Export failed\");\n    }\n  }\n\n  const totalPages = entries\n    ? Math.max(1, Math.ceil(entries.total / entries.page_size))\n    : 1;\n  const hasFilters = Boolean(\n    filters.start_date || filters.end_date || filters.project,\n  );\n\n  return (\n    <div className=\"min-h-screen bg-gray-100 text-gray-900\">\n      <header className=\"border-b border-gray-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-3\">\n          <div className=\"flex items-baseline gap-3\">\n            <h1 className=\"text-lg font-semibold text-gray-900\">Timesheet</h1>\n            <span className=\"hidden text-sm text-gray-500 sm:inline\">\n              Personal time tracking\n            </span>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-sm text-gray-600\">\n              Signed in as{\" \"}\n              <span className=\"font-medium text-gray-900\">{username}</span>\n            </span>\n            <button\n              type=\"button\"\n              onClick={onSignOut}\n              className=\"rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1\"\n            >\n              Sign out\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl space-y-6 px-4 py-6\">\n        {error && (\n          <div\n            role=\"alert\"\n            className=\"rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\"\n          >\n            {error}\n          </div>\n        )}\n        {notice && (\n          <div className=\"rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700\">\n            {notice}\n          </div>\n        )}\n\n        <QuickEntryForm\n          projects={projects}\n          onCreated={() => {\n            setNotice(\"Entry added\");\n            reload();\n          }}\n        />\n\n        <div className=\"grid gap-6 lg:grid-cols-3\">\n          <div className=\"space-y-4 lg:col-span-2\">\n            <section className=\"rounded-lg border border-gray-200 bg-white p-4 shadow-sm\">\n              <div className=\"flex flex-wrap items-end gap-3\">\n                <div className=\"min-w-[9.5rem] flex-1\">\n                  <label\n                    htmlFor=\"filter-start\"\n                    className=\"block text-xs font-medium text-gray-700\"\n                  >\n                    From\n                  </label>\n                  <input\n                    id=\"filter-start\"\n                    type=\"date\"\n                    value={filters.start_date}\n                    onChange={(event) =>\n                      updateFilter(\"start_date\", event.target.value)\n                    }\n                    className={filterFieldClass}\n                  />\n                </div>\n                <div className=\"min-w-[9.5rem] flex-1\">\n                  <label\n                    htmlFor=\"filter-end\"\n                    className=\"block text-xs font-medium text-gray-700\"\n                  >\n                    To\n                  </label>\n                  <input\n                    id=\"filter-end\"\n                    type=\"date\"\n                    value={filters.end_date}\n                    onChange={(event) =>\n                      updateFilter(\"end_date\", event.target.value)\n                    }\n                    className={filterFieldClass}\n                  />\n                </div>\n                <div className=\"min-w-[11rem] flex-1\">\n                  <label\n                    htmlFor=\"filter-project\"\n                    className=\"block text-xs font-medium text-gray-700\"\n                  >\n                    Project\n                  </label>\n                  <select\n                    id=\"filter-project\"\n                    value={filters.project}\n                    onChange={(event) =>\n                      updateFilter(\"project\", event.target.value)\n                    }\n                    className={filterFieldClass}\n                  >\n                    <option value=\"\">All projects</option>\n                    {projects.map((name) => (\n                      <option key={name} value={name}>\n                        {name}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={clearFilters}\n                  disabled={!hasFilters}\n                  className=\"rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  Clear\n                </button>\n                <div className=\"flex gap-2 sm:ml-auto\">\n                  <button\n                    type=\"button\"\n                    onClick={() => handleExport(\"entries\")}\n                    className=\"rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1\"\n                  >\n                    Export CSV\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleExport(\"summary\")}\n                    className=\"rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1\"\n                  >\n                    Export totals\n                  </button>\n                </div>\n              </div>\n            </section>\n\n            <EntryTable\n              entries={entries}\n              loading={loading}\n              projects={projects}\n              page={page}\n              totalPages={totalPages}\n              onPageChange={setPage}\n              onChanged={reload}\n              onUnauthorized={handleUnauthorized}\n            />\n          </div>\n\n          <TotalsCard totals={totals} />\n        </div>\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/Timesheet.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Timesheet.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Timesheet.tsx","time":{"start":1794363538880,"end":1794363538893}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c866bdb8001JzPlp3L0j0hGni","sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","messageID":"msg_1c86622e5001nYeqL9p8cWtYP2"}}
