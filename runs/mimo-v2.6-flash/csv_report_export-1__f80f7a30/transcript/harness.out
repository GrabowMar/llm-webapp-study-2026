{"type":"text","timestamp":1794362294440,"sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","part":{"id":"prt_1c853c093001UMhcZr4P7ijyvL","messageID":"msg_1c84c7a1700193Gjybi3Ynn16Y","sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","type":"text","text":"Dependencies are installed. Now I'll write the backend API.","time":{"start":1794362294419,"end":1794362294435}}}
{"type":"tool_use","timestamp":1794362294508,"sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","part":{"type":"tool","tool":"write","callID":"call_d33553785c0d4a57b20920a4","state":{"status":"completed","input":{"content":"\"\"\"Personal timesheet: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport io\nimport math\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"timesheet.db\"\n\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\nCSV_UNSAFE_PREFIXES = (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\")\n\napp = Flask(__name__, static_folder=None)\n\n\n# ---------------------------------------------------------------- database\n\n\ndef connect_db() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect_db()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect_db()\n    try:\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL\n                    REFERENCES users (id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS entries (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL\n                    REFERENCES users (id) ON DELETE CASCADE,\n                project TEXT NOT NULL,\n                description TEXT NOT NULL,\n                hours REAL NOT NULL,\n                date TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_entries_user_date\n                ON entries (user_id, date);\n            \"\"\"\n        )\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\n# ---------------------------------------------------------------- helpers\n\n\ndef payload() -> dict:\n    data = request.get_json(silent=True, force=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef api_error(message: str, status: int, errors: dict | None = None):\n    body: dict = {\"error\": message}\n    if errors is not None:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\ndef validation_error(errors: dict[str, str]):\n    return api_error(\"; \".join(errors.values()), 400, errors)\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    row = (\n        get_db()\n        .execute(\n            \"SELECT u.id, u.username FROM tokens AS t \"\n            \"JOIN users AS u ON u.id = t.user_id WHERE t.token = ?\",\n            (token,),\n        )\n        .fetchone()\n    )\n    return row\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return api_error(\"unauthorized\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\nclass FilterError(ValueError):\n    pass\n\n\ndef parse_date(value: str) -> str:\n    \"\"\"Validate a YYYY-MM-DD string and return it normalised.\"\"\"\n    candidate = value.strip()\n    if not DATE_RE.match(candidate):\n        raise FilterError(\"must be a valid date in YYYY-MM-DD format\")\n    try:\n        datetime.strptime(candidate, \"%Y-%m-%d\")\n    except ValueError as exc:\n        raise FilterError(\"must be a valid date in YYYY-MM-DD format\") from exc\n    return candidate\n\n\ndef parse_filters(args, include_project: bool = True) -> tuple[list[str], list]:\n    where: list[str] = []\n    params: list = []\n    for name, operator in ((\"start_date\", \">=\"), (\"end_date\", \"<=\")):\n        raw = args.get(name)\n        if raw:\n            try:\n                cleaned = parse_date(raw)\n            except FilterError as exc:\n                raise FilterError(f\"{name} {exc}\") from exc\n            where.append(f\"date {operator} ?\")\n            params.append(cleaned)\n    if include_project:\n        project = args.get(\"project\")\n        if project:\n            where.append(\"project = ?\")\n            params.append(project)\n    return where, params\n\n\ndef validate_entry(data: dict, *, partial: bool) -> tuple[dict, dict]:\n    \"\"\"Validate entry fields; returns (values, errors).\n\n    In partial mode only the keys present in ``data`` are checked and\n    returned, which is what PATCH needs.\n    \"\"\"\n    errors: dict[str, str] = {}\n    values: dict = {}\n\n    def given(field: str) -> bool:\n        return not partial or field in data\n\n    if given(\"project\"):\n        raw = data.get(\"project\")\n        if not isinstance(raw, str) or not raw.strip():\n            errors[\"project\"] = \"project is required\"\n        else:\n            values[\"project\"] = raw\n\n    if given(\"description\"):\n        raw = data.get(\"description\")\n        if not isinstance(raw, str) or not raw.strip():\n            errors[\"description\"] = \"description is required\"\n        else:\n            values[\"description\"] = raw\n\n    if given(\"hours\"):\n        raw = data.get(\"hours\")\n        number: float | None = None\n        if isinstance(raw, bool):\n            number = None\n        elif isinstance(raw, (int, float)):\n            number = float(raw)\n        elif isinstance(raw, str):\n            try:\n                number = float(raw.strip())\n            except ValueError:\n                number = None\n        if number is None or not math.isfinite(number):\n            errors[\"hours\"] = \"hours must be a number\"\n        elif number <= 0:\n            errors[\"hours\"] = \"hours must be a positive number\"\n        else:\n            values[\"hours\"] = number\n\n    if given(\"date\"):\n        raw = data.get(\"date\")\n        if not isinstance(raw, str) or not raw.strip():\n            errors[\"date\"] = \"date is required\"\n        else:\n            try:\n                values[\"date\"] = parse_date(raw)\n            except FilterError:\n                errors[\"date\"] = \"date must be a valid date in YYYY-MM-DD format\"\n\n    return values, errors\n\n\ndef entry_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"project\": row[\"project\"],\n        \"description\": row[\"description\"],\n        \"hours\": row[\"hours\"],\n        \"date\": row[\"date\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef sanitize_cell(value) -> str:\n    \"\"\"Keep spreadsheet programs from re-interpreting typed text.\"\"\"\n    text = \"\" if value is None else str(value)\n    if text[:1] in CSV_UNSAFE_PREFIXES:\n        return \"'\" + text\n    return text\n\n\ndef csv_response(rows: list[list], filename: str) -> Response:\n    buffer = io.StringIO()\n    writer = csv.writer(buffer, lineterminator=\"\\r\\n\")\n    for row in rows:\n        writer.writerow([sanitize_cell(cell) for cell in row])\n    response = Response(buffer.getvalue().encode(\"utf-8\"), mimetype=\"text/csv\")\n    response.headers[\"Content-Disposition\"] = f'attachment; filename=\"{filename}\"'\n    return response\n\n\n# ---------------------------------------------------------------- auth\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = payload()\n    errors: dict[str, str] = {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"username is required\"\n    if not isinstance(password, str) or password == \"\":\n        errors[\"password\"] = \"password is required\"\n    if errors:\n        return validation_error(errors)\n\n    username = username.strip()\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return api_error(\"username already exists\", 409, {\"username\": \"username already exists\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = payload()\n    errors: dict[str, str] = {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"username is required\"\n    if not isinstance(password, str) or password == \"\":\n        errors[\"password\"] = \"password is required\"\n    if errors:\n        return validation_error(errors)\n\n    row = (\n        get_db()\n        .execute(\"SELECT * FROM users WHERE username = ?\", (username.strip(),))\n        .fetchone()\n    )\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return api_error(\"invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], utcnow()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n# ---------------------------------------------------------------- entries\n\n\n@app.get(\"/api/entries\")\n@login_required\ndef list_entries():\n    try:\n        where, params = parse_filters(request.args)\n    except FilterError as exc:\n        return api_error(str(exc), 400)\n\n    try:\n        page = int(request.args.get(\"page\", \"1\"))\n        page_size = int(request.args.get(\"page_size\", \"100\"))\n    except ValueError:\n        return api_error(\"page and page_size must be integers\", 400)\n    if page < 1:\n        return api_error(\"page must be at least 1\", 400)\n    if page_size < 1 or page_size > 1000:\n        return api_error(\"page_size must be between 1 and 1000\", 400)\n\n    owner = [\"user_id = ?\"]\n    owner_params: list = [g.user[\"id\"]]\n    conditions = owner + where\n    all_params = owner_params + params\n    tail = \"\"\n    if where:\n        tail = \" AND \" + \" AND \".join(where)\n\n    db = get_db()\n    total = db.execute(\n        f\"SELECT COUNT(*) FROM entries WHERE {owner[0]}{tail}\", all_params\n    ).fetchone()[0]\n    rows = db.execute(\n        \"SELECT * FROM entries WHERE \"\n        + conditions[0]\n        + \"\".join(f\" AND {c}\" for c in conditions[1:])\n        + \" ORDER BY date DESC, id DESC LIMIT ? OFFSET ?\",\n        [*all_params, page_size, (page - 1) * page_size],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [entry_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/entries\")\n@login_required\ndef create_entry():\n    values, errors = validate_entry(payload(), partial=False)\n    if errors:\n        return validation_error(errors)\n\n    db = get_db()\n    cursor = db.execute(\n        \"INSERT INTO entries (user_id, project, description, hours, date, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            g.user[\"id\"],\n            values[\"project\"],\n            values[\"description\"],\n            values[\"hours\"],\n            values[\"date\"],\n            utcnow(),\n        ),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT * FROM entries WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(entry_dict(row)), 201\n\n\ndef load_entry(entry_id: int):\n    return (\n        get_db()\n        .execute(\n            \"SELECT * FROM entries WHERE id = ? AND user_id = ?\",\n            (entry_id, g.user[\"id\"]),\n        )\n        .fetchone()\n    )\n\n\n@app.patch(\"/api/entries/<int:entry_id>\")\n@login_required\ndef update_entry(entry_id: int):\n    existing = load_entry(entry_id)\n    if existing is None:\n        return api_error(\"entry not found\", 404)\n\n    values, errors = validate_entry(payload(), partial=True)\n    if errors:\n        return validation_error(errors)\n    if values:\n        assignments = \", \".join(f\"{field} = ?\" for field in values)\n        db = get_db()\n        db.execute(\n            f\"UPDATE entries SET {assignments} WHERE id = ? AND user_id = ?\",\n            [*values.values(), entry_id, g.user[\"id\"]],\n        )\n        db.commit()\n\n    return jsonify(entry_dict(load_entry(entry_id)))\n\n\n@app.delete(\"/api/entries/<int:entry_id>\")\n@login_required\ndef delete_entry(entry_id: int):\n    db = get_db()\n    cursor = db.execute(\n        \"DELETE FROM entries WHERE id = ? AND user_id = ?\",\n        (entry_id, g.user[\"id\"]),\n    )\n    db.commit()\n    if cursor.rowcount == 0:\n        return api_error(\"entry not found\", 404)\n    return jsonify({\"ok\": True}), 200\n\n\n@app.get(\"/api/projects\")\n@login_required\ndef list_projects():\n    rows = (\n        get_db()\n        .execute(\n            \"SELECT DISTINCT project FROM entries WHERE user_id = ? ORDER BY project\",\n            (g.user[\"id\"],),\n        )\n        .fetchall()\n    )\n    return jsonify({\"items\": [row[\"project\"] for row in rows]})\n\n\n@app.get(\"/api/totals\")\n@login_required\ndef totals():\n    try:\n        where, params = parse_filters(request.args)\n    except FilterError as exc:\n        return api_error(str(exc), 400)\n\n    sql = (\n        \"SELECT project, SUM(hours) AS total FROM entries WHERE user_id = ?\"\n        + (\" AND \" + \" AND \".join(where) if where else \"\")\n        + \" GROUP BY project ORDER BY project\"\n    )\n    rows = get_db().execute(sql, [g.user[\"id\"], *params]).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\"project\": row[\"project\"], \"hours\": row[\"total\"]} for row in rows\n            ]\n        }\n    )\n\n\n# ---------------------------------------------------------------- exports\n\n\n@app.get(\"/api/exports/entries.csv\")\n@login_required\ndef export_entries_csv():\n    try:\n        where, params = parse_filters(request.args)\n    except FilterError as exc:\n        return api_error(str(exc), 400)\n\n    sql = (\n        \"SELECT date, project, description, hours FROM entries WHERE user_id = ?\"\n        + (\" AND \" + \" AND \".join(where) if where else \"\")\n        + \" ORDER BY date ASC, id ASC\"\n    )\n    rows = get_db().execute(sql, [g.user[\"id\"], *params]).fetchall()\n    data = [\n        [row[\"date\"], row[\"project\"], row[\"description\"], row[\"hours\"]]\n        for row in rows\n    ]\n    return csv_response(data, \"entries.csv\")\n\n\n@app.get(\"/api/exports/summary.csv\")\n@login_required\ndef export_summary_csv():\n    try:\n        where, params = parse_filters(request.args, include_project=False)\n    except FilterError as exc:\n        return api_error(str(exc), 400)\n\n    sql = (\n        \"SELECT project, SUM(hours) AS total FROM entries WHERE user_id = ?\"\n        + (\" AND \" + \" AND \".join(where) if where else \"\")\n        + \" GROUP BY project ORDER BY project\"\n    )\n    rows = get_db().execute(sql, [g.user[\"id\"], *params]).fetchall()\n    data = [[row[\"project\"], row[\"total\"]] for row in rows]\n    return csv_response(data, \"summary.csv\")\n\n\n# ---------------------------------------------------------------- frontend\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return api_error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return api_error(\"frontend build not found\", 404)\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return api_error(\"not found\", 404)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return api_error(\"not found\", 404)\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_error):\n    if request.path.startswith(\"/api/\"):\n        return api_error(\"method not allowed\", 405)\n    return api_error(\"method not allowed\", 405)\n\n\n@app.after_request\ndef cors_headers(response):\n    if request.path.startswith(\"/api/\"):\n        response.headers.setdefault(\"Access-Control-Allow-Origin\", \"*\")\n        response.headers.setdefault(\n            \"Access-Control-Allow-Headers\", \"Authorization, Content-Type\"\n        )\n        response.headers.setdefault(\n            \"Access-Control-Allow-Methods\", \"GET, POST, PATCH, DELETE, OPTIONS\"\n        )\n    return response\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794362294430,"end":1794362294482}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c853c097001aNoTScWCRlQ81P","sessionID":"ses_e37c0206bffe1WqCsLDh8xik5o","messageID":"msg_1c84c7a1700193Gjybi3Ynn16Y"}}
