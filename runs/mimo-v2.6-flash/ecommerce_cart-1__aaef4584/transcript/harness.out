{"type":"tool_use","timestamp":1794381526011,"sessionID":"ses_e36ac0041ffeAjsRq7kwpL3mQR","part":{"type":"tool","tool":"read","callID":"call_f02c30b25199465085ac86d7","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Shop backend: JSON API under /api plus the built-in frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import hashlib\n6: import os\n7: import secrets\n8: import sqlite3\n9: from functools import wraps\n10: from pathlib import Path\n11: \n12: from flask import Flask, g, jsonify, request, send_from_directory\n13: \n14: BASE_DIR = Path(__file__).resolve().parent.parent\n15: DIST = BASE_DIR / \"frontend\" / \"dist\"\n16: DATA_DIR = BASE_DIR / \"data\"\n17: DB_PATH = DATA_DIR / \"shop.db\"\n18: \n19: ADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n20: ADMIN_ENABLED = bool(ADMIN_PASSWORD)\n21: \n22: DEFAULT_PAGE_SIZE = 10\n23: MAX_PAGE_SIZE = 100\n24: \n25: SEED_PRODUCTS = [\n26:     (\"Aurora Desk Lamp\", \"Warm LED desk lamp with a touch dimmer and a brushed metal arm.\", 3499, 25),\n27:     (\"Bamboo Monitor Riser\", \"Elevates your screen to eye level with a built-in drawer.\", 2750, 18),\n28:     (\"Ceramic Pour-Over Set\", \"Hand-glazed dripper and carafe for a clean, slow brew.\", 4200, 12),\n29:     (\"Drift Bluetooth Speaker\", \"Portable speaker with 12-hour battery and deep bass.\", 5999, 30),\n30:     (\"Ember Ceramic Mug\", \"Double-walled mug that keeps coffee hot for hours.\", 1425, 40),\n31:     (\"Frost Insulated Bottle\", \"Cold drinks stay cold for 24 hours, hot for 12.\", 2175, 22),\n32:     (\"Grove Notebook A5\", \"Dot-grid pages with a lay-flat binding and pen loop.\", 950, 50),\n33:     (\"Harbor Canvas Tote\", \"Heavyweight canvas tote with reinforced straps.\", 1800, 15),\n34:     (\"Ivory Mechanical Keyboard\", \"Compact hot-swappable keyboard with tactile switches.\", 8900, 11),\n35: ]\n36: \n37: app = Flask(__name__, static_folder=None)\n38: \n39: \n40: # --------------------------------------------------------------------------\n41: # Database\n42: # --------------------------------------------------------------------------\n43: \n44: \n45: def get_db() -> sqlite3.Connection:\n46:     if \"db\" not in g:\n47:         g.db = sqlite3.connect(DB_PATH)\n48:         g.db.row_factory = sqlite3.Row\n49:         g.db.execute(\"PRAGMA foreign_keys = ON\")\n50:     return g.db\n51: \n52: \n53: @app.teardown_appcontext\n54: def close_db(_exc: BaseException | None) -> None:\n55:     db = g.pop(\"db\", None)\n56:     if db is not None:\n57:         db.close()\n58: \n59: \n60: def hash_password(password: str, salt: str | None = None) -> str:\n61:     salt = salt or secrets.token_hex(16)\n62:     digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 120_000)\n63:     return f\"pbkdf2:{salt}:{digest.hex()}\"\n64: \n65: \n66: def verify_password(password: str, stored: str) -> bool:\n67:     try:\n68:         _, salt, digest = stored.split(\":\", 2)\n69:     except ValueError:\n70:         return False\n71:     candidate = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 120_000)\n72:     return secrets.compare_digest(candidate.hex(), digest)\n73: \n74: \n75: def init_db() -> None:\n76:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n77:     conn = sqlite3.connect(DB_PATH)\n78:     conn.row_factory = sqlite3.Row\n79:     try:\n80:         conn.execute(\"PRAGMA journal_mode = WAL\")\n81:         conn.executescript(\n82:             \"\"\"\n83:             CREATE TABLE IF NOT EXISTS users (\n84:                 id            INTEGER PRIMARY KEY AUTOINCREMENT,\n85:                 username      TEXT    NOT NULL UNIQUE,\n86:                 password_hash TEXT    NOT NULL,\n87:                 is_admin      INTEGER NOT NULL DEFAULT 0\n88:             );\n89:             CREATE TABLE IF NOT EXISTS tokens (\n90:                 token     TEXT PRIMARY KEY,\n91:                 user_id   INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n92:                 created_at TEXT NOT NULL DEFAULT (datetime('now'))\n93:             );\n94:             CREATE TABLE IF NOT EXISTS products (\n95:                 id          INTEGER PRIMARY KEY AUTOINCREMENT,\n96:                 name        TEXT    NOT NULL,\n97:                 description TEXT    NOT NULL DEFAULT '',\n98:                 price_cents INTEGER NOT NULL,\n99:                 stock       INTEGER NOT NULL DEFAULT 0,\n100:                 is_active   INTEGER NOT NULL DEFAULT 1\n101:             );\n102:             CREATE TABLE IF NOT EXISTS cart_items (\n103:                 id         INTEGER PRIMARY KEY AUTOINCREMENT,\n104:                 user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n105:                 product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n106:                 quantity   INTEGER NOT NULL,\n107:                 created_at TEXT    NOT NULL DEFAULT (datetime('now')),\n108:                 UNIQUE (user_id, product_id)\n109:             );\n110:             \"\"\"\n111:         )\n112:         seed_products(conn)\n113:         init_admin(conn)\n114:         conn.commit()\n115:     finally:\n116:         conn.close()\n117: \n118: \n119: def seed_products(conn: sqlite3.Connection) -> None:\n120:     count = conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\n121:     if count:\n122:         return\n123:     conn.executemany(\n124:         \"INSERT INTO products (name, description, price_cents, stock, is_active) VALUES (?, ?, ?, ?, 1)\",\n125:         SEED_PRODUCTS,\n126:     )\n127: \n128: \n129: def init_admin(conn: sqlite3.Connection) -> None:\n130:     row = conn.execute(\"SELECT id FROM users WHERE username = 'admin'\").fetchone()\n131:     if ADMIN_ENABLED:\n132:         password_hash = hash_password(ADMIN_PASSWORD)\n133:         if row is None:\n134:             conn.execute(\n135:                 \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n136:                 (password_hash,),\n137:             )\n138:         else:\n139:             conn.execute(\n140:                 \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n141:                 (password_hash, row[\"id\"]),\n142:             )\n143:             conn.execute(\"DELETE FROM tokens WHERE user_id = ?\", (row[\"id\"],))\n144:     elif row is not None:\n145:         # Admin sign-in is disabled: neutralise the stored password and sessions.\n146:         conn.execute(\"UPDATE users SET password_hash = ? WHERE id = ?\", (\"pbkdf2::disabled\", row[\"id\"]))\n147:         conn.execute(\"DELETE FROM tokens WHERE user_id = ?\", (row[\"id\"],))\n148: \n149: \n150: init_db()\n151: \n152: \n153: # --------------------------------------------------------------------------\n154: # Serialisation helpers\n155: # --------------------------------------------------------------------------\n156: \n157: \n158: def product_dict(row: sqlite3.Row) -> dict:\n159:     return {\n160:         \"id\": row[\"id\"],\n161:         \"name\": row[\"name\"],\n162:         \"description\": row[\"description\"],\n163:         \"price\": row[\"price_cents\"] / 100,\n164:         \"stock\": row[\"stock\"],\n165:         \"is_active\": bool(row[\"is_active\"]),\n166:     }\n167: \n168: \n169: def cart_item_dict(row: sqlite3.Row) -> dict:\n170:     line_cents = row[\"price_cents\"] * row[\"quantity\"]\n171:     return {\n172:         \"id\": row[\"id\"],\n173:         \"product_id\": row[\"product_id\"],\n174:         \"quantity\": row[\"quantity\"],\n175:         \"name\": row[\"name\"],\n176:         \"unit_price\": row[\"price_cents\"] / 100,\n177:         \"line_total\": line_cents / 100,\n178:     }\n179: \n180: \n181: def cart_payload(db: sqlite3.Connection, user_id: int) -> dict:\n182:     rows = db.execute(\n183:         \"\"\"\n184:         SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price_cents\n185:         FROM cart_items ci\n186:         JOIN products p ON p.id = ci.product_id\n187:         WHERE ci.user_id = ? AND p.is_active = 1\n188:         ORDER BY ci.id ASC\n189:         \"\"\",\n190:         (user_id,),\n191:     ).fetchall()\n192:     items = [cart_item_dict(r) for r in rows]\n193:     subtotal_cents = sum(r[\"price_cents\"] * r[\"quantity\"] for r in rows)\n194:     return {\"items\": items, \"subtotal\": subtotal_cents / 100}\n195: \n196: \n197: def error(message: str, status: int):\n198:     return jsonify({\"message\": message}), status\n199: \n200: \n201: def payload() -> dict | None:\n202:     data = request.get_json(silent=True)\n203:     return data if isinstance(data, dict) else None\n204: \n205: \n206: # --------------------------------------------------------------------------\n207: # Auth\n208: # --------------------------------------------------------------------------\n209: \n210: \n211: def current_user() -> sqlite3.Row | None:\n212:     header = request.headers.get(\"Authorization\", \"\")\n213:     if not header.startswith(\"Bearer \"):\n214:         return None\n215:     token = header[7:].strip()\n216:     if not token:\n217:         return None\n218:     row = get_db().execute(\n219:         \"\"\"\n220:         SELECT u.id, u.username, u.is_admin\n221:         FROM tokens t\n222:         JOIN users u ON u.id = t.user_id\n223:         WHERE t.token = ?\n224:         \"\"\",\n225:         (token,),\n226:     ).fetchone()\n227:     return row\n228: \n229: \n230: def login_required(view):\n231:     @wraps(view)\n232:     def wrapper(*args, **kwargs):\n233:         user = current_user()\n234:         if user is None:\n235:             return error(\"Authentication required\", 401)\n236:         g.user = user\n237:         return view(*args, **kwargs)\n238: \n239:     return wrapper\n240: \n241: \n242: def admin_required(view):\n243:     @wraps(view)\n244:     def wrapper(*args, **kwargs):\n245:         user = current_user()\n246:         if user is None:\n247:             return error(\"Authentication required\", 401)\n248:         if not user[\"is_admin\"]:\n249:             return error(\"Admin access required\", 403)\n250:         g.user = user\n251:         return view(*args, **kwargs)\n252: \n253:     return wrapper\n254: \n255: \n256: def issue_token(db: sqlite3.Connection, user_id: int) -> str:\n257:     token = secrets.token_urlsafe(32)\n258:     db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id))\n259:     db.commit()\n260:     return token\n261: \n262: \n263: @app.post(\"/api/auth/register\")\n264: def register():\n265:     data = payload()\n266:     if not data:\n267:         return error(\"Invalid JSON body\", 400)\n268:     username = data.get(\"username\")\n269:     password = data.get(\"password\")\n270:     if not isinstance(username, str) or not username.strip():\n271:         return error(\"username is required\", 400)\n272:     if not isinstance(password, str) or not password:\n273:         return error(\"password is required\", 400)\n274:     username = username.strip()\n275:     if len(username) > 64:\n276:         return error(\"username must be at most 64 characters\", 400)\n277:     if username.lower() == \"admin\":\n278:         return error(\"That username is reserved\", 400)\n279: \n280:     db = get_db()\n281:     existing = db.execute(\"SELECT id FROM users WHERE username = ?\", (username,)).fetchone()\n282:     if existing is not None:\n283:         return error(\"Username already taken\", 409)\n284:     cur = db.execute(\n285:         \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n286:         (username, hash_password(password)),\n287:     )\n288:     db.commit()\n289:     return jsonify({\"message\": \"Account created\", \"id\": cur.lastrowid}), 201\n290: \n291: \n292: @app.post(\"/api/auth/login\")\n293: def login():\n294:     data = payload()\n295:     if not data:\n296:         return error(\"Invalid JSON body\", 400)\n297:     username = data.get(\"username\")\n298:     password = data.get(\"password\")\n299:     if not isinstance(username, str) or not isinstance(password, str):\n300:         return error(\"username and password are required\", 400)\n301: \n302:     db = get_db()\n303:     user = db.execute(\n304:         \"SELECT id, username, password_hash, is_admin FROM users WHERE username = ?\",\n305:         (username.strip(),),\n306:     ).fetchone()\n307:     if user is None:\n308:         return error(\"Invalid username or password\", 401)\n309:     if user[\"is_admin\"] and not ADMIN_ENABLED:\n310:         return error(\"Admin sign-in is disabled\", 401)\n311:     if not verify_password(password, user[\"password_hash\"]):\n312:         return error(\"Invalid username or password\", 401)\n313:     token = issue_token(db, user[\"id\"])\n314:     return jsonify({\"token\": token}), 200\n315: \n316: \n317: @app.get(\"/api/auth/me\")\n318: @login_required\n319: def me():\n320:     user = g.user\n321:     return jsonify({\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}), 200\n322: \n323: \n324: # --------------------------------------------------------------------------\n325: # Products\n326: # --------------------------------------------------------------------------\n327: \n328: \n329: def parse_int(value, default: int) -> int:\n330:     try:\n331:         return int(value)\n332:     except (TypeError, ValueError):\n333:         return default\n334: \n335: \n336: @app.get(\"/api/products\")\n337: def list_products():\n338:     q = (request.args.get(\"q\") or \"\").strip()\n339:     page = parse_int(request.args.get(\"page\"), 1)\n340:     page_size = parse_int(request.args.get(\"page_size\"), DEFAULT_PAGE_SIZE)\n341:     if page < 1:\n342:         page = 1\n343:     if page_size < 1 or page_size > MAX_PAGE_SIZE:\n344:         page_size = DEFAULT_PAGE_SIZE\n345: \n346:     clauses = [\"is_active = 1\"]\n347:     params: list = []\n348:     if q:\n349:         escaped = (\n350:             q.lower()\n351:             .replace(\"\\\\\", \"\\\\\\\\\")\n352:             .replace(\"%\", \"\\\\%\")\n353:             .replace(\"_\", \"\\\\_\")\n354:         )\n355:         clauses.append(\"(LOWER(name) LIKE ? ESCAPE '\\\\' OR LOWER(description) LIKE ? ESCAPE '\\\\')\")\n356:         pattern = f\"%{escaped}%\"\n357:         params.extend([pattern, pattern])\n358: \n359:     where = \" AND \".join(clauses)\n360:     db = get_db()\n361:     total = db.execute(f\"SELECT COUNT(*) FROM products WHERE {where}\", params).fetchone()[0]\n362:     rows = db.execute(\n363:         f\"\"\"\n364:         SELECT * FROM products\n365:         WHERE {where}\n366:         ORDER BY name COLLATE NOCASE ASC, id ASC\n367:         LIMIT ? OFFSET ?\n368:         \"\"\",\n369:         [*params, page_size, (page - 1) * page_size],\n370:     ).fetchall()\n371:     return jsonify(\n372:         {\n373:             \"items\": [product_dict(r) for r in rows],\n374:             \"total\": total,\n375:             \"page\": page,\n376:             \"page_size\": page_size,\n377:         }\n378:     ), 200\n379: \n380: \n381: @app.get(\"/api/products/<int:product_id>\")\n382: def get_product(product_id: int):\n383:     row = get_db().execute(\n384:         \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n385:     ).fetchone()\n386:     if row is None:\n387:         return error(\"Product not found\", 404)\n388:     return jsonify(product_dict(row)), 200\n389: \n390: \n391: # --------------------------------------------------------------------------\n392: # Cart\n393: # --------------------------------------------------------------------------\n394: \n395: \n396: @app.get(\"/api/cart\")\n397: @login_required\n398: def get_cart():\n399:     return jsonify(cart_payload(get_db(), g.user[\"id\"])), 200\n400: \n401: \n402: @app.post(\"/api/cart\")\n403: @login_required\n404: def add_to_cart():\n405:     data = payload()\n406:     if not data:\n407:         return error(\"Invalid JSON body\", 400)\n408:     product_id = data.get(\"product_id\")\n409:     quantity = data.get(\"quantity\")\n410:     if not isinstance(product_id, int) or isinstance(product_id, bool):\n411:         return error(\"product_id is required\", 400)\n412:     if not isinstance(quantity, int) or isinstance(quantity, bool):\n413:         return error(\"quantity is required\", 400)\n414:     if quantity < 1:\n415:         return error(\"quantity must be at least 1\", 400)\n416: \n417:     db = get_db()\n418:     product = db.execute(\n419:         \"SELECT id FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n420:     ).fetchone()\n421:     if product is None:\n422:         return error(\"Product not found\", 404)\n423: \n424:     existing = db.execute(\n425:         \"SELECT id, quantity FROM cart_items WHERE user_id = ? AND product_id = ?\",\n426:         (g.user[\"id\"], product_id),\n427:     ).fetchone()\n428:     if existing is not None:\n429:         db.execute(\n430:             \"UPDATE cart_items SET quantity = ? WHERE id = ?\",\n431:             (existing[\"quantity\"] + quantity, existing[\"id\"]),\n432:         )\n433:     else:\n434:         db.execute(\n435:             \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n436:             (g.user[\"id\"], product_id, quantity),\n437:         )\n438:     db.commit()\n439:     return jsonify(cart_payload(db, g.user[\"id\"])), 200\n440: \n441: \n442: def own_cart_item(db: sqlite3.Connection, item_id: int) -> sqlite3.Row | None:\n443:     return db.execute(\n444:         \"SELECT * FROM cart_items WHERE id = ? AND user_id = ?\",\n445:         (item_id, g.user[\"id\"]),\n446:     ).fetchone()\n447: \n448: \n449: @app.patch(\"/api/cart/<int:item_id>\")\n450: @login_required\n451: def update_cart_item(item_id: int):\n452:     data = payload()\n453:     if not data:\n454:         return error(\"Invalid JSON body\", 400)\n455:     quantity = data.get(\"quantity\")\n456:     if not isinstance(quantity, int) or isinstance(quantity, bool):\n457:         return error(\"quantity is required\", 400)\n458:     if quantity < 1:\n459:         return error(\"quantity must be at least 1\", 400)\n460: \n461:     db = get_db()\n462:     item = own_cart_item(db, item_id)\n463:     if item is None:\n464:         return error(\"Cart item not found\", 404)\n465:     db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n466:     db.commit()\n467:     return jsonify(cart_payload(db, g.user[\"id\"])), 200\n468: \n469: \n470: @app.delete(\"/api/cart/<int:item_id>\")\n471: @login_required\n472: def remove_cart_item(item_id: int):\n473:     db = get_db()\n474:     item = own_cart_item(db, item_id)\n475:     if item is None:\n476:         return error(\"Cart item not found\", 404)\n477:     db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n478:     db.commit()\n479:     return jsonify(cart_payload(db, g.user[\"id\"])), 200\n480: \n481: \n482: # --------------------------------------------------------------------------\n483: # Admin\n484: # --------------------------------------------------------------------------\n485: \n486: \n487: def price_to_cents(value) -> int | None:\n488:     if isinstance(value, bool) or not isinstance(value, (int, float)):\n489:         return None\n490:     if value < 0:\n491:         return None\n492:     return int(round(value * 100))\n493: \n494: \n495: @app.post(\"/api/admin/products\")\n496: @admin_required\n497: def create_product():\n498:     data = payload()\n499:     if not data:\n500:         return error(\"Invalid JSON body\", 400)\n501: \n502:     name = data.get(\"name\")\n503:     if not isinstance(name, str) or not name.strip():\n504:         return error(\"name is required\", 400)\n505:     name = name.strip()\n506:     if len(name) > 200:\n507:         return error(\"name must be at most 200 characters\", 400)\n508: \n509:     description = data.get(\"description\", \"\")\n510:     if not isinstance(description, str):\n511:         return error(\"description must be a string\", 400)\n512: \n513:     if \"price\" not in data:\n514:         return error(\"price is required\", 400)\n515:     price_cents = price_to_cents(data.get(\"price\"))\n516:     if price_cents is None:\n517:         return error(\"price must be a non-negative number\", 400)\n518: \n519:     stock = data.get(\"stock\", 0)\n520:     if not isinstance(stock, int) or isinstance(stock, bool) or stock < 0:\n521:         return error(\"stock must be a non-negative integer\", 400)\n522: \n523:     is_active = data.get(\"is_active\", True)\n524:     if not isinstance(is_active, bool):\n525:         return error(\"is_active must be a boolean\", 400)\n526: \n527:     db = get_db()\n528:     cur = db.execute(\n529:         \"INSERT INTO products (name, description, price_cents, stock, is_active) VALUES (?, ?, ?, ?, ?)\",\n530:         (name, description, price_cents, stock, 1 if is_active else 0),\n531:     )\n532:     db.commit()\n533:     row = db.execute(\"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)).fetchone()\n534:     return jsonify(product_dict(row)), 201\n535: \n536: \n537: @app.patch(\"/api/admin/products/<int:product_id>\")\n538: @admin_required\n539: def update_product(product_id: int):\n540:     data = payload()\n541:     if not data:\n542:         return error(\"Invalid JSON body\", 400)\n543: \n544:     db = get_db()\n545:     row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n546:     if row is None:\n547:         return error(\"Product not found\", 404)\n548: \n549:     fields: dict[str, object] = {}\n550:     if \"name\" in data:\n551:         name = data[\"name\"]\n552:         if not isinstance(name, str) or not name.strip():\n553:             return error(\"name must be a non-empty string\", 400)\n554:         if len(name.strip()) > 200:\n555:             return error(\"name must be at most 200 characters\", 400)\n556:         fields[\"name\"] = name.strip()\n557:     if \"description\" in data:\n558:         if not isinstance(data[\"description\"], str):\n559:             return error(\"description must be a string\", 400)\n560:         fields[\"description\"] = data[\"description\"]\n561:     if \"price\" in data:\n562:         price_cents = price_to_cents(data[\"price\"])\n563:         if price_cents is None:\n564:             return error(\"price must be a non-negative number\", 400)\n565:         fields[\"price_cents\"] = price_cents\n566:     if \"stock\" in data:\n567:         stock = data[\"stock\"]\n568:         if not isinstance(stock, int) or isinstance(stock, bool) or stock < 0:\n569:             return error(\"stock must be a non-negative integer\", 400)\n570:         fields[\"stock\"] = stock\n571:     if \"is_active\" in data:\n572:         if not isinstance(data[\"is_active\"], bool):\n573:             return error(\"is_active must be a boolean\", 400)\n574:         fields[\"is_active\"] = 1 if data[\"is_active\"] else 0\n575: \n576:     if not fields:\n577:         return error(\"No valid fields to update\", 400)\n578: \n579:     sets = \", \".join(f\"{column} = ?\" for column in fields)\n580:     db.execute(\n581:         f\"UPDATE products SET {sets} WHERE id = ?\",\n582:         [*fields.values(), product_id],\n583:     )\n584:     db.commit()\n585:     updated = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n586:     return jsonify(product_dict(updated)), 200\n587: \n588: \n589: # --------------------------------------------------------------------------\n590: # Frontend + fallbacks\n591: # --------------------------------------------------------------------------\n592: \n593: \n594: @app.after_request\n595: def add_cors_headers(response):\n596:     response.headers.setdefault(\"Access-Control-Allow-Origin\", \"*\")\n597:     response.headers.setdefault(\n598:         \"Access-Control-Allow-Headers\", \"Authorization, Content-Type\"\n599:     )\n600:     response.headers.setdefault(\"Access-Control-Allow-Methods\", \"GET, POST, PATCH, DELETE, OPTIONS\")\n601:     return response\n602: \n603: \n604: @app.get(\"/api/health\")\n605: def health():\n606:     return {\"status\": \"ok\"}\n607: \n608: \n609: def serve_frontend(path: str):\n610:     if path.startswith(\"api/\"):\n611:         return error(\"Not found\", 404)\n612:     target = (DIST / path).resolve()\n613:     if path and target.is_file() and target.is_relative_to(DIST.resolve()):\n614:         return send_from_directory(DIST, path)\n615:     if not (DIST / \"index.html\").is_file():\n616:         return error(\"Frontend build not found\", 404)\n617:     return send_from_directory(DIST, \"index.html\")\n618: \n619: \n620: @app.get(\"/\")\n621: @app.get(\"/<path:path>\")\n622: def frontend(path: str = \"index.html\"):\n623:     return serve_frontend(path)\n624: \n625: \n626: @app.post(\"/<path:path>\")\n627: @app.patch(\"/<path:path>\")\n628: @app.delete(\"/<path:path>\")\n629: def frontend_fallback(path: str):\n630:     return serve_frontend(path)\n631: \n632: \n633: if __name__ == \"__main__\":\n634:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\n(End of file - total 634 lines)\n</content>","metadata":{"preview":"\"\"\"Shop backend: JSON API under /api plus the built-in frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"shop.db\"\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\nADMIN_ENABLED = bool(ADMIN_PASSWORD)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Shop backend: JSON API under /api plus the built-in frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDIST = BASE_DIR / \"frontend\" / \"dist\"\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"shop.db\"\n\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\nADMIN_ENABLED = bool(ADMIN_PASSWORD)\n\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\nSEED_PRODUCTS = [\n    (\"Aurora Desk Lamp\", \"Warm LED desk lamp with a touch dimmer and a brushed metal arm.\", 3499, 25),\n    (\"Bamboo Monitor Riser\", \"Elevates your screen to eye level with a built-in drawer.\", 2750, 18),\n    (\"Ceramic Pour-Over Set\", \"Hand-glazed dripper and carafe for a clean, slow brew.\", 4200, 12),\n    (\"Drift Bluetooth Speaker\", \"Portable speaker with 12-hour battery and deep bass.\", 5999, 30),\n    (\"Ember Ceramic Mug\", \"Double-walled mug that keeps coffee hot for hours.\", 1425, 40),\n    (\"Frost Insulated Bottle\", \"Cold drinks stay cold for 24 hours, hot for 12.\", 2175, 22),\n    (\"Grove Notebook A5\", \"Dot-grid pages with a lay-flat binding and pen loop.\", 950, 50),\n    (\"Harbor Canvas Tote\", \"Heavyweight canvas tote with reinforced straps.\", 1800, 15),\n    (\"Ivory Mechanical Keyboard\", \"Compact hot-swappable keyboard with tactile switches.\", 8900, 11),\n]\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# Database\n# --------------------------------------------------------------------------\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef hash_password(password: str, salt: str | None = None) -> str:\n    salt = salt or secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 120_000)\n    return f\"pbkdf2:{salt}:{digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        _, salt, digest = stored.split(\":\", 2)\n    except ValueError:\n        return False\n    candidate = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt.encode(\"utf-8\"), 120_000)\n    return secrets.compare_digest(candidate.hex(), digest)\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id            INTEGER PRIMARY KEY AUTOINCREMENT,\n                username      TEXT    NOT NULL UNIQUE,\n                password_hash TEXT    NOT NULL,\n                is_admin      INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token     TEXT PRIMARY KEY,\n                user_id   INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL DEFAULT (datetime('now'))\n            );\n            CREATE TABLE IF NOT EXISTS products (\n                id          INTEGER PRIMARY KEY AUTOINCREMENT,\n                name        TEXT    NOT NULL,\n                description TEXT    NOT NULL DEFAULT '',\n                price_cents INTEGER NOT NULL,\n                stock       INTEGER NOT NULL DEFAULT 0,\n                is_active   INTEGER NOT NULL DEFAULT 1\n            );\n            CREATE TABLE IF NOT EXISTS cart_items (\n                id         INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n                quantity   INTEGER NOT NULL,\n                created_at TEXT    NOT NULL DEFAULT (datetime('now')),\n                UNIQUE (user_id, product_id)\n            );\n            \"\"\"\n        )\n        seed_products(conn)\n        init_admin(conn)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef seed_products(conn: sqlite3.Connection) -> None:\n    count = conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\n    if count:\n        return\n    conn.executemany(\n        \"INSERT INTO products (name, description, price_cents, stock, is_active) VALUES (?, ?, ?, ?, 1)\",\n        SEED_PRODUCTS,\n    )\n\n\ndef init_admin(conn: sqlite3.Connection) -> None:\n    row = conn.execute(\"SELECT id FROM users WHERE username = 'admin'\").fetchone()\n    if ADMIN_ENABLED:\n        password_hash = hash_password(ADMIN_PASSWORD)\n        if row is None:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES ('admin', ?, 1)\",\n                (password_hash,),\n            )\n        else:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (password_hash, row[\"id\"]),\n            )\n            conn.execute(\"DELETE FROM tokens WHERE user_id = ?\", (row[\"id\"],))\n    elif row is not None:\n        # Admin sign-in is disabled: neutralise the stored password and sessions.\n        conn.execute(\"UPDATE users SET password_hash = ? WHERE id = ?\", (\"pbkdf2::disabled\", row[\"id\"]))\n        conn.execute(\"DELETE FROM tokens WHERE user_id = ?\", (row[\"id\"],))\n\n\ninit_db()\n\n\n# --------------------------------------------------------------------------\n# Serialisation helpers\n# --------------------------------------------------------------------------\n\n\ndef product_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": row[\"price_cents\"] / 100,\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\ndef cart_item_dict(row: sqlite3.Row) -> dict:\n    line_cents = row[\"price_cents\"] * row[\"quantity\"]\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": row[\"quantity\"],\n        \"name\": row[\"name\"],\n        \"unit_price\": row[\"price_cents\"] / 100,\n        \"line_total\": line_cents / 100,\n    }\n\n\ndef cart_payload(db: sqlite3.Connection, user_id: int) -> dict:\n    rows = db.execute(\n        \"\"\"\n        SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price_cents\n        FROM cart_items ci\n        JOIN products p ON p.id = ci.product_id\n        WHERE ci.user_id = ? AND p.is_active = 1\n        ORDER BY ci.id ASC\n        \"\"\",\n        (user_id,),\n    ).fetchall()\n    items = [cart_item_dict(r) for r in rows]\n    subtotal_cents = sum(r[\"price_cents\"] * r[\"quantity\"] for r in rows)\n    return {\"items\": items, \"subtotal\": subtotal_cents / 100}\n\n\ndef error(message: str, status: int):\n    return jsonify({\"message\": message}), status\n\n\ndef payload() -> dict | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\n# --------------------------------------------------------------------------\n# Auth\n# --------------------------------------------------------------------------\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"\"\"\n        SELECT u.id, u.username, u.is_admin\n        FROM tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef admin_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return error(\"Admin access required\", 403)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef issue_token(db: sqlite3.Connection, user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    db.execute(\"INSERT INTO tokens (token, user_id) VALUES (?, ?)\", (token, user_id))\n    db.commit()\n    return token\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = payload()\n    if not data:\n        return error(\"Invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    username = username.strip()\n    if len(username) > 64:\n        return error(\"username must be at most 64 characters\", 400)\n    if username.lower() == \"admin\":\n        return error(\"That username is reserved\", 400)\n\n    db = get_db()\n    existing = db.execute(\"SELECT id FROM users WHERE username = ?\", (username,)).fetchone()\n    if existing is not None:\n        return error(\"Username already taken\", 409)\n    cur = db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n        (username, hash_password(password)),\n    )\n    db.commit()\n    return jsonify({\"message\": \"Account created\", \"id\": cur.lastrowid}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = payload()\n    if not data:\n        return error(\"Invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"username and password are required\", 400)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT id, username, password_hash, is_admin FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if user is None:\n        return error(\"Invalid username or password\", 401)\n    if user[\"is_admin\"] and not ADMIN_ENABLED:\n        return error(\"Admin sign-in is disabled\", 401)\n    if not verify_password(password, user[\"password_hash\"]):\n        return error(\"Invalid username or password\", 401)\n    token = issue_token(db, user[\"id\"])\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    user = g.user\n    return jsonify({\"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])}), 200\n\n\n# --------------------------------------------------------------------------\n# Products\n# --------------------------------------------------------------------------\n\n\ndef parse_int(value, default: int) -> int:\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return default\n\n\n@app.get(\"/api/products\")\ndef list_products():\n    q = (request.args.get(\"q\") or \"\").strip()\n    page = parse_int(request.args.get(\"page\"), 1)\n    page_size = parse_int(request.args.get(\"page_size\"), DEFAULT_PAGE_SIZE)\n    if page < 1:\n        page = 1\n    if page_size < 1 or page_size > MAX_PAGE_SIZE:\n        page_size = DEFAULT_PAGE_SIZE\n\n    clauses = [\"is_active = 1\"]\n    params: list = []\n    if q:\n        escaped = (\n            q.lower()\n            .replace(\"\\\\\", \"\\\\\\\\\")\n            .replace(\"%\", \"\\\\%\")\n            .replace(\"_\", \"\\\\_\")\n        )\n        clauses.append(\"(LOWER(name) LIKE ? ESCAPE '\\\\' OR LOWER(description) LIKE ? ESCAPE '\\\\')\")\n        pattern = f\"%{escaped}%\"\n        params.extend([pattern, pattern])\n\n    where = \" AND \".join(clauses)\n    db = get_db()\n    total = db.execute(f\"SELECT COUNT(*) FROM products WHERE {where}\", params).fetchone()[0]\n    rows = db.execute(\n        f\"\"\"\n        SELECT * FROM products\n        WHERE {where}\n        ORDER BY name COLLATE NOCASE ASC, id ASC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [product_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    ), 200\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef get_product(product_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"Product not found\", 404)\n    return jsonify(product_dict(row)), 200\n\n\n# --------------------------------------------------------------------------\n# Cart\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/cart\")\n@login_required\ndef get_cart():\n    return jsonify(cart_payload(get_db(), g.user[\"id\"])), 200\n\n\n@app.post(\"/api/cart\")\n@login_required\ndef add_to_cart():\n    data = payload()\n    if not data:\n        return error(\"Invalid JSON body\", 400)\n    product_id = data.get(\"product_id\")\n    quantity = data.get(\"quantity\")\n    if not isinstance(product_id, int) or isinstance(product_id, bool):\n        return error(\"product_id is required\", 400)\n    if not isinstance(quantity, int) or isinstance(quantity, bool):\n        return error(\"quantity is required\", 400)\n    if quantity < 1:\n        return error(\"quantity must be at least 1\", 400)\n\n    db = get_db()\n    product = db.execute(\n        \"SELECT id FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if product is None:\n        return error(\"Product not found\", 404)\n\n    existing = db.execute(\n        \"SELECT id, quantity FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (g.user[\"id\"], product_id),\n    ).fetchone()\n    if existing is not None:\n        db.execute(\n            \"UPDATE cart_items SET quantity = ? WHERE id = ?\",\n            (existing[\"quantity\"] + quantity, existing[\"id\"]),\n        )\n    else:\n        db.execute(\n            \"INSERT INTO cart_items (user_id, product_id, quantity) VALUES (?, ?, ?)\",\n            (g.user[\"id\"], product_id, quantity),\n        )\n    db.commit()\n    return jsonify(cart_payload(db, g.user[\"id\"])), 200\n\n\ndef own_cart_item(db: sqlite3.Connection, item_id: int) -> sqlite3.Row | None:\n    return db.execute(\n        \"SELECT * FROM cart_items WHERE id = ? AND user_id = ?\",\n        (item_id, g.user[\"id\"]),\n    ).fetchone()\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\n@login_required\ndef update_cart_item(item_id: int):\n    data = payload()\n    if not data:\n        return error(\"Invalid JSON body\", 400)\n    quantity = data.get(\"quantity\")\n    if not isinstance(quantity, int) or isinstance(quantity, bool):\n        return error(\"quantity is required\", 400)\n    if quantity < 1:\n        return error(\"quantity must be at least 1\", 400)\n\n    db = get_db()\n    item = own_cart_item(db, item_id)\n    if item is None:\n        return error(\"Cart item not found\", 404)\n    db.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n    db.commit()\n    return jsonify(cart_payload(db, g.user[\"id\"])), 200\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\n@login_required\ndef remove_cart_item(item_id: int):\n    db = get_db()\n    item = own_cart_item(db, item_id)\n    if item is None:\n        return error(\"Cart item not found\", 404)\n    db.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    db.commit()\n    return jsonify(cart_payload(db, g.user[\"id\"])), 200\n\n\n# --------------------------------------------------------------------------\n# Admin\n# --------------------------------------------------------------------------\n\n\ndef price_to_cents(value) -> int | None:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return None\n    if value < 0:\n        return None\n    return int(round(value * 100))\n\n\n@app.post(\"/api/admin/products\")\n@admin_required\ndef create_product():\n    data = payload()\n    if not data:\n        return error(\"Invalid JSON body\", 400)\n\n    name = data.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return error(\"name is required\", 400)\n    name = name.strip()\n    if len(name) > 200:\n        return error(\"name must be at most 200 characters\", 400)\n\n    description = data.get(\"description\", \"\")\n    if not isinstance(description, str):\n        return error(\"description must be a string\", 400)\n\n    if \"price\" not in data:\n        return error(\"price is required\", 400)\n    price_cents = price_to_cents(data.get(\"price\"))\n    if price_cents is None:\n        return error(\"price must be a non-negative number\", 400)\n\n    stock = data.get(\"stock\", 0)\n    if not isinstance(stock, int) or isinstance(stock, bool) or stock < 0:\n        return error(\"stock must be a non-negative integer\", 400)\n\n    is_active = data.get(\"is_active\", True)\n    if not isinstance(is_active, bool):\n        return error(\"is_active must be a boolean\", 400)\n\n    db = get_db()\n    cur = db.execute(\n        \"INSERT INTO products (name, description, price_cents, stock, is_active) VALUES (?, ?, ?, ?, ?)\",\n        (name, description, price_cents, stock, 1 if is_active else 0),\n    )\n    db.commit()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(product_dict(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\n@admin_required\ndef update_product(product_id: int):\n    data = payload()\n    if not data:\n        return error(\"Invalid JSON body\", 400)\n\n    db = get_db()\n    row = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    if row is None:\n        return error(\"Product not found\", 404)\n\n    fields: dict[str, object] = {}\n    if \"name\" in data:\n        name = data[\"name\"]\n        if not isinstance(name, str) or not name.strip():\n            return error(\"name must be a non-empty string\", 400)\n        if len(name.strip()) > 200:\n            return error(\"name must be at most 200 characters\", 400)\n        fields[\"name\"] = name.strip()\n    if \"description\" in data:\n        if not isinstance(data[\"description\"], str):\n            return error(\"description must be a string\", 400)\n        fields[\"description\"] = data[\"description\"]\n    if \"price\" in data:\n        price_cents = price_to_cents(data[\"price\"])\n        if price_cents is None:\n            return error(\"price must be a non-negative number\", 400)\n        fields[\"price_cents\"] = price_cents\n    if \"stock\" in data:\n        stock = data[\"stock\"]\n        if not isinstance(stock, int) or isinstance(stock, bool) or stock < 0:\n            return error(\"stock must be a non-negative integer\", 400)\n        fields[\"stock\"] = stock\n    if \"is_active\" in data:\n        if not isinstance(data[\"is_active\"], bool):\n            return error(\"is_active must be a boolean\", 400)\n        fields[\"is_active\"] = 1 if data[\"is_active\"] else 0\n\n    if not fields:\n        return error(\"No valid fields to update\", 400)\n\n    sets = \", \".join(f\"{column} = ?\" for column in fields)\n    db.execute(\n        f\"UPDATE products SET {sets} WHERE id = ?\",\n        [*fields.values(), product_id],\n    )\n    db.commit()\n    updated = db.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return jsonify(product_dict(updated)), 200\n\n\n# --------------------------------------------------------------------------\n# Frontend + fallbacks\n# --------------------------------------------------------------------------\n\n\n@app.after_request\ndef add_cors_headers(response):\n    response.headers.setdefault(\"Access-Control-Allow-Origin\", \"*\")\n    response.headers.setdefault(\n        \"Access-Control-Allow-Headers\", \"Authorization, Content-Type\"\n    )\n    response.headers.setdefault(\"Access-Control-Allow-Methods\", \"GET, POST, PATCH, DELETE, OPTIONS\")\n    return response\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\ndef serve_frontend(path: str):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    target = (DIST / path).resolve()\n    if path and target.is_file() and target.is_relative_to(DIST.resolve()):\n        return send_from_directory(DIST, path)\n    if not (DIST / \"index.html\").is_file():\n        return error(\"Frontend build not found\", 404)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    return serve_frontend(path)\n\n\n@app.post(\"/<path:path>\")\n@app.patch(\"/<path:path>\")\n@app.delete(\"/<path:path>\")\ndef frontend_fallback(path: str):\n    return serve_frontend(path)\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))","lineStart":1,"lineEnd":634,"totalLines":634,"truncated":false}},"title":"backend/app.py","time":{"start":1794381525966,"end":1794381525984}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c97933c8001djKu6oSup35nZV","sessionID":"ses_e36ac0041ffeAjsRq7kwpL3mQR","messageID":"msg_1c979108e001FynJUF0WFQPSkB"}}
