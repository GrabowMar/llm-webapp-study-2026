{"type":"tool_use","timestamp":1794380113902,"sessionID":"ses_e36ac0041ffeAjsRq7kwpL3mQR","part":{"type":"tool","tool":"write","callID":"call_18253065cca04ae0bf183ca6","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  api,\n  clearSession,\n  errorMessage,\n  getStoredUsername,\n  saveSession,\n} from \"./api\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport AuthModal from \"./components/AuthModal\";\nimport CartDrawer from \"./components/CartDrawer\";\nimport Header from \"./components/Header\";\nimport ProductGrid from \"./components/ProductGrid\";\nimport type { Cart, CartItem, Product, ProductPage, User } from \"./types\";\n\nconst PAGE_SIZE = 12;\n\nfunction formatPrice(value: number): string {\n  return `$${value.toFixed(2)}`;\n}\n\nexport default function App() {\n  const [user, setUser] = useState<User | null>(null);\n  const [cart, setCart] = useState<Cart | null>(null);\n  const [cartOpen, setCartOpen] = useState(false);\n  const [cartError, setCartError] = useState(\"\");\n  const [cartBusy, setCartBusy] = useState(false);\n  const [authOpen, setAuthOpen] = useState(false);\n  const [notice, setNotice] = useState(\"\");\n\n  const [catalogue, setCatalogue] = useState<ProductPage>({\n    items: [],\n    total: 0,\n    page: 1,\n    page_size: PAGE_SIZE,\n  });\n  const [query, setQuery] = useState(\"\");\n  const [debouncedQuery, setDebouncedQuery] = useState(\"\");\n  const [page, setPage] = useState(1);\n\n  const refreshCart = useCallback(async () => {\n    try {\n      setCart(await api<Cart>(\"/api/cart\"));\n    } catch (err) {\n      if (err instanceof Error && \"status\" in err && (err as { status: number }).status === 401) {\n        clearSession();\n        setUser(null);\n        setCart(null);\n      }\n    }\n  }, []);\n\n  useEffect(() => {\n    const stored = getStoredUsername();\n    if (!stored) {\n      return;\n    }\n    let cancelled = false;\n    api<{ username: string; is_admin: boolean }>(\"/api/auth/me\")\n      .then(async (me) => {\n        if (cancelled) {\n          return;\n        }\n        setUser({ username: me.username, isAdmin: me.is_admin });\n        await refreshCart();\n      })\n      .catch(() => {\n        if (!cancelled) {\n          clearSession();\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [refreshCart]);\n\n  useEffect(() => {\n    if (!notice) {\n      return;\n    }\n    const timer = window.setTimeout(() => setNotice(\"\"), 5000);\n    return () => window.clearTimeout(timer);\n  }, [notice]);\n\n  useEffect(() => {\n    const timer = window.setTimeout(() => {\n      setDebouncedQuery(query.trim());\n      setPage(1);\n    }, 300);\n    return () => window.clearTimeout(timer);\n  }, [query]);\n\n  useEffect(() => {\n    let cancelled = false;\n    const params = new URLSearchParams({\n      page: String(page),\n      page_size: String(PAGE_SIZE),\n    });\n    const q = debouncedQuery;\n    if (q) {\n      params.set(\"q\", q);\n    }\n    api<ProductPage>(`/api/products?${params.toString()}`)\n      .then((data) => {\n        if (!cancelled) {\n          setCatalogue(data);\n        }\n      })\n      .catch((err) => {\n        if (!cancelled) {\n          setNotice(errorMessage(err));\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [debouncedQuery, page]);\n\n  const cartCount = cart ? cart.items.reduce((sum, item) => sum + item.quantity, 0) : 0;\n  const totalPages = Math.max(1, Math.ceil(catalogue.total / catalogue.page_size));\n\n  async function handleAuth(\n    username: string,\n    password: string,\n    mode: \"signin\" | \"register\",\n  ) {\n    if (mode === \"register\") {\n      await api(\"/api/auth/register\", {\n        method: \"POST\",\n        body: { username, password },\n      });\n    }\n    const { token } = await api<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n    });\n    saveSession(token, username.trim());\n    const me = await api<{ username: string; is_admin: boolean }>(\"/api/auth/me\");\n    setUser({ username: me.username, isAdmin: me.is_admin });\n    setAuthOpen(false);\n    setNotice(mode === \"register\" ? \"Account created — you are signed in.\" : \"Signed in.\");\n    await refreshCart();\n  }\n\n  function handleSignOut() {\n    clearSession();\n    setUser(null);\n    setCart(null);\n    setCartOpen(false);\n    setCartError(\"\");\n    setNotice(\"Signed out.\");\n  }\n\n  async function addToCart(product: Product) {\n    if (!user) {\n      setAuthOpen(true);\n      setNotice(\"Sign in to add items to your cart.\");\n      return;\n    }\n    try {\n      const updated = await api<Cart>(\"/api/cart\", {\n        method: \"POST\",\n        body: { product_id: product.id, quantity: 1 },\n      });\n      setCart(updated);\n      setCartError(\"\");\n      setCartOpen(true);\n    } catch (err) {\n      setNotice(errorMessage(err));\n    }\n  }\n\n  async function changeQuantity(item: CartItem, quantity: number) {\n    if (quantity < 1) {\n      return;\n    }\n    setCartBusy(true);\n    setCartError(\"\");\n    try {\n      setCart(\n        await api<Cart>(`/api/cart/${item.id}`, {\n          method: \"PATCH\",\n          body: { quantity },\n        }),\n      );\n    } catch (err) {\n      setCartError(errorMessage(err));\n    } finally {\n      setCartBusy(false);\n    }\n  }\n\n  async function removeItem(item: CartItem) {\n    setCartBusy(true);\n    setCartError(\"\");\n    try {\n      setCart(await api<Cart>(`/api/cart/${item.id}`, { method: \"DELETE\" }));\n    } catch (err) {\n      setCartError(errorMessage(err));\n    } finally {\n      setCartBusy(false);\n    }\n  }\n\n  async function createProduct(body: {\n    name: string;\n    description: string;\n    price: number;\n    stock: number;\n    is_active: boolean;\n  }) {\n    return api<Product>(\"/api/admin/products\", { method: \"POST\", body });\n  }\n\n  async function refreshProducts() {\n    const params = new URLSearchParams({\n      page: String(page),\n      page_size: String(PAGE_SIZE),\n    });\n    if (debouncedQuery) {\n      params.set(\"q\", debouncedQuery);\n    }\n    setCatalogue(await api<ProductPage>(`/api/products?${params.toString()}`));\n  }\n\n  async function patchProduct(id: number, body: Partial<Product>) {\n    const updated = await api<Product>(`/api/admin/products/${id}`, {\n      method: \"PATCH\",\n      body,\n    });\n    setCatalogue((current) => ({\n      ...current,\n      items: updated.is_active\n        ? current.items.map((item) => (item.id === id ? updated : item))\n        : current.items.filter((item) => item.id !== id),\n    }));\n    return updated;\n  }\n\n  const isAdmin = user?.isAdmin ?? false;\n\n  return (\n    <div className=\"min-h-screen text-slate-800\">\n      <Header\n        user={user}\n        cartCount={cartCount}\n        cartOpen={cartOpen}\n        onCartClick={() => {\n          setCartOpen(true);\n          setCartError(\"\");\n        }}\n        onAuthClick={() => setAuthOpen(true)}\n        onSignOut={handleSignOut}\n      />\n\n      <main className=\"mx-auto max-w-6xl px-4 py-6\">\n        {notice && (\n          <div className=\"mb-4 flex items-center justify-between rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm text-indigo-800\">\n            <span>{notice}</span>\n            <button\n              type=\"button\"\n              onClick={() => setNotice(\"\")}\n              aria-label=\"Dismiss\"\n              className=\"ml-3 text-indigo-400 hover:text-indigo-700\"\n            >\n              ✕\n            </button>\n          </div>\n        )}\n\n        {isAdmin && (\n          <AdminPanel onCreated={refreshProducts} onCreate={createProduct} />\n        )}\n\n        <section>\n          <div className=\"mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n            <h1 className=\"text-2xl font-bold text-slate-900\">Products</h1>\n            <input\n              type=\"search\"\n              value={query}\n              onChange={(event) => setQuery(event.target.value)}\n              placeholder=\"Search products…\"\n              aria-label=\"Search products\"\n              className=\"w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 sm:w-72\"\n            />\n          </div>\n\n          <ProductGrid\n            products={catalogue.items}\n            isAdmin={isAdmin}\n            canAdd={Boolean(user)}\n            onAdd={addToCart}\n            onPatch={patchProduct}\n          />\n\n          <nav className=\"mt-6 flex items-center justify-center gap-4\">\n            <button\n              type=\"button\"\n              onClick={() => setPage((value) => Math.max(1, value - 1))}\n              disabled={page <= 1}\n              className=\"rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:opacity-40\"\n            >\n              Previous\n            </button>\n            <span className=\"text-sm text-slate-600\">\n              Page {catalogue.page} of {totalPages} · {catalogue.total} product\n              {catalogue.total === 1 ? \"\" : \"s\"}\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => setPage((value) => Math.min(totalPages, value + 1))}\n              disabled={page >= totalPages}\n              className=\"rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:opacity-40\"\n            >\n              Next\n            </button>\n          </nav>\n        </section>\n      </main>\n\n      <CartDrawer\n        open={cartOpen}\n        cart={cart}\n        error={cartError}\n        busy={cartBusy}\n        onClose={() => setCartOpen(false)}\n        onQuantity={changeQuantity}\n        onRemove={removeItem}\n      />\n\n      <AuthModal\n        open={authOpen}\n        onClose={() => setAuthOpen(false)}\n        onAuth={handleAuth}\n      />\n\n      <footer className=\"mx-auto max-w-6xl px-4 py-8 text-center text-xs text-slate-400\">\n        Prices shown as {formatPrice(0).slice(0, 1)} amounts, computed server-side from the\n        catalogue.\n      </footer>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794380113869,"end":1794380113880}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c963a7c8001eMd9vJ0jk4NBeh","sessionID":"ses_e36ac0041ffeAjsRq7kwpL3mQR","messageID":"msg_1c961f9a6001Kltl8CKgxAjwpV"}}
