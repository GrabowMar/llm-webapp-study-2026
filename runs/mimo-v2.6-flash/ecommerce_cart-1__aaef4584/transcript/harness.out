quest\n+def add_cors_headers(response):\n+    response.headers.setdefault(\"Access-Control-Allow-Origin\", \"*\")\n+    response.headers.setdefault(\n+        \"Access-Control-Allow-Headers\", \"Authorization, Content-Type\"\n+    )\n+    response.headers.setdefault(\"Access-Control-Allow-Methods\", \"GET, POST, PATCH, DELETE, OPTIONS\")\n+    return response\n+\n+\n @app.get(\"/api/health\")\n def health():\n     return {\"status\": \"ok\"}\n \n","additions":10,"deletions":0},"truncated":false},"title":"backend/app.py","time":{"start":1794381500714,"end":1794381500735}},"id":"prt_1c978d125001yTEUUoxL1yOA6Z","sessionID":"ses_e36ac0041ffeAjsRq7kwpL3mQR","messageID":"msg_1c978aa05001GjH8mrl9yeJV34"}}
