    await onPatch(product.id, {\n48:         price: priceValue,\n49:         stock: stockValue,\n50:         is_active: isActive,\n51:       });\n52:     } catch (err) {\n53:       setError(errorMessage(err));\n54:     } finally {\n55:       setBusy(false);\n56:     }\n57:   }\n58: \n59:   return (\n60:     <article className=\"flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md\">\n\n(Showing lines 1-60 of 176. Use offset=61 to continue.)\n</content>","metadata":{"preview":"import { useEffect, useState } from \"react\";\nimport { errorMessage } from \"../api\";\nimport type { Product } from \"../types\";\n\ntype Props = {\n  product: Product;\n  canAdd: boolean;\n  isAdmin: boolean;\n  onAdd: (product: Product) => void;\n  onPatch: (id: number, body: Partial<Product>) => Promise<Product>;\n};\n\nfunction formatPrice(value: number): string {\n  return `$${value.toFixed(2)}`;\n}\n\nfunction ProductCard({ product, canAdd, isAdmin, onAdd, onPatch }: Props) {\n  const [price, setPrice] = useState(product.price.toFixed(2));\n  const [stock, setStock] = useState(String(product.stock));\n  const [isActive, setIsActive] = useState(product.is_active);","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components/ProductGrid.tsx","text":"import { useEffect, useState } from \"react\";\nimport { errorMessage } from \"../api\";\nimport type { Product } from \"../types\";\n\ntype Props = {\n  product: Product;\n  canAdd: boolean;\n  isAdmin: boolean;\n  onAdd: (product: Product) => void;\n  onPatch: (id: number, body: Partial<Product>) => Promise<Product>;\n};\n\nfunction formatPrice(value: number): string {\n  return `$${value.toFixed(2)}`;\n}\n\nfunction ProductCard({ product, canAdd, isAdmin, onAdd, onPatch }: Props) {\n  const [price, setPrice] = useState(product.price.toFixed(2));\n  const [stock, setStock] = useState(String(product.stock));\n  const [isActive, setIsActive] = useState(product.is_active);\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    setPrice(product.price.toFixed(2));\n    setStock(String(product.stock));\n    setIsActive(product.is_active);\n    setError(\"\");\n  }, [product]);\n\n  const outOfStock = product.stock <= 0;\n\n  async function save() {\n    setError(\"\");\n    const priceValue = Number(price);\n    const stockValue = Number(stock);\n    if (!Number.isFinite(priceValue) || priceValue < 0) {\n      setError(\"Price must be a non-negative number\");\n      return;\n    }\n    if (!Number.isInteger(stockValue) || stockValue < 0) {\n      setError(\"Stock must be a non-negative integer\");\n      return;\n    }\n    setBusy(true);\n    try {\n      await onPatch(product.id, {\n        price: priceValue,\n        stock: stockValue,\n        is_active: isActive,\n      });\n    } catch (err) {\n      setError(errorMessage(err));\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <article className=\"flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md\">","lineStart":1,"lineEnd":60,"totalLines":176,"truncated":true}},"title":"frontend/src/components/ProductGrid.tsx","time":{"start":1794381442075,"end":1794381442089}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c977ec16001pHbYgBsS6D8Adl","sessionID":"ses_e36ac0041ffeAjsRq7kwpL3mQR","messageID":"msg_1c975d4a60011sfTtUpqnZk82v"}}
