{"type":"tool_use","timestamp":1794366551390,"sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","part":{"type":"tool","tool":"write","callID":"call_8299fbe9934b4d85b2c30387","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  Post,\n  deletePost,\n  fetchPost,\n  togglePost,\n} from \"../api\";\nimport { formatDate } from \"../format\";\nimport { navigate } from \"../router\";\n\ntype Props = {\n  id: number;\n  username: string | null;\n  onTagClick: (tag: string) => void;\n};\n\nexport default function PostPage({ id, username, onTagClick }: Props) {\n  const [post, setPost] = useState<Post | null>(null);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n\n  const load = useCallback(() => {\n    setLoading(true);\n    fetchPost(id)\n      .then((result) => {\n        setPost(result);\n        setError(\"\");\n      })\n      .catch((err: unknown) => {\n        setPost(null);\n        setError(err instanceof ApiError ? err.message : \"Failed to load post\");\n      })\n      .finally(() => setLoading(false));\n  }, [id]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function handleDelete() {\n    if (!window.confirm(\"Delete this post? This cannot be undone.\")) return;\n    try {\n      await deletePost(id);\n      navigate(\"/\");\n    } catch (err: unknown) {\n      setError(err instanceof ApiError ? err.message : \"Failed to delete post\");\n    }\n  }\n\n  async function handleToggle() {\n    try {\n      await togglePost(id);\n      load();\n    } catch (err: unknown) {\n      setError(err instanceof ApiError ? err.message : \"Failed to update post\");\n    }\n  }\n\n  if (loading && !post) {\n    return <p className=\"text-gray-500\">Loading post…</p>;\n  }\n\n  if (!post) {\n    return (\n      <div>\n        <div className=\"mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\">\n          {error || \"Post not found\"}\n        </div>\n        <a href=\"#/\" className=\"text-sm font-medium text-indigo-600 hover:underline\">\n          ← Back to posts\n        </a>\n      </div>\n    );\n  }\n\n  const isAuthor = username !== null && username === post.author;\n  const isAdmin = username === \"admin\";\n\n  return (\n    <article>\n      {error && (\n        <div className=\"mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\">\n          {error}\n        </div>\n      )}\n\n      <div className=\"mb-4 flex flex-wrap items-start justify-between gap-3\">\n        <div>\n          <h1 className=\"text-3xl font-bold text-gray-900\">{post.title}</h1>\n          <p className=\"mt-2 text-sm text-gray-500\">\n            by <span className=\"font-medium text-gray-700\">{post.author}</span> ·{\" \"}\n            <time dateTime={post.created_at}>{formatDate(post.created_at)}</time>\n            {post.updated_at !== post.created_at && (\n              <>\n                {\" \"}\n                · updated <time dateTime={post.updated_at}>{formatDate(post.updated_at)}</time>\n              </>\n            )}\n          </p>\n        </div>\n        <div className=\"flex flex-wrap gap-2\">\n          {isAuthor && (\n            <>\n              <a\n                href={`#/edit/${post.id}`}\n                className=\"rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50\"\n              >\n                Edit\n              </a>\n              <button\n                type=\"button\"\n                onClick={handleDelete}\n                className=\"rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50\"\n              >\n                Delete\n              </button>\n            </>\n          )}\n          {isAdmin && (\n            <button\n              type=\"button\"\n              onClick={handleToggle}\n              className={\n                post.taken_down\n                  ? \"rounded-md border border-green-300 bg-green-50 px-3 py-1.5 text-sm font-medium text-green-700 hover:bg-green-100\"\n                  : \"rounded-md border border-red-300 bg-red-50 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-100\"\n              }\n            >\n              {post.taken_down ? \"Restore\" : \"Take down\"}\n            </button>\n          )}\n        </div>\n      </div>\n\n      {post.taken_down && (\n        <span className=\"mb-4 inline-block rounded bg-red-100 px-2 py-0.5 text-xs font-semibold uppercase text-red-700\">\n          Taken down\n        </span>\n      )}\n\n      {post.tags.length > 0 && (\n        <div className=\"mb-6 flex flex-wrap gap-2\">\n          {post.tags.map((tag) => (\n            <button\n              key={tag}\n              type=\"button\"\n              onClick={() => onTagClick(tag)}\n              className=\"rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 hover:bg-indigo-100\"\n            >\n              {tag}\n            </button>\n          ))}\n        </div>\n      )}\n\n      <div className=\"rounded-lg border border-gray-200 bg-white p-6 shadow-sm\">\n        <div className=\"whitespace-pre-line leading-7 text-gray-800\">{post.content}</div>\n      </div>\n\n      <div className=\"mt-6\">\n        <a href=\"#/\" className=\"text-sm font-medium text-indigo-600 hover:underline\">\n          ← Back to posts\n        </a>\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/components/PostPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/PostPage.tsx","exists":false,"truncated":false},"title":"frontend/src/components/PostPage.tsx","time":{"start":1794366551364,"end":1794366551373}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c894b53f001CiA3o3x6pFtwUP","sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI"