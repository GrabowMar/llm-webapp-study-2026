{"type":"step_start","timestamp":1794365551834,"sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","part":{"id":"prt_1c88574c6001FGOhjBKz88pi0K","messageID":"msg_1c8842f4c001i34dUXlWSlf7YS","sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","type":"step-start"}}
{"type":"tool_use","timestamp":1794365551861,"sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","part":{"type":"tool","tool":"write","callID":"call_614401552e6e4aa48086371d","state":{"status":"completed","input":{"content":"\"\"\"Post endpoints.\"\"\"\n\nimport re\nfrom datetime import datetime, timedelta, timezone\n\nfrom flask import jsonify, request\n\nfrom auth import api_error, current_user, require_admin, require_auth\nfrom db import get_conn\n\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\nLINE_BREAKS = re.compile(r\"(?:\\r\\n|\\r|\\n)+\")\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n\n\ndef excerpt(content: str) -> str:\n    return LINE_BREAKS.sub(\" \", content)[:200]\n\n\ndef normalize_tags(value):\n    \"\"\"Return a cleaned tag list, or raise ValueError.\"\"\"\n    if value is None:\n        return []\n    if not isinstance(value, list):\n        raise ValueError(\"Tags must be a list of strings\")\n    tags = []\n    for item in value:\n        if not isinstance(item, str):\n            raise ValueError(\"Tags must be a list of strings\")\n        tag = item.strip()\n        if tag and tag not in tags:\n            tags.append(tag)\n    return tags\n\n\ndef validate_body(body, *, partial: bool = False):\n    errors = []\n    title = body.get(\"title\")\n    content = body.get(\"content\")\n    if not partial:\n        if not isinstance(title, str) or not title.strip():\n            errors.append(\"Title is required\")\n        if not isinstance(content, str):\n            errors.append(\"Content is required\")\n    else:\n        if \"title\" in body and (not isinstance(title, str) or not title.strip()):\n            errors.append(\"Title is required\")\n        if \"content\" in body and not isinstance(content, str):\n            errors.append(\"Content is required\")\n    tags = None\n    if \"tags\" in body:\n        try:\n            tags = normalize_tags(body.get(\"tags\"))\n        except ValueError as exc:\n            errors.append(str(exc))\n    if errors:\n        return None, errors\n    return {\"title\": title, \"content\": content, \"tags\": tags}, None\n\n\ndef load_post(post_id: int):\n    with get_conn() as conn:\n        row = conn.execute(\n            \"\"\"SELECT p.*, u.username AS author\n               FROM posts p JOIN users u ON u.id = p.author_id\n               WHERE p.id = ?\"\"\",\n            (post_id,),\n        ).fetchone()\n        if not row:\n            return None\n        tags = [\n            r[\"tag\"]\n            for r in conn.execute(\n                \"SELECT tag FROM tags WHERE post_id = ? ORDER BY rowid\", (post_id,)\n            )\n        ]\n    post = dict(row)\n    post[\"tags\"] = tags\n    return post\n\n\ndef save_tags(post_id: int, tags) -> None:\n    with get_conn() as conn:\n        conn.execute(\"DELETE FROM tags WHERE post_id = ?\", (post_id,))\n        for tag in tags:\n            conn.execute(\"INSERT INTO tags (post_id, tag) VALUES (?, ?)\", (post_id, tag))\n\n\ndef serialize(post: dict, *, with_status: bool = False) -> dict:\n    data = {\n        \"id\": post[\"id\"],\n        \"title\": post[\"title\"],\n        \"content\": post[\"content\"],\n        \"tags\": post[\"tags\"],\n        \"created_at\": post[\"created_at\"],\n        \"updated_at\": post[\"updated_at\"],\n        \"author\": post[\"author\"],\n        \"excerpt\": excerpt(post[\"content\"]),\n    }\n    if with_status:\n        data[\"taken_down\"] = bool(post[\"taken_down\"])\n    return data\n\n\ndef visible_to(post: dict, user) -> bool:\n    if not post[\"taken_down\"]:\n        return True\n    return bool(user and user[\"is_admin\"])\n\n\ndef touch_updated(post: dict) -> str:\n    previous = post[\"updated_at\"]\n    now = datetime.now(timezone.utc)\n    try:\n        prev_dt = datetime.fromisoformat(previous)\n        if prev_dt.tzinfo is None:\n            prev_dt = prev_dt.replace(tzinfo=timezone.utc)\n        if now <= prev_dt:\n            now = prev_dt + timedelta(microseconds=1)\n    except ValueError:\n        pass\n    return now.isoformat(timespec=\"microseconds\")\n\n\ndef register_routes(app):\n    @app.get(\"/api/posts\")\n    def list_posts():\n        user = current_user()\n        args = request.args\n\n        def param(name: str) -> str:\n            value = args.get(name, \"\")\n            return value.strip() if isinstance(value, str) else \"\"\n\n        try:\n            page = int(args.get(\"page\", 1))\n        except (TypeError, ValueError):\n            page = 1\n        try:\n            page_size = int(args.get(\"page_size\", DEFAULT_PAGE_SIZE))\n        except (TypeError, ValueError):\n            page_size = DEFAULT_PAGE_SIZE\n        page = max(1, page)\n        page_size = max(1, min(MAX_PAGE_SIZE, page_size))\n\n        q = param(\"q\")\n        tag = param(\"tag\")\n        author = param(\"author\")\n        include_taken_down = (\n            bool(user and user[\"is_admin\"]) and args.get(\"include_taken_down\") in (\"1\", \"true\", \"yes\")\n        )\n\n        where = []\n        params = []\n        if not include_taken_down:\n            where.append(\"p.taken_down = 0\")\n        if q:\n            pattern = \"%\" + q.lower().replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\") + \"%\"\n            where.append(\n                \"(LOWER(p.title) LIKE ? ESCAPE '\\\\' OR LOWER(p.content) LIKE ? ESCAPE '\\\\')\"\n            )\n            params.extend([pattern, pattern])\n        if tag:\n            where.append(\"p.id IN (SELECT post_id FROM tags WHERE tag = ?)\")\n            params.append(tag)\n        if author:\n            where.append(\"u.username = ?\")\n            params.append(author)\n        where_sql = \" AND \".join(where) if where else \"1=1\"\n\n        with get_conn() as conn:\n            total = conn.execute(\n                f\"\"\"SELECT COUNT(*) AS n\n                    FROM posts p JOIN users u ON u.id = p.author_id\n                    WHERE {where_sql}\"\"\",\n                params,\n            ).fetchone()[\"n\"]\n            rows = conn.execute(\n                f\"\"\"SELECT p.*, u.username AS author\n                    FROM posts p JOIN users u ON u.id = p.author_id\n                    WHERE {where_sql}\n                    ORDER BY p.created_at DESC, p.id DESC\n                    LIMIT ? OFFSET ?\"\"\",\n                [*params, page_size, (page - 1) * page_size],\n            ).fetchall()\n            items = []\n            for row in rows:\n                tags = [\n                    r[\"tag\"]\n                    for r in conn.execute(\n                        \"SELECT tag FROM tags WHERE post_id = ? ORDER BY rowid\",\n                        (row[\"id\"],),\n                    )\n                ]\n                post = dict(row)\n                post[\"tags\"] = tags\n                items.append(\n                    serialize(post, with_status=include_taken_down)\n                )\n\n        return jsonify({\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size})\n\n    @app.post(\"/api/posts\")\n    @require_auth\n    def create_post():\n        user = current_user()\n        body = request.get_json(silent=True, force=True) or {}\n        values, errors = validate_body(body)\n        if errors:\n            return api_error(400, errors[0])\n        now = utcnow()\n        with get_conn() as conn:\n            cur = conn.execute(\n                \"\"\"INSERT INTO posts (author_id, title, content, created_at, updated_at)\n                   VALUES (?, ?, ?, ?, ?)\"\"\",\n                (user[\"id\"], values[\"title\"].strip(), values[\"content\"], now, now),\n            )\n            post_id = cur.lastrowid\n        save_tags(post_id, values[\"tags\"] or [])\n        post = load_post(post_id)\n        return jsonify(serialize(post)), 201\n\n    @app.get(\"/api/posts/<int:post_id>\")\n    def get_post(post_id: int):\n        post = load_post(post_id)\n        if not post or not visible_to(post, current_user()):\n            return api_error(404, \"Post not found\")\n        user = current_user()\n        return jsonify(serialize(post, with_status=bool(user and user[\"is_admin\"])))\n\n    @app.put(\"/api/posts/<int:post_id>\")\n    @require_auth\n    def update_post(post_id: int):\n        user = current_user()\n        post = load_post(post_id)\n        if not post or not visible_to(post, user):\n            return api_error(404, \"Post not found\")\n        if post[\"author_id\"] != user[\"id\"]:\n            return api_error(403, \"Only the author can change this post\")\n        body = request.get_json(silent=True, force=True) or {}\n        values, errors = validate_body(body)\n        if errors:\n            return api_error(400, errors[0])\n        tags = values[\"tags\"] if values[\"tags\"] is not None else []\n        updated_at = touch_updated(post)\n        with get_conn() as conn:\n            conn.execute(\n                \"\"\"UPDATE posts SET title = ?, content = ?, updated_at = ? WHERE id = ?\"\"\",\n                (values[\"title\"].strip(), values[\"content\"], updated_at, post_id),\n            )\n        save_tags(post_id, tags)\n        post = load_post(post_id)\n        return jsonify(serialize(post, with_status=bool(user[\"is_admin\"])))\n\n    @app.delete(\"/api/posts/<int:post_id>\")\n    @require_auth\n    def delete_post(post_id: int):\n        user = current_user()\n        post = load_post(post_id)\n        if not post or not visible_to(post, user):\n            return api_error(404, \"Post not found\")\n        if post[\"author_id\"] != user[\"id\"]:\n            return api_error(403, \"Only the author can delete this post\")\n        with get_conn() as conn:\n            conn.execute(\"DELETE FROM posts WHERE id = ?\", (post_id,))\n        return jsonify({\"ok\": True})\n\n    @app.post(\"/api/admin/posts/<int:post_id>/toggle\")\n    @require_admin\n    def toggle_post(post_id: int):\n        post = load_post(post_id)\n        if not post:\n            return api_error(404, \"Post not found\")\n        with get_conn() as conn:\n            conn.execute(\n                \"UPDATE posts SET taken_down = 1 - taken_down WHERE id = ?\", (post_id,)\n            )\n        post = load_post(post_id)\n        return jsonify(serialize(post, with_status=True))\n","filePath":"/workspace/backend/posts.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/posts.py","exists":false,"truncated":false},"title":"backend/posts.py","time":{"start":1794365551826,"end":1794365551839}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c88574cc001xQ30uTJGl5nzpi","sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","messageID":"msg_1c8842f4c001i34dUXlWSlf7YS"}}
