{"type":"tool_use","timestamp":1794365833883,"sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","part":{"type":"tool","tool":"write","callID":"call_38d5c6555aec424caf74e68d","state":{"status":"completed","input":{"content":"\"\"\"Smoke test for the blog API.\"\"\"\n\nimport json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\n\n\ndef call(method, path, body=None, token=None, expect=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    data = json.dumps(body).encode() if body is not None else None\n    try:\n        with urllib.request.urlopen(req, data=data) as resp:\n            status, payload = resp.status, json.loads(resp.read().decode())\n    except urllib.error.HTTPError as exc:\n        status, payload = exc.code, json.loads(exc.read().decode())\n    if expect is not None and status != expect:\n        raise AssertionError(f\"{method} {path} -> {status} {payload}, expected {expect}\")\n    return status, payload\n\n\nfailures = []\n\n\ndef check(label, cond, extra=\"\"):\n    if cond:\n        print(f\"ok   {label}\")\n    else:\n        failures.append(label)\n        print(f\"FAIL {label} {extra}\")\n\n\n# health\nst, body = call(\"GET\", \"/api/health\")\ncheck(\"health\", st == 200 and body == {\"status\": \"ok\"}, body)\n\n# register / login\nst, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123456\"}, expect=201)\ncheck(\"register alice\", st == 201, body)\nst, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\ncheck(\"duplicate register\", st == 409, body)\nst, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"x\"})\ncheck(\"register admin blocked\", st == 409, body)\nst, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username\", st == 400, body)\nst, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"\"})\ncheck(\"register empty password\", st == 400, body)\n\nst, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ncheck(\"bad login\", st == 401, body)\nst, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw123456\"}, expect=200)\nalice_token = body.get(\"token\")\ncheck(\"alice login\", isinstance(alice_token, str) and set(body) == {\"token\"}, body)\n\nst, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"secret123\"}, expect=200)\nadmin_token = body.get(\"token\")\ncheck(\"admin login\", isinstance(admin_token, str), body)\n\n# second author\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw123456\"}, expect=201)\nst, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw123456\"}, expect=200)\ncarol_token = body[\"token\"]\n\n# create posts\nlong_content = \"First line\\nSecond line\\n\" + \"word \" * 80\nst, post1 = call(\"POST\", \"/api/posts\", {\"title\": \"Hello World\", \"content\": long_content, \"tags\": [\"python\", \"flask\"]}, token=alice_token, expect=201)\ncheck(\"create post 1\", st == 201, post1)\nst, post2 = call(\"POST\", \"/api/posts\", {\"title\": \"Second post\", \"content\": \"Short content.\", \"tags\": [\"python\"]}, token=carol_token, expect=201)\ncheck(\"create post 2\", st == 201, post2)\nst, post3 = call(\"POST\", \"/api/posts\", {\"title\": \"No tags here\", \"content\": \"Content without tags\"}, token=carol_token, expect=201)\ncheck(\"create post 3 no tags\", st == 201, post3)\n\n# validation\nst, body = call(\"POST\", \"/api/posts\", {\"content\": \"x\"}, token=alice_token)\ncheck(\"create missing title\", st == 400, body)\nst, body = call(\"POST\", \"/api/posts\", {\"title\": \"t\"}, token=alice_token)\ncheck(\"create missing content\", st == 400, body)\nst, body = call(\"POST\", \"/api/posts\", {\"title\": \"t\", \"content\": \"c\", \"tags\": \"notalist\"}, token=alice_token)\ncheck(\"create bad tags\", st == 400, body)\nst, body = call(\"POST\", \"/api/posts\", {\"title\": \"t\", \"content\": \"c\"})\ncheck(\"create unauthenticated\", st == 401, body)\n\n# post shape\nexpected_keys = {\"id\", \"title\", \"content\", \"tags\", \"created_at\", \"updated_at\", \"author\", \"excerpt\"}\ncheck(\"post keys\", set(post1) == expected_keys, sorted(post1))\ncheck(\"author field\", post1[\"author\"] == \"alice\", post1.get(\"author\"))\ncheck(\"tags field\", post1[\"tags\"] == [\"python\", \"flask\"], post1[\"tags\"])\nexpected_excerpt = (\"First line Second line \" + \"word \" * 80)[:200]\ncheck(\"excerpt\", post1[\"excerpt\"] == expected_excerpt, repr(post1[\"excerpt\"][:60]))\ncheck(\"excerpt len\", len(post1[\"excerpt\"]) <= 200, len(post1[\"excerpt\"]))\n\n# get single\nst, body = call(\"GET\", f\"/api/posts/{post1['id']}\", expect=200)\ncheck(\"get post\", st == 200 and body[\"title\"] == \"Hello World\", body)\nst, body = call(\"GET\", \"/api/posts/999999\")\ncheck(\"get missing post\", st == 404, body)\nst, body = call(\"GET\", \"/api/posts/abc\")\ncheck(\"get non-int post\", st == 404, body)\n\n# listing\nst, body = call(\"GET\", \"/api/posts\", expect=200)\ncheck(\"list shape\", set(body) == {\"items\", \"total\", \"page\", \"page_size\"}, sorted(body))\ncheck(\"list total\", body[\"total\"] == 3, body)\ncheck(\"list newest first\", [i[\"title\"] for i in body[\"items\"]] == [\"No tags here\", \"Second post\", \"Hello World\"], [i[\"title\"] for i in body[\"items\"]])\n\nst, body = call(\"GET\", \"/api/posts?page=1&page_size=2\", expect=200)\ncheck(\"paging page1\", len(body[\"items\"]) == 2 and body[\"total\"] == 3 and body[\"page\"] == 1 and body[\"page_size\"] == 2, body)\nst, body = call(\"GET\", \"/api/posts?page=2&page_size=2\", expect=200)\ncheck(\"paging page2\", len(body[\"items\"]) == 1 and body[\"page\"] == 2, body)\n\nst, body = call(\"GET\", \"/api/posts?tag=python\", expect=200)\ncheck(\"tag filter\", body[\"total\"] == 2 and {i[\"title\"] for i in body[\"items\"]} == {\"Hello World\", \"Second post\"}, body)\nst, body = call(\"GET\", \"/api/posts?tag=nope\", expect=200)\ncheck(\"tag filter empty\", body[\"total\"] == 0 and body[\"items\"] == [], body)\nst, body = call(\"GET\", \"/api/posts?author=alice\", expect=200)\ncheck(\"author filter\", body[\"total\"] == 1 and body[\"items\"][0][\"author\"] == \"alice\", body)\nst, body = call(\"GET\", \"/api/posts?q=second\", expect=200)\ncheck(\"q filter\", body[\"total\"] == 1 and body[\"items\"][0][\"title\"] == \"Second post\", body)\nst, body = call(\"GET\", \"/api/posts?q=SHORT%20CONTENT\", expect=200)\ncheck(\"q case-insensitive\", body[\"total\"] == 1, body)\nst, body = call(\"GET\", \"/api/posts?q=zzzznothing\", expect=200)\ncheck(\"q no match\", body[\"total\"] == 0, body)\n\n# update\nst, body = call(\"PUT\", f\"/api/posts/{post1['id']}\", {\"title\": \"Hello Updated\", \"content\": \"New content here.\\nWith a line.\"}, token=alice_token, expect=200)\ncheck(\"update post\", st == 200 and body[\"title\"] == \"Hello Updated\", body)\ncheck(\"update clears omitted tags\", body[\"tags\"] == [], body[\"tags\"])\ncheck(\"updated_at changed\", body[\"updated_at\"] != post1[\"updated_at\"], (post1[\"updated_at\"], body[\"updated_at\"]))\nupdated1 = body\n\nst, body = call(\"PUT\", f\"/api/posts/{post1['id']}\", {\"title\": \"Again\", \"content\": \"c\", \"tags\": [\"x\", \"x\", \" y \"]}, token=alice_token, expect=200)\ncheck(\"tags normalized/deduped\", body[\"tags\"] == [\"x\", \"y\"], body[\"tags\"])\ncheck(\"updated_at changes again\", body[\"updated_at\"] > updated1[\"updated_at\"], (updated1[\"updated_at\"], body[\"updated_at\"]))\n\nst, body = call(\"PUT\", f\"/api/posts/{post1['id']}\", {\"content\": \"only content\"}, token=alice_token)\ncheck(\"update missing title\", st == 400, body)\nst, body = call(\"PUT\", f\"/api/posts/{post1['id']}\", {\"title\": \"t\", \"content\": \"c\"}, token=carol_token)\ncheck(\"update not author\", st == 403, body)\nst, body = call(\"PUT\", f\"/api/posts/{post1['id']}\", {\"title\": \"t\", \"content\": \"c\"})\ncheck(\"update unauthenticated\", st == 401, body)\nst, body = call(\"PUT\", \"/api/posts/999999\", {\"title\": \"t\", \"content\": \"c\"}, token=alice_token)\ncheck(\"update missing\", st == 404, body)\n\n# delete\nst, body = call(\"DELETE\", f\"/api/posts/{post3['id']}\", token=carol_token, expect=200)\ncheck(\"delete own post\", st == 200, body)\nst, body = call(\"GET\", f\"/api/posts/{post3['id']}\")\ncheck(\"deleted post gone\", st == 404, body)\nst, body = call(\"DELETE\", f\"/api/posts/{post2['id']}\", token=alice_token)\ncheck(\"delete not author\", st == 403, body)\n\n# admin toggle\nst, body = call(\"POST\", f\"/api/admin/posts/{post2['id']}/toggle\")\ncheck(\"toggle unauthenticated\", st == 401, body)\nst, body = call(\"POST\", f\"/api/admin/posts/{post2['id']}/toggle\", token=alice_token)\ncheck(\"toggle non-admin\", st == 403, body)\nst, body = call(\"POST\", f\"/api/admin/posts/{post2['id']}/toggle\", token=admin_token, expect=200)\ncheck(\"toggle admin\", st == 200 and body[\"taken_down\"] is True, body)\n\nst, body = call(\"GET\", \"/api/posts\", expect=200)\ncheck(\"taken down hidden from list\", all(i[\"title\"] != \"Second post\" for i in body[\"items\"]), [i[\"title\"] for i in body[\"items\"]])\nst, body = call(\"GET\", f\"/api/posts/{post2['id']}\")\ncheck(\"taken down 404 anon\", st == 404, body)\nst, body = call(\"GET\", f\"/api/posts/{post2['id']}\", token=carol_token)\ncheck(\"taken down 404 author\", st == 404, body)\nst, body = call(\"GET\", f\"/api/posts/{post2['id']}\", token=admin_token, expect=200)\ncheck(\"taken down visible to admin\", st == 200 and body[\"taken_down\"] is True, body)\nst, body = call(\"GET\", \"/api/posts\", token=admin_token, expect=200)\ncheck(\"taken down hidden from admin default list\", all(i[\"title\"] != \"Second post\" for i in body[\"items\"]), [i[\"title\"] for i in body[\"items\"]])\nst, body = call(\"GET\", \"/api/posts?include_taken_down=1\", token=admin_token, expect=200)\ncheck(\"admin sees taken down with flag\", any(i[\"title\"] == \"Second post\" and i[\"taken_down\"] for i in body[\"items\"]), body)\nst, body = call(\"GET\", \"/api/posts?include_taken_down=1\")\ncheck(\"anon cannot include taken down\", all(\"taken_down\" not in i for i in body[\"items\"]) and all(i[\"title\"] != \"Second post\" for i in body[\"items\"]), body)\n\n# restore\nst, body = call(\"POST\", f\"/api/admin/posts/{post2['id']}/toggle\", token=admin_token, expect=200)\ncheck(\"restore\", body[\"taken_down\"] is False, body)\nst, body = call(\"GET\", f\"/api/posts/{post2['id']}\", expect=200)\ncheck(\"restored visible\", st == 200, body)\nst, body = call(\"POST\", \"/api/admin/posts/999999/toggle\", token=admin_token)\ncheck(\"toggle missing\", st == 404, body)\n\n# admin account when password disabled\nst, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"nobody\", \"password\": \"x\"})\ncheck(\"unknown login 401\", st == 401, body)\n\n# unknown api routes\nst, body = call(\"GET\", \"/api/nope\")\ncheck(\"unknown api 404 json\", st == 404 and isinstance(body, dict), body)\n\nprint()\nif failures:\n    print(f\"{len(failures)} FAILURES: {failures}\")\n    raise SystemExit(1)\nprint(\"ALL PASSED\")\n","filePath":"/workspace/.tmp/smoke.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.tmp/smoke.py","exists":false,"truncated":false},"title":".tmp/smoke.py","time":{"start":1794365833847,"end":1794365833862}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c889c26f001c34PSJaJ6zH2AO","sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","messageID":"msg_1c888b4d2001kjV5Hm3HUz02no"}}
