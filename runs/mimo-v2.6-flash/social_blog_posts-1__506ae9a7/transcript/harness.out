{"type":"tool_use","timestamp":1794365462008,"sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","part":{"type":"tool","tool":"write","callID":"call_c154e3e723034207a19d6d5c","state":{"status":"completed","input":{"content":"\"\"\"Accounts and token authentication.\"\"\"\n\nimport secrets\nfrom datetime import datetime, timezone\nfrom functools import wraps\n\nfrom flask import g, jsonify, request\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import get_conn\n\nADMIN_USERNAME = \"admin\"\n\n\ndef utcnow() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\")\n\n\ndef api_error(status: int, message: str):\n    return jsonify({\"error\": message, \"message\": message}), status\n\n\ndef admin_password() -> str:\n    import os\n\n    return os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\n\ndef bootstrap_admin():\n    \"\"\"Create or refresh the admin account when ADMIN_PASSWORD is set.\"\"\"\n    password = admin_password()\n    if not password:\n        return\n    with get_conn() as conn:\n        existing = conn.execute(\n            \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n        ).fetchone()\n        if existing:\n            conn.execute(\n                \"UPDATE users SET password_hash = ?, is_admin = 1 WHERE id = ?\",\n                (generate_password_hash(password), existing[\"id\"]),\n            )\n        else:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1)\",\n                (ADMIN_USERNAME, generate_password_hash(password)),\n            )\n\n\ndef create_user(username: str, password: str) -> dict:\n    with get_conn() as conn:\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        return {\"id\": cur.lastrowid, \"username\": username, \"is_admin\": 0}\n\n\ndef find_user(username: str):\n    with get_conn() as conn:\n        row = conn.execute(\n            \"SELECT * FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n        return dict(row) if row else None\n\n\ndef verify_login(username: str, password: str):\n    if username == ADMIN_USERNAME and not admin_password():\n        return None\n    user = find_user(username)\n    if not user or not check_password_hash(user[\"password_hash\"], password):\n        return None\n    return user\n\n\ndef create_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    with get_conn() as conn:\n        conn.execute(\n            \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n            (token, user_id, utcnow()),\n        )\n    return token\n\n\ndef user_from_request():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    with get_conn() as conn:\n        row = conn.execute(\n            \"\"\"SELECT u.id, u.username, u.is_admin\n               FROM tokens t JOIN users u ON u.id = t.user_id\n               WHERE t.token = ?\"\"\",\n            (token,),\n        ).fetchone()\n    return dict(row) if row else None\n\n\ndef load_user_into_g():\n    g.user = user_from_request()\n\n\ndef current_user():\n    return getattr(g, \"user\", None)\n\n\ndef require_auth(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return api_error(401, \"Sign in required\")\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef require_admin(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return api_error(401, \"Sign in required\")\n        if not user[\"is_admin\"]:\n            return api_error(403, \"Admin access required\")\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef register_routes(app):\n    @app.post(\"/api/auth/register\")\n    def register():\n        body = request.get_json(silent=True, force=True) or {}\n        username = body.get(\"username\")\n        password = body.get(\"password\")\n        if not isinstance(username, str) or not username.strip():\n            return api_error(400, \"Username is required\")\n        if not isinstance(password, str) or not password:\n            return api_error(400, \"Password is required\")\n        username = username.strip()\n        if username.lower() == ADMIN_USERNAME or find_user(username):\n            return api_error(409, \"Username is already taken\")\n        user = create_user(username, password)\n        return jsonify({\"username\": user[\"username\"]}), 201\n\n    @app.post(\"/api/auth/login\")\n    def login():\n        body = request.get_json(silent=True, force=True) or {}\n        username = body.get(\"username\")\n        password = body.get(\"password\")\n        if not isinstance(username, str) or not username.strip():\n            return api_error(400, \"Username is required\")\n        if not isinstance(password, str) or not password:\n            return api_error(400, \"Password is required\")\n        user = verify_login(username.strip(), password)\n        if not user:\n            if username.strip() == ADMIN_USERNAME and not admin_password():\n                return api_error(401, \"Admin sign-in is disabled\")\n            return api_error(401, \"Invalid username or password\")\n        token = create_token(user[\"id\"])\n        return jsonify({\"token\": token}), 200\n","filePath":"/workspace/backend/auth.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/auth.py","exists":false,"truncated":false},"title":"backend/auth.py","time":{"start":1794365461972,"end":1794365461986}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c88415cc001aPJ6DwLVrp8l17","sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","messageID":"msg_1c883ae14001PYpNwrQEKJzxHP"}}
