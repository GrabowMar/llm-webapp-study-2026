{"type":"tool_use","timestamp":1794367327775,"sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","part":{"type":"tool","tool":"write","callID":"call_8e97c62da615457eb4a39641","state":{"status":"completed","input":{"content":"/* UI smoke test: drives the built frontend in jsdom against the live API. */\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { pathToFileURL } from \"node:url\";\nimport { JSDOM } from \"jsdom\";\n\nconst BASE = \"http://127.0.0.1:8000\";\nconst DIST = \"/workspace/frontend/dist/assets\";\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nlet failures = 0;\nfunction check(label, cond, extra = \"\") {\n  if (cond) {\n    console.log(`ok   ${label}`);\n  } else {\n    failures += 1;\n    console.log(`FAIL ${label} ${extra}`);\n  }\n}\n\nasync function waitFor(label, fn, timeout = 5000) {\n  const start = Date.now();\n  for (;;) {\n    let result;\n    try {\n      result = fn();\n    } catch {\n      result = undefined;\n    }\n    if (result) return result;\n    if (Date.now() - start > timeout) {\n      check(label, false, \"timeout\");\n      return undefined;\n    }\n    await sleep(25);\n  }\n}\n\n// ---------- seed data through the API ----------\nasync function api(method, p, body, token) {\n  const res = await fetch(BASE + p, {\n    method,\n    headers: {\n      \"Content-Type\": \"application/json\",\n      ...(token ? { Authorization: `Bearer ${token}` } : {}),\n    },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const data = await res.json().catch(() => null);\n  return { status: res.status, data };\n}\n\nawait api(\"POST\", \"/api/auth/register\", { username: \"alice\", password: \"pw123456\" });\nconst alice = (await api(\"POST\", \"/api/auth/login\", { username: \"alice\", password: \"pw123456\" })).data.token;\nawait api(\"POST\", \"/api/auth/register\", { username: \"bob\", password: \"pw123456\" });\nconst bob = (await api(\"POST\", \"/api/auth/login\", { username: \"bob\", password: \"pw123456\" })).data.token;\nconst admin = (await api(\"POST\", \"/api/auth/login\", { username: \"admin\", password: \"secret123\" })).data.token;\n\nfor (let i = 1; i <= 12; i++) {\n  const n = String(i).padStart(2, \"0\");\n  await api(\n    \"POST\",\n    \"/api/posts\",\n    {\n      title: `Post ${n}`,\n      content: `Content of post ${n}.\\nSecond paragraph of post ${n}.`,\n      tags: i === 3 ? [\"special\", \"intro\"] : [`tag${i % 3}`],\n    },\n    alice,\n  );\n}\nawait api(\"POST\", \"/api/posts\", { title: \"Bob's post\", content: \"Written by bob.\" }, bob);\n\n// ---------- jsdom setup ----------\nconst jsFile = fs.readdirSync(DIST).find((f) => f.endsWith(\".js\"));\nconst dom = new JSDOM(\n  `<!DOCTYPE html><html><head></head><body><div id=\"root\"></div></body></html>`,\n  { url: BASE + \"/\", pretendToBeVisual: true },\n);\nconst { window } = dom;\n\nconst globals = [\n  \"window\",\n  \"document\",\n  \"navigator\",\n  \"location\",\n  \"history\",\n  \"Node\",\n  \"Element\",\n  \"HTMLElement\",\n  \"HTMLInputElement\",\n  \"HTMLTextAreaElement\",\n  \"HTMLButtonElement\",\n  \"Event\",\n  \"CustomEvent\",\n  \"KeyboardEvent\",\n  \"MouseEvent\",\n  \"getComputedStyle\",\n  \"requestAnimationFrame\",\n  \"cancelAnimationFrame\",\n  \"localStorage\",\n  \"sessionStorage\",\n  \"MutationObserver\",\n  \"SVGElement\",\n];\nfor (const key of globals) {\n  if (key in window) globalThis[key] = window[key];\n}\nwindow.confirm = () => true;\nglobalThis.confirm = window.confirm;\n\nconst realFetch = globalThis.fetch;\nglobalThis.fetch = (input, init) => {\n  let url = typeof input === \"string\" ? input : input.url;\n  if (url.startsWith(\"/\")) url = BASE + url;\n  return realFetch(url, init);\n};\n\n// ---------- helpers ----------\nconst $ = (sel) => window.document.querySelector(sel);\nconst $$ = (sel) => [...window.document.querySelectorAll(sel)];\nfunction byText(sel, text) {\n  return $$(sel).find((el) => (el.textContent || \"\").includes(text));\n}\nfunction setValue(el, value) {\n  const proto =\n    el.tagName === \"TEXTAREA\" ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;\n  Object.getOwnPropertyDescriptor(proto, \"value\").set.call(el, value);\n  el.dispatchEvent(new window.Event(\"input\", { bubbles: true }));\n}\nfunction click(el) {\n  el.click();\n}\nfunction goto(hash) {\n  window.location.hash = hash;\n}\nasync function signIn(username, password) {\n  goto(\"#/login\");\n  const user = await waitFor(\"login form\", () => $('input[autocomplete=\"username\"]'));\n  if (!user) return false;\n  setValue(user, username);\n  setValue($('input[autocomplete=\"current-password\"]'), password);\n  click(byText(\"button\", \"Sign in\"));\n  return waitFor(\"signed in\", () => document.body.textContent.includes(`Signed in as ${username}`));\n}\nasync function signOut() {\n  click(byText(\"button\", \"Sign out\"));\n  await waitFor(\"signed out\", () => !document.body.textContent.includes(\"Signed in as\"));\n}\n\n// ---------- run ----------\nawait import(pathToFileURL(path.join(DIST, jsFile)).href);\n\nconst listReady = await waitFor(\n  \"list renders\",\n  () => byText(\"a\", \"Post 12\") && document.body.textContent.includes(\"12 posts\"),\n);\ncheck(\"list renders newest first\", !!listReady);\ncheck(\n  \"page 1 has 10 items\",\n  $$(\"ul li\").length === 10,\n  String($$(\"ul li\").length),\n);\ncheck(\"shows page 1 of 2\", document.body.textContent.includes(\"Page 1 of 2\"));\ncheck(\"shows author and date\", !!byText(\"p\", \"by alice\") && !!$(\"time\"));\ncheck(\"shows excerpt\", !!byText(\"p\", \"Content of post 12.\"));\n\n// paging\nclick(byText(\"button\", \"Next\"));\nawait waitFor(\"page 2\", () => document.body.textContent.includes(\"Page 2 of 2\"));\ncheck(\"page 2 has 2 items\", $$(\"ul li\").length === 2, String($$(\"ul li\").length));\nclick(byText(\"button\", \"Previous\"));\nawait waitFor(\"page 1\", () => document.body.textContent.includes(\"Page 1 of 2\"));\n\n// search\nconst search = $('input[type=\"search\"]');\nsetValue(search, \"Bob\");\nclick(byText(\"button\", \"Search\"));\nawait waitFor(\"search result\", () => document.body.textContent.includes(\"1 post\"));\ncheck(\"search finds Bob's post\", !!byText(\"a\", \"Bob's post\") && $$(\"ul li\").length === 1);\n\n// clear filters\nclick(byText(\"button\", \"Clear\"));\nawait waitFor(\"cleared\", () => document.body.textContent.includes(\"12 posts\"));\n\n// tag filter\nsetValue($$(\"input\")[1], \"special\");\nclick(byText(\"button\", \"Search\"));\nawait waitFor(\"tag filter\", () => document.body.textContent.includes(\"1 post\"));\ncheck(\"tag filter works\", !!byText(\"a\", \"Post 03\"));\nclick(byText(\"button\", \"Clear\"));\nawait waitFor(\"cleared 2\", () => document.body.textContent.includes(\"12 posts\"));\n\n// author filter\nsetValue($$(\"input\")[2], \"bob\");\nclick(byText(\"button\", \"Search\"));\nawait waitFor(\"author filter\", () => document.body.textContent.includes(\"1 post\"));\ncheck(\"author filter works\", !!byText(\"a\", \"Bob's post\"));\nclick(byText(\"button\", \"Clear\"));\nawait waitFor(\"cleared 3\", () => document.body.textContent.includes(\"12 posts\"));\n\n// post page\nclick(byText(\"a\", \"Post 12\"));\nawait waitFor(\"post page\", () => byText(\"h1\", \"Post 12\"));\ncheck(\n  \"post page keeps paragraphs\",\n  !!$(\".whitespace-pre-line\") &&\n    $(\".whitespace-pre-line\").textContent.includes(\"Second paragraph of post 12.\"),\n);\ncheck(\"post page shows tags\", !!byText(\"button\", \"tag0\"));\n\n// registration\nawait signOut();\ngoto(\"#/register\");\nconst regUser = await waitFor(\"register form\", () => $('input[autocomplete=\"username\"]'));\nsetValue(regUser, \"carol\");\nsetValue($('input[autocomplete=\"new-password\"]'), \"pw123456\");\nclick(byText(\"button\", \"Create account\"));\ncheck(\n  \"register signs in\",\n  await waitFor(\"carol signed in\", () => document.body.textContent.includes(\"Signed in as carol\")),\n);\n\n// publish\ngoto(\"#/write\");\nconst titleInput = await waitFor(\"editor\", () => $('input[placeholder=\"Post title\"]'));\nsetValue(titleInput, \"Carol's first post\");\nsetValue($('textarea'), \"Hello from carol.\\nSecond line.\");\nsetValue($('input[placeholder=\"python, flask, intro\"]'), \"carol, fresh\");\nclick(byText(\"button\", \"Publish\"));\nawait waitFor(\"published\", () => byText(\"h1\", \"Carol's first post\"));\ncheck(\"published post page\", !!byText(\"h1\", \"Carol's first post\"));\n\n// validation message from API\ngoto(\"#/write\");\nawait waitFor(\"editor 2\", () => $('input[placeholder=\"Post title\"]'));\nsetValue($('input[placeholder=\"Post title\"]'), \"\");\nsetValue($('textarea'), \"no title here\");\nclick(byText(\"button\", \"Publish\"));\ncheck(\n  \"shows API validation message\",\n  await waitFor(\"validation\", () => document.body.textContent.includes(\"Title is required\")),\n);\n\n// edit own post\ngoto(\"#/\");\nawait waitFor(\"list again\", () => byText(\"a\", \"Carol's first post\"));\nclick(byText(\"a\", \"Carol's first post\"));\nawait waitFor(\"carol post page\", () => byText(\"h1\", \"Carol's first post\"));\nclick(byText(\"a\", \"Edit\"));\nconst editTitle = await waitFor(\"edit form\", () => $('input[placeholder=\"Post title\"]'));\ncheck(\"edit form prefilled\", editTitle.value === \"Carol's first post\", editTitle.value);\nsetValue(editTitle, \"Carol's edited post\");\nclick(byText(\"button\", \"Save changes\"));\nawait waitFor(\"edited\", () => byText(\"h1\", \"Carol's edited post\"));\ncheck(\"edit saved\", document.body.textContent.includes(\"Carol's edited post\"));\n\n// delete with confirmation\nclick(byText(\"button\", \"Delete\"));\nawait waitFor(\"deleted\", () => document.body.textContent.includes(\"13 posts\") || !$(\"h1\"));\ncheck(\"delete returns to list\", !document.body.textContent.includes(\"Carol's edited post\"));\n\n// admin take-down / restore\nawait signOut();\ncheck(\"admin sign in\", await signIn(\"admin\", \"secret123\"));\nconst toggleBtn = await waitFor(\"admin toggle\", () => byText(\"button\", \"Take down\"));\ncheck(\"admin sees take-down button\", !!toggleBtn);\nclick(toggleBtn);\ncheck(\n  \"admin sees taken-down badge\",\n  await waitFor(\"badge\", () => document.body.textContent.includes(\"Taken down\")),\n);\ncheck(\"admin can restore\", !!byText(\"button\", \"Restore\"));\n\nawait signOut();\nawait waitFor(\"public list reload\", () => document.body.textContent.includes(\"13 posts\"));\ncheck(\n  \"taken-down post hidden from public list\",\n  !document.body.textContent.includes(\"Post 12\"),\n);\n\ncheck(\"admin sign in again\", await signIn(\"admin\", \"secret123\"));\nconst restoreBtn = await waitFor(\"restore\", () => byText(\"button\", \"Restore\"));\nclick(restoreBtn);\ncheck(\n  \"restored post visible\",\n  await waitFor(\"restored\", () => !document.body.textContent.includes(\"Taken down\")),\n);\n\n// non-author cannot edit: carol tries to open alice's post editor\nawait signOut();\ncheck(\"alice sign in\", await signIn(\"alice\", \"pw123456\"));\ngoto(\"#/edit/1\");\nawait waitFor(\"edit denied\", () => document.body.textContent.includes(\"Only the author\"));\ncheck(\"non-author edit blocked with API message\", true);\n\nconsole.log(\"\");\nif (failures) {\n  console.log(`${failures} FAILURES`);\n  process.exit(1);\n}\nconsole.log(\"UI TESTS PASSED\");\nprocess.exit(0);\n","filePath":"/workspace/.tmp/uitest/ui-test.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.tmp/uitest/ui-test.mjs","exists":false,"truncated":false},"title":".tmp/uitest/ui-test.mjs","time":{"start":1794367327686,"end":1794367327752}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8a08dbe001Dr4xQLYTtgdO4r","sessionID":"ses_e3785b9d6ffexswiiPajgXY1XI","messageID":"msg_1c89e30b3001eKXEmZmAT4I2kN"}}
