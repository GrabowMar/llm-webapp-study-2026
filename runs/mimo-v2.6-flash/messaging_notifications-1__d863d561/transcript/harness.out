{"type":"step_start","timestamp":1794350703683,"sessionID":"ses_e387f7daeffe2FNM1wLtALaVuI","part":{"id":"prt_1c7a2e410001Mq91S5myrDhf3b","messageID":"msg_1c7a21ae7001klekkKXl8E76F4","sessionID":"ses_e387f7daeffe2FNM1wLtALaVuI","type":"step-start"}}
{"type":"tool_use","timestamp":1794350703683,"sessionID":"ses_e387f7daeffe2FNM1wLtALaVuI","part":{"type":"tool","tool":"write","callID":"call_f85c36d86abc481ba81e2752","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useRef, useState } from \"react\";\nimport { api } from \"../api\";\nimport type { Notification, NotificationList, Session } from \"../types\";\nimport AddNotificationForm from \"./AddNotificationForm\";\nimport BroadcastForm from \"./BroadcastForm\";\nimport Header from \"./Header\";\nimport NotificationItem from \"./NotificationItem\";\n\ntype Props = {\n  session: Session;\n  onSignOut: () => void;\n};\n\ntype ReadFilter = \"all\" | \"unread\" | \"read\";\n\nconst PAGE_SIZE_OPTIONS = [10, 20, 50, 100];\n\nexport default function Dashboard({ session, onSignOut }: Props) {\n  const [list, setList] = useState<NotificationList | null>(null);\n  const [page, setPage] = useState(1);\n  const [pageSize, setPageSize] = useState(20);\n  const [readFilter, setReadFilter] = useState<ReadFilter>(\"all\");\n  const [typeFilter, setTypeFilter] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const requestId = useRef(0);\n\n  const load = useCallback(async () => {\n    const id = ++requestId.current;\n    const params = new URLSearchParams();\n    params.set(\"page\", String(page));\n    params.set(\"page_size\", String(pageSize));\n    if (readFilter === \"read\") {\n      params.set(\"read\", \"true\");\n    } else if (readFilter === \"unread\") {\n      params.set(\"read\", \"false\");\n    }\n    const type = typeFilter.trim();\n    if (type) {\n      params.set(\"type\", type);\n    }\n    try {\n      const data = await api<NotificationList>(`/api/notifications?${params.toString()}`);\n      if (id !== requestId.current) {\n        return;\n      }\n      setList(data);\n      setError(null);\n      const pages = Math.max(1, Math.ceil(data.total / data.page_size));\n      if (data.total > 0 && page > pages) {\n        setPage(pages);\n      } else if (data.total === 0 && page > 1) {\n        setPage(1);\n      }\n    } catch (err) {\n      if (id !== requestId.current) {\n        return;\n      }\n      setError(err instanceof Error ? err.message : \"Could not load notifications\");\n    }\n  }, [page, pageSize, readFilter, typeFilter]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function run(action: () => Promise<unknown>) {\n    try {\n      await action();\n      await load();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    }\n  }\n\n  function refresh() {\n    load();\n  }\n\n  async function markAllRead() {\n    await run(() => api(\"/api/notifications/read-all\", { method: \"POST\" }));\n  }\n\n  async function toggleRead(notification: Notification) {\n    await run(() =>\n      api(`/api/notifications/${notification.id}`, {\n        method: \"PATCH\",\n        body: { read: !notification.read },\n      }),\n    );\n  }\n\n  async function removeNotification(notification: Notification) {\n    try {\n      await api(`/api/notifications/${notification.id}`, { method: \"DELETE\" });\n      if (list && list.items.length === 1 && page > 1) {\n        setPage(page - 1);\n      } else {\n        await load();\n      }\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    }\n  }\n\n  async function addNotification() {\n    if (page !== 1) {\n      setPage(1);\n    } else {\n      await load();\n    }\n  }\n\n  const total = list?.total ?? 0;\n  const unreadCount = list?.unread_count ?? 0;\n  const pages = Math.max(1, Math.ceil(total / pageSize));\n\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      <Header username={session.username} unreadCount={unreadCount} onSignOut={onSignOut} />\n\n      <main className=\"mx-auto grid max-w-5xl gap-4 px-4 py-6 lg:grid-cols-3\">\n        <section className=\"lg:col-span-2\">\n          <div className=\"overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm\">\n            <div className=\"flex flex-wrap items-center gap-3 border-b border-gray-100 px-4 py-3\">\n              <h2 className=\"text-sm font-semibold text-gray-900\">Inbox</h2>\n              <span className=\"rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600\">\n                {total} total\n              </span>\n              <span className=\"rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700\">\n                {unreadCount} unread\n              </span>\n\n              <div className=\"ml-auto flex flex-wrap items-center gap-2\">\n                <label htmlFor=\"read-filter\" className=\"sr-only\">\n                  Read filter\n                </label>\n                <select\n                  id=\"read-filter\"\n                  value={readFilter}\n                  onChange={(event) => {\n                    setReadFilter(event.target.value as ReadFilter);\n                    setPage(1);\n                  }}\n                  className=\"rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-700 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                >\n                  <option value=\"all\">All</option>\n                  <option value=\"unread\">Unread</option>\n                  <option value=\"read\">Read</option>\n                </select>\n\n                <label htmlFor=\"type-filter\" className=\"sr-only\">\n                  Type filter\n                </label>\n                <input\n                  id=\"type-filter\"\n                  type=\"text\"\n                  value={typeFilter}\n                  onChange={(event) => {\n                    setTypeFilter(event.target.value);\n                    setPage(1);\n                  }}\n                  placeholder=\"Filter by type\"\n                  className=\"w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-700 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                />\n\n                <button\n                  type=\"button\"\n                  onClick={markAllRead}\n                  disabled={unreadCount === 0}\n                  className=\"rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  Mark all as read\n                </button>\n              </div>\n            </div>\n\n            {error && (\n              <div className=\"border-b border-red-100 bg-red-50 px-4 py-2 text-sm text-red-700\" role=\"alert\">\n                {error}\n              </div>\n            )}\n\n            {list === null ? (\n              <p className=\"px-4 py-8 text-center text-sm text-gray-500\">Loading…</p>\n            ) : list.items.length === 0 ? (\n              <p className=\"px-4 py-8 text-center text-sm text-gray-500\">No notifications.</p>\n            ) : (\n              <ul className=\"divide-y divide-gray-100\">\n                {list.items.map((notification) => (\n                  <NotificationItem\n                    key={notification.id}\n                    notification={notification}\n                    onToggle={toggleRead}\n                    onDelete={removeNotification}\n                  />\n                ))}\n              </ul>\n            )}\n\n            <div className=\"flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 px-4 py-3\">\n              <span className=\"text-sm text-gray-500\">\n                Page {page} of {pages}\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <label htmlFor=\"page-size\" className=\"sr-only\">\n                  Page size\n                </label>\n                <select\n                  id=\"page-size\"\n                  value={pageSize}\n                  onChange={(event) => {\n                    setPageSize(Number(event.target.value));\n                    setPage(1);\n                  }}\n                  className=\"rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-700 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                >\n                  {PAGE_SIZE_OPTIONS.map((size) => (\n                    <option key={size} value={size}>\n                      {size} / page\n                    </option>\n                  ))}\n                </select>\n                <button\n                  type=\"button\"\n                  onClick={() => setPage((value) => Math.max(1, value - 1))}\n                  disabled={page <= 1}\n                  className=\"rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  Previous\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setPage((value) => Math.min(pages, value + 1))}\n                  disabled={page >= pages}\n                  className=\"rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  Next\n                </button>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <aside className=\"space-y-4\">\n          <AddNotificationForm onAdded={addNotification} />\n          {session.is_admin && <BroadcastForm onBroadcast={refresh} />}\n        </aside>\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/components/Dashboard.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Dashboard.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Dashboard.tsx","time":{"start":1794350703646,"end":1794350703677}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7a2e418001NsZSzs9FhQy9Cq","sessionID":"ses_e387f7daeffe2FNM1wLtALaVuI","messageID":"msg_1c7a21ae7001klekkKXl8E76F4"}}
