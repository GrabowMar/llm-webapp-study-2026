-1.9.0 click-8.5.0 flask-3.1.3 gunicorn-26.2.0 itsdangerous-2.2.0 jinja2-3.1.6 markupsafe-3.0.4 werkzeug-3.1.9\n","exit":0,"truncated":false},"title":"/workspace/.venv/bin/pip install --no-cache-dir -r /workspace/backend/requirements.txt -c /workspace/backend/requirements.lock 2>&1 | tail -8","time":{"start":1794310201561,"end":1794310203410}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c538e0d4001Fpqlv5CiP5Y2ro","sessionID":"ses_e3ad04a9dffeKmeb6KDBnUtCaL","messageID":"msg_1c538b047001V8vzXd8oOqGFsr"}}
