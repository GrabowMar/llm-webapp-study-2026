{"type":"tool_use","timestamp":1794311951650,"sessionID":"ses_e3ad04a9dffeKmeb6KDBnUtCaL","part":{"type":"tool","tool":"read","callID":"call_df61cb07220f427ba90f5dc5","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: weather display API and frontend serving.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import hashlib\n6: import hmac\n7: import secrets\n8: import sqlite3\n9: from datetime import datetime, timezone\n10: from pathlib import Path\n11: \n12: from flask import Flask, g, jsonify, request, send_from_directory\n13: \n14: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n15: DATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\n16: DB_PATH = DATA_DIR / \"weather.db\"\n17: \n18: PBKDF2_ITERATIONS = 200_000\n19: DEFAULT_PAGE = 1\n20: DEFAULT_PAGE_SIZE = 10\n21: MAX_PAGE_SIZE = 100\n22: DEFAULT_RECENT_LIMIT = 10\n23: MAX_RECENT_LIMIT = 100\n24: \n25: SAMPLE_REPORTS = [\n26:     (\"London\", \"United Kingdom\", 12.4, \"Cloudy\", 78, 14.2),\n27:     (\"Paris\", \"France\", 15.1, \"Sunny\", 61, 9.6),\n28:     (\"Tokyo\", \"Japan\", 22.7, \"Rain\", 74, 11.3),\n29:     (\"New York\", \"United States\", 9.8, \"Windy\", 55, 24.5),\n30:     (\"Sydney\", \"Australia\", 26.3, \"Sunny\", 48, 17.8),\n31:     (\"Berlin\", \"Germany\", 11.2, \"Overcast\", 70, 13.4),\n32: ]\n33: \n34: app = Flask(__name__, static_folder=None)\n35: \n36: \n37: @app.get(\"/api/health\")\n38: def health():\n39:     return {\"status\": \"ok\"}\n40: \n41: \n42: # ---------------------------------------------------------------------------\n43: # helpers\n44: # ---------------------------------------------------------------------------\n45: \n46: def now_iso() -> str:\n47:     return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n48: \n49: \n50: def error(message: str, status: int):\n51:     return jsonify({\"error\": message}), status\n52: \n53: \n54: def get_db() -> sqlite3.Connection:\n55:     if \"db\" not in g:\n56:         conn = sqlite3.connect(DB_PATH, timeout=30)\n57:         conn.row_factory = sqlite3.Row\n58:         conn.execute(\"PRAGMA busy_timeout=30000\")\n59:         conn.execute(\"PRAGMA foreign_keys=ON\")\n60:         g.db = conn\n61:     return g.db\n62: \n63: \n64: @app.teardown_appcontext\n65: def close_db(_exc) -> None:\n66:     conn = g.pop(\"db\", None)\n67:     if conn is not None:\n68:         conn.close()\n69: \n70: \n71: def row_to_report(row: sqlite3.Row) -> dict:\n72:     return {\n73:         \"id\": row[\"id\"],\n74:         \"city\": row[\"city\"],\n75:         \"country\": row[\"country\"],\n76:         \"temperature_c\": row[\"temperature_c\"],\n77:         \"condition\": row[\"condition\"],\n78:         \"humidity\": row[\"humidity\"],\n79:         \"wind_kph\": row[\"wind_kph\"],\n80:         \"observed_at\": row[\"observed_at\"],\n81:     }\n82: \n83: \n84: def row_to_lookup(row: sqlite3.Row) -> dict:\n85:     return {\n86:         \"id\": row[\"id\"],\n87:         \"city\": row[\"city\"],\n88:         \"found\": bool(row[\"found\"]),\n89:         \"looked_up_at\": row[\"looked_up_at\"],\n90:     }\n91: \n92: \n93: def hash_password(password: str, salt: str | None = None) -> str:\n94:     salt = salt or secrets.token_hex(16)\n95:     digest = hashlib.pbkdf2_hmac(\n96:         \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ITERATIONS\n97:     )\n98:     return f\"pbkdf2_sha256${salt}${digest.hex()}\"\n99: \n100: \n101: def verify_password(password: str, stored: str) -> bool:\n102:     try:\n103:         _scheme, salt, expected = stored.split(\"$\", 2)\n104:     except ValueError:\n105:         return False\n106:     digest = hashlib.pbkdf2_hmac(\n107:         \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ITERATIONS\n108:     )\n109:     return hmac.compare_digest(digest.hex(), expected)\n110: \n111: \n112: def current_user() -> sqlite3.Row | None:\n113:     header = request.headers.get(\"Authorization\", \"\")\n114:     if not header.startswith(\"Bearer \"):\n115:         return None\n116:     token = header[7:].strip()\n117:     if not token:\n118:         return None\n119:     row = get_db().execute(\n120:         \"\"\"\n121:         SELECT u.id, u.username FROM auth_tokens t\n122:         JOIN users u ON u.id = t.user_id\n123:         WHERE t.token = ?\n124:         \"\"\",\n125:         (token,),\n126:     ).fetchone()\n127:     return row\n128: \n129: \n130: def require_auth():\n131:     user = current_user()\n132:     if user is None:\n133:         return None, error(\"Authentication required\", 401)\n134:     return user, None\n135: \n136: \n137: def get_json_body() -> dict | None:\n138:     data = request.get_json(silent=True)\n139:     if data is None:\n140:         return None, error(\"Request body must be a JSON object\", 400)\n141:     if not isinstance(data, dict):\n142:         return None, error(\"Request body must be a JSON object\", 400)\n143:     return data, None\n144: \n145: \n146: def as_number(value) -> float | None:\n147:     if isinstance(value, bool) or not isinstance(value, (int, float)):\n148:         return None\n149:     return float(value)\n150: \n151: \n152: def validate_report_fields(data: dict) -> tuple[dict | None, str | None]:\n153:     \"\"\"Validate a create/replace payload. Returns (fields, error_message).\"\"\"\n154:     fields: dict = {}\n155: \n156:     city = data.get(\"city\")\n157:     if not isinstance(city, str) or not city.strip():\n158:         return None, \"city is required and must be a non-empty string\"\n159:     fields[\"city\"] = city.strip()\n160: \n161:     temperature = as_number(data.get(\"temperature_c\"))\n162:     if temperature is None:\n163:         return None, \"temperature_c is required and must be a number\"\n164:     fields[\"temperature_c\"] = temperature\n165: \n166:     if \"country\" in data:\n167:         country = data.get(\"country\")\n168:         if country is not None and not isinstance(country, str):\n169:             return None, \"country must be a string\"\n170:         fields[\"country\"] = country.strip() if isinstance(country, str) and country.strip() else None\n171: \n172:     if \"condition\" in data:\n173:         condition = data.get(\"condition\")\n174:         if condition is not None and not isinstance(condition, str):\n175:             return None, \"condition must be a string\"\n176:         fields[\"condition\"] = condition.strip() if isinstance(condition, str) and condition.strip() else None\n177: \n178:     if \"humidity\" in data:\n179:         humidity = data.get(\"humidity\")\n180:         if humidity is not None:\n181:             value = as_number(humidity)\n182:             if value is None or value != int(value) or not 0 <= value <= 100:\n183:                 return None, \"humidity must be an integer between 0 and 100\"\n184:             fields[\"humidity\"] = int(value)\n185:         else:\n186:             fields[\"humidity\"] = None\n187: \n188:     if \"wind_kph\" in data:\n189:         wind = data.get(\"wind_kph\")\n190:         if wind is not None:\n191:             value = as_number(wind)\n192:             if value is None or value < 0:\n193:                 return None, \"wind_kph must be a non-negative number\"\n194:             fields[\"wind_kph\"] = value\n195:         else:\n196:             fields[\"wind_kph\"] = None\n197: \n198:     return fields, None\n199: \n200: \n201: # ---------------------------------------------------------------------------\n202: # database setup\n203: # ---------------------------------------------------------------------------\n204: \n205: def init_db() -> None:\n206:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n207:     conn = sqlite3.connect(DB_PATH, timeout=30)\n208:     try:\n209:         conn.execute(\"PRAGMA busy_timeout=30000\")\n210:         conn.execute(\"PRAGMA journal_mode=WAL\")\n211:         conn.executescript(\n212:             \"\"\"\n213:             CREATE TABLE IF NOT EXISTS users (\n214:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n215:                 username TEXT NOT NULL,\n216:                 username_lower TEXT NOT NULL UNIQUE,\n217:                 password_hash TEXT NOT NULL,\n218:                 created_at TEXT NOT NULL\n219:             );\n220: \n221:             CREATE TABLE IF NOT EXISTS auth_tokens (\n222:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n223:                 token TEXT NOT NULL UNIQUE,\n224:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n225:                 created_at TEXT NOT NULL\n226:             );\n227: \n228:             CREATE TABLE IF NOT EXISTS reports (\n229:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n230:                 city TEXT NOT NULL,\n231:                 city_lower TEXT NOT NULL UNIQUE,\n232:                 country TEXT,\n233:                 temperature_c REAL NOT NULL,\n234:                 condition TEXT,\n235:                 humidity INTEGER,\n236:                 wind_kph REAL,\n237:                 observed_at TEXT NOT NULL\n238:             );\n239: \n240:             CREATE TABLE IF NOT EXISTS lookups (\n241:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n242:                 city TEXT NOT NULL,\n243:                 found INTEGER NOT NULL,\n244:                 looked_up_at TEXT NOT NULL\n245:             );\n246: \n247:             CREATE INDEX IF NOT EXISTS idx_reports_city_lower ON reports(city_lower);\n248:             CREATE INDEX IF NOT EXISTS idx_lookups_looked_up_at ON lookups(looked_up_at DESC);\n249:             \"\"\"\n250:         )\n251:         conn.commit()\n252:         seed_if_empty(conn)\n253:         conn.commit()\n254:     finally:\n255:         conn.close()\n256: \n257: \n258: def seed_if_empty(conn: sqlite3.Connection) -> None:\n259:     count = conn.execute(\"SELECT COUNT(*) FROM reports\").fetchone()[0]\n260:     if count:\n261:         return\n262:     observed_at = now_iso()\n263:     for city, country, temperature, condition, humidity, wind in SAMPLE_REPORTS:\n264:         try:\n265:             conn.execute(\n266:                 \"\"\"\n267:                 INSERT INTO reports\n268:                     (city, city_lower, country, temperature_c, condition, humidity, wind_kph, observed_at)\n269:                 VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n270:                 \"\"\",\n271:                 (city, city.lower(), country, temperature, condition, humidity, wind, observed_at),\n272:             )\n273:         except sqlite3.IntegrityError:\n274:             pass\n275: \n276: \n277: init_db()\n278: \n279: \n280: # ---------------------------------------------------------------------------\n281: # auth routes\n282: # ---------------------------------------------------------------------------\n283: \n284: @app.post(\"/api/auth/register\")\n285: def register():\n286:     data, body_err = get_json_body()\n287:     if body_err:\n288:         return body_err\n289: \n290:     username = data.get(\"username\")\n291:     password = data.get(\"password\")\n292:     if not isinstance(username, str) or not username.strip():\n293:         return error(\"username is required and must be a non-empty string\", 400)\n294:     if not isinstance(password, str) or not password:\n295:         return error(\"password is required and must be a non-empty string\", 400)\n296:     username = username.strip()\n297: \n298:     db = get_db()\n299:     existing = db.execute(\n300:         \"SELECT id FROM users WHERE username_lower = ?\", (username.lower(),)\n301:     ).fetchone()\n302:     if existing:\n303:         return error(\"Username already taken\", 409)\n304: \n305:     try:\n306:         cur = db.execute(\n307:             \"\"\"\n308:             INSERT INTO users (username, username_lower, password_hash, created_at)\n309:             VALUES (?, ?, ?, ?)\n310:             \"\"\",\n311:             (username, username.lower(), hash_password(password), now_iso()),\n312:         )\n313:         db.commit()\n314:     except sqlite3.IntegrityError:\n315:         return error(\"Username already taken\", 409)\n316: \n317:     return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n318: \n319: \n320: @app.post(\"/api/auth/login\")\n321: def login():\n322:     data, body_err = get_json_body()\n323:     if body_err:\n324:         return body_err\n325: \n326:     username = data.get(\"username\")\n327:     password = data.get(\"password\")\n328:     if not isinstance(username, str) or not username.strip():\n329:         return error(\"username is required and must be a non-empty string\", 400)\n330:     if not isinstance(password, str) or not password:\n331:         return error(\"password is required and must be a non-empty string\", 400)\n332: \n333:     user = get_db().execute(\n334:         \"SELECT id, username, password_hash FROM users WHERE username_lower = ?\",\n335:         (username.strip().lower(),),\n336:     ).fetchone()\n337:     if user is None or not verify_password(password, user[\"password_hash\"]):\n338:         return error(\"Invalid username or password\", 401)\n339: \n340:     token = secrets.token_urlsafe(32)\n341:     db = get_db()\n342:     db.execute(\n343:         \"INSERT INTO auth_tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n344:         (token, user[\"id\"], now_iso()),\n345:     )\n346:     db.commit()\n347:     return jsonify({\"token\": token}), 200\n348: \n349: \n350: # ---------------------------------------------------------------------------\n351: # weather routes\n352: # ---------------------------------------------------------------------------\n353: \n354: def parse_int_arg(name: str, default: int, lo: int, hi: int) -> int:\n355:     raw = request.args.get(name)\n356:     if raw is None or raw == \"\":\n357:         return default\n358:     try:\n359:         value = int(raw)\n360:     except (TypeError, ValueError):\n361:         return default\n362:     if value < lo:\n363:         return default if lo <= default <= hi else lo\n364:     return min(value, hi)\n365: \n366: \n367: @app.get(\"/api/weather\")\n368: def list_weather():\n369:     city = request.args.get(\"city\")\n370:     db = get_db()\n371: \n372:     if city is not None and city.strip():\n373:         city = city.strip()\n374:         found_row = db.execute(\n375:             \"SELECT id FROM reports WHERE city_lower = ?\", (city.lower(),)\n376:         ).fetchone()\n377:         db.execute(\n378:             \"INSERT INTO lookups (city, found, looked_up_at) VALUES (?, ?, ?)\",\n379:             (city, 1 if found_row else 0, now_iso()),\n380:         )\n381:         db.commit()\n382: \n383:         page = parse_int_arg(\"page\", DEFAULT_PAGE, 1, 10_000_000)\n384:         page_size = parse_int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n385:         total = db.execute(\n386:             \"SELECT COUNT(*) FROM reports WHERE city_lower = ?\", (city.lower(),)\n387:         ).fetchone()[0]\n388:         rows = db.execute(\n389:             \"\"\"\n390:             SELECT * FROM reports WHERE city_lower = ?\n391:             ORDER BY city COLLATE NOCASE ASC, id ASC\n392:             LIMIT ? OFFSET ?\n393:             \"\"\",\n394:             (city.lower(), page_size, (page - 1) * page_size),\n395:         ).fetchall()\n396:         return jsonify(\n397:             {\"items\": [row_to_report(r) for r in rows], \"total\": total,\n398:              \"page\": page, \"page_size\": page_size}\n399:         )\n400: \n401:     page = parse_int_arg(\"page\", DEFAULT_PAGE, 1, 10_000_000)\n402:     page_size = parse_int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n403:     total = db.execute(\"SELECT COUNT(*) FROM reports\").fetchone()[0]\n404:     rows = db.execute(\n405:         \"\"\"\n406:         SELECT * FROM reports\n407:         ORDER BY city COLLATE NOCASE ASC, id ASC\n408:         LIMIT ? OFFSET ?\n409:         \"\"\",\n410:         (page_size, (page - 1) * page_size),\n411:     ).fetchall()\n412:     return jsonify(\n413:         {\"items\": [row_to_report(r) for r in rows], \"total\": total,\n414:          \"page\": page, \"page_size\": page_size}\n415:     )\n416: \n417: \n418: @app.get(\"/api/weather/recent\")\n419: def recent_lookups():\n420:     limit = parse_int_arg(\"limit\", DEFAULT_RECENT_LIMIT, 1, MAX_RECENT_LIMIT)\n421:     rows = get_db().execute(\n422:         \"\"\"\n423:         SELECT * FROM lookups\n424:         ORDER BY looked_up_at DESC, id DESC\n425:         LIMIT ?\n426:         \"\"\",\n427:         (limit,),\n428:     ).fetchall()\n429:     return jsonify({\"items\": [row_to_lookup(r) for r in rows]})\n430: \n431: \n432: @app.post(\"/api/weather\")\n433: def create_weather():\n434:     user, auth_err = require_auth()\n435:     if auth_err:\n436:         return auth_err\n437: \n438:     data, body_err = get_json_body()\n439:     if body_err:\n440:         return body_err\n441: \n442:     fields, field_err = validate_report_fields(data)\n443:     if field_err:\n444:         return error(field_err, 400)\n445: \n446:     db = get_db()\n447:     duplicate = db.execute(\n448:         \"SELECT id FROM reports WHERE city_lower = ?\", (fields[\"city\"].lower(),)\n449:     ).fetchone()\n450:     if duplicate:\n451:         return error(f\"City '{fields['city']}' already exists\", 409)\n452: \n453:     try:\n454:         cur = db.execute(\n455:             \"\"\"\n456:             INSERT INTO reports\n457:                 (city, city_lower, country, temperature_c, condition, humidity, wind_kph, observed_at)\n458:             VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n459:             \"\"\",\n460:             (\n461:                 fields[\"city\"],\n462:                 fields[\"city\"].lower(),\n463:                 fields.get(\"country\"),\n464:                 fields[\"temperature_c\"],\n465:                 fields.get(\"condition\"),\n466:                 fields.get(\"humidity\"),\n467:                 fields.get(\"wind_kph\"),\n468:                 now_iso(),\n469:             ),\n470:         )\n471:         db.commit()\n472:     except sqlite3.IntegrityError:\n473:         return error(f\"City '{fields['city']}' already exists\", 409)\n474: \n475:     row = db.execute(\"SELECT * FROM reports WHERE id = ?\", (cur.lastrowid,)).fetchone()\n476:     return jsonify(row_to_report(row)), 201\n477: \n478: \n479: @app.get(\"/api/weather/<int:report_id>\")\n480: def get_weather(report_id: int):\n481:     row = get_db().execute(\n482:         \"SELECT * FROM reports WHERE id = ?\", (report_id,)\n483:     ).fetchone()\n484:     if row is None:\n485:         return error(\"Weather report not found\", 404)\n486:     return jsonify(row_to_report(row))\n487: \n488: \n489: @app.put(\"/api/weather/<int:report_id>\")\n490: def replace_weather(report_id: int):\n491:     user, auth_err = require_auth()\n492:     if auth_err:\n493:         return auth_err\n494: \n495:     data, body_err = get_json_body()\n496:     if body_err:\n497:         return body_err\n498: \n499:     fields, field_err = validate_report_fields(data)\n500:     if field_err:\n501:         return error(field_err, 400)\n502: \n503:     db = get_db()\n504:     existing = db.execute(\n505:         \"SELECT id FROM reports WHERE id = ?\", (report_id,)\n506:     ).fetchone()\n507:     if existing is None:\n508:         return error(\"Weather report not found\", 404)\n509: \n510:     duplicate = db.execute(\n511:         \"SELECT id FROM reports WHERE city_lower = ? AND id != ?\",\n512:         (fields[\"city\"].lower(), report_id),\n513:     ).fetchone()\n514:     if duplicate:\n515:         return error(f\"City '{fields['city']}' already exists\", 409)\n516: \n517:     db.execute(\n518:         \"\"\"\n519:         UPDATE reports\n520:         SET city = ?, city_lower = ?, country = ?, temperature_c = ?,\n521:             condition = ?, humidity = ?, wind_kph = ?, observed_at = ?\n522:         WHERE id = ?\n523:         \"\"\",\n524:         (\n525:             fields[\"city\"],\n526:             fields[\"city\"].lower(),\n527:             fields.get(\"country\"),\n528:             fields[\"temperature_c\"],\n529:             fields.get(\"condition\"),\n530:             fields.get(\"humidity\"),\n531:             fields.get(\"wind_kph\"),\n532:             now_iso(),\n533:             report_id,\n534:         ),\n535:     )\n536:     db.commit()\n537: \n538:     row = db.execute(\"SELECT * FROM reports WHERE id = ?\", (report_id,)).fetchone()\n539:     return jsonify(row_to_report(row))\n540: \n541: \n542: @app.delete(\"/api/weather/<int:report_id>\")\n543: def delete_weather(report_id: int):\n544:     user, auth_err = require_auth()\n545:     if auth_err:\n546:         return auth_err\n547: \n548:     db = get_db()\n549:     existing = db.execute(\n550:         \"SELECT id FROM reports WHERE id = ?\", (report_id,)\n551:     ).fetchone()\n552:     if existing is None:\n553:         return error(\"Weather report not found\", 404)\n554:     db.execute(\"DELETE FROM reports WHERE id = ?\", (report_id,))\n555:     db.commit()\n556:     return \"\", 204\n557: \n558: \n559: # ---------------------------------------------------------------------------\n560: # frontend + errors\n561: # ---------------------------------------------------------------------------\n562: \n563: @app.get(\"/\")\n564: @app.get(\"/<path:path>\")\n565: def frontend(path: str = \"index.html\"):\n566:     if path.startswith(\"api/\"):\n567:         return error(\"Not found\", 404)\n568:     if (DIST / path).is_file():\n569:         return send_from_directory(DIST, path)\n570:     return send_from_directory(DIST, \"index.html\")\n571: \n572: \n573: @app.errorhandler(404)\n574: def not_found(_exc):\n575:     if request.path.startswith(\"/api/\"):\n576:         return error(\"Not found\", 404)\n577:     if (DIST / \"index.html\").is_file():\n578:         return send_from_directory(DIST, \"index.html\")\n579:     return error(\"Not found\", 404)\n580: \n581: \n582: @app.errorhandler(405)\n583: def method_not_allowed(_exc):\n584:     if request.path.startswith(\"/api/\"):\n585:         return error(\"Method not allowed\", 405)\n586:     return error(\"Method not allowed\", 405)\n\n(End of file - total 586 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: weather display API and frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"weather.db\"\n\nPBKDF2_ITERATIONS = 200_000\nDEFAULT_PAGE = 1\nDEFAULT_PAGE_SIZE = 10","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: weather display API and frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"weather.db\"\n\nPBKDF2_ITERATIONS = 200_000\nDEFAULT_PAGE = 1\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\nDEFAULT_RECENT_LIMIT = 10\nMAX_RECENT_LIMIT = 100\n\nSAMPLE_REPORTS = [\n    (\"London\", \"United Kingdom\", 12.4, \"Cloudy\", 78, 14.2),\n    (\"Paris\", \"France\", 15.1, \"Sunny\", 61, 9.6),\n    (\"Tokyo\", \"Japan\", 22.7, \"Rain\", 74, 11.3),\n    (\"New York\", \"United States\", 9.8, \"Windy\", 55, 24.5),\n    (\"Sydney\", \"Australia\", 26.3, \"Sunny\", 48, 17.8),\n    (\"Berlin\", \"Germany\", 11.2, \"Overcast\", 70, 13.4),\n]\n\napp = Flask(__name__, static_folder=None)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n# ---------------------------------------------------------------------------\n# helpers\n# ---------------------------------------------------------------------------\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA busy_timeout=30000\")\n        conn.execute(\"PRAGMA foreign_keys=ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef row_to_report(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"city\": row[\"city\"],\n        \"country\": row[\"country\"],\n        \"temperature_c\": row[\"temperature_c\"],\n        \"condition\": row[\"condition\"],\n        \"humidity\": row[\"humidity\"],\n        \"wind_kph\": row[\"wind_kph\"],\n        \"observed_at\": row[\"observed_at\"],\n    }\n\n\ndef row_to_lookup(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"city\": row[\"city\"],\n        \"found\": bool(row[\"found\"]),\n        \"looked_up_at\": row[\"looked_up_at\"],\n    }\n\n\ndef hash_password(password: str, salt: str | None = None) -> str:\n    salt = salt or secrets.token_hex(16)\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ITERATIONS\n    )\n    return f\"pbkdf2_sha256${salt}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    try:\n        _scheme, salt, expected = stored.split(\"$\", 2)\n    except ValueError:\n        return False\n    digest = hashlib.pbkdf2_hmac(\n        \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt), PBKDF2_ITERATIONS\n    )\n    return hmac.compare_digest(digest.hex(), expected)\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"\"\"\n        SELECT u.id, u.username FROM auth_tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_auth():\n    user = current_user()\n    if user is None:\n        return None, error(\"Authentication required\", 401)\n    return user, None\n\n\ndef get_json_body() -> dict | None:\n    data = request.get_json(silent=True)\n    if data is None:\n        return None, error(\"Request body must be a JSON object\", 400)\n    if not isinstance(data, dict):\n        return None, error(\"Request body must be a JSON object\", 400)\n    return data, None\n\n\ndef as_number(value) -> float | None:\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return None\n    return float(value)\n\n\ndef validate_report_fields(data: dict) -> tuple[dict | None, str | None]:\n    \"\"\"Validate a create/replace payload. Returns (fields, error_message).\"\"\"\n    fields: dict = {}\n\n    city = data.get(\"city\")\n    if not isinstance(city, str) or not city.strip():\n        return None, \"city is required and must be a non-empty string\"\n    fields[\"city\"] = city.strip()\n\n    temperature = as_number(data.get(\"temperature_c\"))\n    if temperature is None:\n        return None, \"temperature_c is required and must be a number\"\n    fields[\"temperature_c\"] = temperature\n\n    if \"country\" in data:\n        country = data.get(\"country\")\n        if country is not None and not isinstance(country, str):\n            return None, \"country must be a string\"\n        fields[\"country\"] = country.strip() if isinstance(country, str) and country.strip() else None\n\n    if \"condition\" in data:\n        condition = data.get(\"condition\")\n        if condition is not None and not isinstance(condition, str):\n            return None, \"condition must be a string\"\n        fields[\"condition\"] = condition.strip() if isinstance(condition, str) and condition.strip() else None\n\n    if \"humidity\" in data:\n        humidity = data.get(\"humidity\")\n        if humidity is not None:\n            value = as_number(humidity)\n            if value is None or value != int(value) or not 0 <= value <= 100:\n                return None, \"humidity must be an integer between 0 and 100\"\n            fields[\"humidity\"] = int(value)\n        else:\n            fields[\"humidity\"] = None\n\n    if \"wind_kph\" in data:\n        wind = data.get(\"wind_kph\")\n        if wind is not None:\n            value = as_number(wind)\n            if value is None or value < 0:\n                return None, \"wind_kph must be a non-negative number\"\n            fields[\"wind_kph\"] = value\n        else:\n            fields[\"wind_kph\"] = None\n\n    return fields, None\n\n\n# ---------------------------------------------------------------------------\n# database setup\n# ---------------------------------------------------------------------------\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.execute(\"PRAGMA busy_timeout=30000\")\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL,\n                username_lower TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS auth_tokens (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                token TEXT NOT NULL UNIQUE,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS reports (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                city TEXT NOT NULL,\n                city_lower TEXT NOT NULL UNIQUE,\n                country TEXT,\n                temperature_c REAL NOT NULL,\n                condition TEXT,\n                humidity INTEGER,\n                wind_kph REAL,\n                observed_at TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS lookups (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                city TEXT NOT NULL,\n                found INTEGER NOT NULL,\n                looked_up_at TEXT NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_reports_city_lower ON reports(city_lower);\n            CREATE INDEX IF NOT EXISTS idx_lookups_looked_up_at ON lookups(looked_up_at DESC);\n            \"\"\"\n        )\n        conn.commit()\n        seed_if_empty(conn)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef seed_if_empty(conn: sqlite3.Connection) -> None:\n    count = conn.execute(\"SELECT COUNT(*) FROM reports\").fetchone()[0]\n    if count:\n        return\n    observed_at = now_iso()\n    for city, country, temperature, condition, humidity, wind in SAMPLE_REPORTS:\n        try:\n            conn.execute(\n                \"\"\"\n                INSERT INTO reports\n                    (city, city_lower, country, temperature_c, condition, humidity, wind_kph, observed_at)\n                VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n                \"\"\",\n                (city, city.lower(), country, temperature, condition, humidity, wind, observed_at),\n            )\n        except sqlite3.IntegrityError:\n            pass\n\n\ninit_db()\n\n\n# ---------------------------------------------------------------------------\n# auth routes\n# ---------------------------------------------------------------------------\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data, body_err = get_json_body()\n    if body_err:\n        return body_err\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required and must be a non-empty string\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required and must be a non-empty string\", 400)\n    username = username.strip()\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM users WHERE username_lower = ?\", (username.lower(),)\n    ).fetchone()\n    if existing:\n        return error(\"Username already taken\", 409)\n\n    try:\n        cur = db.execute(\n            \"\"\"\n            INSERT INTO users (username, username_lower, password_hash, created_at)\n            VALUES (?, ?, ?, ?)\n            \"\"\",\n            (username, username.lower(), hash_password(password), now_iso()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"Username already taken\", 409)\n\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data, body_err = get_json_body()\n    if body_err:\n        return body_err\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required and must be a non-empty string\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required and must be a non-empty string\", 400)\n\n    user = get_db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username_lower = ?\",\n        (username.strip().lower(),),\n    ).fetchone()\n    if user is None or not verify_password(password, user[\"password_hash\"]):\n        return error(\"Invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db = get_db()\n    db.execute(\n        \"INSERT INTO auth_tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n# ---------------------------------------------------------------------------\n# weather routes\n# ---------------------------------------------------------------------------\n\ndef parse_int_arg(name: str, default: int, lo: int, hi: int) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except (TypeError, ValueError):\n        return default\n    if value < lo:\n        return default if lo <= default <= hi else lo\n    return min(value, hi)\n\n\n@app.get(\"/api/weather\")\ndef list_weather():\n    city = request.args.get(\"city\")\n    db = get_db()\n\n    if city is not None and city.strip():\n        city = city.strip()\n        found_row = db.execute(\n            \"SELECT id FROM reports WHERE city_lower = ?\", (city.lower(),)\n        ).fetchone()\n        db.execute(\n            \"INSERT INTO lookups (city, found, looked_up_at) VALUES (?, ?, ?)\",\n            (city, 1 if found_row else 0, now_iso()),\n        )\n        db.commit()\n\n        page = parse_int_arg(\"page\", DEFAULT_PAGE, 1, 10_000_000)\n        page_size = parse_int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n        total = db.execute(\n            \"SELECT COUNT(*) FROM reports WHERE city_lower = ?\", (city.lower(),)\n        ).fetchone()[0]\n        rows = db.execute(\n            \"\"\"\n            SELECT * FROM reports WHERE city_lower = ?\n            ORDER BY city COLLATE NOCASE ASC, id ASC\n            LIMIT ? OFFSET ?\n            \"\"\",\n            (city.lower(), page_size, (page - 1) * page_size),\n        ).fetchall()\n        return jsonify(\n            {\"items\": [row_to_report(r) for r in rows], \"total\": total,\n             \"page\": page, \"page_size\": page_size}\n        )\n\n    page = parse_int_arg(\"page\", DEFAULT_PAGE, 1, 10_000_000)\n    page_size = parse_int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    total = db.execute(\"SELECT COUNT(*) FROM reports\").fetchone()[0]\n    rows = db.execute(\n        \"\"\"\n        SELECT * FROM reports\n        ORDER BY city COLLATE NOCASE ASC, id ASC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\"items\": [row_to_report(r) for r in rows], \"total\": total,\n         \"page\": page, \"page_size\": page_size}\n    )\n\n\n@app.get(\"/api/weather/recent\")\ndef recent_lookups():\n    limit = parse_int_arg(\"limit\", DEFAULT_RECENT_LIMIT, 1, MAX_RECENT_LIMIT)\n    rows = get_db().execute(\n        \"\"\"\n        SELECT * FROM lookups\n        ORDER BY looked_up_at DESC, id DESC\n        LIMIT ?\n        \"\"\",\n        (limit,),\n    ).fetchall()\n    return jsonify({\"items\": [row_to_lookup(r) for r in rows]})\n\n\n@app.post(\"/api/weather\")\ndef create_weather():\n    user, auth_err = require_auth()\n    if auth_err:\n        return auth_err\n\n    data, body_err = get_json_body()\n    if body_err:\n        return body_err\n\n    fields, field_err = validate_report_fields(data)\n    if field_err:\n        return error(field_err, 400)\n\n    db = get_db()\n    duplicate = db.execute(\n        \"SELECT id FROM reports WHERE city_lower = ?\", (fields[\"city\"].lower(),)\n    ).fetchone()\n    if duplicate:\n        return error(f\"City '{fields['city']}' already exists\", 409)\n\n    try:\n        cur = db.execute(\n            \"\"\"\n            INSERT INTO reports\n                (city, city_lower, country, temperature_c, condition, humidity, wind_kph, observed_at)\n            VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n            \"\"\",\n            (\n                fields[\"city\"],\n                fields[\"city\"].lower(),\n                fields.get(\"country\"),\n                fields[\"temperature_c\"],\n                fields.get(\"condition\"),\n                fields.get(\"humidity\"),\n                fields.get(\"wind_kph\"),\n                now_iso(),\n            ),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(f\"City '{fields['city']}' already exists\", 409)\n\n    row = db.execute(\"SELECT * FROM reports WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(row_to_report(row)), 201\n\n\n@app.get(\"/api/weather/<int:report_id>\")\ndef get_weather(report_id: int):\n    row = get_db().execute(\n        \"SELECT * FROM reports WHERE id = ?\", (report_id,)\n    ).fetchone()\n    if row is None:\n        return error(\"Weather report not found\", 404)\n    return jsonify(row_to_report(row))\n\n\n@app.put(\"/api/weather/<int:report_id>\")\ndef replace_weather(report_id: int):\n    user, auth_err = require_auth()\n    if auth_err:\n        return auth_err\n\n    data, body_err = get_json_body()\n    if body_err:\n        return body_err\n\n    fields, field_err = validate_report_fields(data)\n    if field_err:\n        return error(field_err, 400)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM reports WHERE id = ?\", (report_id,)\n    ).fetchone()\n    if existing is None:\n        return error(\"Weather report not found\", 404)\n\n    duplicate = db.execute(\n        \"SELECT id FROM reports WHERE city_lower = ? AND id != ?\",\n        (fields[\"city\"].lower(), report_id),\n    ).fetchone()\n    if duplicate:\n        return error(f\"City '{fields['city']}' already exists\", 409)\n\n    db.execute(\n        \"\"\"\n        UPDATE reports\n        SET city = ?, city_lower = ?, country = ?, temperature_c = ?,\n            condition = ?, humidity = ?, wind_kph = ?, observed_at = ?\n        WHERE id = ?\n        \"\"\",\n        (\n            fields[\"city\"],\n            fields[\"city\"].lower(),\n            fields.get(\"country\"),\n            fields[\"temperature_c\"],\n            fields.get(\"condition\"),\n            fields.get(\"humidity\"),\n            fields.get(\"wind_kph\"),\n            now_iso(),\n            report_id,\n        ),\n    )\n    db.commit()\n\n    row = db.execute(\"SELECT * FROM reports WHERE id = ?\", (report_id,)).fetchone()\n    return jsonify(row_to_report(row))\n\n\n@app.delete(\"/api/weather/<int:report_id>\")\ndef delete_weather(report_id: int):\n    user, auth_err = require_auth()\n    if auth_err:\n        return auth_err\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT id FROM reports WHERE id = ?\", (report_id,)\n    ).fetchone()\n    if existing is None:\n        return error(\"Weather report not found\", 404)\n    db.execute(\"DELETE FROM reports WHERE id = ?\", (report_id,))\n    db.commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# frontend + errors\n# ---------------------------------------------------------------------------\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(404)\ndef not_found(_exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"Not found\", 404)\n    if (DIST / \"index.html\").is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return error(\"Not found\", 404)\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_exc):\n    if request.path.startswith(\"/api/\"):\n        return error(\"Method not allowed\", 405)\n    return error(\"Method not allowed\", 405)","lineStart":1,"lineEnd":586,"totalLines":586,"truncated":false}},"title":"backend/app.py","time":{"start":1794311951611,"end":1794311951624}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c55394f6001vUDaZDgktcv10r","sessionID":"ses_e3ad04a9dffeKmeb6KDBnUtCaL","messageID":"msg_1c55304c6001L2gf3ZyxmvdrZy"}}
