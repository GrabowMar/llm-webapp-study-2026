   return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")","lineStart":1,"lineEnd":23,"totalLines":23,"truncated":false}},"title":"backend/app.py","time":{"start":1794369124528,"end":1794369124702}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8bbf897001VWGcL36bOn0iVg","sessionID":"ses_e3744480affex77CITZAUDwa8q","messageID":"msg_1c8bbdccc001rT1hwEoha7ZQ9L"}}
