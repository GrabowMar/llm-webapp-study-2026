{"type":"tool_use","timestamp":1794370040651,"sessionID":"ses_e3744480affex77CITZAUDwa8q","part":{"type":"tool","tool":"write","callID":"call_0ece3660ff404845ab4d484e","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","content":"\"\"\"Flask entry point: leaderboard API and frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport os\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = ROOT / \"data\"\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\") or \"\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at REAL NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS scores (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    score REAL NOT NULL,\n    achieved_ts REAL NOT NULL,\n    is_hidden INTEGER NOT NULL DEFAULT 0\n);\n\nCREATE INDEX IF NOT EXISTS idx_scores_user ON scores(user_id);\nCREATE INDEX IF NOT EXISTS idx_scores_ts ON scores(achieved_ts);\n\"\"\"\n\nPERIOD_ALIASES = {\n    \"all\": \"all\",\n    \"alltime\": \"all\",\n    \"all_time\": \"all\",\n    \"all-time\": \"all\",\n    \"lifetime\": \"all\",\n    \"total\": \"all\",\n    \"ever\": \"all\",\n    \"overall\": \"all\",\n    \"global\": \"all\",\n    \"week\": \"week\",\n    \"weekly\": \"week\",\n    \"this_week\": \"week\",\n    \"this-week\": \"week\",\n    \"7d\": \"week\",\n    \"today\": \"today\",\n    \"daily\": \"today\",\n    \"day\": \"today\",\n    \"this_day\": \"today\",\n}\n\n\n# --------------------------------------------------------------------------\n# database\n# --------------------------------------------------------------------------\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.execute(\"PRAGMA busy_timeout=30000\")\n        conn.executescript(SCHEMA)\n        if ADMIN_PASSWORD:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1) \"\n                \"ON CONFLICT(username) DO UPDATE SET password_hash = excluded.password_hash, \"\n                \"is_admin = 1\",\n                (ADMIN_USERNAME, generate_password_hash(ADMIN_PASSWORD)),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    conn = g.get(\"db\")\n    if conn is None:\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA busy_timeout=30000\")\n        conn.execute(\"PRAGMA foreign_keys=ON\")\n        g.db = conn\n    return conn\n\n\n@app.teardown_appcontext\ndef _close_db(_exc: object) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ninit_db()\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\n\n\ndef _err(message: str, status: int):\n    return {\"error\": message}, status\n\n\ndef _json_body() -> dict | None:\n    data = request.get_json(silent=True, force=True)\n    return data if isinstance(data, dict) else None\n\n\ndef _as_number(value):\n    if value is None:\n        return None\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n    return value\n\n\ndef format_ts(ts: float) -> str:\n    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef score_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"score\": _as_number(row[\"score\"]),\n        \"achieved_at\": format_ts(row[\"achieved_ts\"]),\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n\n\ndef normalize_period(raw: str | None) -> str:\n    if raw is None or not raw.strip():\n        return \"all\"\n    return PERIOD_ALIASES.get(raw.strip().lower(), \"all\")\n\n\ndef period_cutoff(period: str) -> float | None:\n    now = datetime.now(timezone.utc)\n    if period == \"today\":\n        start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n        return start.timestamp()\n    if period == \"week\":\n        start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n        start = start - timedelta(days=start.weekday())\n        return start.timestamp()\n    return None\n\n\ndef _optional_positive_int(name: str) -> int | None:\n    raw = request.args.get(name)\n    if raw is None or str(raw).strip() == \"\":\n        return None\n    try:\n        value = int(str(raw).strip())\n    except (TypeError, ValueError):\n        return None\n    if value < 1:\n        return None\n    return value\n\n\ndef authenticate():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username, u.is_admin FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = authenticate()\n        if user is None:\n            return _err(\"authentication required\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef admin_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = authenticate()\n        if user is None:\n            return _err(\"authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return _err(\"admin access required\", 403)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef compute_leaderboard(period: str, player: str | None) -> list[dict]:\n    cutoff = period_cutoff(period)\n    sql = (\n        \"SELECT s.score, s.achieved_ts, u.id AS uid, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.is_hidden = 0\"\n    )\n    params: list = []\n    if cutoff is not None:\n        sql += \" AND s.achieved_ts >= ?\"\n        params.append(cutoff)\n    if player:\n        escaped = (\n            player.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        )\n        sql += \" AND u.username LIKE ? ESCAPE '\\\\'\"\n        params.append(f\"%{escaped}%\")\n    rows = get_db().execute(sql, params).fetchall()\n\n    best: dict[int, dict] = {}\n    for row in rows:\n        uid = row[\"uid\"]\n        entry = best.get(uid)\n        if (\n            entry is None\n            or row[\"score\"] > entry[\"score\"]\n            or (row[\"score\"] == entry[\"score\"] and row[\"achieved_ts\"] < entry[\"achieved_ts\"])\n        ):\n            best[uid] = {\n                \"username\": row[\"username\"],\n                \"score\": row[\"score\"],\n                \"achieved_ts\": row[\"achieved_ts\"],\n            }\n\n    ordered = sorted(\n        best.items(), key=lambda kv: (-kv[1][\"score\"], kv[1][\"achieved_ts\"], kv[0])\n    )\n    items: list[dict] = []\n    for rank, (_uid, entry) in enumerate(ordered, start=1):\n        items.append(\n            {\n                \"rank\": rank,\n                \"player\": entry[\"username\"],\n                \"score\": _as_number(entry[\"score\"]),\n                \"achieved_at\": format_ts(entry[\"achieved_ts\"]),\n            }\n        )\n    return items\n\n\ndef all_time_rank(username: str) -> int | None:\n    for item in compute_leaderboard(\"all\", None):\n        if item[\"player\"].lower() == username.lower():\n            return item[\"rank\"]\n    return None\n\n\n# --------------------------------------------------------------------------\n# auth\n# --------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _json_body()\n    if data is None:\n        return _err(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return _err(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return _err(\"username and password are required\", 400)\n    if username.lower() == ADMIN_USERNAME:\n        return _err(\"username not available\", 409)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT 1 FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return _err(\"username not available\", 409)\n\n    db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return {\"username\": username}, 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _json_body()\n    if data is None:\n        return _err(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return _err(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return _err(\"username and password are required\", 400)\n\n    if username.lower() == ADMIN_USERNAME and not ADMIN_PASSWORD:\n        return _err(\"admin sign-in is disabled\", 401)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT * FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return _err(\"invalid credentials\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], time.time()),\n    )\n    db.commit()\n    return {\"token\": token}, 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}, 200\n\n\n# --------------------------------------------------------------------------\n# leaderboard and scores\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    period = normalize_period(request.args.get(\"period\"))\n    player = request.args.get(\"player\") or None\n    if player is not None:\n        player = player.strip() or None\n    limit = _optional_positive_int(\"limit\")\n\n    items = compute_leaderboard(period, player)\n    total = len(items)\n    if limit is not None:\n        items = items[:limit]\n    return {\"items\": items, \"total\": total}, 200\n\n\n@app.post(\"/api/scores\")\n@login_required\ndef submit_score():\n    data = _json_body()\n    if data is None:\n        return _err(\"invalid JSON body\", 400)\n    value = data.get(\"score\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return _err(\"score must be a number\", 400)\n    if not math.isfinite(float(value)):\n        return _err(\"score must be a number\", 400)\n\n    db = get_db()\n    user_id = g.user[\"id\"]\n    previous = db.execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n        (user_id,),\n    ).fetchone()[\"best\"]\n    now = time.time()\n    cursor = db.execute(\n        \"INSERT INTO scores (user_id, score, achieved_ts, is_hidden) VALUES (?, ?, ?, 0)\",\n        (user_id, float(value), now),\n    )\n    db.commit()\n\n    personal_best = previous is None or float(value) > float(previous)\n    row = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n\n    payload = score_to_dict(row)\n    payload[\"rank\"] = all_time_rank(g.user[\"username\"])\n    payload[\"personal_best\"] = personal_best\n    return payload, 200\n\n\n@app.get(\"/api/scores\")\n@login_required\ndef my_scores():\n    db = get_db()\n    rows = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"WHERE s.user_id = ? ORDER BY s.achieved_ts DESC, s.id DESC\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    best = db.execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n        (g.user[\"id\"],),\n    ).fetchone()[\"best\"]\n    return {\"items\": [score_to_dict(r) for r in rows], \"best_score\": _as_number(best)}, 200\n\n\n# --------------------------------------------------------------------------\n# admin\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/admin/scores\")\n@admin_required\ndef admin_scores():\n    db = get_db()\n    page = _optional_positive_int(\"page\") or 1\n    page_size = _optional_positive_int(\"page_size\") or 20\n\n    total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"ORDER BY s.achieved_ts DESC, s.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return {\n        \"items\": [score_to_dict(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }, 200\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n@admin_required\ndef toggle_score(score_id: int):\n    db = get_db()\n    row = db.execute(\"SELECT id FROM scores WHERE id = ?\", (score_id,)).fetchone()\n    if row is None:\n        return _err(\"score not found\", 404)\n    db.execute(\n        \"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,)\n    )\n    db.commit()\n    updated = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    return score_to_dict(updated), 200\n\n\n# --------------------------------------------------------------------------\n# frontend hosting\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return _err(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return _err(\"not found\", 404)\n    return _err(\"not found\", 404)\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_error):\n    if request.path.startswith(\"/api/\"):\n        return _err(\"method not allowed\", 405)\n    return _err(\"method not allowed\", 405)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794370040468,"end":1794370040574}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8c9f28a001vfPg0Vi3305oJ2","sessionID":"ses_e3744480affex77CITZAUDwa8q","messageID":"msg_1c8c2122a001OzJ8q8aAZ6ZBWo"}}
