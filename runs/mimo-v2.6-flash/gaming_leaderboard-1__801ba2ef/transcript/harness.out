{"type":"tool_use","timestamp":1794372014855,"sessionID":"ses_e3744480affex77CITZAUDwa8q","part":{"type":"tool","tool":"write","callID":"call_78b8c68d281248629fce63e1","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Smoke tests for the leaderboard API (basic).\"\"\"\nimport json\nimport urllib.request\nimport urllib.error\n\nBASE = \"http://127.0.0.1:8000\"\npassed = 0\nfailed = 0\n\n\ndef req(method, path, body=None, token=None, expect=200):\n    global passed, failed\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(BASE + path, data=data, method=method)\n    if data is not None:\n        r.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        r.add_header(\"Authorization\", f\"Bearer {token}\")\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status = resp.status\n            payload = json.loads(resp.read().decode() or \"{}\")\n    except urllib.error.HTTPError as e:\n        status = e.code\n        try:\n            payload = json.loads(e.read().decode() or \"{}\")\n        except Exception:\n            payload = {}\n    ok = status == expect\n    if ok:\n        passed += 1\n    else:\n        failed += 1\n        print(f\"FAIL {method} {path}: expected {expect}, got {status}: {payload}\")\n    return status, payload\n\n\n# health\ns, p = req(\"GET\", \"/api/health\", expect=200)\nassert p.get(\"status\") == \"ok\", p\n\n# register\ns, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123456\"}, expect=201)\nassert p.get(\"username\") == \"alice\", p\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw123456\"}, expect=409)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw123456\"}, expect=201)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw123456\"}, expect=201)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"pw123456\"}, expect=409)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"\"}, expect=400)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"}, expect=400)\n\n# login\ns, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ns, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw123456\"}, expect=200)\ntok_a = p[\"token\"]\nassert set(p.keys()) == {\"token\"}, p.keys()\ns, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"BOB\", \"password\": \"pw123456\"}, expect=200)\ntok_b = p[\"token\"]\ns, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw123456\"}, expect=200)\ntok_c = p[\"token\"]\n# admin sign-in disabled\nreq(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"sesame\"}, expect=401)\n\n# unauthenticated\nreq(\"GET\", \"/api/scores\", expect=401)\nreq(\"GET\", \"/api/admin/scores\", expect=401)\nreq(\"POST\", \"/api/scores\", {\"score\": 100}, expect=401)\n\n# me\ns, p = req(\"GET\", \"/api/auth/me\", token=tok_a, expect=200)\nassert p == {\"username\": \"alice\", \"is_admin\": False}, p\nreq(\"GET\", \"/api/auth/me\", expect=401)\n\n# submit scores\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 100}, token=tok_a, expect=200)\nassert p[\"score\"] == 100 and p[\"player\"] == \"alice\" and p[\"rank\"] == 1 and p[\"personal_best\"] is True, p\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 250}, token=tok_a, expect=200)\nassert p[\"personal_best\"] is True and p[\"rank\"] == 1, p\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 150}, token=tok_a, expect=200)\nassert p[\"personal_best\"] is False, p\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 300}, token=tok_b, expect=200)\nassert p[\"rank\"] == 1 and p[\"personal_best\"] is True, p\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 120}, token=tok_c, expect=200)\nassert p[\"rank\"] == 3, p\n# invalid scores\nreq(\"POST\", \"/api/scores\", {\"score\": \"high\"}, token=tok_a, expect=400)\nreq(\"POST\", \"/api/scores\", {}, token=tok_a, expect=400)\nreq(\"POST\", \"/api/scores\", {\"score\": True}, token=tok_a, expect=400)\n\n# scores listing\ns, p = req(\"GET\", \"/api/scores\", token=tok_a, expect=200)\nassert p[\"best_score\"] == 250, p\nassert [i[\"score\"] for i in p[\"items\"]] == [150, 250, 100], p\nassert all(i[\"player\"] == \"alice\" for i in p[\"items\"]), p\n\n# leaderboard\ns, p = req(\"GET\", \"/api/leaderboard\", expect=200)\nassert p[\"total\"] == 3, p\nassert [i[\"player\"] for i in p[\"items\"]] == [\"bob\", \"alice\", \"carol\"], p\nassert [i[\"rank\"] for i in p[\"items\"]] == [1, 2, 3], p\nassert p[\"items\"][0][\"score\"] == 300, p\ns, p = req(\"GET\", \"/api/leaderboard?limit=2\", expect=200)\nassert len(p[\"items\"]) == 2 and p[\"total\"] == 3, p\ns, p = req(\"GET\", \"/api/leaderboard?player=ali\", expect=200)\nassert p[\"total\"] == 1 and p[\"items\"][0][\"player\"] == \"alice\", p\ns, p = req(\"GET\", \"/api/leaderboard?player=zzz\", expect=200)\nassert p == {\"items\": [], \"total\": 0}, p\ns, p = req(\"GET\", \"/api/leaderboard?period=week\", expect=200)\nassert p[\"total\"] == 3, p\ns, p = req(\"GET\", \"/api/leaderboard?period=today\", expect=200)\nassert p[\"total\"] == 3, p\ns, p = req(\"GET\", \"/api/leaderboard?period=nonsense\", expect=200)\nassert p[\"total\"] == 3, p\ns, p = req(\"GET\", \"/api/leaderboard?period=all&limit=bogus\", expect=200)\nassert p[\"total\"] == 3, p\n\n# admin endpoints without admin token\nreq(\"GET\", \"/api/admin/scores\", token=tok_a, expect=403)\nreq(\"POST\", \"/api/admin/scores/1/toggle\", token=tok_a, expect=403)\n\n# unknown routes\nreq(\"GET\", \"/api/nope\", expect=404)\nreq(\"PUT\", \"/api/scores\", expect=405)\n\nprint(f\"basic: {passed} passed, {failed} failed\")\nprint(\"ALL BASIC TESTS PASSED\" if failed == 0 else \"FAILURES\")\nraise SystemExit(1 if failed else 0)\n","filePath":"/workspace/.smoke_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.smoke_test.py","exists":false,"truncated":false},"title":".smoke_test.py","time":{"start":1794372014767,"end":1794372014796}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8e812a7001onu6xuN5QGEooo","sessionID":"ses_e3744480affex77CITZAUDwa8q","messageID":"msg_1c8e6ba60001kX5YDncrGfFfNv"}}
{"type":"tool_use","timestamp":1794372014855,"sessionID":"ses_e3744480affex77CITZAUDwa8q","part":{"type":"tool","tool":"write","callID":"call_d405ee7f4ad14cd5a3381d02","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Smoke tests for admin hide/show (requires ADMIN_PASSWORD=sesame at server start).\"\"\"\nimport json\nimport urllib.request\nimport urllib.error\n\nBASE = \"http://127.0.0.1:8000\"\npassed = 0\nfailed = 0\n\n\ndef req(method, path, body=None, token=None, expect=200):\n    global passed, failed\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(BASE + path, data=data, method=method)\n    if data is not None:\n        r.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        r.add_header(\"Authorization\", f\"Bearer {token}\")\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status = resp.status\n            payload = json.loads(resp.read().decode() or \"{}\")\n    except urllib.error.HTTPError as e:\n        status = e.code\n        try:\n            payload = json.loads(e.read().decode() or \"{}\")\n        except Exception:\n            payload = {}\n    ok = status == expect\n    if ok:\n        passed += 1\n    else:\n        failed += 1\n        print(f\"FAIL {method} {path}: expected {expect}, got {status}: {payload}\")\n    return status, payload\n\n\n# data exists from the basic run: alice/bob/carol\ns, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"sesame\"}, expect=200)\ntok_admin = p[\"token\"]\nreq(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"wrong\"}, expect=401)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"x\"}, expect=409)\n\ns, p = req(\"GET\", \"/api/auth/me\", token=tok_admin, expect=200)\nassert p == {\"username\": \"admin\", \"is_admin\": True}, p\n\n# admin scores listing\ns, p = req(\"GET\", \"/api/admin/scores\", token=tok_admin, expect=200)\nassert set(p.keys()) == {\"items\", \"total\", \"page\", \"page_size\"}, p.keys()\nassert p[\"total\"] == 3 and len(p[\"items\"]) == 3, p\nassert all(\"is_hidden\" in i for i in p[\"items\"]), p\ns, p = req(\"GET\", \"/api/admin/scores?page=1&page_size=2\", token=tok_admin, expect=200)\nassert p[\"page\"] == 1 and p[\"page_size\"] == 2 and len(p[\"items\"]) == 2 and p[\"total\"] == 3, p\ns, p = req(\"GET\", \"/api/admin/scores?page=2&page_size=2\", token=tok_admin, expect=200)\nassert len(p[\"items\"]) == 1, p\n\n# find bob's score (300)\nbob_id = next(i[\"id\"] for i in p[\"items\"] if i[\"player\"] == \"bob\")\ns, p = req(\"GET\", \"/api/admin/scores\", token=tok_admin, expect=200)\nbob_id = next(i[\"id\"] for i in p[\"items\"] if i[\"player\"] == \"bob\")\nassert bob_id\n\n# toggle hide\ns, p = req(\"POST\", f\"/api/admin/scores/{bob_id}/toggle\", token=tok_admin, expect=200)\nassert p[\"is_hidden\"] is True, p\n\n# hidden score excluded from leaderboard and personal best\ns, p = req(\"GET\", \"/api/leaderboard\", expect=200)\nassert p[\"total\"] == 2, p\nassert all(i[\"player\"] != \"bob\" for i in p[\"items\"]), p\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 50}, token=None, expect=401)\n\n# login as bob, check best_score excludes hidden\ns, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw123456\"}, expect=200)\ntok_b = p[\"token\"]\ns, p = req(\"GET\", \"/api/scores\", token=tok_b, expect=200)\nassert p[\"best_score\"] is None, p\n# new lower score is still a personal best (no visible score)\ns, p = req(\"POST\", \"/api/scores\", {\"score\": 10}, token=tok_b, expect=200)\nassert p[\"personal_best\"] is True, p\n\n# admin listing still shows hidden score\ns, p = req(\"GET\", \"/api/admin/scores\", token=tok_admin, expect=200)\nrow = next(i for i in p[\"items\"] if i[\"id\"] == bob_id)\nassert row[\"is_hidden\"] is True, row\n\n# toggle show\ns, p = req(\"POST\", f\"/api/admin/scores/{bob_id}/toggle\", token=tok_admin, expect=200)\nassert p[\"is_hidden\"] is False, p\ns, p = req(\"GET\", \"/api/leaderboard\", expect=200)\nassert any(i[\"player\"] == \"bob\" for i in p[\"items\"]), p\n\n# toggle nonexistent\nreq(\"POST\", \"/api/admin/scores/99999/toggle\", token=tok_admin, expect=404)\n\n# non-admin forbidden again\nreq(\"POST\", \"/api/admin/scores/1/toggle\", token=tok_b, expect=403)\n\nprint(f\"admin: {passed} passed, {failed} failed\")\nprint(\"ALL ADMIN TESTS PASSED\" if failed == 0 else \"FAILURES\")\nraise SystemExit(1 if failed else 0)\n","filePath":"/workspace/.smoke_admin.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.smoke_admin.py","exists":false,"truncated":false},"title":".smoke_admin.py","time":{"start":1794372014779,"end":1794372014807}},"id":"prt_1c8e812b3001decTVoFwnQjCZ4","sessionID":"ses_e3744480affex77CITZAUDwa8q","messageID":"msg_1c8e6ba60001kX5YDncrGfFfNv"}}
