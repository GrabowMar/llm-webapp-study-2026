{"type":"tool_use","timestamp":1794371771816,"sessionID":"ses_e3744480affex77CITZAUDwa8q","part":{"type":"tool","tool":"read","callID":"call_5851a3c947f146d1bb8e74b4","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: leaderboard API and frontend hosting.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import math\n6: import os\n7: import secrets\n8: import sqlite3\n9: import time\n10: from datetime import datetime, timedelta, timezone\n11: from functools import wraps\n12: from pathlib import Path\n13: \n14: from flask import Flask, g, request, send_from_directory\n15: from werkzeug.security import check_password_hash, generate_password_hash\n16: \n17: ROOT = Path(__file__).resolve().parent.parent\n18: DIST = ROOT / \"frontend\" / \"dist\"\n19: DATA_DIR = ROOT / \"data\"\n20: DB_PATH = DATA_DIR / \"leaderboard.db\"\n21: \n22: ADMIN_USERNAME = \"admin\"\n23: ADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\") or \"\"\n24: \n25: app = Flask(__name__, static_folder=None)\n26: \n27: SCHEMA = \"\"\"\n28: CREATE TABLE IF NOT EXISTS users (\n29:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n30:     username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n31:     password_hash TEXT NOT NULL,\n32:     is_admin INTEGER NOT NULL DEFAULT 0\n33: );\n34: \n35: CREATE TABLE IF NOT EXISTS tokens (\n36:     token TEXT PRIMARY KEY,\n37:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n38:     created_at REAL NOT NULL\n39: );\n40: \n41: CREATE TABLE IF NOT EXISTS scores (\n42:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n43:     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n44:     score REAL NOT NULL,\n45:     achieved_ts REAL NOT NULL,\n46:     is_hidden INTEGER NOT NULL DEFAULT 0\n47: );\n48: \n49: CREATE INDEX IF NOT EXISTS idx_scores_user ON scores(user_id);\n50: CREATE INDEX IF NOT EXISTS idx_scores_ts ON scores(achieved_ts);\n51: \"\"\"\n52: \n53: PERIOD_ALIASES = {\n54:     \"all\": \"all\",\n55:     \"alltime\": \"all\",\n56:     \"all_time\": \"all\",\n57:     \"all-time\": \"all\",\n58:     \"lifetime\": \"all\",\n59:     \"total\": \"all\",\n60:     \"ever\": \"all\",\n61:     \"overall\": \"all\",\n62:     \"global\": \"all\",\n63:     \"week\": \"week\",\n64:     \"weekly\": \"week\",\n65:     \"this_week\": \"week\",\n66:     \"this-week\": \"week\",\n67:     \"7d\": \"week\",\n68:     \"today\": \"today\",\n69:     \"daily\": \"today\",\n70:     \"day\": \"today\",\n71:     \"this_day\": \"today\",\n72: }\n73: \n74: \n75: # --------------------------------------------------------------------------\n76: # database\n77: # --------------------------------------------------------------------------\n78: \n79: \n80: def init_db() -> None:\n81:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n82:     conn = sqlite3.connect(DB_PATH, timeout=30)\n83:     try:\n84:         conn.row_factory = sqlite3.Row\n85:         conn.execute(\"PRAGMA journal_mode=WAL\")\n86:         conn.execute(\"PRAGMA busy_timeout=30000\")\n87:         conn.executescript(SCHEMA)\n88:         if ADMIN_PASSWORD:\n89:             conn.execute(\n90:                 \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1) \"\n91:                 \"ON CONFLICT(username) DO UPDATE SET password_hash = excluded.password_hash, \"\n92:                 \"is_admin = 1\",\n93:                 (ADMIN_USERNAME, generate_password_hash(ADMIN_PASSWORD)),\n94:             )\n95:         conn.commit()\n96:     finally:\n97:         conn.close()\n98: \n99: \n100: def get_db() -> sqlite3.Connection:\n101:     conn = g.get(\"db\")\n102:     if conn is None:\n103:         conn = sqlite3.connect(DB_PATH, timeout=30)\n104:         conn.row_factory = sqlite3.Row\n105:         conn.execute(\"PRAGMA busy_timeout=30000\")\n106:         conn.execute(\"PRAGMA foreign_keys=ON\")\n107:         g.db = conn\n108:     return conn\n109: \n110: \n111: @app.teardown_appcontext\n112: def _close_db(_exc: object) -> None:\n113:     conn = g.pop(\"db\", None)\n114:     if conn is not None:\n115:         conn.close()\n116: \n117: \n118: init_db()\n119: \n120: \n121: # --------------------------------------------------------------------------\n122: # helpers\n123: # --------------------------------------------------------------------------\n124: \n125: \n126: def _err(message: str, status: int):\n127:     return {\"error\": message}, status\n128: \n129: \n130: def _json_body() -> dict | None:\n131:     data = request.get_json(silent=True, force=True)\n132:     return data if isinstance(data, dict) else None\n133: \n134: \n135: def _as_number(value):\n136:     if value is None:\n137:         return None\n138:     if isinstance(value, float) and value.is_integer():\n139:         return int(value)\n140:     return value\n141: \n142: \n143: def format_ts(ts: float) -> str:\n144:     return datetime.fromtimestamp(ts, tz=timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n145: \n146: \n147: def score_to_dict(row: sqlite3.Row) -> dict:\n148:     return {\n149:         \"id\": row[\"id\"],\n150:         \"score\": _as_number(row[\"score\"]),\n151:         \"achieved_at\": format_ts(row[\"achieved_ts\"]),\n152:         \"is_hidden\": bool(row[\"is_hidden\"]),\n153:         \"player\": row[\"username\"],\n154:     }\n155: \n156: \n157: def normalize_period(raw: str | None) -> str:\n158:     if raw is None or not raw.strip():\n159:         return \"all\"\n160:     return PERIOD_ALIASES.get(raw.strip().lower(), \"all\")\n161: \n162: \n163: def period_cutoff(period: str) -> float | None:\n164:     now = datetime.now(timezone.utc)\n165:     if period == \"today\":\n166:         start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n167:         return start.timestamp()\n168:     if period == \"week\":\n169:         start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n170:         start = start - timedelta(days=start.weekday())\n171:         return start.timestamp()\n172:     return None\n173: \n174: \n175: def _optional_positive_int(name: str) -> int | None:\n176:     raw = request.args.get(name)\n177:     if raw is None or str(raw).strip() == \"\":\n178:         return None\n179:     try:\n180:         value = int(str(raw).strip())\n181:     except (TypeError, ValueError):\n182:         return None\n183:     if value < 1:\n184:         return None\n185:     return value\n186: \n187: \n188: def authenticate():\n189:     header = request.headers.get(\"Authorization\", \"\")\n190:     parts = header.split(None, 1)\n191:     if len(parts) != 2 or parts[0].lower() != \"bearer\":\n192:         return None\n193:     token = parts[1].strip()\n194:     if not token:\n195:         return None\n196:     row = get_db().execute(\n197:         \"SELECT u.id, u.username, u.is_admin FROM tokens t \"\n198:         \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n199:         (token,),\n200:     ).fetchone()\n201:     return row\n202: \n203: \n204: def login_required(fn):\n205:     @wraps(fn)\n206:     def wrapper(*args, **kwargs):\n207:         user = authenticate()\n208:         if user is None:\n209:             return _err(\"authentication required\", 401)\n210:         g.user = user\n211:         return fn(*args, **kwargs)\n212: \n213:     return wrapper\n214: \n215: \n216: def admin_required(fn):\n217:     @wraps(fn)\n218:     def wrapper(*args, **kwargs):\n219:         user = authenticate()\n220:         if user is None:\n221:             return _err(\"authentication required\", 401)\n222:         if not user[\"is_admin\"]:\n223:             return _err(\"admin access required\", 403)\n224:         g.user = user\n225:         return fn(*args, **kwargs)\n226: \n227:     return wrapper\n228: \n229: \n230: def compute_leaderboard(period: str, player: str | None) -> list[dict]:\n231:     cutoff = period_cutoff(period)\n232:     sql = (\n233:         \"SELECT s.score, s.achieved_ts, u.id AS uid, u.username \"\n234:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.is_hidden = 0\"\n235:     )\n236:     params: list = []\n237:     if cutoff is not None:\n238:         sql += \" AND s.achieved_ts >= ?\"\n239:         params.append(cutoff)\n240:     if player:\n241:         escaped = (\n242:             player.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n243:         )\n244:         sql += \" AND u.username LIKE ? ESCAPE '\\\\'\"\n245:         params.append(f\"%{escaped}%\")\n246:     rows = get_db().execute(sql, params).fetchall()\n247: \n248:     best: dict[int, dict] = {}\n249:     for row in rows:\n250:         uid = row[\"uid\"]\n251:         entry = best.get(uid)\n252:         if (\n253:             entry is None\n254:             or row[\"score\"] > entry[\"score\"]\n255:             or (row[\"score\"] == entry[\"score\"] and row[\"achieved_ts\"] < entry[\"achieved_ts\"])\n256:         ):\n257:             best[uid] = {\n258:                 \"username\": row[\"username\"],\n259:                 \"score\": row[\"score\"],\n260:                 \"achieved_ts\": row[\"achieved_ts\"],\n261:             }\n262: \n263:     ordered = sorted(\n264:         best.items(), key=lambda kv: (-kv[1][\"score\"], kv[1][\"achieved_ts\"], kv[0])\n265:     )\n266:     items: list[dict] = []\n267:     for rank, (_uid, entry) in enumerate(ordered, start=1):\n268:         items.append(\n269:             {\n270:                 \"rank\": rank,\n271:                 \"player\": entry[\"username\"],\n272:                 \"score\": _as_number(entry[\"score\"]),\n273:                 \"achieved_at\": format_ts(entry[\"achieved_ts\"]),\n274:             }\n275:         )\n276:     return items\n277: \n278: \n279: def all_time_rank(username: str) -> int | None:\n280:     for item in compute_leaderboard(\"all\", None):\n281:         if item[\"player\"].lower() == username.lower():\n282:             return item[\"rank\"]\n283:     return None\n284: \n285: \n286: # --------------------------------------------------------------------------\n287: # auth\n288: # --------------------------------------------------------------------------\n289: \n290: \n291: @app.post(\"/api/auth/register\")\n292: def register():\n293:     data = _json_body()\n294:     if data is None:\n295:         return _err(\"invalid JSON body\", 400)\n296:     username = data.get(\"username\")\n297:     password = data.get(\"password\")\n298:     if not isinstance(username, str) or not isinstance(password, str):\n299:         return _err(\"username and password are required\", 400)\n300:     username = username.strip()\n301:     if not username or not password:\n302:         return _err(\"username and password are required\", 400)\n303:     if username.lower() == ADMIN_USERNAME:\n304:         return _err(\"username not available\", 409)\n305: \n306:     db = get_db()\n307:     existing = db.execute(\n308:         \"SELECT 1 FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n309:     ).fetchone()\n310:     if existing is not None:\n311:         return _err(\"username not available\", 409)\n312: \n313:     db.execute(\n314:         \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n315:         (username, generate_password_hash(password)),\n316:     )\n317:     db.commit()\n318:     return {\"username\": username}, 201\n319: \n320: \n321: @app.post(\"/api/auth/login\")\n322: def login():\n323:     data = _json_body()\n324:     if data is None:\n325:         return _err(\"invalid JSON body\", 400)\n326:     username = data.get(\"username\")\n327:     password = data.get(\"password\")\n328:     if not isinstance(username, str) or not isinstance(password, str):\n329:         return _err(\"username and password are required\", 400)\n330:     username = username.strip()\n331:     if not username or not password:\n332:         return _err(\"username and password are required\", 400)\n333: \n334:     if username.lower() == ADMIN_USERNAME and not ADMIN_PASSWORD:\n335:         return _err(\"admin sign-in is disabled\", 401)\n336: \n337:     db = get_db()\n338:     user = db.execute(\n339:         \"SELECT * FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n340:     ).fetchone()\n341:     if user is None or not check_password_hash(user[\"password_hash\"], password):\n342:         return _err(\"invalid credentials\", 401)\n343: \n344:     token = secrets.token_urlsafe(32)\n345:     db.execute(\n346:         \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n347:         (token, user[\"id\"], time.time()),\n348:     )\n349:     db.commit()\n350:     return {\"token\": token}, 200\n351: \n352: \n353: @app.get(\"/api/auth/me\")\n354: @login_required\n355: def me():\n356:     return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}, 200\n357: \n358: \n359: # --------------------------------------------------------------------------\n360: # leaderboard and scores\n361: # --------------------------------------------------------------------------\n362: \n363: \n364: @app.get(\"/api/leaderboard\")\n365: def leaderboard():\n366:     period = normalize_period(request.args.get(\"period\"))\n367:     player = request.args.get(\"player\") or None\n368:     if player is not None:\n369:         player = player.strip() or None\n370:     limit = _optional_positive_int(\"limit\")\n371: \n372:     items = compute_leaderboard(period, player)\n373:     total = len(items)\n374:     if limit is not None:\n375:         items = items[:limit]\n376:     return {\"items\": items, \"total\": total}, 200\n377: \n378: \n379: @app.post(\"/api/scores\")\n380: @login_required\n381: def submit_score():\n382:     data = _json_body()\n383:     if data is None:\n384:         return _err(\"invalid JSON body\", 400)\n385:     value = data.get(\"score\")\n386:     if isinstance(value, bool) or not isinstance(value, (int, float)):\n387:         return _err(\"score must be a number\", 400)\n388:     if not math.isfinite(float(value)):\n389:         return _err(\"score must be a number\", 400)\n390: \n391:     db = get_db()\n392:     user_id = g.user[\"id\"]\n393:     previous = db.execute(\n394:         \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n395:         (user_id,),\n396:     ).fetchone()[\"best\"]\n397:     now = time.time()\n398:     cursor = db.execute(\n399:         \"INSERT INTO scores (user_id, score, achieved_ts, is_hidden) VALUES (?, ?, ?, 0)\",\n400:         (user_id, float(value), now),\n401:     )\n402:     db.commit()\n403: \n404:     personal_best = previous is None or float(value) > float(previous)\n405:     row = db.execute(\n406:         \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n407:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n408:         (cursor.lastrowid,),\n409:     ).fetchone()\n410: \n411:     payload = score_to_dict(row)\n412:     payload[\"rank\"] = all_time_rank(g.user[\"username\"])\n413:     payload[\"personal_best\"] = personal_best\n414:     return payload, 200\n415: \n416: \n417: @app.get(\"/api/scores\")\n418: @login_required\n419: def my_scores():\n420:     db = get_db()\n421:     rows = db.execute(\n422:         \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n423:         \"FROM scores s JOIN users u ON u.id = s.user_id \"\n424:         \"WHERE s.user_id = ? ORDER BY s.achieved_ts DESC, s.id DESC\",\n425:         (g.user[\"id\"],),\n426:     ).fetchall()\n427:     best = db.execute(\n428:         \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n429:         (g.user[\"id\"],),\n430:     ).fetchone()[\"best\"]\n431:     return {\"items\": [score_to_dict(r) for r in rows], \"best_score\": _as_number(best)}, 200\n432: \n433: \n434: # --------------------------------------------------------------------------\n435: # admin\n436: # --------------------------------------------------------------------------\n437: \n438: \n439: @app.get(\"/api/admin/scores\")\n440: @admin_required\n441: def admin_scores():\n442:     db = get_db()\n443:     page = _optional_positive_int(\"page\") or 1\n444:     page_size = _optional_positive_int(\"page_size\") or 20\n445: \n446:     total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n447:     rows = db.execute(\n448:         \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n449:         \"FROM scores s JOIN users u ON u.id = s.user_id \"\n450:         \"ORDER BY s.achieved_ts DESC, s.id DESC LIMIT ? OFFSET ?\",\n451:         (page_size, (page - 1) * page_size),\n452:     ).fetchall()\n453:     return {\n454:         \"items\": [score_to_dict(r) for r in rows],\n455:         \"total\": total,\n456:         \"page\": page,\n457:         \"page_size\": page_size,\n458:     }, 200\n459: \n460: \n461: @app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n462: @admin_required\n463: def toggle_score(score_id: int):\n464:     db = get_db()\n465:     row = db.execute(\"SELECT id FROM scores WHERE id = ?\", (score_id,)).fetchone()\n466:     if row is None:\n467:         return _err(\"score not found\", 404)\n468:     db.execute(\n469:         \"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,)\n470:     )\n471:     db.commit()\n472:     updated = db.execute(\n473:         \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n474:         \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n475:         (score_id,),\n476:     ).fetchone()\n477:     return score_to_dict(updated), 200\n478: \n479: \n480: # --------------------------------------------------------------------------\n481: # frontend hosting\n482: # --------------------------------------------------------------------------\n483: \n484: \n485: @app.get(\"/api/health\")\n486: def health():\n487:     return {\"status\": \"ok\"}\n488: \n489: \n490: @app.get(\"/\")\n491: @app.get(\"/<path:path>\")\n492: def frontend(path: str = \"index.html\"):\n493:     if path.startswith(\"api/\"):\n494:         return _err(\"not found\", 404)\n495:     if (DIST / path).is_file():\n496:         return send_from_directory(DIST, path)\n497:     return send_from_directory(DIST, \"index.html\")\n498: \n499: \n500: @app.errorhandler(404)\n501: def not_found(_error):\n502:     if request.path.startswith(\"/api/\"):\n503:         return _err(\"not found\", 404)\n504:     return _err(\"not found\", 404)\n505: \n506: \n507: @app.errorhandler(405)\n508: def method_not_allowed(_error):\n509:     if request.path.startswith(\"/api/\"):\n510:         return _err(\"method not allowed\", 405)\n511:     return _err(\"method not allowed\", 405)\n\n(End of file - total 511 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: leaderboard API and frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport os\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = ROOT / \"data\"\nDB_PATH = DATA_DIR / \"leaderboard.db\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: leaderboard API and frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport os\nimport secrets\nimport sqlite3\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = ROOT / \"data\"\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\") or \"\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n    password_hash TEXT NOT NULL,\n    is_admin INTEGER NOT NULL DEFAULT 0\n);\n\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at REAL NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS scores (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    score REAL NOT NULL,\n    achieved_ts REAL NOT NULL,\n    is_hidden INTEGER NOT NULL DEFAULT 0\n);\n\nCREATE INDEX IF NOT EXISTS idx_scores_user ON scores(user_id);\nCREATE INDEX IF NOT EXISTS idx_scores_ts ON scores(achieved_ts);\n\"\"\"\n\nPERIOD_ALIASES = {\n    \"all\": \"all\",\n    \"alltime\": \"all\",\n    \"all_time\": \"all\",\n    \"all-time\": \"all\",\n    \"lifetime\": \"all\",\n    \"total\": \"all\",\n    \"ever\": \"all\",\n    \"overall\": \"all\",\n    \"global\": \"all\",\n    \"week\": \"week\",\n    \"weekly\": \"week\",\n    \"this_week\": \"week\",\n    \"this-week\": \"week\",\n    \"7d\": \"week\",\n    \"today\": \"today\",\n    \"daily\": \"today\",\n    \"day\": \"today\",\n    \"this_day\": \"today\",\n}\n\n\n# --------------------------------------------------------------------------\n# database\n# --------------------------------------------------------------------------\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    try:\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.execute(\"PRAGMA busy_timeout=30000\")\n        conn.executescript(SCHEMA)\n        if ADMIN_PASSWORD:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 1) \"\n                \"ON CONFLICT(username) DO UPDATE SET password_hash = excluded.password_hash, \"\n                \"is_admin = 1\",\n                (ADMIN_USERNAME, generate_password_hash(ADMIN_PASSWORD)),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    conn = g.get(\"db\")\n    if conn is None:\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA busy_timeout=30000\")\n        conn.execute(\"PRAGMA foreign_keys=ON\")\n        g.db = conn\n    return conn\n\n\n@app.teardown_appcontext\ndef _close_db(_exc: object) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ninit_db()\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\n\n\ndef _err(message: str, status: int):\n    return {\"error\": message}, status\n\n\ndef _json_body() -> dict | None:\n    data = request.get_json(silent=True, force=True)\n    return data if isinstance(data, dict) else None\n\n\ndef _as_number(value):\n    if value is None:\n        return None\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n    return value\n\n\ndef format_ts(ts: float) -> str:\n    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef score_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"score\": _as_number(row[\"score\"]),\n        \"achieved_at\": format_ts(row[\"achieved_ts\"]),\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n\n\ndef normalize_period(raw: str | None) -> str:\n    if raw is None or not raw.strip():\n        return \"all\"\n    return PERIOD_ALIASES.get(raw.strip().lower(), \"all\")\n\n\ndef period_cutoff(period: str) -> float | None:\n    now = datetime.now(timezone.utc)\n    if period == \"today\":\n        start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n        return start.timestamp()\n    if period == \"week\":\n        start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n        start = start - timedelta(days=start.weekday())\n        return start.timestamp()\n    return None\n\n\ndef _optional_positive_int(name: str) -> int | None:\n    raw = request.args.get(name)\n    if raw is None or str(raw).strip() == \"\":\n        return None\n    try:\n        value = int(str(raw).strip())\n    except (TypeError, ValueError):\n        return None\n    if value < 1:\n        return None\n    return value\n\n\ndef authenticate():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id, u.username, u.is_admin FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = authenticate()\n        if user is None:\n            return _err(\"authentication required\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef admin_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = authenticate()\n        if user is None:\n            return _err(\"authentication required\", 401)\n        if not user[\"is_admin\"]:\n            return _err(\"admin access required\", 403)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef compute_leaderboard(period: str, player: str | None) -> list[dict]:\n    cutoff = period_cutoff(period)\n    sql = (\n        \"SELECT s.score, s.achieved_ts, u.id AS uid, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.is_hidden = 0\"\n    )\n    params: list = []\n    if cutoff is not None:\n        sql += \" AND s.achieved_ts >= ?\"\n        params.append(cutoff)\n    if player:\n        escaped = (\n            player.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        )\n        sql += \" AND u.username LIKE ? ESCAPE '\\\\'\"\n        params.append(f\"%{escaped}%\")\n    rows = get_db().execute(sql, params).fetchall()\n\n    best: dict[int, dict] = {}\n    for row in rows:\n        uid = row[\"uid\"]\n        entry = best.get(uid)\n        if (\n            entry is None\n            or row[\"score\"] > entry[\"score\"]\n            or (row[\"score\"] == entry[\"score\"] and row[\"achieved_ts\"] < entry[\"achieved_ts\"])\n        ):\n            best[uid] = {\n                \"username\": row[\"username\"],\n                \"score\": row[\"score\"],\n                \"achieved_ts\": row[\"achieved_ts\"],\n            }\n\n    ordered = sorted(\n        best.items(), key=lambda kv: (-kv[1][\"score\"], kv[1][\"achieved_ts\"], kv[0])\n    )\n    items: list[dict] = []\n    for rank, (_uid, entry) in enumerate(ordered, start=1):\n        items.append(\n            {\n                \"rank\": rank,\n                \"player\": entry[\"username\"],\n                \"score\": _as_number(entry[\"score\"]),\n                \"achieved_at\": format_ts(entry[\"achieved_ts\"]),\n            }\n        )\n    return items\n\n\ndef all_time_rank(username: str) -> int | None:\n    for item in compute_leaderboard(\"all\", None):\n        if item[\"player\"].lower() == username.lower():\n            return item[\"rank\"]\n    return None\n\n\n# --------------------------------------------------------------------------\n# auth\n# --------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _json_body()\n    if data is None:\n        return _err(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return _err(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return _err(\"username and password are required\", 400)\n    if username.lower() == ADMIN_USERNAME:\n        return _err(\"username not available\", 409)\n\n    db = get_db()\n    existing = db.execute(\n        \"SELECT 1 FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return _err(\"username not available\", 409)\n\n    db.execute(\n        \"INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, 0)\",\n        (username, generate_password_hash(password)),\n    )\n    db.commit()\n    return {\"username\": username}, 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _json_body()\n    if data is None:\n        return _err(\"invalid JSON body\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return _err(\"username and password are required\", 400)\n    username = username.strip()\n    if not username or not password:\n        return _err(\"username and password are required\", 400)\n\n    if username.lower() == ADMIN_USERNAME and not ADMIN_PASSWORD:\n        return _err(\"admin sign-in is disabled\", 401)\n\n    db = get_db()\n    user = db.execute(\n        \"SELECT * FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n    ).fetchone()\n    if user is None or not check_password_hash(user[\"password_hash\"], password):\n        return _err(\"invalid credentials\", 401)\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user[\"id\"], time.time()),\n    )\n    db.commit()\n    return {\"token\": token}, 200\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return {\"username\": g.user[\"username\"], \"is_admin\": bool(g.user[\"is_admin\"])}, 200\n\n\n# --------------------------------------------------------------------------\n# leaderboard and scores\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    period = normalize_period(request.args.get(\"period\"))\n    player = request.args.get(\"player\") or None\n    if player is not None:\n        player = player.strip() or None\n    limit = _optional_positive_int(\"limit\")\n\n    items = compute_leaderboard(period, player)\n    total = len(items)\n    if limit is not None:\n        items = items[:limit]\n    return {\"items\": items, \"total\": total}, 200\n\n\n@app.post(\"/api/scores\")\n@login_required\ndef submit_score():\n    data = _json_body()\n    if data is None:\n        return _err(\"invalid JSON body\", 400)\n    value = data.get(\"score\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return _err(\"score must be a number\", 400)\n    if not math.isfinite(float(value)):\n        return _err(\"score must be a number\", 400)\n\n    db = get_db()\n    user_id = g.user[\"id\"]\n    previous = db.execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n        (user_id,),\n    ).fetchone()[\"best\"]\n    now = time.time()\n    cursor = db.execute(\n        \"INSERT INTO scores (user_id, score, achieved_ts, is_hidden) VALUES (?, ?, ?, 0)\",\n        (user_id, float(value), now),\n    )\n    db.commit()\n\n    personal_best = previous is None or float(value) > float(previous)\n    row = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n\n    payload = score_to_dict(row)\n    payload[\"rank\"] = all_time_rank(g.user[\"username\"])\n    payload[\"personal_best\"] = personal_best\n    return payload, 200\n\n\n@app.get(\"/api/scores\")\n@login_required\ndef my_scores():\n    db = get_db()\n    rows = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"WHERE s.user_id = ? ORDER BY s.achieved_ts DESC, s.id DESC\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    best = db.execute(\n        \"SELECT MAX(score) AS best FROM scores WHERE user_id = ? AND is_hidden = 0\",\n        (g.user[\"id\"],),\n    ).fetchone()[\"best\"]\n    return {\"items\": [score_to_dict(r) for r in rows], \"best_score\": _as_number(best)}, 200\n\n\n# --------------------------------------------------------------------------\n# admin\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/admin/scores\")\n@admin_required\ndef admin_scores():\n    db = get_db()\n    page = _optional_positive_int(\"page\") or 1\n    page_size = _optional_positive_int(\"page_size\") or 20\n\n    total = db.execute(\"SELECT COUNT(*) AS n FROM scores\").fetchone()[\"n\"]\n    rows = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id \"\n        \"ORDER BY s.achieved_ts DESC, s.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return {\n        \"items\": [score_to_dict(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }, 200\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\n@admin_required\ndef toggle_score(score_id: int):\n    db = get_db()\n    row = db.execute(\"SELECT id FROM scores WHERE id = ?\", (score_id,)).fetchone()\n    if row is None:\n        return _err(\"score not found\", 404)\n    db.execute(\n        \"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,)\n    )\n    db.commit()\n    updated = db.execute(\n        \"SELECT s.id, s.score, s.achieved_ts, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.user_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    return score_to_dict(updated), 200\n\n\n# --------------------------------------------------------------------------\n# frontend hosting\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return _err(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if request.path.startswith(\"/api/\"):\n        return _err(\"not found\", 404)\n    return _err(\"not found\", 404)\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_error):\n    if request.path.startswith(\"/api/\"):\n        return _err(\"method not allowed\", 405)\n    return _err(\"method not allowed\", 405)","lineStart":1,"lineEnd":511,"totalLines":511,"truncated":false}},"title":"backend/app.py","time":{"start":1794371771707,"end":1794371771784}},"id":"prt_1c8e45d34001f0chb2XGbKZMtV","sessionID":"ses_e3744480affex77CITZAUDwa8q","messageID":"msg_1c8e3fab4001Uodf6e0dR24z80"}}
