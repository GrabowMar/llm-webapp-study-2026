{"type":"tool_use","timestamp":1794370469984,"sessionID":"ses_e3744480affex77CITZAUDwa8q","part":{"type":"tool","tool":"write","callID":"call_af7e95024bb2419292cbe5e0","state":{"status":"completed","input":{"content":"\"\"\"Ad-hoc API smoke test for the leaderboard backend (temporary).\"\"\"\n\nimport json\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\n\n\ndef call(method, path, body=None, token=None, expect=None):\n    req = urllib.request.Request(BASE + path, method=method)\n    req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    data = None if body is None else json.dumps(body).encode()\n    try:\n        with urllib.request.urlopen(req, data=data, timeout=10) as resp:\n            status = resp.status\n            raw = resp.read().decode()\n    except urllib.error.HTTPError as e:\n        status = e.code\n        raw = e.read().decode()\n    try:\n        parsed = json.loads(raw) if raw else None\n    except json.JSONDecodeError:\n        parsed = raw\n    label = f\"{method} {path} -> {status}\"\n    if expect is not None:\n        ok = status in expect if isinstance(expect, (list, tuple)) else status == expect\n        print((\"PASS \" if ok else \"FAIL \") + label, json.dumps(parsed)[:160])\n        if not ok:\n            raise SystemExit(f\"expected {expect}, got {status}: {parsed!r}\")\n    else:\n        print(\"     \" + label, json.dumps(parsed)[:160])\n    return status, parsed\n\n\ncall(\"GET\", \"/api/health\", expect=200)\n\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw1\"}, expect=201)\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw1\"}, expect=409)\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw2\"}, expect=201)\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw3\"}, expect=201)\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"x\"}, expect=409)\ncall(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"}, expect=400)\n\n_, alice = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw1\"}, expect=200)\n_, bob = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw2\"}, expect=200)\n_, carol = call(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw3\"}, expect=200)\nat, bt, ct = alice[\"token\"], bob[\"token\"], carol[\"token\"]\ncall(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ncall(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"whatever\"}, expect=401)\n\ncall(\"GET\", \"/api/auth/me\", token=at, expect=200)\ncall(\"GET\", \"/api/auth/me\", expect=401)\ncall(\"GET\", \"/api/auth/me\", token=\"bogus\", expect=401)\n\ncall(\"POST\", \"/api/scores\", {\"score\": 10}, expect=401)\ncall(\"GET\", \"/api/scores\", expect=401)\n\n_, s1 = call(\"POST\", \"/api/scores\", {\"score\": 100}, token=at, expect=200)\nassert s1[\"personal_best\"] is True and s1[\"rank\"] == 1, s1\n_, s2 = call(\"POST\", \"/api/scores\", {\"score\": 50}, token=at, expect=200)\nassert s2[\"personal_best\"] is False and s2[\"rank\"] >= 1, s2\n_, s3 = call(\"POST\", \"/api/scores\", {\"score\": 250}, token=at, expect=200)\nassert s3[\"personal_best\"] is True and s3[\"rank\"] == 1, s3\n_, s4 = call(\"POST\", \"/api/scores\", {\"score\": 300}, token=bt, expect=200)\nassert s4[\"personal_best\"] is True and s4[\"rank\"] == 1, s4\n_, s5 = call(\"POST\", \"/api/scores\", {\"score\": 120}, token=ct, expect=200)\nassert s5[\"rank\"] == 2, s5\ncall(\"POST\", \"/api/scores\", {\"score\": \"abc\"}, token=at, expect=400)\ncall(\"POST\", \"/api/scores\", {}, token=at, expect=400)\n\nfor key in (\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\", \"rank\", \"personal_best\"):\n    assert key in s3, key\nassert s3[\"player\"] == \"alice\"\n\n_, mine = call(\"GET\", \"/api/scores\", token=at, expect=200)\nassert set(mine) == {\"items\", \"best_score\"}, mine.keys()\nassert mine[\"best_score\"] == 250, mine\nassert [i[\"score\"] for i in mine[\"items\"]] == [250, 100, 50], mine\nassert all(i[\"player\"] == \"alice\" for i in mine[\"items\"])\nfor i in mine[\"items\"]:\n    assert set(i) == {\"id\", \"score\", \"achieved_at\", \"is_hidden\", \"player\"}, i.keys()\n\n_, lb = call(\"GET\", \"/api/leaderboard\", expect=200)\nassert set(lb) == {\"items\", \"total\"}, lb.keys()\nassert lb[\"total\"] == 3\nassert [(i[\"player\"], i[\"score\"]) for i in lb[\"items\"]] == [\n    (\"bob\", 300),\n    (\"alice\", 250),\n    (\"carol\", 120),\n], lb\nassert [i[\"rank\"] for i in lb[\"items\"]] == [1, 2, 3]\nfor i in lb[\"items\"]:\n    assert set(i) == {\"rank\", \"player\", \"score\", \"achieved_at\"}, i.keys()\n\nfor p in (\"all\", \"week\", \"today\", \"alltime\", \"this_week\", \"daily\", \"bogus\"):\n    call(\"GET\", f\"/api/leaderboard?period={p}\", expect=200)\n\n_, lb2 = call(\"GET\", \"/api/leaderboard?limit=2\", expect=200)\nassert len(lb2[\"items\"]) == 2 and lb2[\"total\"] == 3, lb2\n_, lb3 = call(\"GET\", \"/api/leaderboard?player=ali\", expect=200)\nassert lb3[\"total\"] == 1 and lb3[\"items\"][0][\"player\"] == \"alice\", lb3\n_, lb4 = call(\"GET\", \"/api/leaderboard?period=week&limit=10&player=alice\", expect=200)\nassert lb4[\"total\"] == 1\n\ncall(\"GET\", \"/api/admin/scores\", expect=401)\ncall(\"GET\", \"/api/admin/scores\", token=at, expect=403)\ncall(\"POST\", f\"/api/admin/scores/{s1['id']}/toggle\", token=at, expect=403)\n\ncall(\"GET\", \"/api/nope\", expect=404)\ncall(\"POST\", \"/api/nope\", expect=404)\n\nprint(\"ALL BASIC TESTS PASSED\")\n","filePath":"/workspace/.smoke_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.smoke_test.py","exists":false,"truncated":false},"title":".