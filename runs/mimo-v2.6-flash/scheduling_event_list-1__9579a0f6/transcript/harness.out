{"type":"tool_use","timestamp":1794354640647,"sessionID":"ses_e38469a15ffe36mf3F2otgrqwy","part":{"type":"tool","tool":"read","callID":"call_5c3c4156885a4580a0b48a2f","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import json\n6: import os\n7: import secrets\n8: import sqlite3\n9: from datetime import datetime, timezone\n10: from functools import wraps\n11: from pathlib import Path\n12: \n13: from flask import Flask, g, jsonify, request, send_from_directory\n14: from werkzeug.security import check_password_hash, generate_password_hash\n15: \n16: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n17: DATA_DIR = Path(os.environ.get(\"DATA_DIR\") or \"data\")\n18: DB_FILE = DATA_DIR / \"calendar.db\"\n19: UTC = timezone.utc\n20: \n21: SCHEMA = \"\"\"\n22: CREATE TABLE IF NOT EXISTS users (\n23:     username TEXT PRIMARY KEY,\n24:     password_hash TEXT NOT NULL,\n25:     created_at TEXT NOT NULL\n26: );\n27: CREATE TABLE IF NOT EXISTS tokens (\n28:     token TEXT PRIMARY KEY,\n29:     username TEXT NOT NULL,\n30:     created_at TEXT NOT NULL\n31: );\n32: CREATE TABLE IF NOT EXISTS events (\n33:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n34:     title TEXT NOT NULL,\n35:     description TEXT,\n36:     location TEXT,\n37:     start_time REAL NOT NULL,\n38:     end_time REAL NOT NULL,\n39:     created_at REAL NOT NULL,\n40:     created_by TEXT NOT NULL\n41: );\n42: CREATE INDEX IF NOT EXISTS idx_events_start ON events (start_time);\n43: \"\"\"\n44: \n45: app = Flask(__name__, static_folder=None)\n46: \n47: \n48: def connect() -> sqlite3.Connection:\n49:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n50:     conn = sqlite3.connect(DB_FILE, timeout=30)\n51:     conn.row_factory = sqlite3.Row\n52:     conn.execute(\"PRAGMA journal_mode=WAL\")\n53:     conn.execute(\"PRAGMA foreign_keys=ON\")\n54:     return conn\n55: \n56: \n57: def init_db() -> None:\n58:     conn = connect()\n59:     try:\n60:         conn.executescript(SCHEMA)\n61:         conn.commit()\n62:     finally:\n63:         conn.close()\n64: \n65: \n66: init_db()\n67: \n68: \n69: @app.teardown_appcontext\n70: def _close_db(_exc) -> None:\n71:     conn = g.pop(\"db\", None)\n72:     if conn is not None:\n73:         conn.close()\n74: \n75: \n76: def db() -> sqlite3.Connection:\n77:     if \"db\" not in g:\n78:         g.db = connect()\n79:     return g.db\n80: \n81: \n82: # ---------------------------------------------------------------------------\n83: # helpers\n84: # ---------------------------------------------------------------------------\n85: \n86: \n87: def api_error(message: str, status: int, field: str | None = None):\n88:     payload: dict = {\"error\": message}\n89:     if field is not None:\n90:         payload[\"field\"] = field\n91:     return jsonify(payload), status\n92: \n93: \n94: def _body() -> dict:\n95:     data = request.get_json(silent=True)\n96:     if data is None:\n97:         raw = request.get_data(as_text=True).strip()\n98:         if raw:\n99:             try:\n100:                 parsed = json.loads(raw)\n101:             except ValueError:\n102:                 parsed = None\n103:             if isinstance(parsed, dict):\n104:                 data = parsed\n105:     return data if isinstance(data, dict) else {}\n106: \n107: \n108: def _iso(epoch: float) -> str:\n109:     return datetime.fromtimestamp(epoch, UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n110: \n111: \n112: def _now_epoch() -> float:\n113:     return float(int(datetime.now(UTC).timestamp()))\n114: \n115: \n116: def parse_datetime(value, field: str):\n117:     \"\"\"Parse an incoming date-time; naive values are taken as UTC.\"\"\"\n118:     if not isinstance(value, str) or not value.strip():\n119:         return None, api_error(f\"{field} is required\", 400, field)\n120:     text = value.strip()\n121:     if text.endswith(\"z\"):\n122:         text = text[:-1] + \"Z\"\n123:     try:\n124:         parsed = datetime.fromisoformat(text)\n125:     except ValueError:\n126:         return None, api_error(\n127:             f\"{field} must be a valid ISO 8601 date-time\", 400, field\n128:         )\n129:     if parsed.tzinfo is None:\n130:         parsed = parsed.replace(tzinfo=UTC)\n131:     return parsed.astimezone(UTC), None\n132: \n133: \n134: def parse_date_bound(value, field: str):\n135:     \"\"\"Parse a start_date/end_date query value.\n136: \n137:     Returns ``(epoch, is_date_only, error_response)``.\n138:     \"\"\"\n139:     if not isinstance(value, str) or not value.strip():\n140:         return None, False, api_error(f\"{field} is required\", 400, field)\n141:     text = value.strip()\n142:     date_only = \"T\" not in text and \" \" not in text\n143:     dt, err = parse_datetime(text, field)\n144:     if err is not None:\n145:         return None, False, err\n146:     return dt.timestamp(), date_only, None\n147: \n148: \n149: def validate_event(data: dict):\n150:     \"\"\"Validate an event payload.\n151: \n152:     Returns ``(fields, error_response)``; ``fields`` is ``None`` on error.\n153:     \"\"\"\n154:     title = data.get(\"title\")\n155:     if not isinstance(title, str) or not title.strip():\n156:         return None, api_error(\"title is required\", 400, \"title\")\n157: \n158:     start, err = parse_datetime(data.get(\"start_time\"), \"start_time\")\n159:     if err is not None:\n160:         return None, err\n161:     end, err = parse_datetime(data.get(\"end_time\"), \"end_time\")\n162:     if err is not None:\n163:         return None, err\n164:     if end < start:\n165:         return None, api_error(\n166:             \"end_time must not be before start_time\", 400, \"end_time\"\n167:         )\n168: \n169:     description = data.get(\"description\")\n170:     if description is not None and not isinstance(description, str):\n171:         return None, api_error(\"description must be a string\", 400, \"description\")\n172:     location = data.get(\"location\")\n173:     if location is not None and not isinstance(location, str):\n174:         return None, api_error(\"location must be a string\", 400, \"location\")\n175: \n176:     return {\n177:         \"title\": title,\n178:         \"description\": description,\n179:         \"location\": location,\n180:         \"start_time\": start.timestamp(),\n181:         \"end_time\": end.timestamp(),\n182:     }, None\n183: \n184: \n185: def event_json(row: sqlite3.Row) -> dict:\n186:     return {\n187:         \"id\": row[\"id\"],\n188:         \"title\": row[\"title\"],\n189:         \"description\": row[\"description\"],\n190:         \"location\": row[\"location\"],\n191:         \"start_time\": _iso(row[\"start_time\"]),\n192:         \"end_time\": _iso(row[\"end_time\"]),\n193:         \"created_at\": _iso(row[\"created_at\"]),\n194:         \"created_by\": row[\"created_by\"],\n195:     }\n196: \n197: \n198: def current_user() -> str | None:\n199:     header = request.headers.get(\"Authorization\", \"\")\n200:     parts = header.split(None, 1)\n201:     if len(parts) != 2 or parts[0].lower() != \"bearer\":\n202:         return None\n203:     token = parts[1].strip()\n204:     if not token:\n205:         return None\n206:     row = db().execute(\n207:         \"SELECT username FROM tokens WHERE token = ?\", (token,)\n208:     ).fetchone()\n209:     return row[\"username\"] if row is not None else None\n210: \n211: \n212: def login_required(view):\n213:     @wraps(view)\n214:     def wrapper(*args, **kwargs):\n215:         username = current_user()\n216:         if username is None:\n217:             return api_error(\"authentication required\", 401)\n218:         g.username = username\n219:         return view(*args, **kwargs)\n220: \n221:     return wrapper\n222: \n223: \n224: # ---------------------------------------------------------------------------\n225: # auth\n226: # ---------------------------------------------------------------------------\n227: \n228: \n229: @app.post(\"/api/auth/register\")\n230: def register():\n231:     data = _body()\n232:     username = data.get(\"username\")\n233:     password = data.get(\"password\")\n234:     if not isinstance(username, str) or not username.strip():\n235:         return api_error(\"username is required\", 400, \"username\")\n236:     if not isinstance(password, str) or password == \"\":\n237:         return api_error(\"password is required\", 400, \"password\")\n238:     username = username.strip()\n239:     existing = db().execute(\n240:         \"SELECT 1 FROM users WHERE username = ?\", (username,)\n241:     ).fetchone()\n242:     if existing is not None:\n243:         return api_error(\"username already taken\", 409, \"username\")\n244:     db().execute(\n245:         \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n246:         (username, generate_password_hash(password), _iso(_now_epoch())),\n247:     )\n248:     db().commit()\n249:     return jsonify({\"username\": username}), 201\n250: \n251: \n252: @app.post(\"/api/auth/login\")\n253: def login():\n254:     data = _body()\n255:     username = data.get(\"username\")\n256:     password = data.get(\"password\")\n257:     if not isinstance(username, str) or not username.strip():\n258:         return api_error(\"username is required\", 400, \"username\")\n259:     if not isinstance(password, str) or password == \"\":\n260:         return api_error(\"password is required\", 400, \"password\")\n261:     username = username.strip()\n262:     row = db().execute(\n263:         \"SELECT password_hash FROM users WHERE username = ?\", (username,)\n264:     ).fetchone()\n265:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n266:         return api_error(\"invalid username or password\", 401)\n267:     token = secrets.token_urlsafe(32)\n268:     db().execute(\n269:         \"INSERT INTO tokens (token, username, created_at) VALUES (?, ?, ?)\",\n270:         (token, username, _iso(_now_epoch())),\n271:     )\n272:     db().commit()\n273:     return jsonify({\"token\": token})\n274: \n275: \n276: # ---------------------------------------------------------------------------\n277: # events\n278: # ---------------------------------------------------------------------------\n279: \n280: \n281: @app.get(\"/api/events\")\n282: def list_events():\n283:     clauses: list[str] = []\n284:     params: list[float] = []\n285: \n286:     start_date = request.args.get(\"start_date\")\n287:     if start_date is not None:\n288:         lower, _date_only, err = parse_date_bound(start_date, \"start_date\")\n289:         if err is not None:\n290:             return err\n291:         clauses.append(\"end_time >= ?\")\n292:         params.append(lower)\n293: \n294:     end_date = request.args.get(\"end_date\")\n295:     if end_date is not None:\n296:         upper, date_only, err = parse_date_bound(end_date, \"end_date\")\n297:         if err is not None:\n298:             return err\n299:         if date_only:\n300:             # a plain date covers the whole day\n301:             upper += 86400\n302:         clauses.append(\"start_time < ?\")\n303:         params.append(upper)\n304: \n305:     sql = \"SELECT * FROM events\"\n306:     if clauses:\n307:         sql += \" WHERE \" + \" AND \".join(clauses)\n308:     sql += \" ORDER BY start_time ASC, id ASC\"\n309:     rows = db().execute(sql, params).fetchall()\n310:     items = [event_json(row) for row in rows]\n311:     return jsonify({\"items\": items, \"total\": len(items)})\n312: \n313: \n314: @app.get(\"/api/events/<int:event_id>\")\n315: def get_event(event_id: int):\n316:     row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n317:     if row is None:\n318:         return api_error(\"event not found\", 404)\n319:     return jsonify(event_json(row))\n320: \n321: \n322: @app.post(\"/api/events\")\n323: @login_required\n324: def create_event():\n325:     fields, err = validate_event(_body())\n326:     if err is not None:\n327:         return err\n328:     cursor = db().execute(\n329:         \"INSERT INTO events (title, description, location, start_time, end_time,\"\n330:         \" created_at, created_by) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n331:         (\n332:             fields[\"title\"],\n333:             fields[\"description\"],\n334:             fields[\"location\"],\n335:             fields[\"start_time\"],\n336:             fields[\"end_time\"],\n337:             _now_epoch(),\n338:             g.username,\n339:         ),\n340:     )\n341:     db().commit()\n342:     row = db().execute(\n343:         \"SELECT * FROM events WHERE id = ?\", (cursor.lastrowid,)\n344:     ).fetchone()\n345:     return jsonify(event_json(row)), 201\n346: \n347: \n348: @app.put(\"/api/events/<int:event_id>\")\n349: @login_required\n350: def update_event(event_id: int):\n351:     row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n352:     if row is None:\n353:         return api_error(\"event not found\", 404)\n354:     fields, err = validate_event(_body())\n355:     if err is not None:\n356:         return err\n357:     db().execute(\n358:         \"UPDATE events SET title = ?, description = ?, location = ?,\"\n359:         \" start_time = ?, end_time = ? WHERE id = ?\",\n360:         (\n361:             fields[\"title\"],\n362:             fields[\"description\"],\n363:             fields[\"location\"],\n364:             fields[\"start_time\"],\n365:             fields[\"end_time\"],\n366:             event_id,\n367:         ),\n368:     )\n369:     db().commit()\n370:     updated = db().execute(\n371:         \"SELECT * FROM events WHERE id = ?\", (event_id,)\n372:     ).fetchone()\n373:     return jsonify(event_json(updated))\n374: \n375: \n376: @app.delete(\"/api/events/<int:event_id>\")\n377: @login_required\n378: def delete_event(event_id: int):\n379:     row = db().execute(\"SELECT id FROM events WHERE id = ?\", (event_id,)).fetchone()\n380:     if row is None:\n381:         return api_error(\"event not found\", 404)\n382:     db().execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n383:     db().commit()\n384:     return \"\", 204\n385: \n386: \n387: # ---------------------------------------------------------------------------\n388: # health + frontend\n389: # ---------------------------------------------------------------------------\n390: \n391: \n392: @app.after_request\n393: def _cors(response):\n394:     if request.path.startswith(\"/api/\"):\n395:         response.headers[\"Access-Control-Allow-Origin\"] = \"*\"\n396:         response.headers[\"Access-Control-Allow-Methods\"] = (\n397:             \"GET, POST, PUT, DELETE, OPTIONS\"\n398:         )\n399:         response.headers[\"Access-Control-Allow-Headers\"] = (\n400:             \"Authorization, Content-Type\"\n401:         )\n402:     return response\n403: \n404: \n405: @app.get(\"/api/health\")\n406: def health():\n407:     return {\"status\": \"ok\"}\n408: \n409: \n410: def _wants_json() -> bool:\n411:     return request.path.startswith(\"/api/\")\n412: \n413: \n414: @app.errorhandler(404)\n415: def not_found(_error):\n416:     if _wants_json():\n417:         return api_error(\"not found\", 404)\n418:     index = DIST / \"index.html\"\n419:     if index.is_file():\n420:         return send_from_directory(DIST, \"index.html\")\n421:     return api_error(\"frontend build not found\", 404)\n422: \n423: \n424: @app.errorhandler(405)\n425: def method_not_allowed(_error):\n426:     if _wants_json():\n427:         return api_error(\"method not allowed\", 405)\n428:     return api_error(\"method not allowed\", 405)\n429: \n430: \n431: @app.get(\"/\")\n432: @app.get(\"/<path:path>\")\n433: def frontend(path: str = \"index.html\"):\n434:     if path.startswith(\"api/\"):\n435:         return api_error(\"not found\", 404)\n436:     target = DIST / path\n437:     if path != \"index.html\" and target.is_file():\n438:         return send_from_directory(DIST, path)\n439:     index = DIST / \"index.html\"\n440:     if index.is_file():\n441:         return send_from_directory(DIST, \"index.html\")\n442:     return api_error(\"frontend build not found\", 404)\n\n(End of file - total 442 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or \"data\")\nDB_FILE = DATA_DIR / \"calendar.db\"\nUTC = timezone.utc\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or \"data\")\nDB_FILE = DATA_DIR / \"calendar.db\"\nUTC = timezone.utc\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    username TEXT PRIMARY KEY,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    username TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS events (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    description TEXT,\n    location TEXT,\n    start_time REAL NOT NULL,\n    end_time REAL NOT NULL,\n    created_at REAL NOT NULL,\n    created_by TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_events_start ON events (start_time);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_FILE, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA journal_mode=WAL\")\n    conn.execute(\"PRAGMA foreign_keys=ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\n@app.teardown_appcontext\ndef _close_db(_exc) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n# ---------------------------------------------------------------------------\n# helpers\n# ---------------------------------------------------------------------------\n\n\ndef api_error(message: str, status: int, field: str | None = None):\n    payload: dict = {\"error\": message}\n    if field is not None:\n        payload[\"field\"] = field\n    return jsonify(payload), status\n\n\ndef _body() -> dict:\n    data = request.get_json(silent=True)\n    if data is None:\n        raw = request.get_data(as_text=True).strip()\n        if raw:\n            try:\n                parsed = json.loads(raw)\n            except ValueError:\n                parsed = None\n            if isinstance(parsed, dict):\n                data = parsed\n    return data if isinstance(data, dict) else {}\n\n\ndef _iso(epoch: float) -> str:\n    return datetime.fromtimestamp(epoch, UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _now_epoch() -> float:\n    return float(int(datetime.now(UTC).timestamp()))\n\n\ndef parse_datetime(value, field: str):\n    \"\"\"Parse an incoming date-time; naive values are taken as UTC.\"\"\"\n    if not isinstance(value, str) or not value.strip():\n        return None, api_error(f\"{field} is required\", 400, field)\n    text = value.strip()\n    if text.endswith(\"z\"):\n        text = text[:-1] + \"Z\"\n    try:\n        parsed = datetime.fromisoformat(text)\n    except ValueError:\n        return None, api_error(\n            f\"{field} must be a valid ISO 8601 date-time\", 400, field\n        )\n    if parsed.tzinfo is None:\n        parsed = parsed.replace(tzinfo=UTC)\n    return parsed.astimezone(UTC), None\n\n\ndef parse_date_bound(value, field: str):\n    \"\"\"Parse a start_date/end_date query value.\n\n    Returns ``(epoch, is_date_only, error_response)``.\n    \"\"\"\n    if not isinstance(value, str) or not value.strip():\n        return None, False, api_error(f\"{field} is required\", 400, field)\n    text = value.strip()\n    date_only = \"T\" not in text and \" \" not in text\n    dt, err = parse_datetime(text, field)\n    if err is not None:\n        return None, False, err\n    return dt.timestamp(), date_only, None\n\n\ndef validate_event(data: dict):\n    \"\"\"Validate an event payload.\n\n    Returns ``(fields, error_response)``; ``fields`` is ``None`` on error.\n    \"\"\"\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        return None, api_error(\"title is required\", 400, \"title\")\n\n    start, err = parse_datetime(data.get(\"start_time\"), \"start_time\")\n    if err is not None:\n        return None, err\n    end, err = parse_datetime(data.get(\"end_time\"), \"end_time\")\n    if err is not None:\n        return None, err\n    if end < start:\n        return None, api_error(\n            \"end_time must not be before start_time\", 400, \"end_time\"\n        )\n\n    description = data.get(\"description\")\n    if description is not None and not isinstance(description, str):\n        return None, api_error(\"description must be a string\", 400, \"description\")\n    location = data.get(\"location\")\n    if location is not None and not isinstance(location, str):\n        return None, api_error(\"location must be a string\", 400, \"location\")\n\n    return {\n        \"title\": title,\n        \"description\": description,\n        \"location\": location,\n        \"start_time\": start.timestamp(),\n        \"end_time\": end.timestamp(),\n    }, None\n\n\ndef event_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": _iso(row[\"start_time\"]),\n        \"end_time\": _iso(row[\"end_time\"]),\n        \"created_at\": _iso(row[\"created_at\"]),\n        \"created_by\": row[\"created_by\"],\n    }\n\n\ndef current_user() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT username FROM tokens WHERE token = ?\", (token,)\n    ).fetchone()\n    return row[\"username\"] if row is not None else None\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        username = current_user()\n        if username is None:\n            return api_error(\"authentication required\", 401)\n        g.username = username\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\n# ---------------------------------------------------------------------------\n# auth\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return api_error(\"username is required\", 400, \"username\")\n    if not isinstance(password, str) or password == \"\":\n        return api_error(\"password is required\", 400, \"password\")\n    username = username.strip()\n    existing = db().execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return api_error(\"username already taken\", 409, \"username\")\n    db().execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), _iso(_now_epoch())),\n    )\n    db().commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return api_error(\"username is required\", 400, \"username\")\n    if not isinstance(password, str) or password == \"\":\n        return api_error(\"password is required\", 400, \"password\")\n    username = username.strip()\n    row = db().execute(\n        \"SELECT password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return api_error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db().execute(\n        \"INSERT INTO tokens (token, username, created_at) VALUES (?, ?, ?)\",\n        (token, username, _iso(_now_epoch())),\n    )\n    db().commit()\n    return jsonify({\"token\": token})\n\n\n# ---------------------------------------------------------------------------\n# events\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    clauses: list[str] = []\n    params: list[float] = []\n\n    start_date = request.args.get(\"start_date\")\n    if start_date is not None:\n        lower, _date_only, err = parse_date_bound(start_date, \"start_date\")\n        if err is not None:\n            return err\n        clauses.append(\"end_time >= ?\")\n        params.append(lower)\n\n    end_date = request.args.get(\"end_date\")\n    if end_date is not None:\n        upper, date_only, err = parse_date_bound(end_date, \"end_date\")\n        if err is not None:\n            return err\n        if date_only:\n            # a plain date covers the whole day\n            upper += 86400\n        clauses.append(\"start_time < ?\")\n        params.append(upper)\n\n    sql = \"SELECT * FROM events\"\n    if clauses:\n        sql += \" WHERE \" + \" AND \".join(clauses)\n    sql += \" ORDER BY start_time ASC, id ASC\"\n    rows = db().execute(sql, params).fetchall()\n    items = [event_json(row) for row in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id: int):\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return api_error(\"event not found\", 404)\n    return jsonify(event_json(row))\n\n\n@app.post(\"/api/events\")\n@login_required\ndef create_event():\n    fields, err = validate_event(_body())\n    if err is not None:\n        return err\n    cursor = db().execute(\n        \"INSERT INTO events (title, description, location, start_time, end_time,\"\n        \" created_at, created_by) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            _now_epoch(),\n            g.username,\n        ),\n    )\n    db().commit()\n    row = db().execute(\n        \"SELECT * FROM events WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(event_json(row)), 201\n\n\n@app.put(\"/api/events/<int:event_id>\")\n@login_required\ndef update_event(event_id: int):\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return api_error(\"event not found\", 404)\n    fields, err = validate_event(_body())\n    if err is not None:\n        return err\n    db().execute(\n        \"UPDATE events SET title = ?, description = ?, location = ?,\"\n        \" start_time = ?, end_time = ? WHERE id = ?\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            event_id,\n        ),\n    )\n    db().commit()\n    updated = db().execute(\n        \"SELECT * FROM events WHERE id = ?\", (event_id,)\n    ).fetchone()\n    return jsonify(event_json(updated))\n\n\n@app.delete(\"/api/events/<int:event_id>\")\n@login_required\ndef delete_event(event_id: int):\n    row = db().execute(\"SELECT id FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return api_error(\"event not found\", 404)\n    db().execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    db().commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# health + frontend\n# ---------------------------------------------------------------------------\n\n\n@app.after_request\ndef _cors(response):\n    if request.path.startswith(\"/api/\"):\n        response.headers[\"Access-Control-Allow-Origin\"] = \"*\"\n        response.headers[\"Access-Control-Allow-Methods\"] = (\n            \"GET, POST, PUT, DELETE, OPTIONS\"\n        )\n        response.headers[\"Access-Control-Allow-Headers\"] = (\n            \"Authorization, Content-Type\"\n        )\n    return response\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\ndef _wants_json() -> bool:\n    return request.path.startswith(\"/api/\")\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if _wants_json():\n        return api_error(\"not found\", 404)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return api_error(\"frontend build not found\", 404)\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_error):\n    if _wants_json():\n        return api_error(\"method not allowed\", 405)\n    return api_error(\"method not allowed\", 405)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return api_error(\"not found\", 404)\n    target = DIST / path\n    if path != \"index.html\" and target.is_file():\n        return send_from_directory(DIST, path)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return api_error(\"frontend build not found\", 404)","lineStart":1,"lineEnd":442,"totalLines":442,"truncated":false}},"title":"backend/app.py","time":{"start":1794354640586,"end":1794354640622}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7def6c3001hHhkiiqG13Xu2a","sessionID":"ses_e38469a15ffe36mf3F2otgrqwy","messageID":"msg_1c7deb42400125vEMY9G8P5CX0"}}
