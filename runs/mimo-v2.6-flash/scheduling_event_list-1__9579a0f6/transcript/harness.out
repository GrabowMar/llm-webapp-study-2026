{"type":"text","timestamp":1794353072598,"sessionID":"ses_e38469a15ffe36mf3F2otgrqwy","part":{"id":"prt_1c7c709c6001hNL34KJW3KBLnq","messageID":"msg_1c7c623a2001dFplcBnVKaQTwy","sessionID":"ses_e38469a15ffe36mf3F2otgrqwy","type":"text","text":"Now writing the backend:","time":{"start":1794353072582,"end":1794353072595}}}
{"type":"tool_use","timestamp":1794353072629,"sessionID":"ses_e38469a15ffe36mf3F2otgrqwy","part":{"type":"tool","tool":"write","callID":"call_240346f15bd84edba5269a6e","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or \"data\")\nDB_FILE = DATA_DIR / \"calendar.db\"\nUTC = timezone.utc\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    username TEXT PRIMARY KEY,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    username TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS events (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    description TEXT,\n    location TEXT,\n    start_time REAL NOT NULL,\n    end_time REAL NOT NULL,\n    created_at REAL NOT NULL,\n    created_by TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_events_start ON events (start_time);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_FILE, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA journal_mode=WAL\")\n    conn.execute(\"PRAGMA foreign_keys=ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\n@app.teardown_appcontext\ndef _close_db(_exc) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n# ---------------------------------------------------------------------------\n# helpers\n# ---------------------------------------------------------------------------\n\n\ndef api_error(message: str, status: int, field: str | None = None):\n    payload: dict = {\"error\": message}\n    if field is not None:\n        payload[\"field\"] = field\n    return jsonify(payload), status\n\n\ndef _body() -> dict:\n    data = request.get_json(silent=True)\n    if data is None:\n        raw = request.get_data(as_text=True).strip()\n        if raw:\n            try:\n                parsed = json.loads(raw)\n            except ValueError:\n                parsed = None\n            if isinstance(parsed, dict):\n                data = parsed\n    return data if isinstance(data, dict) else {}\n\n\ndef _iso(epoch: float) -> str:\n    return datetime.fromtimestamp(epoch, UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _now_epoch() -> float:\n    return float(int(datetime.now(UTC).timestamp()))\n\n\ndef parse_datetime(value, field: str):\n    \"\"\"Parse an incoming date-time; naive values are taken as UTC.\"\"\"\n    if not isinstance(value, str) or not value.strip():\n        return None, api_error(f\"{field} is required\", 400, field)\n    text = value.strip()\n    if text.endswith(\"z\"):\n        text = text[:-1] + \"Z\"\n    try:\n        parsed = datetime.fromisoformat(text)\n    except ValueError:\n        return None, api_error(\n            f\"{field} must be a valid ISO 8601 date-time\", 400, field\n        )\n    if parsed.tzinfo is None:\n        parsed = parsed.replace(tzinfo=UTC)\n    return parsed.astimezone(UTC), None\n\n\ndef parse_date_bound(value, field: str):\n    \"\"\"Parse a start_date/end_date query value.\n\n    Returns ``(epoch, is_date_only, error_response)``.\n    \"\"\"\n    if not isinstance(value, str) or not value.strip():\n        return None, False, api_error(f\"{field} is required\", 400, field)\n    text = value.strip()\n    date_only = \"T\" not in text and \" \" not in text\n    dt, err = parse_datetime(text, field)\n    if err is not None:\n        return None, False, err\n    return dt.timestamp(), date_only, None\n\n\ndef validate_event(data: dict):\n    \"\"\"Validate an event payload.\n\n    Returns ``(fields, error_response)``; ``fields`` is ``None`` on error.\n    \"\"\"\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        return None, api_error(\"title is required\", 400, \"title\")\n\n    start, err = parse_datetime(data.get(\"start_time\"), \"start_time\")\n    if err is not None:\n        return None, err\n    end, err = parse_datetime(data.get(\"end_time\"), \"end_time\")\n    if err is not None:\n        return None, err\n    if end < start:\n        return None, api_error(\n            \"end_time must not be before start_time\", 400, \"end_time\"\n        )\n\n    description = data.get(\"description\")\n    if description is not None and not isinstance(description, str):\n        return None, api_error(\"description must be a string\", 400, \"description\")\n    location = data.get(\"location\")\n    if location is not None and not isinstance(location, str):\n        return None, api_error(\"location must be a string\", 400, \"location\")\n\n    return {\n        \"title\": title,\n        \"description\": description,\n        \"location\": location,\n        \"start_time\": start.timestamp(),\n        \"end_time\": end.timestamp(),\n    }, None\n\n\ndef event_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": _iso(row[\"start_time\"]),\n        \"end_time\": _iso(row[\"end_time\"]),\n        \"created_at\": _iso(row[\"created_at\"]),\n        \"created_by\": row[\"created_by\"],\n    }\n\n\ndef current_user() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT username FROM tokens WHERE token = ?\", (token,)\n    ).fetchone()\n    return row[\"username\"] if row is not None else None\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        username = current_user()\n        if username is None:\n            return api_error(\"authentication required\", 401)\n        g.username = username\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\n# ---------------------------------------------------------------------------\n# auth\n# ---------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = _body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return api_error(\"username is required\", 400, \"username\")\n    if not isinstance(password, str) or password == \"\":\n        return api_error(\"password is required\", 400, \"password\")\n    username = username.strip()\n    existing = db().execute(\n        \"SELECT 1 FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if existing is not None:\n        return api_error(\"username already taken\", 409, \"username\")\n    db().execute(\n        \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), _iso(_now_epoch())),\n    )\n    db().commit()\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = _body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return api_error(\"username is required\", 400, \"username\")\n    if not isinstance(password, str) or password == \"\":\n        return api_error(\"password is required\", 400, \"password\")\n    username = username.strip()\n    row = db().execute(\n        \"SELECT password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return api_error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    db().execute(\n        \"INSERT INTO tokens (token, username, created_at) VALUES (?, ?, ?)\",\n        (token, username, _iso(_now_epoch())),\n    )\n    db().commit()\n    return jsonify({\"token\": token})\n\n\n# ---------------------------------------------------------------------------\n# events\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    clauses: list[str] = []\n    params: list[float] = []\n\n    start_date = request.args.get(\"start_date\")\n    if start_date is not None:\n        lower, _date_only, err = parse_date_bound(start_date, \"start_date\")\n        if err is not None:\n            return err\n        clauses.append(\"end_time >= ?\")\n        params.append(lower)\n\n    end_date = request.args.get(\"end_date\")\n    if end_date is not None:\n        upper, date_only, err = parse_date_bound(end_date, \"end_date\")\n        if err is not None:\n            return err\n        if date_only:\n            # a plain date covers the whole day\n            upper += 86400\n        clauses.append(\"start_time < ?\")\n        params.append(upper)\n\n    sql = \"SELECT * FROM events\"\n    if clauses:\n        sql += \" WHERE \" + \" AND \".join(clauses)\n    sql += \" ORDER BY start_time ASC, id ASC\"\n    rows = db().execute(sql, params).fetchall()\n    items = [event_json(row) for row in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id: int):\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return api_error(\"event not found\", 404)\n    return jsonify(event_json(row))\n\n\n@app.post(\"/api/events\")\n@login_required\ndef create_event():\n    fields, err = validate_event(_body())\n    if err is not None:\n        return err\n    cursor = db().execute(\n        \"INSERT INTO events (title, description, location, start_time, end_time,\"\n        \" created_at, created_by) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            _now_epoch(),\n            g.username,\n        ),\n    )\n    db().commit()\n    row = db().execute(\n        \"SELECT * FROM events WHERE id = ?\", (cursor.lastrowid,)\n    ).fetchone()\n    return jsonify(event_json(row)), 201\n\n\n@app.put(\"/api/events/<int:event_id>\")\n@login_required\ndef update_event(event_id: int):\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return api_error(\"event not found\", 404)\n    fields, err = validate_event(_body())\n    if err is not None:\n        return err\n    db().execute(\n        \"UPDATE events SET title = ?, description = ?, location = ?,\"\n        \" start_time = ?, end_time = ? WHERE id = ?\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            event_id,\n        ),\n    )\n    db().commit()\n    updated = db().execute(\n        \"SELECT * FROM events WHERE id = ?\", (event_id,)\n    ).fetchone()\n    return jsonify(event_json(updated))\n\n\n@app.delete(\"/api/events/<int:event_id>\")\n@login_required\ndef delete_event(event_id: int):\n    row = db().execute(\"SELECT id FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        return api_error(\"event not found\", 404)\n    db().execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    db().commit()\n    return \"\", 204\n\n\n# ---------------------------------------------------------------------------\n# health + frontend\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\ndef _wants_json() -> bool:\n    return request.path.startswith(\"/api/\")\n\n\n@app.errorhandler(404)\ndef not_found(_error):\n    if _wants_json():\n        return api_error(\"not found\", 404)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return api_error(\"frontend build not found\", 404)\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_error):\n    if _wants_json():\n        return api_error(\"method not allowed\", 405)\n    return api_error(\"method not allowed\", 405)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return api_error(\"not found\", 404)\n    target = DIST / path\n    if path != \"index.html\" and target.is_file():\n        return send_from_directory(DIST, path)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return api_error(\"frontend build not found\", 404)\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794353072591,"end":1794353072612}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7c709c8001hj0ndl13YWlOlS","sessionID":"ses_e38469a15ffe36mf3F2otgrqwy","messageID":"msg_1c7c623a2001dFplcBnVKaQTwy"}}
