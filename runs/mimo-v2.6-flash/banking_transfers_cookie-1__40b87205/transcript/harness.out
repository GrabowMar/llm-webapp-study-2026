{"type":"tool_use","timestamp":1794347631130,"sessionID":"ses_e38b116b4ffebamEgV72HvBIPS","part":{"type":"tool","tool":"read","callID":"call_1b7fbc3c4663474aaed5e7c8","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import secrets\n6: import sqlite3\n7: from datetime import datetime, timezone\n8: from decimal import Decimal, InvalidOperation, ROUND_HALF_UP\n9: from functools import wraps\n10: from pathlib import Path\n11: from typing import Any\n12: \n13: from flask import Flask, g, jsonify, request, send_from_directory\n14: from werkzeug.security import check_password_hash, generate_password_hash\n15: \n16: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n17: DATA_DIR = Path(\"data\")\n18: DB_PATH = DATA_DIR / \"bank.db\"\n19: STARTING_BALANCE_CENTS = 100_000\n20: MAX_PAGE_SIZE = 100\n21: \n22: app = Flask(__name__, static_folder=None)\n23: \n24: \n25: # --------------------------------------------------------------------------\n26: # Database\n27: # --------------------------------------------------------------------------\n28: \n29: \n30: def _connect() -> sqlite3.Connection:\n31:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n32:     conn = sqlite3.connect(DB_PATH, isolation_level=None, timeout=5)\n33:     conn.row_factory = sqlite3.Row\n34:     conn.execute(\"PRAGMA busy_timeout = 5000\")\n35:     conn.execute(\"PRAGMA foreign_keys = ON\")\n36:     return conn\n37: \n38: \n39: def get_db() -> sqlite3.Connection:\n40:     if \"db\" not in g:\n41:         g.db = _connect()\n42:     return g.db\n43: \n44: \n45: @app.teardown_appcontext\n46: def close_db(_exc: BaseException | None) -> None:\n47:     conn = g.pop(\"db\", None)\n48:     if conn is not None:\n49:         conn.close()\n50: \n51: \n52: def init_db() -> None:\n53:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n54:     conn = _connect()\n55:     try:\n56:         conn.execute(\"PRAGMA journal_mode = WAL\")\n57:         conn.executescript(\n58:             \"\"\"\n59:             CREATE TABLE IF NOT EXISTS users (\n60:                 id            INTEGER PRIMARY KEY AUTOINCREMENT,\n61:                 username      TEXT NOT NULL UNIQUE,\n62:                 password_hash TEXT NOT NULL,\n63:                 balance_cents INTEGER NOT NULL,\n64:                 csrf_token    TEXT NOT NULL,\n65:                 created_at    TEXT NOT NULL\n66:             );\n67:             CREATE TABLE IF NOT EXISTS sessions (\n68:                 token      TEXT PRIMARY KEY,\n69:                 user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n70:                 created_at TEXT NOT NULL\n71:             );\n72:             CREATE TABLE IF NOT EXISTS transfers (\n73:                 id           INTEGER PRIMARY KEY AUTOINCREMENT,\n74:                 from_id      INTEGER NOT NULL REFERENCES users(id),\n75:                 to_id        INTEGER NOT NULL REFERENCES users(id),\n76:                 amount_cents INTEGER NOT NULL,\n77:                 memo         TEXT,\n78:                 created_at   TEXT NOT NULL\n79:             );\n80:             CREATE INDEX IF NOT EXISTS idx_transfers_from\n81:                 ON transfers(from_id, created_at, id);\n82:             CREATE INDEX IF NOT EXISTS idx_transfers_to\n83:                 ON transfers(to_id, created_at, id);\n84:             \"\"\"\n85:         )\n86:     finally:\n87:         conn.close()\n88: \n89: \n90: # --------------------------------------------------------------------------\n91: # Helpers\n92: # --------------------------------------------------------------------------\n93: \n94: \n95: def now_iso() -> str:\n96:     return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n97: \n98: \n99: def error(message: str, status: int):\n100:     body = {\"error\": message, \"message\": message}\n101:     return jsonify(body), status\n102: \n103: \n104: def cents_to_amount(cents: int) -> float:\n105:     return round(cents / 100, 2)\n106: \n107: \n108: def parse_amount_cents(value: Any) -> int | None:\n109:     if isinstance(value, bool) or not isinstance(value, (int, float, str)):\n110:         return None\n111:     try:\n112:         dec = Decimal(str(value))\n113:     except InvalidOperation:\n114:         return None\n115:     if not dec.is_finite():\n116:         return None\n117:     dec = dec.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n118:     return int(dec * 100)\n119: \n120: \n121: def json_body() -> dict[str, Any] | None:\n122:     data = request.get_json(silent=True)\n123:     return data if isinstance(data, dict) else None\n124: \n125: \n126: def int_arg(name: str, default: int) -> int:\n127:     raw = request.args.get(name)\n128:     if raw is None:\n129:         return default\n130:     try:\n131:         return int(raw)\n132:     except (TypeError, ValueError):\n133:         return default\n134: \n135: \n136: def _bearer_token() -> str | None:\n137:     header = request.headers.get(\"Authorization\", \"\")\n138:     if header[:7].lower() != \"bearer \":\n139:         return None\n140:     token = header[7:].strip()\n141:     return token or None\n142: \n143: \n144: def current_user() -> sqlite3.Row | None:\n145:     if \"user\" in g:\n146:         return g.user\n147:     user: sqlite3.Row | None = None\n148:     token = _bearer_token()\n149:     if token is not None:\n150:         row = get_db().execute(\n151:             \"\"\"\n152:             SELECT u.*, s.token AS session_token\n153:             FROM sessions s\n154:             JOIN users u ON u.id = s.user_id\n155:             WHERE s.token = ?\n156:             \"\"\",\n157:             (token,),\n158:         ).fetchone()\n159:         if row is not None:\n160:             user = row\n161:             g.session_token = row[\"session_token\"]\n162:     g.user = user\n163:     return user\n164: \n165: \n166: def require_auth(view):\n167:     @wraps(view)\n168:     def wrapper(*args: Any, **kwargs: Any):\n169:         if current_user() is None:\n170:             return error(\"authentication required\", 401)\n171:         return view(*args, **kwargs)\n172: \n173:     return wrapper\n174: \n175: \n176: def csrf_guard():\n177:     \"\"\"Reject a presented CSRF token that does not match the signed-in user.\"\"\"\n178:     presented = request.headers.get(\"X-CSRF-Token\")\n179:     if not presented:\n180:         return None\n181:     user = current_user()\n182:     if user is None:\n183:         return error(\"authentication required\", 401)\n184:     if not secrets.compare_digest(presented, user[\"csrf_token\"]):\n185:         return error(\"invalid csrf token\", 403)\n186:     return None\n187: \n188: \n189: TRANSFER_SELECT = \"\"\"\n190:     SELECT t.*, fu.username AS from_username, tu.username AS to_username\n191:     FROM transfers t\n192:     JOIN users fu ON fu.id = t.from_id\n193:     JOIN users tu ON tu.id = t.to_id\n194: \"\"\"\n195: \n196: \n197: def serialize_transfer(row: sqlite3.Row, user_id: int) -> dict[str, Any]:\n198:     direction = \"out\" if row[\"from_id\"] == user_id else \"in\"\n199:     return {\n200:         \"id\": row[\"id\"],\n201:         \"to_username\": row[\"to_username\"],\n202:         \"amount\": cents_to_amount(row[\"amount_cents\"]),\n203:         \"memo\": row[\"memo\"],\n204:         \"created_at\": row[\"created_at\"],\n205:         \"from_username\": row[\"from_username\"],\n206:         \"direction\": direction,\n207:     }\n208: \n209: \n210: # --------------------------------------------------------------------------\n211: # Auth\n212: # --------------------------------------------------------------------------\n213: \n214: \n215: @app.post(\"/api/auth/register\")\n216: def register():\n217:     data = json_body()\n218:     if data is None:\n219:         return error(\"invalid JSON body\", 400)\n220: \n221:     username = data.get(\"username\")\n222:     password = data.get(\"password\")\n223:     if not isinstance(username, str) or not username.strip():\n224:         return error(\"username is required\", 400)\n225:     if not isinstance(password, str) or not password:\n226:         return error(\"password is required\", 400)\n227:     username = username.strip()\n228:     if len(username) > 64:\n229:         return error(\"username must be at most 64 characters\", 400)\n230:     if len(password) > 256:\n231:         return error(\"password must be at most 256 characters\", 400)\n232: \n233:     try:\n234:         get_db().execute(\n235:             \"\"\"\n236:             INSERT INTO users (username, password_hash, balance_cents, csrf_token, created_at)\n237:             VALUES (?, ?, ?, ?, ?)\n238:             \"\"\",\n239:             (\n240:                 username,\n241:                 generate_password_hash(password),\n242:                 STARTING_BALANCE_CENTS,\n243:                 secrets.token_urlsafe(32),\n244:                 now_iso(),\n245:             ),\n246:         )\n247:     except sqlite3.IntegrityError:\n248:         return error(\"username already taken\", 409)\n249: \n250:     return jsonify({\"username\": username, \"balance\": cents_to_amount(STARTING_BALANCE_CENTS)}), 201\n251: \n252: \n253: @app.post(\"/api/auth/login\")\n254: def login():\n255:     data = json_body()\n256:     if data is None:\n257:         return error(\"invalid JSON body\", 400)\n258: \n259:     username = data.get(\"username\")\n260:     password = data.get(\"password\")\n261:     if not isinstance(username, str) or not username.strip():\n262:         return error(\"username is required\", 400)\n263:     if not isinstance(password, str) or not password:\n264:         return error(\"password is required\", 400)\n265: \n266:     row = get_db().execute(\n267:         \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n268:     ).fetchone()\n269:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n270:         return error(\"invalid username or password\", 401)\n271: \n272:     token = secrets.token_urlsafe(32)\n273:     get_db().execute(\n274:         \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n275:         (token, row[\"id\"], now_iso()),\n276:     )\n277:     return jsonify({\"token\": token}), 200\n278: \n279: \n280: @app.post(\"/api/auth/logout\")\n281: @require_auth\n282: def logout():\n283:     get_db().execute(\"DELETE FROM sessions WHERE token = ?\", (g.session_token,))\n284:     return jsonify({\"status\": \"ok\"}), 200\n285: \n286: \n287: @app.get(\"/api/auth/csrf\")\n288: @require_auth\n289: def csrf():\n290:     return jsonify({\"csrf_token\": current_user()[\"csrf_token\"]}), 200\n291: \n292: \n293: # --------------------------------------------------------------------------\n294: # Account\n295: # --------------------------------------------------------------------------\n296: \n297: \n298: @app.get(\"/api/account\")\n299: @require_auth\n300: def account():\n301:     user = current_user()\n302:     return jsonify({\"username\": user[\"username\"], \"balance\": cents_to_amount(user[\"balance_cents\"])}), 200\n303: \n304: \n305: # --------------------------------------------------------------------------\n306: # Transfers\n307: # --------------------------------------------------------------------------\n308: \n309: \n310: @app.post(\"/api/transfers\")\n311: @require_auth\n312: def create_transfer():\n313:     guard = csrf_guard()\n314:     if guard is not None:\n315:         return guard\n316: \n317:     data = json_body()\n318:     if data is None:\n319:         return error(\"invalid JSON body\", 400)\n320: \n321:     to_username = data.get(\"to_username\")\n322:     if not isinstance(to_username, str) or not to_username.strip():\n323:         return error(\"to_username is required\", 400)\n324:     to_username = to_username.strip()\n325: \n326:     if \"amount\" not in data:\n327:         return error(\"amount is required\", 400)\n328:     amount_cents = parse_amount_cents(data.get(\"amount\"))\n329:     if amount_cents is None:\n330:         return error(\"invalid amount\", 400)\n331:     if amount_cents <= 0:\n332:         return error(\"amount must be greater than zero\", 400)\n333: \n334:     memo = data.get(\"memo\")\n335:     if memo is None:\n336:         memo = None\n337:     elif isinstance(memo, str):\n338:         memo = memo or None\n339:     else:\n340:         return error(\"memo must be a string\", 400)\n341: \n342:     user = current_user()\n343:     db = get_db()\n344:     recipient = db.execute(\n345:         \"SELECT id, username FROM users WHERE username = ?\", (to_username,)\n346:     ).fetchone()\n347:     if recipient is None:\n348:         return error(\"recipient not found\", 400)\n349: \n350:     db.execute(\"BEGIN IMMEDIATE\")\n351:     try:\n352:         balance = db.execute(\n353:             \"SELECT balance_cents FROM users WHERE id = ?\", (user[\"id\"],)\n354:         ).fetchone()[\"balance_cents\"]\n355:         if amount_cents > balance:\n356:             db.execute(\"ROLLBACK\")\n357:             return error(\"insufficient balance\", 400)\n358:         db.execute(\n359:             \"UPDATE users SET balance_cents = balance_cents - ? WHERE id = ?\",\n360:             (amount_cents, user[\"id\"]),\n361:         )\n362:         db.execute(\n363:             \"UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?\",\n364:             (amount_cents, recipient[\"id\"]),\n365:         )\n366:         created_at = now_iso()\n367:         cursor = db.execute(\n368:             \"\"\"\n369:             INSERT INTO transfers (from_id, to_id, amount_cents, memo, created_at)\n370:             VALUES (?, ?, ?, ?, ?)\n371:             \"\"\",\n372:             (user[\"id\"], recipient[\"id\"], amount_cents, memo, created_at),\n373:         )\n374:         transfer_id = cursor.lastrowid\n375:         db.execute(\"COMMIT\")\n376:     except sqlite3.Error:\n377:         db.execute(\"ROLLBACK\")\n378:         raise\n379: \n380:     row = db.execute(\n381:         TRANSFER_SELECT + \" WHERE t.id = ?\", (transfer_id,)\n382:     ).fetchone()\n383:     return jsonify(serialize_transfer(row, user[\"id\"])), 201\n384: \n385: \n386: @app.get(\"/api/transfers\")\n387: @require_auth\n388: def list_transfers():\n389:     user = current_user()\n390:     page = max(int_arg(\"page\", 1), 1)\n391:     page_size = min(max(int_arg(\"page_size\", 10), 1), MAX_PAGE_SIZE)\n392: \n393:     db = get_db()\n394:     total = db.execute(\n395:         \"SELECT COUNT(*) FROM transfers WHERE from_id = ? OR to_id = ?\",\n396:         (user[\"id\"], user[\"id\"]),\n397:     ).fetchone()[0]\n398:     rows = db.execute(\n399:         TRANSFER_SELECT\n400:         + \"\"\"\n401:         WHERE t.from_id = ? OR t.to_id = ?\n402:         ORDER BY t.created_at DESC, t.id DESC\n403:         LIMIT ? OFFSET ?\n404:         \"\"\",\n405:         (user[\"id\"], user[\"id\"], page_size, (page - 1) * page_size),\n406:     ).fetchall()\n407:     items = [serialize_transfer(row, user[\"id\"]) for row in rows]\n408:     return jsonify({\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size}), 200\n409: \n410: \n411: @app.get(\"/api/transfers/<int:transfer_id>\")\n412: @require_auth\n413: def get_transfer(transfer_id: int):\n414:     user = current_user()\n415:     row = get_db().execute(\n416:         TRANSFER_SELECT + \" WHERE t.id = ? AND (t.from_id = ? OR t.to_id = ?)\",\n417:         (transfer_id, user[\"id\"], user[\"id\"]),\n418:     ).fetchone()\n419:     if row is None:\n420:         return error(\"transfer not found\", 404)\n421:     return jsonify(serialize_transfer(row, user[\"id\"])), 200\n422: \n423: \n424: # --------------------------------------------------------------------------\n425: # Health\n426: # --------------------------------------------------------------------------\n427: \n428: \n429: @app.get(\"/api/health\")\n430: def health():\n431:     return jsonify({\"status\": \"ok\"}), 200\n432: \n433: \n434: # --------------------------------------------------------------------------\n435: # Frontend\n436: # --------------------------------------------------------------------------\n437: \n438: \n439: @app.get(\"/\")\n440: @app.get(\"/<path:path>\")\n441: def frontend(path: str = \"index.html\"):\n442:     if path == \"api\" or path.startswith(\"api/\"):\n443:         return error(\"not found\", 404)\n444:     if (DIST / path).is_file():\n445:         return send_from_directory(DIST, path)\n446:     return send_from_directory(DIST, \"index.html\")\n447: \n448: \n449: init_db()\n450: \n451: \n452: if __name__ == \"__main__\":\n453:     app.run(host=\"0.0.0.0\", port=8000)\n\n(End of file - total 453 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"bank.db\"\nSTARTING_BALANCE_CENTS = 100_000\nMAX_PAGE_SIZE = 100","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"bank.db\"\nSTARTING_BALANCE_CENTS = 100_000\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# Database\n# --------------------------------------------------------------------------\n\n\ndef _connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, isolation_level=None, timeout=5)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA busy_timeout = 5000\")\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = _connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = _connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id            INTEGER PRIMARY KEY AUTOINCREMENT,\n                username      TEXT NOT NULL UNIQUE,\n                password_hash TEXT NOT NULL,\n                balance_cents INTEGER NOT NULL,\n                csrf_token    TEXT NOT NULL,\n                created_at    TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token      TEXT PRIMARY KEY,\n                user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS transfers (\n                id           INTEGER PRIMARY KEY AUTOINCREMENT,\n                from_id      INTEGER NOT NULL REFERENCES users(id),\n                to_id        INTEGER NOT NULL REFERENCES users(id),\n                amount_cents INTEGER NOT NULL,\n                memo         TEXT,\n                created_at   TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_transfers_from\n                ON transfers(from_id, created_at, id);\n            CREATE INDEX IF NOT EXISTS idx_transfers_to\n                ON transfers(to_id, created_at, id);\n            \"\"\"\n        )\n    finally:\n        conn.close()\n\n\n# --------------------------------------------------------------------------\n# Helpers\n# --------------------------------------------------------------------------\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef error(message: str, status: int):\n    body = {\"error\": message, \"message\": message}\n    return jsonify(body), status\n\n\ndef cents_to_amount(cents: int) -> float:\n    return round(cents / 100, 2)\n\n\ndef parse_amount_cents(value: Any) -> int | None:\n    if isinstance(value, bool) or not isinstance(value, (int, float, str)):\n        return None\n    try:\n        dec = Decimal(str(value))\n    except InvalidOperation:\n        return None\n    if not dec.is_finite():\n        return None\n    dec = dec.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    return int(dec * 100)\n\n\ndef json_body() -> dict[str, Any] | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef int_arg(name: str, default: int) -> int:\n    raw = request.args.get(name)\n    if raw is None:\n        return default\n    try:\n        return int(raw)\n    except (TypeError, ValueError):\n        return default\n\n\ndef _bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if header[:7].lower() != \"bearer \":\n        return None\n    token = header[7:].strip()\n    return token or None\n\n\ndef current_user() -> sqlite3.Row | None:\n    if \"user\" in g:\n        return g.user\n    user: sqlite3.Row | None = None\n    token = _bearer_token()\n    if token is not None:\n        row = get_db().execute(\n            \"\"\"\n            SELECT u.*, s.token AS session_token\n            FROM sessions s\n            JOIN users u ON u.id = s.user_id\n            WHERE s.token = ?\n            \"\"\",\n            (token,),\n        ).fetchone()\n        if row is not None:\n            user = row\n            g.session_token = row[\"session_token\"]\n    g.user = user\n    return user\n\n\ndef require_auth(view):\n    @wraps(view)\n    def wrapper(*args: Any, **kwargs: Any):\n        if current_user() is None:\n            return error(\"authentication required\", 401)\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef csrf_guard():\n    \"\"\"Reject a presented CSRF token that does not match the signed-in user.\"\"\"\n    presented = request.headers.get(\"X-CSRF-Token\")\n    if not presented:\n        return None\n    user = current_user()\n    if user is None:\n        return error(\"authentication required\", 401)\n    if not secrets.compare_digest(presented, user[\"csrf_token\"]):\n        return error(\"invalid csrf token\", 403)\n    return None\n\n\nTRANSFER_SELECT = \"\"\"\n    SELECT t.*, fu.username AS from_username, tu.username AS to_username\n    FROM transfers t\n    JOIN users fu ON fu.id = t.from_id\n    JOIN users tu ON tu.id = t.to_id\n\"\"\"\n\n\ndef serialize_transfer(row: sqlite3.Row, user_id: int) -> dict[str, Any]:\n    direction = \"out\" if row[\"from_id\"] == user_id else \"in\"\n    return {\n        \"id\": row[\"id\"],\n        \"to_username\": row[\"to_username\"],\n        \"amount\": cents_to_amount(row[\"amount_cents\"]),\n        \"memo\": row[\"memo\"],\n        \"created_at\": row[\"created_at\"],\n        \"from_username\": row[\"from_username\"],\n        \"direction\": direction,\n    }\n\n\n# --------------------------------------------------------------------------\n# Auth\n# --------------------------------------------------------------------------\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    username = username.strip()\n    if len(username) > 64:\n        return error(\"username must be at most 64 characters\", 400)\n    if len(password) > 256:\n        return error(\"password must be at most 256 characters\", 400)\n\n    try:\n        get_db().execute(\n            \"\"\"\n            INSERT INTO users (username, password_hash, balance_cents, csrf_token, created_at)\n            VALUES (?, ?, ?, ?, ?)\n            \"\"\",\n            (\n                username,\n                generate_password_hash(password),\n                STARTING_BALANCE_CENTS,\n                secrets.token_urlsafe(32),\n                now_iso(),\n            ),\n        )\n    except sqlite3.IntegrityError:\n        return error(\"username already taken\", 409)\n\n    return jsonify({\"username\": username, \"balance\": cents_to_amount(STARTING_BALANCE_CENTS)}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n\n    row = get_db().execute(\n        \"SELECT * FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n\n    token = secrets.token_urlsafe(32)\n    get_db().execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/auth/logout\")\n@require_auth\ndef logout():\n    get_db().execute(\"DELETE FROM sessions WHERE token = ?\", (g.session_token,))\n    return jsonify({\"status\": \"ok\"}), 200\n\n\n@app.get(\"/api/auth/csrf\")\n@require_auth\ndef csrf():\n    return jsonify({\"csrf_token\": current_user()[\"csrf_token\"]}), 200\n\n\n# --------------------------------------------------------------------------\n# Account\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/account\")\n@require_auth\ndef account():\n    user = current_user()\n    return jsonify({\"username\": user[\"username\"], \"balance\": cents_to_amount(user[\"balance_cents\"])}), 200\n\n\n# --------------------------------------------------------------------------\n# Transfers\n# --------------------------------------------------------------------------\n\n\n@app.post(\"/api/transfers\")\n@require_auth\ndef create_transfer():\n    guard = csrf_guard()\n    if guard is not None:\n        return guard\n\n    data = json_body()\n    if data is None:\n        return error(\"invalid JSON body\", 400)\n\n    to_username = data.get(\"to_username\")\n    if not isinstance(to_username, str) or not to_username.strip():\n        return error(\"to_username is required\", 400)\n    to_username = to_username.strip()\n\n    if \"amount\" not in data:\n        return error(\"amount is required\", 400)\n    amount_cents = parse_amount_cents(data.get(\"amount\"))\n    if amount_cents is None:\n        return error(\"invalid amount\", 400)\n    if amount_cents <= 0:\n        return error(\"amount must be greater than zero\", 400)\n\n    memo = data.get(\"memo\")\n    if memo is None:\n        memo = None\n    elif isinstance(memo, str):\n        memo = memo or None\n    else:\n        return error(\"memo must be a string\", 400)\n\n    user = current_user()\n    db = get_db()\n    recipient = db.execute(\n        \"SELECT id, username FROM users WHERE username = ?\", (to_username,)\n    ).fetchone()\n    if recipient is None:\n        return error(\"recipient not found\", 400)\n\n    db.execute(\"BEGIN IMMEDIATE\")\n    try:\n        balance = db.execute(\n            \"SELECT balance_cents FROM users WHERE id = ?\", (user[\"id\"],)\n        ).fetchone()[\"balance_cents\"]\n        if amount_cents > balance:\n            db.execute(\"ROLLBACK\")\n            return error(\"insufficient balance\", 400)\n        db.execute(\n            \"UPDATE users SET balance_cents = balance_cents - ? WHERE id = ?\",\n            (amount_cents, user[\"id\"]),\n        )\n        db.execute(\n            \"UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?\",\n            (amount_cents, recipient[\"id\"]),\n        )\n        created_at = now_iso()\n        cursor = db.execute(\n            \"\"\"\n            INSERT INTO transfers (from_id, to_id, amount_cents, memo, created_at)\n            VALUES (?, ?, ?, ?, ?)\n            \"\"\",\n            (user[\"id\"], recipient[\"id\"], amount_cents, memo, created_at),\n        )\n        transfer_id = cursor.lastrowid\n        db.execute(\"COMMIT\")\n    except sqlite3.Error:\n        db.execute(\"ROLLBACK\")\n        raise\n\n    row = db.execute(\n        TRANSFER_SELECT + \" WHERE t.id = ?\", (transfer_id,)\n    ).fetchone()\n    return jsonify(serialize_transfer(row, user[\"id\"])), 201\n\n\n@app.get(\"/api/transfers\")\n@require_auth\ndef list_transfers():\n    user = current_user()\n    page = max(int_arg(\"page\", 1), 1)\n    page_size = min(max(int_arg(\"page_size\", 10), 1), MAX_PAGE_SIZE)\n\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) FROM transfers WHERE from_id = ? OR to_id = ?\",\n        (user[\"id\"], user[\"id\"]),\n    ).fetchone()[0]\n    rows = db.execute(\n        TRANSFER_SELECT\n        + \"\"\"\n        WHERE t.from_id = ? OR t.to_id = ?\n        ORDER BY t.created_at DESC, t.id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        (user[\"id\"], user[\"id\"], page_size, (page - 1) * page_size),\n    ).fetchall()\n    items = [serialize_transfer(row, user[\"id\"]) for row in rows]\n    return jsonify({\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size}), 200\n\n\n@app.get(\"/api/transfers/<int:transfer_id>\")\n@require_auth\ndef get_transfer(transfer_id: int):\n    user = current_user()\n    row = get_db().execute(\n        TRANSFER_SELECT + \" WHERE t.id = ? AND (t.from_id = ? OR t.to_id = ?)\",\n        (transfer_id, user[\"id\"], user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        return error(\"transfer not found\", 404)\n    return jsonify(serialize_transfer(row, user[\"id\"])), 200\n\n\n# --------------------------------------------------------------------------\n# Health\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return jsonify({\"status\": \"ok\"}), 200\n\n\n# --------------------------------------------------------------------------\n# Frontend\n# --------------------------------------------------------------------------\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8000)","lineStart":1,"lineEnd":453,"totalLines":453,"truncated":false}},"title":"backend/app.py","time":{"start":1794347631101,"end":1794347631111}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c77401f80018KCTFRR9GT7Nj7","sessionID":"ses_e38b116b4ffebamEgV72HvBIPS","messageID":"msg_1c7737c59001YKVXoYSw8NYZZl"}}
