{"type":"tool_use","timestamp":1794346843490,"sessionID":"ses_e38b116b4ffebamEgV72HvBIPS","part":{"type":"tool","tool":"write","callID":"call_56115e1980eb41f28b357135","state":{"status":"completed","input":{"content":"\"\"\"End-to-end tests for the bank API + served frontend.\"\"\"\n\nimport json\nimport sys\nimport threading\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://localhost:8000\"\nFAILURES = []\n\n\ndef req(method, path, body=None, token=None, csrf=None):\n    data = None if body is None else json.dumps(body).encode()\n    headers = {\"Accept\": \"application/json\"}\n    if data is not None:\n        headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    if csrf:\n        headers[\"X-CSRF-Token\"] = csrf\n    request = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(request, timeout=15) as resp:\n            raw = resp.read().decode()\n            status = resp.status\n    except urllib.error.HTTPError as e:\n        raw = e.read().decode()\n        status = e.code\n    try:\n        payload = json.loads(raw) if raw else None\n    except json.JSONDecodeError:\n        payload = raw\n    return status, payload\n\n\ndef check(label, actual, expected=None):\n    ok = actual == expected if expected is not None else True\n    if not ok:\n        FAILURES.append(f\"{label}: expected {expected!r}, got {actual!r}\")\n        print(f\"FAIL {label}: expected {expected!r}, got {actual!r}\")\n    else:\n        print(f\"ok   {label}\")\n    return ok\n\n\ndef check_true(label, cond, detail=\"\"):\n    if not cond:\n        FAILURES.append(f\"{label} {detail}\")\n        print(f\"FAIL {label} {detail}\")\n    else:\n        print(f\"ok   {label}\")\n\n\ndef main():\n    # health + frontend shell\n    status, body = req(\"GET\", \"/api/health\")\n    check(\"health\", (status, body), (200, {\"status\": \"ok\"}))\n\n    status, body = req(\"GET\", \"/\")\n    check_true(\"frontend index\", status == 200 and \"<div id=\\\"root\\\">\" in body, f\"status={status}\")\n    status, body = req(\"GET\", \"/some/spa/route\")\n    check_true(\"spa fallback\", status == 200 and \"<div id=\\\"root\\\">\" in str(body), f\"status={status}\")\n    status, body = req(\"GET\", \"/api/does-not-exist\")\n    check_true(\"unknown api 404\", status == 404, f\"status={status}\")\n\n    # registration\n    status, body = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"})\n    check(\"register alice\", status, 201)\n    check(\"register alice balance\", body.get(\"balance\"), 1000.0)\n    status, _ = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"other\"})\n    check(\"duplicate register\", status, 409)\n    status, _ = req(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"secret1\"})\n    check(\"register bob\", status, 201)\n    status, _ = req(\"POST\", \"/api/auth/register\", {\"username\": \"charlie\", \"password\": \"secret1\"})\n    check(\"register charlie\", status, 201)\n    status, _ = req(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\n    check(\"empty username\", status, 400)\n    status, _ = req(\"POST\", \"/api/auth/register\", {\"username\": \"nologin\"})\n    check(\"missing password\", status, 400)\n\n    # login\n    status, body = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\n    check(\"bad login\", status, 401)\n    status, alice_login = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"})\n    check(\"alice login\", status, 200)\n    alice = alice_login[\"token\"]\n    status, bob_login = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"secret1\"})\n    check(\"bob login\", status, 200)\n    bob = bob_login[\"token\"]\n    status, charlie_login = req(\"POST\", \"/api/auth/login\", {\"username\": \"charlie\", \"password\": \"secret1\"})\n    charlie = charlie_login[\"token\"]\n\n    # auth guards\n    status, _ = req(\"GET\", \"/api/account\")\n    check(\"account no token\", status, 401)\n    status, _ = req(\"GET\", \"/api/account\", token=\"not-a-token\")\n    check(\"account bad token\", status, 401)\n    status, account = req(\"GET\", \"/api/account\", token=alice)\n    check(\"alice account\", (status, account), (200, {\"username\": \"alice\", \"balance\": 1000.0}))\n    status, body = req(\"GET\", \"/api/auth/csrf\")\n    check(\"csrf no auth\", status, 401)\n    status, csrf_body = req(\"GET\", \"/api/auth/csrf\", token=alice)\n    check(\"csrf\", status, 200)\n    alice_csrf = csrf_body[\"csrf_token\"]\n    check_true(\"csrf is string\", isinstance(alice_csrf, str) and len(alice_csrf) > 10)\n\n    # transfer creation\n    status, _ = req(\"POST\", \"/api/transfers\", {\"to_username\": \"ghost\", \"amount\": 1})\n    check(\"transfer no auth\", status, 401)\n    status, transfer = req(\n        \"POST\",\n        \"/api/transfers\",\n        {\"to_username\": \"bob\", \"amount\": 125.5, \"memo\": \"lunch\"},\n        token=alice,\n    )\n    check(\"create transfer\", status, 201)\n    check_true(\n        \"transfer shape\",\n        set(transfer)\n        >= {\"id\", \"to_username\", \"amount\", \"memo\", \"created_at\", \"from_username\", \"direction\"}\n        and transfer[\"to_username\"] == \"bob\"\n        and transfer[\"from_username\"] == \"alice\"\n        and transfer[\"amount\"] == 125.5\n        and transfer[\"memo\"] == \"lunch\"\n        and transfer[\"direction\"] == \"out\"\n        and isinstance(transfer[\"id\"], int)\n        and isinstance(transfer[\"created_at\"], str),\n        repr(transfer),\n    )\n    first_id = transfer[\"id\"]\n\n    status, account = req(\"GET\", \"/api/account\", token=alice)\n    check(\"alice balance after send\", account[\"balance\"], 874.5)\n    status, account = req(\"GET\", \"/api/account\", token=bob)\n    check(\"bob balance after receive\", account[\"balance\"], 1125.5)\n\n    # validation errors\n    status, body = req(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 999999}, token=alice)\n    check(\"insufficient balance\", status, 400)\n    check_true(\"insufficient message\", \"insufficient\" in json.dumps(body).lower(), repr(body))\n    status, body = req(\"POST\", \"/api/transfers\", {\"to_username\": \"ghost\", \"amount\": 1}, token=alice)\n    check(\"unknown recipient\", status, 400)\n    status, _ = req(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 0}, token=alice)\n    check(\"zero amount\", status, 400)\n    status, _ = req(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": -5}, token=alice)\n    check(\"negative amount\", status, 400)\n    status, _ = req(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": \"abc\"}, token=alice)\n    check(\"garbage amount\", status, 400)\n    status, _ = req(\"POST\", \"/api/transfers\", {\"amount\": 10}, token=alice)\n    check(\"missing recipient\", status, 400)\n    status, _ = req(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\"}, token=alice)\n    check(\"missing amount\", status, 400)\n\n    # csrf enforcement when header is presented\n    status, body = req(\n        \"POST\", \"/api/transfers\",\n        {\"to_username\": \"bob\", \"amount\": 1}, token=alice, csrf=\"wrong-token\",\n    )\n    check(\"bad csrf rejected\", status, 403)\n    status, _ = req(\n        \"POST\", \"/api/transfers\",\n        {\"to_username\": \"bob\", \"amount\": 1}, token=alice, csrf=alice_csrf,\n    )\n    check(\"good csrf accepted\", status, 201)\n\n    # visibility of transfers\n    status, items = req(\"GET\", \"/api/transfers\", token=bob)\n    check(\"bob list\", status, 200)\n    check_true(\"bob sees transfer\", any(t[\"id\"] == first_id for t in items[\"items\"]), repr(items))\n    check_true(\"bob direction in\", all(t[\"direction\"] == \"in\" for t in items[\"items\"]), repr(items))\n    status, items = req(\"GET\", \"/api/transfers\", token=charlie)\n    check_true(\"charlie sees none\", items == {\"items\": [], \"total\": 0, \"page\": 1, \"page_size\": 10}, repr(items))\n\n    status, one = req(\"GET\", f\"/api/transfers/{first_id}\", token=alice)\n    check(\"alice fetches transfer\", status, 200)\n    check(\"alice transfer direction\", one[\"direction\"], \"out\")\n    status, one = req(\"GET\", f\"/api/transfers/{first_id}\", token=bob)\n    check(\"bob fetches transfer\", status, 200)\n    check(\"bob transfer direction\", one[\"direction\"], \"in\")\n    status, _ = req(\"GET\", f\"/api/transfers/{first_id}\", token=charlie)\n    check(\"charlie cannot fetch transfer\", status, 404)\n    status, _ = req(\"GET\", \"/api/transfers/99999999\", token=alice)\n    check(\"missing transfer\", status, 404)\n\n    # paging\n    for i in range(12):\n        status, _ = req(\n            \"POST\", \"/api/transfers\",\n            {\"to_username\": \"alice\", \"amount\": 1, \"memo\": f\"m{i}\"},\n            token=bob,\n        )\n        check_true(f\"seed transfer {i}\", status == 201, f\"status={status}\")\n\n    status, page1 = req(\"GET\", \"/api/transfers?page=1&page_size=5\", token=alice)\n    check(\"page 1 size\", (status, len(page1[\"items\"]), page1[\"total\"], page1[\"page\"], page1[\"page_size\"]),\n          (200, 5, 14, 1, 5))\n    ids = [t[\"id\"] for t in page1[\"items\"]]\n    check_true(\"newest first\", ids == sorted(ids, reverse=True), repr(ids))\n    status, page2 = req(\"GET\", \"/api/transfers?page=2&page_size=5\", token=alice)\n    check(\"page 2 size\", len(page2[\"items\"]), 5)\n    check_true(\"pages disjoint\", not set(ids) & {t[\"id\"] for t in page2[\"items\"]})\n    status, page3 = req(\"GET\", \"/api/transfers?page=3&page_size=5\", token=alice)\n    check(\"page 3 size\", len(page3[\"items\"]), 4)\n    status, empty = req(\"GET\", \"/api/transfers?page=99&page_size=5\", token=alice)\n    check(\"page beyond end\", (empty[\"items\"], empty[\"total\"], empty[\"page\"]), ([], 14, 99))\n    status, defaults = req(\"GET\", \"/api/transfers\", token=alice)\n    check(\"default paging echoes\", (defaults[\"page\"], defaults[\"page_size\"]), (1, 10))\n\n    # optional memo\n    status, t = req(\"POST\", \"/api/transfers\", {\"to_username\": \"bob\", \"amount\": 0.5}, token=alice)\n    check(\"memo optional\", (status, t[\"memo\"]), (201, None))\n\n    # logout\n    status, _ = req(\"POST\", \"/api/auth/logout\", token=alice)\n    check(\"logout\", status, 200)\n    status, _ = req(\"GET\", \"/api/account\", token=alice)\n    check(\"token revoked\", status, 401)\n    status, _ = req(\"POST\", \"/api/auth/logout\", token=alice)\n    check(\"logout again\", status, 401)\n    status, _ = req(\"POST\", \"/api/auth/logout\")\n    check(\"logout without token\", status, 401)\n\n    # balance of frontend assets\n    status, html = req(\"GET\", \"/\")\n    import re\n    assets = re.findall(r'/(assets/[^\"]+)', html)\n    check_true(\"asset referenced\", len(assets) >= 1, html[:200])\n    for asset in assets:\n        status, _ = req(\"GET\", \"/\" + asset)\n        check(f\"asset {asset}\", status, 200)\n\n    # atomicity under concurrency: carol can fund at most 10 transfers of 100\n    req(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"secret1\"})\n    req(\"POST\", \"/api/auth/register\", {\"username\": \"dave\", \"password\": \"secret1\"})\n    _, carol_login = req(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"secret1\"})\n    _, dave_login = req(\"POST\", \"/api/auth/login\", {\"username\": \"dave\", \"password\": \"secret1\"})\n    carol, dave = carol_login[\"token\"], dave_login[\"token\"]\n\n    results = []\n    lock = threading.Lock()\n\n    def attempt():\n        status, _ = req(\n            \"POST\", \"/api/transfers\",\n            {\"to_username\": \"dave\", \"amount\": 100}, token=carol,\n        )\n        with lock:\n            results.append(status)\n\n    threads = [threading.Thread(target=attempt) for _ in range(20)]\n    for t in threads:\n        t.start()\n    for t in threads:\n        t.join()\n\n    ok_count = results.count(201)\n    check_true(\"exactly 10 succeed\", ok_count == 10, repr(sorted(results)))\n    check_true(\"rest are 400\", all(s in (200, 201, 400) for s in results), repr(sorted(results)))\n    _, acc = req(\"GET\", \"/api/account\", token=carol)\n    check(\"carol drained exactly\", acc[\"balance\"], 0.0)\n    _, acc = req(\"GET\", \"/api/account\", token=dave)\n    check(\"dave received exactly\", acc[\"balance\"], 2000.0)\n    _, listing = req(\"GET\", \"/api/transfers?page_size=100\", token=carol)\n    check(\"carol transfer count\", listing[\"total\"], 10)\n    _, listing = req(\"GET\", \"/api/transfers?page_size=100\", token=dave)\n    check(\"dave transfer count\", listing[\"total\"], 10)\n\n    print()\n    if FAILURES:\n        print(f\"{len(FAILURES)} FAILURE(S):\")\n        for f in FAILURES:\n            print(\" -\", f)\n        sys.exit(1)\n    print(\"ALL TESTS PASSED\")\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/workspace/.e2e.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.e2e.py","exists":false,"truncated":false},"title":".e2e.py","time":{"start":1794346843462,"end":1794346843472}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c767fd42001Bfj7iX1enOTNkS","sessionID":"ses_e38b116b4ffebamEgV72HvBIPS","messageID":"msg_1c7653576001Wl2m8OyGBA4RiV"}}
