+          </p>
+          <p className="mt-2 text-sm text-sky-100">
+            Signed in as {account.username}
+          </p>
+        </section>
+
+        <TransferForm onSent={handleTransferSent} />
+        <TransferList version={listVersion} />
+      </main>
+    </div>
+  );
+}
diff --git a/frontend/src/components/TransferForm.tsx b/frontend/src/components/TransferForm.tsx
new file mode 100644
index 0000000..2644c40
--- /dev/null
+++ b/frontend/src/components/TransferForm.tsx
@@ -0,0 +1,225 @@
+import { useState } from "react";
+import { createTransfer } from "../api";
+import { formatMoney } from "../format";
+
+type Props = {
+  onSent: () => void | Promise<void>;
+};
+
+type Result = { ok: boolean; message: string } | null;
+
+export default function TransferForm({ onSent }: Props) {
+  const [to, setTo] = useState("");
+  const [amount, setAmount] = useState("");
+  const [memo, setMemo] = useState("");
+  const [step, setStep] = useState<"edit" | "confirm">("edit");
+  const [formError, setFormError] = useState<string | null>(null);
+  const [result, setResult] = useState<Result>(null);
+  const [busy, setBusy] = useState(false);
+
+  function reset() {
+    setTo("");
+    setAmount("");
+    setMemo("");
+    setStep("edit");
+    setFormError(null);
+    setResult(null);
+  }
+
+  function review(event: React.FormEvent) {
+    event.preventDefault();
+    setFormError(null);
+    setResult(null);
+    const value = Number(amount);
+    if (!to.trim()) {
+      setFormError("Enter the recipient's username.");
+      return;
+    }
+    if (!amount.trim() || !Number.isFinite(value) || value <= 0) {
+      setFormError("Enter an amount greater than zero.");
+      return;
+    }
+    setStep("confirm");
+  }
+
+  async function confirm() {
+    setBusy(true);
+    setFormError(null);
+    try {
+      await createTransfer({
+        to_username: to.trim(),
+        amount: Number(amount),
+        memo: memo.trim() || undefined,
+      });
+      setResult({
+        ok: true,
+        message: `Sent $${formatMoney(Number(amount))} to ${to.trim()}.`,
+      });
+      await onSent();
+    } catch (err) {
+      setResult({
+        ok: false,
+        message: err instanceof Error ? err.message : "The transfer failed.",
+      });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const inputClass =
+    "mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-200";
+
+  return (
+    <section className="rounded-2xl bg-white p-6 shadow">
+      <h2 className="text-base font-semibold text-slate-900">Send money</h2>
+
+      {step === "edit" && (
+        <form onSubmit={review} className="mt-4 space-y-4">
+          <div className="grid gap-4 sm:grid-cols-2">
+            <div>
+              <label
+                htmlFor="to"
+                className="block text-sm font-medium text-slate-700"
+              >
+                Recipient username
+              </label>
+              <input
+                id="to"
+                value={to}
+                onChange={(e) => setTo(e.target.value)}
+                placeholder="alice"
+                className={inputClass}
+              />
+            </div>
+            <div>
+              <label
+                htmlFor="amount"
+                className="block text-sm font-medium text-slate-700"
+              >
+                Amount
+              </label>
+              <input
+                id="amount"
+                value={amount}
+                onChange={(e) => setAmount(e.target.value)}
+                placeholder="25.00"
+                inputMode="decimal"
+                className={inputClass}
+              />
+            </div>
+          </div>
+          <div>
+            <label
+              htmlFor="memo"
+              className="block text-sm font-medium text-slate-700"
+            >
+              Memo <span className="text-slate-400">(optional)</span>
+            </label>
+            <input
+              id="memo"
+              value={memo}
+              onChange={(e) => setMemo(e.target.value)}
+              placeholder="Lunch"
+              className={inputClass}
+            />
+          </div>
+
+          {formError && (
+            <p className="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">
+              {formError}
+            </p>
+          )}
+
+          <button
+            type="submit"
+            className="rounded-lg bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-sky-500"
+          >
+            Review transfer
+          </button>
+        </form>
+      )}
+
+      {step === "confirm" && (
+        <div className="mt-4 space-y-4">
+          <dl className="divide-y divide-slate-200 rounded-lg border border-slate-200">
+            <div className="flex items-center justify-between px-4 py-3">
+              <dt className="text-sm text-slate-500">Recipient</dt>
+              <dd className="text-sm font-medium text-slate-900">{to.trim()}</dd>
+            </div>
+            <div className="flex items-center justify-between px-4 py-3">
+              <dt className="text-sm text-slate-500">Amount</dt>
+              <dd className="text-sm font-medium text-slate-900">
+                ${formatMoney(Number(amount))}
+              </dd>
+            </div>
+            <div className="flex items-center justify-between px-4 py-3">
+              <dt className="text-sm text-slate-500">Memo</dt>
+              <dd className="text-sm font-medium text-slate-900">
+                {memo.trim() || "—"}
+              </dd>
+            </div>
+          </dl>
+
+          {result && (
+            <p
+              className={
+                result.ok
+                  ? "rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700"
+                  : "rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700"
+              }
+            >
+              {result.message}
+            </p>
+          )}
+
+          {!result && (
+            <div className="flex gap-3">
+              <button
+                type="button"
+                onClick={() => void confirm()}
+                disabled={busy}
+                className="rounded-lg bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-sky-500 disabled:opacity-60"
+              >
+                {busy ? "Sending…" : "Confirm transfer"}
+              </button>
+              <button
+                type="button"
+                onClick={() => {
+                  setStep("edit");
+                  setFormError(null);
+                }}
+                disabled={busy}
+                className="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-60"
+              >
+                Back
+              </button>
+            </div>
+          )}
+
+          {result?.ok && (
+            <button
+              type="button"
+              onClick={reset}
+              className="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
+            >
+              Send another transfer
+            </button>
+          )}
+
+          {result && !result.ok && (
+            <button
+              type="button"
+              onClick={() => {
+                setStep("edit");
+                setResult(null);
+              }}
+              className="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
+            >
+              Back to edit
+            </button>
+          )}
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/src/components/TransferList.tsx b/frontend/src/components/TransferList.tsx
new file mode 100644
index 0000000..42f694e
--- /dev/null
+++ b/frontend/src/components/TransferList.tsx
@@ -0,0 +1,161 @@
+import { useEffect, useState } from "react";
+import { listTransfers } from "../api";
+import type { TransferPage } from "../api";
+import { formatDate, formatMoney } from "../format";
+
+const PAGE_SIZE = 10;
+
+type Props = {
+  version: number;
+};
+
+export default function TransferList({ version }: Props) {
+  const [page, setPage] = useState(1);
+  const [data, setData] = useState<TransferPage | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    setPage(1);
+  }, [version]);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    listTransfers(page, PAGE_SIZE)
+      .then((next) => {
+        if (cancelled) return;
+        setData(next);
+        setError(null);
+      })
+      .catch((err) => {
+        if (cancelled) return;
+        setError(err instanceof Error ? err.message : "Failed to load transfers.");
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [page, version]);
+
+  const total = data?.total ?? 0;
+  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
+
+  useEffect(() => {
+    if (data && data.page > totalPages) setPage(totalPages);
+  }, [data, totalPages]);
+
+  return (
+    <section className="rounded-2xl bg-white p-6 shadow">
+      <div className="flex items-baseline justify-between">
+        <h2 className="text-base font-semibold text-slate-900">
+          Transaction history
+        </h2>
+        {data && (
+          <span className="text-sm text-slate-500">
+            {total} transfer{total === 1 ? "" : "s"}
+          </span>
+        )}
+      </div>
+
+      {error && (
+        <p className="mt-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">
+          {error}
+        </p>
+      )}
+
+      {!error && loading && (
+        <p className="mt-4 text-sm text-slate-500">Loading transfers…</p>
+      )}
+
+      {!error && !loading && data && data.items.length === 0 && (
+        <p className="mt-4 text-sm text-slate-500">No transfers yet.</p>
+      )}
+
+      {!error && !loading && data && data.items.length > 0 && (
+        <>
+          <div className="mt-4 overflow-x-auto">
+            <table className="w-full min-w-[540px] text-left text-sm">
+              <thead>
+                <tr className="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
+                  <th className="py-2 pr-3 font-medium">Date</th>
+                  <th className="py-2 pr-3 font-medium">Direction</th>
+                  <th className="py-2 pr-3 font-medium">Other party</th>
+                  <th className="py-2 pr-3 text-right font-medium">Amount</th>
+                  <th className="py-2 font-medium">Memo</th>
+                </tr>
+              </thead>
+              <tbody className="divide-y divide-slate-100">
+                {data.items.map((transfer) => {
+                  const outgoing = transfer.direction === "out";
+                  return (
+                    <tr key={transfer.id} className="text-slate-700">
+                      <td className="py-3 pr-3 whitespace-nowrap">
+                        {formatDate(transfer.created_at)}
+                      </td>
+                      <td className="py-3 pr-3">
+                        <span
+                          className={
+                            outgoing
+                              ? "rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700"
+                              : "rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700"
+                          }
+                        >
+                          {outgoing ? "Out" : "In"}
+                        </span>
+                      </td>
+                      <td className="py-3 pr-3">
+                        <span className="text-slate-400">
+                          {outgoing ? "To" : "From"}
+                        </span>{" "}
+                        <span className="font-medium text-slate-900">
+                          {outgoing ? transfer.to_username : transfer.from_username}
+                        </span>
+                      </td>
+                      <td
+                        className={
+                          outgoing
+                            ? "py-3 pr-3 text-right font-medium text-rose-600 whitespace-nowrap"
+                            : "py-3 pr-3 text-right font-medium text-emerald-600 whitespace-nowrap"
+                        }
+                      >
+                        {outgoing ? "−" : "+"}${formatMoney(transfer.amount)}
+                      </td>
+                      <td className="py-3 text-slate-500">
+                        {transfer.memo || "—"}
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          </div>
+
+          <div className="mt-4 flex items-center justify-between">
+            <button
+              type="button"
+              onClick={() => setPage((p) => Math.max(1, p - 1))}
+              disabled={page <= 1}
+              className="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40"
+            >
+              Previous
+            </button>
+            <span className="text-sm text-slate-500">
+              Page {data.page} of {totalPages}
+            </span>
+            <button
+              type="button"
+              onClick={() => setPage((p) => p + 1)}
+              disabled={page >= totalPages}
+              className="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40"
+            >
+              Next
+            </button>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/src/format.ts b/frontend/src/format.ts
new file mode 100644
