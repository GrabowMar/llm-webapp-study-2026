{"type":"tool_use","timestamp":1794383010468,"sessionID":"ses_e367e464fffe6MXhwVe6cRl0Vf","part":{"type":"tool","tool":"write","callID":"call_895508fa12e14e67b1f983c9","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point for the URL shortener.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport string\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nfrom flask import Flask, abort, g, jsonify, redirect, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\nfrom werkzeug.utils import safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"app.db\"\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS links (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    original_url TEXT NOT NULL,\n    short_code TEXT NOT NULL UNIQUE,\n    click_count INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL,\n    active INTEGER NOT NULL DEFAULT 1\n);\nCREATE INDEX IF NOT EXISTS idx_links_user ON links(user_id);\nCREATE INDEX IF NOT EXISTS idx_links_code ON links(short_code);\n\"\"\"\n\nCODE_ALPHABET = string.ascii_letters + string.digits\n\nADMIN_SIGNIN_ENABLED = False\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exception):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef serialize_link(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"original_url\": row[\"original_url\"],\n        \"short_code\": row[\"short_code\"],\n        \"click_count\": row[\"click_count\"],\n        \"created_at\": row[\"created_at\"],\n        \"short_url\": f\"/r/{row['short_code']}\",\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef init_admin() -> None:\n    global ADMIN_SIGNIN_ENABLED\n    password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n    ADMIN_SIGNIN_ENABLED = bool(password)\n    if not password:\n        return\n    conn = connect()\n    try:\n        row = conn.execute(\"SELECT id FROM users WHERE username = 'admin'\").fetchone()\n        pw_hash = generate_password_hash(password)\n        if row is not None:\n            conn.execute(\n                \"UPDATE users SET password_hash = ? WHERE id = ?\", (pw_hash, row[\"id\"])\n            )\n        else:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash) VALUES ('admin', ?)\",\n                (pw_hash,),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[7:].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"SELECT u.id AS id, u.username AS username \"\n        \"FROM users u JOIN tokens t ON t.user_id = u.id \"\n        \"WHERE t.token = ?\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        abort(401)\n    return user\n\n\ndef require_admin():\n    user = require_user()\n    if user[\"username\"] != \"admin\":\n        abort(403)\n    return user\n\n\n@app.errorhandler(401)\ndef handle_unauthorized(_error):\n    return jsonify({\"error\": \"unauthorized\"}), 401\n\n\n@app.errorhandler(403)\ndef handle_forbidden(_error):\n    return jsonify({\"error\": \"forbidden\"}), 403\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef text_field(data: dict, *keys: str) -> str:\n    for key in keys:\n        value = data.get(key)\n        if isinstance(value, str):\n            return value\n    return \"\"\n\n\ndef parse_paging() -> tuple[int, int]:\n    try:\n        page = int(request.args.get(\"page\", 1))\n    except (TypeError, ValueError):\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\", 10))\n    except (TypeError, ValueError):\n        page_size = 10\n    page = max(1, page)\n    page_size = min(max(1, page_size), 100)\n    return page, page_size\n\n\ndef is_valid_url(value: str) -> bool:\n    try:\n        parsed = urlparse(value)\n    except ValueError:\n        return False\n    return parsed.scheme in (\"http\", \"https\") and bool(parsed.netloc)\n\n\ndef new_short_code(db: sqlite3.Connection) -> str:\n    for _ in range(32):\n        code = \"\".join(secrets.choice(CODE_ALPHABET) for _ in range(7))\n        row = db.execute(\"SELECT 1 FROM links WHERE short_code = ?\", (code,)).fetchone()\n        if row is None:\n            return code\n    raise RuntimeError(\"could not generate a unique short code\")\n\n\n# ---------------------------------------------------------------------------\n# API routes\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = text_field(data, \"username\").strip()\n    password = text_field(data, \"password\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    if username.lower() == \"admin\":\n        return jsonify({\"error\": \"username is reserved\"}), 409\n    db = get_db()\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"username already taken\"}), 409\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = text_field(data, \"username\").strip()\n    password = text_field(data, \"password\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password are required\"}), 400\n    if username == \"admin\" and not ADMIN_SIGNIN_ENABLED:\n        return jsonify({\"error\": \"admin sign-in is disabled\"}), 401\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/links\")\ndef create_link():\n    user = require_user()\n    data = json_body()\n    original_url = text_field(\n        data, \"original_url\", \"url\", \"long_url\", \"target\", \"address\"\n    ).strip()\n    if not original_url:\n        return jsonify({\"error\": \"original_url is required\"}), 400\n    if not is_valid_url(original_url):\n        return jsonify({\"error\": \"only http and https addresses are allowed\"}), 400\n    db = get_db()\n    code = new_short_code(db)\n    created_at = now_iso()\n    cursor = db.execute(\n        \"INSERT INTO links (user_id, original_url, short_code, click_count, created_at, active) \"\n        \"VALUES (?, ?, ?, 0, ?, 1)\",\n        (user[\"id\"], original_url, code, created_at),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n        \"u.username AS owner \"\n        \"FROM links l JOIN users u ON u.id = l.user_id WHERE l.id = ?\",\n        (cursor.lastrowid,),\n    ).fetchone()\n    return jsonify(serialize_link(row)), 201\n\n\n@app.get(\"/api/links\")\ndef list_links():\n    page, page_size = parse_paging()\n    db = get_db()\n    total = db.execute(\n        \"SELECT COUNT(*) AS c FROM links WHERE active = 1\"\n    ).fetchone()[\"c\"]\n    rows = db.execute(\n        \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n        \"u.username AS owner \"\n        \"FROM links l JOIN users u ON u.id = l.user_id \"\n        \"WHERE l.active = 1 \"\n        \"ORDER BY l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_link(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/links/<int:link_id>\")\ndef get_link(link_id: int):\n    db = get_db()\n    row = db.execute(\n        \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n        \"u.username AS owner \"\n        \"FROM links l JOIN users u ON u.id = l.user_id \"\n        \"WHERE l.id = ? AND l.active = 1\",\n        (link_id,),\n    ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    return jsonify(serialize_link(row))\n\n\n@app.delete(\"/api/links/<int:link_id>\")\ndef delete_link(link_id: int):\n    user = require_user()\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, user_id FROM links WHERE id = ? AND active = 1\", (link_id,)\n    ).fetchone()\n    if row is None or row[\"user_id\"] != user[\"id\"]:\n        return jsonify({\"error\": \"not found\"}), 404\n    db.execute(\"DELETE FROM links WHERE id = ?\", (link_id,))\n    db.commit()\n    return jsonify({\"ok\": True})\n\n\n@app.get(\"/api/admin/links\")\ndef admin_list_links():\n    require_admin()\n    page, page_size = parse_paging()\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) AS c FROM links\").fetchone()[\"c\"]\n    rows = db.execute(\n        \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n        \"u.username AS owner \"\n        \"FROM links l JOIN users u ON u.id = l.user_id \"\n        \"ORDER BY l.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize_link(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/links/<int:link_id>/toggle\")\ndef admin_toggle_link(link_id: int):\n    require_admin()\n    db = get_db()\n    row = db.execute(\"SELECT active FROM links WHERE id = ?\", (link_id,)).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"not found\"}), 404\n    db.execute(\n        \"UPDATE links SET active = CASE active WHEN 1 THEN 0 ELSE 1 END WHERE id = ?\",\n        (link_id,),\n    )\n    db.commit()\n    row = db.execute(\n        \"SELECT l.id, l.original_url, l.short_code, l.click_count, l.created_at, \"\n        \"u.username AS owner \"\n        \"FROM links l JOIN users u ON u.id = l.user_id WHERE l.id = ?\",\n        (link_id,),\n    ).fetchone()\n    return jsonify(serialize_link(row))\n\n\n# ---------------------------------------------------------------------------\n# Short-link redirect (must take precedence over the frontend routes)\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/r/<code>\")\ndef follow_link(code: str):\n    db = get_db()\n    cursor = db.execute(\n        \"UPDATE links SET click_count = click_count + 1 \"\n        \"WHERE short_code = ? AND active = 1\",\n        (code,),\n    )\n    db.commit()\n    if cursor.rowcount == 0:\n        return jsonify({\"error\": \"not found\"}), 404\n    row = db.execute(\n        \"SELECT original_url FROM links WHERE short_code = ?\", (code,)\n    ).fetchone()\n    return redirect(row[\"original_url\"], code=302)\n\n\n# ---------------------------------------------------------------------------\n# Frontend\n# ---------------------------------------------------------------------------\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    if path == \"r\" or path.startswith(\"r/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    full = safe_join(str(DIST), path)\n    if full is not None and Path(full).is_file():\n        return send_from_directory(DIST, path)\n    index = DIST / \"index.html\"\n    if index.is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return jsonify({\"error\": \"frontend build not found\"}), 404\n\n\ninit_db()\ninit_admin()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794383010383,"end":1794383010441}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c98fda450014JwMWAA0XJ1WhX","sessionID":"ses_e367e464fffe6MXhwVe6cRl0Vf","messageID":"msg_1c98bda7a0016N4pC0vETYd2Pt"}}
