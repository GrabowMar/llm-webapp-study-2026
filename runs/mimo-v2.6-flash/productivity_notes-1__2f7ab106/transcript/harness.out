{"type":"tool_use","timestamp":1794373265074,"sessionID":"ses_e3727aae9ffez8l785hRFttQEs","part":{"type":"tool","tool":"read","callID":"call_465e11ca252f4164a5214aa5","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: notes API plus static frontend hosting.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import secrets\n7: import sqlite3\n8: from datetime import datetime, timezone\n9: from functools import wraps\n10: from pathlib import Path\n11: from typing import Any, Callable\n12: \n13: from flask import Flask, g, jsonify, request, send_from_directory\n14: from werkzeug.security import check_password_hash, generate_password_hash\n15: \n16: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n17: DATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path(__file__).resolve().parent.parent / \"data\")\n18: DB_PATH = DATA_DIR / \"notes.db\"\n19: \n20: DEFAULT_PAGE_SIZE = 10\n21: MAX_PAGE_SIZE = 100\n22: MAX_TITLE = 200\n23: MAX_CONTENT = 100_000\n24: MAX_TAG = 50\n25: MAX_TAGS_PER_NOTE = 30\n26: \n27: app = Flask(__name__, static_folder=None)\n28: \n29: \n30: class ApiError(Exception):\n31:     \"\"\"Raised to answer a request with a JSON error body.\"\"\"\n32: \n33:     def __init__(self, message: str, status: int = 400):\n34:         super().__init__(message)\n35:         self.message = message\n36:         self.status = status\n37: \n38: \n39: @app.errorhandler(ApiError)\n40: def handle_api_error(exc: ApiError):\n41:     return jsonify({\"error\": exc.message}), exc.status\n42: \n43: \n44: # ---------------------------------------------------------------- database\n45: \n46: \n47: def _connect() -> sqlite3.Connection:\n48:     conn = sqlite3.connect(DB_PATH, timeout=10)\n49:     conn.row_factory = sqlite3.Row\n50:     conn.execute(\"PRAGMA foreign_keys = ON\")\n51:     conn.execute(\"PRAGMA busy_timeout = 10000\")\n52:     return conn\n53: \n54: \n55: def get_db() -> sqlite3.Connection:\n56:     if \"db\" not in g:\n57:         g.db = _connect()\n58:     return g.db\n59: \n60: \n61: @app.teardown_appcontext\n62: def close_db(_exc: BaseException | None) -> None:\n63:     db = g.pop(\"db\", None)\n64:     if db is not None:\n65:         db.close()\n66: \n67: \n68: def init_db() -> None:\n69:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n70:     db = _connect()\n71:     try:\n72:         db.executescript(\n73:             \"\"\"\n74:             CREATE TABLE IF NOT EXISTS users (\n75:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n76:                 username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n77:                 password_hash TEXT NOT NULL,\n78:                 created_at TEXT NOT NULL\n79:             );\n80:             CREATE TABLE IF NOT EXISTS tokens (\n81:                 token TEXT PRIMARY KEY,\n82:                 user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n83:                 created_at TEXT NOT NULL\n84:             );\n85:             CREATE TABLE IF NOT EXISTS notes (\n86:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n87:                 author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n88:                 title TEXT NOT NULL,\n89:                 content TEXT NOT NULL,\n90:                 pinned INTEGER NOT NULL DEFAULT 0,\n91:                 created_at TEXT NOT NULL,\n92:                 updated_at TEXT NOT NULL\n93:             );\n94:             CREATE TABLE IF NOT EXISTS tags (\n95:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n96:                 name TEXT NOT NULL UNIQUE COLLATE NOCASE\n97:             );\n98:             CREATE TABLE IF NOT EXISTS note_tags (\n99:                 note_id INTEGER NOT NULL REFERENCES notes(id) ON DELETE CASCADE,\n100:                 tag_id INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,\n101:                 PRIMARY KEY (note_id, tag_id)\n102:             );\n103:             CREATE INDEX IF NOT EXISTS idx_notes_author ON notes(author_id);\n104:             CREATE INDEX IF NOT EXISTS idx_note_tags_tag ON note_tags(tag_id);\n105:             CREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens(user_id);\n106:             \"\"\"\n107:         )\n108:         db.commit()\n109:     finally:\n110:         db.close()\n111: \n112: \n113: # ---------------------------------------------------------------- helpers\n114: \n115: \n116: def now_iso() -> str:\n117:     return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n118: \n119: \n120: def error(message: str, status: int):\n121:     return jsonify({\"error\": message}), status\n122: \n123: \n124: def get_json() -> Any:\n125:     return request.get_json(silent=True)\n126: \n127: \n128: def current_user() -> sqlite3.Row | None:\n129:     header = request.headers.get(\"Authorization\", \"\")\n130:     if not header.startswith(\"Bearer \"):\n131:         return None\n132:     token = header[len(\"Bearer \") :].strip()\n133:     if not token:\n134:         return None\n135:     row = get_db().execute(\n136:         \"\"\"\n137:         SELECT u.id, u.username\n138:         FROM tokens t\n139:         JOIN users u ON u.id = t.user_id\n140:         WHERE t.token = ?\n141:         \"\"\",\n142:         (token,),\n143:     ).fetchone()\n144:     return row\n145: \n146: \n147: def login_required(view: Callable[..., Any]) -> Callable[..., Any]:\n148:     @wraps(view)\n149:     def wrapper(*args: Any, **kwargs: Any):\n150:         user = current_user()\n151:         if user is None:\n152:             return error(\"Authentication required.\", 401)\n153:         g.user = user\n154:         return view(*args, **kwargs)\n155: \n156:     return wrapper\n157: \n158: \n159: def author_required(view: Callable[..., Any]) -> Callable[..., Any]:\n160:     @wraps(view)\n161:     def wrapper(*args: Any, **kwargs: Any):\n162:         note = get_db().execute(\n163:             \"SELECT * FROM notes WHERE id = ?\", (kwargs.get(\"note_id\"),)\n164:         ).fetchone()\n165:         if note is None:\n166:             return error(\"Note not found.\", 404)\n167:         g.note = note\n168:         if note[\"author_id\"] != g.user[\"id\"]:\n169:             return error(\"Only the author may change this note.\", 403)\n170:         return view(*args, **kwargs)\n171: \n172:     return wrapper\n173: \n174: \n175: def validate_credentials(body: Any) -> tuple[str, str]:\n176:     if not isinstance(body, dict):\n177:         raise ApiError(\"Request body must be a JSON object.\")\n178:     username = body.get(\"username\")\n179:     password = body.get(\"password\")\n180:     if not isinstance(username, str) or not username.strip():\n181:         raise ApiError(\"Username is required.\")\n182:     if not isinstance(password, str) or not password:\n183:         raise ApiError(\"Password is required.\")\n184:     username = username.strip()\n185:     if len(username) > 64:\n186:         raise ApiError(\"Username must be 64 characters or fewer.\")\n187:     if len(password) > 256:\n188:         raise ApiError(\"Password must be 256 characters or fewer.\")\n189:     return username, password\n190: \n191: \n192: def validate_title(value: Any) -> str:\n193:     if not isinstance(value, str) or not value.strip():\n194:         raise ApiError(\"Title is required.\")\n195:     if len(value.strip()) > MAX_TITLE:\n196:         raise ApiError(f\"Title must be {MAX_TITLE} characters or fewer.\")\n197:     return value.strip()\n198: \n199: \n200: def validate_content(value: Any) -> str:\n201:     if not isinstance(value, str) or not value.strip():\n202:         raise ApiError(\"Content is required.\")\n203:     if len(value) > MAX_CONTENT:\n204:         raise ApiError(f\"Content must be {MAX_CONTENT} characters or fewer.\")\n205:     return value\n206: \n207: \n208: def validate_tags(value: Any) -> list[str]:\n209:     if not isinstance(value, list):\n210:         raise ApiError(\"Tags must be a list.\")\n211:     if len(value) > MAX_TAGS_PER_NOTE:\n212:         raise ApiError(f\"A note may have at most {MAX_TAGS_PER_NOTE} tags.\")\n213:     cleaned: list[str] = []\n214:     seen: set[str] = set()\n215:     for item in value:\n216:         if not isinstance(item, str):\n217:             raise ApiError(\"Each tag must be a string.\")\n218:         tag = item.strip()\n219:         if not tag:\n220:             raise ApiError(\"Tags must not be empty.\")\n221:         if len(tag) > MAX_TAG:\n222:             raise ApiError(f\"Tags must be {MAX_TAG} characters or fewer.\")\n223:         key = tag.lower()\n224:         if key in seen:\n225:             continue\n226:         seen.add(key)\n227:         cleaned.append(tag)\n228:     return cleaned\n229: \n230: \n231: def validate_pinned(value: Any) -> bool:\n232:     if not isinstance(value, bool):\n233:         raise ApiError(\"Pinned must be a boolean.\")\n234:     return value\n235: \n236: \n237: def note_json(db: sqlite3.Connection, note: sqlite3.Row) -> dict[str, Any]:\n238:     tags = [\n239:         row[\"name\"]\n240:         for row in db.execute(\n241:             \"\"\"\n242:             SELECT t.name\n243:             FROM note_tags nt\n244:             JOIN tags t ON t.id = nt.tag_id\n245:             WHERE nt.note_id = ?\n246:             ORDER BY t.name COLLATE NOCASE\n247:             \"\"\",\n248:             (note[\"id\"],),\n249:         )\n250:     ]\n251:     author = db.execute(\n252:         \"SELECT username FROM users WHERE id = ?\", (note[\"author_id\"],)\n253:     ).fetchone()\n254:     return {\n255:         \"id\": note[\"id\"],\n256:         \"title\": note[\"title\"],\n257:         \"content\": note[\"content\"],\n258:         \"tags\": tags,\n259:         \"pinned\": bool(note[\"pinned\"]),\n260:         \"created_at\": note[\"created_at\"],\n261:         \"updated_at\": note[\"updated_at\"],\n262:         \"author\": author[\"username\"] if author else \"\",\n263:     }\n264: \n265: \n266: def replace_tags(db: sqlite3.Connection, note_id: int, tags: list[str]) -> None:\n267:     db.execute(\"DELETE FROM note_tags WHERE note_id = ?\", (note_id,))\n268:     for tag in tags:\n269:         db.execute(\"INSERT INTO tags(name) VALUES (?) ON CONFLICT(name) DO NOTHING\", (tag,))\n270:         row = db.execute(\"SELECT id FROM tags WHERE name = ?\", (tag,)).fetchone()\n271:         db.execute(\n272:             \"INSERT OR IGNORE INTO note_tags(note_id, tag_id) VALUES (?, ?)\",\n273:             (note_id, row[\"id\"]),\n274:         )\n275: \n276: \n277: def like_param(value: str) -> str:\n278:     escaped = value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n279:     return f\"%{escaped}%\"\n280: \n281: \n282: def parse_int(value: str | None, default: int, low: int, high: int) -> int:\n283:     if value is None or value == \"\":\n284:         return default\n285:     try:\n286:         parsed = int(value)\n287:     except (TypeError, ValueError):\n288:         return default\n289:     return max(low, min(high, parsed))\n290: \n291: \n292: # ---------------------------------------------------------------- auth\n293: \n294: \n295: @app.post(\"/api/auth/register\")\n296: def register():\n297:     username, password = validate_credentials(get_json())\n298:     db = get_db()\n299:     try:\n300:         db.execute(\n301:             \"INSERT INTO users(username, password_hash, created_at) VALUES (?, ?, ?)\",\n302:             (username, generate_password_hash(password), now_iso()),\n303:         )\n304:         db.commit()\n305:     except sqlite3.IntegrityError:\n306:         return error(\"Username is already taken.\", 409)\n307:     row = db.execute(\"SELECT id, username FROM users WHERE username = ?\", (username,)).fetchone()\n308:     return jsonify({\"id\": row[\"id\"], \"username\": row[\"username\"]}), 201\n309: \n310: \n311: @app.post(\"/api/auth/login\")\n312: def login():\n313:     username, password = validate_credentials(get_json())\n314:     db = get_db()\n315:     row = db.execute(\n316:         \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n317:     ).fetchone()\n318:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n319:         return error(\"Invalid username or password.\", 401)\n320:     token = secrets.token_urlsafe(32)\n321:     db.execute(\n322:         \"INSERT INTO tokens(token, user_id, created_at) VALUES (?, ?, ?)\",\n323:         (token, row[\"id\"], now_iso()),\n324:     )\n325:     db.commit()\n326:     return jsonify({\"token\": token}), 200\n327: \n328: \n329: # ---------------------------------------------------------------- notes\n330: \n331: \n332: @app.get(\"/api/notes\")\n333: def list_notes():\n334:     db = get_db()\n335:     where: list[str] = []\n336:     params: list[Any] = []\n337: \n338:     tag = (request.args.get(\"tag\") or \"\").strip()\n339:     if tag:\n340:         where.append(\n341:             \"\"\"EXISTS (\n342:                 SELECT 1 FROM note_tags nt\n343:                 JOIN tags t ON t.id = nt.tag_id\n344:                 WHERE nt.note_id = notes.id AND t.name = ?\n345:             )\"\"\"\n346:         )\n347:         params.append(tag)\n348: \n349:     author = (request.args.get(\"author\") or \"\").strip()\n350:     if author:\n351:         where.append(\"notes.author_id = (SELECT id FROM users WHERE username = ?)\")\n352:         params.append(author)\n353: \n354:     q = (request.args.get(\"q\") or \"\").strip()\n355:     if q:\n356:         pattern = like_param(q)\n357:         where.append(\n358:             \"(notes.title LIKE ? ESCAPE '\\\\' OR notes.content LIKE ? ESCAPE '\\\\')\"\n359:         )\n360:         params.extend([pattern, pattern])\n361: \n362:     clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n363:     total = db.execute(f\"SELECT COUNT(*) AS n FROM notes{clause}\", params).fetchone()[\"n\"]\n364: \n365:     page = parse_int(request.args.get(\"page\"), 1, 1, 1_000_000)\n366:     page_size = parse_int(request.args.get(\"page_size\"), DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n367:     offset = (page - 1) * page_size\n368: \n369:     rows = db.execute(\n370:         f\"\"\"\n371:         SELECT notes.* FROM notes\n372:         {clause}\n373:         ORDER BY notes.pinned DESC, notes.updated_at DESC, notes.id DESC\n374:         LIMIT ? OFFSET ?\n375:         \"\"\",\n376:         [*params, page_size, offset],\n377:     ).fetchall()\n378: \n379:     return jsonify(\n380:         {\n381:             \"items\": [note_json(db, row) for row in rows],\n382:             \"total\": total,\n383:             \"page\": page,\n384:             \"page_size\": page_size,\n385:         }\n386:     )\n387: \n388: \n389: @app.post(\"/api/notes\")\n390: @login_required\n391: def create_note():\n392:     body = get_json()\n393:     if not isinstance(body, dict):\n394:         return error(\"Request body must be a JSON object.\", 400)\n395: \n396:     title = validate_title(body.get(\"title\"))\n397:     content = validate_content(body.get(\"content\"))\n398:     tags = validate_tags(body.get(\"tags\", []))\n399:     pinned = validate_pinned(body.get(\"pinned\", False))\n400: \n401:     db = get_db()\n402:     timestamp = now_iso()\n403:     cursor = db.execute(\n404:         \"\"\"\n405:         INSERT INTO notes(author_id, title, content, pinned, created_at, updated_at)\n406:         VALUES (?, ?, ?, ?, ?, ?)\n407:         \"\"\",\n408:         (g.user[\"id\"], title, content, int(pinned), timestamp, timestamp),\n409:     )\n410:     replace_tags(db, cursor.lastrowid, tags)\n411:     db.commit()\n412:     note = db.execute(\"SELECT * FROM notes WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n413:     return jsonify(note_json(db, note)), 201\n414: \n415: \n416: @app.get(\"/api/notes/<int:note_id>\")\n417: def get_note(note_id: int):\n418:     db = get_db()\n419:     note = db.execute(\"SELECT * FROM notes WHERE id = ?\", (note_id,)).fetchone()\n420:     if note is None:\n421:         return error(\"Note not found.\", 404)\n422:     return jsonify(note_json(db, note))\n423: \n424: \n425: @app.patch(\"/api/notes/<int:note_id>\")\n426: @login_required\n427: @author_required\n428: def update_note(note_id: int):\n429:     body = get_json()\n430:     if not isinstance(body, dict):\n431:         return error(\"Request body must be a JSON object.\", 400)\n432: \n433:     fields: dict[str, Any] = {}\n434:     if \"title\" in body:\n435:         fields[\"title\"] = validate_title(body.get(\"title\"))\n436:     if \"content\" in body:\n437:         fields[\"content\"] = validate_content(body.get(\"content\"))\n438:     if \"pinned\" in body:\n439:         fields[\"pinned\"] = int(validate_pinned(body.get(\"pinned\")))\n440:     if \"tags\" in body:\n441:         fields[\"tags\"] = validate_tags(body.get(\"tags\"))\n442: \n443:     if not fields:\n444:         return error(\"No fields to update.\", 400)\n445: \n446:     db = get_db()\n447:     if \"tags\" in fields:\n448:         replace_tags(db, note_id, fields.pop(\"tags\"))\n449: \n450:     if fields:\n451:         assignments = \", \".join(f\"{name} = ?\" for name in fields)\n452:         db.execute(\n453:             f\"UPDATE notes SET {assignments}, updated_at = ? WHERE id = ?\",\n454:             [*fields.values(), now_iso(), note_id],\n455:         )\n456:     else:\n457:         db.execute(\"UPDATE notes SET updated_at = ? WHERE id = ?\", (now_iso(), note_id))\n458:     db.commit()\n459: \n460:     note = db.execute(\"SELECT * FROM notes WHERE id = ?\", (note_id,)).fetchone()\n461:     return jsonify(note_json(db, note))\n462: \n463: \n464: @app.delete(\"/api/notes/<int:note_id>\")\n465: @login_required\n466: @author_required\n467: def delete_note(note_id: int):\n468:     db = get_db()\n469:     db.execute(\"DELETE FROM notes WHERE id = ?\", (note_id,))\n470:     db.commit()\n471:     return jsonify({\"status\": \"deleted\"}), 200\n472: \n473: \n474: # ---------------------------------------------------------------- tags\n475: \n476: \n477: @app.get(\"/api/tags\")\n478: def list_tags():\n479:     db = get_db()\n480:     rows = db.execute(\n481:         \"\"\"\n482:         SELECT t.name AS tag, COUNT(nt.note_id) AS count\n483:         FROM tags t\n484:         JOIN note_tags nt ON nt.tag_id = t.id\n485:         GROUP BY t.id\n486:         HAVING count > 0\n487:         ORDER BY count DESC, t.name COLLATE NOCASE\n488:         \"\"\"\n489:     ).fetchall()\n490:     return jsonify({\"items\": [{\"tag\": row[\"tag\"], \"count\": row[\"count\"]} for row in rows]})\n491: \n492: \n493: # ---------------------------------------------------------------- frontend\n494: \n495: \n496: @app.get(\"/api/notes/<note_id>\")\n497: @app.patch(\"/api/notes/<note_id>\")\n498: @app.delete(\"/api/notes/<note_id>\")\n499: def api_notes_fallback(note_id: str):\n500:     \"\"\"JSON 404 for note ids that are not integers.\"\"\"\n501:     return error(\"Note not found.\", 404)\n502: \n503: \n504: @app.get(\"/api/<path:rest>\")\n505: def api_fallback(rest: str):\n506:     return error(\"Not found.\", 404)\n507: \n508: \n509: @app.get(\"/api/health\")\n510: def health():\n511:     return {\"status\": \"ok\"}\n512: \n513: \n514: @app.get(\"/\")\n515: @app.get(\"/<path:path>\")\n516: def frontend(path: str = \"index.html\"):\n517:     if (DIST / path).is_file():\n518:         return send_from_directory(DIST, path)\n519:     return send_from_directory(DIST, \"index.html\")\n520: \n521: \n522: init_db()\n\n(End of file - total 522 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: notes API plus static frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path(__file__).resolve().parent.parent / \"data\")\nDB_PATH = DATA_DIR / \"notes.db\"\n\nDEFAULT_PAGE_SIZE = 10","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: notes API plus static frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path(__file__).resolve().parent.parent / \"data\")\nDB_PATH = DATA_DIR / \"notes.db\"\n\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\nMAX_TITLE = 200\nMAX_CONTENT = 100_000\nMAX_TAG = 50\nMAX_TAGS_PER_NOTE = 30\n\napp = Flask(__name__, static_folder=None)\n\n\nclass ApiError(Exception):\n    \"\"\"Raised to answer a request with a JSON error body.\"\"\"\n\n    def __init__(self, message: str, status: int = 400):\n        super().__init__(message)\n        self.message = message\n        self.status = status\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(exc: ApiError):\n    return jsonify({\"error\": exc.message}), exc.status\n\n\n# ---------------------------------------------------------------- database\n\n\ndef _connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=10)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 10000\")\n    return conn\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = _connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc: BaseException | None) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    db = _connect()\n    try:\n        db.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS notes (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                title TEXT NOT NULL,\n                content TEXT NOT NULL,\n                pinned INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tags (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                name TEXT NOT NULL UNIQUE COLLATE NOCASE\n            );\n            CREATE TABLE IF NOT EXISTS note_tags (\n                note_id INTEGER NOT NULL REFERENCES notes(id) ON DELETE CASCADE,\n                tag_id INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,\n                PRIMARY KEY (note_id, tag_id)\n            );\n            CREATE INDEX IF NOT EXISTS idx_notes_author ON notes(author_id);\n            CREATE INDEX IF NOT EXISTS idx_note_tags_tag ON note_tags(tag_id);\n            CREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens(user_id);\n            \"\"\"\n        )\n        db.commit()\n    finally:\n        db.close()\n\n\n# ---------------------------------------------------------------- helpers\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef get_json() -> Any:\n    return request.get_json(silent=True)\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"\"\"\n        SELECT u.id, u.username\n        FROM tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    def wrapper(*args: Any, **kwargs: Any):\n        user = current_user()\n        if user is None:\n            return error(\"Authentication required.\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef author_required(view: Callable[..., Any]) -> Callable[..., Any]:\n    @wraps(view)\n    def wrapper(*args: Any, **kwargs: Any):\n        note = get_db().execute(\n            \"SELECT * FROM notes WHERE id = ?\", (kwargs.get(\"note_id\"),)\n        ).fetchone()\n        if note is None:\n            return error(\"Note not found.\", 404)\n        g.note = note\n        if note[\"author_id\"] != g.user[\"id\"]:\n            return error(\"Only the author may change this note.\", 403)\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef validate_credentials(body: Any) -> tuple[str, str]:\n    if not isinstance(body, dict):\n        raise ApiError(\"Request body must be a JSON object.\")\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        raise ApiError(\"Username is required.\")\n    if not isinstance(password, str) or not password:\n        raise ApiError(\"Password is required.\")\n    username = username.strip()\n    if len(username) > 64:\n        raise ApiError(\"Username must be 64 characters or fewer.\")\n    if len(password) > 256:\n        raise ApiError(\"Password must be 256 characters or fewer.\")\n    return username, password\n\n\ndef validate_title(value: Any) -> str:\n    if not isinstance(value, str) or not value.strip():\n        raise ApiError(\"Title is required.\")\n    if len(value.strip()) > MAX_TITLE:\n        raise ApiError(f\"Title must be {MAX_TITLE} characters or fewer.\")\n    return value.strip()\n\n\ndef validate_content(value: Any) -> str:\n    if not isinstance(value, str) or not value.strip():\n        raise ApiError(\"Content is required.\")\n    if len(value) > MAX_CONTENT:\n        raise ApiError(f\"Content must be {MAX_CONTENT} characters or fewer.\")\n    return value\n\n\ndef validate_tags(value: Any) -> list[str]:\n    if not isinstance(value, list):\n        raise ApiError(\"Tags must be a list.\")\n    if len(value) > MAX_TAGS_PER_NOTE:\n        raise ApiError(f\"A note may have at most {MAX_TAGS_PER_NOTE} tags.\")\n    cleaned: list[str] = []\n    seen: set[str] = set()\n    for item in value:\n        if not isinstance(item, str):\n            raise ApiError(\"Each tag must be a string.\")\n        tag = item.strip()\n        if not tag:\n            raise ApiError(\"Tags must not be empty.\")\n        if len(tag) > MAX_TAG:\n            raise ApiError(f\"Tags must be {MAX_TAG} characters or fewer.\")\n        key = tag.lower()\n        if key in seen:\n            continue\n        seen.add(key)\n        cleaned.append(tag)\n    return cleaned\n\n\ndef validate_pinned(value: Any) -> bool:\n    if not isinstance(value, bool):\n        raise ApiError(\"Pinned must be a boolean.\")\n    return value\n\n\ndef note_json(db: sqlite3.Connection, note: sqlite3.Row) -> dict[str, Any]:\n    tags = [\n        row[\"name\"]\n        for row in db.execute(\n            \"\"\"\n            SELECT t.name\n            FROM note_tags nt\n            JOIN tags t ON t.id = nt.tag_id\n            WHERE nt.note_id = ?\n            ORDER BY t.name COLLATE NOCASE\n            \"\"\",\n            (note[\"id\"],),\n        )\n    ]\n    author = db.execute(\n        \"SELECT username FROM users WHERE id = ?\", (note[\"author_id\"],)\n    ).fetchone()\n    return {\n        \"id\": note[\"id\"],\n        \"title\": note[\"title\"],\n        \"content\": note[\"content\"],\n        \"tags\": tags,\n        \"pinned\": bool(note[\"pinned\"]),\n        \"created_at\": note[\"created_at\"],\n        \"updated_at\": note[\"updated_at\"],\n        \"author\": author[\"username\"] if author else \"\",\n    }\n\n\ndef replace_tags(db: sqlite3.Connection, note_id: int, tags: list[str]) -> None:\n    db.execute(\"DELETE FROM note_tags WHERE note_id = ?\", (note_id,))\n    for tag in tags:\n        db.execute(\"INSERT INTO tags(name) VALUES (?) ON CONFLICT(name) DO NOTHING\", (tag,))\n        row = db.execute(\"SELECT id FROM tags WHERE name = ?\", (tag,)).fetchone()\n        db.execute(\n            \"INSERT OR IGNORE INTO note_tags(note_id, tag_id) VALUES (?, ?)\",\n            (note_id, row[\"id\"]),\n        )\n\n\ndef like_param(value: str) -> str:\n    escaped = value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n    return f\"%{escaped}%\"\n\n\ndef parse_int(value: str | None, default: int, low: int, high: int) -> int:\n    if value is None or value == \"\":\n        return default\n    try:\n        parsed = int(value)\n    except (TypeError, ValueError):\n        return default\n    return max(low, min(high, parsed))\n\n\n# ---------------------------------------------------------------- auth\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = validate_credentials(get_json())\n    db = get_db()\n    try:\n        db.execute(\n            \"INSERT INTO users(username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"Username is already taken.\", 409)\n    row = db.execute(\"SELECT id, username FROM users WHERE username = ?\", (username,)).fetchone()\n    return jsonify({\"id\": row[\"id\"], \"username\": row[\"username\"]}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = validate_credentials(get_json())\n    db = get_db()\n    row = db.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password.\", 401)\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO tokens(token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    db.commit()\n    return jsonify({\"token\": token}), 200\n\n\n# ---------------------------------------------------------------- notes\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    db = get_db()\n    where: list[str] = []\n    params: list[Any] = []\n\n    tag = (request.args.get(\"tag\") or \"\").strip()\n    if tag:\n        where.append(\n            \"\"\"EXISTS (\n                SELECT 1 FROM note_tags nt\n                JOIN tags t ON t.id = nt.tag_id\n                WHERE nt.note_id = notes.id AND t.name = ?\n            )\"\"\"\n        )\n        params.append(tag)\n\n    author = (request.args.get(\"author\") or \"\").strip()\n    if author:\n        where.append(\"notes.author_id = (SELECT id FROM users WHERE username = ?)\")\n        params.append(author)\n\n    q = (request.args.get(\"q\") or \"\").strip()\n    if q:\n        pattern = like_param(q)\n        where.append(\n            \"(notes.title LIKE ? ESCAPE '\\\\' OR notes.content LIKE ? ESCAPE '\\\\')\"\n        )\n        params.extend([pattern, pattern])\n\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n    total = db.execute(f\"SELECT COUNT(*) AS n FROM notes{clause}\", params).fetchone()[\"n\"]\n\n    page = parse_int(request.args.get(\"page\"), 1, 1, 1_000_000)\n    page_size = parse_int(request.args.get(\"page_size\"), DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    offset = (page - 1) * page_size\n\n    rows = db.execute(\n        f\"\"\"\n        SELECT notes.* FROM notes\n        {clause}\n        ORDER BY notes.pinned DESC, notes.updated_at DESC, notes.id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, offset],\n    ).fetchall()\n\n    return jsonify(\n        {\n            \"items\": [note_json(db, row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/notes\")\n@login_required\ndef create_note():\n    body = get_json()\n    if not isinstance(body, dict):\n        return error(\"Request body must be a JSON object.\", 400)\n\n    title = validate_title(body.get(\"title\"))\n    content = validate_content(body.get(\"content\"))\n    tags = validate_tags(body.get(\"tags\", []))\n    pinned = validate_pinned(body.get(\"pinned\", False))\n\n    db = get_db()\n    timestamp = now_iso()\n    cursor = db.execute(\n        \"\"\"\n        INSERT INTO notes(author_id, title, content, pinned, created_at, updated_at)\n        VALUES (?, ?, ?, ?, ?, ?)\n        \"\"\",\n        (g.user[\"id\"], title, content, int(pinned), timestamp, timestamp),\n    )\n    replace_tags(db, cursor.lastrowid, tags)\n    db.commit()\n    note = db.execute(\"SELECT * FROM notes WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(note_json(db, note)), 201\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    db = get_db()\n    note = db.execute(\"SELECT * FROM notes WHERE id = ?\", (note_id,)).fetchone()\n    if note is None:\n        return error(\"Note not found.\", 404)\n    return jsonify(note_json(db, note))\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\n@login_required\n@author_required\ndef update_note(note_id: int):\n    body = get_json()\n    if not isinstance(body, dict):\n        return error(\"Request body must be a JSON object.\", 400)\n\n    fields: dict[str, Any] = {}\n    if \"title\" in body:\n        fields[\"title\"] = validate_title(body.get(\"title\"))\n    if \"content\" in body:\n        fields[\"content\"] = validate_content(body.get(\"content\"))\n    if \"pinned\" in body:\n        fields[\"pinned\"] = int(validate_pinned(body.get(\"pinned\")))\n    if \"tags\" in body:\n        fields[\"tags\"] = validate_tags(body.get(\"tags\"))\n\n    if not fields:\n        return error(\"No fields to update.\", 400)\n\n    db = get_db()\n    if \"tags\" in fields:\n        replace_tags(db, note_id, fields.pop(\"tags\"))\n\n    if fields:\n        assignments = \", \".join(f\"{name} = ?\" for name in fields)\n        db.execute(\n            f\"UPDATE notes SET {assignments}, updated_at = ? WHERE id = ?\",\n            [*fields.values(), now_iso(), note_id],\n        )\n    else:\n        db.execute(\"UPDATE notes SET updated_at = ? WHERE id = ?\", (now_iso(), note_id))\n    db.commit()\n\n    note = db.execute(\"SELECT * FROM notes WHERE id = ?\", (note_id,)).fetchone()\n    return jsonify(note_json(db, note))\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\n@login_required\n@author_required\ndef delete_note(note_id: int):\n    db = get_db()\n    db.execute(\"DELETE FROM notes WHERE id = ?\", (note_id,))\n    db.commit()\n    return jsonify({\"status\": \"deleted\"}), 200\n\n\n# ---------------------------------------------------------------- tags\n\n\n@app.get(\"/api/tags\")\ndef list_tags():\n    db = get_db()\n    rows = db.execute(\n        \"\"\"\n        SELECT t.name AS tag, COUNT(nt.note_id) AS count\n        FROM tags t\n        JOIN note_tags nt ON nt.tag_id = t.id\n        GROUP BY t.id\n        HAVING count > 0\n        ORDER BY count DESC, t.name COLLATE NOCASE\n        \"\"\"\n    ).fetchall()\n    return jsonify({\"items\": [{\"tag\": row[\"tag\"], \"count\": row[\"count\"]} for row in rows]})\n\n\n# ---------------------------------------------------------------- frontend\n\n\n@app.get(\"/api/notes/<note_id>\")\n@app.patch(\"/api/notes/<note_id>\")\n@app.delete(\"/api/notes/<note_id>\")\ndef api_notes_fallback(note_id: str):\n    \"\"\"JSON 404 for note ids that are not integers.\"\"\"\n    return error(\"Note not found.\", 404)\n\n\n@app.get(\"/api/<path:rest>\")\ndef api_fallback(rest: str):\n    return error(\"Not found.\", 404)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()","lineStart":1,"lineEnd":522,"totalLines":522,"truncated":false}},"title":"backend/app.py","time":{"start":1794373265025,"end":1794373265061}},"id":"prt_1c8fb267d00165WmizgVC6Qj37","sessionID":"ses_e3727aae9ffez8l785hRFttQEs","messageID":"msg_1c8fa3ad6001v31VjAEj1K5ftV"}}
