{"type":"tool_use","timestamp":1794371573647,"sessionID":"ses_e3727aae9ffez8l785hRFttQEs","part":{"type":"tool","tool":"write","callID":"call_621e2443a9aa4a8597a3f2a8","state":{"status":"completed","input":{"content":"\"\"\"Temporary API smoke test.\"\"\"\nimport os\nimport shutil\nimport sys\n\nos.environ[\"DATA_DIR\"] = \"/workspace/.tmpdata\"\nshutil.rmtree(\"/workspace/.tmpdata\", ignore_errors=True)\n\nsys.path.insert(0, \"/workspace/backend\")\nfrom app import app  # noqa: E402\n\nc = app.test_client()\n\nfailures = []\n\n\ndef check(name, cond, extra=\"\"):\n    if cond:\n        print(f\"ok  {name}\")\n    else:\n        failures.append(name)\n        print(f\"FAIL {name} {extra}\")\n\n\nr = c.get(\"/api/health\")\ncheck(\"health\", r.status_code == 200 and r.get_json() == {\"status\": \"ok\"}, r.get_json())\n\nr = c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"register 201\", r.status_code == 201, r.get_json())\nr = c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"register dup 409\", r.status_code == 409, r.get_json())\nr = c.post(\"/api/auth/register\", json={\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", r.status_code == 400 and \"error\" in r.get_json(), r.get_json())\n\nr = c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login bad 401\", r.status_code == 401, r.get_json())\nr = c.post(\"/api/auth/login\", json={\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"login 200 token\", r.status_code == 200 and isinstance(r.get_json().get(\"token\"), str), r.get_json())\ntoken = r.get_json()[\"token\"]\nauth = {\"Authorization\": f\"Bearer {token}\"}\n\nr = c.post(\"/api/auth/login\", json={\"username\": \"bob\", \"password\": \"secret2\"})\ntoken_bob = r.get_json()[\"token\"]\nauth_bob = {\"Authorization\": f\"Bearer {token_bob}\"}\n\nr = c.post(\"/api/notes\", json={\"title\": \"t\", \"content\": \"c\"})\ncheck(\"create no auth 401\", r.status_code == 401, r.get_json())\n\nr = c.post(\"/api/notes\", json={\"title\": \"\", \"content\": \"c\"}, headers=auth)\ncheck(\"create empty title 400\", r.status_code == 400 and r.get_json()[\"error\"] == \"Title is required.\", r.get_json())\nr = c.post(\"/api/notes\", json={\"title\": \"t\", \"content\": \"\"}, headers=auth)\ncheck(\"create empty content 400\", r.status_code == 400 and r.get_json()[\"error\"] == \"Content is required.\", r.get_json())\nr = c.post(\"/api/notes\", json={\"title\": \"t\", \"content\": \"c\", \"tags\": \"x\"}, headers=auth)\ncheck(\"tags not list 400\", r.status_code == 400, r.get_json())\nr = c.post(\"/api/notes\", json={\"title\": \"t\", \"content\": \"c\", \"pinned\": \"yes\"}, headers=auth)\ncheck(\"pinned not bool 400\", r.status_code == 400, r.get_json())\n\nn1 = c.post(\n    \"/api/notes\",\n    json={\"title\": \"First note\", \"content\": \"hello world\\nsecond line\", \"tags\": [\"python\", \"flask\"], \"pinned\": False},\n    headers=auth,\n).get_json()\ncheck(\"create 201\", n1.get(\"id\") and n1[\"author\"] == \"alice\" and n1[\"tags\"] == [\"flask\", \"python\"], n1)\ncheck(\"timestamps\", n1[\"created_at\"] == n1[\"updated_at\"], n1)\n\nn2 = c.post(\n    \"/api/notes\",\n    json={\"title\": \"Pinned note\", \"content\": \"important stuff\", \"tags\": [\"python\"], \"pinned\": True},\n    headers=auth,\n).get_json()\nn3 = c.post(\n    \"/api/notes\",\n    json={\"title\": \"Bob note\", \"content\": \"bob writes\", \"tags\": [\"misc\"]},\n    headers=auth_bob,\n).get_json()\n\nr = c.get(\"/api/notes\")\ndata = r.get_json()\ncheck(\"list shape\", set(data) == {\"items\", \"total\", \"page\", \"page_size\"}, data)\ncheck(\"list total 3\", data[\"total\"] == 3, data)\ncheck(\"pinned first\", data[\"items\"][0][\"id\"] == n2[\"id\"], [i[\"id\"] for i in data[\"items\"]])\ncheck(\"item shape\", set(data[\"items\"][0]) == {\n    \"id\", \"title\", \"content\", \"tags\", \"pinned\", \"created_at\", \"updated_at\", \"author\"\n}, data[\"items\"][0])\n\nr = c.get(\"/api/notes?tag=flask\")\ncheck(\"filter tag\", r.get_json()[\"total\"] == 1 and r.get_json()[\"items\"][0][\"id\"] == n1[\"id\"], r.get_json())\nr = c.get(\"/api/notes?tag=PYTHON\")\ncheck(\"filter tag case\", r.get_json()[\"total\"] == 2, r.get_json())\nr = c.get(\"/api/notes?author=bob\")\ncheck(\"filter author\", r.get_json()[\"total\"] == 1 and r.get_json()[\"items\"][0][\"author\"] == \"bob\", r.get_json())\nr = c.get(\"/api/notes?q=important\")\ncheck(\"filter q\", r.get_json()[\"total\"] == 1 and r.get_json()[\"items\"][0][\"id\"] == n2[\"id\"], r.get_json())\nr = c.get(\"/api/notes?q=%25\")\ncheck(\"q wildcard literal\", r.get_json()[\"total\"] == 0, r.get_json())\nr = c.get(\"/api/notes?page=2&page_size=2\")\ncheck(\"paging\", r.get_json()[\"total\"] == 3 and r.get_json()[\"page\"] == 2 and len(r.get_json()[\"items\"]) == 1, r.get_json())\n\nr = c.get(f\"/api/notes/{n1['id']}\")\ncheck(\"get one\", r.status_code == 200 and r.get_json()[\"title\"] == \"First note\", r.get_json())\nr = c.get(\"/api/notes/999999\")\ncheck(\"get missing 404\", r.status_code == 404, r.get_json())\n\nr = c.get(f\"/api/notes/{n1['id']}\")\nbefore = r.get_json()[\"updated_at\"]\nimport time\ntime.sleep(1.1)\nr = c.patch(f\"/api/notes/{n1['id']}\", json={\"title\": \"Renamed\"}, headers=auth)\npatched = r.get_json()\ncheck(\"patch 200\", r.status_code == 200, patched)\ncheck(\"patch partial keeps content\", patched[\"content\"] == \"hello world\\nsecond line\" and patched[\"title\"] == \"Renamed\", patched)\ncheck(\"patch updated_at changes\", patched[\"updated_at\"] > before, (before, patched[\"updated_at\"]))\n\nr = c.patch(f\"/api/notes/{n1['id']}\", json={\"pinned\": True}, headers=auth)\ncheck(\"patch pinned\", r.get_json()[\"pinned\"] is True, r.get_json())\nr = c.patch(f\"/api/notes/{n1['id']}\", json={\"tags\": [\"newtag\"]}, headers=auth)\ncheck(\"patch tags\", r.get_json()[\"tags\"] == [\"newtag\"], r.get_json())\nr = c.patch(f\"/api/notes/{n1['id']}\", json={\"title\": \"x\"}, headers=auth_bob)\ncheck(\"patch by other 403\", r.status_code == 403, r.get_json())\nr = c.patch(f\"/api/notes/{n1['id']}\", json={\"title\": \"x\"})\ncheck(\"patch no auth 401\", r.status_code == 401, r.get_json())\nr = c.patch(f\"/api/notes/{n1['id']}\", json={}, headers=auth)\ncheck(\"patch empty 400\", r.status_code == 400, r.get_json())\n\nr = c.delete(f\"/api/notes/{n1['id']}\", headers=auth_bob)\ncheck(\"delete by other 403\", r.status_code == 403, r.get_json())\nr = c.delete(f\"/api/notes/{n1['id']}\", headers=auth)\ncheck(\"delete own\", r.status_code == 200, r.get_json())\nr = c.get(f\"/api/notes/{n1['id']}\")\ncheck(\"deleted gone\", r.status_code == 404, r.get_json())\n\nr = c.get(\"/api/tags\")\ntags = r.get_json()\ncheck(\"tags shape\", set(tags) == {\"items\"}, tags)\ncheck(\"tags counts\", tags[\"items\"][0] == {\"tag\": \"python\", \"count\": 1} or tags[\"items\"][0][\"count\"] >= 1, tags)\ncheck(\"tags sorted desc\", all(\n    tags[\"items\"][i][\"count\"] >= tags[\"items\"][i + 1][\"count\"] for i in range(len(tags[\"items\"]) - 1)\n), tags)\nprint(tags)\n\nr = c.get(\"/api/notes?tag=nosuchtag\")\ncheck(\"tag no match\", r.status_code == 200 and r.get_json()[\"total\"] == 0, r.get_json())\n\nr = c.get(\"/\")\ncheck(\"frontend fallback\", r.status_code == 200)\n\nprint()\nif failures:\n    print(\"FAILURES:\", failures)\n    sys.exit(1)\nprint(\"all passed\")\n","filePath":"/workspace/_test_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/_test_api.py","exists":false,"truncated":false},"title":"_test_api.py","time":{"start":1794371573598,"end":1794371573614}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8e15754001HDuQej1SGrhwIE","sessionID":"ses_e3727aae9ffez8l785hRFttQEs","messageID":"msg_1c8e03ec8001SKsLldIa4QUnCx"}}
