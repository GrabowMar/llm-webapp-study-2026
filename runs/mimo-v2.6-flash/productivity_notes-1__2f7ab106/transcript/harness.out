{"type":"tool_use","timestamp":1794373001533,"sessionID":"ses_e3727aae9ffez8l785hRFttQEs","part":{"type":"tool","tool":"write","callID":"call_d25cf22991ed4f81af182c0d","state":{"status":"completed","input":{"content":"\"\"\"Final end-to-end verification against a running server.\"\"\"\nimport json\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nBASE = \"http://127.0.0.1:8000\"\nfailures = []\n\n\ndef call(method, path, body=None, token=None, raw=None):\n    data = None\n    headers = {}\n    if raw is not None:\n        data = raw.encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    elif body is not None:\n        data = json.dumps(body).encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    req = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req) as res:\n            payload = res.read().decode()\n            return res.status, json.loads(payload) if payload else None\n    except urllib.error.HTTPError as err:\n        payload = err.read().decode()\n        return err.code, json.loads(payload) if payload else None\n\n\ndef check(name, cond, extra=\"\"):\n    if cond:\n        print(f\"ok  {name}\")\n    else:\n        failures.append(name)\n        print(f\"FAIL {name} {extra}\")\n\n\ndef main():\n    status, body = call(\"GET\", \"/api/health\")\n    check(\"health\", status == 200 and body == {\"status\": \"ok\"}, body)\n\n    with urllib.request.urlopen(BASE + \"/\") as res:\n        html = res.read().decode()\n    check(\"frontend html\", \"Tagged Notes\" in html and 'type=\"module\"' in html)\n    asset = html.split('src=\"')[1].split('\"')[0]\n    with urllib.request.urlopen(BASE + asset) as res:\n        check(\"frontend js asset\", res.status == 200 and len(res.read()) > 1000)\n    css = html.split('href=\"')[1].split('\"')[0]\n    with urllib.request.urlopen(BASE + css) as res:\n        check(\"frontend css asset\", res.status == 200 and b\"tailwind\" in res.read().lower() or res.status == 200)\n\n    status, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"ada\", \"password\": \"lovelace1\"})\n    check(\"register 201\", status == 201, body)\n    status, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"ada\", \"password\": \"lovelace1\"})\n    check(\"register duplicate 409\", status == 409, body)\n    status, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"ada\", \"password\": \"nope\"})\n    check(\"login bad 401\", status == 401, body)\n    status, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"ada\", \"password\": \"lovelace1\"})\n    check(\"login 200\", status == 200 and isinstance(body.get(\"token\"), str), body)\n    token = body[\"token\"]\n\n    status, body = call(\"POST\", \"/api/auth/register\", {\"username\": \"grace\", \"password\": \"hopper12\"})\n    check(\"second user\", status == 201, body)\n    status, body = call(\"POST\", \"/api/auth/login\", {\"username\": \"grace\", \"password\": \"hopper12\"})\n    token2 = body[\"token\"]\n\n    status, body = call(\"POST\", \"/api/notes\", {\"title\": \"t\", \"content\": \"c\"}, token=\"bad-token\")\n    check(\"write with bad token 401\", status == 401, body)\n\n    status, body = call(\n        \"POST\",\n        \"/api/notes\",\n        {\"title\": \"Alpha note\", \"content\": \"first\\nsecond\", \"tags\": [\"work\", \"urgent\"], \"pinned\": True},\n        token=token,\n    )\n    check(\"create note 201\", status == 201 and body[\"author\"] == \"ada\", body)\n    note1 = body\n\n    status, body = call(\n        \"POST\",\n        \"/api/notes\",\n        {\"title\": \"Beta note\", \"content\": \"plain content\", \"tags\": [\"work\"]},\n        token=token,\n    )\n    note2 = body\n    status, body = call(\n        \"POST\",\n        \"/api/notes\",\n        {\"title\": \"Gamma note\", \"content\": \"from grace\", \"tags\": [\"personal\"]},\n        token=token2,\n    )\n    note3 = body\n\n    status, body = call(\"GET\", \"/api/notes\")\n    check(\n        \"list shape\",\n        status == 200 and set(body) == {\"items\", \"total\", \"page\", \"page_size\"} and body[\"total\"] == 3,\n        body,\n    )\n    check(\"pinned first\", body[\"items\"][0][\"id\"] == note1[\"id\"], body[\"items\"])\n    check(\n        \"note shape\",\n        set(body[\"items\"][0])\n        == {\"id\", \"title\", \"content\", \"tags\", \"pinned\", \"created_at\", \"updated_at\", \"author\"},\n        body[\"items\"][0],\n    )\n\n    status, body = call(\"GET\", \"/api/notes?tag=work\")\n    check(\"tag filter\", body[\"total\"] == 2, body)\n    status, body = call(\"GET\", \"/api/notes?author=grace\")\n    check(\"author filter\", body[\"total\"] == 1 and body[\"items\"][0][\"id\"] == note3[\"id\"], body)\n    status, body = call(\"GET\", \"/api/notes?q=first\")\n    check(\"search filter\", body[\"total\"] == 1 and body[\"items\"][0][\"id\"] == note1[\"id\"], body)\n    status, body = call(\"GET\", \"/api/notes?page=2&page_size=2\")\n    check(\"paging\", body[\"total\"] == 3 and body[\"page\"] == 2 and len(body[\"items\"]) == 1, body)\n\n    status, body = call(\"GET\", f\"/api/notes/{note2['id']}\")\n    check(\"get one\", status == 200 and body[\"title\"] == \"Beta note\", body)\n    status, body = call(\"GET\", \"/api/notes/999999\")\n    check(\"get missing 404\", status == 404 and \"error\" in body, body)\n    status, body = call(\"GET\", \"/api/notes/not-a-number\")\n    check(\"get non-int 404 json\", status == 404 and \"error\" in body, body)\n\n    before = call(\"GET\", f\"/api/notes/{note2['id']}\")[1][\"updated_at\"]\n    time.sleep(0.05)\n    status, body = call(\"PATCH\", f\"/api/notes/{note2['id']}\", {\"title\": \"Beta renamed\"}, token=token)\n    check(\"patch 200\", status == 200, body)\n    check(\"patch partial\", body[\"title\"] == \"Beta renamed\" and body[\"content\"] == \"plain content\", body)\n    check(\"patch bumps updated_at\", body[\"updated_at\"] > before, (before, body[\"updated_at\"]))\n\n    status, body = call(\"PATCH\", f\"/api/notes/{note2['id']}\", {\"pinned\": True}, token=token)\n    check(\"patch pinned\", body[\"pinned\"] is True, body)\n    status, body = call(\"PATCH\", f\"/api/notes/{note2['id']}\", {\"tags\": [\"work\", \"later\"]}, token=token)\n    check(\"patch tags\", body[\"tags\"] == [\"later\", \"work\"] or body[\"tags\"] == [\"work\", \"later\"], body)\n\n    status, body = call(\"PATCH\", f\"/api/notes/{note2['id']}\", {\"title\": \"hack\"}, token=token2)\n    check(\"patch foreign 403\", status == 403, body)\n    status, body = call(\"DELETE\", f\"/api/notes/{note2['id']}\", token=token2)\n    check(\"delete foreign 403\", status == 403, body)\n    status, body = call(\"PATCH\", f\"/api/notes/{note2['id']}\", {\"title\": \"x\"})\n    check(\"patch anonymous 401\", status == 401, body)\n\n    status, body = call(\"POST\", \"/api/notes\", {\"title\": \"\", \"content\": \"c\"}, token=token)\n    check(\"validation message\", status == 400 and body == {\"error\": \"Title is required.\"}, body)\n    status, body = call(\"POST\", \"/api/notes\", {\"title\": \"t\", \"content\": \"c\", \"tags\": [1]}, token=token)\n    check(\"validation tags\", status == 400 and \"tag\" in body[\"error\"].lower(), body)\n    status, body = call(\"POST\", \"/api/notes\", {\"title\": \"t\", \"content\": \"c\", \"pinned\": \"yes\"}, token=token)\n    check(\"validation pinned\", status == 400, body)\n\n    status, body = call(\"GET\", \"/api/tags\")\n    tags = body[\"items\"]\n    check(\n        \"tags endpoint\",\n        status == 200\n        and {\"tag\": \"work\", \"count\": 2} in tags\n        and tags[0][\"count\"] >= tags[-1][\"count\"],\n        body,\n    )\n\n    status, body = call(\"DELETE\", f\"/api/notes/{note1['id']}\", token=token)\n    check(\"delete own 200\", status == 200, body)\n    status, body = call(\"GET\", f\"/api/notes/{note1['id']}\")\n    check(\"deleted 404\", status == 404, body)\n    status, body = call(\"GET\", \"/api/tags\")\n    check(\"tag counts drop\", {\"tag\": \"urgent\", \"count\": 0} not in body[\"items\"], body)\n\n    status, body = call(\"GET\", \"/api/definitely-missing\")\n    check(\"unknown api 404 json\", status == 404 and \"error\" in body, body)\n\n    print()\n    if failures:\n        print(\"FAILURES:\", failures)\n        sys.exit(1)\n    print(\"all checks passed\")\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/workspace/_verify.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/_verify.py","exists":false,"truncated":false},"title":"_verify.py","time":{"start":1794373001439,"end":1794373001471}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8f720cd001L3EPb54NjLFQRb","sessionID":"ses_e3727aae9ffez8l785hRFttQEs","messageID":"msg_1c8f617ba001UKZSOPnRsizWSu"}}
