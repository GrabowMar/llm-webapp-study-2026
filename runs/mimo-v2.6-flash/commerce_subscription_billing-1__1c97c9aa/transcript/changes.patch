+@app.get("/api/subscriptions")
+@require_auth
+def list_subscriptions():
+    args = request.args
+    clauses: list[str] = []
+    params: list[Any] = []
+
+    query = args.get("q", "").strip()
+    if query:
+        escaped = (
+            query.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+        )
+        clauses.append("customer_name LIKE ? ESCAPE '\\'")
+        params.append(f"%{escaped}%")
+
+    status = args.get("status", "").strip()
+    if status:
+        clauses.append("REPLACE(status, '-', '_') = ?")
+        params.append(canonical_status(status))
+
+    plan = args.get("plan", "").strip()
+    if plan:
+        clauses.append("plan = ?")
+        params.append(plan)
+
+    where = f"WHERE {' AND '.join(clauses)}" if clauses else ""
+
+    try:
+        page = int(args.get("page", 1))
+        page_size = int(args.get("page_size", DEFAULT_PAGE_SIZE))
+    except ValueError:
+        raise ValidationError("page and page_size must be integers") from None
+    if page < 1:
+        raise ValidationError("page must be at least 1")
+    if page_size < 1:
+        raise ValidationError("page_size must be at least 1")
+
+    db = get_db()
+    total = db.execute(
+        f"SELECT COUNT(*) AS n FROM subscriptions {where}", tuple(params)
+    ).fetchone()["n"]
+    rows = db.execute(
+        f"""
+        SELECT * FROM subscriptions
+        {where}
+        ORDER BY created_at DESC, id DESC
+        LIMIT ? OFFSET ?
+        """,
+        (*params, page_size, (page - 1) * page_size),
+    ).fetchall()
+
+    return jsonify(
+        {
+            "items": [subscription_dict(row) for row in rows],
+            "total": total,
+            "page": page,
+            "page_size": page_size,
+        }
+    )
