+                    </td>
+                    <td className="px-5 py-3">
+                      <InvoiceBadge status={invoice.status} />
+                    </td>
+                    <td className="px-5 py-3 text-slate-500">
+                      {invoice.paid_at ? formatDate(invoice.paid_at) : "—"}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </section>
+    </div>
+  );
+}
