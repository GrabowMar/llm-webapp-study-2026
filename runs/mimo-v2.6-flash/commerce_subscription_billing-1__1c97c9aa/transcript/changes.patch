+import { useEffect, type ReactNode } from "react";
+import { signOut } from "./api";
+import { LoadingNote } from "./components";
+import { navigate, useAuth, usePathname } from "./router";
+import AuthPage from "./pages/AuthPage";
+import PublicPage from "./pages/PublicPage";
+import SubscriptionDetailPage from "./pages/SubscriptionDetailPage";
+import SubscriptionsPage from "./pages/SubscriptionsPage";
+
+function NavLink({
+  to,
+  label,
+  active,
+}: {
+  to: string;
+  label: string;
+  active: boolean;
+}) {
+  return (
+    <a
+      href={to}
+      onClick={(event) => {
+        event.preventDefault();
+        navigate(to);
+      }}
+      className={`rounded-md px-3 py-2 text-sm font-medium transition ${
+        active
+          ? "bg-slate-100 text-slate-900"
+          : "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
+      }`}
+    >
+      {label}
+    </a>
+  );
+}
+
+function Header() {
+  const auth = useAuth();
+  const path = usePathname();
+
+  return (
+    <header className="sticky top-0 z-10 border-b border-slate-200 bg-white/95 backdrop-blur">
+      <div className="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
+        <div className="flex items-center gap-2">
+          <a
+            href="/"
+            onClick={(event) => {
+              event.preventDefault();
+              navigate("/");
+            }}
+            className="flex items-center gap-2 text-sm font-semibold tracking-tight text-slate-900"
+          >
+            <span className="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">
+              B
+            </span>
+            <span>Billing Console</span>
+          </a>
+          <nav className="ml-4 hidden items-center gap-1 sm:flex">
+            <NavLink to="/" label="Summary" active={path === "/"} />
+            {auth.token && (
+              <NavLink
+                to="/subscriptions"
+                label="Subscriptions"
+                active={path.startsWith("/subscriptions")}
+              />
+            )}
+          </nav>
+        </div>
+
+        <div className="flex items-center gap-3">
+          {auth.token ? (
+            <>
+              <span className="hidden text-sm text-slate-600 sm:inline">
+                {auth.username}
+              </span>
+              <button
+                type="button"
+                onClick={() => {
+                  signOut();
+                  navigate("/");
+                }}
+                className="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
+              >
+                Sign out
+              </button>
+            </>
+          ) : (
+            <>
+              <a
+                href="/login"
+                onClick={(event) => {
+                  event.preventDefault();
+                  navigate("/login");
+                }}
+                className="rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:text-slate-900"
+              >
+                Sign in
+              </a>
+              <a
+                href="/register"
+                onClick={(event) => {
+                  event.preventDefault();
+                  navigate("/register");
+                }}
+                className="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-500"
+              >
+                Register
+              </a>
+            </>
+          )}
+        </div>
+      </div>
+    </header>
+  );
+}
+
+function RequireAuth({ children }: { children: ReactNode }) {
+  const auth = useAuth();
+  useEffect(() => {
+    if (!auth.token) navigate("/login");
+  }, [auth.token]);
+  if (!auth.token) {
+    return (
+      <div className="mx-auto max-w-6xl px-4 py-16">
+        <LoadingNote label="Redirecting to sign in…" />
+      </div>
+    );
+  }
+  return <>{children}</>;
+}
+
+function NotFoundPage() {
+  return (
+    <div className="mx-auto max-w-6xl px-4 py-16 text-center">
+      <p className="text-sm font-medium text-slate-500">404</p>
+      <h1 className="mt-2 text-2xl font-semibold text-slate-900">
+        Page not found
+      </h1>
+      <a
+        href="/"
+        onClick={(event) => {
+          event.preventDefault();
+          navigate("/");
+        }}
+        className="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-500"
+      >
+        Back to summary
+      </a>
+    </div>
+  );
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  const path = usePathname();
+
+  let page: ReactNode;
+  const detailMatch = /^\/subscriptions\/(\d+)\/?$/.exec(path);
+
+  if (path === "/" || path === "") {
+    page = <PublicPage />;
+  } else if (path === "/login") {
+    page = <AuthPage mode="login" />;
+  } else if (path === "/register") {
+    page = <AuthPage mode="register" />;
+  } else if (path === "/subscriptions" || path === "/subscriptions/") {
+    page = (
+      <RequireAuth>
+        <SubscriptionsPage />
+      </RequireAuth>
+    );
+  } else if (detailMatch) {
+    page = (
+      <RequireAuth>
+        <SubscriptionDetailPage id={Number(detailMatch[1])} />
+      </RequireAuth>
+    );
+  } else {
+    page = <NotFoundPage />;
+  }
+
+  return (
+    <div className="min-h-screen">
+      <Header />
+      <main className="mx-auto max-w-6xl px-4 py-8">{page}</main>
+      <footer className="mx-auto max-w-6xl px-4 pb-8 text-center text-xs text-slate-400">
+        Subscription billing console
+      </footer>
+    </div>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..394745c
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,248 @@
+export type Status = "trial" | "active" | "past_due" | "cancelled";
+export type CollectionOutcome = "failed" | "succeeded";
+
+export interface Subscription {
+  id: number;
+  customer_name: string;
+  plan: string;
+  monthly_amount: number;
+  renewal_date: string;
+  status: Status;
+  failed_payment_count: number;
+  created_at: string;
+}
+
+export interface Invoice {
+  id: number;
+  subscription_id: number;
+  amount_due: number;
+  due_date: string;
+  status: string;
+  paid_at: string | null;
+}
+
+export interface SubscriptionPage {
+  items: Subscription[];
+  total: number;
+  page: number;
+  page_size: number;
+}
+
+export interface Stats {
+  mrr: number;
+  counts: Record<string, number>;
+}
+
+export interface CollectionResult {
+  id: number;
+  subscription_id: number;
+  outcome: CollectionOutcome;
+  invoices_affected: number;
+  created_at: string;
+}
+
+export interface AuthSnapshot {
+  token: string | null;
+  username: string | null;
+}
+
+const TOKEN_KEY = "billing.token";
+const USERNAME_KEY = "billing.username";
+
+function loadAuth(): AuthSnapshot {
+  return {
+    token: localStorage.getItem(TOKEN_KEY),
+    username: localStorage.getItem(USERNAME_KEY),
+  };
+}
+
+let authState: AuthSnapshot = loadAuth();
+const authListeners = new Set<() => void>();
+
+function commitAuth(next: AuthSnapshot): void {
+  authState = next;
+  if (next.token) {
+    localStorage.setItem(TOKEN_KEY, next.token);
+  } else {
+    localStorage.removeItem(TOKEN_KEY);
+  }
+  if (next.username) {
+    localStorage.setItem(USERNAME_KEY, next.username);
+  } else {
+    localStorage.removeItem(USERNAME_KEY);
+  }
+  authListeners.forEach((listener) => listener());
+}
+
+export function subscribeAuth(listener: () => void): () => void {
+  authListeners.add(listener);
+  return () => {
+    authListeners.delete(listener);
+  };
+}
+
+export function getAuth(): AuthSnapshot {
+  return authState;
+}
+
+export function signIn(token: string, username: string): void {
+  commitAuth({ token, username });
+}
+
+export function signOut(): void {
+  commitAuth({ token: null, username: null });
+}
+
+export class ApiError extends Error {
+  readonly status: number;
+
+  constructor(message: string, status: number) {
+    super(message);
+    this.name = "ApiError";
+    this.status = status;
+  }
+}
+
+interface RequestOptions {
+  method?: string;
+  body?: unknown;
+}
+
+async function request<T>(path: string, options: RequestOptions = {}): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (options.body !== undefined) {
+    headers["Content-Type"] = "application/json";
+  }
+  if (authState.token) {
+    headers["Authorization"] = `Bearer ${authState.token}`;
+  }
+
+  const response = await fetch(path, {
+    method: options.method ?? "GET",
+    headers,
+    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,
+  });
+
+  const text = await response.text();
+  let payload: unknown = null;
+  if (text) {
+    try {
+      payload = JSON.parse(text);
+    } catch {
+      payload = null;
+    }
+  }
+
+  if (!response.ok) {
+    if (
+      response.status === 401 &&
+      authState.token &&
+      !path.startsWith("/api/auth/")
+    ) {
+      signOut();
+    }
+    const message =
+      payload !== null &&
+      typeof payload === "object" &&
+      "error" in payload &&
+      typeof (payload as { error: unknown }).error === "string"
+        ? (payload as { error: string }).error
+        : `Request failed (${response.status})`;
+    throw new ApiError(message, response.status);
+  }
+
+  return payload as T;
+}
+
+export interface SubscriptionQuery {
+  q?: string;
+  status?: string;
+  plan?: string;
+  page?: number;
+  page_size?: number;
+}
+
+export const api = {
+  register(username: string, password: string): Promise<unknown> {
+    return request("/api/auth/register", {
+      method: "POST",
+      body: { username, password },
+    });
+  },
+
+  login(username: string, password: string): Promise<{ token: string }> {
+    return request("/api/auth/login", {
+      method: "POST",
+      body: { username, password },
+    });
+  },
+
+  listSubscriptions(query: SubscriptionQuery): Promise<SubscriptionPage> {
+    const params = new URLSearchParams();
+    if (query.q) params.set("q", query.q);
+    if (query.status) params.set("status", query.status);
+    if (query.plan) params.set("plan", query.plan);
+    if (query.page !== undefined) params.set("page", String(query.page));
+    if (query.page_size !== undefined) {
+      params.set("page_size", String(query.page_size));
+    }
+    const suffix = params.toString();
+    return request(`/api/subscriptions${suffix ? `?${suffix}` : ""}`);
+  },
+
+  getSubscription(id: number): Promise<Subscription> {
+    return request(`/api/subscriptions/${id}`);
+  },
+
+  patchSubscription(
+    id: number,
+    fields: Partial<
+      Pick<
+        Subscription,
+        | "customer_name"
+        | "plan"
+        | "monthly_amount"
+        | "renewal_date"
+        | "status"
+      >
+    >,
+  ): Promise<Subscription> {
+    return request(`/api/subscriptions/${id}`, {
+      method: "PATCH",
+      body: fields,
+    });
+  },
+
+  listInvoices(id: number): Promise<{ items: Invoice[] }> {
+    return request(`/api/subscriptions/${id}/invoices`);
+  },
+
+  issueInvoice(
+    id: number,
+    body: { amount_due?: number; due_date?: string },
+  ): Promise<Invoice> {
+    return request(`/api/subscriptions/${id}/invoices`, {
+      method: "POST",
+      body,
+    });
+  },
+
+  recordCollection(
+    id: number,
+    outcome: CollectionOutcome,
+  ): Promise<CollectionResult> {
+    return request(`/api/subscriptions/${id}/collections`, {
+      method: "POST",
+      body: { outcome },
+    });
+  },
+
+  publicStats(): Promise<Stats> {
+    return request("/api/public/stats");
+  },
+};
+
+export function errorMessage(error: unknown): string {
+  if (error instanceof Error && error.message) return error.message;
+  return "Something went wrong";
+}
