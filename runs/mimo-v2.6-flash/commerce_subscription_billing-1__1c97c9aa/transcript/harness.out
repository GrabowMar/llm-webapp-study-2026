nset ${classes}`}\n50:     >\n51:       {statusLabel(status)}\n52:     </span>\n53:   );\n54: }\n55: \n56: export function InvoiceBadge({ status }: { status: string }) {\n57:   const classes =\n58:     INVOICE_BADGE_CLASSES[status] ??\n59:     \"bg-slate-100 text-slate-700 ring-slate-600/20\";\n60:   return (\n61:     <span\n62:       className={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${classes}`}\n63:     >\n64:       {status}\n65:     </span>\n66:   );\n67: }\n68: \n69: export function ErrorNote({ message }: { message: string }) {\n70:   if (!message) return null;\n71:   return (\n72:     <div className=\"rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700\">\n73:       {message}\n74:     </div>\n75:   );\n76: }\n77: \n78: export function SuccessNote({ message }: { message: string }) {\n79:   if (!message) return null;\n80:   return (\n81:     <div className=\"rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700\">\n82:       {message}\n83:     </div>\n84:   );\n85: }\n86: \n87: export function LoadingNote({ label = \"Loading…\" }: { label?: string }) {\n88:   return <p className=\"py-8 text-center text-sm text-slate-500\">{label}</p>;\n89: }\n\n(End of file - total 89 lines)\n</content>","metadata":{"preview":"import type { Status } from \"./api\";\n\nconst STATUS_LABELS: Record<string, string> = {\n  trial: \"Trial\",\n  active: \"Active\",\n  past_due: \"Past due\",\n  cancelled: \"Cancelled\",\n};\n\nconst STATUS_BADGE_CLASSES: Record<string, string> = {\n  trial: \"bg-sky-50 text-sky-700 ring-sky-600/20\",\n  active: \"bg-emerald-50 text-emerald-700 ring-emerald-600/20\",\n  past_due: \"bg-amber-50 text-amber-700 ring-amber-600/20\",\n  cancelled: \"bg-rose-50 text-rose-700 ring-rose-600/20\",\n};\n\nconst INVOICE_BADGE_CLASSES: Record<string, string> = {\n  open: \"bg-amber-50 text-amber-700 ring-amber-600/20\",\n  paid: \"bg-emerald-50 text-emerald-700 ring-emerald-600/20\",\n};","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components.tsx","text":"import type { Status } from \"./api\";\n\nconst STATUS_LABELS: Record<string, string> = {\n  trial: \"Trial\",\n  active: \"Active\",\n  past_due: \"Past due\",\n  cancelled: \"Cancelled\",\n};\n\nconst STATUS_BADGE_CLASSES: Record<string, string> = {\n  trial: \"bg-sky-50 text-sky-700 ring-sky-600/20\",\n  active: \"bg-emerald-50 text-emerald-700 ring-emerald-600/20\",\n  past_due: \"bg-amber-50 text-amber-700 ring-amber-600/20\",\n  cancelled: \"bg-rose-50 text-rose-700 ring-rose-600/20\",\n};\n\nconst INVOICE_BADGE_CLASSES: Record<string, string> = {\n  open: \"bg-amber-50 text-amber-700 ring-amber-600/20\",\n  paid: \"bg-emerald-50 text-emerald-700 ring-emerald-600/20\",\n};\n\nexport const STATUS_ORDER: Status[] = [\n  \"active\",\n  \"past_due\",\n  \"trial\",\n  \"cancelled\",\n];\n\nexport function statusLabel(status: string): string {\n  return STATUS_LABELS[status] ?? status;\n}\n\nexport function formatMoney(value: number): string {\n  return value.toLocaleString(\"en-US\", {\n    minimumFractionDigits: 0,\n    maximumFractionDigits: 2,\n  });\n}\n\nexport function formatDate(value: string): string {\n  return value.slice(0, 10);\n}\n\nexport function StatusBadge({ status }: { status: string }) {\n  const classes =\n    STATUS_BADGE_CLASSES[status] ?? \"bg-slate-100 text-slate-700 ring-slate-600/20\";\n  return (\n    <span\n      className={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${classes}`}\n    >\n      {statusLabel(status)}\n    </span>\n  );\n}\n\nexport function InvoiceBadge({ status }: { status: string }) {\n  const classes =\n    INVOICE_BADGE_CLASSES[status] ??\n    \"bg-slate-100 text-slate-700 ring-slate-600/20\";\n  return (\n    <span\n      className={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${classes}`}\n    >\n      {status}\n    </span>\n  );\n}\n\nexport function ErrorNote({ message }: { message: string }) {\n  if (!message) return null;\n  return (\n    <div className=\"rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700\">\n      {message}\n    </div>\n  );\n}\n\nexport function SuccessNote({ message }: { message: string }) {\n  if (!message) return null;\n  return (\n    <div className=\"rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700\">\n      {message}\n    </div>\n  );\n}\n\nexport function LoadingNote({ label = \"Loading…\" }: { label?: string }) {\n  return <p className=\"py-8 text-center text-sm text-slate-500\">{label}</p>;\n}","lineStart":1,"lineEnd":89,"totalLines":89,"truncated":false}},"title":"frontend/src/components.tsx","time":{"start":1794327467222,"end":1794327467256}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c64054ce001zOUbidpLkqtDhs","sessionID":"ses_e39dba1ebffeasuHLBc09Tf0rt","messageID":"msg_1c6403b970010foSpWf2whay8b"}}
