ho \"--- invoices + collections\"\ncurl -s -X POST $API/subscriptions/1/invoices -H \"$AUTH\" -H 'Content-Type: application/json' -d '{}' -w \" [%{http_code}]\\n\"\ncurl -s -X POST $API/subscriptions/1/invoices -H \"$AUTH\" -H 'Content-Type: application/json' -d '{\"amount_due\":10}' -w \" [%{http_code}]\\n\"\ncurl -s -X POST $API/subscriptions/1/collections -H \"$AUTH\" -H 'Content-Type: application/json' -d '{\"outcome\":\"failed\"}' -w \" [%{http_code}]\\n\"\ncurl -s $API/subscriptions/1 -H \"$AUTH\" | python3 -c \"import sys,json;d=json.load(sys.stdin);print('failed_payment_count:',d['failed_payment_count'])\"\ncurl -s -X POST $API/subscriptions/1/collections -H \"$AUTH\" -H 'Content-Type: application/json' -d '{\"outcome\":\"succeeded\"}' -w \" [%{http_code}]\\n\"\ncurl -s $API/subscriptions/1/invoices -H \"$AUTH\" | python3 -m json.tool\necho \"--- patch\"\ncurl -s -X PATCH $API/subscriptions/1 -H \"$AUTH\" -H 'Content-Type: application/json' -d '{\"plan\":\"pro\"}' | python3 -c \"import sys,json;d=json.load(sys.stdin);print('patched plan:',d['plan'],'amount still',d['monthly_amount'])\"\necho \"--- auth failures\"\ncurl -s -o /dev/null -w \"no token: %{http_code}\\n\" $API/subscriptions\ncurl -s -o /dev/null -w \"bad token: %{http_code}\\n\" $API/subscriptions -H \"Authorization: Bearer bogus\"\ncurl -s -o /dev/null -w \"register missing: %{http_code}\\n\" -X POST $API/auth/register -H 'Content-Type: application/json' -d '{}'\necho \"--- unknown api\"\ncurl -s -o /dev/null -w \"unknown: %{http_code}\\n\" $API/does-not-exist\ncurl -s -o /dev/null -w \"unknown post: %{http_code}\\n\" -X POST $API/does-not-exist","time":{"start":1794327020124,"end":1794327021400}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6398252001DqMbnvawKr1BPo","sessionID":"ses_e39dba1ebffeasuHLBc09Tf0rt","messageID":"msg_1c6391efe001fm0QY09vU8vBMV"}}
