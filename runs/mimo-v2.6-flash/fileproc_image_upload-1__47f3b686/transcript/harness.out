{"type":"text","timestamp":1794342710347,"sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","part":{"id":"prt_1c728ec39001KHEVPXCLz0Y4kx","messageID":"msg_1c7262775001WFvRqIN2XgXFzZ","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","type":"text","text":"Now I'll write the backend API.","time":{"start":1794342710329,"end":1794342710343}}}
{"type":"tool_use","timestamp":1794342710379,"sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","part":{"type":"tool","tool":"write","callID":"call_67f2d02df647485898495eaf","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: image gallery API and frontend hosting.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\nimport secrets\nimport sqlite3\nimport uuid\nfrom datetime import datetime, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_file, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nBASE_DIR = Path(__file__).resolve().parent.parent\nDATA_DIR = BASE_DIR / \"data\"\nFILES_DIR = DATA_DIR / \"files\"\nDB_PATH = DATA_DIR / \"gallery.db\"\nDIST = BASE_DIR / \"frontend\" / \"dist\"\n\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\nMAX_CONTENT_LENGTH = 32 * 1024 * 1024\n\nPNG_MAGIC = b\"\\x89PNG\\r\\n\\x1a\\n\"\nJPEG_MAGIC = b\"\\xff\\xd8\\xff\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT COLLATE NOCASE NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS images (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    filename TEXT NOT NULL,\n    title TEXT,\n    content_type TEXT NOT NULL,\n    size_bytes INTEGER NOT NULL,\n    stored_name TEXT NOT NULL,\n    uploaded_at TEXT NOT NULL,\n    user_id INTEGER NOT NULL REFERENCES users(id)\n);\nCREATE INDEX IF NOT EXISTS idx_images_recent ON images (uploaded_at DESC, id DESC);\n\"\"\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\ndef detect_content_type(data: bytes) -> str | None:\n    if data.startswith(PNG_MAGIC):\n        return \"image/png\"\n    if data.startswith(JPEG_MAGIC):\n        return \"image/jpeg\"\n    return None\n\n\ndef decode_base64(payload: str) -> bytes:\n    payload = \"\".join(payload.split())\n    if payload.startswith(\"data:\") and \",\" in payload:\n        payload = payload.split(\",\", 1)[1]\n    payload += \"=\" * (-len(payload) % 4)\n    return base64.b64decode(payload, validate=True)\n\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = MAX_CONTENT_LENGTH\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = sqlite3.connect(DB_PATH)\n        g.db.row_factory = sqlite3.Row\n        g.db.execute(\"PRAGMA foreign_keys = ON\")\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc) -> None:\n    db = g.pop(\"db\", None)\n    if db is not None:\n        db.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    FILES_DIR.mkdir(parents=True, exist_ok=True)\n    with sqlite3.connect(DB_PATH) as db:\n        db.execute(\"PRAGMA journal_mode = WAL\")\n        db.executescript(SCHEMA)\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \"):].strip()\n    if not token:\n        return None\n    row = get_db().execute(\n        \"\"\"\n        SELECT u.id, u.username\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token = ?\n        \"\"\",\n        (token,),\n    ).fetchone()\n    return row\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef image_to_dict(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"filename\": row[\"filename\"],\n        \"title\": row[\"title\"],\n        \"content_type\": row[\"content_type\"],\n        \"size_bytes\": row[\"size_bytes\"],\n        \"uploaded_at\": row[\"uploaded_at\"],\n        \"url\": f\"/api/images/{row['id']}/file\",\n        \"uploader\": row[\"uploader\"],\n    }\n\n\ndef fetch_image(image_id: int) -> sqlite3.Row | None:\n    return get_db().execute(\n        \"\"\"\n        SELECT i.id, i.filename, i.title, i.content_type, i.size_bytes,\n               i.stored_name, i.uploaded_at, i.user_id, u.username AS uploader\n        FROM images i\n        JOIN users u ON u.id = i.user_id\n        WHERE i.id = ?\n        \"\"\",\n        (image_id,),\n    ).fetchone()\n\n\ndef parse_query_int(name: str, default: int, minimum: int, maximum: int):\n    raw = request.args.get(name)\n    if raw is None:\n        return default, None\n    try:\n        value = int(raw)\n    except (TypeError, ValueError):\n        return None, error(f\"{name} must be an integer\", 400)\n    value = max(minimum, min(maximum, value))\n    return value, None\n\n\n@app.errorhandler(404)\ndef not_found(_e):\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.errorhandler(405)\ndef method_not_allowed(_e):\n    return jsonify({\"error\": \"method not allowed\"}), 405\n\n\n@app.errorhandler(413)\ndef payload_too_large(_e):\n    return jsonify({\"error\": \"request payload too large\"}), 413\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        body = {}\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    username = username.strip()\n    db = get_db()\n    try:\n        cursor = db.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        db.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username already taken\", 409)\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        body = {}\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return error(\"username is required\", 400)\n    if not isinstance(password, str) or not password:\n        return error(\"password is required\", 400)\n    row = get_db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    get_db().execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], now_iso()),\n    )\n    get_db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/images\")\ndef list_images():\n    page, err = parse_query_int(\"page\", 1, 1, 1_000_000)\n    if err:\n        return err\n    page_size, err = parse_query_int(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    if err:\n        return err\n    db = get_db()\n    total = db.execute(\"SELECT COUNT(*) FROM images\").fetchone()[0]\n    rows = db.execute(\n        \"\"\"\n        SELECT i.id, i.filename, i.title, i.content_type, i.size_bytes,\n               i.uploaded_at, i.user_id, u.username AS uploader\n        FROM images i\n        JOIN users u ON u.id = i.user_id\n        ORDER BY i.uploaded_at DESC, i.id DESC\n        LIMIT ? OFFSET ?\n        \"\"\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [image_to_dict(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/images\")\n@login_required\ndef create_image():\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return error(\"JSON body required\", 400)\n    filename = body.get(\"filename\")\n    data = body.get(\"data\")\n    title = body.get(\"title\")\n    if not isinstance(filename, str) or not filename.strip():\n        return error(\"filename is required\", 400)\n    if not isinstance(data, str) or not data.strip():\n        return error(\"data is required\", 400)\n    if title is not None and not isinstance(title, str):\n        return error(\"title must be a string\", 400)\n    try:\n        raw = decode_base64(data)\n    except (binascii.Error, ValueError):\n        return error(\"data must be valid base64\", 400)\n    content_type = detect_content_type(raw)\n    if content_type is None:\n        return error(\"only PNG and JPEG images are supported\", 400)\n    stored_name = uuid.uuid4().hex\n    path = FILES_DIR / stored_name\n    path.write_bytes(raw)\n    clean_title = title.strip() if isinstance(title, str) and title.strip() else None\n    db = get_db()\n    try:\n        cursor = db.execute(\n            \"\"\"\n            INSERT INTO images (filename, title, content_type, size_bytes, stored_name, uploaded_at, user_id)\n            VALUES (?, ?, ?, ?, ?, ?, ?)\n            \"\"\",\n            (\n                filename.strip(),\n                clean_title,\n                content_type,\n                len(raw),\n                stored_name,\n                now_iso(),\n                g.user[\"id\"],\n            ),\n        )\n        db.commit()\n    except sqlite3.Error:\n        path.unlink(missing_ok=True)\n        raise\n    image_id = cursor.lastrowid\n    return jsonify(image_to_dict(fetch_image(image_id))), 201\n\n\n@app.get(\"/api/images/<int:image_id>\")\ndef get_image(image_id: int):\n    row = fetch_image(image_id)\n    if row is None:\n        return error(\"image not found\", 404)\n    return jsonify(image_to_dict(row))\n\n\n@app.get(\"/api/images/<int:image_id>/file\")\ndef get_image_file(image_id: int):\n    row = fetch_image(image_id)\n    if row is None:\n        return error(\"image not found\", 404)\n    path = FILES_DIR / row[\"stored_name\"]\n    if not path.is_file():\n        return error(\"image file not found\", 404)\n    return send_file(path, mimetype=row[\"content_type\"], conditional=True)\n\n\n@app.delete(\"/api/images/<int:image_id>\")\n@login_required\ndef delete_image(image_id: int):\n    row = fetch_image(image_id)\n    if row is None:\n        return error(\"image not found\", 404)\n    if row[\"user_id\"] != g.user[\"id\"]:\n        return error(\"only the uploader can delete this image\", 403)\n    db = get_db()\n    db.execute(\"DELETE FROM images WHERE id = ?\", (image_id,))\n    db.commit()\n    (FILES_DIR / row[\"stored_name\"]).unlink(missing_ok=True)\n    return \"\", 204\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794342710339,"end":1794342710361}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c728ec3c001FaVagbVqdJB5KU","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","messageID":"msg_1c7262775001WFvRqIN2XgXFzZ"}}
