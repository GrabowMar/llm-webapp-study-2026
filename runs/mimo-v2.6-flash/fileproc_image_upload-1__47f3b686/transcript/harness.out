it response.json()) as { error?: unknown };\n65:     if (body && typeof body.error === \"string\" && body.error) {\n66:       return body.error;\n67:     }\n68:   } catch {\n69:     // ignore malformed error bodies\n70:   }\n71:   return `Request failed with status ${response.status}`;\n72: }\n73: \n74: async function request<T>(\n75:   path: string,\n76:   options: RequestInit = {},\n77:   session?: Session | null,\n78: ): Promise<T> {\n79:   const headers = new Headers(options.headers);\n80:   if (options.body) {\n81:     headers.set(\"Content-Type\", \"application/json\");\n82:   }\n83:   if (session) {\n84:     headers.set(\"Authorization\", `Bearer ${session.token}`);\n85:   }\n86:   const response = await fetch(path, { ...options, headers });\n87:   if (!response.ok) {\n88:     throw new ApiError(await errorFromResponse(response), response.status);\n89:   }\n90:   if (response.status === 204) {\n91:     return undefined as T;\n92:   }\n93:   return (await response.json()) as T;\n94: }\n95: \n96: export async function register(\n97:   username: string,\n98:   password: string,\n99: ): Promise<void> {\n100:   await request(\"/api/auth/register\", {\n101:     method: \"POST\",\n102:     body: JSON.stringify({ username, password }),\n103:   });\n104: }\n105: \n106: export async function login(\n107:   username: string,\n108:   password: string,\n109: ): Promise<Session> {\n110:   const body = await request<{ token: string }>(\"/api/auth/login\", {\n111:     method: \"POST\",\n112:     body: JSON.stringify({ username, password }),\n113:   });\n114:   return { token: body.token, username };\n115: }\n116: \n117: export async function listImages(\n118:   page: number,\n119:   pageSize: number,\n120: ): Promise<ImageList> {\n121:   const query = new URLSearchParams({\n122:     page: String(page),\n123:     page_size: String(pageSize),\n124:   });\n125:   return request<ImageList>(`/api/images?${query.toString()}`);\n126: }\n127: \n128: export async function createImage(\n129:   image: { filename: string; data: string; title?: string },\n130:   session: Session,\n131: ): Promise<ImageItem> {\n132:   return request<ImageItem>(\"/api/images\", {\n133:     method: \"POST\",\n134:     body: JSON.stringify(image),\n135:   }, session);\n136: }\n137: \n138: export async function deleteImage(\n139:   id: number,\n140:   session: Session,\n141: ): Promise<void> {\n142:   await request<void>(`/api/images/${id}`, { method: \"DELETE\" }, session);\n143: }\n144: \n145: export function formatBytes(bytes: number): string {\n146:   if (bytes < 1024) return `${bytes} B`;\n147:   if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n148:   return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n149: }\n150: \n151: export function formatShortDate(iso: string): string {\n152:   const date = new Date(iso);\n153:   if (Number.isNaN(date.getTime())) return iso;\n154:   return date.toLocaleDateString(undefined, {\n155:     year: \"numeric\",\n156:     month: \"short\",\n157:     day: \"numeric\",\n158:   });\n159: }\n160: \n161: export function formatFullDate(iso: string): string {\n162:   const date = new Date(iso);\n163:   if (Number.isNaN(date.getTime())) return iso;\n164:   return date.toLocaleString();\n165: }\n\n(End of file - total 165 lines)\n</content>","metadata":{"preview":"export interface ImageItem {\n  id: number;\n  filename: string;\n  title: string | null;\n  content_type: string;\n  size_bytes: number;\n  uploaded_at: string;\n  url: string;\n  uploader: string;\n}\n\nexport interface ImageList {\n  items: ImageItem[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Session {\n  token: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/api.ts","text":"export interface ImageItem {\n  id: number;\n  filename: string;\n  title: string | null;\n  content_type: string;\n  size_bytes: number;\n  uploaded_at: string;\n  url: string;\n  uploader: string;\n}\n\nexport interface ImageList {\n  items: ImageItem[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Session {\n  token: string;\n  username: string;\n}\n\nexport class ApiError extends Error {\n  readonly status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\nconst SESSION_KEY = \"gallery.session\";\n\nexport function loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(SESSION_KEY);\n    if (!raw) return null;\n    const parsed = JSON.parse(raw) as Partial<Session> | null;\n    if (\n      parsed &&\n      typeof parsed.token === \"string\" &&\n      typeof parsed.username === \"string\"\n    ) {\n      return { token: parsed.token, username: parsed.username };\n    }\n    return null;\n  } catch {\n    return null;\n  }\n}\n\nexport function saveSession(session: Session | null): void {\n  if (session) {\n    localStorage.setItem(SESSION_KEY, JSON.stringify(session));\n  } else {\n    localStorage.removeItem(SESSION_KEY);\n  }\n}\n\nasync function errorFromResponse(response: Response): Promise<string> {\n  try {\n    const body = (await response.json()) as { error?: unknown };\n    if (body && typeof body.error === \"string\" && body.error) {\n      return body.error;\n    }\n  } catch {\n    // ignore malformed error bodies\n  }\n  return `Request failed with status ${response.status}`;\n}\n\nasync function request<T>(\n  path: string,\n  options: RequestInit = {},\n  session?: Session | null,\n): Promise<T> {\n  const headers = new Headers(options.headers);\n  if (options.body) {\n    headers.set(\"Content-Type\", \"application/json\");\n  }\n  if (session) {\n    headers.set(\"Authorization\", `Bearer ${session.token}`);\n  }\n  const response = await fetch(path, { ...options, headers });\n  if (!response.ok) {\n    throw new ApiError(await errorFromResponse(response), response.status);\n  }\n  if (response.status === 204) {\n    return undefined as T;\n  }\n  return (await response.json()) as T;\n}\n\nexport async function register(\n  username: string,\n  password: string,\n): Promise<void> {\n  await request(\"/api/auth/register\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n}\n\nexport async function login(\n  username: string,\n  password: string,\n): Promise<Session> {\n  const body = await request<{ token: string }>(\"/api/auth/login\", {\n    method: \"POST\",\n    body: JSON.stringify({ username, password }),\n  });\n  return { token: body.token, username };\n}\n\nexport async function listImages(\n  page: number,\n  pageSize: number,\n): Promise<ImageList> {\n  const query = new URLSearchParams({\n    page: String(page),\n    page_size: String(pageSize),\n  });\n  return request<ImageList>(`/api/images?${query.toString()}`);\n}\n\nexport async function createImage(\n  image: { filename: string; data: string; title?: string },\n  session: Session,\n): Promise<ImageItem> {\n  return request<ImageItem>(\"/api/images\", {\n    method: \"POST\",\n    body: JSON.stringify(image),\n  }, session);\n}\n\nexport async function deleteImage(\n  id: number,\n  session: Session,\n): Promise<void> {\n  await request<void>(`/api/images/${id}`, { method: \"DELETE\" }, session);\n}\n\nexport function formatBytes(bytes: number): string {\n  if (bytes < 1024) return `${bytes} B`;\n  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n}\n\nexport function formatShortDate(iso: string): string {\n  const date = new Date(iso);\n  if (Number.isNaN(date.getTime())) return iso;\n  return date.toLocaleDateString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n  });\n}\n\nexport function formatFullDate(iso: string): string {\n  const date = new Date(iso);\n  if (Number.isNaN(date.getTime())) return iso;\n  return date.toLocaleString();\n}","lineStart":1,"lineEnd":165,"totalLines":165,"truncated":false}},"title":"frontend/src/api.ts","time":{"start":1794344072070,"end":1794344072080}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c73db382001OCChXvuFIisleX","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","messageID":"msg_1c73d125e001HVRE16Zhas2Ydk"}}
