                </span>\n94:               </dd>\n95:             </div>\n96:             <div>\n97:               <dt className=\"text-slate-500\">Uploader</dt>\n98:               <dd className=\"font-medium text-slate-800\">{image.uploader}</dd>\n99:             </div>\n100:             <div>\n101:               <dt className=\"text-slate-500\">Uploaded</dt>\n102:               <dd className=\"font-medium text-slate-800\">\n103:                 {formatFullDate(image.uploaded_at)}\n104:               </dd>\n105:             </div>\n106:             <div>\n107:               <dt className=\"text-slate-500\">Content type</dt>\n108:               <dd className=\"font-medium text-slate-800\">\n109:                 {image.content_type}\n110:               </dd>\n111:             </div>\n112:           </dl>\n113: \n114:           <div className=\"mt-4 flex items-center justify-between gap-3 border-t border-slate-200 pt-4\">\n115:             <a\n116:               href={image.url}\n117:               target=\"_blank\"\n118:               rel=\"noreferrer\"\n119:               className=\"text-sm font-medium text-blue-600 hover:underline\"\n120:             >\n121:               Open full size\n122:             </a>\n123:             {canDelete && (\n124:               <button\n125:                 type=\"button\"\n126:                 onClick={handleDelete}\n127:                 disabled={deleting}\n128:                 className=\"rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300 focus:ring-offset-1 disabled:cursor-not-allowed disabled:opacity-50\"\n129:               >\n130:                 {deleting ? \"Deleting...\" : \"Delete\"}\n131:               </button>\n132:             )}\n133:           </div>\n134:         </div>\n135:       </div>\n136:     </div>\n137:   );\n138: }\n\n(End of file - total 138 lines)\n</content>","metadata":{"preview":"import { useEffect, useState } from \"react\";\nimport {\n  formatBytes,\n  formatFullDate,\n  type ImageItem,\n  type Session,\n} from \"../api\";\n\ninterface Props {\n  image: ImageItem;\n  session: Session | null;\n  onClose: () => void;\n  onDelete: (image: ImageItem) => void | Promise<void>;\n}\n\nexport default function ImageDetail({ image, session, onClose, onDelete }: Props) {\n  const [deleting, setDeleting] = useState(false);\n  const canDelete = session !== null && session.username === image.uploader;\n\n  useEffect(() => {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components/ImageDetail.tsx","text":"import { useEffect, useState } from \"react\";\nimport {\n  formatBytes,\n  formatFullDate,\n  type ImageItem,\n  type Session,\n} from \"../api\";\n\ninterface Props {\n  image: ImageItem;\n  session: Session | null;\n  onClose: () => void;\n  onDelete: (image: ImageItem) => void | Promise<void>;\n}\n\nexport default function ImageDetail({ image, session, onClose, onDelete }: Props) {\n  const [deleting, setDeleting] = useState(false);\n  const canDelete = session !== null && session.username === image.uploader;\n\n  useEffect(() => {\n    const onKeyDown = (event: KeyboardEvent) => {\n      if (event.key === \"Escape\") onClose();\n    };\n    window.addEventListener(\"keydown\", onKeyDown);\n    return () => window.removeEventListener(\"keydown\", onKeyDown);\n  }, [onClose]);\n\n  const handleDelete = async () => {\n    if (deleting) return;\n    const label = image.title || image.filename;\n    if (!window.confirm(`Delete \"${label}\"? This cannot be undone.`)) return;\n    setDeleting(true);\n    try {\n      await onDelete(image);\n    } finally {\n      setDeleting(false);\n    }\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-4\"\n      onClick={onClose}\n      role=\"presentation\"\n    >\n      <div\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-label={image.title || image.filename}\n        className=\"relative max-h-full w-full max-w-4xl overflow-y-auto rounded-xl bg-white p-4 shadow-xl sm:p-6\"\n        onClick={(event) => event.stopPropagation()}\n      >\n        <button\n          type=\"button\"\n          onClick={onClose}\n          aria-label=\"Close\"\n          className=\"absolute right-3 top-3 rounded-lg bg-slate-100 px-2.5 py-1 text-sm font-medium text-slate-600 hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        >\n          Close\n        </button>\n\n        <div className=\"flex justify-center bg-slate-900/5 p-2 sm:p-4\">\n          <img\n            src={image.url}\n            alt={image.title ?? image.filename}\n            className=\"max-h-[65vh] w-auto max-w-full rounded-lg object-contain\"\n          />\n        </div>\n\n        <div className=\"mt-4\">\n          <h2 className=\"truncate pr-16 text-lg font-semibold text-slate-900\">\n            {image.title || image.filename}\n          </h2>\n          <dl className=\"mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2\">\n            <div>\n              <dt className=\"text-slate-500\">Filename</dt>\n              <dd className=\"font-medium text-slate-800 break-all\">\n                {image.filename}\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-slate-500\">Title</dt>\n              <dd className=\"font-medium text-slate-800\">\n                {image.title || <span className=\"text-slate-400\">None</span>}\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-slate-500\">Size</dt>\n              <dd className=\"font-medium text-slate-800\">\n                {formatBytes(image.size_bytes)}\n                <span className=\"ml-1 font-normal text-slate-400\">\n                  ({image.size_bytes} bytes)\n                </span>\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-slate-500\">Uploader</dt>\n              <dd className=\"font-medium text-slate-800\">{image.uploader}</dd>\n            </div>\n            <div>\n              <dt className=\"text-slate-500\">Uploaded</dt>\n              <dd className=\"font-medium text-slate-800\">\n                {formatFullDate(image.uploaded_at)}\n              </dd>\n            </div>\n            <div>\n              <dt className=\"text-slate-500\">Content type</dt>\n              <dd className=\"font-medium text-slate-800\">\n                {image.content_type}\n              </dd>\n            </div>\n          </dl>\n\n          <div className=\"mt-4 flex items-center justify-between gap-3 border-t border-slate-200 pt-4\">\n            <a\n              href={image.url}\n              target=\"_blank\"\n              rel=\"noreferrer\"\n              className=\"text-sm font-medium text-blue-600 hover:underline\"\n            >\n              Open full size\n            </a>\n            {canDelete && (\n              <button\n                type=\"button\"\n                onClick={handleDelete}\n                disabled={deleting}\n                className=\"rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300 focus:ring-offset-1 disabled:cursor-not-allowed disabled:opacity-50\"\n              >\n                {deleting ? \"Deleting...\" : \"Delete\"}\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}","lineStart":1,"lineEnd":138,"totalLines":138,"truncated":false}},"title":"frontend/src/components/ImageDetail.tsx","time":{"start":1794344030784,"end":1794344030799}},"id":"prt_1c73d123a001iW5WJCqL9AD979","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","messageID":"msg_1c73cadb10019kyYorpvZUm3wV"}}
