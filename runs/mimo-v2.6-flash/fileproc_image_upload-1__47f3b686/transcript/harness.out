    setListError(\n50:         err instanceof Error ? err.message : \"Failed to load images.\",\n51:       );\n52:     } finally {\n53:       setLoading(false);\n54:     }\n55:   }, []);\n56: \n57:   useEffect(() => {\n58:     void load(page);\n59:   }, [page, load]);\n60: \n61:   const handleAuthed = (next: Session) => {\n62:     saveSession(next);\n63:     setSession(next);\n64:     setNotice(null);\n65:   };\n66: \n67:   const handleSignOut = () => {\n68:     saveSession(null);\n69:     setSession(null);\n70:     setSelected(null);\n71:     setNotice(\"Signed out.\");\n72:   };\n73: \n74:   const handleAuthError = (message: string) => {\n75:     saveSession(null);\n76:     setSession(null);\n77:     setSelected(null);\n78:     setNotice(message);\n79:   };\n80: \n81:   const handleUploaded = () => {\n82:     setNotice(null);\n83:     if (page === 1) {\n84:       void load(1);\n85:     } else {\n86:       setPage(1);\n87:     }\n88:   };\n89: \n90:   const handleDelete = async (image: ImageItem) => {\n91:     if (!session) return;\n92:     try {\n93:       await deleteImage(image.id, session);\n94:       setSelected(null);\n95:       setNotice(`Deleted \"${image.title || image.filename}\".`);\n96:       await load(page);\n97:     } catch (err) {\n98:       if (err instanceof ApiError && err.status === 401) {\n99:         handleAuthError(\"Your session expired. Please sign in again.\");\n100:       } else {\n101:         setNotice(\n102:           err instanceof ApiError ? err.message : \"Failed to delete image.\",\n103:         );\n104:       }\n105:     }\n106:   };\n107: \n108:   const pages = totalPagesOf(list.total);\n109: \n110:   return (\n111:     <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n112:       <header className=\"border-b border-slate-200 bg-white\">\n113:         <div className=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n114:           <h1 className=\"text-xl font-bold tracking-tight\">Image Gallery</h1>\n115:           {session ? (\n116:             <div className=\"flex items-center gap-3\">\n117:               <span className=\"text-sm text-slate-600\">\n118:                 Signed in as{\" \"}\n119:                 <span className=\"font-medium text-slate-900\">\n120:                   {session.username}\n121:                 </span>\n122:               </span>\n123:               <button\n124:                 type=\"button\"\n125:                 onClick={handleSignOut}\n126:                 className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-300\"\n127:               >\n128:                 Sign out\n129:               </button>\n130:             </div>\n131:           ) : (\n132:             <span className=\"text-sm text-slate-500\">Browsing as guest</span>\n133:           )}\n134:         </div>\n135:       </header>\n136: \n137:       <main className=\"mx-auto max-w-6xl space-y-6 px-4 py-6\">\n138:         {notice && (\n139:           <div\n140:             role=\"status\"\n141:             className=\"flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm\"\n142:           >\n143:             <span>{notice}</span>\n144:             <button\n145:               type=\"button\"\n146:               onClick={() => setNotice(null)}\n147:               className=\"font-medium text-slate-400 hover:text-slate-600\"\n148:               aria-label=\"Dismiss message\"\n149:             >\n150:               Dismiss\n151:             </button>\n152:           </div>\n153:         )}\n154: \n155:         {!session ? (\n156:           <AuthForms onAuthed={handleAuthed} />\n157:         ) : (\n158:           <UploadForm\n159:             session={session}\n160:             onUploaded={handleUploaded}\n161:             onAuthError={handleAuthError}\n162:           />\n163:         )}\n164: \n165:         <section aria-label=\"Gallery\" className=\"space-y-4\">\n166:           <Gallery\n167:             images={list.items}\n168:             loading={loading}\n169:             error={listError}\n170:             onOpen={setSelected}\n171:           />\n172: \n173:           {list.total > 0 && (\n174:             <nav\n175:               aria-label=\"Pagination\"\n176:               className=\"flex flex-wrap items-center justify-between gap-3\"\n177:             >\n178:               <p className=\"text-sm text-slate-600\">\n179:                 {list.total} image{list.total === 1 ? \"\" : \"s\"} · Page {page} of{\" \"}\n180:                 {pages}\n181:               </p>\n182:               <div className=\"flex gap-2\">\n183:                 <button\n184:                   type=\"button\"\n185:                   onClick={() => setPage((p) => Math.max(1, p - 1))}\n186:                   disabled={page <= 1}\n187:                   className=\"rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n188:                 >\n189:                   Previous\n190:                 </button>\n191:                 <button\n192:                   type=\"button\"\n193:                   onClick={() => setPage((p) => Math.min(pages, p + 1))}\n194:                   disabled={page >= pages}\n195:                   className=\"rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n196:                 >\n197:                   Next\n198:                 </button>\n199:               </div>\n200:             </nav>\n201:           )}\n202:         </section>\n203:       </main>\n204: \n205:       {selected && (\n206:         <ImageDetail\n207:           image={selected}\n208:           session={session}\n209:           onClose={() => setSelected(null)}\n210:           onDelete={handleDelete}\n211:         />\n212:       )}\n213:     </div>\n214:   );\n215: }\n\n(End of file - total 215 lines)\n</content>","metadata":{"preview":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  deleteImage,\n  listImages,\n  loadSession,\n  saveSession,\n  type ImageItem,\n  type ImageList,\n  type Session,\n} from \"./api\";\nimport AuthForms from \"./components/AuthForms\";\nimport Gallery from \"./components/Gallery\";\nimport ImageDetail from \"./components/ImageDetail\";\nimport UploadForm from \"./components/UploadForm\";\n\nconst PAGE_SIZE = 12;\n\nfunction totalPagesOf(total: number): number {\n  return Math.max(1, Math.ceil(total / PAGE_SIZE));","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  deleteImage,\n  listImages,\n  loadSession,\n  saveSession,\n  type ImageItem,\n  type ImageList,\n  type Session,\n} from \"./api\";\nimport AuthForms from \"./components/AuthForms\";\nimport Gallery from \"./components/Gallery\";\nimport ImageDetail from \"./components/ImageDetail\";\nimport UploadForm from \"./components/UploadForm\";\n\nconst PAGE_SIZE = 12;\n\nfunction totalPagesOf(total: number): number {\n  return Math.max(1, Math.ceil(total / PAGE_SIZE));\n}\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(() => loadSession());\n  const [page, setPage] = useState(1);\n  const [list, setList] = useState<ImageList>({\n    items: [],\n    total: 0,\n    page: 1,\n    page_size: PAGE_SIZE,\n  });\n  const [loading, setLoading] = useState(true);\n  const [listError, setListError] = useState<string | null>(null);\n  const [selected, setSelected] = useState<ImageItem | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n\n  const load = useCallback(async (pageToLoad: number) => {\n    setLoading(true);\n    try {\n      const data = await listImages(pageToLoad, PAGE_SIZE);\n      const pages = totalPagesOf(data.total);\n      if (data.items.length === 0 && data.page > pages) {\n        setPage(pages);\n        return;\n      }\n      setList(data);\n      setListError(null);\n    } catch (err) {\n      setListError(\n        err instanceof Error ? err.message : \"Failed to load images.\",\n      );\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    void load(page);\n  }, [page, load]);\n\n  const handleAuthed = (next: Session) => {\n    saveSession(next);\n    setSession(next);\n    setNotice(null);\n  };\n\n  const handleSignOut = () => {\n    saveSession(null);\n    setSession(null);\n    setSelected(null);\n    setNotice(\"Signed out.\");\n  };\n\n  const handleAuthError = (message: string) => {\n    saveSession(null);\n    setSession(null);\n    setSelected(null);\n    setNotice(message);\n  };\n\n  const handleUploaded = () => {\n    setNotice(null);\n    if (page === 1) {\n      void load(1);\n    } else {\n      setPage(1);\n    }\n  };\n\n  const handleDelete = async (image: ImageItem) => {\n    if (!session) return;\n    try {\n      await deleteImage(image.id, session);\n      setSelected(null);\n      setNotice(`Deleted \"${image.title || image.filename}\".`);\n      await load(page);\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) {\n        handleAuthError(\"Your session expired. Please sign in again.\");\n      } else {\n        setNotice(\n          err instanceof ApiError ? err.message : \"Failed to delete image.\",\n        );\n      }\n    }\n  };\n\n  const pages = totalPagesOf(list.total);\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n          <h1 className=\"text-xl font-bold tracking-tight\">Image Gallery</h1>\n          {session ? (\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-sm text-slate-600\">\n                Signed in as{\" \"}\n                <span className=\"font-medium text-slate-900\">\n                  {session.username}\n                </span>\n              </span>\n              <button\n                type=\"button\"\n                onClick={handleSignOut}\n                className=\"rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-300\"\n              >\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <span className=\"text-sm text-slate-500\">Browsing as guest</span>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl space-y-6 px-4 py-6\">\n        {notice && (\n          <div\n            role=\"status\"\n            className=\"flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm\"\n          >\n            <span>{notice}</span>\n            <button\n              type=\"button\"\n              onClick={() => setNotice(null)}\n              className=\"font-medium text-slate-400 hover:text-slate-600\"\n              aria-label=\"Dismiss message\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n\n        {!session ? (\n          <AuthForms onAuthed={handleAuthed} />\n        ) : (\n          <UploadForm\n            session={session}\n            onUploaded={handleUploaded}\n            onAuthError={handleAuthError}\n          />\n        )}\n\n        <section aria-label=\"Gallery\" className=\"space-y-4\">\n          <Gallery\n            images={list.items}\n            loading={loading}\n            error={listError}\n            onOpen={setSelected}\n          />\n\n          {list.total > 0 && (\n            <nav\n              aria-label=\"Pagination\"\n              className=\"flex flex-wrap items-center justify-between gap-3\"\n            >\n              <p className=\"text-sm text-slate-600\">\n                {list.total} image{list.total === 1 ? \"\" : \"s\"} · Page {page} of{\" \"}\n                {pages}\n              </p>\n              <div className=\"flex gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setPage((p) => Math.max(1, p - 1))}\n                  disabled={page <= 1}\n                  className=\"rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  Previous\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setPage((p) => Math.min(pages, p + 1))}\n                  disabled={page >= pages}\n                  className=\"rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  Next\n                </button>\n              </div>\n            </nav>\n          )}\n        </section>\n      </main>\n\n      {selected && (\n        <ImageDetail\n          image={selected}\n          session={session}\n          onClose={() => setSelected(null)}\n          onDelete={handleDelete}\n        />\n      )}\n    </div>\n  );\n}","lineStart":1,"lineEnd":215,"totalLines":215,"truncated":false}},"title":"frontend/src/App.tsx","time":{"start":1794344005002,"end":1794344005018}},"id":"prt_1c73cad86001hc6YUZKlTTnCxO","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","messageID":"msg_1c73c7cc3001mKZ3hliQ3ASUVQ"}}
