{"type":"tool_use","timestamp":1794343264236,"sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","part":{"type":"tool","tool":"write","callID":"call_86862c4847264afab8600f77","state":{"status":"completed","input":{"content":"\"\"\"End-to-end API tests for the image gallery.\"\"\"\n\nimport base64\nimport json\nimport struct\nimport sys\nimport urllib.error\nimport urllib.request\nimport zlib\n\nBASE = \"http://127.0.0.1:8000\"\n\nfailures = []\n\n\ndef check(name, cond, detail=\"\"):\n    status = \"PASS\" if cond else \"FAIL\"\n    print(f\"[{status}] {name}\" + (f\" -- {detail}\" if detail and not cond else \"\"))\n    if not cond:\n        failures.append(name)\n\n\ndef request(method, path, body=None, token=None, raw=False):\n    headers = {}\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        headers[\"Content-Type\"] = \"application/json\"\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    req = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req) as resp:\n            payload = resp.read()\n            status = resp.status\n            ctype = resp.headers.get(\"Content-Type\", \"\")\n    except urllib.error.HTTPError as exc:\n        payload = exc.read()\n        status = exc.code\n        ctype = exc.headers.get(\"Content-Type\", \"\")\n    if raw:\n        return status, payload, ctype\n    try:\n        parsed = json.loads(payload) if payload else None\n    except json.JSONDecodeError:\n        parsed = payload.decode(errors=\"replace\")\n    return status, parsed, ctype\n\n\ndef png_bytes():\n    def chunk(tag, data):\n        return (\n            struct.pack(\">I\", len(data))\n            + tag\n            + data\n            + struct.pack(\">I\", zlib.crc32(tag + data) & 0xFFFFFFFF)\n        )\n\n    ihdr = struct.pack(\">IIBBBBB\", 1, 1, 8, 6, 0, 0, 0)\n    raw = zlib.compress(b\"\\x00\\x00\\x00\\x00\\x00\")\n    return b\"\\x89PNG\\r\\n\\x1a\\n\" + chunk(b\"IHDR\", ihdr) + chunk(b\"IDAT\", raw) + chunk(b\"IEND\", b\"\")\n\n\nPNG = png_bytes()\nJPEG = b\"\\xff\\xd8\\xff\\xe0\\x00\\x10JFIF\\x00\\x01\\x01\\x00\\x00\\x01\\x00\\x01\\x00\\x00\\xff\\xd9\"\n\n# health + frontend\nstatus, body, _ = request(\"GET\", \"/api/health\")\ncheck(\"health\", status == 200 and body == {\"status\": \"ok\"}, str(body))\n\nstatus, body, ctype = request(\"GET\", \"/\", raw=True)\ncheck(\"serves frontend index\", status == 200 and b\"root\" in body and \"text/html\" in ctype)\n\nstatus, body, _ = request(\"GET\", \"/assets/does-not-exist.js\")\ncheck(\"unknown asset falls back to index\", status == 200 and isinstance(body, str) and '<div id=\"root\">' in body)\n\n# list when empty\nstatus, body, _ = request(\"GET\", \"/api/images\")\ncheck(\n    \"empty list shape\",\n    status == 200\n    and body == {\"items\": [], \"total\": 0, \"page\": 1, \"page_size\": 20},\n    str(body),\n)\n\n# auth required\nstatus, body, _ = request(\"POST\", \"/api/images\", {\"filename\": \"x.png\", \"data\": \"\"})\ncheck(\"upload without token -> 401\", status == 401 and \"error\" in body, str(body))\nstatus, body, _ = request(\"DELETE\", \"/api/images/1\")\ncheck(\"delete without token -> 401\", status == 401, str(body))\nstatus, body, _ = request(\"POST\", \"/api/images\", {\"filename\": \"x.png\", \"data\": \"\"}, token=\"bogus\")\ncheck(\"upload with bad token -> 401\", status == 401, str(body))\n\n# register / login\nstatus, body, _ = request(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"register -> 201\", status == 201, str(body))\nstatus, body, _ = request(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"other\"})\ncheck(\"duplicate register -> 409\", status == 409 and \"error\" in body, str(body))\nstatus, body, _ = request(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username -> 400\", status == 400, str(body))\nstatus, body, _ = request(\"POST\", \"/api/auth/register\", {\"username\": \"bob\"})\ncheck(\"register missing password -> 400\", status == 400, str(body))\n\nstatus, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"})\ncheck(\"login bad password -> 401\", status == 401 and \"error\" in body, str(body))\nstatus, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"})\ncheck(\"login -> 200 token\", status == 200 and isinstance(body.get(\"token\"), str) and body[\"token\"], str(body))\ntoken_alice = body.get(\"token\", \"\")\n\nstatus, body, _ = request(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"hunter22\"})\ncheck(\"second user register\", status == 201, str(body))\nstatus, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"hunter22\"})\ntoken_bob = body.get(\"token\", \"\")\ncheck(\"second user login\", status == 200 and token_bob, str(body))\n\n# upload png\npng_b64 = base64.b64encode(PNG).decode()\nstatus, body, _ = request(\n    \"POST\",\n    \"/api/images\",\n    {\"filename\": \"dot.png\", \"data\": png_b64, \"title\": \"A dot\"},\n    token=token_alice,\n)\ncheck(\"upload png -> 201\", status == 201, str(body))\nimg1 = body or {}\nrequired_keys = {\"id\", \"filename\", \"title\", \"content_type\", \"size_bytes\", \"uploaded_at\", \"url\", \"uploader\"}\ncheck(\"image keys\", required_keys.issubset(set(img1)), str(sorted(img1)))\ncheck(\"png fields\", img1.get(\"content_type\") == \"image/png\" and img1.get(\"size_bytes\") == len(PNG)\n      and img1.get(\"filename\") == \"dot.png\" and img1.get(\"title\") == \"A dot\"\n      and img1.get(\"uploader\") == \"alice\" and img1.get(\"url\") == f\"/api/images/{img1.get('id')}/file\",\n      str(img1))\ncheck(\"uploaded_at present\", isinstance(img1.get(\"uploaded_at\"), str) and img1[\"uploaded_at\"], str(img1))\n\n# file endpoint\nstatus, data, ctype = request(\"GET\", img1[\"url\"], raw=True)\ncheck(\"file bytes unchanged\", status == 200 and data == PNG, f\"status={status} len={len(data)}\")\ncheck(\"file content type\", ctype.startswith(\"image/png\"), ctype)\n\n# get one\nstatus, body, _ = request(\"GET\", f\"/api/images/{img1['id']}\")\ncheck(\"get image\", status == 200 and body == img1, str(body))\nstatus, body, _ = request(\"GET\", \"/api/images/999999\")\ncheck(\"get missing image -> 404\", status == 404 and \"error\" in body, str(body))\n\n# data-url prefix accepted\nstatus, body, _ = request(\n    \"POST\",\n    \"/api/images\",\n    {\"filename\": \"dot.png\", \"data\": f\"data:image/png;base64,{png_b64}\"},\n    token=token_alice,\n)\ncheck(\"data-url base64 accepted\", status == 201, str(body))\nimg_dataurl = body or {}\n\n# jpeg with same filename stays separate\njpeg_b64 = base64.b64encode(JPEG).decode()\nstatus, body, _ = request(\n    \"POST\",\n    \"/api/images\",\n    {\"filename\": \"dot.png\", \"data\": jpeg_b64},\n    token=token_bob,\n)\ncheck(\"upload jpeg same filename -> 201\", status == 201, str(body))\nimg2 = body or {}\ncheck(\n    \"separate ids for same filename\",\n    img2.get(\"id\") not in (None, img1.get(\"id\"), img_dataurl.get(\"id\")),\n    str(img2),\n)\ncheck(\"jpeg content type\", img2.get(\"content_type\") == \"image/jpeg\", str(img2))\nstatus, data, ctype = request(\"GET\", img2[\"url\"], raw=True)\ncheck(\"jpeg file bytes\", status == 200 and data == JPEG and ctype.startswith(\"image/jpeg\"), ctype)\n\n# wrong format rejected based on content, not name\nstatus, body, _ = request(\n    \"POST\",\n    \"/api/images\",\n    {\"filename\": \"fake.png\", \"data\": base64.b64encode(b\"GIF89a-not-an-image\").decode()},\n    token=token_alice,\n)\ncheck(\"gif bytes named .png rejected\", status == 400 and \"error\" in body, str(body))\n\n# png bytes with .jpg name accepted (content decides)\nstatus, body, _ = request(\n    \"POST\",\n    \"/api/images\",\n    {\"filename\": \"actually.png.jpg\", \"data\": png_b64},\n    token=token_alice,\n)\ncheck(\"png bytes named .jpg accepted\", status == 201 and body.get(\"content_type\") == \"image/png\", str(body))\nimg3 = body or {}\n\n# invalid base64\nstatus, body, _ = request(\n    \"POST\",\n    \"/api/images\",\n    {\"filename\": \"bad.png\", \"data\": \"!!!not-base64!!!\"},\n    token=token_alice,\n)\ncheck(\"invalid base64 -> 400\", status == 400 and \"error\" in body, str(body))\n\n# missing fields\nstatus, body, _ = request(\"POST\", \"/api/images\", {\"data\": png_b64}, token=token_alice)\ncheck(\"missing filename -> 400\", status == 400, str(body))\nstatus, body, _ = request(\"POST\", \"/api/images\", {\"filename\": \"a.png\"}, token=token_alice)\ncheck(\"missing data -> 400\", status == 400, str(body))\n\n# pagination + ordering (newest first)\ncreated = []\nfor i in range(5):\n    status, body, _ = request(\n        \"POST\",\n        \"/api/images\",\n        {\"filename\": f\"p{i}.png\", \"data\": png_b64, \"title\": f\"page-test-{i}\"},\n        token=token_alice,\n    )\n    created.append(body)\ncheck(\"created 5 more\", all(item.get(\"id\") for item in created) and status == 201, str(body))\n\nstatus, body, _ = request(\"GET\", \"/api/images?page=1&page_size=2\")\ncheck(\n    \"page 1 shape\",\n    status == 200\n    and body.get(\"page\") == 1\n    and body.get(\"page_size\") == 2\n    and body.get(\"total\") == 8\n    and len(body.get(\"items\", [])) == 2,\n    str(body),\n)\nids_p1 = [item[\"id\"] for item in body[\"items\"]]\nstatus, body2, _ = request(\"GET\", \"/api/images?page=2&page_size=2\")\nids_p2 = [item[\"id\"] for item in body2[\"items\"]]\ncheck(\"pages do not overlap\", not set(ids_p1) & set(ids_p2), str((ids_p1, ids_p2)))\ncheck(\"newest first\", ids_p1[0] > ids_p1[1] and ids_p1[-1] > ids_p2[0], str((ids_p1, ids_p2)))\nexpected_order = [item[\"id\"] for item in reversed(created)]\nstatus, body3, _ = request(\"GET\", \"/api/images?page=1&page_size=20\")\nall_ids = [item[\"id\"] for item in body3[\"items\"]]\ncheck(\"all newest first\", all_ids[:5] == expected_order,\n      str((all_ids, expected_order)))\ncheck(\"total 8\", body3.get(\"total\") == 8, str(body3.get(\"total\")))\nstatus, body4, _ = request(\"GET\", \"/api/images?page=99&page_size=20\")\ncheck(\"page beyond range\", status == 200 and body4[\"items\"] == [] and body4[\"total\"] == 8, str(body4))\nstatus, body5, _ = request(\"GET\", \"/api/images?page=abc\")\ncheck(\"bad page -> 400\", status == 400 and \"error\" in body5, str(body5))\n\n# delete permissions\nstatus, body, _ = request(\"DELETE\", f\"/api/images/{img1['id']}\", token=token_bob)\ncheck(\"non-uploader delete -> 403\", status == 403 and \"error\" in body, str(body))\nstatus, body, _ = request(\"GET\", f\"/api/images/{img1['id']}\")\ncheck(\"image survives foreign delete\", status == 200, str(status))\n\nstatus, _, _ = request(\"DELETE\", f\"/api/images/{img1['id']}\", token=token_alice)\ncheck(\"uploader delete -> 2xx\", 200 <= status < 300, str(status))\nstatus, body, _ = request(\"GET\", f\"/api/images/{img1['id']}\")\ncheck(\"deleted image gone\", status == 404, str(body))\nstatus, _, _ = request(\"GET\", f\"/api/images/{img1['id']}/file\")\ncheck(\"deleted file gone\", status == 404, str(status))\nstatus, body, _ = request(\"DELETE\", f\"/api/images/{img1['id']}\", token=token_alice)\ncheck(\"double delete -> 404\", status == 404, str(body))\nstatus, body, _ = request(\"DELETE\", f\"/api/images/{img2['id']}\", token=token_alice)\ncheck(\"other's image delete -> 403\", status == 403, str(body))\n\n# auth endpoint edge cases\nstatus, body, _ = request(\"POST\", \"/api/auth/login\", {\"username\": \"ghost\", \"password\": \"x\"})\ncheck(\"login unknown user -> 401\", status == 401, str(body))\nstatus, body, _ = request(\"GET\", \"/api/nope\")\ncheck(\"unknown api route -> 404 json\", status == 404 and isinstance(body, dict) and \"error\" in body, str(body))\n\nprint()\nif failures:\n    print(f\"{len(failures)} FAILED: {failures}\")\n    sys.exit(1)\nprint(\"ALL PASSED\")\n","filePath":"/workspace/.test_api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/.test_api.py","exists":true,"truncated":false},"title":".test_api.py","time":{"start":1794343264206,"end":1794343264217}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7315fc8001tWIhCCw7ZUH5jP","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","messageID":"msg_1c7304984001LgLpGUr1h4zeT4"}}
