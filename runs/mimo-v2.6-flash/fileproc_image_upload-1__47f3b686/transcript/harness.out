INFO] Control socket listening at /run/home/.gunicorn/gunicorn.ctl\n","exit":0,"truncated":false},"title":"node -e \"\nconst BASE='http://127.0.0.1:8000';\n(async()=>{\n  const r = await fetch(BASE+'/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:'bob'+Date.now(),password:'x1'})});\n  console.log('register', r.status, await r.text());\n  const l = await fetch(BASE+'/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:'alice',password:'secret1'})});\n  console.log('login', l.status, (await l.text()).slice(0,80));\n})().catch(e=>console.error('ERR',e));\n\"; curl -s -m 5 http://127.0.0.1:8000/api/health; echo; cat gunicorn.log 2>/dev/null | tail -5","time":{"start":1794344266101,"end":1794344266518}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c740a96f001U5oPDjrud5WIUo","sessionID":"ses_e38dce68fffekvhklwtw9VZA4b","messageID":"msg_1c73ff40a001oucfgNDnQ511Li"}}
