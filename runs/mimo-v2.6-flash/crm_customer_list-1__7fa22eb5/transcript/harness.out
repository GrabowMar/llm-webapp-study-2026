t>","metadata":{"preview":"        else:\n            errors[\"kind\"] = \"Kind must be one of: call, email, meeting.\"\n\n    summary = read_text(data, \"summary\", \"Summary\", True, errors)\n    if summary is not None:\n        values[\"summary\"] = summary\n\n    occurred = data.get(\"occurred_at\")\n    if occurred is None or occurred == \"\":\n        values[\"occurred_at\"] = now_iso()\n    elif isinstance(occurred, str):\n        try:\n            parsed = datetime.fromisoformat(occurred.replace(\"Z\", \"+00:00\"))\n        except ValueError:\n            errors[\"occurred_at\"] = \"occurred_at must be an ISO 8601 timestamp.\"\n        else:\n            if parsed.tzinfo is None:\n                parsed = parsed.replace(tzinfo=timezone.utc)\n            values[\"occurred_at\"] = format_ts(parsed.astimezone(timezone.utc))\n    else:","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"        else:\n            errors[\"kind\"] = \"Kind must be one of: call, email, meeting.\"\n\n    summary = read_text(data, \"summary\", \"Summary\", True, errors)\n    if summary is not None:\n        values[\"summary\"] = summary\n\n    occurred = data.get(\"occurred_at\")\n    if occurred is None or occurred == \"\":\n        values[\"occurred_at\"] = now_iso()\n    elif isinstance(occurred, str):\n        try:\n            parsed = datetime.fromisoformat(occurred.replace(\"Z\", \"+00:00\"))\n        except ValueError:\n            errors[\"occurred_at\"] = \"occurred_at must be an ISO 8601 timestamp.\"\n        else:\n            if parsed.tzinfo is None:\n                parsed = parsed.replace(tzinfo=timezone.utc)\n            values[\"occurred_at\"] = format_ts(parsed.astimezone(timezone.utc))\n    else:\n        errors[\"occurred_at\"] = \"occurred_at must be an ISO 8601 timestamp.\"\n\n    if errors:\n        return invalid(errors)\n\n    cursor = get_db().execute(\n        \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, \"\n        \"logged_by) VALUES (?, ?, ?, ?, ?)\",\n        (\n            customer_id,\n            values[\"kind\"],\n            values[\"summary\"],\n            values[\"occurred_at\"],\n            g.username,\n        ),\n    )\n    row = fetch_interaction(int(cursor.lastrowid))\n    return jsonify(interaction_dict(row)), 201\n\n\n# ---------------------------------------------------------------------------\n# Companies\n\n\n@app.get(\"/api/companies\")\n@login_required\ndef list_companies():\n    rows = get_db().execute(\n        \"SELECT DISTINCT company FROM customers \"\n        \"WHERE company IS NOT NULL AND company != '' \"\n        \"ORDER BY company COLLATE NOCASE ASC\"\n    ).fetchall()\n    return jsonify({\"items\": [row[\"company\"] for row in rows]})\n\n\n# ---------------------------------------------------------------------------\n# Health and hosting\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.route(\n    \"/api/<path:path>\",\n    methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\", \"HEAD\", \"OPTIONS\"],\n)\ndef api_unknown(path: str):\n    return fail(\"Not found.\", 404)\n\n\n@app.errorhandler(404)\ndef not_found(err):\n    if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n        return api_not_found()\n    if (DIST / \"index.html\").is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return err\n\n\n@app.errorhandler(405)\ndef method_not_allowed(err):\n    if request.path == \"/api\" or request.path.startswith(\"/api/\"):\n        return fail(\"Method not allowed.\", 405)\n    return err\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return api_not_found()\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    if (DIST / \"index.html\").is_file():\n        return send_from_directory(DIST, \"index.html\")\n    return fail(\"Frontend build not found.\", 404)","lineStart":495,"lineEnd":592,"totalLines":592,"truncated":false}},"title":"backend/app.py","time":{"start":1794343335460,"end":1794343335490}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7327610001igmg7t1R4mkCdR","sessionID":"ses_e38db2bd8ffePAik0ne8IijSVn","messageID":"msg_1c732633b001Yt3RWgwBxQQuFf"}}
