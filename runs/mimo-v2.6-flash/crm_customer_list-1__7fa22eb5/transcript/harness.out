"int list empty\", c.get(\"/api/customers/2/interactions\", headers=H))\nshow(\"int missing cust\", c.get(\"/api/customers/999/interactions\", headers=H))\nshow(\"customer after ints\", c.get(\"/api/customers/1\", headers=H))\n# delete\nshow(\"delete\", c.delete(\"/api/customers/2\", headers=H))\nshow(\"get deleted\", c.get(\"/api/customers/2\", headers=H))\nshow(\"ints deleted\", c.get(\"/api/customers/2/interactions\", headers=H))\n# unknown api routes\nshow(\"unknown api\", c.get(\"/api/nope\"))\nshow(\"unknown api post\", c.post(\"/api/nope\"))\nshow(\"method not allowed\", c.put(\"/api/health\"))\nshow(\"frontend root\", c.get(\"/\").status_code)\nshow(\"frontend spa\", c.get(\"/customers/1\").status_code)\nEOF\n/workspace/.venv/bin/python /tmp/opencode/apitest.py"},"output":"/usr/bin/bash: line 1: /tmp/opencode/apitest.py: Permission denied\n/workspace/.venv/bin/python: can't open file '/tmp/opencode/apitest.py': [Errno 2] No such file or directory\n","metadata":{"output":"/usr/bin/bash: line 1: /tmp/opencode/apitest.py: Permission denied\n/workspace/.venv/bin/python: can't open file '/tmp/opencode/apitest.py': [Errno 2] No such file or directory\n","exit":2,"truncated":false},"title":"cat > /tmp/opencode/apitest.py <<'EOF'\nimport json, sys, os, shutil\nsys.path.insert(0, \"/workspace/backend\")\n# use a scratch data dir\nos.environ[\"DATA_DIR\"] = \"/tmp/opencode/testdata\"\nshutil.rmtree(\"/tmp/opencode/testdata\", ignore_errors=True)\nfrom app import app\nc = app.test_client()\n\ndef show(label, r):\n    body = r.get_json(silent=True)\n    print(f\"{label}: {r.status_code} {json.dumps(body)[:300]}\")\n\n# health\nshow(\"health\", c.get(\"/api/health\"))\n# auth required\nshow(\"no token list\", c.get(\"/api/customers\"))\n# register\nshow(\"register\", c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"secret1\"}))\nshow(\"register dup\", c.post(\"/api/auth/register\", json={\"username\": \"alice\", \"password\": \"x\"}))\nshow(\