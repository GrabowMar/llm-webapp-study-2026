leep(800);\nconst sel = window.document.querySelector(\"#page-size\");\nconsole.log(\"select found:\", !!sel, \"value:\", sel?.value);\nsel.value = \"2\";\nsel.dispatchEvent(new window.Event(\"input\", { bubbles: true }));\nsel.dispatchEvent(new window.Event(\"change\", { bubbles: true }));\nawait sleep(800);\nconsole.log(\"after change value:\", window.document.querySelector(\"#page-size\")?.value);\nconst pag = [...window.document.querySelectorAll(\"span\")].map(s => s.textContent).filter(t => t.includes(\"Page\"));\nconsole.log(\"pagination spans:\", pag);\nconsole.log(\"rows:\", [...window.document.querySelectorAll(\"tbody a\")].map(a => a.textContent));\nEOF\nnode .smoke/debug.mjs","timeout":60000},"output":"node:internal/modules/run_main:107\n    triggerUncaughtException(\n    ^\n\nError [ERR_MODULE_NOT_FOUND]: Cannot find module '/workspace/frontend/.smoke/.smoke/smoke-entry.js' imported from /workspace/frontend/.smoke/debug.mjs\nDid you mean to import \"./smoke-entry.js\"?\n    at finalizeResolution (node:internal/modules/esm/resolve:272:11)\n    at moduleResolve (node:internal/modules/esm/resolve:879:10)\n    at defaultResolve (node:internal/modules/esm/resolve:1006:11)\n    at #cachedDefaultResolve (node:internal/modules/esm/loader:705:20)\n    at #resolveAndMaybeBlockOnLoaderThread (node:internal/modules/esm/loader:725:38)\n    at ModuleLoader.resolveSync (node:internal/modules/esm/loader:763:56)\n    at #resolve (node:internal/modules/esm/loader:687:17)\n    at ModuleLoader.getOrCreateModuleJob (node:internal/modules/esm/loader:607:35)\n    at node:internal/modules/esm/loader:636:32\n    at TracingChannel.tracePromise (node:diagnostics_channel:370:14) {\n  code: 'ERR_MODULE_NOT_FOUND',\n  url: 'file:///workspace/frontend/.smoke/.smoke/smoke-entry.js'\n}\n\nNode.js v24.22.1\n","metadata":{"output":"node:internal/modules/run_main:107\n    triggerUncaughtException(\n    ^\n\nError [ERR_MODULE_NOT_FOUND]: Cannot find module '/workspace/frontend/.smoke/.smoke