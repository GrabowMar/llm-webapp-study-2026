{"type":"tool_use","timestamp":1794351560419,"sessionID":"ses_e3865d475ffeWX1dsogsfu9qqZ","part":{"type":"tool","tool":"write","callID":"call_8b08a32479a24d9b8bb386f3","state":{"status":"completed","input":{"content":"import { JSDOM } from \"jsdom\";\n\nconst BASE = \"http://127.0.0.1:8000\";\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n\nfunction assert(condition, label, detail = \"\") {\n  if (!condition) throw new Error(`ASSERT FAILED: ${label} ${detail}`);\n}\n\nasync function api(method, path, body, token) {\n  const headers = { \"Content-Type\": \"application/json\" };\n  if (token) headers.Authorization = `Bearer ${token}`;\n  const res = await fetch(BASE + path, {\n    method,\n    headers,\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const text = await res.text();\n  return { status: res.status, body: text ? JSON.parse(text) : null };\n}\n\n// ---- API setup ----------------------------------------------------------\nconst username = `smoke${Date.now()}`;\nlet res = await api(\"POST\", \"/api/auth/register\", { username, password: \"pw123456\" });\nassert(res.status === 201, \"register\", JSON.stringify(res));\nres = await api(\"POST\", \"/api/auth/login\", { username, password: \"pw123456\" });\nassert(res.status === 200 && res.body.token, \"login\", JSON.stringify(res));\nconst token = res.body.token;\n\nres = await api(\n  \"POST\",\n  \"/api/items\",\n  { name: \"Alpha Bolt\", sku: \"AB-1\", location: \"Aisle A\", quantity: 50, reorder_level: 5 },\n  token,\n);\nassert(res.status === 201, \"create alpha\", JSON.stringify(res));\nres = await api(\n  \"POST\",\n  \"/api/items\",\n  { name: \"Zebra Tool\", sku: \"ZT-1\", location: \"Aisle B\", quantity: 5, reorder_level: 10 },\n  token,\n);\nassert(res.status === 201, \"create zebra\", JSON.stringify(res));\n\n// ---- jsdom setup --------------------------------------------------------\nconst dom = new JSDOM(\n  '<!DOCTYPE html><html><body><div id=\"root\"></div></body></html>',\n  { url: BASE + \"/\", pretendToBeVisual: true },\n);\nconst { window } = dom;\n\nfor (const key of [\n  \"window\",\n  \"document\",\n  \"navigator\",\n  \"HTMLElement\",\n  \"HTMLInputElement\",\n  \"HTMLSelectElement\",\n  \"HTMLButtonElement\",\n  \"Element\",\n  \"Node\",\n  \"Event\",\n  \"CustomEvent\",\n  \"MouseEvent\",\n  \"KeyboardEvent\",\n  \"localStorage\",\n  \"getComputedStyle\",\n  \"requestAnimationFrame\",\n  \"cancelAnimationFrame\",\n  \"MutationObserver\",\n]) {\n  if (window[key] !== undefined) globalThis[key] = window[key];\n}\nglobalThis.window = window;\nglobalThis.document = window.document;\nwindow.scrollTo = () => {};\n\nconst realFetch = globalThis.fetch;\nconst wrappedFetch = (input, init) => {\n  const url =\n    typeof input === \"string\" && !input.startsWith(\"http\") ? BASE + input : input;\n  return realFetch(url, init);\n};\nglobalThis.fetch = wrappedFetch;\nwindow.fetch = wrappedFetch;\n\nconst errors = [];\nconst origError = console.error;\nconsole.error = (...args) => {\n  errors.push(args.map(String).join(\" \"));\n  origError(...args);\n};\n\n// ---- helpers ------------------------------------------------------------\nasync function waitFor(predicate, label, timeoutMs = 8000) {\n  const start = Date.now();\n  for (;;) {\n    const value = predicate();\n    if (value) return value;\n    if (Date.now() - start > timeoutMs) {\n      throw new Error(\n        `TIMEOUT waiting for: ${label}\\nBODY: ${window.document.body.innerHTML.slice(0, 3000)}`,\n      );\n    }\n    await sleep(50);\n  }\n}\n\nconst bodyText = () => window.document.body.textContent || \"\";\nconst bodyHTML = () => window.document.body.innerHTML;\n\nfunction setValue(selector, value) {\n  const el = window.document.querySelector(selector);\n  assert(el, `element ${selector} exists`);\n  const proto =\n    el.tagName === \"SELECT\"\n      ? window.HTMLSelectElement.prototype\n      : window.HTMLInputElement.prototype;\n  Object.getOwnPropertyDescriptor(proto, \"value\").set.call(el, value);\n  el.dispatchEvent(new window.Event(\"input\", { bubbles: true }));\n  el.dispatchEvent(new window.Event(\"change\", { bubbles: true }));\n  return el;\n}\n\nfunction submitForm(selector) {\n  const form = window.document.querySelector(selector);\n  assert(form, `form ${selector} exists`);\n  form.dispatchEvent(new window.Event(\"submit\", { bubbles: true, cancelable: true }));\n}\n\nfunction go(path) {\n  window.history.pushState({}, \"\", path);\n  window.dispatchEvent(new window.PopStateEvent(\"popstate\"));\n}\n\nfunction click(selector) {\n  const el = window.document.querySelector(selector);\n  assert(el, `element ${selector} exists`);\n  el.dispatchEvent(new window.MouseEvent(\"click\", { bubbles: true, cancelable: true }));\n}\n\n// ---- mount --------------------------------------------------------------\nwindow.localStorage.setItem(\"inventory_token\", token);\nwindow.localStorage.setItem(\"inventory_username\", username);\n\nconst { mount } = await import(\"./smoke-entry.js\");\nmount(window.document.getElementById(\"root\"));\n\n// ---- assertions ---------------------------------------------------------\nawait waitFor(() => bodyText().includes(\"Warehouse Inventory\"), \"header\");\nawait waitFor(() => bodyText().includes(\"Alpha Bolt\"), \"item list loads\");\nassert(\n  window.document.querySelector(`tr[class*=\"bg-amber-100\"]`)?.textContent?.includes(\"Zebra Tool\"),\n  \"low-stock row highlighted\",\n  bodyHTML().slice(0, 500),\n);\nassert(\n  bodyText().includes(username),\n  \"signed-in username shown\",\n);\nassert(!bodyText().includes(\"Sign in\\n\") && !window.document.querySelector('a[href=\"/login\"]'),\n  \"sign-in link hidden when signed in\");\n\n// search\nsetValue(\"#search\", \"zebra\");\nawait waitFor(() => !bodyText().includes(\"Alpha Bolt\") && bodyText().includes(\"Zebra Tool\"), \"search filters\");\nsetValue(\"#search\", \"\");\nawait waitFor(() => bodyText().includes(\"Alpha Bolt\"), \"search cleared\");\n\n// low stock switch\nclick(`button[role=\"switch\"]`);\nawait waitFor(() => !bodyText().includes(\"Alpha Bolt\") && bodyText().includes(\"Zebra Tool\"), \"low stock switch\");\nclick(`button[role=\"switch\"]`);\nawait waitFor(() => bodyText().includes(\"Alpha Bolt\"), \"low stock switch off\");\n\n// location filter\nsetValue(\"#location\", \"Aisle A\");\nawait waitFor(() => bodyText().includes(\"Alpha Bolt\") && !bodyText().includes(\"Zebra Tool\"), \"location filter\");\nsetValue(\"#location\", \"\");\nawait waitFor(() => bodyText().includes(\"Zebra Tool\"), \"location filter cleared\");\n\n// paging: shrink page size so 3 items need 2 pages (seed a third)\nawait api(\n  \"POST\",\n  \"/api/items\",\n  { name: \"Beta Cable\", sku: \"BC-1\", location: \"Aisle A\", quantity: 20, reorder_level: 2 },\n  token,\n);\n// remount list data by nudging the reload: navigate away and back\ngo(\"/login\");\nawait waitFor(() => bodyText().includes(\"Sign in\"), \"login page\");\ngo(\"/\");\nawait waitFor(() => bodyText().includes(\"Beta Cable\"), \"list after add\");\nsetValue(\"#page-size\", \"2\");\nawait waitFor(\n  () => bodyText().includes(\"Page 1 of 2\") && !bodyText().includes(\"Beta Cable\"),\n  \"paging page 1\",\n);\nclick(\"main button:not([role=switch])\"); // Previous (disabled) — ensure no crash\nconst nextButtons = [...window.document.querySelectorAll(\"button\")].filter((b) =>\n  b.textContent === \"Next\",\n);\nassert(nextButtons.length === 1, \"next button exists\");\nnextButtons[0].dispatchEvent(new window.MouseEvent(\"click\", { bubbles: true }));\nawait waitFor(() => bodyText().includes(\"Page 2 of 2\"), \"paging page 2\");\nsetValue(\"#page-size\", \"20\");\nawait waitFor(() => bodyText().includes(\"Page 1 of 1\"), \"paging reset\");\n\n// ---- add item with validation message -----------------------------------\ngo(\"/items/new\");\nawait waitFor(() => bodyText().includes(\"Add item\"), \"add form\");\nsetValue(\"#name\", \"Gamma Gadget\");\nsetValue(\"#sku\", \"AB-1\"); // duplicate\nsetValue(\"#item-location\", \"Aisle C\");\nsetValue(\"#reorder\", \"3\");\nsetValue(\"#quantity\", \"4\");\nsubmitForm(\"form\");\nawait waitFor(() => bodyText().includes(\"SKU already exists\"), \"duplicate sku message\", 5000);\nsetValue(\"#sku\", \"GG-1\");\nsubmitForm(\"form\");\nawait waitFor(\n  () => window.location.pathname.startsWith(\"/items/\") && bodyText().includes(\"Gamma Gadget\"),\n  \"navigated to new item\",\n);\n\n// ---- movements ----------------------------------------------------------\nawait waitFor(() => bodyText().includes(\"Receive\") && bodyText().includes(\"Take out\"), \"movement forms\");\nassert(bodyText().includes(\"4\"), \"opening quantity shown\");\n\n// insufficient take-out\nsetValue(\"#take-qty\", \"100\");\nsetValue(\"#take-reason\", \"too much\");\nsubmitForm(\"form:last-of-type\");\nawait waitFor(() => bodyText().includes(\"Insufficient stock\"), \"insufficient stock message\");\nassert(\n  window.document.querySelectorAll(\"tbody tr\").length >= 1,\n  \"movement table present\",\n);\n\n// receive\nsetValue(\"#receive-qty\", \"6\");\nsetValue(\"#receive-reason\", \"restock\");\nconst forms = [...window.document.querySelectorAll(\"form\")];\nforms[0].dispatchEvent(new window.Event(\"submit\", { bubbles: true, cancelable: true }));\nawait waitFor(() => bodyText().includes(\"restock\"), \"receive recorded\");\nawait waitFor(() => /\\b10\\b/.test(bodyText()), \"quantity updated to 10\");\nassert(bodyText().includes(\"+6\"), \"delta shown\");\n\n// ---- edit ----------------------------------------------------------------\ngo(\"/items/3/edit\");\nawait waitFor(() => bodyText().includes(\"Edit item\"), \"edit form loads\");\nawait waitFor(\n  () => window.document.querySelector(\"#name\")?.value === \"Gamma Gadget\",\n  \"edit form prefilled\",\n);\nsetValue(\"#name\", \"Gamma Gadget Pro\");\nsetValue(\"#sku\", \"ZT-1\"); // duplicate of existing\nsubmitForm(\"form\");\nawait waitFor(() => bodyText().includes(\"SKU already exists\"), \"edit duplicate sku message\");\nsetValue(\"#sku\", \"GG-1\");\nsubmitForm(\"form\");\nawait waitFor(() => bodyText().includes(\"Gamma Gadget Pro\"), \"edit saved\");\n\n// ---- delete with confirmation -------------------------------------------\nlet confirmed = false;\nwindow.confirm = () => {\n  confirmed = true;\n  return false;\n};\nconst deleteBtn = [...window.document.querySelectorAll(\"button\")].find(\n  (b) => b.textContent === \"Delete item\",\n);\nassert(deleteBtn, \"delete button exists\");\ndeleteBtn.dispatchEvent(new window.MouseEvent(\"click\", { bubbles: true, cancelable: true }));\nassert(confirmed, \"delete asks for confirmation\");\n\nwindow.confirm = () => true;\ndeleteBtn.dispatchEvent(new window.MouseEvent(\"click\", { bubbles: true, cancelable: true }));\nawait waitFor(() => window.location.pathname === \"/\", \"navigated home after delete\");\nawait waitFor(() => !bodyText().includes(\"Gamma Gadget Pro\"), \"item deleted from list\");\n\n// ---- sign out -----------------------------------------------------------\nconst signOut = [...window.document.querySelectorAll(\"button\")].find(\n  (b) => b.textContent === \"Sign out\",\n);\nassert(signOut, \"sign out button exists\");\nsignOut.dispatchEvent(new window.MouseEvent(\"click\", { bubbles: true, cancelable: true }));\nawait waitFor(() => bodyText().includes(\"Sign in\"), \"signed out\");\nassert(!bodyText().includes(username), \"username hidden after sign out\");\n\n// signed-out guard\ngo(\"/items/new\");\nawait waitFor(() => bodyText().includes(\"Sign in required\"), \"add form guard\");\ngo(\"/login\");\nawait waitFor(() => bodyText().includes(\"Username\") && bodyText().includes(\"Password\"), \"login form\");\n\n// React console.error should not contain crashes (act warnings tolerated)\nconst serious = errors.filter(\n  (line) =>\n    !line.includes(\"not wrapped in act\") &&\n    !line.includes(\"Each child in a list\") &&\n    !line.includes(\"Warning:\"),\n);\nassert(serious.length === 0, \"no react errors\", serious.slice(0, 3).join(\" | \"));\n\nconsole.log(\"SMOKE OK\");\n","filePath":"/workspace/frontend/.smoke/run.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/.smoke/run.mjs","exists":false,"truncated":false},"title":"frontend/.smoke/run.mjs","time":{"start":1794351560387,"end":1794351560401}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7aff6bf001F7jK93QLmgGjMi","sessionID":"ses_e3865d475ffeWX1dsogsfu9qqZ","messageID":"msg_1c7adc929001BkHRADBIm4WZZN"}}
