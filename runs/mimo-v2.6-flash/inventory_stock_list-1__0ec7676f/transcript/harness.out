indow.fetch = wrapped;\n// sign in via API\nconst reg = await realFetch(BASE + \"/api/auth/register\", { method: \"POST\", headers: {\"Content-Type\":\"application/json\"}, body: JSON.stringify({ username: \"dbg\"+Date.now(), password: \"pw123456\" }) });\nconst login = await realFetch(BASE + \"/api/auth/login\", { method: \"POST\", headers: {\"Content-Type\":\"application/json\"}, body: JSON.stringify({ username: (await reg.json()).username, password: \"pw123456\" }) });\nconst { token } = await login.json();\nwindow.localStorage.setItem(\"inventory_token\", token);\nwindow.localStorage.setItem(\"inventory_username\", \"dbg\");\nconst { mount } = await import(\"./.smoke/smoke-entry.js\");\nmount(window.document.getElementById(\"root\"));\nawait sleep(800);\nconst sel = window.document.querySelector(\"#page-size\");\nconsole.log(\"select found:\", !!sel, \"value:\", sel?.value);\nsel.value = \"2\";\nsel.dispatchEvent(new window.Event(\"input\", { bubbles: true }));\nsel.dispatchEvent(new window.Event(\"change\", { bubbles: true }));\nawait sleep(800);\nconsole.log(\"after change value:\", window.document.querySelector(\"#page-size\")?.value);\nconst pag = [...window.document.querySelectorAll(\"span\")].map(s => s.textContent).filter(t => t.includes(\"Page\"));\nconsole.log(\"pagination spans:\", pag);\nconsole.log(\"rows:\", [...window.document.querySelectorAll(\"tbody a\")].map(a => a.textContent));\nEOF\nnode .smoke/debug.mjs","time":{"start":1794351953845,"end":1794351955038}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7b5f7ae001P2ruvOeRK2f8Wx","sessionID":"ses_e3865d475ffeWX1dsogsfu9qqZ","messageID":"msg_1c7b5666d001644PxKctBuCdcF"}}
