{"type":"text","timestamp":1794307431085,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"id":"prt_1c50e9a8f0017ZaP7Kah1KJiML","messageID":"msg_1c50db9d4001ELowNxwmqzwD5B","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","type":"text","text":"Now the React frontend:","time":{"start":1794307431055,"end":1794307431074}}}
{"type":"tool_use","timestamp":1794307431085,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"type":"tool","tool":"write","callID":"call_941a590a6cd64f6a8b87c655","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { ApiError, clearSession, getToken, getUsername } from \"./api\";\nimport AuthPage from \"./pages/AuthPage\";\nimport BookFormPage from \"./pages/BookFormPage\";\nimport BookPage from \"./pages/BookPage\";\nimport BooksPage from \"./pages/BooksPage\";\n\ntype Route =\n  | { name: \"books\" }\n  | { name: \"login\" }\n  | { name: \"register\" }\n  | { name: \"book-new\" }\n  | { name: \"book\"; id: number }\n  | { name: \"book-edit\"; id: number }\n  | { name: \"not-found\" };\n\nfunction parsePath(pathname: string): Route {\n  const parts = pathname.split(\"/\").filter(Boolean);\n  if (parts.length === 0) return { name: \"books\" };\n  if (parts[0] === \"login\" && parts.length === 1) return { name: \"login\" };\n  if (parts[0] === \"register\" && parts.length === 1) return { name: \"register\" };\n  if (parts[0] === \"books\") {\n    if (parts.length === 1) return { name: \"books\" };\n    if (parts[1] === \"new\" && parts.length === 2) return { name: \"book-new\" };\n    const id = Number(parts[1]);\n    if (Number.isInteger(id) && id > 0) {\n      if (parts.length === 2) return { name: \"book\", id };\n      if (parts[2] === \"edit\" && parts.length === 3) return { name: \"book-edit\", id };\n    }\n  }\n  return { name: \"not-found\" };\n}\n\nexport default function App() {\n  const [route, setRoute] = useState<Route>(() => parsePath(window.location.pathname));\n  const [username, setUsername] = useState<string | null>(() => getUsername());\n  const [authError, setAuthError] = useState<string | null>(null);\n\n  const navigate = useCallback((path: string) => {\n    window.history.pushState({}, \"\", path);\n    setRoute(parsePath(path));\n    setAuthError(null);\n  }, []);\n\n  useEffect(() => {\n    const onPop = () => setRoute(parsePath(window.location.pathname));\n    window.addEventListener(\"popstate\", onPop);\n    return () => window.removeEventListener(\"popstate\", onPop);\n  }, []);\n\n  const signIn = useCallback(\n    (token: string, name: string) => {\n      localStorage.setItem(\"token\", token);\n      localStorage.setItem(\"username\", name);\n      setUsername(name);\n      navigate(\"/\");\n    },\n    [navigate],\n  );\n\n  const signOut = useCallback(() => {\n    clearSession();\n    setUsername(null);\n    navigate(\"/\");\n  }, [navigate]);\n\n  const onApiError = useCallback((err: unknown) => {\n    if (err instanceof ApiError && err.status === 401) {\n      setUsername(null);\n      setAuthError(\"Please sign in to continue.\");\n      navigate(\"/login\");\n    }\n  }, [navigate]);\n\n  let content: React.ReactNode;\n  switch (route.name) {\n    case \"books\":\n      content = <BooksPage username={username} navigate={navigate} />;\n      break;\n    case \"login\":\n      content = (\n        <AuthPage\n          mode=\"login\"\n          onSignedIn={signIn}\n          navigate={navigate}\n          banner={authError}\n        />\n      );\n      break;\n    case \"register\":\n      content = (\n        <AuthPage mode=\"register\" onSignedIn={signIn} navigate={navigate} />\n      );\n      break;\n    case \"book-new\":\n      content = <BookFormPage mode=\"add\" navigate={navigate} onApiError={onApiError} />;\n      break;\n    case \"book\":\n      content = (\n        <BookPage\n          id={route.id}\n          username={username}\n          navigate={navigate}\n          onApiError={onApiError}\n        />\n      );\n      break;\n    case \"book-edit\":\n      content = (\n        <BookFormPage\n          mode=\"edit\"\n          bookId={route.id}\n          navigate={navigate}\n          onApiError={onApiError}\n        />\n      );\n      break;\n    default:\n      content = (\n        <div className=\"mx-auto max-w-3xl px-4 py-16 text-center\">\n          <p className=\"text-lg text-gray-600\">Page not found.</p>\n          <button\n            type=\"button\"\n            onClick={() => navigate(\"/\")}\n            className=\"mt-4 text-indigo-600 hover:underline\"\n          >\n            Back to books\n          </button>\n        </div>\n      );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 text-gray-900\">\n      <header className=\"border-b border-gray-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3\">\n          <button\n            type=\"button\"\n            onClick={() => navigate(\"/\")}\n            className=\"text-lg font-semibold tracking-tight text-indigo-700 hover:text-indigo-900\"\n          >\n            Book Library\n          </button>\n          <nav className=\"flex items-center gap-3 text-sm\">\n            {username ? (\n              <>\n                <span className=\"text-gray-600\">\n                  Signed in as <span className=\"font-medium text-gray-900\">{username}</span>\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={signOut}\n                  className=\"rounded border border-gray-300 px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100\"\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  type=\"button\"\n                  onClick={() => navigate(\"/login\")}\n                  className=\"rounded border border-gray-300 px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100\"\n                >\n                  Sign in\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => navigate(\"/register\")}\n                  className=\"rounded bg-indigo-600 px-3 py-1.5 font-medium text-white hover:bg-indigo-700\"\n                >\n                  Register\n                </button>\n              </>\n            )}\n          </nav>\n        </div>\n      </header>\n      <main>{content}</main>\n    </div>\n  );\n}\n\nexport { getToken };\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794307431062,"end":1794307431081}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c50e9a91001NyVTSywl24fy6N","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","messageID":"msg_1c50db9d4001ELowNxwmqzwD5B"}}
{"type":"tool_use","timestamp":1794307431109,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"type":"tool","tool":"write","callID":"call_279d5c1ff2d24a15bec0038e","state":{"status":"completed","input":{"content":"import { FormEvent, useState } from \"react\";\nimport { ApiError, apiFetch } from \"../api\";\n\ntype Props = {\n  mode: \"login\" | \"register\";\n  onSignedIn: (token: string, username: string) => void;\n  navigate: (path: string) => void;\n  banner?: string | null;\n};\n\nexport default function AuthPage({ mode, onSignedIn, navigate, banner }: Props) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(banner ?? null);\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  const isLogin = mode === \"login\";\n\n  async function submit(event: FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFields({});\n    try {\n      if (isLogin) {\n        const res = await apiFetch<{ token: string }>(\"/api/auth/login\", {\n          method: \"POST\",\n          body: { username, password },\n        });\n        onSignedIn(res.token, username);\n      } else {\n        await apiFetch(\"/api/auth/register\", {\n          method: \"POST\",\n          body: { username, password },\n        });\n        const res = await apiFetch<{ token: string }>(\"/api/auth/login\", {\n          method: \"POST\",\n          body: { username, password },\n        });\n        onSignedIn(res.token, username);\n      }\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else {\n        setError(\"Something went wrong. Please try again.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-md px-4 py-10\">\n      <div className=\"rounded-lg border border-gray-200 bg-white p-6 shadow-sm\">\n        <h1 className=\"text-xl font-semibold\">\n          {isLogin ? \"Sign in\" : \"Create an account\"}\n        </h1>\n        {error && (\n          <p className=\"mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {error}\n          </p>\n        )}\n        <form onSubmit={submit} className=\"mt-5 space-y-4\">\n          <div>\n            <label htmlFor=\"username\" className=\"block text-sm font-medium text-gray-700\">\n              Username\n            </label>\n            <input\n              id=\"username\"\n              name=\"username\"\n              type=\"text\"\n              autoComplete=\"username\"\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              className=\"mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n            />\n            {fields.username && (\n              <p className=\"mt-1 text-sm text-red-600\">{fields.username}</p>\n            )}\n          </div>\n          <div>\n            <label htmlFor=\"password\" className=\"block text-sm font-medium text-gray-700\">\n              Password\n            </label>\n            <input\n              id=\"password\"\n              name=\"password\"\n              type=\"password\"\n              autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              className=\"mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n            />\n            {fields.password && (\n              <p className=\"mt-1 text-sm text-red-600\">{fields.password}</p>\n            )}\n          </div>\n          <button\n            type=\"submit\"\n            disabled={busy}\n            className=\"w-full rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\"\n          >\n            {busy ? \"Please wait…\" : isLogin ? \"Sign in\" : \"Register\"}\n          </button>\n        </form>\n        <p className=\"mt-4 text-sm text-gray-600\">\n          {isLogin ? (\n            <>\n              No account yet?{\" \"}\n              <button\n                type=\"button\"\n                onClick={() => navigate(\"/register\")}\n                className=\"font-medium text-indigo-600 hover:underline\"\n              >\n                Register\n              </button>\n            </>\n          ) : (\n            <>\n              Already have an account?{\" \"}\n              <button\n                type=\"button\"\n                onClick={() => navigate(\"/login\")}\n                className=\"font-medium text-indigo-600 hover:underline\"\n              >\n                Sign in\n              </button>\n            </>\n          )}\n        </p>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/AuthPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/AuthPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/AuthPage.tsx","time":{"start":1794307431070,"end":1794307431087}},"id":"prt_1c50e9a99001gBeQjm61abjsPm","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","messageID":"msg_1c50db9d4001ELowNxwmqzwD5B"}}
{"type":"step_finish","timestamp":1794307431109,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"id":"prt_1c50e9ab3001qAAKP611l1VQET","reason":"tool-calls","messageID":"msg_1c50db9d4001ELowNxwmqzwD5B","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","type":"step-finish","tokens":{"total":73256,"input":2704,"output":2545,"reasoning":295,"cache":{"write":0,"read":67712}},"cost":0}}
{"type":"step_start","timestamp":1794307520076,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"id":"prt_1c50ff5f9001QbC76SoZ8p4c6Y","messageID":"msg_1c50e9abe001vMlp4eb3iMoAkR","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","type":"step-start"}}
{"type":"tool_use","timestamp":1794307520077,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"type":"tool","tool":"write","callID":"call_7f005eadf21b42c48504c3b5","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { ApiError, Book, BookPage, apiFetch } from \"../api\";\n\nconst PAGE_SIZE = 10;\n\ntype Props = {\n  username: string | null;\n  navigate: (path: string) => void;\n};\n\nexport default function BooksPage({ username, navigate }: Props) {\n  const [query, setQuery] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<BookPage | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    const params = new URLSearchParams();\n    if (search) params.set(\"q\", search);\n    params.set(\"page\", String(page));\n    params.set(\"page_size\", String(PAGE_SIZE));\n    apiFetch<BookPage>(`/api/books?${params.toString()}`)\n      .then((res) => {\n        if (!cancelled) {\n          setData(res);\n          setError(null);\n        }\n      })\n      .catch((err) => {\n        if (!cancelled) setError(err instanceof ApiError ? err.message : \"Failed to load books.\");\n      })\n      .finally(() => {\n        if (!cancelled) setLoading(false);\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [search, page]);\n\n  const total = data?.total ?? 0;\n  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));\n  const items = data?.items ?? [];\n\n  return (\n    <div className=\"mx-auto max-w-5xl px-4 py-8\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <h1 className=\"text-2xl font-semibold\">Books</h1>\n        {username && (\n          <button\n            type=\"button\"\n            onClick={() => navigate(\"/books/new\")}\n            className=\"rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700\"\n          >\n            Add book\n          </button>\n        )}\n      </div>\n\n      <form\n        className=\"mt-4 flex gap-2\"\n        onSubmit={(e) => {\n          e.preventDefault();\n          setPage(1);\n          setSearch(query.trim());\n        }}\n      >\n        <input\n          type=\"search\"\n          value={query}\n          onChange={(e) => setQuery(e.target.value)}\n          placeholder=\"Search by title, author or ISBN…\"\n          aria-label=\"Search books\"\n          className=\"flex-1 rounded border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n        />\n        <button\n          type=\"submit\"\n          className=\"rounded border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100\"\n        >\n          Search\n        </button>\n        {search && (\n          <button\n            type=\"button\"\n            onClick={() => {\n              setQuery(\"\");\n              setSearch(\"\");\n              setPage(1);\n            }}\n            className=\"rounded px-3 py-2 text-sm text-gray-500 hover:text-gray-800\"\n          >\n            Clear\n          </button>\n        )}\n      </form>\n\n      {error && (\n        <p className=\"mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n\n      <div className=\"mt-4 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm\">\n        <table className=\"w-full text-left text-sm\">\n          <thead className=\"border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500\">\n            <tr>\n              <th className=\"px-4 py-3\">Title</th>\n              <th className=\"px-4 py-3\">Author</th>\n              <th className=\"px-4 py-3\">Year</th>\n              <th className=\"px-4 py-3 text-right\">Average rating</th>\n            </tr>\n          </thead>\n          <tbody>\n            {loading ? (\n              <tr>\n                <td colSpan={4} className=\"px-4 py-8 text-center text-gray-500\">\n                  Loading…\n                </td>\n              </tr>\n            ) : items.length === 0 ? (\n              <tr>\n                <td colSpan={4} className=\"px-4 py-8 text-center text-gray-500\">\n                  {search ? `No books match “${search}”.` : \"No books yet.\"}\n                </td>\n              </tr>\n            ) : (\n              items.map((book: Book) => (\n                <tr\n                  key={book.id}\n                  className=\"cursor-pointer border-b border-gray-100 last:border-0 hover:bg-gray-50\"\n                  onClick={() => navigate(`/books/${book.id}`)}\n                >\n                  <td className=\"px-4 py-3 font-medium text-indigo-700 hover:underline\">\n                    {book.title}\n                  </td>\n                  <td className=\"px-4 py-3 text-gray-700\">{book.author}</td>\n                  <td className=\"px-4 py-3 text-gray-700\">{book.year ?? \"—\"}</td>\n                  <td className=\"px-4 py-3 text-right text-gray-700\">\n                    {book.average_rating === null ? (\n                      <span className=\"text-gray-400\">No reviews</span>\n                    ) : (\n                      <>\n                        <span className=\"font-medium\">{book.average_rating.toFixed(1)}</span>\n                        <span className=\"ml-1 text-gray-400\">({book.review_count})</span>\n                      </>\n                    )}\n                  </td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      {totalPages > 1 && (\n        <div className=\"mt-4 flex items-center justify-between text-sm\">\n          <span className=\"text-gray-600\">\n            {total} book{total === 1 ? \"\" : \"s\"} · Page {page} of {totalPages}\n          </span>\n          <div className=\"flex gap-2\">\n            <button\n              type=\"button\"\n              disabled={page <= 1}\n              onClick={() => setPage(page - 1)}\n              className=\"rounded border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40\"\n            >\n              Previous\n            </button>\n            <button\n              type=\"button\"\n              disabled={page >= totalPages}\n              onClick={() => setPage(page + 1)}\n              className=\"rounded border border-gray-300 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40\"\n            >\n              Next\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/BooksPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/BooksPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/BooksPage.tsx","time":{"start":1794307520006,"end":1794307520026}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c50ff601001yxkp2mjZZE2XE1","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","messageID":"msg_1c50e9abe001vMlp4eb3iMoAkR"}}
{"type":"tool_use","timestamp":1794307520077,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"type":"tool","tool":"write","callID":"call_7cd88bb9cb64400193d3ffa4","state":{"status":"completed","input":{"content":"import { FormEvent, useCallback, useEffect, useState } from \"react\";\nimport { ApiError, Book, Review, apiFetch } from \"../api\";\n\ntype Props = {\n  id: number;\n  username: string | null;\n  navigate: (path: string) => void;\n  onApiError: (err: unknown) => void;\n};\n\nexport default function BookPage({ id, username, navigate, onApiError }: Props) {\n  const [book, setBook] = useState<Book | null>(null);\n  const [reviews, setReviews] = useState<Review[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [notFound, setNotFound] = useState(false);\n\n  const [rating, setRating] = useState(\"5\");\n  const [comment, setComment] = useState(\"\");\n  const [formError, setFormError] = useState<string | null>(null);\n  const [formFields, setFormFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(() => {\n    Promise.all([\n      apiFetch<Book>(`/api/books/${id}`),\n      apiFetch<{ items: Review[] }>(`/api/books/${id}/reviews`),\n    ])\n      .then(([b, r]) => {\n        setBook(b);\n        setReviews(r.items);\n        setError(null);\n        setNotFound(false);\n      })\n      .catch((err) => {\n        if (err instanceof ApiError && err.status === 404) {\n          setNotFound(true);\n        } else {\n          setError(err instanceof ApiError ? err.message : \"Failed to load book.\");\n        }\n      });\n  }, [id]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  useEffect(() => {\n    if (book && book.title) document.title = `${book.title} · Book Library`;\n    return () => {\n      document.title = \"Book Library\";\n    };\n  }, [book]);\n\n  async function submitReview(event: FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setFormError(null);\n    setFormFields({});\n    try {\n      await apiFetch(`/api/books/${id}/reviews`, {\n        method: \"POST\",\n        body: { rating: Number(rating), comment },\n      });\n      setComment(\"\");\n      load();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFormError(err.message);\n        setFormFields(err.fields);\n        onApiError(err);\n      } else {\n        setFormError(\"Failed to submit review.\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function deleteBook() {\n    if (!window.confirm(\"Delete this book and all of its reviews? This cannot be undone.\")) {\n      return;\n    }\n    try {\n      await apiFetch(`/api/books/${id}`, { method: \"DELETE\" });\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        onApiError(err);\n      } else {\n        setError(\"Failed to delete book.\");\n      }\n    }\n  }\n\n  if (notFound) {\n    return (\n      <div className=\"mx-auto max-w-3xl px-4 py-16 text-center\">\n        <p className=\"text-lg text-gray-600\">This book does not exist.</p>\n        <button\n          type=\"button\"\n          onClick={() => navigate(\"/\")}\n          className=\"mt-4 text-indigo-600 hover:underline\"\n        >\n          Back to books\n        </button>\n      </div>\n    );\n  }\n\n  if (error && !book) {\n    return (\n      <div className=\"mx-auto max-w-3xl px-4 py-16\">\n        <p className=\"rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      </div>\n    );\n  }\n\n  if (!book) {\n    return (\n      <div className=\"mx-auto max-w-3xl px-4 py-16 text-center text-gray-500\">Loading…</div>\n    );\n  }\n\n  const alreadyReviewed = reviews.some((r) => r.username === username);\n\n  return (\n    <div className=\"mx-auto max-w-3xl px-4 py-8\">\n      <button\n        type=\"button\"\n        onClick={() => navigate(\"/\")}\n        className=\"text-sm text-gray-500 hover:text-gray-800\"\n      >\n        ← All books\n      </button>\n\n      <div className=\"mt-4 rounded-lg border border-gray-200 bg-white p-6 shadow-sm\">\n        <div className=\"flex flex-wrap items-start justify-between gap-3\">\n          <div>\n            <h1 className=\"text-2xl font-semibold\">{book.title}</h1>\n            <p className=\"mt-1 text-gray-700\">{book.author}</p>\n          </div>\n          {username && (\n            <div className=\"flex gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => navigate(`/books/${book.id}/edit`)}\n                className=\"rounded border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100\"\n              >\n                Edit\n              </button>\n              <button\n                type=\"button\"\n                onClick={deleteBook}\n                className=\"rounded border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50\"\n              >\n                Delete\n              </button>\n            </div>\n          )}\n        </div>\n\n        <dl className=\"mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-4\">\n          <div>\n            <dt className=\"text-gray-500\">Year</dt>\n            <dd className=\"font-medium\">{book.year ?? \"—\"}</dd>\n          </div>\n          <div>\n            <dt className=\"text-gray-500\">ISBN</dt>\n            <dd className=\"font-medium\">{book.isbn ?? \"—\"}</dd>\n          </div>\n          <div>\n            <dt className=\"text-gray-500\">Rating</dt>\n            <dd className=\"font-medium\">\n              {book.average_rating === null\n                ? \"No reviews\"\n                : `${book.average_rating.toFixed(1)} / 5`}\n            </dd>\n          </div>\n          <div>\n            <dt className=\"text-gray-500\">Reviews</dt>\n            <dd className=\"font-medium\">{book.review_count}</dd>\n          </div>\n        </dl>\n        {error && (\n          <p className=\"mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {error}\n          </p>\n        )}\n      </div>\n\n      <section className=\"mt-6\">\n        <h2 className=\"text-lg font-semibold\">Reviews</h2>\n\n        {username ? (\n          alreadyReviewed ? (\n            <p className=\"mt-3 rounded border border-gray-200 bg-white px-3 py-2 text-sm text-gray-600\">\n              You have already reviewed this book.\n            </p>\n          ) : (\n            <form\n              onSubmit={submitReview}\n              className=\"mt-3 rounded-lg border border-gray-200 bg-white p-4 shadow-sm\"\n            >\n              <h3 className=\"text-sm font-medium text-gray-700\">Write a review</h3>\n              {formError && (\n                <p className=\"mt-2 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n                  {formError}\n                </p>\n              )}\n              <div className=\"mt-3 flex items-center gap-3\">\n                <label htmlFor=\"rating\" className=\"text-sm font-medium text-gray-700\">\n                  Rating\n                </label>\n                <select\n                  id=\"rating\"\n                  value={rating}\n                  onChange={(e) => setRating(e.target.value)}\n                  className=\"rounded border border-gray-300 px-2 py-1.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                >\n                  {[5, 4, 3, 2, 1].map((n) => (\n                    <option key={n} value={n}>\n                      {n} / 5\n                    </option>\n                  ))}\n                </select>\n                {formFields.rating && (\n                  <span className=\"text-sm text-red-600\">{formFields.rating}</span>\n                )}\n              </div>\n              <div className=\"mt-3\">\n                <label htmlFor=\"comment\" className=\"block text-sm font-medium text-gray-700\">\n                  Comment\n                </label>\n                <textarea\n                  id=\"comment\"\n                  rows={3}\n                  value={comment}\n                  onChange={(e) => setComment(e.target.value)}\n                  placeholder=\"What did you think?\"\n                  className=\"mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                />\n                {formFields.comment && (\n                  <p className=\"mt-1 text-sm text-red-600\">{formFields.comment}</p>\n                )}\n              </div>\n              <button\n                type=\"submit\"\n                disabled={busy}\n                className=\"mt-3 rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\"\n              >\n                {busy ? \"Submitting…\" : \"Submit review\"}\n              </button>\n            </form>\n          )\n        ) : (\n          <p className=\"mt-3 text-sm text-gray-600\">\n            <button\n              type=\"button\"\n              onClick={() => navigate(\"/login\")}\n              className=\"font-medium text-indigo-600 hover:underline\"\n            >\n              Sign in\n            </button>{\" \"}\n            to review this book.\n          </p>\n        )}\n\n        <ul className=\"mt-4 space-y-3\">\n          {reviews.length === 0 ? (\n            <li className=\"rounded border border-gray-200 bg-white px-4 py-6 text-center text-sm text-gray-500\">\n              No reviews yet.\n            </li>\n          ) : (\n            reviews.map((review) => (\n              <li\n                key={review.id}\n                className=\"rounded-lg border border-gray-200 bg-white p-4 shadow-sm\"\n              >\n                <div className=\"flex flex-wrap items-center justify-between gap-2 text-sm\">\n                  <span className=\"font-medium text-gray-900\">{review.username}</span>\n                  <span className=\"text-gray-500\">\n                    {new Date(review.created_at).toLocaleDateString()}\n                  </span>\n                </div>\n                <div className=\"mt-1 text-sm font-medium text-amber-600\">\n                  {review.rating} / 5\n                </div>\n                {review.comment && (\n                  <p className=\"mt-2 whitespace-pre-wrap text-sm text-gray-700\">\n                    {review.comment}\n                  </p>\n                )}\n              </li>\n            ))\n          )}\n        </ul>\n      </section>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/BookPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/BookPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/BookPage.tsx","time":{"start":1794307520015,"end":1794307520032}},"id":"prt_1c50ff60a001wjDD02aWOwOTWL","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","messageID":"msg_1c50e9abe001vMlp4eb3iMoAkR"}}
