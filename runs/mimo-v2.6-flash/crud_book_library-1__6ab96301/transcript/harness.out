{"type":"tool_use","timestamp":1794308442033,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"type":"tool","tool":"bash","callID":"call_76905e23405d450e96d6913c","state":{"status":"completed","input":{"command":"python3 - <<'EOF'\nimport json, urllib.request, urllib.error\n\nBASE = \"http://localhost:8000\"\n\ndef req(method, path, body=None, token=None, expect=None):\n    data = json.dumps(body).encode() if body is not None else None\n    headers = {}\n    if data is not None: headers[\"Content-Type\"] = \"application/json\"\n    if token: headers[\"Authorization\"] = f\"Bearer {token}\"\n    r = urllib.request.Request(BASE+path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status, payload = resp.status, resp.read()\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, e.read()\n    parsed = json.loads(payload) if payload else None\n    if expect is not None:\n        assert status == expect, f\"{method} {path} -> {status}, want {expect}: {parsed}\"\n    return status, parsed\n\nfails = []\ndef check(name, cond, detail=\"\"):\n    if not cond: fails.append(f\"{name}: {detail}\")\n    print((\"ok  \" if cond else \"FAIL\") + f\" {name}\" + (\"\" if cond else f\" {detail}\"))\n\n# ---- health ----\nst, p = req(\"GET\", \"/api/health\", expect=200)\ncheck(\"health\", p == {\"status\": \"ok\"}, p)\n\n# ---- auth ----\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=201)\ncheck(\"register 201\", True)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\ncheck(\"register dup 409\", True)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", st == 400 and \"username\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"u2\", \"password\": \"\"})\ncheck(\"register empty password 400\", st == 400 and \"password\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ncheck(\"login bad 401\", True)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=200)\ntok = p.get(\"token\")\ncheck(\"login token\", isinstance(tok, str) and len(tok) > 10, p)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=201)\ntok2 = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=200)[1][\"token\"]\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=201)\ntok3 = req(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=200)[1][\"token\"]\n\n# ---- auth required ----\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"post book no auth 401\", st == 401, st)\nst, _ = req(\"PUT\", \"/api/books/1\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"put book no auth 401\", st == 401, st)\nst, _ = req(\"DELETE\", \"/api/books/1\")\ncheck(\"delete book no auth 401\", st == 401, st)\nst, _ = req(\"POST\", \"/api/books/1/reviews\", {\"rating\": 5})\ncheck(\"post review no auth 401\", st == 401, st)\n\n# ---- create books ----\nb1 = req(\"POST\", \"/api/books\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 201)[1]\nb2 = req(\"POST\", \"/api/books\", {\"title\": \"1984\", \"author\": \"George Orwell\", \"year\": 1949}, tok, 201)[1]\nb3 = req(\"POST\", \"/api/books\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\"}, tok2, 201)[1]\ncheck(\"book fields\", set(b1) == {\"id\",\"title\",\"author\",\"year\",\"isbn\",\"created_at\",\"review_count\",\"average_rating\"}, set(b1))\ncheck(\"null rating\", b1[\"average_rating\"] is None and b1[\"review_count\"] == 0, b1)\nb4 = req(\"POST\", \"/api/books\", {\"title\": \"Minimal\", \"author\": \"Anon\"}, tok, 201)[1]\ncheck(\"minimal create\", b4[\"year\"] is None and b4[\"isbn\"] is None and b4[\"review_count\"] == 0, b4)\n\n# ---- validation ----\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"\", \"author\": \"\"}, tok)\ncheck(\"book validation 400\", st == 400 and \"title\" in p.get(\"errors\", {}) and \"author\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"T\", \"author\": \"A\", \"year\": \"abc\"}, tok)\ncheck(\"year validation\", st == 400 and \"year\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"T\", \"author\": \"A\", \"year\": True}, tok)\ncheck(\"bool year rejected\", st == 400 and \"year\" in p.get(\"errors\", {}), p)\n\n# ---- listing: newest first ----\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"newest first\", [b[\"title\"] for b in p[\"items\"]] == [\"Minimal\", \"Neuromancer\", \"1984\", \"Dune\"], p[\"items\"])\ncheck(\"list shape\", set(p) == {\"items\",\"total\",\"page\",\"page_size\"}, set(p))\ncheck(\"list total=4\", p[\"total\"] == 4 and p[\"page\"] == 1 and p[\"page_size\"] == 10, p)\n\n# ---- pagination ----\nst, p = req(\"GET\", \"/api/books?page=2&page_size=3\", expect=200)\ncheck(\"page 2\", len(p[\"items\"]) == 1 and p[\"total\"] == 4 and p[\"page\"] == 2 and p[\"page_size\"] == 3, p)\nst, p = req(\"GET\", \"/api/books?page=99&page_size=2\", expect=200)\ncheck(\"empty page\", p[\"items\"] == [] and p[\"total\"] == 4, p)\nst, _ = req(\"GET\", \"/api/books?page=0\")\ncheck(\"page=0 400\", st == 400, st)\nst, _ = req(\"GET\", \"/api/books?page_size=abc\")\ncheck(\"bad page_size 400\", st == 400, st)\n\n# ---- search ----\nst, p = req(\"GET\", \"/api/books?q=orwell\", expect=200)\ncheck(\"search author\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"1984\", p)\nst, p = req(\"GET\", \"/api/books?q=dun\", expect=200)\ncheck(\"search partial\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"Dune\", p)\nst, p = req(\"GET\", \"/api/books?q=9780441\", expect=200)\ncheck(\"search isbn\", p[\"total\"] == 1, p)\nst, p = req(\"GET\", \"/api/books?q=1984\", expect=200)\ncheck(\"search title\", p[\"total\"] == 1, p)\nst, p = req(\"GET\", \"/api/books?q=zzzz\", expect=200)\ncheck(\"search none\", p[\"total\"] == 0 and p[\"items\"] == [], p)\n\n# ---- get single / 404 ----\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"get book\", p[\"title\"] == \"Dune\", p)\nst, _ = req(\"GET\", \"/api/books/999999\")\ncheck(\"get missing 404\", st == 404, st)\nst, _ = req(\"GET\", \"/api/books/abc\")\ncheck(\"get bad id 404\", st == 404, st)\nst, p = req(\"GET\", \"/api/nonexistent\")\ncheck(\"api 404 json\", st == 404 and \"error\" in p, (st, p))\n\n# ---- PUT ----\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\"}, tok, 200)\ncheck(\"put clears omitted year/isbn\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": None, \"isbn\": None}, tok, 200)\ncheck(\"explicit null clears\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": \"\", \"isbn\": \"\"}, tok, 200)\ncheck(\"empty string clears\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 200)\ncheck(\"put sets\", p[\"title\"] == \"Dune\" and p[\"year\"] == 1965 and p[\"isbn\"] == \"9780441172719\", p)\nst, p = req(\"PUT\", f\"/api/books/{b3['id']}\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\", \"year\": 1984}, tok, 200)\ncheck(\"alice edits bob's book\", p[\"year\"] == 1984, p)\nreq(\"PUT\", f\"/api/books/{b3['id']}\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\"}, tok, 200)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"x\"}, tok)\ncheck(\"put missing author 400\", st == 400 and \"author\" in p.get(\"errors\", {}), p)\nst, _ = req(\"PUT\", \"/api/books/999999\", {\"title\": \"x\", \"author\": \"y\"}, tok)\ncheck(\"put missing 404\", st == 404, st)\n\n# ---- reviews ----\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"empty reviews\", p == {\"items\": []}, p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 5, \"comment\": \"Amazing\"}, tok, 201)\ncheck(\"review shape\", set(p) == {\"id\",\"book_id\",\"rating\",\"comment\",\"created_at\",\"username\"}, set(p))\ncheck(\"review username\", p[\"username\"] == \"alice\", p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 3, \"comment\": \"again\"}, tok)\ncheck(\"one review per user 409\", st == 409, (st, p))\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 4, \"comment\": \"Solid\"}, tok2, 201)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 9}, tok2)\ncheck(\"rating range 400\", st == 400 and \"rating\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": \"x\"}, tok2)\ncheck(\"rating type 400\", st == 400, (st, p))\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 0}, tok3)\ncheck(\"rating 0 400\", st == 400, st)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"reviews newest first\", [r[\"username\"] for r in p[\"items\"]] == [\"bob\", \"alice\"], p)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"avg 2 reviews 4.5\", p[\"review_count\"] == 2 and p[\"average_rating\"] == 4.5, p)\n\n# rounding: 5,4,4 => 13/3 = 4.333... => 4.3\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 5}, tok, 201)\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok2, 201)\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok3, 201)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\", expect=200)\ncheck(\"round 1 decimal 4.3\", p[\"average_rating\"] == 4.3, p)\n# rounding: two reviews 5,4 => 4.5 exact\nst, p = req(\"GET\", f\"/api/books/{b3['id']}\", expect=200)\ncheck(\"avg null no reviews\", p[\"average_rating\"] is None and p[\"review_count\"] == 0, p)\n\n# review missing book\nst, _ = req(\"GET\", \"/api/books/999999/reviews\")\ncheck(\"reviews missing book 404\", st == 404, st)\nst, _ = req(\"POST\", \"/api/books/999999/reviews\", {\"rating\": 3}, tok)\ncheck(\"post review missing book 404\", st == 404, st)\n\n# ---- delete + cascade ----\nst, _ = req(\"DELETE\", f\"/api/books/{b2['id']}\", token=tok)\ncheck(\"delete 204\", st == 204, st)\nst, _ = req(\"GET\", f\"/api/books/{b2['id']}\")\ncheck(\"deleted 404\", st == 404, st)\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"total after delete\", p[\"total\"] == 3, p)\n# reviews of deleted book gone (no orphan access via recreating? reviews only per book id)\nst, _ = req(\"DELETE\", f\"/api/books/{b2['id']}\", token=tok)\ncheck(\"double delete 404\", st == 404, st)\n\n# ---- tokens ----\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"bogus\")\ncheck(\"bogus token 401\", st == 401, st)\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"\")\ncheck(\"empty bearer 401\", st == 401, st)\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=None)\ncheck(\"no auth header 401\", st == 401, st)\n\n# ---- malformed json ----\nr = urllib.request.Request(BASE+\"/api/books\", data=b\"not-json\",\n    headers={\"Content-Type\":\"application/json\",\"Authorization\":f\"Bearer {tok}\"}, method=\"POST\")\ntry:\n    urllib.request.urlopen(r); st = 200\nexcept urllib.error.HTTPError as e:\n    st = e.code\ncheck(\"malformed json 400\", st == 400, st)\n\n# ---- frontend ----\nwith urllib.request.urlopen(BASE + \"/\") as r:\n    html = r.read().decode()\ncheck(\"frontend html\", 'id=\"root\"' in html and \"/assets/\" in html, html[:200])\nwith urllib.request.urlopen(BASE + \"/books/1\") as r:\n    check(\"spa fallback\", r.status == 200 and 'id=\"root\"' in r.read().decode())\ntry:\n    urllib.request.urlopen(BASE + \"/assets/nope.js\")\n    st = 200\nexcept urllib.error.HTTPError as e:\n    st = e.code\ncheck(\"missing asset 404\", st == 404, st)\nwith urllib.request.urlopen(BASE + \"/api/books\") as r:\n    check(\"api list public 200\", r.status == 200)\n\nprint()\nprint(\"FAILURES:\", len(fails))\nfor f in fails: print(\" -\", f)\nraise SystemExit(1 if fails else 0)\nEOF","timeout":60000},"output":"ok   health\nok   register 201\nok   register dup 409\nok   register empty username 400\nok   register empty password 400\nok   login bad 401\nok   login token\nok   post book no auth 401\nok   put book no auth 401\nok   delete book no auth 401\nok   post review no auth 401\nok   book fields\nok   null rating\nok   minimal create\nok   book validation 400\nok   year validation\nok   bool year rejected\nok   newest first\nok   list shape\nok   list total=4\nok   page 2\nok   empty page\nok   page=0 400\nok   bad page_size 400\nok   search author\nok   search partial\nok   search isbn\nok   search title\nok   search none\nok   get book\nok   get missing 404\nok   get bad id 404\nok   api 404 json\nok   put clears omitted year/isbn\nok   explicit null clears\nok   empty string clears\nok   put sets\nok   alice edits bob's book\nok   put missing author 400\nok   put missing 404\nok   empty reviews\nok   review shape\nok   review username\nok   one review per user 409\nok   rating range 400\nok   rating type 400\nok   rating 0 400\nok   reviews newest first\nok   avg 2 reviews 4.5\nok   round 1 decimal 4.3\nok   avg null no reviews\nok   reviews missing book 404\nok   post review missing book 404\nok   delete 204\nok   deleted 404\nok   total after delete\nok   double delete 404\nok   bogus token 401\nok   empty bearer 401\nok   no auth header 401\nok   malformed json 400\nok   frontend html\nok   spa fallback\nFAIL missing asset 404 200\nok   api list public 200\n\nFAILURES: 1\n - missing asset 404: 200\n","metadata":{"output":"ok   health\nok   register 201\nok   register dup 409\nok   register empty username 400\nok   register empty password 400\nok   login bad 401\nok   login token\nok   post book no auth 401\nok   put book no auth 401\nok   delete book no auth 401\nok   post review no auth 401\nok   book fields\nok   null rating\nok   minimal create\nok   book validation 400\nok   year validation\nok   bool year rejected\nok   newest first\nok   list shape\nok   list total=4\nok   page 2\nok   empty page\nok   page=0 400\nok   bad page_size 400\nok   search author\nok   search partial\nok   search isbn\nok   search title\nok   search none\nok   get book\nok   get missing 404\nok   get bad id 404\nok   api 404 json\nok   put clears omitted year/isbn\nok   explicit null clears\nok   empty string clears\nok   put sets\nok   alice edits bob's book\nok   put missing author 400\nok   put missing 404\nok   empty reviews\nok   review shape\nok   review username\nok   one review per user 409\nok   rating range 400\nok   rating type 400\nok   rating 0 400\nok   reviews newest first\nok   avg 2 reviews 4.5\nok   round 1 decimal 4.3\nok   avg null no reviews\nok   reviews missing book 404\nok   post review missing book 404\nok   delete 204\nok   deleted 404\nok   total after delete\nok   double delete 404\nok   bogus token 401\nok   empty bearer 401\nok   no auth header 401\nok   malformed json 400\nok   frontend html\nok   spa fallback\nFAIL missing asset 404 200\nok   api list public 200\n\nFAILURES: 1\n - missing asset 404: 200\n","exit":1,"truncated":false},"title":"python3 - <<'EOF'\nimport json, urllib.request, urllib.error\n\nBASE = \"http://localhost:8000\"\n\ndef req(method, path, body=None, token=None, expect=None):\n    data = json.dumps(body).encode() if body is not None else None\n    headers = {}\n    if data is not None: headers[\"Content-Type\"] = \"application/json\"\n    if token: headers[\"Authorization\"] = f\"Bearer {token}\"\n    r = urllib.request.Request(BASE+path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status, payload = resp.status, resp.read()\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, e.read()\n    parsed = json.loads(payload) if payload else None\n    if expect is not None:\n        assert status == expect, f\"{method} {path} -> {status}, want {expect}: {parsed}\"\n    return status, parsed\n\nfails = []\ndef check(name, cond, detail=\"\"):\n    if not cond: fails.append(f\"{name}: {detail}\")\n    print((\"ok  \" if cond else \"FAIL\") + f\" {name}\" + (\"\" if cond else f\" {detail}\"))\n\n# ---- health ----\nst, p = req(\"GET\", \"/api/health\", expect=200)\ncheck(\"health\", p == {\"status\": \"ok\"}, p)\n\n# ---- auth ----\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=201)\ncheck(\"register 201\", True)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\ncheck(\"register dup 409\", True)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", st == 400 and \"username\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"u2\", \"password\": \"\"})\ncheck(\"register empty password 400\", st == 400 and \"password\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ncheck(\"login bad 401\", True)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=200)\ntok = p.get(\"token\")\ncheck(\"login token\", isinstance(tok, str) and len(tok) > 10, p)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=201)\ntok2 = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=200)[1][\"token\"]\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=201)\ntok3 = req(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=200)[1][\"token\"]\n\n# ---- auth required ----\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"post book no auth 401\", st == 401, st)\nst, _ = req(\"PUT\", \"/api/books/1\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"put book no auth 401\", st == 401, st)\nst, _ = req(\"DELETE\", \"/api/books/1\")\ncheck(\"delete book no auth 401\", st == 401, st)\nst, _ = req(\"POST\", \"/api/books/1/reviews\", {\"rating\": 5})\ncheck(\"post review no auth 401\", st == 401, st)\n\n# ---- create books ----\nb1 = req(\"POST\", \"/api/books\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 201)[1]\nb2 = req(\"POST\", \"/api/books\", {\"title\": \"1984\", \"author\": \"George Orwell\", \"year\": 1949}, tok, 201)[1]\nb3 = req(\"POST\", \"/api/books\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\"}, tok2, 201)[1]\ncheck(\"book fields\", set(b1) == {\"id\",\"title\",\"author\",\"year\",\"isbn\",\"created_at\",\"review_count\",\"average_rating\"}, set(b1))\ncheck(\"null rating\", b1[\"average_rating\"] is None and b1[\"review_count\"] == 0, b1)\nb4 = req(\"POST\", \"/api/books\", {\"title\": \"Minimal\", \"author\": \"Anon\"}, tok, 201)[1]\ncheck(\"minimal create\", b4[\"year\"] is None and b4[\"isbn\"] is None and b4[\"review_count\"] == 0, b4)\n\n# ---- validation ----\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"\", \"author\": \"\"}, tok)\ncheck(\"book validation 400\", st == 400 and \"title\" in p.get(\"errors\", {}) and \"author\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"T\", \"author\": \"A\", \"year\": \"abc\"}, tok)\ncheck(\"year validation\", st == 400 and \"year\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"T\", \"author\": \"A\", \"year\": True}, tok)\ncheck(\"bool year rejected\", st == 400 and \"year\" in p.get(\"errors\", {}), p)\n\n# ---- listing: newest first ----\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"newest first\", [b[\"title\"] for b in p[\"items\"]] == [\"Minimal\", \"Neuromancer\", \"1984\", \"Dune\"], p[\"items\"])\ncheck(\"list shape\", set(p) == {\"items\",\"total\",\"page\",\"page_size\"}, set(p))\ncheck(\"list total=4\", p[\"total\"] == 4 and p[\"page\"] == 1 and p[\"page_size\"] == 10, p)\n\n# ---- pagination ----\nst, p = req(\"GET\", \"/api/books?page=2&page_size=3\", expect=200)\ncheck(\"page 2\", len(p[\"items\"]) == 1 and p[\"total\"] == 4 and p[\"page\"] == 2 and p[\"page_size\"] == 3, p)\nst, p = req(\"GET\", \"/api/books?page=99&page_size=2\", expect=200)\ncheck(\"empty page\", p[\"items\"] == [] and p[\"total\"] == 4, p)\nst, _ = req(\"GET\", \"/api/books?page=0\")\ncheck(\"page=0 400\", st == 400, st)\nst, _ = req(\"GET\", \"/api/books?page_size=abc\")\ncheck(\"bad page_size 400\", st == 400, st)\n\n# ---- search ----\nst, p = req(\"GET\", \"/api/books?q=orwell\", expect=200)\ncheck(\"search author\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"1984\", p)\nst, p = req(\"GET\", \"/api/books?q=dun\", expect=200)\ncheck(\"search partial\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"Dune\", p)\nst, p = req(\"GET\", \"/api/books?q=9780441\", expect=200)\ncheck(\"search isbn\", p[\"total\"] == 1, p)\nst, p = req(\"GET\", \"/api/books?q=1984\", expect=200)\ncheck(\"search title\", p[\"total\"] == 1, p)\nst, p = req(\"GET\", \"/api/books?q=zzzz\", expect=200)\ncheck(\"search none\", p[\"total\"] == 0 and p[\"items\"] == [], p)\n\n# ---- get single / 404 ----\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"get book\", p[\"title\"] == \"Dune\", p)\nst, _ = req(\"GET\", \"/api/books/999999\")\ncheck(\"get missing 404\", st == 404, st)\nst, _ = req(\"GET\", \"/api/books/abc\")\ncheck(\"get bad id 404\", st == 404, st)\nst, p = req(\"GET\", \"/api/nonexistent\")\ncheck(\"api 404 json\", st == 404 and \"error\" in p, (st, p))\n\n# ---- PUT ----\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\"}, tok, 200)\ncheck(\"put clears omitted year/isbn\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": None, \"isbn\": None}, tok, 200)\ncheck(\"explicit null clears\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": \"\", \"isbn\": \"\"}, tok, 200)\ncheck(\"empty string clears\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 200)\ncheck(\"put sets\", p[\"title\"] == \"Dune\" and p[\"year\"] == 1965 and p[\"isbn\"] == \"9780441172719\", p)\nst, p = req(\"PUT\", f\"/api/books/{b3['id']}\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\", \"year\": 1984}, tok, 200)\ncheck(\"alice edits bob's book\", p[\"year\"] == 1984, p)\nreq(\"PUT\", f\"/api/books/{b3['id']}\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\"}, tok, 200)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"x\"}, tok)\ncheck(\"put missing author 400\", st == 400 and \"author\" in p.get(\"errors\", {}), p)\nst, _ = req(\"PUT\", \"/api/books/999999\", {\"title\": \"x\", \"author\": \"y\"}, tok)\ncheck(\"put missing 404\", st == 404, st)\n\n# ---- reviews ----\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"empty reviews\", p == {\"items\": []}, p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 5, \"comment\": \"Amazing\"}, tok, 201)\ncheck(\"review shape\", set(p) == {\"id\",\"book_id\",\"rating\",\"comment\",\"created_at\",\"username\"}, set(p))\ncheck(\"review username\", p[\"username\"] == \"alice\", p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 3, \"comment\": \"again\"}, tok)\ncheck(\"one review per user 409\", st == 409, (st, p))\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 4, \"comment\": \"Solid\"}, tok2, 201)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 9}, tok2)\ncheck(\"rating range 400\", st == 400 and \"rating\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": \"x\"}, tok2)\ncheck(\"rating type 400\", st == 400, (st, p))\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 0}, tok3)\ncheck(\"rating 0 400\", st == 400, st)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"reviews newest first\", [r[\"username\"] for r in p[\"items\"]] == [\"bob\", \"alice\"], p)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"avg 2 reviews 4.5\", p[\"review_count\"] == 2 and p[\"average_rating\"] == 4.5, p)\n\n# rounding: 5,4,4 => 13/3 = 4.333... => 4.3\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 5}, tok, 201)\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok2, 201)\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok3, 201)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\", expect=200)\ncheck(\"round 1 decimal 4.3\", p[\"average_rating\"] == 4.3, p)\n# rounding: two reviews 5,4 => 4.5 exact\nst, p = req(\"GET\", f\"/api/books/{b3['id']}\", expect=200)\ncheck(\"avg null no reviews\", p[\"average_rating\"] is None and p[\"review_count\"] == 0, p)\n\n# review missing book\nst, _ = req(\"GET\", \"/api/books/999999/reviews\")\ncheck(\"reviews missing book 404\", st == 404, st)\nst, _ = req(\"POST\", \"/api/books/999999/reviews\", {\"rating\": 3}, tok)\ncheck(\"post review missing book 404\", st == 404, st)\n\n# ---- delete + cascade ----\nst, _ = req(\"DELETE\", f\"/api/books/{b2['id']}\", token=tok)\ncheck(\"delete 204\", st == 204, st)\nst, _ = req(\"GET\", f\"/api/books/{b2['id']}\")\ncheck(\"deleted 404\", st == 404, st)\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"total after delete\", p[\"total\"] == 3, p)\n# reviews of deleted book gone (no orphan access via recreating? reviews only per book id)\nst, _ = req(\"DELETE\", f\"/api/books/{b2['id']}\", token=tok)\ncheck(\"double delete 404\", st == 404, st)\n\n# ---- tokens ----\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"bogus\")\ncheck(\"bogus token 401\", st == 401, st)\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"\")\ncheck(\"empty bearer 401\", st == 401, st)\nst, _ = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=None)\ncheck(\"no auth header 401\", st == 401, st)\n\n# ---- malformed json ----\nr = urllib.request.Request(BASE+\"/api/books\", data=b\"not-json\",\n    headers={\"Content-Type\":\"application/json\",\"Authorization\":f\"Bearer {tok}\"}, method=\"POST\")\ntry:\n    urllib.request.urlopen(r); st = 200\nexcept urllib.error.HTTPError as e:\n    st = e.code\ncheck(\"malformed json 400\", st == 400, st)\n\n# ---- frontend ----\nwith urllib.request.urlopen(BASE + \"/\") as r:\n    html = r.read().decode()\ncheck(\"frontend html\", 'id=\"root\"' in html and \"/assets/\" in html, html[:200])\nwith urllib.request.urlopen(BASE + \"/books/1\") as r:\n    check(\"spa fallback\", r.status == 200 and 'id=\"root\"' in r.read().decode())\ntry:\n    urllib.request.urlopen(BASE + \"/assets/nope.js\")\n    st = 200\nexcept urllib.error.HTTPError as e:\n    st = e.code\ncheck(\"missing asset 404\", st == 404, st)\nwith urllib.request.urlopen(BASE + \"/api/books\") as r:\n    check(\"api list public 200\", r.status == 200)\n\nprint()\nprint(\"FAILURES:\", len(fails))\nfor f in fails: print(\" -\", f)\nraise SystemExit(1 if fails else 0)\nEOF","time":{"start":1794308440926,"end":1794308442003}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c51e0357001Uxa5CfOfD4EDkZ","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","messageID":"msg_1c51ccac6001GAt98izr4GlPAx"}}
