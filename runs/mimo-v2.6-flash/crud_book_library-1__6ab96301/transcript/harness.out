{"type":"tool_use","timestamp":1794307984240,"sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","part":{"type":"tool","tool":"bash","callID":"call_a01dbc4f4a2e462286396f5c","state":{"status":"completed","input":{"command":"python3 - <<'EOF'\nimport json, urllib.request, urllib.error\n\nBASE = \"http://localhost:8000\"\n\ndef req(method, path, body=None, token=None, expect=None):\n    data = json.dumps(body).encode() if body is not None else None\n    headers = {}\n    if data is not None: headers[\"Content-Type\"] = \"application/json\"\n    if token: headers[\"Authorization\"] = f\"Bearer {token}\"\n    r = urllib.request.Request(BASE+path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status, payload = resp.status, resp.read()\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, e.read()\n    parsed = json.loads(payload) if payload else None\n    if expect is not None:\n        assert status == expect, f\"{method} {path} -> {status}, want {expect}: {parsed}\"\n    return status, parsed\n\nfails = []\ndef check(name, cond, detail=\"\"):\n    if not cond: fails.append(f\"{name}: {detail}\")\n    print((\"ok  \" if cond else \"FAIL\") + f\" {name} {detail if not cond else ''}\")\n\n# health\nst, p = req(\"GET\", \"/api/health\", expect=200)\ncheck(\"health\", p == {\"status\": \"ok\"})\n\n# auth\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=201)\ncheck(\"register 201\", st == 201)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\ncheck(\"register dup 409\", st == 409)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", st == 400 and \"username\" in p.get(\"errors\", {}))\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ncheck(\"login bad 401\", st == 401)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=200)\ntok = p[\"token\"]; check(\"login token\", isinstance(tok, str) and len(tok) > 10)\n\n# register second user\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=201)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=200)\ntok2 = p[\"token\"]\n\n# books unauthenticated\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"post book no auth 401\", st == 401)\nst, p = req(\"PUT\", \"/api/books/1\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"put book no auth 401\", st == 401)\nst, p = req(\"DELETE\", \"/api/books/1\")\ncheck(\"delete book no auth 401\", st == 401)\nst, p = req(\"POST\", \"/api/books/1/reviews\", {\"rating\": 5})\ncheck(\"post review no auth 401\", st == 401)\n\n# create books\nb1 = req(\"POST\", \"/api/books\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 201)[1]\nb2 = req(\"POST\", \"/api/books\", {\"title\": \"1984\", \"author\": \"George Orwell\", \"year\": 1949}, tok, 201)[1]\nb3 = req(\"POST\", \"/api/books\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\"}, tok2, 201)[1]\ncheck(\"book fields\", set(b1) == {\"id\",\"title\",\"author\",\"year\",\"isbn\",\"created_at\",\"review_count\",\"average_rating\"}, set(b1))\ncheck(\"null rating\", b1[\"average_rating\"] is None and b1[\"review_count\"] == 0)\n\n# validation\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"\", \"author\": \"\"}, tok)\ncheck(\"book validation 400\", st == 400 and \"title\" in p.get(\"errors\", {}) and \"author\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"T\", \"author\": \"A\", \"year\": \"abc\"}, tok)\ncheck(\"year validation\", st == 400 and \"year\" in p.get(\"errors\", {}), p)\n\n# ordering newest first\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"newest first\", [b[\"title\"] for b in p[\"items\"]] == [\"Neuromancer\", \"1984\", \"Dune\"], p[\"items\"])\ncheck(\"list shape\", set(p) == {\"items\",\"total\",\"page\",\"page_size\"} and p[\"total\"] == 3 and p[\"page\"] == 1 and p[\"page_size\"] == 10)\n\n# pagination\nst, p = req(\"GET\", \"/api/books?page=2&page_size=2\", expect=200)\ncheck(\"page 2\", len(p[\"items\"]) == 1 and p[\"total\"] == 3 and p[\"page\"] == 2 and p[\"page_size\"] == 2, p)\nst, p = req(\"GET\", \"/api/books?page=99&page_size=2\", expect=200)\ncheck(\"empty page\", p[\"items\"] == [] and p[\"total\"] == 3)\nst, p = req(\"GET\", \"/api/books?page=0\")\ncheck(\"page=0 400\", st == 400, st)\n\n# search\nst, p = req(\"GET\", \"/api/books?q=orwell\", expect=200)\ncheck(\"search author\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"1984\")\nst, p = req(\"GET\", \"/api/books?q=dun\", expect=200)\ncheck(\"search partial\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"Dune\")\nst, p = req(\"GET\", \"/api/books?q=9780441\", expect=200)\ncheck(\"search isbn\", p[\"total\"] == 1)\nst, p = req(\"GET\", \"/api/books?q=zzzz\", expect=200)\ncheck(\"search none\", p[\"total\"] == 0 and p[\"items\"] == [])\n\n# get single / 404\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"get book\", p[\"title\"] == \"Dune\")\nst, p = req(\"GET\", \"/api/books/999999\")\ncheck(\"get missing 404\", st == 404)\nst, p = req(\"GET\", \"/api/books/abc\")\ncheck(\"get bad id 404\", st == 404)\nst, p = req(\"GET\", \"/api/nonexistent\")\ncheck(\"api 404 json\", st == 404 and \"error\" in p, (st, p))\n\n# PUT replaces; omitted year/isbn cleared\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\"}, tok, 200)\ncheck(\"put clears year/isbn\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune Messiah\", \"author\": \"Frank Herbert\", \"year\": 1969, \"isbn\": \"9780441172719\"}, tok, 200)\ncheck(\"put sets\", p[\"title\"] == \"Dune Messiah\" and p[\"year\"] == 1969)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"x\"}, tok2, 200)\ncheck(\"any user can edit\", p[\"title\"] == \"Dune Messiah\" or p[\"title\"] == \"x\", p)\n# restore\nreq(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 200)\nst, p = req(\"PUT\", \"/api/books/999999\", {\"title\": \"x\", \"author\": \"y\"}, tok)\ncheck(\"put missing 404\", st == 404)\n\n# reviews\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"empty reviews\", p == {\"items\": []}, p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 5, \"comment\": \"Amazing\"}, tok, 201)\ncheck(\"review shape\", set(p) == {\"id\",\"book_id\",\"rating\",\"comment\",\"created_at\",\"username\"}, set(p))\ncheck(\"review username\", p[\"username\"] == \"alice\")\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 3, \"comment\": \"again\"}, tok)\ncheck(\"one review per user 409\", st == 409, (st, p))\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 4, \"comment\": \"Solid\"}, tok2, 201)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 9}, tok2)\ncheck(\"rating range 400\", st == 400 and \"rating\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": \"x\"}, tok2)\ncheck(\"rating type 400\", st == 400)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"reviews newest first\", [r[\"username\"] for r in p[\"items\"]] == [\"bob\", \"alice\"], p)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"avg rating\", p[\"review_count\"] == 2 and p[\"average_rating\"] == 4.5, p)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\", expect=200)\ncheck(\"avg null no reviews\", p[\"average_rating\"] is None)\n\n# three reviews -> rounding to one decimal: 5,4,4 => 4.333 -> 4.3\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 5}, tok, 201)\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok2, 201)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=201)\ntok3 = req(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=200)[1][\"token\"]\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok3, 201)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\", expect=200)\ncheck(\"round 1 decimal\", p[\"average_rating\"] == 4.3, p)\n\n# review of missing book\nst, p = req(\"GET\", \"/api/books/999999/reviews\")\ncheck(\"reviews missing book 404\", st == 404)\nst, p = req(\"POST\", \"/api/books/999999/reviews\", {\"rating\": 3}, tok)\ncheck(\"post review missing book 404\", st == 404)\n\n# delete book cascades reviews\nst, p = req(\"DELETE\", f\"/api/books/{b2['id']}\", tok, None)\n# fix: token positional wrong — redo\nst, p = req(\"DELETE\", f\"/api/books/{b2['id']}\", token=tok)\ncheck(\"delete 204\", st == 204, st)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\")\ncheck(\"deleted 404\", st == 404)\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"total after delete\", p[\"total\"] == 2, p)\n\n# token validity\nst, p = req(\"GET\", \"/api/books\", token=\"bogus-token\")\ncheck(\"bogus token still public ok\", st == 200)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"bogus\")\ncheck(\"bogus token 401\", st == 401)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"\")\ncheck(\"empty bearer 401\", st == 401)\n\n# frontend\nwith urllib.request.urlopen(BASE + \"/\") as r:\n    html = r.read().decode()\ncheck(\"frontend html\", 'id=\"root\"' in html and \"/assets/\" in html)\n\nprint()\nprint(\"FAILURES:\", len(fails))\nfor f in fails: print(\" -\", f)\nEOF"},"output":"ok   health \nok   register 201 \nok   register dup 409 \nok   register empty username 400 \nok   login bad 401 \nok   login token \nok   post book no auth 401 \nok   put book no auth 401 \nok   delete book no auth 401 \nok   post review no auth 401 \nok   book fields \nok   null rating \nok   book validation 400 \nok   year validation \nok   newest first \nok   list shape \nok   page 2 \nok   empty page \nok   page=0 400 \nok   search author \nok   search partial \nok   search isbn \nok   search none \nok   get book \nok   get missing 404 \nok   get bad id 404 \nok   api 404 json \nok   put clears year/isbn \nok   put sets \nTraceback (most recent call last):\n  File \"<stdin>\", line 108, in <module>\n  File \"<stdin>\", line 18, in req\nAssertionError: PUT /api/books/1 -> 400, want 200: {'error': 'Author is required', 'errors': {'author': 'Author is required'}}\n","metadata":{"output":"ok   health \nok   register 201 \nok   register dup 409 \nok   register empty username 400 \nok   login bad 401 \nok   login token \nok   post book no auth 401 \nok   put book no auth 401 \nok   delete book no auth 401 \nok   post review no auth 401 \nok   book fields \nok   null rating \nok   book validation 400 \nok   year validation \nok   newest first \nok   list shape \nok   page 2 \nok   empty page \nok   page=0 400 \nok   search author \nok   search partial \nok   search isbn \nok   search none \nok   get book \nok   get missing 404 \nok   get bad id 404 \nok   api 404 json \nok   put clears year/isbn \nok   put sets \nTraceback (most recent call last):\n  File \"<stdin>\", line 108, in <module>\n  File \"<stdin>\", line 18, in req\nAssertionError: PUT /api/books/1 -> 400, want 200: {'error': 'Author is required', 'errors': {'author': 'Author is required'}}\n","exit":1,"truncated":false},"title":"python3 - <<'EOF'\nimport json, urllib.request, urllib.error\n\nBASE = \"http://localhost:8000\"\n\ndef req(method, path, body=None, token=None, expect=None):\n    data = json.dumps(body).encode() if body is not None else None\n    headers = {}\n    if data is not None: headers[\"Content-Type\"] = \"application/json\"\n    if token: headers[\"Authorization\"] = f\"Bearer {token}\"\n    r = urllib.request.Request(BASE+path, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(r) as resp:\n            status, payload = resp.status, resp.read()\n    except urllib.error.HTTPError as e:\n        status, payload = e.code, e.read()\n    parsed = json.loads(payload) if payload else None\n    if expect is not None:\n        assert status == expect, f\"{method} {path} -> {status}, want {expect}: {parsed}\"\n    return status, parsed\n\nfails = []\ndef check(name, cond, detail=\"\"):\n    if not cond: fails.append(f\"{name}: {detail}\")\n    print((\"ok  \" if cond else \"FAIL\") + f\" {name} {detail if not cond else ''}\")\n\n# health\nst, p = req(\"GET\", \"/api/health\", expect=200)\ncheck(\"health\", p == {\"status\": \"ok\"})\n\n# auth\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=201)\ncheck(\"register 201\", st == 201)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"x\"}, expect=409)\ncheck(\"register dup 409\", st == 409)\nst, p = req(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"})\ncheck(\"register empty username 400\", st == 400 and \"username\" in p.get(\"errors\", {}))\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\ncheck(\"login bad 401\", st == 401)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"secret1\"}, expect=200)\ntok = p[\"token\"]; check(\"login token\", isinstance(tok, str) and len(tok) > 10)\n\n# register second user\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=201)\nst, p = req(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"secret2\"}, expect=200)\ntok2 = p[\"token\"]\n\n# books unauthenticated\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"post book no auth 401\", st == 401)\nst, p = req(\"PUT\", \"/api/books/1\", {\"title\": \"x\", \"author\": \"y\"})\ncheck(\"put book no auth 401\", st == 401)\nst, p = req(\"DELETE\", \"/api/books/1\")\ncheck(\"delete book no auth 401\", st == 401)\nst, p = req(\"POST\", \"/api/books/1/reviews\", {\"rating\": 5})\ncheck(\"post review no auth 401\", st == 401)\n\n# create books\nb1 = req(\"POST\", \"/api/books\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 201)[1]\nb2 = req(\"POST\", \"/api/books\", {\"title\": \"1984\", \"author\": \"George Orwell\", \"year\": 1949}, tok, 201)[1]\nb3 = req(\"POST\", \"/api/books\", {\"title\": \"Neuromancer\", \"author\": \"William Gibson\"}, tok2, 201)[1]\ncheck(\"book fields\", set(b1) == {\"id\",\"title\",\"author\",\"year\",\"isbn\",\"created_at\",\"review_count\",\"average_rating\"}, set(b1))\ncheck(\"null rating\", b1[\"average_rating\"] is None and b1[\"review_count\"] == 0)\n\n# validation\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"\", \"author\": \"\"}, tok)\ncheck(\"book validation 400\", st == 400 and \"title\" in p.get(\"errors\", {}) and \"author\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"T\", \"author\": \"A\", \"year\": \"abc\"}, tok)\ncheck(\"year validation\", st == 400 and \"year\" in p.get(\"errors\", {}), p)\n\n# ordering newest first\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"newest first\", [b[\"title\"] for b in p[\"items\"]] == [\"Neuromancer\", \"1984\", \"Dune\"], p[\"items\"])\ncheck(\"list shape\", set(p) == {\"items\",\"total\",\"page\",\"page_size\"} and p[\"total\"] == 3 and p[\"page\"] == 1 and p[\"page_size\"] == 10)\n\n# pagination\nst, p = req(\"GET\", \"/api/books?page=2&page_size=2\", expect=200)\ncheck(\"page 2\", len(p[\"items\"]) == 1 and p[\"total\"] == 3 and p[\"page\"] == 2 and p[\"page_size\"] == 2, p)\nst, p = req(\"GET\", \"/api/books?page=99&page_size=2\", expect=200)\ncheck(\"empty page\", p[\"items\"] == [] and p[\"total\"] == 3)\nst, p = req(\"GET\", \"/api/books?page=0\")\ncheck(\"page=0 400\", st == 400, st)\n\n# search\nst, p = req(\"GET\", \"/api/books?q=orwell\", expect=200)\ncheck(\"search author\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"1984\")\nst, p = req(\"GET\", \"/api/books?q=dun\", expect=200)\ncheck(\"search partial\", p[\"total\"] == 1 and p[\"items\"][0][\"title\"] == \"Dune\")\nst, p = req(\"GET\", \"/api/books?q=9780441\", expect=200)\ncheck(\"search isbn\", p[\"total\"] == 1)\nst, p = req(\"GET\", \"/api/books?q=zzzz\", expect=200)\ncheck(\"search none\", p[\"total\"] == 0 and p[\"items\"] == [])\n\n# get single / 404\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"get book\", p[\"title\"] == \"Dune\")\nst, p = req(\"GET\", \"/api/books/999999\")\ncheck(\"get missing 404\", st == 404)\nst, p = req(\"GET\", \"/api/books/abc\")\ncheck(\"get bad id 404\", st == 404)\nst, p = req(\"GET\", \"/api/nonexistent\")\ncheck(\"api 404 json\", st == 404 and \"error\" in p, (st, p))\n\n# PUT replaces; omitted year/isbn cleared\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\"}, tok, 200)\ncheck(\"put clears year/isbn\", p[\"year\"] is None and p[\"isbn\"] is None, p)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune Messiah\", \"author\": \"Frank Herbert\", \"year\": 1969, \"isbn\": \"9780441172719\"}, tok, 200)\ncheck(\"put sets\", p[\"title\"] == \"Dune Messiah\" and p[\"year\"] == 1969)\nst, p = req(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"x\"}, tok2, 200)\ncheck(\"any user can edit\", p[\"title\"] == \"Dune Messiah\" or p[\"title\"] == \"x\", p)\n# restore\nreq(\"PUT\", f\"/api/books/{b1['id']}\", {\"title\": \"Dune\", \"author\": \"Frank Herbert\", \"year\": 1965, \"isbn\": \"9780441172719\"}, tok, 200)\nst, p = req(\"PUT\", \"/api/books/999999\", {\"title\": \"x\", \"author\": \"y\"}, tok)\ncheck(\"put missing 404\", st == 404)\n\n# reviews\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"empty reviews\", p == {\"items\": []}, p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 5, \"comment\": \"Amazing\"}, tok, 201)\ncheck(\"review shape\", set(p) == {\"id\",\"book_id\",\"rating\",\"comment\",\"created_at\",\"username\"}, set(p))\ncheck(\"review username\", p[\"username\"] == \"alice\")\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 3, \"comment\": \"again\"}, tok)\ncheck(\"one review per user 409\", st == 409, (st, p))\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 4, \"comment\": \"Solid\"}, tok2, 201)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": 9}, tok2)\ncheck(\"rating range 400\", st == 400 and \"rating\" in p.get(\"errors\", {}), p)\nst, p = req(\"POST\", f\"/api/books/{b1['id']}/reviews\", {\"rating\": \"x\"}, tok2)\ncheck(\"rating type 400\", st == 400)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}/reviews\", expect=200)\ncheck(\"reviews newest first\", [r[\"username\"] for r in p[\"items\"]] == [\"bob\", \"alice\"], p)\nst, p = req(\"GET\", f\"/api/books/{b1['id']}\", expect=200)\ncheck(\"avg rating\", p[\"review_count\"] == 2 and p[\"average_rating\"] == 4.5, p)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\", expect=200)\ncheck(\"avg null no reviews\", p[\"average_rating\"] is None)\n\n# three reviews -> rounding to one decimal: 5,4,4 => 4.333 -> 4.3\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 5}, tok, 201)\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok2, 201)\nreq(\"POST\", \"/api/auth/register\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=201)\ntok3 = req(\"POST\", \"/api/auth/login\", {\"username\": \"carol\", \"password\": \"pw1234\"}, expect=200)[1][\"token\"]\nreq(\"POST\", f\"/api/books/{b2['id']}/reviews\", {\"rating\": 4}, tok3, 201)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\", expect=200)\ncheck(\"round 1 decimal\", p[\"average_rating\"] == 4.3, p)\n\n# review of missing book\nst, p = req(\"GET\", \"/api/books/999999/reviews\")\ncheck(\"reviews missing book 404\", st == 404)\nst, p = req(\"POST\", \"/api/books/999999/reviews\", {\"rating\": 3}, tok)\ncheck(\"post review missing book 404\", st == 404)\n\n# delete book cascades reviews\nst, p = req(\"DELETE\", f\"/api/books/{b2['id']}\", tok, None)\n# fix: token positional wrong — redo\nst, p = req(\"DELETE\", f\"/api/books/{b2['id']}\", token=tok)\ncheck(\"delete 204\", st == 204, st)\nst, p = req(\"GET\", f\"/api/books/{b2['id']}\")\ncheck(\"deleted 404\", st == 404)\nst, p = req(\"GET\", \"/api/books\", expect=200)\ncheck(\"total after delete\", p[\"total\"] == 2, p)\n\n# token validity\nst, p = req(\"GET\", \"/api/books\", token=\"bogus-token\")\ncheck(\"bogus token still public ok\", st == 200)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"bogus\")\ncheck(\"bogus token 401\", st == 401)\nst, p = req(\"POST\", \"/api/books\", {\"title\": \"t\", \"author\": \"a\"}, token=\"\")\ncheck(\"empty bearer 401\", st == 401)\n\n# frontend\nwith urllib.request.urlopen(BASE + \"/\") as r:\n    html = r.read().decode()\ncheck(\"frontend html\", 'id=\"root\"' in html and \"/assets/\" in html)\n\nprint()\nprint(\"FAILURES:\", len(fails))\nfor f in fails: print(\" -\", f)\nEOF","time":{"start":1794307983618,"end":1794307984221}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c51708fd001cxD2D5BI3dH0FV","sessionID":"ses_e3b0b810dffegBA4eZqYEno8s9","messageID":"msg_1c515f929001qMfMvgwlpdB2kv"}}
