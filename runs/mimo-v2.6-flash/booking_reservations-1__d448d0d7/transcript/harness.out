59:       setEmail(editing.email);\n60:       setDate(editing.date);\n61:       setTime(editing.time);\n62:       setPartySize(String(editing.party_size));\n63:       setNotes(editing.notes ?? \"\");\n64:       setMessage(null);\n65:     } else {\n66:       setName(\"\");\n67:       setEmail(\"\");\n68:       setPartySize(\"2\");\n69:       setNotes(\"\");\n70:     }\n71:   }, [editing]);\n72: \n73:   async function submit(event: FormEvent) {\n74:     event.preventDefault();\n75:     const size = Number(partySize);\n76:     if (!name.trim() || !email.trim() || !date || !time) {\n77:       setMessage({ kind: \"error\", text: \"Fill in every required field.\" });\n78:       return;\n79:     }\n80:     if (!Number.isInteger(size) || size < 1) {\n81:       setMessage({ kind: \"error\", text: \"Party size must be a positive whole number.\" });\n82:       return;\n83:     }\n84:     const body: ReservationDraft = {\n85:       name: name.trim(),\n86:       email: email.trim(),\n87:       date,\n88:       time,\n89:       party_size: size,\n90:       notes: notes.trim() ? notes.trim() : null,\n91:     };\n92:     setBusy(true);\n93:     setMessage(null);\n94:     try {\n95:       if (editing) {\n96:         await api(`/api/reservations/${editing.id}`, { method: \"PUT\", body });\n97:         setMessage({ kind: \"success\", text: \"Reservation updated.\" });\n98:         onCancelEdit();\n99:       } else {\n100:         await api(\"/api/reservations\", { method: \"POST\", body });\n101:         setMessage({ kind: \"success\", text: `Table booked for ${date} at ${time}.` });\n102:         setName(\"\");\n103:         setEmail(\"\");\n104:         setNotes(\"\");\n105:       }\n106:       onSaved();\n107:     } catch (cause) {\n108:       if (cause instanceof ApiError && cause.status === 401) {\n109:         onUnauthorized?.();\n110:         return;\n111:       }\n112:       setMessage({\n113:         kind: \"error\",\n114:         text: cause instanceof ApiError ? cause.message : \"Something went wrong\",\n115:       });\n116:     } finally {\n117:       setBusy(false);\n118:     }\n119:   }\n120: \n121:   const slot = date === day ? slots.find((item) => item.time === time) : undefined;\n122: \n123:   return (\n124:     <section className={card} aria-label=\"Booking form\">\n125:       <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3\">\n126:         <div>\n127:           <h2 className={heading}>{editing ? \"Edit reservation\" : \"Book a table\"}</h2>\n128:           {editing && (\n129:             <p className={smallMuted}>\n130:               Reservation #{editing.id} · {formatDay(editing.date)} at {editing.time}\n131:             </p>\n132:           )}\n133:         </div>\n134:         {editing && (\n135:           <button className={secondaryButton} type=\"button\" onClick={onCancelEdit}>\n136:             Cancel edit\n137:           </button>\n138:         )}\n139:       </div>\n140: \n141:       {message && (\n142:         <p\n143:           className={`${message.kind === \"success\" ? successPanel : errorPanel} mb-4`}\n144:           role=\"alert\"\n145:         >\n146:           {message.text}\n147:         </p>\n148:       )}\n149: \n150:       <form className=\"space-y-4\" onSubmit={submit}>\n151:         <div className=\"grid gap-4 sm:grid-cols-2\">\n152:           <div>\n153:             <label className={label} htmlFor=\"booking-name\">\n154:               Name\n155:             </label>\n156:             <input\n157:               className={input}\n158:               id=\"booking-name\"\n159:               value={name}\n160:               onChange={(event) => setName(event.target.value)}\n161:               required\n162:             />\n163:           </div>\n164:           <div>\n165:             <label className={label} htmlFor=\"booking-email\">\n166:               Email\n167:             </label>\n168:             <input\n169:               className={input}\n170:               id=\"booking-email\"\n171:               type=\"email\"\n172:               value={email}\n173:               onChange={(event) => setEmail(event.target.value)}\n174:               required\n175:             />\n176:           </div>\n177:           <div>\n178:             <label className={label} htmlFor=\"booking-date\">\n179:               Date\n180:             </label>\n181:             <input\n182:               className={input}\n183:               id=\"booking-date\"\n184:               type=\"date\"\n185:               value={date}\n186:               onChange={(event) => setDate(event.target.value)}\n187:               required\n188:             />\n189:           </div>\n190:           <div>\n191:             <label className={label} htmlFor=\"booking-time\">\n192:               Time\n193:             </label>\n194:             <input\n195:               className={input}\n196:               id=\"booking-time\"\n197:               type=\"time\"\n198:               value={time}\n199:               onChange={(event) => setTime(event.target.value)}\n200:               required\n201:             />\n202:           </div>\n203:           <div>\n204:             <label className={label} htmlFor=\"booking-party\">\n205:               Party size\n206:             </label>\n207:             <input\n208:               className={input}\n209:               id=\"booking-party\"\n210:               type=\"number\"\n211:               min={1}\n212:               value={partySize}\n213:               onChange={(event) => setPartySize(event.target.value)}\n214:               required\n215:             />\n216:             {slot && (\n217:               <p\n218:                 className={`${smallMuted} mt-1 ${\n219:                   slot.remaining === 0 ? \"font-medium text-red-600\" : \"\"\n220:                 }`}\n221:               >\n222:                 {slot.remaining === 0\n223:                   ? \"This time slot is full\"\n224:                   : `${slot.remaining} of 20 seats remaining at ${time}`}\n225:               </p>\n226:             )}\n227:           </div>\n228:           <div>\n229:             <label className={label} htmlFor=\"booking-notes\">\n230:               Notes\n231:             </label>\n232:             <input\n233:               className={input}\n234:               id=\"booking-notes\"\n235:               placeholder=\"Allergies, occasion, seating…\"\n236:               value={notes}\n237:               onChange={(event) => setNotes(event.target.value)}\n238:             />\n239:           </div>\n240:         </div>\n241:         <div className=\"flex items-center gap-3\">\n242:           <button className={primaryButton} type=\"submit\" disabled={busy}>\n243:             {busy\n244:               ? \"Saving…\"\n245:               : editing\n246:                 ? \"Save changes\"\n247:                 : \"Book table\"}\n248:           </button>\n249:           <span className={smallMuted}>Each time slot seats at most 20 guests.</span>\n250:         </div>\n251:       </form>\n252:     </section>\n253:   );\n254: }\n\n(End of file - total 254 lines)\n</content>","metadata":{"preview":"import { useEffect, useState, type FormEvent } from \"react\";\nimport { api, ApiError } from \"../api\";\nimport type { Reservation, ReservationDraft, Slot } from \"../types\";\nimport {\n  card,\n  errorPanel,\n  formatDay,\n  heading,\n  input,\n  label,\n  primaryButton,\n  secondaryButton,\n  smallMuted,\n  successPanel,\n} from \"../ui\";\n\ninterface Props {\n  editing: Reservation | null;\n  seed: { date: string; time: string; nonce: number };\n  slots: Slot[];","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components/BookingForm.tsx","text":"import { useEffect, useState, type FormEvent } from \"react\";\nimport { api, ApiError } from \"../api\";\nimport type { Reservation, ReservationDraft, Slot } from \"../types\";\nimport {\n  card,\n  errorPanel,\n  formatDay,\n  heading,\n  input,\n  label,\n  primaryButton,\n  secondaryButton,\n  smallMuted,\n  successPanel,\n} from \"../ui\";\n\ninterface Props {\n  editing: Reservation | null;\n  seed: { date: string; time: string; nonce: number };\n  slots: Slot[];\n  day: string;\n  onSaved: () => void;\n  onCancelEdit: () => void;\n  onUnauthorized?: () => void;\n}\n\ninterface Message {\n  kind: \"success\" | \"error\";\n  text: string;\n}\n\nexport default function BookingForm({\n  editing,\n  seed,\n  slots,\n  day,\n  onSaved,\n  onCancelEdit,\n  onUnauthorized,\n}: Props) {\n  const [name, setName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [date, setDate] = useState(seed.date);\n  const [time, setTime] = useState(seed.time);\n  const [partySize, setPartySize] = useState(\"2\");\n  const [notes, setNotes] = useState(\"\");\n  const [message, setMessage] = useState<Message | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    setDate(seed.date);\n    setTime(seed.time);\n    setMessage(null);\n  }, [seed.nonce, seed.date, seed.time]);\n\n  useEffect(() => {\n    if (editing) {\n      setName(editing.name);\n      setEmail(editing.email);\n      setDate(editing.date);\n      setTime(editing.time);\n      setPartySize(String(editing.party_size));\n      setNotes(editing.notes ?? \"\");\n      setMessage(null);\n    } else {\n      setName(\"\");\n      setEmail(\"\");\n      setPartySize(\"2\");\n      setNotes(\"\");\n    }\n  }, [editing]);\n\n  async function submit(event: FormEvent) {\n    event.preventDefault();\n    const size = Number(partySize);\n    if (!name.trim() || !email.trim() || !date || !time) {\n      setMessage({ kind: \"error\", text: \"Fill in every required field.\" });\n      return;\n    }\n    if (!Number.isInteger(size) || size < 1) {\n      setMessage({ kind: \"error\", text: \"Party size must be a positive whole number.\" });\n      return;\n    }\n    const body: ReservationDraft = {\n      name: name.trim(),\n      email: email.trim(),\n      date,\n      time,\n      party_size: size,\n      notes: notes.trim() ? notes.trim() : null,\n    };\n    setBusy(true);\n    setMessage(null);\n    try {\n      if (editing) {\n        await api(`/api/reservations/${editing.id}`, { method: \"PUT\", body });\n        setMessage({ kind: \"success\", text: \"Reservation updated.\" });\n        onCancelEdit();\n      } else {\n        await api(\"/api/reservations\", { method: \"POST\", body });\n        setMessage({ kind: \"success\", text: `Table booked for ${date} at ${time}.` });\n        setName(\"\");\n        setEmail(\"\");\n        setNotes(\"\");\n      }\n      onSaved();\n    } catch (cause) {\n      if (cause instanceof ApiError && cause.status === 401) {\n        onUnauthorized?.();\n        return;\n      }\n      setMessage({\n        kind: \"error\",\n        text: cause instanceof ApiError ? cause.message : \"Something went wrong\",\n      });\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const slot = date === day ? slots.find((item) => item.time === time) : undefined;\n\n  return (\n    <section className={card} aria-label=\"Booking form\">\n      <div className=\"mb-5 flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <h2 className={heading}>{editing ? \"Edit reservation\" : \"Book a table\"}</h2>\n          {editing && (\n            <p className={smallMuted}>\n              Reservation #{editing.id} · {formatDay(editing.date)} at {editing.time}\n            </p>\n          )}\n        </div>\n        {editing && (\n          <button className={secondaryButton} type=\"button\" onClick={onCancelEdit}>\n            Cancel edit\n          </button>\n        )}\n      </div>\n\n      {message && (\n        <p\n          className={`${message.kind === \"success\" ? successPanel : errorPanel} mb-4`}\n          role=\"alert\"\n        >\n          {message.text}\n        </p>\n      )}\n\n      <form className=\"space-y-4\" onSubmit={submit}>\n        <div className=\"grid gap-4 sm:grid-cols-2\">\n          <div>\n            <label className={label} htmlFor=\"booking-name\">\n              Name\n            </label>\n            <input\n              className={input}\n              id=\"booking-name\"\n              value={name}\n              onChange={(event) => setName(event.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={label} htmlFor=\"booking-email\">\n              Email\n            </label>\n            <input\n              className={input}\n              id=\"booking-email\"\n              type=\"email\"\n              value={email}\n              onChange={(event) => setEmail(event.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={label} htmlFor=\"booking-date\">\n              Date\n            </label>\n            <input\n              className={input}\n              id=\"booking-date\"\n              type=\"date\"\n              value={date}\n              onChange={(event) => setDate(event.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={label} htmlFor=\"booking-time\">\n              Time\n            </label>\n            <input\n              className={input}\n              id=\"booking-time\"\n              type=\"time\"\n              value={time}\n              onChange={(event) => setTime(event.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={label} htmlFor=\"booking-party\">\n              Party size\n            </label>\n            <input\n              className={input}\n              id=\"booking-party\"\n              type=\"number\"\n              min={1}\n              value={partySize}\n              onChange={(event) => setPartySize(event.target.value)}\n              required\n            />\n            {slot && (\n              <p\n                className={`${smallMuted} mt-1 ${\n                  slot.remaining === 0 ? \"font-medium text-red-600\" : \"\"\n                }`}\n              >\n                {slot.remaining === 0\n                  ? \"This time slot is full\"\n                  : `${slot.remaining} of 20 seats remaining at ${time}`}\n              </p>\n            )}\n          </div>\n          <div>\n            <label className={label} htmlFor=\"booking-notes\">\n              Notes\n            </label>\n            <input\n              className={input}\n              id=\"booking-notes\"\n              placeholder=\"Allergies, occasion, seating…\"\n              value={notes}\n              onChange={(event) => setNotes(event.target.value)}\n            />\n          </div>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <button className={primaryButton} type=\"submit\" disabled={busy}>\n            {busy\n              ? \"Saving…\"\n              : editing\n                ? \"Save changes\"\n                : \"Book table\"}\n          </button>\n          <span className={smallMuted}>Each time slot seats at most 20 guests.</span>\n        </div>\n      </form>\n    </section>\n  );\n}","lineStart":1,"lineEnd":254,"totalLines":254,"truncated":false}},"title":"frontend/src/components/BookingForm.tsx","time":{"start":1794324348070,"end":1794324348088}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c610bca2001fLe1LzWInTtJne","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c61068e0001KsN4QbyDiP64YL"}}
