:           <input\n97:             className={input}\n98:             id=\"auth-username\"\n99:             autoComplete=\"username\"\n100:             value={username}\n101:             onChange={(event) => setUsername(event.target.value)}\n102:             required\n103:           />\n104:         </div>\n105:         <div>\n106:           <label className={label} htmlFor=\"auth-password\">\n107:             Password\n108:           </label>\n109:           <input\n110:             className={input}\n111:             id=\"auth-password\"\n112:             type=\"password\"\n113:             autoComplete={mode === \"register\" ? \"new-password\" : \"current-password\"}\n114:             value={password}\n115:             onChange={(event) => setPassword(event.target.value)}\n116:             required\n117:           />\n118:         </div>\n119:         <button className={`${primaryButton} w-full`} type=\"submit\" disabled={busy}>\n120:           {busy ? \"Please wait…\" : mode === \"register\" ? \"Create account\" : \"Sign in\"}\n121:         </button>\n122:       </form>\n123:     </section>\n124:   );\n125: }\n\n(End of file - total 125 lines)\n</content>","metadata":{"preview":"import { useState, type FormEvent } from \"react\";\nimport { api, ApiError, storeSession } from \"../api\";\nimport { card, errorPanel, heading, input, label, primaryButton, successPanel } from \"../ui\";\n\ninterface Props {\n  onSignedIn: (username: string) => void;\n}\n\ntype Mode = \"signin\" | \"register\";\n\nexport default function AuthPanel({ onSignedIn }: Props) {\n  const [mode, setMode] = useState<Mode>(\"signin\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(event: FormEvent) {\n    event.preventDefault();","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components/AuthPanel.tsx","text":"import { useState, type FormEvent } from \"react\";\nimport { api, ApiError, storeSession } from \"../api\";\nimport { card, errorPanel, heading, input, label, primaryButton, successPanel } from \"../ui\";\n\ninterface Props {\n  onSignedIn: (username: string) => void;\n}\n\ntype Mode = \"signin\" | \"register\";\n\nexport default function AuthPanel({ onSignedIn }: Props) {\n  const [mode, setMode] = useState<Mode>(\"signin\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(event: FormEvent) {\n    event.preventDefault();\n    setBusy(true);\n    setError(null);\n    setNotice(null);\n    try {\n      if (mode === \"register\") {\n        await api(\"/api/auth/register\", {\n          method: \"POST\",\n          body: { username, password },\n        });\n        setMode(\"signin\");\n        setNotice(\"Account created. Sign in to continue.\");\n      } else {\n        const result = await api<{ token: string }>(\"/api/auth/login\", {\n          method: \"POST\",\n          body: { username, password },\n        });\n        storeSession(username.trim(), result.token);\n        setUsername(\"\");\n        setPassword(\"\");\n        onSignedIn(username.trim());\n      }\n    } catch (cause) {\n      setError(cause instanceof ApiError ? cause.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const tabClass = (active: boolean) =>\n    active\n      ? \"rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-900 shadow-sm\"\n      : \"rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:text-slate-900\";\n\n  return (\n    <section className={`${card} mx-auto w-full max-w-md`} aria-label=\"Account\">\n      <div className=\"mb-4 flex items-center justify-between gap-4\">\n        <h2 className={heading}>Account</h2>\n        <div className=\"flex rounded-lg bg-slate-100 p-1\" role=\"tablist\">\n          <button\n            className={tabClass(mode === \"signin\")}\n            role=\"tab\"\n            aria-selected={mode === \"signin\"}\n            type=\"button\"\n            onClick={() => {\n              setMode(\"signin\");\n              setError(null);\n              setNotice(null);\n            }}\n          >\n            Sign in\n          </button>\n          <button\n            className={tabClass(mode === \"register\")}\n            role=\"tab\"\n            aria-selected={mode === \"register\"}\n            type=\"button\"\n            onClick={() => {\n              setMode(\"register\");\n              setError(null);\n              setNotice(null);\n            }}\n          >\n            Register\n          </button>\n        </div>\n      </div>\n\n      {notice && <p className={`${successPanel} mb-4`}>{notice}</p>}\n      {error && <p className={`${errorPanel} mb-4`}>{error}</p>}\n\n      <form className=\"space-y-4\" onSubmit={submit}>\n        <div>\n          <label className={label} htmlFor=\"auth-username\">\n            Username\n          </label>\n          <input\n            className={input}\n            id=\"auth-username\"\n            autoComplete=\"username\"\n            value={username}\n            onChange={(event) => setUsername(event.target.value)}\n            required\n          />\n        </div>\n        <div>\n          <label className={label} htmlFor=\"auth-password\">\n            Password\n          </label>\n          <input\n            className={input}\n            id=\"auth-password\"\n            type=\"password\"\n            autoComplete={mode === \"register\" ? \"new-password\" : \"current-password\"}\n            value={password}\n            onChange={(event) => setPassword(event.target.value)}\n            required\n          />\n        </div>\n        <button className={`${primaryButton} w-full`} type=\"submit\" disabled={busy}>\n          {busy ? \"Please wait…\" : mode === \"register\" ? \"Create account\" : \"Sign in\"}\n        </button>\n      </form>\n    </section>\n  );\n}","lineStart":1,"lineEnd":125,"totalLines":125,"truncated":false}},"title":"frontend/src/components/AuthPanel.tsx","time":{"start":1794324380098,"end":1794324380119}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61139be001Po93sitFBV7hMm","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c610bcc90013LbcsMNnE0m0AZ"}}
