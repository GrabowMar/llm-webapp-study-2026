n.date) ?? [];\n55:     list.push(reservation);\n56:     groups.set(reservation.date, list);\n57:   }\n58:   for (const list of groups.values()) {\n59:     list.sort((a, b) => a.time.localeCompare(b.time) || a.id - b.id);\n60:   }\n61:   const dates = [...groups.keys()].sort();\n62: \n63:   return (\n64:     <section className={card} aria-label=\"Your reservations\">\n65:       <div className=\"mb-5 flex items-center justify-between gap-3\">\n66:         <div>\n67:           <h2 className={heading}>Your reservations</h2>\n68:           <p className={smallMuted}>{reservations.length} upcoming booking(s)</p>\n69:         </div>\n70:         <button className={secondaryButton} type=\"button\" onClick={onRefresh}>\n71:           Refresh\n72:         </button>\n73:       </div>\n74: \n75:       {error && <p className=\"mb-4 text-sm text-red-700\">{error}</p>}\n76:       {actionError && <p className=\"mb-4 text-sm text-red-700\">{actionError}</p>}\n77: \n78:       {loading ? (\n79:         <p className={smallMuted}>Loading reservations…</p>\n80:       ) : dates.length === 0 ? (\n81:         <div className=\"rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center\">\n82:           <p className=\"text-sm font-medium text-slate-700\">You have no reservations yet</p>\n83:           <p className={`${smallMuted} mt-1`}>Pick a slot or use the booking form to reserve.</p>\n84:         </div>\n85:       ) : (\n86:         <div className=\"space-y-6\">\n87:           {dates.map((date) => (\n88:             <div key={date}>\n89:               <h3 className=\"mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500\">\n90:                 {formatDay(date)}\n91:               </h3>\n92:               <ul className=\"space-y-3\">\n93:                 {groups.get(date)!.map((reservation) => (\n94:                   <li\n95:                     className=\"rounded-xl border border-slate-200 bg-slate-50 px-4 py-3\"\n96:                     key={reservation.id}\n97:                   >\n98:                     <div className=\"flex flex-wrap items-start justify-between gap-3\">\n99:                       <div className=\"space-y-1\">\n100:                         <p className=\"flex flex-wrap items-center gap-2\">\n101:                           <span className=\"text-base font-semibold text-slate-900\">\n102:                             {reservation.time}\n103:                           </span>\n104:                           <span className=\"rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-800\">\n105:                             {reservation.party_size}{\" \"}\n106:                             {reservation.party_size === 1 ? \"guest\" : \"guests\"}\n107:                           </span>\n108:                         </p>\n109:                         <p className=\"text-sm text-slate-700\">\n110:                           {reservation.name}\n111:                           <span className=\"text-slate-400\"> · </span>\n112:                           {reservation.email}\n113:                         </p>\n114:                         {reservation.notes && (\n115:                           <p className=\"text-sm italic text-slate-500\">{reservation.notes}</p>\n116:                         )}\n117:                         <p className={smallMuted}>\n118:                           Reservation #{reservation.id} · booked{\" \"}\n119:                           {new Date(reservation.created_at).toLocaleString()}\n120:                         </p>\n121:                       </div>\n122:                       <div className=\"flex shrink-0 gap-2\">\n123:                         <button\n124:                           className={secondaryButton}\n125:                           type=\"button\"\n126:                           onClick={() => onEdit(reservation)}\n127:                         >\n128:                           Edit\n129:                         </button>\n130:                         <button\n131:                           className={dangerButton}\n132:                           type=\"button\"\n133:                           onClick={() => void cancel(reservation)}\n134:                         >\n135:                           Cancel\n136:                         </button>\n137:                       </div>\n138:                     </div>\n139:                   </li>\n140:                 ))}\n141:               </ul>\n142:             </div>\n143:           ))}\n144:         </div>\n145:       )}\n146:     </section>\n147:   );\n148: }\n\n(End of file - total 148 lines)\n</content>","metadata":{"preview":"import { useState } from \"react\";\nimport { api, ApiError } from \"../api\";\nimport type { Reservation } from \"../types\";\nimport {\n  card,\n  dangerButton,\n  formatDay,\n  heading,\n  secondaryButton,\n  smallMuted,\n} from \"../ui\";\n\ninterface Props {\n  reservations: Reservation[];\n  loading: boolean;\n  error: string | null;\n  onEdit: (reservation: Reservation) => void;\n  onRefresh: () => void;\n  onUnauthorized: () => void;\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components/MyReservations.tsx","text":"import { useState } from \"react\";\nimport { api, ApiError } from \"../api\";\nimport type { Reservation } from \"../types\";\nimport {\n  card,\n  dangerButton,\n  formatDay,\n  heading,\n  secondaryButton,\n  smallMuted,\n} from \"../ui\";\n\ninterface Props {\n  reservations: Reservation[];\n  loading: boolean;\n  error: string | null;\n  onEdit: (reservation: Reservation) => void;\n  onRefresh: () => void;\n  onUnauthorized: () => void;\n}\n\nexport default function MyReservations({\n  reservations,\n  loading,\n  error,\n  onEdit,\n  onRefresh,\n  onUnauthorized,\n}: Props) {\n  const [actionError, setActionError] = useState<string | null>(null);\n\n  async function cancel(reservation: Reservation) {\n    const confirmed = window.confirm(\n      `Cancel your reservation on ${reservation.date} at ${reservation.time}?`,\n    );\n    if (!confirmed) {\n      return;\n    }\n    setActionError(null);\n    try {\n      await api(`/api/reservations/${reservation.id}`, { method: \"DELETE\" });\n      onRefresh();\n    } catch (cause) {\n      if (cause instanceof ApiError && cause.status === 401) {\n        onUnauthorized();\n        return;\n      }\n      setActionError(cause instanceof ApiError ? cause.message : \"Something went wrong\");\n    }\n  }\n\n  const groups = new Map<string, Reservation[]>();\n  for (const reservation of reservations) {\n    const list = groups.get(reservation.date) ?? [];\n    list.push(reservation);\n    groups.set(reservation.date, list);\n  }\n  for (const list of groups.values()) {\n    list.sort((a, b) => a.time.localeCompare(b.time) || a.id - b.id);\n  }\n  const dates = [...groups.keys()].sort();\n\n  return (\n    <section className={card} aria-label=\"Your reservations\">\n      <div className=\"mb-5 flex items-center justify-between gap-3\">\n        <div>\n          <h2 className={heading}>Your reservations</h2>\n          <p className={smallMuted}>{reservations.length} upcoming booking(s)</p>\n        </div>\n        <button className={secondaryButton} type=\"button\" onClick={onRefresh}>\n          Refresh\n        </button>\n      </div>\n\n      {error && <p className=\"mb-4 text-sm text-red-700\">{error}</p>}\n      {actionError && <p className=\"mb-4 text-sm text-red-700\">{actionError}</p>}\n\n      {loading ? (\n        <p className={smallMuted}>Loading reservations…</p>\n      ) : dates.length === 0 ? (\n        <div className=\"rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center\">\n          <p className=\"text-sm font-medium text-slate-700\">You have no reservations yet</p>\n          <p className={`${smallMuted} mt-1`}>Pick a slot or use the booking form to reserve.</p>\n        </div>\n      ) : (\n        <div className=\"space-y-6\">\n          {dates.map((date) => (\n            <div key={date}>\n              <h3 className=\"mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500\">\n                {formatDay(date)}\n              </h3>\n              <ul className=\"space-y-3\">\n                {groups.get(date)!.map((reservation) => (\n                  <li\n                    className=\"rounded-xl border border-slate-200 bg-slate-50 px-4 py-3\"\n                    key={reservation.id}\n                  >\n                    <div className=\"flex flex-wrap items-start justify-between gap-3\">\n                      <div className=\"space-y-1\">\n                        <p className=\"flex flex-wrap items-center gap-2\">\n                          <span className=\"text-base font-semibold text-slate-900\">\n                            {reservation.time}\n                          </span>\n                          <span className=\"rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-800\">\n                            {reservation.party_size}{\" \"}\n                            {reservation.party_size === 1 ? \"guest\" : \"guests\"}\n                          </span>\n                        </p>\n                        <p className=\"text-sm text-slate-700\">\n                          {reservation.name}\n                          <span className=\"text-slate-400\"> · </span>\n                          {reservation.email}\n                        </p>\n                        {reservation.notes && (\n                          <p className=\"text-sm italic text-slate-500\">{reservation.notes}</p>\n                        )}\n                        <p className={smallMuted}>\n                          Reservation #{reservation.id} · booked{\" \"}\n                          {new Date(reservation.created_at).toLocaleString()}\n                        </p>\n                      </div>\n                      <div className=\"flex shrink-0 gap-2\">\n                        <button\n                          className={secondaryButton}\n                          type=\"button\"\n                          onClick={() => onEdit(reservation)}\n                        >\n                          Edit\n                        </button>\n                        <button\n                          className={dangerButton}\n                          type=\"button\"\n                          onClick={() => void cancel(reservation)}\n                        >\n                          Cancel\n                        </button>\n                      </div>\n                    </div>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n      )}\n    </section>\n  );\n}","lineStart":1,"lineEnd":148,"totalLines":148,"truncated":false}},"title":"frontend/src/components/MyReservations.tsx","time":{"start":1794324380108,"end":1794324380123}},"id":"prt_1c61139c40017f387u3aJZWYdj","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c610bcc90013LbcsMNnE0m0AZ"}}
