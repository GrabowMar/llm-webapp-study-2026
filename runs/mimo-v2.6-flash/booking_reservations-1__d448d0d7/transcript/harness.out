review":"import type { Slot } from \"../types\";\nimport { card, formatDay, heading, secondaryButton, smallMuted } from \"../ui\";\nimport DayPicker from \"./DayPicker\";\n\ninterface Props {\n  date: string;\n  slots: Slot[];\n  loading: boolean;\n  error: string | null;\n  onDateChange: (date: string) => void;\n  onBook: (slot: Slot) => void;\n}\n\nexport default function AvailabilityPanel({\n  date,\n  slots,\n  loading,\n  error,\n  onDateChange,\n  onBook,","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/components/AvailabilityPanel.tsx","text":"import type { Slot } from \"../types\";\nimport { card, formatDay, heading, secondaryButton, smallMuted } from \"../ui\";\nimport DayPicker from \"./DayPicker\";\n\ninterface Props {\n  date: string;\n  slots: Slot[];\n  loading: boolean;\n  error: string | null;\n  onDateChange: (date: string) => void;\n  onBook: (slot: Slot) => void;\n}\n\nexport default function AvailabilityPanel({\n  date,\n  slots,\n  loading,\n  error,\n  onDateChange,\n  onBook,\n}: Props) {\n  return (\n    <section className={card} aria-label=\"Availability\">\n      <div className=\"mb-5 flex flex-wrap items-end justify-between gap-4\">\n        <div>\n          <h2 className={heading}>Availability</h2>\n          <p className={smallMuted}>Every slot seats at most 20 guests.</p>\n        </div>\n        <DayPicker date={date} onDateChange={onDateChange} />\n      </div>\n\n      <p className=\"mb-4 text-sm text-slate-600\">{formatDay(date)}</p>\n\n      {error && <p className=\"mb-4 text-sm text-red-700\">{error}</p>}\n\n      {loading ? (\n        <p className={smallMuted}>Loading slots…</p>\n      ) : slots.length === 0 ? (\n        <div className=\"rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center\">\n          <p className=\"text-sm font-medium text-slate-700\">No reservations on this day yet</p>\n          <p className={`${smallMuted} mt-1`}>All 20 seats per time slot are still available.</p>\n        </div>\n      ) : (\n        <ul className=\"space-y-3\">\n          {slots.map((slot) => {\n            const percent = Math.round((slot.booked / 20) * 100);\n            const full = slot.remaining === 0;\n            return (\n              <li\n                className=\"rounded-xl border border-slate-200 bg-slate-50 px-4 py-3\"\n                key={slot.time}\n              >\n                <div className=\"flex flex-wrap items-center justify-between gap-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"text-base font-semibold text-slate-900\">{slot.time}</span>\n                    <span\n                      className={`rounded-full px-2 py-0.5 text-xs font-medium ${\n                        full\n                          ? \"bg-red-100 text-red-700\"\n                          : \"bg-emerald-100 text-emerald-800\"\n                      }`}\n                    >\n                      {slot.booked} of 20 booked · {slot.remaining} remaining\n                    </span>\n                  </div>\n                  <button\n                    className={secondaryButton}\n                    type=\"button\"\n                    onClick={() => onBook(slot)}\n                  >\n                    Book this slot\n                  </button>\n                </div>\n                <div className=\"mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-200\">\n                  <div\n                    className={`h-2 rounded-full ${full ? \"bg-red-500\" : \"bg-emerald-500\"}`}\n                    style={{ width: `${percent}%` }}\n                  />\n                </div>\n              </li>\n            );\n          })}\n        </ul>\n      )}\n    </section>\n  );\n}","lineStart":1,"lineEnd":87,"totalLines":87,"truncated":false}},"title":"frontend/src/components/AvailabilityPanel.tsx","time":{"start":1794324348077,"end":1794324348092}},"id":"prt_1c610bca90