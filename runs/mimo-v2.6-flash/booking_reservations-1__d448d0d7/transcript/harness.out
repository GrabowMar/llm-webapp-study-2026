{"type":"tool_use","timestamp":1794324588017,"sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","part":{"type":"tool","tool":"write","callID":"call_201e71f8bf4e4c57b5bab1ce","state":{"status":"completed","input":{"content":"import { renderToString } from \"react-dom/server\";\nimport App from \"./src/App\";\n\nfunction render(label: string, storage: Record<string, string>): string {\n  const store = new Map(Object.entries(storage));\n  (globalThis as Record<string, unknown>).localStorage = {\n    getItem: (key: string) => store.get(key) ?? null,\n    setItem: (key: string, value: string) => void store.set(key, value),\n    removeItem: (key: string) => void store.delete(key),\n  };\n  const html = renderToString(<App />);\n  if (html.length < 500) {\n    throw new Error(`${label}: suspiciously short render (${html.length} chars)`);\n  }\n  console.log(`${label}: ok (${html.length} chars)`);\n  return html;\n}\n\nfunction expect(haystack: string, needle: string, label: string): void {\n  if (!haystack.includes(needle)) {\n    throw new Error(`${label}: missing \"${needle}\"`);\n  }\n}\n\nconst anon = render(\"anonymous\", {});\nexpect(anon, \"Sign in\", \"anonymous\");\nexpect(anon, \"Availability\", \"anonymous\");\nexpect(anon, \"Sign in to book this slot\", \"anonymous\");\nif (anon.includes(\"Book this slot\")) {\n  throw new Error(\"anonymous: must not offer booking\");\n}\nif (anon.includes(\"Book a table\")) {\n  throw new Error(\"anonymous: must not see booking tab\");\n}\n\nconst user = render(\"user\", {\n  \"reservations.token\": \"tok\",\n  \"reservations.username\": \"bob\",\n});\nexpect(user, \"Signed in\", \"user\");\nexpect(user, \"Book a table\", \"user\");\nexpect(user, \"My reservations\", \"user\");\nexpect(user, \"Book this slot\", \"user\");\nif (user.includes(\">Admin<\")) {\n  throw new Error(\"user: must not see Admin tab\");\n}\n\nconst admin = render(\"admin\", {\n  \"reservations.token\": \"tok\",\n  \"reservations.username\": \"admin\",\n});\nexpect(admin, \"Signed in\", \"admin\");\nexpect(admin, \">Admin<\", \"admin\");\n\nconsole.log(\"SMOKE OK\");\n","filePath":"/workspace/frontend/smoke-entry.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/smoke-entry.tsx","exists":false,"truncated":false},"title":"frontend/smoke-entry.tsx","time":{"start":1794324587979,"end":1794324587991}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61465c5001XSAyNpdH8q9hiU","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c6142ecd0013pmyDRMDTOjPGS"}}
