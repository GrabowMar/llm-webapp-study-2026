g(false);\n89:     }\n90:   }, [session, signOut]);\n91: \n92:   useEffect(() => {\n93:     void refreshAvailability();\n94:   }, [refreshAvailability]);\n95: \n96:   useEffect(() => {\n97:     void refreshReservations();\n98:   }, [refreshReservations]);\n99: \n100:   function handleSaved() {\n101:     void refreshAvailability();\n102:     void refreshReservations();\n103:   }\n104: \n105:   function handleBook(slot: Slot) {\n106:     setSeed((previous) => ({ date, time: slot.time, nonce: previous.nonce + 1 }));\n107:     setEditing(null);\n108:     setTab(\"book\");\n109:   }\n110: \n111:   function handleEdit(reservation: Reservation) {\n112:     setEditing(reservation);\n113:     setTab(\"book\");\n114:   }\n115: \n116:   function handleSignedIn(username: string) {\n117:     setSession({ username });\n118:     setTab(\"availability\");\n119:   }\n120: \n121:   const isAdmin = session?.username === \"admin\";\n122:   const activeTab: Tab = session ? tab : \"availability\";\n123:   const tabs: { id: Tab; label: string }[] = [{ id: \"availability\", label: \"Availability\" }];\n124:   if (session) {\n125:     tabs.push({ id: \"book\", label: \"Book a table\" });\n126:     tabs.push({ id: \"reservations\", label: \"My reservations\" });\n127:   }\n128:   if (isAdmin) {\n129:     tabs.push({ id: \"admin\", label: \"Admin\" });\n130:   }\n131: \n132:   return (\n133:     <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n134:       <header className=\"border-b border-slate-200 bg-white\">\n135:         <div className=\"mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n136:           <div className=\"flex items-baseline gap-3\">\n137:             <h1 className=\"text-lg font-semibold tracking-tight\">Table reservations</h1>\n138:             <span className=\"hidden text-xs text-slate-400 sm:inline\">\n139:               20 seats per time slot\n140:             </span>\n141:           </div>\n142:           {session ? (\n143:             <div className=\"flex items-center gap-3\">\n144:               <span className=\"text-sm text-slate-600\">\n145:                 Signed in as{\" \"}\n146:                 <span className=\"font-semibold text-slate-900\">{session.username}</span>\n147:               </span>\n148:               <button className={secondaryButton} type=\"button\" onClick={signOut}>\n149:                 Sign out\n150:               </button>\n151:             </div>\n152:           ) : (\n153:             <span className={smallMuted}>Sign in to book a table</span>\n154:           )}\n155:         </div>\n156:       </header>\n157: \n158:       <main className=\"mx-auto max-w-5xl px-4 py-8\">\n159:         {!session && <AuthPanel onSignedIn={handleSignedIn} />}\n160: \n161:         <div className=\"space-y-6\">\n162:           {session && (\n163:             <nav className=\"flex flex-wrap gap-2\" aria-label=\"Sections\">\n164:               {tabs.map((item) => (\n165:                 <button\n166:                   aria-current={item.id === activeTab ? \"page\" : undefined}\n167:                   className={item.id === activeTab ? activeTabClass : inactiveTabClass}\n168:                   key={item.id}\n169:                   type=\"button\"\n170:                   onClick={() => setTab(item.id)}\n171:                 >\n172:                   {item.label}\n173:                 </button>\n174:               ))}\n175:             </nav>\n176:           )}\n177: \n178:           {activeTab === \"availability\" && (\n179:             <AvailabilityPanel\n180:               date={date}\n181:               slots={slots}\n182:               loading={availabilityLoading}\n183:               error={availabilityError}\n184:               onDateChange={setDate}\n185:               onBook={handleBook}\n186:             />\n187:           )}\n188: \n189:           {session && activeTab === \"book\" && (\n190:             <BookingForm\n191:               editing={editing}\n192:               seed={seed}\n193:               slots={slots}\n194:               day={date}\n195:               onSaved={handleSaved}\n196:               onCancelEdit={() => setEditing(null)}\n197:               onUnauthorized={signOut}\n198:             />\n199:           )}\n200: \n201:           {session && activeTab === \"reservations\" && (\n202:             <MyReservations\n203:               reservations={reservations}\n204:               loading={reservationsLoading}\n205:               error={reservationsError}\n206:               onEdit={handleEdit}\n207:               onRefresh={() => void refreshReservations()}\n208:               onUnauthorized={signOut}\n209:             />\n210:           )}\n211: \n212:           {session && isAdmin && activeTab === \"admin\" && (\n213:             <AdminPanel date={date} onDateChange={setDate} onUnauthorized={signOut} />\n214:           )}\n215:         </div>\n216:       </main>\n217: \n218:       <footer className=\"mx-auto max-w-5xl px-4 pb-8\">\n219:         <p className={smallMuted}>\n220:           Anyone can browse a day's availability. Sign in to book, change or cancel your\n221:           reservations.\n222:         </p>\n223:       </footer>\n224:     </div>\n225:   );\n226: }\n\n(End of file - total 226 lines)\n</content>","metadata":{"preview":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, clearSession, getStoredUsername, getToken } from \"./api\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport AvailabilityPanel from \"./components/AvailabilityPanel\";\nimport BookingForm from \"./components/BookingForm\";\nimport MyReservations from \"./components/MyReservations\";\nimport type { AvailabilityList, Reservation, ReservationList, Slot } from \"./types\";\nimport { secondaryButton, smallMuted, todayISO } from \"./ui\";\n\ntype Tab = \"availability\" | \"book\" | \"reservations\" | \"admin\";\n\ninterface Session {\n  username: string;\n}\n\nfunction initialSession(): Session | null {\n  const token = getToken();\n  const username = getStoredUsername();\n  return token && username ? { username } : null;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, clearSession, getStoredUsername, getToken } from \"./api\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport AuthPanel from \"./components/AuthPanel\";\nimport AvailabilityPanel from \"./components/AvailabilityPanel\";\nimport BookingForm from \"./components/BookingForm\";\nimport MyReservations from \"./components/MyReservations\";\nimport type { AvailabilityList, Reservation, ReservationList, Slot } from \"./types\";\nimport { secondaryButton, smallMuted, todayISO } from \"./ui\";\n\ntype Tab = \"availability\" | \"book\" | \"reservations\" | \"admin\";\n\ninterface Session {\n  username: string;\n}\n\nfunction initialSession(): Session | null {\n  const token = getToken();\n  const username = getStoredUsername();\n  return token && username ? { username } : null;\n}\n\nconst activeTabClass =\n  \"rounded-lg bg-white px-4 py-2 text-sm font-medium text-indigo-700 shadow-sm ring-1 ring-slate-200\";\nconst inactiveTabClass =\n  \"rounded-lg px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-white hover:text-slate-900 hover:shadow-sm\";\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(initialSession);\n  const [tab, setTab] = useState<Tab>(\"availability\");\n  const [date, setDate] = useState(todayISO);\n  const [seed, setSeed] = useState(() => ({ date, time: \"\", nonce: 0 }));\n  const [editing, setEditing] = useState<Reservation | null>(null);\n\n  const [slots, setSlots] = useState<Slot[]>([]);\n  const [availabilityLoading, setAvailabilityLoading] = useState(true);\n  const [availabilityError, setAvailabilityError] = useState<string | null>(null);\n\n  const [reservations, setReservations] = useState<Reservation[]>([]);\n  const [reservationsLoading, setReservationsLoading] = useState(false);\n  const [reservationsError, setReservationsError] = useState<string | null>(null);\n\n  const signOut = useCallback(() => {\n    clearSession();\n    setSession(null);\n    setReservations([]);\n    setReservationsError(null);\n    setEditing(null);\n    setTab(\"availability\");\n  }, []);\n\n  const refreshAvailability = useCallback(async () => {\n    setAvailabilityLoading(true);\n    try {\n      const result = await api<AvailabilityList>(\n        `/api/availability?date=${encodeURIComponent(date)}`,\n      );\n      setSlots(result.items);\n      setAvailabilityError(null);\n    } catch (cause) {\n      setAvailabilityError(\n        cause instanceof ApiError ? cause.message : \"Could not load availability\",\n      );\n    } finally {\n      setAvailabilityLoading(false);\n    }\n  }, [date]);\n\n  const refreshReservations = useCallback(async () => {\n    if (!session) {\n      setReservations([]);\n      return;\n    }\n    setReservationsLoading(true);\n    try {\n      const result = await api<ReservationList>(\"/api/reservations\");\n      setReservations(result.items);\n      setReservationsError(null);\n    } catch (cause) {\n      if (cause instanceof ApiError && cause.status === 401) {\n        signOut();\n        return;\n      }\n      setReservationsError(\n        cause instanceof ApiError ? cause.message : \"Could not load reservations\",\n      );\n    } finally {\n      setReservationsLoading(false);\n    }\n  }, [session, signOut]);\n\n  useEffect(() => {\n    void refreshAvailability();\n  }, [refreshAvailability]);\n\n  useEffect(() => {\n    void refreshReservations();\n  }, [refreshReservations]);\n\n  function handleSaved() {\n    void refreshAvailability();\n    void refreshReservations();\n  }\n\n  function handleBook(slot: Slot) {\n    setSeed((previous) => ({ date, time: slot.time, nonce: previous.nonce + 1 }));\n    setEditing(null);\n    setTab(\"book\");\n  }\n\n  function handleEdit(reservation: Reservation) {\n    setEditing(reservation);\n    setTab(\"book\");\n  }\n\n  function handleSignedIn(username: string) {\n    setSession({ username });\n    setTab(\"availability\");\n  }\n\n  const isAdmin = session?.username === \"admin\";\n  const activeTab: Tab = session ? tab : \"availability\";\n  const tabs: { id: Tab; label: string }[] = [{ id: \"availability\", label: \"Availability\" }];\n  if (session) {\n    tabs.push({ id: \"book\", label: \"Book a table\" });\n    tabs.push({ id: \"reservations\", label: \"My reservations\" });\n  }\n  if (isAdmin) {\n    tabs.push({ id: \"admin\", label: \"Admin\" });\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n          <div className=\"flex items-baseline gap-3\">\n            <h1 className=\"text-lg font-semibold tracking-tight\">Table reservations</h1>\n            <span className=\"hidden text-xs text-slate-400 sm:inline\">\n              20 seats per time slot\n            </span>\n          </div>\n          {session ? (\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-sm text-slate-600\">\n                Signed in as{\" \"}\n                <span className=\"font-semibold text-slate-900\">{session.username}</span>\n              </span>\n              <button className={secondaryButton} type=\"button\" onClick={signOut}>\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <span className={smallMuted}>Sign in to book a table</span>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-5xl px-4 py-8\">\n        {!session && <AuthPanel onSignedIn={handleSignedIn} />}\n\n        <div className=\"space-y-6\">\n          {session && (\n            <nav className=\"flex flex-wrap gap-2\" aria-label=\"Sections\">\n              {tabs.map((item) => (\n                <button\n                  aria-current={item.id === activeTab ? \"page\" : undefined}\n                  className={item.id === activeTab ? activeTabClass : inactiveTabClass}\n                  key={item.id}\n                  type=\"button\"\n                  onClick={() => setTab(item.id)}\n                >\n                  {item.label}\n                </button>\n              ))}\n            </nav>\n          )}\n\n          {activeTab === \"availability\" && (\n            <AvailabilityPanel\n              date={date}\n              slots={slots}\n              loading={availabilityLoading}\n              error={availabilityError}\n              onDateChange={setDate}\n              onBook={handleBook}\n            />\n          )}\n\n          {session && activeTab === \"book\" && (\n            <BookingForm\n              editing={editing}\n              seed={seed}\n              slots={slots}\n              day={date}\n              onSaved={handleSaved}\n              onCancelEdit={() => setEditing(null)}\n              onUnauthorized={signOut}\n            />\n          )}\n\n          {session && activeTab === \"reservations\" && (\n            <MyReservations\n              reservations={reservations}\n              loading={reservationsLoading}\n              error={reservationsError}\n              onEdit={handleEdit}\n              onRefresh={() => void refreshReservations()}\n              onUnauthorized={signOut}\n            />\n          )}\n\n          {session && isAdmin && activeTab === \"admin\" && (\n            <AdminPanel date={date} onDateChange={setDate} onUnauthorized={signOut} />\n          )}\n        </div>\n      </main>\n\n      <footer className=\"mx-auto max-w-5xl px-4 pb-8\">\n        <p className={smallMuted}>\n          Anyone can browse a day's availability. Sign in to book, change or cancel your\n          reservations.\n        </p>\n      </footer>\n    </div>\n  );\n}","lineStart":1,"lineEnd":226,"totalLines":226,"truncated":false}},"title":"frontend/src/App.tsx","time":{"start":1794324326588,"end":1794324326606}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61068b80019xcd1kbfXhZug7","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c610412f00165TJjbTqAS8Vns"}}
{"type":"tool_use","timestamp":1794324326630,"sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","part":{"type":"tool","tool":"read","callID":"call_3919eae7c616422aac0c784b","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts"},"output":"<path>/workspace/frontend/src/api.ts</path>\n<type>file</type>\n<content>\n1: const TOKEN_KEY = \"reservations.token\";\n2: const USERNAME_KEY = \"reservations.username\";\n3: \n4: export class ApiError extends Error {\n5:   status: number;\n6: \n7:   constructor(message: string, status: number) {\n8:     super(message);\n9:     this.name = \"ApiError\";\n10:     this.status = status;\n11:   }\n12: }\n13: \n14: export function getToken(): string | null {\n15:   return localStorage.getItem(TOKEN_KEY);\n16: }\n17: \n18: export function getStoredUsername(): string | null {\n19:   return localStorage.getItem(USERNAME_KEY);\n20: }\n21: \n22: export function storeSession(username: string, token: string): void {\n23:   localStorage.setItem(TOKEN_KEY, token);\n24:   localStorage.setItem(USERNAME_KEY, username);\n25: }\n26: \n27: export function clearSession(): void {\n28:   localStorage.removeItem(TOKEN_KEY);\n29:   localStorage.removeItem(USERNAME_KEY);\n30: }\n31: \n32: interface RequestOptions {\n33:   method?: string;\n34:   body?: unknown;\n35: }\n36: \n37: export async function api<T>(path: string, options: RequestOptions = {}): Promise<T> {\n38:   const headers: Record<string, string> = {};\n39:   const token = getToken();\n40:   if (token) {\n41:     headers[\"Authorization\"] = `Bearer ${token}`;\n42:   }\n43:   if (options.body !== undefined) {\n44:     headers[\"Content-Type\"] = \"application/json\";\n45:   }\n46:   const response = await fetch(path, {\n47:     method: options.method ?? \"GET\",\n48:     headers,\n49:     body: options.body === undefined ? undefined : JSON.stringify(options.body),\n50:   });\n51:   const text = await response.text();\n52:   let payload: unknown = null;\n53:   if (text) {\n54:     try {\n55:       payload = JSON.parse(text);\n56:     } catch {\n57:       payload = null;\n58:     }\n59:   }\n60:   if (!response.ok) {\n61:     const message =\n62:       payload !== null && typeof payload === \"object\" && \"error\" in payload\n63:         ? String((payload as { error: unknown }).error)\n64:         : `Request failed (${response.status})`;\n65:     throw new ApiError(message, response.status);\n66:   }\n67:   return payload as T;\n68: }\n\n(End of file - total 68 lines)\n</content>","metadata":{"preview":"const TOKEN_KEY = \"reservations.token\";\nconst USERNAME_KEY = \"reservations.username\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/api.ts","text":"const TOKEN_KEY = \"reservations.token\";\nconst USERNAME_KEY = \"reservations.username\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUsername(): string | null {\n  return localStorage.getItem(USERNAME_KEY);\n}\n\nexport function storeSession(username: string, token: string): void {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USERNAME_KEY, username);\n}\n\nexport function clearSession(): void {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USERNAME_KEY);\n}\n\ninterface RequestOptions {\n  method?: string;\n  body?: unknown;\n}\n\nexport async function api<T>(path: string, options: RequestOptions = {}): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = getToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n  if (options.body !== undefined) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const response = await fetch(path, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body === undefined ? undefined : JSON.stringify(options.body),\n  });\n  const text = await response.text();\n  let payload: unknown = null;\n  if (text) {\n    try {\n      payload = JSON.parse(text);\n    } catch {\n      payload = null;\n    }\n  }\n  if (!response.ok) {\n    const message =\n      payload !== null && typeof payload === \"object\" && \"error\" in payload\n        ? String((payload as { error: unknown }).error)\n        : `Request failed (${response.status})`;\n    throw new ApiError(message, response.status);\n  }\n  return payload as T;\n}","lineStart":1,"lineEnd":68,"totalLines":68,"truncated":false}},"title":"frontend/src/api.ts","time":{"start":1794324326595,"end":1794324326609}},"id":"prt_1c61068bf001nMtaJsqF7OdRUi","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c610412f00165TJjbTqAS8Vns"}}
