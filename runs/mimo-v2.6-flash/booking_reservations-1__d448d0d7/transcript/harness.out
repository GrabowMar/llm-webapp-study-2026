{"type":"tool_use","timestamp":1794323496334,"sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","part":{"type":"tool","tool":"write","callID":"call_c5d6887199134f5abc424c39","state":{"status":"completed","input":{"content":"\"\"\"End-to-end contract checks for the reservation API (development only).\"\"\"\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nBASE = os.environ.get(\"BASE\", \"http://127.0.0.1:8000\")\nfailures = []\n\n\ndef call(method, path, body=None, token=None, expect=200, raw=False):\n    req = urllib.request.Request(BASE + path, method=method)\n    data = None\n    if body is not None:\n        data = json.dumps(body).encode()\n        req.add_header(\"Content-Type\", \"application/json\")\n    if token:\n        req.add_header(\"Authorization\", \"Bearer \" + token)\n    try:\n        with urllib.request.urlopen(req, data=data, timeout=10) as resp:\n            status, payload = resp.status, resp.read().decode()\n    except urllib.error.HTTPError as exc:\n        status, payload = exc.code, exc.read().decode()\n    if status != expect:\n        failures.append(f\"{method} {path}: expected {expect}, got {status}: {payload[:300]}\")\n    if raw:\n        return status, payload\n    try:\n        return status, json.loads(payload) if payload else None\n    except json.JSONDecodeError:\n        failures.append(f\"{method} {path}: non-JSON response: {payload[:200]}\")\n        return status, None\n\n\ndef check(cond, msg):\n    if not cond:\n        failures.append(msg)\n\n\ndef reservation_keys(obj):\n    return set(obj) == {\n        \"id\", \"name\", \"email\", \"date\", \"time\", \"party_size\", \"notes\", \"created_at\",\n    }\n\n\ndef main():\n    # --- health -----------------------------------------------------------\n    _, health = call(\"GET\", \"/api/health\")\n    check(health == {\"status\": \"ok\"}, f\"health: {health}\")\n\n    # --- auth -------------------------------------------------------------\n    call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw12345\"}, expect=201)\n    call(\"POST\", \"/api/auth/register\", {\"username\": \"alice\", \"password\": \"pw12345\"}, expect=409)\n    call(\"POST\", \"/api/auth/register\", {\"username\": \"admin\", \"password\": \"pw12345\"}, expect=409)\n    call(\"POST\", \"/api/auth/register\", {\"username\": \"bob\", \"password\": \"pw12345\"}, expect=201)\n    call(\"POST\", \"/api/auth/register\", {\"username\": \"\", \"password\": \"x\"}, expect=400)\n    call(\"POST\", \"/api/auth/register\", {\"username\": \"carol\"}, expect=400)\n\n    st, bad = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"wrong\"}, expect=401)\n    call(\"POST\", \"/api/auth/login\", {\"username\": \"ghost\", \"password\": \"x\"}, expect=401)\n\n    st, alice_login = call(\"POST\", \"/api/auth/login\", {\"username\": \"alice\", \"password\": \"pw12345\"})\n    alice = alice_login.get(\"token\") if isinstance(alice_login, dict) else None\n    check(isinstance(alice, str) and len(alice) > 20, f\"alice token: {alice_login}\")\n    _, bob_login = call(\"POST\", \"/api/auth/login\", {\"username\": \"bob\", \"password\": \"pw12345\"})\n    bob = bob_login.get(\"token\")\n\n    # admin without ADMIN_PASSWORD -> sign-in disabled\n    call(\"POST\", \"/api/auth/login\", {\"username\": \"admin\", \"password\": \"anything\"}, expect=401)\n\n    # unauthenticated\n    call(\"GET\", \"/api/reservations\", expect=401)\n    call(\"POST\", \"/api/reservations\", {\"name\": \"x\", \"email\": \"x@y.z\", \"date\": \"2026-12-01\",\n                                       \"time\": \"18:00\", \"party_size\": 1}, expect=401)\n    call(\"GET\", \"/api/reservations/1\", expect=401)\n    call(\"PUT\", \"/api/reservations/1\", {\"name\": \"x\"}, expect=401)\n    call(\"DELETE\", \"/api/reservations/1\", expect=401)\n    call(\"GET\", \"/api/admin/reservations\", expect=401)\n    call(\"GET\", \"/api/reservations\", token=\"not-a-real-token\", expect=401)\n\n    # --- booking ----------------------------------------------------------\n    body = {\n        \"name\": \"Alice Smith\", \"email\": \"alice@example.com\", \"date\": \"2026-12-01\",\n        \"time\": \"18:00\", \"party_size\": 8, \"notes\": \"window seat\",\n    }\n    st, res1 = call(\"POST\", \"/api/reservations\", body, token=alice, expect=201)\n    check(isinstance(res1, dict) and reservation_keys(res1), f\"create shape: {res1}\")\n    check(res1.get(\"notes\") == \"window seat\", f\"notes: {res1}\")\n    check(res1.get(\"created_at\"), f\"created_at missing: {res1}\")\n    rid1 = res1.get(\"id\")\n\n    # validation failures\n    bad_body = dict(body)\n    del bad_body[\"name\"]\n    call(\"POST\", \"/api/reservations\", bad_body, token=alice, expect=400)\n    bad_body = dict(body, date=\"01/12/2026\")\n    call(\"POST\", \"/api/reservations\", bad_body, token=alice, expect=400)\n    bad_body = dict(body, party_size=0)\n    call(\"POST\", \"/api/reservations\", bad_body, token=alice, expect=400)\n    bad_body = dict(body, party_size=-3)\n    call(\"POST\", \"/api/reservations\", bad_body, token=alice, expect=400)\n    call(\"POST\", \"/api/reservations\", body, token=alice, expect=400)  # not json-object? it is; placeholder\n\n    # --- availability -----------------------------------------------------\n    _, avail = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    check(avail == {\"items\": [{\"time\": \"18:00\", \"booked\": 8, \"remaining\": 12}]},\n          f\"availability: {avail}\")\n\n    # --- capacity ---------------------------------------------------------\n    over = dict(body, party_size=13)\n    st, msg = call(\"POST\", \"/api/reservations\", over, token=bob, expect=409)\n    check(\"full\" in str(msg.get(\"error\", \"\")).lower(), f\"full-slot message: {msg}\")\n    _, avail = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    check(avail[\"items\"][0][\"booked\"] == 8, f\"refused booking changed slot: {avail}\")\n\n    exact = dict(body, party_size=12)\n    st, res2 = call(\"POST\", \"/api/reservations\", exact, token=bob, expect=201)\n    _, avail = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    check(avail == {\"items\": [{\"time\": \"18:00\", \"booked\": 20, \"remaining\": 0}]},\n          f\"slot filled: {avail}\")\n\n    st, msg = call(\"POST\", \"/api/reservations\", dict(body, party_size=1), token=alice, expect=409)\n    check(\"full\" in str(msg.get(\"error\", \"\")).lower(), f\"full message: {msg}\")\n\n    # empty day\n    _, avail = call(\"GET\", \"/api/availability?date=2027-01-01\")\n    check(avail == {\"items\": []}, f\"empty availability: {avail}\")\n\n    # --- listing ----------------------------------------------------------\n    st, listing = call(\"GET\", \"/api/reservations\", token=alice)\n    check(listing.get(\"total\") == 1 and len(listing[\"items\"]) == 1, f\"list: {listing}\")\n    check(listing[\"items\"][0][\"id\"] == rid1, f\"list item: {listing}\")\n\n    # more reservations for ordering / grouping\n    later = dict(body, date=\"2026-11-30\", time=\"09:30\", party_size=2, notes=None)\n    call(\"POST\", \"/api/reservations\", later, token=alice, expect=201)\n    same_day_early = dict(body, date=\"2026-12-01\", time=\"12:15\", party_size=3)\n    call(\"POST\", \"/api/reservations\", same_day_early, token=alice, expect=201)\n\n    _, listing = call(\"GET\", \"/api/reservations\", token=alice)\n    dates_times = [(r[\"date\"], r[\"time\"]) for r in listing[\"items\"]]\n    check(dates_times == sorted(dates_times), f\"not earliest first: {dates_times}\")\n    check(listing[\"total\"] == 3, f\"total: {listing['total']}\")\n\n    _, filtered = call(\"GET\", \"/api/reservations?date=2026-12-01\", token=alice)\n    check(filtered[\"total\"] == 2 and all(r[\"date\"] == \"2026-12-01\" for r in filtered[\"items\"]),\n          f\"date filter: {filtered}\")\n\n    # --- ownership --------------------------------------------------------\n    other_id = res2[\"id\"]\n    call(\"GET\", f\"/api/reservations/{other_id}\", token=alice, expect=404)\n    call(\"PUT\", f\"/api/reservations/{other_id}\", dict(body, party_size=1), token=alice, expect=404)\n    call(\"DELETE\", f\"/api/reservations/{other_id}\", token=alice, expect=404)\n    call(\"GET\", \"/api/reservations/999999\", token=alice, expect=404)\n    call(\"DELETE\", \"/api/reservations/999999\", token=alice, expect=404)\n    call(\"PUT\", \"/api/reservations/999999\", dict(body, party_size=1), token=alice, expect=404)\n    _, mine = call(\"GET\", f\"/api/reservations/{rid1}\", token=alice)\n    check(mine[\"id\"] == rid1, f\"get own: {mine}\")\n\n    # --- update -----------------------------------------------------------\n    # own guests are not counted twice: slot 18:00 is full (alice 8 + bob 12),\n    # but alice replacing her own 8 with 10 works because her own 8 are excluded.\n    upd = {\n        \"name\": \"Alice S.\", \"email\": \"alice2@example.com\", \"date\": \"2026-12-01\",\n        \"time\": \"18:00\", \"party_size\": 10,\n    }\n    st, updated = call(\"PUT\", f\"/api/reservations/{rid1}\", upd, token=alice)\n    check(updated.get(\"party_size\") == 10 and updated.get(\"name\") == \"Alice S.\",\n          f\"update: {updated}\")\n    check(updated.get(\"notes\") is None, f\"omitted notes not cleared: {updated}\")\n    check(updated[\"id\"] == rid1 and updated[\"created_at\"] == res1[\"created_at\"],\n          f\"update changed identity: {updated}\")\n\n    _, avail = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    check(avail[\"items\"][0][\"booked\"] == 22 - 8 + 10 or avail[\"items\"][0][\"booked\"] == 22,\n          f\"unexpected booked: {avail}\")\n    check(avail[\"items\"][0][\"booked\"] == 22 or avail[\"items\"][0][\"booked\"] == 20 + 2,\n          f\"unexpected booked: {avail}\")\n\n    # exceeding after update is refused and changes nothing\n    st, msg = call(\"PUT\", f\"/api/reservations/{rid1}\", dict(upd, party_size=11), token=alice,\n                   expect=409)\n    check(\"full\" in str(msg.get(\"error\", \"\")).lower(), f\"update full message: {msg}\")\n    _, after = call(\"GET\", f\"/api/reservations/{rid1}\", token=alice)\n    check(after[\"party_size\"] == 10, f\"refused update changed data: {after}\")\n\n    # move to another slot\n    st, moved = call(\"PUT\", f\"/api/reservations/{rid1}\", dict(upd, date=\"2026-12-02\", time=\"20:00\"),\n                     token=alice)\n    check(moved[\"date\"] == \"2026-12-02\" and moved[\"time\"] == \"20:00\", f\"move: {moved}\")\n    _, avail_old = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    _, avail_new = call(\"GET\", \"/api/availability?date=2026-12-02\")\n    check(avail_old[\"items\"][0][\"booked\"] == 12, f\"old slot after move: {avail_old}\")\n    check(avail_new[\"items\"][0][\"booked\"] == 10, f\"new slot after move: {avail_new}\")\n\n    # move it back and clear notes explicitly with null\n    st, moved = call(\"PUT\", f\"/api/reservations/{rid1}\", dict(upd, date=\"2026-12-01\", time=\"18:00\",\n                                                              notes=\"\"),\n                     token=alice)\n    check(moved[\"notes\"] is None, f\"empty notes: {moved}\")\n\n    # --- cancel -----------------------------------------------------------\n    _, listing = call(\"GET\", \"/api/reservations\", token=alice)\n    cancelled = [r for r in listing[\"items\"] if r[\"date\"] == \"2026-11-30\"][0]\n    call(\"DELETE\", f\"/api/reservations/{cancelled['id']}\", token=alice)\n    _, listing = call(\"GET\", \"/api/reservations\", token=alice)\n    check(listing[\"total\"] == 2, f\"after delete total: {listing}\")\n    call(\"GET\", f\"/api/reservations/{cancelled['id']}\", token=alice, expect=404)\n\n    # seats freed: bob can now book a fresh slot after his is deleted\n    _, bob_listing = call(\"GET\", \"/api/reservations\", token=bob)\n    for r in bob_listing[\"items\"]:\n        call(\"DELETE\", f\"/api/reservations/{r['id']}\", token=bob)\n    _, avail = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    check(avail[\"items\"][0][\"booked\"] == 10, f\"seats not freed: {avail}\")\n    st, _ = call(\"POST\", \"/api/reservations\", dict(body, party_size=10), token=bob, expect=201)\n    _, avail = call(\"GET\", \"/api/availability?date=2026-12-01\")\n    check(avail[\"items\"][0][\"remaining\"] == 0, f\"refill: {avail}\")\n\n    # --- admin (non-admin path first) -------------------------------------\n    call(\"GET\", \"/api/admin/reservations\", token=alice, expect=403)\n    call(\"GET\", \"/api/admin/reservations?date=2026-12-01\", token=alice, expect=403)\n\n    # unknown api route -> JSON 404, not the SPA\n    st, payload = call(\"GET\", \"/api/nope\", expect=404, raw=True)\n    check(payload.lstrip().startswith(\"{\"), f\"unknown api route served: {payload[:80]}\")\n\n    print(json.dumps({\"failures\": failures}, indent=2))\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","filePath":"/workspace/api_test.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/api_test.py","exists":false,"truncated":false},"title":"api_test.py","time":{"start":1794323496305,"end":1794323496316}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c603bd6c0011fsyRK3uToGOtR","sessionID":"ses_e3a033ea2ffeKJvy4pS94Xaqs0","messageID":"msg_1c602eb2e001kMosdjIQlsxIxQ"}}
