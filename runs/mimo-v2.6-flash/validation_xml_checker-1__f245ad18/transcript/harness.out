{"type":"tool_use","timestamp":1794388178976,"sessionID":"ses_e363e5f23ffeRVmgW4g0UYKH3s","part":{"type":"tool","tool":"read","callID":"call_082dc0df4ca84c7f968b9f47","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","limit":140},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: XML well-formedness checker API plus frontend serving.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: import secrets\n7: import sqlite3\n8: from datetime import datetime, timezone\n9: from pathlib import Path\n10: from typing import Any\n11: from xml.parsers import expat\n12: \n13: from flask import Flask, g, jsonify, request, send_from_directory\n14: from werkzeug.security import check_password_hash, generate_password_hash\n15: \n16: DIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\n17: DATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\n18: DB_PATH = DATA_DIR / \"app.db\"\n19: \n20: PREVIEW_LENGTH = 200\n21: DEFAULT_PAGE_SIZE = 10\n22: \n23: app = Flask(__name__, static_folder=None)\n24: \n25: SCHEMA = \"\"\"\n26: CREATE TABLE IF NOT EXISTS users (\n27:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n28:     username TEXT NOT NULL UNIQUE,\n29:     password_hash TEXT NOT NULL,\n30:     created_at TEXT NOT NULL\n31: );\n32: CREATE TABLE IF NOT EXISTS tokens (\n33:     token TEXT PRIMARY KEY,\n34:     user_id INTEGER NOT NULL,\n35:     created_at TEXT NOT NULL,\n36:     FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n37: );\n38: CREATE TABLE IF NOT EXISTS validations (\n39:     id INTEGER PRIMARY KEY AUTOINCREMENT,\n40:     user_id INTEGER NOT NULL,\n41:     xml_preview TEXT NOT NULL,\n42:     valid INTEGER NOT NULL,\n43:     error TEXT,\n44:     line INTEGER,\n45:     column INTEGER,\n46:     root_element TEXT,\n47:     created_at TEXT NOT NULL,\n48:     FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n49: );\n50: CREATE INDEX IF NOT EXISTS idx_validations_user_created\n51:     ON validations (user_id, created_at DESC, id DESC);\n52: CREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens (user_id);\n53: \"\"\"\n54: \n55: \n56: # ----------------------------------------------------------------- database\n57: \n58: \n59: def _connect() -> sqlite3.Connection:\n60:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n61:     conn = sqlite3.connect(DB_PATH, timeout=30)\n62:     conn.row_factory = sqlite3.Row\n63:     conn.execute(\"PRAGMA foreign_keys = ON\")\n64:     return conn\n65: \n66: \n67: def db() -> sqlite3.Connection:\n68:     if \"db\" not in g:\n69:         g.db = _connect()\n70:     return g.db\n71: \n72: \n73: @app.teardown_appcontext\n74: def _close_db(_exception: BaseException | None) -> None:\n75:     conn = g.pop(\"db\", None)\n76:     if conn is not None:\n77:         conn.close()\n78: \n79: \n80: def init_db() -> None:\n81:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n82:     conn = _connect()\n83:     try:\n84:         conn.execute(\"PRAGMA journal_mode=WAL\")\n85:         conn.executescript(SCHEMA)\n86:         conn.commit()\n87:     finally:\n88:         conn.close()\n89: \n90: \n91: def _now() -> str:\n92:     return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n93: \n94: \n95: # ------------------------------------------------------------ xml checking\n96: \n97: \n98: def check_xml(text: str) -> dict[str, Any]:\n99:     \"\"\"Decide well-formedness of ``text`` without resolving anything external.\"\"\"\n100:     parser = expat.ParserCreate()\n101:     root: list[str] = []\n102: \n103:     def start_element(name: str, _attrs: dict[str, str]) -> None:\n104:         if not root:\n105:             root.append(name)\n106: \n107:     parser.StartElementHandler = start_element\n108:     # Never hand anything to the parser from outside the submitted text.\n109:     parser.ExternalEntityRefHandler = lambda *_args: 0\n110:     try:\n111:         parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)\n112:     except (AttributeError, expat.ExpatError):  # pragma: no cover - exotic builds\n113:         pass\n114: \n115:     try:\n116:         parser.Parse(text, True)\n117:     except expat.ExpatError as exc:\n118:         return {\n119:             \"valid\": False,\n120:             \"error\": expat.ErrorString(exc.code) or \"parse error\",\n121:             \"line\": exc.lineno,\n122:             \"column\": exc.offset + 1,\n123:             \"root_element\": root[0] if root else None,\n124:         }\n125:     except (UnicodeEncodeError, ValueError):\n126:         return {\n127:             \"valid\": False,\n128:             \"error\": \"not well-formed (invalid character)\",\n129:             \"line\": 1,\n130:             \"column\": 1,\n131:             \"root_element\": root[0] if root else None,\n132:         }\n133:     return {\n134:         \"valid\": True,\n135:         \"error\": None,\n136:         \"line\": None,\n137:         \"column\": None,\n138:         \"root_element\": root[0] if root else None,\n139:     }\n140: \n\n(Showing lines 1-140 of 415. Use offset=141 to continue.)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: XML well-formedness checker API plus frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\nfrom xml.parsers import expat\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\nPREVIEW_LENGTH = 200","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: XML well-formedness checker API plus frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\nfrom xml.parsers import expat\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\nPREVIEW_LENGTH = 200\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS validations (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL,\n    xml_preview TEXT NOT NULL,\n    valid INTEGER NOT NULL,\n    error TEXT,\n    line INTEGER,\n    column INTEGER,\n    root_element TEXT,\n    created_at TEXT NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS idx_validations_user_created\n    ON validations (user_id, created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens (user_id);\n\"\"\"\n\n\n# ----------------------------------------------------------------- database\n\n\ndef _connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = _connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef _close_db(_exception: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = _connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef _now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\n# ------------------------------------------------------------ xml checking\n\n\ndef check_xml(text: str) -> dict[str, Any]:\n    \"\"\"Decide well-formedness of ``text`` without resolving anything external.\"\"\"\n    parser = expat.ParserCreate()\n    root: list[str] = []\n\n    def start_element(name: str, _attrs: dict[str, str]) -> None:\n        if not root:\n            root.append(name)\n\n    parser.StartElementHandler = start_element\n    # Never hand anything to the parser from outside the submitted text.\n    parser.ExternalEntityRefHandler = lambda *_args: 0\n    try:\n        parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)\n    except (AttributeError, expat.ExpatError):  # pragma: no cover - exotic builds\n        pass\n\n    try:\n        parser.Parse(text, True)\n    except expat.ExpatError as exc:\n        return {\n            \"valid\": False,\n            \"error\": expat.ErrorString(exc.code) or \"parse error\",\n            \"line\": exc.lineno,\n            \"column\": exc.offset + 1,\n            \"root_element\": root[0] if root else None,\n        }\n    except (UnicodeEncodeError, ValueError):\n        return {\n            \"valid\": False,\n            \"error\": \"not well-formed (invalid character)\",\n            \"line\": 1,\n            \"column\": 1,\n            \"root_element\": root[0] if root else None,\n        }\n    return {\n        \"valid\": True,\n        \"error\": None,\n        \"line\": None,\n        \"column\": None,\n        \"root_element\": root[0] if root else None,\n    }\n","lineStart":1,"lineEnd":140,"totalLines":415,"truncated":true}},"title":"backend/app.py","time":{"start":1794388178961,"end":1794388178973}},"id":"prt_1c9deb80d0017CXxxOQzK4XWYo","sessionID":"ses_e363e5f23ffeRVmgW4g0UYKH3s","messageID":"msg_1c9dd6dd4001wQzLM3SM5pUfsi"}}
