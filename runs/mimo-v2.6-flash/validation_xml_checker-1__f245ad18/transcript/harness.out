{"type":"tool_use","timestamp":1794386889443,"sessionID":"ses_e363e5f23ffeRVmgW4g0UYKH3s","part":{"type":"tool","tool":"write","callID":"call_4e9ec9ea339f4bcaa275ac23","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point: XML well-formedness checker API plus frontend serving.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\nfrom xml.parsers import expat\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or Path.cwd() / \"data\")\nDB_PATH = DATA_DIR / \"app.db\"\n\nPREVIEW_LENGTH = 200\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS validations (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL,\n    xml_preview TEXT NOT NULL,\n    valid INTEGER NOT NULL,\n    error TEXT,\n    line INTEGER,\n    column INTEGER,\n    root_element TEXT,\n    created_at TEXT NOT NULL,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS idx_validations_user_created\n    ON validations (user_id, created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens (user_id);\n\"\"\"\n\n\n# ----------------------------------------------------------------- database\n\n\ndef _connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = _connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef _close_db(_exception: BaseException | None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = _connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef _now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\n# ------------------------------------------------------------ xml checking\n\n\ndef check_xml(text: str) -> dict[str, Any]:\n    \"\"\"Decide well-formedness of ``text`` without resolving anything external.\"\"\"\n    parser = expat.ParserCreate()\n    root: list[str] = []\n\n    def start_element(name: str, _attrs: dict[str, str]) -> None:\n        if not root:\n            root.append(name)\n\n    parser.StartElementHandler = start_element\n    # Never hand anything to the parser from outside the submitted text.\n    parser.ExternalEntityRefHandler = lambda *_args: 0\n    try:\n        parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)\n    except (AttributeError, expat.ExpatError):  # pragma: no cover - exotic builds\n        pass\n\n    try:\n        parser.Parse(text, True)\n    except expat.ExpatError as exc:\n        return {\n            \"valid\": False,\n            \"error\": expat.ErrorString(exc.code) or \"parse error\",\n            \"line\": exc.lineno,\n            \"column\": exc.offset + 1,\n            \"root_element\": root[0] if root else None,\n        }\n    except (UnicodeEncodeError, ValueError):\n        return {\n            \"valid\": False,\n            \"error\": \"not well-formed (invalid character)\",\n            \"line\": 1,\n            \"column\": 1,\n            \"root_element\": root[0] if root else None,\n        }\n    return {\n        \"valid\": True,\n        \"error\": None,\n        \"line\": None,\n        \"column\": None,\n        \"root_element\": root[0] if root else None,\n    }\n\n\ndef _check_from_row(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n# ----------------------------------------------------------------- helpers\n\n\ndef _json_body() -> tuple[dict[str, Any] | None, Any]:\n    body = request.get_json(silent=True)\n    if not isinstance(body, dict):\n        return None, (jsonify({\"error\": \"a JSON object body is required\"}), 400)\n    return body, None\n\n\ndef _xml_from(body: dict[str, Any]) -> tuple[str | None, Any]:\n    if \"xml\" not in body:\n        return None, (jsonify({\"error\": \"the 'xml' field is required\"}), 400)\n    value = body[\"xml\"]\n    if not isinstance(value, str):\n        return None, (jsonify({\"error\": \"the 'xml' field must be a string\"}), 400)\n    return value, None\n\n\ndef _current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    return (\n        db()\n        .execute(\n            \"SELECT u.id AS id, u.username AS username \"\n            \"FROM tokens t JOIN users u ON u.id = t.user_id \"\n            \"WHERE t.token = ?\",\n            (token,),\n        )\n        .fetchone()\n    )\n\n\ndef _auth_error():\n    return jsonify({\"error\": \"a valid bearer token is required\"}), 401\n\n\ndef _query_int(name: str, default: int, minimum: int, maximum: int | None):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, (jsonify({\"error\": f\"'{name}' must be an integer\"}), 400)\n    value = max(minimum, value)\n    if maximum is not None:\n        value = min(maximum, value)\n    return value, None\n\n\n# ---------------------------------------------------------------- endpoints\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body, err = _json_body()\n    if err is not None:\n        return err\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"a username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"a password is required\"}), 400\n    username = username.strip()\n    if len(username) > 150:\n        return jsonify({\"error\": \"the username is too long\"}), 400\n    try:\n        cursor = db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), _now()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"that username is already taken\"}), 409\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body, err = _json_body()\n    if err is not None:\n        return err\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"a username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"a password is required\"}), 400\n    row = (\n        db()\n        .execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\",\n            (username.strip(),),\n        )\n        .fetchone()\n    )\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    token = secrets.token_urlsafe(32)\n    db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], _now()),\n    )\n    db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/validate/xml\")\ndef validate_xml():\n    body, err = _json_body()\n    if err is not None:\n        return err\n    xml, err = _xml_from(body)\n    if err is not None:\n        return err\n    return jsonify(check_xml(xml)), 200\n\n\n@app.post(\"/api/validations\")\ndef create_validation():\n    user = _current_user()\n    if user is None:\n        return _auth_error()\n    body, err = _json_body()\n    if err is not None:\n        return err\n    xml, err = _xml_from(body)\n    if err is not None:\n        return err\n    result = check_xml(xml)\n    created_at = _now()\n    cursor = db().execute(\n        \"INSERT INTO validations \"\n        \"(user_id, xml_preview, valid, error, line, column, root_element, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            user[\"id\"],\n            xml[:PREVIEW_LENGTH],\n            int(result[\"valid\"]),\n            result[\"error\"],\n            result[\"line\"],\n            result[\"column\"],\n            result[\"root_element\"],\n            created_at,\n        ),\n    )\n    db().commit()\n    return (\n        jsonify(\n            {\n                \"id\": cursor.lastrowid,\n                \"xml_preview\": xml[:PREVIEW_LENGTH],\n                \"valid\": result[\"valid\"],\n                \"error\": result[\"error\"],\n                \"line\": result[\"line\"],\n                \"column\": result[\"column\"],\n                \"root_element\": result[\"root_element\"],\n                \"created_at\": created_at,\n            }\n        ),\n        201,\n    )\n\n\n@app.get(\"/api/validations\")\ndef list_validations():\n    user = _current_user()\n    if user is None:\n        return _auth_error()\n\n    where = \"user_id = ?\"\n    params: list[Any] = [user[\"id\"]]\n    raw_valid = request.args.get(\"valid\")\n    if raw_valid is not None and raw_valid != \"\":\n        lowered = raw_valid.strip().lower()\n        if lowered in (\"true\", \"1\", \"yes\"):\n            where += \" AND valid = 1\"\n        elif lowered in (\"false\", \"0\", \"no\"):\n            where += \" AND valid = 0\"\n        else:\n            return jsonify({\"error\": \"'valid' must be true or false\"}), 400\n\n    page, err = _query_int(\"page\", 1, 1, None)\n    if err is not None:\n        return err\n    page_size, err = _query_int(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    if err is not None:\n        return err\n\n    conn = db()\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM validations WHERE {where}\", params\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM validations WHERE {where} \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return (\n        jsonify(\n            {\n                \"items\": [_check_from_row(row) for row in rows],\n                \"total\": total,\n                \"page\": page,\n                \"page_size\": page_size,\n            }\n        ),\n        200,\n    )\n\n\n@app.delete(\"/api/validations/<int:validation_id>\")\ndef delete_validation(validation_id: int):\n    user = _current_user()\n    if user is None:\n        return _auth_error()\n    cursor = db().execute(\n        \"DELETE FROM validations WHERE id = ? AND user_id = ?\",\n        (validation_id, user[\"id\"]),\n    )\n    db().commit()\n    if cursor.rowcount == 0:\n        return jsonify({\"error\": \"not found\"}), 404\n    return \"\", 204\n\n\n@app.route(\"/api/<path:_rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_fallback(_rest: str):\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    parts = Path(path).parts\n    if path and (\"..\" in parts or path.startswith(\"/\")):\n        return jsonify({\"error\": \"not found\"}), 404\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":  # pragma: no cover - local convenience\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794386889397,"end":1794386889419}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9cb0aad001hvgiqLo8NenBVi","sessionID":"ses_e363e5f23ffeRVmgW4g0UYKH3s","messageID":"msg_1c9c99857001edSfcWPoF1iJ3G"}}
