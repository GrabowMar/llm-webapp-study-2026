{"type":"tool_use","timestamp":1794388186582,"sessionID":"ses_e363e5f23ffeRVmgW4g0UYKH3s","part":{"type":"tool","tool":"read","callID":"call_c0a9211bd14544ccb97f3b6a","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py","offset":141},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n141: \n142: def _check_from_row(row: sqlite3.Row) -> dict[str, Any]:\n143:     return {\n144:         \"id\": row[\"id\"],\n145:         \"xml_preview\": row[\"xml_preview\"],\n146:         \"valid\": bool(row[\"valid\"]),\n147:         \"error\": row[\"error\"],\n148:         \"line\": row[\"line\"],\n149:         \"column\": row[\"column\"],\n150:         \"root_element\": row[\"root_element\"],\n151:         \"created_at\": row[\"created_at\"],\n152:     }\n153: \n154: \n155: # ----------------------------------------------------------------- helpers\n156: \n157: \n158: def _json_body() -> tuple[dict[str, Any] | None, Any]:\n159:     body = request.get_json(silent=True, force=True)\n160:     if not isinstance(body, dict):\n161:         return None, (jsonify({\"error\": \"a JSON object body is required\"}), 400)\n162:     return body, None\n163: \n164: \n165: def _xml_from(body: dict[str, Any]) -> tuple[str | None, Any]:\n166:     if \"xml\" not in body:\n167:         return None, (jsonify({\"error\": \"the 'xml' field is required\"}), 400)\n168:     value = body[\"xml\"]\n169:     if not isinstance(value, str):\n170:         return None, (jsonify({\"error\": \"the 'xml' field must be a string\"}), 400)\n171:     return value, None\n172: \n173: \n174: def _current_user() -> sqlite3.Row | None:\n175:     header = request.headers.get(\"Authorization\", \"\")\n176:     parts = header.split(None, 1)\n177:     if len(parts) != 2 or parts[0].lower() != \"bearer\":\n178:         return None\n179:     token = parts[1].strip()\n180:     if not token:\n181:         return None\n182:     return (\n183:         db()\n184:         .execute(\n185:             \"SELECT u.id AS id, u.username AS username \"\n186:             \"FROM tokens t JOIN users u ON u.id = t.user_id \"\n187:             \"WHERE t.token = ?\",\n188:             (token,),\n189:         )\n190:         .fetchone()\n191:     )\n192: \n193: \n194: def _auth_error():\n195:     return jsonify({\"error\": \"a valid bearer token is required\"}), 401\n196: \n197: \n198: def _query_int(name: str, default: int, minimum: int, maximum: int | None):\n199:     raw = request.args.get(name)\n200:     if raw is None or raw == \"\":\n201:         return default, None\n202:     try:\n203:         value = int(raw)\n204:     except ValueError:\n205:         return None, (jsonify({\"error\": f\"'{name}' must be an integer\"}), 400)\n206:     value = max(minimum, value)\n207:     if maximum is not None:\n208:         value = min(maximum, value)\n209:     return value, None\n210: \n211: \n212: # ---------------------------------------------------------------- endpoints\n213: \n214: \n215: @app.get(\"/api/health\")\n216: def health():\n217:     return {\"status\": \"ok\"}\n218: \n219: \n220: @app.post(\"/api/auth/register\")\n221: def register():\n222:     body, err = _json_body()\n223:     if err is not None:\n224:         return err\n225:     username = body.get(\"username\")\n226:     password = body.get(\"password\")\n227:     if not isinstance(username, str) or not username.strip():\n228:         return jsonify({\"error\": \"a username is required\"}), 400\n229:     if not isinstance(password, str) or not password:\n230:         return jsonify({\"error\": \"a password is required\"}), 400\n231:     username = username.strip()\n232:     if len(username) > 150:\n233:         return jsonify({\"error\": \"the username is too long\"}), 400\n234:     try:\n235:         cursor = db().execute(\n236:             \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n237:             (username, generate_password_hash(password), _now()),\n238:         )\n239:         db().commit()\n240:     except sqlite3.IntegrityError:\n241:         return jsonify({\"error\": \"that username is already taken\"}), 409\n242:     return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n243: \n244: \n245: @app.post(\"/api/auth/login\")\n246: def login():\n247:     body, err = _json_body()\n248:     if err is not None:\n249:         return err\n250:     username = body.get(\"username\")\n251:     password = body.get(\"password\")\n252:     if not isinstance(username, str) or not username.strip():\n253:         return jsonify({\"error\": \"a username is required\"}), 400\n254:     if not isinstance(password, str) or not password:\n255:         return jsonify({\"error\": \"a password is required\"}), 400\n256:     row = (\n257:         db()\n258:         .execute(\n259:             \"SELECT id, password_hash FROM users WHERE username = ?\",\n260:             (username.strip(),),\n261:         )\n262:         .fetchone()\n263:     )\n264:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n265:         return jsonify({\"error\": \"invalid username or password\"}), 401\n266:     token = secrets.token_urlsafe(32)\n267:     db().execute(\n268:         \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n269:         (token, row[\"id\"], _now()),\n270:     )\n271:     db().commit()\n272:     return jsonify({\"token\": token}), 200\n273: \n274: \n275: @app.post(\"/api/validate/xml\")\n276: def validate_xml():\n277:     body, err = _json_body()\n278:     if err is not None:\n279:         return err\n280:     xml, err = _xml_from(body)\n281:     if err is not None:\n282:         return err\n283:     return jsonify(check_xml(xml)), 200\n284: \n285: \n286: @app.post(\"/api/validations\")\n287: def create_validation():\n288:     user = _current_user()\n289:     if user is None:\n290:         return _auth_error()\n291:     body, err = _json_body()\n292:     if err is not None:\n293:         return err\n294:     xml, err = _xml_from(body)\n295:     if err is not None:\n296:         return err\n297:     result = check_xml(xml)\n298:     created_at = _now()\n299:     cursor = db().execute(\n300:         \"INSERT INTO validations \"\n301:         \"(user_id, xml_preview, valid, error, line, column, root_element, created_at) \"\n302:         \"VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n303:         (\n304:             user[\"id\"],\n305:             xml[:PREVIEW_LENGTH],\n306:             int(result[\"valid\"]),\n307:             result[\"error\"],\n308:             result[\"line\"],\n309:             result[\"column\"],\n310:             result[\"root_element\"],\n311:             created_at,\n312:         ),\n313:     )\n314:     db().commit()\n315:     return (\n316:         jsonify(\n317:             {\n318:                 \"id\": cursor.lastrowid,\n319:                 \"xml_preview\": xml[:PREVIEW_LENGTH],\n320:                 \"valid\": result[\"valid\"],\n321:                 \"error\": result[\"error\"],\n322:                 \"line\": result[\"line\"],\n323:                 \"column\": result[\"column\"],\n324:                 \"root_element\": result[\"root_element\"],\n325:                 \"created_at\": created_at,\n326:             }\n327:         ),\n328:         201,\n329:     )\n330: \n331: \n332: @app.get(\"/api/validations\")\n333: def list_validations():\n334:     user = _current_user()\n335:     if user is None:\n336:         return _auth_error()\n337: \n338:     where = \"user_id = ?\"\n339:     params: list[Any] = [user[\"id\"]]\n340:     raw_valid = request.args.get(\"valid\")\n341:     if raw_valid is not None and raw_valid != \"\":\n342:         lowered = raw_valid.strip().lower()\n343:         if lowered in (\"true\", \"1\", \"yes\"):\n344:             where += \" AND valid = 1\"\n345:         elif lowered in (\"false\", \"0\", \"no\"):\n346:             where += \" AND valid = 0\"\n347:         else:\n348:             return jsonify({\"error\": \"'valid' must be true or false\"}), 400\n349: \n350:     page, err = _query_int(\"page\", 1, 1, None)\n351:     if err is not None:\n352:         return err\n353:     page_size, err = _query_int(\"page_size\", DEFAULT_PAGE_SIZE, 1, None)\n354:     if err is not None:\n355:         return err\n356: \n357:     conn = db()\n358:     total = conn.execute(\n359:         f\"SELECT COUNT(*) FROM validations WHERE {where}\", params\n360:     ).fetchone()[0]\n361:     rows = conn.execute(\n362:         f\"SELECT * FROM validations WHERE {where} \"\n363:         \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n364:         [*params, page_size, (page - 1) * page_size],\n365:     ).fetchall()\n366:     return (\n367:         jsonify(\n368:             {\n369:                 \"items\": [_check_from_row(row) for row in rows],\n370:                 \"total\": total,\n371:                 \"page\": page,\n372:                 \"page_size\": page_size,\n373:             }\n374:         ),\n375:         200,\n376:     )\n377: \n378: \n379: @app.delete(\"/api/validations/<int:validation_id>\")\n380: def delete_validation(validation_id: int):\n381:     user = _current_user()\n382:     if user is None:\n383:         return _auth_error()\n384:     cursor = db().execute(\n385:         \"DELETE FROM validations WHERE id = ? AND user_id = ?\",\n386:         (validation_id, user[\"id\"]),\n387:     )\n388:     db().commit()\n389:     if cursor.rowcount == 0:\n390:         return jsonify({\"error\": \"not found\"}), 404\n391:     return \"\", 204\n392: \n393: \n394: @app.route(\"/api/<path:_rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\n395: def api_fallback(_rest: str):\n396:     return jsonify({\"error\": \"not found\"}), 404\n397: \n398: \n399: @app.get(\"/\")\n400: @app.get(\"/<path:path>\")\n401: def frontend(path: str = \"index.html\"):\n402:     if path.startswith(\"api/\"):\n403:         return jsonify({\"error\": \"not found\"}), 404\n404:     parts = Path(path).parts\n405:     if path and (\"..\" in parts or path.startswith(\"/\")):\n406:         return jsonify({\"error\": \"not found\"}), 404\n407:     if path and (DIST / path).is_file():\n408:         return send_from_directory(DIST, path)\n409:     return send_from_directory(DIST, \"index.html\")\n410: \n411: \n412: init_db()\n413: \n414: if __name__ == \"__main__\":  # pragma: no cover - local convenience\n415:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\n\n(End of file - total 415 lines)\n</content>","metadata":{"preview":"\ndef _check_from_row(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n# ----------------------------------------------------------------- helpers\n\n\ndef _json_body() -> tuple[dict[str, Any] | None, Any]:\n    body = request.get_json(silent=True, force=True)\n    if not isinstance(body, dict):","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\ndef _check_from_row(row: sqlite3.Row) -> dict[str, Any]:\n    return {\n        \"id\": row[\"id\"],\n        \"xml_preview\": row[\"xml_preview\"],\n        \"valid\": bool(row[\"valid\"]),\n        \"error\": row[\"error\"],\n        \"line\": row[\"line\"],\n        \"column\": row[\"column\"],\n        \"root_element\": row[\"root_element\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\n# ----------------------------------------------------------------- helpers\n\n\ndef _json_body() -> tuple[dict[str, Any] | None, Any]:\n    body = request.get_json(silent=True, force=True)\n    if not isinstance(body, dict):\n        return None, (jsonify({\"error\": \"a JSON object body is required\"}), 400)\n    return body, None\n\n\ndef _xml_from(body: dict[str, Any]) -> tuple[str | None, Any]:\n    if \"xml\" not in body:\n        return None, (jsonify({\"error\": \"the 'xml' field is required\"}), 400)\n    value = body[\"xml\"]\n    if not isinstance(value, str):\n        return None, (jsonify({\"error\": \"the 'xml' field must be a string\"}), 400)\n    return value, None\n\n\ndef _current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    return (\n        db()\n        .execute(\n            \"SELECT u.id AS id, u.username AS username \"\n            \"FROM tokens t JOIN users u ON u.id = t.user_id \"\n            \"WHERE t.token = ?\",\n            (token,),\n        )\n        .fetchone()\n    )\n\n\ndef _auth_error():\n    return jsonify({\"error\": \"a valid bearer token is required\"}), 401\n\n\ndef _query_int(name: str, default: int, minimum: int, maximum: int | None):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, (jsonify({\"error\": f\"'{name}' must be an integer\"}), 400)\n    value = max(minimum, value)\n    if maximum is not None:\n        value = min(maximum, value)\n    return value, None\n\n\n# ---------------------------------------------------------------- endpoints\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body, err = _json_body()\n    if err is not None:\n        return err\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"a username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"a password is required\"}), 400\n    username = username.strip()\n    if len(username) > 150:\n        return jsonify({\"error\": \"the username is too long\"}), 400\n    try:\n        cursor = db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), _now()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return jsonify({\"error\": \"that username is already taken\"}), 409\n    return jsonify({\"id\": cursor.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body, err = _json_body()\n    if err is not None:\n        return err\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return jsonify({\"error\": \"a username is required\"}), 400\n    if not isinstance(password, str) or not password:\n        return jsonify({\"error\": \"a password is required\"}), 400\n    row = (\n        db()\n        .execute(\n            \"SELECT id, password_hash FROM users WHERE username = ?\",\n            (username.strip(),),\n        )\n        .fetchone()\n    )\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return jsonify({\"error\": \"invalid username or password\"}), 401\n    token = secrets.token_urlsafe(32)\n    db().execute(\n        \"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, row[\"id\"], _now()),\n    )\n    db().commit()\n    return jsonify({\"token\": token}), 200\n\n\n@app.post(\"/api/validate/xml\")\ndef validate_xml():\n    body, err = _json_body()\n    if err is not None:\n        return err\n    xml, err = _xml_from(body)\n    if err is not None:\n        return err\n    return jsonify(check_xml(xml)), 200\n\n\n@app.post(\"/api/validations\")\ndef create_validation():\n    user = _current_user()\n    if user is None:\n        return _auth_error()\n    body, err = _json_body()\n    if err is not None:\n        return err\n    xml, err = _xml_from(body)\n    if err is not None:\n        return err\n    result = check_xml(xml)\n    created_at = _now()\n    cursor = db().execute(\n        \"INSERT INTO validations \"\n        \"(user_id, xml_preview, valid, error, line, column, root_element, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            user[\"id\"],\n            xml[:PREVIEW_LENGTH],\n            int(result[\"valid\"]),\n            result[\"error\"],\n            result[\"line\"],\n            result[\"column\"],\n            result[\"root_element\"],\n            created_at,\n        ),\n    )\n    db().commit()\n    return (\n        jsonify(\n            {\n                \"id\": cursor.lastrowid,\n                \"xml_preview\": xml[:PREVIEW_LENGTH],\n                \"valid\": result[\"valid\"],\n                \"error\": result[\"error\"],\n                \"line\": result[\"line\"],\n                \"column\": result[\"column\"],\n                \"root_element\": result[\"root_element\"],\n                \"created_at\": created_at,\n            }\n        ),\n        201,\n    )\n\n\n@app.get(\"/api/validations\")\ndef list_validations():\n    user = _current_user()\n    if user is None:\n        return _auth_error()\n\n    where = \"user_id = ?\"\n    params: list[Any] = [user[\"id\"]]\n    raw_valid = request.args.get(\"valid\")\n    if raw_valid is not None and raw_valid != \"\":\n        lowered = raw_valid.strip().lower()\n        if lowered in (\"true\", \"1\", \"yes\"):\n            where += \" AND valid = 1\"\n        elif lowered in (\"false\", \"0\", \"no\"):\n            where += \" AND valid = 0\"\n        else:\n            return jsonify({\"error\": \"'valid' must be true or false\"}), 400\n\n    page, err = _query_int(\"page\", 1, 1, None)\n    if err is not None:\n        return err\n    page_size, err = _query_int(\"page_size\", DEFAULT_PAGE_SIZE, 1, None)\n    if err is not None:\n        return err\n\n    conn = db()\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM validations WHERE {where}\", params\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM validations WHERE {where} \"\n        \"ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return (\n        jsonify(\n            {\n                \"items\": [_check_from_row(row) for row in rows],\n                \"total\": total,\n                \"page\": page,\n                \"page_size\": page_size,\n            }\n        ),\n        200,\n    )\n\n\n@app.delete(\"/api/validations/<int:validation_id>\")\ndef delete_validation(validation_id: int):\n    user = _current_user()\n    if user is None:\n        return _auth_error()\n    cursor = db().execute(\n        \"DELETE FROM validations WHERE id = ? AND user_id = ?\",\n        (validation_id, user[\"id\"]),\n    )\n    db().commit()\n    if cursor.rowcount == 0:\n        return jsonify({\"error\": \"not found\"}), 404\n    return \"\", 204\n\n\n@app.route(\"/api/<path:_rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_fallback(_rest: str):\n    return jsonify({\"error\": \"not found\"}), 404\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return jsonify({\"error\": \"not found\"}), 404\n    parts = Path(path).parts\n    if path and (\"..\" in parts or path.startswith(\"/\")):\n        return jsonify({\"error\": \"not found\"}), 404\n    if path and (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":  # pragma: no cover - local convenience\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))","lineStart":141,"lineEnd":415,"totalLines":415,"truncated":false}},"title":"backend/app.py","time":{"start":1794388186544,"end":1794388186559}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c9ded5ab001EMS8Tc8iU01YrU","sessionID":"ses_e363e5f23ffeRVmgW4g0UYKH3s","messageID":"msg_1c9deb8480014z4lu3oO5xFCdC"}}
