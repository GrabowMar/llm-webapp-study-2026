{"type":"tool_use","timestamp":1794322681903,"sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","part":{"type":"tool","tool":"write","callID":"call_807a58e6ab20444eb5793541","state":{"status":"completed","input":{"content":"\"\"\"SQLite access: connection handling, schema and sample data.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport sqlite3\nfrom contextlib import contextmanager\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom werkzeug.security import generate_password_hash\n\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\"\nDB_PATH = DATA_DIR / \"recipes.db\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS sessions (\n    token TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL,\n    expires_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS recipes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    ingredients TEXT NOT NULL,\n    instructions TEXT NOT NULL,\n    category TEXT NOT NULL,\n    prep_minutes INTEGER,\n    servings INTEGER,\n    author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_recipes_created ON recipes(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS idx_recipes_author ON recipes(author_id);\n\"\"\"\n\nSEED_USER = {\"username\": \"chef_claire\", \"password\": \"cookbook123\"}\n\nSEED_RECIPES = [\n    {\n        \"title\": \"Fluffy Buttermilk Pancakes\",\n        \"category\": \"Breakfast\",\n        \"prep_minutes\": 20,\n        \"servings\": 4,\n        \"ingredients\": [\n            \"2 cups all-purpose flour\",\n            \"2 tbsp sugar\",\n            \"2 tsp baking powder\",\n            \"1 tsp baking soda\",\n            \"1/2 tsp salt\",\n            \"2 cups buttermilk\",\n            \"2 large eggs\",\n            \"3 tbsp melted butter\",\n        ],\n        \"instructions\": (\n            \"Whisk the flour, sugar, baking powder, baking soda and salt in a large bowl.\\n\"\n            \"In a second bowl whisk the buttermilk, eggs and melted butter.\\n\"\n            \"Fold the wet mixture into the dry mixture until just combined; lumps are fine.\\n\"\n            \"Heat a lightly buttered skillet over medium heat.\\n\"\n            \"Pour 1/3 cup of batter per pancake and cook until bubbles form, about 2 minutes.\\n\"\n            \"Flip and cook for another 1 to 2 minutes until golden.\\n\"\n            \"Serve warm with maple syrup and butter.\"\n        ),\n    },\n    {\n        \"title\": \"Garlic Butter Pasta\",\n        \"category\": \"Main Course\",\n        \"prep_minutes\": 25,\n        \"servings\": 2,\n        \"ingredients\": [\n            \"200 g spaghetti\",\n            \"3 tbsp butter\",\n            \"4 cloves garlic, minced\",\n            \"1/4 tsp red pepper flakes\",\n            \"1/2 cup grated parmesan\",\n            \"2 tbsp chopped parsley\",\n            \"Salt and black pepper to taste\",\n        ],\n        \"instructions\": (\n            \"Cook the spaghetti in well-salted boiling water until al dente.\\n\"\n            \"Reserve a cup of the cooking water, then drain the pasta.\\n\"\n            \"Melt the butter in a wide pan over medium heat and soften the garlic for 1 minute.\\n\"\n            \"Add the red pepper flakes, then the pasta and a splash of the reserved water.\\n\"\n            \"Toss in the parmesan until the sauce clings to the strands.\\n\"\n            \"Season with salt and pepper, finish with parsley and serve immediately.\"\n        ),\n    },\n    {\n        \"title\": \"Classic Tomato Basil Soup\",\n        \"category\": \"Soup\",\n        \"prep_minutes\": 35,\n        \"servings\": 4,\n        \"ingredients\": [\n            \"2 tbsp olive oil\",\n            \"1 onion, chopped\",\n            \"3 cloves garlic, minced\",\n            \"2 cans (800 g) whole peeled tomatoes\",\n            \"1 cup vegetable stock\",\n            \"1 tsp sugar\",\n            \"1/2 cup fresh basil leaves\",\n            \"Salt and black pepper to taste\",\n        ],\n        \"instructions\": (\n            \"Warm the olive oil in a pot and sweat the onion for 5 minutes.\\n\"\n            \"Stir in the garlic and cook for 30 seconds.\\n\"\n            \"Add the tomatoes with their juices, the stock and the sugar.\\n\"\n            \"Simmer gently for 20 minutes, stirring now and then.\\n\"\n            \"Blend until smooth with an immersion blender.\\n\"\n            \"Tear in the basil, season with salt and pepper, then simmer for 2 more minutes.\"\n        ),\n    },\n    {\n        \"title\": \"Brown Butter Chocolate Chip Cookies\",\n        \"category\": \"Dessert\",\n        \"prep_minutes\": 45,\n        \"servings\": 18,\n        \"ingredients\": [\n            \"170 g butter\",\n            \"200 g brown sugar\",\n            \"100 g white sugar\",\n            \"2 large eggs\",\n            \"2 tsp vanilla extract\",\n            \"280 g all-purpose flour\",\n            \"1 tsp baking soda\",\n            \"1/2 tsp salt\",\n            \"200 g dark chocolate chips\",\n        ],\n        \"instructions\": (\n            \"Brown the butter in a saucepan until it smells nutty, then cool for 10 minutes.\\n\"\n            \"Whisk the butter with both sugars until glossy.\\n\"\n            \"Beat in the eggs and vanilla.\\n\"\n            \"Fold in the flour, baking soda and salt, then the chocolate chips.\\n\"\n            \"Chill the dough for 30 minutes.\\n\"\n            \"Scoop onto a lined tray and bake at 180 C for 11 to 13 minutes.\\n\"\n            \"Let them set on the tray for 5 minutes before moving to a rack.\"\n        ),\n    },\n]\n\n\ndef utcnow() -> str:\n    \"\"\"Current UTC time as an ISO 8601 string.\"\"\"\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n\n\n@contextmanager\ndef get_db():\n    \"\"\"Open a short-lived database connection and commit on success.\"\"\"\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30.0)\n    conn.row_factory = sqlite3.Row\n    try:\n        conn.execute(\"PRAGMA foreign_keys = ON\")\n        yield conn\n        conn.commit()\n    except BaseException:\n        conn.rollback()\n        raise\n    finally:\n        conn.close()\n\n\ndef init_db() -> None:\n    \"\"\"Create the schema and, on a fresh database, insert the sample data.\"\"\"\n    with get_db() as conn:\n        conn.executescript(SCHEMA)\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        user_count = conn.execute(\"SELECT COUNT(*) FROM users\").fetchone()[0]\n        if user_count:\n            return\n        cursor = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (\n                SEED_USER[\"username\"],\n                generate_password_hash(SEED_USER[\"password\"]),\n                utcnow(),\n            ),\n        )\n        author_id = cursor.lastrowid\n        for recipe in SEED_RECIPES:\n            conn.execute(\n                \"\"\"INSERT INTO recipes\n                   (title, ingredients, instructions, category, prep_minutes,\n                    servings, author_id, created_at)\n                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n                (\n                    recipe[\"title\"],\n                    json.dumps(recipe[\"ingredients\"]),\n                    recipe[\"instructions\"],\n                    recipe[\"category\"],\n                    recipe[\"prep_minutes\"],\n                    recipe[\"servings\"],\n                    author_id,\n                    utcnow(),\n                ),\n            )\n","filePath":"/workspace/backend/db.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/db.py","exists":false,"truncated":false},"title":"backend/db.py","time":{"start":1794322681865,"end":1794322681882}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f75003001kTC547U4doXO6a","sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","messageID":"msg_1c5f44aa6001xt4BGqoqAJG5sO"}}
{"type":"step_finish","timestamp":1794322681904,"sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","part":{"id":"prt_1c5f75021001I6IRI0buekiNYW","reason":"tool-calls","messageID":"msg_1c5f44aa6001xt4BGqoqAJG5sO","sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","type":"step-finish","tokens":{"total":48262,"input":182,"output":1665,"reasoning":6095,"cache":{"write":0,"read":40320}},"cost":0}}
{"type":"step_start","timestamp":1794322762682,"sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","part":{"id":"prt_1c5f88ba3001YXr8a1XF2PwVxQ","messageID":"msg_1c5f7502a001XYdR7aVhasTsrn","sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","type":"step-start"}}
{"type":"tool_use","timestamp":1794322762705,"sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","part":{"type":"tool","tool":"write","callID":"call_8b6c918464b447998993874d","state":{"status":"completed","input":{"content":"\"\"\"JSON API: accounts and recipes.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\n\nfrom flask import Blueprint, g, jsonify, request\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import get_db, utcnow\n\napi = Blueprint(\"api\", __name__, url_prefix=\"/api\")\n\nSESSION_DAYS = 30\nMAX_TITLE = 200\nMAX_CATEGORY = 50\nMAX_INGREDIENTS = 100\nMAX_INGREDIENT_LENGTH = 200\nMAX_INSTRUCTIONS = 5000\nMAX_PREP_MINUTES = 10080\nMAX_SERVINGS = 1000\n\n\ndef error_response(message: str, status: int, errors: dict | None = None):\n    body: dict = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\ndef validation_error(errors: dict):\n    return error_response(\"Validation failed.\", 400, errors)\n\n\ndef parse_json_body() -> dict | None:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n# ---------------------------------------------------------------------------\n# Authentication\n# ---------------------------------------------------------------------------\n\n\ndef get_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header.startswith(\"Bearer \"):\n        return None\n    token = header[len(\"Bearer \") :].strip()\n    return token or None\n\n\ndef get_current_user() -> dict | None:\n    token = get_token()\n    if not token:\n        return None\n    with get_db() as conn:\n        row = conn.execute(\n            \"\"\"SELECT u.id AS id, u.username AS username, s.expires_at AS expires_at\n               FROM sessions s\n               JOIN users u ON u.id = s.user_id\n               WHERE s.token = ?\"\"\",\n            (token,),\n        ).fetchone()\n    if row is None or row[\"expires_at\"] <= utcnow():\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n\n\ndef require_auth(handler):\n    @wraps(handler)\n    def wrapper(*args, **kwargs):\n        user = get_current_user()\n        if user is None:\n            return error_response(\"Authentication required.\", 401)\n        g.user = user\n        return handler(*args, **kwargs)\n\n    return wrapper\n\n\n@api.post(\"/auth/register\")\ndef register():\n    data = parse_json_body()\n    if data is None:\n        return error_response(\"Invalid JSON body.\", 400)\n\n    errors: dict[str, list[str]] = {}\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = [\"Username is required.\"]\n    elif len(username.strip()) > 50:\n        errors[\"username\"] = [\"Username must be 50 characters or fewer.\"]\n\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = [\"Password is required.\"]\n    elif len(password) > 128:\n        errors[\"password\"] = [\"Password must be 128 characters or fewer.\"]\n\n    if errors:\n        return validation_error(errors)\n\n    username = username.strip()\n    with get_db() as conn:\n        try:\n            cursor = conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), utcnow()),\n            )\n        except sqlite3.IntegrityError:\n            return error_response(\"Username already taken.\", 409)\n        user_id = cursor.lastrowid\n\n    return jsonify({\"id\": user_id, \"username\": username}), 201\n\n\n@api.post(\"/auth/login\")\ndef login():\n    data = parse_json_body()\n    if data is None:\n        return error_response(\"Invalid JSON body.\", 400)\n\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if (\n        not isinstance(username, str)\n        or not username.strip()\n        or not isinstance(password, str)\n        or not password\n    ):\n        return validation_error(\n            {\n                \"username\": [\"Username is required.\"]\n                if not isinstance(username, str) or not username.strip()\n                else [],\n                \"password\": [\"Password is required.\"]\n                if not isinstance(password, str) or not password\n                else [],\n            }\n        )\n\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT id, username, password_hash FROM users WHERE username = ? COLLATE NOCASE\",\n            (username.strip(),),\n        ).fetchone()\n        if row is None or not check_password_hash(row[\"password_hash\"], password):\n            return error_response(\"Invalid username or password.\", 401)\n        token = secrets.token_urlsafe(32)\n        expires_at = (\n            datetime.now(timezone.utc) + timedelta(days=SESSION_DAYS)\n        ).isoformat(timespec=\"seconds\")\n        conn.execute(\n            \"INSERT INTO sessions (token, user_id, created_at, expires_at) VALUES (?, ?, ?, ?)\",\n            (token, row[\"id\"], utcnow(), expires_at),\n        )\n\n    return jsonify({\"token\": token}), 200\n\n\n@api.get(\"/auth/me\")\n@require_auth\ndef me():\n    return jsonify({\"username\": g.user[\"username\"]})\n\n\n@api.post(\"/auth/logout\")\ndef logout():\n    token = get_token()\n    if token:\n        with get_db() as conn:\n            conn.execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n    return jsonify({\"status\": \"ok\"}), 200\n\n\n# ---------------------------------------------------------------------------\n# Recipe validation and serialisation\n# ---------------------------------------------------------------------------\n\n\ndef _validate_non_empty_text(\n    value, field: str, label: str, limit: int, errors: dict\n) -> str | None:\n    if not isinstance(value, str) or not value.strip():\n        errors.setdefault(field, []).append(f\"{label} is required.\")\n        return None\n    text = value.strip()\n    if len(text) > limit:\n        errors.setdefault(field, []).append(\n            f\"{label} must be {limit} characters or fewer.\"\n        )\n        return None\n    return text\n\n\ndef _validate_optional_int(\n    value, field: str, label: str, maximum: int, errors: dict\n) -> int | None:\n    if value is None or (isinstance(value, str) and not value.strip()):\n        return None\n    number: int | None = None\n    if isinstance(value, bool):\n        number = None\n    elif isinstance(value, int):\n        number = value\n    elif isinstance(value, float) and value.is_integer():\n        number = int(value)\n    elif isinstance(value, str) and value.strip().lstrip(\"+-\").isdigit():\n        number = int(value.strip())\n    if number is None or number < 0 or number > maximum:\n        errors.setdefault(field, []).append(\n            f\"{label} must be a whole number between 0 and {maximum}.\"\n        )\n        return None\n    return number\n\n\ndef validate_recipe(payload: dict) -> tuple[dict | None, dict]:\n    \"\"\"Validate recipe fields; returns (clean values, field errors).\"\"\"\n    errors: dict[str, list[str]] = {}\n    clean: dict = {}\n\n    title = _validate_non_empty_text(\n        payload.get(\"title\"), \"title\", \"Title\", MAX_TITLE, errors\n    )\n    if title is not None:\n        clean[\"title\"] = title\n\n    category = _validate_non_empty_text(\n        payload.get(\"category\"), \"category\", \"Category\", MAX_CATEGORY, errors\n    )\n    if category is not None:\n        clean[\"category\"] = category\n\n    ingredients = payload.get(\"ingredients\")\n    if not isinstance(ingredients, list):\n        errors.setdefault(\"ingredients\", []).append(\"Ingredients are required.\")\n    elif not ingredients:\n        errors.setdefault(\"ingredients\", []).append(\n            \"Add at least one ingredient.\"\n        )\n    elif len(ingredients) > MAX_INGREDIENTS:\n        errors.setdefault(\"ingredients\", []).append(\n            f\"A recipe can have at most {MAX_INGREDIENTS} ingredients.\"\n        )\n    else:\n        cleaned: list[str] = []\n        for item in ingredients:\n            if not isinstance(item, str) or not item.strip():\n                errors.setdefault(\"ingredients\", []).append(\n                    \"Each ingredient must be non-empty text.\"\n                )\n                cleaned = []\n                break\n            if len(item.strip()) > MAX_INGREDIENT_LENGTH:\n                errors.setdefault(\"ingredients\", []).append(\n                    f\"Each ingredient must be {MAX_INGREDIENT_LENGTH} characters or fewer.\"\n                )\n                cleaned = []\n                break\n            cleaned.append(item.strip())\n        if cleaned:\n            clean[\"ingredients\"] = cleaned\n\n    instructions = _validate_non_empty_text(\n        payload.get(\"instructions\"),\n        \"instructions\",\n        \"Instructions\",\n        MAX_INSTRUCTIONS,\n        errors,\n    )\n    if instructions is not None:\n        clean[\"instructions\"] = instructions\n\n    prep_minutes = _validate_optional_int(\n        payload.get(\"prep_minutes\"),\n        \"prep_minutes\",\n        \"Prep minutes\",\n        MAX_PREP_MINUTES,\n        errors,\n    )\n    if \"prep_minutes\" not in errors:\n        clean[\"prep_minutes\"] = prep_minutes\n\n    servings = _validate_optional_int(\n        payload.get(\"servings\"), \"servings\", \"Servings\", MAX_SERVINGS, errors\n    )\n    if \"servings\" not in errors:\n        clean[\"servings\"] = servings\n\n    if errors:\n        return None, errors\n    return clean, errors\n\n\ndef fetch_recipe(conn, recipe_id: int):\n    return conn.execute(\n        \"\"\"SELECT r.id, r.title, r.ingredients, r.instructions, r.category,\n                  r.prep_minutes, r.servings, r.author_id, r.created_at,\n                  u.username AS author\n           FROM recipes r\n           JOIN users u ON u.id = r.author_id\n           WHERE r.id = ?\"\"\",\n        (recipe_id,),\n    ).fetchone()\n\n\ndef full_recipe(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"ingredients\": json.loads(row[\"ingredients\"]),\n        \"instructions\": row[\"instructions\"],\n        \"category\": row[\"category\"],\n        \"prep_minutes\": row[\"prep_minutes\"],\n        \"servings\": row[\"servings\"],\n        \"created_at\": row[\"created_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\ndef query_int(name: str, default: int, minimum: int, maximum: int | None) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(str(raw).strip())\n    except ValueError:\n        return default\n    if value < minimum:\n        value = minimum\n    if maximum is not None and value > maximum:\n        value = maximum\n    return value\n\n\n# ---------------------------------------------------------------------------\n# Recipes\n# ---------------------------------------------------------------------------\n\n\n@api.get(\"/recipes\")\ndef list_recipes():\n    category = (request.args.get(\"category\") or \"\").strip()\n    q = (request.args.get(\"q\") or \"\").strip()\n    page = query_int(\"page\", 1, 1, None)\n    page_size = query_int(\"page_size\", 10, 1, 500)\n\n    where: list[str] = []\n    params: list = []\n    if category:\n        where.append(\"r.category = ? COLLATE NOCASE\")\n        params.append(category)\n    if q:\n        escaped = (\n            q.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        )\n        where.append(\"r.title LIKE ? ESCAPE '\\\\'\")\n        params.append(f\"%{escaped}%\")\n    clause = f\"WHERE {' AND '.join(where)}\" if where else \"\"\n\n    with get_db() as conn:\n        total = conn.execute(\n            f\"SELECT COUNT(*) FROM recipes r {clause}\", params\n        ).fetchone()[0]\n        rows = conn.execute(\n            f\"\"\"SELECT r.id, r.title, r.category, r.prep_minutes,\n                       u.username AS author\n                FROM recipes r\n                JOIN users u ON u.id = r.author_id\n                {clause}\n                ORDER BY r.created_at DESC, r.id DESC\n                LIMIT ? OFFSET ?\"\"\",\n            [*params, page_size, (page - 1) * page_size],\n        ).fetchall()\n\n    items = [\n        {\n            \"id\": row[\"id\"],\n            \"title\": row[\"title\"],\n            \"category\": row[\"category\"],\n            \"prep_minutes\": row[\"prep_minutes\"],\n            \"author\": row[\"author\"],\n        }\n        for row in rows\n    ]\n    return jsonify(\n        {\"items\": items, \"total\": total, \"page\": page, \"page_size\": page_size}\n    )\n\n\n@api.get(\"/recipes/<int:recipe_id>\")\ndef get_recipe(recipe_id: int):\n    with get_db() as conn:\n        row = fetch_recipe(conn, recipe_id)\n    if row is None:\n        return error_response(\"Recipe not found.\", 404)\n    return jsonify(full_recipe(row))\n\n\n@api.post(\"/recipes\")\n@require_auth\ndef create_recipe():\n    data = parse_json_body()\n    if data is None:\n        return error_response(\"Invalid JSON body.\", 400)\n\n    clean, errors = validate_recipe(data)\n    if errors:\n        return validation_error(errors)\n\n    with get_db() as conn:\n        cursor = conn.execute(\n            \"\"\"INSERT INTO recipes\n               (title, ingredients, instructions, category, prep_minutes,\n                servings, author_id, created_at)\n               VALUES (?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n            (\n                clean[\"title\"],\n                json.dumps(clean[\"ingredients\"]),\n                clean[\"instructions\"],\n                clean[\"category\"],\n                clean[\"prep_minutes\"],\n                clean[\"servings\"],\n                g.user[\"id\"],\n                utcnow(),\n            ),\n        )\n        row = fetch_recipe(conn, cursor.lastrowid)\n\n    return jsonify(full_recipe(row)), 201\n\n\n@api.put(\"/recipes/<int:recipe_id>\")\n@require_auth\ndef update_recipe(recipe_id: int):\n    with get_db() as conn:\n        existing = fetch_recipe(conn, recipe_id)\n        if existing is None:\n            return error_response(\"Recipe not found.\", 404)\n        if existing[\"author_id\"] != g.user[\"id\"]:\n            return error_response(\n                \"Only the author can change this recipe.\", 403\n            )\n\n        data = parse_json_body()\n        if data is None:\n            return error_response(\"Invalid JSON body.\", 400)\n\n        merged = {\n            \"title\": existing[\"title\"],\n            \"ingredients\": json.loads(existing[\"ingredients\"]),\n            \"instructions\": existing[\"instructions\"],\n            \"category\": existing[\"category\"],\n            \"prep_minutes\": existing[\"prep_minutes\"],\n            \"servings\": existing[\"servings\"],\n        }\n        provided = {key: value for key, value in data.items() if key in merged}\n        if not provided:\n            return error_response(\"No recipe fields were provided.\", 400)\n        merged.update(provided)\n\n        clean, errors = validate_recipe(merged)\n        if errors:\n            return validation_error(errors)\n\n        conn.execute(\n            \"\"\"UPDATE recipes\n               SET title = ?, ingredients = ?, instructions = ?, category = ?,\n                   prep_minutes = ?, servings = ?\n               WHERE id = ?\"\"\",\n            (\n                clean[\"title\"],\n                json.dumps(clean[\"ingredients\"]),\n                clean[\"instructions\"],\n                clean[\"category\"],\n                clean[\"prep_minutes\"],\n                clean[\"servings\"],\n                recipe_id,\n            ),\n        )\n        row = fetch_recipe(conn, recipe_id)\n\n    return jsonify(full_recipe(row))\n\n\n@api.delete(\"/recipes/<int:recipe_id>\")\n@require_auth\ndef delete_recipe(recipe_id: int):\n    with get_db() as conn:\n        existing = fetch_recipe(conn, recipe_id)\n        if existing is None:\n            return error_response(\"Recipe not found.\", 404)\n        if existing[\"author_id\"] != g.user[\"id\"]:\n            return error_response(\"Only the author can delete this recipe.\", 403)\n        conn.execute(\"DELETE FROM recipes WHERE id = ?\", (recipe_id,))\n\n    return jsonify({\"message\": \"Recipe deleted.\"}), 200\n\n\n@api.get(\"/categories\")\ndef categories():\n    with get_db() as conn:\n        rows = conn.execute(\n            \"SELECT DISTINCT category FROM recipes ORDER BY category COLLATE NOCASE\"\n        ).fetchall()\n    return jsonify({\"items\": [row[\"category\"] for row in rows]})\n","filePath":"/workspace/backend/api.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/api.py","exists":false,"truncated":false},"title":"backend/api.py","time":{"start":1794322762671,"end":1794322762686}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f88ba9001BSx8wXcXJQ12S2","sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","messageID":"msg_1c5f7502a001XYdR7aVhasTsrn"}}
