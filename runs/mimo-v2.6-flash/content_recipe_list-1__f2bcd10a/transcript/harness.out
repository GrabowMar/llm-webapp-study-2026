{"type":"tool_use","timestamp":1794323298600,"sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","part":{"type":"tool","tool":"write","callID":"call_c2aace2934b045aa88a95fe2","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { apiRequest, type RecipeListPage } from \"../api\";\nimport RecipeCard from \"../components/RecipeCard\";\n\nconst PAGE_SIZE = 9;\n\nexport default function BrowsePage() {\n  const [query, setQuery] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [category, setCategory] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [result, setResult] = useState<RecipeListPage | null>(null);\n  const [categories, setCategories] = useState<string[]>([]);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    let cancelled = false;\n    apiRequest<{ items: string[] }>(\"/api/categories\")\n      .then((data) => {\n        if (!cancelled) {\n          setCategories(data.items);\n        }\n      })\n      .catch(() => {});\n    return () => {\n      cancelled = true;\n    };\n  }, []);\n\n  useEffect(() => {\n    const timer = window.setTimeout(() => {\n      setSearch(query.trim());\n      setPage(1);\n    }, 300);\n    return () => window.clearTimeout(timer);\n  }, [query]);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    const params = new URLSearchParams({\n      page: String(page),\n      page_size: String(PAGE_SIZE),\n    });\n    if (category) {\n      params.set(\"category\", category);\n    }\n    if (search) {\n      params.set(\"q\", search);\n    }\n    apiRequest<RecipeListPage>(`/api/recipes?${params.toString()}`)\n      .then((data) => {\n        if (!cancelled) {\n          setResult(data);\n          setError(\"\");\n        }\n      })\n      .catch((err: Error) => {\n        if (!cancelled) {\n          setError(err.message);\n        }\n      })\n      .finally(() => {\n        if (!cancelled) {\n          setLoading(false);\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [search, category, page]);\n\n  const total = result?.total ?? 0;\n  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));\n  const categoryOptions = Array.from(\n    new Set([...categories, category].filter((value) => value !== \"\")),\n  ).sort((a, b) => a.localeCompare(b));\n\n  return (\n    <div>\n      <div className=\"mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between\">\n        <div>\n          <h1 className=\"text-2xl font-bold text-slate-900\">Recipes</h1>\n          <p className=\"text-sm text-slate-500\">\n            {result\n              ? `${total} ${total === 1 ? \"recipe\" : \"recipes\"} found`\n              : \"Browse the collection\"}\n          </p>\n        </div>\n\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center\">\n          <label className=\"flex items-center gap-2\">\n            <span className=\"text-sm font-medium text-slate-600\">Category</span>\n            <select\n              value={category}\n              onChange={(event) => {\n                setCategory(event.target.value);\n                setPage(1);\n              }}\n              className=\"rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-800 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500\"\n            >\n              <option value=\"\">All categories</option>\n              {categoryOptions.map((value) => (\n                <option key={value} value={value}>\n                  {value}\n                </option>\n              ))}\n            </select>\n          </label>\n\n          <label className=\"flex items-center gap-2\">\n            <span className=\"text-sm font-medium text-slate-600\">Search</span>\n            <input\n              type=\"search\"\n              value={query}\n              onChange={(event) => setQuery(event.target.value)}\n              placeholder=\"Title contains...\"\n              className=\"w-full rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-800 shadow-sm placeholder:text-slate-400 focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 sm:w-56\"\n            />\n          </label>\n        </div>\n      </div>\n\n      {error && (\n        <div className=\"mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\">\n          {error}\n        </div>\n      )}\n\n      {loading && !result ? (\n        <p className=\"py-12 text-center text-sm text-slate-500\">Loading...</p>\n      ) : result && result.items.length === 0 ? (\n        <div className=\"rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center\">\n          <p className=\"font-medium text-slate-700\">No recipes found</p>\n          <p className=\"mt-1 text-sm text-slate-500\">\n            Try a different search or category.\n          </p>\n        </div>\n      ) : (\n        <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {result?.items.map((recipe) => (\n            <RecipeCard key={recipe.id} recipe={recipe} />\n          ))}\n        </div>\n      )}\n\n      <nav\n        aria-label=\"Pagination\"\n        className=\"mt-8 flex items-center justify-between gap-3\"\n      >\n        <button\n          type=\"button\"\n          disabled={page <= 1}\n          onClick={() => setPage((value) => Math.max(1, value - 1))}\n          className=\"rounded-md border border-slate-300 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40\"\n        >\n          Previous\n        </button>\n        <span className=\"text-sm text-slate-600\">\n          Page {page} of {totalPages}\n        </span>\n        <button\n          type=\"button\"\n          disabled={page >= totalPages}\n          onClick={() => setPage((value) => Math.min(totalPages, value + 1))}\n          className=\"rounded-md border border-slate-300 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40\"\n        >\n          Next\n        </button>\n      </nav>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/BrowsePage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/BrowsePage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/BrowsePage.tsx","time":{"start":1794323298567,"end":1794323298577}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c600b8ff00196z7nu2eZA656P","sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","messageID":"msg_1c6003dae001dVMU84OEbfb9JS"}}
