{"type":"tool_use","timestamp":1794323232802,"sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","part":{"type":"tool","tool":"write","callID":"call_b92830541ab74502b72c3119","state":{"status":"completed","input":{"content":"import { createContext, useCallback, useContext, useEffect, useState } from \"react\";\nimport {\n  apiRequest,\n  clearSession,\n  loadToken,\n  loadUsername,\n  saveSession,\n} from \"./api\";\nimport Header from \"./components/Header\";\nimport AuthPage from \"./pages/AuthPage\";\nimport BrowsePage from \"./pages/BrowsePage\";\nimport RecipeFormPage from \"./pages/RecipeFormPage\";\nimport RecipePage from \"./pages/RecipePage\";\n\ntype Route =\n  | { name: \"browse\" }\n  | { name: \"recipe\"; id: number }\n  | { name: \"add\" }\n  | { name: \"edit\"; id: number }\n  | { name: \"login\" }\n  | { name: \"register\" };\n\ntype AuthContextValue = {\n  token: string | null;\n  username: string | null;\n  signIn: (token: string, username: string) => void;\n  signOut: () => void;\n};\n\nconst AuthContext = createContext<AuthContextValue>({\n  token: null,\n  username: null,\n  signIn: () => {},\n  signOut: () => {},\n});\n\nexport function useAuth(): AuthContextValue {\n  return useContext(AuthContext);\n}\n\nexport function navigate(path: string): void {\n  const target = path.startsWith(\"#\") ? path : `#${path}`;\n  if (window.location.hash === target) {\n    window.dispatchEvent(new HashChangeEvent(\"hashchange\"));\n  } else {\n    window.location.hash = target;\n  }\n}\n\nfunction parseRoute(hash: string): Route {\n  const parts = hash.replace(/^#/, \"\").split(\"/\").filter(Boolean);\n  if (parts.length === 0) {\n    return { name: \"browse\" };\n  }\n  const [head, second] = parts;\n  if (head === \"recipes\") {\n    const id = Number(second);\n    if (second !== undefined && Number.isInteger(id) && id > 0) {\n      return { name: \"recipe\", id };\n    }\n    return { name: \"browse\" };\n  }\n  if (head === \"edit\") {\n    const id = Number(second);\n    if (second !== undefined && Number.isInteger(id) && id > 0) {\n      return { name: \"edit\", id };\n    }\n    return { name: \"browse\" };\n  }\n  if (head === \"add\") return { name: \"add\" };\n  if (head === \"login\") return { name: \"login\" };\n  if (head === \"register\") return { name: \"register\" };\n  return { name: \"browse\" };\n}\n\nfunction useRoute(): Route {\n  const [route, setRoute] = useState<Route>(() =>\n    parseRoute(window.location.hash),\n  );\n  useEffect(() => {\n    const onChange = () => setRoute(parseRoute(window.location.hash));\n    window.addEventListener(\"hashchange\", onChange);\n    return () => window.removeEventListener(\"hashchange\", onChange);\n  }, []);\n  return route;\n}\n\nexport default function App() {\n  const [token, setToken] = useState<string | null>(() => loadToken());\n  const [username, setUsername] = useState<string | null>(() => loadUsername());\n  const route = useRoute();\n\n  useEffect(() => {\n    if (!token) {\n      return;\n    }\n    let cancelled = false;\n    apiRequest<{ username: string }>(\"/api/auth/me\", { token })\n      .then((data) => {\n        if (!cancelled) {\n          setUsername(data.username);\n          saveSession(token, data.username);\n        }\n      })\n      .catch(() => {\n        if (!cancelled) {\n          clearSession();\n          setToken(null);\n          setUsername(null);\n        }\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [token]);\n\n  const signIn = useCallback((nextToken: string, nextUsername: string) => {\n    saveSession(nextToken, nextUsername);\n    setToken(nextToken);\n    setUsername(nextUsername);\n  }, []);\n\n  const signOut = useCallback(() => {\n    if (token) {\n      void apiRequest(\"/api/auth/logout\", {\n        method: \"POST\",\n        token,\n      }).catch(() => {});\n    }\n    clearSession();\n    setToken(null);\n    setUsername(null);\n  }, [token]);\n\n  let page: React.ReactNode;\n  switch (route.name) {\n    case \"recipe\":\n      page = <RecipePage id={route.id} />;\n      break;\n    case \"add\":\n      page = token ? (\n        <RecipeFormPage />\n      ) : (\n        <AuthPage mode=\"login\" redirectTo=\"/add\" />\n      );\n      break;\n    case \"edit\":\n      page = token ? (\n        <RecipeFormPage id={route.id} />\n      ) : (\n        <AuthPage mode=\"login\" redirectTo={`/edit/${route.id}`} />\n      );\n      break;\n    case \"login\":\n      page = <AuthPage mode=\"login\" />;\n      break;\n    case \"register\":\n      page = <AuthPage mode=\"register\" />;\n      break;\n    default:\n      page = <BrowsePage />;\n  }\n\n  return (\n    <AuthContext.Provider value={{ token, username, signIn, signOut }}>\n      <div className=\"min-h-screen bg-slate-50 text-slate-800\">\n        <Header />\n        <main className=\"mx-auto w-full max-w-5xl px-4 py-8\">{page}</main>\n        <footer className=\"mx-auto max-w-5xl px-4 py-6 text-center text-xs text-slate-400\">\n          Recipe Book\n        </footer>\n      </div>\n    </AuthContext.Provider>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794323232775,"end":1794323232785}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5ffb8020016ZZ6SSddKMZbY5","sessionID":"ses_e3a146df2ffeWJKaKI3Yxy6aAm","messageID":"msg_1c5fde677001AfIfxAoSkBfWg4"}}
