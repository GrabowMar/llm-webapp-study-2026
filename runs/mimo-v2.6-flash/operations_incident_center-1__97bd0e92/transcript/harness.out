 team console\n155:       </footer>\n156:     </div>\n157:   );\n158: }\n159: \n160: export default function App() {\n161:   return (\n162:     <AuthProvider>\n163:       <Router />\n164:     </AuthProvider>\n165:   );\n166: }\n\n(End of file - total 166 lines)\n</content>","metadata":{"preview":"import { useEffect, type ReactNode } from \"react\";\nimport { AuthProvider, useAuth } from \"./auth\";\nimport { Link, navigate, usePath } from \"./router\";\nimport PublicPage from \"./pages/PublicPage\";\nimport AuthPage from \"./pages/AuthPage\";\nimport IncidentListPage from \"./pages/IncidentListPage\";\nimport IncidentDetailPage from \"./pages/IncidentDetailPage\";\nimport NewIncidentPage from \"./pages/NewIncidentPage\";\n\nfunction RequireAuth({ children }: { children: ReactNode }) {\n  const { username } = useAuth();\n  useEffect(() => {\n    if (!username) {\n      navigate(\"/login\");\n    }\n  }, [username]);\n  if (!username) {\n    return null;\n  }\n  return <>{children}</>;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/frontend/src/App.tsx","text":"import { useEffect, type ReactNode } from \"react\";\nimport { AuthProvider, useAuth } from \"./auth\";\nimport { Link, navigate, usePath } from \"./router\";\nimport PublicPage from \"./pages/PublicPage\";\nimport AuthPage from \"./pages/AuthPage\";\nimport IncidentListPage from \"./pages/IncidentListPage\";\nimport IncidentDetailPage from \"./pages/IncidentDetailPage\";\nimport NewIncidentPage from \"./pages/NewIncidentPage\";\n\nfunction RequireAuth({ children }: { children: ReactNode }) {\n  const { username } = useAuth();\n  useEffect(() => {\n    if (!username) {\n      navigate(\"/login\");\n    }\n  }, [username]);\n  if (!username) {\n    return null;\n  }\n  return <>{children}</>;\n}\n\nfunction NotFoundPage() {\n  return (\n    <div className=\"rounded-xl border border-slate-200 bg-white p-10 text-center\">\n      <h1 className=\"text-xl font-bold text-slate-900\">Page not found</h1>\n      <p className=\"mt-2 text-sm text-slate-500\">\n        The page you are looking for does not exist.\n      </p>\n      <Link\n        to=\"/\"\n        className=\"mt-4 inline-block text-sm font-semibold text-blue-600 hover:text-blue-800\"\n      >\n        Back to the incident center\n      </Link>\n    </div>\n  );\n}\n\nfunction Navbar() {\n  const { username, signOut } = useAuth();\n\n  const handleSignOut = () => {\n    signOut();\n    navigate(\"/\");\n  };\n\n  return (\n    <nav className=\"border-b border-slate-200 bg-white\">\n      <div className=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3\">\n        <Link to=\"/\" className=\"flex items-center gap-2\" title=\"Public status\">\n          <span className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-red-600 text-xs font-bold text-white\">\n            IC\n          </span>\n          <span className=\"text-base font-bold tracking-tight text-slate-900\">\n            Incident Center\n          </span>\n        </Link>\n        <div className=\"flex items-center gap-1 text-sm\">\n          <Link\n            to=\"/\"\n            className=\"rounded-lg px-3 py-2 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900\"\n          >\n            Status\n          </Link>\n          {username ? (\n            <>\n              <Link\n                to=\"/incidents\"\n                className=\"rounded-lg px-3 py-2 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900\"\n              >\n                Incidents\n              </Link>\n              <Link\n                to=\"/incidents/new\"\n                className=\"rounded-lg bg-blue-600 px-3 py-2 font-semibold text-white hover:bg-blue-700\"\n              >\n                Open incident\n              </Link>\n              <span\n                className=\"ml-2 max-w-[10rem] truncate rounded-lg bg-slate-100 px-3 py-2 font-medium text-slate-700\"\n                title={username}\n              >\n                {username}\n              </span>\n              <button\n                type=\"button\"\n                onClick={handleSignOut}\n                className=\"rounded-lg border border-slate-300 px-3 py-2 font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900\"\n              >\n                Sign out\n              </button>\n            </>\n          ) : (\n            <>\n              <Link\n                to=\"/login\"\n                className=\"rounded-lg px-3 py-2 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900\"\n              >\n                Sign in\n              </Link>\n              <Link\n                to=\"/register\"\n                className=\"rounded-lg bg-blue-600 px-3 py-2 font-semibold text-white hover:bg-blue-700\"\n              >\n                Register\n              </Link>\n            </>\n          )}\n        </div>\n      </div>\n    </nav>\n  );\n}\n\nfunction Router() {\n  const path = usePath();\n  const incidentMatch = /^\\/incidents\\/(\\d+)$/.exec(path);\n\n  let page: ReactNode;\n  if (path === \"/\" || path === \"\") {\n    page = <PublicPage />;\n  } else if (path === \"/login\") {\n    page = <AuthPage mode=\"login\" />;\n  } else if (path === \"/register\") {\n    page = <AuthPage mode=\"register\" />;\n  } else if (path === \"/incidents\") {\n    page = (\n      <RequireAuth>\n        <IncidentListPage />\n      </RequireAuth>\n    );\n  } else if (path === \"/incidents/new\") {\n    page = (\n      <RequireAuth>\n        <NewIncidentPage />\n      </RequireAuth>\n    );\n  } else if (incidentMatch) {\n    page = (\n      <RequireAuth>\n        <IncidentDetailPage id={Number(incidentMatch[1])} />\n      </RequireAuth>\n    );\n  } else {\n    page = <NotFoundPage />;\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-50\">\n      <Navbar />\n      <main className=\"mx-auto max-w-6xl px-4 py-8\">{page}</main>\n      <footer className=\"mx-auto max-w-6xl px-4 pb-8 text-xs text-slate-400\">\n        Incident Center — operations team console\n      </footer>\n    </div>\n  );\n}\n\nexport default function App() {\n  return (\n    <AuthProvider>\n      <Router />\n    </AuthProvider>\n  );\n}","lineStart":1,"lineEnd":166,"totalLines":166,"truncated":false}},"title":"frontend/src/App.tsx","time":{"start":1794358960247,"end":1794358960334}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c820e06f001kX8ou4edcxEXMd","sessionID":"ses_e380d61b4ffect0alGKeoUVSaW","messageID":"msg_1c81ea62d0013cneUCSQkLxK4X"}}
