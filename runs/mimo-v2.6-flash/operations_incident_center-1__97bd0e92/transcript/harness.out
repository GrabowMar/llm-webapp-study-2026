slow\"}],\"page\":1,\"page_size\":2,\"total\":3}\n---\nHTTP/1.1 200 OK\r\nServer: Werkzeug/3.1.9 Python/3.13.5\r\nDate: Wed, 11 Nov 2026 00:36:02 GMT\r\nContent-Type: application/json\r\nContent-Length: 967\r\nConnection: close\r\n\r\n{\"items\":[{\"commander\":\"\",\"id\":3,\"impact_summary\":\"\",\"opened_at\":\"2026-11-11T00:35:40.899560+00:00\",\"opened_by\":\"alice\",\"reopen_count\":0,\"resolved_at\":null,\"service\":\"docs\",\"severity\":\"sev4\",\"sla_breached\":false,\"sla_due_at\":\"2026-11-14T00:35:40.899560+00:00\",\"status\":\"investigating\",\"title\":\"Docs typo\"},{\"commander\":\"\",\"id\":2,\"impact_summary\":\"\",\"opened_at\":\"2026-11-11T00:35:40.896547+00:00\",\"opened_by\":\"alice\",\"reopen_count\":0,\"resolved_at\":null,\"service\":\"api\",\"severity\":\"sev2\",\"sla_breached\":false,\"sla_due_at\":\"2026-11-11T04:35:40.896547+00:00\",\"status\":\"investigating\",\"title\":\"Search slow\"},{\"commander\":\"alice\",\"id\":1,\"impact_summary\":\"Users cannot pay\",\"opened_at\":\"2026-11-11T00:35:40.888064+00:00\",\"opened_by\":\"alice\",\"reopen_count\":0,\"resolved_at\":null,\"service\":\"payments\",\"severity\":\"sev1\",\"sla_breached\":false,\"sla_due_at\":\"2026-11-11T01:35:40.888064+00:00\",\"status\":\"investigating\",\"title\":\"Checkout failing\"}],\"page\":1,\"page_size\":50,\"total\":3}\n","exit":0,"truncated":false},"title":"TOKEN=$(python3 -c \"\nimport json,urllib.request\nreq=urllib.request.Request('http://localhost:8000/api/auth/login', method='POST')\nreq.add_header('Content-Type','application/json')\nprint(json.load(urllib.request.urlopen(req, json.dumps({'username':'alice','password':'secret1'}).encode()))['token'])\")\necho \"token=$TOKEN\"\ncurl -s -i \"http://localhost:8000/api/incidents?page_size=2\" -H \"Authorization: Bearer $TOKEN\" | head -20\necho ---\ncurl -s -i \"http://localhost:8000/api/incidents\" -H \"Authorization: Bearer $TOKEN\" | head -8","time":{"start":1794357362482,"end":1794357362834}},"metadata":{"ope