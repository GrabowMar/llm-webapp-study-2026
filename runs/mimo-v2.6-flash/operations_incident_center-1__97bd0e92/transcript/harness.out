.token","workdir":"/workspace"},"error":"The user has specified a rule which prevents you from using this specific tool call. Here are some of the relevant rules [{\"permission\":\"*\",\"action\":\"allow\",\"pattern\":\"*\"},{\"permission\":\"external_directory\",\"pattern\":\"*\",\"action\":\"ask\"},{\"permission\":\"external_directory\",\"pattern\":\"/run/home/.local/share/opencode/tool-output/*\",\"action\":\"allow\"},{\"permission\":\"external_directory\",\"pattern\":\"/tmp/opencode/*\",\"action\":\"allow\"},{\"permission\":\"external_directory\",\"action\":\"deny\",\"pattern\":\"*\"},{\"permission\":\"external_directory\",\"pattern\":\"/run/home/.local/share/opencode/tool-output/*\",\"action\":\"allow\"}]","time":{"start":1794357252167,"end":1794357252180}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c806d03f001TYXmleD99SS5zT","sessionID":"ses_e380d61b4ffect0alGKeoUVSaW","messageID":"msg_1c8069b9c001okTC9Jgg3b7PJt"}}
