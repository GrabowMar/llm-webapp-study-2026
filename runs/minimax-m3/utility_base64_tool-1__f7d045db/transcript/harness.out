{"type":"tool_use","timestamp":1794359319847,"sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","part":{"type":"tool","tool":"write","callID":"call_01a1c82657db72dea0add444","state":{"status":"completed","input":{"content":"import \"@testing-library/jest-dom/vitest\";\nimport { afterEach, vi } from \"vitest\";\nimport { cleanup } from \"@testing-library/react\";\n\nafterEach(() => {\n  cleanup();\n  window.localStorage.clear();\n  vi.unstubAllGlobals();\n});\n","filePath":"/workspace/frontend/src/test/setup.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/test/setup.ts","exists":false,"truncated":false},"title":"frontend/src/test/setup.ts","time":{"start":1794359319810,"end":1794359319819}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8265cfa001EloRXbzLdLuZIX","sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","messageID":"msg_1c8265292001cswVO0treMIFLO"}}
