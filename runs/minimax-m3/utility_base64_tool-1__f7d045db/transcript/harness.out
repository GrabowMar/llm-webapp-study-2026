{"type":"tool_use","timestamp":1794358772614,"sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","part":{"type":"tool","tool":"write","callID":"call_01a1c81dfa64775faa57a4b3","state":{"status":"completed","input":{"content":"\"\"\"Base64 helpers shared by the API endpoints.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport binascii\n\nPREVIEW_LIMIT = 200\n\n\nclass ConversionError(ValueError):\n    \"\"\"Raised when a payload cannot be converted.\"\"\"\n\n\ndef encode_text(text: str) -> str:\n    \"\"\"Encode text as UTF-8 into standard, padded base64.\"\"\"\n    return base64.b64encode(text.encode(\"utf-8\")).decode(\"ascii\")\n\n\ndef decode_base64(value: str) -> str:\n    \"\"\"Decode standard base64 into UTF-8 text.\"\"\"\n    compact = \"\".join(value.split())\n    if not compact:\n        return \"\"\n    try:\n        raw = base64.b64decode(compact, validate=True)\n    except (binascii.Error, ValueError) as exc:\n        raise ConversionError(\"Invalid base64 input\") from exc\n    try:\n        return raw.decode(\"utf-8\")\n    except UnicodeDecodeError as exc:\n        raise ConversionError(\"Decoded value is not valid UTF-8 text\") from exc\n\n\ndef convert(direction: str, value: str) -> str:\n    \"\"\"Convert a value in the given direction (\"encode\" or \"decode\").\"\"\"\n    if direction == \"encode\":\n        return encode_text(value)\n    if direction == \"decode\":\n        return decode_base64(value)\n    raise ConversionError(\"Direction must be 'encode' or 'decode'\")\n\n\ndef preview(text: str, limit: int = PREVIEW_LIMIT) -> str:\n    \"\"\"Return a short preview of a text.\"\"\"\n    return text[:limit]\n","filePath":"/workspace/backend/codec.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/codec.py","exists":false,"truncated":false},"title":"backend/codec.py","time":{"start":1794358772581,"end":1794358772594}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c81e035e00151sI1vUtaB7jF5","sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","messageID":"msg_1c81df4d0001ZnJ5PjewfDGk6c"}}
