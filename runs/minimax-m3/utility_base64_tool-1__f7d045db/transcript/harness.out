n+    if path.startswith(\"api/\"):\n+        return error(\"Not found\", 404)\n     if (DIST / path).is_file():\n         return send_from_directory(DIST, path)\n-    return send_from_directory(DIST, \"index.html\")\n+    if (DIST / \"index.html\").is_file():\n+        return send_from_directory(DIST, \"index.html\")\n+    return error(\"Frontend build is not available\", 404)\n \n \n db.init_db()\n","additions":5,"deletions":1},"truncated":false},"title":"backend/app.py","time":{"start":1794358801498,"end":1794358801512}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c81e7454001ogQeaIwdIZykzT","sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","messageID":"msg_1c81e57c4001x1lLw5139AlC2g"}}
