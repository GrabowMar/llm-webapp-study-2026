{"type":"tool_use","timestamp":1794359124849,"sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","part":{"type":"tool","tool":"write","callID":"call_01a1c823466f7705830b282c","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport * as api from \"../api\";\nimport { ApiError } from \"../api\";\nimport type { Conversion } from \"../types\";\n\ninterface HistoryPanelProps {\n  token: string | null;\n  version: number;\n  onError: (message: string | null) => void;\n}\n\nconst PAGE_SIZE = 5;\n\nfunction formatTimestamp(value: string): string {\n  const parsed = new Date(value);\n  if (Number.isNaN(parsed.getTime())) return value;\n  return parsed.toLocaleString();\n}\n\nexport default function HistoryPanel({\n  token,\n  version,\n  onError,\n}: HistoryPanelProps) {\n  const [items, setItems] = useState<Conversion[]>([]);\n  const [total, setTotal] = useState(0);\n  const [page, setPage] = useState(1);\n  const [loading, setLoading] = useState(false);\n\n  const load = useCallback(\n    async (targetPage: number) => {\n      if (!token) return;\n      setLoading(true);\n      try {\n        const data = await api.listConversions(token, targetPage, PAGE_SIZE);\n        setItems(data.items);\n        setTotal(data.total);\n        setPage(data.page);\n      } catch (err) {\n        onError(err instanceof ApiError ? err.message : \"Something went wrong\");\n      } finally {\n        setLoading(false);\n      }\n    },\n    [token, onError],\n  );\n\n  useEffect(() => {\n    setPage(1);\n    void load(1);\n  }, [load, version]);\n\n  if (!token) {\n    return (\n      <section className=\"rounded-2xl border border-slate-800 bg-slate-900/70 p-5\">\n        <h2 className=\"text-sm font-semibold uppercase tracking-wide text-slate-400\">\n          History\n        </h2>\n        <p className=\"mt-3 text-sm text-slate-500\">\n          Sign in to keep your conversions in a private history.\n        </p>\n      </section>\n    );\n  }\n\n  const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));\n\n  async function remove(id: number) {\n    if (!token) return;\n    try {\n      await api.deleteConversion(token, id);\n      if (items.length === 1 && page > 1) {\n        await load(page - 1);\n      } else {\n        await load(page);\n      }\n    } catch (err) {\n      onError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    }\n  }\n\n  return (\n    <section className=\"rounded-2xl border border-slate-800 bg-slate-900/70 p-5\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <h2 className=\"text-sm font-semibold uppercase tracking-wide text-slate-400\">\n          History\n        </h2>\n        <p className=\"text-sm text-slate-500\">\n          {total} saved conversion{total === 1 ? \"\" : \"s\"}\n        </p>\n      </div>\n\n      {items.length === 0 ? (\n        <p className=\"mt-4 text-sm text-slate-500\">\n          Nothing saved yet. Turn on &quot;Save to history&quot; and convert\n          something.\n        </p>\n      ) : (\n        <ul className=\"mt-4 flex flex-col gap-2\">\n          {items.map((item) => (\n            <li\n              key={item.id}\n              data-testid=\"history-item\"\n              className=\"flex flex-wrap items-start justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3\"\n            >\n              <div className=\"min-w-0 flex-1\">\n                <div className=\"flex items-center gap-2\">\n                  <span\n                    className={`rounded-full px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${\n                      item.direction === \"encode\"\n                        ? \"bg-indigo-500/20 text-indigo-200\"\n                        : \"bg-emerald-500/20 text-emerald-200\"\n                    }`}\n                  >\n                    {item.direction}\n                  </span>\n                  <span className=\"text-xs text-slate-500\">\n                    {formatTimestamp(item.created_at)}\n                  </span>\n                </div>\n                <p className=\"mt-2 truncate font-mono text-sm text-slate-200\">\n                  {item.input_preview}\n                </p>\n                <p className=\"mt-1 truncate font-mono text-sm text-slate-400\">\n                  {item.output_preview}\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => remove(item.id)}\n                title=\"Delete conversion\"\n                className=\"rounded-lg border border-slate-700 px-3 py-1.5 text-sm font-medium text-slate-300 transition hover:border-rose-500 hover:text-rose-200\"\n              >\n                Delete\n              </button>\n            </li>\n          ))}\n        </ul>\n      )}\n\n      <div className=\"mt-4 flex flex-wrap items-center justify-between gap-3\">\n        <p className=\"text-sm text-slate-500\">\n          Page {page} of {pageCount}\n        </p>\n        <div className=\"flex gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => load(page - 1)}\n            disabled={loading || page <= 1}\n            title=\"Previous page\"\n            className=\"rounded-lg border border-slate-700 px-3 py-1.5 text-sm font-medium text-slate-200 transition hover:border-slate-500 hover:text-white disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            Previous\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => load(page + 1)}\n            disabled={loading || page >= pageCount}\n            title=\"Next page\"\n            className=\"rounded-lg border border-slate-700 px-3 py-1.5 text-sm font-medium text-slate-200 transition hover:border-slate-500 hover:text-white disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            Next\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/HistoryPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/HistoryPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/HistoryPanel.tsx","time":{"start":1794359124819,"end":1794359124829}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c823634e001cWV5ggRqzInAcp","sessionID":"ses_e37e4f349ffe51J6s9LdQyAxPv","messageID":"msg_1c823339d001in6VqYg00arkMY"}}
