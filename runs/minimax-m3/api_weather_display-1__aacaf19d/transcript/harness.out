sername, str) or not username.strip():\n+    errors[\"username\"] = \"username is required\"\n+if not isinstance(password, str) or not password:\n+    errors[\"password\"] = \"password is required\"\n+if errors:\n+    return validation_error(errors)\n+\n conn = get_db()\n row = store.find_user_by_username(conn, username.strip())\n if row is None or not verify_password(password, row[\"password_hash\"]):\n     return error_response(401, \"invalid username or password\")\n","filediff":{"file":"/workspace/backend/app.py","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -221,15 +221,17 @@\n     return error_response(400, \"request body must be a JSON object\")\n \n username = payload.get(\"username\")\n password = payload.get(\"password\")\n-if not isinstance(username, str) or not isinstance(password, str) or not username.strip() or not password:\n-    return validation_error(\n-        {\"username\": \"username is required\", \"password\": \"password is required\"}\n-        if not (isinstance(username, str) and username.strip())\n-        else {\"password\": \"password is required\"}\n-    )\n \n+errors: dict = {}\n+if not isinstance(username, str) or not username.strip():\n+    errors[\"username\"] = \"username is required\"\n+if not isinstance(password, str) or not password:\n+    errors[\"password\"] = \"password is required\"\n+if errors:\n+    return validation_error(errors)\n+\n conn = get_db()\n row = store.find_user_by_username(conn, username.strip())\n if row is None or not verify_password(password, row[\"password_hash\"]):\n     return error_response(401, \"invalid username or password\")\n","additions":8,"deletions":6},"truncated":false},"title":"backend/app.py","time":{"start":1794306920250,"end":1794306920318}},"id":"prt_1c506cf31001345cHETSteIKhi","sessionID":"ses_e3afb8e6dffemZh34YunfKALwC","messageID":"msg_1c506b19c001o8ZkFYdTVmkvg7"}}
