e 240, in test_lookup_is_recorded\n    self.assertTrue(items[0][\"found\"])\n    ~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^\nAssertionError: False is not true\n\n----------------------------------------------------------------------\nRan 20 tests in 1.698s\n\nFAILED (failures=6)\n","exit":0,"truncated":false},"title":"/workspace/.venv/bin/python -m unittest discover -s tests -v 2>&1 | tail -40","time":{"start":1794306945212,"end":1794306947256}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c50730b4001EZ9tKvFNARNUDz","sessionID":"ses_e3afb8e6dffemZh34YunfKALwC","messageID":"msg_1c507294d001zymtZ37H2807jV"}}
