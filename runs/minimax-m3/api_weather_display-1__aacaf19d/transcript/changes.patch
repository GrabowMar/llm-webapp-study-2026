+          className="shrink-0 rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-700 disabled:cursor-not-allowed disabled:opacity-60"
+        >
+          {busy ? "Searching…" : "Search"}
+        </button>
+      </form>
+    </section>
+  );
+}
