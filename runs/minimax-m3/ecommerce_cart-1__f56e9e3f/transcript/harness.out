{"type":"tool_use","timestamp":1794380681091,"sessionID":"ses_e36a1605fffeQa463ZF52q8gD3","part":{"type":"tool","tool":"read","callID":"call_01a1c96c4bdf756a82126399","state":{"status":"completed","input":{"filePath":"/workspace/backend/app.py"},"output":"<path>/workspace/backend/app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import base64\n6: import fcntl\n7: import hmac\n8: import os\n9: import secrets\n10: import sqlite3\n11: import time\n12: from decimal import Decimal, InvalidOperation, ROUND_HALF_UP\n13: from pathlib import Path\n14: \n15: from flask import Flask, g, jsonify, request, send_from_directory\n16: from werkzeug.security import check_password_hash, generate_password_hash\n17: \n18: ROOT = Path(__file__).resolve().parent.parent\n19: DIST = ROOT / \"frontend\" / \"dist\"\n20: DATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (ROOT / \"data\")).resolve()\n21: DB_PATH = DATA_DIR / \"shop.db\"\n22: SECRET_PATH = DATA_DIR / \"secret.key\"\n23: LOCK_PATH = DATA_DIR / \"init.lock\"\n24: \n25: ADMIN_USERNAME = \"admin\"\n26: TOKEN_TTL_SECONDS = 60 * 60 * 24 * 30\n27: MAX_PAGE_SIZE = 100\n28: DEFAULT_PAGE_SIZE = 20\n29: \n30: app = Flask(__name__, static_folder=None)\n31: \n32: \n33: # --------------------------------------------------------------------------\n34: # helpers\n35: # --------------------------------------------------------------------------\n36: def api_error(status: int, message: str):\n37:     response = jsonify({\"error\": message, \"message\": message})\n38:     response.status_code = status\n39:     return response\n40: \n41: \n42: def now_ts() -> float:\n43:     return time.time()\n44: \n45: \n46: def secret_key() -> bytes:\n47:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n48:     if not SECRET_PATH.exists():\n49:         SECRET_PATH.write_text(secrets.token_hex(32))\n50:         os.chmod(SECRET_PATH, 0o600)\n51:     return bytes.fromhex(SECRET_PATH.read_text().strip())\n52: \n53: \n54: def _b64(raw: bytes) -> str:\n55:     return base64.urlsafe_b64encode(raw).decode().rstrip(\"=\")\n56: \n57: \n58: def _unb64(raw: str) -> bytes:\n59:     return base64.urlsafe_b64decode(raw + \"=\" * (-len(raw) % 4))\n60: \n61: \n62: def make_token(user_id: int) -> str:\n63:     payload = f\"{user_id}.{int(now_ts() + TOKEN_TTL_SECONDS)}\"\n64:     signature = hmac.new(secret_key(), payload.encode(), \"sha256\").hexdigest()\n65:     return f\"{_b64(payload.encode())}.{signature}\"\n66: \n67: \n68: def read_token(token: str) -> int | None:\n69:     if not token or \".\" not in token:\n70:         return None\n71:     encoded, _, signature = token.partition(\".\")\n72:     try:\n73:         payload = _unb64(encoded).decode()\n74:     except Exception:\n75:         return None\n76:     expected = hmac.new(secret_key(), payload.encode(), \"sha256\").hexdigest()\n77:     if not hmac.compare_digest(expected, signature):\n78:         return None\n79:     try:\n80:         user_id, expires = payload.split(\".\", 1)\n81:         if int(expires) < now_ts():\n82:             return None\n83:         return int(user_id)\n84:     except (TypeError, ValueError):\n85:         return None\n86: \n87: \n88: def db() -> sqlite3.Connection:\n89:     if \"db\" not in g:\n90:         DATA_DIR.mkdir(parents=True, exist_ok=True)\n91:         conn = sqlite3.connect(DB_PATH, timeout=15)\n92:         conn.row_factory = sqlite3.Row\n93:         conn.execute(\"PRAGMA busy_timeout=10000\")\n94:         conn.execute(\"PRAGMA foreign_keys=ON\")\n95:         g.db = conn\n96:     return g.db\n97: \n98: \n99: @app.teardown_appcontext\n100: def close_db(_exc):\n101:     conn = g.pop(\"db\", None)\n102:     if conn is not None:\n103:         conn.close()\n104: \n105: \n106: def body() -> dict:\n107:     data = request.get_json(silent=True)\n108:     return data if isinstance(data, dict) else {}\n109: \n110: \n111: def to_price(value) -> Decimal | None:\n112:     \"\"\"Convert a JSON price into an exact decimal; None when not a usable number.\"\"\"\n113:     if isinstance(value, bool) or value is None:\n114:         return None\n115:     if isinstance(value, str):\n116:         value = value.strip()\n117:         if not value:\n118:             return None\n119:     if not isinstance(value, (int, float, Decimal)):\n120:         return None\n121:     try:\n122:         amount = Decimal(str(value))\n123:     except (InvalidOperation, ValueError):\n124:         return None\n125:     if not amount.is_finite() or amount < 0:\n126:         return None\n127:     return amount\n128: \n129: \n130: def money(amount: Decimal) -> float:\n131:     \"\"\"Render an exact decimal amount as a JSON friendly float.\"\"\"\n132:     return float(amount)\n133: \n134: \n135: def to_quantity(value) -> int | None:\n136:     if isinstance(value, bool) or value is None:\n137:         return None\n138:     if isinstance(value, str):\n139:         value = value.strip()\n140:         if not value:\n141:             return None\n142:     if isinstance(value, float):\n143:         if not value.is_integer():\n144:             return None\n145:         value = int(value)\n146:     if not isinstance(value, int):\n147:         return None\n148:     if value < 1:\n149:         return None\n150:     return value\n151: \n152: \n153: def to_stock(value) -> int | None:\n154:     if isinstance(value, bool) or value is None:\n155:         return None\n156:     if isinstance(value, str):\n157:         value = value.strip()\n158:         if not value:\n159:             return None\n160:     if isinstance(value, float):\n161:         if not value.is_integer():\n162:             return None\n163:         value = int(value)\n164:     if not isinstance(value, int) or value < 0:\n165:         return None\n166:     return value\n167: \n168: \n169: def to_flag(value) -> bool | None:\n170:     if isinstance(value, bool):\n171:         return value\n172:     if isinstance(value, str):\n173:         lowered = value.strip().lower()\n174:         if lowered in (\"true\", \"1\", \"yes\", \"on\"):\n175:             return True\n176:         if lowered in (\"false\", \"0\", \"no\", \"off\"):\n177:             return False\n178:     if isinstance(value, int) and value in (0, 1):\n179:         return bool(value)\n180:     return None\n181: \n182: \n183: def product_json(row: sqlite3.Row) -> dict:\n184:     return {\n185:         \"id\": row[\"id\"],\n186:         \"name\": row[\"name\"],\n187:         \"description\": row[\"description\"],\n188:         \"price\": money(row[\"price_cents\"]),\n189:         \"stock\": row[\"stock\"],\n190:         \"is_active\": bool(row[\"is_active\"]),\n191:     }\n192: \n193: \n194: def cart_item_json(row: sqlite3.Row) -> dict:\n195:     unit = row[\"price_cents\"]\n196:     quantity = row[\"quantity\"]\n197:     return {\n198:         \"id\": row[\"id\"],\n199:         \"product_id\": row[\"product_id\"],\n200:         \"quantity\": quantity,\n201:         \"name\": row[\"name\"],\n202:         \"unit_price\": money(unit),\n203:         \"line_total\": money(unit * quantity),\n204:     }\n205: \n206: \n207: # --------------------------------------------------------------------------\n208: # database bootstrap\n209: # --------------------------------------------------------------------------\n210: SEED_PRODUCTS = [\n211:     (\"Canvas Tote\", \"Heavy cotton tote bag, roomy enough for market runs.\", 1500, 30),\n212:     (\"Ceramic Mug\", \"Stoneware mug, 350 ml, dishwasher safe.\", 1250, 40),\n213:     (\"Desk Lamp\", \"Warm LED desk lamp with a dimmable arm.\", 3450, 15),\n214:     (\"Espresso Beans\", \"Dark roast arabica beans, 1 kg bag.\", 1899, 24),\n215:     (\"Notebook A5\", \"Dotted paper notebook with a soft cover.\", 899, 60),\n216:     (\"Olive Oil\", \"Cold pressed extra virgin olive oil, 500 ml.\", 2150, 26),\n217:     (\"Puzzle 1000\", \"Landscape jigsaw puzzle with 1000 pieces.\", 2199, 14),\n218:     (\"Tea Sampler\", \"Six loose leaf blends, 120 g in total.\", 1650, 22),\n219:     (\"Wireless Mouse\", \"Quiet click mouse with a USB-C receiver.\", 2599, 18),\n220:     (\"Wool Scarf\", \"Brushed wool scarf, 180 x 30 cm.\", 2999, 12),\n221: ]\n222: \n223: \n224: def init_db() -> None:\n225:     DATA_DIR.mkdir(parents=True, exist_ok=True)\n226:     with open(LOCK_PATH, \"w\") as lock:\n227:         fcntl.flock(lock.fileno(), fcntl.LOCK_EX)\n228:         conn = sqlite3.connect(DB_PATH, timeout=30)\n229:         try:\n230:             conn.row_factory = sqlite3.Row\n231:             conn.execute(\"PRAGMA busy_timeout=30000\")\n232:             conn.execute(\"PRAGMA foreign_keys=ON\")\n233:             conn.executescript(\n234:                 \"\"\"\n235:                 CREATE TABLE IF NOT EXISTS users (\n236:                     id INTEGER PRIMARY KEY AUTOINCREMENT,\n237:                     username TEXT NOT NULL UNIQUE,\n238:                     password_hash TEXT NOT NULL,\n239:                     is_admin INTEGER NOT NULL DEFAULT 0,\n240:                     created_at REAL NOT NULL\n241:                 );\n242:                 CREATE TABLE IF NOT EXISTS products (\n243:                     id INTEGER PRIMARY KEY AUTOINCREMENT,\n244:                     name TEXT NOT NULL,\n245:                     description TEXT NOT NULL DEFAULT '',\n246:                     price_cents INTEGER NOT NULL DEFAULT 0,\n247:                     stock INTEGER NOT NULL DEFAULT 0,\n248:                     is_active INTEGER NOT NULL DEFAULT 1,\n249:                     created_at REAL NOT NULL\n250:                 );\n251:                 CREATE TABLE IF NOT EXISTS cart_items (\n252:                     id INTEGER PRIMARY KEY AUTOINCREMENT,\n253:                     user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n254:                     product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n255:                     quantity INTEGER NOT NULL,\n256:                     created_at REAL NOT NULL,\n257:                     UNIQUE (user_id, product_id)\n258:                 );\n259:                 \"\"\"\n260:             )\n261:             count = conn.execute(\"SELECT COUNT(*) AS c FROM products\").fetchone()[\"c\"]\n262:             if count == 0:\n263:                 timestamp = now_ts()\n264:                 conn.executemany(\n265:                     \"INSERT INTO products (name, description, price_cents, stock, is_active, created_at)\"\n266:                     \" VALUES (?, ?, ?, ?, 1, ?)\",\n267:                     [(n, d, p, s, timestamp) for n, d, p, s in SEED_PRODUCTS],\n268:                 )\n269:             admin_password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n270:             if admin_password:\n271:                 conn.execute(\n272:                     \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n273:                     \" VALUES (?, ?, 1, ?)\"\n274:                     \" ON CONFLICT(username) DO UPDATE SET password_hash=excluded.password_hash,\"\n275:                     \" is_admin=1\",\n276:                     (ADMIN_USERNAME, generate_password_hash(admin_password), now_ts()),\n277:                 )\n278:             else:\n279:                 conn.execute(\n280:                     \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n281:                     \" VALUES (?, ?, 1, ?)\"\n282:                     \" ON CONFLICT(username) DO UPDATE SET is_admin=1\",\n283:                     (ADMIN_USERNAME, generate_password_hash(secrets.token_urlsafe(32)), now_ts()),\n284:                 )\n285:             conn.commit()\n286:         finally:\n287:             conn.close()\n288: \n289: \n290: # --------------------------------------------------------------------------\n291: # authentication\n292: # --------------------------------------------------------------------------\n293: def current_user() -> sqlite3.Row | None:\n294:     header = request.headers.get(\"Authorization\", \"\")\n295:     if not header:\n296:         return None\n297:     scheme, _, token = header.partition(\" \")\n298:     if scheme.lower() != \"bearer\" or not token.strip():\n299:         return None\n300:     user_id = read_token(token.strip())\n301:     if user_id is None:\n302:         return None\n303:     return db().execute(\"SELECT * FROM users WHERE id = ?\", (user_id,)).fetchone()\n304: \n305: \n306: def require_user() -> sqlite3.Row | None:\n307:     user = current_user()\n308:     if user is None:\n309:         api_error(401, \"Sign in to continue.\")\n310:         return None\n311:     return user\n312: \n313: \n314: def require_admin() -> sqlite3.Row | None:\n315:     user = require_user()\n316:     if user is None:\n317:         return None\n318:     if not user[\"is_admin\"]:\n319:         api_error(403, \"This action is restricted to the admin.\")\n320:         return None\n321:     return user\n322: \n323: \n324: def user_json(row: sqlite3.Row) -> dict:\n325:     return {\n326:         \"id\": row[\"id\"],\n327:         \"username\": row[\"username\"],\n328:         \"is_admin\": bool(row[\"is_admin\"]),\n329:     }\n330: \n331: \n332: # --------------------------------------------------------------------------\n333: # auth routes\n334: # --------------------------------------------------------------------------\n335: @app.post(\"/api/auth/register\")\n336: def register():\n337:     data = body()\n338:     username = data.get(\"username\")\n339:     password = data.get(\"password\")\n340:     if not isinstance(username, str) or not username.strip():\n341:         return api_error(400, \"A username is required.\")\n342:     username = username.strip()\n343:     if len(username) > 64:\n344:         return api_error(400, \"That username is too long.\")\n345:     if not isinstance(password, str) or not password:\n346:         return api_error(400, \"A password is required.\")\n347:     if username.lower() == ADMIN_USERNAME:\n348:         return api_error(409, \"That username is reserved for the admin.\")\n349:     try:\n350:         cursor = db().execute(\n351:             \"INSERT INTO users (username, password_hash, is_admin, created_at) VALUES (?, ?, 0, ?)\",\n352:             (username, generate_password_hash(password), now_ts()),\n353:         )\n354:         db().commit()\n355:     except sqlite3.IntegrityError:\n356:         return api_error(409, \"That username is already taken.\")\n357:     row = db().execute(\"SELECT * FROM users WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n358:     return jsonify({\"token\": make_token(row[\"id\"]), \"user\": user_json(row)}), 201\n359: \n360: \n361: @app.post(\"/api/auth/login\")\n362: def login():\n363:     data = body()\n364:     username = data.get(\"username\")\n365:     password = data.get(\"password\")\n366:     if not isinstance(username, str) or not isinstance(password, str):\n367:         return api_error(400, \"A username and password are required.\")\n368:     username = username.strip()\n369:     if username.lower() == ADMIN_USERNAME:\n370:         admin_password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n371:         if not admin_password:\n372:             return api_error(401, \"Admin sign-in is disabled.\")\n373:         if not hmac.compare_digest(admin_password, password):\n374:             return api_error(401, \"Incorrect username or password.\")\n375:         row = db().execute(\"SELECT * FROM users WHERE username = ?\", (ADMIN_USERNAME,)).fetchone()\n376:         if row is None:\n377:             cursor = db().execute(\n378:                 \"INSERT INTO users (username, password_hash, is_admin, created_at) VALUES (?, ?, 1, ?)\",\n379:                 (ADMIN_USERNAME, generate_password_hash(admin_password), now_ts()),\n380:             )\n381:             db().commit()\n382:             row = db().execute(\"SELECT * FROM users WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n383:         else:\n384:             db().execute(\"UPDATE users SET is_admin = 1 WHERE id = ?\", (row[\"id\"],))\n385:             db().commit()\n386:             row = db().execute(\"SELECT * FROM users WHERE id = ?\", (row[\"id\"],)).fetchone()\n387:         return jsonify({\"token\": make_token(row[\"id\"]), \"user\": user_json(row)}), 200\n388:     row = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n389:     if row is None or not check_password_hash(row[\"password_hash\"], password):\n390:         return api_error(401, \"Incorrect username or password.\")\n391:     return jsonify({\"token\": make_token(row[\"id\"]), \"user\": user_json(row)}), 200\n392: \n393: \n394: @app.get(\"/api/auth/me\")\n395: def me():\n396:     user = require_user()\n397:     if user is None:\n398:         return None\n399:     return jsonify({\"user\": user_json(user)}), 200\n400: \n401: \n402: # --------------------------------------------------------------------------\n403: # catalogue\n404: # --------------------------------------------------------------------------\n405: @app.get(\"/api/products\")\n406: def list_products():\n407:     search = (request.args.get(\"q\") or \"\").strip()\n408:     try:\n409:         page = int(request.args.get(\"page\") or 1)\n410:     except ValueError:\n411:         page = 1\n412:     try:\n413:         page_size = int(request.args.get(\"page_size\") or DEFAULT_PAGE_SIZE)\n414:     except ValueError:\n415:         page_size = DEFAULT_PAGE_SIZE\n416:     page = max(1, page)\n417:     page_size = max(1, min(MAX_PAGE_SIZE, page_size))\n418: \n419:     conn = db()\n420:     where = \"WHERE is_active = 1\"\n421:     params: list = []\n422:     if search:\n423:         where += \" AND (name LIKE ? OR description LIKE ?)\"\n424:         pattern = f\"%{search}%\"\n425:         params += [pattern, pattern]\n426:     total = conn.execute(f\"SELECT COUNT(*) AS c FROM products {where}\", params).fetchone()[\"c\"]\n427:     rows = conn.execute(\n428:         f\"SELECT * FROM products {where} ORDER BY name ASC, id ASC LIMIT ? OFFSET ?\",\n429:         [*params, page_size, (page - 1) * page_size],\n430:     ).fetchall()\n431:     return jsonify(\n432:         {\n433:             \"items\": [product_json(row) for row in rows],\n434:             \"total\": total,\n435:             \"page\": page,\n436:             \"page_size\": page_size,\n437:         }\n438:     ), 200\n439: \n440: \n441: @app.get(\"/api/products/<int:product_id>\")\n442: def get_product(product_id: int):\n443:     row = db().execute(\n444:         \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n445:     ).fetchone()\n446:     if row is None:\n447:         return api_error(404, \"Product not found.\")\n448:     return jsonify(product_json(row)), 200\n449: \n450: \n451: # --------------------------------------------------------------------------\n452: # cart\n453: # --------------------------------------------------------------------------\n454: def cart_rows(user_id: int) -> list[sqlite3.Row]:\n455:     return db().execute(\n456:         \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price_cents\"\n457:         \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n458:         \" WHERE ci.user_id = ? AND p.is_active = 1\"\n459:         \" ORDER BY ci.created_at ASC, ci.id ASC\",\n460:         (user_id,),\n461:     ).fetchall()\n462: \n463: \n464: def cart_payload(user_id: int) -> dict:\n465:     rows = cart_rows(user_id)\n466:     items = [cart_item_json(row) for row in rows]\n467:     subtotal_cents = sum(row[\"price_cents\"] * row[\"quantity\"] for row in rows)\n468:     return {\"items\": items, \"subtotal\": money(subtotal_cents)}\n469: \n470: \n471: @app.get(\"/api/cart\")\n472: def get_cart():\n473:     user = require_user()\n474:     if user is None:\n475:         return None\n476:     return jsonify(cart_payload(user[\"id\"])), 200\n477: \n478: \n479: @app.post(\"/api/cart\")\n480: def add_to_cart():\n481:     user = require_user()\n482:     if user is None:\n483:         return None\n484:     data = body()\n485:     product_id = data.get(\"product_id\", data.get(\"productId\", data.get(\"id\")))\n486:     if isinstance(product_id, str) and product_id.strip().lstrip(\"-\").isdigit():\n487:         product_id = int(product_id.strip())\n488:     if not isinstance(product_id, int) or isinstance(product_id, bool):\n489:         return api_error(400, \"A product id is required.\")\n490:     quantity = to_quantity(data.get(\"quantity\", 1))\n491:     if quantity is None:\n492:         return api_error(400, \"Quantity must be a positive whole number.\")\n493: \n494:     product = db().execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n495:     if product is None or not product[\"is_active\"]:\n496:         return api_error(404, \"That product is not available.\")\n497: \n498:     conn = db()\n499:     existing = conn.execute(\n500:         \"SELECT * FROM cart_items WHERE user_id = ? AND product_id = ?\",\n501:         (user[\"id\"], product_id),\n502:     ).fetchone()\n503:     if existing is None:\n504:         conn.execute(\n505:             \"INSERT INTO cart_items (user_id, product_id, quantity, created_at) VALUES (?, ?, ?, ?)\",\n506:             (user[\"id\"], product_id, quantity, now_ts()),\n507:         )\n508:     else:\n509:         conn.execute(\n510:             \"UPDATE cart_items SET quantity = quantity + ? WHERE id = ?\",\n511:             (quantity, existing[\"id\"]),\n512:         )\n513:     conn.commit()\n514:     payload = cart_payload(user[\"id\"])\n515:     item = next((entry for entry in payload[\"items\"] if entry[\"product_id\"] == product_id), None)\n516:     if item is not None:\n517:         payload[\"item\"] = item\n518:         payload.update(item)\n519:     return jsonify(payload), 200\n520: \n521: \n522: @app.patch(\"/api/cart/<int:item_id>\")\n523: def update_cart_item(item_id: int):\n524:     user = require_user()\n525:     if user is None:\n526:         return None\n527:     data = body()\n528:     quantity = to_quantity(data.get(\"quantity\"))\n529:     if quantity is None:\n530:         return api_error(400, \"Quantity must be a positive whole number.\")\n531:     conn = db()\n532:     row = conn.execute(\n533:         \"SELECT * FROM cart_items WHERE id = ? AND user_id = ?\", (item_id, user[\"id\"])\n534:     ).fetchone()\n535:     if row is None:\n536:         return api_error(404, \"Cart item not found.\")\n537:     conn.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n538:     conn.commit()\n539:     payload = cart_payload(user[\"id\"])\n540:     item = next((entry for entry in payload[\"items\"] if entry[\"id\"] == item_id), None)\n541:     if item is not None:\n542:         payload[\"item\"] = item\n543:         payload.update(item)\n544:     return jsonify(payload), 200\n545: \n546: \n547: @app.delete(\"/api/cart/<int:item_id>\")\n548: def delete_cart_item(item_id: int):\n549:     user = require_user()\n550:     if user is None:\n551:         return None\n552:     conn = db()\n553:     row = conn.execute(\n554:         \"SELECT * FROM cart_items WHERE id = ? AND user_id = ?\", (item_id, user[\"id\"])\n555:     ).fetchone()\n556:     if row is None:\n557:         return api_error(404, \"Cart item not found.\")\n558:     conn.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n559:     conn.commit()\n560:     return jsonify(cart_payload(user[\"id\"])), 200\n561: \n562: \n563: # --------------------------------------------------------------------------\n564: # admin\n565: # --------------------------------------------------------------------------\n566: @app.get(\"/api/admin/products\")\n567: def admin_list_products():\n568:     user = require_admin()\n569:     if user is None:\n570:         return None\n571:     rows = db().execute(\"SELECT * FROM products ORDER BY name ASC, id ASC\").fetchall()\n572:     return jsonify({\"items\": [product_json(row) for row in rows]}), 200\n573: \n574: \n575: @app.post(\"/api/admin/products\")\n576: def admin_create_product():\n577:     user = require_admin()\n578:     if user is None:\n579:         return None\n580:     data = body()\n581:     name = data.get(\"name\")\n582:     if not isinstance(name, str) or not name.strip():\n583:         return api_error(400, \"A product name is required.\")\n584:     name = name.strip()\n585:     description = data.get(\"description\")\n586:     if description is None:\n587:         description = \"\"\n588:     if not isinstance(description, str):\n589:         return api_error(400, \"The description must be text.\")\n590:     cents = to_cents(data.get(\"price\", 0))\n591:     if cents is None:\n592:         return api_error(400, \"The price must be a positive number.\")\n593:     stock = to_stock(data.get(\"stock\", 0))\n594:     if stock is None:\n595:         return api_error(400, \"The stock must be a whole number of zero or more.\")\n596:     is_active = to_flag(data.get(\"is_active\", True))\n597:     if is_active is None:\n598:         return api_error(400, \"The active flag must be a boolean.\")\n599: \n600:     conn = db()\n601:     cursor = conn.execute(\n602:         \"INSERT INTO products (name, description, price_cents, stock, is_active, created_at)\"\n603:         \" VALUES (?, ?, ?, ?, ?, ?)\",\n604:         (name, description.strip(), cents, stock, 1 if is_active else 0, now_ts()),\n605:     )\n606:     conn.commit()\n607:     row = conn.execute(\"SELECT * FROM products WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n608:     return jsonify(product_json(row)), 201\n609: \n610: \n611: @app.patch(\"/api/admin/products/<int:product_id>\")\n612: def admin_update_product(product_id: int):\n613:     user = require_admin()\n614:     if user is None:\n615:         return None\n616:     data = body()\n617:     conn = db()\n618:     row = conn.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n619:     if row is None:\n620:         return api_error(404, \"Product not found.\")\n621: \n622:     updates: list[str] = []\n623:     values: list = []\n624: \n625:     if \"name\" in data:\n626:         name = data.get(\"name\")\n627:         if not isinstance(name, str) or not name.strip():\n628:             return api_error(400, \"A product name is required.\")\n629:         updates.append(\"name = ?\")\n630:         values.append(name.strip())\n631: \n632:     if \"description\" in data:\n633:         description = data.get(\"description\")\n634:         if description is None:\n635:             description = \"\"\n636:         if not isinstance(description, str):\n637:             return api_error(400, \"The description must be text.\")\n638:         updates.append(\"description = ?\")\n639:         values.append(description.strip())\n640: \n641:     if \"price\" in data:\n642:         cents = to_cents(data.get(\"price\"))\n643:         if cents is None:\n644:             return api_error(400, \"The price must be a positive number.\")\n645:         updates.append(\"price_cents = ?\")\n646:         values.append(cents)\n647: \n648:     if \"stock\" in data:\n649:         stock = to_stock(data.get(\"stock\"))\n650:         if stock is None:\n651:             return api_error(400, \"The stock must be a whole number of zero or more.\")\n652:         updates.append(\"stock = ?\")\n653:         values.append(stock)\n654: \n655:     if \"is_active\" in data:\n656:         is_active = to_flag(data.get(\"is_active\"))\n657:         if is_active is None:\n658:             return api_error(400, \"The active flag must be a boolean.\")\n659:         updates.append(\"is_active = ?\")\n660:         values.append(1 if is_active else 0)\n661: \n662:     if updates:\n663:         values.append(product_id)\n664:         conn.execute(f\"UPDATE products SET {', '.join(updates)} WHERE id = ?\", values)\n665:         conn.commit()\n666:     row = conn.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n667:     return jsonify(product_json(row)), 200\n668: \n669: \n670: # --------------------------------------------------------------------------\n671: # frontend + health\n672: # --------------------------------------------------------------------------\n673: @app.get(\"/api/health\")\n674: def health():\n675:     return {\"status\": \"ok\"}\n676: \n677: \n678: @app.get(\"/\")\n679: @app.get(\"/<path:path>\")\n680: def frontend(path: str = \"index.html\"):\n681:     if path.startswith(\"api/\"):\n682:         return api_error(404, \"Unknown API endpoint.\")\n683:     candidate = (DIST / path).resolve()\n684:     if candidate.is_file() and str(candidate).startswith(str(DIST.resolve())):\n685:         return send_from_directory(DIST, path)\n686:     return send_from_directory(DIST, \"index.html\")\n687: \n688: \n689: init_db()\n690: \n691: if __name__ == \"__main__\":\n692:     app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")), debug=False)\n\n(End of file - total 692 lines)\n</content>","metadata":{"preview":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport fcntl\nimport hmac\nimport os\nimport secrets\nimport sqlite3\nimport time\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (ROOT / \"data\")).resolve()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"\"\"\"Flask entry point: JSON API under /api plus the built frontend.\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport fcntl\nimport hmac\nimport os\nimport secrets\nimport sqlite3\nimport time\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or (ROOT / \"data\")).resolve()\nDB_PATH = DATA_DIR / \"shop.db\"\nSECRET_PATH = DATA_DIR / \"secret.key\"\nLOCK_PATH = DATA_DIR / \"init.lock\"\n\nADMIN_USERNAME = \"admin\"\nTOKEN_TTL_SECONDS = 60 * 60 * 24 * 30\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 20\n\napp = Flask(__name__, static_folder=None)\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\ndef api_error(status: int, message: str):\n    response = jsonify({\"error\": message, \"message\": message})\n    response.status_code = status\n    return response\n\n\ndef now_ts() -> float:\n    return time.time()\n\n\ndef secret_key() -> bytes:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    if not SECRET_PATH.exists():\n        SECRET_PATH.write_text(secrets.token_hex(32))\n        os.chmod(SECRET_PATH, 0o600)\n    return bytes.fromhex(SECRET_PATH.read_text().strip())\n\n\ndef _b64(raw: bytes) -> str:\n    return base64.urlsafe_b64encode(raw).decode().rstrip(\"=\")\n\n\ndef _unb64(raw: str) -> bytes:\n    return base64.urlsafe_b64decode(raw + \"=\" * (-len(raw) % 4))\n\n\ndef make_token(user_id: int) -> str:\n    payload = f\"{user_id}.{int(now_ts() + TOKEN_TTL_SECONDS)}\"\n    signature = hmac.new(secret_key(), payload.encode(), \"sha256\").hexdigest()\n    return f\"{_b64(payload.encode())}.{signature}\"\n\n\ndef read_token(token: str) -> int | None:\n    if not token or \".\" not in token:\n        return None\n    encoded, _, signature = token.partition(\".\")\n    try:\n        payload = _unb64(encoded).decode()\n    except Exception:\n        return None\n    expected = hmac.new(secret_key(), payload.encode(), \"sha256\").hexdigest()\n    if not hmac.compare_digest(expected, signature):\n        return None\n    try:\n        user_id, expires = payload.split(\".\", 1)\n        if int(expires) < now_ts():\n            return None\n        return int(user_id)\n    except (TypeError, ValueError):\n        return None\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        DATA_DIR.mkdir(parents=True, exist_ok=True)\n        conn = sqlite3.connect(DB_PATH, timeout=15)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA busy_timeout=10000\")\n        conn.execute(\"PRAGMA foreign_keys=ON\")\n        g.db = conn\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef body() -> dict:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else {}\n\n\ndef to_price(value) -> Decimal | None:\n    \"\"\"Convert a JSON price into an exact decimal; None when not a usable number.\"\"\"\n    if isinstance(value, bool) or value is None:\n        return None\n    if isinstance(value, str):\n        value = value.strip()\n        if not value:\n            return None\n    if not isinstance(value, (int, float, Decimal)):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite() or amount < 0:\n        return None\n    return amount\n\n\ndef money(amount: Decimal) -> float:\n    \"\"\"Render an exact decimal amount as a JSON friendly float.\"\"\"\n    return float(amount)\n\n\ndef to_quantity(value) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    if isinstance(value, str):\n        value = value.strip()\n        if not value:\n            return None\n    if isinstance(value, float):\n        if not value.is_integer():\n            return None\n        value = int(value)\n    if not isinstance(value, int):\n        return None\n    if value < 1:\n        return None\n    return value\n\n\ndef to_stock(value) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    if isinstance(value, str):\n        value = value.strip()\n        if not value:\n            return None\n    if isinstance(value, float):\n        if not value.is_integer():\n            return None\n        value = int(value)\n    if not isinstance(value, int) or value < 0:\n        return None\n    return value\n\n\ndef to_flag(value) -> bool | None:\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, str):\n        lowered = value.strip().lower()\n        if lowered in (\"true\", \"1\", \"yes\", \"on\"):\n            return True\n        if lowered in (\"false\", \"0\", \"no\", \"off\"):\n            return False\n    if isinstance(value, int) and value in (0, 1):\n        return bool(value)\n    return None\n\n\ndef product_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"description\": row[\"description\"],\n        \"price\": money(row[\"price_cents\"]),\n        \"stock\": row[\"stock\"],\n        \"is_active\": bool(row[\"is_active\"]),\n    }\n\n\ndef cart_item_json(row: sqlite3.Row) -> dict:\n    unit = row[\"price_cents\"]\n    quantity = row[\"quantity\"]\n    return {\n        \"id\": row[\"id\"],\n        \"product_id\": row[\"product_id\"],\n        \"quantity\": quantity,\n        \"name\": row[\"name\"],\n        \"unit_price\": money(unit),\n        \"line_total\": money(unit * quantity),\n    }\n\n\n# --------------------------------------------------------------------------\n# database bootstrap\n# --------------------------------------------------------------------------\nSEED_PRODUCTS = [\n    (\"Canvas Tote\", \"Heavy cotton tote bag, roomy enough for market runs.\", 1500, 30),\n    (\"Ceramic Mug\", \"Stoneware mug, 350 ml, dishwasher safe.\", 1250, 40),\n    (\"Desk Lamp\", \"Warm LED desk lamp with a dimmable arm.\", 3450, 15),\n    (\"Espresso Beans\", \"Dark roast arabica beans, 1 kg bag.\", 1899, 24),\n    (\"Notebook A5\", \"Dotted paper notebook with a soft cover.\", 899, 60),\n    (\"Olive Oil\", \"Cold pressed extra virgin olive oil, 500 ml.\", 2150, 26),\n    (\"Puzzle 1000\", \"Landscape jigsaw puzzle with 1000 pieces.\", 2199, 14),\n    (\"Tea Sampler\", \"Six loose leaf blends, 120 g in total.\", 1650, 22),\n    (\"Wireless Mouse\", \"Quiet click mouse with a USB-C receiver.\", 2599, 18),\n    (\"Wool Scarf\", \"Brushed wool scarf, 180 x 30 cm.\", 2999, 12),\n]\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    with open(LOCK_PATH, \"w\") as lock:\n        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)\n        conn = sqlite3.connect(DB_PATH, timeout=30)\n        try:\n            conn.row_factory = sqlite3.Row\n            conn.execute(\"PRAGMA busy_timeout=30000\")\n            conn.execute(\"PRAGMA foreign_keys=ON\")\n            conn.executescript(\n                \"\"\"\n                CREATE TABLE IF NOT EXISTS users (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    username TEXT NOT NULL UNIQUE,\n                    password_hash TEXT NOT NULL,\n                    is_admin INTEGER NOT NULL DEFAULT 0,\n                    created_at REAL NOT NULL\n                );\n                CREATE TABLE IF NOT EXISTS products (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    name TEXT NOT NULL,\n                    description TEXT NOT NULL DEFAULT '',\n                    price_cents INTEGER NOT NULL DEFAULT 0,\n                    stock INTEGER NOT NULL DEFAULT 0,\n                    is_active INTEGER NOT NULL DEFAULT 1,\n                    created_at REAL NOT NULL\n                );\n                CREATE TABLE IF NOT EXISTS cart_items (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                    product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n                    quantity INTEGER NOT NULL,\n                    created_at REAL NOT NULL,\n                    UNIQUE (user_id, product_id)\n                );\n                \"\"\"\n            )\n            count = conn.execute(\"SELECT COUNT(*) AS c FROM products\").fetchone()[\"c\"]\n            if count == 0:\n                timestamp = now_ts()\n                conn.executemany(\n                    \"INSERT INTO products (name, description, price_cents, stock, is_active, created_at)\"\n                    \" VALUES (?, ?, ?, ?, 1, ?)\",\n                    [(n, d, p, s, timestamp) for n, d, p, s in SEED_PRODUCTS],\n                )\n            admin_password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n            if admin_password:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n                    \" VALUES (?, ?, 1, ?)\"\n                    \" ON CONFLICT(username) DO UPDATE SET password_hash=excluded.password_hash,\"\n                    \" is_admin=1\",\n                    (ADMIN_USERNAME, generate_password_hash(admin_password), now_ts()),\n                )\n            else:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, is_admin, created_at)\"\n                    \" VALUES (?, ?, 1, ?)\"\n                    \" ON CONFLICT(username) DO UPDATE SET is_admin=1\",\n                    (ADMIN_USERNAME, generate_password_hash(secrets.token_urlsafe(32)), now_ts()),\n                )\n            conn.commit()\n        finally:\n            conn.close()\n\n\n# --------------------------------------------------------------------------\n# authentication\n# --------------------------------------------------------------------------\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header:\n        return None\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    user_id = read_token(token.strip())\n    if user_id is None:\n        return None\n    return db().execute(\"SELECT * FROM users WHERE id = ?\", (user_id,)).fetchone()\n\n\ndef require_user() -> sqlite3.Row | None:\n    user = current_user()\n    if user is None:\n        api_error(401, \"Sign in to continue.\")\n        return None\n    return user\n\n\ndef require_admin() -> sqlite3.Row | None:\n    user = require_user()\n    if user is None:\n        return None\n    if not user[\"is_admin\"]:\n        api_error(403, \"This action is restricted to the admin.\")\n        return None\n    return user\n\n\ndef user_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"username\": row[\"username\"],\n        \"is_admin\": bool(row[\"is_admin\"]),\n    }\n\n\n# --------------------------------------------------------------------------\n# auth routes\n# --------------------------------------------------------------------------\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not username.strip():\n        return api_error(400, \"A username is required.\")\n    username = username.strip()\n    if len(username) > 64:\n        return api_error(400, \"That username is too long.\")\n    if not isinstance(password, str) or not password:\n        return api_error(400, \"A password is required.\")\n    if username.lower() == ADMIN_USERNAME:\n        return api_error(409, \"That username is reserved for the admin.\")\n    try:\n        cursor = db().execute(\n            \"INSERT INTO users (username, password_hash, is_admin, created_at) VALUES (?, ?, 0, ?)\",\n            (username, generate_password_hash(password), now_ts()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return api_error(409, \"That username is already taken.\")\n    row = db().execute(\"SELECT * FROM users WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify({\"token\": make_token(row[\"id\"]), \"user\": user_json(row)}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return api_error(400, \"A username and password are required.\")\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        admin_password = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n        if not admin_password:\n            return api_error(401, \"Admin sign-in is disabled.\")\n        if not hmac.compare_digest(admin_password, password):\n            return api_error(401, \"Incorrect username or password.\")\n        row = db().execute(\"SELECT * FROM users WHERE username = ?\", (ADMIN_USERNAME,)).fetchone()\n        if row is None:\n            cursor = db().execute(\n                \"INSERT INTO users (username, password_hash, is_admin, created_at) VALUES (?, ?, 1, ?)\",\n                (ADMIN_USERNAME, generate_password_hash(admin_password), now_ts()),\n            )\n            db().commit()\n            row = db().execute(\"SELECT * FROM users WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n        else:\n            db().execute(\"UPDATE users SET is_admin = 1 WHERE id = ?\", (row[\"id\"],))\n            db().commit()\n            row = db().execute(\"SELECT * FROM users WHERE id = ?\", (row[\"id\"],)).fetchone()\n        return jsonify({\"token\": make_token(row[\"id\"]), \"user\": user_json(row)}), 200\n    row = db().execute(\"SELECT * FROM users WHERE username = ?\", (username,)).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return api_error(401, \"Incorrect username or password.\")\n    return jsonify({\"token\": make_token(row[\"id\"]), \"user\": user_json(row)}), 200\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = require_user()\n    if user is None:\n        return None\n    return jsonify({\"user\": user_json(user)}), 200\n\n\n# --------------------------------------------------------------------------\n# catalogue\n# --------------------------------------------------------------------------\n@app.get(\"/api/products\")\ndef list_products():\n    search = (request.args.get(\"q\") or \"\").strip()\n    try:\n        page = int(request.args.get(\"page\") or 1)\n    except ValueError:\n        page = 1\n    try:\n        page_size = int(request.args.get(\"page_size\") or DEFAULT_PAGE_SIZE)\n    except ValueError:\n        page_size = DEFAULT_PAGE_SIZE\n    page = max(1, page)\n    page_size = max(1, min(MAX_PAGE_SIZE, page_size))\n\n    conn = db()\n    where = \"WHERE is_active = 1\"\n    params: list = []\n    if search:\n        where += \" AND (name LIKE ? OR description LIKE ?)\"\n        pattern = f\"%{search}%\"\n        params += [pattern, pattern]\n    total = conn.execute(f\"SELECT COUNT(*) AS c FROM products {where}\", params).fetchone()[\"c\"]\n    rows = conn.execute(\n        f\"SELECT * FROM products {where} ORDER BY name ASC, id ASC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [product_json(row) for row in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    ), 200\n\n\n@app.get(\"/api/products/<int:product_id>\")\ndef get_product(product_id: int):\n    row = db().execute(\n        \"SELECT * FROM products WHERE id = ? AND is_active = 1\", (product_id,)\n    ).fetchone()\n    if row is None:\n        return api_error(404, \"Product not found.\")\n    return jsonify(product_json(row)), 200\n\n\n# --------------------------------------------------------------------------\n# cart\n# --------------------------------------------------------------------------\ndef cart_rows(user_id: int) -> list[sqlite3.Row]:\n    return db().execute(\n        \"SELECT ci.id, ci.product_id, ci.quantity, p.name, p.price_cents\"\n        \" FROM cart_items ci JOIN products p ON p.id = ci.product_id\"\n        \" WHERE ci.user_id = ? AND p.is_active = 1\"\n        \" ORDER BY ci.created_at ASC, ci.id ASC\",\n        (user_id,),\n    ).fetchall()\n\n\ndef cart_payload(user_id: int) -> dict:\n    rows = cart_rows(user_id)\n    items = [cart_item_json(row) for row in rows]\n    subtotal_cents = sum(row[\"price_cents\"] * row[\"quantity\"] for row in rows)\n    return {\"items\": items, \"subtotal\": money(subtotal_cents)}\n\n\n@app.get(\"/api/cart\")\ndef get_cart():\n    user = require_user()\n    if user is None:\n        return None\n    return jsonify(cart_payload(user[\"id\"])), 200\n\n\n@app.post(\"/api/cart\")\ndef add_to_cart():\n    user = require_user()\n    if user is None:\n        return None\n    data = body()\n    product_id = data.get(\"product_id\", data.get(\"productId\", data.get(\"id\")))\n    if isinstance(product_id, str) and product_id.strip().lstrip(\"-\").isdigit():\n        product_id = int(product_id.strip())\n    if not isinstance(product_id, int) or isinstance(product_id, bool):\n        return api_error(400, \"A product id is required.\")\n    quantity = to_quantity(data.get(\"quantity\", 1))\n    if quantity is None:\n        return api_error(400, \"Quantity must be a positive whole number.\")\n\n    product = db().execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    if product is None or not product[\"is_active\"]:\n        return api_error(404, \"That product is not available.\")\n\n    conn = db()\n    existing = conn.execute(\n        \"SELECT * FROM cart_items WHERE user_id = ? AND product_id = ?\",\n        (user[\"id\"], product_id),\n    ).fetchone()\n    if existing is None:\n        conn.execute(\n            \"INSERT INTO cart_items (user_id, product_id, quantity, created_at) VALUES (?, ?, ?, ?)\",\n            (user[\"id\"], product_id, quantity, now_ts()),\n        )\n    else:\n        conn.execute(\n            \"UPDATE cart_items SET quantity = quantity + ? WHERE id = ?\",\n            (quantity, existing[\"id\"]),\n        )\n    conn.commit()\n    payload = cart_payload(user[\"id\"])\n    item = next((entry for entry in payload[\"items\"] if entry[\"product_id\"] == product_id), None)\n    if item is not None:\n        payload[\"item\"] = item\n        payload.update(item)\n    return jsonify(payload), 200\n\n\n@app.patch(\"/api/cart/<int:item_id>\")\ndef update_cart_item(item_id: int):\n    user = require_user()\n    if user is None:\n        return None\n    data = body()\n    quantity = to_quantity(data.get(\"quantity\"))\n    if quantity is None:\n        return api_error(400, \"Quantity must be a positive whole number.\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT * FROM cart_items WHERE id = ? AND user_id = ?\", (item_id, user[\"id\"])\n    ).fetchone()\n    if row is None:\n        return api_error(404, \"Cart item not found.\")\n    conn.execute(\"UPDATE cart_items SET quantity = ? WHERE id = ?\", (quantity, item_id))\n    conn.commit()\n    payload = cart_payload(user[\"id\"])\n    item = next((entry for entry in payload[\"items\"] if entry[\"id\"] == item_id), None)\n    if item is not None:\n        payload[\"item\"] = item\n        payload.update(item)\n    return jsonify(payload), 200\n\n\n@app.delete(\"/api/cart/<int:item_id>\")\ndef delete_cart_item(item_id: int):\n    user = require_user()\n    if user is None:\n        return None\n    conn = db()\n    row = conn.execute(\n        \"SELECT * FROM cart_items WHERE id = ? AND user_id = ?\", (item_id, user[\"id\"])\n    ).fetchone()\n    if row is None:\n        return api_error(404, \"Cart item not found.\")\n    conn.execute(\"DELETE FROM cart_items WHERE id = ?\", (item_id,))\n    conn.commit()\n    return jsonify(cart_payload(user[\"id\"])), 200\n\n\n# --------------------------------------------------------------------------\n# admin\n# --------------------------------------------------------------------------\n@app.get(\"/api/admin/products\")\ndef admin_list_products():\n    user = require_admin()\n    if user is None:\n        return None\n    rows = db().execute(\"SELECT * FROM products ORDER BY name ASC, id ASC\").fetchall()\n    return jsonify({\"items\": [product_json(row) for row in rows]}), 200\n\n\n@app.post(\"/api/admin/products\")\ndef admin_create_product():\n    user = require_admin()\n    if user is None:\n        return None\n    data = body()\n    name = data.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return api_error(400, \"A product name is required.\")\n    name = name.strip()\n    description = data.get(\"description\")\n    if description is None:\n        description = \"\"\n    if not isinstance(description, str):\n        return api_error(400, \"The description must be text.\")\n    cents = to_cents(data.get(\"price\", 0))\n    if cents is None:\n        return api_error(400, \"The price must be a positive number.\")\n    stock = to_stock(data.get(\"stock\", 0))\n    if stock is None:\n        return api_error(400, \"The stock must be a whole number of zero or more.\")\n    is_active = to_flag(data.get(\"is_active\", True))\n    if is_active is None:\n        return api_error(400, \"The active flag must be a boolean.\")\n\n    conn = db()\n    cursor = conn.execute(\n        \"INSERT INTO products (name, description, price_cents, stock, is_active, created_at)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (name, description.strip(), cents, stock, 1 if is_active else 0, now_ts()),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM products WHERE id = ?\", (cursor.lastrowid,)).fetchone()\n    return jsonify(product_json(row)), 201\n\n\n@app.patch(\"/api/admin/products/<int:product_id>\")\ndef admin_update_product(product_id: int):\n    user = require_admin()\n    if user is None:\n        return None\n    data = body()\n    conn = db()\n    row = conn.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    if row is None:\n        return api_error(404, \"Product not found.\")\n\n    updates: list[str] = []\n    values: list = []\n\n    if \"name\" in data:\n        name = data.get(\"name\")\n        if not isinstance(name, str) or not name.strip():\n            return api_error(400, \"A product name is required.\")\n        updates.append(\"name = ?\")\n        values.append(name.strip())\n\n    if \"description\" in data:\n        description = data.get(\"description\")\n        if description is None:\n            description = \"\"\n        if not isinstance(description, str):\n            return api_error(400, \"The description must be text.\")\n        updates.append(\"description = ?\")\n        values.append(description.strip())\n\n    if \"price\" in data:\n        cents = to_cents(data.get(\"price\"))\n        if cents is None:\n            return api_error(400, \"The price must be a positive number.\")\n        updates.append(\"price_cents = ?\")\n        values.append(cents)\n\n    if \"stock\" in data:\n        stock = to_stock(data.get(\"stock\"))\n        if stock is None:\n            return api_error(400, \"The stock must be a whole number of zero or more.\")\n        updates.append(\"stock = ?\")\n        values.append(stock)\n\n    if \"is_active\" in data:\n        is_active = to_flag(data.get(\"is_active\"))\n        if is_active is None:\n            return api_error(400, \"The active flag must be a boolean.\")\n        updates.append(\"is_active = ?\")\n        values.append(1 if is_active else 0)\n\n    if updates:\n        values.append(product_id)\n        conn.execute(f\"UPDATE products SET {', '.join(updates)} WHERE id = ?\", values)\n        conn.commit()\n    row = conn.execute(\"SELECT * FROM products WHERE id = ?\", (product_id,)).fetchone()\n    return jsonify(product_json(row)), 200\n\n\n# --------------------------------------------------------------------------\n# frontend + health\n# --------------------------------------------------------------------------\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path.startswith(\"api/\"):\n        return api_error(404, \"Unknown API endpoint.\")\n    candidate = (DIST / path).resolve()\n    if candidate.is_file() and str(candidate).startswith(str(DIST.resolve())):\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")), debug=False)","lineStart":1,"lineEnd":692,"totalLines":692,"truncated":false}},"title":"backend/app.py","time":{"start":1794380681005,"end":1794380681018}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c96c4f28001yKXwgI2IIJoA9I","sessionID":"ses_e36a1605fffeQa463ZF52q8gD3","messageID":"msg_1c96c4630001v6qIMzOxpF0l3T"}}
