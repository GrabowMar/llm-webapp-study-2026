': 'bob'}\nbob post reading 403 {'error': 'only the owner may post readings to this sensor'}\nbob delete 403 {'error': 'only the owner may delete this sensor'}\nalice delete 204 None\nreadings after delete 404 {'error': 'sensor not found'}\n404 sensor 404 {'error': 'sensor not found'}\napi unknown 404 {'error': 'not found'}\n","metadata":{"output":"health 200 {'status': 'ok'}\nregister 201 {'id': 1, 'token': 'ICb5x-Mc6GdCEdlsG-FjVKvsPRoD27bYbb69vZT71ro', 'username': 'alice'}\nlogin 200 {'token': 'L52yEpOBURmcIN51e8Q642bkvjX6oaPzccqHSh1XCsY', 'user': {'id': 1, 'username': 'alice'}}\nlogin-bad 401 {'error': 'invalid username or password'}\nreg-dup 409 {'error': 'username already taken'}\nnoauth-post-sensor 401 {'error': 'authentication required'}\ncreate sensor 201 {'id': 1, 'last_updated': None, 'last_value': None, 'location': 'Kitchen', 'name': 'Temp A', 'owner': 'alice', 'unit': 'C'}\nlist sensors 200 {'items': [{'id': 1, 'last_updated': None, 'last_value': None, 'location': 'Kitchen', 'name': 'Temp A', 'owner': 'alice', 'unit': 'C'}]}\nget sensor 200 {'id': 1, 'last_updated': None, 'last_value': None, 'location': 'Kitchen', 'name': 'Temp A', 'owner': 'alice', 'unit': 'C'}\npost reading 201 {'id': 1, 'recorded_at': '2026-11-11T04:55:46.128Z', 'sensor_id': 1, 'value': 21.5}\npost reading2 201 {'id': 2, 'recorded_at': '2026-11-11T04:55:46.130Z', 'sensor_id': 1, 'value': 23.0}\nget sensor after 200 {'id': 1, 'last_updated': '2026-11-11T04:55:46.130Z', 'last_value': 23.0, 'location': 'Kitchen', 'name': 'Temp A', 'owner': 'alice', 'unit': 'C'}\nreadings 200 {'items': [{'id': 2, 'recorded_at': '2026-11-11T04:55:46.130Z', 'sensor_id': 1, 'value': 23.0}, {'id': 1, 'recorded_at': '2026-11-11T04:55:46.128Z', 'sensor_id': 1, 'value': 21.5}], 'total': 2}\nreadings limit 200 {'items': [{'id': 2, 'recorded_at': '2026-11-11T04:55:46.130Z', 'sensor_id': 1, 'value': 23.0}], 'total': 2}\nreadings bad limit 400 {'error': 'limit must be an integer'}\nregister bob 201 {'id': 2, 'token': 'ljmjisoxbrj9JpMujbJ88vmikLsQRJrLt_f9NpTTquw', 'username': 'bob'}\nbob post reading 403 {'error': 'only the owner may post readings to this sensor'}\nbob delete 403 {'error': 'only the owner may delete this sensor'}\nalice delete 204 None\nreadings after delete 404 {'error': 'sensor not found'}\n404 sensor 404 {'error': 'sensor not found'}\napi unknown 404 {'error': 'not found'}\n","exit":0,"truncated":false},"title":"cd /workspace && python3 test_api_tmp.py","time":{"start":1794372945577,"end":1794372946290}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8f646a20012I6zzDyk4SMWlt","sessionID":"ses_e370b5ae4ffe9rbeud9vtYO6Dm","messageID":"msg_1c8f63ed7001O3n06LsCNzDFCF"}}
