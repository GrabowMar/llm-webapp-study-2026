or null value: None\nPASS sensor null updated: None\nPASS list sensors: 200\nPASS list wrapper: ['items']\nPASS get sensor: 200\nPASS get sensor id: 1\nPASS post reading 10: 201\nPASS reading keys 10: ['id', 'recorded_at', 'sensor_id', 'value']\nPASS post reading 12.5: 201\nPASS reading keys 12.5: ['id', 'recorded_at', 'sensor_id', 'value']\nPASS post reading 15: 201\nPASS reading keys 15: ['id', 'recorded_at', 'sensor_id', 'value']\nPASS readings status: 200\nPASS readings total: 3\nPASS readings order: [15, 12.5, 10]\nPASS readings newest first ts: True\nPASS limited count: 2\nPASS limited total: 3\nPASS sensor last value: 15\nPASS sensor last updated set: True\nPASS reading without token: 401\nPASS other user reading: 403\nPASS other user delete: 403\nPASS bad token delete: 401\nPASS unknown sensor: 404\nPASS delete sensor: 204\nPASS deleted sensor gone: 404\nPASS deleted readings gone: 404\nPASS health: {'status': 'ok'}\n\nFAILURES: 0\n","exit":0,"truncated":false},"title":"cd /workspace && python3 test_live_tmp.py","time":{"start":1794373173368,"end":1794373173976}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8f9c070001V2NUhn3X7dy2cd","sessionID":"ses_e370b5ae4ffe9rbeud9vtYO6Dm","messageID":"msg_1c8f9b740001Nkky3hFWSOKKsM"}}
