+import type { ReactNode } from "react";
+import { BrowserRouter, Navigate, Route, Routes } from "react-router-dom";
+
+import { AuthProvider, useAuth } from "./auth";
+import { Spinner } from "./components/ui";
+import CustomerDetailPage from "./pages/CustomerDetailPage";
+import CustomerFormPage from "./pages/CustomerFormPage";
+import CustomersPage from "./pages/CustomersPage";
+import SignInPage from "./pages/SignInPage";
+
+function Protected({ children }: { children: ReactNode }) {
+  const { username, ready } = useAuth();
+  if (!ready) {
+    return (
+      <div className="grid min-h-screen place-items-center bg-slate-50">
+        <Spinner label="Starting the directory" />
+      </div>
+    );
+  }
+  if (!username) return <Navigate to="/signin" replace />;
+  return <>{children}</>;
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  return (
+    <AuthProvider>
+      <BrowserRouter>
+        <Routes>
+          <Route path="/signin" element={<SignInPage />} />
+          <Route path="/" element={<Navigate to="/customers" replace />} />
+          <Route
+            path="/customers"
+            element={
+              <Protected>
+                <CustomersPage />
+              </Protected>
+            }
+          />
+          <Route
+            path="/customers/new"
+            element={
+              <Protected>
+                <CustomerFormPage mode="create" />
+              </Protected>
+            }
+          />
+          <Route
+            path="/customers/:id"
+            element={
+              <Protected>
+                <CustomerDetailPage />
+              </Protected>
+            }
+          />
+          <Route
+            path="/customers/:id/edit"
+            element={
+              <Protected>
+                <CustomerFormPage mode="edit" />
+              </Protected>
+            }
+          />
+          <Route path="*" element={<Navigate to="/customers" replace />} />
+        </Routes>
+      </BrowserRouter>
+    </AuthProvider>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..b76d699
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,210 @@
+export interface Customer {
+  id: number;
+  name: string;
+  email: string | null;
+  phone: string | null;
+  company: string | null;
+  notes: string | null;
+  created_at: string;
+  interaction_count: number;
+  last_contacted_at: string | null;
+}
+
+export interface Interaction {
+  id: number;
+  customer_id: number;
+  kind: string;
+  summary: string;
+  occurred_at: string;
+  logged_by: string;
+}
+
+export interface CustomerList {
+  items: Customer[];
+  total: number;
+  page: number;
+  page_size: number;
+}
+
+export interface CustomerInput {
+  name: string;
+  email: string;
+  phone: string;
+  company: string;
+  notes: string;
+}
+
+export interface InteractionInput {
+  kind: string;
+  summary: string;
+  occurred_at?: string;
+}
+
+export interface Session {
+  token: string;
+  username?: string;
+}
+
+const TOKEN_KEY = "customer-directory.token";
+const USERNAME_KEY = "customer-directory.username";
+
+export class ApiError extends Error {
+  status: number;
+  fields: Record<string, string>;
+
+  constructor(status: number, message: string, fields: Record<string, string> = {}) {
+    super(message);
+    this.name = "ApiError";
+    this.status = status;
+    this.fields = fields;
+  }
+}
+
+export function getToken(): string | null {
+  return window.localStorage.getItem(TOKEN_KEY);
+}
+
+export function getStoredUsername(): string | null {
+  return window.localStorage.getItem(USERNAME_KEY);
+}
+
+export function storeSession(token: string, username: string) {
+  window.localStorage.setItem(TOKEN_KEY, token);
+  window.localStorage.setItem(USERNAME_KEY, username);
+}
+
+export function storeUsername(username: string) {
+  window.localStorage.setItem(USERNAME_KEY, username);
+}
+
+export function clearSession() {
+  window.localStorage.removeItem(TOKEN_KEY);
+  window.localStorage.removeItem(USERNAME_KEY);
+}
+
+function extractFields(payload: unknown): Record<string, string> {
+  const fields: Record<string, string> = {};
+  if (!payload || typeof payload !== "object") return fields;
+  const record = payload as Record<string, unknown>;
+  const sources = [record.fields, record.errors];
+  for (const source of sources) {
+    if (source && typeof source === "object" && !Array.isArray(source)) {
+      for (const [key, value] of Object.entries(source as Record<string, unknown>)) {
+        fields[key] = String(value);
+      }
+    }
+  }
+  if (Array.isArray(record.details)) {
+    for (const item of record.details) {
+      if (item && typeof item === "object") {
+        const entry = item as { field?: string; message?: string };
+        if (entry.field) fields[entry.field] = String(entry.message ?? "");
+      }
+    }
+  }
+  return fields;
+}
+
+async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const headers = new Headers(init.headers);
+  const token = getToken();
+  if (token) headers.set("Authorization", `Bearer ${token}`);
+  if (init.body != null && !headers.has("Content-Type")) {
+    headers.set("Content-Type", "application/json");
+  }
+  const response = await fetch(path, { ...init, headers });
+  const text = await response.text();
+  let payload: unknown = null;
+  if (text) {
+    try {
+      payload = JSON.parse(text);
+    } catch {
+      payload = text;
+    }
+  }
+  if (!response.ok) {
+    const record = (payload ?? {}) as Record<string, unknown>;
+    const message =
+      typeof record.error === "string"
+        ? record.error
+        : typeof record.message === "string"
+          ? record.message
+          : `The request failed (${response.status}).`;
+    throw new ApiError(response.status, message, extractFields(payload));
+  }
+  return payload as T;
+}
+
+function jsonBody(value: unknown): string {
+  return JSON.stringify(value);
+}
+
+export const api = {
+  register(username: string, password: string) {
+    return request<Session>("/api/auth/register", {
+      method: "POST",
+      body: jsonBody({ username, password }),
+    });
+  },
+
+  login(username: string, password: string) {
+    return request<Session>("/api/auth/login", {
+      method: "POST",
+      body: jsonBody({ username, password }),
+    });
+  },
+
+  me() {
+    return request<{ id: number; username: string }>("/api/auth/me");
+  },
+
+  logout() {
+    return request<{ status: string }>("/api/auth/logout", { method: "POST" });
+  },
+
+  listCustomers(params: Record<string, string | number>) {
+    const search = new URLSearchParams();
+    for (const [key, value] of Object.entries(params)) {
+      if (value !== "" && value !== undefined && value !== null) search.set(key, String(value));
+    }
+    const query = search.toString();
+    return request<CustomerList>(`/api/customers${query ? `?${query}` : ""}`);
+  },
+
+  listCompanies() {
+    return request<{ items: string[] }>("/api/companies");
+  },
+
+  getCustomer(id: number) {
+    return request<Customer>(`/api/customers/${id}`);
+  },
+
+  createCustomer(payload: CustomerInput) {
+    return request<Customer>("/api/customers", {
+      method: "POST",
+      body: jsonBody(payload),
+    });
+  },
+
+  updateCustomer(id: number, payload: CustomerInput) {
+    return request<Customer>(`/api/customers/${id}`, {
+      method: "PUT",
+      body: jsonBody(payload),
+    });
+  },
+
+  deleteCustomer(id: number) {
+    return request<{ status: string }>(`/api/customers/${id}`, { method: "DELETE" });
+  },
+
+  listInteractions(id: number) {
+    return request<{ items: Interaction[] }>(`/api/customers/${id}/interactions`);
+  },
+
+  createInteraction(id: number, payload: InteractionInput) {
+    return request<Interaction>(`/api/customers/${id}/interactions`, {
+      method: "POST",
+      body: jsonBody(payload),
+    });
+  },
+};
diff --git a/frontend/src/auth.tsx b/frontend/src/auth.tsx
new file mode 100644
index 0000000..e2a2ab0
--- /dev/null
+++ b/frontend/src/auth.tsx
@@ -0,0 +1,89 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type ReactNode,
+} from "react";
+
+import { api, clearSession, getStoredUsername, getToken, storeSession, storeUsername } from "./api";
+
+interface AuthContextValue {
+  username: string | null;
+  ready: boolean;
+  signIn: (username: string, password: string) => Promise<void>;
+  signUp: (username: string, password: string) => Promise<void>;
+  signOut: () => Promise<void>;
+}
+
+const AuthContext = createContext<AuthContextValue | null>(null);
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [username, setUsername] = useState<string | null>(getStoredUsername());
+  const [ready, setReady] = useState(false);
+
+  useEffect(() => {
+    let cancelled = false;
+    const token = getToken();
+    if (!token) {
+      setUsername(null);
+      setReady(true);
+      return;
+    }
+    api
+      .me()
+      .then((user) => {
+        if (cancelled) return;
+        storeUsername(user.username);
+        setUsername(user.username);
+      })
+      .catch(() => {
+        if (cancelled) return;
+        clearSession();
+        setUsername(null);
+      })
+      .finally(() => {
+        if (!cancelled) setReady(true);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const signIn = useCallback(async (name: string, password: string) => {
+    const session = await api.login(name, password);
+    storeSession(session.token, name);
+    setUsername(name);
+  }, []);
+
+  const signUp = useCallback(async (name: string, password: string) => {
+    const session = await api.register(name, password);
+    storeSession(session.token, session.username ?? name);
+    setUsername(session.username ?? name);
+  }, []);
+
+  const signOut = useCallback(async () => {
+    try {
+      await api.logout();
+    } catch {
+      // The session is dropped locally even if the call fails.
+    }
+    clearSession();
+    setUsername(null);
+  }, []);
+
+  const value = useMemo(
+    () => ({ username, ready, signIn, signUp, signOut }),
+    [username, ready, signIn, signUp, signOut],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthContextValue {
+  const context = useContext(AuthContext);
+  if (!context) throw new Error("useAuth must be used inside AuthProvider");
+  return context;
+}
