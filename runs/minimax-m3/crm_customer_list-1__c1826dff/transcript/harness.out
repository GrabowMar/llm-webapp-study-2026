{"type":"tool_use","timestamp":1794344562520,"sessionID":"ses_e38be2834ffeyfE9hooqtrOekt","part":{"type":"tool","tool":"write","callID":"call_01a1c7452522713d88995c56","state":{"status":"completed","input":{"content":"\"\"\"Accounts, password hashing and bearer token sessions.\"\"\"\n\nimport secrets\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\n\nfrom flask import g, request\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom db import get_db, utcnow\nfrom errors import api_error\n\nSESSION_TTL_DAYS = 30\n\n\ndef hash_password(password: str) -> str:\n    return generate_password_hash(password)\n\n\ndef verify_password(password_hash: str, password: str) -> bool:\n    try:\n        return check_password_hash(password_hash, password)\n    except ValueError:\n        return False\n\n\ndef create_session(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    expires_at = (\n        (datetime.now(timezone.utc) + timedelta(days=SESSION_TTL_DAYS))\n        .strftime(\"%Y-%m-%dT%H:%M:%S.%f\")\n        + \"Z\"\n    )\n    get_db().execute(\n        \"INSERT INTO sessions (token, user_id, created_at, expires_at) VALUES (?, ?, ?, ?)\",\n        (token, user_id, utcnow(), expires_at),\n    )\n    return token\n\n\ndef delete_session(token: str) -> None:\n    get_db().execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n\n\ndef bearer_token() -> str:\n    header = request.headers.get(\"Authorization\", \"\").strip()\n    if not header:\n        return \"\"\n    parts = header.split()\n    if len(parts) == 2 and parts[0].lower() == \"bearer\":\n        return parts[1]\n    if len(parts) == 1:\n        return parts[0]\n    return \"\"\n\n\ndef current_user():\n    if \"current_user\" in g:\n        return g.current_user\n    user = None\n    token = bearer_token()\n    if token:\n        row = get_db().execute(\n            \"SELECT u.id AS id, u.username AS username FROM sessions s \"\n            \"JOIN users u ON u.id = s.user_id \"\n            \"WHERE s.token = ? AND s.expires_at > ?\",\n            (token, utcnow()),\n        ).fetchone()\n        if row is not None:\n            user = row\n    g.current_user = user\n    return user\n\n\ndef login_required(view):\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        if current_user() is None:\n            return api_error(401, \"Authentication required. Sign in to continue.\")\n        return view(*args, **kwargs)\n\n    return wrapper\n","filePath":"/workspace/backend/auth.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/auth.py","exists":false,"truncated":false},"title":"backend/auth.py","time":{"start":1794344562488,"end":1794344562499}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7452f32001eDPzh0FCsiV5cR","sessionID":"ses_e38be2834ffeyfE9hooqtrOekt","messageID":"msg_1c74520100012SSHtXW8C4Gf99"}}
