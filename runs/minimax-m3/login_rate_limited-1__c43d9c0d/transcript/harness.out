ogin_at = ?\"\n413:         \" WHERE id = ?\",\n414:         (now, account[\"id\"]),\n415:     )\n416:     record_attempt(account[\"id\"], now, True)\n417:     db.commit()\n418:     return jsonify({\"token\": token})\n419: \n420: \n421: @app.get(\"/api/me\")\n422: def me():\n423:     account = require_account()\n424:     return jsonify(\n425:         {\n426:             \"id\": account[\"id\"],\n427:             \"username\": account[\"username\"],\n428:             \"last_login_at\": iso(account[\"last_login_at\"]),\n429:         }\n\n(Showing lines 330-429 of 531. Use offset=430 to continue.)\n</content>","metadata":{"preview":"        return error(409, \"username_taken\", \"That username is already taken.\")\n    now = time.time()\n    cursor = db.execute(\n        \"INSERT INTO accounts (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), now),\n    )\n    db.commit()\n    return (\n        jsonify({\"id\": cursor.lastrowid, \"username\": username}),\n        201,\n    )\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(400, \"invalid_request\", \"A JSON body is required.\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"        return error(409, \"username_taken\", \"That username is already taken.\")\n    now = time.time()\n    cursor = db.execute(\n        \"INSERT INTO accounts (username, password_hash, created_at) VALUES (?, ?, ?)\",\n        (username, generate_password_hash(password), now),\n    )\n    db.commit()\n    return (\n        jsonify({\"id\": cursor.lastrowid, \"username\": username}),\n        201,\n    )\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(400, \"invalid_request\", \"A JSON body is required.\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"invalid_request\", \"username and password are required.\")\n    username = username.strip()\n    if not username:\n        return error(400, \"invalid_request\", \"username and password are required.\")\n\n    now = time.time()\n    db = get_db()\n\n    retry_after = rate_limit_retry_after(client_identifier(), now)\n    if retry_after is not None:\n        return too_many(\n            retry_after,\n            \"rate_limited\",\n            f\"Too many sign-in attempts. Try again in {retry_after} seconds.\",\n        )\n\n    account = db.execute(\"SELECT * FROM accounts WHERE username = ?\", (username,)).fetchone()\n    if account is None or not account[\"login_enabled\"]:\n        return error(401, \"invalid_credentials\", \"Invalid username or password.\")\n\n    locked_until = account[\"locked_until\"]\n    if locked_until is not None and locked_until > now:\n        seconds = max(1, math.ceil(locked_until - now))\n        return too_many(\n            seconds,\n            \"locked\",\n            f\"This username is locked. Try again in {seconds} seconds.\",\n            locked_until=iso(locked_until),\n        )\n    if locked_until is not None:\n        db.execute(\n            \"UPDATE accounts SET locked_until = NULL, failed_count = 0 WHERE id = ?\",\n            (account[\"id\"],),\n        )\n        db.commit()\n        account = db.execute(\n            \"SELECT * FROM accounts WHERE id = ?\", (account[\"id\"],)\n        ).fetchone()\n\n    if not check_password_hash(account[\"password_hash\"], password):\n        failed_count = int(account[\"failed_count\"]) + 1\n        if failed_count >= LOCK_THRESHOLD:\n            db.execute(\n                \"UPDATE accounts SET failed_count = ?, locked_until = ? WHERE id = ?\",\n                (failed_count, now + LOCK_SECONDS, account[\"id\"]),\n            )\n        else:\n            db.execute(\n                \"UPDATE accounts SET failed_count = ? WHERE id = ?\",\n                (failed_count, account[\"id\"]),\n            )\n        record_attempt(account[\"id\"], now, False)\n        db.commit()\n        return error(401, \"invalid_credentials\", \"Invalid username or password.\")\n\n    token = secrets.token_urlsafe(32)\n    db.execute(\n        \"INSERT INTO sessions (token, account_id, created_at) VALUES (?, ?, ?)\",\n        (token, account[\"id\"], now),\n    )\n    db.execute(\n        \"UPDATE accounts SET failed_count = 0, locked_until = NULL, last_login_at = ?\"\n        \" WHERE id = ?\",\n        (now, account[\"id\"]),\n    )\n    record_attempt(account[\"id\"], now, True)\n    db.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/me\")\ndef me():\n    account = require_account()\n    return jsonify(\n        {\n            \"id\": account[\"id\"],\n            \"username\": account[\"username\"],\n            \"last_login_at\": iso(account[\"last_login_at\"]),\n        }","lineStart":330,"lineEnd":429,"totalLines":531,"truncated":true}},"title":"backend/app.py","time":{"start":1794339908064,"end":1794339908076}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c6fe29db001IWp3iM2Kh5vGOr","sessionID":"ses_e390f5f67ffeyzZwSqPLXNKUwZ","messageID":"msg_1c6fe21560012a2ezlN53EFfF1"}}
