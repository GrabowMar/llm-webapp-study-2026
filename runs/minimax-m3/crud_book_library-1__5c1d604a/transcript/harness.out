{"type":"tool_use","timestamp":1794305578288,"sessionID":"ses_e3b11b142ffehyUsg0hi8c2GGs","part":{"type":"tool","tool":"write","callID":"call_8EVPrwlUTCK7CWgm4fJfO6Aq","state":{"status":"completed","input":{"content":"export interface Book {\n  id: number;\n  title: string;\n  author: string;\n  year: number | null;\n  isbn: string | null;\n  created_at: string;\n  review_count: number;\n  average_rating: number | null;\n}\n\nexport interface Review {\n  id: number;\n  book_id: number;\n  rating: number;\n  comment: string;\n  created_at: string;\n  username: string;\n}\n\nexport interface BookListResponse {\n  items: Book[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface ReviewListResponse {\n  items: Review[];\n}\n\nexport interface User {\n  id: number;\n  username: string;\n}\n\nexport interface BookInput {\n  title: string;\n  author: string;\n  year: number | null;\n  isbn: string | null;\n}\n\nexport interface ReviewInput {\n  rating: number;\n  comment: string;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n    this.errors = errors;\n    Object.setPrototypeOf(this, ApiError.prototype);\n  }\n}\n\nconst TOKEN_KEY = \"booklib.token\";\n\nexport function getToken(): string | null {\n  try {\n    return window.localStorage.getItem(TOKEN_KEY);\n  } catch {\n    return null;\n  }\n}\n\nexport function setToken(token: string | null): void {\n  try {\n    if (token) {\n      window.localStorage.setItem(TOKEN_KEY, token);\n    } else {\n      window.localStorage.removeItem(TOKEN_KEY);\n    }\n  } catch {\n    /* storage unavailable */\n  }\n}\n\ninterface RequestOptions {\n  method?: string;\n  body?: unknown;\n  auth?: boolean;\n}\n\nasync function request<T>(path: string, options: RequestOptions = {}): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  if (options.auth !== false) {\n    const token = getToken();\n    if (token) {\n      headers[\"Authorization\"] = `Bearer ${token}`;\n    }\n  }\n\n  let response: Response;\n  try {\n    response = await fetch(path, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body === undefined ? undefined : JSON.stringify(options.body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server. Please try again.\");\n  }\n\n  if (response.status === 204) {\n    return undefined as T;\n  }\n\n  const raw = await response.text();\n  let payload: unknown = null;\n  if (raw) {\n    try {\n      payload = JSON.parse(raw);\n    } catch {\n      payload = null;\n    }\n  }\n\n  if (!response.ok) {\n    const data = (payload ?? {}) as { error?: string; errors?: Record<string, string> };\n    const message = data.error ?? `Request failed with status ${response.status}.`;\n    throw new ApiError(response.status, message, data.errors ?? {});\n  }\n\n  return payload as T;\n}\n\nexport const api = {\n  register(username: string, password: string) {\n    return request<{ id: number; username: string; token: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    });\n  },\n  login(username: string, password: string) {\n    return request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    });\n  },\n  me() {\n    return request<User>(\"/api/auth/me\");\n  },\n  listBooks(params: { q?: string; page?: number; pageSize?: number }) {\n    const query = new URLSearchParams();\n    if (params.q) query.set(\"q\", params.q);\n    if (params.page && params.page > 0) query.set(\"page\", String(params.page));\n    if (params.pageSize && params.pageSize > 0) query.set(\"page_size\", String(params.pageSize));\n    const suffix = query.toString();\n    return request<BookListResponse>(`/api/books${suffix ? `?${suffix}` : \"\"}`);\n  },\n  getBook(id: number) {\n    return request<Book>(`/api/books/${id}`);\n  },\n  createBook(input: BookInput) {\n    return request<Book>(\"/api/books\", { method: \"POST\", body: input });\n  },\n  updateBook(id: number, input: BookInput) {\n    return request<Book>(`/api/books/${id}`, { method: \"PUT\", body: input });\n  },\n  deleteBook(id: number) {\n    return request<void>(`/api/books/${id}`, { method: \"DELETE\" });\n  },\n  listReviews(bookId: number) {\n    return request<ReviewListResponse>(`/api/books/${bookId}/reviews`);\n  },\n  createReview(bookId: number, input: ReviewInput) {\n    return request<Review>(`/api/books/${bookId}/reviews`, { method: \"POST\", body: input });\n  },\n};\n\nexport function errorMessage(error: unknown): string {\n  if (error instanceof ApiError) return error.message;\n  if (error instanceof Error) return error.message;\n  return \"Something went wrong.\";\n}\n\nexport function formatDate(value: string): string {\n  const parsed = new Date(value);\n  if (Number.isNaN(parsed.getTime())) return value;\n  return parsed.toLocaleDateString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n  });\n}\n\nexport function formatDateTime(value: string): string {\n  const parsed = new Date(value);\n  if (Number.isNaN(parsed.getTime())) return value;\n  return parsed.toLocaleString(undefined, {\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n  });\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794305578262,"end":1794305578269}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4f2550e001amUzgWUOHwEN99","sessionID":"ses_e3b11b142ffehyUsg0hi8c2GGs","messageID":"msg_1c4f23714001lzx89qyCne6pWt"}}
