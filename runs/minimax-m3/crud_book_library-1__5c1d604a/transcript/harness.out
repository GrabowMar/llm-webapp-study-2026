rt) % 4))\n        signature = base64.urlsafe_b64decode(signature_part + \"=\" * (-len(signature_part) % 4))\n    except Exception:\n        return None\n    expected = hmac.new(SECRET, body, hashlib.sha256).digest()\n    if not hmac.compare_digest(signature, expected):\n        return None    try:\n        data = json.loads(body.decode(\"utf-8\"))\n    except Exception:\n        return None\n    if not isinstance(data, dict) or \"uid\" not in data:","truncated":true,"loaded":[],"display":{"type":"file","path":"/workspace/backend/app.py","text":"    body = base64.urlsafe_b64encode(payload).rstrip(b\"=\")\n    return f\"{body.decode('ascii')}.{base64.urlsafe_b64encode(signature).rstrip(b'=').decode('ascii')}\"\n\n\ndef read_token(token: str) -> dict[str, Any] | None:\n    if not token or \".\" not in token:\n        return None\n    body_part, _, signature_part = token.partition(\".\")\n    try:\n        body = base64.urlsafe_b64decode(body_part + \"=\" * (-len(body_part) % 4))\n        signature = base64.urlsafe_b64decode(signature_part + \"=\" * (-len(signature_part) % 4))\n    except Exception:\n        return None\n    expected = hmac.new(SECRET, body, hashlib.sha256).digest()\n    if not hmac.compare_digest(signature, expected):\n        return None    try:\n        data = json.loads(body.decode(\"utf-8\"))\n    except Exception:\n        return None\n    if not isinstance(data, dict) or \"uid\" not in data:\n        return None\n    if float(data.get(\"exp\", 0)) < time.time():\n        return None\n    return data\n","lineStart":140,"lineEnd":164,"totalLines":562,"truncated":true}},"title":"backend/app.py","time":{"start":1794305521411,"end":1794305521422}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4f176fc001usjlPeJW769q7q","sessionID":"ses_e3b11b142ffehyUsg0hi8c2GGs","messageID":"msg_1c4f16f7d001dr26FuzlTh3Rve"}}
