{"type":"tool_use","timestamp":1794352285521,"sessionID":"ses_e3847c4f2ffeRaGpXufKYD9yDm","part":{"type":"tool","tool":"write","callID":"call_01a1c7baf5dc7430886e0ee1","state":{"status":"completed","input":{"content":"\"\"\"SQLite storage helpers for accounts and events.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport secrets\nimport sqlite3\nfrom pathlib import Path\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or \"./data\").resolve()\nDB_PATH = DATA_DIR / \"events.db\"\nSECRET_PATH = DATA_DIR / \"secret.key\"\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL COLLATE NOCASE UNIQUE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS events (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    description TEXT,\n    location TEXT,\n    start_time TEXT NOT NULL,\n    end_time TEXT NOT NULL,\n    created_at TEXT NOT NULL,\n    created_by TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_events_start_time ON events (start_time);\n\"\"\"\n\n\ndef ensure_data_dir() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n\n\ndef connect() -> sqlite3.Connection:\n    \"\"\"Open a connection to the SQLite database.\"\"\"\n    ensure_data_dir()\n    conn = sqlite3.connect(DB_PATH, timeout=30.0, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA journal_mode=WAL\")\n    conn.execute(\"PRAGMA busy_timeout=30000\")\n    return conn\n\n\ndef init_db() -> None:\n    \"\"\"Create the tables if they do not exist yet.\"\"\"\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n    finally:\n        conn.close()\n\n\ndef get_secret() -> bytes:\n    \"\"\"Return the persistent signing secret used for bearer tokens.\"\"\"\n    ensure_data_dir()\n    try:\n        fd = os.open(SECRET_PATH, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)\n    except FileExistsError:\n        pass\n    else:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as handle:\n            handle.write(secrets.token_hex(32))\n    return SECRET_PATH.read_text(encoding=\"utf-8\").strip().encode(\"utf-8\")\n","filePath":"/workspace/backend/db.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/db.py","exists":false,"truncated":false},"title":"backend/db.py","time":{"start":1794352285465,"end":1794352285490}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7bb070f0012TYCj9jF9nfqac","sessionID":"ses_e3847c4f2ffeRaGpXufKYD9yDm","messageID":"msg_1c7baf0b0001nr5y5Is3R7SSIS"}}
{"type":"tool_use","timestamp":1794352285521,"sessionID":"ses_e3847c4f2ffeRaGpXufKYD9yDm","part":{"type":"tool","tool":"write","callID":"call_01a1c7bafc60777d92ffa2cd","state":{"status":"completed","input":{"content":"\"\"\"Password hashing and bearer-token helpers (standard library only).\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport hashlib\nimport hmac\nimport json\nimport time\n\nPBKDF2_ITERATIONS = 120_000\nTOKEN_TTL_SECONDS = 30 * 24 * 60 * 60\n\n\ndef hash_password(password: str) -> str:\n    \"\"\"Hash a password with PBKDF2-HMAC-SHA256 and a random salt.\"\"\"\n    salt = os.urandom(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, PBKDF2_ITERATIONS)\n    return f\"pbkdf2_sha256${PBKDF2_ITERATIONS}${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    \"\"\"Check a password against a stored hash.\"\"\"\n    if not isinstance(password, str) or not isinstance(stored, str):\n        return False\n    try:\n        algorithm, iterations, salt_hex, digest_hex = stored.split(\"$\")\n    except ValueError:\n        return False\n    if algorithm != \"pbkdf2_sha256\":\n        return False\n    try:\n        digest = hashlib.pbkdf2_hmac(\n            \"sha256\", password.encode(\"utf-8\"), bytes.fromhex(salt_hex), int(iterations)\n        )\n    except (ValueError, TypeError):\n        return False\n    return hmac.compare_digest(digest.hex(), digest_hex)\n\n\ndef _b64encode(raw: bytes) -> str:\n    return base64.urlsafe_b64encode(raw).decode(\"ascii\").rstrip(\"=\")\n\n\ndef _b64decode(text: str) -> bytes:\n    return base64.urlsafe_b64decode(text + \"=\" * (-len(text) % 4))\n\n\ndef issue_token(username: str, secret: bytes) -> str:\n    \"\"\"Create a signed bearer token for the given username.\"\"\"\n    now = int(time.time())\n    payload = {\"u\": username, \"iat\": now, \"exp\": now + TOKEN_TTL_SECONDS}\n    body = _b64encode(json.dumps(payload, separators=(\",\", \":\"), sort_keys=True).encode(\"utf-8\"))\n    signature = hmac.new(secret, body.encode(\"ascii\"), hashlib.sha256).digest()\n    return f\"{body}.{_b64encode(signature)}\"\n\n\ndef read_token(token: str, secret: bytes) -> str | None:\n    \"\"\"Validate a bearer token and return the username it was issued for.\"\"\"\n    if not token or \".\" not in token:\n        return None\n    body, _, signature = token.partition(\".\")\n    expected = hmac.new(secret, body.encode(\"ascii\"), hashlib.sha256).digest()\n    try:\n        given = _b64decode(signature)\n    except (ValueError, TypeError):\n        return None\n    if not hmac.compare_digest(expected, given):\n        return None\n    try:\n        payload = json.loads(_b64decode(body))\n    except (ValueError, TypeError):\n        return None\n    if not isinstance(payload, dict):\n        return None\n    username = payload.get(\"u\")\n    expires_at = payload.get(\"exp\")\n    if not isinstance(username, str) or not isinstance(expires_at, int):\n        return None\n    if expires_at < int(time.time()):\n        return None\n    return username\n\n\nimport os  # noqa: E402  (kept at the end to avoid shadowing the helper names above)\n","filePath":"/workspace/backend/auth.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/auth.py","exists":false,"truncated":false},"title":"backend/auth.py","time":{"start":1794352285477,"end":1794352285499}},"id":"prt_1c7bb071e0011XXh3059iUR8VD","sessionID":"ses_e3847c4f2ffeRaGpXufKYD9yDm","messageID":"msg_1c7baf0b0001nr5y5Is3R7SSIS"}}
