{"type":"tool_use","timestamp":1794352587451,"sessionID":"ses_e3847c4f2ffeRaGpXufKYD9yDm","part":{"type":"tool","tool":"write","callID":"call_01a1c7bf98c3724a999241bd","state":{"status":"completed","input":{"content":"/**\n * Renders the production bundle in jsdom against the local API to catch\n * runtime errors in the React app.\n */\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { JSDOM } from \"jsdom\";\n\nconst distDir = path.resolve(\"../frontend/dist\");\nconst html = fs.readFileSync(path.join(distDir, \"index.html\"), \"utf-8\");\nconst asset = fs\n  .readdirSync(path.join(distDir, \"assets\"))\n  .find((name) => name.endsWith(\".js\"));\n\nconst dom = new JSDOM(html, {\n  url: \"http://localhost:8000/\",\n  pretendToBeVisual: true,\n});\n\nglobal.window = dom.window;\nglobal.document = dom.window.document;\nglobal.navigator = dom.window.navigator;\nglobal.HTMLElement = dom.window.HTMLElement;\nglobal.Element = dom.window.Element;\nglobal.Node = dom.window.Node;\nglobal.Event = dom.window.Event;\nglobal.MouseEvent = dom.window.MouseEvent;\nglobal.KeyboardEvent = dom.window.KeyboardEvent;\nglobal.getComputedStyle = dom.window.getComputedStyle;\nglobal.requestAnimationFrame = dom.window.requestAnimationFrame.bind(dom.window);\nglobal.cancelAnimationFrame = dom.window.cancelAnimationFrame.bind(dom.window);\nglobal.MessageChannel = dom.window.MessageChannel;\nglobal.localStorage = dom.window.localStorage;\nglobal.fetch = (input, init) => {\n  const url = new URL(typeof input === \"string\" ? input : input.url, \"http://localhost:8000\");\n  return fetch(`http://127.0.0.1:8000${url.pathname}${url.search}`, init);\n};\n\nconst errors = [];\ndom.window.addEventListener(\"error\", (event) => errors.push(String(event.error || event.message)));\nconst originalError = console.error;\nconsole.error = (...args) => {\n  errors.push(args.map(String).join(\" \"));\n  originalError(...args);\n};\n\nawait import(path.join(distDir, \"assets\", asset));\n\nawait new Promise((resolve) => setTimeout(resolve, 1500));\n\nconst text = dom.window.document.body.textContent.replace(/\\s+/g, \" \").trim();\nconsole.log(\"--- rendered text ---\");\nconsole.log(text.slice(0, 2000));\nconsole.log(\"--- errors ---\");\nconsole.log(errors.length ? errors.join(\"\\n\") : \"none\");\n\nconst checks = {\n  title: text.includes(\"Event Calendar\"),\n  auth: text.includes(\"Sign in\"),\n  register: text.includes(\"Register\"),\n  monthTab: text.includes(\"Month\") && text.includes(\"Week\") && text.includes(\"Day\"),\n  today: text.includes(\"Today\"),\n  monthGrid: dom.window.document.querySelectorAll('[aria-label^=\"Show \"]').length === 42,\n};\nconsole.log(\"--- checks ---\");\nconsole.log(checks);\nprocess.exit(errors.length || Object.values(checks).some((value) => !value) ? 1 : 0);\n","filePath":"/workspace/tmpjsdom/render.mjs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/tmpjsdom/render.mjs","exists":false,"truncated":false},"title":"tmpjsdom/render.mjs","time":{"start":1794352587426,"end":1794352587433}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7bfa29d001NC8YepwdUyvqWT","sessionID":"ses_e3847c4f2ffeRaGpXufKYD9yDm","messageID":"msg_1c7bf860d001b4bFuEzZwAwJSr"}}
