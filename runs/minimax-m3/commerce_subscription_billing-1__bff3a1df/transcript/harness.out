 {\n        \"@vitejs/plugin-react\": \"6.2.1\",\n        \"vite\": \"8.3.5\"\n      }\n    },\n    \"node_modules/@oxc-project/types\": {\n      \"version\": \"0.156.0\",\n      \"resolved\": \"https://registry.npmjs.org/@oxc-project/types/-/types-0.156.0.tgz\",\n      \"integrity\": \"sha512-1Duyg48TdJNdyhEB8Xn1L36bT9Pv6GUtlKjHxOys8xkaF/rQq3XJE+bAurSK/AgIz5mGFsb77cn9Pb20+WCScw==\",\n      \"dev\": true,\n      \"license\": \"MIT\",\n      \"funding\": {\n        \"url\": \"https://github.com/sponsors/oxc-project\"\n      }\n    },\n    \"node_modules/@rolldown/binding-android-arm-eabi\": {\n      \"version\": \"1.2.16\",\n      \"resolved\": \"https://registry.npmjs.org/@rolldown/binding-android-arm-eabi/-/binding-android-arm-eabi-1.2.16.tgz\",\n      \"integrity\": \"sha512-ia3DwAs0OsMGS7+IConptSiyk9pEXkOx/AbJ2n/lAGxH3QkWQus1t8d7gnAT38FCU2sQu8lUbeR6AiZFv4JxaA==\",\n      \"cpu\": [\n        \"arm\"\n      ],\n      \"dev\": true,\n      \"license\": \"MIT\",\n      \"optional\": true,\n      \"os\": [\n        \"android\"\n      ],\n      \"engines\": {\n...\n888\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && head -40 package-lock.json && echo \"...\" && grep -c '' package-lock.json","time":{"start":1794324968106,"end":1794324968128}},"id":"prt_1c61a32a5001HEY2xZ2m6KwyXH","sessionID":"ses_e39e70e5effeCYI8DTCFFfI5ZZ","messageID":"msg_1c61968f4001zik17q7JoqJHM0"}}
