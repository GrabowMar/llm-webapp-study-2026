ensure_sync(self.view_functions[rule.endpoint])(**view_args)  # type: ignore[no-any-return]\n           ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~^^^^^^^^^^^^^\n  File \"/workspace/backend/app.py\", line 282, in wrapper\n    return fn(*args, **kwargs)\n  File \"/workspace/backend/app.py\", line 445, in list_subscriptions\n    if normalised:\n       ^^^^^^^^^^\nUnboundLocalError: cannot access local variable 'normalised' where it is not associated with a value\nPASS  health\nPASS  public stats shape\nPASS  public stats empty mrr\nPASS  list requires auth\nPASS  create requires auth\nPASS  bad token 401\nPASS  register 201\nPASS  duplicate register 409\nPASS  register missing username 400\nPASS  register missing password 400\nPASS  login 200\nPASS  login token\nPASS  bad login 401\nPASS  register bob\nPASS  create sub 201\nPASS  sub shape\nPASS  sub amount\nPASS  sub status default active\nPASS  sub failed count\nPASS  sub renewal date\nPASS  other member reads\nPASS  other member patches\nPASS  create Globex\nPASS  create Initech\nPASS  create Umbrella\nTraceback (most recent call last):\n  File \"/workspace/.tmp_test_api.py\", line 132, in <module>\n    check(\"list shape\", set(data.keys()) == {\"items\", \"total\", \"page\", \"page_size\"}, data.keys())\n                            ^^^^^^^^^\nAttributeError: 'NoneType' object has no attribute 'keys'\n","exit":0,"truncated":false},"title":"cd /workspace && python3 .tmp_test_api.py 2>&1 | tail -40","time":{"start":1794325050330,"end":1794325050922}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61b73d4001mSOm1GEiYZHyhN","sessionID":"ses_e39e70e5effeCYI8DTCFFfI5ZZ","messageID":"msg_1c61b6b62001zEg0J0mHHvejCJ"}}
