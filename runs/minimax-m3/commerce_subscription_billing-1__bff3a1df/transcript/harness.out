Authorization\", \"\")\n+    header = request.headers.get(\"Authorization\", \"\").strip()\n+    if not header:\n+        return None\n     if header.lower().startswith(\"bearer \"):\n-        token = header[7:].strip()\n-        return token or None\n-    return None\n+        return header[7:].strip() or None\n+    return header\n \n \n def require_auth(fn: Callable[..., Any]) -> Callable[..., Any]:\n     @wraps(fn)\n","additions":5,"deletions":4},"truncated":false},"title":"backend/app.py","time":{"start":1794325310095,"end":1794325310108}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c61f6a8a001oNB3IpAO6mmuAs","sessionID":"ses_e39e70e5effeCYI8DTCFFfI5ZZ","messageID":"msg_1c61ecdb8001UYP8z3VKhDwxvV"}}
