+import { useEffect, useState } from "react";
+import { Link } from "react-router-dom";
+import { apiPublicStats } from "../api";
+import StatusBadge from "../components/StatusBadge";
+import { formatMoney } from "../format";
+import { STATUS_LABELS, STATUS_ORDER } from "../types";
+import type { PublicStats } from "../types";
+
+export default function PublicStatsPage() {
+  const [stats, setStats] = useState<PublicStats | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    apiPublicStats()
+      .then((data) => {
+        if (!cancelled) setStats(data);
+      })
+      .catch((err: Error) => {
+        if (!cancelled) setError(err.message);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const counts = stats?.counts ?? {};
+  const total = STATUS_ORDER.reduce((sum, status) => sum + (counts[status] ?? 0), 0);
+
+  return (
+    <div className="space-y-8">
+      <section className="rounded-2xl bg-gradient-to-br from-indigo-600 via-indigo-600 to-violet-700 px-6 py-10 text-white shadow-lg shadow-indigo-600/20 sm:px-10">
+        <p className="text-sm font-medium uppercase tracking-widest text-indigo-100">Public summary</p>
+        <h1 className="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
+          Monthly recurring revenue
+        </h1>
+        <p className="mt-6 text-5xl font-semibold tracking-tight sm:text-6xl">
+          {stats ? formatMoney(stats.mrr) : "—"}
+        </p>
+        <p className="mt-3 max-w-xl text-sm text-indigo-100">
+          The sum of the monthly amounts of all active and past-due subscriptions. Trial and
+          cancelled subscriptions are not counted.
+        </p>
+      </section>
+
+      {error ? (
+        <p className="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
+          {error}
+        </p>
+      ) : null}
+
+      <section>
+        <div className="flex items-baseline justify-between">
+          <h2 className="text-lg font-semibold tracking-tight">Subscriptions per status</h2>
+          <span className="text-sm text-slate-500">{total} total</span>
+        </div>
+        <div className="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+          {STATUS_ORDER.map((status) => (
+            <div
+              key={status}
+              className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"
+            >
+              <StatusBadge status={status} />
+              <p className="mt-4 text-3xl font-semibold tracking-tight">
+                {stats ? counts[status] ?? 0 : "—"}
+              </p>
+              <p className="mt-1 text-sm text-slate-500">
+                {STATUS_LABELS[status]} subscriptions
+              </p>
+            </div>
+          ))}
+        </div>
+      </section>
+
+      <section className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+        <h2 className="text-lg font-semibold tracking-tight">Team access</h2>
+        <p className="mt-2 text-sm text-slate-600">
+          Customer details, invoices and payment runs are private. Sign in with a team account to
+          manage subscriptions.
+        </p>
+        <Link
+          to="/login"
+          className="mt-4 inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700"
+        >
+          Sign in to the console
+        </Link>
+      </section>
+    </div>
+  );
+}
diff --git a/frontend/src/pages/SubscriptionDetailPage.tsx b/frontend/src/pages/SubscriptionDetailPage.tsx
new file mode 100644
index 0000000..89e45d9
--- /dev/null
+++ b/frontend/src/pages/SubscriptionDetailPage.tsx
@@ -0,0 +1,389 @@
+import { useCallback, useEffect, useState } from "react";
+import type { FormEvent } from "react";
+import { Link, useParams } from "react-router-dom";
+import { apiCreateInvoice, apiInvoices, apiRecordCollection, apiSubscription, apiUpdateSubscription } from "../api";
+import StatusBadge from "../components/StatusBadge";
+import { formatDate, formatDateTime, formatMoney } from "../format";
+import { STATUS_LABELS, STATUS_ORDER } from "../types";
+import type { Invoice, Subscription, SubscriptionStatus } from "../types";
+
+export default function SubscriptionDetailPage() {
+  const { id } = useParams();
+  const subscriptionId = Number(id);
+
+  const [subscription, setSubscription] = useState<Subscription | null>(null);
+  const [invoices, setInvoices] = useState<Invoice[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+
+  const [customerName, setCustomerName] = useState("");
+  const [plan, setPlan] = useState("");
+  const [amount, setAmount] = useState("");
+  const [renewalDate, setRenewalDate] = useState("");
+  const [status, setStatus] = useState<SubscriptionStatus>("active");
+  const [saving, setSaving] = useState(false);
+
+  const [invoiceAmount, setInvoiceAmount] = useState("");
+  const [invoiceDueDate, setInvoiceDueDate] = useState("");
+  const [issuing, setIssuing] = useState(false);
+
+  const [collectionBusy, setCollectionBusy] = useState(false);
+
+  const applySubscription = useCallback((value: Subscription) => {
+    setSubscription(value);
+    setCustomerName(value.customer_name);
+    setPlan(value.plan);
+    setAmount(String(value.monthly_amount));
+    setRenewalDate(value.renewal_date);
+    setStatus(value.status);
+    setInvoiceAmount(String(value.monthly_amount));
+    setInvoiceDueDate(value.renewal_date);
+  }, []);
+
+  const load = useCallback(() => {
+    if (!Number.isFinite(subscriptionId)) return;
+    setLoading(true);
+    Promise.all([apiSubscription(subscriptionId), apiInvoices(subscriptionId)])
+      .then(([detail, invoiceList]) => {
+        applySubscription(detail);
+        setInvoices(invoiceList.items);
+        setError(null);
+      })
+      .catch((err: Error) => setError(err.message))
+      .finally(() => setLoading(false));
+  }, [subscriptionId, applySubscription]);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  async function handleSave(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!subscription) return;
+    setSaving(true);
+    setNotice(null);
+    setError(null);
+    try {
+      const updated = await apiUpdateSubscription(subscription.id, {
+        customer_name: customerName.trim(),
+        plan: plan.trim(),
+        monthly_amount: Number(amount) || 0,
+        renewal_date: renewalDate,
+        status,
+      });
+      applySubscription(updated);
+      setNotice("Subscription updated.");
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not save the subscription");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  async function handleIssueInvoice(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!subscription) return;
+    setIssuing(true);
+    setNotice(null);
+    setError(null);
+    try {
+      await apiCreateInvoice(subscription.id, {
+        amount_due: Number(invoiceAmount) || 0,
+        due_date: invoiceDueDate,
+      });
+      const list = await apiInvoices(subscription.id);
+      setInvoices(list.items);
+      setNotice("Invoice issued.");
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not issue the invoice");
+    } finally {
+      setIssuing(false);
+    }
+  }
+
+  async function handleCollection(outcome: "failed" | "succeeded") {
+    if (!subscription) return;
+    setCollectionBusy(true);
+    setNotice(null);
+    setError(null);
+    try {
+      const updated = await apiRecordCollection(subscription.id, outcome);
+      applySubscription(updated);
+      const list = await apiInvoices(subscription.id);
+      setInvoices(list.items);
+      setNotice(
+        outcome === "succeeded"
+          ? "Collection run succeeded — open invoices were paid."
+          : "Collection run failed — the subscription is now past due.",
+      );
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not record the collection run");
+    } finally {
+      setCollectionBusy(false);
+    }
+  }
+
+  if (loading) {
+    return <p className="text-sm text-slate-500">Loading subscription…</p>;
+  }
+
+  if (!subscription) {
+    return (
+      <div className="space-y-4">
+        <p className="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
+          {error ?? "Subscription not found."}
+        </p>
+        <Link to="/subscriptions" className="text-sm font-medium text-indigo-600">
+          Back to subscriptions
+        </Link>
+      </div>
+    );
+  }
+
+  const inputClass =
+    "mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200";
+
+  return (
