+import type { ReactNode } from "react";
+import { BrowserRouter, Link, Navigate, Route, Routes } from "react-router-dom";
+import { AuthProvider, useAuth } from "./auth";
+import Layout from "./components/Layout";
+import AuthPage from "./pages/AuthPage";
+import PublicStatsPage from "./pages/PublicStatsPage";
+import SubscriptionDetailPage from "./pages/SubscriptionDetailPage";
+import SubscriptionsPage from "./pages/SubscriptionsPage";
+
+function RequireAuth({ children }: { children: ReactNode }) {
+  const { user, ready } = useAuth();
+  if (!ready) {
+    return <p className="text-sm text-slate-500">Loading…</p>;
+  }
+  if (!user) {
+    return <Navigate to="/login" replace />;
+  }
+  return <>{children}</>;
+}
+
+function NotFound() {
+  return (
+    <div className="mx-auto max-w-md py-16 text-center">
+      <p className="text-sm font-semibold uppercase tracking-wide text-indigo-600">404</p>
+      <h1 className="mt-2 text-2xl font-semibold tracking-tight">Page not found</h1>
+      <p className="mt-2 text-sm text-slate-500">
+        The page you were looking for does not exist.
+      </p>
+      <Link
+        to="/"
+        className="mt-6 inline-flex rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700"
+      >
+        Back to the public summary
+      </Link>
+    </div>
+  );
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  return (
+    <BrowserRouter>
+      <AuthProvider>
+        <Layout>
+          <Routes>
+            <Route path="/" element={<PublicStatsPage />} />
+            <Route path="/public" element={<PublicStatsPage />} />
+            <Route path="/login" element={<AuthPage />} />
+            <Route path="/register" element={<AuthPage />} />
+            <Route
+              path="/subscriptions"
+              element={
+                <RequireAuth>
+                  <SubscriptionsPage />
+                </RequireAuth>
+              }
+            />
+            <Route
+              path="/subscriptions/:id"
+              element={
+                <RequireAuth>
+                  <SubscriptionDetailPage />
+                </RequireAuth>
+              }
+            />
+            <Route path="*" element={<NotFound />} />
+          </Routes>
+        </Layout>
+      </AuthProvider>
+    </BrowserRouter>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..c65b4d4
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,168 @@
+import type {
+  Account,
+  Invoice,
+  PublicStats,
+  Subscription,
+  SubscriptionInput,
+  SubscriptionPage,
+  SubscriptionStatus,
+} from "./types";
+
+const TOKEN_STORAGE_KEY = "billing-console-token";
+
+export class ApiError extends Error {
+  status: number;
+
+  constructor(message: string, status: number) {
+    super(message);
+    this.name = "ApiError";
+    this.status = status;
+  }
+}
+
+export function readToken(): string | null {
+  try {
+    return window.localStorage.getItem(TOKEN_STORAGE_KEY);
+  } catch {
+    return null;
+  }
+}
+
+export function writeToken(token: string | null): void {
+  try {
+    if (token) {
+      window.localStorage.setItem(TOKEN_STORAGE_KEY, token);
+    } else {
+      window.localStorage.removeItem(TOKEN_STORAGE_KEY);
+    }
+  } catch {
+    /* storage unavailable - the session simply will not persist */
+  }
+}
+
+async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const headers: Record<string, string> = { Accept: "application/json" };
+  if (init.body !== undefined) headers["Content-Type"] = "application/json";
+  const token = readToken();
+  if (token) headers.Authorization = `Bearer ${token}`;
+
+  let response: Response;
+  try {
+    response = await fetch(path, { ...init, headers });
+  } catch {
+    throw new ApiError("Could not reach the server", 0);
+  }
+
+  const text = await response.text();
+  let payload: unknown = null;
+  if (text) {
+    try {
+      payload = JSON.parse(text);
+    } catch {
+      payload = null;
+    }
+  }
+
+  if (!response.ok) {
+    const message =
+      payload && typeof payload === "object" && "error" in payload
+        ? String((payload as { error: unknown }).error)
+        : `Request failed (${response.status})`;
+    throw new ApiError(message, response.status);
+  }
+  return payload as T;
+}
+
+export function apiRegister(username: string, password: string): Promise<Account> {
+  return request<Account>("/api/auth/register", {
+    method: "POST",
+    body: JSON.stringify({ username, password }),
+  });
+}
+
+export function apiLogin(username: string, password: string): Promise<{ token: string }> {
+  return request<{ token: string }>("/api/auth/login", {
+    method: "POST",
+    body: JSON.stringify({ username, password }),
+  });
+}
+
+export function apiLogout(): Promise<{ status: string }> {
+  return request<{ status: string }>("/api/auth/logout", { method: "POST" });
+}
+
+export function apiMe(): Promise<Account> {
+  return request<Account>("/api/auth/me");
+}
+
+export function apiPublicStats(): Promise<PublicStats> {
+  return request<PublicStats>("/api/public/stats");
+}
+
+export type SubscriptionQuery = {
+  q?: string;
+  status?: SubscriptionStatus | "";
+  plan?: string;
+  page?: number;
+  pageSize?: number;
+};
+
+export function apiSubscriptions(query: SubscriptionQuery = {}): Promise<SubscriptionPage> {
+  const params = new URLSearchParams();
+  if (query.q) params.set("q", query.q);
+  if (query.status) params.set("status", query.status);
+  if (query.plan) params.set("plan", query.plan);
+  if (query.page && query.page > 1) params.set("page", String(query.page));
+  if (query.pageSize) params.set("page_size", String(query.pageSize));
+  const search = params.toString();
+  return request<SubscriptionPage>(`/api/subscriptions${search ? `?${search}` : ""}`);
+}
+
+export function apiPlans(): Promise<{ items: string[] }> {
+  return request<{ items: string[] }>("/api/subscriptions/plans");
+}
+
+export function apiSubscription(id: number): Promise<Subscription> {
+  return request<Subscription>(`/api/subscriptions/${id}`);
+}
+
+export function apiCreateSubscription(input: SubscriptionInput): Promise<Subscription> {
+  return request<Subscription>("/api/subscriptions", {
+    method: "POST",
+    body: JSON.stringify(input),
+  });
+}
+
+export function apiUpdateSubscription(
+  id: number,
+  input: Partial<SubscriptionInput>,
+): Promise<Subscription> {
+  return request<Subscription>(`/api/subscriptions/${id}`, {
+    method: "PATCH",
+    body: JSON.stringify(input),
+  });
+}
+
+export function apiInvoices(id: number): Promise<{ items: Invoice[] }> {
+  return request<{ items: Invoice[] }>(`/api/subscriptions/${id}/invoices`);
+}
+
+export function apiCreateInvoice(
+  id: number,
+  input: { amount_due?: number; due_date?: string },
+): Promise<Invoice> {
+  return request<Invoice>(`/api/subscriptions/${id}/invoices`, {
+    method: "POST",
+    body: JSON.stringify(input),
+  });
+}
+
+export function apiRecordCollection(
+  id: number,
+  outcome: "failed" | "succeeded",
+): Promise<Subscription & { outcome: string }> {
+  return request<Subscription & { outcome: string }>(`/api/subscriptions/${id}/collections`, {
+    method: "POST",
+    body: JSON.stringify({ outcome }),
+  });
+}
diff --git a/frontend/src/auth.tsx b/frontend/src/auth.tsx
new file mode 100644
index 0000000..70c49ad
--- /dev/null
+++ b/frontend/src/auth.tsx
@@ -0,0 +1,78 @@
+import { createContext, useCallback, useContext, useEffect, useMemo, useState } from "react";
+import type { ReactNode } from "react";
+import { apiLogin, apiLogout, apiMe, apiRegister, readToken, writeToken } from "./api";
+import type { Account } from "./types";
+
+type AuthContextValue = {
+  user: Account | null;
+  ready: boolean;
+  signIn: (username: string, password: string) => Promise<void>;
+  signUp: (username: string, password: string) => Promise<void>;
+  signOut: () => Promise<void>;
+};
+
+const AuthContext = createContext<AuthContextValue | null>(null);
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [user, setUser] = useState<Account | null>(null);
+  const [ready, setReady] = useState(false);
+
+  useEffect(() => {
+    if (!readToken()) {
+      setReady(true);
+      return;
+    }
+    let cancelled = false;
+    apiMe()
+      .then((account) => {
+        if (!cancelled) setUser(account);
+      })
+      .catch(() => {
+        writeToken(null);
+      })
+      .finally(() => {
+        if (!cancelled) setReady(true);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const signIn = useCallback(async (username: string, password: string) => {
+    const result = await apiLogin(username, password);
+    writeToken(result.token);
+    const account = await apiMe();
+    setUser(account);
+  }, []);
+
+  const signUp = useCallback(async (username: string, password: string) => {
+    await apiRegister(username, password);
+    const result = await apiLogin(username, password);
+    writeToken(result.token);
+    const account = await apiMe();
+    setUser(account);
+  }, []);
+
+  const signOut = useCallback(async () => {
+    try {
+      await apiLogout();
+    } catch {
+      /* the local session is dropped either way */
+    }
+    writeToken(null);
+    setUser(null);
+  }, []);
+
+  const value = useMemo(
+    () => ({ user, ready, signIn, signUp, signOut }),
+    [user, ready, signIn, signUp, signOut],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthContextValue {
+  const context = useContext(AuthContext);
+  if (!context) throw new Error("useAuth must be used inside an AuthProvider");
+  return context;
+}
