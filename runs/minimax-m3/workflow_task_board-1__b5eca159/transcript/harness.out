 \"import sys,json; print(json.load(sys.stdin)['token'])\"); echo \"TOKEN=$TOKEN\"; curl -s -X POST http://127.0.0.1:8000/api/tasks -H \"Authorization: Bearer $TOKEN\" -H 'Content-Type: application/json' -d '{\"title\":\"Write docs\",\"priority\":\"high\"}'; echo; curl -s -X POST http://127.0.0.1:8000/api/tasks -H \"Authorization: Bearer $TOKEN\" -H 'Content-Type: application/json' -d '{\"title\":\"Ship it\",\"priority\":\"low\",\"status\":\"in_progress\"}'; echo; curl -s \"http://127.0.0.1:8000/api/tasks\" | python3 -m json.tool","time":{"start":1794358176474,"end":1794358176955}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c814ead4001lRdlQkFwSJQ14V","sessionID":"ses_e37f28d7bffekBPOL1DKCH4OOV","messageID":"msg_1c814df79001wBeuRXM2COA5ky"}}
