diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..49dc324
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,162 @@
+import type {
+  Incident,
+  IncidentListResponse,
+  PublicStats,
+  TimelineEvent,
+  TimelineResponse,
+} from "./types";
+
+const TOKEN_KEY = "incident_center.token";
+const USERNAME_KEY = "incident_center.username";
+
+export class ApiError extends Error {
+  status: number;
+  errors: Record<string, string>;
+
+  constructor(message: string, status: number, errors: Record<string, string> = {}) {
+    super(message);
+    this.name = "ApiError";
+    this.status = status;
+    this.errors = errors;
+  }
+}
+
+export function getToken(): string | null {
+  try {
+    return window.localStorage.getItem(TOKEN_KEY);
+  } catch {
+    return null;
+  }
+}
+
+export function setSession(token: string, username: string): void {
+  try {
+    window.localStorage.setItem(TOKEN_KEY, token);
+    window.localStorage.setItem(USERNAME_KEY, username);
+  } catch {
+    /* storage unavailable */
+  }
+}
+
+export function clearSession(): void {
+  try {
+    window.localStorage.removeItem(TOKEN_KEY);
+    window.localStorage.removeItem(USERNAME_KEY);
+  } catch {
+    /* storage unavailable */
+  }
+}
+
+export function getStoredUsername(): string | null {
+  try {
+    return window.localStorage.getItem(USERNAME_KEY);
+  } catch {
+    return null;
+  }
+}
+
+async function request<T>(
+  path: string,
+  options: { method?: string; body?: unknown } = {},
+): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (options.body !== undefined) {
+    headers["Content-Type"] = "application/json";
+  }
+  const token = getToken();
+  if (token) {
+    headers["Authorization"] = `Bearer ${token}`;
+  }
+
+  let response: Response;
+  try {
+    response = await fetch(path, {
+      method: options.method ?? "GET",
+      headers,
+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,
+    });
+  } catch {
+    throw new ApiError("The server is unreachable", 0);
+  }
+
+  const raw = await response.text();
+  let payload: unknown = null;
+  if (raw) {
+    try {
+      payload = JSON.parse(raw);
+    } catch {
+      payload = null;
+    }
+  }
+
+  if (!response.ok) {
+    const body = (payload ?? {}) as { error?: string; errors?: Record<string, string> };
+    throw new ApiError(
+      body.error ?? `Request failed with status ${response.status}`,
+      response.status,
+      body.errors ?? {},
+    );
+  }
+  return payload as T;
+}
+
+export interface IncidentQuery {
+  severity?: string;
+  status?: string;
+  open?: boolean;
+  q?: string;
+  page?: number;
+  page_size?: number;
+}
+
+export const api = {
+  health: () => request<{ status: string }>("/api/health"),
+
+  register: (username: string, password: string) =>
+    request<{ id: number; username: string }>("/api/auth/register", {
+      method: "POST",
+      body: { username, password },
+    }),
+
+  login: (username: string, password: string) =>
+    request<{ token: string; username: string }>("/api/auth/login", {
+      method: "POST",
+      body: { username, password },
+    }),
+
+  listIncidents: (query: IncidentQuery = {}) => {
+    const params = new URLSearchParams();
+    if (query.severity) params.set("severity", query.severity);
+    if (query.status) params.set("status", query.status);
+    if (query.open !== undefined) params.set("open", query.open ? "true" : "false");
+    if (query.q) params.set("q", query.q);
+    if (query.page) params.set("page", String(query.page));
+    if (query.page_size) params.set("page_size", String(query.page_size));
+    const suffix = params.toString();
+    return request<IncidentListResponse>(`/api/incidents${suffix ? `?${suffix}` : ""}`);
+  },
+
+  createIncident: (payload: {
+    title: string;
+    service: string;
+    severity: string;
+    commander: string;
+    impact_summary: string;
+  }) => request<Incident>("/api/incidents", { method: "POST", body: payload }),
+
+  getIncident: (id: number) => request<Incident>(`/api/incidents/${id}`),
+
+  updateIncident: (id: number, patch: Partial<Incident>) =>
+    request<Incident>(`/api/incidents/${id}`, { method: "PATCH", body: patch }),
+
+  listTimeline: (id: number) =>
+    request<TimelineResponse>(`/api/incidents/${id}/timeline`),
+
+  postTimelineEvent: (id: number, message: string, type = "note") =>
+    request<TimelineEvent>(`/api/incidents/${id}/timeline`, {
+      method: "POST",
+      body: { message, type },
+    }),
+
+  publicStats: () => request<PublicStats>("/api/public/stats"),
+};
diff --git a/frontend/src/auth.tsx b/frontend/src/auth.tsx
new file mode 100644
index 0000000..dddd841
--- /dev/null
+++ b/frontend/src/auth.tsx
@@ -0,0 +1,56 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useMemo,
+  useState,
+  type ReactNode,
+} from "react";
+import { api, clearSession, getStoredUsername, getToken, setSession } from "./api";
+
+interface AuthState {
+  username: string | null;
+  token: string | null;
+  signIn: (username: string, password: string) => Promise<void>;
+  signUp: (username: string, password: string) => Promise<void>;
+  signOut: () => void;
+}
+
+const AuthContext = createContext<AuthState | null>(null);
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [token, setTokenState] = useState<string | null>(() => getToken());
+  const [username, setUsername] = useState<string | null>(() => getStoredUsername());
+
+  const signIn = useCallback(async (name: string, password: string) => {
+    const result = await api.login(name, password);
+    setSession(result.token, result.username ?? name);
+    setTokenState(result.token);
+    setUsername(result.username ?? name);
+  }, []);
+
+  const signUp = useCallback(async (name: string, password: string) => {
+    await api.register(name, password);
+  }, []);
+
+  const signOut = useCallback(() => {
+    clearSession();
+    setTokenState(null);
+    setUsername(null);
+  }, []);
+
+  const value = useMemo(
+    () => ({ username, token, signIn, signUp, signOut }),
+    [username, token, signIn, signUp, signOut],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthState {
+  const context = useContext(AuthContext);
+  if (!context) {
+    throw new Error("useAuth must be used inside AuthProvider");
+  }
+  return context;
+}
