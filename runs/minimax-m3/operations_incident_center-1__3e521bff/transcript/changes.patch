+        <span>Opened by {incident.opened_by || "—"}</span>
+        {incident.resolved_at ? (
+          <span>Resolved {formatDateTime(incident.resolved_at)}</span>
+        ) : null}
+        {incident.reopen_count > 0 ? (
+          <span>Reopened {incident.reopen_count}×</span>
