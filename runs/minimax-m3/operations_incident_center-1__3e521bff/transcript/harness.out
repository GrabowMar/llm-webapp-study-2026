{"type":"tool_use","timestamp":1794355518106,"sessionID":"ses_e38170798fferFf1mK07jkjW4e","part":{"type":"tool","tool":"write","callID":"call_01a1c7ec52e575fcb50a3d34","state":{"status":"completed","input":{"content":"export type Severity = \"sev1\" | \"sev2\" | \"sev3\" | \"sev4\";\n\nexport type IncidentStatus =\n  | \"investigating\"\n  | \"identified\"\n  | \"monitoring\"\n  | \"resolved\"\n  | \"open\"\n  | \"closed\";\n\nexport interface Incident {\n  id: number;\n  title: string;\n  service: string;\n  severity: Severity;\n  status: IncidentStatus;\n  commander: string;\n  impact_summary: string;\n  opened_at: string;\n  resolved_at: string | null;\n  reopen_count: number;\n  opened_by: string;\n  sla_due_at: string;\n  sla_breached: boolean;\n}\n\nexport interface TimelineEvent {\n  id: number;\n  type: string;\n  message: string;\n  created_at: string;\n  author: string;\n}\n\nexport interface IncidentListResponse {\n  items: Incident[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface TimelineResponse {\n  items: TimelineEvent[];\n}\n\nexport interface PublicStats {\n  open_total: number;\n  open_by_severity: Record<Severity, number>;\n  sla_breached_open: number;\n  resolved_last_30_days: number;\n}\n\nexport const SEVERITIES: Severity[] = [\"sev1\", \"sev2\", \"sev3\", \"sev4\"];\n\nexport const STATUSES: IncidentStatus[] = [\n  \"investigating\",\n  \"identified\",\n  \"monitoring\",\n  \"resolved\",\n];\n\nexport const SLA_TARGET_MINUTES: Record<Severity, number> = {\n  sev1: 60,\n  sev2: 240,\n  sev3: 1440,\n  sev4: 4320,\n};\n","filePath":"/workspace/frontend/src/types.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/types.ts","exists":false,"truncated":false},"title":"frontend/src/types.ts","time":{"start":1794355518081,"end":1794355518087}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7ec5a7b001TwYLPPr7y4ry14","sessionID":"ses_e38170798fferFf1mK07jkjW4e","messageID":"msg_1c7ec4d73001zJIDHS4B0PJW8d"}}
