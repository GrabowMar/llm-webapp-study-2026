(username,)\n        ).fetchone()\n        if user is None or not check_password_hash(user[\"password_hash\"], password):\n            raise ApiError(\"Invalid username or password\", 401)\n    else:\n        user = connection.execute(\n            \"SELECT * FROM users WHERE username = ? COLLATE NOCASE\", (username,)\n        ).fetchone()\n        if user is None or not check_password_hash(user[\"password_hash\"], password):\n            raise ApiError(\"Invalid username or password\", 401)\n\n    token = issue_token(connection, user[\"id\"])\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = require_user()\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"], \"is_admin\": bool(user[\"is_admin\"])})","lineStart":396,"lineEnd":435,"totalLines":710,"truncated":true}},"title":"backend/app.py","time":{"start":1794304412490,"end":1794304412505}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4e08b45001gCRETtvgL7vjR1","sessionID":"ses_e3b28f934ffeJmeWt8viIcFs1W","messageID":"msg_1c4e07e6200133k63DwRzFoaiQ"}}
