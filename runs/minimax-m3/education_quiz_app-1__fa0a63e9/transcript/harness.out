{"type":"tool_use","timestamp":1794304269985,"sessionID":"ses_e3b28f934ffeJmeWt8viIcFs1W","part":{"type":"tool","tool":"write","callID":"call_QFqkfOTD291xIE47udftlThC","state":{"status":"completed","input":{"content":"const TOKEN_KEY = \"quiz_token\";\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nexport function getToken(): string | null {\n  try {\n    return window.localStorage.getItem(TOKEN_KEY);\n  } catch {\n    return null;\n  }\n}\n\nexport function setToken(token: string): void {\n  try {\n    window.localStorage.setItem(TOKEN_KEY, token);\n  } catch {\n    /* storage unavailable */\n  }\n}\n\nexport function clearToken(): void {\n  try {\n    window.localStorage.removeItem(TOKEN_KEY);\n  } catch {\n    /* storage unavailable */\n  }\n}\n\ninterface RequestOptions {\n  method?: string;\n  body?: unknown;\n  auth?: boolean;\n}\n\nexport async function apiRequest<T>(path: string, options: RequestOptions = {}): Promise<T> {\n  const { method = \"GET\", body, auth = true } = options;\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (auth) {\n    const token = getToken();\n    if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  }\n\n  let response: Response;\n  try {\n    response = await fetch(path, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server. Please try again.\");\n  }\n\n  const raw = await response.text();\n  let payload: unknown = null;\n  if (raw) {\n    try {\n      payload = JSON.parse(raw);\n    } catch {\n      payload = null;\n    }\n  }\n\n  if (!response.ok) {\n    const data = (payload ?? {}) as { error?: string; errors?: Record<string, string> };\n    throw new ApiError(\n      response.status,\n      data.error || `Request failed with status ${response.status}`,\n      data.errors ?? {},\n    );\n  }\n\n  return (payload ?? {}) as T;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794304269934,"end":1794304269960}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c4de5e67001LatVV90VuHsXxL","sessionID":"ses_e3b28f934ffeJmeWt8viIcFs1W","messageID":"msg_1c4de4c79001w79tupSQdIT6O9"}}
