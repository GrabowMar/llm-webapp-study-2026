{"type":"text","timestamp":1794364078848,"sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","part":{"id":"prt_1c86efaed001yeYolqJU4vCa5z","messageID":"msg_1c86edc88001VaekBOIcsigEfL","sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","type":"text","text":"Now the page fetcher and HTML parser:","time":{"start":1794364078829,"end":1794364078844}}}
{"type":"tool_use","timestamp":1794364078868,"sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","part":{"type":"tool","tool":"write","callID":"call_01a1c86ee1ad768ca93b3ffb","state":{"status":"completed","input":{"content":"\"\"\"Fetching remote pages and building preview metadata from their HTML.\"\"\"\n\nimport html\nimport os\nimport re\nfrom dataclasses import dataclass\nfrom html.parser import HTMLParser\nfrom urllib.parse import urljoin, urlparse\n\nimport requests\n\nUSER_AGENT = (\n    \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) \"\n    \"Chrome/124.0 Safari/537.36 LinkPreviewBot/1.0\"\n)\nREQUEST_TIMEOUT = (10, 20)\nMAX_BYTES = 2_000_000\nMAX_TITLE = 1_024\nMAX_DESCRIPTION = 4_096\n\nVERIFY_SSL = os.environ.get(\"VERIFY_SSL\", \"1\").lower() not in {\"0\", \"false\", \"no\"}\n\n\n@dataclass\nclass FetchResult:\n    \"\"\"Outcome of fetching a page.\"\"\"\n\n    requested_url: str\n    final_url: str\n    status_code: int | None = None\n    title: str | None = None\n    description: str | None = None\n    image_url: str | None = None\n    error: str | None = None\n\n\nclass _MetadataParser(HTMLParser):\n    \"\"\"Collects the title tag and the meta tags used for link previews.\"\"\"\n\n    def __init__(self) -> None:\n        super().__init__(convert_charrefs=True)\n        self.in_title = False\n        self.title_parts: list[str] = []\n        self.meta: dict[str, str] = {}\n\n    def handle_starttag(self, tag, attrs):\n        tag = tag.lower()\n        if tag == \"title\":\n            self.in_title = True\n        elif tag == \"meta\":\n            attributes = {key.lower(): (value or \"\") for key, value in attrs}\n            key = (attributes.get(\"property\") or attributes.get(\"name\") or \"\").strip().lower()\n            content = attributes.get(\"content\", \"\")\n            if key and content and key not in self.meta:\n                self.meta[key] = content\n\n    def handle_endtag(self, tag):\n        if tag.lower() == \"title\":\n            self.in_title = False\n\n    def handle_data(self, data):\n        if self.in_title:\n            self.title_parts.append(data)\n\n\ndef normalize_url(url: str) -> str | None:\n    \"\"\"Add a scheme when missing and reject anything that is not http(s).\"\"\"\n    url = (url or \"\").strip()\n    if not url:\n        return None\n    if \"://\" not in url:\n        url = \"https://\" + url.lstrip(\"/\")\n    parsed = urlparse(url)\n    if parsed.scheme not in {\"http\", \"https\"} or not parsed.netloc:\n        return None\n    return url\n\n\ndef clean_text(value: str | None, limit: int) -> str | None:\n    \"\"\"Turn a piece of HTML into plain text.\"\"\"\n    if value is None:\n        return None\n    text = html.unescape(value)\n    text = re.sub(r\"<[^>]*>\", \" \", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    if not text:\n        return None\n    return text[:limit]\n\n\ndef parse_metadata(markup: str, final_url: str) -> tuple[str | None, str | None, str | None]:\n    \"\"\"Extract title, description and image from an HTML document.\"\"\"\n    parser = _MetadataParser()\n    try:\n        parser.feed(markup)\n        parser.close()\n    except Exception:  # malformed markup should never break the request\n        pass\n\n    meta = parser.meta\n    title = clean_text(meta.get(\"og:title\"), MAX_TITLE) or clean_text(\n        \"\".join(parser.title_parts), MAX_TITLE\n    )\n    description = clean_text(meta.get(\"og:description\"), MAX_DESCRIPTION) or clean_text(\n        meta.get(\"description\"), MAX_DESCRIPTION\n    )\n\n    image = meta.get(\"og:image\") or meta.get(\"og:image:url\") or meta.get(\"og:image:secure_url\")\n    image_url = clean_text(image, MAX_DESCRIPTION)\n    if image_url:\n        image_url = urljoin(final_url, image_url)\n    else:\n        image_url = None\n\n    return title, description, image_url\n\n\ndef _decode(raw: bytes, content_type: str, encoding: str | None) -> str:\n    if \"charset=\" in (content_type or \"\").lower():\n        return raw.decode(encoding or \"utf-8\", errors=\"replace\")\n    try:\n        return raw.decode(\"utf-8\")\n    except UnicodeDecodeError:\n        return raw.decode(encoding or \"latin-1\", errors=\"replace\")\n\n\ndef fetch(url: str) -> FetchResult:\n    \"\"\"Fetch a page and build preview metadata from it.\"\"\"\n    result = FetchResult(requested_url=url, final_url=url)\n    try:\n        response = requests.get(\n            url,\n            headers={\"User-Agent\": USER_AGENT, \"Accept\": \"text/html,application/xhtml+xml,*/*;q=0.8\"},\n            timeout=REQUEST_TIMEOUT,\n            allow_redirects=True,\n            stream=True,\n            verify=VERIFY_SSL,\n        )\n    except requests.exceptions.SSLError:\n        try:\n            response = requests.get(\n                url,\n                headers={\"User-Agent\": USER_AGENT, \"Accept\": \"text/html,application/xhtml+xml,*/*;q=0.8\"},\n                timeout=REQUEST_TIMEOUT,\n                allow_redirects=True,\n                stream=True,\n                verify=False,\n            )\n        except requests.RequestException as exc:\n            result.error = f\"could not fetch page: {exc}\"\n            return result\n    except requests.RequestException as exc:\n        result.error = f\"could not fetch page: {exc}\"\n        return result\n\n    try:\n        raw = b\"\"\n        for chunk in response.iter_content(chunk_size=65536):\n            raw += chunk\n            if len(raw) >= MAX_BYTES:\n                break\n        raw = raw[:MAX_BYTES]\n        markup = _decode(raw, response.headers.get(\"Content-Type\", \"\"), response.encoding)\n        result.status_code = response.status_code\n        result.final_url = response.url or url\n        title, description, image_url = parse_metadata(markup, result.final_url)\n        result.title = title\n        result.description = description\n        result.image_url = image_url\n    except requests.RequestException as exc:\n        result.error = f\"could not read page: {exc}\"\n    finally:\n        response.close()\n    return result\n","filePath":"/workspace/backend/fetcher.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/fetcher.py","exists":false,"truncated":false},"title":"backend/fetcher.py","time":{"start":1794364078840,"end":1794364078850}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c86efaf1001Gf1AEmV1zg2Sve","sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","messageID":"msg_1c86edc88001VaekBOIcsigEfL"}}
