{"type":"text","timestamp":1794364059636,"sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","part":{"id":"prt_1c86eafe4001DeujneP0Hushdp","messageID":"msg_1c86e9e42001cupJthsx27cwH1","sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","type":"text","text":"<think>Nowauth.py.</think>\n\n","time":{"start":1794364059620,"end":1794364059632}}}
{"type":"tool_use","timestamp":1794364059658,"sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","part":{"type":"tool","tool":"write","callID":"call_01a1c86ea2df7549a6495686","state":{"status":"completed","input":{"content":"\"\"\"Password hashing, bearer tokens and the authentication decorator.\"\"\"\n\nimport hashlib\nimport hmac\nimport secrets\nfrom functools import wraps\n\nfrom flask import g, jsonify, request\n\nfrom db import execute, query_one\n\nPBKDF2_ITERATIONS = 120_000\nTOKEN_BYTES = 32\n\n\ndef hash_password(password: str, salt: bytes | None = None) -> str:\n    \"\"\"Hash a password with PBKDF2-HMAC-SHA256 and a random salt.\"\"\"\n    salt = salt or secrets.token_bytes(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, PBKDF2_ITERATIONS)\n    return f\"pbkdf2_sha256${PBKDF2_ITERATIONS}${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    \"\"\"Check a password against a stored hash.\"\"\"\n    try:\n        algorithm, iterations, salt_hex, digest_hex = stored.split(\"$\")\n        if algorithm != \"pbkdf2_sha256\":\n            return False\n        digest = hashlib.pbkdf2_hmac(\n            \"sha256\",\n            password.encode(\"utf-8\"),\n            bytes.fromhex(salt_hex),\n            int(iterations),\n        )\n    except (AttributeError, TypeError, ValueError):\n        return False\n    return hmac.compare_digest(digest.hex(), digest_hex)\n\n\ndef issue_token(user_id: int) -> str:\n    \"\"\"Create and persist a new bearer token for a user.\"\"\"\n    token = secrets.token_urlsafe(TOKEN_BYTES)\n    execute(\"INSERT INTO tokens (token, user_id, created_at) VALUES (?, ?, ?)\", (token, user_id, _now()))\n    return token\n\n\ndef resolve_token(token: str):\n    \"\"\"Return the user row behind a token, or None.\"\"\"\n    if not token:\n        return None\n    return query_one(\n        \"SELECT users.id AS id, users.username AS username FROM tokens \"\n        \"JOIN users ON users.id = tokens.user_id WHERE tokens.token = ?\",\n        (token,),\n    )\n\n\ndef bearer_token() -> str | None:\n    \"\"\"Extract the bearer token from the Authorization header.\"\"\"\n    header = request.headers.get(\"Authorization\", \"\") or \"\"\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    return parts[1].strip() or None\n\n\ndef require_auth(view):\n    \"\"\"Reject requests without a valid bearer token.\"\"\"\n\n    @wraps(view)\n    def wrapper(*args, **kwargs):\n        user = resolve_token(bearer_token() or \"\")\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n\n\ndef _now() -> str:\n    from datetime import datetime, timezone\n\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n","filePath":"/workspace/backend/auth.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/auth.py","exists":false,"truncated":false},"title":"backend/auth.py","time":{"start":1794364059628,"end":1794364059639}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c86eafe7001Rp2jKPchjbef0E","sessionID":"ses_e37936048ffeH8FUfoum56bQ5v","messageID":"msg_1c86e9e42001cupJthsx27cwH1"}}
