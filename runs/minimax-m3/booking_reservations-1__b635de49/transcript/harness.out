{"type":"step_start","timestamp":1794322576042,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"id":"prt_1c5f5b29e001MswE2CeI3c0rR6","messageID":"msg_1c5f58e44001jCxvD60qtq9I7G","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","type":"step-start"}}
{"type":"tool_use","timestamp":1794322576064,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"type":"tool","tool":"write","callID":"call_1SntttQYKLJcpdUBedHnAndD","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { ApiError, login, register } from \"../api\";\nimport { cardClass, cardTitleClass, inputClass, labelClass, primaryButtonClass, secondaryButtonClass } from \"../ui\";\n\ntype Props = {\n  onSignedIn: (username: string, isAdmin: boolean) => void;\n};\n\nexport default function AuthPanel({ onSignedIn }: Props) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function handleSubmit(event: React.FormEvent) {\n    event.preventDefault();\n    setError(null);\n    setMessage(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await register(username.trim(), password);\n        const session = await login(username.trim(), password);\n        onSignedIn(session.username, Boolean(session.is_admin));\n        return;\n      }\n      const session = await login(username.trim(), password);\n      onSignedIn(session.username, Boolean(session.is_admin));\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong. Please try again.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto w-full max-w-md\">\n      <div className=\"mb-6 text-center\">\n        <p className=\"text-xs font-semibold uppercase tracking-[0.3em] text-amber-700\">Maison Verte</p>\n        <h1 className=\"mt-2 text-3xl font-semibold tracking-tight text-stone-900\">Table reservations</h1>\n        <p className=\"mt-2 text-sm text-stone-500\">Sign in to book a table, or create an account to get started.</p>\n      </div>\n\n      <div className={cardClass}>\n        <div className=\"mb-5 grid grid-cols-2 gap-1 rounded-lg bg-stone-100 p-1\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\"login\");\n              setError(null);\n              setMessage(null);\n            }}\n            className={`rounded-md px-3 py-1.5 text-sm font-semibold transition ${\n              mode === \"login\" ? \"bg-white text-stone-900 shadow-sm\" : \"text-stone-500 hover:text-stone-700\"\n            }`}\n          >\n            Sign in\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\"register\");\n              setError(null);\n              setMessage(null);\n            }}\n            className={`rounded-md px-3 py-1.5 text-sm font-semibold transition ${\n              mode === \"register\" ? \"bg-white text-stone-900 shadow-sm\" : \"text-stone-500 hover:text-stone-700\"\n            }`}\n          >\n            Register\n          </button>\n        </div>\n\n        <h2 className={cardTitleClass}>{mode === \"login\" ? \"Welcome back\" : \"Create your account\"}</h2>\n\n        <form className=\"mt-4 space-y-4\" onSubmit={handleSubmit}>\n          <div>\n            <label className={labelClass} htmlFor=\"username\">\n              Username\n            </label>\n            <input\n              id=\"username\"\n              name=\"username\"\n              className={inputClass}\n              value={username}\n              autoComplete=\"username\"\n              onChange={(event) => setUsername(event.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={labelClass} htmlFor=\"password\">\n              Password\n            </label>\n            <input\n              id=\"password\"\n              name=\"password\"\n              type=\"password\"\n              className={inputClass}\n              value={password}\n              autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n              onChange={(event) => setPassword(event.target.value)}\n              required\n            />\n          </div>\n\n          {error ? (\n            <p role=\"alert\" className=\"rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n              {error}\n            </p>\n          ) : null}\n          {message ? (\n            <p role=\"status\" className=\"rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700\">\n              {message}\n            </p>\n          ) : null}\n\n          <button type=\"submit\" className={`${primaryButtonClass} w-full`} disabled={busy}>\n            {busy ? \"Please wait…\" : mode === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        </form>\n      </div>\n\n      <p className=\"mt-4 text-center text-xs text-stone-400\">\n        Availability is open to everyone — sign in only to manage your own bookings.\n      </p>\n    </div>\n  );\n}\n\nexport function AuthHeader({\n  username,\n  isAdmin,\n  onSignOut,\n}: {\n  username: string;\n  isAdmin: boolean;\n  onSignOut: () => void;\n}) {\n  return (\n    <header className=\"border-b border-stone-200 bg-white/90 backdrop-blur\">\n      <div className=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n        <div>\n          <p className=\"text-xs font-semibold uppercase tracking-[0.3em] text-amber-700\">Maison Verte</p>\n          <h1 className=\"text-xl font-semibold tracking-tight text-stone-900\">Table reservations</h1>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <span className=\"rounded-full bg-stone-100 px-3 py-1.5 text-sm font-medium text-stone-700\">\n            Signed in as <span className=\"font-semibold\">{username}</span>\n            {isAdmin ? <span className=\"ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-semibold text-amber-800\">admin</span> : null}\n          </span>\n          <button type=\"button\" className={secondaryButtonClass} onClick={onSignOut}>\n            Sign out\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AuthPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AuthPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AuthPanel.tsx","time":{"start":1794322576038,"end":1794322576046}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f5b2a1001C57nBtpaRA0amf","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","messageID":"msg_1c5f58e44001jCxvD60qtq9I7G"}}
