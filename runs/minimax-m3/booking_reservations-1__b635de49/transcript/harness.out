{"type":"tool_use","timestamp":1794322619935,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"type":"tool","tool":"write","callID":"call_t5X6rWPs61UxSUcvTcMBfvEL","state":{"status":"completed","input":{"content":"import type { AvailabilityItem } from \"../api\";\nimport { cardClass, cardTitleClass, formatDate, formatTime, inputClass, labelClass } from \"../ui\";\n\ntype Props = {\n  date: string;\n  availability: AvailabilityItem[];\n  onDateChange: (date: string) => void;\n};\n\nexport default function AvailabilityPanel({ date, availability, onDateChange }: Props) {\n  return (\n    <section className={cardClass} aria-labelledby=\"availability-heading\">\n      <div className=\"flex flex-wrap items-end justify-between gap-4\">\n        <div>\n          <h2 id=\"availability-heading\" className={cardTitleClass}>\n            Availability\n          </h2>\n          <p className=\"mt-1 text-sm text-stone-500\">Every seat of a slot is shared between all bookings.</p>\n        </div>\n        <div className=\"w-full sm:w-56\">\n          <label className={labelClass} htmlFor=\"day-picker\">\n            Day\n          </label>\n          <input\n            id=\"day-picker\"\n            type=\"date\"\n            className={inputClass}\n            value={date}\n            onChange={(event) => onDateChange(event.target.value)}\n          />\n        </div>\n      </div>\n\n      <p className=\"mt-4 text-sm font-medium text-stone-700\">{formatDate(date)}</p>\n\n      {availability.length === 0 ? (\n        <p className=\"mt-3 rounded-lg border border-dashed border-stone-300 bg-stone-50 px-4 py-6 text-center text-sm text-stone-500\">\n          No bookings yet on this day — every slot is wide open.\n        </p>\n      ) : (\n        <div className=\"mt-3 overflow-hidden rounded-xl border border-stone-200\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"bg-stone-50 text-xs uppercase tracking-wide text-stone-500\">\n              <tr>\n                <th scope=\"col\" className=\"px-4 py-2 font-semibold\">\n                  Slot\n                </th>\n                <th scope=\"col\" className=\"px-4 py-2 font-semibold\">\n                  Booked\n                </th>\n                <th scope=\"col\" className=\"px-4 py-2 font-semibold\">\n                  Seats left\n                </th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-stone-100 bg-white\">\n              {availability.map((slot) => (\n                <tr key={slot.time}>\n                  <td className=\"px-4 py-2.5 font-medium text-stone-800\">{formatTime(slot.time)}</td>\n                  <td className=\"px-4 py-2.5 text-stone-600\">{slot.booked}</td>\n                  <td className=\"px-4 py-2.5\">\n                    <span\n                      className={\n                        slot.remaining === 0\n                          ? \"inline-flex rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-700\"\n                          : \"inline-flex rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700\"\n                      }\n                    >\n                      {slot.remaining === 0 ? \"full\" : `${slot.remaining} of 20`}\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/AvailabilityPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AvailabilityPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AvailabilityPanel.tsx","time":{"start":1794322619907,"end":1794322619916}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f65dfe0012lr093AUbOqhnG","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","messageID":"msg_1c5f64660001ZrqE93s6SRpXDr"}}
