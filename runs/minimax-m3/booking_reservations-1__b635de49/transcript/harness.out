{"type":"text","timestamp":1794322663505,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"id":"prt_1c5f7083e001BldZfeE1JGXxUx","messageID":"msg_1c5f6e993001rZ4S7LBxeyeUc8","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","type":"text","text":"Now the main App component:","time":{"start":1794322663487,"end":1794322663502}}}
{"type":"tool_use","timestamp":1794322663541,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"type":"tool","tool":"write","callID":"call_jRtl2wg710ULvR4Eq7logwYM","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  ApiError,\n  fetchAllAdminReservations,\n  fetchAvailability,\n  fetchMe,\n  fetchReservations,\n  getStoredToken,\n  logout as apiLogout,\n  storeToken,\n} from \"./api\";\nimport type { AvailabilityItem, Reservation, User } from \"./api\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport AuthPanel, { AuthHeader } from \"./components/AuthPanel\";\nimport AvailabilityPanel from \"./components/AvailabilityPanel\";\nimport BookingForm from \"./components/BookingForm\";\nimport ReservationsPanel from \"./components/ReservationsPanel\";\nimport { todayISO } from \"./ui\";\n\nexport default function App() {\n  const [user, setUser] = useState<User | null>(null);\n  const [booting, setBooting] = useState(true);\n  const [selectedDate, setSelectedDate] = useState(todayISO());\n  const [availability, setAvailability] = useState<AvailabilityItem[]>([]);\n  const [reservations, setReservations] = useState<Reservation[]>([]);\n  const [adminReservations, setAdminReservations] = useState<Reservation[]>([]);\n  const [adminTotal, setAdminTotal] = useState(0);\n  const [editing, setEditing] = useState<Reservation | null>(null);\n\n  useEffect(() => {\n    let cancelled = false;\n    async function restore() {\n      if (!getStoredToken()) {\n        setBooting(false);\n        return;\n      }\n      try {\n        const me = await fetchMe();\n        if (!cancelled) setUser(me);\n      } catch {\n        storeToken(null);\n      } finally {\n        if (!cancelled) setBooting(false);\n      }\n    }\n    void restore();\n    return () => {\n      cancelled = true;\n    };\n  }, []);\n\n  const loadAvailability = useCallback(async (date: string) => {\n    try {\n      const data = await fetchAvailability(date);\n      setAvailability(data.items);\n    } catch {\n      setAvailability([]);\n    }\n  }, []);\n\n  const loadReservations = useCallback(async () => {\n    try {\n      const data = await fetchReservations();\n      setReservations(data.items);\n    } catch {\n      setReservations([]);\n    }\n  }, []);\n\n  const loadAdminReservations = useCallback(async (date: string) => {\n    try {\n      const items = await fetchAllAdminReservations(date);\n      setAdminReservations(items);\n      setAdminTotal(items.length);\n    } catch {\n      setAdminReservations([]);\n      setAdminTotal(0);\n    }\n  }, []);\n\n  const refresh = useCallback(async () => {\n    await Promise.all([loadAvailability(selectedDate), loadReservations(), loadAdminReservations(selectedDate)]);\n  }, [selectedDate, loadAvailability, loadReservations, loadAdminReservations]);\n\n  useEffect(() => {\n    void loadAvailability(selectedDate);\n  }, [selectedDate, loadAvailability]);\n\n  useEffect(() => {\n    if (!user) {\n      setReservations([]);\n      setAdminReservations([]);\n      setAdminTotal(0);\n      return;\n    }\n    void loadReservations();\n    void loadAdminReservations(selectedDate);\n  }, [user, selectedDate, loadReservations, loadAdminReservations]);\n\n  function handleSignedIn(username: string, isAdmin: boolean) {\n    const token = getStoredToken();\n    if (!token) return;\n    setUser({ id: 0, username, is_admin: isAdmin });\n    setEditing(null);\n  }\n\n  async function handleSignOut() {\n    await apiLogout();\n    storeToken(null);\n    setUser(null);\n    setEditing(null);\n    setReservations([]);\n    setAdminReservations([]);\n  }\n\n  function handleDateChange(date: string) {\n    setSelectedDate(date);\n  }\n\n  if (booting) {\n    return (\n      <div className=\"flex min-h-screen items-center justify-center bg-stone-50 text-sm text-stone-500\">\n        Loading…\n      </div>\n    );\n  }\n\n  if (!user) {\n    return (\n      <main className=\"min-h-screen bg-stone-50 px-4 py-10\">\n        <AuthPanel onSignedIn={handleSignedIn} />\n      </main>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-stone-50\">\n      <AuthHeader username={user.username} isAdmin={user.is_admin} onSignOut={handleSignOut} />\n\n      <main className=\"mx-auto max-w-6xl space-y-6 px-4 py-8\">\n        <div className=\"grid gap-6 lg:grid-cols-2\">\n          <div className=\"space-y-6\">\n            <AvailabilityPanel\n              date={selectedDate}\n              availability={availability}\n              onDateChange={handleDateChange}\n            />\n            <BookingForm\n              selectedDate={selectedDate}\n              editing={editing}\n              onStartEdit={setEditing}\n              onChanged={() => void refresh()}\n            />\n          </div>\n\n          <div className=\"space-y-6\">\n            <ReservationsPanel\n              reservations={reservations}\n              onEdit={(reservation) => {\n                setEditing(reservation);\n                window.scrollTo({ top: 0, behavior: \"smooth\" });\n              }}\n              onChanged={() => void refresh()}\n            />\n            {user.is_admin ? (\n              <AdminPanel date={selectedDate} reservations={adminReservations} total={adminTotal} />\n            ) : null}\n          </div>\n        </div>\n\n        <p className=\"pt-2 text-center text-xs text-stone-400\">\n          A slot seats at most 20 guests. Availability is public — sign in to book or change a table.\n        </p>\n      </main>\n    </div>\n  );\n}\n\nexport { ApiError };\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794322663498,"end":1794322663510}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f70842001D7QZ9F3qT4w9P5","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","messageID":"msg_1c5f6e993001rZ4S7LBxeyeUc8"}}
