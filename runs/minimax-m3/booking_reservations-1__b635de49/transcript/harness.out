{"type":"text","timestamp":1794322648450,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"id":"prt_1c5f6cd7100137otFcHFnzqjVW","messageID":"msg_1c5f6b21a001GyjG4ME5f595YU","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","type":"text","text":"Now the reservations list and admin panel:","time":{"start":1794322648433,"end":1794322648447}}}
{"type":"tool_use","timestamp":1794322648529,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"type":"tool","tool":"write","callID":"call_CbOOdmk8Fst2Bf0WHuRVuHvi","state":{"status":"completed","input":{"content":"import { useMemo, useState } from \"react\";\nimport { ApiError, deleteReservation } from \"../api\";\nimport type { Reservation } from \"../api\";\nimport { cardClass, cardTitleClass, dangerButtonClass, formatDate, formatTime, secondaryButtonClass } from \"../ui\";\n\ntype Props = {\n  reservations: Reservation[];\n  onEdit: (reservation: Reservation) => void;\n  onChanged: () => void;\n};\n\nexport default function ReservationsPanel({ reservations, onEdit, onChanged }: Props) {\n  const [error, setError] = useState<string | null>(null);\n  const [busyId, setBusyId] = useState<number | null>(null);\n\n  const grouped = useMemo(() => {\n    const groups = new Map<string, Reservation[]>();\n    for (const reservation of reservations) {\n      const list = groups.get(reservation.date) ?? [];\n      list.push(reservation);\n      groups.set(reservation.date, list);\n    }\n    return Array.from(groups.entries()).sort(([a], [b]) => a.localeCompare(b));\n  }, [reservations]);\n\n  async function handleCancel(reservation: Reservation) {\n    const confirmed = window.confirm(\n      `Cancel the reservation for ${reservation.name || \"this guest\"} on ${formatDate(reservation.date)} at ${formatTime(reservation.time)}?`,\n    );\n    if (!confirmed) return;\n    setError(null);\n    setBusyId(reservation.id);\n    try {\n      await deleteReservation(reservation.id);\n      onChanged();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Could not cancel the reservation.\");\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  return (\n    <section className={cardClass} aria-labelledby=\"reservations-heading\">\n      <div className=\"flex items-center justify-between gap-4\">\n        <div>\n          <h2 id=\"reservations-heading\" className={cardTitleClass}>\n            My reservations\n          </h2>\n          <p className=\"mt-1 text-sm text-stone-500\">Only you can see and change these bookings.</p>\n        </div>\n        <span className=\"rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-600\">\n          {reservations.length} total\n        </span>\n      </div>\n\n      {error ? (\n        <p role=\"alert\" className=\"mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n          {error}\n        </p>\n      ) : null}\n\n      {grouped.length === 0 ? (\n        <p className=\"mt-4 rounded-lg border border-dashed border-stone-300 bg-stone-50 px-4 py-6 text-center text-sm text-stone-500\">\n          You have no reservations yet. Book a table to get started.\n        </p>\n      ) : (\n        <div className=\"mt-4 space-y-5\">\n          {grouped.map(([date, items]) => (\n            <div key={date}>\n              <h3 className=\"text-sm font-semibold tracking-wide text-stone-700\">{formatDate(date)}</h3>\n              <ul className=\"mt-2 space-y-2\">\n                {items.map((reservation) => (\n                  <li\n                    key={reservation.id}\n                    className=\"flex flex-wrap items-center justify-between gap-3 rounded-xl border border-stone-200 bg-stone-50/60 px-4 py-3\"\n                  >\n                    <div className=\"min-w-0\">\n                      <p className=\"text-sm font-semibold text-stone-900\">\n                        {formatTime(reservation.time)} · {reservation.party_size} guest\n                        {reservation.party_size === 1 ? \"\" : \"s\"}\n                      </p>\n                      <p className=\"truncate text-sm text-stone-600\">\n                        {reservation.name || \"Guest\"}\n                        {reservation.email ? ` · ${reservation.email}` : \"\"}\n                      </p>\n                      {reservation.notes ? (\n                        <p className=\"mt-0.5 truncate text-xs italic text-stone-500\">{reservation.notes}</p>\n                      ) : null}\n                    </div>\n                    <div className=\"flex gap-2\">\n                      <button\n                        type=\"button\"\n                        className={secondaryButtonClass}\n                        onClick={() => onEdit(reservation)}\n                      >\n                        Edit\n                      </button>\n                      <button\n                        type=\"button\"\n                        className={dangerButtonClass}\n                        onClick={() => handleCancel(reservation)}\n                        disabled={busyId === reservation.id}\n                      >\n                        {busyId === reservation.id ? \"Cancelling…\" : \"Cancel\"}\n                      </button>\n                    </div>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n      )}\n    </section>\n  );\n}\n","filePath":"/workspace/frontend/src/components/ReservationsPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/ReservationsPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/ReservationsPanel.tsx","time":{"start":1794322648443,"end":1794322648454}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f6cd75001fbebEVW1DSgLnL","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","messageID":"msg_1c5f6b21a001GyjG4ME5f595YU"}}
