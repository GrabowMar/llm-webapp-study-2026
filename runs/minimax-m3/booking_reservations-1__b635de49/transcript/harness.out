{"type":"step_start","timestamp":1794322629036,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"id":"prt_1c5f6819f001gm00wxTSbmVb7A","messageID":"msg_1c5f65e1a001JqTUHIyuRqE1mu","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","type":"step-start"}}
{"type":"tool_use","timestamp":1794322629057,"sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","part":{"type":"tool","tool":"write","callID":"call_rOAhKrqtsVpdk9ajIsnOHyBU","state":{"status":"completed","input":{"content":"import { useEffect, useMemo, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { ApiError, createReservation, updateReservation } from \"../api\";\nimport type { Reservation, ReservationInput } from \"../api\";\nimport {\n  SLOT_TIMES,\n  cardClass,\n  cardTitleClass,\n  dangerButtonClass,\n  inputClass,\n  labelClass,\n  primaryButtonClass,\n  secondaryButtonClass,\n} from \"../ui\";\n\ntype Props = {\n  selectedDate: string;\n  editing: Reservation | null;\n  onStartEdit: (reservation: Reservation | null) => void;\n  onChanged: () => void;\n};\n\nconst emptyForm = {\n  name: \"\",\n  email: \"\",\n  time: \"19:00\",\n  party_size: \"2\",\n  notes: \"\",\n};\n\nexport default function BookingForm({ selectedDate, editing, onStartEdit, onChanged }: Props) {\n  const [name, setName] = useState(emptyForm.name);\n  const [email, setEmail] = useState(emptyForm.email);\n  const [date, setDate] = useState(selectedDate);\n  const [time, setTime] = useState(emptyForm.time);\n  const [partySize, setPartySize] = useState(emptyForm.party_size);\n  const [notes, setNotes] = useState(emptyForm.notes);\n  const [message, setMessage] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (!editing) setDate(selectedDate);\n  }, [selectedDate, editing]);\n\n  useEffect(() => {\n    if (editing) {\n      setName(editing.name);\n      setEmail(editing.email);\n      setDate(editing.date);\n      setTime(editing.time);\n      setPartySize(String(editing.party_size));\n      setNotes(editing.notes);\n      setMessage(null);\n      setError(null);\n    }\n  }, [editing]);\n\n  const slotOptions = useMemo(() => {\n    const options = new Set(SLOT_TIMES);\n    options.add(time);\n    return Array.from(options).sort();\n  }, [time]);\n\n  async function handleSubmit(event: FormEvent) {\n    event.preventDefault();\n    setError(null);\n    setMessage(null);\n    setBusy(true);\n    const payload: ReservationInput = {\n      name: name.trim(),\n      email: email.trim(),\n      date,\n      time,\n      party_size: Number(partySize),\n      notes: notes.trim(),\n    };\n    try {\n      if (editing) {\n        await updateReservation(editing.id, payload);\n        setMessage(\"Reservation updated.\");\n      } else {\n        await createReservation(payload);\n        setMessage(\"Reservation confirmed.\");\n      }\n      setName(emptyForm.name);\n      setEmail(emptyForm.email);\n      setNotes(emptyForm.notes);\n      setPartySize(emptyForm.party_size);\n      onStartEdit(null);\n      onChanged();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong. Please try again.\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <section className={cardClass} aria-labelledby=\"booking-heading\">\n      <h2 id=\"booking-heading\" className={cardTitleClass}>\n        {editing ? \"Edit reservation\" : \"Book a table\"}\n      </h2>\n      <p className=\"mt-1 text-sm text-stone-500\">\n        {editing\n          ? `Changing reservation #${editing.id}. Saving replaces every field of the booking.`\n          : \"Each slot seats up to 20 guests in total.\"}\n      </p>\n\n      <form className=\"mt-4 space-y-4\" onSubmit={handleSubmit}>\n        <div className=\"grid gap-4 sm:grid-cols-2\">\n          <div>\n            <label className={labelClass} htmlFor=\"guest-name\">\n              Name\n            </label>\n            <input\n              id=\"guest-name\"\n              name=\"name\"\n              className={inputClass}\n              value={name}\n              onChange={(event) => setName(event.target.value)}\n              placeholder=\"Ada Lovelace\"\n              required\n            />\n          </div>\n          <div>\n            <label className={labelClass} htmlFor=\"guest-email\">\n              Email\n            </label>\n            <input\n              id=\"guest-email\"\n              name=\"email\"\n              type=\"email\"\n              className={inputClass}\n              value={email}\n              onChange={(event) => setEmail(event.target.value)}\n              placeholder=\"ada@example.com\"\n            />\n          </div>\n        </div>\n\n        <div className=\"grid gap-4 sm:grid-cols-3\">\n          <div>\n            <label className={labelClass} htmlFor=\"booking-date\">\n              Date\n            </label>\n            <input\n              id=\"booking-date\"\n              name=\"date\"\n              type=\"date\"\n              className={inputClass}\n              value={date}\n              onChange={(event) => setDate(event.target.value)}\n              required\n            />\n          </div>\n          <div>\n            <label className={labelClass} htmlFor=\"booking-time\">\n              Time\n            </label>\n            <select\n              id=\"booking-time\"\n              name=\"time\"\n              className={inputClass}\n              value={time}\n              onChange={(event) => setTime(event.target.value)}\n              required\n            >\n              {slotOptions.map((slot) => (\n                <option key={slot} value={slot}>\n                  {slot}\n                </option>\n              ))}\n            </select>\n          </div>\n          <div>\n            <label className={labelClass} htmlFor=\"party-size\">\n              Party size\n            </label>\n            <input\n              id=\"party-size\"\n              name=\"party_size\"\n              type=\"number\"\n              min={1}\n              max={20}\n              className={inputClass}\n              value={partySize}\n              onChange={(event) => setPartySize(event.target.value)}\n              required\n            />\n          </div>\n        </div>\n\n        <div>\n          <label className={labelClass} htmlFor=\"notes\">\n            Notes\n          </label>\n          <textarea\n            id=\"notes\"\n            name=\"notes\"\n            rows={3}\n            className={`${inputClass} resize-y`}\n            value={notes}\n            onChange={(event) => setNotes(event.target.value)}\n            placeholder=\"Window table, birthday celebration…\"\n          />\n        </div>\n\n        {error ? (\n          <p role=\"alert\" className=\"rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {error}\n          </p>\n        ) : null}\n        {message ? (\n          <p role=\"status\" className=\"rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700\">\n            {message}\n          </p>\n        ) : null}\n\n        <div className=\"flex flex-wrap gap-3\">\n          <button type=\"submit\" className={primaryButtonClass} disabled={busy}>\n            {busy ? \"Please wait…\" : editing ? \"Save changes\" : \"Book table\"}\n          </button>\n          {editing ? (\n            <button type=\"button\" className={dangerButtonClass} onClick={() => onStartEdit(null)} disabled={busy}>\n              Cancel edit\n            </button>\n          ) : null}\n        </div>\n      </form>\n    </section>\n  );\n}\n\nexport { secondaryButtonClass };\n","filePath":"/workspace/frontend/src/components/BookingForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/BookingForm.tsx","exists":false,"truncated":false},"title":"frontend/src/components/BookingForm.tsx","time":{"start":1794322629031,"end":1794322629039}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5f681a2001Lo8kO7feggrRQK","sessionID":"ses_e3a0f5faeffeaja4roFLLuM44w","messageID":"msg_1c5f65e1a001JqTUHIyuRqE1mu"}}
