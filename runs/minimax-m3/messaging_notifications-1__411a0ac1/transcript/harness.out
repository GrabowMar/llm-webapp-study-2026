{"type":"tool_use","timestamp":1794348850823,"sessionID":"ses_e3881931cffeUV0aIWtfc95zIA","part":{"type":"tool","tool":"write","callID":"call_01a1c786919170738a067fb3","state":{"status":"completed","input":{"content":"import type { Notification, NotificationPage, ReadFilter, Session, User } from \"./types\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(status: number, message: string) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\ntype RequestOptions = {\n  method?: string;\n  body?: unknown;\n  token?: string | null;\n};\n\nasync function request<T>(path: string, options: RequestOptions = {}): Promise<T> {\n  const headers: Record<string, string> = { \"Content-Type\": \"application/json\" };\n  if (options.token) headers.Authorization = `Bearer ${options.token}`;\n\n  const response = await fetch(`/api${path}`, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body === undefined ? undefined : JSON.stringify(options.body),\n  });\n\n  if (response.status === 204) return undefined as T;\n\n  const text = await response.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n\n  if (!response.ok) {\n    const message =\n      data && typeof data === \"object\" && \"error\" in data && typeof data.error === \"string\"\n        ? data.error\n        : `Request failed with status ${response.status}`;\n    throw new ApiError(response.status, message);\n  }\n\n  return data as T;\n}\n\nexport async function register(username: string, password: string): Promise<Session> {\n  const data = await request<{ token: string; user: User }>(\"/auth/register\", {\n    method: \"POST\",\n    body: { username, password },\n  });\n  return { token: data.token, user: data.user };\n}\n\nexport async function login(username: string, password: string): Promise<Session> {\n  const data = await request<{ token: string; user: User }>(\"/auth/login\", {\n    method: \"POST\",\n    body: { username, password },\n  });\n  return { token: data.token, user: data.user };\n}\n\nexport async function fetchMe(token: string): Promise<User> {\n  const data = await request<{ user: User }>(\"/auth/me\", { token });\n  return data.user;\n}\n\nexport async function fetchNotifications(\n  token: string,\n  filters: { read: ReadFilter; type: string; page: number; pageSize: number },\n): Promise<NotificationPage> {\n  const params = new URLSearchParams();\n  if (filters.read === \"read\") params.set(\"read\", \"true\");\n  if (filters.read === \"unread\") params.set(\"read\", \"false\");\n  if (filters.type) params.set(\"type\", filters.type);\n  params.set(\"page\", String(filters.page));\n  params.set(\"page_size\", String(filters.pageSize));\n  const query = params.toString();\n  return request<NotificationPage>(`/notifications?${query}`, { token });\n}\n\nexport async function fetchTypes(token: string): Promise<string[]> {\n  const data = await request<{ types: string[] }>(\"/notifications/types\", { token });\n  return data.types;\n}\n\nexport async function createNotification(\n  token: string,\n  message: string,\n  type: string,\n): Promise<Notification> {\n  return request<Notification>(\"/notifications\", {\n    method: \"POST\",\n    token,\n    body: { message, type },\n  });\n}\n\nexport async function setNotificationRead(\n  token: string,\n  id: number,\n  read: boolean,\n): Promise<Notification> {\n  return request<Notification>(`/notifications/${id}`, {\n    method: \"PATCH\",\n    token,\n    body: { read },\n  });\n}\n\nexport async function deleteNotification(token: string, id: number): Promise<void> {\n  await request<void>(`/notifications/${id}`, { method: \"DELETE\", token });\n}\n\nexport async function markAllRead(token: string): Promise<number> {\n  const data = await request<{ updated: number }>(\"/notifications/read-all\", {\n    method: \"POST\",\n    token,\n  });\n  return data.updated;\n}\n\nexport async function broadcast(token: string, message: string, type: string): Promise<number> {\n  const data = await request<{ delivered: number }>(\"/admin/broadcast\", {\n    method: \"POST\",\n    token,\n    body: { message, type },\n  });\n  return data.delivered;\n}\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794348850786,"end":1794348850797}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7869e530010qhUD1XRlzFPTz","sessionID":"ses_e3881931cffeUV0aIWtfc95zIA","messageID":"msg_1c7868cc3001rBpBYezdnpnXpJ"}}
