\"No notifications match your filters.\"\n+      : \"No notifications yet. Add one to get started.\"}\n   </p>\n ) : (\n   <ul className=\"divide-y divide-slate-100\">\n     {items.map((notification) => (\n","filediff":{"file":"/workspace/frontend/src/App.tsx","patch":"Index: /workspace/frontend/src/App.tsx\n===================================================================\n--- /workspace/frontend/src/App.tsx\n+++ /workspace/frontend/src/App.tsx\n@@ -299,15 +299,15 @@\n {error ? (\n   <p className=\"m-4 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700\">{error}</p>\n ) : null}\n \n-{loading ? (\n+{loading && items.length === 0 ? (\n   <p className=\"px-4 py-10 text-center text-sm text-slate-500\">Loading notifications…</p>\n ) : items.length === 0 ? (\n   <p className=\"px-4 py-10 text-center text-sm text-slate-500\">\n-    {total === 0 && !refreshing\n-      ? \"No notifications yet. Add one to get started.\"\n-      : \"No notifications match your filters.\"}\n+    {refreshing\n+      ? \"No notifications match your filters.\"\n+      : \"No notifications yet. Add one to get started.\"}\n   </p>\n ) : (\n   <ul className=\"divide-y divide-slate-100\">\n     {items.map((notification) => (\n","additions":4,"deletions":4},"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794348957805,"end":1794348957816}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c7884068001C45IcprAsGJ7ix","sessionID":"ses_e3881931cffeUV0aIWtfc95zIA","messageID":"msg_1c788358f001Q0dxV32xtyPiqr"}}
