{"type":"tool_use","timestamp":1794321508651,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"type":"tool","tool":"write","callID":"call_QZeusKIQmKFaOFGR930EzLHk","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport RecipeCard from \"../components/RecipeCard\";\nimport type { CategoryCount, RecipeSummary } from \"../types\";\n\nconst PAGE_SIZE = 9;\n\nexport default function BrowsePage() {\n  const [params, setParams] = useSearchParams();\n  const { user } = useAuth();\n\n  const query = params.get(\"q\") ?? \"\";\n  const category = params.get(\"category\") ?? \"all\";\n  const page = Math.max(1, Number(params.get(\"page\") ?? \"1\") || 1);\n\n  const [items, setItems] = useState<RecipeSummary[]>([]);\n  const [total, setTotal] = useState(0);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [categories, setCategories] = useState<CategoryCount[]>([]);\n  const [searchText, setSearchText] = useState(query);\n\n  const updateParams = useCallback(\n    (changes: Record<string, string | null>) => {\n      const next = new URLSearchParams(params);\n      for (const [key, value] of Object.entries(changes)) {\n        if (value === null || value === \"\") next.delete(key);\n        else next.set(key, value);\n      }\n      setParams(next, { replace: true });\n    },\n    [params, setParams],\n  );\n\n  useEffect(() => {\n    setSearchText(query);\n  }, [query]);\n\n  useEffect(() => {\n    api\n      .categories()\n      .then(setCategories)\n      .catch(() => setCategories([]));\n  }, []);\n\n  useEffect(() => {\n    let active = true;\n    setLoading(true);\n    api\n      .listRecipes({\n        q: query || undefined,\n        category: category !== \"all\" ? category : undefined,\n        page,\n        pageSize: PAGE_SIZE,\n      })\n      .then((result) => {\n        if (!active) return;\n        setItems(result.items);\n        setTotal(result.total);\n        setError(null);\n      })\n      .catch((cause) => {\n        if (!active) return;\n        setError(cause instanceof ApiError ? cause.message : \"Could not load recipes.\");\n      })\n      .finally(() => {\n        if (active) setLoading(false);\n      });\n    return () => {\n      active = false;\n    };\n  }, [query, category, page]);\n\n  useEffect(() => {\n    if (searchText === query) return;\n    const timer = window.setTimeout(() => {\n      updateParams({ q: searchText || null, page: null });\n    }, 300);\n    return () => window.clearTimeout(timer);\n  }, [searchText, query, updateParams]);\n\n  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));\n  const firstResult = total === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;\n  const lastResult = Math.min(page * PAGE_SIZE, total);\n\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-wrap items-end justify-between gap-4\">\n        <div>\n          <h1 className=\"font-display text-3xl font-bold text-stone-900\">Recipes</h1>\n          <p className=\"mt-1 text-sm text-stone-600\">\n            Browse what other cooks are making. Sign in to add your own.\n          </p>\n        </div>\n        {user ? (\n          <Link\n            to=\"/recipes/new\"\n            className=\"rounded-lg bg-stone-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-stone-700\"\n          >\n            Add recipe\n          </Link>\n        ) : (\n          <Link\n            to=\"/signin\"\n            className=\"rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-100\"\n          >\n            Sign in to add recipes\n          </Link>\n        )}\n      </div>\n\n      <div className=\"flex flex-col gap-3 rounded-xl border border-stone-200 bg-white p-4 shadow-sm sm:flex-row\">\n        <div className=\"flex flex-1 flex-col gap-1\">\n          <label htmlFor=\"search\" className=\"text-xs font-medium text-stone-500\">\n            Search titles\n          </label>\n          <input\n            id=\"search\"\n            type=\"search\"\n            value={searchText}\n            placeholder=\"Search for a recipe\"\n            onChange={(event) => setSearchText(event.target.value)}\n            className=\"w-full rounded-lg border border-stone-300 px-3 py-2 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-amber-600 focus:ring-2 focus:ring-amber-200\"\n          />\n        </div>\n        <div className=\"flex flex-col gap-1 sm:w-56\">\n          <label htmlFor=\"category\" className=\"text-xs font-medium text-stone-500\">\n            Category\n          </label>\n          <select\n            id=\"category\"\n            value={category}\n            onChange={(event) => updateParams({ category: event.target.value === \"all\" ? null : event.target.value, page: null })}\n            className=\"rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 outline-none transition focus:border-amber-600 focus:ring-2 focus:ring-amber-200\"\n          >\n            <option value=\"all\">All categories</option>\n            {categories.map((option) => (\n              <option key={option.category} value={option.category}>\n                {option.category} ({option.count})\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {error ? (\n        <p className=\"rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700\">\n          {error}\n        </p>\n      ) : null}\n\n      {loading ? (\n        <p className=\"text-sm text-stone-500\">Loading recipes...</p>\n      ) : items.length === 0 ? (\n        <p className=\"rounded-xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-600\">\n          No recipes found. Try a different search or category.\n        </p>\n      ) : (\n        <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {items.map((recipe) => (\n            <RecipeCard key={recipe.id} recipe={recipe} />\n          ))}\n        </div>\n      )}\n\n      <div className=\"flex flex-wrap items-center justify-between gap-3 text-sm text-stone-600\">\n        <span>\n          {total === 0 ? \"No recipes\" : `Showing ${firstResult}-${lastResult} of ${total}`}\n        </span>\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => updateParams({ page: page > 1 ? String(page - 1) : null })}\n            disabled={page <= 1}\n            className=\"rounded-lg border border-stone-300 px-3 py-1.5 font-medium text-stone-700 transition hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <span className=\"px-1\">\n            Page {page} of {totalPages}\n          </span>\n          <button\n            type=\"button\"\n            onClick={() => updateParams({ page: page < totalPages ? String(page + 1) : null })}\n            disabled={page >= totalPages}\n            className=\"rounded-lg border border-stone-300 px-3 py-1.5 font-medium text-stone-700 transition hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/BrowsePage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/BrowsePage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/BrowsePage.tsx","time":{"start":1794321508624,"end":1794321508634}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e5690b0012Vxkb3NrPEO7fs","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","messageID":"msg_1c5e53a10001CY18vA2kfml0yg"}}
{"type":"step_finish","timestamp":1794321508651,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"id":"prt_1c5e5691d0016pDTSKXIfCA2DT","reason":"tool-calls","messageID":"msg_1c5e53a10001CY18vA2kfml0yg","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","type":"step-finish","tokens":{"total":60040,"input":103,"output":1844,"reasoning":0,"cache":{"write":0,"read":58093}},"cost":0}}
{"type":"step_start","timestamp":1794321517711,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"id":"prt_1c5e58c84001160vkmM1HIinu6","messageID":"msg_1c5e56926001XouX9RypE07LwZ","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","type":"step-start"}}
{"type":"tool_use","timestamp":1794321517730,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"type":"tool","tool":"write","callID":"call_9ocOlDk0OsH7czhBgqmmznX5","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport type { Recipe } from \"../types\";\n\nfunction formatDate(value: string): string {\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return value;\n  return date.toLocaleDateString(undefined, { year: \"numeric\", month: \"long\", day: \"numeric\" });\n}\n\nexport default function RecipePage() {\n  const { id } = useParams();\n  const recipeId = Number(id);\n  const { user } = useAuth();\n  const navigate = useNavigate();\n\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [deleting, setDeleting] = useState(false);\n\n  useEffect(() => {\n    let active = true;\n    if (!Number.isFinite(recipeId)) {\n      setError(\"That recipe does not exist.\");\n      setLoading(false);\n      return () => {\n        active = false;\n      };\n    }\n    setLoading(true);\n    api\n      .getRecipe(recipeId)\n      .then((result) => {\n        if (!active) return;\n        setRecipe(result);\n        setError(null);\n      })\n      .catch((cause) => {\n        if (!active) return;\n        setError(cause instanceof ApiError ? cause.message : \"Could not load this recipe.\");\n      })\n      .finally(() => {\n        if (active) setLoading(false);\n      });\n    return () => {\n      active = false;\n    };\n  }, [recipeId]);\n\n  const isAuthor = Boolean(\n    recipe && user && recipe.author.toLowerCase() === user.username.toLowerCase(),\n  );\n\n  const handleDelete = async () => {\n    if (!recipe) return;\n    const confirmed = window.confirm(`Delete \"${recipe.title}\"? This cannot be undone.`);\n    if (!confirmed) return;\n    setDeleting(true);\n    try {\n      await api.deleteRecipe(recipe.id);\n      navigate(\"/\", { replace: true });\n    } catch (cause) {\n      setError(cause instanceof ApiError ? cause.message : \"Could not delete this recipe.\");\n      setDeleting(false);\n    }\n  };\n\n  if (loading) {\n    return <p className=\"text-sm text-stone-500\">Loading recipe...</p>;\n  }\n\n  if (error || !recipe) {\n    return (\n      <div className=\"flex flex-col gap-4\">\n        <p className=\"rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700\">\n          {error ?? \"Recipe not found.\"}\n        </p>\n        <Link to=\"/\" className=\"text-sm font-medium text-amber-700 hover:underline\">\n          Back to all recipes\n        </Link>\n      </div>\n    );\n  }\n\n  return (\n    <article className=\"flex flex-col gap-8\">\n      <div className=\"flex flex-col gap-4\">\n        <Link to=\"/\" className=\"w-fit text-sm font-medium text-amber-700 hover:underline\">\n          Back to all recipes\n        </Link>\n        <div className=\"flex flex-wrap items-start justify-between gap-4\">\n          <div>\n            <h1 className=\"font-display text-3xl font-bold text-stone-900\">{recipe.title}</h1>\n            <div className=\"mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-stone-600\">\n              <span className=\"rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900\">\n                {recipe.category}\n              </span>\n              <span>{recipe.prep_minutes} min prep</span>\n              <span>Serves {recipe.servings}</span>\n              <span>By {recipe.author}</span>\n              <span>Added {formatDate(recipe.created_at)}</span>\n            </div>\n          </div>\n          {isAuthor ? (\n            <div className=\"flex gap-2\">\n              <Link\n                to={`/recipes/${recipe.id}/edit`}\n                className=\"rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-100\"\n              >\n                Edit\n              </Link>\n              <button\n                type=\"button\"\n                onClick={handleDelete}\n                disabled={deleting}\n                className=\"rounded-lg border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60\"\n              >\n                {deleting ? \"Deleting...\" : \"Delete\"}\n              </button>\n            </div>\n          ) : null}\n        </div>\n      </div>\n\n      <div className=\"grid gap-8 lg:grid-cols-3\">\n        <section className=\"rounded-xl border border-stone-200 bg-white p-6 shadow-sm lg:col-span-1\">\n          <h2 className=\"font-display text-xl font-bold text-stone-900\">Ingredients</h2>\n          {recipe.ingredients.length === 0 ? (\n            <p className=\"mt-3 text-sm text-stone-500\">No ingredients listed.</p>\n          ) : (\n            <ul className=\"mt-3 flex list-disc flex-col gap-2 pl-5 text-sm text-stone-700\">\n              {recipe.ingredients.map((ingredient, index) => (\n                <li key={index}>{ingredient}</li>\n              ))}\n            </ul>\n          )}\n        </section>\n\n        <section className=\"rounded-xl border border-stone-200 bg-white p-6 shadow-sm lg:col-span-2\">\n          <h2 className=\"font-display text-xl font-bold text-stone-900\">Instructions</h2>\n          {recipe.instructions ? (\n            <p className=\"mt-3 whitespace-pre-line text-sm leading-relaxed text-stone-700\">\n              {recipe.instructions}\n            </p>\n          ) : (\n            <p className=\"mt-3 text-sm text-stone-500\">No instructions yet.</p>\n          )}\n        </section>\n      </div>\n    </article>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipePage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipePage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipePage.tsx","time":{"start":1794321517707,"end":1794321517713}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e58c86001Y2Ql8VcQZULfwL","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","messageID":"msg_1c5e56926001XouX9RypE07LwZ"}}
{"type":"step_finish","timestamp":1794321517730,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"id":"prt_1c5e58c94001ITSmOZTA2PlOvB","reason":"tool-calls","messageID":"msg_1c5e56926001XouX9RypE07LwZ","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","type":"step-finish","tokens":{"total":61495,"input":1864,"output":1436,"reasoning":0,"cache":{"write":0,"read":58195}},"cost":0}}
{"type":"step_start","timestamp":1794321529911,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"id":"prt_1c5e5bbf6001dHpQAHlKODOQ3F","messageID":"msg_1c5e58c9d0018D4we4jcXp6Jpa","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","type":"step-start"}}
{"type":"text","timestamp":1794321529911,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"id":"prt_1c5e5bbf9001ZV2wevfnihfDsw","messageID":"msg_1c5e58c9d0018D4we4jcXp6Jpa","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","type":"text","text":"<think>Now the RecipeFormPage (create/edit) and the AuthPage.\n\nRecipeFormPage:\n```tsx\nimport { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport RecipeForm from \"../components/RecipeForm\";\nimport type { Recipe } from \"../types\";\n\nexport default function RecipeFormPage({ mode }: { mode: \"create\" | \"edit\" }) {\n  const { id } = useParams();\n  const recipeId = Number(id);\n  const { user, ready } = useAuth();\n  const navigate = useNavigate();\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [categories, setCategories] = useState<string[]>([]);\n  const [loading, setLoading] = useState(mode === \"edit\");\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => { api.categories().then(list => setCategories(list.map(c => c.category))).catch(() => {}); }, []);\n\n  useEffect(() => {\n    if (mode !== \"edit\") return;\n    api.getRecipe(recipeId).then(setRecipe).catch(...).finally(() => setLoading(false));\n  }, [mode, recipeId]);\n\n  // redirect to sign in if not authenticated\n  useEffect(() => {\n    if (ready && !user) navigate(\"/signin\", { replace: true });\n  }, [ready, user, navigate]);\n\n  const handleSubmit = async (input: RecipeInput) => {\n    if (mode === \"create\") {\n      const created = await api.createRecipe(input);\n      navigate(`/recipes/${created.id}`);\n    } else {\n      const updated = await api.updateRecipe(recipeId, input);\n      navigate(`/recipes/${updated.id}`);\n    }\n  };\n```\n\nCareful: `ready` and `user` — the auth provider sets ready after the /me check.\n\nFor the edit mode, if the user is not the author, the API returns 403 → show an error message.\n\nLet me write it.\n\nAuthPage: mode \"signin\" | \"register\".\n\nAlso a NotFound page for unknown routes — I'll handle it inline in App.tsx.\n\nLet me write both pages.</think>\n\n","time":{"start":1794321529849,"end":1794321529873}}}
{"type":"tool_use","timestamp":1794321529912,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"type":"tool","tool":"write","callID":"call_HOpz9Wm05pvKbQ8DD31nFryd","state":{"status":"completed","input":{"content":"import { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport RecipeForm from \"../components/RecipeForm\";\nimport type { Recipe, RecipeInput } from \"../types\";\n\ninterface RecipeFormPageProps {\n  mode: \"create\" | \"edit\";\n}\n\nexport default function RecipeFormPage({ mode }: RecipeFormPageProps) {\n  const { id } = useParams();\n  const recipeId = Number(id);\n  const { user, ready } = useAuth();\n  const navigate = useNavigate();\n\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [categories, setCategories] = useState<string[]>([]);\n  const [loading, setLoading] = useState(mode === \"edit\");\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    api\n      .categories()\n      .then((list) => setCategories(list.map((entry) => entry.category)))\n      .catch(() => setCategories([]));\n  }, []);\n\n  useEffect(() => {\n    if (ready && !user) navigate(\"/signin\", { replace: true });\n  }, [ready, user, navigate]);\n\n  useEffect(() => {\n    if (mode !== \"edit\") return;\n    let active = true;\n    api\n      .getRecipe(recipeId)\n      .then((result) => {\n        if (!active) return;\n        setRecipe(result);\n        setError(null);\n      })\n      .catch((cause) => {\n        if (!active) return;\n        setError(cause instanceof ApiError ? cause.message : \"Could not load this recipe.\");\n      })\n      .finally(() => {\n        if (active) setLoading(false);\n      });\n    return () => {\n      active = false;\n    };\n  }, [mode, recipeId]);\n\n  const handleSubmit = async (input: RecipeInput) => {\n    if (mode === \"create\") {\n      const created = await api.createRecipe(input);\n      navigate(`/recipes/${created.id}`);\n      return;\n    }\n    const updated = await api.updateRecipe(recipeId, input);\n    navigate(`/recipes/${updated.id}`);\n  };\n\n  if (mode === \"edit\" && loading) {\n    return <p className=\"text-sm text-stone-500\">Loading recipe...</p>;\n  }\n\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-col gap-2\">\n        <Link to=\"/\" className=\"w-fit text-sm font-medium text-amber-700 hover:underline\">\n          Back to all recipes\n        </Link>\n        <h1 className=\"font-display text-3xl font-bold text-stone-900\">\n          {mode === \"create\" ? \"Add a recipe\" : \"Edit recipe\"}\n        </h1>\n      </div>\n\n      {error ? (\n        <p className=\"rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700\">\n          {error}\n        </p>\n      ) : null}\n\n      <RecipeForm\n        initial={mode === \"edit\" ? recipe : null}\n        categories={categories}\n        submitLabel={mode === \"create\" ? \"Publish recipe\" : \"Save changes\"}\n        onSubmit={handleSubmit}\n      />\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/RecipeFormPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/RecipeFormPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/RecipeFormPage.tsx","time":{"start":1794321529860,"end":1794321529881}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5e5bbfd001ttyI6ohhYYXnLO","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","messageID":"msg_1c5e58c9d0018D4we4jcXp6Jpa"}}
{"type":"tool_use","timestamp":1794321529912,"sessionID":"ses_e3a21d981ffebd45Va6soahg7t","part":{"type":"tool","tool":"write","callID":"call_6MVbqC4VTcnxrERH0Fof35UV","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport TextField from \"../components/TextField\";\n\ninterface AuthPageProps {\n  mode: \"signin\" | \"register\";\n}\n\nexport default function AuthPage({ mode }: AuthPageProps) {\n  const { login, register } = useAuth();\n  const navigate = useNavigate();\n\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});\n  const [formError, setFormError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const isRegister = mode === \"register\";\n\n  const handleSubmit = async (event: FormEvent) => {\n    event.preventDefault();\n    setFormError(null);\n    setFieldErrors({});\n    setBusy(true);\n    try {\n      if (isRegister) {\n        await register(username.trim(), password);\n      } else {\n        await login(username.trim(), password);\n      }\n      navigate(\"/\", { replace: true });\n    } catch (error) {\n      if (error instanceof ApiError) {\n        setFieldErrors(error.fieldErrors);\n        if (Object.keys(error.fieldErrors).length === 0) setFormError(error.message);\n      } else {\n        setFormError(\"Something went wrong. Please try again.\");\n      }\n      setBusy(false);\n    }\n  };\n\n  return (\n    <div className=\"mx-auto flex w-full max-w-md flex-col gap-6\">\n      <div className=\"flex flex-col gap-2 text-center\">\n        <h1 className=\"font-display text-3xl font-bold text-stone-900\">\n          {isRegister ? \"Create an account\" : \"Sign in\"}\n        </h1>\n        <p className=\"text-sm text-stone-600\">\n          {isRegister\n            ? \"Register to add recipes and manage the ones you wrote.\"\n            : \"Sign in to add recipes and manage the ones you wrote.\"}\n        </p>\n      </div>\n\n      {formError ? (\n        <p className=\"rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700\">\n          {formError}\n        </p>\n      ) : null}\n\n      <form\n        onSubmit={handleSubmit}\n        className=\"flex flex-col gap-5 rounded-xl border border-stone-200 bg-white p-6 shadow-sm\"\n      >\n        <TextField\n          id=\"username\"\n          label=\"Username\"\n          value={username}\n          onChange={setUsername}\n          error={fieldErrors.username}\n          placeholder=\"your-name\"\n        />\n        <TextField\n          id=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          value={password}\n          onChange={setPassword}\n          error={fieldErrors.password}\n          placeholder=\"your password\"\n        />\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"rounded-lg bg-stone-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-stone-700 disabled:cursor-not-allowed disabled:opacity-60\"\n        >\n          {busy ? \"Please wait...\" : isRegister ? \"Create account\" : \"Sign in\"}\n        </button>\n      </form>\n\n      <p className=\"text-center text-sm text-stone-600\">\n        {isRegister ? \"Already have an account? \" : \"New here? \"}\n        <Link\n          to={isRegister ? \"/signin\" : \"/register\"}\n          className=\"font-semibold text-amber-700 hover:underline\"\n        >\n          {isRegister ? \"Sign in\" : \"Create an account\"}\n        </Link>\n      </p>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/pages/AuthPage.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/pages/AuthPage.tsx","exists":false,"truncated":false},"title":"frontend/src/pages/AuthPage.tsx","time":{"start":1794321529870,"end":1794321529887}},"id":"prt_1c5e5bc070019JAjvZ38jXAzt6","sessionID":"ses_e3a21d981ffebd45Va6soahg7t","messageID":"msg_1c5e58c9d0018D4we4jcXp6Jpa"}}
