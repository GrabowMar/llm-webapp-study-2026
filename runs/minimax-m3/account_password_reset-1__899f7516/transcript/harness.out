\n     return f\"{request.host_url.rstrip('/')}/reset?token={token}\"\n","filediff":{"file":"/workspace/backend/app.py","patch":"Index: /workspace/backend/app.py\n===================================================================\n--- /workspace/backend/app.py\n+++ /workspace/backend/app.py\n@@ -80,20 +80,16 @@\n     )\n     return token\n \n \n-def start_session(account_id: int) -> str:\n-    return create_session(account_id)\n-\n-\n def delete_other_sessions(account_id: int, keep_token: str | None = None) -> None:\n     if keep_token is None:\n         g.db.execute(\"DELETE FROM sessions WHERE account_id = ?\", (account_id,))\n-    else:\n-        g.db.execute(\n-            \"DELETE FROM sessions WHERE account_id = ? AND token != ?\",\n-            (account_id, keep_token),\n-        )\n+        return\n+    g.db.execute(\n+        \"DELETE FROM sessions WHERE account_id = ? AND token != ?\",\n+        (account_id, keep_token),\n+    )\n \n \n def reset_link(token: str) -> str:\n     return f\"{request.host_url.rstrip('/')}/reset?token={token}\"\n","additions":5,"deletions":9},"truncated":false},"title":"backend/app.py","time":{"start":1794314544432,"end":1794314544460}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c57b2528001NZlqxuQK4TmP42","sessionID":"ses_e3a86b1d7ffefMSIuRfahpJxKE","messageID":"msg_1c57b1398001hwiyS0wPc04Ef2"}}
