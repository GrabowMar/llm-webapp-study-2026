{"type":"text","timestamp":1794341733789,"sessionID":"ses_e38f2e3bfffecd83FRQMpSQm98","part":{"id":"prt_1c71a058b001hO30crCKExcgvm","messageID":"msg_1c719ca81001X7h6J4qLHY5Xjs","sessionID":"ses_e38f2e3bfffecd83FRQMpSQm98","type":"text","text":"Now the upload form component:","time":{"start":1794341733771,"end":1794341733785}}}
{"type":"tool_use","timestamp":1794341733811,"sessionID":"ses_e38f2e3bfffecd83FRQMpSQm98","part":{"type":"tool","tool":"write","callID":"call-d26d53f6-0528-4dfe-91f5-88400d3e53f1","state":{"status":"completed","input":{"content":"import { useEffect, useRef, useState } from \"react\";\nimport { ApiError, uploadImage } from \"../api\";\n\ninterface UploadFormProps {\n  token: string;\n  onUploaded: () => void;\n}\n\nconst ACCEPTED_TYPES = [\"image/png\", \"image/jpeg\"];\nconst ACCEPTED_EXTENSIONS = [\".png\", \".jpg\", \".jpeg\"];\n\nexport default function UploadForm({ token, onUploaded }: UploadFormProps) {\n  const [file, setFile] = useState<File | null>(null);\n  const [title, setTitle] = useState(\"\");\n  const [previewUrl, setPreviewUrl] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n  const inputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    if (!file) {\n      setPreviewUrl(null);\n      return;\n    }\n    const url = URL.createObjectURL(file);\n    setPreviewUrl(url);\n    return () => URL.revokeObjectURL(url);\n  }, [file]);\n\n  function handleFileChange(event: React.ChangeEvent<HTMLInputElement>) {\n    setError(null);\n    const selected = event.target.files?.[0] ?? null;\n    if (!selected) {\n      setFile(null);\n      return;\n    }\n    if (!isAccepted(selected)) {\n      setFile(null);\n      setError(\"Only PNG and JPEG images can be uploaded.\");\n      if (inputRef.current) {\n        inputRef.current.value = \"\";\n      }\n      return;\n    }\n    setFile(selected);\n  }\n\n  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {\n    event.preventDefault();\n    if (!file) {\n      setError(\"Choose a PNG or JPEG image to upload.\");\n      return;\n    }\n    setBusy(true);\n    setError(null);\n    try {\n      const data = await readAsBase64(file);\n      await uploadImage(token, {\n        filename: file.name,\n        data,\n        ...(title.trim() ? { title: title.trim() } : {}),\n      });\n      setFile(null);\n      setTitle(\"\");\n      if (inputRef.current) {\n        inputRef.current.value = \"\";\n      }\n      onUploaded();\n    } catch (caught) {\n      setError(\n        caught instanceof ApiError\n          ? caught.message\n          : \"The upload failed. Please try again.\",\n      );\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form\n      onSubmit={handleSubmit}\n      className=\"rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6\"\n    >\n      <h2 className=\"text-lg font-semibold text-slate-900\">Upload an image</h2>\n      <p className=\"mt-1 text-sm text-slate-500\">PNG or JPEG, up to 32 MB.</p>\n\n      <div className=\"mt-4 grid gap-4 sm:grid-cols-2\">\n        <div>\n          <label\n            htmlFor=\"image-file\"\n            className=\"mb-1 block text-sm font-medium text-slate-700\"\n          >\n            Image\n          </label>\n          <input\n            ref={inputRef}\n            id=\"image-file\"\n            name=\"file\"\n            type=\"file\"\n            accept={[...ACCEPTED_TYPES, ...ACCEPTED_EXTENSIONS].join(\",\")}\n            onChange={handleFileChange}\n            className=\"block w-full cursor-pointer rounded-lg border border-slate-300 text-sm text-slate-600 file:mr-3 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-4 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200\"\n          />\n        </div>\n\n        <div>\n          <label\n            htmlFor=\"image-title\"\n            className=\"mb-1 block text-sm font-medium text-slate-700\"\n          >\n            Title <span className=\"font-normal text-slate-400\">(optional)</span>\n          </label>\n          <input\n            id=\"image-title\"\n            name=\"title\"\n            type=\"text\"\n            value={title}\n            maxLength={200}\n            onChange={(event) => setTitle(event.target.value)}\n            className=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200\"\n            placeholder=\"A short description\"\n          />\n        </div>\n      </div>\n\n      {previewUrl ? (\n        <div className=\"mt-4 flex items-center gap-4 rounded-xl border border-slate-200 bg-slate-50 p-3\">\n          <img\n            src={previewUrl}\n            alt=\"Selected image preview\"\n            className=\"h-20 w-20 shrink-0 rounded-lg object-cover\"\n          />\n          <div className=\"min-w-0\">\n            <p className=\"truncate text-sm font-medium text-slate-800\">\n              {file?.name}\n            </p>\n            <p className=\"text-xs text-slate-500\">\n              {file ? formatBytes(file.size) : \"\"}\n            </p>\n          </div>\n        </div>\n      ) : null}\n\n      {error ? (\n        <p\n          role=\"alert\"\n          className=\"mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\"\n        >\n          {error}\n        </p>\n      ) : null}\n\n      <button\n        type=\"submit\"\n        disabled={busy || !file}\n        className=\"mt-4 w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto\"\n      >\n        {busy ? \"Uploading…\" : \"Upload\"}\n      </button>\n    </form>\n  );\n}\n\nfunction isAccepted(file: File): boolean {\n  if (ACCEPTED_TYPES.includes(file.type)) {\n    return true;\n  }\n  const name = file.name.toLowerCase();\n  return ACCEPTED_EXTENSIONS.some((extension) => name.endsWith(extension));\n}\n\nfunction readAsBase64(file: File): Promise<string> {\n  return new Promise((resolve, reject) => {\n    const reader = new FileReader();\n    reader.onerror = () => reject(new Error(\"The file could not be read.\"));\n    reader.onload = () => {\n      const result = typeof reader.result === \"string\" ? reader.result : \"\";\n      const comma = result.indexOf(\",\");\n      resolve(comma >= 0 ? result.slice(comma + 1) : result);\n    };\n    reader.readAsDataURL(file);\n  });\n}\n\nfunction formatBytes(bytes: number): string {\n  if (bytes < 1024) return `${bytes} B`;\n  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n}\n","filePath":"/workspace/frontend/src/components/UploadForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/UploadForm.tsx","exists":false,"truncated":false},"title":"frontend/src/components/UploadForm.tsx","time":{"start":1794341733782,"end":1794341733793}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c71a0591001L02Ytcim581xYM","sessionID":"ses_e38f2e3bfffecd83FRQMpSQm98","messageID":"msg_1c719ca81001X7h6J4qLHY5Xjs"}}
