 2.4, 2.3.1, 2.3, 2.2.1, 2.2.0, 2.1.1, 2.1.0, 2.0.3, 2.0.2, 2.0.1, 2.0, 1.7\n=== mistune ===\nmistune (3.4.0)\nAvailable versions: 3.4.0, 3.3.4, 3.3.3, 3.3.2, 3.3.1, 3.3.0, 3.2.1, 3.2.0, 3.1.4, 3.1.3, 3.1.2, 3.1.1, 3.1.0, 3.0.2, 3.0.1, 3.0.0, 2.1.0, 2.0.5, 2.0.4, 2.0.3, 2.0.2, 2.0.1, 2.0.0, 0.8.4, 0.8.3, 0.8.2, 0.8.1, 0.8, 0.7.4, 0.7.3, 0.7.2, 0.7.1, 0.7, 0.6, 0.5.1, 0.5, 0.4.1, 0.4, 0.3.1, 0.3.0, 0.2.0, 0.1.0\n=== markdown-it-py ===\nmarkdown-it-py (4.3.0)\nAvailable versions: 4.3.0, 4.2.0, 4.1.0, 4.0.0, 3.0.0, 2.2.0, 2.1.0, 2.0.1, 2.0.0, 1.1.0, 1.0.0, 0.6.2, 0.6.1, 0.6.0, 0.5.8, 0.5.7, 0.5.6, 0.5.5, 0.5.4, 0.5.3, 0.5.2, 0.5.1, 0.5.0, 0.4.9, 0.4.8, 0.4.7, 0.4.6, 0.4.5, 0.4.4, 0.4.3, 0.4.2, 0.4.1, 0.4.0, 0.3.3, 0.3.2, 0.3.1, 0.3.0, 0.2.3, 0.2.2, 0.2.1, 0.2.0, 0.1.1, 0.1.0\n","exit":0,"truncated":false},"title":"pip index versions markdown 2>&1 | head -5; echo \"=== mistune ===\"; pip index versions mistune 2>&1 | head -5; echo \"=== markdown-it-py ===\"; pip index versions markdown-it-py 2>&1 | head -5","time":{"start":1794373435527,"end":1794373438540}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8fdc081001496RD9Pf0Y3lVB","sessionID":"ses_e3702db50ffeNnzuAtZolPliQC","messageID":"msg_1c8fdb40b001tUcubT513r3ZtP"}}
