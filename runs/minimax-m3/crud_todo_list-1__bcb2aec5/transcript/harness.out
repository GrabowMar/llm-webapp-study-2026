{"type":"text","timestamp":1794319116459,"sessionID":"ses_e3a41e784ffewW0a3KF7BSFPAW","part":{"id":"prt_1c5c0e899001Ag86lrIkJgA6bt","messageID":"msg_1c5c0c821001UwFQ0DW8omDSC9","sessionID":"ses_e3a41e784ffewW0a3KF7BSFPAW","type":"text","text":"<think>Now security.py: password hashing, token creation, `require_auth` decorator, current_user.</think>\n\n","time":{"start":1794319116441,"end":1794319116455}}}
{"type":"tool_use","timestamp":1794319116479,"sessionID":"ses_e3a41e784ffewW0a3KF7BSFPAW","part":{"type":"tool","tool":"write","callID":"call_01a1c5c0d18e77eda1953777","state":{"status":"completed","input":{"content":"\"\"\"Password hashing, bearer tokens and the authentication guard.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport hashlib\nimport hmac\nimport secrets\n\nfrom flask import g, jsonify, request\n\nfrom db import execute, query_one, utc_now\n\nALGORITHM = \"pbkdf2_sha256\"\nITERATIONS = 120_000\nSALT_BYTES = 16\n\n\ndef hash_password(password: str) -> str:\n    \"\"\"Hash a plaintext password with PBKDF2-HMAC-SHA256 and a random salt.\"\"\"\n\n    salt = secrets.token_bytes(SALT_BYTES)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, ITERATIONS)\n    return f\"{ALGORITHM}${ITERATIONS}${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password: str, stored: str) -> bool:\n    \"\"\"Check a plaintext password against a stored hash in constant time.\"\"\"\n\n    try:\n        algorithm, iterations, salt_hex, digest_hex = stored.split(\"$\")\n        salt = bytes.fromhex(salt_hex)\n        expected = int(iterations)\n    except (AttributeError, TypeError, ValueError):\n        return False\n    if algorithm != ALGORITHM:\n        return False\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(\"utf-8\"), salt, expected)\n    return hmac.compare_digest(digest.hex(), digest_hex)\n\n\ndef create_session(user_id: int) -> str:\n    \"\"\"Create a bearer token for a user and store it.\"\"\"\n\n    token = secrets.token_urlsafe(32)\n    execute(\n        \"INSERT INTO sessions (token, user_id, created_at) VALUES (?, ?, ?)\",\n        (token, user_id, utc_now()),\n    )\n    return token\n\n\ndef delete_session(token: str) -> None:\n    execute(\"DELETE FROM sessions WHERE token = ?\", (token,))\n\n\ndef user_for_token(token: str) -> sqlite3.Row | None:  # type: ignore[name-defined]\n    return query_one(\n        \"\"\"\n        SELECT users.id, users.username, users.created_at\n          FROM sessions\n          JOIN users ON users.id = sessions.user_id\n         WHERE sessions.token = ?\n        \"\"\",\n        (token,),\n    )\n\n\ndef bearer_token() -> str | None:\n    \"\"\"Extract the bearer token from the request headers.\"\"\"\n\n    header = request.headers.get(\"Authorization\", \"\")\n    if not header:\n        return None\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\":\n        return None\n    token = token.strip()\n    return token or None\n\n\ndef current_user() -> sqlite3.Row | None:\n    \"\"\"Return the user row of the signed-in request, if any.\"\"\"\n\n    token = bearer_token()\n    if not token:\n        return None\n    user = user_for_token(token)\n    if user is None:\n        return None\n    g.current_token = token\n    return user\n\n\ndef require_auth(view):\n    \"\"\"Reject requests that do not carry a valid bearer token.\"\"\"\n\n    @functools.wraps(view)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return jsonify({\"error\": \"authentication required\"}), 401\n        g.user = user\n        return view(*args, **kwargs)\n\n    return wrapper\n","filePath":"/workspace/backend/security.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/security.py","exists":false,"truncated":false},"title":"backend/security.py","time":{"start":1794319116451,"end":1794319116462}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c5c0e89c001j1bpOWW2wcMp9t","sessionID":"ses_e3a41e784ffewW0a3KF7BSFPAW","messageID":"msg_1c5c0c821001UwFQ0DW8omDSC9"}}
