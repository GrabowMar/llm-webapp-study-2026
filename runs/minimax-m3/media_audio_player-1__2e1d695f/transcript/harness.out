pi/tracks/{tid}/plays')\nprint('plays', r.status_code, r.json)\nr = c.get('/api/tracks?q=song')\nprint('search', r.status_code, r.json['total'])\nr = c.get('/api/tracks?page=1&page_size=1')\nprint('paged', r.status_code, r.json['total'], r.json['page'], r.json['page_size'], len(r.json['items']))\nr = c.get(f'/api/tracks/{tid}')\nprint('get', r.status_code, r.json)\nr = c.delete(f'/api/tracks/{tid}', headers=h)\nprint('del', r.status_code, r.json)\nr = c.get('/api/tracks/999')\nprint('404', r.status_code, r.json)\nr = c.get('/api/nope')\nprint('api404', r.status_code, r.json)\nprint('me', c.get('/api/auth/me', headers=h).status_code, c.get('/api/auth/me', headers=h).json)\nr = c.post('/api/tracks', json={'title':'Bob','artist':'X','url':'http://example.com/b.mp3','duration':'3:45'}, headers=h)\nprint('strdur', r.status_code, r.json)\n\"\n","time":{"start":1794377352678,"end":1794377353090}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c93985df001R4ZLm2Tpf3O3bH","sessionID":"ses_e36c92cabffe1cdrQ9t4Hp4h3a","messageID":"msg_1c9396310001hhFcjoVv76eFwv"}}
