api/health; echo; curl -s -o /dev/null -w \"%{http_code} %{content_type}\\n\" localhost:8000/; curl -s localhost:8000/ | head -20","time":{"start":1794377618026,"end":1794377621081}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c93d9261001chIE8DlZ5YtNAA","sessionID":"ses_e36c92cabffe1cdrQ9t4Hp4h3a","messageID":"msg_1c93d86f200187nch0W5XoG3Rj"}}
