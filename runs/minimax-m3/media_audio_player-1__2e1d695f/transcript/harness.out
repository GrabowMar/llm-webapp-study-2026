{"type":"tool_use","timestamp":1794377279789,"sessionID":"ses_e36c92cabffe1cdrQ9t4Hp4h3a","part":{"type":"tool","tool":"write","callID":"call_XCUiXegSBqzzyFUKA8vZe6ei","state":{"status":"completed","input":{"content":"\"\"\"SQLite storage for the audio library.\n\nThe database lives under ``./data`` (relative to the process working\ndirectory) so that it survives restarts.  Every request gets its own\nconnection; writes are committed immediately.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).expanduser()\nDB_PATH = Path(os.environ.get(\"DATABASE_PATH\", str(DATA_DIR / \"app.db\")))\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id            INTEGER PRIMARY KEY AUTOINCREMENT,\n    username      TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at    TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS sessions (\n    token_hash TEXT PRIMARY KEY,\n    user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS tracks (\n    id               INTEGER PRIMARY KEY AUTOINCREMENT,\n    title            TEXT NOT NULL,\n    artist           TEXT NOT NULL DEFAULT '',\n    url              TEXT NOT NULL,\n    duration         TEXT,\n    duration_seconds REAL,\n    play_count       INTEGER NOT NULL DEFAULT 0,\n    created_at       TEXT NOT NULL,\n    user_id          INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\n\nCREATE INDEX IF NOT EXISTS idx_tracks_created_at ON tracks(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS idx_tracks_user_id ON tracks(user_id);\n\"\"\"\n\n\ndef utc_now() -> str:\n    \"\"\"Current time as an ISO-8601 UTC string (sortable as text).\"\"\"\n\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\")\n\n\ndef connect() -> sqlite3.Connection:\n    \"\"\"Open a new connection with sensible durability settings.\"\"\"\n\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(str(DB_PATH), timeout=15.0, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA journal_mode=WAL\")\n    conn.execute(\"PRAGMA foreign_keys=ON\")\n    conn.execute(\"PRAGMA busy_timeout=15000\")\n    return conn\n\n\ndef init_db() -> None:\n    \"\"\"Create the schema if it does not exist yet.\"\"\"\n\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.executescript(SCHEMA)\n    finally:\n        conn.close()\n","filePath":"/workspace/backend/db.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/db.py","exists":false,"truncated":false},"title":"backend/db.py","time":{"start":1794377279747,"end":1794377279768}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c93868fa001h5kcV5u4leDXih","sessionID":"ses_e36c92cabffe1cdrQ9t4Hp4h3a","messageID":"msg_1c938512c001WveDOseIeDwPod"}}
