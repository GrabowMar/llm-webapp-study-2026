{"type":"step_start","timestamp":1794366141344,"sessionID":"ses_e377d0badffet7LSn1dj9cFwue","part":{"id":"prt_1c88e7393001cdHdHR4p0XAgs0","messageID":"msg_1c88e4ea10012OtwgHW076wrQI","sessionID":"ses_e377d0badffet7LSn1dj9cFwue","type":"step-start"}}
{"type":"tool_use","timestamp":1794366141366,"sessionID":"ses_e377d0badffet7LSn1dj9cFwue","part":{"type":"tool","tool":"write","callID":"call-872d5eb0-082a-415b-b30f-c99870f4e80e","state":{"status":"completed","input":{"content":"import type { Post, PostInput, PostPage, RegisterResponse, User } from \"./types\";\n\nconst TOKEN_KEY = \"inkwell.token\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\nexport function readToken(): string | null {\n  try {\n    return window.localStorage.getItem(TOKEN_KEY);\n  } catch {\n    return null;\n  }\n}\n\nexport function storeToken(token: string | null): void {\n  try {\n    if (token === null) {\n      window.localStorage.removeItem(TOKEN_KEY);\n    } else {\n      window.localStorage.setItem(TOKEN_KEY, token);\n    }\n  } catch {\n    /* storage unavailable: the session simply does not survive a reload */\n  }\n}\n\ninterface RequestOptions {\n  method?: string;\n  body?: unknown;\n  auth?: boolean;\n}\n\nasync function request<T>(path: string, options: RequestOptions = {}): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = readToken();\n  if (token && options.auth !== false) {\n    headers.Authorization = `Bearer ${token}`;\n  }\n\n  let response: Response;\n  try {\n    response = await fetch(path, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body === undefined ? undefined : JSON.stringify(options.body),\n    });\n  } catch {\n    throw new ApiError(\"Could not reach the server. Please try again.\", 0);\n  }\n\n  const text = await response.text();\n  let payload: unknown = null;\n  if (text) {\n    try {\n      payload = JSON.parse(text);\n    } catch {\n      payload = text;\n    }\n  }\n\n  if (!response.ok) {\n    const message =\n      payload && typeof payload === \"object\" && \"error\" in payload\n        ? String((payload as { error: unknown }).error)\n        : \"The request could not be completed.\";\n    throw new ApiError(message, response.status);\n  }\n  return payload as T;\n}\n\nexport interface ListParams {\n  q?: string;\n  tag?: string;\n  author?: string;\n  page?: number;\n  page_size?: number;\n}\n\nfunction query(params: ListParams): string {\n  const search = new URLSearchParams();\n  if (params.q) search.set(\"q\", params.q);\n  if (params.tag) search.set(\"tag\", params.tag);\n  if (params.author) search.set(\"author\", params.author);\n  if (params.page && params.page > 1) search.set(\"page\", String(params.page));\n  if (params.page_size) search.set(\"page_size\", String(params.page_size));\n  const encoded = search.toString();\n  return encoded ? `?${encoded}` : \"\";\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<RegisterResponse>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    }),\n\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n      auth: false,\n    }),\n\n  logout: () => request<{ ok: boolean }>(\"/api/auth/logout\", { method: \"POST\" }),\n\n  me: () => request<User>(\"/api/auth/me\"),\n\n  listPosts: (params: ListParams) => request<PostPage>(`/api/posts${query(params)}`),\n\n  getPost: (id: number) => request<Post>(`/api/posts/${id}`),\n\n  createPost: (input: PostInput) =>\n    request<Post>(\"/api/posts\", { method: \"POST\", body: input }),\n\n  updatePost: (id: number, input: PostInput) =>\n    request<Post>(`/api/posts/${id}`, { method: \"PUT\", body: input }),\n\n  deletePost: (id: number) => request<null>(`/api/posts/${id}`, { method: \"DELETE\" }),\n\n  togglePost: (id: number) =>\n    request<{ ok: boolean; hidden: boolean; post: Post }>(`/api/admin/posts/${id}/toggle`, {\n      method: \"POST\",\n    }),\n\n  hiddenPosts: () => request<PostPage>(\"/api/admin/posts\"),\n\n  tags: () => request<{ items: string[]; total: number }>(\"/api/tags\"),\n\n  authors: () => request<{ items: string[]; total: number }>(\"/api/authors\"),\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794366141340,"end":1794366141347}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c88e7397001jRbNJsNOHo1eor","sessionID":"ses_e377d0badffet7LSn1dj9cFwue","messageID":"msg_1c88e4ea10012OtwgHW076wrQI"}}
