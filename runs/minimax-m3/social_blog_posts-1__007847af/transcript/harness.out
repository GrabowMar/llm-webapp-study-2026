"lineEnd":20,"totalLines":20,"truncated":false}},"title":"frontend/package.json","time":{"start":1794365486772,"end":1794365486789}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c88476af001gnuJpA5ckXO913","sessionID":"ses_e377d0badffet7LSn1dj9cFwue","messageID":"msg_1c8846f68001dHL5ITdsyNACds"}}
