oured\n  ok   leaderboard player search\n  ok   leaderboard player search miss\nmy scores\n  ok   my scores keys\n  ok   my scores count\n  ok   my scores best 250\n  ok   my scores newest first\n  ok   my scores item keys\nadmin\n  ok   admin scores keys\n  ok   admin scores total 5\n  ok   admin scores newest first\n  ok   admin page size default\n  ok   admin pagination\n  ok   toggle -> 200\n  ok   toggle hides\n  FAIL hidden score leaves leaderboard {'items': [{'achieved_at': '2026-11-11T03:47:00.447867Z', 'player': 'alice', 'rank': 1, 'score': 250}, {'achieved_at': '2026-11-11T03:47:00.450449Z', 'player': 'bob', 'rank': 2, 'score': 120}], 'total': 2}\n  ok   hidden score leaves best score\n  ok   toggle again shows\n  ok   shown score back on leaderboard\n  ok   toggle unknown -> 404\nme\n  ok   me admin\n  ok   me player\nlogout\n  ok   logout -> 200\n  ok   token dead after logout\npersistence\n  ok   data still there\n\n1 FAILED: ['hidden score leaves leaderboard']\n","exit":0,"truncated":false},"title":"cd /workspace && .venv/bin/python .tmp/smoke.py 2>&1 | tail -80","time":{"start":1794368818817,"end":1794368820778}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b74e79001Oy21W85dL1phjy","sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","messageID":"msg_1c8b741e4001t55z0FVNb2EERs"}}
