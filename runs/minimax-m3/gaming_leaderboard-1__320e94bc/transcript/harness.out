ked={mode === option}\n-                onChange={() => {\n-                  setMode(option);\n-                  setError(null);\n-                }}\n-                className=\"sr-only\"\n-              />\n-              {option === \"login\" ? \"Sign in\" : \"Register\"}\n-            </label>\n-          ))}\n-        </div>\n-      </fieldset>\n+      <div className=\"mb-6 flex rounded-xl bg-slate-950/70 p-1\">\n+        {([\"login\", \"register\"] as Mode[]).map((option) => (\n+          <button\n+            key={option}\n+            type=\"button\"\n+            onClick={() => {\n+              setMode(option);\n+              setError(null);\n+            }}\n+            className={`flex-1 rounded-lg px-3 py-2 text-sm font-semibold transition ${\n+              mode === option\n+                ? \"bg-indigo-500 text-white shadow\"\n+                : \"text-slate-400 hover:text-slate-200\"\n+            }`}\n+          >\n+            {option === \"login\" ? \"Log in\" : \"Register\"}\n+          </button>\n+        ))}\n+      </div>\n \n       <form className=\"space-y-4\" onSubmit={handleSubmit}>\n         <div>\n           <label\n","additions":19,"deletions":28},"truncated":false},"title":"frontend/src/components/AuthPanel.tsx","time":{"start":1794369348574,"end":1794369348590}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8bf63d8001dRAWxX683wFyu8","sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","messageID":"msg_1c8bf183d001BhkOq89GEoDdg4"}}
