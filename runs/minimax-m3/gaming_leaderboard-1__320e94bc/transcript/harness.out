   \"@types/react-dom\": \"^19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"tailwindcss\": \"^4.3.5\",\n    \"typescript\": \"^5.9.3\",\n    \"vite\": \"8.3.5\"\n  }\n}","lineStart":1,"lineEnd":22,"totalLines":22,"truncated":false}},"title":"frontend/package.json","time":{"start":1794368952127,"end":1794368952134}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b95739001MCmh8iNXk6S14o","sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","messageID":"msg_1c8b94ea4001u1JiujMGyucXGp"}}
