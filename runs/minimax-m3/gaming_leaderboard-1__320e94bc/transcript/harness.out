T\", f\"/api/admin/scores/{solo}/toggle\", token=admin)\n+# a player whose scores are all hidden disappears from the leaderboard\n+bob_ids = [s[\"id\"] for s in call(\"GET\", \"/api/admin/scores\", token=admin)[1][\"items\"] if s[\"player\"] == \"bob\"]\n+for sid in bob_ids:\n+    call(\"POST\", f\"/api/admin/scores/{sid}/toggle\", token=admin)\n+status, payload = call(\"GET\", \"/api/leaderboard\")\n+check(\"all scores hidden -> player gone\", payload[\"total\"] == 1 and payload[\"items\"][0][\"player\"] == \"alice\", payload)\n+for sid in bob_ids:\n+    call(\"POST\", f\"/api/admin/scores/{sid}/toggle\", token=admin)\n \n print(\"me\")\n status, payload = call(\"GET\", \"/api/auth/me\", token=admin)\n check(\"me admin\", status == 200 and payload[\"username\"] == \"admin\" and payload[\"is_admin\"] is True, payload)\n","additions":8,"deletions":6},"truncated":false},"title":".tmp/smoke.py","time":{"start":1794368838482,"end":1794368838498}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8b79b4b0011upBasL3a9kxUJ","sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","messageID":"msg_1c8b78a4e001MiqGT2hkJABL6K"}}
