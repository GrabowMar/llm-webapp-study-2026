{"type":"step_start","timestamp":1794369004726,"sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","part":{"id":"prt_1c8ba2498001ToB5N8ONtFVW8e","messageID":"msg_1c8b9fe31001ngAfPLNDjYgb5o","sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","type":"step-start"}}
{"type":"tool_use","timestamp":1794369004757,"sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","part":{"type":"tool","tool":"write","callID":"call_01a1c8ba124b7236a1a0e9b6","state":{"status":"completed","input":{"content":"import type {\n  AdminScoresResponse,\n  LeaderboardResponse,\n  MyScoresResponse,\n  Period,\n  SubmittedScore,\n  User,\n} from \"./types\";\n\nconst TOKEN_KEY = \"leaderboard_token\";\n\nexport class ApiError extends Error {\n  status: number;\n\n  constructor(message: string, status: number) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n  }\n}\n\nexport function getToken(): string | null {\n  try {\n    return window.localStorage.getItem(TOKEN_KEY);\n  } catch {\n    return null;\n  }\n}\n\nexport function setToken(token: string | null): void {\n  try {\n    if (token) {\n      window.localStorage.setItem(TOKEN_KEY, token);\n    } else {\n      window.localStorage.removeItem(TOKEN_KEY);\n    }\n  } catch {\n    /* storage unavailable, the session simply does not persist */\n  }\n}\n\nasync function request<T>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (init.body !== undefined) {\n    headers[\"Content-Type\"] = \"application/json\";\n  }\n  const token = getToken();\n  if (token) {\n    headers.Authorization = `Bearer ${token}`;\n  }\n\n  const response = await fetch(path, {\n    method: init.method ?? \"GET\",\n    headers,\n    body: init.body === undefined ? undefined : JSON.stringify(init.body),\n  });\n\n  const text = await response.text();\n  let payload: unknown = null;\n  if (text) {\n    try {\n      payload = JSON.parse(text);\n    } catch {\n      payload = null;\n    }\n  }\n\n  if (!response.ok) {\n    const message =\n      (payload as { error?: string } | null)?.error ?? `Request failed (${response.status})`;\n    throw new ApiError(message, response.status);\n  }\n  return payload as T;\n}\n\nfunction query(params: Record<string, string | number | undefined>): string {\n  const search = new URLSearchParams();\n  for (const [key, value] of Object.entries(params)) {\n    if (value !== undefined && value !== \"\") {\n      search.set(key, String(value));\n    }\n  }\n  const encoded = search.toString();\n  return encoded ? `?${encoded}` : \"\";\n}\n\nexport const api = {\n  register(username: string, password: string) {\n    return request<{ id: number; username: string }>(\"/api/auth/register\", {\n      method: \"POST\",\n      body: { username, password },\n    });\n  },\n\n  async login(username: string, password: string): Promise<string> {\n    const result = await request<{ token: string }>(\"/api/auth/login\", {\n      method: \"POST\",\n      body: { username, password },\n    });\n    return result.token;\n  },\n\n  logout() {\n    return request<{ ok: boolean }>(\"/api/auth/logout\", { method: \"POST\" });\n  },\n\n  me() {\n    return request<User>(\"/api/auth/me\");\n  },\n\n  leaderboard(options: { period: Period; limit?: number; player?: string }) {\n    return request<LeaderboardResponse>(\n      `/api/leaderboard${query({\n        period: options.period,\n        limit: options.limit,\n        player: options.player,\n      })}`,\n    );\n  },\n\n  submitScore(score: number) {\n    return request<SubmittedScore>(\"/api/scores\", { method: \"POST\", body: { score } });\n  },\n\n  myScores() {\n    return request<MyScoresResponse>(\"/api/scores\");\n  },\n\n  adminScores(page: number, pageSize: number) {\n    return request<AdminScoresResponse>(`/api/admin/scores${query({ page, page_size: pageSize })}`);\n  },\n\n  toggleScore(id: number) {\n    return request<{ is_hidden: boolean }>(`/api/admin/scores/${id}/toggle`, { method: \"POST\" });\n  },\n};\n","filePath":"/workspace/frontend/src/api.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794369004720,"end":1794369004729}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c8ba24a8001NOxsAAI0qjsTlY","sessionID":"ses_e3750b618ffeN46LwuGHIvwVmz","messageID":"msg_1c8b9fe31001ngAfPLNDjYgb5o"}}
