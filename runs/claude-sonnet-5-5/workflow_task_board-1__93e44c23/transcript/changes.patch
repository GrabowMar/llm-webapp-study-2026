+        conn.execute("DELETE FROM tasks WHERE id = ?", (task_id,))
+        renumber(conn, row["status"], column_ids(conn, row["status"]))
+        conn.execute("COMMIT")
+    except BaseException:
+        conn.execute("ROLLBACK")
+        raise
+    return "", 204
+
