{"type":"tool_use","timestamp":1794253270542,"sessionID":"ses_e3e2c9127ffe6YxmFSdPt9SHUV","part":{"type":"tool","tool":"bash","callID":"toolu_01NYiJ2GTTajGVBxQxGRuwWj","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Flask entry point: JSON API under /api and the frontend build.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import date, datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"todos.db\"\n\nPRIORITIES = (\"low\", \"medium\", \"high\")\nTOKEN_TTL = timedelta(days=30)\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 20\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS todos (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL,\n    description TEXT,\n    priority TEXT NOT NULL DEFAULT 'medium',\n    due_date TEXT,\n    completed INTEGER NOT NULL DEFAULT 0,\n    completed_at TEXT,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_todos_user ON todos(user_id, completed, due_date);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(message: str, status: int, errors: dict | None = None):\n    body = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user_id() -> int | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT user_id, expires_at FROM tokens WHERE token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        return None\n    return row[\"user_id\"]\n\n\ndef auth_required(fn):\n    from functools import wraps\n\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user_id = current_user_id()\n        if user_id is None:\n            return error(\"Authentication required\", 401)\n        g.user_id = user_id\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    else:\n        username = username.strip()\n        if len(username) < 3 or len(username) > 50:\n            errors[\"username\"] = \"Username must be 3 to 50 characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters\"\n    elif len(password) > 200:\n        errors[\"password\"] = \"Password must be at most 200 characters\"\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n    try:\n        with db() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        return error(\"Validation failed\", 409, {\"username\": \"Username is already taken\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Invalid username or password\", 401)\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        return error(\"Invalid username or password\", 401)\n    if not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    expires = (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n    with db() as conn:\n        conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (now_iso(),))\n        conn.execute(\n            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (hash_token(token), row[\"id\"], expires),\n        )\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/auth/me\")\n@auth_required\ndef me():\n    row = db().execute(\"SELECT username FROM users WHERE id = ?\", (g.user_id,)).fetchone()\n    return jsonify({\"username\": row[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@auth_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\").split(None, 1)\n    with db() as conn:\n        conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(header[1].strip()),))\n    return \"\", 204\n\n\ndef todo_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"priority\": row[\"priority\"],\n        \"due_date\": row[\"due_date\"],\n        \"completed\": bool(row[\"completed\"]),\n        \"completed_at\": row[\"completed_at\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef validate_todo(data: dict, partial: bool) -> tuple[dict, dict]:\n    values: dict = {}\n    errors: dict = {}\n\n    if \"title\" in data or not partial:\n        title = data.get(\"title\")\n        if not isinstance(title, str) or not title.strip():\n            errors[\"title\"] = \"Title is required\"\n        elif len(title.strip()) > 200:\n            errors[\"title\"] = \"Title must be at most 200 characters\"\n        else:\n            values[\"title\"] = title.strip()\n\n    if \"description\" in data:\n        desc = data[\"description\"]\n        if desc is None:\n            values[\"description\"] = None\n        elif not isinstance(desc, str):\n            errors[\"description\"] = \"Description must be a string\"\n        elif len(desc) > 2000:\n            errors[\"description\"] = \"Description must be at most 2000 characters\"\n        else:\n            values[\"description\"] = desc if desc.strip() else None\n\n    if \"priority\" in data:\n        prio = data[\"priority\"]\n        if not isinstance(prio, str) or prio not in PRIORITIES:\n            errors[\"priority\"] = \"Priority must be one of: \" + \", \".join(PRIORITIES)\n        else:\n            values[\"priority\"] = prio\n\n    if \"due_date\" in data:\n        due = data[\"due_date\"]\n        if due is None or due == \"\":\n            values[\"due_date\"] = None\n        else:\n            ok = isinstance(due, str) and DATE_RE.match(due)\n            if ok:\n                try:\n                    date.fromisoformat(due)\n                except ValueError:\n                    ok = False\n            if ok:\n                values[\"due_date\"] = due\n            else:\n                errors[\"due_date\"] = \"Due date must be a valid date in YYYY-MM-DD format\"\n\n    if \"completed\" in data:\n        comp = data[\"completed\"]\n        if not isinstance(comp, bool):\n            errors[\"completed\"] = \"Completed must be true or false\"\n        else:\n            values[\"completed\"] = comp\n\n    return values, errors\n\n\ndef get_owned(todo_id: int) -> sqlite3.Row | None:\n    return db().execute(\n        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\", (todo_id, g.user_id)\n    ).fetchone()\n\n\ndef parse_int_param(name: str, default: int, errors: dict, minimum=1, maximum=None) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        val = int(raw)\n    except ValueError:\n        errors[name] = f\"{name} must be an integer\"\n        return default\n    if val < minimum or (maximum is not None and val > maximum):\n        rng = f\"between {minimum} and {maximum}\" if maximum else f\"at least {minimum}\"\n        errors[name] = f\"{name} must be {rng}\"\n        return default\n    return val\n\n\n@app.get(\"/api/todos\")\n@auth_required\ndef list_todos():\n    errors: dict = {}\n    page = parse_int_param(\"page\", 1, errors)\n    page_size = parse_int_param(\"page_size\", DEFAULT_PAGE_SIZE, errors, 1, MAX_PAGE_SIZE)\n\n    where = [\"user_id = ?\"]\n    params: list = [g.user_id]\n\n    completed = request.args.get(\"completed\")\n    if completed not in (None, \"\"):\n        low = completed.lower()\n        if low in (\"true\", \"1\"):\n            where.append(\"completed = 1\")\n        elif low in (\"false\", \"0\"):\n            where.append(\"completed = 0\")\n        else:\n            errors[\"completed\"] = \"completed must be true or false\"\n\n    priority = request.args.get(\"priority\")\n    if priority not in (None, \"\"):\n        if priority in PRIORITIES:\n            where.append(\"priority = ?\")\n            params.append(priority)\n        else:\n            errors[\"priority\"] = \"Priority must be one of: \" + \", \".join(PRIORITIES)\n\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n\n    clause = \" AND \".join(where)\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM todos WHERE {clause}\", params).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM todos WHERE {clause} \"\n        \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n        \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [todo_json(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"remaining\": max(0, total - page * page_size),\n        }\n    )\n\n\n@app.post(\"/api/todos\")\n@auth_required\ndef create_todo():\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    values, errors = validate_todo(data, partial=False)\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n    completed = values.get(\"completed\", False)\n    created = now_iso()\n    with db() as conn:\n        cur = conn.execute(\n            \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n            \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (\n                g.user_id,\n                values[\"title\"],\n                values.get(\"description\"),\n                values.get(\"priority\", \"medium\"),\n                values.get(\"due_date\"),\n                int(completed),\n                created if completed else None,\n                created,\n            ),\n        )\n        todo_id = cur.lastrowid\n    return jsonify(todo_json(get_owned(todo_id))), 201\n\n\n@app.get(\"/api/todos/<int:todo_id>\")\n@auth_required\ndef get_todo(todo_id: int):\n    row = get_owned(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n    return jsonify(todo_json(row))\n\n\n@app.patch(\"/api/todos/<int:todo_id>\")\n@auth_required\ndef update_todo(todo_id: int):\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    row = get_owned(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n    values, errors = validate_todo(data, partial=True)\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n    if \"completed\" in values:\n        completed = values.pop(\"completed\")\n        if completed != bool(row[\"completed\"]):\n            values[\"completed\"] = int(completed)\n            values[\"completed_at\"] = now_iso() if completed else None\n    if values:\n        assignments = \", \".join(f\"{k} = ?\" for k in values)\n        with db() as conn:\n            conn.execute(\n                f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n                [*values.values(), todo_id, g.user_id],\n            )\n    return jsonify(todo_json(get_owned(todo_id)))\n\n\n@app.delete(\"/api/todos/<int:todo_id>\")\n@auth_required\ndef delete_todo(todo_id: int):\n    with db() as conn:\n        cur = conn.execute(\n            \"DELETE FROM todos WHERE id = ? AND user_id = ?\", (todo_id, g.user_id)\n        )\n    if cur.rowcount == 0:\n        return error(\"Todo not found\", 404)\n    return \"\", 204\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.description or exc.name, exc.code or 500)\n    return exc\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Flask entry point: JSON API under /api and the frontend build.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import date, datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"todos.db\"\n\nPRIORITIES = (\"low\", \"medium\", \"high\")\nTOKEN_TTL = timedelta(days=30)\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 20\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS todos (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL,\n    description TEXT,\n    priority TEXT NOT NULL DEFAULT 'medium',\n    due_date TEXT,\n    completed INTEGER NOT NULL DEFAULT 0,\n    completed_at TEXT,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_todos_user ON todos(user_id, completed, due_date);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(message: str, status: int, errors: dict | None = None):\n    body = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user_id() -> int | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT user_id, expires_at FROM tokens WHERE token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        return None\n    return row[\"user_id\"]\n\n\ndef auth_required(fn):\n    from functools import wraps\n\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user_id = current_user_id()\n        if user_id is None:\n            return error(\"Authentication required\", 401)\n        g.user_id = user_id\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    else:\n        username = username.strip()\n        if len(username) < 3 or len(username) > 50:\n            errors[\"username\"] = \"Username must be 3 to 50 characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters\"\n    elif len(password) > 200:\n        errors[\"password\"] = \"Password must be at most 200 characters\"\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n    try:\n        with db() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        return error(\"Validation failed\", 409, {\"username\": \"Username is already taken\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Invalid username or password\", 401)\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        return error(\"Invalid username or password\", 401)\n    if not check_password_hash(row[\"password_hash\"], password):\n        return error(\"Invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    expires = (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n    with db() as conn:\n        conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (now_iso(),))\n        conn.execute(\n            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (hash_token(token), row[\"id\"], expires),\n        )\n    return jsonify({\"token\": token}), 200\n\n\n@app.get(\"/api/auth/me\")\n@auth_required\ndef me():\n    row = db().execute(\"SELECT username FROM users WHERE id = ?\", (g.user_id,)).fetchone()\n    return jsonify({\"username\": row[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@auth_required\ndef logout():\n    header = request.headers.get(\"Authorization\", \"\").split(None, 1)\n    with db() as conn:\n        conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(header[1].strip()),))\n    return \"\", 204\n\n\ndef todo_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"priority\": row[\"priority\"],\n        \"due_date\": row[\"due_date\"],\n        \"completed\": bool(row[\"completed\"]),\n        \"completed_at\": row[\"completed_at\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef validate_todo(data: dict, partial: bool) -> tuple[dict, dict]:\n    values: dict = {}\n    errors: dict = {}\n\n    if \"title\" in data or not partial:\n        title = data.get(\"title\")\n        if not isinstance(title, str) or not title.strip():\n            errors[\"title\"] = \"Title is required\"\n        elif len(title.strip()) > 200:\n            errors[\"title\"] = \"Title must be at most 200 characters\"\n        else:\n            values[\"title\"] = title.strip()\n\n    if \"description\" in data:\n        desc = data[\"description\"]\n        if desc is None:\n            values[\"description\"] = None\n        elif not isinstance(desc, str):\n            errors[\"description\"] = \"Description must be a string\"\n        elif len(desc) > 2000:\n            errors[\"description\"] = \"Description must be at most 2000 characters\"\n        else:\n            values[\"description\"] = desc if desc.strip() else None\n\n    if \"priority\" in data:\n        prio = data[\"priority\"]\n        if not isinstance(prio, str) or prio not in PRIORITIES:\n            errors[\"priority\"] = \"Priority must be one of: \" + \", \".join(PRIORITIES)\n        else:\n            values[\"priority\"] = prio\n\n    if \"due_date\" in data:\n        due = data[\"due_date\"]\n        if due is None or due == \"\":\n            values[\"due_date\"] = None\n        else:\n            ok = isinstance(due, str) and DATE_RE.match(due)\n            if ok:\n                try:\n                    date.fromisoformat(due)\n                except ValueError:\n                    ok = False\n            if ok:\n                values[\"due_date\"] = due\n            else:\n                errors[\"due_date\"] = \"Due date must be a valid date in YYYY-MM-DD format\"\n\n    if \"completed\" in data:\n        comp = data[\"completed\"]\n        if not isinstance(comp, bool):\n            errors[\"completed\"] = \"Completed must be true or false\"\n        else:\n            values[\"completed\"] = comp\n\n    return values, errors\n\n\ndef get_owned(todo_id: int) -> sqlite3.Row | None:\n    return db().execute(\n        \"SELECT * FROM todos WHERE id = ? AND user_id = ?\", (todo_id, g.user_id)\n    ).fetchone()\n\n\ndef parse_int_param(name: str, default: int, errors: dict, minimum=1, maximum=None) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        val = int(raw)\n    except ValueError:\n        errors[name] = f\"{name} must be an integer\"\n        return default\n    if val < minimum or (maximum is not None and val > maximum):\n        rng = f\"between {minimum} and {maximum}\" if maximum else f\"at least {minimum}\"\n        errors[name] = f\"{name} must be {rng}\"\n        return default\n    return val\n\n\n@app.get(\"/api/todos\")\n@auth_required\ndef list_todos():\n    errors: dict = {}\n    page = parse_int_param(\"page\", 1, errors)\n    page_size = parse_int_param(\"page_size\", DEFAULT_PAGE_SIZE, errors, 1, MAX_PAGE_SIZE)\n\n    where = [\"user_id = ?\"]\n    params: list = [g.user_id]\n\n    completed = request.args.get(\"completed\")\n    if completed not in (None, \"\"):\n        low = completed.lower()\n        if low in (\"true\", \"1\"):\n            where.append(\"completed = 1\")\n        elif low in (\"false\", \"0\"):\n            where.append(\"completed = 0\")\n        else:\n            errors[\"completed\"] = \"completed must be true or false\"\n\n    priority = request.args.get(\"priority\")\n    if priority not in (None, \"\"):\n        if priority in PRIORITIES:\n            where.append(\"priority = ?\")\n            params.append(priority)\n        else:\n            errors[\"priority\"] = \"Priority must be one of: \" + \", \".join(PRIORITIES)\n\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n\n    clause = \" AND \".join(where)\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM todos WHERE {clause}\", params).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM todos WHERE {clause} \"\n        \"ORDER BY completed ASC, due_date IS NULL ASC, due_date ASC, \"\n        \"created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [todo_json(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"remaining\": max(0, total - page * page_size),\n        }\n    )\n\n\n@app.post(\"/api/todos\")\n@auth_required\ndef create_todo():\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    values, errors = validate_todo(data, partial=False)\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n    completed = values.get(\"completed\", False)\n    created = now_iso()\n    with db() as conn:\n        cur = conn.execute(\n            \"INSERT INTO todos (user_id, title, description, priority, due_date, \"\n            \"completed, completed_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            (\n                g.user_id,\n                values[\"title\"],\n                values.get(\"description\"),\n                values.get(\"priority\", \"medium\"),\n                values.get(\"due_date\"),\n                int(completed),\n                created if completed else None,\n                created,\n            ),\n        )\n        todo_id = cur.lastrowid\n    return jsonify(todo_json(get_owned(todo_id))), 201\n\n\n@app.get(\"/api/todos/<int:todo_id>\")\n@auth_required\ndef get_todo(todo_id: int):\n    row = get_owned(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n    return jsonify(todo_json(row))\n\n\n@app.patch(\"/api/todos/<int:todo_id>\")\n@auth_required\ndef update_todo(todo_id: int):\n    data = json_body()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    row = get_owned(todo_id)\n    if row is None:\n        return error(\"Todo not found\", 404)\n    values, errors = validate_todo(data, partial=True)\n    if errors:\n        return error(\"Validation failed\", 400, errors)\n    if \"completed\" in values:\n        completed = values.pop(\"completed\")\n        if completed != bool(row[\"completed\"]):\n            values[\"completed\"] = int(completed)\n            values[\"completed_at\"] = now_iso() if completed else None\n    if values:\n        assignments = \", \".join(f\"{k} = ?\" for k in values)\n        with db() as conn:\n            conn.execute(\n                f\"UPDATE todos SET {assignments} WHERE id = ? AND user_id = ?\",\n                [*values.values(), todo_id, g.user_id],\n            )\n    return jsonify(todo_json(get_owned(todo_id)))\n\n\n@app.delete(\"/api/todos/<int:todo_id>\")\n@auth_required\ndef delete_todo(todo_id: int):\n    with db() as conn:\n        cur = conn.execute(\n            \"DELETE FROM todos WHERE id = ? AND user_id = ?\", (todo_id, g.user_id)\n        )\n    if cur.rowcount == 0:\n        return error(\"Todo not found\", 404)\n    return \"\", 204\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.description or exc.name, exc.code or 500)\n    return exc\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"Not found\", 404)\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF","time":{"start":1794253270353,"end":1794253270403}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1d42d3b001fD5xGe7bQXEeHb","sessionID":"ses_e3e2c9127ffe6YxmFSdPt9SHUV","messageID":"msg_1c1d3904e001RgKxJ6E6YlE9eL"}}
