{"type":"tool_use","timestamp":1794249585155,"sessionID":"ses_e3e66b214ffeN0e56FsH12pS0n","part":{"type":"tool","tool":"bash","callID":"toolu_01UCZZY7B4EWDKTS3TqCzufz","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Sensor dashboard: Flask API and static frontend.\"\"\"\n\nimport hashlib\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"sensors.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_USERNAME = 64\nMAX_PASSWORD = 256\nMIN_PASSWORD = 1\nMAX_NAME = 100\nMAX_UNIT = 32\nMAX_LOCATION = 100\nDEFAULT_LIMIT = 100\nMAX_LIMIT = 1000\n\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sensors (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    unit TEXT NOT NULL DEFAULT '',\n    location TEXT NOT NULL DEFAULT '',\n    last_value REAL,\n    last_updated TEXT,\n    owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS readings (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n    value REAL NOT NULL,\n    recorded_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_readings_sensor ON readings(sensor_id, id);\nCREATE INDEX IF NOT EXISTS idx_sensors_name ON sensors(name, id);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef error(status: int, message: str):\n    return jsonify({\"error\": message}), status\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] <= now_iso():\n        return None\n    return row\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef sensor_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"last_value\": row[\"last_value\"],\n        \"last_updated\": row[\"last_updated\"],\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef reading_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"sensor_id\": row[\"sensor_id\"],\n        \"value\": row[\"value\"],\n        \"recorded_at\": row[\"recorded_at\"],\n    }\n\n\nSENSOR_SELECT = (\n    \"SELECT s.id, s.name, s.unit, s.location, s.last_value, s.last_updated, \"\n    \"s.owner_id, u.username AS owner FROM sensors s JOIN users u ON u.id = s.owner_id\"\n)\n\n\ndef fetch_sensor(sensor_id: int):\n    return db().execute(SENSOR_SELECT + \" WHERE s.id = ?\", (sensor_id,)).fetchone()\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.code or 500, exc.name)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef unhandled(exc: Exception):\n    app.logger.exception(\"unhandled error\")\n    return error(500, \"Internal Server Error\")\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"username and password are required strings\")\n    username = username.strip()\n    if not username or len(username) > MAX_USERNAME:\n        return error(400, f\"username must be 1-{MAX_USERNAME} characters\")\n    if len(password) < MIN_PASSWORD or len(password) > MAX_PASSWORD:\n        return error(400, f\"password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters\")\n    conn = db()\n    try:\n        with conn:\n            cur = conn.execute(\n                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                (username, generate_password_hash(password)),\n            )\n    except sqlite3.IntegrityError:\n        return error(409, \"username already taken\")\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"username and password are required strings\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        return error(401, \"invalid username or password\")\n    if not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    now = datetime.now(timezone.utc)\n    expires = (now + TOKEN_TTL).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n    with conn:\n        conn.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now_iso(),))\n        conn.execute(\n            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (hash_token(token), row[\"id\"], expires),\n        )\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    token = request.headers[\"Authorization\"].split(None, 1)[1].strip()\n    with db() as conn:\n        conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(token),))\n    return \"\", 204\n\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = db().execute(SENSOR_SELECT + \" ORDER BY s.name, s.id\").fetchall()\n    return jsonify({\"items\": [sensor_json(r) for r in rows]})\n\n\ndef optional_text(data: dict, key: str, limit: int):\n    value = data.get(key)\n    if value is None:\n        return \"\", None\n    if not isinstance(value, str):\n        return None, f\"{key} must be a string\"\n    value = value.strip()\n    if len(value) > limit:\n        return None, f\"{key} must be at most {limit} characters\"\n    return value, None\n\n\n@app.post(\"/api/sensors\")\ndef create_sensor():\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    name = data.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return error(400, \"name is required\")\n    name = name.strip()\n    if len(name) > MAX_NAME:\n        return error(400, f\"name must be at most {MAX_NAME} characters\")\n    unit, err = optional_text(data, \"unit\", MAX_UNIT)\n    if err:\n        return error(400, err)\n    location, err = optional_text(data, \"location\", MAX_LOCATION)\n    if err:\n        return error(400, err)\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO sensors (name, unit, location, owner_id) VALUES (?, ?, ?, ?)\",\n            (name, unit, location, user[\"id\"]),\n        )\n    return jsonify(sensor_json(fetch_sensor(cur.lastrowid))), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef get_sensor(sensor_id: int):\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(404, \"sensor not found\")\n    return jsonify(sensor_json(row))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\ndef delete_sensor(sensor_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(404, \"sensor not found\")\n    if row[\"owner_id\"] != user[\"id\"]:\n        return error(403, \"not the owner of this sensor\")\n    conn = db()\n    with conn:\n        conn.execute(\"DELETE FROM readings WHERE sensor_id = ?\", (sensor_id,))\n        conn.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n    return \"\", 204\n\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id: int):\n    if fetch_sensor(sensor_id) is None:\n        return error(404, \"sensor not found\")\n    limit = DEFAULT_LIMIT\n    raw = request.args.get(\"limit\")\n    if raw is not None:\n        try:\n            limit = int(raw)\n        except ValueError:\n            return error(400, \"limit must be an integer\")\n        if limit < 1:\n            return error(400, \"limit must be at least 1\")\n        limit = min(limit, MAX_LIMIT)\n    conn = db()\n    rows = conn.execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings \"\n        \"WHERE sensor_id = ? ORDER BY id DESC LIMIT ?\",\n        (sensor_id, limit),\n    ).fetchall()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[0]\n    return jsonify({\"items\": [reading_json(r) for r in rows], \"total\": total})\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\ndef create_reading(sensor_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    sensor = fetch_sensor(sensor_id)\n    if sensor is None:\n        return error(404, \"sensor not found\")\n    if sensor[\"owner_id\"] != user[\"id\"]:\n        return error(403, \"not the owner of this sensor\")\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    value = data.get(\"value\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return error(400, \"value must be a number\")\n    value = float(value)\n    if not math.isfinite(value):\n        return error(400, \"value must be a finite number\")\n    recorded_at = now_iso()\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n            (sensor_id, value, recorded_at),\n        )\n        conn.execute(\n            \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n            (value, recorded_at, sensor_id),\n        )\n    return (\n        jsonify(\n            {\n                \"id\": cur.lastrowid,\n                \"sensor_id\": sensor_id,\n                \"value\": value,\n                \"recorded_at\": recorded_at,\n            }\n        ),\n        201,\n    )\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\")\ndef api_not_found(path: str):\n    return error(404, \"not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = (DIST / path).resolve()\n    if target.is_file() and DIST.resolve() in target.parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\ncd frontend && npm i -D tailwindcss @tailwindcss/vite typescript @types/react @types/react-dom 2>&1 | tail -5; cat package.json"},"output":"(no output)\n\n<shell_metadata>\nshell tool terminated command after exceeding timeout 120000 ms. If this command is expected to take longer and is not waiting for interactive input, retry with a larger timeout value in milliseconds.\n</shell_metadata>","metadata":{"output":"(no output)\n\n<shell_metadata>\nshell tool terminated command after exceeding timeout 120000 ms. If this command is expected to take longer and is not waiting for interactive input, retry with a larger timeout value in milliseconds.\n</shell_metadata>","exit":null,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Sensor dashboard: Flask API and static frontend.\"\"\"\n\nimport hashlib\nimport math\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"sensors.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_USERNAME = 64\nMAX_PASSWORD = 256\nMIN_PASSWORD = 1\nMAX_NAME = 100\nMAX_UNIT = 32\nMAX_LOCATION = 100\nDEFAULT_LIMIT = 100\nMAX_LIMIT = 1000\n\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\napp = Flask(__name__, static_folder=None)\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sensors (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL,\n    unit TEXT NOT NULL DEFAULT '',\n    location TEXT NOT NULL DEFAULT '',\n    last_value REAL,\n    last_updated TEXT,\n    owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE TABLE IF NOT EXISTS readings (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    sensor_id INTEGER NOT NULL REFERENCES sensors(id) ON DELETE CASCADE,\n    value REAL NOT NULL,\n    recorded_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_readings_sensor ON readings(sensor_id, id);\nCREATE INDEX IF NOT EXISTS idx_sensors_name ON sensors(name, id);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef error(status: int, message: str):\n    return jsonify({\"error\": message}), status\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] <= now_iso():\n        return None\n    return row\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef sensor_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"unit\": row[\"unit\"],\n        \"location\": row[\"location\"],\n        \"last_value\": row[\"last_value\"],\n        \"last_updated\": row[\"last_updated\"],\n        \"owner\": row[\"owner\"],\n    }\n\n\ndef reading_json(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"sensor_id\": row[\"sensor_id\"],\n        \"value\": row[\"value\"],\n        \"recorded_at\": row[\"recorded_at\"],\n    }\n\n\nSENSOR_SELECT = (\n    \"SELECT s.id, s.name, s.unit, s.location, s.last_value, s.last_updated, \"\n    \"s.owner_id, u.username AS owner FROM sensors s JOIN users u ON u.id = s.owner_id\"\n)\n\n\ndef fetch_sensor(sensor_id: int):\n    return db().execute(SENSOR_SELECT + \" WHERE s.id = ?\", (sensor_id,)).fetchone()\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.code or 500, exc.name)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef unhandled(exc: Exception):\n    app.logger.exception(\"unhandled error\")\n    return error(500, \"Internal Server Error\")\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"username and password are required strings\")\n    username = username.strip()\n    if not username or len(username) > MAX_USERNAME:\n        return error(400, f\"username must be 1-{MAX_USERNAME} characters\")\n    if len(password) < MIN_PASSWORD or len(password) > MAX_PASSWORD:\n        return error(400, f\"password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters\")\n    conn = db()\n    try:\n        with conn:\n            cur = conn.execute(\n                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                (username, generate_password_hash(password)),\n            )\n    except sqlite3.IntegrityError:\n        return error(409, \"username already taken\")\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"username and password are required strings\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        return error(401, \"invalid username or password\")\n    if not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    now = datetime.now(timezone.utc)\n    expires = (now + TOKEN_TTL).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n    with conn:\n        conn.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (now_iso(),))\n        conn.execute(\n            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (hash_token(token), row[\"id\"], expires),\n        )\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    return jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    token = request.headers[\"Authorization\"].split(None, 1)[1].strip()\n    with db() as conn:\n        conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(token),))\n    return \"\", 204\n\n\n@app.get(\"/api/sensors\")\ndef list_sensors():\n    rows = db().execute(SENSOR_SELECT + \" ORDER BY s.name, s.id\").fetchall()\n    return jsonify({\"items\": [sensor_json(r) for r in rows]})\n\n\ndef optional_text(data: dict, key: str, limit: int):\n    value = data.get(key)\n    if value is None:\n        return \"\", None\n    if not isinstance(value, str):\n        return None, f\"{key} must be a string\"\n    value = value.strip()\n    if len(value) > limit:\n        return None, f\"{key} must be at most {limit} characters\"\n    return value, None\n\n\n@app.post(\"/api/sensors\")\ndef create_sensor():\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    name = data.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return error(400, \"name is required\")\n    name = name.strip()\n    if len(name) > MAX_NAME:\n        return error(400, f\"name must be at most {MAX_NAME} characters\")\n    unit, err = optional_text(data, \"unit\", MAX_UNIT)\n    if err:\n        return error(400, err)\n    location, err = optional_text(data, \"location\", MAX_LOCATION)\n    if err:\n        return error(400, err)\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO sensors (name, unit, location, owner_id) VALUES (?, ?, ?, ?)\",\n            (name, unit, location, user[\"id\"]),\n        )\n    return jsonify(sensor_json(fetch_sensor(cur.lastrowid))), 201\n\n\n@app.get(\"/api/sensors/<int:sensor_id>\")\ndef get_sensor(sensor_id: int):\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(404, \"sensor not found\")\n    return jsonify(sensor_json(row))\n\n\n@app.delete(\"/api/sensors/<int:sensor_id>\")\ndef delete_sensor(sensor_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    row = fetch_sensor(sensor_id)\n    if row is None:\n        return error(404, \"sensor not found\")\n    if row[\"owner_id\"] != user[\"id\"]:\n        return error(403, \"not the owner of this sensor\")\n    conn = db()\n    with conn:\n        conn.execute(\"DELETE FROM readings WHERE sensor_id = ?\", (sensor_id,))\n        conn.execute(\"DELETE FROM sensors WHERE id = ?\", (sensor_id,))\n    return \"\", 204\n\n\n@app.get(\"/api/sensors/<int:sensor_id>/readings\")\ndef list_readings(sensor_id: int):\n    if fetch_sensor(sensor_id) is None:\n        return error(404, \"sensor not found\")\n    limit = DEFAULT_LIMIT\n    raw = request.args.get(\"limit\")\n    if raw is not None:\n        try:\n            limit = int(raw)\n        except ValueError:\n            return error(400, \"limit must be an integer\")\n        if limit < 1:\n            return error(400, \"limit must be at least 1\")\n        limit = min(limit, MAX_LIMIT)\n    conn = db()\n    rows = conn.execute(\n        \"SELECT id, sensor_id, value, recorded_at FROM readings \"\n        \"WHERE sensor_id = ? ORDER BY id DESC LIMIT ?\",\n        (sensor_id, limit),\n    ).fetchall()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM readings WHERE sensor_id = ?\", (sensor_id,)\n    ).fetchone()[0]\n    return jsonify({\"items\": [reading_json(r) for r in rows], \"total\": total})\n\n\n@app.post(\"/api/sensors/<int:sensor_id>/readings\")\ndef create_reading(sensor_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, \"authentication required\")\n    sensor = fetch_sensor(sensor_id)\n    if sensor is None:\n        return error(404, \"sensor not found\")\n    if sensor[\"owner_id\"] != user[\"id\"]:\n        return error(403, \"not the owner of this sensor\")\n    data = json_body()\n    if data is None:\n        return error(400, \"JSON object body required\")\n    value = data.get(\"value\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return error(400, \"value must be a number\")\n    value = float(value)\n    if not math.isfinite(value):\n        return error(400, \"value must be a finite number\")\n    recorded_at = now_iso()\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO readings (sensor_id, value, recorded_at) VALUES (?, ?, ?)\",\n            (sensor_id, value, recorded_at),\n        )\n        conn.execute(\n            \"UPDATE sensors SET last_value = ?, last_updated = ? WHERE id = ?\",\n            (value, recorded_at, sensor_id),\n        )\n    return (\n        jsonify(\n            {\n                \"id\": cur.lastrowid,\n                \"sensor_id\": sensor_id,\n                \"value\": value,\n                \"recorded_at\": recorded_at,\n            }\n        ),\n        201,\n    )\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\")\ndef api_not_found(path: str):\n    return error(404, \"not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = (DIST / path).resolve()\n    if target.is_file() and DIST.resolve() in target.parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\ncd frontend && npm i -D tailwindcss @tailwindcss/vite typescript @types/react @types/react-dom 2>&1 | tail -5; cat package.json","time":{"start":1794249464983,"end":1794249585127}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c19a1c51001PXMd10jbjrnR8H","sessionID":"ses_e3e66b214ffeN0e56FsH12pS0n","messageID":"msg_1c1997a0f0013BINM6m0NgMpdN"}}
