{"type":"tool_use","timestamp":1794249675371,"sessionID":"ses_e3e66b214ffeN0e56FsH12pS0n","part":{"type":"tool","tool":"bash","callID":"toolu_012VpkUvbMZ6qx9UNVBW6bVT","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\ncat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\nsed -i 's|<title>App</title>|<title>Sensor dashboard</title>|; s|<body>|<body class=\"bg-slate-50 text-slate-900\">|' index.html\nsed -i 's|\"build\": \"vite build\"|\"typecheck\": \"tsc --noEmit\",\\n    \"build\": \"vite build\"|' package.json\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/api.ts <<'EOF'\nexport type Sensor = {\n  id: number;\n  name: string;\n  unit: string;\n  location: string;\n  last_value: number | null;\n  last_updated: string | null;\n  owner: string;\n};\n\nexport type Reading = {\n  id: number;\n  sensor_id: number;\n  value: number;\n  recorded_at: string;\n};\n\nexport type Session = { token: string; username: string };\n\nconst KEY = \"session\";\n\nexport function loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(KEY);\n    return raw ? (JSON.parse(raw) as Session) : null;\n  } catch {\n    return null;\n  }\n}\n\nexport function saveSession(s: Session | null) {\n  if (s) localStorage.setItem(KEY, JSON.stringify(s));\n  else localStorage.removeItem(KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport async function api<T>(\n  path: string,\n  opts: { method?: string; body?: unknown; token?: string } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (opts.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (opts.token) headers[\"Authorization\"] = `Bearer ${opts.token}`;\n  const res = await fetch(`/api${path}`, {\n    method: opts.method ?? \"GET\",\n    headers,\n    body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,\n  });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const msg =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, msg);\n  }\n  return data as T;\n}\n\nexport function timeAgo(iso: string | null, now: number): string {\n  if (!iso) return \"never\";\n  const secs = Math.max(0, Math.round((now - new Date(iso).getTime()) / 1000));\n  if (secs < 5) return \"just now\";\n  if (secs < 60) return `${secs}s ago`;\n  const mins = Math.floor(secs / 60);\n  if (mins < 60) return `${mins}m ago`;\n  const hours = Math.floor(mins / 60);\n  if (hours < 24) return `${hours}h ago`;\n  return `${Math.floor(hours / 24)}d ago`;\n}\n\nexport function formatValue(v: number | null): string {\n  if (v === null) return \"–\";\n  return Number.isInteger(v) ? String(v) : String(Math.round(v * 1000) / 1000);\n}\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\";\nexport const btnCls =\n  \"rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50\";\nexport const dangerCls =\n  \"rounded border border-red-300 px-3 py-1 text-sm text-red-700 hover:bg-red-50 disabled:opacity-50\";\n\nexport function Field({ label, children }: { label: string; children: ReactNode }) {\n  return (\n    <label className=\"block text-sm\">\n      <span className=\"mb-1 block font-medium text-slate-700\">{label}</span>\n      {children}\n    </label>\n  );\n}\n\nexport function ErrorMsg({ message }: { message: string | null }) {\n  if (!message) return null;\n  return (\n    <p role=\"alert\" className=\"rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </p>\n  );\n}\n\nexport function Panel({ title, children }: { title: string; children: ReactNode }) {\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-4 shadow-sm\">\n      <h2 className=\"mb-3 text-lg font-semibold\">{title}</h2>\n      {children}\n    </section>\n  );\n}\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, type Session } from \"./api\";\nimport { btnCls, ErrorMsg, Field, inputCls, Panel } from \"./ui\";\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: (s: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username, password } });\n      }\n      const res = await api<{ token: string; username?: string }>(\"/auth/login\", {\n        method: \"POST\",\n        body: { username, password },\n      });\n      onSignedIn({ token: res.token, username: res.username ?? username.trim() });\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const isLogin = mode === \"login\";\n  return (\n    <Panel title={isLogin ? \"Sign in\" : \"Create account\"}>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <Field label=\"Username\">\n          <input\n            className={inputCls}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n        </Field>\n        <Field label=\"Password\">\n          <input\n            className={inputCls}\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n            required\n          />\n        </Field>\n        <ErrorMsg message={error} />\n        <div className=\"flex items-center gap-3\">\n          <button className={btnCls} disabled={busy} type=\"submit\">\n            {isLogin ? \"Sign in\" : \"Register\"}\n          </button>\n          <button\n            type=\"button\"\n            className=\"text-sm text-blue-700 hover:underline\"\n            onClick={() => {\n              setMode(isLogin ? \"register\" : \"login\");\n              setError(null);\n            }}\n          >\n            {isLogin ? \"Need an account? Register\" : \"Have an account? Sign in\"}\n          </button>\n        </div>\n      </form>\n    </Panel>\n  );\n}\nEOF\ncat > src/Forms.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, type Sensor } from \"./api\";\nimport { btnCls, ErrorMsg, Field, inputCls, Panel } from \"./ui\";\n\nexport function NewSensorForm({ token, onDone }: { token: string; onDone: () => void }) {\n  const [name, setName] = useState(\"\");\n  const [unit, setUnit] = useState(\"\");\n  const [location, setLocation] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      await api(\"/sensors\", { method: \"POST\", token, body: { name, unit, location } });\n      setName(\"\");\n      setUnit(\"\");\n      setLocation(\"\");\n      onDone();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <Panel title=\"Register a sensor\">\n      <form onSubmit={submit} className=\"space-y-3\">\n        <Field label=\"Name\">\n          <input className={inputCls} value={name} onChange={(e) => setName(e.target.value)} required />\n        </Field>\n        <Field label=\"Unit\">\n          <input className={inputCls} value={unit} onChange={(e) => setUnit(e.target.value)} placeholder=\"°C\" />\n        </Field>\n        <Field label=\"Location\">\n          <input className={inputCls} value={location} onChange={(e) => setLocation(e.target.value)} />\n        </Field>\n        <ErrorMsg message={error} />\n        <button className={btnCls} disabled={busy} type=\"submit\">\n          Add sensor\n        </button>\n      </form>\n    </Panel>\n  );\n}\n\nexport function NewReadingForm({\n  token,\n  sensors,\n  fixedId,\n  onDone,\n}: {\n  token: string;\n  sensors: Sensor[];\n  fixedId?: number;\n  onDone: () => void;\n}) {\n  const [selected, setSelected] = useState<string>(\"\");\n  const [value, setValue] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const sensorId = fixedId !== undefined ? String(fixedId) : selected || String(sensors[0]?.id ?? \"\");\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    const num = Number(value);\n    if (value.trim() === \"\" || !Number.isFinite(num)) {\n      setError(\"Enter a valid number\");\n      return;\n    }\n    setBusy(true);\n    try {\n      await api(`/sensors/${sensorId}/readings`, { method: \"POST\", token, body: { value: num } });\n      setValue(\"\");\n      onDone();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  if (sensors.length === 0) {\n    return (\n      <Panel title=\"Post a reading\">\n        <p className=\"text-sm text-slate-500\">Register a sensor first.</p>\n      </Panel>\n    );\n  }\n\n  return (\n    <Panel title=\"Post a reading\">\n      <form onSubmit={submit} className=\"space-y-3\">\n        {fixedId === undefined && (\n          <Field label=\"Sensor\">\n            <select className={inputCls} value={sensorId} onChange={(e) => setSelected(e.target.value)}>\n              {sensors.map((s) => (\n                <option key={s.id} value={s.id}>\n                  {s.name}\n                </option>\n              ))}\n            </select>\n          </Field>\n        )}\n        <Field label=\"Value\">\n          <input\n            className={inputCls}\n            type=\"number\"\n            step=\"any\"\n            value={value}\n            onChange={(e) => setValue(e.target.value)}\n            required\n          />\n        </Field>\n        <ErrorMsg message={error} />\n        <button className={btnCls} disabled={busy} type=\"submit\">\n          Post reading\n        </button>\n      </form>\n    </Panel>\n  );\n}\nEOF\ncat > src/Chart.tsx <<'EOF'\nimport type { Reading } from \"./api\";\nimport { formatValue } from \"./api\";\n\nexport default function Chart({ readings, unit }: { readings: Reading[]; unit: string }) {\n  if (readings.length === 0) {\n    return <p className=\"text-sm text-slate-500\">No readings yet.</p>;\n  }\n  const pts = [...readings].reverse();\n  const W = 640;\n  const H = 240;\n  const pad = { l: 48, r: 16, t: 12, b: 28 };\n  const times = pts.map((p) => new Date(p.recorded_at).getTime());\n  const vals = pts.map((p) => p.value);\n  const tMin = Math.min(...times);\n  const tMax = Math.max(...times);\n  let vMin = Math.min(...vals);\n  let vMax = Math.max(...vals);\n  if (vMin === vMax) {\n    vMin -= 1;\n    vMax += 1;\n  }\n  const x = (i: number) =>\n    tMax === tMin\n      ? pad.l + (W - pad.l - pad.r) / 2\n      : pad.l + ((times[i] - tMin) / (tMax - tMin)) * (W - pad.l - pad.r);\n  const y = (v: number) => pad.t + (1 - (v - vMin) / (vMax - vMin)) * (H - pad.t - pad.b);\n  const path = pts.map((p, i) => `${i === 0 ? \"M\" : \"L\"}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(\" \");\n  const ticks = [vMin, (vMin + vMax) / 2, vMax];\n  const fmt = (t: number) => new Date(t).toLocaleTimeString([], { hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\" });\n\n  return (\n    <svg viewBox={`0 0 ${W} ${H}`} className=\"w-full\" role=\"img\" aria-label={`Line chart of recent readings${unit ? ` in ${unit}` : \"\"}`}>\n      {ticks.map((t) => (\n        <g key={t}>\n          <line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} className=\"stroke-slate-200\" />\n          <text x={pad.l - 6} y={y(t) + 4} textAnchor=\"end\" className=\"fill-slate-500 text-[11px]\">\n            {formatValue(Math.round(t * 100) / 100)}\n          </text>\n        </g>\n      ))}\n      <text x={pad.l} y={H - 8} className=\"fill-slate-500 text-[11px]\">\n        {fmt(tMin)}\n      </text>\n      <text x={W - pad.r} y={H - 8} textAnchor=\"end\" className=\"fill-slate-500 text-[11px]\">\n        {fmt(tMax)}\n      </text>\n      <path d={path} fill=\"none\" className=\"stroke-blue-600\" strokeWidth={2} strokeLinejoin=\"round\" />\n      {pts.map((p, i) => (\n        <circle key={p.id} cx={x(i)} cy={y(p.value)} r={3} className=\"fill-blue-600\">\n          <title>{`${formatValue(p.value)} ${unit} at ${new Date(p.recorded_at).toLocaleString()}`}</title>\n        </circle>\n      ))}\n    </svg>\n  );\n}\nEOF\ncat > src/SensorPage.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatValue, timeAgo, type Reading, type Sensor, type Session } from \"./api\";\nimport Chart from \"./Chart\";\nimport { NewReadingForm } from \"./Forms\";\nimport { dangerCls, ErrorMsg, Panel } from \"./ui\";\n\nexport default function SensorPage({\n  id,\n  session,\n  navigate,\n}: {\n  id: number;\n  session: Session | null;\n  navigate: (path: string) => void;\n}) {\n  const [sensor, setSensor] = useState<Sensor | null>(null);\n  const [readings, setReadings] = useState<Reading[]>([]);\n  const [total, setTotal] = useState(0);\n  const [error, setError] = useState<string | null>(null);\n  const [notFound, setNotFound] = useState(false);\n  const [now, setNow] = useState(Date.now());\n\n  const load = useCallback(async () => {\n    try {\n      const [s, r] = await Promise.all([\n        api<Sensor>(`/sensors/${id}`),\n        api<{ items: Reading[]; total: number }>(`/sensors/${id}/readings?limit=50`),\n      ]);\n      setSensor(s);\n      setReadings(r.items);\n      setTotal(r.total);\n      setError(null);\n      setNow(Date.now());\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 404) setNotFound(true);\n      else setError(err instanceof Error ? err.message : \"Failed to load\");\n    }\n  }, [id]);\n\n  useEffect(() => {\n    setNotFound(false);\n    setSensor(null);\n    load();\n    const t = setInterval(load, 10000);\n    return () => clearInterval(t);\n  }, [load]);\n\n  async function remove() {\n    if (!session || !sensor) return;\n    if (!window.confirm(`Delete sensor \"${sensor.name}\" and all its readings?`)) return;\n    try {\n      await api(`/sensors/${sensor.id}`, { method: \"DELETE\", token: session.token });\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Delete failed\");\n    }\n  }\n\n  if (notFound) {\n    return (\n      <div className=\"space-y-3\">\n        <p>Sensor not found.</p>\n        <a href=\"/\" onClick={(e) => { e.preventDefault(); navigate(\"/\"); }} className=\"text-blue-700 hover:underline\">\n          Back to dashboard\n        </a>\n      </div>\n    );\n  }\n  if (!sensor) return <p className=\"text-slate-500\">{error ?? \"Loading…\"}</p>;\n\n  const isOwner = session?.username.toLowerCase() === sensor.owner.toLowerCase();\n\n  return (\n    <div className=\"space-y-6\">\n      <a href=\"/\" onClick={(e) => { e.preventDefault(); navigate(\"/\"); }} className=\"text-sm text-blue-700 hover:underline\">\n        ← All sensors\n      </a>\n      <div className=\"flex flex-wrap items-start justify-between gap-3\">\n        <div>\n          <h1 className=\"text-2xl font-bold\">{sensor.name}</h1>\n          <p className=\"text-sm text-slate-500\">\n            {sensor.location || \"No location\"} · owner {sensor.owner}\n          </p>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-3xl font-semibold\">\n            {formatValue(sensor.last_value)} <span className=\"text-lg text-slate-500\">{sensor.unit}</span>\n          </p>\n          <p className=\"text-sm text-slate-500\">updated {timeAgo(sensor.last_updated, now)}</p>\n        </div>\n      </div>\n      <ErrorMsg message={error} />\n      <Panel title=\"Recent readings\">\n        <Chart readings={readings} unit={sensor.unit} />\n      </Panel>\n      {isOwner && session && (\n        <div className=\"grid gap-6 md:grid-cols-2\">\n          <NewReadingForm token={session.token} sensors={[sensor]} fixedId={sensor.id} onDone={load} />\n          <Panel title=\"Danger zone\">\n            <button className={dangerCls} onClick={remove}>\n              Delete sensor\n            </button>\n          </Panel>\n        </div>\n      )}\n      <Panel title={`Readings (${total})`}>\n        {readings.length === 0 ? (\n          <p className=\"text-sm text-slate-500\">No readings yet.</p>\n        ) : (\n          <table className=\"w-full text-left text-sm\">\n            <thead>\n              <tr className=\"border-b border-slate-200 text-slate-500\">\n                <th className=\"py-1 pr-4 font-medium\">Time</th>\n                <th className=\"py-1 font-medium\">Value</th>\n              </tr>\n            </thead>\n            <tbody>\n              {readings.map((r) => (\n                <tr key={r.id} className=\"border-b border-slate-100\">\n                  <td className=\"py-1 pr-4\">{new Date(r.recorded_at).toLocaleString()}</td>\n                  <td className=\"py-1\">\n                    {formatValue(r.value)} {sensor.unit}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        )}\n        {total > readings.length && (\n          <p className=\"mt-2 text-xs text-slate-500\">Showing the latest {readings.length} readings.</p>\n        )}\n      </Panel>\n    </div>\n  );\n}\nEOF\ncat > src/Dashboard.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, formatValue, timeAgo, type Sensor, type Session } from \"./api\";\nimport { NewReadingForm, NewSensorForm } from \"./Forms\";\nimport { dangerCls, ErrorMsg } from \"./ui\";\n\nexport default function Dashboard({\n  session,\n  navigate,\n}: {\n  session: Session | null;\n  navigate: (path: string) => void;\n}) {\n  const [sensors, setSensors] = useState<Sensor[] | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [now, setNow] = useState(Date.now());\n\n  const load = useCallback(async () => {\n    try {\n      const res = await api<{ items: Sensor[] }>(\"/sensors\");\n      setSensors(res.items);\n      setError(null);\n      setNow(Date.now());\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to load sensors\");\n    }\n  }, []);\n\n  useEffect(() => {\n    load();\n    const t = setInterval(load, 10000);\n    return () => clearInterval(t);\n  }, [load]);\n\n  async function remove(s: Sensor) {\n    if (!session) return;\n    if (!window.confirm(`Delete sensor \"${s.name}\" and all its readings?`)) return;\n    try {\n      await api(`/sensors/${s.id}`, { method: \"DELETE\", token: session.token });\n      await load();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Delete failed\");\n    }\n  }\n\n  const mine = session\n    ? (sensors ?? []).filter((s) => s.owner.toLowerCase() === session.username.toLowerCase())\n    : [];\n\n  return (\n    <div className=\"space-y-6\">\n      <ErrorMsg message={error} />\n      {sensors === null ? (\n        <p className=\"text-slate-500\">Loading…</p>\n      ) : sensors.length === 0 ? (\n        <p className=\"text-slate-500\">No sensors yet.</p>\n      ) : (\n        <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {sensors.map((s) => (\n            <article key={s.id} className=\"rounded-lg border border-slate-200 bg-white p-4 shadow-sm\">\n              <h3 className=\"font-semibold\">\n                <a\n                  href={`/sensors/${s.id}`}\n                  onClick={(e) => {\n                    e.preventDefault();\n                    navigate(`/sensors/${s.id}`);\n                  }}\n                  className=\"text-blue-700 hover:underline\"\n                >\n                  {s.name}\n                </a>\n              </h3>\n              <p className=\"my-2 text-3xl font-semibold\">\n                {formatValue(s.last_value)} <span className=\"text-lg text-slate-500\">{s.unit}</span>\n              </p>\n              <p className=\"text-sm text-slate-500\">{s.location || \"No location\"}</p>\n              <p className=\"text-sm text-slate-500\">updated {timeAgo(s.last_updated, now)}</p>\n              {session && s.owner.toLowerCase() === session.username.toLowerCase() && (\n                <button className={`${dangerCls} mt-3`} onClick={() => remove(s)}>\n                  Delete\n                </button>\n              )}\n            </article>\n          ))}\n        </div>\n      )}\n      {session && (\n        <div className=\"grid gap-6 md:grid-cols-2\">\n          <NewSensorForm token={session.token} onDone={load} />\n          <NewReadingForm token={session.token} sensors={mine} onDone={load} />\n        </div>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, loadSession, saveSession, type Session } from \"./api\";\nimport AuthForms from \"./AuthForms\";\nimport Dashboard from \"./Dashboard\";\nimport SensorPage from \"./SensorPage\";\n\nfunction usePath() {\n  const [path, setPath] = useState(window.location.pathname);\n  useEffect(() => {\n    const onPop = () => setPath(window.location.pathname);\n    window.addEventListener(\"popstate\", onPop);\n    return () => window.removeEventListener(\"popstate\", onPop);\n  }, []);\n  const navigate = useCallback((to: string) => {\n    window.history.pushState(null, \"\", to);\n    setPath(to);\n    window.scrollTo(0, 0);\n  }, []);\n  return { path, navigate };\n}\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n  const { path, navigate } = usePath();\n\n  const update = useCallback((s: Session | null) => {\n    saveSession(s);\n    setSession(s);\n  }, []);\n\n  useEffect(() => {\n    if (!session) return;\n    api(\"/auth/me\", { token: session.token }).catch((err) => {\n      if (err instanceof ApiError && err.status === 401) update(null);\n    });\n  }, [session, update]);\n\n  async function signOut() {\n    if (session) {\n      try {\n        await api(\"/auth/logout\", { method: \"POST\", token: session.token });\n      } catch {\n        /* token may already be invalid */\n      }\n    }\n    update(null);\n  }\n\n  const match = path.match(/^\\/sensors\\/(\\d+)\\/?$/);\n\n  return (\n    <div className=\"mx-auto max-w-5xl space-y-6 p-4\">\n      <header className=\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-3\">\n        <a\n          href=\"/\"\n          onClick={(e) => {\n            e.preventDefault();\n            navigate(\"/\");\n          }}\n          className=\"text-xl font-bold\"\n        >\n          Sensor dashboard\n        </a>\n        {session && (\n          <div className=\"flex items-center gap-3 text-sm\">\n            <span>\n              Signed in as <strong data-testid=\"username\">{session.username}</strong>\n            </span>\n            <button\n              onClick={signOut}\n              className=\"rounded border border-slate-300 px-3 py-1 hover:bg-slate-100\"\n            >\n              Sign out\n            </button>\n          </div>\n        )}\n      </header>\n      {!session && <AuthForms onSignedIn={update} />}\n      {match ? (\n        <SensorPage id={Number(match[1])} session={session} navigate={navigate} />\n      ) : (\n        <Dashboard session={session} navigate={navigate} />\n      )}\n    </div>\n  );\n}\nEOF\nsed -i 's|import App from \"./App\";|import App from \"./App\";\\nimport \"./index.css\";|' src/main.tsx\nnpx tsc --noEmit && npm run build 2>&1 | tail -8","timeout":300000},"output":"✓ 23 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.43 kB │ gzip:  0.29 kB\ndist/assets/index-xWbUcpPw.css   11.74 kB │ gzip:  3.15 kB\ndist/assets/index-DFflsLcC.js   233.40 kB │ gzip: 72.52 kB\n\n✓ built in 314ms\n","metadata":{"output":"✓ 23 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.43 kB │ gzip:  0.29 kB\ndist/assets/index-xWbUcpPw.css   11.74 kB │ gzip:  3.15 kB\ndist/assets/index-DFflsLcC.js   233.40 kB │ gzip: 72.52 kB\n\n✓ built in 314ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\ncat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\nsed -i 's|<title>App</title>|<title>Sensor dashboard</title>|; s|<body>|<body class=\"bg-slate-50 text-slate-900\">|' index.html\nsed -i 's|\"build\": \"vite build\"|\"typecheck\": \"tsc --noEmit\",\\n    \"build\": \"vite build\"|' package.json\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/api.ts <<'EOF'\nexport type Sensor = {\n  id: number;\n  name: string;\n  unit: string;\n  location: string;\n  last_value: number | null;\n  last_updated: string | null;\n  owner: string;\n};\n\nexport type Reading = {\n  id: number;\n  sensor_id: number;\n  value: number;\n  recorded_at: string;\n};\n\nexport type Session = { token: string; username: string };\n\nconst KEY = \"session\";\n\nexport function loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(KEY);\n    return raw ? (JSON.parse(raw) as Session) : null;\n  } catch {\n    return null;\n  }\n}\n\nexport function saveSession(s: Session | null) {\n  if (s) localStorage.setItem(KEY, JSON.stringify(s));\n  else localStorage.removeItem(KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport async function api<T>(\n  path: string,\n  opts: { method?: string; body?: unknown; token?: string } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (opts.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (opts.token) headers[\"Authorization\"] = `Bearer ${opts.token}`;\n  const res = await fetch(`/api${path}`, {\n    method: opts.method ?? \"GET\",\n    headers,\n    body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,\n  });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const msg =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, msg);\n  }\n  return data as T;\n}\n\nexport function timeAgo(iso: string | null, now: number): string {\n  if (!iso) return \"never\";\n  const secs = Math.max(0, Math.round((now - new Date(iso).getTime()) / 1000));\n  if (secs < 5) return \"just now\";\n  if (secs < 60) return `${secs}s ago`;\n  const mins = Math.floor(secs / 60);\n  if (mins < 60) return `${mins}m ago`;\n  const hours = Math.floor(mins / 60);\n  if (hours < 24) return `${hours}h ago`;\n  return `${Math.floor(hours / 24)}d ago`;\n}\n\nexport function formatValue(v: number | null): string {\n  if (v === null) return \"–\";\n  return Number.isInteger(v) ? String(v) : String(Math.round(v * 1000) / 1000);\n}\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\";\nexport const btnCls =\n  \"rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50\";\nexport const dangerCls =\n  \"rounded border border-red-300 px-3 py-1 text-sm text-red-700 hover:bg-red-50 disabled:opacity-50\";\n\nexport function Field({ label, children }: { label: string; children: ReactNode }) {\n  return (\n    <label className=\"block text-sm\">\n      <span className=\"mb-1 block font-medium text-slate-700\">{label}</span>\n      {children}\n    </label>\n  );\n}\n\nexport function ErrorMsg({ message }: { message: string | null }) {\n  if (!message) return null;\n  return (\n    <p role=\"alert\" className=\"rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </p>\n  );\n}\n\nexport function Panel({ title, children }: { title: string; children: ReactNode }) {\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-4 shadow-sm\">\n      <h2 className=\"mb-3 text-lg font-semibold\">{title}</h2>\n      {children}\n    </section>\n  );\n}\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, type Session } from \"./api\";\nimport { btnCls, ErrorMsg, Field, inputCls, Panel } from \"./ui\";\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: (s: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username, password } });\n      }\n      const res = await api<{ token: string; username?: string }>(\"/auth/login\", {\n        method: \"POST\",\n        body: { username, password },\n      });\n      onSignedIn({ token: res.token, username: res.username ?? username.trim() });\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const isLogin = mode === \"login\";\n  return (\n    <Panel title={isLogin ? \"Sign in\" : \"Create account\"}>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <Field label=\"Username\">\n          <input\n            className={inputCls}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n        </Field>\n        <Field label=\"Password\">\n          <input\n            className={inputCls}\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n            required\n          />\n        </Field>\n        <ErrorMsg message={error} />\n        <div className=\"flex items-center gap-3\">\n          <button className={btnCls} disabled={busy} type=\"submit\">\n            {isLogin ? \"Sign in\" : \"Register\"}\n          </button>\n          <button\n            type=\"button\"\n            className=\"text-sm text-blue-700 hover:underline\"\n            onClick={() => {\n              setMode(isLogin ? \"register\" : \"login\");\n              setError(null);\n            }}\n          >\n            {isLogin ? \"Need an account? Register\" : \"Have an account? Sign in\"}\n          </button>\n        </div>\n      </form>\n    </Panel>\n  );\n}\nEOF\ncat > src/Forms.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, type Sensor } from \"./api\";\nimport { btnCls, ErrorMsg, Field, inputCls, Panel } from \"./ui\";\n\nexport function NewSensorForm({ token, onDone }: { token: string; onDone: () => void }) {\n  const [name, setName] = useState(\"\");\n  const [unit, setUnit] = useState(\"\");\n  const [location, setLocation] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setBusy(true);\n    try {\n      await api(\"/sensors\", { method: \"POST\", token, body: { name, unit, location } });\n      setName(\"\");\n      setUnit(\"\");\n      setLocation(\"\");\n      onDone();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <Panel title=\"Register a sensor\">\n      <form onSubmit={submit} className=\"space-y-3\">\n        <Field label=\"Name\">\n          <input className={inputCls} value={name} onChange={(e) => setName(e.target.value)} required />\n        </Field>\n        <Field label=\"Unit\">\n          <input className={inputCls} value={unit} onChange={(e) => setUnit(e.target.value)} placeholder=\"°C\" />\n        </Field>\n        <Field label=\"Location\">\n          <input className={inputCls} value={location} onChange={(e) => setLocation(e.target.value)} />\n        </Field>\n        <ErrorMsg message={error} />\n        <button className={btnCls} disabled={busy} type=\"submit\">\n          Add sensor\n        </button>\n      </form>\n    </Panel>\n  );\n}\n\nexport function NewReadingForm({\n  token,\n  sensors,\n  fixedId,\n  onDone,\n}: {\n  token: string;\n  sensors: Sensor[];\n  fixedId?: number;\n  onDone: () => void;\n}) {\n  const [selected, setSelected] = useState<string>(\"\");\n  const [value, setValue] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const sensorId = fixedId !== undefined ? String(fixedId) : selected || String(sensors[0]?.id ?? \"\");\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    const num = Number(value);\n    if (value.trim() === \"\" || !Number.isFinite(num)) {\n      setError(\"Enter a valid number\");\n      return;\n    }\n    setBusy(true);\n    try {\n      await api(`/sensors/${sensorId}/readings`, { method: \"POST\", token, body: { value: num } });\n      setValue(\"\");\n      onDone();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  if (sensors.length === 0) {\n    return (\n      <Panel title=\"Post a reading\">\n        <p className=\"text-sm text-slate-500\">Register a sensor first.</p>\n      </Panel>\n    );\n  }\n\n  return (\n    <Panel title=\"Post a reading\">\n      <form onSubmit={submit} className=\"space-y-3\">\n        {fixedId === undefined && (\n          <Field label=\"Sensor\">\n            <select className={inputCls} value={sensorId} onChange={(e) => setSelected(e.target.value)}>\n              {sensors.map((s) => (\n                <option key={s.id} value={s.id}>\n                  {s.name}\n                </option>\n              ))}\n            </select>\n          </Field>\n        )}\n        <Field label=\"Value\">\n          <input\n            className={inputCls}\n            type=\"number\"\n            step=\"any\"\n            value={value}\n            onChange={(e) => setValue(e.target.value)}\n            required\n          />\n        </Field>\n        <ErrorMsg message={error} />\n        <button className={btnCls} disabled={busy} type=\"submit\">\n          Post reading\n        </button>\n      </form>\n    </Panel>\n  );\n}\nEOF\ncat > src/Chart.tsx <<'EOF'\nimport type { Reading } from \"./api\";\nimport { formatValue } from \"./api\";\n\nexport default function Chart({ readings, unit }: { readings: Reading[]; unit: string }) {\n  if (readings.length === 0) {\n    return <p className=\"text-sm text-slate-500\">No readings yet.</p>;\n  }\n  const pts = [...readings].reverse();\n  const W = 640;\n  const H = 240;\n  const pad = { l: 48, r: 16, t: 12, b: 28 };\n  const times = pts.map((p) => new Date(p.recorded_at).getTime());\n  const vals = pts.map((p) => p.value);\n  const tMin = Math.min(...times);\n  const tMax = Math.max(...times);\n  let vMin = Math.min(...vals);\n  let vMax = Math.max(...vals);\n  if (vMin === vMax) {\n    vMin -= 1;\n    vMax += 1;\n  }\n  const x = (i: number) =>\n    tMax === tMin\n      ? pad.l + (W - pad.l - pad.r) / 2\n      : pad.l + ((times[i] - tMin) / (tMax - tMin)) * (W - pad.l - pad.r);\n  const y = (v: number) => pad.t + (1 - (v - vMin) / (vMax - vMin)) * (H - pad.t - pad.b);\n  const path = pts.map((p, i) => `${i === 0 ? \"M\" : \"L\"}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(\" \");\n  const ticks = [vMin, (vMin + vMax) / 2, vMax];\n  const fmt = (t: number) => new Date(t).toLocaleTimeString([], { hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\" });\n\n  return (\n    <svg viewBox={`0 0 ${W} ${H}`} className=\"w-full\" role=\"img\" aria-label={`Line chart of recent readings${unit ? ` in ${unit}` : \"\"}`}>\n      {ticks.map((t) => (\n        <g key={t}>\n          <line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} className=\"stroke-slate-200\" />\n          <text x={pad.l - 6} y={y(t) + 4} textAnchor=\"end\" className=\"fill-slate-500 text-[11px]\">\n            {formatValue(Math.round(t * 100) / 100)}\n          </text>\n        </g>\n      ))}\n      <text x={pad.l} y={H - 8} className=\"fill-slate-500 text-[11px]\">\n        {fmt(tMin)}\n      </text>\n      <text x={W - pad.r} y={H - 8} textAnchor=\"end\" className=\"fill-slate-500 text-[11px]\">\n        {fmt(tMax)}\n      </text>\n      <path d={path} fill=\"none\" className=\"stroke-blue-600\" strokeWidth={2} strokeLinejoin=\"round\" />\n      {pts.map((p, i) => (\n        <circle key={p.id} cx={x(i)} cy={y(p.value)} r={3} className=\"fill-blue-600\">\n          <title>{`${formatValue(p.value)} ${unit} at ${new Date(p.recorded_at).toLocaleString()}`}</title>\n        </circle>\n      ))}\n    </svg>\n  );\n}\nEOF\ncat > src/SensorPage.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatValue, timeAgo, type Reading, type Sensor, type Session } from \"./api\";\nimport Chart from \"./Chart\";\nimport { NewReadingForm } from \"./Forms\";\nimport { dangerCls, ErrorMsg, Panel } from \"./ui\";\n\nexport default function SensorPage({\n  id,\n  session,\n  navigate,\n}: {\n  id: number;\n  session: Session | null;\n  navigate: (path: string) => void;\n}) {\n  const [sensor, setSensor] = useState<Sensor | null>(null);\n  const [readings, setReadings] = useState<Reading[]>([]);\n  const [total, setTotal] = useState(0);\n  const [error, setError] = useState<string | null>(null);\n  const [notFound, setNotFound] = useState(false);\n  const [now, setNow] = useState(Date.now());\n\n  const load = useCallback(async () => {\n    try {\n      const [s, r] = await Promise.all([\n        api<Sensor>(`/sensors/${id}`),\n        api<{ items: Reading[]; total: number }>(`/sensors/${id}/readings?limit=50`),\n      ]);\n      setSensor(s);\n      setReadings(r.items);\n      setTotal(r.total);\n      setError(null);\n      setNow(Date.now());\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 404) setNotFound(true);\n      else setError(err instanceof Error ? err.message : \"Failed to load\");\n    }\n  }, [id]);\n\n  useEffect(() => {\n    setNotFound(false);\n    setSensor(null);\n    load();\n    const t = setInterval(load, 10000);\n    return () => clearInterval(t);\n  }, [load]);\n\n  async function remove() {\n    if (!session || !sensor) return;\n    if (!window.confirm(`Delete sensor \"${sensor.name}\" and all its readings?`)) return;\n    try {\n      await api(`/sensors/${sensor.id}`, { method: \"DELETE\", token: session.token });\n      navigate(\"/\");\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Delete failed\");\n    }\n  }\n\n  if (notFound) {\n    return (\n      <div className=\"space-y-3\">\n        <p>Sensor not found.</p>\n        <a href=\"/\" onClick={(e) => { e.preventDefault(); navigate(\"/\"); }} className=\"text-blue-700 hover:underline\">\n          Back to dashboard\n        </a>\n      </div>\n    );\n  }\n  if (!sensor) return <p className=\"text-slate-500\">{error ?? \"Loading…\"}</p>;\n\n  const isOwner = session?.username.toLowerCase() === sensor.owner.toLowerCase();\n\n  return (\n    <div className=\"space-y-6\">\n      <a href=\"/\" onClick={(e) => { e.preventDefault(); navigate(\"/\"); }} className=\"text-sm text-blue-700 hover:underline\">\n        ← All sensors\n      </a>\n      <div className=\"flex flex-wrap items-start justify-between gap-3\">\n        <div>\n          <h1 className=\"text-2xl font-bold\">{sensor.name}</h1>\n          <p className=\"text-sm text-slate-500\">\n            {sensor.location || \"No location\"} · owner {sensor.owner}\n          </p>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-3xl font-semibold\">\n            {formatValue(sensor.last_value)} <span className=\"text-lg text-slate-500\">{sensor.unit}</span>\n          </p>\n          <p className=\"text-sm text-slate-500\">updated {timeAgo(sensor.last_updated, now)}</p>\n        </div>\n      </div>\n      <ErrorMsg message={error} />\n      <Panel title=\"Recent readings\">\n        <Chart readings={readings} unit={sensor.unit} />\n      </Panel>\n      {isOwner && session && (\n        <div className=\"grid gap-6 md:grid-cols-2\">\n          <NewReadingForm token={session.token} sensors={[sensor]} fixedId={sensor.id} onDone={load} />\n          <Panel title=\"Danger zone\">\n            <button className={dangerCls} onClick={remove}>\n              Delete sensor\n            </button>\n          </Panel>\n        </div>\n      )}\n      <Panel title={`Readings (${total})`}>\n        {readings.length === 0 ? (\n          <p className=\"text-sm text-slate-500\">No readings yet.</p>\n        ) : (\n          <table className=\"w-full text-left text-sm\">\n            <thead>\n              <tr className=\"border-b border-slate-200 text-slate-500\">\n                <th className=\"py-1 pr-4 font-medium\">Time</th>\n                <th className=\"py-1 font-medium\">Value</th>\n              </tr>\n            </thead>\n            <tbody>\n              {readings.map((r) => (\n                <tr key={r.id} className=\"border-b border-slate-100\">\n                  <td className=\"py-1 pr-4\">{new Date(r.recorded_at).toLocaleString()}</td>\n                  <td className=\"py-1\">\n                    {formatValue(r.value)} {sensor.unit}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        )}\n        {total > readings.length && (\n          <p className=\"mt-2 text-xs text-slate-500\">Showing the latest {readings.length} readings.</p>\n        )}\n      </Panel>\n    </div>\n  );\n}\nEOF\ncat > src/Dashboard.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, formatValue, timeAgo, type Sensor, type Session } from \"./api\";\nimport { NewReadingForm, NewSensorForm } from \"./Forms\";\nimport { dangerCls, ErrorMsg } from \"./ui\";\n\nexport default function Dashboard({\n  session,\n  navigate,\n}: {\n  session: Session | null;\n  navigate: (path: string) => void;\n}) {\n  const [sensors, setSensors] = useState<Sensor[] | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [now, setNow] = useState(Date.now());\n\n  const load = useCallback(async () => {\n    try {\n      const res = await api<{ items: Sensor[] }>(\"/sensors\");\n      setSensors(res.items);\n      setError(null);\n      setNow(Date.now());\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to load sensors\");\n    }\n  }, []);\n\n  useEffect(() => {\n    load();\n    const t = setInterval(load, 10000);\n    return () => clearInterval(t);\n  }, [load]);\n\n  async function remove(s: Sensor) {\n    if (!session) return;\n    if (!window.confirm(`Delete sensor \"${s.name}\" and all its readings?`)) return;\n    try {\n      await api(`/sensors/${s.id}`, { method: \"DELETE\", token: session.token });\n      await load();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Delete failed\");\n    }\n  }\n\n  const mine = session\n    ? (sensors ?? []).filter((s) => s.owner.toLowerCase() === session.username.toLowerCase())\n    : [];\n\n  return (\n    <div className=\"space-y-6\">\n      <ErrorMsg message={error} />\n      {sensors === null ? (\n        <p className=\"text-slate-500\">Loading…</p>\n      ) : sensors.length === 0 ? (\n        <p className=\"text-slate-500\">No sensors yet.</p>\n      ) : (\n        <div className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {sensors.map((s) => (\n            <article key={s.id} className=\"rounded-lg border border-slate-200 bg-white p-4 shadow-sm\">\n              <h3 className=\"font-semibold\">\n                <a\n                  href={`/sensors/${s.id}`}\n                  onClick={(e) => {\n                    e.preventDefault();\n                    navigate(`/sensors/${s.id}`);\n                  }}\n                  className=\"text-blue-700 hover:underline\"\n                >\n                  {s.name}\n                </a>\n              </h3>\n              <p className=\"my-2 text-3xl font-semibold\">\n                {formatValue(s.last_value)} <span className=\"text-lg text-slate-500\">{s.unit}</span>\n              </p>\n              <p className=\"text-sm text-slate-500\">{s.location || \"No location\"}</p>\n              <p className=\"text-sm text-slate-500\">updated {timeAgo(s.last_updated, now)}</p>\n              {session && s.owner.toLowerCase() === session.username.toLowerCase() && (\n                <button className={`${dangerCls} mt-3`} onClick={() => remove(s)}>\n                  Delete\n                </button>\n              )}\n            </article>\n          ))}\n        </div>\n      )}\n      {session && (\n        <div className=\"grid gap-6 md:grid-cols-2\">\n          <NewSensorForm token={session.token} onDone={load} />\n          <NewReadingForm token={session.token} sensors={mine} onDone={load} />\n        </div>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, loadSession, saveSession, type Session } from \"./api\";\nimport AuthForms from \"./AuthForms\";\nimport Dashboard from \"./Dashboard\";\nimport SensorPage from \"./SensorPage\";\n\nfunction usePath() {\n  const [path, setPath] = useState(window.location.pathname);\n  useEffect(() => {\n    const onPop = () => setPath(window.location.pathname);\n    window.addEventListener(\"popstate\", onPop);\n    return () => window.removeEventListener(\"popstate\", onPop);\n  }, []);\n  const navigate = useCallback((to: string) => {\n    window.history.pushState(null, \"\", to);\n    setPath(to);\n    window.scrollTo(0, 0);\n  }, []);\n  return { path, navigate };\n}\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n  const { path, navigate } = usePath();\n\n  const update = useCallback((s: Session | null) => {\n    saveSession(s);\n    setSession(s);\n  }, []);\n\n  useEffect(() => {\n    if (!session) return;\n    api(\"/auth/me\", { token: session.token }).catch((err) => {\n      if (err instanceof ApiError && err.status === 401) update(null);\n    });\n  }, [session, update]);\n\n  async function signOut() {\n    if (session) {\n      try {\n        await api(\"/auth/logout\", { method: \"POST\", token: session.token });\n      } catch {\n        /* token may already be invalid */\n      }\n    }\n    update(null);\n  }\n\n  const match = path.match(/^\\/sensors\\/(\\d+)\\/?$/);\n\n  return (\n    <div className=\"mx-auto max-w-5xl space-y-6 p-4\">\n      <header className=\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-3\">\n        <a\n          href=\"/\"\n          onClick={(e) => {\n            e.preventDefault();\n            navigate(\"/\");\n          }}\n          className=\"text-xl font-bold\"\n        >\n          Sensor dashboard\n        </a>\n        {session && (\n          <div className=\"flex items-center gap-3 text-sm\">\n            <span>\n              Signed in as <strong data-testid=\"username\">{session.username}</strong>\n            </span>\n            <button\n              onClick={signOut}\n              className=\"rounded border border-slate-300 px-3 py-1 hover:bg-slate-100\"\n            >\n              Sign out\n            </button>\n          </div>\n        )}\n      </header>\n      {!session && <AuthForms onSignedIn={update} />}\n      {match ? (\n        <SensorPage id={Number(match[1])} session={session} navigate={navigate} />\n      ) : (\n        <Dashboard session={session} navigate={navigate} />\n      )}\n    </div>\n  );\n}\nEOF\nsed -i 's|import App from \"./App\";|import App from \"./App\";\\nimport \"./index.css\";|' src/main.tsx\nnpx tsc --noEmit && npm run build 2>&1 | tail -8","time":{"start":1794249673177,"end":1794249675319}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c19d49cf001k8moTqbCoxXh6g","sessionID":"ses_e3e66b214ffeN0e56FsH12pS0n","messageID":"msg_1c19c87d7001iU7MBoyXIJLjig"}}
