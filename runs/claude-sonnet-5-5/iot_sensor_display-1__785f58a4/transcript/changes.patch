--- /dev/null
+++ b/frontend/src/AuthForms.tsx
@@ -0,0 +1,74 @@
+import { useState, type FormEvent } from "react";
+import { api, type Session } from "./api";
+import { btnCls, ErrorMsg, Field, inputCls, Panel } from "./ui";
+
+export default function AuthForms({ onSignedIn }: { onSignedIn: (s: Session) => void }) {
+  const [mode, setMode] = useState<"login" | "register">("login");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setBusy(true);
+    try {
+      if (mode === "register") {
+        await api("/auth/register", { method: "POST", body: { username, password } });
+      }
+      const res = await api<{ token: string; username?: string }>("/auth/login", {
+        method: "POST",
+        body: { username, password },
+      });
+      onSignedIn({ token: res.token, username: res.username ?? username.trim() });
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Something went wrong");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const isLogin = mode === "login";
+  return (
+    <Panel title={isLogin ? "Sign in" : "Create account"}>
+      <form onSubmit={submit} className="space-y-3">
+        <Field label="Username">
+          <input
+            className={inputCls}
+            value={username}
+            onChange={(e) => setUsername(e.target.value)}
+            autoComplete="username"
+            required
+          />
+        </Field>
+        <Field label="Password">
+          <input
+            className={inputCls}
+            type="password"
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            autoComplete={isLogin ? "current-password" : "new-password"}
+            required
+          />
+        </Field>
+        <ErrorMsg message={error} />
+        <div className="flex items-center gap-3">
+          <button className={btnCls} disabled={busy} type="submit">
+            {isLogin ? "Sign in" : "Register"}
+          </button>
+          <button
+            type="button"
+            className="text-sm text-blue-700 hover:underline"
+            onClick={() => {
+              setMode(isLogin ? "register" : "login");
+              setError(null);
+            }}
+          >
+            {isLogin ? "Need an account? Register" : "Have an account? Sign in"}
+          </button>
+        </div>
+      </form>
+    </Panel>
+  );
+}
diff --git a/frontend/src/Chart.tsx b/frontend/src/Chart.tsx
new file mode 100644
index 0000000..be9b0bb
--- /dev/null
+++ b/frontend/src/Chart.tsx
@@ -0,0 +1,55 @@
+import type { Reading } from "./api";
+import { formatValue } from "./api";
+
+export default function Chart({ readings, unit }: { readings: Reading[]; unit: string }) {
+  if (readings.length === 0) {
+    return <p className="text-sm text-slate-500">No readings yet.</p>;
+  }
+  const pts = [...readings].reverse();
+  const W = 640;
+  const H = 240;
+  const pad = { l: 48, r: 16, t: 12, b: 28 };
+  const times = pts.map((p) => new Date(p.recorded_at).getTime());
+  const vals = pts.map((p) => p.value);
+  const tMin = Math.min(...times);
+  const tMax = Math.max(...times);
+  let vMin = Math.min(...vals);
+  let vMax = Math.max(...vals);
+  if (vMin === vMax) {
+    vMin -= 1;
+    vMax += 1;
+  }
+  const x = (i: number) =>
+    tMax === tMin
+      ? pad.l + (W - pad.l - pad.r) / 2
+      : pad.l + ((times[i] - tMin) / (tMax - tMin)) * (W - pad.l - pad.r);
+  const y = (v: number) => pad.t + (1 - (v - vMin) / (vMax - vMin)) * (H - pad.t - pad.b);
+  const path = pts.map((p, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(" ");
+  const ticks = [vMin, (vMin + vMax) / 2, vMax];
+  const fmt = (t: number) => new Date(t).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
+
+  return (
+    <svg viewBox={`0 0 ${W} ${H}`} className="w-full" role="img" aria-label={`Line chart of recent readings${unit ? ` in ${unit}` : ""}`}>
+      {ticks.map((t) => (
+        <g key={t}>
+          <line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} className="stroke-slate-200" />
+          <text x={pad.l - 6} y={y(t) + 4} textAnchor="end" className="fill-slate-500 text-[11px]">
+            {formatValue(Math.round(t * 100) / 100)}
+          </text>
+        </g>
+      ))}
+      <text x={pad.l} y={H - 8} className="fill-slate-500 text-[11px]">
+        {fmt(tMin)}
+      </text>
+      <text x={W - pad.r} y={H - 8} textAnchor="end" className="fill-slate-500 text-[11px]">
+        {fmt(tMax)}
+      </text>
+      <path d={path} fill="none" className="stroke-blue-600" strokeWidth={2} strokeLinejoin="round" />
+      {pts.map((p, i) => (
+        <circle key={p.id} cx={x(i)} cy={y(p.value)} r={3} className="fill-blue-600">
+          <title>{`${formatValue(p.value)} ${unit} at ${new Date(p.recorded_at).toLocaleString()}`}</title>
+        </circle>
+      ))}
+    </svg>
+  );
+}
diff --git a/frontend/src/Dashboard.tsx b/frontend/src/Dashboard.tsx
new file mode 100644
index 0000000..7a168f0
--- /dev/null
+++ b/frontend/src/Dashboard.tsx
@@ -0,0 +1,94 @@
+import { useCallback, useEffect, useState } from "react";
+import { api, formatValue, timeAgo, type Sensor, type Session } from "./api";
+import { NewReadingForm, NewSensorForm } from "./Forms";
+import { dangerCls, ErrorMsg } from "./ui";
+
+export default function Dashboard({
+  session,
+  navigate,
+}: {
+  session: Session | null;
+  navigate: (path: string) => void;
+}) {
+  const [sensors, setSensors] = useState<Sensor[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [now, setNow] = useState(Date.now());
+
+  const load = useCallback(async () => {
+    try {
+      const res = await api<{ items: Sensor[] }>("/sensors");
+      setSensors(res.items);
+      setError(null);
+      setNow(Date.now());
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Failed to load sensors");
+    }
+  }, []);
+
+  useEffect(() => {
+    load();
+    const t = setInterval(load, 10000);
+    return () => clearInterval(t);
+  }, [load]);
+
+  async function remove(s: Sensor) {
+    if (!session) return;
+    if (!window.confirm(`Delete sensor "${s.name}" and all its readings?`)) return;
+    try {
+      await api(`/sensors/${s.id}`, { method: "DELETE", token: session.token });
+      await load();
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Delete failed");
+    }
+  }
+
+  const mine = session
+    ? (sensors ?? []).filter((s) => s.owner.toLowerCase() === session.username.toLowerCase())
+    : [];
+
+  return (
+    <div className="space-y-6">
+      <ErrorMsg message={error} />
+      {sensors === null ? (
+        <p className="text-slate-500">Loading…</p>
+      ) : sensors.length === 0 ? (
+        <p className="text-slate-500">No sensors yet.</p>
+      ) : (
+        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
+          {sensors.map((s) => (
+            <article key={s.id} className="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
+              <h3 className="font-semibold">
+                <a
+                  href={`/sensors/${s.id}`}
+                  onClick={(e) => {
+                    e.preventDefault();
+                    navigate(`/sensors/${s.id}`);
+                  }}
+                  className="text-blue-700 hover:underline"
+                >
+                  {s.name}
+                </a>
+              </h3>
+              <p className="my-2 text-3xl font-semibold">
+                {formatValue(s.last_value)} <span className="text-lg text-slate-500">{s.unit}</span>
+              </p>
+              <p className="text-sm text-slate-500">{s.location || "No location"}</p>
+              <p className="text-sm text-slate-500">updated {timeAgo(s.last_updated, now)}</p>
+              {session && s.owner.toLowerCase() === session.username.toLowerCase() && (
+                <button className={`${dangerCls} mt-3`} onClick={() => remove(s)}>
+                  Delete
+                </button>
+              )}
+            </article>
+          ))}
+        </div>
+      )}
+      {session && (
+        <div className="grid gap-6 md:grid-cols-2">
+          <NewSensorForm token={session.token} onDone={load} />
+          <NewReadingForm token={session.token} sensors={mine} onDone={load} />
+        </div>
+      )}
+    </div>
+  );
+}
