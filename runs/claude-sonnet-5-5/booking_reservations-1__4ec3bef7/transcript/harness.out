{"type":"tool_use","timestamp":1794255299414,"sessionID":"ses_e3e0de511ffe6dmfRODJ9zj5yX","part":{"type":"tool","tool":"bash","callID":"toolu_01BnmxdmCEnDhq6hRQ3cew6c","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Table reservations: Flask JSON API plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom contextlib import contextmanager\nfrom datetime import date as date_type\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request\nfrom flask import send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash, safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"reservations.db\"\n\nSLOT_CAPACITY = 20\nADMIN_USERNAME = \"admin\"\nTOKEN_TTL = timedelta(days=7)\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\nTIME_RE = re.compile(r\"^([01]\\d|2[0-3]):([0-5]\\d)$\")\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\napp.json.sort_keys = False\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err: ApiError):\n    return jsonify({\"error\": err.message}), err.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(err: HTTPException):\n    return jsonify({\"error\": err.description or err.name}), err.code or 500\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                expires_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS reservations (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                name TEXT NOT NULL,\n                email TEXT NOT NULL,\n                date TEXT NOT NULL,\n                time TEXT NOT NULL,\n                party_size INTEGER NOT NULL CHECK (party_size BETWEEN 1 AND 20),\n                notes TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_res_slot ON reservations(date, time);\n            CREATE INDEX IF NOT EXISTS idx_res_user ON reservations(user_id, date, time);\n            \"\"\"\n        )\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\n@contextmanager\ndef write_tx():\n    conn = db()\n    conn.execute(\"BEGIN IMMEDIATE\")\n    try:\n        yield conn\n    except BaseException:\n        conn.execute(\"ROLLBACK\")\n        raise\n    else:\n        conn.execute(\"COMMIT\")\n\n\ndef admin_password() -> str:\n    return os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef is_admin_name(username: str) -> bool:\n    return username.lower() == ADMIN_USERNAME\n\n\ndef current_user() -> sqlite3.Row:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    token = token.strip()\n    if scheme.lower() != \"bearer\" or not token:\n        raise ApiError(401, \"Authentication required\")\n    row = db().execute(\n        \"\"\"\n        SELECT u.id, u.username, s.expires_at FROM sessions s\n        JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?\n        \"\"\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        raise ApiError(401, \"Invalid or expired token\")\n    if is_admin_name(row[\"username\"]) and not admin_password():\n        raise ApiError(401, \"Invalid or expired token\")\n    g.token_hash = hash_token(token)\n    return row\n\n\ndef require_admin() -> sqlite3.Row:\n    user = current_user()\n    if not is_admin_name(user[\"username\"]):\n        raise ApiError(403, \"Admin access required\")\n    return user\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    expires = (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE expires_at < ?\", (now_iso(),))\n    conn.execute(\n        \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user_id, expires),\n    )\n    return token\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"username and password are required\")\n    username = username.strip()\n    if not username or len(username) > 64:\n        raise ApiError(400, \"username must be 1-64 characters\")\n    if not password or len(password) > 256:\n        raise ApiError(400, \"password must be 1-256 characters\")\n    if is_admin_name(username):\n        raise ApiError(409, \"Username is already taken\")\n    try:\n        with write_tx() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        raise ApiError(409, \"Username is already taken\")\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"username and password are required\")\n    username = username.strip()\n    invalid = ApiError(401, \"Invalid username or password\")\n\n    if is_admin_name(username):\n        configured = admin_password()\n        if not configured or not hmac.compare_digest(\n            password.encode(), configured.encode()\n        ):\n            raise invalid\n        with write_tx() as conn:\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n            if row is None:\n                cur = conn.execute(\n                    \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                    (ADMIN_USERNAME, \"!\", now_iso()),\n                )\n                user_id = cur.lastrowid\n            else:\n                user_id = row[\"id\"]\n            token = issue_token(user_id)\n        return jsonify({\"token\": token})\n\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        raise invalid\n    if not check_password_hash(row[\"password_hash\"], password):\n        raise invalid\n    with write_tx():\n        token = issue_token(row[\"id\"])\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    return jsonify(\n        {\"username\": user[\"username\"], \"is_admin\": is_admin_name(user[\"username\"])}\n    )\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    current_user()\n    db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n    return \"\", 204\n\n\ndef parse_date(value) -> str:\n    if not isinstance(value, str) or not DATE_RE.match(value):\n        raise ApiError(400, \"date must be formatted YYYY-MM-DD\")\n    try:\n        date_type.fromisoformat(value)\n    except ValueError:\n        raise ApiError(400, \"date is not a valid calendar date\")\n    return value\n\n\ndef parse_time(value) -> str:\n    if not isinstance(value, str) or not TIME_RE.match(value):\n        raise ApiError(400, \"time must be formatted HH:MM (24-hour)\")\n    return value\n\n\ndef parse_reservation(data: dict) -> dict:\n    name = data.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        raise ApiError(400, \"name is required\")\n    name = name.strip()\n    if len(name) > 100:\n        raise ApiError(400, \"name must be at most 100 characters\")\n\n    email = data.get(\"email\")\n    if not isinstance(email, str) or not EMAIL_RE.match(email.strip()):\n        raise ApiError(400, \"a valid email is required\")\n    email = email.strip()\n    if len(email) > 254:\n        raise ApiError(400, \"email must be at most 254 characters\")\n\n    if \"date\" not in data:\n        raise ApiError(400, \"date is required\")\n    if \"time\" not in data:\n        raise ApiError(400, \"time is required\")\n    day = parse_date(data.get(\"date\"))\n    time = parse_time(data.get(\"time\"))\n\n    size = data.get(\"party_size\")\n    if isinstance(size, bool) or not isinstance(size, int):\n        raise ApiError(400, \"party_size must be an integer\")\n    if size < 1 or size > SLOT_CAPACITY:\n        raise ApiError(400, f\"party_size must be between 1 and {SLOT_CAPACITY}\")\n\n    notes = data.get(\"notes\")\n    if notes is not None:\n        if not isinstance(notes, str):\n            raise ApiError(400, \"notes must be a string\")\n        notes = notes.strip() or None\n        if notes is not None and len(notes) > 1000:\n            raise ApiError(400, \"notes must be at most 1000 characters\")\n\n    return {\n        \"name\": name,\n        \"email\": email,\n        \"date\": day,\n        \"time\": time,\n        \"party_size\": size,\n        \"notes\": notes,\n    }\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"email\": row[\"email\"],\n        \"date\": row[\"date\"],\n        \"time\": row[\"time\"],\n        \"party_size\": row[\"party_size\"],\n        \"notes\": row[\"notes\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\nCOLUMNS = \"id, name, email, date, time, party_size, notes, created_at\"\n\n\ndef ensure_capacity(conn, day: str, time: str, size: int, exclude_id=None) -> None:\n    row = conn.execute(\n        \"\"\"\n        SELECT COALESCE(SUM(party_size), 0) AS booked FROM reservations\n        WHERE date = ? AND time = ? AND id IS NOT ?\n        \"\"\",\n        (day, time, exclude_id),\n    ).fetchone()\n    remaining = SLOT_CAPACITY - row[\"booked\"]\n    if size > remaining:\n        if remaining <= 0:\n            raise ApiError(409, \"That time slot is full\")\n        raise ApiError(\n            409,\n            f\"That time slot only has {remaining} seat{'s' if remaining != 1 else ''} left\",\n        )\n\n\ndef own_reservation(conn, user_id: int, res_id: int) -> sqlite3.Row:\n    row = conn.execute(\n        f\"SELECT {COLUMNS} FROM reservations WHERE id = ? AND user_id = ?\",\n        (res_id, user_id),\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"Reservation not found\")\n    return row\n\n\n@app.post(\"/api/reservations\")\ndef create_reservation():\n    user = current_user()\n    fields = parse_reservation(json_body())\n    with write_tx() as conn:\n        ensure_capacity(conn, fields[\"date\"], fields[\"time\"], fields[\"party_size\"])\n        cur = conn.execute(\n            \"\"\"\n            INSERT INTO reservations\n                (user_id, name, email, date, time, party_size, notes, created_at)\n            VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n            \"\"\",\n            (\n                user[\"id\"],\n                fields[\"name\"],\n                fields[\"email\"],\n                fields[\"date\"],\n                fields[\"time\"],\n                fields[\"party_size\"],\n                fields[\"notes\"],\n                now_iso(),\n            ),\n        )\n        row = conn.execute(\n            f\"SELECT {COLUMNS} FROM reservations WHERE id = ?\", (cur.lastrowid,)\n        ).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.get(\"/api/reservations\")\ndef list_reservations():\n    user = current_user()\n    where = \"user_id = ?\"\n    params: list = [user[\"id\"]]\n    if \"date\" in request.args:\n        where += \" AND date = ?\"\n        params.append(parse_date(request.args[\"date\"]))\n    conn = db()\n    rows = conn.execute(\n        f\"SELECT {COLUMNS} FROM reservations WHERE {where} ORDER BY date, time, id\",\n        params,\n    ).fetchall()\n    return jsonify({\"items\": [serialize(r) for r in rows], \"total\": len(rows)})\n\n\n@app.get(\"/api/reservations/<int:res_id>\")\ndef get_reservation(res_id: int):\n    user = current_user()\n    return jsonify(serialize(own_reservation(db(), user[\"id\"], res_id)))\n\n\n@app.put(\"/api/reservations/<int:res_id>\")\ndef replace_reservation(res_id: int):\n    user = current_user()\n    fields = parse_reservation(json_body())\n    with write_tx() as conn:\n        own_reservation(conn, user[\"id\"], res_id)\n        ensure_capacity(\n            conn, fields[\"date\"], fields[\"time\"], fields[\"party_size\"], res_id\n        )\n        conn.execute(\n            \"\"\"\n            UPDATE reservations\n            SET name = ?, email = ?, date = ?, time = ?, party_size = ?, notes = ?\n            WHERE id = ?\n            \"\"\",\n            (\n                fields[\"name\"],\n                fields[\"email\"],\n                fields[\"date\"],\n                fields[\"time\"],\n                fields[\"party_size\"],\n                fields[\"notes\"],\n                res_id,\n            ),\n        )\n        row = conn.execute(\n            f\"SELECT {COLUMNS} FROM reservations WHERE id = ?\", (res_id,)\n        ).fetchone()\n    return jsonify(serialize(row))\n\n\n@app.delete(\"/api/reservations/<int:res_id>\")\ndef cancel_reservation(res_id: int):\n    user = current_user()\n    with write_tx() as conn:\n        own_reservation(conn, user[\"id\"], res_id)\n        conn.execute(\"DELETE FROM reservations WHERE id = ?\", (res_id,))\n    return \"\", 204\n\n\n@app.get(\"/api/availability\")\ndef availability():\n    if \"date\" not in request.args:\n        raise ApiError(400, \"date is required\")\n    day = parse_date(request.args[\"date\"])\n    rows = db().execute(\n        \"\"\"\n        SELECT time, SUM(party_size) AS booked FROM reservations\n        WHERE date = ? GROUP BY time ORDER BY time\n        \"\"\",\n        (day,),\n    ).fetchall()\n    items = [\n        {\n            \"time\": r[\"time\"],\n            \"booked\": r[\"booked\"],\n            \"remaining\": max(SLOT_CAPACITY - r[\"booked\"], 0),\n        }\n        for r in rows\n    ]\n    return jsonify({\"items\": items})\n\n\ndef int_arg(name: str, default: int, maximum=None) -> int:\n    raw = request.args.get(name)\n    if raw is None:\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if value < 1:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if maximum is not None and value > maximum:\n        raise ApiError(400, f\"{name} must be at most {maximum}\")\n    return value\n\n\n@app.get(\"/api/admin/reservations\")\ndef admin_reservations():\n    require_admin()\n    where = \"1 = 1\"\n    params: list = []\n    if \"date\" in request.args:\n        where += \" AND date = ?\"\n        params.append(parse_date(request.args[\"date\"]))\n    page = int_arg(\"page\", 1)\n    page_size = int_arg(\"page_size\", DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        f\"SELECT COUNT(*) AS n FROM reservations WHERE {where}\", params\n    ).fetchone()[\"n\"]\n    rows = conn.execute(\n        f\"\"\"\n        SELECT {COLUMNS} FROM reservations WHERE {where}\n        ORDER BY date, time, id LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    raise ApiError(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = safe_join(str(DIST), path)\n    if target is not None and Path(target).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Table reservations: Flask JSON API plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom contextlib import contextmanager\nfrom datetime import date as date_type\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request\nfrom flask import send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash, safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"reservations.db\"\n\nSLOT_CAPACITY = 20\nADMIN_USERNAME = \"admin\"\nTOKEN_TTL = timedelta(days=7)\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\nTIME_RE = re.compile(r\"^([01]\\d|2[0-3]):([0-5]\\d)$\")\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\napp.json.sort_keys = False\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str):\n        super().__init__(message)\n        self.status = status\n        self.message = message\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err: ApiError):\n    return jsonify({\"error\": err.message}), err.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(err: HTTPException):\n    return jsonify({\"error\": err.description or err.name}), err.code or 500\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS sessions (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                expires_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS reservations (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                name TEXT NOT NULL,\n                email TEXT NOT NULL,\n                date TEXT NOT NULL,\n                time TEXT NOT NULL,\n                party_size INTEGER NOT NULL CHECK (party_size BETWEEN 1 AND 20),\n                notes TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS idx_res_slot ON reservations(date, time);\n            CREATE INDEX IF NOT EXISTS idx_res_user ON reservations(user_id, date, time);\n            \"\"\"\n        )\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\n@contextmanager\ndef write_tx():\n    conn = db()\n    conn.execute(\"BEGIN IMMEDIATE\")\n    try:\n        yield conn\n    except BaseException:\n        conn.execute(\"ROLLBACK\")\n        raise\n    else:\n        conn.execute(\"COMMIT\")\n\n\ndef admin_password() -> str:\n    return os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef is_admin_name(username: str) -> bool:\n    return username.lower() == ADMIN_USERNAME\n\n\ndef current_user() -> sqlite3.Row:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    token = token.strip()\n    if scheme.lower() != \"bearer\" or not token:\n        raise ApiError(401, \"Authentication required\")\n    row = db().execute(\n        \"\"\"\n        SELECT u.id, u.username, s.expires_at FROM sessions s\n        JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?\n        \"\"\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        raise ApiError(401, \"Invalid or expired token\")\n    if is_admin_name(row[\"username\"]) and not admin_password():\n        raise ApiError(401, \"Invalid or expired token\")\n    g.token_hash = hash_token(token)\n    return row\n\n\ndef require_admin() -> sqlite3.Row:\n    user = current_user()\n    if not is_admin_name(user[\"username\"]):\n        raise ApiError(403, \"Admin access required\")\n    return user\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    expires = (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE expires_at < ?\", (now_iso(),))\n    conn.execute(\n        \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user_id, expires),\n    )\n    return token\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"username and password are required\")\n    username = username.strip()\n    if not username or len(username) > 64:\n        raise ApiError(400, \"username must be 1-64 characters\")\n    if not password or len(password) > 256:\n        raise ApiError(400, \"password must be 1-256 characters\")\n    if is_admin_name(username):\n        raise ApiError(409, \"Username is already taken\")\n    try:\n        with write_tx() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        raise ApiError(409, \"Username is already taken\")\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"username and password are required\")\n    username = username.strip()\n    invalid = ApiError(401, \"Invalid username or password\")\n\n    if is_admin_name(username):\n        configured = admin_password()\n        if not configured or not hmac.compare_digest(\n            password.encode(), configured.encode()\n        ):\n            raise invalid\n        with write_tx() as conn:\n            row = conn.execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n            if row is None:\n                cur = conn.execute(\n                    \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                    (ADMIN_USERNAME, \"!\", now_iso()),\n                )\n                user_id = cur.lastrowid\n            else:\n                user_id = row[\"id\"]\n            token = issue_token(user_id)\n        return jsonify({\"token\": token})\n\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        raise invalid\n    if not check_password_hash(row[\"password_hash\"], password):\n        raise invalid\n    with write_tx():\n        token = issue_token(row[\"id\"])\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    return jsonify(\n        {\"username\": user[\"username\"], \"is_admin\": is_admin_name(user[\"username\"])}\n    )\n\n\n@app.post(\"/api/auth/logout\")\ndef logout():\n    current_user()\n    db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n    return \"\", 204\n\n\ndef parse_date(value) -> str:\n    if not isinstance(value, str) or not DATE_RE.match(value):\n        raise ApiError(400, \"date must be formatted YYYY-MM-DD\")\n    try:\n        date_type.fromisoformat(value)\n    except ValueError:\n        raise ApiError(400, \"date is not a valid calendar date\")\n    return value\n\n\ndef parse_time(value) -> str:\n    if not isinstance(value, str) or not TIME_RE.match(value):\n        raise ApiError(400, \"time must be formatted HH:MM (24-hour)\")\n    return value\n\n\ndef parse_reservation(data: dict) -> dict:\n    name = data.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        raise ApiError(400, \"name is required\")\n    name = name.strip()\n    if len(name) > 100:\n        raise ApiError(400, \"name must be at most 100 characters\")\n\n    email = data.get(\"email\")\n    if not isinstance(email, str) or not EMAIL_RE.match(email.strip()):\n        raise ApiError(400, \"a valid email is required\")\n    email = email.strip()\n    if len(email) > 254:\n        raise ApiError(400, \"email must be at most 254 characters\")\n\n    if \"date\" not in data:\n        raise ApiError(400, \"date is required\")\n    if \"time\" not in data:\n        raise ApiError(400, \"time is required\")\n    day = parse_date(data.get(\"date\"))\n    time = parse_time(data.get(\"time\"))\n\n    size = data.get(\"party_size\")\n    if isinstance(size, bool) or not isinstance(size, int):\n        raise ApiError(400, \"party_size must be an integer\")\n    if size < 1 or size > SLOT_CAPACITY:\n        raise ApiError(400, f\"party_size must be between 1 and {SLOT_CAPACITY}\")\n\n    notes = data.get(\"notes\")\n    if notes is not None:\n        if not isinstance(notes, str):\n            raise ApiError(400, \"notes must be a string\")\n        notes = notes.strip() or None\n        if notes is not None and len(notes) > 1000:\n            raise ApiError(400, \"notes must be at most 1000 characters\")\n\n    return {\n        \"name\": name,\n        \"email\": email,\n        \"date\": day,\n        \"time\": time,\n        \"party_size\": size,\n        \"notes\": notes,\n    }\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"name\": row[\"name\"],\n        \"email\": row[\"email\"],\n        \"date\": row[\"date\"],\n        \"time\": row[\"time\"],\n        \"party_size\": row[\"party_size\"],\n        \"notes\": row[\"notes\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\nCOLUMNS = \"id, name, email, date, time, party_size, notes, created_at\"\n\n\ndef ensure_capacity(conn, day: str, time: str, size: int, exclude_id=None) -> None:\n    row = conn.execute(\n        \"\"\"\n        SELECT COALESCE(SUM(party_size), 0) AS booked FROM reservations\n        WHERE date = ? AND time = ? AND id IS NOT ?\n        \"\"\",\n        (day, time, exclude_id),\n    ).fetchone()\n    remaining = SLOT_CAPACITY - row[\"booked\"]\n    if size > remaining:\n        if remaining <= 0:\n            raise ApiError(409, \"That time slot is full\")\n        raise ApiError(\n            409,\n            f\"That time slot only has {remaining} seat{'s' if remaining != 1 else ''} left\",\n        )\n\n\ndef own_reservation(conn, user_id: int, res_id: int) -> sqlite3.Row:\n    row = conn.execute(\n        f\"SELECT {COLUMNS} FROM reservations WHERE id = ? AND user_id = ?\",\n        (res_id, user_id),\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"Reservation not found\")\n    return row\n\n\n@app.post(\"/api/reservations\")\ndef create_reservation():\n    user = current_user()\n    fields = parse_reservation(json_body())\n    with write_tx() as conn:\n        ensure_capacity(conn, fields[\"date\"], fields[\"time\"], fields[\"party_size\"])\n        cur = conn.execute(\n            \"\"\"\n            INSERT INTO reservations\n                (user_id, name, email, date, time, party_size, notes, created_at)\n            VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n            \"\"\",\n            (\n                user[\"id\"],\n                fields[\"name\"],\n                fields[\"email\"],\n                fields[\"date\"],\n                fields[\"time\"],\n                fields[\"party_size\"],\n                fields[\"notes\"],\n                now_iso(),\n            ),\n        )\n        row = conn.execute(\n            f\"SELECT {COLUMNS} FROM reservations WHERE id = ?\", (cur.lastrowid,)\n        ).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.get(\"/api/reservations\")\ndef list_reservations():\n    user = current_user()\n    where = \"user_id = ?\"\n    params: list = [user[\"id\"]]\n    if \"date\" in request.args:\n        where += \" AND date = ?\"\n        params.append(parse_date(request.args[\"date\"]))\n    conn = db()\n    rows = conn.execute(\n        f\"SELECT {COLUMNS} FROM reservations WHERE {where} ORDER BY date, time, id\",\n        params,\n    ).fetchall()\n    return jsonify({\"items\": [serialize(r) for r in rows], \"total\": len(rows)})\n\n\n@app.get(\"/api/reservations/<int:res_id>\")\ndef get_reservation(res_id: int):\n    user = current_user()\n    return jsonify(serialize(own_reservation(db(), user[\"id\"], res_id)))\n\n\n@app.put(\"/api/reservations/<int:res_id>\")\ndef replace_reservation(res_id: int):\n    user = current_user()\n    fields = parse_reservation(json_body())\n    with write_tx() as conn:\n        own_reservation(conn, user[\"id\"], res_id)\n        ensure_capacity(\n            conn, fields[\"date\"], fields[\"time\"], fields[\"party_size\"], res_id\n        )\n        conn.execute(\n            \"\"\"\n            UPDATE reservations\n            SET name = ?, email = ?, date = ?, time = ?, party_size = ?, notes = ?\n            WHERE id = ?\n            \"\"\",\n            (\n                fields[\"name\"],\n                fields[\"email\"],\n                fields[\"date\"],\n                fields[\"time\"],\n                fields[\"party_size\"],\n                fields[\"notes\"],\n                res_id,\n            ),\n        )\n        row = conn.execute(\n            f\"SELECT {COLUMNS} FROM reservations WHERE id = ?\", (res_id,)\n        ).fetchone()\n    return jsonify(serialize(row))\n\n\n@app.delete(\"/api/reservations/<int:res_id>\")\ndef cancel_reservation(res_id: int):\n    user = current_user()\n    with write_tx() as conn:\n        own_reservation(conn, user[\"id\"], res_id)\n        conn.execute(\"DELETE FROM reservations WHERE id = ?\", (res_id,))\n    return \"\", 204\n\n\n@app.get(\"/api/availability\")\ndef availability():\n    if \"date\" not in request.args:\n        raise ApiError(400, \"date is required\")\n    day = parse_date(request.args[\"date\"])\n    rows = db().execute(\n        \"\"\"\n        SELECT time, SUM(party_size) AS booked FROM reservations\n        WHERE date = ? GROUP BY time ORDER BY time\n        \"\"\",\n        (day,),\n    ).fetchall()\n    items = [\n        {\n            \"time\": r[\"time\"],\n            \"booked\": r[\"booked\"],\n            \"remaining\": max(SLOT_CAPACITY - r[\"booked\"], 0),\n        }\n        for r in rows\n    ]\n    return jsonify({\"items\": items})\n\n\ndef int_arg(name: str, default: int, maximum=None) -> int:\n    raw = request.args.get(name)\n    if raw is None:\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if value < 1:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if maximum is not None and value > maximum:\n        raise ApiError(400, f\"{name} must be at most {maximum}\")\n    return value\n\n\n@app.get(\"/api/admin/reservations\")\ndef admin_reservations():\n    require_admin()\n    where = \"1 = 1\"\n    params: list = []\n    if \"date\" in request.args:\n        where += \" AND date = ?\"\n        params.append(parse_date(request.args[\"date\"]))\n    page = int_arg(\"page\", 1)\n    page_size = int_arg(\"page_size\", DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        f\"SELECT COUNT(*) AS n FROM reservations WHERE {where}\", params\n    ).fetchone()[\"n\"]\n    rows = conn.execute(\n        f\"\"\"\n        SELECT {COLUMNS} FROM reservations WHERE {where}\n        ORDER BY date, time, id LIMIT ? OFFSET ?\n        \"\"\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    raise ApiError(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = safe_join(str(DIST), path)\n    if target is not None and Path(target).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF","time":{"start":1794255299358,"end":1794255299393}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f322df001UfohGdCeWQ1Szk","sessionID":"ses_e3e0de511ffe6dmfRODJ9zj5yX","messageID":"msg_1c1f239d4001Mi0l65BqMa78AY"}}
