"c\"},headers=h(at)).status_code)\nprint(c.get(\"/api/posts?q=h2&author=bob\").json)\nprint(c.post(f\"/api/admin/posts/{pid}/toggle\",headers=h(bt)).status_code)\nprint(c.post(f\"/api/admin/posts/{pid}/toggle\",headers=h(at)).json)\nprint(c.get(f\"/api/posts/{pid}\").status_code, c.get(f\"/api/posts/{pid}\",headers=h(at)).status_code, c.get(\"/api/posts\").json)\nprint(c.delete(f\"/api/posts/{pid}\",headers=h(bt)).status_code)\nprint(c.get(\"/api/nope\").status_code, c.get(\"/api/health\").json)\nEOF\n/tmp/venv/bin/python t.py","time":{"start":1794255027374,"end":1794255027994}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1eefca7001hn8OE54bkJGusG","sessionID":"ses_e3e15377dffelxyWGsivpUJQSG","messageID":"msg_1c1eed8f9001WhyPrAxtbcUMUR"}}
