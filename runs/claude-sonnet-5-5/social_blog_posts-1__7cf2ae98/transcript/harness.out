{"type":"tool_use","timestamp":1794255095127,"sessionID":"ses_e3e15377dffelxyWGsivpUJQSG","part":{"type":"tool","tool":"bash","callID":"toolu_018zjcdtpmms3s64eZLLnpFh","state":{"status":"completed","input":{"command":"cd /workspace && rm -rf .tmp_t && cd frontend && npm i --save-exact react-router-dom@7.18.5 2>&1 | tail -2\ncat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's#\"build\": \"vite build\"#\"build\": \"tsc \\&\\& vite build\"#' package.json\nsed -i 's#<title>App</title>#<title>Blog</title>#' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Post = {\n  id: number;\n  title: string;\n  content: string;\n  tags: string[];\n  created_at: string;\n  updated_at: string;\n  author: string;\n  excerpt: string;\n  taken_down?: boolean;\n};\n\nexport type PostList = {\n  items: Post[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type PostInput = { title: string; content: string; tags: string[] };\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"blog_token\";\n\nexport const getToken = () => localStorage.getItem(TOKEN_KEY);\nexport const setToken = (t: string | null) => {\n  if (t) localStorage.setItem(TOKEN_KEY, t);\n  else localStorage.removeItem(TOKEN_KEY);\n};\n\nexport async function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    throw new ApiError(res.status, data?.error || `Request failed (${res.status})`, data?.errors || {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"POST\", \"/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"POST\", \"/auth/login\", { username, password }),\n  me: () => request<{ username: string; is_admin: boolean }>(\"GET\", \"/auth/me\"),\n  listPosts: (params: Record<string, string | number | undefined>) => {\n    const qs = new URLSearchParams();\n    for (const [k, v] of Object.entries(params)) {\n      if (v !== undefined && v !== \"\") qs.set(k, String(v));\n    }\n    return request<PostList>(\"GET\", `/posts?${qs}`);\n  },\n  getPost: (id: string | number) => request<Post>(\"GET\", `/posts/${id}`),\n  createPost: (p: PostInput) => request<Post>(\"POST\", \"/posts\", p),\n  updatePost: (id: number, p: PostInput) => request<Post>(\"PUT\", `/posts/${id}`, p),\n  deletePost: (id: number) => request<void>(\"DELETE\", `/posts/${id}`),\n  toggle: (id: number) => request<Post>(\"POST\", `/admin/posts/${id}/toggle`),\n};\nEOF\ncat > src/auth.tsx <<'EOF'\nimport { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from \"react\";\nimport { api, getToken, setToken } from \"./api\";\n\ntype User = { username: string; is_admin: boolean };\ntype AuthState = {\n  user: User | null;\n  ready: boolean;\n  signIn: (username: string, password: string) => Promise<void>;\n  signOut: () => void;\n};\n\nconst Ctx = createContext<AuthState>(null as unknown as AuthState);\nexport const useAuth = () => useContext(Ctx);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [user, setUser] = useState<User | null>(null);\n  const [ready, setReady] = useState(!getToken());\n\n  useEffect(() => {\n    if (!getToken()) return;\n    api\n      .me()\n      .then(setUser)\n      .catch(() => setToken(null))\n      .finally(() => setReady(true));\n  }, []);\n\n  const signIn = useCallback(async (username: string, password: string) => {\n    const { token } = await api.login(username, password);\n    setToken(token);\n    setUser(await api.me());\n  }, []);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setUser(null);\n  }, []);\n\n  return <Ctx.Provider value={{ user, ready, signIn, signOut }}>{children}</Ctx.Provider>;\n}\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ButtonHTMLAttributes, InputHTMLAttributes, ReactNode } from \"react\";\nimport { Link } from \"react-router-dom\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\n\nexport function Button({\n  variant = \"primary\",\n  className = \"\",\n  ...rest\n}: ButtonHTMLAttributes<HTMLButtonElement> & { variant?: \"primary\" | \"secondary\" | \"danger\" }) {\n  const styles = {\n    primary: \"bg-indigo-600 text-white hover:bg-indigo-700\",\n    secondary: \"border border-slate-300 bg-white text-slate-700 hover:bg-slate-50\",\n    danger: \"bg-red-600 text-white hover:bg-red-700\",\n  }[variant];\n  return (\n    <button\n      {...rest}\n      className={`rounded px-3 py-2 text-sm font-medium disabled:opacity-50 ${styles} ${className}`}\n    />\n  );\n}\n\nexport function Field({\n  label,\n  error,\n  ...rest\n}: InputHTMLAttributes<HTMLInputElement> & { label: string; error?: string }) {\n  return (\n    <label className=\"block\">\n      <span className=\"mb-1 block text-sm font-medium text-slate-700\">{label}</span>\n      <input {...rest} className={inputCls} />\n      {error && <span className=\"mt-1 block text-sm text-red-600\">{error}</span>}\n    </label>\n  );\n}\n\nexport function ErrorBox({ children }: { children: ReactNode }) {\n  return (\n    <div role=\"alert\" className=\"rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {children}\n    </div>\n  );\n}\n\nexport function TagList({ tags }: { tags: string[] }) {\n  if (!tags.length) return null;\n  return (\n    <ul className=\"flex flex-wrap gap-1\">\n      {tags.map((t) => (\n        <li key={t}>\n          <Link\n            to={`/?tag=${encodeURIComponent(t)}`}\n            className=\"rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700 hover:bg-indigo-100\"\n          >\n            #{t}\n          </Link>\n        </li>\n      ))}\n    </ul>\n  );\n}\n\nexport const fmtDate = (iso: string) => new Date(iso).toLocaleDateString(undefined, { dateStyle: \"medium\" });\nEOF\ncat > src/App.tsx <<'EOF'\nimport { Link, Route, Routes, useNavigate } from \"react-router-dom\";\nimport { useAuth } from \"./auth\";\nimport { Button } from \"./ui\";\nimport AuthPage from \"./pages/AuthPage\";\nimport Editor from \"./pages/Editor\";\nimport PostPage from \"./pages/PostPage\";\nimport PostsPage from \"./pages/PostsPage\";\n\nexport default function App() {\n  const { user, ready, signOut } = useAuth();\n  const navigate = useNavigate();\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <nav className=\"mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3\">\n          <Link to=\"/\" className=\"text-lg font-bold text-indigo-700\">\n            Blog\n          </Link>\n          <div className=\"flex items-center gap-3 text-sm\">\n            {user ? (\n              <>\n                <Link to=\"/posts/new\" className=\"text-indigo-700 hover:underline\">\n                  New post\n                </Link>\n                <span data-testid=\"current-user\" className=\"font-medium\">\n                  {user.username}\n                </span>\n                <Button\n                  variant=\"secondary\"\n                  onClick={() => {\n                    signOut();\n                    navigate(\"/\");\n                  }}\n                >\n                  Sign out\n                </Button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n                  Sign in\n                </Link>\n                <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n                  Register\n                </Link>\n              </>\n            )}\n          </div>\n        </nav>\n      </header>\n      <main className=\"mx-auto max-w-3xl px-4 py-6\">\n        {!ready ? (\n          <p className=\"text-slate-500\">Loading…</p>\n        ) : (\n          <Routes>\n            <Route path=\"/\" element={<PostsPage />} />\n            <Route path=\"/login\" element={<AuthPage mode=\"login\" />} />\n            <Route path=\"/register\" element={<AuthPage mode=\"register\" />} />\n            <Route path=\"/posts/new\" element={<Editor />} />\n            <Route path=\"/posts/:id\" element={<PostPage />} />\n            <Route path=\"/posts/:id/edit\" element={<Editor />} />\n            <Route path=\"*\" element={<p>Page not found.</p>} />\n          </Routes>\n        )}\n      </main>\n    </div>\n  );\n}\nEOF\nmkdir -p src/pages\ncat > src/pages/AuthPage.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { ApiError, api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, Field } from \"../ui\";\n\nexport default function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const { signIn } = useAuth();\n  const navigate = useNavigate();\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n  const isLogin = mode === \"login\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    try {\n      if (!isLogin) await api.register(username, password);\n      await signIn(username, password);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else setError(\"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-sm space-y-4 rounded bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-bold\">{isLogin ? \"Sign in\" : \"Create account\"}</h1>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      <Field\n        label=\"Username\"\n        name=\"username\"\n        autoComplete=\"username\"\n        value={username}\n        onChange={(e) => setUsername(e.target.value)}\n        error={fields.username}\n        required\n      />\n      <Field\n        label=\"Password\"\n        name=\"password\"\n        type=\"password\"\n        autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n        value={password}\n        onChange={(e) => setPassword(e.target.value)}\n        error={fields.password}\n        required\n      />\n      <Button type=\"submit\" disabled={busy} className=\"w-full\">\n        {isLogin ? \"Sign in\" : \"Register\"}\n      </Button>\n      <p className=\"text-sm text-slate-600\">\n        {isLogin ? (\n          <>\n            No account?{\" \"}\n            <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n              Register\n            </Link>\n          </>\n        ) : (\n          <>\n            Already registered?{\" \"}\n            <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n              Sign in\n            </Link>\n          </>\n        )}\n      </p>\n    </form>\n  );\n}\nEOF\ncat > src/pages/PostsPage.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { ApiError, api, type PostList } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, TagList, fmtDate, inputCls } from \"../ui\";\n\nexport default function PostsPage() {\n  const { user } = useAuth();\n  const [params, setParams] = useSearchParams();\n  const q = params.get(\"q\") || \"\";\n  const tag = params.get(\"tag\") || \"\";\n  const author = params.get(\"author\") || \"\";\n  const down = params.get(\"taken_down\") === \"1\" && !!user?.is_admin;\n  const page = Math.max(1, parseInt(params.get(\"page\") || \"1\", 10) || 1);\n\n  const [data, setData] = useState<PostList | null>(null);\n  const [error, setError] = useState(\"\");\n  const [form, setForm] = useState({ q, tag, author });\n  const [reload, setReload] = useState(0);\n\n  useEffect(() => setForm({ q, tag, author }), [q, tag, author]);\n\n  useEffect(() => {\n    let live = true;\n    setError(\"\");\n    api\n      .listPosts({ q, tag, author, page, taken_down: down ? 1 : undefined })\n      .then((d) => live && setData(d))\n      .catch((e) => live && setError(e instanceof ApiError ? e.message : \"Failed to load posts\"));\n    return () => {\n      live = false;\n    };\n  }, [q, tag, author, page, down, reload, user?.username]);\n\n  function update(next: Record<string, string>) {\n    const p = new URLSearchParams(params);\n    for (const [k, v] of Object.entries(next)) {\n      if (v) p.set(k, v);\n      else p.delete(k);\n    }\n    setParams(p);\n  }\n\n  function search(e: FormEvent) {\n    e.preventDefault();\n    update({ q: form.q.trim(), tag: form.tag.trim(), author: form.author.trim(), page: \"\" });\n  }\n\n  async function toggle(id: number) {\n    try {\n      await api.toggle(id);\n      setReload((n) => n + 1);\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Action failed\");\n    }\n  }\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-4\">\n      <form onSubmit={search} className=\"grid gap-2 sm:grid-cols-[2fr_1fr_1fr_auto]\">\n        <input\n          className={inputCls}\n          type=\"search\"\n          placeholder=\"Search posts\"\n          aria-label=\"Search\"\n          value={form.q}\n          onChange={(e) => setForm({ ...form, q: e.target.value })}\n        />\n        <input\n          className={inputCls}\n          placeholder=\"Tag\"\n          aria-label=\"Tag filter\"\n          value={form.tag}\n          onChange={(e) => setForm({ ...form, tag: e.target.value })}\n        />\n        <input\n          className={inputCls}\n          placeholder=\"Author\"\n          aria-label=\"Author filter\"\n          value={form.author}\n          onChange={(e) => setForm({ ...form, author: e.target.value })}\n        />\n        <Button type=\"submit\">Search</Button>\n      </form>\n\n      {user?.is_admin && (\n        <label className=\"flex items-center gap-2 text-sm text-slate-600\">\n          <input\n            type=\"checkbox\"\n            checked={down}\n            onChange={(e) => update({ taken_down: e.target.checked ? \"1\" : \"\", page: \"\" })}\n          />\n          Show taken-down posts\n        </label>\n      )}\n\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {!data && !error && <p className=\"text-slate-500\">Loading…</p>}\n      {data && data.items.length === 0 && <p className=\"text-slate-500\">No posts found.</p>}\n\n      <ul className=\"space-y-3\">\n        {data?.items.map((p) => (\n          <li key={p.id} className=\"rounded bg-white p-4 shadow-sm\">\n            <h2 className=\"text-lg font-semibold\">\n              <Link to={`/posts/${p.id}`} className=\"hover:text-indigo-700\">\n                {p.title}\n              </Link>\n            </h2>\n            <p className=\"mb-2 text-xs text-slate-500\">\n              <button\n                type=\"button\"\n                className=\"font-medium hover:underline\"\n                onClick={() => update({ author: p.author, page: \"\" })}\n              >\n                {p.author}\n              </button>{\" \"}\n              · <time dateTime={p.created_at}>{fmtDate(p.created_at)}</time>\n            </p>\n            <p className=\"mb-2 break-words text-sm text-slate-700\">{p.excerpt}</p>\n            <div className=\"flex items-center justify-between gap-2\">\n              <TagList tags={p.tags} />\n              {user?.is_admin && (\n                <Button variant=\"danger\" className=\"ml-auto\" onClick={() => toggle(p.id)}>\n                  {p.taken_down ? \"Restore\" : \"Take down\"}\n                </Button>\n              )}\n            </div>\n          </li>\n        ))}\n      </ul>\n\n      {data && pages > 1 && (\n        <div className=\"flex items-center justify-between\">\n          <Button variant=\"secondary\" disabled={page <= 1} onClick={() => update({ page: String(page - 1) })}>\n            Previous\n          </Button>\n          <span className=\"text-sm text-slate-600\">\n            Page {data.page} of {pages}\n          </span>\n          <Button variant=\"secondary\" disabled={page >= pages} onClick={() => update({ page: String(page + 1) })}>\n            Next\n          </Button>\n        </div>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/pages/PostPage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ApiError, api, type Post } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, TagList, fmtDate } from \"../ui\";\n\nexport default function PostPage() {\n  const { id } = useParams();\n  const { user } = useAuth();\n  const navigate = useNavigate();\n  const [post, setPost] = useState<Post | null>(null);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n\n  useEffect(() => {\n    let live = true;\n    setPost(null);\n    setError(\"\");\n    api\n      .getPost(id!)\n      .then((p) => live && setPost(p))\n      .catch((e) => live && setError(e instanceof ApiError ? e.message : \"Failed to load post\"));\n    return () => {\n      live = false;\n    };\n  }, [id, user?.username]);\n\n  async function remove() {\n    try {\n      await api.deletePost(post!.id);\n      navigate(\"/\");\n    } catch (e) {\n      setConfirming(false);\n      setError(e instanceof ApiError ? e.message : \"Delete failed\");\n    }\n  }\n\n  async function toggle() {\n    try {\n      setPost(await api.toggle(post!.id));\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Action failed\");\n    }\n  }\n\n  if (error && !post) return <ErrorBox>{error}</ErrorBox>;\n  if (!post) return <p className=\"text-slate-500\">Loading…</p>;\n\n  const paragraphs = post.content.split(/\\n\\s*\\n/).filter((p) => p.trim());\n  const own = user?.username === post.author && !user?.is_admin;\n\n  return (\n    <article className=\"space-y-4 rounded bg-white p-6 shadow-sm\">\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {post.taken_down && <ErrorBox>This post is taken down and hidden from everyone else.</ErrorBox>}\n      <header className=\"space-y-1\">\n        <h1 className=\"break-words text-2xl font-bold\">{post.title}</h1>\n        <p className=\"text-sm text-slate-500\">\n          <Link to={`/?author=${encodeURIComponent(post.author)}`} className=\"font-medium hover:underline\">\n            {post.author}\n          </Link>{\" \"}\n          · <time dateTime={post.created_at}>{fmtDate(post.created_at)}</time>\n          {post.updated_at !== post.created_at && <> · updated {fmtDate(post.updated_at)}</>}\n        </p>\n        <TagList tags={post.tags} />\n      </header>\n      <div className=\"space-y-3\">\n        {paragraphs.map((p, i) => (\n          <p key={i} className=\"whitespace-pre-line break-words\">\n            {p}\n          </p>\n        ))}\n      </div>\n      <div className=\"flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4\">\n        {own && (\n          <>\n            <Link\n              to={`/posts/${post.id}/edit`}\n              className=\"rounded border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50\"\n            >\n              Edit\n            </Link>\n            {confirming ? (\n              <>\n                <span className=\"text-sm\">Delete this post?</span>\n                <Button variant=\"danger\" onClick={remove}>\n                  Confirm delete\n                </Button>\n                <Button variant=\"secondary\" onClick={() => setConfirming(false)}>\n                  Cancel\n                </Button>\n              </>\n            ) : (\n              <Button variant=\"danger\" onClick={() => setConfirming(true)}>\n                Delete\n              </Button>\n            )}\n          </>\n        )}\n        {user?.is_admin && (\n          <Button variant=\"danger\" onClick={toggle}>\n            {post.taken_down ? \"Restore\" : \"Take down\"}\n          </Button>\n        )}\n      </div>\n    </article>\n  );\n}\nEOF\ncat > src/pages/Editor.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent, type KeyboardEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ApiError, api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, inputCls } from \"../ui\";\n\nexport default function Editor() {\n  const { id } = useParams();\n  const { user } = useAuth();\n  const navigate = useNavigate();\n  const [title, setTitle] = useState(\"\");\n  const [content, setContent] = useState(\"\");\n  const [tags, setTags] = useState<string[]>([]);\n  const [tagInput, setTagInput] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [loading, setLoading] = useState(!!id);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (!id || !user) return;\n    api\n      .getPost(id)\n      .then((p) => {\n        if (p.author !== user.username) setError(\"You can only edit your own posts\");\n        else {\n          setTitle(p.title);\n          setContent(p.content);\n          setTags(p.tags);\n        }\n      })\n      .catch((e) => setError(e instanceof ApiError ? e.message : \"Failed to load post\"))\n      .finally(() => setLoading(false));\n  }, [id, user]);\n\n  if (!user)\n    return (\n      <p>\n        Please <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">sign in</Link> to write posts.\n      </p>\n    );\n\n  function addTags(raw: string) {\n    const parts = raw.split(\",\").map((t) => t.trim()).filter(Boolean);\n    if (!parts.length) return;\n    const next = [...tags];\n    for (const t of parts) if (!next.some((x) => x.toLowerCase() === t.toLowerCase())) next.push(t);\n    setTags(next);\n    setTagInput(\"\");\n  }\n\n  function onTagKey(e: KeyboardEvent<HTMLInputElement>) {\n    if (e.key === \"Enter\" || e.key === \",\") {\n      e.preventDefault();\n      addTags(tagInput);\n    } else if (e.key === \"Backspace\" && !tagInput && tags.length) {\n      setTags(tags.slice(0, -1));\n    }\n  }\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    const finalTags = [...tags];\n    for (const t of tagInput.split(\",\").map((s) => s.trim()).filter(Boolean))\n      if (!finalTags.some((x) => x.toLowerCase() === t.toLowerCase())) finalTags.push(t);\n    try {\n      const body = { title, content, tags: finalTags };\n      const post = id ? await api.updatePost(Number(id), body) : await api.createPost(body);\n      navigate(`/posts/${post.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else setError(\"Something went wrong\");\n      setBusy(false);\n    }\n  }\n\n  if (loading) return <p className=\"text-slate-500\">Loading…</p>;\n\n  const fieldErr = (k: string) =>\n    fields[k] ? <span className=\"mt-1 block text-sm text-red-600\">{fields[k]}</span> : null;\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4 rounded bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-bold\">{id ? \"Edit post\" : \"New post\"}</h1>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      <label className=\"block\">\n        <span className=\"mb-1 block text-sm font-medium text-slate-700\">Title</span>\n        <input className={inputCls} name=\"title\" value={title} onChange={(e) => setTitle(e.target.value)} />\n        {fieldErr(\"title\")}\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-sm font-medium text-slate-700\">Content</span>\n        <textarea\n          className={inputCls}\n          name=\"content\"\n          rows={12}\n          value={content}\n          onChange={(e) => setContent(e.target.value)}\n        />\n        {fieldErr(\"content\")}\n      </label>\n      <div>\n        <label htmlFor=\"tag-input\" className=\"mb-1 block text-sm font-medium text-slate-700\">\n          Tags\n        </label>\n        <div className=\"flex flex-wrap gap-1 rounded border border-slate-300 p-2\">\n          {tags.map((t) => (\n            <span key={t} className=\"flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700\">\n              {t}\n              <button\n                type=\"button\"\n                aria-label={`Remove tag ${t}`}\n                onClick={() => setTags(tags.filter((x) => x !== t))}\n              >\n                ×\n              </button>\n            </span>\n          ))}\n          <input\n            id=\"tag-input\"\n            className=\"min-w-32 flex-1 text-sm outline-none\"\n            placeholder=\"Add a tag, press Enter\"\n            value={tagInput}\n            onChange={(e) => setTagInput(e.target.value)}\n            onKeyDown={onTagKey}\n            onBlur={() => addTags(tagInput)}\n          />\n        </div>\n        {fieldErr(\"tags\")}\n      </div>\n      <div className=\"flex gap-2\">\n        <Button type=\"submit\" disabled={busy}>\n          {id ? \"Save changes\" : \"Publish\"}\n        </Button>\n        <Button type=\"button\" variant=\"secondary\" onClick={() => navigate(-1)}>\n          Cancel\n        </Button>\n      </div>\n    </form>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -15"},"output":"\nfound 0 vulnerabilities\n\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 30 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.38 kB │ gzip:  0.26 kB\ndist/assets/index-DgETCqBd.css   13.55 kB │ gzip:  3.45 kB\ndist/assets/index-5JoAh0mK.js   273.22 kB │ gzip: 86.18 kB\n\n✓ built in 482ms\n","metadata":{"output":"\nfound 0 vulnerabilities\n\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 30 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.38 kB │ gzip:  0.26 kB\ndist/assets/index-DgETCqBd.css   13.55 kB │ gzip:  3.45 kB\ndist/assets/index-5JoAh0mK.js   273.22 kB │ gzip: 86.18 kB\n\n✓ built in 482ms\n","exit":0,"truncated":false},"title":"cd /workspace && rm -rf .tmp_t && cd frontend && npm i --save-exact react-router-dom@7.18.5 2>&1 | tail -2\ncat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's#\"build\": \"vite build\"#\"build\": \"tsc \\&\\& vite build\"#' package.json\nsed -i 's#<title>App</title>#<title>Blog</title>#' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Post = {\n  id: number;\n  title: string;\n  content: string;\n  tags: string[];\n  created_at: string;\n  updated_at: string;\n  author: string;\n  excerpt: string;\n  taken_down?: boolean;\n};\n\nexport type PostList = {\n  items: Post[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type PostInput = { title: string; content: string; tags: string[] };\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"blog_token\";\n\nexport const getToken = () => localStorage.getItem(TOKEN_KEY);\nexport const setToken = (t: string | null) => {\n  if (t) localStorage.setItem(TOKEN_KEY, t);\n  else localStorage.removeItem(TOKEN_KEY);\n};\n\nexport async function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    throw new ApiError(res.status, data?.error || `Request failed (${res.status})`, data?.errors || {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"POST\", \"/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"POST\", \"/auth/login\", { username, password }),\n  me: () => request<{ username: string; is_admin: boolean }>(\"GET\", \"/auth/me\"),\n  listPosts: (params: Record<string, string | number | undefined>) => {\n    const qs = new URLSearchParams();\n    for (const [k, v] of Object.entries(params)) {\n      if (v !== undefined && v !== \"\") qs.set(k, String(v));\n    }\n    return request<PostList>(\"GET\", `/posts?${qs}`);\n  },\n  getPost: (id: string | number) => request<Post>(\"GET\", `/posts/${id}`),\n  createPost: (p: PostInput) => request<Post>(\"POST\", \"/posts\", p),\n  updatePost: (id: number, p: PostInput) => request<Post>(\"PUT\", `/posts/${id}`, p),\n  deletePost: (id: number) => request<void>(\"DELETE\", `/posts/${id}`),\n  toggle: (id: number) => request<Post>(\"POST\", `/admin/posts/${id}/toggle`),\n};\nEOF\ncat > src/auth.tsx <<'EOF'\nimport { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from \"react\";\nimport { api, getToken, setToken } from \"./api\";\n\ntype User = { username: string; is_admin: boolean };\ntype AuthState = {\n  user: User | null;\n  ready: boolean;\n  signIn: (username: string, password: string) => Promise<void>;\n  signOut: () => void;\n};\n\nconst Ctx = createContext<AuthState>(null as unknown as AuthState);\nexport const useAuth = () => useContext(Ctx);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [user, setUser] = useState<User | null>(null);\n  const [ready, setReady] = useState(!getToken());\n\n  useEffect(() => {\n    if (!getToken()) return;\n    api\n      .me()\n      .then(setUser)\n      .catch(() => setToken(null))\n      .finally(() => setReady(true));\n  }, []);\n\n  const signIn = useCallback(async (username: string, password: string) => {\n    const { token } = await api.login(username, password);\n    setToken(token);\n    setUser(await api.me());\n  }, []);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setUser(null);\n  }, []);\n\n  return <Ctx.Provider value={{ user, ready, signIn, signOut }}>{children}</Ctx.Provider>;\n}\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ButtonHTMLAttributes, InputHTMLAttributes, ReactNode } from \"react\";\nimport { Link } from \"react-router-dom\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\n\nexport function Button({\n  variant = \"primary\",\n  className = \"\",\n  ...rest\n}: ButtonHTMLAttributes<HTMLButtonElement> & { variant?: \"primary\" | \"secondary\" | \"danger\" }) {\n  const styles = {\n    primary: \"bg-indigo-600 text-white hover:bg-indigo-700\",\n    secondary: \"border border-slate-300 bg-white text-slate-700 hover:bg-slate-50\",\n    danger: \"bg-red-600 text-white hover:bg-red-700\",\n  }[variant];\n  return (\n    <button\n      {...rest}\n      className={`rounded px-3 py-2 text-sm font-medium disabled:opacity-50 ${styles} ${className}`}\n    />\n  );\n}\n\nexport function Field({\n  label,\n  error,\n  ...rest\n}: InputHTMLAttributes<HTMLInputElement> & { label: string; error?: string }) {\n  return (\n    <label className=\"block\">\n      <span className=\"mb-1 block text-sm font-medium text-slate-700\">{label}</span>\n      <input {...rest} className={inputCls} />\n      {error && <span className=\"mt-1 block text-sm text-red-600\">{error}</span>}\n    </label>\n  );\n}\n\nexport function ErrorBox({ children }: { children: ReactNode }) {\n  return (\n    <div role=\"alert\" className=\"rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {children}\n    </div>\n  );\n}\n\nexport function TagList({ tags }: { tags: string[] }) {\n  if (!tags.length) return null;\n  return (\n    <ul className=\"flex flex-wrap gap-1\">\n      {tags.map((t) => (\n        <li key={t}>\n          <Link\n            to={`/?tag=${encodeURIComponent(t)}`}\n            className=\"rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700 hover:bg-indigo-100\"\n          >\n            #{t}\n          </Link>\n        </li>\n      ))}\n    </ul>\n  );\n}\n\nexport const fmtDate = (iso: string) => new Date(iso).toLocaleDateString(undefined, { dateStyle: \"medium\" });\nEOF\ncat > src/App.tsx <<'EOF'\nimport { Link, Route, Routes, useNavigate } from \"react-router-dom\";\nimport { useAuth } from \"./auth\";\nimport { Button } from \"./ui\";\nimport AuthPage from \"./pages/AuthPage\";\nimport Editor from \"./pages/Editor\";\nimport PostPage from \"./pages/PostPage\";\nimport PostsPage from \"./pages/PostsPage\";\n\nexport default function App() {\n  const { user, ready, signOut } = useAuth();\n  const navigate = useNavigate();\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <nav className=\"mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3\">\n          <Link to=\"/\" className=\"text-lg font-bold text-indigo-700\">\n            Blog\n          </Link>\n          <div className=\"flex items-center gap-3 text-sm\">\n            {user ? (\n              <>\n                <Link to=\"/posts/new\" className=\"text-indigo-700 hover:underline\">\n                  New post\n                </Link>\n                <span data-testid=\"current-user\" className=\"font-medium\">\n                  {user.username}\n                </span>\n                <Button\n                  variant=\"secondary\"\n                  onClick={() => {\n                    signOut();\n                    navigate(\"/\");\n                  }}\n                >\n                  Sign out\n                </Button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n                  Sign in\n                </Link>\n                <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n                  Register\n                </Link>\n              </>\n            )}\n          </div>\n        </nav>\n      </header>\n      <main className=\"mx-auto max-w-3xl px-4 py-6\">\n        {!ready ? (\n          <p className=\"text-slate-500\">Loading…</p>\n        ) : (\n          <Routes>\n            <Route path=\"/\" element={<PostsPage />} />\n            <Route path=\"/login\" element={<AuthPage mode=\"login\" />} />\n            <Route path=\"/register\" element={<AuthPage mode=\"register\" />} />\n            <Route path=\"/posts/new\" element={<Editor />} />\n            <Route path=\"/posts/:id\" element={<PostPage />} />\n            <Route path=\"/posts/:id/edit\" element={<Editor />} />\n            <Route path=\"*\" element={<p>Page not found.</p>} />\n          </Routes>\n        )}\n      </main>\n    </div>\n  );\n}\nEOF\nmkdir -p src/pages\ncat > src/pages/AuthPage.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { ApiError, api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, Field } from \"../ui\";\n\nexport default function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const { signIn } = useAuth();\n  const navigate = useNavigate();\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n  const isLogin = mode === \"login\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    try {\n      if (!isLogin) await api.register(username, password);\n      await signIn(username, password);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else setError(\"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-sm space-y-4 rounded bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-bold\">{isLogin ? \"Sign in\" : \"Create account\"}</h1>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      <Field\n        label=\"Username\"\n        name=\"username\"\n        autoComplete=\"username\"\n        value={username}\n        onChange={(e) => setUsername(e.target.value)}\n        error={fields.username}\n        required\n      />\n      <Field\n        label=\"Password\"\n        name=\"password\"\n        type=\"password\"\n        autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n        value={password}\n        onChange={(e) => setPassword(e.target.value)}\n        error={fields.password}\n        required\n      />\n      <Button type=\"submit\" disabled={busy} className=\"w-full\">\n        {isLogin ? \"Sign in\" : \"Register\"}\n      </Button>\n      <p className=\"text-sm text-slate-600\">\n        {isLogin ? (\n          <>\n            No account?{\" \"}\n            <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n              Register\n            </Link>\n          </>\n        ) : (\n          <>\n            Already registered?{\" \"}\n            <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n              Sign in\n            </Link>\n          </>\n        )}\n      </p>\n    </form>\n  );\n}\nEOF\ncat > src/pages/PostsPage.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { ApiError, api, type PostList } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, TagList, fmtDate, inputCls } from \"../ui\";\n\nexport default function PostsPage() {\n  const { user } = useAuth();\n  const [params, setParams] = useSearchParams();\n  const q = params.get(\"q\") || \"\";\n  const tag = params.get(\"tag\") || \"\";\n  const author = params.get(\"author\") || \"\";\n  const down = params.get(\"taken_down\") === \"1\" && !!user?.is_admin;\n  const page = Math.max(1, parseInt(params.get(\"page\") || \"1\", 10) || 1);\n\n  const [data, setData] = useState<PostList | null>(null);\n  const [error, setError] = useState(\"\");\n  const [form, setForm] = useState({ q, tag, author });\n  const [reload, setReload] = useState(0);\n\n  useEffect(() => setForm({ q, tag, author }), [q, tag, author]);\n\n  useEffect(() => {\n    let live = true;\n    setError(\"\");\n    api\n      .listPosts({ q, tag, author, page, taken_down: down ? 1 : undefined })\n      .then((d) => live && setData(d))\n      .catch((e) => live && setError(e instanceof ApiError ? e.message : \"Failed to load posts\"));\n    return () => {\n      live = false;\n    };\n  }, [q, tag, author, page, down, reload, user?.username]);\n\n  function update(next: Record<string, string>) {\n    const p = new URLSearchParams(params);\n    for (const [k, v] of Object.entries(next)) {\n      if (v) p.set(k, v);\n      else p.delete(k);\n    }\n    setParams(p);\n  }\n\n  function search(e: FormEvent) {\n    e.preventDefault();\n    update({ q: form.q.trim(), tag: form.tag.trim(), author: form.author.trim(), page: \"\" });\n  }\n\n  async function toggle(id: number) {\n    try {\n      await api.toggle(id);\n      setReload((n) => n + 1);\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Action failed\");\n    }\n  }\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-4\">\n      <form onSubmit={search} className=\"grid gap-2 sm:grid-cols-[2fr_1fr_1fr_auto]\">\n        <input\n          className={inputCls}\n          type=\"search\"\n          placeholder=\"Search posts\"\n          aria-label=\"Search\"\n          value={form.q}\n          onChange={(e) => setForm({ ...form, q: e.target.value })}\n        />\n        <input\n          className={inputCls}\n          placeholder=\"Tag\"\n          aria-label=\"Tag filter\"\n          value={form.tag}\n          onChange={(e) => setForm({ ...form, tag: e.target.value })}\n        />\n        <input\n          className={inputCls}\n          placeholder=\"Author\"\n          aria-label=\"Author filter\"\n          value={form.author}\n          onChange={(e) => setForm({ ...form, author: e.target.value })}\n        />\n        <Button type=\"submit\">Search</Button>\n      </form>\n\n      {user?.is_admin && (\n        <label className=\"flex items-center gap-2 text-sm text-slate-600\">\n          <input\n            type=\"checkbox\"\n            checked={down}\n            onChange={(e) => update({ taken_down: e.target.checked ? \"1\" : \"\", page: \"\" })}\n          />\n          Show taken-down posts\n        </label>\n      )}\n\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {!data && !error && <p className=\"text-slate-500\">Loading…</p>}\n      {data && data.items.length === 0 && <p className=\"text-slate-500\">No posts found.</p>}\n\n      <ul className=\"space-y-3\">\n        {data?.items.map((p) => (\n          <li key={p.id} className=\"rounded bg-white p-4 shadow-sm\">\n            <h2 className=\"text-lg font-semibold\">\n              <Link to={`/posts/${p.id}`} className=\"hover:text-indigo-700\">\n                {p.title}\n              </Link>\n            </h2>\n            <p className=\"mb-2 text-xs text-slate-500\">\n              <button\n                type=\"button\"\n                className=\"font-medium hover:underline\"\n                onClick={() => update({ author: p.author, page: \"\" })}\n              >\n                {p.author}\n              </button>{\" \"}\n              · <time dateTime={p.created_at}>{fmtDate(p.created_at)}</time>\n            </p>\n            <p className=\"mb-2 break-words text-sm text-slate-700\">{p.excerpt}</p>\n            <div className=\"flex items-center justify-between gap-2\">\n              <TagList tags={p.tags} />\n              {user?.is_admin && (\n                <Button variant=\"danger\" className=\"ml-auto\" onClick={() => toggle(p.id)}>\n                  {p.taken_down ? \"Restore\" : \"Take down\"}\n                </Button>\n              )}\n            </div>\n          </li>\n        ))}\n      </ul>\n\n      {data && pages > 1 && (\n        <div className=\"flex items-center justify-between\">\n          <Button variant=\"secondary\" disabled={page <= 1} onClick={() => update({ page: String(page - 1) })}>\n            Previous\n          </Button>\n          <span className=\"text-sm text-slate-600\">\n            Page {data.page} of {pages}\n          </span>\n          <Button variant=\"secondary\" disabled={page >= pages} onClick={() => update({ page: String(page + 1) })}>\n            Next\n          </Button>\n        </div>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/pages/PostPage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ApiError, api, type Post } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, TagList, fmtDate } from \"../ui\";\n\nexport default function PostPage() {\n  const { id } = useParams();\n  const { user } = useAuth();\n  const navigate = useNavigate();\n  const [post, setPost] = useState<Post | null>(null);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n\n  useEffect(() => {\n    let live = true;\n    setPost(null);\n    setError(\"\");\n    api\n      .getPost(id!)\n      .then((p) => live && setPost(p))\n      .catch((e) => live && setError(e instanceof ApiError ? e.message : \"Failed to load post\"));\n    return () => {\n      live = false;\n    };\n  }, [id, user?.username]);\n\n  async function remove() {\n    try {\n      await api.deletePost(post!.id);\n      navigate(\"/\");\n    } catch (e) {\n      setConfirming(false);\n      setError(e instanceof ApiError ? e.message : \"Delete failed\");\n    }\n  }\n\n  async function toggle() {\n    try {\n      setPost(await api.toggle(post!.id));\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Action failed\");\n    }\n  }\n\n  if (error && !post) return <ErrorBox>{error}</ErrorBox>;\n  if (!post) return <p className=\"text-slate-500\">Loading…</p>;\n\n  const paragraphs = post.content.split(/\\n\\s*\\n/).filter((p) => p.trim());\n  const own = user?.username === post.author && !user?.is_admin;\n\n  return (\n    <article className=\"space-y-4 rounded bg-white p-6 shadow-sm\">\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {post.taken_down && <ErrorBox>This post is taken down and hidden from everyone else.</ErrorBox>}\n      <header className=\"space-y-1\">\n        <h1 className=\"break-words text-2xl font-bold\">{post.title}</h1>\n        <p className=\"text-sm text-slate-500\">\n          <Link to={`/?author=${encodeURIComponent(post.author)}`} className=\"font-medium hover:underline\">\n            {post.author}\n          </Link>{\" \"}\n          · <time dateTime={post.created_at}>{fmtDate(post.created_at)}</time>\n          {post.updated_at !== post.created_at && <> · updated {fmtDate(post.updated_at)}</>}\n        </p>\n        <TagList tags={post.tags} />\n      </header>\n      <div className=\"space-y-3\">\n        {paragraphs.map((p, i) => (\n          <p key={i} className=\"whitespace-pre-line break-words\">\n            {p}\n          </p>\n        ))}\n      </div>\n      <div className=\"flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4\">\n        {own && (\n          <>\n            <Link\n              to={`/posts/${post.id}/edit`}\n              className=\"rounded border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50\"\n            >\n              Edit\n            </Link>\n            {confirming ? (\n              <>\n                <span className=\"text-sm\">Delete this post?</span>\n                <Button variant=\"danger\" onClick={remove}>\n                  Confirm delete\n                </Button>\n                <Button variant=\"secondary\" onClick={() => setConfirming(false)}>\n                  Cancel\n                </Button>\n              </>\n            ) : (\n              <Button variant=\"danger\" onClick={() => setConfirming(true)}>\n                Delete\n              </Button>\n            )}\n          </>\n        )}\n        {user?.is_admin && (\n          <Button variant=\"danger\" onClick={toggle}>\n            {post.taken_down ? \"Restore\" : \"Take down\"}\n          </Button>\n        )}\n      </div>\n    </article>\n  );\n}\nEOF\ncat > src/pages/Editor.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent, type KeyboardEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { ApiError, api } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { Button, ErrorBox, inputCls } from \"../ui\";\n\nexport default function Editor() {\n  const { id } = useParams();\n  const { user } = useAuth();\n  const navigate = useNavigate();\n  const [title, setTitle] = useState(\"\");\n  const [content, setContent] = useState(\"\");\n  const [tags, setTags] = useState<string[]>([]);\n  const [tagInput, setTagInput] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [loading, setLoading] = useState(!!id);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (!id || !user) return;\n    api\n      .getPost(id)\n      .then((p) => {\n        if (p.author !== user.username) setError(\"You can only edit your own posts\");\n        else {\n          setTitle(p.title);\n          setContent(p.content);\n          setTags(p.tags);\n        }\n      })\n      .catch((e) => setError(e instanceof ApiError ? e.message : \"Failed to load post\"))\n      .finally(() => setLoading(false));\n  }, [id, user]);\n\n  if (!user)\n    return (\n      <p>\n        Please <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">sign in</Link> to write posts.\n      </p>\n    );\n\n  function addTags(raw: string) {\n    const parts = raw.split(\",\").map((t) => t.trim()).filter(Boolean);\n    if (!parts.length) return;\n    const next = [...tags];\n    for (const t of parts) if (!next.some((x) => x.toLowerCase() === t.toLowerCase())) next.push(t);\n    setTags(next);\n    setTagInput(\"\");\n  }\n\n  function onTagKey(e: KeyboardEvent<HTMLInputElement>) {\n    if (e.key === \"Enter\" || e.key === \",\") {\n      e.preventDefault();\n      addTags(tagInput);\n    } else if (e.key === \"Backspace\" && !tagInput && tags.length) {\n      setTags(tags.slice(0, -1));\n    }\n  }\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    const finalTags = [...tags];\n    for (const t of tagInput.split(\",\").map((s) => s.trim()).filter(Boolean))\n      if (!finalTags.some((x) => x.toLowerCase() === t.toLowerCase())) finalTags.push(t);\n    try {\n      const body = { title, content, tags: finalTags };\n      const post = id ? await api.updatePost(Number(id), body) : await api.createPost(body);\n      navigate(`/posts/${post.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else setError(\"Something went wrong\");\n      setBusy(false);\n    }\n  }\n\n  if (loading) return <p className=\"text-slate-500\">Loading…</p>;\n\n  const fieldErr = (k: string) =>\n    fields[k] ? <span className=\"mt-1 block text-sm text-red-600\">{fields[k]}</span> : null;\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4 rounded bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-bold\">{id ? \"Edit post\" : \"New post\"}</h1>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      <label className=\"block\">\n        <span className=\"mb-1 block text-sm font-medium text-slate-700\">Title</span>\n        <input className={inputCls} name=\"title\" value={title} onChange={(e) => setTitle(e.target.value)} />\n        {fieldErr(\"title\")}\n      </label>\n      <label className=\"block\">\n        <span className=\"mb-1 block text-sm font-medium text-slate-700\">Content</span>\n        <textarea\n          className={inputCls}\n          name=\"content\"\n          rows={12}\n          value={content}\n          onChange={(e) => setContent(e.target.value)}\n        />\n        {fieldErr(\"content\")}\n      </label>\n      <div>\n        <label htmlFor=\"tag-input\" className=\"mb-1 block text-sm font-medium text-slate-700\">\n          Tags\n        </label>\n        <div className=\"flex flex-wrap gap-1 rounded border border-slate-300 p-2\">\n          {tags.map((t) => (\n            <span key={t} className=\"flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700\">\n              {t}\n              <button\n                type=\"button\"\n                aria-label={`Remove tag ${t}`}\n                onClick={() => setTags(tags.filter((x) => x !== t))}\n              >\n                ×\n              </button>\n            </span>\n          ))}\n          <input\n            id=\"tag-input\"\n            className=\"min-w-32 flex-1 text-sm outline-none\"\n            placeholder=\"Add a tag, press Enter\"\n            value={tagInput}\n            onChange={(e) => setTagInput(e.target.value)}\n            onKeyDown={onTagKey}\n            onBlur={() => addTags(tagInput)}\n          />\n        </div>\n        {fieldErr(\"tags\")}\n      </div>\n      <div className=\"flex gap-2\">\n        <Button type=\"submit\" disabled={busy}>\n          {id ? \"Save changes\" : \"Publish\"}\n        </Button>\n        <Button type=\"button\" variant=\"secondary\" onClick={() => navigate(-1)}>\n          Cancel\n        </Button>\n      </div>\n    </form>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -15","time":{"start":1794255085277,"end":1794255095107}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1efded3001HhCiJv9vU2MyoJ","sessionID":"ses_e3e15377dffelxyWGsivpUJQSG","messageID":"msg_1c1eeff27001zbM3B9rnNN5gGo"}}
