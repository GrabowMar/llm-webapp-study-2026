{"type":"tool_use","timestamp":1794254974711,"sessionID":"ses_e3e15377dffelxyWGsivpUJQSG","part":{"type":"tool","tool":"bash","callID":"toolu_01FxJJXRYcxsyrj13o2dZAdT","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Multi-author blog: Flask JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"blog.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\nSESSION_TTL = timedelta(days=7)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nPASSWORD_MIN, PASSWORD_MAX = 8, 128\nTITLE_MAX = 200\nCONTENT_MAX = 100_000\nTAG_MAX_LEN = 30\nTAG_MAX_COUNT = 10\nDEFAULT_PAGE_SIZE, MAX_PAGE_SIZE = 10, 100\nEXCERPT_LEN = 200\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT,\n    is_admin INTEGER NOT NULL DEFAULT 0\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS posts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL,\n    content TEXT NOT NULL,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL,\n    taken_down INTEGER NOT NULL DEFAULT 0\n);\nCREATE INDEX IF NOT EXISTS posts_created ON posts(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS posts_user ON posts(user_id);\nCREATE TABLE IF NOT EXISTS post_tags (\n    post_id INTEGER NOT NULL REFERENCES posts(id) ON DELETE CASCADE,\n    position INTEGER NOT NULL,\n    tag TEXT NOT NULL COLLATE NOCASE,\n    PRIMARY KEY (post_id, position)\n);\nCREATE INDEX IF NOT EXISTS post_tags_tag ON post_tags(tag);\n\"\"\"\n\n\ndef _casefold(value):\n    return value.casefold() if isinstance(value, str) else value\n\n\ndef connect():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.create_function(\"casefold\", 1, _casefold, deterministic=True)\n    return conn\n\n\ndef init_db():\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef bump_iso(previous):\n    prev = datetime.fromisoformat(previous.replace(\"Z\", \"+00:00\"))\n    return (prev + timedelta(milliseconds=1)).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\nclass ApiError(Exception):\n    def __init__(self, status, message, errors=None):\n        self.status = status\n        self.message = message\n        self.errors = errors\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err):\n    body = {\"error\": err.message}\n    if err.errors:\n        body[\"errors\"] = err.errors\n    return jsonify(body), err.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(err):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": err.description or err.name}), err.code\n    return err\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(err):\n    app.logger.exception(\"unhandled error\")\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\n@app.after_request\ndef add_headers(resp):\n    resp.headers.setdefault(\"X-Content-Type-Options\", \"nosniff\")\n    resp.headers.setdefault(\"Referrer-Policy\", \"same-origin\")\n    if request.path.startswith(\"/api\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef hash_password(password, salt=None):\n    salt = salt or secrets.token_bytes(16)\n    digest = hashlib.scrypt(password.encode(), salt=salt, n=2**14, r=8, p=1, dklen=32)\n    return f\"scrypt${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password, stored):\n    try:\n        _, salt_hex, digest_hex = stored.split(\"$\")\n        expected = bytes.fromhex(digest_hex)\n        actual = hashlib.scrypt(\n            password.encode(), salt=bytes.fromhex(salt_hex), n=2**14, r=8, p=1, dklen=32\n        )\n    except (ValueError, AttributeError):\n        return False\n    return hmac.compare_digest(actual, expected)\n\n\nDUMMY_HASH = hash_password(secrets.token_hex(8))\n\n\ndef token_digest(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    if hasattr(g, \"_user\"):\n        return g._user\n    user = None\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) == 2 and parts[0].lower() == \"bearer\":\n        token = parts[1].strip()\n        row = db().execute(\n            \"SELECT u.id, u.username, u.is_admin, s.expires_at FROM sessions s \"\n            \"JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?\",\n            (token_digest(token),),\n        ).fetchone()\n        if row and row[\"expires_at\"] > now_iso():\n            is_admin = bool(row[\"is_admin\"]) and bool(ADMIN_PASSWORD)\n            if not row[\"is_admin\"] or is_admin:\n                user = {\"id\": row[\"id\"], \"username\": row[\"username\"], \"is_admin\": is_admin}\n    g._user = user\n    return user\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        raise ApiError(401, \"Authentication required\")\n    return user\n\n\ndef issue_token(user_id):\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE expires_at < ?\", (now_iso(),))\n    expires = (datetime.now(timezone.utc) + SESSION_TTL).isoformat(timespec=\"milliseconds\")\n    conn.execute(\n        \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (token_digest(token), user_id, expires.replace(\"+00:00\", \"Z\")),\n    )\n    conn.commit()\n    return token\n\n\ndef credentials():\n    data = json_body()\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(\n            400,\n            \"Validation failed\",\n            {\n                **({} if isinstance(username, str) else {\"username\": \"Username is required\"}),\n                **({} if isinstance(password, str) else {\"password\": \"Password is required\"}),\n            },\n        )\n    return username, password\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = credentials()\n    errors = {}\n    if not USERNAME_RE.match(username):\n        errors[\"username\"] = (\n            \"Username must be 3-32 characters: letters, digits, underscore, dot or hyphen\"\n        )\n    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:\n        errors[\"password\"] = f\"Password must be {PASSWORD_MIN}-{PASSWORD_MAX} characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    if username.lower() == ADMIN_USERNAME:\n        raise ApiError(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    conn = db()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, hash_password(password)),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = credentials()\n    conn = db()\n    invalid = ApiError(401, \"Invalid username or password\")\n    if username.lower() == ADMIN_USERNAME:\n        if not ADMIN_PASSWORD or not hmac.compare_digest(\n            hashlib.sha256(password.encode()).digest(),\n            hashlib.sha256(ADMIN_PASSWORD.encode()).digest(),\n        ):\n            raise invalid\n        conn.execute(\n            \"INSERT OR IGNORE INTO users (username, password_hash, is_admin) VALUES (?, NULL, 1)\",\n            (ADMIN_USERNAME,),\n        )\n        conn.commit()\n        row = conn.execute(\n            \"SELECT id FROM users WHERE username = ? AND is_admin = 1\", (ADMIN_USERNAME,)\n        ).fetchone()\n        if row is None:\n            raise invalid\n        return {\"token\": issue_token(row[\"id\"])}\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ? AND is_admin = 0\", (username,)\n    ).fetchone()\n    ok = verify_password(password, row[\"password_hash\"] if row else DUMMY_HASH)\n    if not row or not ok:\n        raise invalid\n    return {\"token\": issue_token(row[\"id\"])}\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = require_user()\n    return {\"username\": user[\"username\"], \"is_admin\": user[\"is_admin\"]}\n\n\ndef excerpt_of(content):\n    return re.sub(r\"[\\r\\n]+\", \" \", content)[:EXCERPT_LEN]\n\n\ndef tags_for(post_ids):\n    result = {pid: [] for pid in post_ids}\n    if post_ids:\n        marks = \",\".join(\"?\" * len(post_ids))\n        rows = db().execute(\n            f\"SELECT post_id, tag FROM post_tags WHERE post_id IN ({marks}) \"\n            \"ORDER BY post_id, position\",\n            list(post_ids),\n        )\n        for r in rows:\n            result[r[\"post_id\"]].append(r[\"tag\"])\n    return result\n\n\ndef serialize(rows):\n    tag_map = tags_for([r[\"id\"] for r in rows])\n    return [\n        {\n            \"id\": r[\"id\"],\n            \"title\": r[\"title\"],\n            \"content\": r[\"content\"],\n            \"tags\": tag_map[r[\"id\"]],\n            \"created_at\": r[\"created_at\"],\n            \"updated_at\": r[\"updated_at\"],\n            \"author\": r[\"author\"],\n            \"excerpt\": excerpt_of(r[\"content\"]),\n            \"taken_down\": bool(r[\"taken_down\"]),\n        }\n        for r in rows\n    ]\n\n\nPOST_SELECT = (\n    \"SELECT p.id, p.user_id, p.title, p.content, p.created_at, p.updated_at, p.taken_down, \"\n    \"u.username AS author FROM posts p JOIN users u ON u.id = p.user_id\"\n)\n\n\ndef fetch_post(post_id):\n    return db().execute(POST_SELECT + \" WHERE p.id = ?\", (post_id,)).fetchone()\n\n\ndef visible_post(post_id):\n    row = fetch_post(post_id)\n    user = current_user()\n    if row is None or (row[\"taken_down\"] and not (user and user[\"is_admin\"])):\n        raise ApiError(404, \"Post not found\")\n    return row\n\n\ndef validate_post(data):\n    errors = {}\n    title, content, tags = data.get(\"title\"), data.get(\"content\"), data.get(\"tags\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n    elif len(title.strip()) > TITLE_MAX:\n        errors[\"title\"] = f\"Title must be at most {TITLE_MAX} characters\"\n    if not isinstance(content, str) or not content.strip():\n        errors[\"content\"] = \"Content is required\"\n    elif len(content) > CONTENT_MAX:\n        errors[\"content\"] = f\"Content must be at most {CONTENT_MAX} characters\"\n    clean_tags = []\n    if tags is None:\n        pass\n    elif not isinstance(tags, list):\n        errors[\"tags\"] = \"Tags must be a list of strings\"\n    else:\n        seen = set()\n        for tag in tags:\n            if not isinstance(tag, str):\n                errors[\"tags\"] = \"Tags must be a list of strings\"\n                break\n            tag = tag.strip()\n            if not tag:\n                errors[\"tags\"] = \"Tags must not be empty\"\n                break\n            if len(tag) > TAG_MAX_LEN:\n                errors[\"tags\"] = f\"Each tag must be at most {TAG_MAX_LEN} characters\"\n                break\n            if \",\" in tag or any(ord(c) < 32 for c in tag):\n                errors[\"tags\"] = \"Tags must not contain commas or control characters\"\n                break\n            if tag.casefold() not in seen:\n                seen.add(tag.casefold())\n                clean_tags.append(tag)\n        if \"tags\" not in errors and len(clean_tags) > TAG_MAX_COUNT:\n            errors[\"tags\"] = f\"At most {TAG_MAX_COUNT} tags are allowed\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return title.strip(), content, clean_tags\n\n\ndef write_tags(conn, post_id, tags):\n    conn.execute(\"DELETE FROM post_tags WHERE post_id = ?\", (post_id,))\n    conn.executemany(\n        \"INSERT INTO post_tags (post_id, position, tag) VALUES (?, ?, ?)\",\n        [(post_id, i, t) for i, t in enumerate(tags)],\n    )\n\n\ndef int_param(name, default):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if value < 1:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    return value\n\n\n@app.get(\"/api/posts\")\ndef list_posts():\n    page = int_param(\"page\", 1)\n    page_size = min(int_param(\"page_size\", DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE)\n    user = current_user()\n    only_down = bool(user and user[\"is_admin\"] and request.args.get(\"taken_down\") in (\"1\", \"true\"))\n    where, params = [\"p.taken_down = ?\"], [1 if only_down else 0]\n    q = (request.args.get(\"q\") or \"\").strip()\n    if q:\n        needle = q.casefold()\n        where.append(\"(instr(casefold(p.title), ?) > 0 OR instr(casefold(p.content), ?) > 0)\")\n        params += [needle, needle]\n    tag = (request.args.get(\"tag\") or \"\").strip()\n    if tag:\n        where.append(\"EXISTS (SELECT 1 FROM post_tags t WHERE t.post_id = p.id AND t.tag = ?)\")\n        params.append(tag)\n    author = (request.args.get(\"author\") or \"\").strip()\n    if author:\n        where.append(\"u.username = ?\")\n        params.append(author)\n    clause = \" WHERE \" + \" AND \".join(where)\n    conn = db()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM posts p JOIN users u ON u.id = p.user_id\" + clause, params\n    ).fetchone()[0]\n    rows = conn.execute(\n        POST_SELECT + clause + \" ORDER BY p.created_at DESC, p.id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return {\"items\": serialize(rows), \"total\": total, \"page\": page, \"page_size\": page_size}\n\n\n@app.post(\"/api/posts\")\ndef create_post():\n    user = require_user()\n    title, content, tags = validate_post(json_body())\n    conn = db()\n    now = now_iso()\n    cur = conn.execute(\n        \"INSERT INTO posts (user_id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)\",\n        (user[\"id\"], title, content, now, now),\n    )\n    write_tags(conn, cur.lastrowid, tags)\n    conn.commit()\n    return jsonify(serialize([fetch_post(cur.lastrowid)])[0]), 201\n\n\n@app.get(\"/api/posts/<int:post_id>\")\ndef get_post(post_id):\n    return serialize([visible_post(post_id)])[0]\n\n\ndef own_post(post_id):\n    user = require_user()\n    row = visible_post(post_id)\n    if row[\"user_id\"] != user[\"id\"]:\n        raise ApiError(403, \"You can only change your own posts\")\n    return row\n\n\n@app.put(\"/api/posts/<int:post_id>\")\ndef update_post(post_id):\n    user = require_user()\n    row = own_post(post_id)\n    title, content, tags = validate_post(json_body())\n    now = now_iso()\n    if now <= row[\"updated_at\"]:\n        now = bump_iso(row[\"updated_at\"])\n    conn = db()\n    conn.execute(\n        \"UPDATE posts SET title = ?, content = ?, updated_at = ? WHERE id = ? AND user_id = ?\",\n        (title, content, now, post_id, user[\"id\"]),\n    )\n    write_tags(conn, post_id, tags)\n    conn.commit()\n    return serialize([fetch_post(post_id)])[0]\n\n\n@app.delete(\"/api/posts/<int:post_id>\")\ndef delete_post(post_id):\n    own_post(post_id)\n    conn = db()\n    conn.execute(\"DELETE FROM posts WHERE id = ?\", (post_id,))\n    conn.commit()\n    return \"\", 204\n\n\n@app.post(\"/api/admin/posts/<int:post_id>/toggle\")\ndef toggle_post(post_id):\n    user = require_user()\n    if not user[\"is_admin\"]:\n        raise ApiError(403, \"Admin only\")\n    conn = db()\n    cur = conn.execute(\"UPDATE posts SET taken_down = 1 - taken_down WHERE id = ?\", (post_id,))\n    conn.commit()\n    if cur.rowcount == 0:\n        raise ApiError(404, \"Post not found\")\n    return serialize([fetch_post(post_id)])[0]\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        raise ApiError(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Multi-author blog: Flask JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(\"data\")\nDB_PATH = DATA_DIR / \"blog.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\") or \"\"\n\nSESSION_TTL = timedelta(days=7)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nPASSWORD_MIN, PASSWORD_MAX = 8, 128\nTITLE_MAX = 200\nCONTENT_MAX = 100_000\nTAG_MAX_LEN = 30\nTAG_MAX_COUNT = 10\nDEFAULT_PAGE_SIZE, MAX_PAGE_SIZE = 10, 100\nEXCERPT_LEN = 200\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT,\n    is_admin INTEGER NOT NULL DEFAULT 0\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS posts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    title TEXT NOT NULL,\n    content TEXT NOT NULL,\n    created_at TEXT NOT NULL,\n    updated_at TEXT NOT NULL,\n    taken_down INTEGER NOT NULL DEFAULT 0\n);\nCREATE INDEX IF NOT EXISTS posts_created ON posts(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS posts_user ON posts(user_id);\nCREATE TABLE IF NOT EXISTS post_tags (\n    post_id INTEGER NOT NULL REFERENCES posts(id) ON DELETE CASCADE,\n    position INTEGER NOT NULL,\n    tag TEXT NOT NULL COLLATE NOCASE,\n    PRIMARY KEY (post_id, position)\n);\nCREATE INDEX IF NOT EXISTS post_tags_tag ON post_tags(tag);\n\"\"\"\n\n\ndef _casefold(value):\n    return value.casefold() if isinstance(value, str) else value\n\n\ndef connect():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.create_function(\"casefold\", 1, _casefold, deterministic=True)\n    return conn\n\n\ndef init_db():\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef bump_iso(previous):\n    prev = datetime.fromisoformat(previous.replace(\"Z\", \"+00:00\"))\n    return (prev + timedelta(milliseconds=1)).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\nclass ApiError(Exception):\n    def __init__(self, status, message, errors=None):\n        self.status = status\n        self.message = message\n        self.errors = errors\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err):\n    body = {\"error\": err.message}\n    if err.errors:\n        body[\"errors\"] = err.errors\n    return jsonify(body), err.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(err):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": err.description or err.name}), err.code\n    return err\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(err):\n    app.logger.exception(\"unhandled error\")\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\n@app.after_request\ndef add_headers(resp):\n    resp.headers.setdefault(\"X-Content-Type-Options\", \"nosniff\")\n    resp.headers.setdefault(\"Referrer-Policy\", \"same-origin\")\n    if request.path.startswith(\"/api\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef hash_password(password, salt=None):\n    salt = salt or secrets.token_bytes(16)\n    digest = hashlib.scrypt(password.encode(), salt=salt, n=2**14, r=8, p=1, dklen=32)\n    return f\"scrypt${salt.hex()}${digest.hex()}\"\n\n\ndef verify_password(password, stored):\n    try:\n        _, salt_hex, digest_hex = stored.split(\"$\")\n        expected = bytes.fromhex(digest_hex)\n        actual = hashlib.scrypt(\n            password.encode(), salt=bytes.fromhex(salt_hex), n=2**14, r=8, p=1, dklen=32\n        )\n    except (ValueError, AttributeError):\n        return False\n    return hmac.compare_digest(actual, expected)\n\n\nDUMMY_HASH = hash_password(secrets.token_hex(8))\n\n\ndef token_digest(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    if hasattr(g, \"_user\"):\n        return g._user\n    user = None\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) == 2 and parts[0].lower() == \"bearer\":\n        token = parts[1].strip()\n        row = db().execute(\n            \"SELECT u.id, u.username, u.is_admin, s.expires_at FROM sessions s \"\n            \"JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?\",\n            (token_digest(token),),\n        ).fetchone()\n        if row and row[\"expires_at\"] > now_iso():\n            is_admin = bool(row[\"is_admin\"]) and bool(ADMIN_PASSWORD)\n            if not row[\"is_admin\"] or is_admin:\n                user = {\"id\": row[\"id\"], \"username\": row[\"username\"], \"is_admin\": is_admin}\n    g._user = user\n    return user\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        raise ApiError(401, \"Authentication required\")\n    return user\n\n\ndef issue_token(user_id):\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE expires_at < ?\", (now_iso(),))\n    expires = (datetime.now(timezone.utc) + SESSION_TTL).isoformat(timespec=\"milliseconds\")\n    conn.execute(\n        \"INSERT INTO sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (token_digest(token), user_id, expires.replace(\"+00:00\", \"Z\")),\n    )\n    conn.commit()\n    return token\n\n\ndef credentials():\n    data = json_body()\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(\n            400,\n            \"Validation failed\",\n            {\n                **({} if isinstance(username, str) else {\"username\": \"Username is required\"}),\n                **({} if isinstance(password, str) else {\"password\": \"Password is required\"}),\n            },\n        )\n    return username, password\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = credentials()\n    errors = {}\n    if not USERNAME_RE.match(username):\n        errors[\"username\"] = (\n            \"Username must be 3-32 characters: letters, digits, underscore, dot or hyphen\"\n        )\n    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:\n        errors[\"password\"] = f\"Password must be {PASSWORD_MIN}-{PASSWORD_MAX} characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    if username.lower() == ADMIN_USERNAME:\n        raise ApiError(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    conn = db()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, hash_password(password)),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = credentials()\n    conn = db()\n    invalid = ApiError(401, \"Invalid username or password\")\n    if username.lower() == ADMIN_USERNAME:\n        if not ADMIN_PASSWORD or not hmac.compare_digest(\n            hashlib.sha256(password.encode()).digest(),\n            hashlib.sha256(ADMIN_PASSWORD.encode()).digest(),\n        ):\n            raise invalid\n        conn.execute(\n            \"INSERT OR IGNORE INTO users (username, password_hash, is_admin) VALUES (?, NULL, 1)\",\n            (ADMIN_USERNAME,),\n        )\n        conn.commit()\n        row = conn.execute(\n            \"SELECT id FROM users WHERE username = ? AND is_admin = 1\", (ADMIN_USERNAME,)\n        ).fetchone()\n        if row is None:\n            raise invalid\n        return {\"token\": issue_token(row[\"id\"])}\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ? AND is_admin = 0\", (username,)\n    ).fetchone()\n    ok = verify_password(password, row[\"password_hash\"] if row else DUMMY_HASH)\n    if not row or not ok:\n        raise invalid\n    return {\"token\": issue_token(row[\"id\"])}\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = require_user()\n    return {\"username\": user[\"username\"], \"is_admin\": user[\"is_admin\"]}\n\n\ndef excerpt_of(content):\n    return re.sub(r\"[\\r\\n]+\", \" \", content)[:EXCERPT_LEN]\n\n\ndef tags_for(post_ids):\n    result = {pid: [] for pid in post_ids}\n    if post_ids:\n        marks = \",\".join(\"?\" * len(post_ids))\n        rows = db().execute(\n            f\"SELECT post_id, tag FROM post_tags WHERE post_id IN ({marks}) \"\n            \"ORDER BY post_id, position\",\n            list(post_ids),\n        )\n        for r in rows:\n            result[r[\"post_id\"]].append(r[\"tag\"])\n    return result\n\n\ndef serialize(rows):\n    tag_map = tags_for([r[\"id\"] for r in rows])\n    return [\n        {\n            \"id\": r[\"id\"],\n            \"title\": r[\"title\"],\n            \"content\": r[\"content\"],\n            \"tags\": tag_map[r[\"id\"]],\n            \"created_at\": r[\"created_at\"],\n            \"updated_at\": r[\"updated_at\"],\n            \"author\": r[\"author\"],\n            \"excerpt\": excerpt_of(r[\"content\"]),\n            \"taken_down\": bool(r[\"taken_down\"]),\n        }\n        for r in rows\n    ]\n\n\nPOST_SELECT = (\n    \"SELECT p.id, p.user_id, p.title, p.content, p.created_at, p.updated_at, p.taken_down, \"\n    \"u.username AS author FROM posts p JOIN users u ON u.id = p.user_id\"\n)\n\n\ndef fetch_post(post_id):\n    return db().execute(POST_SELECT + \" WHERE p.id = ?\", (post_id,)).fetchone()\n\n\ndef visible_post(post_id):\n    row = fetch_post(post_id)\n    user = current_user()\n    if row is None or (row[\"taken_down\"] and not (user and user[\"is_admin\"])):\n        raise ApiError(404, \"Post not found\")\n    return row\n\n\ndef validate_post(data):\n    errors = {}\n    title, content, tags = data.get(\"title\"), data.get(\"content\"), data.get(\"tags\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n    elif len(title.strip()) > TITLE_MAX:\n        errors[\"title\"] = f\"Title must be at most {TITLE_MAX} characters\"\n    if not isinstance(content, str) or not content.strip():\n        errors[\"content\"] = \"Content is required\"\n    elif len(content) > CONTENT_MAX:\n        errors[\"content\"] = f\"Content must be at most {CONTENT_MAX} characters\"\n    clean_tags = []\n    if tags is None:\n        pass\n    elif not isinstance(tags, list):\n        errors[\"tags\"] = \"Tags must be a list of strings\"\n    else:\n        seen = set()\n        for tag in tags:\n            if not isinstance(tag, str):\n                errors[\"tags\"] = \"Tags must be a list of strings\"\n                break\n            tag = tag.strip()\n            if not tag:\n                errors[\"tags\"] = \"Tags must not be empty\"\n                break\n            if len(tag) > TAG_MAX_LEN:\n                errors[\"tags\"] = f\"Each tag must be at most {TAG_MAX_LEN} characters\"\n                break\n            if \",\" in tag or any(ord(c) < 32 for c in tag):\n                errors[\"tags\"] = \"Tags must not contain commas or control characters\"\n                break\n            if tag.casefold() not in seen:\n                seen.add(tag.casefold())\n                clean_tags.append(tag)\n        if \"tags\" not in errors and len(clean_tags) > TAG_MAX_COUNT:\n            errors[\"tags\"] = f\"At most {TAG_MAX_COUNT} tags are allowed\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return title.strip(), content, clean_tags\n\n\ndef write_tags(conn, post_id, tags):\n    conn.execute(\"DELETE FROM post_tags WHERE post_id = ?\", (post_id,))\n    conn.executemany(\n        \"INSERT INTO post_tags (post_id, position, tag) VALUES (?, ?, ?)\",\n        [(post_id, i, t) for i, t in enumerate(tags)],\n    )\n\n\ndef int_param(name, default):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if value < 1:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    return value\n\n\n@app.get(\"/api/posts\")\ndef list_posts():\n    page = int_param(\"page\", 1)\n    page_size = min(int_param(\"page_size\", DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE)\n    user = current_user()\n    only_down = bool(user and user[\"is_admin\"] and request.args.get(\"taken_down\") in (\"1\", \"true\"))\n    where, params = [\"p.taken_down = ?\"], [1 if only_down else 0]\n    q = (request.args.get(\"q\") or \"\").strip()\n    if q:\n        needle = q.casefold()\n        where.append(\"(instr(casefold(p.title), ?) > 0 OR instr(casefold(p.content), ?) > 0)\")\n        params += [needle, needle]\n    tag = (request.args.get(\"tag\") or \"\").strip()\n    if tag:\n        where.append(\"EXISTS (SELECT 1 FROM post_tags t WHERE t.post_id = p.id AND t.tag = ?)\")\n        params.append(tag)\n    author = (request.args.get(\"author\") or \"\").strip()\n    if author:\n        where.append(\"u.username = ?\")\n        params.append(author)\n    clause = \" WHERE \" + \" AND \".join(where)\n    conn = db()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM posts p JOIN users u ON u.id = p.user_id\" + clause, params\n    ).fetchone()[0]\n    rows = conn.execute(\n        POST_SELECT + clause + \" ORDER BY p.created_at DESC, p.id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return {\"items\": serialize(rows), \"total\": total, \"page\": page, \"page_size\": page_size}\n\n\n@app.post(\"/api/posts\")\ndef create_post():\n    user = require_user()\n    title, content, tags = validate_post(json_body())\n    conn = db()\n    now = now_iso()\n    cur = conn.execute(\n        \"INSERT INTO posts (user_id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)\",\n        (user[\"id\"], title, content, now, now),\n    )\n    write_tags(conn, cur.lastrowid, tags)\n    conn.commit()\n    return jsonify(serialize([fetch_post(cur.lastrowid)])[0]), 201\n\n\n@app.get(\"/api/posts/<int:post_id>\")\ndef get_post(post_id):\n    return serialize([visible_post(post_id)])[0]\n\n\ndef own_post(post_id):\n    user = require_user()\n    row = visible_post(post_id)\n    if row[\"user_id\"] != user[\"id\"]:\n        raise ApiError(403, \"You can only change your own posts\")\n    return row\n\n\n@app.put(\"/api/posts/<int:post_id>\")\ndef update_post(post_id):\n    user = require_user()\n    row = own_post(post_id)\n    title, content, tags = validate_post(json_body())\n    now = now_iso()\n    if now <= row[\"updated_at\"]:\n        now = bump_iso(row[\"updated_at\"])\n    conn = db()\n    conn.execute(\n        \"UPDATE posts SET title = ?, content = ?, updated_at = ? WHERE id = ? AND user_id = ?\",\n        (title, content, now, post_id, user[\"id\"]),\n    )\n    write_tags(conn, post_id, tags)\n    conn.commit()\n    return serialize([fetch_post(post_id)])[0]\n\n\n@app.delete(\"/api/posts/<int:post_id>\")\ndef delete_post(post_id):\n    own_post(post_id)\n    conn = db()\n    conn.execute(\"DELETE FROM posts WHERE id = ?\", (post_id,))\n    conn.commit()\n    return \"\", 204\n\n\n@app.post(\"/api/admin/posts/<int:post_id>/toggle\")\ndef toggle_post(post_id):\n    user = require_user()\n    if not user[\"is_admin\"]:\n        raise ApiError(403, \"Admin only\")\n    conn = db()\n    cur = conn.execute(\"UPDATE posts SET taken_down = 1 - taken_down WHERE id = ?\", (post_id,))\n    conn.commit()\n    if cur.rowcount == 0:\n        raise ApiError(404, \"Post not found\")\n    return serialize([fetch_post(post_id)])[0]\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        raise ApiError(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF","time":{"start":1794254974675,"end":1794254974692}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1ee2eca001P50XjXQWFGnBmx","sessionID":"ses_e3e15377dffelxyWGsivpUJQSG","messageID":"msg_1c1ece4ca001H4a2iaOyLx2JwR"}}
