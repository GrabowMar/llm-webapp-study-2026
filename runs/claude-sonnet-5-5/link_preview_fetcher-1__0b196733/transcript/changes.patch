--- a/frontend/src/App.tsx
+++ b/frontend/src/App.tsx
@@ -1,3 +1,181 @@
+import { useCallback, useEffect, useState } from "react";
+import { api, ApiError, getToken, setToken, type PreviewPage } from "./api";
+import AuthForm from "./AuthForm";
+import PreviewCard from "./PreviewCard";
+
+const PAGE_SIZE = 9;
+
+function Dashboard({ username, onSignOut }: { username: string; onSignOut: () => void }) {
+  const [data, setData] = useState<PreviewPage | null>(null);
+  const [page, setPage] = useState(1);
+  const [url, setUrl] = useState("");
+  const [adding, setAdding] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = useCallback(
+    async (p: number) => {
+      try {
+        const result = await api.list(p, PAGE_SIZE);
+        const lastPage = Math.max(1, Math.ceil(result.total / PAGE_SIZE));
+        if (p > lastPage) {
+          setPage(lastPage);
+          return;
+        }
+        setData(result);
+      } catch (err) {
+        if (err instanceof ApiError && err.status === 401) onSignOut();
+        else setError(err instanceof Error ? err.message : "Failed to load");
+      }
+    },
+    [onSignOut],
+  );
+
+  useEffect(() => {
+    load(page);
+  }, [page, load]);
+
+  async function add(e: React.FormEvent) {
+    e.preventDefault();
+    if (!url.trim()) return;
+    setAdding(true);
+    setError(null);
+    try {
+      await api.create(url.trim());
+      setUrl("");
+      if (page === 1) await load(1);
+      else setPage(1);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Failed to add link");
+    } finally {
+      setAdding(false);
+    }
+  }
+
+  async function refresh(id: number) {
