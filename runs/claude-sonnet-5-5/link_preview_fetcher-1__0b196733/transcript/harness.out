{"type":"tool_use","timestamp":1794251634675,"sessionID":"ses_e3e45f79effenLQTXX4KCH1w6x","part":{"type":"tool","tool":"bash","callID":"toolu_01SVAt5GB15uRDkjUakGk3vu","state":{"status":"completed","input":{"command":"mkdir -p /workspace/backend && cd /workspace/backend && cat > db.py <<'EOF'\nimport os\nimport sqlite3\nfrom pathlib import Path\n\nfrom flask import g\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at INTEGER NOT NULL\n);\nCREATE TABLE IF NOT EXISTS previews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    url TEXT NOT NULL,\n    final_url TEXT,\n    status_code INTEGER,\n    title TEXT,\n    description TEXT,\n    image_url TEXT,\n    fetched_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS previews_user_idx ON previews (user_id, id DESC);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DATA_DIR / \"app.db\", timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys=ON\")\n    conn.execute(\"PRAGMA busy_timeout=15000\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\ndef close_db(_exc=None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\nEOF\ncat > extract.py <<'EOF'\nimport re\nfrom html.parser import HTMLParser\nfrom urllib.parse import urljoin, urlsplit\n\nTITLE_MAX = 300\nDESCRIPTION_MAX = 1000\nIMAGE_URL_MAX = 2048\n\n_CONTROL = re.compile(r\"[\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]\")\n_SPACE = re.compile(r\"\\s+\")\n\n\ndef clean_text(value, limit):\n    if not value:\n        return None\n    value = _CONTROL.sub(\"\", value)\n    value = _SPACE.sub(\" \", value).strip()\n    if not value:\n        return None\n    return value[:limit]\n\n\ndef clean_url(value, base):\n    if not value:\n        return None\n    value = _CONTROL.sub(\"\", value).strip()\n    if not value:\n        return None\n    try:\n        absolute = urljoin(base, value)\n        parts = urlsplit(absolute)\n        if parts.scheme not in (\"http\", \"https\") or not parts.hostname:\n            return None\n    except ValueError:\n        return None\n    if len(absolute) > IMAGE_URL_MAX:\n        return None\n    return absolute\n\n\nclass _Parser(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.title = None\n        self._title_parts = []\n        self._in_title = False\n        self._svg_depth = 0\n        self.meta = {}\n\n    def handle_starttag(self, tag, attrs):\n        if tag == \"svg\":\n            self._svg_depth += 1\n        elif tag == \"title\" and self._svg_depth == 0 and self.title is None:\n            self._in_title = True\n            self._title_parts = []\n        elif tag == \"meta\":\n            self._handle_meta(attrs)\n\n    def handle_startendtag(self, tag, attrs):\n        if tag == \"meta\":\n            self._handle_meta(attrs)\n\n    def handle_endtag(self, tag):\n        if tag == \"svg\" and self._svg_depth:\n            self._svg_depth -= 1\n        elif tag == \"title\" and self._in_title:\n            self._in_title = False\n            self.title = \"\".join(self._title_parts)\n\n    def handle_data(self, data):\n        if self._in_title:\n            self._title_parts.append(data)\n\n    def _handle_meta(self, attrs):\n        d = {k.lower(): v for k, v in attrs if v is not None}\n        key = (d.get(\"property\") or d.get(\"name\") or \"\").strip().lower()\n        content = d.get(\"content\")\n        if key and content is not None and key not in self.meta:\n            self.meta[key] = content\n\n    def close(self):\n        super().close()\n        if self._in_title and self.title is None:\n            self.title = \"\".join(self._title_parts)\n\n\ndef extract_preview(html, base_url):\n    parser = _Parser()\n    try:\n        parser.feed(html)\n        parser.close()\n    except Exception:\n        pass\n    title = clean_text(parser.meta.get(\"og:title\"), TITLE_MAX) or clean_text(parser.title, TITLE_MAX)\n    description = clean_text(parser.meta.get(\"og:description\"), DESCRIPTION_MAX) or clean_text(\n        parser.meta.get(\"description\"), DESCRIPTION_MAX\n    )\n    image_url = clean_url(parser.meta.get(\"og:image\"), base_url)\n    return {\"title\": title, \"description\": description, \"image_url\": image_url}\nEOF\ncat > fetcher.py <<'EOF'\nimport codecs\nimport http.client\nimport ipaddress\nimport os\nimport re\nimport socket\nimport ssl\nimport time\nfrom urllib.parse import quote, urljoin, urlsplit\n\nMAX_BYTES = 1024 * 1024\nMAX_REDIRECTS = 5\nTOTAL_TIMEOUT = 15.0\nSOCKET_TIMEOUT = 8.0\nUSER_AGENT = \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"\nALLOW_PRIVATE = os.environ.get(\"ALLOW_PRIVATE_FETCH\", \"\").lower() in (\"1\", \"true\", \"yes\")\n\n_SSL_CONTEXT = ssl.create_default_context()\n_META_CHARSET = re.compile(rb\"\"\"<meta[^>]+charset\\s*=\\s*[\"']?\\s*([A-Za-z0-9_\\-:.]+)\"\"\", re.I)\n_NAT64 = ipaddress.ip_network(\"64:ff9b::/96\")\n_SIXTOFOUR = ipaddress.ip_network(\"2002::/16\")\n\n\nclass FetchError(Exception):\n    def __init__(self, message, status=502):\n        super().__init__(message)\n        self.message = message\n        self.status = status\n\n\nclass InvalidUrl(FetchError):\n    def __init__(self, message):\n        super().__init__(message, 400)\n\n\ndef _ip_allowed(ip):\n    if ALLOW_PRIVATE:\n        return True\n    if isinstance(ip, ipaddress.IPv6Address):\n        if ip.ipv4_mapped is not None:\n            return _ip_allowed(ip.ipv4_mapped)\n        if ip in _NAT64:\n            return _ip_allowed(ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF))\n        if ip in _SIXTOFOUR:\n            return _ip_allowed(ipaddress.IPv4Address((int(ip) >> 80) & 0xFFFFFFFF))\n    return ip.is_global and not ip.is_multicast\n\n\ndef parse_url(url):\n    if not isinstance(url, str):\n        raise InvalidUrl(\"url must be a string\")\n    url = url.strip()\n    if not url or len(url) > 2048 or re.search(r\"[\\x00-\\x20\\x7f]\", url):\n        raise InvalidUrl(\"invalid url\")\n    try:\n        parts = urlsplit(url)\n        host = parts.hostname\n        port = parts.port\n    except ValueError:\n        raise InvalidUrl(\"invalid url\")\n    if parts.scheme not in (\"http\", \"https\"):\n        raise InvalidUrl(\"url must start with http:// or https://\")\n    if not host:\n        raise InvalidUrl(\"url has no host\")\n    if parts.username is not None or parts.password is not None:\n        raise InvalidUrl(\"credentials in url are not allowed\")\n    return url, parts, host, port\n\n\ndef _resolve(host, port):\n    try:\n        host_ascii = host.encode(\"idna\").decode(\"ascii\")\n    except UnicodeError:\n        raise InvalidUrl(\"invalid host\")\n    try:\n        infos = socket.getaddrinfo(host_ascii, port, type=socket.SOCK_STREAM)\n    except (socket.gaierror, UnicodeError):\n        raise FetchError(\"could not resolve host\")\n    addrs = []\n    for info in infos:\n        try:\n            ip = ipaddress.ip_address(info[4][0].split(\"%\")[0])\n        except ValueError:\n            continue\n        addrs.append((info[0], info[4][0], ip))\n    if not addrs:\n        raise FetchError(\"could not resolve host\")\n    for _, _, ip in addrs:\n        if not _ip_allowed(ip):\n            raise InvalidUrl(\"url points to a non-public address\")\n    return host_ascii, addrs\n\n\ndef _connect(addrs, port, deadline):\n    last = None\n    for family, addr, _ in addrs:\n        remaining = deadline - time.monotonic()\n        if remaining <= 0:\n            break\n        try:\n            sock = socket.socket(family, socket.SOCK_STREAM)\n            sock.settimeout(min(SOCKET_TIMEOUT, remaining))\n            sock.connect((addr, port) if family == socket.AF_INET else (addr, port, 0, 0))\n            return sock\n        except OSError as exc:\n            last = exc\n            try:\n                sock.close()\n            except OSError:\n                pass\n    raise FetchError(\"could not connect to host\" if last else \"timed out\")\n\n\ndef _request_once(url, deadline):\n    _, parts, host, port = parse_url(url)\n    secure = parts.scheme == \"https\"\n    port = port or (443 if secure else 80)\n    host_ascii, addrs = _resolve(host, port)\n    sock = _connect(addrs, port, deadline)\n    try:\n        if secure:\n            try:\n                sock = _SSL_CONTEXT.wrap_socket(sock, server_hostname=host_ascii)\n            except (ssl.SSLError, OSError):\n                raise FetchError(\"TLS handshake failed\")\n        path = quote(parts.path or \"/\", safe=\"/%:@!$&'()*+,;=~-._\")\n        if parts.query:\n            path += \"?\" + quote(parts.query, safe=\"/%:@!$&'()*+,;=~-._?\")\n        default_port = 443 if secure else 80\n        host_header = host_ascii if \":\" not in host_ascii else f\"[{host_ascii}]\"\n        if port != default_port:\n            host_header += f\":{port}\"\n        conn = http.client.HTTPConnection(\"localhost\")\n        conn.sock = sock\n        conn.putrequest(\"GET\", path, skip_host=True, skip_accept_encoding=True)\n        conn.putheader(\"Host\", host_header)\n        conn.putheader(\"User-Agent\", USER_AGENT)\n        conn.putheader(\"Accept\", \"text/html,application/xhtml+xml;q=0.9,*/*;q=0.5\")\n        conn.putheader(\"Accept-Encoding\", \"identity\")\n        conn.putheader(\"Connection\", \"close\")\n        conn.endheaders()\n        try:\n            resp = conn.getresponse()\n            status = resp.status\n            headers = resp.headers\n            location = headers.get(\"Location\")\n            body = b\"\"\n            if not (300 <= status < 400 and location):\n                chunks = []\n                size = 0\n                while size < MAX_BYTES:\n                    if time.monotonic() > deadline:\n                        raise FetchError(\"timed out\")\n                    chunk = resp.read(min(16384, MAX_BYTES - size))\n                    if not chunk:\n                        break\n                    chunks.append(chunk)\n                    size += len(chunk)\n                body = b\"\".join(chunks)\n            return status, headers, location, body\n        except (http.client.HTTPException, OSError):\n            raise FetchError(\"failed to read response from host\")\n    finally:\n        try:\n            sock.close()\n        except OSError:\n            pass\n\n\ndef _decode(body, content_type):\n    charset = None\n    m = re.search(r\"charset\\s*=\\s*[\\\"']?([A-Za-z0-9_\\-:.]+)\", content_type or \"\", re.I)\n    if m:\n        charset = m.group(1)\n    if not charset:\n        m = _META_CHARSET.search(body[:4096])\n        if m:\n            charset = m.group(1).decode(\"ascii\", \"ignore\")\n    if body.startswith(codecs.BOM_UTF8):\n        charset = \"utf-8-sig\"\n    try:\n        return body.decode(charset or \"utf-8\", \"replace\")\n    except (LookupError, TypeError):\n        return body.decode(\"utf-8\", \"replace\")\n\n\ndef fetch_page(url):\n    url, _, _, _ = parse_url(url)\n    deadline = time.monotonic() + TOTAL_TIMEOUT\n    current = url\n    for _ in range(MAX_REDIRECTS + 1):\n        status, headers, location, body = _request_once(current, deadline)\n        if 300 <= status < 400 and location:\n            current = urljoin(current, location.strip())\n            continue\n        content_type = headers.get(\"Content-Type\", \"\")\n        mime = content_type.split(\";\")[0].strip().lower()\n        html = None\n        if not mime or mime in (\"text/html\", \"application/xhtml+xml\"):\n            html = _decode(body, content_type)\n        return {\"final_url\": current, \"status_code\": status, \"html\": html}\n    raise FetchError(\"too many redirects\")\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"mkdir -p /workspace/backend && cd /workspace/backend && cat > db.py <<'EOF'\nimport os\nimport sqlite3\nfrom pathlib import Path\n\nfrom flask import g\n\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at INTEGER NOT NULL\n);\nCREATE TABLE IF NOT EXISTS previews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    url TEXT NOT NULL,\n    final_url TEXT,\n    status_code INTEGER,\n    title TEXT,\n    description TEXT,\n    image_url TEXT,\n    fetched_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS previews_user_idx ON previews (user_id, id DESC);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DATA_DIR / \"app.db\", timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys=ON\")\n    conn.execute(\"PRAGMA busy_timeout=15000\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode=WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef get_db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\ndef close_db(_exc=None) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\nEOF\ncat > extract.py <<'EOF'\nimport re\nfrom html.parser import HTMLParser\nfrom urllib.parse import urljoin, urlsplit\n\nTITLE_MAX = 300\nDESCRIPTION_MAX = 1000\nIMAGE_URL_MAX = 2048\n\n_CONTROL = re.compile(r\"[\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]\")\n_SPACE = re.compile(r\"\\s+\")\n\n\ndef clean_text(value, limit):\n    if not value:\n        return None\n    value = _CONTROL.sub(\"\", value)\n    value = _SPACE.sub(\" \", value).strip()\n    if not value:\n        return None\n    return value[:limit]\n\n\ndef clean_url(value, base):\n    if not value:\n        return None\n    value = _CONTROL.sub(\"\", value).strip()\n    if not value:\n        return None\n    try:\n        absolute = urljoin(base, value)\n        parts = urlsplit(absolute)\n        if parts.scheme not in (\"http\", \"https\") or not parts.hostname:\n            return None\n    except ValueError:\n        return None\n    if len(absolute) > IMAGE_URL_MAX:\n        return None\n    return absolute\n\n\nclass _Parser(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.title = None\n        self._title_parts = []\n        self._in_title = False\n        self._svg_depth = 0\n        self.meta = {}\n\n    def handle_starttag(self, tag, attrs):\n        if tag == \"svg\":\n            self._svg_depth += 1\n        elif tag == \"title\" and self._svg_depth == 0 and self.title is None:\n            self._in_title = True\n            self._title_parts = []\n        elif tag == \"meta\":\n            self._handle_meta(attrs)\n\n    def handle_startendtag(self, tag, attrs):\n        if tag == \"meta\":\n            self._handle_meta(attrs)\n\n    def handle_endtag(self, tag):\n        if tag == \"svg\" and self._svg_depth:\n            self._svg_depth -= 1\n        elif tag == \"title\" and self._in_title:\n            self._in_title = False\n            self.title = \"\".join(self._title_parts)\n\n    def handle_data(self, data):\n        if self._in_title:\n            self._title_parts.append(data)\n\n    def _handle_meta(self, attrs):\n        d = {k.lower(): v for k, v in attrs if v is not None}\n        key = (d.get(\"property\") or d.get(\"name\") or \"\").strip().lower()\n        content = d.get(\"content\")\n        if key and content is not None and key not in self.meta:\n            self.meta[key] = content\n\n    def close(self):\n        super().close()\n        if self._in_title and self.title is None:\n            self.title = \"\".join(self._title_parts)\n\n\ndef extract_preview(html, base_url):\n    parser = _Parser()\n    try:\n        parser.feed(html)\n        parser.close()\n    except Exception:\n        pass\n    title = clean_text(parser.meta.get(\"og:title\"), TITLE_MAX) or clean_text(parser.title, TITLE_MAX)\n    description = clean_text(parser.meta.get(\"og:description\"), DESCRIPTION_MAX) or clean_text(\n        parser.meta.get(\"description\"), DESCRIPTION_MAX\n    )\n    image_url = clean_url(parser.meta.get(\"og:image\"), base_url)\n    return {\"title\": title, \"description\": description, \"image_url\": image_url}\nEOF\ncat > fetcher.py <<'EOF'\nimport codecs\nimport http.client\nimport ipaddress\nimport os\nimport re\nimport socket\nimport ssl\nimport time\nfrom urllib.parse import quote, urljoin, urlsplit\n\nMAX_BYTES = 1024 * 1024\nMAX_REDIRECTS = 5\nTOTAL_TIMEOUT = 15.0\nSOCKET_TIMEOUT = 8.0\nUSER_AGENT = \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"\nALLOW_PRIVATE = os.environ.get(\"ALLOW_PRIVATE_FETCH\", \"\").lower() in (\"1\", \"true\", \"yes\")\n\n_SSL_CONTEXT = ssl.create_default_context()\n_META_CHARSET = re.compile(rb\"\"\"<meta[^>]+charset\\s*=\\s*[\"']?\\s*([A-Za-z0-9_\\-:.]+)\"\"\", re.I)\n_NAT64 = ipaddress.ip_network(\"64:ff9b::/96\")\n_SIXTOFOUR = ipaddress.ip_network(\"2002::/16\")\n\n\nclass FetchError(Exception):\n    def __init__(self, message, status=502):\n        super().__init__(message)\n        self.message = message\n        self.status = status\n\n\nclass InvalidUrl(FetchError):\n    def __init__(self, message):\n        super().__init__(message, 400)\n\n\ndef _ip_allowed(ip):\n    if ALLOW_PRIVATE:\n        return True\n    if isinstance(ip, ipaddress.IPv6Address):\n        if ip.ipv4_mapped is not None:\n            return _ip_allowed(ip.ipv4_mapped)\n        if ip in _NAT64:\n            return _ip_allowed(ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF))\n        if ip in _SIXTOFOUR:\n            return _ip_allowed(ipaddress.IPv4Address((int(ip) >> 80) & 0xFFFFFFFF))\n    return ip.is_global and not ip.is_multicast\n\n\ndef parse_url(url):\n    if not isinstance(url, str):\n        raise InvalidUrl(\"url must be a string\")\n    url = url.strip()\n    if not url or len(url) > 2048 or re.search(r\"[\\x00-\\x20\\x7f]\", url):\n        raise InvalidUrl(\"invalid url\")\n    try:\n        parts = urlsplit(url)\n        host = parts.hostname\n        port = parts.port\n    except ValueError:\n        raise InvalidUrl(\"invalid url\")\n    if parts.scheme not in (\"http\", \"https\"):\n        raise InvalidUrl(\"url must start with http:// or https://\")\n    if not host:\n        raise InvalidUrl(\"url has no host\")\n    if parts.username is not None or parts.password is not None:\n        raise InvalidUrl(\"credentials in url are not allowed\")\n    return url, parts, host, port\n\n\ndef _resolve(host, port):\n    try:\n        host_ascii = host.encode(\"idna\").decode(\"ascii\")\n    except UnicodeError:\n        raise InvalidUrl(\"invalid host\")\n    try:\n        infos = socket.getaddrinfo(host_ascii, port, type=socket.SOCK_STREAM)\n    except (socket.gaierror, UnicodeError):\n        raise FetchError(\"could not resolve host\")\n    addrs = []\n    for info in infos:\n        try:\n            ip = ipaddress.ip_address(info[4][0].split(\"%\")[0])\n        except ValueError:\n            continue\n        addrs.append((info[0], info[4][0], ip))\n    if not addrs:\n        raise FetchError(\"could not resolve host\")\n    for _, _, ip in addrs:\n        if not _ip_allowed(ip):\n            raise InvalidUrl(\"url points to a non-public address\")\n    return host_ascii, addrs\n\n\ndef _connect(addrs, port, deadline):\n    last = None\n    for family, addr, _ in addrs:\n        remaining = deadline - time.monotonic()\n        if remaining <= 0:\n            break\n        try:\n            sock = socket.socket(family, socket.SOCK_STREAM)\n            sock.settimeout(min(SOCKET_TIMEOUT, remaining))\n            sock.connect((addr, port) if family == socket.AF_INET else (addr, port, 0, 0))\n            return sock\n        except OSError as exc:\n            last = exc\n            try:\n                sock.close()\n            except OSError:\n                pass\n    raise FetchError(\"could not connect to host\" if last else \"timed out\")\n\n\ndef _request_once(url, deadline):\n    _, parts, host, port = parse_url(url)\n    secure = parts.scheme == \"https\"\n    port = port or (443 if secure else 80)\n    host_ascii, addrs = _resolve(host, port)\n    sock = _connect(addrs, port, deadline)\n    try:\n        if secure:\n            try:\n                sock = _SSL_CONTEXT.wrap_socket(sock, server_hostname=host_ascii)\n            except (ssl.SSLError, OSError):\n                raise FetchError(\"TLS handshake failed\")\n        path = quote(parts.path or \"/\", safe=\"/%:@!$&'()*+,;=~-._\")\n        if parts.query:\n            path += \"?\" + quote(parts.query, safe=\"/%:@!$&'()*+,;=~-._?\")\n        default_port = 443 if secure else 80\n        host_header = host_ascii if \":\" not in host_ascii else f\"[{host_ascii}]\"\n        if port != default_port:\n            host_header += f\":{port}\"\n        conn = http.client.HTTPConnection(\"localhost\")\n        conn.sock = sock\n        conn.putrequest(\"GET\", path, skip_host=True, skip_accept_encoding=True)\n        conn.putheader(\"Host\", host_header)\n        conn.putheader(\"User-Agent\", USER_AGENT)\n        conn.putheader(\"Accept\", \"text/html,application/xhtml+xml;q=0.9,*/*;q=0.5\")\n        conn.putheader(\"Accept-Encoding\", \"identity\")\n        conn.putheader(\"Connection\", \"close\")\n        conn.endheaders()\n        try:\n            resp = conn.getresponse()\n            status = resp.status\n            headers = resp.headers\n            location = headers.get(\"Location\")\n            body = b\"\"\n            if not (300 <= status < 400 and location):\n                chunks = []\n                size = 0\n                while size < MAX_BYTES:\n                    if time.monotonic() > deadline:\n                        raise FetchError(\"timed out\")\n                    chunk = resp.read(min(16384, MAX_BYTES - size))\n                    if not chunk:\n                        break\n                    chunks.append(chunk)\n                    size += len(chunk)\n                body = b\"\".join(chunks)\n            return status, headers, location, body\n        except (http.client.HTTPException, OSError):\n            raise FetchError(\"failed to read response from host\")\n    finally:\n        try:\n            sock.close()\n        except OSError:\n            pass\n\n\ndef _decode(body, content_type):\n    charset = None\n    m = re.search(r\"charset\\s*=\\s*[\\\"']?([A-Za-z0-9_\\-:.]+)\", content_type or \"\", re.I)\n    if m:\n        charset = m.group(1)\n    if not charset:\n        m = _META_CHARSET.search(body[:4096])\n        if m:\n            charset = m.group(1).decode(\"ascii\", \"ignore\")\n    if body.startswith(codecs.BOM_UTF8):\n        charset = \"utf-8-sig\"\n    try:\n        return body.decode(charset or \"utf-8\", \"replace\")\n    except (LookupError, TypeError):\n        return body.decode(\"utf-8\", \"replace\")\n\n\ndef fetch_page(url):\n    url, _, _, _ = parse_url(url)\n    deadline = time.monotonic() + TOTAL_TIMEOUT\n    current = url\n    for _ in range(MAX_REDIRECTS + 1):\n        status, headers, location, body = _request_once(current, deadline)\n        if 300 <= status < 400 and location:\n            current = urljoin(current, location.strip())\n            continue\n        content_type = headers.get(\"Content-Type\", \"\")\n        mime = content_type.split(\";\")[0].strip().lower()\n        html = None\n        if not mime or mime in (\"text/html\", \"application/xhtml+xml\"):\n            html = _decode(body, content_type)\n        return {\"final_url\": current, \"status_code\": status, \"html\": html}\n    raise FetchError(\"too many redirects\")\nEOF","time":{"start":1794251634558,"end":1794251634605}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1bb3760001xvTxyZ6sUjGG7c","sessionID":"ses_e3e45f79effenLQTXX4KCH1w6x","messageID":"msg_1c1ba2c730011iIQpx53A01936"}}
