+def transfer_json(row, user_id):
+    return {
+        "id": row["id"],
+        "from_username": row["from_username"],
+        "to_username": row["to_username"],
+        "amount": money(row["amount"]),
+        "memo": row["memo"],
+        "created_at": row["created_at"],
+        "direction": "out" if row["from_user_id"] == user_id else "in",
+    }
+
