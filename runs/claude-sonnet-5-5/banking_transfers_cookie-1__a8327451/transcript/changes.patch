+            "VALUES (?, ?, ?, ?)",
+            (username, pw_hash, START_BALANCE, iso(now())),
+        )
+    except sqlite3.IntegrityError:
+        return error("Username is already taken.", 409)
+    return jsonify({"username": username, "balance": money(START_BALANCE)}), 201
