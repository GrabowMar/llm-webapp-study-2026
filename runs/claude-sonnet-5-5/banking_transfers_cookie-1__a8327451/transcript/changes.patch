index fee9f48..c1acb24 100644
--- a/frontend/src/App.tsx
+++ b/frontend/src/App.tsx
@@ -1,3 +1,66 @@
+import { useCallback, useEffect, useState } from "react";
+import { Account, ApiError, api, getToken, setToken } from "./api";
+import AuthForm from "./AuthForm";
+import Dashboard from "./Dashboard";
+
 export default function App() {
-  return <h1>App</h1>;
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loading, setLoading] = useState(!!getToken());
+
+  const refresh = useCallback(async () => {
+    try {
+      setAccount(await api<Account>("GET", "/account"));
+    } catch (e) {
+      if (e instanceof ApiError && e.status === 401) {
+        setToken(null);
+        setAccount(null);
+      }
+    }
+  }, []);
+
+  useEffect(() => {
+    if (getToken()) refresh().finally(() => setLoading(false));
+  }, [refresh]);
+
+  const logout = async () => {
+    try {
+      await api("POST", "/auth/logout");
+    } catch {
+      /* ignore */
+    }
+    setToken(null);
+    setAccount(null);
+  };
+
+  if (loading) return <p className="p-8 text-center text-slate-500">Loading…</p>;
+
+  return (
+    <div className="min-h-screen bg-slate-100 text-slate-900">
+      <header className="bg-slate-900 text-white">
+        <div className="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
+          <span className="text-lg font-semibold">Bank</span>
+          {account && (
+            <div className="flex items-center gap-3 text-sm">
+              <span>
+                Signed in as <strong data-testid="username">{account.username}</strong>
+              </span>
+              <button
+                onClick={logout}
+                className="rounded bg-slate-700 px-3 py-1 hover:bg-slate-600"
+              >
+                Sign out
+              </button>
+            </div>
+          )}
+        </div>
+      </header>
+      <main className="mx-auto max-w-3xl px-4 py-6">
+        {account ? (
+          <Dashboard account={account} refresh={refresh} />
+        ) : (
+          <AuthForm onSignedIn={refresh} />
+        )}
+      </main>
+    </div>
+  );
 }
diff --git a/frontend/src/AuthForm.tsx b/frontend/src/AuthForm.tsx
new file mode 100644
index 0000000..6eb55c9
--- /dev/null
+++ b/frontend/src/AuthForm.tsx
@@ -0,0 +1,104 @@
+import { FormEvent, useState } from "react";
+import { ApiError, api, setToken } from "./api";
+
+const input =
+  "w-full rounded border border-slate-300 px-3 py-2 focus:border-blue-500 focus:outline-none";
+
+export default function AuthForm({ onSignedIn }: { onSignedIn: () => Promise<void> }) {
+  const [mode, setMode] = useState<"login" | "register">("login");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState("");
+  const [info, setInfo] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  const login = async () => {
+    const { token } = await api<{ token: string }>("POST", "/auth/login", {
+      username,
+      password,
+    });
+    setToken(token);
+    await onSignedIn();
+  };
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    setError("");
+    setInfo("");
+    setBusy(true);
+    try {
+      if (mode === "register") {
+        await api("POST", "/auth/register", { username, password });
+        setInfo("Account created.");
+      }
+      await login();
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : "Something went wrong.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <form
+      onSubmit={submit}
+      className="mx-auto max-w-sm space-y-4 rounded-lg bg-white p-6 shadow"
+    >
+      <h1 className="text-xl font-semibold">
+        {mode === "login" ? "Sign in" : "Create account"}
+      </h1>
+      <label className="block text-sm">
+        Username
+        <input
+          className={input}
+          name="username"
+          autoComplete="username"
+          value={username}
+          onChange={(e) => setUsername(e.target.value)}
+          required
+        />
+      </label>
+      <label className="block text-sm">
+        Password
+        <input
+          className={input}
+          name="password"
+          type="password"
+          autoComplete={mode === "login" ? "current-password" : "new-password"}
+          value={password}
+          onChange={(e) => setPassword(e.target.value)}
+          required
+          minLength={mode === "register" ? 8 : undefined}
+        />
+      </label>
+      {mode === "register" && (
+        <p className="text-xs text-slate-500">
+          Username: 3-32 letters, digits, ".", "_" or "-". Password: at least 8 characters.
+        </p>
+      )}
+      {error && (
+        <p role="alert" className="rounded bg-red-50 p-2 text-sm text-red-700">
+          {error}
+        </p>
+      )}
+      {info && <p className="rounded bg-green-50 p-2 text-sm text-green-700">{info}</p>}
+      <button
+        disabled={busy}
+        className="w-full rounded bg-blue-600 py-2 font-medium text-white hover:bg-blue-700 disabled:opacity-50"
+      >
+        {mode === "login" ? "Sign in" : "Register"}
+      </button>
+      <button
+        type="button"
+        onClick={() => {
+          setMode(mode === "login" ? "register" : "login");
+          setError("");
+          setInfo("");
+        }}
+        className="w-full text-sm text-blue-600 hover:underline"
+      >
+        {mode === "login" ? "No account? Register" : "Have an account? Sign in"}
+      </button>
+    </form>
+  );
+}
