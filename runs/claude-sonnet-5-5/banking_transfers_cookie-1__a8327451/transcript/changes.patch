+    ).fetchone()
+    if user is None:
+        check_password_hash(DUMMY_HASH, password[:128])
+        return error("Invalid username or password.", 401)
+    if not check_password_hash(user["password_hash"], password[:128]):
+        return error("Invalid username or password.", 401)
