{"type":"tool_use","timestamp":1794253905475,"sessionID":"ses_e3e23a60effeuJvluv3fQfDSPA","part":{"type":"tool","tool":"bash","callID":"toolu_01KfkDpGL7tsKkJ8SpFVVHK2","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Flask entry point: JSON API under /api and the frontend build.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom decimal import Decimal, InvalidOperation\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"bank.db\"\n\nSTART_BALANCE = 100000\nMAX_AMOUNT = 1_000_000_00\nTOKEN_TTL = timedelta(hours=12)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nMAX_MEMO = 200\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 16 * 1024\n\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    balance INTEGER NOT NULL DEFAULT 100000 CHECK (balance >= 0),\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id),\n    csrf_token TEXT NOT NULL,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS transfers (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    from_user_id INTEGER NOT NULL REFERENCES users(id),\n    to_user_id INTEGER NOT NULL REFERENCES users(id),\n    amount INTEGER NOT NULL CHECK (amount > 0),\n    memo TEXT NOT NULL DEFAULT '',\n    created_at TEXT NOT NULL,\n    CHECK (from_user_id <> to_user_id)\n);\nCREATE INDEX IF NOT EXISTS idx_transfers_from ON transfers(from_user_id, id);\nCREATE INDEX IF NOT EXISTS idx_transfers_to ON transfers(to_user_id, id);\n\"\"\"\n\n\ndef connect():\n    conn = sqlite3.connect(DB_PATH, timeout=15, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now():\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt):\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef error(message, status):\n    return jsonify({\"error\": message}), status\n\n\ndef money(cents):\n    return cents / 100\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        abort(400, \"Request body must be a JSON object.\")\n    return data\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc):\n    if request.path.startswith(\"/api/\"):\n        messages = {\n            404: \"Not found.\",\n            405: \"Method not allowed.\",\n            413: \"Request too large.\",\n        }\n        message = exc.description if exc.code == 400 else messages.get(exc.code, exc.name)\n        return error(message, exc.code)\n    return exc\n\n\n@app.after_request\ndef security_headers(resp):\n    resp.headers.setdefault(\"X-Content-Type-Options\", \"nosniff\")\n    resp.headers.setdefault(\"X-Frame-Options\", \"DENY\")\n    resp.headers.setdefault(\"Referrer-Policy\", \"no-referrer\")\n    if request.path.startswith(\"/api/\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef auth_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        scheme, _, token = header.partition(\" \")\n        token = token.strip()\n        if scheme.lower() != \"bearer\" or not token:\n            return error(\"Authentication required.\", 401)\n        row = db().execute(\n            \"SELECT s.token_hash, s.csrf_token, s.expires_at, u.id, u.username \"\n            \"FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?\",\n            (hash_token(token),),\n        ).fetchone()\n        if row is None:\n            return error(\"Authentication required.\", 401)\n        if row[\"expires_at\"] <= iso(now()):\n            db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (row[\"token_hash\"],))\n            return error(\"Authentication required.\", 401)\n        g.user_id = row[\"id\"]\n        g.username = row[\"username\"]\n        g.token_hash = row[\"token_hash\"]\n        g.csrf_token = row[\"csrf_token\"]\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not USERNAME_RE.match(username):\n        return error(\n            \"Username must be 3-32 characters: letters, digits, '.', '_' or '-'.\", 400\n        )\n    if not isinstance(password, str) or not 8 <= len(password) <= 128:\n        return error(\"Password must be 8-128 characters.\", 400)\n    pw_hash = generate_password_hash(password)\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, balance, created_at) \"\n            \"VALUES (?, ?, ?, ?)\",\n            (username, pw_hash, START_BALANCE, iso(now())),\n        )\n    except sqlite3.IntegrityError:\n        return error(\"Username is already taken.\", 409)\n    return jsonify({\"username\": username, \"balance\": money(START_BALANCE)}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required.\", 400)\n    user = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None:\n        check_password_hash(DUMMY_HASH, password[:128])\n        return error(\"Invalid username or password.\", 401)\n    if not check_password_hash(user[\"password_hash\"], password[:128]):\n        return error(\"Invalid username or password.\", 401)\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (iso(now()),))\n    conn.execute(\n        \"INSERT INTO sessions (token_hash, user_id, csrf_token, expires_at) \"\n        \"VALUES (?, ?, ?, ?)\",\n        (hash_token(token), user[\"id\"], secrets.token_urlsafe(32), iso(now() + TOKEN_TTL)),\n    )\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@auth_required\ndef logout():\n    db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/auth/csrf\")\n@auth_required\ndef csrf():\n    return jsonify({\"csrf_token\": g.csrf_token})\n\n\n@app.get(\"/api/account\")\n@auth_required\ndef account():\n    row = db().execute(\"SELECT balance FROM users WHERE id = ?\", (g.user_id,)).fetchone()\n    return jsonify({\"username\": g.username, \"balance\": money(row[\"balance\"])})\n\n\ndef parse_amount(value):\n    if isinstance(value, bool) or not isinstance(value, (int, float, str)):\n        return None\n    try:\n        d = Decimal(str(value).strip())\n    except InvalidOperation:\n        return None\n    if not d.is_finite():\n        return None\n    return d\n\n\ndef transfer_json(row, user_id):\n    return {\n        \"id\": row[\"id\"],\n        \"from_username\": row[\"from_username\"],\n        \"to_username\": row[\"to_username\"],\n        \"amount\": money(row[\"amount\"]),\n        \"memo\": row[\"memo\"],\n        \"created_at\": row[\"created_at\"],\n        \"direction\": \"out\" if row[\"from_user_id\"] == user_id else \"in\",\n    }\n\n\nTRANSFER_SELECT = (\n    \"SELECT t.id, t.from_user_id, t.to_user_id, t.amount, t.memo, t.created_at, \"\n    \"f.username AS from_username, r.username AS to_username \"\n    \"FROM transfers t JOIN users f ON f.id = t.from_user_id \"\n    \"JOIN users r ON r.id = t.to_user_id \"\n)\n\n\n@app.post(\"/api/transfers\")\n@auth_required\ndef create_transfer():\n    data = body()\n    supplied_csrf = request.headers.get(\"X-CSRF-Token\")\n    if supplied_csrf is not None and not hmac.compare_digest(supplied_csrf, g.csrf_token):\n        return error(\"Invalid anti-forgery token.\", 403)\n\n    to_username = data.get(\"to_username\")\n    if not isinstance(to_username, str) or not to_username.strip():\n        return error(\"Recipient is required.\", 400)\n    to_username = to_username.strip()\n\n    d = parse_amount(data.get(\"amount\"))\n    if d is None:\n        return error(\"Amount must be a number.\", 400)\n    if d <= 0:\n        return error(\"Amount must be greater than zero.\", 400)\n    if d != d.quantize(Decimal(\"0.01\")):\n        return error(\"Amount can have at most two decimal places.\", 400)\n    cents = int(d * 100)\n    if cents > MAX_AMOUNT:\n        return error(\"Amount is too large.\", 400)\n\n    memo = data.get(\"memo\")\n    if memo is None:\n        memo = \"\"\n    if not isinstance(memo, str):\n        return error(\"Memo must be text.\", 400)\n    memo = memo.strip()\n    if len(memo) > MAX_MEMO:\n        return error(f\"Memo can be at most {MAX_MEMO} characters.\", 400)\n\n    conn = db()\n    conn.execute(\"BEGIN IMMEDIATE\")\n    try:\n        recipient = conn.execute(\n            \"SELECT id, username FROM users WHERE username = ?\", (to_username,)\n        ).fetchone()\n        if recipient is None:\n            conn.execute(\"ROLLBACK\")\n            return error(\"Recipient not found.\", 404)\n        if recipient[\"id\"] == g.user_id:\n            conn.execute(\"ROLLBACK\")\n            return error(\"You cannot send money to yourself.\", 400)\n        debited = conn.execute(\n            \"UPDATE users SET balance = balance - ? WHERE id = ? AND balance >= ?\",\n            (cents, g.user_id, cents),\n        )\n        if debited.rowcount != 1:\n            conn.execute(\"ROLLBACK\")\n            return error(\"Insufficient balance.\", 400)\n        conn.execute(\n            \"UPDATE users SET balance = balance + ? WHERE id = ?\", (cents, recipient[\"id\"])\n        )\n        cur = conn.execute(\n            \"INSERT INTO transfers (from_user_id, to_user_id, amount, memo, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (g.user_id, recipient[\"id\"], cents, memo, iso(now())),\n        )\n        transfer_id = cur.lastrowid\n        conn.execute(\"COMMIT\")\n    except BaseException:\n        if conn.in_transaction:\n            conn.execute(\"ROLLBACK\")\n        raise\n    row = conn.execute(TRANSFER_SELECT + \"WHERE t.id = ?\", (transfer_id,)).fetchone()\n    return jsonify(transfer_json(row, g.user_id)), 201\n\n\ndef int_param(name, default, minimum=1):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    if not re.fullmatch(r\"\\d{1,9}\", raw) or int(raw) < minimum:\n        abort(400, f\"'{name}' must be an integer of at least {minimum}.\")\n    return int(raw)\n\n\n@app.get(\"/api/transfers\")\n@auth_required\ndef list_transfers():\n    page = int_param(\"page\", 1)\n    page_size = min(int_param(\"page_size\", 20), MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM transfers WHERE from_user_id = ? OR to_user_id = ?\",\n        (g.user_id, g.user_id),\n    ).fetchone()[0]\n    rows = conn.execute(\n        TRANSFER_SELECT\n        + \"WHERE t.from_user_id = ? OR t.to_user_id = ? \"\n        \"ORDER BY t.id DESC LIMIT ? OFFSET ?\",\n        (g.user_id, g.user_id, page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [transfer_json(r, g.user_id) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/transfers/<int:transfer_id>\")\n@auth_required\ndef get_transfer(transfer_id):\n    row = db().execute(\n        TRANSFER_SELECT\n        + \"WHERE t.id = ? AND (t.from_user_id = ? OR t.to_user_id = ?)\",\n        (transfer_id, g.user_id, g.user_id),\n    ).fetchone()\n    if row is None:\n        return error(\"Transfer not found.\", 404)\n    return jsonify(transfer_json(row, g.user_id))\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    target = (DIST / path).resolve()\n    if target.is_relative_to(DIST.resolve()) and target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\ncd frontend && npm i --no-audit --no-fund -E tailwindcss@4.3.5 @tailwindcss/vite@4.3.5 && npm i --no-audit --no-fund -E -D typescript@7.0.2 @types/react@19.3.0 @types/react-dom@19.3.0 2>&1 | tail -5"},"output":"\nadded 35 packages in 36s\n\nadded 5 packages in 4s\n","metadata":{"output":"\nadded 35 packages in 36s\n\nadded 5 packages in 4s\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Flask entry point: JSON API under /api and the frontend build.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom decimal import Decimal, InvalidOperation\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, abort, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"bank.db\"\n\nSTART_BALANCE = 100000\nMAX_AMOUNT = 1_000_000_00\nTOKEN_TTL = timedelta(hours=12)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nMAX_MEMO = 200\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 16 * 1024\n\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    balance INTEGER NOT NULL DEFAULT 100000 CHECK (balance >= 0),\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS sessions (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id),\n    csrf_token TEXT NOT NULL,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS transfers (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    from_user_id INTEGER NOT NULL REFERENCES users(id),\n    to_user_id INTEGER NOT NULL REFERENCES users(id),\n    amount INTEGER NOT NULL CHECK (amount > 0),\n    memo TEXT NOT NULL DEFAULT '',\n    created_at TEXT NOT NULL,\n    CHECK (from_user_id <> to_user_id)\n);\nCREATE INDEX IF NOT EXISTS idx_transfers_from ON transfers(from_user_id, id);\nCREATE INDEX IF NOT EXISTS idx_transfers_to ON transfers(to_user_id, id);\n\"\"\"\n\n\ndef connect():\n    conn = sqlite3.connect(DB_PATH, timeout=15, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now():\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt):\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef error(message, status):\n    return jsonify({\"error\": message}), status\n\n\ndef money(cents):\n    return cents / 100\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        abort(400, \"Request body must be a JSON object.\")\n    return data\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc):\n    if request.path.startswith(\"/api/\"):\n        messages = {\n            404: \"Not found.\",\n            405: \"Method not allowed.\",\n            413: \"Request too large.\",\n        }\n        message = exc.description if exc.code == 400 else messages.get(exc.code, exc.name)\n        return error(message, exc.code)\n    return exc\n\n\n@app.after_request\ndef security_headers(resp):\n    resp.headers.setdefault(\"X-Content-Type-Options\", \"nosniff\")\n    resp.headers.setdefault(\"X-Frame-Options\", \"DENY\")\n    resp.headers.setdefault(\"Referrer-Policy\", \"no-referrer\")\n    if request.path.startswith(\"/api/\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef auth_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        header = request.headers.get(\"Authorization\", \"\")\n        scheme, _, token = header.partition(\" \")\n        token = token.strip()\n        if scheme.lower() != \"bearer\" or not token:\n            return error(\"Authentication required.\", 401)\n        row = db().execute(\n            \"SELECT s.token_hash, s.csrf_token, s.expires_at, u.id, u.username \"\n            \"FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?\",\n            (hash_token(token),),\n        ).fetchone()\n        if row is None:\n            return error(\"Authentication required.\", 401)\n        if row[\"expires_at\"] <= iso(now()):\n            db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (row[\"token_hash\"],))\n            return error(\"Authentication required.\", 401)\n        g.user_id = row[\"id\"]\n        g.username = row[\"username\"]\n        g.token_hash = row[\"token_hash\"]\n        g.csrf_token = row[\"csrf_token\"]\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not USERNAME_RE.match(username):\n        return error(\n            \"Username must be 3-32 characters: letters, digits, '.', '_' or '-'.\", 400\n        )\n    if not isinstance(password, str) or not 8 <= len(password) <= 128:\n        return error(\"Password must be 8-128 characters.\", 400)\n    pw_hash = generate_password_hash(password)\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, balance, created_at) \"\n            \"VALUES (?, ?, ?, ?)\",\n            (username, pw_hash, START_BALANCE, iso(now())),\n        )\n    except sqlite3.IntegrityError:\n        return error(\"Username is already taken.\", 409)\n    return jsonify({\"username\": username, \"balance\": money(START_BALANCE)}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Username and password are required.\", 400)\n    user = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if user is None:\n        check_password_hash(DUMMY_HASH, password[:128])\n        return error(\"Invalid username or password.\", 401)\n    if not check_password_hash(user[\"password_hash\"], password[:128]):\n        return error(\"Invalid username or password.\", 401)\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM sessions WHERE expires_at <= ?\", (iso(now()),))\n    conn.execute(\n        \"INSERT INTO sessions (token_hash, user_id, csrf_token, expires_at) \"\n        \"VALUES (?, ?, ?, ?)\",\n        (hash_token(token), user[\"id\"], secrets.token_urlsafe(32), iso(now() + TOKEN_TTL)),\n    )\n    return jsonify({\"token\": token})\n\n\n@app.post(\"/api/auth/logout\")\n@auth_required\ndef logout():\n    db().execute(\"DELETE FROM sessions WHERE token_hash = ?\", (g.token_hash,))\n    return jsonify({\"status\": \"ok\"})\n\n\n@app.get(\"/api/auth/csrf\")\n@auth_required\ndef csrf():\n    return jsonify({\"csrf_token\": g.csrf_token})\n\n\n@app.get(\"/api/account\")\n@auth_required\ndef account():\n    row = db().execute(\"SELECT balance FROM users WHERE id = ?\", (g.user_id,)).fetchone()\n    return jsonify({\"username\": g.username, \"balance\": money(row[\"balance\"])})\n\n\ndef parse_amount(value):\n    if isinstance(value, bool) or not isinstance(value, (int, float, str)):\n        return None\n    try:\n        d = Decimal(str(value).strip())\n    except InvalidOperation:\n        return None\n    if not d.is_finite():\n        return None\n    return d\n\n\ndef transfer_json(row, user_id):\n    return {\n        \"id\": row[\"id\"],\n        \"from_username\": row[\"from_username\"],\n        \"to_username\": row[\"to_username\"],\n        \"amount\": money(row[\"amount\"]),\n        \"memo\": row[\"memo\"],\n        \"created_at\": row[\"created_at\"],\n        \"direction\": \"out\" if row[\"from_user_id\"] == user_id else \"in\",\n    }\n\n\nTRANSFER_SELECT = (\n    \"SELECT t.id, t.from_user_id, t.to_user_id, t.amount, t.memo, t.created_at, \"\n    \"f.username AS from_username, r.username AS to_username \"\n    \"FROM transfers t JOIN users f ON f.id = t.from_user_id \"\n    \"JOIN users r ON r.id = t.to_user_id \"\n)\n\n\n@app.post(\"/api/transfers\")\n@auth_required\ndef create_transfer():\n    data = body()\n    supplied_csrf = request.headers.get(\"X-CSRF-Token\")\n    if supplied_csrf is not None and not hmac.compare_digest(supplied_csrf, g.csrf_token):\n        return error(\"Invalid anti-forgery token.\", 403)\n\n    to_username = data.get(\"to_username\")\n    if not isinstance(to_username, str) or not to_username.strip():\n        return error(\"Recipient is required.\", 400)\n    to_username = to_username.strip()\n\n    d = parse_amount(data.get(\"amount\"))\n    if d is None:\n        return error(\"Amount must be a number.\", 400)\n    if d <= 0:\n        return error(\"Amount must be greater than zero.\", 400)\n    if d != d.quantize(Decimal(\"0.01\")):\n        return error(\"Amount can have at most two decimal places.\", 400)\n    cents = int(d * 100)\n    if cents > MAX_AMOUNT:\n        return error(\"Amount is too large.\", 400)\n\n    memo = data.get(\"memo\")\n    if memo is None:\n        memo = \"\"\n    if not isinstance(memo, str):\n        return error(\"Memo must be text.\", 400)\n    memo = memo.strip()\n    if len(memo) > MAX_MEMO:\n        return error(f\"Memo can be at most {MAX_MEMO} characters.\", 400)\n\n    conn = db()\n    conn.execute(\"BEGIN IMMEDIATE\")\n    try:\n        recipient = conn.execute(\n            \"SELECT id, username FROM users WHERE username = ?\", (to_username,)\n        ).fetchone()\n        if recipient is None:\n            conn.execute(\"ROLLBACK\")\n            return error(\"Recipient not found.\", 404)\n        if recipient[\"id\"] == g.user_id:\n            conn.execute(\"ROLLBACK\")\n            return error(\"You cannot send money to yourself.\", 400)\n        debited = conn.execute(\n            \"UPDATE users SET balance = balance - ? WHERE id = ? AND balance >= ?\",\n            (cents, g.user_id, cents),\n        )\n        if debited.rowcount != 1:\n            conn.execute(\"ROLLBACK\")\n            return error(\"Insufficient balance.\", 400)\n        conn.execute(\n            \"UPDATE users SET balance = balance + ? WHERE id = ?\", (cents, recipient[\"id\"])\n        )\n        cur = conn.execute(\n            \"INSERT INTO transfers (from_user_id, to_user_id, amount, memo, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (g.user_id, recipient[\"id\"], cents, memo, iso(now())),\n        )\n        transfer_id = cur.lastrowid\n        conn.execute(\"COMMIT\")\n    except BaseException:\n        if conn.in_transaction:\n            conn.execute(\"ROLLBACK\")\n        raise\n    row = conn.execute(TRANSFER_SELECT + \"WHERE t.id = ?\", (transfer_id,)).fetchone()\n    return jsonify(transfer_json(row, g.user_id)), 201\n\n\ndef int_param(name, default, minimum=1):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    if not re.fullmatch(r\"\\d{1,9}\", raw) or int(raw) < minimum:\n        abort(400, f\"'{name}' must be an integer of at least {minimum}.\")\n    return int(raw)\n\n\n@app.get(\"/api/transfers\")\n@auth_required\ndef list_transfers():\n    page = int_param(\"page\", 1)\n    page_size = min(int_param(\"page_size\", 20), MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM transfers WHERE from_user_id = ? OR to_user_id = ?\",\n        (g.user_id, g.user_id),\n    ).fetchone()[0]\n    rows = conn.execute(\n        TRANSFER_SELECT\n        + \"WHERE t.from_user_id = ? OR t.to_user_id = ? \"\n        \"ORDER BY t.id DESC LIMIT ? OFFSET ?\",\n        (g.user_id, g.user_id, page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [transfer_json(r, g.user_id) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/transfers/<int:transfer_id>\")\n@auth_required\ndef get_transfer(transfer_id):\n    row = db().execute(\n        TRANSFER_SELECT\n        + \"WHERE t.id = ? AND (t.from_user_id = ? OR t.to_user_id = ?)\",\n        (transfer_id, g.user_id, g.user_id),\n    ).fetchone()\n    if row is None:\n        return error(\"Transfer not found.\", 404)\n    return jsonify(transfer_json(row, g.user_id))\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(\"Not found.\", 404)\n    target = (DIST / path).resolve()\n    if target.is_relative_to(DIST.resolve()) and target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\ncd frontend && npm i --no-audit --no-fund -E tailwindcss@4.3.5 @tailwindcss/vite@4.3.5 && npm i --no-audit --no-fund -E -D typescript@7.0.2 @types/react@19.3.0 @types/react-dom@19.3.0 2>&1 | tail -5","time":{"start":1794253864335,"end":1794253905452}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1dd3d67001chXuA9PI1uEdaV","sessionID":"ses_e3e23a60effeuJvluv3fQfDSPA","messageID":"msg_1c1dc9b7b001SSGUh6ir3kM22q"}}
