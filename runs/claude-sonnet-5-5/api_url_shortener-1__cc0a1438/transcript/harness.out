{"type":"tool_use","timestamp":1794256003588,"sessionID":"ses_e3e043f3bffePqMA3HpHvx6uR5","part":{"type":"tool","tool":"bash","callID":"toolu_01AXyB2o54AoyZHLA6ZWdCtp","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: {\n    proxy: {\n      \"/api\": \"http://localhost:8000\",\n      \"/r\": \"http://localhost:8000\",\n    },\n  },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's|\"build\": \"vite build\"|\"build\": \"tsc --noEmit \\&\\& vite build\"|' package.json\nsed -i 's|<title>App</title>|<title>Shortener</title>|' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport interface Link {\n  id: number;\n  original_url: string;\n  short_code: string;\n  click_count: number;\n  created_at: string;\n  short_url: string;\n  owner: string;\n  active?: boolean;\n}\n\nexport interface Page {\n  items: Link[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport async function api<T>(\n  path: string,\n  options: { method?: string; body?: unknown; token?: string | null } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.token) headers[\"Authorization\"] = `Bearer ${options.token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n    });\n  } catch {\n    throw new ApiError(\"Network error, please try again\", 0);\n  }\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const msg =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(msg, res.status);\n  }\n  return data as T;\n}\n\nexport function fullShortUrl(link: Link): string {\n  return `${window.location.origin}${link.short_url}`;\n}\n\nexport function parseUsername(token: string | null): string | null {\n  return token;\n}\nEOF\nsed -i '/parseUsername/,$d' src/api.ts\ncat > src/App.tsx <<'EOF'\nimport { FormEvent, useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, fullShortUrl, Link, Page } from \"./api\";\n\ninterface Session {\n  token: string;\n  username: string;\n}\n\nconst STORAGE_KEY = \"shortener-session\";\n\nfunction loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    const s = JSON.parse(raw);\n    if (typeof s?.token === \"string\" && typeof s?.username === \"string\") return s;\n  } catch {\n    /* ignore */\n  }\n  return null;\n}\n\nconst inputCls =\n  \"w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nconst btnCls =\n  \"rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\nconst btnGhostCls =\n  \"rounded border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100 disabled:opacity-50\";\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n\n  const signOut = useCallback(() => {\n    localStorage.removeItem(STORAGE_KEY);\n    setSession(null);\n  }, []);\n\n  const signIn = (s: Session) => {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(s));\n    setSession(s);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-4xl items-center justify-between px-4 py-3\">\n          <h1 className=\"text-lg font-semibold\">URL Shortener</h1>\n          {session && (\n            <div className=\"flex items-center gap-3 text-sm\">\n              <span data-testid=\"username\">{session.username}</span>\n              <button className={btnGhostCls} onClick={signOut}>\n                Sign out\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-4xl space-y-8 px-4 py-6\">\n        {session ? (\n          <Dashboard session={session} onExpired={signOut} />\n        ) : (\n          <AuthForms onSignedIn={signIn} />\n        )}\n      </main>\n    </div>\n  );\n}\n\nfunction AuthForms({ onSignedIn }: { onSignedIn: (s: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setNotice(null);\n    setBusy(true);\n    try {\n      const name = username.trim();\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username: name, password } });\n        setNotice(\"Account created. You can sign in now.\");\n        setMode(\"login\");\n        setPassword(\"\");\n      } else {\n        const res = await api<{ token: string }>(\"/auth/login\", {\n          method: \"POST\",\n          body: { username: name, password },\n        });\n        onSignedIn({ token: res.token, username: name });\n      }\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  return (\n    <section className=\"mx-auto max-w-sm rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <div className=\"mb-4 flex gap-2\">\n        {([\"login\", \"register\"] as const).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            onClick={() => {\n              setMode(m);\n              setError(null);\n              setNotice(null);\n            }}\n            className={`flex-1 rounded px-3 py-1.5 text-sm font-medium ${\n              mode === m ? \"bg-indigo-600 text-white\" : \"bg-slate-100 text-slate-700\"\n            }`}\n          >\n            {m === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        ))}\n      </div>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <label className=\"block text-sm\">\n          Username\n          <input\n            className={inputCls}\n            name=\"username\"\n            autoComplete=\"username\"\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            required\n          />\n        </label>\n        <label className=\"block text-sm\">\n          Password\n          <input\n            className={inputCls}\n            name=\"password\"\n            type=\"password\"\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            required\n          />\n        </label>\n        {error && (\n          <p role=\"alert\" className=\"text-sm text-red-600\">\n            {error}\n          </p>\n        )}\n        {notice && <p className=\"text-sm text-green-700\">{notice}</p>}\n        <button className={`${btnCls} w-full`} disabled={busy}>\n          {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n        </button>\n      </form>\n    </section>\n  );\n}\n\nfunction Dashboard({ session, onExpired }: { session: Session; onExpired: () => void }) {\n  const isAdmin = session.username.toLowerCase() === \"admin\";\n  const [tab, setTab] = useState<\"links\" | \"admin\">(\"links\");\n  const [refresh, setRefresh] = useState(0);\n  const bump = () => setRefresh((n) => n + 1);\n\n  return (\n    <>\n      <ShortenForm session={session} onExpired={onExpired} onCreated={bump} />\n      {isAdmin && (\n        <div className=\"flex gap-2\">\n          {([\"links\", \"admin\"] as const).map((t) => (\n            <button\n              key={t}\n              onClick={() => setTab(t)}\n              className={`rounded px-3 py-1.5 text-sm font-medium ${\n                tab === t ? \"bg-indigo-600 text-white\" : \"bg-slate-200 text-slate-700\"\n              }`}\n            >\n              {t === \"links\" ? \"Recent links\" : \"Moderation\"}\n            </button>\n          ))}\n        </div>\n      )}\n      {tab === \"admin\" && isAdmin ? (\n        <LinkTable key=\"admin\" session={session} onExpired={onExpired} admin refresh={refresh} onChanged={bump} />\n      ) : (\n        <LinkTable key=\"links\" session={session} onExpired={onExpired} refresh={refresh} onChanged={bump} />\n      )}\n    </>\n  );\n}\n\nfunction ShortenForm({\n  session,\n  onExpired,\n  onCreated,\n}: {\n  session: Session;\n  onExpired: () => void;\n  onCreated: () => void;\n}) {\n  const [url, setUrl] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [result, setResult] = useState<string | null>(null);\n  const [copied, setCopied] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setResult(null);\n    setCopied(false);\n    setBusy(true);\n    try {\n      const link = await api<Link>(\"/links\", {\n        method: \"POST\",\n        body: { original_url: url.trim() },\n        token: session.token,\n      });\n      setResult(fullShortUrl(link));\n      setUrl(\"\");\n      onCreated();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const copy = async () => {\n    if (!result) return;\n    try {\n      await navigator.clipboard.writeText(result);\n    } catch {\n      const ta = document.createElement(\"textarea\");\n      ta.value = result;\n      document.body.appendChild(ta);\n      ta.select();\n      document.execCommand(\"copy\");\n      ta.remove();\n    }\n    setCopied(true);\n  };\n\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-base font-semibold\">Shorten an address</h2>\n      <form onSubmit={submit} className=\"flex gap-2\">\n        <input\n          className={inputCls}\n          name=\"url\"\n          placeholder=\"https://example.com/a/very/long/address\"\n          value={url}\n          onChange={(e) => setUrl(e.target.value)}\n          required\n        />\n        <button className={btnCls} disabled={busy}>\n          Shorten\n        </button>\n      </form>\n      {error && (\n        <p role=\"alert\" className=\"mt-3 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      {result && (\n        <div className=\"mt-3 flex items-center gap-2 text-sm\">\n          <a\n            href={result}\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            data-testid=\"short-result\"\n            className=\"break-all font-medium text-indigo-700 underline\"\n          >\n            {result}\n          </a>\n          <button className={btnGhostCls} onClick={copy}>\n            {copied ? \"Copied\" : \"Copy\"}\n          </button>\n        </div>\n      )}\n    </section>\n  );\n}\n\nfunction LinkTable({\n  session,\n  onExpired,\n  admin = false,\n  refresh,\n  onChanged,\n}: {\n  session: Session;\n  onExpired: () => void;\n  admin?: boolean;\n  refresh: number;\n  onChanged: () => void;\n}) {\n  const pageSize = 10;\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [busyId, setBusyId] = useState<number | null>(null);\n\n  const load = useCallback(async () => {\n    try {\n      const res = await api<Page>(\n        `${admin ? \"/admin\" : \"\"}/links?page=${page}&page_size=${pageSize}`,\n        { token: admin ? session.token : null },\n      );\n      const lastPage = Math.max(1, Math.ceil(res.total / pageSize));\n      if (page > lastPage) {\n        setPage(lastPage);\n        return;\n      }\n      setData(res);\n      setError(null);\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Could not load links\");\n    }\n  }, [admin, page, session.token, onExpired]);\n\n  useEffect(() => {\n    load();\n  }, [load, refresh]);\n\n  const remove = async (link: Link) => {\n    if (!window.confirm(`Delete ${fullShortUrl(link)}? This cannot be undone.`)) return;\n    setBusyId(link.id);\n    try {\n      await api(`/links/${link.id}`, { method: \"DELETE\", token: session.token });\n      onChanged();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Could not delete link\");\n    } finally {\n      setBusyId(null);\n    }\n  };\n\n  const toggle = async (link: Link) => {\n    setBusyId(link.id);\n    try {\n      await api(`/admin/links/${link.id}/toggle`, { method: \"POST\", token: session.token });\n      onChanged();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Could not update link\");\n    } finally {\n      setBusyId(null);\n    }\n  };\n\n  const lastPage = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-base font-semibold\">{admin ? \"All links\" : \"Recent links\"}</h2>\n      {error && (\n        <p role=\"alert\" className=\"mb-3 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      {data && data.items.length === 0 && <p className=\"text-sm text-slate-500\">No links yet.</p>}\n      {data && data.items.length > 0 && (\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 text-xs uppercase text-slate-500\">\n              <tr>\n                <th className=\"py-2 pr-3\">Short address</th>\n                <th className=\"py-2 pr-3\">Original</th>\n                {admin && <th className=\"py-2 pr-3\">Owner</th>}\n                <th className=\"py-2 pr-3\">Clicks</th>\n                <th className=\"py-2 pr-3\">Created</th>\n                <th className=\"py-2\" />\n              </tr>\n            </thead>\n            <tbody>\n              {data.items.map((link) => (\n                <tr key={link.id} className=\"border-b border-slate-100 align-top\">\n                  <td className=\"py-2 pr-3\">\n                    <a\n                      className=\"break-all text-indigo-700 underline\"\n                      href={link.short_url}\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                    >\n                      {fullShortUrl(link)}\n                    </a>\n                    {admin && link.active === false && (\n                      <span className=\"ml-2 rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-700\">\n                        disabled\n                      </span>\n                    )}\n                  </td>\n                  <td className=\"max-w-[16rem] py-2 pr-3\">\n                    <span className=\"block truncate\" title={link.original_url}>\n                      {link.original_url}\n                    </span>\n                  </td>\n                  {admin && <td className=\"py-2 pr-3\">{link.owner}</td>}\n                  <td className=\"py-2 pr-3\">{link.click_count}</td>\n                  <td className=\"whitespace-nowrap py-2 pr-3\">\n                    {new Date(link.created_at).toLocaleString()}\n                  </td>\n                  <td className=\"whitespace-nowrap py-2 text-right\">\n                    {admin && (\n                      <button\n                        className={btnGhostCls}\n                        disabled={busyId === link.id}\n                        onClick={() => toggle(link)}\n                      >\n                        {link.active === false ? \"Enable\" : \"Disable\"}\n                      </button>\n                    )}\n                    {!admin && link.owner === session.username && (\n                      <button\n                        className=\"rounded border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50 disabled:opacity-50\"\n                        disabled={busyId === link.id}\n                        onClick={() => remove(link)}\n                      >\n                        Delete\n                      </button>\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n      {data && (\n        <div className=\"mt-4 flex items-center justify-between text-sm\">\n          <button className={btnGhostCls} disabled={page <= 1} onClick={() => setPage(page - 1)}>\n            Previous\n          </button>\n          <span>\n            Page {data.page} of {lastPage} ({data.total} links)\n          </span>\n          <button className={btnGhostCls} disabled={page >= lastPage} onClick={() => setPage(page + 1)}>\n            Next\n          </button>\n        </div>\n      )}\n    </section>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20"},"output":"\n> build\n> tsc --noEmit && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 17 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-B9-81nJY.css   11.62 kB │ gzip:  3.18 kB\ndist/assets/index-B1pvYwmP.js   229.21 kB │ gzip: 71.41 kB\n\n✓ built in 419ms\n","metadata":{"output":"\n> build\n> tsc --noEmit && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 17 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-B9-81nJY.css   11.62 kB │ gzip:  3.18 kB\ndist/assets/index-B1pvYwmP.js   229.21 kB │ gzip: 71.41 kB\n\n✓ built in 419ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: {\n    proxy: {\n      \"/api\": \"http://localhost:8000\",\n      \"/r\": \"http://localhost:8000\",\n    },\n  },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's|\"build\": \"vite build\"|\"build\": \"tsc --noEmit \\&\\& vite build\"|' package.json\nsed -i 's|<title>App</title>|<title>Shortener</title>|' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport interface Link {\n  id: number;\n  original_url: string;\n  short_code: string;\n  click_count: number;\n  created_at: string;\n  short_url: string;\n  owner: string;\n  active?: boolean;\n}\n\nexport interface Page {\n  items: Link[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(message: string, status: number) {\n    super(message);\n    this.status = status;\n  }\n}\n\nexport async function api<T>(\n  path: string,\n  options: { method?: string; body?: unknown; token?: string | null } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (options.token) headers[\"Authorization\"] = `Bearer ${options.token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n    });\n  } catch {\n    throw new ApiError(\"Network error, please try again\", 0);\n  }\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const msg =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(msg, res.status);\n  }\n  return data as T;\n}\n\nexport function fullShortUrl(link: Link): string {\n  return `${window.location.origin}${link.short_url}`;\n}\n\nexport function parseUsername(token: string | null): string | null {\n  return token;\n}\nEOF\nsed -i '/parseUsername/,$d' src/api.ts\ncat > src/App.tsx <<'EOF'\nimport { FormEvent, useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, fullShortUrl, Link, Page } from \"./api\";\n\ninterface Session {\n  token: string;\n  username: string;\n}\n\nconst STORAGE_KEY = \"shortener-session\";\n\nfunction loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    const s = JSON.parse(raw);\n    if (typeof s?.token === \"string\" && typeof s?.username === \"string\") return s;\n  } catch {\n    /* ignore */\n  }\n  return null;\n}\n\nconst inputCls =\n  \"w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nconst btnCls =\n  \"rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\nconst btnGhostCls =\n  \"rounded border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100 disabled:opacity-50\";\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n\n  const signOut = useCallback(() => {\n    localStorage.removeItem(STORAGE_KEY);\n    setSession(null);\n  }, []);\n\n  const signIn = (s: Session) => {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(s));\n    setSession(s);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-4xl items-center justify-between px-4 py-3\">\n          <h1 className=\"text-lg font-semibold\">URL Shortener</h1>\n          {session && (\n            <div className=\"flex items-center gap-3 text-sm\">\n              <span data-testid=\"username\">{session.username}</span>\n              <button className={btnGhostCls} onClick={signOut}>\n                Sign out\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-4xl space-y-8 px-4 py-6\">\n        {session ? (\n          <Dashboard session={session} onExpired={signOut} />\n        ) : (\n          <AuthForms onSignedIn={signIn} />\n        )}\n      </main>\n    </div>\n  );\n}\n\nfunction AuthForms({ onSignedIn }: { onSignedIn: (s: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setNotice(null);\n    setBusy(true);\n    try {\n      const name = username.trim();\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username: name, password } });\n        setNotice(\"Account created. You can sign in now.\");\n        setMode(\"login\");\n        setPassword(\"\");\n      } else {\n        const res = await api<{ token: string }>(\"/auth/login\", {\n          method: \"POST\",\n          body: { username: name, password },\n        });\n        onSignedIn({ token: res.token, username: name });\n      }\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  return (\n    <section className=\"mx-auto max-w-sm rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <div className=\"mb-4 flex gap-2\">\n        {([\"login\", \"register\"] as const).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            onClick={() => {\n              setMode(m);\n              setError(null);\n              setNotice(null);\n            }}\n            className={`flex-1 rounded px-3 py-1.5 text-sm font-medium ${\n              mode === m ? \"bg-indigo-600 text-white\" : \"bg-slate-100 text-slate-700\"\n            }`}\n          >\n            {m === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        ))}\n      </div>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <label className=\"block text-sm\">\n          Username\n          <input\n            className={inputCls}\n            name=\"username\"\n            autoComplete=\"username\"\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            required\n          />\n        </label>\n        <label className=\"block text-sm\">\n          Password\n          <input\n            className={inputCls}\n            name=\"password\"\n            type=\"password\"\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            required\n          />\n        </label>\n        {error && (\n          <p role=\"alert\" className=\"text-sm text-red-600\">\n            {error}\n          </p>\n        )}\n        {notice && <p className=\"text-sm text-green-700\">{notice}</p>}\n        <button className={`${btnCls} w-full`} disabled={busy}>\n          {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n        </button>\n      </form>\n    </section>\n  );\n}\n\nfunction Dashboard({ session, onExpired }: { session: Session; onExpired: () => void }) {\n  const isAdmin = session.username.toLowerCase() === \"admin\";\n  const [tab, setTab] = useState<\"links\" | \"admin\">(\"links\");\n  const [refresh, setRefresh] = useState(0);\n  const bump = () => setRefresh((n) => n + 1);\n\n  return (\n    <>\n      <ShortenForm session={session} onExpired={onExpired} onCreated={bump} />\n      {isAdmin && (\n        <div className=\"flex gap-2\">\n          {([\"links\", \"admin\"] as const).map((t) => (\n            <button\n              key={t}\n              onClick={() => setTab(t)}\n              className={`rounded px-3 py-1.5 text-sm font-medium ${\n                tab === t ? \"bg-indigo-600 text-white\" : \"bg-slate-200 text-slate-700\"\n              }`}\n            >\n              {t === \"links\" ? \"Recent links\" : \"Moderation\"}\n            </button>\n          ))}\n        </div>\n      )}\n      {tab === \"admin\" && isAdmin ? (\n        <LinkTable key=\"admin\" session={session} onExpired={onExpired} admin refresh={refresh} onChanged={bump} />\n      ) : (\n        <LinkTable key=\"links\" session={session} onExpired={onExpired} refresh={refresh} onChanged={bump} />\n      )}\n    </>\n  );\n}\n\nfunction ShortenForm({\n  session,\n  onExpired,\n  onCreated,\n}: {\n  session: Session;\n  onExpired: () => void;\n  onCreated: () => void;\n}) {\n  const [url, setUrl] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [result, setResult] = useState<string | null>(null);\n  const [copied, setCopied] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setResult(null);\n    setCopied(false);\n    setBusy(true);\n    try {\n      const link = await api<Link>(\"/links\", {\n        method: \"POST\",\n        body: { original_url: url.trim() },\n        token: session.token,\n      });\n      setResult(fullShortUrl(link));\n      setUrl(\"\");\n      onCreated();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const copy = async () => {\n    if (!result) return;\n    try {\n      await navigator.clipboard.writeText(result);\n    } catch {\n      const ta = document.createElement(\"textarea\");\n      ta.value = result;\n      document.body.appendChild(ta);\n      ta.select();\n      document.execCommand(\"copy\");\n      ta.remove();\n    }\n    setCopied(true);\n  };\n\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-base font-semibold\">Shorten an address</h2>\n      <form onSubmit={submit} className=\"flex gap-2\">\n        <input\n          className={inputCls}\n          name=\"url\"\n          placeholder=\"https://example.com/a/very/long/address\"\n          value={url}\n          onChange={(e) => setUrl(e.target.value)}\n          required\n        />\n        <button className={btnCls} disabled={busy}>\n          Shorten\n        </button>\n      </form>\n      {error && (\n        <p role=\"alert\" className=\"mt-3 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      {result && (\n        <div className=\"mt-3 flex items-center gap-2 text-sm\">\n          <a\n            href={result}\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            data-testid=\"short-result\"\n            className=\"break-all font-medium text-indigo-700 underline\"\n          >\n            {result}\n          </a>\n          <button className={btnGhostCls} onClick={copy}>\n            {copied ? \"Copied\" : \"Copy\"}\n          </button>\n        </div>\n      )}\n    </section>\n  );\n}\n\nfunction LinkTable({\n  session,\n  onExpired,\n  admin = false,\n  refresh,\n  onChanged,\n}: {\n  session: Session;\n  onExpired: () => void;\n  admin?: boolean;\n  refresh: number;\n  onChanged: () => void;\n}) {\n  const pageSize = 10;\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [busyId, setBusyId] = useState<number | null>(null);\n\n  const load = useCallback(async () => {\n    try {\n      const res = await api<Page>(\n        `${admin ? \"/admin\" : \"\"}/links?page=${page}&page_size=${pageSize}`,\n        { token: admin ? session.token : null },\n      );\n      const lastPage = Math.max(1, Math.ceil(res.total / pageSize));\n      if (page > lastPage) {\n        setPage(lastPage);\n        return;\n      }\n      setData(res);\n      setError(null);\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Could not load links\");\n    }\n  }, [admin, page, session.token, onExpired]);\n\n  useEffect(() => {\n    load();\n  }, [load, refresh]);\n\n  const remove = async (link: Link) => {\n    if (!window.confirm(`Delete ${fullShortUrl(link)}? This cannot be undone.`)) return;\n    setBusyId(link.id);\n    try {\n      await api(`/links/${link.id}`, { method: \"DELETE\", token: session.token });\n      onChanged();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Could not delete link\");\n    } finally {\n      setBusyId(null);\n    }\n  };\n\n  const toggle = async (link: Link) => {\n    setBusyId(link.id);\n    try {\n      await api(`/admin/links/${link.id}/toggle`, { method: \"POST\", token: session.token });\n      onChanged();\n    } catch (err) {\n      if (err instanceof ApiError && err.status === 401) return onExpired();\n      setError(err instanceof ApiError ? err.message : \"Could not update link\");\n    } finally {\n      setBusyId(null);\n    }\n  };\n\n  const lastPage = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-6 shadow-sm\">\n      <h2 className=\"mb-3 text-base font-semibold\">{admin ? \"All links\" : \"Recent links\"}</h2>\n      {error && (\n        <p role=\"alert\" className=\"mb-3 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      {data && data.items.length === 0 && <p className=\"text-sm text-slate-500\">No links yet.</p>}\n      {data && data.items.length > 0 && (\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 text-xs uppercase text-slate-500\">\n              <tr>\n                <th className=\"py-2 pr-3\">Short address</th>\n                <th className=\"py-2 pr-3\">Original</th>\n                {admin && <th className=\"py-2 pr-3\">Owner</th>}\n                <th className=\"py-2 pr-3\">Clicks</th>\n                <th className=\"py-2 pr-3\">Created</th>\n                <th className=\"py-2\" />\n              </tr>\n            </thead>\n            <tbody>\n              {data.items.map((link) => (\n                <tr key={link.id} className=\"border-b border-slate-100 align-top\">\n                  <td className=\"py-2 pr-3\">\n                    <a\n                      className=\"break-all text-indigo-700 underline\"\n                      href={link.short_url}\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                    >\n                      {fullShortUrl(link)}\n                    </a>\n                    {admin && link.active === false && (\n                      <span className=\"ml-2 rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-700\">\n                        disabled\n                      </span>\n                    )}\n                  </td>\n                  <td className=\"max-w-[16rem] py-2 pr-3\">\n                    <span className=\"block truncate\" title={link.original_url}>\n                      {link.original_url}\n                    </span>\n                  </td>\n                  {admin && <td className=\"py-2 pr-3\">{link.owner}</td>}\n                  <td className=\"py-2 pr-3\">{link.click_count}</td>\n                  <td className=\"whitespace-nowrap py-2 pr-3\">\n                    {new Date(link.created_at).toLocaleString()}\n                  </td>\n                  <td className=\"whitespace-nowrap py-2 text-right\">\n                    {admin && (\n                      <button\n                        className={btnGhostCls}\n                        disabled={busyId === link.id}\n                        onClick={() => toggle(link)}\n                      >\n                        {link.active === false ? \"Enable\" : \"Disable\"}\n                      </button>\n                    )}\n                    {!admin && link.owner === session.username && (\n                      <button\n                        className=\"rounded border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50 disabled:opacity-50\"\n                        disabled={busyId === link.id}\n                        onClick={() => remove(link)}\n                      >\n                        Delete\n                      </button>\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n      {data && (\n        <div className=\"mt-4 flex items-center justify-between text-sm\">\n          <button className={btnGhostCls} disabled={page <= 1} onClick={() => setPage(page - 1)}>\n            Previous\n          </button>\n          <span>\n            Page {data.page} of {lastPage} ({data.total} links)\n          </span>\n          <button className={btnGhostCls} disabled={page >= lastPage} onClick={() => setPage(page + 1)}>\n            Next\n          </button>\n        </div>\n      )}\n    </section>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20","time":{"start":1794256002021,"end":1794256003561}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1fddbda0017OoPfSgpr6xj6K","sessionID":"ses_e3e043f3bffePqMA3HpHvx6uR5","messageID":"msg_1c1fd5c3e001xbKqLDrQ2MN1wG"}}
