{"type":"tool_use","timestamp":1794251547682,"sessionID":"ses_e3e4791f8ffe0r0F2fg7hWWyEF","part":{"type":"tool","tool":"bash","callID":"toolu_01Rys2oUsq9eYMQw2Gqf3aM1","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Book library: Flask API and frontend host.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom decimal import ROUND_HALF_UP, Decimal\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"library.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS books (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    author TEXT NOT NULL,\n    year INTEGER,\n    isbn TEXT,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS reviews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    rating INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),\n    comment TEXT NOT NULL DEFAULT '',\n    created_at TEXT NOT NULL,\n    UNIQUE (book_id, user_id)\n);\nCREATE INDEX IF NOT EXISTS idx_reviews_book ON reviews(book_id);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt: datetime) -> str:\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str, errors: dict | None = None):\n        self.status = status\n        self.message = message\n        self.errors = errors\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err: ApiError):\n    body: dict = {\"error\": err.message}\n    if err.errors:\n        body[\"errors\"] = err.errors\n    return jsonify(body), err.status\n\n\n@app.errorhandler(404)\ndef handle_404(_err):\n    return jsonify({\"error\": \"Not found\"}), 404\n\n\n@app.errorhandler(405)\ndef handle_405(_err):\n    return jsonify({\"error\": \"Method not allowed\"}), 405\n\n\n@app.errorhandler(500)\ndef handle_500(_err):\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\ndef body_object() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user() -> sqlite3.Row:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        raise ApiError(401, \"Authentication required\")\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(parts[1].strip()),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < iso(now()):\n        raise ApiError(401, \"Authentication required\")\n    return row\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body_object()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    else:\n        username = username.strip()\n        if len(username) < 3 or len(username) > 50:\n            errors[\"username\"] = \"Username must be 3 to 50 characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 8:\n        errors[\"password\"] = \"Password must be at least 8 characters\"\n    elif len(password) > 200:\n        errors[\"password\"] = \"Password must be at most 200 characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), iso(now())),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(\n            409, \"Username is already taken\", {\"username\": \"Username is already taken\"}\n        )\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body_object()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"Username and password are required\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (iso(now()),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), row[\"id\"], iso(now() + TOKEN_TTL)),\n    )\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\nBOOK_SELECT = \"\"\"\nSELECT b.id, b.title, b.author, b.year, b.isbn, b.created_at,\n       COUNT(r.id) AS review_count, COALESCE(SUM(r.rating), 0) AS rating_sum\nFROM books b LEFT JOIN reviews r ON r.book_id = b.id\n\"\"\"\n\n\ndef book_json(row: sqlite3.Row) -> dict:\n    count = row[\"review_count\"]\n    average = None\n    if count:\n        average = float(\n            (Decimal(row[\"rating_sum\"]) / Decimal(count)).quantize(\n                Decimal(\"0.1\"), rounding=ROUND_HALF_UP\n            )\n        )\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"author\": row[\"author\"],\n        \"year\": row[\"year\"],\n        \"isbn\": row[\"isbn\"],\n        \"created_at\": row[\"created_at\"],\n        \"review_count\": count,\n        \"average_rating\": average,\n    }\n\n\ndef fetch_book(book_id: int) -> sqlite3.Row:\n    row = db().execute(BOOK_SELECT + \" WHERE b.id = ? GROUP BY b.id\", (book_id,)).fetchone()\n    if row is None or row[\"id\"] is None:\n        raise ApiError(404, \"Book not found\")\n    return row\n\n\nISBN_RE = re.compile(r\"^(?:\\d{9}[\\dXx]|\\d{13})$\")\n\n\ndef validate_book(data: dict) -> dict:\n    errors = {}\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n    else:\n        title = title.strip()\n        if len(title) > 200:\n            errors[\"title\"] = \"Title must be at most 200 characters\"\n    author = data.get(\"author\")\n    if not isinstance(author, str) or not author.strip():\n        errors[\"author\"] = \"Author is required\"\n    else:\n        author = author.strip()\n        if len(author) > 200:\n            errors[\"author\"] = \"Author must be at most 200 characters\"\n    year = data.get(\"year\")\n    if year is not None:\n        if isinstance(year, bool) or not isinstance(year, int):\n            errors[\"year\"] = \"Year must be a whole number\"\n        elif year < 1 or year > 9999:\n            errors[\"year\"] = \"Year must be between 1 and 9999\"\n    isbn = data.get(\"isbn\")\n    if isbn is not None:\n        if not isinstance(isbn, str):\n            errors[\"isbn\"] = \"ISBN must be a string\"\n        else:\n            isbn = isbn.strip()\n            if not isbn:\n                isbn = None\n            elif not ISBN_RE.match(re.sub(r\"[-\\s]\", \"\", isbn)):\n                errors[\"isbn\"] = \"ISBN must have 10 or 13 digits\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return {\"title\": title, \"author\": author, \"year\": year, \"isbn\": isbn}\n\n\ndef int_param(name: str, default: int) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if value < 1:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    return value\n\n\n@app.get(\"/api/books\")\ndef list_books():\n    page = int_param(\"page\", 1)\n    page_size = min(int_param(\"page_size\", DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE)\n    q = (request.args.get(\"q\") or \"\").strip()\n    where = \"\"\n    params: list = []\n    if q:\n        escaped = q.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        where = \" WHERE (b.title LIKE ? ESCAPE '\\\\' OR b.author LIKE ? ESCAPE '\\\\')\"\n        params = [f\"%{escaped}%\"] * 2\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM books b{where}\", params).fetchone()[0]\n    rows = conn.execute(\n        BOOK_SELECT + where + \" GROUP BY b.id ORDER BY b.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [book_json(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/books\")\ndef create_book():\n    current_user()\n    fields = validate_book(body_object())\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO books (title, author, year, isbn, created_at) VALUES (?, ?, ?, ?, ?)\",\n        (fields[\"title\"], fields[\"author\"], fields[\"year\"], fields[\"isbn\"], iso(now())),\n    )\n    conn.commit()\n    return jsonify(book_json(fetch_book(cur.lastrowid))), 201\n\n\n@app.get(\"/api/books/<int:book_id>\")\ndef get_book(book_id: int):\n    return jsonify(book_json(fetch_book(book_id)))\n\n\n@app.put(\"/api/books/<int:book_id>\")\ndef update_book(book_id: int):\n    current_user()\n    fetch_book(book_id)\n    fields = validate_book(body_object())\n    conn = db()\n    conn.execute(\n        \"UPDATE books SET title = ?, author = ?, year = ?, isbn = ? WHERE id = ?\",\n        (fields[\"title\"], fields[\"author\"], fields[\"year\"], fields[\"isbn\"], book_id),\n    )\n    conn.commit()\n    return jsonify(book_json(fetch_book(book_id)))\n\n\n@app.delete(\"/api/books/<int:book_id>\")\ndef delete_book(book_id: int):\n    current_user()\n    fetch_book(book_id)\n    conn = db()\n    conn.execute(\"DELETE FROM books WHERE id = ?\", (book_id,))\n    conn.commit()\n    return \"\", 204\n\n\ndef review_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"book_id\": row[\"book_id\"],\n        \"rating\": row[\"rating\"],\n        \"comment\": row[\"comment\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": row[\"username\"],\n    }\n\n\nREVIEW_SELECT = \"\"\"\nSELECT r.id, r.book_id, r.rating, r.comment, r.created_at, u.username\nFROM reviews r JOIN users u ON u.id = r.user_id\n\"\"\"\n\n\n@app.get(\"/api/books/<int:book_id>/reviews\")\ndef list_reviews(book_id: int):\n    fetch_book(book_id)\n    rows = db().execute(\n        REVIEW_SELECT + \" WHERE r.book_id = ? ORDER BY r.id DESC\", (book_id,)\n    ).fetchall()\n    return jsonify({\"items\": [review_json(r) for r in rows]})\n\n\n@app.post(\"/api/books/<int:book_id>/reviews\")\ndef create_review(book_id: int):\n    user = current_user()\n    fetch_book(book_id)\n    data = body_object()\n    errors = {}\n    rating = data.get(\"rating\")\n    if isinstance(rating, bool) or not isinstance(rating, int) or not 1 <= rating <= 5:\n        errors[\"rating\"] = \"Rating must be a whole number from 1 to 5\"\n    comment = data.get(\"comment\")\n    if comment is None:\n        comment = \"\"\n    elif not isinstance(comment, str):\n        errors[\"comment\"] = \"Comment must be a string\"\n    else:\n        comment = comment.strip()\n        if len(comment) > 2000:\n            errors[\"comment\"] = \"Comment must be at most 2000 characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO reviews (book_id, user_id, rating, comment, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (book_id, user[\"id\"], rating, comment, iso(now())),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        conn.rollback()\n        if conn.execute(\"SELECT 1 FROM books WHERE id = ?\", (book_id,)).fetchone() is None:\n            raise ApiError(404, \"Book not found\")\n        raise ApiError(409, \"You have already reviewed this book\")\n    row = conn.execute(REVIEW_SELECT + \" WHERE r.id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(review_json(row)), 201\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    raise ApiError(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF\ncd frontend && npm install --no-audit --no-fund tailwindcss @tailwindcss/vite typescript @types/react @types/react-dom 2>&1 | tail -5; cat package.json"},"output":"\nadded 40 packages in 42s\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"^4.3.5\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"^4.3.5\",\n    \"typescript\": \"^7.0.2\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","metadata":{"output":"\nadded 40 packages in 42s\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"^4.3.5\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"^4.3.5\",\n    \"typescript\": \"^7.0.2\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Book library: Flask API and frontend host.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom decimal import ROUND_HALF_UP, Decimal\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"library.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS books (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    author TEXT NOT NULL,\n    year INTEGER,\n    isbn TEXT,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS reviews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    rating INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),\n    comment TEXT NOT NULL DEFAULT '',\n    created_at TEXT NOT NULL,\n    UNIQUE (book_id, user_id)\n);\nCREATE INDEX IF NOT EXISTS idx_reviews_book ON reviews(book_id);\n\"\"\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt: datetime) -> str:\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str, errors: dict | None = None):\n        self.status = status\n        self.message = message\n        self.errors = errors\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err: ApiError):\n    body: dict = {\"error\": err.message}\n    if err.errors:\n        body[\"errors\"] = err.errors\n    return jsonify(body), err.status\n\n\n@app.errorhandler(404)\ndef handle_404(_err):\n    return jsonify({\"error\": \"Not found\"}), 404\n\n\n@app.errorhandler(405)\ndef handle_405(_err):\n    return jsonify({\"error\": \"Method not allowed\"}), 405\n\n\n@app.errorhandler(500)\ndef handle_500(_err):\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\ndef body_object() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user() -> sqlite3.Row:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        raise ApiError(401, \"Authentication required\")\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(parts[1].strip()),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < iso(now()):\n        raise ApiError(401, \"Authentication required\")\n    return row\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = body_object()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    else:\n        username = username.strip()\n        if len(username) < 3 or len(username) > 50:\n            errors[\"username\"] = \"Username must be 3 to 50 characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 8:\n        errors[\"password\"] = \"Password must be at least 8 characters\"\n    elif len(password) > 200:\n        errors[\"password\"] = \"Password must be at most 200 characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), iso(now())),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(\n            409, \"Username is already taken\", {\"username\": \"Username is already taken\"}\n        )\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = body_object()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"Username and password are required\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (iso(now()),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), row[\"id\"], iso(now() + TOKEN_TTL)),\n    )\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\nBOOK_SELECT = \"\"\"\nSELECT b.id, b.title, b.author, b.year, b.isbn, b.created_at,\n       COUNT(r.id) AS review_count, COALESCE(SUM(r.rating), 0) AS rating_sum\nFROM books b LEFT JOIN reviews r ON r.book_id = b.id\n\"\"\"\n\n\ndef book_json(row: sqlite3.Row) -> dict:\n    count = row[\"review_count\"]\n    average = None\n    if count:\n        average = float(\n            (Decimal(row[\"rating_sum\"]) / Decimal(count)).quantize(\n                Decimal(\"0.1\"), rounding=ROUND_HALF_UP\n            )\n        )\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"author\": row[\"author\"],\n        \"year\": row[\"year\"],\n        \"isbn\": row[\"isbn\"],\n        \"created_at\": row[\"created_at\"],\n        \"review_count\": count,\n        \"average_rating\": average,\n    }\n\n\ndef fetch_book(book_id: int) -> sqlite3.Row:\n    row = db().execute(BOOK_SELECT + \" WHERE b.id = ? GROUP BY b.id\", (book_id,)).fetchone()\n    if row is None or row[\"id\"] is None:\n        raise ApiError(404, \"Book not found\")\n    return row\n\n\nISBN_RE = re.compile(r\"^(?:\\d{9}[\\dXx]|\\d{13})$\")\n\n\ndef validate_book(data: dict) -> dict:\n    errors = {}\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n    else:\n        title = title.strip()\n        if len(title) > 200:\n            errors[\"title\"] = \"Title must be at most 200 characters\"\n    author = data.get(\"author\")\n    if not isinstance(author, str) or not author.strip():\n        errors[\"author\"] = \"Author is required\"\n    else:\n        author = author.strip()\n        if len(author) > 200:\n            errors[\"author\"] = \"Author must be at most 200 characters\"\n    year = data.get(\"year\")\n    if year is not None:\n        if isinstance(year, bool) or not isinstance(year, int):\n            errors[\"year\"] = \"Year must be a whole number\"\n        elif year < 1 or year > 9999:\n            errors[\"year\"] = \"Year must be between 1 and 9999\"\n    isbn = data.get(\"isbn\")\n    if isbn is not None:\n        if not isinstance(isbn, str):\n            errors[\"isbn\"] = \"ISBN must be a string\"\n        else:\n            isbn = isbn.strip()\n            if not isbn:\n                isbn = None\n            elif not ISBN_RE.match(re.sub(r\"[-\\s]\", \"\", isbn)):\n                errors[\"isbn\"] = \"ISBN must have 10 or 13 digits\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return {\"title\": title, \"author\": author, \"year\": year, \"isbn\": isbn}\n\n\ndef int_param(name: str, default: int) -> int:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    try:\n        value = int(raw)\n    except ValueError:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    if value < 1:\n        raise ApiError(400, f\"{name} must be a positive integer\")\n    return value\n\n\n@app.get(\"/api/books\")\ndef list_books():\n    page = int_param(\"page\", 1)\n    page_size = min(int_param(\"page_size\", DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE)\n    q = (request.args.get(\"q\") or \"\").strip()\n    where = \"\"\n    params: list = []\n    if q:\n        escaped = q.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n        where = \" WHERE (b.title LIKE ? ESCAPE '\\\\' OR b.author LIKE ? ESCAPE '\\\\')\"\n        params = [f\"%{escaped}%\"] * 2\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM books b{where}\", params).fetchone()[0]\n    rows = conn.execute(\n        BOOK_SELECT + where + \" GROUP BY b.id ORDER BY b.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [book_json(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/books\")\ndef create_book():\n    current_user()\n    fields = validate_book(body_object())\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO books (title, author, year, isbn, created_at) VALUES (?, ?, ?, ?, ?)\",\n        (fields[\"title\"], fields[\"author\"], fields[\"year\"], fields[\"isbn\"], iso(now())),\n    )\n    conn.commit()\n    return jsonify(book_json(fetch_book(cur.lastrowid))), 201\n\n\n@app.get(\"/api/books/<int:book_id>\")\ndef get_book(book_id: int):\n    return jsonify(book_json(fetch_book(book_id)))\n\n\n@app.put(\"/api/books/<int:book_id>\")\ndef update_book(book_id: int):\n    current_user()\n    fetch_book(book_id)\n    fields = validate_book(body_object())\n    conn = db()\n    conn.execute(\n        \"UPDATE books SET title = ?, author = ?, year = ?, isbn = ? WHERE id = ?\",\n        (fields[\"title\"], fields[\"author\"], fields[\"year\"], fields[\"isbn\"], book_id),\n    )\n    conn.commit()\n    return jsonify(book_json(fetch_book(book_id)))\n\n\n@app.delete(\"/api/books/<int:book_id>\")\ndef delete_book(book_id: int):\n    current_user()\n    fetch_book(book_id)\n    conn = db()\n    conn.execute(\"DELETE FROM books WHERE id = ?\", (book_id,))\n    conn.commit()\n    return \"\", 204\n\n\ndef review_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"book_id\": row[\"book_id\"],\n        \"rating\": row[\"rating\"],\n        \"comment\": row[\"comment\"],\n        \"created_at\": row[\"created_at\"],\n        \"username\": row[\"username\"],\n    }\n\n\nREVIEW_SELECT = \"\"\"\nSELECT r.id, r.book_id, r.rating, r.comment, r.created_at, u.username\nFROM reviews r JOIN users u ON u.id = r.user_id\n\"\"\"\n\n\n@app.get(\"/api/books/<int:book_id>/reviews\")\ndef list_reviews(book_id: int):\n    fetch_book(book_id)\n    rows = db().execute(\n        REVIEW_SELECT + \" WHERE r.book_id = ? ORDER BY r.id DESC\", (book_id,)\n    ).fetchall()\n    return jsonify({\"items\": [review_json(r) for r in rows]})\n\n\n@app.post(\"/api/books/<int:book_id>/reviews\")\ndef create_review(book_id: int):\n    user = current_user()\n    fetch_book(book_id)\n    data = body_object()\n    errors = {}\n    rating = data.get(\"rating\")\n    if isinstance(rating, bool) or not isinstance(rating, int) or not 1 <= rating <= 5:\n        errors[\"rating\"] = \"Rating must be a whole number from 1 to 5\"\n    comment = data.get(\"comment\")\n    if comment is None:\n        comment = \"\"\n    elif not isinstance(comment, str):\n        errors[\"comment\"] = \"Comment must be a string\"\n    else:\n        comment = comment.strip()\n        if len(comment) > 2000:\n            errors[\"comment\"] = \"Comment must be at most 2000 characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO reviews (book_id, user_id, rating, comment, created_at) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (book_id, user[\"id\"], rating, comment, iso(now())),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        conn.rollback()\n        if conn.execute(\"SELECT 1 FROM books WHERE id = ?\", (book_id,)).fetchone() is None:\n            raise ApiError(404, \"Book not found\")\n        raise ApiError(409, \"You have already reviewed this book\")\n    row = conn.execute(REVIEW_SELECT + \" WHERE r.id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(review_json(row)), 201\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    raise ApiError(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF\ncd frontend && npm install --no-audit --no-fund tailwindcss @tailwindcss/vite typescript @types/react @types/react-dom 2>&1 | tail -5; cat package.json","time":{"start":1794251505098,"end":1794251547571}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1b93dbc001Z6DMP54b6bNg2G","sessionID":"ses_e3e4791f8ffe0r0F2fg7hWWyEF","messageID":"msg_1c1b88f1a001j60mtB2F3o2c7u"}}
