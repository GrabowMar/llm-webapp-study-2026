{"type":"tool_use","timestamp":1794255312075,"sessionID":"ses_e3e0f4b79ffejWLifipYfahxAx","part":{"type":"tool","tool":"bash","callID":"toolu_01ULXMYf6Y9LTPiQ1mvYxs9u","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/\"build\": \"vite build\"/\"build\": \"tsc \\&\\& vite build\"/' package.json\nsed -i 's/<title>App/<title>Recipe Book/' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/api.ts <<'EOF'\nexport type RecipeSummary = {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number;\n  author: string;\n};\n\nexport type Recipe = RecipeSummary & {\n  ingredients: string[];\n  instructions: string;\n  servings: number;\n  created_at: string;\n};\n\nexport type RecipeInput = {\n  title: string;\n  category: string;\n  prep_minutes: number | null;\n  servings: number | null;\n  ingredients: string[];\n  instructions: string;\n};\n\nexport type RecipePage = {\n  items: RecipeSummary[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"recipe-token\";\nconst USER_KEY = \"recipe-user\";\n\nexport const session = {\n  get token() {\n    return localStorage.getItem(TOKEN_KEY);\n  },\n  get username() {\n    return localStorage.getItem(USER_KEY);\n  },\n  set(token: string, username: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, username);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = session.token;\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(path, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    throw new ApiError(res.status, data?.error ?? `Request failed (${res.status})`, data?.errors ?? {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"POST\", \"/api/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string }>(\"POST\", \"/api/auth/login\", { username, password }),\n  me: () => request<{ username: string }>(\"GET\", \"/api/auth/me\"),\n  categories: () => request<{ items: string[] }>(\"GET\", \"/api/categories\"),\n  list: (params: { category: string; q: string; page: number; page_size: number }) => {\n    const qs = new URLSearchParams();\n    if (params.category) qs.set(\"category\", params.category);\n    if (params.q) qs.set(\"q\", params.q);\n    qs.set(\"page\", String(params.page));\n    qs.set(\"page_size\", String(params.page_size));\n    return request<RecipePage>(\"GET\", `/api/recipes?${qs}`);\n  },\n  get: (id: string | number) => request<Recipe>(\"GET\", `/api/recipes/${id}`),\n  create: (input: RecipeInput) => request<Recipe>(\"POST\", \"/api/recipes\", input),\n  update: (id: string | number, input: RecipeInput) => request<Recipe>(\"PUT\", `/api/recipes/${id}`, input),\n  remove: (id: string | number) => request<void>(\"DELETE\", `/api/recipes/${id}`),\n};\nEOF\ncat > src/auth.tsx <<'EOF'\nimport { createContext, useContext, useEffect, useState, type ReactNode } from \"react\";\nimport { api, session } from \"./api\";\n\ntype AuthState = {\n  username: string | null;\n  signIn: (token: string, username: string) => void;\n  signOut: () => void;\n};\n\nconst AuthContext = createContext<AuthState>({ username: null, signIn: () => {}, signOut: () => {} });\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [username, setUsername] = useState<string | null>(session.username);\n\n  useEffect(() => {\n    if (!session.token) return;\n    api.me().catch((e) => {\n      if (e.status === 401) {\n        session.clear();\n        setUsername(null);\n      }\n    });\n  }, []);\n\n  const signIn = (token: string, name: string) => {\n    session.set(token, name);\n    setUsername(name);\n  };\n  const signOut = () => {\n    session.clear();\n    setUsername(null);\n  };\n  return <AuthContext.Provider value={{ username, signIn, signOut }}>{children}</AuthContext.Provider>;\n}\n\nexport const useAuth = () => useContext(AuthContext);\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\n\nexport const inputCls =\n  \"w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600\";\nexport const primaryBtn =\n  \"inline-flex items-center justify-center rounded-md bg-amber-700 px-4 py-2 text-sm font-medium text-white hover:bg-amber-800 disabled:opacity-50\";\nexport const secondaryBtn =\n  \"inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 disabled:opacity-50\";\nexport const dangerBtn =\n  \"inline-flex items-center justify-center rounded-md bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 disabled:opacity-50\";\n\nexport function Field({ label, error, children, htmlFor }: { label: string; error?: string; children: ReactNode; htmlFor?: string }) {\n  return (\n    <div className=\"space-y-1\">\n      <label htmlFor={htmlFor} className=\"block text-sm font-medium text-stone-700\">\n        {label}\n      </label>\n      {children}\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n    </div>\n  );\n}\n\nexport function ErrorBox({ message }: { message: string }) {\n  return (\n    <p role=\"alert\" className=\"rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800\">\n      {message}\n    </p>\n  );\n}\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\nEOF\ncat > src/App.tsx <<'EOF'\nimport { Link, Navigate, Route, Routes, useNavigate } from \"react-router-dom\";\nimport { useAuth } from \"./auth\";\nimport { AuthForm } from \"./pages/AuthForm\";\nimport { RecipeForm } from \"./pages/RecipeForm\";\nimport { RecipeList } from \"./pages/RecipeList\";\nimport { RecipePage } from \"./pages/RecipePage\";\nimport { secondaryBtn, primaryBtn } from \"./ui\";\n\nfunction Header() {\n  const { username, signOut } = useAuth();\n  const navigate = useNavigate();\n  return (\n    <header className=\"border-b border-stone-200 bg-white\">\n      <div className=\"mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3\">\n        <Link to=\"/\" className=\"text-xl font-semibold text-amber-800\">\n          Recipe Book\n        </Link>\n        <nav className=\"flex flex-wrap items-center gap-3 text-sm\">\n          {username ? (\n            <>\n              <Link to=\"/recipes/new\" className={primaryBtn}>\n                Add recipe\n              </Link>\n              <span>\n                Signed in as <strong data-testid=\"current-user\">{username}</strong>\n              </span>\n              <button\n                type=\"button\"\n                className={secondaryBtn}\n                onClick={() => {\n                  signOut();\n                  navigate(\"/\");\n                }}\n              >\n                Sign out\n              </button>\n            </>\n          ) : (\n            <>\n              <Link to=\"/login\" className={secondaryBtn}>\n                Sign in\n              </Link>\n              <Link to=\"/register\" className={primaryBtn}>\n                Register\n              </Link>\n            </>\n          )}\n        </nav>\n      </div>\n    </header>\n  );\n}\n\nfunction RequireAuth({ children }: { children: React.ReactNode }) {\n  const { username } = useAuth();\n  if (!username) return <Navigate to=\"/login\" replace />;\n  return <>{children}</>;\n}\n\nexport default function App() {\n  return (\n    <div className=\"min-h-screen bg-stone-50 text-stone-900\">\n      <Header />\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">\n        <Routes>\n          <Route path=\"/\" element={<RecipeList />} />\n          <Route path=\"/login\" element={<AuthForm mode=\"login\" />} />\n          <Route path=\"/register\" element={<AuthForm mode=\"register\" />} />\n          <Route path=\"/recipes/new\" element={<RequireAuth><RecipeForm /></RequireAuth>} />\n          <Route path=\"/recipes/:id\" element={<RecipePage />} />\n          <Route path=\"/recipes/:id/edit\" element={<RequireAuth><RecipeForm /></RequireAuth>} />\n          <Route path=\"*\" element={<p>Page not found.</p>} />\n        </Routes>\n      </main>\n    </div>\n  );\n}\nEOF\nmkdir -p src/pages\ncat > src/pages/AuthForm.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { ErrorBox, Field, inputCls, primaryBtn } from \"../ui\";\n\nexport function AuthForm({ mode }: { mode: \"login\" | \"register\" }) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n  const { signIn } = useAuth();\n  const navigate = useNavigate();\n  const isRegister = mode === \"register\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setFields({});\n    setBusy(true);\n    try {\n      if (isRegister) await api.register(username, password);\n      const res = await api.login(username.trim(), password);\n      signIn(res.token, res.username);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else {\n        setError(\"Something went wrong\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-sm space-y-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-semibold\">{isRegister ? \"Create an account\" : \"Sign in\"}</h1>\n      {error && <ErrorBox message={error} />}\n      <Field label=\"Username\" htmlFor=\"username\" error={fields.username}>\n        <input id=\"username\" name=\"username\" className={inputCls} value={username} onChange={(e) => setUsername(e.target.value)} autoComplete=\"username\" required />\n      </Field>\n      <Field label=\"Password\" htmlFor=\"password\" error={fields.password}>\n        <input id=\"password\" name=\"password\" type=\"password\" className={inputCls} value={password} onChange={(e) => setPassword(e.target.value)} autoComplete={isRegister ? \"new-password\" : \"current-password\"} required />\n      </Field>\n      <button type=\"submit\" className={`${primaryBtn} w-full`} disabled={busy}>\n        {isRegister ? \"Register\" : \"Sign in\"}\n      </button>\n      <p className=\"text-sm text-stone-600\">\n        {isRegister ? (\n          <>Already have an account? <Link className=\"text-amber-800 underline\" to=\"/login\">Sign in</Link></>\n        ) : (\n          <>No account yet? <Link className=\"text-amber-800 underline\" to=\"/register\">Register</Link></>\n        )}\n      </p>\n    </form>\n  );\n}\nEOF\ncat > src/pages/RecipeList.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { api, type RecipePage } from \"../api\";\nimport { ErrorBox, inputCls, secondaryBtn } from \"../ui\";\n\nconst PAGE_SIZE = 6;\n\nexport function RecipeList() {\n  const [params, setParams] = useSearchParams();\n  const category = params.get(\"category\") ?? \"\";\n  const q = params.get(\"q\") ?? \"\";\n  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n  const [search, setSearch] = useState(q);\n  const [categories, setCategories] = useState<string[]>([]);\n  const [data, setData] = useState<RecipePage | null>(null);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    api.categories().then((r) => setCategories(r.items)).catch(() => {});\n  }, []);\n\n  useEffect(() => {\n    setSearch(q);\n  }, [q]);\n\n  useEffect(() => {\n    let cancelled = false;\n    setError(\"\");\n    api\n      .list({ category, q, page, page_size: PAGE_SIZE })\n      .then((r) => !cancelled && setData(r))\n      .catch((e) => !cancelled && setError(e.message));\n    return () => {\n      cancelled = true;\n    };\n  }, [category, q, page]);\n\n  function update(next: { category?: string; q?: string; page?: number }) {\n    const p = new URLSearchParams(params);\n    for (const [k, v] of Object.entries(next)) {\n      if (v === \"\" || v === undefined || (k === \"page\" && v === 1)) p.delete(k);\n      else p.set(k, String(v));\n    }\n    setParams(p);\n  }\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-5\">\n      <form\n        className=\"flex flex-wrap gap-3\"\n        onSubmit={(e) => {\n          e.preventDefault();\n          update({ q: search.trim(), page: 1 });\n        }}\n      >\n        <select aria-label=\"Category\" className={`${inputCls} sm:w-56`} value={category} onChange={(e) => update({ category: e.target.value, page: 1 })}>\n          <option value=\"\">All categories</option>\n          {categories.map((c) => (\n            <option key={c} value={c}>\n              {c}\n            </option>\n          ))}\n        </select>\n        <input aria-label=\"Search title\" type=\"search\" placeholder=\"Search by title\" className={`${inputCls} flex-1 sm:min-w-64`} value={search} onChange={(e) => setSearch(e.target.value)} />\n        <button type=\"submit\" className={secondaryBtn}>\n          Search\n        </button>\n      </form>\n\n      {error && <ErrorBox message={error} />}\n      {!data && !error && <p className=\"text-stone-500\">Loading…</p>}\n      {data && data.items.length === 0 && <p className=\"text-stone-600\">No recipes found.</p>}\n      {data && data.items.length > 0 && (\n        <ul className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {data.items.map((r) => (\n            <li key={r.id} className=\"rounded-lg border border-stone-200 bg-white p-4 shadow-sm hover:shadow\">\n              <Link to={`/recipes/${r.id}`} className=\"block space-y-2\">\n                <h2 className=\"text-lg font-semibold text-amber-900\">{r.title}</h2>\n                <p className=\"text-sm\">\n                  <span className=\"rounded-full bg-amber-100 px-2 py-0.5 text-amber-900\">{r.category}</span>\n                </p>\n                <p className=\"text-sm text-stone-600\">{r.prep_minutes} min prep</p>\n                <p className=\"text-sm text-stone-500\">by {r.author}</p>\n              </Link>\n            </li>\n          ))}\n        </ul>\n      )}\n\n      {data && data.total > 0 && (\n        <nav className=\"flex items-center justify-between\" aria-label=\"Pagination\">\n          <button type=\"button\" className={secondaryBtn} disabled={page <= 1} onClick={() => update({ page: page - 1 })}>\n            Previous\n          </button>\n          <span className=\"text-sm text-stone-600\">\n            Page {data.page} of {pages}\n          </span>\n          <button type=\"button\" className={secondaryBtn} disabled={page >= pages} onClick={() => update({ page: page + 1 })}>\n            Next\n          </button>\n        </nav>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/pages/RecipePage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError, type Recipe } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { dangerBtn, ErrorBox, secondaryBtn } from \"../ui\";\n\nexport function RecipePage() {\n  const { id = \"\" } = useParams();\n  const { username } = useAuth();\n  const navigate = useNavigate();\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    setRecipe(null);\n    setError(\"\");\n    api.get(id).then(setRecipe).catch((e) => setError(e.message));\n  }, [id]);\n\n  async function remove() {\n    setBusy(true);\n    try {\n      await api.remove(id);\n      navigate(\"/\");\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Delete failed\");\n      setConfirming(false);\n      setBusy(false);\n    }\n  }\n\n  if (error && !recipe) return <ErrorBox message={error} />;\n  if (!recipe) return <p className=\"text-stone-500\">Loading…</p>;\n  const mine = username === recipe.author;\n\n  return (\n    <article className=\"space-y-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n      <Link to=\"/\" className=\"text-sm text-amber-800 underline\">\n        &larr; All recipes\n      </Link>\n      <header className=\"space-y-2\">\n        <h1 className=\"text-3xl font-semibold\">{recipe.title}</h1>\n        <p className=\"flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-600\">\n          <span className=\"rounded-full bg-amber-100 px-2 py-0.5 text-amber-900\">{recipe.category}</span>\n          <span>{recipe.prep_minutes} min prep</span>\n          <span>Serves {recipe.servings}</span>\n          <span>by {recipe.author}</span>\n        </p>\n      </header>\n      {error && <ErrorBox message={error} />}\n      <section>\n        <h2 className=\"mb-2 text-lg font-semibold\">Ingredients</h2>\n        <ul className=\"list-disc space-y-1 pl-6\">\n          {recipe.ingredients.map((ing, i) => (\n            <li key={i}>{ing}</li>\n          ))}\n        </ul>\n      </section>\n      <section>\n        <h2 className=\"mb-2 text-lg font-semibold\">Instructions</h2>\n        <p className=\"whitespace-pre-line\">{recipe.instructions}</p>\n      </section>\n      {mine && (\n        <footer className=\"flex flex-wrap items-center gap-3 border-t border-stone-200 pt-4\">\n          <Link to={`/recipes/${recipe.id}/edit`} className={secondaryBtn}>\n            Edit\n          </Link>\n          {confirming ? (\n            <>\n              <span className=\"text-sm\">Delete this recipe permanently?</span>\n              <button type=\"button\" className={dangerBtn} onClick={remove} disabled={busy}>\n                Yes, delete\n              </button>\n              <button type=\"button\" className={secondaryBtn} onClick={() => setConfirming(false)} disabled={busy}>\n                Cancel\n              </button>\n            </>\n          ) : (\n            <button type=\"button\" className={dangerBtn} onClick={() => setConfirming(true)}>\n              Delete\n            </button>\n          )}\n        </footer>\n      )}\n    </article>\n  );\n}\nEOF\ncat > src/pages/RecipeForm.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { ErrorBox, Field, inputCls, primaryBtn, secondaryBtn } from \"../ui\";\n\nexport function RecipeForm() {\n  const { id } = useParams();\n  const editing = id !== undefined;\n  const navigate = useNavigate();\n  const { username, signOut } = useAuth();\n  const [title, setTitle] = useState(\"\");\n  const [category, setCategory] = useState(\"\");\n  const [prep, setPrep] = useState(\"\");\n  const [servings, setServings] = useState(\"\");\n  const [ingredients, setIngredients] = useState<string[]>([\"\"]);\n  const [instructions, setInstructions] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(editing);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (!editing) return;\n    api\n      .get(id)\n      .then((r) => {\n        if (r.author !== username) {\n          setError(\"Only the author may edit this recipe\");\n          return;\n        }\n        setTitle(r.title);\n        setCategory(r.category);\n        setPrep(String(r.prep_minutes));\n        setServings(String(r.servings));\n        setIngredients(r.ingredients.length ? r.ingredients : [\"\"]);\n        setInstructions(r.instructions);\n        setLoading(false);\n      })\n      .catch((e) => setError(e.message));\n  }, [id, editing, username]);\n\n  function toNumber(s: string): number | null {\n    return /^\\s*\\d+\\s*$/.test(s) ? Number(s) : null;\n  }\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setFields({});\n    setBusy(true);\n    const input = {\n      title,\n      category,\n      prep_minutes: toNumber(prep),\n      servings: toNumber(servings),\n      ingredients: ingredients.filter((i) => i.trim() !== \"\"),\n      instructions,\n    };\n    try {\n      const saved = editing ? await api.update(id, input) : await api.create(input);\n      navigate(`/recipes/${saved.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        if (err.status === 401) {\n          signOut();\n          navigate(\"/login\");\n          return;\n        }\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else {\n        setError(\"Something went wrong\");\n      }\n      setBusy(false);\n    }\n  }\n\n  const setIngredient = (i: number, v: string) => setIngredients(ingredients.map((x, j) => (j === i ? v : x)));\n\n  if (loading) return error ? <ErrorBox message={error} /> : <p className=\"text-stone-500\">Loading…</p>;\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-semibold\">{editing ? \"Edit recipe\" : \"Add a recipe\"}</h1>\n      {error && <ErrorBox message={error} />}\n      <Field label=\"Title\" htmlFor=\"title\" error={fields.title}>\n        <input id=\"title\" className={inputCls} value={title} onChange={(e) => setTitle(e.target.value)} />\n      </Field>\n      <div className=\"grid gap-4 sm:grid-cols-3\">\n        <Field label=\"Category\" htmlFor=\"category\" error={fields.category}>\n          <input id=\"category\" className={inputCls} value={category} onChange={(e) => setCategory(e.target.value)} />\n        </Field>\n        <Field label=\"Prep time (minutes)\" htmlFor=\"prep\" error={fields.prep_minutes}>\n          <input id=\"prep\" inputMode=\"numeric\" className={inputCls} value={prep} onChange={(e) => setPrep(e.target.value)} />\n        </Field>\n        <Field label=\"Servings\" htmlFor=\"servings\" error={fields.servings}>\n          <input id=\"servings\" inputMode=\"numeric\" className={inputCls} value={servings} onChange={(e) => setServings(e.target.value)} />\n        </Field>\n      </div>\n      <fieldset className=\"space-y-2\">\n        <legend className=\"text-sm font-medium text-stone-700\">Ingredients</legend>\n        {ingredients.map((ing, i) => (\n          <div key={i} className=\"flex gap-2\">\n            <input aria-label={`Ingredient ${i + 1}`} className={inputCls} value={ing} onChange={(e) => setIngredient(i, e.target.value)} />\n            <button\n              type=\"button\"\n              className={secondaryBtn}\n              aria-label={`Remove ingredient ${i + 1}`}\n              onClick={() => setIngredients(ingredients.length > 1 ? ingredients.filter((_, j) => j !== i) : [\"\"])}\n            >\n              Remove\n            </button>\n          </div>\n        ))}\n        {fields.ingredients && (\n          <p role=\"alert\" className=\"text-sm text-red-700\">\n            {fields.ingredients}\n          </p>\n        )}\n        <button type=\"button\" className={secondaryBtn} onClick={() => setIngredients([...ingredients, \"\"])}>\n          Add ingredient\n        </button>\n      </fieldset>\n      <Field label=\"Instructions\" htmlFor=\"instructions\" error={fields.instructions}>\n        <textarea id=\"instructions\" rows={8} className={inputCls} value={instructions} onChange={(e) => setInstructions(e.target.value)} />\n      </Field>\n      <div className=\"flex gap-3\">\n        <button type=\"submit\" className={primaryBtn} disabled={busy}>\n          {editing ? \"Save changes\" : \"Add recipe\"}\n        </button>\n        <Link to={editing ? `/recipes/${id}` : \"/\"} className={secondaryBtn}>\n          Cancel\n        </Link>\n      </div>\n    </form>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20"},"output":"\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 30 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-VtxoDZpr.css   12.62 kB │ gzip:  3.27 kB\ndist/assets/index-DLy4mYUF.js   274.35 kB │ gzip: 86.22 kB\n\n✓ built in 477ms\n","metadata":{"output":"\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 30 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-VtxoDZpr.css   12.62 kB │ gzip:  3.27 kB\ndist/assets/index-DLy4mYUF.js   274.35 kB │ gzip: 86.22 kB\n\n✓ built in 477ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/\"build\": \"vite build\"/\"build\": \"tsc \\&\\& vite build\"/' package.json\nsed -i 's/<title>App/<title>Recipe Book/' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/api.ts <<'EOF'\nexport type RecipeSummary = {\n  id: number;\n  title: string;\n  category: string;\n  prep_minutes: number;\n  author: string;\n};\n\nexport type Recipe = RecipeSummary & {\n  ingredients: string[];\n  instructions: string;\n  servings: number;\n  created_at: string;\n};\n\nexport type RecipeInput = {\n  title: string;\n  category: string;\n  prep_minutes: number | null;\n  servings: number | null;\n  ingredients: string[];\n  instructions: string;\n};\n\nexport type RecipePage = {\n  items: RecipeSummary[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"recipe-token\";\nconst USER_KEY = \"recipe-user\";\n\nexport const session = {\n  get token() {\n    return localStorage.getItem(TOKEN_KEY);\n  },\n  get username() {\n    return localStorage.getItem(USER_KEY);\n  },\n  set(token: string, username: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, username);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = session.token;\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(path, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    throw new ApiError(res.status, data?.error ?? `Request failed (${res.status})`, data?.errors ?? {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ username: string }>(\"POST\", \"/api/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string }>(\"POST\", \"/api/auth/login\", { username, password }),\n  me: () => request<{ username: string }>(\"GET\", \"/api/auth/me\"),\n  categories: () => request<{ items: string[] }>(\"GET\", \"/api/categories\"),\n  list: (params: { category: string; q: string; page: number; page_size: number }) => {\n    const qs = new URLSearchParams();\n    if (params.category) qs.set(\"category\", params.category);\n    if (params.q) qs.set(\"q\", params.q);\n    qs.set(\"page\", String(params.page));\n    qs.set(\"page_size\", String(params.page_size));\n    return request<RecipePage>(\"GET\", `/api/recipes?${qs}`);\n  },\n  get: (id: string | number) => request<Recipe>(\"GET\", `/api/recipes/${id}`),\n  create: (input: RecipeInput) => request<Recipe>(\"POST\", \"/api/recipes\", input),\n  update: (id: string | number, input: RecipeInput) => request<Recipe>(\"PUT\", `/api/recipes/${id}`, input),\n  remove: (id: string | number) => request<void>(\"DELETE\", `/api/recipes/${id}`),\n};\nEOF\ncat > src/auth.tsx <<'EOF'\nimport { createContext, useContext, useEffect, useState, type ReactNode } from \"react\";\nimport { api, session } from \"./api\";\n\ntype AuthState = {\n  username: string | null;\n  signIn: (token: string, username: string) => void;\n  signOut: () => void;\n};\n\nconst AuthContext = createContext<AuthState>({ username: null, signIn: () => {}, signOut: () => {} });\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [username, setUsername] = useState<string | null>(session.username);\n\n  useEffect(() => {\n    if (!session.token) return;\n    api.me().catch((e) => {\n      if (e.status === 401) {\n        session.clear();\n        setUsername(null);\n      }\n    });\n  }, []);\n\n  const signIn = (token: string, name: string) => {\n    session.set(token, name);\n    setUsername(name);\n  };\n  const signOut = () => {\n    session.clear();\n    setUsername(null);\n  };\n  return <AuthContext.Provider value={{ username, signIn, signOut }}>{children}</AuthContext.Provider>;\n}\n\nexport const useAuth = () => useContext(AuthContext);\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\n\nexport const inputCls =\n  \"w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-amber-600 focus:outline-none focus:ring-1 focus:ring-amber-600\";\nexport const primaryBtn =\n  \"inline-flex items-center justify-center rounded-md bg-amber-700 px-4 py-2 text-sm font-medium text-white hover:bg-amber-800 disabled:opacity-50\";\nexport const secondaryBtn =\n  \"inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 disabled:opacity-50\";\nexport const dangerBtn =\n  \"inline-flex items-center justify-center rounded-md bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 disabled:opacity-50\";\n\nexport function Field({ label, error, children, htmlFor }: { label: string; error?: string; children: ReactNode; htmlFor?: string }) {\n  return (\n    <div className=\"space-y-1\">\n      <label htmlFor={htmlFor} className=\"block text-sm font-medium text-stone-700\">\n        {label}\n      </label>\n      {children}\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n    </div>\n  );\n}\n\nexport function ErrorBox({ message }: { message: string }) {\n  return (\n    <p role=\"alert\" className=\"rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800\">\n      {message}\n    </p>\n  );\n}\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\nEOF\ncat > src/App.tsx <<'EOF'\nimport { Link, Navigate, Route, Routes, useNavigate } from \"react-router-dom\";\nimport { useAuth } from \"./auth\";\nimport { AuthForm } from \"./pages/AuthForm\";\nimport { RecipeForm } from \"./pages/RecipeForm\";\nimport { RecipeList } from \"./pages/RecipeList\";\nimport { RecipePage } from \"./pages/RecipePage\";\nimport { secondaryBtn, primaryBtn } from \"./ui\";\n\nfunction Header() {\n  const { username, signOut } = useAuth();\n  const navigate = useNavigate();\n  return (\n    <header className=\"border-b border-stone-200 bg-white\">\n      <div className=\"mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3\">\n        <Link to=\"/\" className=\"text-xl font-semibold text-amber-800\">\n          Recipe Book\n        </Link>\n        <nav className=\"flex flex-wrap items-center gap-3 text-sm\">\n          {username ? (\n            <>\n              <Link to=\"/recipes/new\" className={primaryBtn}>\n                Add recipe\n              </Link>\n              <span>\n                Signed in as <strong data-testid=\"current-user\">{username}</strong>\n              </span>\n              <button\n                type=\"button\"\n                className={secondaryBtn}\n                onClick={() => {\n                  signOut();\n                  navigate(\"/\");\n                }}\n              >\n                Sign out\n              </button>\n            </>\n          ) : (\n            <>\n              <Link to=\"/login\" className={secondaryBtn}>\n                Sign in\n              </Link>\n              <Link to=\"/register\" className={primaryBtn}>\n                Register\n              </Link>\n            </>\n          )}\n        </nav>\n      </div>\n    </header>\n  );\n}\n\nfunction RequireAuth({ children }: { children: React.ReactNode }) {\n  const { username } = useAuth();\n  if (!username) return <Navigate to=\"/login\" replace />;\n  return <>{children}</>;\n}\n\nexport default function App() {\n  return (\n    <div className=\"min-h-screen bg-stone-50 text-stone-900\">\n      <Header />\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">\n        <Routes>\n          <Route path=\"/\" element={<RecipeList />} />\n          <Route path=\"/login\" element={<AuthForm mode=\"login\" />} />\n          <Route path=\"/register\" element={<AuthForm mode=\"register\" />} />\n          <Route path=\"/recipes/new\" element={<RequireAuth><RecipeForm /></RequireAuth>} />\n          <Route path=\"/recipes/:id\" element={<RecipePage />} />\n          <Route path=\"/recipes/:id/edit\" element={<RequireAuth><RecipeForm /></RequireAuth>} />\n          <Route path=\"*\" element={<p>Page not found.</p>} />\n        </Routes>\n      </main>\n    </div>\n  );\n}\nEOF\nmkdir -p src/pages\ncat > src/pages/AuthForm.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { ErrorBox, Field, inputCls, primaryBtn } from \"../ui\";\n\nexport function AuthForm({ mode }: { mode: \"login\" | \"register\" }) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n  const { signIn } = useAuth();\n  const navigate = useNavigate();\n  const isRegister = mode === \"register\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setFields({});\n    setBusy(true);\n    try {\n      if (isRegister) await api.register(username, password);\n      const res = await api.login(username.trim(), password);\n      signIn(res.token, res.username);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else {\n        setError(\"Something went wrong\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-sm space-y-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-semibold\">{isRegister ? \"Create an account\" : \"Sign in\"}</h1>\n      {error && <ErrorBox message={error} />}\n      <Field label=\"Username\" htmlFor=\"username\" error={fields.username}>\n        <input id=\"username\" name=\"username\" className={inputCls} value={username} onChange={(e) => setUsername(e.target.value)} autoComplete=\"username\" required />\n      </Field>\n      <Field label=\"Password\" htmlFor=\"password\" error={fields.password}>\n        <input id=\"password\" name=\"password\" type=\"password\" className={inputCls} value={password} onChange={(e) => setPassword(e.target.value)} autoComplete={isRegister ? \"new-password\" : \"current-password\"} required />\n      </Field>\n      <button type=\"submit\" className={`${primaryBtn} w-full`} disabled={busy}>\n        {isRegister ? \"Register\" : \"Sign in\"}\n      </button>\n      <p className=\"text-sm text-stone-600\">\n        {isRegister ? (\n          <>Already have an account? <Link className=\"text-amber-800 underline\" to=\"/login\">Sign in</Link></>\n        ) : (\n          <>No account yet? <Link className=\"text-amber-800 underline\" to=\"/register\">Register</Link></>\n        )}\n      </p>\n    </form>\n  );\n}\nEOF\ncat > src/pages/RecipeList.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { api, type RecipePage } from \"../api\";\nimport { ErrorBox, inputCls, secondaryBtn } from \"../ui\";\n\nconst PAGE_SIZE = 6;\n\nexport function RecipeList() {\n  const [params, setParams] = useSearchParams();\n  const category = params.get(\"category\") ?? \"\";\n  const q = params.get(\"q\") ?? \"\";\n  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n  const [search, setSearch] = useState(q);\n  const [categories, setCategories] = useState<string[]>([]);\n  const [data, setData] = useState<RecipePage | null>(null);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    api.categories().then((r) => setCategories(r.items)).catch(() => {});\n  }, []);\n\n  useEffect(() => {\n    setSearch(q);\n  }, [q]);\n\n  useEffect(() => {\n    let cancelled = false;\n    setError(\"\");\n    api\n      .list({ category, q, page, page_size: PAGE_SIZE })\n      .then((r) => !cancelled && setData(r))\n      .catch((e) => !cancelled && setError(e.message));\n    return () => {\n      cancelled = true;\n    };\n  }, [category, q, page]);\n\n  function update(next: { category?: string; q?: string; page?: number }) {\n    const p = new URLSearchParams(params);\n    for (const [k, v] of Object.entries(next)) {\n      if (v === \"\" || v === undefined || (k === \"page\" && v === 1)) p.delete(k);\n      else p.set(k, String(v));\n    }\n    setParams(p);\n  }\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-5\">\n      <form\n        className=\"flex flex-wrap gap-3\"\n        onSubmit={(e) => {\n          e.preventDefault();\n          update({ q: search.trim(), page: 1 });\n        }}\n      >\n        <select aria-label=\"Category\" className={`${inputCls} sm:w-56`} value={category} onChange={(e) => update({ category: e.target.value, page: 1 })}>\n          <option value=\"\">All categories</option>\n          {categories.map((c) => (\n            <option key={c} value={c}>\n              {c}\n            </option>\n          ))}\n        </select>\n        <input aria-label=\"Search title\" type=\"search\" placeholder=\"Search by title\" className={`${inputCls} flex-1 sm:min-w-64`} value={search} onChange={(e) => setSearch(e.target.value)} />\n        <button type=\"submit\" className={secondaryBtn}>\n          Search\n        </button>\n      </form>\n\n      {error && <ErrorBox message={error} />}\n      {!data && !error && <p className=\"text-stone-500\">Loading…</p>}\n      {data && data.items.length === 0 && <p className=\"text-stone-600\">No recipes found.</p>}\n      {data && data.items.length > 0 && (\n        <ul className=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          {data.items.map((r) => (\n            <li key={r.id} className=\"rounded-lg border border-stone-200 bg-white p-4 shadow-sm hover:shadow\">\n              <Link to={`/recipes/${r.id}`} className=\"block space-y-2\">\n                <h2 className=\"text-lg font-semibold text-amber-900\">{r.title}</h2>\n                <p className=\"text-sm\">\n                  <span className=\"rounded-full bg-amber-100 px-2 py-0.5 text-amber-900\">{r.category}</span>\n                </p>\n                <p className=\"text-sm text-stone-600\">{r.prep_minutes} min prep</p>\n                <p className=\"text-sm text-stone-500\">by {r.author}</p>\n              </Link>\n            </li>\n          ))}\n        </ul>\n      )}\n\n      {data && data.total > 0 && (\n        <nav className=\"flex items-center justify-between\" aria-label=\"Pagination\">\n          <button type=\"button\" className={secondaryBtn} disabled={page <= 1} onClick={() => update({ page: page - 1 })}>\n            Previous\n          </button>\n          <span className=\"text-sm text-stone-600\">\n            Page {data.page} of {pages}\n          </span>\n          <button type=\"button\" className={secondaryBtn} disabled={page >= pages} onClick={() => update({ page: page + 1 })}>\n            Next\n          </button>\n        </nav>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/pages/RecipePage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError, type Recipe } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { dangerBtn, ErrorBox, secondaryBtn } from \"../ui\";\n\nexport function RecipePage() {\n  const { id = \"\" } = useParams();\n  const { username } = useAuth();\n  const navigate = useNavigate();\n  const [recipe, setRecipe] = useState<Recipe | null>(null);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    setRecipe(null);\n    setError(\"\");\n    api.get(id).then(setRecipe).catch((e) => setError(e.message));\n  }, [id]);\n\n  async function remove() {\n    setBusy(true);\n    try {\n      await api.remove(id);\n      navigate(\"/\");\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Delete failed\");\n      setConfirming(false);\n      setBusy(false);\n    }\n  }\n\n  if (error && !recipe) return <ErrorBox message={error} />;\n  if (!recipe) return <p className=\"text-stone-500\">Loading…</p>;\n  const mine = username === recipe.author;\n\n  return (\n    <article className=\"space-y-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n      <Link to=\"/\" className=\"text-sm text-amber-800 underline\">\n        &larr; All recipes\n      </Link>\n      <header className=\"space-y-2\">\n        <h1 className=\"text-3xl font-semibold\">{recipe.title}</h1>\n        <p className=\"flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-600\">\n          <span className=\"rounded-full bg-amber-100 px-2 py-0.5 text-amber-900\">{recipe.category}</span>\n          <span>{recipe.prep_minutes} min prep</span>\n          <span>Serves {recipe.servings}</span>\n          <span>by {recipe.author}</span>\n        </p>\n      </header>\n      {error && <ErrorBox message={error} />}\n      <section>\n        <h2 className=\"mb-2 text-lg font-semibold\">Ingredients</h2>\n        <ul className=\"list-disc space-y-1 pl-6\">\n          {recipe.ingredients.map((ing, i) => (\n            <li key={i}>{ing}</li>\n          ))}\n        </ul>\n      </section>\n      <section>\n        <h2 className=\"mb-2 text-lg font-semibold\">Instructions</h2>\n        <p className=\"whitespace-pre-line\">{recipe.instructions}</p>\n      </section>\n      {mine && (\n        <footer className=\"flex flex-wrap items-center gap-3 border-t border-stone-200 pt-4\">\n          <Link to={`/recipes/${recipe.id}/edit`} className={secondaryBtn}>\n            Edit\n          </Link>\n          {confirming ? (\n            <>\n              <span className=\"text-sm\">Delete this recipe permanently?</span>\n              <button type=\"button\" className={dangerBtn} onClick={remove} disabled={busy}>\n                Yes, delete\n              </button>\n              <button type=\"button\" className={secondaryBtn} onClick={() => setConfirming(false)} disabled={busy}>\n                Cancel\n              </button>\n            </>\n          ) : (\n            <button type=\"button\" className={dangerBtn} onClick={() => setConfirming(true)}>\n              Delete\n            </button>\n          )}\n        </footer>\n      )}\n    </article>\n  );\n}\nEOF\ncat > src/pages/RecipeForm.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { ErrorBox, Field, inputCls, primaryBtn, secondaryBtn } from \"../ui\";\n\nexport function RecipeForm() {\n  const { id } = useParams();\n  const editing = id !== undefined;\n  const navigate = useNavigate();\n  const { username, signOut } = useAuth();\n  const [title, setTitle] = useState(\"\");\n  const [category, setCategory] = useState(\"\");\n  const [prep, setPrep] = useState(\"\");\n  const [servings, setServings] = useState(\"\");\n  const [ingredients, setIngredients] = useState<string[]>([\"\"]);\n  const [instructions, setInstructions] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(editing);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    if (!editing) return;\n    api\n      .get(id)\n      .then((r) => {\n        if (r.author !== username) {\n          setError(\"Only the author may edit this recipe\");\n          return;\n        }\n        setTitle(r.title);\n        setCategory(r.category);\n        setPrep(String(r.prep_minutes));\n        setServings(String(r.servings));\n        setIngredients(r.ingredients.length ? r.ingredients : [\"\"]);\n        setInstructions(r.instructions);\n        setLoading(false);\n      })\n      .catch((e) => setError(e.message));\n  }, [id, editing, username]);\n\n  function toNumber(s: string): number | null {\n    return /^\\s*\\d+\\s*$/.test(s) ? Number(s) : null;\n  }\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    setFields({});\n    setBusy(true);\n    const input = {\n      title,\n      category,\n      prep_minutes: toNumber(prep),\n      servings: toNumber(servings),\n      ingredients: ingredients.filter((i) => i.trim() !== \"\"),\n      instructions,\n    };\n    try {\n      const saved = editing ? await api.update(id, input) : await api.create(input);\n      navigate(`/recipes/${saved.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        if (err.status === 401) {\n          signOut();\n          navigate(\"/login\");\n          return;\n        }\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else {\n        setError(\"Something went wrong\");\n      }\n      setBusy(false);\n    }\n  }\n\n  const setIngredient = (i: number, v: string) => setIngredients(ingredients.map((x, j) => (j === i ? v : x)));\n\n  if (loading) return error ? <ErrorBox message={error} /> : <p className=\"text-stone-500\">Loading…</p>;\n\n  return (\n    <form onSubmit={submit} className=\"space-y-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm\">\n      <h1 className=\"text-xl font-semibold\">{editing ? \"Edit recipe\" : \"Add a recipe\"}</h1>\n      {error && <ErrorBox message={error} />}\n      <Field label=\"Title\" htmlFor=\"title\" error={fields.title}>\n        <input id=\"title\" className={inputCls} value={title} onChange={(e) => setTitle(e.target.value)} />\n      </Field>\n      <div className=\"grid gap-4 sm:grid-cols-3\">\n        <Field label=\"Category\" htmlFor=\"category\" error={fields.category}>\n          <input id=\"category\" className={inputCls} value={category} onChange={(e) => setCategory(e.target.value)} />\n        </Field>\n        <Field label=\"Prep time (minutes)\" htmlFor=\"prep\" error={fields.prep_minutes}>\n          <input id=\"prep\" inputMode=\"numeric\" className={inputCls} value={prep} onChange={(e) => setPrep(e.target.value)} />\n        </Field>\n        <Field label=\"Servings\" htmlFor=\"servings\" error={fields.servings}>\n          <input id=\"servings\" inputMode=\"numeric\" className={inputCls} value={servings} onChange={(e) => setServings(e.target.value)} />\n        </Field>\n      </div>\n      <fieldset className=\"space-y-2\">\n        <legend className=\"text-sm font-medium text-stone-700\">Ingredients</legend>\n        {ingredients.map((ing, i) => (\n          <div key={i} className=\"flex gap-2\">\n            <input aria-label={`Ingredient ${i + 1}`} className={inputCls} value={ing} onChange={(e) => setIngredient(i, e.target.value)} />\n            <button\n              type=\"button\"\n              className={secondaryBtn}\n              aria-label={`Remove ingredient ${i + 1}`}\n              onClick={() => setIngredients(ingredients.length > 1 ? ingredients.filter((_, j) => j !== i) : [\"\"])}\n            >\n              Remove\n            </button>\n          </div>\n        ))}\n        {fields.ingredients && (\n          <p role=\"alert\" className=\"text-sm text-red-700\">\n            {fields.ingredients}\n          </p>\n        )}\n        <button type=\"button\" className={secondaryBtn} onClick={() => setIngredients([...ingredients, \"\"])}>\n          Add ingredient\n        </button>\n      </fieldset>\n      <Field label=\"Instructions\" htmlFor=\"instructions\" error={fields.instructions}>\n        <textarea id=\"instructions\" rows={8} className={inputCls} value={instructions} onChange={(e) => setInstructions(e.target.value)} />\n      </Field>\n      <div className=\"flex gap-3\">\n        <button type=\"submit\" className={primaryBtn} disabled={busy}>\n          {editing ? \"Save changes\" : \"Add recipe\"}\n        </button>\n        <Link to={editing ? `/recipes/${id}` : \"/\"} className={secondaryBtn}>\n          Cancel\n        </Link>\n      </div>\n    </form>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20","time":{"start":1794255310317,"end":1794255312054}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f34de1001DkIoFgKGE1LstY","sessionID":"ses_e3e0f4b79ffejWLifipYfahxAx","messageID":"msg_1c1f293b4001fZtbWbhD6pzhvt"}}
