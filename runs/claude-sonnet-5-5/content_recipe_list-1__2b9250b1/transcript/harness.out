{"type":"tool_use","timestamp":1794255262662,"sessionID":"ses_e3e0f4b79ffejWLifipYfahxAx","part":{"type":"tool","tool":"bash","callID":"toolu_01T3hgk368FsF3NSWJDWaX1b","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Recipe book: Flask JSON API plus the built frontend.\"\"\"\n\nimport hashlib\nimport json\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"recipes.db\"\nTOKEN_TTL = timedelta(days=30)\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS recipes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    ingredients TEXT NOT NULL,\n    instructions TEXT NOT NULL,\n    category TEXT NOT NULL,\n    prep_minutes INTEGER NOT NULL,\n    servings INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS recipes_created ON recipes(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS recipes_category ON recipes(category COLLATE NOCASE);\nCREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n\"\"\"\n\nSAMPLES = [\n    {\n        \"title\": \"Classic Margherita Pizza\",\n        \"category\": \"Main course\",\n        \"prep_minutes\": 30,\n        \"servings\": 2,\n        \"ingredients\": [\n            \"300 g pizza dough\",\n            \"120 ml tomato passata\",\n            \"200 g fresh mozzarella\",\n            \"A handful of fresh basil leaves\",\n            \"2 tbsp olive oil\",\n            \"Salt\",\n        ],\n        \"instructions\": \"Heat the oven to its highest setting with a baking tray inside.\\n\"\n        \"Stretch the dough into a thin round on a sheet of baking paper.\\n\"\n        \"Spread the passata, tear over the mozzarella and drizzle with oil.\\n\"\n        \"Slide onto the hot tray and bake for 8 to 10 minutes.\\n\"\n        \"Top with basil and serve immediately.\",\n    },\n    {\n        \"title\": \"Creamy Tomato Soup\",\n        \"category\": \"Soup\",\n        \"prep_minutes\": 35,\n        \"servings\": 4,\n        \"ingredients\": [\n            \"1 kg ripe tomatoes\",\n            \"1 onion, chopped\",\n            \"2 cloves garlic\",\n            \"500 ml vegetable stock\",\n            \"100 ml cream\",\n            \"1 tbsp butter\",\n        ],\n        \"instructions\": \"Melt the butter and soften the onion and garlic.\\n\"\n        \"Add the quartered tomatoes and stock and simmer for 20 minutes.\\n\"\n        \"Blend until smooth, stir in the cream and season to taste.\",\n    },\n    {\n        \"title\": \"Fluffy Pancakes\",\n        \"category\": \"Breakfast\",\n        \"prep_minutes\": 20,\n        \"servings\": 4,\n        \"ingredients\": [\n            \"200 g plain flour\",\n            \"2 tsp baking powder\",\n            \"1 tbsp sugar\",\n            \"250 ml milk\",\n            \"1 egg\",\n            \"30 g melted butter\",\n        ],\n        \"instructions\": \"Whisk the dry ingredients together.\\n\"\n        \"Beat in the milk, egg and butter until just combined.\\n\\n\"\n        \"Cook ladlefuls in a hot greased pan until bubbles form, flip and cook for another minute.\",\n    },\n    {\n        \"title\": \"Chocolate Mug Cake\",\n        \"category\": \"Dessert\",\n        \"prep_minutes\": 5,\n        \"servings\": 1,\n        \"ingredients\": [\n            \"4 tbsp plain flour\",\n            \"3 tbsp sugar\",\n            \"2 tbsp cocoa powder\",\n            \"3 tbsp milk\",\n            \"2 tbsp vegetable oil\",\n        ],\n        \"instructions\": \"Mix everything in a large mug until smooth.\\n\"\n        \"Microwave for 90 seconds and let it cool slightly before eating.\",\n    },\n]\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef connect():\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.execute(\"BEGIN IMMEDIATE\")\n        seeded = conn.execute(\"SELECT 1 FROM meta WHERE key = 'seeded'\").fetchone()\n        if not seeded:\n            cur = conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (\n                    \"chef\",\n                    generate_password_hash(secrets.token_urlsafe(32)),\n                    now_iso(),\n                ),\n            )\n            chef_id = cur.lastrowid\n            base = datetime.now(timezone.utc)\n            for i, s in enumerate(SAMPLES):\n                created = (base - timedelta(minutes=len(SAMPLES) - i)).strftime(\n                    \"%Y-%m-%dT%H:%M:%S.%fZ\"\n                )\n                conn.execute(\n                    \"INSERT INTO recipes (title, ingredients, instructions, category,\"\n                    \" prep_minutes, servings, created_at, author_id)\"\n                    \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n                    (\n                        s[\"title\"],\n                        json.dumps(s[\"ingredients\"]),\n                        s[\"instructions\"],\n                        s[\"category\"],\n                        s[\"prep_minutes\"],\n                        s[\"servings\"],\n                        created,\n                        chef_id,\n                    ),\n                )\n            conn.execute(\"INSERT INTO meta (key, value) VALUES ('seeded', '1')\")\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(status, message, errors=None):\n    body = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.code or 500, exc.description or exc.name)\n    return exc\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n# ---------- auth ----------\n\n\ndef credentials():\n    data = json_body()\n    if data is None:\n        return None, None, error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = credentials()\n    if err:\n        return err\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    else:\n        username = username.strip()\n        if not 3 <= len(username) <= 32:\n            errors[\"username\"] = \"Username must be 3 to 32 characters long\"\n        elif any(c.isspace() or not c.isprintable() for c in username):\n            errors[\"username\"] = \"Username must not contain whitespace\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters long\"\n    elif len(password) > 200:\n        errors[\"password\"] = \"Password must be at most 200 characters long\"\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = credentials()\n    if err:\n        return err\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"Username and password are required\")\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (now_iso(),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (\n            hash_token(token),\n            row[\"id\"],\n            (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\"),\n        ),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    return jsonify({\"username\": user[\"username\"]})\n\n\n# ---------- recipes ----------\n\nRECIPE_COLUMNS = (\n    \"r.id, r.title, r.ingredients, r.instructions, r.category, r.prep_minutes,\"\n    \" r.servings, r.created_at, r.author_id, u.username AS author\"\n)\n\n\ndef full_recipe(row):\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"ingredients\": json.loads(row[\"ingredients\"]),\n        \"instructions\": row[\"instructions\"],\n        \"category\": row[\"category\"],\n        \"prep_minutes\": row[\"prep_minutes\"],\n        \"servings\": row[\"servings\"],\n        \"created_at\": row[\"created_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\ndef is_int(value):\n    return isinstance(value, int) and not isinstance(value, bool)\n\n\ndef validate_recipe(data):\n    errors = {}\n    clean = {}\n\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n    elif len(title.strip()) > 200:\n        errors[\"title\"] = \"Title must be at most 200 characters long\"\n    else:\n        clean[\"title\"] = title.strip()\n\n    category = data.get(\"category\")\n    if not isinstance(category, str) or not category.strip():\n        errors[\"category\"] = \"Category is required\"\n    elif len(category.strip()) > 60:\n        errors[\"category\"] = \"Category must be at most 60 characters long\"\n    else:\n        clean[\"category\"] = category.strip()\n\n    instructions = data.get(\"instructions\")\n    if not isinstance(instructions, str) or not instructions.strip():\n        errors[\"instructions\"] = \"Instructions are required\"\n    elif len(instructions) > 20000:\n        errors[\"instructions\"] = \"Instructions must be at most 20000 characters long\"\n    else:\n        clean[\"instructions\"] = instructions.strip()\n\n    ingredients = data.get(\"ingredients\")\n    if not isinstance(ingredients, list) or not ingredients:\n        errors[\"ingredients\"] = \"At least one ingredient is required\"\n    elif len(ingredients) > 200:\n        errors[\"ingredients\"] = \"At most 200 ingredients are allowed\"\n    elif not all(isinstance(i, str) and i.strip() for i in ingredients):\n        errors[\"ingredients\"] = \"Each ingredient must be a non-empty string\"\n    elif any(len(i.strip()) > 300 for i in ingredients):\n        errors[\"ingredients\"] = \"Each ingredient must be at most 300 characters long\"\n    else:\n        clean[\"ingredients\"] = [i.strip() for i in ingredients]\n\n    prep = data.get(\"prep_minutes\")\n    if not is_int(prep) or prep < 0:\n        errors[\"prep_minutes\"] = \"Prep time must be a whole number of minutes, 0 or more\"\n    elif prep > 100000:\n        errors[\"prep_minutes\"] = \"Prep time is too large\"\n    else:\n        clean[\"prep_minutes\"] = prep\n\n    servings = data.get(\"servings\")\n    if not is_int(servings) or servings < 1:\n        errors[\"servings\"] = \"Servings must be a whole number, 1 or more\"\n    elif servings > 10000:\n        errors[\"servings\"] = \"Servings is too large\"\n    else:\n        clean[\"servings\"] = servings\n\n    return clean, errors\n\n\ndef fetch_recipe(recipe_id):\n    return db().execute(\n        f\"SELECT {RECIPE_COLUMNS} FROM recipes r JOIN users u ON u.id = r.author_id\"\n        \" WHERE r.id = ?\",\n        (recipe_id,),\n    ).fetchone()\n\n\n@app.post(\"/api/recipes\")\ndef create_recipe():\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    clean, errors = validate_recipe(data)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO recipes (title, ingredients, instructions, category, prep_minutes,\"\n        \" servings, created_at, author_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            clean[\"title\"],\n            json.dumps(clean[\"ingredients\"]),\n            clean[\"instructions\"],\n            clean[\"category\"],\n            clean[\"prep_minutes\"],\n            clean[\"servings\"],\n            now_iso(),\n            user[\"id\"],\n        ),\n    )\n    conn.commit()\n    return jsonify(full_recipe(fetch_recipe(cur.lastrowid))), 201\n\n\ndef positive_int_arg(name, default):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, f\"{name} must be a positive integer\"\n    if value < 1:\n        return None, f\"{name} must be a positive integer\"\n    return value, None\n\n\ndef like_escape(text):\n    return text.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\n@app.get(\"/api/recipes\")\ndef list_recipes():\n    page, err = positive_int_arg(\"page\", 1)\n    if err:\n        return error(400, err, {\"page\": err})\n    page_size, err = positive_int_arg(\"page_size\", DEFAULT_PAGE_SIZE)\n    if err:\n        return error(400, err, {\"page_size\": err})\n    page_size = min(page_size, MAX_PAGE_SIZE)\n\n    where = []\n    params = []\n    category = request.args.get(\"category\", \"\").strip()\n    if category:\n        where.append(\"r.category = ? COLLATE NOCASE\")\n        params.append(category)\n    q = request.args.get(\"q\", \"\").strip()\n    if q:\n        where.append(\"r.title LIKE ? ESCAPE '\\\\'\")\n        params.append(f\"%{like_escape(q)}%\")\n    clause = f\" WHERE {' AND '.join(where)}\" if where else \"\"\n\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM recipes r{clause}\", params).fetchone()[0]\n    rows = conn.execute(\n        \"SELECT r.id, r.title, r.category, r.prep_minutes, u.username AS author\"\n        f\" FROM recipes r JOIN users u ON u.id = r.author_id{clause}\"\n        \" ORDER BY r.created_at DESC, r.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\n                    \"id\": r[\"id\"],\n                    \"title\": r[\"title\"],\n                    \"category\": r[\"category\"],\n                    \"prep_minutes\": r[\"prep_minutes\"],\n                    \"author\": r[\"author\"],\n                }\n                for r in rows\n            ],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/categories\")\ndef list_categories():\n    rows = db().execute(\n        \"SELECT MIN(category) AS category FROM recipes GROUP BY category COLLATE NOCASE\"\n        \" ORDER BY category COLLATE NOCASE\"\n    ).fetchall()\n    return jsonify({\"items\": [r[\"category\"] for r in rows]})\n\n\n@app.get(\"/api/recipes/<int:recipe_id>\")\ndef get_recipe(recipe_id):\n    row = fetch_recipe(recipe_id)\n    if row is None:\n        return error(404, \"Recipe not found\")\n    return jsonify(full_recipe(row))\n\n\n@app.put(\"/api/recipes/<int:recipe_id>\")\ndef update_recipe(recipe_id):\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    row = fetch_recipe(recipe_id)\n    if row is None:\n        return error(404, \"Recipe not found\")\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(403, \"Only the author may change this recipe\")\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    clean, errors = validate_recipe(data)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    conn = db()\n    conn.execute(\n        \"UPDATE recipes SET title = ?, ingredients = ?, instructions = ?, category = ?,\"\n        \" prep_minutes = ?, servings = ? WHERE id = ?\",\n        (\n            clean[\"title\"],\n            json.dumps(clean[\"ingredients\"]),\n            clean[\"instructions\"],\n            clean[\"category\"],\n            clean[\"prep_minutes\"],\n            clean[\"servings\"],\n            recipe_id,\n        ),\n    )\n    conn.commit()\n    return jsonify(full_recipe(fetch_recipe(recipe_id)))\n\n\n@app.delete(\"/api/recipes/<int:recipe_id>\")\ndef delete_recipe(recipe_id):\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    row = fetch_recipe(recipe_id)\n    if row is None:\n        return error(404, \"Recipe not found\")\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(403, \"Only the author may delete this recipe\")\n    conn = db()\n    conn.execute(\"DELETE FROM recipes WHERE id = ?\", (recipe_id,))\n    conn.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF\ncd frontend && npm i react-router-dom 2>&1 | tail -2; npm i -D tailwindcss @tailwindcss/vite typescript @types/react @types/react-dom 2>&1 | tail -3; cat package.json"},"output":"\nfound 0 vulnerabilities\nadded 21 packages, and audited 51 packages in 1m\n\nfound 0 vulnerabilities\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"react-router-dom\": \"^7.18.5\"\n  },\n  \"devDependencies\": {\n    \"@tailwindcss/vite\": \"^4.3.5\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"tailwindcss\": \"^4.3.5\",\n    \"typescript\": \"^7.0.2\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","metadata":{"output":"\nfound 0 vulnerabilities\nadded 21 packages, and audited 51 packages in 1m\n\nfound 0 vulnerabilities\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"react-router-dom\": \"^7.18.5\"\n  },\n  \"devDependencies\": {\n    \"@tailwindcss/vite\": \"^4.3.5\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"tailwindcss\": \"^4.3.5\",\n    \"typescript\": \"^7.0.2\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Recipe book: Flask JSON API plus the built frontend.\"\"\"\n\nimport hashlib\nimport json\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"recipes.db\"\nTOKEN_TTL = timedelta(days=30)\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 10\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS recipes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    ingredients TEXT NOT NULL,\n    instructions TEXT NOT NULL,\n    category TEXT NOT NULL,\n    prep_minutes INTEGER NOT NULL,\n    servings INTEGER NOT NULL,\n    created_at TEXT NOT NULL,\n    author_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE\n);\nCREATE INDEX IF NOT EXISTS recipes_created ON recipes(created_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS recipes_category ON recipes(category COLLATE NOCASE);\nCREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);\n\"\"\"\n\nSAMPLES = [\n    {\n        \"title\": \"Classic Margherita Pizza\",\n        \"category\": \"Main course\",\n        \"prep_minutes\": 30,\n        \"servings\": 2,\n        \"ingredients\": [\n            \"300 g pizza dough\",\n            \"120 ml tomato passata\",\n            \"200 g fresh mozzarella\",\n            \"A handful of fresh basil leaves\",\n            \"2 tbsp olive oil\",\n            \"Salt\",\n        ],\n        \"instructions\": \"Heat the oven to its highest setting with a baking tray inside.\\n\"\n        \"Stretch the dough into a thin round on a sheet of baking paper.\\n\"\n        \"Spread the passata, tear over the mozzarella and drizzle with oil.\\n\"\n        \"Slide onto the hot tray and bake for 8 to 10 minutes.\\n\"\n        \"Top with basil and serve immediately.\",\n    },\n    {\n        \"title\": \"Creamy Tomato Soup\",\n        \"category\": \"Soup\",\n        \"prep_minutes\": 35,\n        \"servings\": 4,\n        \"ingredients\": [\n            \"1 kg ripe tomatoes\",\n            \"1 onion, chopped\",\n            \"2 cloves garlic\",\n            \"500 ml vegetable stock\",\n            \"100 ml cream\",\n            \"1 tbsp butter\",\n        ],\n        \"instructions\": \"Melt the butter and soften the onion and garlic.\\n\"\n        \"Add the quartered tomatoes and stock and simmer for 20 minutes.\\n\"\n        \"Blend until smooth, stir in the cream and season to taste.\",\n    },\n    {\n        \"title\": \"Fluffy Pancakes\",\n        \"category\": \"Breakfast\",\n        \"prep_minutes\": 20,\n        \"servings\": 4,\n        \"ingredients\": [\n            \"200 g plain flour\",\n            \"2 tsp baking powder\",\n            \"1 tbsp sugar\",\n            \"250 ml milk\",\n            \"1 egg\",\n            \"30 g melted butter\",\n        ],\n        \"instructions\": \"Whisk the dry ingredients together.\\n\"\n        \"Beat in the milk, egg and butter until just combined.\\n\\n\"\n        \"Cook ladlefuls in a hot greased pan until bubbles form, flip and cook for another minute.\",\n    },\n    {\n        \"title\": \"Chocolate Mug Cake\",\n        \"category\": \"Dessert\",\n        \"prep_minutes\": 5,\n        \"servings\": 1,\n        \"ingredients\": [\n            \"4 tbsp plain flour\",\n            \"3 tbsp sugar\",\n            \"2 tbsp cocoa powder\",\n            \"3 tbsp milk\",\n            \"2 tbsp vegetable oil\",\n        ],\n        \"instructions\": \"Mix everything in a large mug until smooth.\\n\"\n        \"Microwave for 90 seconds and let it cool slightly before eating.\",\n    },\n]\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef connect():\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.execute(\"BEGIN IMMEDIATE\")\n        seeded = conn.execute(\"SELECT 1 FROM meta WHERE key = 'seeded'\").fetchone()\n        if not seeded:\n            cur = conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n                (\n                    \"chef\",\n                    generate_password_hash(secrets.token_urlsafe(32)),\n                    now_iso(),\n                ),\n            )\n            chef_id = cur.lastrowid\n            base = datetime.now(timezone.utc)\n            for i, s in enumerate(SAMPLES):\n                created = (base - timedelta(minutes=len(SAMPLES) - i)).strftime(\n                    \"%Y-%m-%dT%H:%M:%S.%fZ\"\n                )\n                conn.execute(\n                    \"INSERT INTO recipes (title, ingredients, instructions, category,\"\n                    \" prep_minutes, servings, created_at, author_id)\"\n                    \" VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n                    (\n                        s[\"title\"],\n                        json.dumps(s[\"ingredients\"]),\n                        s[\"instructions\"],\n                        s[\"category\"],\n                        s[\"prep_minutes\"],\n                        s[\"servings\"],\n                        created,\n                        chef_id,\n                    ),\n                )\n            conn.execute(\"INSERT INTO meta (key, value) VALUES ('seeded', '1')\")\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(status, message, errors=None):\n    body = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.code or 500, exc.description or exc.name)\n    return exc\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        return None\n    return {\"id\": row[\"id\"], \"username\": row[\"username\"]}\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\n# ---------- auth ----------\n\n\ndef credentials():\n    data = json_body()\n    if data is None:\n        return None, None, error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = credentials()\n    if err:\n        return err\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    else:\n        username = username.strip()\n        if not 3 <= len(username) <= 32:\n            errors[\"username\"] = \"Username must be 3 to 32 characters long\"\n        elif any(c.isspace() or not c.isprintable() for c in username):\n            errors[\"username\"] = \"Username must not contain whitespace\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters long\"\n    elif len(password) > 200:\n        errors[\"password\"] = \"Password must be at most 200 characters long\"\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(409, \"Username is already taken\", {\"username\": \"Username is already taken\"})\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = credentials()\n    if err:\n        return err\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"Username and password are required\")\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (now_iso(),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (\n            hash_token(token),\n            row[\"id\"],\n            (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\"),\n        ),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    return jsonify({\"username\": user[\"username\"]})\n\n\n# ---------- recipes ----------\n\nRECIPE_COLUMNS = (\n    \"r.id, r.title, r.ingredients, r.instructions, r.category, r.prep_minutes,\"\n    \" r.servings, r.created_at, r.author_id, u.username AS author\"\n)\n\n\ndef full_recipe(row):\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"ingredients\": json.loads(row[\"ingredients\"]),\n        \"instructions\": row[\"instructions\"],\n        \"category\": row[\"category\"],\n        \"prep_minutes\": row[\"prep_minutes\"],\n        \"servings\": row[\"servings\"],\n        \"created_at\": row[\"created_at\"],\n        \"author\": row[\"author\"],\n    }\n\n\ndef is_int(value):\n    return isinstance(value, int) and not isinstance(value, bool)\n\n\ndef validate_recipe(data):\n    errors = {}\n    clean = {}\n\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n    elif len(title.strip()) > 200:\n        errors[\"title\"] = \"Title must be at most 200 characters long\"\n    else:\n        clean[\"title\"] = title.strip()\n\n    category = data.get(\"category\")\n    if not isinstance(category, str) or not category.strip():\n        errors[\"category\"] = \"Category is required\"\n    elif len(category.strip()) > 60:\n        errors[\"category\"] = \"Category must be at most 60 characters long\"\n    else:\n        clean[\"category\"] = category.strip()\n\n    instructions = data.get(\"instructions\")\n    if not isinstance(instructions, str) or not instructions.strip():\n        errors[\"instructions\"] = \"Instructions are required\"\n    elif len(instructions) > 20000:\n        errors[\"instructions\"] = \"Instructions must be at most 20000 characters long\"\n    else:\n        clean[\"instructions\"] = instructions.strip()\n\n    ingredients = data.get(\"ingredients\")\n    if not isinstance(ingredients, list) or not ingredients:\n        errors[\"ingredients\"] = \"At least one ingredient is required\"\n    elif len(ingredients) > 200:\n        errors[\"ingredients\"] = \"At most 200 ingredients are allowed\"\n    elif not all(isinstance(i, str) and i.strip() for i in ingredients):\n        errors[\"ingredients\"] = \"Each ingredient must be a non-empty string\"\n    elif any(len(i.strip()) > 300 for i in ingredients):\n        errors[\"ingredients\"] = \"Each ingredient must be at most 300 characters long\"\n    else:\n        clean[\"ingredients\"] = [i.strip() for i in ingredients]\n\n    prep = data.get(\"prep_minutes\")\n    if not is_int(prep) or prep < 0:\n        errors[\"prep_minutes\"] = \"Prep time must be a whole number of minutes, 0 or more\"\n    elif prep > 100000:\n        errors[\"prep_minutes\"] = \"Prep time is too large\"\n    else:\n        clean[\"prep_minutes\"] = prep\n\n    servings = data.get(\"servings\")\n    if not is_int(servings) or servings < 1:\n        errors[\"servings\"] = \"Servings must be a whole number, 1 or more\"\n    elif servings > 10000:\n        errors[\"servings\"] = \"Servings is too large\"\n    else:\n        clean[\"servings\"] = servings\n\n    return clean, errors\n\n\ndef fetch_recipe(recipe_id):\n    return db().execute(\n        f\"SELECT {RECIPE_COLUMNS} FROM recipes r JOIN users u ON u.id = r.author_id\"\n        \" WHERE r.id = ?\",\n        (recipe_id,),\n    ).fetchone()\n\n\n@app.post(\"/api/recipes\")\ndef create_recipe():\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    clean, errors = validate_recipe(data)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO recipes (title, ingredients, instructions, category, prep_minutes,\"\n        \" servings, created_at, author_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            clean[\"title\"],\n            json.dumps(clean[\"ingredients\"]),\n            clean[\"instructions\"],\n            clean[\"category\"],\n            clean[\"prep_minutes\"],\n            clean[\"servings\"],\n            now_iso(),\n            user[\"id\"],\n        ),\n    )\n    conn.commit()\n    return jsonify(full_recipe(fetch_recipe(cur.lastrowid))), 201\n\n\ndef positive_int_arg(name, default):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, f\"{name} must be a positive integer\"\n    if value < 1:\n        return None, f\"{name} must be a positive integer\"\n    return value, None\n\n\ndef like_escape(text):\n    return text.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\n@app.get(\"/api/recipes\")\ndef list_recipes():\n    page, err = positive_int_arg(\"page\", 1)\n    if err:\n        return error(400, err, {\"page\": err})\n    page_size, err = positive_int_arg(\"page_size\", DEFAULT_PAGE_SIZE)\n    if err:\n        return error(400, err, {\"page_size\": err})\n    page_size = min(page_size, MAX_PAGE_SIZE)\n\n    where = []\n    params = []\n    category = request.args.get(\"category\", \"\").strip()\n    if category:\n        where.append(\"r.category = ? COLLATE NOCASE\")\n        params.append(category)\n    q = request.args.get(\"q\", \"\").strip()\n    if q:\n        where.append(\"r.title LIKE ? ESCAPE '\\\\'\")\n        params.append(f\"%{like_escape(q)}%\")\n    clause = f\" WHERE {' AND '.join(where)}\" if where else \"\"\n\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM recipes r{clause}\", params).fetchone()[0]\n    rows = conn.execute(\n        \"SELECT r.id, r.title, r.category, r.prep_minutes, u.username AS author\"\n        f\" FROM recipes r JOIN users u ON u.id = r.author_id{clause}\"\n        \" ORDER BY r.created_at DESC, r.id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [\n                {\n                    \"id\": r[\"id\"],\n                    \"title\": r[\"title\"],\n                    \"category\": r[\"category\"],\n                    \"prep_minutes\": r[\"prep_minutes\"],\n                    \"author\": r[\"author\"],\n                }\n                for r in rows\n            ],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/categories\")\ndef list_categories():\n    rows = db().execute(\n        \"SELECT MIN(category) AS category FROM recipes GROUP BY category COLLATE NOCASE\"\n        \" ORDER BY category COLLATE NOCASE\"\n    ).fetchall()\n    return jsonify({\"items\": [r[\"category\"] for r in rows]})\n\n\n@app.get(\"/api/recipes/<int:recipe_id>\")\ndef get_recipe(recipe_id):\n    row = fetch_recipe(recipe_id)\n    if row is None:\n        return error(404, \"Recipe not found\")\n    return jsonify(full_recipe(row))\n\n\n@app.put(\"/api/recipes/<int:recipe_id>\")\ndef update_recipe(recipe_id):\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    row = fetch_recipe(recipe_id)\n    if row is None:\n        return error(404, \"Recipe not found\")\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(403, \"Only the author may change this recipe\")\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    clean, errors = validate_recipe(data)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    conn = db()\n    conn.execute(\n        \"UPDATE recipes SET title = ?, ingredients = ?, instructions = ?, category = ?,\"\n        \" prep_minutes = ?, servings = ? WHERE id = ?\",\n        (\n            clean[\"title\"],\n            json.dumps(clean[\"ingredients\"]),\n            clean[\"instructions\"],\n            clean[\"category\"],\n            clean[\"prep_minutes\"],\n            clean[\"servings\"],\n            recipe_id,\n        ),\n    )\n    conn.commit()\n    return jsonify(full_recipe(fetch_recipe(recipe_id)))\n\n\n@app.delete(\"/api/recipes/<int:recipe_id>\")\ndef delete_recipe(recipe_id):\n    user = current_user()\n    if user is None:\n        return error(401, \"Authentication required\")\n    row = fetch_recipe(recipe_id)\n    if row is None:\n        return error(404, \"Recipe not found\")\n    if row[\"author_id\"] != user[\"id\"]:\n        return error(403, \"Only the author may delete this recipe\")\n    conn = db()\n    conn.execute(\"DELETE FROM recipes WHERE id = ?\", (recipe_id,))\n    conn.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(404, \"Not found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF\ncd frontend && npm i react-router-dom 2>&1 | tail -2; npm i -D tailwindcss @tailwindcss/vite typescript @types/react @types/react-dom 2>&1 | tail -3; cat package.json","time":{"start":1794255195785,"end":1794255262596}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f18e6f001flZhGUhrbnqvk1","sessionID":"ses_e3e0f4b79ffejWLifipYfahxAx","messageID":"msg_1c1f0d779001MOCATmyIg3thtf"}}
