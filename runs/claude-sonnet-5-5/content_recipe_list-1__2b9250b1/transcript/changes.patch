+                        s["category"],
+                        s["prep_minutes"],
+                        s["servings"],
+                        created,
+                        chef_id,
+                    ),
+                )
+            conn.execute("INSERT INTO meta (key, value) VALUES ('seeded', '1')")
+        conn.commit()
+    finally:
+        conn.close()
