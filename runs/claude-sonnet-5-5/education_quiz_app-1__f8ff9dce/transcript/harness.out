{"type":"tool_use","timestamp":1794251604558,"sessionID":"ses_e3e4800c2ffemNbR5gW8Txq5U0","part":{"type":"tool","tool":"bash","callID":"toolu_01BHEidjQwwPAzQtj9i3jNih","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"types\": []\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/<title>App<\\/title>/<title>Quiz<\\/title>/' index.html\nmkdir -p src\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Letter = \"A\" | \"B\" | \"C\" | \"D\";\nexport const LETTERS: Letter[] = [\"A\", \"B\", \"C\", \"D\"];\n\nexport interface QuizQuestion {\n  id: number;\n  text: string;\n  option_a: string;\n  option_b: string;\n  option_c: string;\n  option_d: string;\n}\n\nexport interface Question extends QuizQuestion {\n  correct_option: Letter;\n}\n\nexport interface ReviewItem extends QuizQuestion {\n  question_id: number;\n  selected: Letter;\n  correct_option: Letter;\n  is_correct: boolean;\n}\n\nexport interface Attempt {\n  id: number | null;\n  score: number;\n  correct: number;\n  total_questions: number;\n  submitted_at: string;\n  answers: ReviewItem[];\n}\n\nexport interface Me {\n  username: string;\n  is_admin: boolean;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n  constructor(message: string, status: number, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"quiz_token\";\n\nexport const getToken = () => localStorage.getItem(TOKEN_KEY);\nexport const setToken = (t: string | null) =>\n  t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY);\n\nexport async function api<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token && options.auth !== false) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n    });\n  } catch {\n    throw new ApiError(\"Network error, please try again\", 0);\n  }\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    throw new ApiError(data?.error ?? `Request failed (${res.status})`, res.status, data?.errors ?? {});\n  }\n  return data as T;\n}\n\nexport const optionText = (q: QuizQuestion, l: Letter): string =>\n  q[`option_${l.toLowerCase()}` as \"option_a\"];\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { ApiError, Attempt, Me, api, getToken, setToken } from \"./api\";\nimport AuthForms from \"./components/AuthForms\";\nimport QuizView from \"./components/QuizView\";\nimport ResultView from \"./components/ResultView\";\nimport HistoryView from \"./components/HistoryView\";\nimport AdminView from \"./components/AdminView\";\nimport { btnPrimary, btnSecondary } from \"./ui\";\n\ntype View = \"home\" | \"quiz\" | \"result\" | \"history\" | \"attempt\" | \"admin\" | \"auth\";\n\nexport default function App() {\n  const [me, setMe] = useState<Me | null>(null);\n  const [ready, setReady] = useState(false);\n  const [view, setView] = useState<View>(\"home\");\n  const [result, setResult] = useState<Attempt | null>(null);\n\n  useEffect(() => {\n    if (!getToken()) {\n      setReady(true);\n      return;\n    }\n    api<Me>(\"/auth/me\")\n      .then(setMe)\n      .catch((e) => {\n        if (e instanceof ApiError && e.status === 401) setToken(null);\n      })\n      .finally(() => setReady(true));\n  }, []);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setMe(null);\n    setResult(null);\n    setView(\"home\");\n  }, []);\n\n  const onSignedIn = async () => {\n    const info = await api<Me>(\"/auth/me\");\n    setMe(info);\n    setView(\"home\");\n  };\n\n  const nav = (v: View) => () => setView(v);\n\n  if (!ready) return <div className=\"p-8 text-center text-slate-500\">Loading…</div>;\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-3xl flex-wrap items-center gap-3 px-4 py-3\">\n          <button onClick={nav(\"home\")} className=\"text-lg font-bold text-indigo-700\">\n            Quiz\n          </button>\n          <nav className=\"flex flex-1 flex-wrap gap-2 text-sm\">\n            {me && (\n              <button onClick={nav(\"history\")} className=\"rounded px-2 py-1 hover:bg-slate-100\">\n                My attempts\n              </button>\n            )}\n            {me?.is_admin && (\n              <button onClick={nav(\"admin\")} className=\"rounded px-2 py-1 hover:bg-slate-100\">\n                Admin\n              </button>\n            )}\n          </nav>\n          {me ? (\n            <div className=\"flex items-center gap-3 text-sm\">\n              <span>\n                Signed in as <strong data-testid=\"username\">{me.username}</strong>\n              </span>\n              <button onClick={signOut} className={btnSecondary}>\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <button onClick={nav(\"auth\")} className={btnSecondary}>\n              Sign in / Register\n            </button>\n          )}\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-3xl px-4 py-6\">\n        {view === \"home\" && (\n          <section className=\"rounded-lg bg-white p-6 text-center shadow\">\n            <h1 className=\"mb-2 text-2xl font-bold\">General knowledge quiz</h1>\n            <p className=\"mb-6 text-slate-600\">Answer 5 random multiple-choice questions.</p>\n            <button onClick={nav(\"quiz\")} className={btnPrimary}>\n              Start quiz\n            </button>\n          </section>\n        )}\n        {view === \"quiz\" && (\n          <QuizView\n            signedIn={!!me}\n            onSessionExpired={signOut}\n            onDone={(r) => {\n              setResult(r);\n              setView(\"result\");\n            }}\n          />\n        )}\n        {view === \"result\" && result && (\n          <ResultView\n            attempt={result}\n            signedIn={!!me}\n            onSignIn={nav(\"auth\")}\n            onAgain={nav(\"quiz\")}\n          />\n        )}\n        {view === \"history\" && me && <HistoryView onExpired={signOut} />}\n        {view === \"admin\" && me?.is_admin && <AdminView onExpired={signOut} />}\n        {view === \"auth\" && !me && <AuthForms onSignedIn={onSignedIn} />}\n      </main>\n    </div>\n  );\n}\nEOF\ncat > src/ui.ts <<'EOF'\nexport const btnPrimary =\n  \"rounded bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\";\nexport const btnSecondary =\n  \"rounded border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-slate-100 disabled:opacity-50\";\nexport const inputCls =\n  \"w-full rounded border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const cardCls = \"rounded-lg bg-white p-6 shadow\";\n\nexport const formatDate = (iso: string) => new Date(iso).toLocaleString();\nEOF\nmkdir -p src/components\ncat > src/components/AuthForms.tsx <<'EOF'\nimport { FormEvent, useState } from \"react\";\nimport { ApiError, api, setToken } from \"../api\";\nimport { btnPrimary, cardCls, inputCls } from \"../ui\";\n\nfunction Form({\n  mode,\n  onSignedIn,\n  onRegistered,\n}: {\n  mode: \"login\" | \"register\";\n  onSignedIn: () => Promise<void>;\n  onRegistered?: () => void;\n}) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setMessage(null);\n    setFieldErrors({});\n    try {\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username, password }, auth: false });\n      }\n      const { token } = await api<{ token: string }>(\"/auth/login\", {\n        method: \"POST\",\n        body: { username, password },\n        auth: false,\n      });\n      setToken(token);\n      await onSignedIn();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFieldErrors(err.errors);\n        setMessage(Object.keys(err.errors).length ? null : err.message);\n      } else {\n        setMessage(\"Something went wrong\");\n      }\n      setBusy(false);\n    }\n    void onRegistered;\n  };\n\n  const id = mode;\n  return (\n    <form onSubmit={submit} className={`${cardCls} space-y-4`} aria-label={mode === \"login\" ? \"Sign in\" : \"Register\"}>\n      <h2 className=\"text-xl font-bold\">{mode === \"login\" ? \"Sign in\" : \"Register\"}</h2>\n      <div>\n        <label htmlFor={`${id}-username`} className=\"mb-1 block text-sm font-medium\">\n          Username\n        </label>\n        <input\n          id={`${id}-username`}\n          name=\"username\"\n          className={inputCls}\n          value={username}\n          onChange={(e) => setUsername(e.target.value)}\n          autoComplete=\"username\"\n          required\n        />\n        {fieldErrors.username && <p className=\"mt-1 text-sm text-red-600\">{fieldErrors.username}</p>}\n      </div>\n      <div>\n        <label htmlFor={`${id}-password`} className=\"mb-1 block text-sm font-medium\">\n          Password\n        </label>\n        <input\n          id={`${id}-password`}\n          name=\"password\"\n          type=\"password\"\n          className={inputCls}\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n          required\n        />\n        {fieldErrors.password && <p className=\"mt-1 text-sm text-red-600\">{fieldErrors.password}</p>}\n      </div>\n      {message && (\n        <p role=\"alert\" className=\"text-sm text-red-600\">\n          {message}\n        </p>\n      )}\n      <button type=\"submit\" disabled={busy} className={btnPrimary}>\n        {mode === \"login\" ? \"Sign in\" : \"Register\"}\n      </button>\n    </form>\n  );\n}\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: () => Promise<void> }) {\n  return (\n    <div className=\"grid gap-6 md:grid-cols-2\">\n      <Form mode=\"login\" onSignedIn={onSignedIn} />\n      <Form mode=\"register\" onSignedIn={onSignedIn} />\n    </div>\n  );\n}\nEOF\ncat > src/components/QuizView.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { ApiError, Attempt, LETTERS, Letter, QuizQuestion, api, getToken, optionText } from \"../api\";\nimport { btnPrimary, btnSecondary, cardCls } from \"../ui\";\n\nexport default function QuizView({\n  signedIn,\n  onDone,\n  onSessionExpired,\n}: {\n  signedIn: boolean;\n  onDone: (a: Attempt) => void;\n  onSessionExpired: () => void;\n}) {\n  const [questions, setQuestions] = useState<QuizQuestion[] | null>(null);\n  const [index, setIndex] = useState(0);\n  const [answers, setAnswers] = useState<Record<number, Letter>>({});\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    let live = true;\n    api<{ items: QuizQuestion[] }>(\"/quiz?count=5\", { auth: false })\n      .then((d) => live && setQuestions(d.items))\n      .catch((e) => live && setError(e.message));\n    return () => {\n      live = false;\n    };\n  }, []);\n\n  if (error && !questions) return <p role=\"alert\" className=\"text-red-600\">{error}</p>;\n  if (!questions) return <p className=\"text-slate-500\">Loading…</p>;\n  if (questions.length === 0) return <p>No questions available.</p>;\n\n  const q = questions[index];\n  const last = index === questions.length - 1;\n  const selected = answers[q.id];\n\n  const submit = async () => {\n    setBusy(true);\n    setError(null);\n    const body = {\n      answers: questions.map((x) => ({ question_id: x.id, selected: answers[x.id] })),\n    };\n    try {\n      const result = await api<Attempt>(\"/attempts\", { method: \"POST\", body });\n      onDone(result);\n    } catch (e) {\n      if (e instanceof ApiError && e.status === 401 && getToken()) {\n        onSessionExpired();\n        return;\n      }\n      setError(e instanceof Error ? e.message : \"Something went wrong\");\n      setBusy(false);\n    }\n  };\n\n  return (\n    <section className={cardCls}>\n      <p className=\"mb-2 text-sm font-medium text-slate-500\" data-testid=\"progress\">\n        Question {index + 1} of {questions.length}\n      </p>\n      <div className=\"mb-4 h-2 overflow-hidden rounded bg-slate-200\">\n        <div className=\"h-full bg-indigo-600\" style={{ width: `${((index + 1) / questions.length) * 100}%` }} />\n      </div>\n      <fieldset>\n        <legend className=\"mb-4 text-lg font-semibold\">{q.text}</legend>\n        <div className=\"space-y-2\">\n          {LETTERS.map((l) => (\n            <label\n              key={l}\n              className={`flex cursor-pointer items-center gap-3 rounded border px-3 py-2 hover:bg-slate-50 ${\n                selected === l ? \"border-indigo-600 bg-indigo-50\" : \"border-slate-300\"\n              }`}\n            >\n              <input\n                type=\"radio\"\n                name={`question-${q.id}`}\n                value={l}\n                checked={selected === l}\n                onChange={() => setAnswers({ ...answers, [q.id]: l })}\n              />\n              <span>{optionText(q, l)}</span>\n            </label>\n          ))}\n        </div>\n      </fieldset>\n      {error && <p role=\"alert\" className=\"mt-3 text-sm text-red-600\">{error}</p>}\n      <div className=\"mt-6 flex justify-between\">\n        <button\n          className={btnSecondary}\n          disabled={index === 0 || busy}\n          onClick={() => setIndex(index - 1)}\n        >\n          Back\n        </button>\n        {last ? (\n          <button className={btnPrimary} disabled={!selected || busy} onClick={submit}>\n            Submit\n          </button>\n        ) : (\n          <button className={btnPrimary} disabled={!selected} onClick={() => setIndex(index + 1)}>\n            Next\n          </button>\n        )}\n      </div>\n      <span className=\"hidden\">{signedIn ? \"\" : \"\"}</span>\n    </section>\n  );\n}\nEOF\ncat > src/components/ReviewList.tsx <<'EOF'\nimport { LETTERS, ReviewItem, optionText } from \"../api\";\n\nexport default function ReviewList({ items }: { items: ReviewItem[] }) {\n  return (\n    <ol className=\"space-y-4\">\n      {items.map((it, i) => (\n        <li key={`${it.question_id}-${i}`} className=\"rounded border border-slate-200 p-4\">\n          <p className=\"mb-2 font-semibold\">\n            {i + 1}. {it.text}{\" \"}\n            <span className={it.is_correct ? \"text-green-700\" : \"text-red-700\"}>\n              {it.is_correct ? \"Correct\" : \"Incorrect\"}\n            </span>\n          </p>\n          <ul className=\"space-y-1\">\n            {LETTERS.map((l) => {\n              const chosen = it.selected === l;\n              const correct = it.correct_option === l;\n              const cls = correct\n                ? \"border-green-600 bg-green-50\"\n                : chosen\n                  ? \"border-red-600 bg-red-50\"\n                  : \"border-slate-200\";\n              return (\n                <li key={l} className={`flex flex-wrap items-center gap-2 rounded border px-3 py-1.5 ${cls}`}>\n                  <span className=\"font-mono text-sm\">{l}.</span>\n                  <span>{optionText(it, l)}</span>\n                  {chosen && (\n                    <span className=\"ml-auto rounded bg-slate-700 px-2 text-xs text-white\">Your answer</span>\n                  )}\n                  {correct && (\n                    <span className=\"rounded bg-green-700 px-2 text-xs text-white\">Correct answer</span>\n                  )}\n                </li>\n              );\n            })}\n          </ul>\n        </li>\n      ))}\n    </ol>\n  );\n}\nEOF\ncat > src/components/ResultView.tsx <<'EOF'\nimport { Attempt } from \"../api\";\nimport { btnPrimary, cardCls } from \"../ui\";\nimport ReviewList from \"./ReviewList\";\n\nexport default function ResultView({\n  attempt,\n  signedIn,\n  onSignIn,\n  onAgain,\n  onBack,\n}: {\n  attempt: Attempt;\n  signedIn?: boolean;\n  onSignIn?: () => void;\n  onAgain?: () => void;\n  onBack?: () => void;\n}) {\n  return (\n    <section className={`${cardCls} space-y-4`}>\n      <h2 className=\"text-xl font-bold\">Result</h2>\n      <p className=\"text-3xl font-bold text-indigo-700\" data-testid=\"score\">\n        Score: {attempt.score}%\n      </p>\n      <p data-testid=\"correct\">\n        {attempt.correct} of {attempt.total_questions} correct\n      </p>\n      {signedIn === false && (\n        <div className=\"rounded border border-amber-300 bg-amber-50 p-3\">\n          <button onClick={onSignIn} className=\"font-medium text-indigo-700 underline\">\n            Sign in to save your results\n          </button>\n        </div>\n      )}\n      <ReviewList items={attempt.answers} />\n      <div className=\"flex gap-3\">\n        {onAgain && (\n          <button className={btnPrimary} onClick={onAgain}>\n            Take another quiz\n          </button>\n        )}\n        {onBack && (\n          <button className={btnPrimary} onClick={onBack}>\n            Back to attempts\n          </button>\n        )}\n      </div>\n    </section>\n  );\n}\nEOF\ncat > src/components/HistoryView.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { ApiError, Attempt, api } from \"../api\";\nimport { btnSecondary, cardCls, formatDate } from \"../ui\";\nimport ResultView from \"./ResultView\";\n\nexport default function HistoryView({ onExpired }: { onExpired: () => void }) {\n  const [items, setItems] = useState<Attempt[] | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [open, setOpen] = useState<Attempt | null>(null);\n\n  useEffect(() => {\n    api<{ items: Attempt[] }>(\"/attempts\")\n      .then((d) => setItems(d.items))\n      .catch((e) => {\n        if (e instanceof ApiError && e.status === 401) onExpired();\n        else setError(e.message);\n      });\n  }, [onExpired]);\n\n  const openAttempt = async (id: number) => {\n    try {\n      setOpen(await api<Attempt>(`/attempts/${id}`));\n    } catch (e) {\n      if (e instanceof ApiError && e.status === 401) onExpired();\n      else setError(e instanceof Error ? e.message : \"Something went wrong\");\n    }\n  };\n\n  if (open) return <ResultView attempt={open} onBack={() => setOpen(null)} />;\n  if (error) return <p role=\"alert\" className=\"text-red-600\">{error}</p>;\n  if (!items) return <p className=\"text-slate-500\">Loading…</p>;\n\n  return (\n    <section className={cardCls}>\n      <h2 className=\"mb-4 text-xl font-bold\">My attempts</h2>\n      {items.length === 0 ? (\n        <p className=\"text-slate-600\">No saved attempts yet.</p>\n      ) : (\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr className=\"border-b border-slate-200\">\n              <th className=\"py-2\">Date</th>\n              <th>Score</th>\n              <th>Questions</th>\n              <th />\n            </tr>\n          </thead>\n          <tbody>\n            {items.map((a) => (\n              <tr key={a.id} className=\"border-b border-slate-100\">\n                <td className=\"py-2\">{formatDate(a.submitted_at)}</td>\n                <td>\n                  {a.score}% ({a.correct}/{a.total_questions})\n                </td>\n                <td>{a.total_questions}</td>\n                <td className=\"text-right\">\n                  <button className={btnSecondary} onClick={() => openAttempt(a.id!)}>\n                    Open\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      )}\n    </section>\n  );\n}\nEOF\ncat > src/components/AdminView.tsx <<'EOF'\nimport { FormEvent, useCallback, useEffect, useState } from \"react\";\nimport { ApiError, LETTERS, Question, api } from \"../api\";\nimport { btnPrimary, btnSecondary, cardCls, inputCls } from \"../ui\";\n\ninterface Page {\n  items: Question[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst PAGE_SIZE = 10;\nconst empty = { text: \"\", option_a: \"\", option_b: \"\", option_c: \"\", option_d: \"\", correct_option: \"A\" };\n\nexport default function AdminView({ onExpired }: { onExpired: () => void }) {\n  const [form, setForm] = useState(empty);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState<string | null>(null);\n  const [success, setSuccess] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [loadError, setLoadError] = useState<string | null>(null);\n\n  const load = useCallback(\n    async (p: number) => {\n      try {\n        setData(await api<Page>(`/admin/questions?page=${p}&page_size=${PAGE_SIZE}`));\n        setLoadError(null);\n      } catch (e) {\n        if (e instanceof ApiError && e.status === 401) onExpired();\n        else setLoadError(e instanceof Error ? e.message : \"Something went wrong\");\n      }\n    },\n    [onExpired],\n  );\n\n  useEffect(() => {\n    load(page);\n  }, [load, page]);\n\n  const set = (k: string, v: string) => setForm((f) => ({ ...f, [k]: v }));\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setErrors({});\n    setMessage(null);\n    setSuccess(null);\n    try {\n      await api(\"/admin/questions\", { method: \"POST\", body: form });\n      setForm(empty);\n      setSuccess(\"Question added\");\n      await load(page);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        if (err.status === 401) return onExpired();\n        setErrors(err.errors);\n        if (!Object.keys(err.errors).length) setMessage(err.message);\n      } else setMessage(\"Something went wrong\");\n    }\n    setBusy(false);\n  };\n\n  const fieldErr = (k: string) =>\n    errors[k] ? <p className=\"mt-1 text-sm text-red-600\">{errors[k]}</p> : null;\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-6\">\n      <form onSubmit={submit} className={`${cardCls} space-y-3`} aria-label=\"Add question\">\n        <h2 className=\"text-xl font-bold\">Add question</h2>\n        <div>\n          <label htmlFor=\"q-text\" className=\"mb-1 block text-sm font-medium\">Question</label>\n          <input id=\"q-text\" className={inputCls} value={form.text} onChange={(e) => set(\"text\", e.target.value)} />\n          {fieldErr(\"text\")}\n        </div>\n        {LETTERS.map((l) => {\n          const k = `option_${l.toLowerCase()}`;\n          return (\n            <div key={k}>\n              <label htmlFor={`q-${k}`} className=\"mb-1 block text-sm font-medium\">Option {l}</label>\n              <input\n                id={`q-${k}`}\n                className={inputCls}\n                value={(form as Record<string, string>)[k]}\n                onChange={(e) => set(k, e.target.value)}\n              />\n              {fieldErr(k)}\n            </div>\n          );\n        })}\n        <div>\n          <label htmlFor=\"q-correct\" className=\"mb-1 block text-sm font-medium\">Correct option</label>\n          <select\n            id=\"q-correct\"\n            className={inputCls}\n            value={form.correct_option}\n            onChange={(e) => set(\"correct_option\", e.target.value)}\n          >\n            {LETTERS.map((l) => (\n              <option key={l} value={l}>{l}</option>\n            ))}\n          </select>\n          {fieldErr(\"correct_option\")}\n        </div>\n        {message && <p role=\"alert\" className=\"text-sm text-red-600\">{message}</p>}\n        {success && <p role=\"status\" className=\"text-sm text-green-700\">{success}</p>}\n        <button type=\"submit\" disabled={busy} className={btnPrimary}>Add question</button>\n      </form>\n\n      <section className={cardCls}>\n        <h2 className=\"mb-4 text-xl font-bold\">Questions {data && `(${data.total})`}</h2>\n        {loadError && <p role=\"alert\" className=\"text-red-600\">{loadError}</p>}\n        <ul className=\"space-y-3\">\n          {data?.items.map((q) => (\n            <li key={q.id} className=\"rounded border border-slate-200 p-3 text-sm\">\n              <p className=\"font-semibold\">{q.id}. {q.text}</p>\n              <ul className=\"mt-1 grid gap-1 sm:grid-cols-2\">\n                {LETTERS.map((l) => (\n                  <li key={l} className={q.correct_option === l ? \"font-semibold text-green-700\" : \"\"}>\n                    {l}. {q[`option_${l.toLowerCase()}` as \"option_a\"]}\n                    {q.correct_option === l && \" (correct)\"}\n                  </li>\n                ))}\n              </ul>\n            </li>\n          ))}\n        </ul>\n        <div className=\"mt-4 flex items-center justify-between\">\n          <button className={btnSecondary} disabled={page <= 1} onClick={() => setPage(page - 1)}>Previous</button>\n          <span className=\"text-sm text-slate-600\">Page {page} of {pages}</span>\n          <button className={btnSecondary} disabled={page >= pages} onClick={() => setPage(page + 1)}>Next page</button>\n        </div>\n      </section>\n    </div>\n  );\n}\nEOF\nnpx tsc --noEmit -p . 2>&1 | head -20; npm run build 2>&1 | tail -8"},"output":"src/main.tsx(3,8): error TS2882: Cannot find module or type declarations for side-effect import of './index.css'.\n✓ 24 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.38 kB │ gzip:  0.26 kB\ndist/assets/index-DC3Z7tCU.css   13.64 kB │ gzip:  3.47 kB\ndist/assets/index-BdCisbu8.js   234.21 kB │ gzip: 72.57 kB\n\n✓ built in 426ms\n","metadata":{"output":"src/main.tsx(3,8): error TS2882: Cannot find module or type declarations for side-effect import of './index.css'.\n✓ 24 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.38 kB │ gzip:  0.26 kB\ndist/assets/index-DC3Z7tCU.css   13.64 kB │ gzip:  3.47 kB\ndist/assets/index-BdCisbu8.js   234.21 kB │ gzip: 72.57 kB\n\n✓ built in 426ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"types\": []\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/<title>App<\\/title>/<title>Quiz<\\/title>/' index.html\nmkdir -p src\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Letter = \"A\" | \"B\" | \"C\" | \"D\";\nexport const LETTERS: Letter[] = [\"A\", \"B\", \"C\", \"D\"];\n\nexport interface QuizQuestion {\n  id: number;\n  text: string;\n  option_a: string;\n  option_b: string;\n  option_c: string;\n  option_d: string;\n}\n\nexport interface Question extends QuizQuestion {\n  correct_option: Letter;\n}\n\nexport interface ReviewItem extends QuizQuestion {\n  question_id: number;\n  selected: Letter;\n  correct_option: Letter;\n  is_correct: boolean;\n}\n\nexport interface Attempt {\n  id: number | null;\n  score: number;\n  correct: number;\n  total_questions: number;\n  submitted_at: string;\n  answers: ReviewItem[];\n}\n\nexport interface Me {\n  username: string;\n  is_admin: boolean;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n  constructor(message: string, status: number, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"quiz_token\";\n\nexport const getToken = () => localStorage.getItem(TOKEN_KEY);\nexport const setToken = (t: string | null) =>\n  t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY);\n\nexport async function api<T>(\n  path: string,\n  options: { method?: string; body?: unknown; auth?: boolean } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token && options.auth !== false) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n    });\n  } catch {\n    throw new ApiError(\"Network error, please try again\", 0);\n  }\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    throw new ApiError(data?.error ?? `Request failed (${res.status})`, res.status, data?.errors ?? {});\n  }\n  return data as T;\n}\n\nexport const optionText = (q: QuizQuestion, l: Letter): string =>\n  q[`option_${l.toLowerCase()}` as \"option_a\"];\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { ApiError, Attempt, Me, api, getToken, setToken } from \"./api\";\nimport AuthForms from \"./components/AuthForms\";\nimport QuizView from \"./components/QuizView\";\nimport ResultView from \"./components/ResultView\";\nimport HistoryView from \"./components/HistoryView\";\nimport AdminView from \"./components/AdminView\";\nimport { btnPrimary, btnSecondary } from \"./ui\";\n\ntype View = \"home\" | \"quiz\" | \"result\" | \"history\" | \"attempt\" | \"admin\" | \"auth\";\n\nexport default function App() {\n  const [me, setMe] = useState<Me | null>(null);\n  const [ready, setReady] = useState(false);\n  const [view, setView] = useState<View>(\"home\");\n  const [result, setResult] = useState<Attempt | null>(null);\n\n  useEffect(() => {\n    if (!getToken()) {\n      setReady(true);\n      return;\n    }\n    api<Me>(\"/auth/me\")\n      .then(setMe)\n      .catch((e) => {\n        if (e instanceof ApiError && e.status === 401) setToken(null);\n      })\n      .finally(() => setReady(true));\n  }, []);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    setMe(null);\n    setResult(null);\n    setView(\"home\");\n  }, []);\n\n  const onSignedIn = async () => {\n    const info = await api<Me>(\"/auth/me\");\n    setMe(info);\n    setView(\"home\");\n  };\n\n  const nav = (v: View) => () => setView(v);\n\n  if (!ready) return <div className=\"p-8 text-center text-slate-500\">Loading…</div>;\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-3xl flex-wrap items-center gap-3 px-4 py-3\">\n          <button onClick={nav(\"home\")} className=\"text-lg font-bold text-indigo-700\">\n            Quiz\n          </button>\n          <nav className=\"flex flex-1 flex-wrap gap-2 text-sm\">\n            {me && (\n              <button onClick={nav(\"history\")} className=\"rounded px-2 py-1 hover:bg-slate-100\">\n                My attempts\n              </button>\n            )}\n            {me?.is_admin && (\n              <button onClick={nav(\"admin\")} className=\"rounded px-2 py-1 hover:bg-slate-100\">\n                Admin\n              </button>\n            )}\n          </nav>\n          {me ? (\n            <div className=\"flex items-center gap-3 text-sm\">\n              <span>\n                Signed in as <strong data-testid=\"username\">{me.username}</strong>\n              </span>\n              <button onClick={signOut} className={btnSecondary}>\n                Sign out\n              </button>\n            </div>\n          ) : (\n            <button onClick={nav(\"auth\")} className={btnSecondary}>\n              Sign in / Register\n            </button>\n          )}\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-3xl px-4 py-6\">\n        {view === \"home\" && (\n          <section className=\"rounded-lg bg-white p-6 text-center shadow\">\n            <h1 className=\"mb-2 text-2xl font-bold\">General knowledge quiz</h1>\n            <p className=\"mb-6 text-slate-600\">Answer 5 random multiple-choice questions.</p>\n            <button onClick={nav(\"quiz\")} className={btnPrimary}>\n              Start quiz\n            </button>\n          </section>\n        )}\n        {view === \"quiz\" && (\n          <QuizView\n            signedIn={!!me}\n            onSessionExpired={signOut}\n            onDone={(r) => {\n              setResult(r);\n              setView(\"result\");\n            }}\n          />\n        )}\n        {view === \"result\" && result && (\n          <ResultView\n            attempt={result}\n            signedIn={!!me}\n            onSignIn={nav(\"auth\")}\n            onAgain={nav(\"quiz\")}\n          />\n        )}\n        {view === \"history\" && me && <HistoryView onExpired={signOut} />}\n        {view === \"admin\" && me?.is_admin && <AdminView onExpired={signOut} />}\n        {view === \"auth\" && !me && <AuthForms onSignedIn={onSignedIn} />}\n      </main>\n    </div>\n  );\n}\nEOF\ncat > src/ui.ts <<'EOF'\nexport const btnPrimary =\n  \"rounded bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\";\nexport const btnSecondary =\n  \"rounded border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-slate-100 disabled:opacity-50\";\nexport const inputCls =\n  \"w-full rounded border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const cardCls = \"rounded-lg bg-white p-6 shadow\";\n\nexport const formatDate = (iso: string) => new Date(iso).toLocaleString();\nEOF\nmkdir -p src/components\ncat > src/components/AuthForms.tsx <<'EOF'\nimport { FormEvent, useState } from \"react\";\nimport { ApiError, api, setToken } from \"../api\";\nimport { btnPrimary, cardCls, inputCls } from \"../ui\";\n\nfunction Form({\n  mode,\n  onSignedIn,\n  onRegistered,\n}: {\n  mode: \"login\" | \"register\";\n  onSignedIn: () => Promise<void>;\n  onRegistered?: () => void;\n}) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setMessage(null);\n    setFieldErrors({});\n    try {\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username, password }, auth: false });\n      }\n      const { token } = await api<{ token: string }>(\"/auth/login\", {\n        method: \"POST\",\n        body: { username, password },\n        auth: false,\n      });\n      setToken(token);\n      await onSignedIn();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFieldErrors(err.errors);\n        setMessage(Object.keys(err.errors).length ? null : err.message);\n      } else {\n        setMessage(\"Something went wrong\");\n      }\n      setBusy(false);\n    }\n    void onRegistered;\n  };\n\n  const id = mode;\n  return (\n    <form onSubmit={submit} className={`${cardCls} space-y-4`} aria-label={mode === \"login\" ? \"Sign in\" : \"Register\"}>\n      <h2 className=\"text-xl font-bold\">{mode === \"login\" ? \"Sign in\" : \"Register\"}</h2>\n      <div>\n        <label htmlFor={`${id}-username`} className=\"mb-1 block text-sm font-medium\">\n          Username\n        </label>\n        <input\n          id={`${id}-username`}\n          name=\"username\"\n          className={inputCls}\n          value={username}\n          onChange={(e) => setUsername(e.target.value)}\n          autoComplete=\"username\"\n          required\n        />\n        {fieldErrors.username && <p className=\"mt-1 text-sm text-red-600\">{fieldErrors.username}</p>}\n      </div>\n      <div>\n        <label htmlFor={`${id}-password`} className=\"mb-1 block text-sm font-medium\">\n          Password\n        </label>\n        <input\n          id={`${id}-password`}\n          name=\"password\"\n          type=\"password\"\n          className={inputCls}\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n          required\n        />\n        {fieldErrors.password && <p className=\"mt-1 text-sm text-red-600\">{fieldErrors.password}</p>}\n      </div>\n      {message && (\n        <p role=\"alert\" className=\"text-sm text-red-600\">\n          {message}\n        </p>\n      )}\n      <button type=\"submit\" disabled={busy} className={btnPrimary}>\n        {mode === \"login\" ? \"Sign in\" : \"Register\"}\n      </button>\n    </form>\n  );\n}\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: () => Promise<void> }) {\n  return (\n    <div className=\"grid gap-6 md:grid-cols-2\">\n      <Form mode=\"login\" onSignedIn={onSignedIn} />\n      <Form mode=\"register\" onSignedIn={onSignedIn} />\n    </div>\n  );\n}\nEOF\ncat > src/components/QuizView.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { ApiError, Attempt, LETTERS, Letter, QuizQuestion, api, getToken, optionText } from \"../api\";\nimport { btnPrimary, btnSecondary, cardCls } from \"../ui\";\n\nexport default function QuizView({\n  signedIn,\n  onDone,\n  onSessionExpired,\n}: {\n  signedIn: boolean;\n  onDone: (a: Attempt) => void;\n  onSessionExpired: () => void;\n}) {\n  const [questions, setQuestions] = useState<QuizQuestion[] | null>(null);\n  const [index, setIndex] = useState(0);\n  const [answers, setAnswers] = useState<Record<number, Letter>>({});\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    let live = true;\n    api<{ items: QuizQuestion[] }>(\"/quiz?count=5\", { auth: false })\n      .then((d) => live && setQuestions(d.items))\n      .catch((e) => live && setError(e.message));\n    return () => {\n      live = false;\n    };\n  }, []);\n\n  if (error && !questions) return <p role=\"alert\" className=\"text-red-600\">{error}</p>;\n  if (!questions) return <p className=\"text-slate-500\">Loading…</p>;\n  if (questions.length === 0) return <p>No questions available.</p>;\n\n  const q = questions[index];\n  const last = index === questions.length - 1;\n  const selected = answers[q.id];\n\n  const submit = async () => {\n    setBusy(true);\n    setError(null);\n    const body = {\n      answers: questions.map((x) => ({ question_id: x.id, selected: answers[x.id] })),\n    };\n    try {\n      const result = await api<Attempt>(\"/attempts\", { method: \"POST\", body });\n      onDone(result);\n    } catch (e) {\n      if (e instanceof ApiError && e.status === 401 && getToken()) {\n        onSessionExpired();\n        return;\n      }\n      setError(e instanceof Error ? e.message : \"Something went wrong\");\n      setBusy(false);\n    }\n  };\n\n  return (\n    <section className={cardCls}>\n      <p className=\"mb-2 text-sm font-medium text-slate-500\" data-testid=\"progress\">\n        Question {index + 1} of {questions.length}\n      </p>\n      <div className=\"mb-4 h-2 overflow-hidden rounded bg-slate-200\">\n        <div className=\"h-full bg-indigo-600\" style={{ width: `${((index + 1) / questions.length) * 100}%` }} />\n      </div>\n      <fieldset>\n        <legend className=\"mb-4 text-lg font-semibold\">{q.text}</legend>\n        <div className=\"space-y-2\">\n          {LETTERS.map((l) => (\n            <label\n              key={l}\n              className={`flex cursor-pointer items-center gap-3 rounded border px-3 py-2 hover:bg-slate-50 ${\n                selected === l ? \"border-indigo-600 bg-indigo-50\" : \"border-slate-300\"\n              }`}\n            >\n              <input\n                type=\"radio\"\n                name={`question-${q.id}`}\n                value={l}\n                checked={selected === l}\n                onChange={() => setAnswers({ ...answers, [q.id]: l })}\n              />\n              <span>{optionText(q, l)}</span>\n            </label>\n          ))}\n        </div>\n      </fieldset>\n      {error && <p role=\"alert\" className=\"mt-3 text-sm text-red-600\">{error}</p>}\n      <div className=\"mt-6 flex justify-between\">\n        <button\n          className={btnSecondary}\n          disabled={index === 0 || busy}\n          onClick={() => setIndex(index - 1)}\n        >\n          Back\n        </button>\n        {last ? (\n          <button className={btnPrimary} disabled={!selected || busy} onClick={submit}>\n            Submit\n          </button>\n        ) : (\n          <button className={btnPrimary} disabled={!selected} onClick={() => setIndex(index + 1)}>\n            Next\n          </button>\n        )}\n      </div>\n      <span className=\"hidden\">{signedIn ? \"\" : \"\"}</span>\n    </section>\n  );\n}\nEOF\ncat > src/components/ReviewList.tsx <<'EOF'\nimport { LETTERS, ReviewItem, optionText } from \"../api\";\n\nexport default function ReviewList({ items }: { items: ReviewItem[] }) {\n  return (\n    <ol className=\"space-y-4\">\n      {items.map((it, i) => (\n        <li key={`${it.question_id}-${i}`} className=\"rounded border border-slate-200 p-4\">\n          <p className=\"mb-2 font-semibold\">\n            {i + 1}. {it.text}{\" \"}\n            <span className={it.is_correct ? \"text-green-700\" : \"text-red-700\"}>\n              {it.is_correct ? \"Correct\" : \"Incorrect\"}\n            </span>\n          </p>\n          <ul className=\"space-y-1\">\n            {LETTERS.map((l) => {\n              const chosen = it.selected === l;\n              const correct = it.correct_option === l;\n              const cls = correct\n                ? \"border-green-600 bg-green-50\"\n                : chosen\n                  ? \"border-red-600 bg-red-50\"\n                  : \"border-slate-200\";\n              return (\n                <li key={l} className={`flex flex-wrap items-center gap-2 rounded border px-3 py-1.5 ${cls}`}>\n                  <span className=\"font-mono text-sm\">{l}.</span>\n                  <span>{optionText(it, l)}</span>\n                  {chosen && (\n                    <span className=\"ml-auto rounded bg-slate-700 px-2 text-xs text-white\">Your answer</span>\n                  )}\n                  {correct && (\n                    <span className=\"rounded bg-green-700 px-2 text-xs text-white\">Correct answer</span>\n                  )}\n                </li>\n              );\n            })}\n          </ul>\n        </li>\n      ))}\n    </ol>\n  );\n}\nEOF\ncat > src/components/ResultView.tsx <<'EOF'\nimport { Attempt } from \"../api\";\nimport { btnPrimary, cardCls } from \"../ui\";\nimport ReviewList from \"./ReviewList\";\n\nexport default function ResultView({\n  attempt,\n  signedIn,\n  onSignIn,\n  onAgain,\n  onBack,\n}: {\n  attempt: Attempt;\n  signedIn?: boolean;\n  onSignIn?: () => void;\n  onAgain?: () => void;\n  onBack?: () => void;\n}) {\n  return (\n    <section className={`${cardCls} space-y-4`}>\n      <h2 className=\"text-xl font-bold\">Result</h2>\n      <p className=\"text-3xl font-bold text-indigo-700\" data-testid=\"score\">\n        Score: {attempt.score}%\n      </p>\n      <p data-testid=\"correct\">\n        {attempt.correct} of {attempt.total_questions} correct\n      </p>\n      {signedIn === false && (\n        <div className=\"rounded border border-amber-300 bg-amber-50 p-3\">\n          <button onClick={onSignIn} className=\"font-medium text-indigo-700 underline\">\n            Sign in to save your results\n          </button>\n        </div>\n      )}\n      <ReviewList items={attempt.answers} />\n      <div className=\"flex gap-3\">\n        {onAgain && (\n          <button className={btnPrimary} onClick={onAgain}>\n            Take another quiz\n          </button>\n        )}\n        {onBack && (\n          <button className={btnPrimary} onClick={onBack}>\n            Back to attempts\n          </button>\n        )}\n      </div>\n    </section>\n  );\n}\nEOF\ncat > src/components/HistoryView.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { ApiError, Attempt, api } from \"../api\";\nimport { btnSecondary, cardCls, formatDate } from \"../ui\";\nimport ResultView from \"./ResultView\";\n\nexport default function HistoryView({ onExpired }: { onExpired: () => void }) {\n  const [items, setItems] = useState<Attempt[] | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [open, setOpen] = useState<Attempt | null>(null);\n\n  useEffect(() => {\n    api<{ items: Attempt[] }>(\"/attempts\")\n      .then((d) => setItems(d.items))\n      .catch((e) => {\n        if (e instanceof ApiError && e.status === 401) onExpired();\n        else setError(e.message);\n      });\n  }, [onExpired]);\n\n  const openAttempt = async (id: number) => {\n    try {\n      setOpen(await api<Attempt>(`/attempts/${id}`));\n    } catch (e) {\n      if (e instanceof ApiError && e.status === 401) onExpired();\n      else setError(e instanceof Error ? e.message : \"Something went wrong\");\n    }\n  };\n\n  if (open) return <ResultView attempt={open} onBack={() => setOpen(null)} />;\n  if (error) return <p role=\"alert\" className=\"text-red-600\">{error}</p>;\n  if (!items) return <p className=\"text-slate-500\">Loading…</p>;\n\n  return (\n    <section className={cardCls}>\n      <h2 className=\"mb-4 text-xl font-bold\">My attempts</h2>\n      {items.length === 0 ? (\n        <p className=\"text-slate-600\">No saved attempts yet.</p>\n      ) : (\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr className=\"border-b border-slate-200\">\n              <th className=\"py-2\">Date</th>\n              <th>Score</th>\n              <th>Questions</th>\n              <th />\n            </tr>\n          </thead>\n          <tbody>\n            {items.map((a) => (\n              <tr key={a.id} className=\"border-b border-slate-100\">\n                <td className=\"py-2\">{formatDate(a.submitted_at)}</td>\n                <td>\n                  {a.score}% ({a.correct}/{a.total_questions})\n                </td>\n                <td>{a.total_questions}</td>\n                <td className=\"text-right\">\n                  <button className={btnSecondary} onClick={() => openAttempt(a.id!)}>\n                    Open\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      )}\n    </section>\n  );\n}\nEOF\ncat > src/components/AdminView.tsx <<'EOF'\nimport { FormEvent, useCallback, useEffect, useState } from \"react\";\nimport { ApiError, LETTERS, Question, api } from \"../api\";\nimport { btnPrimary, btnSecondary, cardCls, inputCls } from \"../ui\";\n\ninterface Page {\n  items: Question[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nconst PAGE_SIZE = 10;\nconst empty = { text: \"\", option_a: \"\", option_b: \"\", option_c: \"\", option_d: \"\", correct_option: \"A\" };\n\nexport default function AdminView({ onExpired }: { onExpired: () => void }) {\n  const [form, setForm] = useState(empty);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState<string | null>(null);\n  const [success, setSuccess] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [loadError, setLoadError] = useState<string | null>(null);\n\n  const load = useCallback(\n    async (p: number) => {\n      try {\n        setData(await api<Page>(`/admin/questions?page=${p}&page_size=${PAGE_SIZE}`));\n        setLoadError(null);\n      } catch (e) {\n        if (e instanceof ApiError && e.status === 401) onExpired();\n        else setLoadError(e instanceof Error ? e.message : \"Something went wrong\");\n      }\n    },\n    [onExpired],\n  );\n\n  useEffect(() => {\n    load(page);\n  }, [load, page]);\n\n  const set = (k: string, v: string) => setForm((f) => ({ ...f, [k]: v }));\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setErrors({});\n    setMessage(null);\n    setSuccess(null);\n    try {\n      await api(\"/admin/questions\", { method: \"POST\", body: form });\n      setForm(empty);\n      setSuccess(\"Question added\");\n      await load(page);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        if (err.status === 401) return onExpired();\n        setErrors(err.errors);\n        if (!Object.keys(err.errors).length) setMessage(err.message);\n      } else setMessage(\"Something went wrong\");\n    }\n    setBusy(false);\n  };\n\n  const fieldErr = (k: string) =>\n    errors[k] ? <p className=\"mt-1 text-sm text-red-600\">{errors[k]}</p> : null;\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-6\">\n      <form onSubmit={submit} className={`${cardCls} space-y-3`} aria-label=\"Add question\">\n        <h2 className=\"text-xl font-bold\">Add question</h2>\n        <div>\n          <label htmlFor=\"q-text\" className=\"mb-1 block text-sm font-medium\">Question</label>\n          <input id=\"q-text\" className={inputCls} value={form.text} onChange={(e) => set(\"text\", e.target.value)} />\n          {fieldErr(\"text\")}\n        </div>\n        {LETTERS.map((l) => {\n          const k = `option_${l.toLowerCase()}`;\n          return (\n            <div key={k}>\n              <label htmlFor={`q-${k}`} className=\"mb-1 block text-sm font-medium\">Option {l}</label>\n              <input\n                id={`q-${k}`}\n                className={inputCls}\n                value={(form as Record<string, string>)[k]}\n                onChange={(e) => set(k, e.target.value)}\n              />\n              {fieldErr(k)}\n            </div>\n          );\n        })}\n        <div>\n          <label htmlFor=\"q-correct\" className=\"mb-1 block text-sm font-medium\">Correct option</label>\n          <select\n            id=\"q-correct\"\n            className={inputCls}\n            value={form.correct_option}\n            onChange={(e) => set(\"correct_option\", e.target.value)}\n          >\n            {LETTERS.map((l) => (\n              <option key={l} value={l}>{l}</option>\n            ))}\n          </select>\n          {fieldErr(\"correct_option\")}\n        </div>\n        {message && <p role=\"alert\" className=\"text-sm text-red-600\">{message}</p>}\n        {success && <p role=\"status\" className=\"text-sm text-green-700\">{success}</p>}\n        <button type=\"submit\" disabled={busy} className={btnPrimary}>Add question</button>\n      </form>\n\n      <section className={cardCls}>\n        <h2 className=\"mb-4 text-xl font-bold\">Questions {data && `(${data.total})`}</h2>\n        {loadError && <p role=\"alert\" className=\"text-red-600\">{loadError}</p>}\n        <ul className=\"space-y-3\">\n          {data?.items.map((q) => (\n            <li key={q.id} className=\"rounded border border-slate-200 p-3 text-sm\">\n              <p className=\"font-semibold\">{q.id}. {q.text}</p>\n              <ul className=\"mt-1 grid gap-1 sm:grid-cols-2\">\n                {LETTERS.map((l) => (\n                  <li key={l} className={q.correct_option === l ? \"font-semibold text-green-700\" : \"\"}>\n                    {l}. {q[`option_${l.toLowerCase()}` as \"option_a\"]}\n                    {q.correct_option === l && \" (correct)\"}\n                  </li>\n                ))}\n              </ul>\n            </li>\n          ))}\n        </ul>\n        <div className=\"mt-4 flex items-center justify-between\">\n          <button className={btnSecondary} disabled={page <= 1} onClick={() => setPage(page - 1)}>Previous</button>\n          <span className=\"text-sm text-slate-600\">Page {page} of {pages}</span>\n          <button className={btnSecondary} disabled={page >= pages} onClick={() => setPage(page + 1)}>Next page</button>\n        </div>\n      </section>\n    </div>\n  );\n}\nEOF\nnpx tsc --noEmit -p . 2>&1 | head -20; npm run build 2>&1 | tail -8","time":{"start":1794251602087,"end":1794251604515}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1bab899001x7voxNTUQPakZ1","sessionID":"ses_e3e4800c2ffemNbR5gW8Txq5U0","messageID":"msg_1c1b9ed6c001rJaQBF7HAMllxz"}}
