{"type":"tool_use","timestamp":1794251509864,"sessionID":"ses_e3e4800c2ffemNbR5gW8Txq5U0","part":{"type":"tool","tool":"bash","callID":"toolu_01SmC8UdYmX2VdYTCXexDnfy","state":{"status":"completed","input":{"command":"mkdir -p /workspace/backend && cat > /workspace/backend/seed.py <<'EOF'\nQUESTIONS = [\n    (\"What is the capital of France?\", \"Berlin\", \"Madrid\", \"Paris\", \"Rome\", \"C\"),\n    (\"Which planet is known as the Red Planet?\", \"Mars\", \"Venus\", \"Jupiter\", \"Mercury\", \"A\"),\n    (\"How many continents are there on Earth?\", \"Five\", \"Six\", \"Eight\", \"Seven\", \"D\"),\n    (\"What is the largest ocean on Earth?\", \"Atlantic Ocean\", \"Pacific Ocean\", \"Indian Ocean\", \"Arctic Ocean\", \"B\"),\n    (\"Who painted the Mona Lisa?\", \"Vincent van Gogh\", \"Pablo Picasso\", \"Leonardo da Vinci\", \"Claude Monet\", \"C\"),\n    (\"What is the chemical symbol for water?\", \"H2O\", \"CO2\", \"O2\", \"NaCl\", \"A\"),\n    (\"In which year did World War II end?\", \"1918\", \"1939\", \"1945\", \"1950\", \"C\"),\n    (\"Which is the longest river in Africa?\", \"Congo\", \"Niger\", \"Zambezi\", \"Nile\", \"D\"),\n    (\"What is the hardest natural substance?\", \"Gold\", \"Diamond\", \"Quartz\", \"Iron\", \"B\"),\n    (\"Who wrote 'Romeo and Juliet'?\", \"Charles Dickens\", \"Jane Austen\", \"William Shakespeare\", \"Mark Twain\", \"C\"),\n    (\"What is the largest mammal in the world?\", \"African elephant\", \"Blue whale\", \"Giraffe\", \"Great white shark\", \"B\"),\n    (\"Which country has the largest population in Europe (excluding Russia)?\", \"Germany\", \"France\", \"Italy\", \"United Kingdom\", \"A\"),\n    (\"How many sides does a hexagon have?\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"B\"),\n    (\"What is the smallest prime number?\", \"0\", \"1\", \"2\", \"3\", \"C\"),\n    (\"Which gas do plants absorb from the atmosphere for photosynthesis?\", \"Oxygen\", \"Nitrogen\", \"Hydrogen\", \"Carbon dioxide\", \"D\"),\n    (\"What is the capital of Japan?\", \"Tokyo\", \"Kyoto\", \"Osaka\", \"Seoul\", \"A\"),\n    (\"Which element has the atomic number 1?\", \"Helium\", \"Hydrogen\", \"Lithium\", \"Carbon\", \"B\"),\n    (\"Who was the first person to walk on the Moon?\", \"Buzz Aldrin\", \"Yuri Gagarin\", \"Neil Armstrong\", \"Michael Collins\", \"C\"),\n    (\"Which desert is the largest hot desert in the world?\", \"Gobi\", \"Kalahari\", \"Arabian\", \"Sahara\", \"D\"),\n    (\"How many players are on a soccer team on the field?\", \"Eleven\", \"Nine\", \"Ten\", \"Twelve\", \"A\"),\n    (\"What is the currency of the United Kingdom?\", \"Euro\", \"Pound sterling\", \"Dollar\", \"Franc\", \"B\"),\n    (\"Which language has the most native speakers worldwide?\", \"English\", \"Spanish\", \"Mandarin Chinese\", \"Hindi\", \"C\"),\n    (\"What is the boiling point of water at sea level in degrees Celsius?\", \"90\", \"95\", \"105\", \"100\", \"D\"),\n    (\"Which organ pumps blood through the human body?\", \"Heart\", \"Liver\", \"Lungs\", \"Kidney\", \"A\"),\n    (\"Which mountain is the highest above sea level?\", \"K2\", \"Mount Everest\", \"Kangchenjunga\", \"Mont Blanc\", \"B\"),\n    (\"Who developed the theory of general relativity?\", \"Isaac Newton\", \"Niels Bohr\", \"Albert Einstein\", \"Galileo Galilei\", \"C\"),\n    (\"What is the capital of Australia?\", \"Sydney\", \"Melbourne\", \"Perth\", \"Canberra\", \"D\"),\n    (\"Which instrument has black and white keys?\", \"Piano\", \"Violin\", \"Flute\", \"Drums\", \"A\"),\n    (\"What is the square root of 144?\", \"10\", \"12\", \"14\", \"16\", \"B\"),\n    (\"Which ancient civilization built the pyramids of Giza?\", \"Romans\", \"Greeks\", \"Egyptians\", \"Mayans\", \"C\"),\n]\nEOF\ncat > /workspace/backend/app.py <<'EOF'\n\"\"\"Quiz app: Flask JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom seed import QUESTIONS\n\nBASE = Path(__file__).resolve().parent.parent\nDIST = BASE / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"quiz.db\"\n\nADMIN_USERNAME = \"admin\"\nOPTIONS = (\"A\", \"B\", \"C\", \"D\")\nTOKEN_TTL = timedelta(days=7)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nMIN_PASSWORD = 8\nMAX_PASSWORD = 128\nDEFAULT_QUIZ_COUNT = 5\nMAX_QUIZ_COUNT = 50\nMAX_PAGE_SIZE = 100\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS questions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    text TEXT NOT NULL,\n    option_a TEXT NOT NULL,\n    option_b TEXT NOT NULL,\n    option_c TEXT NOT NULL,\n    option_d TEXT NOT NULL,\n    correct_option TEXT NOT NULL CHECK (correct_option IN ('A','B','C','D')),\n    active INTEGER NOT NULL DEFAULT 1\n);\nCREATE TABLE IF NOT EXISTS attempts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    score INTEGER NOT NULL,\n    correct INTEGER NOT NULL,\n    total_questions INTEGER NOT NULL,\n    submitted_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_attempts_user ON attempts(user_id, id);\nCREATE TABLE IF NOT EXISTS attempt_answers (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    attempt_id INTEGER NOT NULL REFERENCES attempts(id) ON DELETE CASCADE,\n    question_id INTEGER NOT NULL REFERENCES questions(id),\n    selected TEXT NOT NULL CHECK (selected IN ('A','B','C','D'))\n);\nCREATE INDEX IF NOT EXISTS idx_answers_attempt ON attempt_answers(attempt_id, id);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\n\ndef connect():\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 30000\")\n    return conn\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.execute(\"BEGIN IMMEDIATE\")\n        count = conn.execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n        if count == 0:\n            conn.executemany(\n                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option)\"\n                \" VALUES (?, ?, ?, ?, ?, ?)\",\n                QUESTIONS,\n            )\n        conn.execute(\n            \"DELETE FROM tokens WHERE expires_at < ?\", (iso(datetime.now(timezone.utc)),)\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef iso(dt):\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef error(message, status, **extra):\n    return jsonify({\"error\": message, **extra}), status\n\n\ndef validation_error(errors):\n    return error(next(iter(errors.values())), 400, errors=errors)\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef admin_enabled():\n    return bool(os.environ.get(\"ADMIN_PASSWORD\"))\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef issue_token(user_id):\n    token = secrets.token_urlsafe(32)\n    expires = iso(datetime.now(timezone.utc) + TOKEN_TTL)\n    db().execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user_id, expires),\n    )\n    db().commit()\n    return token\n\n\nclass Unauthorized(Exception):\n    pass\n\n\ndef current_user(required):\n    \"\"\"Return the signed-in user row, None for anonymous. Raises Unauthorized.\"\"\"\n    header = request.headers.get(\"Authorization\")\n    if header is None:\n        if required:\n            raise Unauthorized\n        return None\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        raise Unauthorized\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token_hash = ?\",\n        (hash_token(parts[1].strip()),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < iso(datetime.now(timezone.utc)):\n        raise Unauthorized\n    return row\n\n\ndef is_admin(user):\n    return (\n        user is not None\n        and admin_enabled()\n        and user[\"username\"].lower() == ADMIN_USERNAME\n    )\n\n\n@app.errorhandler(Unauthorized)\ndef handle_unauthorized(_e):\n    resp = jsonify({\"error\": \"Authentication required\"})\n    resp.status_code = 401\n    resp.headers[\"WWW-Authenticate\"] = \"Bearer\"\n    return resp\n\n\n@app.errorhandler(HTTPException)\ndef handle_http(e):\n    if request.path.startswith(\"/api\"):\n        return error(e.description or e.name, e.code or 500)\n    return e\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(e):\n    app.logger.exception(\"Unhandled error: %s\", e)\n    return error(\"Internal server error\", 500)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        errors[\"username\"] = (\n            \"Username must be 3-32 characters: letters, digits, '.', '_' or '-'\"\n        )\n    if not isinstance(password, str) or not (MIN_PASSWORD <= len(password) <= MAX_PASSWORD):\n        errors[\"password\"] = (\n            f\"Password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters long\"\n        )\n    if errors:\n        return validation_error(errors)\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        return error(\"Username is already taken\", 409)\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Username is already taken\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str) or not username:\n        return error(\"Username and password are required\", 400)\n    username = username.strip()\n    bad = error(\"Invalid username or password\", 401)\n    if username.lower() == ADMIN_USERNAME:\n        expected = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        if not expected or not hmac.compare_digest(password.encode(), expected.encode()):\n            return bad\n        row = db().execute(\n            \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n        ).fetchone()\n        if row is None:\n            db().execute(\n                \"INSERT OR IGNORE INTO users (username, password_hash) VALUES (?, ?)\",\n                (ADMIN_USERNAME, \"!\"),\n            )\n            db().commit()\n            row = db().execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n        return jsonify({\"token\": issue_token(row[\"id\"])})\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        return bad\n    if not check_password_hash(row[\"password_hash\"], password):\n        return bad\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user(True)\n    return jsonify({\"username\": user[\"username\"], \"is_admin\": is_admin(user)})\n\n\ndef parse_int(value, name, minimum, maximum=None):\n    try:\n        if not re.fullmatch(r\"[0-9]+\", value.strip()):\n            raise ValueError\n        number = int(value)\n    except ValueError:\n        return None, f\"{name} must be an integer\"\n    if number < minimum or (maximum is not None and number > maximum):\n        bound = f\"between {minimum} and {maximum}\" if maximum else f\"at least {minimum}\"\n        return None, f\"{name} must be {bound}\"\n    return number, None\n\n\n@app.get(\"/api/quiz\")\ndef quiz():\n    count = DEFAULT_QUIZ_COUNT\n    raw = request.args.get(\"count\")\n    if raw is not None:\n        count, err = parse_int(raw, \"count\", 1, MAX_QUIZ_COUNT)\n        if err:\n            return error(err, 400)\n    rows = db().execute(\n        \"SELECT id, text, option_a, option_b, option_c, option_d FROM questions\"\n        \" WHERE active = 1 ORDER BY RANDOM() LIMIT ?\",\n        (count,),\n    ).fetchall()\n    return jsonify({\"items\": [dict(r) for r in rows]})\n\n\ndef review_items(rows):\n    items = []\n    for r in rows:\n        items.append(\n            {\n                \"question_id\": r[\"question_id\"],\n                \"text\": r[\"text\"],\n                \"option_a\": r[\"option_a\"],\n                \"option_b\": r[\"option_b\"],\n                \"option_c\": r[\"option_c\"],\n                \"option_d\": r[\"option_d\"],\n                \"selected\": r[\"selected\"],\n                \"correct_option\": r[\"correct_option\"],\n                \"is_correct\": r[\"selected\"] == r[\"correct_option\"],\n            }\n        )\n    return items\n\n\ndef attempt_dict(row, answers):\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"correct\": row[\"correct\"],\n        \"total_questions\": row[\"total_questions\"],\n        \"submitted_at\": row[\"submitted_at\"],\n        \"answers\": answers,\n    }\n\n\ndef load_answers(attempt_id):\n    rows = db().execute(\n        \"SELECT a.question_id, a.selected, q.text, q.option_a, q.option_b, q.option_c,\"\n        \" q.option_d, q.correct_option FROM attempt_answers a\"\n        \" JOIN questions q ON q.id = a.question_id WHERE a.attempt_id = ? ORDER BY a.id\",\n        (attempt_id,),\n    ).fetchall()\n    return review_items(rows)\n\n\n@app.post(\"/api/attempts\")\ndef submit_attempt():\n    user = current_user(False)\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    answers = body.get(\"answers\")\n    if not isinstance(answers, list) or not answers:\n        return error(\"answers must be a non-empty list\", 400)\n    if len(answers) > 100:\n        return error(\"answers must not contain more than 100 entries\", 400)\n    parsed = []\n    seen = set()\n    for i, a in enumerate(answers):\n        if not isinstance(a, dict):\n            return error(f\"answers[{i}] must be an object\", 400)\n        qid = a.get(\"question_id\")\n        sel = a.get(\"selected\")\n        if not isinstance(qid, int) or isinstance(qid, bool):\n            return error(f\"answers[{i}].question_id must be an integer\", 400)\n        if not isinstance(sel, str) or sel not in OPTIONS:\n            return error(f\"answers[{i}].selected must be one of A, B, C, D\", 400)\n        if qid in seen:\n            return error(f\"Question {qid} is answered more than once\", 400)\n        seen.add(qid)\n        parsed.append((qid, sel))\n    placeholders = \",\".join(\"?\" * len(parsed))\n    qrows = db().execute(\n        f\"SELECT * FROM questions WHERE active = 1 AND id IN ({placeholders})\",\n        [q for q, _ in parsed],\n    ).fetchall()\n    questions = {r[\"id\"]: r for r in qrows}\n    for qid, _ in parsed:\n        if qid not in questions:\n            return error(f\"Unknown question: {qid}\", 400)\n    review = []\n    for qid, sel in parsed:\n        q = questions[qid]\n        review.append({**dict(q), \"question_id\": qid, \"selected\": sel})\n    items = review_items(review)\n    total = len(items)\n    correct = sum(1 for it in items if it[\"is_correct\"])\n    score = round(100 * correct / total)\n    now = iso(datetime.now(timezone.utc))\n    attempt_id = None\n    if user is not None:\n        conn = db()\n        cur = conn.execute(\n            \"INSERT INTO attempts (user_id, score, correct, total_questions, submitted_at)\"\n            \" VALUES (?, ?, ?, ?, ?)\",\n            (user[\"id\"], score, correct, total, now),\n        )\n        attempt_id = cur.lastrowid\n        conn.executemany(\n            \"INSERT INTO attempt_answers (attempt_id, question_id, selected) VALUES (?, ?, ?)\",\n            [(attempt_id, qid, sel) for qid, sel in parsed],\n        )\n        conn.commit()\n    result = {\n        \"id\": attempt_id,\n        \"score\": score,\n        \"correct\": correct,\n        \"total_questions\": total,\n        \"submitted_at\": now,\n        \"answers\": items,\n    }\n    return jsonify(result), 201 if attempt_id else 200\n\n\n@app.get(\"/api/attempts\")\ndef list_attempts():\n    user = current_user(True)\n    rows = db().execute(\n        \"SELECT * FROM attempts WHERE user_id = ? ORDER BY submitted_at DESC, id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [attempt_dict(r, load_answers(r[\"id\"])) for r in rows]})\n\n\n@app.get(\"/api/attempts/<int:attempt_id>\")\ndef get_attempt(attempt_id):\n    user = current_user(True)\n    row = db().execute(\n        \"SELECT * FROM attempts WHERE id = ? AND user_id = ?\", (attempt_id, user[\"id\"])\n    ).fetchone()\n    if row is None:\n        return error(\"Attempt not found\", 404)\n    return jsonify(attempt_dict(row, load_answers(row[\"id\"])))\n\n\ndef require_admin():\n    user = current_user(True)\n    if not is_admin(user):\n        return error(\"Admin access required\", 403)\n    return None\n\n\ndef question_dict(r):\n    return {\n        \"id\": r[\"id\"],\n        \"text\": r[\"text\"],\n        \"option_a\": r[\"option_a\"],\n        \"option_b\": r[\"option_b\"],\n        \"option_c\": r[\"option_c\"],\n        \"option_d\": r[\"option_d\"],\n        \"correct_option\": r[\"correct_option\"],\n    }\n\n\n@app.post(\"/api/admin/questions\")\ndef add_question():\n    denied = require_admin()\n    if denied:\n        return denied\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    errors = {}\n    values = {}\n    limits = {\"text\": 500, \"option_a\": 200, \"option_b\": 200, \"option_c\": 200, \"option_d\": 200}\n    labels = {\n        \"text\": \"Question text\",\n        \"option_a\": \"Option A\",\n        \"option_b\": \"Option B\",\n        \"option_c\": \"Option C\",\n        \"option_d\": \"Option D\",\n    }\n    for field, limit in limits.items():\n        v = body.get(field)\n        if not isinstance(v, str) or not v.strip():\n            errors[field] = f\"{labels[field]} is required\"\n        elif len(v.strip()) > limit:\n            errors[field] = f\"{labels[field]} must be at most {limit} characters\"\n        else:\n            values[field] = v.strip()\n    opts = [values.get(f\"option_{c}\") for c in \"abcd\"]\n    present = [o.lower() for o in opts if o]\n    if len(set(present)) != len(present):\n        for c in \"abcd\":\n            f = f\"option_{c}\"\n            if f not in errors and values[f].lower() in [\n                o.lower() for k, o in zip(\"abcd\", opts) if k != c and o\n            ]:\n                errors[f] = \"Options must be different from each other\"\n    correct = body.get(\"correct_option\")\n    if not isinstance(correct, str) or correct not in OPTIONS:\n        errors[\"correct_option\"] = \"Correct option must be one of A, B, C, D\"\n    if errors:\n        order = [\"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\", \"correct_option\"]\n        return validation_error({k: errors[k] for k in order if k in errors})\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            values[\"text\"],\n            values[\"option_a\"],\n            values[\"option_b\"],\n            values[\"option_c\"],\n            values[\"option_d\"],\n            correct,\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM questions WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(question_dict(row)), 201\n\n\n@app.get(\"/api/admin/questions\")\ndef list_questions():\n    denied = require_admin()\n    if denied:\n        return denied\n    page, page_size = 1, 20\n    if \"page\" in request.args:\n        page, err = parse_int(request.args[\"page\"], \"page\", 1)\n        if err:\n            return error(err, 400)\n    if \"page_size\" in request.args:\n        page_size, err = parse_int(request.args[\"page_size\"], \"page_size\", 1, MAX_PAGE_SIZE)\n        if err:\n            return error(err, 400)\n    total = db().execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n    rows = db().execute(\n        \"SELECT * FROM questions ORDER BY id LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [question_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path):\n    return error(\"Not found\", 404)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = (DIST / path).resolve()\n    if target.is_file() and DIST.resolve() in target.parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"mkdir -p /workspace/backend && cat > /workspace/backend/seed.py <<'EOF'\nQUESTIONS = [\n    (\"What is the capital of France?\", \"Berlin\", \"Madrid\", \"Paris\", \"Rome\", \"C\"),\n    (\"Which planet is known as the Red Planet?\", \"Mars\", \"Venus\", \"Jupiter\", \"Mercury\", \"A\"),\n    (\"How many continents are there on Earth?\", \"Five\", \"Six\", \"Eight\", \"Seven\", \"D\"),\n    (\"What is the largest ocean on Earth?\", \"Atlantic Ocean\", \"Pacific Ocean\", \"Indian Ocean\", \"Arctic Ocean\", \"B\"),\n    (\"Who painted the Mona Lisa?\", \"Vincent van Gogh\", \"Pablo Picasso\", \"Leonardo da Vinci\", \"Claude Monet\", \"C\"),\n    (\"What is the chemical symbol for water?\", \"H2O\", \"CO2\", \"O2\", \"NaCl\", \"A\"),\n    (\"In which year did World War II end?\", \"1918\", \"1939\", \"1945\", \"1950\", \"C\"),\n    (\"Which is the longest river in Africa?\", \"Congo\", \"Niger\", \"Zambezi\", \"Nile\", \"D\"),\n    (\"What is the hardest natural substance?\", \"Gold\", \"Diamond\", \"Quartz\", \"Iron\", \"B\"),\n    (\"Who wrote 'Romeo and Juliet'?\", \"Charles Dickens\", \"Jane Austen\", \"William Shakespeare\", \"Mark Twain\", \"C\"),\n    (\"What is the largest mammal in the world?\", \"African elephant\", \"Blue whale\", \"Giraffe\", \"Great white shark\", \"B\"),\n    (\"Which country has the largest population in Europe (excluding Russia)?\", \"Germany\", \"France\", \"Italy\", \"United Kingdom\", \"A\"),\n    (\"How many sides does a hexagon have?\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"B\"),\n    (\"What is the smallest prime number?\", \"0\", \"1\", \"2\", \"3\", \"C\"),\n    (\"Which gas do plants absorb from the atmosphere for photosynthesis?\", \"Oxygen\", \"Nitrogen\", \"Hydrogen\", \"Carbon dioxide\", \"D\"),\n    (\"What is the capital of Japan?\", \"Tokyo\", \"Kyoto\", \"Osaka\", \"Seoul\", \"A\"),\n    (\"Which element has the atomic number 1?\", \"Helium\", \"Hydrogen\", \"Lithium\", \"Carbon\", \"B\"),\n    (\"Who was the first person to walk on the Moon?\", \"Buzz Aldrin\", \"Yuri Gagarin\", \"Neil Armstrong\", \"Michael Collins\", \"C\"),\n    (\"Which desert is the largest hot desert in the world?\", \"Gobi\", \"Kalahari\", \"Arabian\", \"Sahara\", \"D\"),\n    (\"How many players are on a soccer team on the field?\", \"Eleven\", \"Nine\", \"Ten\", \"Twelve\", \"A\"),\n    (\"What is the currency of the United Kingdom?\", \"Euro\", \"Pound sterling\", \"Dollar\", \"Franc\", \"B\"),\n    (\"Which language has the most native speakers worldwide?\", \"English\", \"Spanish\", \"Mandarin Chinese\", \"Hindi\", \"C\"),\n    (\"What is the boiling point of water at sea level in degrees Celsius?\", \"90\", \"95\", \"105\", \"100\", \"D\"),\n    (\"Which organ pumps blood through the human body?\", \"Heart\", \"Liver\", \"Lungs\", \"Kidney\", \"A\"),\n    (\"Which mountain is the highest above sea level?\", \"K2\", \"Mount Everest\", \"Kangchenjunga\", \"Mont Blanc\", \"B\"),\n    (\"Who developed the theory of general relativity?\", \"Isaac Newton\", \"Niels Bohr\", \"Albert Einstein\", \"Galileo Galilei\", \"C\"),\n    (\"What is the capital of Australia?\", \"Sydney\", \"Melbourne\", \"Perth\", \"Canberra\", \"D\"),\n    (\"Which instrument has black and white keys?\", \"Piano\", \"Violin\", \"Flute\", \"Drums\", \"A\"),\n    (\"What is the square root of 144?\", \"10\", \"12\", \"14\", \"16\", \"B\"),\n    (\"Which ancient civilization built the pyramids of Giza?\", \"Romans\", \"Greeks\", \"Egyptians\", \"Mayans\", \"C\"),\n]\nEOF\ncat > /workspace/backend/app.py <<'EOF'\n\"\"\"Quiz app: Flask JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom seed import QUESTIONS\n\nBASE = Path(__file__).resolve().parent.parent\nDIST = BASE / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"quiz.db\"\n\nADMIN_USERNAME = \"admin\"\nOPTIONS = (\"A\", \"B\", \"C\", \"D\")\nTOKEN_TTL = timedelta(days=7)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nMIN_PASSWORD = 8\nMAX_PASSWORD = 128\nDEFAULT_QUIZ_COUNT = 5\nMAX_QUIZ_COUNT = 50\nMAX_PAGE_SIZE = 100\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS questions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    text TEXT NOT NULL,\n    option_a TEXT NOT NULL,\n    option_b TEXT NOT NULL,\n    option_c TEXT NOT NULL,\n    option_d TEXT NOT NULL,\n    correct_option TEXT NOT NULL CHECK (correct_option IN ('A','B','C','D')),\n    active INTEGER NOT NULL DEFAULT 1\n);\nCREATE TABLE IF NOT EXISTS attempts (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    score INTEGER NOT NULL,\n    correct INTEGER NOT NULL,\n    total_questions INTEGER NOT NULL,\n    submitted_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_attempts_user ON attempts(user_id, id);\nCREATE TABLE IF NOT EXISTS attempt_answers (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    attempt_id INTEGER NOT NULL REFERENCES attempts(id) ON DELETE CASCADE,\n    question_id INTEGER NOT NULL REFERENCES questions(id),\n    selected TEXT NOT NULL CHECK (selected IN ('A','B','C','D'))\n);\nCREATE INDEX IF NOT EXISTS idx_answers_attempt ON attempt_answers(attempt_id, id);\n\"\"\"\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\n\ndef connect():\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 30000\")\n    return conn\n\n\ndef init_db():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.execute(\"BEGIN IMMEDIATE\")\n        count = conn.execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n        if count == 0:\n            conn.executemany(\n                \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option)\"\n                \" VALUES (?, ?, ?, ?, ?, ?)\",\n                QUESTIONS,\n            )\n        conn.execute(\n            \"DELETE FROM tokens WHERE expires_at < ?\", (iso(datetime.now(timezone.utc)),)\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef iso(dt):\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef error(message, status, **extra):\n    return jsonify({\"error\": message, **extra}), status\n\n\ndef validation_error(errors):\n    return error(next(iter(errors.values())), 400, errors=errors)\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef admin_enabled():\n    return bool(os.environ.get(\"ADMIN_PASSWORD\"))\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef issue_token(user_id):\n    token = secrets.token_urlsafe(32)\n    expires = iso(datetime.now(timezone.utc) + TOKEN_TTL)\n    db().execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), user_id, expires),\n    )\n    db().commit()\n    return token\n\n\nclass Unauthorized(Exception):\n    pass\n\n\ndef current_user(required):\n    \"\"\"Return the signed-in user row, None for anonymous. Raises Unauthorized.\"\"\"\n    header = request.headers.get(\"Authorization\")\n    if header is None:\n        if required:\n            raise Unauthorized\n        return None\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\" or not parts[1].strip():\n        raise Unauthorized\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t JOIN users u ON u.id = t.user_id\"\n        \" WHERE t.token_hash = ?\",\n        (hash_token(parts[1].strip()),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < iso(datetime.now(timezone.utc)):\n        raise Unauthorized\n    return row\n\n\ndef is_admin(user):\n    return (\n        user is not None\n        and admin_enabled()\n        and user[\"username\"].lower() == ADMIN_USERNAME\n    )\n\n\n@app.errorhandler(Unauthorized)\ndef handle_unauthorized(_e):\n    resp = jsonify({\"error\": \"Authentication required\"})\n    resp.status_code = 401\n    resp.headers[\"WWW-Authenticate\"] = \"Bearer\"\n    return resp\n\n\n@app.errorhandler(HTTPException)\ndef handle_http(e):\n    if request.path.startswith(\"/api\"):\n        return error(e.description or e.name, e.code or 500)\n    return e\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(e):\n    app.logger.exception(\"Unhandled error: %s\", e)\n    return error(\"Internal server error\", 500)\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        errors[\"username\"] = (\n            \"Username must be 3-32 characters: letters, digits, '.', '_' or '-'\"\n        )\n    if not isinstance(password, str) or not (MIN_PASSWORD <= len(password) <= MAX_PASSWORD):\n        errors[\"password\"] = (\n            f\"Password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters long\"\n        )\n    if errors:\n        return validation_error(errors)\n    username = username.strip()\n    if username.lower() == ADMIN_USERNAME:\n        return error(\"Username is already taken\", 409)\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n            (username, generate_password_hash(password)),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Username is already taken\", 409)\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    username = body.get(\"username\")\n    password = body.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str) or not username:\n        return error(\"Username and password are required\", 400)\n    username = username.strip()\n    bad = error(\"Invalid username or password\", 401)\n    if username.lower() == ADMIN_USERNAME:\n        expected = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n        if not expected or not hmac.compare_digest(password.encode(), expected.encode()):\n            return bad\n        row = db().execute(\n            \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n        ).fetchone()\n        if row is None:\n            db().execute(\n                \"INSERT OR IGNORE INTO users (username, password_hash) VALUES (?, ?)\",\n                (ADMIN_USERNAME, \"!\"),\n            )\n            db().commit()\n            row = db().execute(\n                \"SELECT id FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n        return jsonify({\"token\": issue_token(row[\"id\"])})\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        return bad\n    if not check_password_hash(row[\"password_hash\"], password):\n        return bad\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user(True)\n    return jsonify({\"username\": user[\"username\"], \"is_admin\": is_admin(user)})\n\n\ndef parse_int(value, name, minimum, maximum=None):\n    try:\n        if not re.fullmatch(r\"[0-9]+\", value.strip()):\n            raise ValueError\n        number = int(value)\n    except ValueError:\n        return None, f\"{name} must be an integer\"\n    if number < minimum or (maximum is not None and number > maximum):\n        bound = f\"between {minimum} and {maximum}\" if maximum else f\"at least {minimum}\"\n        return None, f\"{name} must be {bound}\"\n    return number, None\n\n\n@app.get(\"/api/quiz\")\ndef quiz():\n    count = DEFAULT_QUIZ_COUNT\n    raw = request.args.get(\"count\")\n    if raw is not None:\n        count, err = parse_int(raw, \"count\", 1, MAX_QUIZ_COUNT)\n        if err:\n            return error(err, 400)\n    rows = db().execute(\n        \"SELECT id, text, option_a, option_b, option_c, option_d FROM questions\"\n        \" WHERE active = 1 ORDER BY RANDOM() LIMIT ?\",\n        (count,),\n    ).fetchall()\n    return jsonify({\"items\": [dict(r) for r in rows]})\n\n\ndef review_items(rows):\n    items = []\n    for r in rows:\n        items.append(\n            {\n                \"question_id\": r[\"question_id\"],\n                \"text\": r[\"text\"],\n                \"option_a\": r[\"option_a\"],\n                \"option_b\": r[\"option_b\"],\n                \"option_c\": r[\"option_c\"],\n                \"option_d\": r[\"option_d\"],\n                \"selected\": r[\"selected\"],\n                \"correct_option\": r[\"correct_option\"],\n                \"is_correct\": r[\"selected\"] == r[\"correct_option\"],\n            }\n        )\n    return items\n\n\ndef attempt_dict(row, answers):\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"correct\": row[\"correct\"],\n        \"total_questions\": row[\"total_questions\"],\n        \"submitted_at\": row[\"submitted_at\"],\n        \"answers\": answers,\n    }\n\n\ndef load_answers(attempt_id):\n    rows = db().execute(\n        \"SELECT a.question_id, a.selected, q.text, q.option_a, q.option_b, q.option_c,\"\n        \" q.option_d, q.correct_option FROM attempt_answers a\"\n        \" JOIN questions q ON q.id = a.question_id WHERE a.attempt_id = ? ORDER BY a.id\",\n        (attempt_id,),\n    ).fetchall()\n    return review_items(rows)\n\n\n@app.post(\"/api/attempts\")\ndef submit_attempt():\n    user = current_user(False)\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    answers = body.get(\"answers\")\n    if not isinstance(answers, list) or not answers:\n        return error(\"answers must be a non-empty list\", 400)\n    if len(answers) > 100:\n        return error(\"answers must not contain more than 100 entries\", 400)\n    parsed = []\n    seen = set()\n    for i, a in enumerate(answers):\n        if not isinstance(a, dict):\n            return error(f\"answers[{i}] must be an object\", 400)\n        qid = a.get(\"question_id\")\n        sel = a.get(\"selected\")\n        if not isinstance(qid, int) or isinstance(qid, bool):\n            return error(f\"answers[{i}].question_id must be an integer\", 400)\n        if not isinstance(sel, str) or sel not in OPTIONS:\n            return error(f\"answers[{i}].selected must be one of A, B, C, D\", 400)\n        if qid in seen:\n            return error(f\"Question {qid} is answered more than once\", 400)\n        seen.add(qid)\n        parsed.append((qid, sel))\n    placeholders = \",\".join(\"?\" * len(parsed))\n    qrows = db().execute(\n        f\"SELECT * FROM questions WHERE active = 1 AND id IN ({placeholders})\",\n        [q for q, _ in parsed],\n    ).fetchall()\n    questions = {r[\"id\"]: r for r in qrows}\n    for qid, _ in parsed:\n        if qid not in questions:\n            return error(f\"Unknown question: {qid}\", 400)\n    review = []\n    for qid, sel in parsed:\n        q = questions[qid]\n        review.append({**dict(q), \"question_id\": qid, \"selected\": sel})\n    items = review_items(review)\n    total = len(items)\n    correct = sum(1 for it in items if it[\"is_correct\"])\n    score = round(100 * correct / total)\n    now = iso(datetime.now(timezone.utc))\n    attempt_id = None\n    if user is not None:\n        conn = db()\n        cur = conn.execute(\n            \"INSERT INTO attempts (user_id, score, correct, total_questions, submitted_at)\"\n            \" VALUES (?, ?, ?, ?, ?)\",\n            (user[\"id\"], score, correct, total, now),\n        )\n        attempt_id = cur.lastrowid\n        conn.executemany(\n            \"INSERT INTO attempt_answers (attempt_id, question_id, selected) VALUES (?, ?, ?)\",\n            [(attempt_id, qid, sel) for qid, sel in parsed],\n        )\n        conn.commit()\n    result = {\n        \"id\": attempt_id,\n        \"score\": score,\n        \"correct\": correct,\n        \"total_questions\": total,\n        \"submitted_at\": now,\n        \"answers\": items,\n    }\n    return jsonify(result), 201 if attempt_id else 200\n\n\n@app.get(\"/api/attempts\")\ndef list_attempts():\n    user = current_user(True)\n    rows = db().execute(\n        \"SELECT * FROM attempts WHERE user_id = ? ORDER BY submitted_at DESC, id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [attempt_dict(r, load_answers(r[\"id\"])) for r in rows]})\n\n\n@app.get(\"/api/attempts/<int:attempt_id>\")\ndef get_attempt(attempt_id):\n    user = current_user(True)\n    row = db().execute(\n        \"SELECT * FROM attempts WHERE id = ? AND user_id = ?\", (attempt_id, user[\"id\"])\n    ).fetchone()\n    if row is None:\n        return error(\"Attempt not found\", 404)\n    return jsonify(attempt_dict(row, load_answers(row[\"id\"])))\n\n\ndef require_admin():\n    user = current_user(True)\n    if not is_admin(user):\n        return error(\"Admin access required\", 403)\n    return None\n\n\ndef question_dict(r):\n    return {\n        \"id\": r[\"id\"],\n        \"text\": r[\"text\"],\n        \"option_a\": r[\"option_a\"],\n        \"option_b\": r[\"option_b\"],\n        \"option_c\": r[\"option_c\"],\n        \"option_d\": r[\"option_d\"],\n        \"correct_option\": r[\"correct_option\"],\n    }\n\n\n@app.post(\"/api/admin/questions\")\ndef add_question():\n    denied = require_admin()\n    if denied:\n        return denied\n    body = json_body()\n    if body is None:\n        return error(\"Request body must be a JSON object\", 400)\n    errors = {}\n    values = {}\n    limits = {\"text\": 500, \"option_a\": 200, \"option_b\": 200, \"option_c\": 200, \"option_d\": 200}\n    labels = {\n        \"text\": \"Question text\",\n        \"option_a\": \"Option A\",\n        \"option_b\": \"Option B\",\n        \"option_c\": \"Option C\",\n        \"option_d\": \"Option D\",\n    }\n    for field, limit in limits.items():\n        v = body.get(field)\n        if not isinstance(v, str) or not v.strip():\n            errors[field] = f\"{labels[field]} is required\"\n        elif len(v.strip()) > limit:\n            errors[field] = f\"{labels[field]} must be at most {limit} characters\"\n        else:\n            values[field] = v.strip()\n    opts = [values.get(f\"option_{c}\") for c in \"abcd\"]\n    present = [o.lower() for o in opts if o]\n    if len(set(present)) != len(present):\n        for c in \"abcd\":\n            f = f\"option_{c}\"\n            if f not in errors and values[f].lower() in [\n                o.lower() for k, o in zip(\"abcd\", opts) if k != c and o\n            ]:\n                errors[f] = \"Options must be different from each other\"\n    correct = body.get(\"correct_option\")\n    if not isinstance(correct, str) or correct not in OPTIONS:\n        errors[\"correct_option\"] = \"Correct option must be one of A, B, C, D\"\n    if errors:\n        order = [\"text\", \"option_a\", \"option_b\", \"option_c\", \"option_d\", \"correct_option\"]\n        return validation_error({k: errors[k] for k in order if k in errors})\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO questions (text, option_a, option_b, option_c, option_d, correct_option)\"\n        \" VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            values[\"text\"],\n            values[\"option_a\"],\n            values[\"option_b\"],\n            values[\"option_c\"],\n            values[\"option_d\"],\n            correct,\n        ),\n    )\n    conn.commit()\n    row = conn.execute(\"SELECT * FROM questions WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(question_dict(row)), 201\n\n\n@app.get(\"/api/admin/questions\")\ndef list_questions():\n    denied = require_admin()\n    if denied:\n        return denied\n    page, page_size = 1, 20\n    if \"page\" in request.args:\n        page, err = parse_int(request.args[\"page\"], \"page\", 1)\n        if err:\n            return error(err, 400)\n    if \"page_size\" in request.args:\n        page_size, err = parse_int(request.args[\"page_size\"], \"page_size\", 1, MAX_PAGE_SIZE)\n        if err:\n            return error(err, 400)\n    total = db().execute(\"SELECT COUNT(*) FROM questions\").fetchone()[0]\n    rows = db().execute(\n        \"SELECT * FROM questions ORDER BY id LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [question_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path):\n    return error(\"Not found\", 404)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = (DIST / path).resolve()\n    if target.is_file() and DIST.resolve() in target.parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF","time":{"start":1794251509803,"end":1794251509838}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1b9501a001rzhTYDrg1cZytR","sessionID":"ses_e3e4800c2ffemNbR5gW8Txq5U0","messageID":"msg_1c1b83c9d001Fi8WGlBfTCHVBI"}}
