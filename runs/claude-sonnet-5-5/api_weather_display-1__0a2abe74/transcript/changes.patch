+    total = db.execute(f"SELECT COUNT(*) FROM reports{where}", params).fetchone()[0]
+    rows = db.execute(
+        f"SELECT * FROM reports{where} ORDER BY city_key, id LIMIT ? OFFSET ?",
+        (*params, page_size, (page - 1) * page_size),
