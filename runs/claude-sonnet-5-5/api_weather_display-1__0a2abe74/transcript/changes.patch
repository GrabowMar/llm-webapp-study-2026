+def report_json(row) -> dict:
+    return {
+        "id": row["id"],
+        "city": row["city"],
+        "country": row["country"],
+        "temperature_c": row["temperature_c"],
+        "condition": row["condition"],
+        "humidity": row["humidity"],
+        "wind_kph": row["wind_kph"],
+        "observed_at": row["observed_at"],
+    }
+
