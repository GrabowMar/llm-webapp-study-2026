ck_xml as c\nfor s in ['<a/>','','<a><b></a>','\\ufeff<a/>',' <?xml version=\"1.0\"?><a/>','<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><a>é</a>','<a>\\ud800</a>','<a>\\x00</a>','<a\\n  b=1/>','<?xml version=\"1.0\" encoding=\"bogus\"?><a/>','<a>'+'<b>'*100000]:\n    print(repr(s[:30]),c(s))\nE","time":{"start":1794249790540,"end":1794249790648}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c19f1443001DNHyhz91NDphE3","sessionID":"ses_e3e6208b6ffePgeaBHRAWr7w8t","messageID":"msg_1c19eb8f8001ZI862yjBP44IWQ"}}
