+        " root_element, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+        (
+            uid,
+            xml[:200],
+            1 if result["valid"] else 0,
+            result["error"],
+            result["line"],
+            result["column"],
+            result["root_element"],
+            iso(now()),
+        ),
+    )
+    db.commit()
+    row = db.execute("SELECT * FROM validations WHERE id = ?", (cur.lastrowid,)).fetchone()
+    return jsonify(serialize(row)), 201
