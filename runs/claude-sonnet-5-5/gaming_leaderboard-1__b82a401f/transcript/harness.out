{"type":"tool_use","timestamp":1794250646077,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"bash","callID":"toolu_01QWAAiptMGezxu7d4skLLpD","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Game leaderboard: Flask JSON API plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\nADMIN_USERNAME = \"admin\"\nTOKEN_TTL = timedelta(days=30)\nTS_FORMAT = \"%Y-%m-%dT%H:%M:%S.%fZ\"\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nPASSWORD_MIN = 6\nPASSWORD_MAX = 128\nMAX_SCORE = 1_000_000_000_000\nPERIODS = (\"all\", \"week\", \"today\")\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\napp.json.sort_keys = False\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef fmt(ts: datetime) -> str:\n    return ts.strftime(TS_FORMAT)\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id),\n                expires_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS scores (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                player_id INTEGER NOT NULL REFERENCES users(id),\n                score INTEGER NOT NULL,\n                achieved_at TEXT NOT NULL,\n                is_hidden INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE INDEX IF NOT EXISTS idx_scores_player ON scores(player_id);\n            CREATE INDEX IF NOT EXISTS idx_scores_achieved ON scores(achieved_at);\n            \"\"\"\n        )\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(status: int, message: str):\n    return jsonify({\"error\": message}), status\n\n\ndef admin_password() -> str:\n    return os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) == 2 and parts[0].lower() == \"bearer\" and parts[1].strip():\n        return parts[1].strip()\n    return None\n\n\ndef current_user():\n    if \"user\" in g:\n        return g.user\n    g.user = None\n    token = bearer_token()\n    if token:\n        token_hash = hashlib.sha256(token.encode()).hexdigest()\n        row = db().execute(\n            \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n            \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n            (token_hash,),\n        ).fetchone()\n        if row and row[\"expires_at\"] > fmt(now()):\n            is_admin = row[\"username\"] == ADMIN_USERNAME\n            if not is_admin or admin_password():\n                g.user = {\n                    \"id\": row[\"id\"],\n                    \"username\": row[\"username\"],\n                    \"is_admin\": is_admin,\n                }\n    return g.user\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (fmt(now()),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hashlib.sha256(token.encode()).hexdigest(), user_id, fmt(now() + TOKEN_TTL)),\n    )\n    return token\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef credentials(data):\n    if data is None:\n        return None, None\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return None, None\n    return username, password\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = credentials(json_body())\n    if username is None:\n        return error(400, \"username and password are required strings\")\n    if not USERNAME_RE.match(username):\n        return error(\n            400, \"username must be 3-32 characters: letters, digits, '_', '.', '-'\"\n        )\n    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:\n        return error(\n            400, f\"password must be {PASSWORD_MIN}-{PASSWORD_MAX} characters long\"\n        )\n    if username.lower() == ADMIN_USERNAME:\n        return error(409, \"username is already taken\")\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), fmt(now())),\n        )\n    except sqlite3.IntegrityError:\n        return error(409, \"username is already taken\")\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = credentials(json_body())\n    if username is None:\n        return error(400, \"username and password are required strings\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if username.lower() == ADMIN_USERNAME:\n        expected = admin_password()\n        ok = bool(expected) and hmac.compare_digest(\n            password.encode(), expected.encode()\n        )\n        if not ok:\n            return error(401, \"invalid username or password\")\n        if row is None:\n            try:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, created_at) \"\n                    \"VALUES (?, NULL, ?)\",\n                    (ADMIN_USERNAME, fmt(now())),\n                )\n            except sqlite3.IntegrityError:\n                pass\n            row = conn.execute(\n                \"SELECT id, username FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n        return jsonify({\"token\": issue_token(row[\"id\"])})\n    stored = row[\"password_hash\"] if row else None\n    ok = check_password_hash(stored or DUMMY_HASH, password)\n    if row is None or not stored or not ok:\n        return error(401, \"invalid username or password\")\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, error(401, \"authentication required\")\n    return user, None\n\n\ndef require_admin():\n    user, err = require_user()\n    if err:\n        return None, err\n    if not user[\"is_admin\"]:\n        return None, error(403, \"admin only\")\n    return user, None\n\n\ndef score_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"achieved_at\": row[\"achieved_at\"],\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n\n\ndef int_param(name: str, default: int):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, error(400, f\"{name} must be an integer\")\n    if value < 1:\n        return None, error(400, f\"{name} must be at least 1\")\n    return value, None\n\n\ndef period_start(period: str) -> str | None:\n    current = now()\n    if period == \"today\":\n        return fmt(current.replace(hour=0, minute=0, second=0, microsecond=0))\n    if period == \"week\":\n        return fmt(current - timedelta(days=7))\n    return None\n\n\ndef like_escape(text: str) -> str:\n    return text.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    period = request.args.get(\"period\", \"all\") or \"all\"\n    if period not in PERIODS:\n        return error(400, \"period must be one of: all, week, today\")\n    limit, err = int_param(\"limit\", 50)\n    if err:\n        return err\n    limit = min(limit, 100)\n    player = request.args.get(\"player\", \"\").strip()\n    since = period_start(period)\n\n    query = \"\"\"\n        WITH best AS (\n            SELECT s.id, s.player_id, s.score, s.achieved_at,\n                   ROW_NUMBER() OVER (\n                       PARTITION BY s.player_id\n                       ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\n                   ) AS rn\n            FROM scores s\n            WHERE s.is_hidden = 0 AND (? IS NULL OR s.achieved_at >= ?)\n        ),\n        ranked AS (\n            SELECT b.id, u.username, b.score, b.achieved_at,\n                   RANK() OVER (ORDER BY b.score DESC) AS rank\n            FROM best b JOIN users u ON u.id = b.player_id\n            WHERE b.rn = 1\n        )\n        SELECT {cols} FROM ranked\n        WHERE (? = '' OR username LIKE ? ESCAPE '\\\\')\n    \"\"\"\n    params = [since, since, player, f\"%{like_escape(player)}%\"]\n    conn = db()\n    total = conn.execute(query.format(cols=\"COUNT(*)\"), params).fetchone()[0]\n    rows = conn.execute(\n        query.format(cols=\"rank, username, score, achieved_at\")\n        + \" ORDER BY score DESC, achieved_at ASC, id ASC LIMIT ?\",\n        params + [limit],\n    ).fetchall()\n    items = [\n        {\n            \"rank\": r[\"rank\"],\n            \"player\": r[\"username\"],\n            \"score\": r[\"score\"],\n            \"achieved_at\": r[\"achieved_at\"],\n        }\n        for r in rows\n    ]\n    return jsonify({\"items\": items, \"total\": total})\n\n\ndef best_visible(conn, user_id: int):\n    return conn.execute(\n        \"SELECT MAX(score) FROM scores WHERE player_id = ? AND is_hidden = 0\",\n        (user_id,),\n    ).fetchone()[0]\n\n\n@app.post(\"/api/scores\")\ndef submit_score():\n    user, err = require_user()\n    if err:\n        return err\n    data = json_body()\n    value = data.get(\"score\") if data else None\n    if isinstance(value, float) and value.is_integer():\n        value = int(value)\n    if not isinstance(value, int) or isinstance(value, bool):\n        return error(400, \"score must be an integer\")\n    if not 0 <= value <= MAX_SCORE:\n        return error(400, f\"score must be between 0 and {MAX_SCORE}\")\n\n    conn = db()\n    conn.execute(\"BEGIN IMMEDIATE\")\n    try:\n        previous = best_visible(conn, user[\"id\"])\n        achieved_at = fmt(now())\n        cur = conn.execute(\n            \"INSERT INTO scores (player_id, score, achieved_at) VALUES (?, ?, ?)\",\n            (user[\"id\"], value, achieved_at),\n        )\n        best = best_visible(conn, user[\"id\"])\n        rank = 1 + conn.execute(\n            \"SELECT COUNT(*) FROM (SELECT MAX(score) AS m FROM scores \"\n            \"WHERE is_hidden = 0 GROUP BY player_id) WHERE m > ?\",\n            (best,),\n        ).fetchone()[0]\n        conn.execute(\"COMMIT\")\n    except Exception:\n        conn.execute(\"ROLLBACK\")\n        raise\n    body = {\n        \"id\": cur.lastrowid,\n        \"score\": value,\n        \"achieved_at\": achieved_at,\n        \"is_hidden\": False,\n        \"player\": user[\"username\"],\n        \"rank\": rank,\n        \"personal_best\": previous is None or value > previous,\n    }\n    return jsonify(body), 201\n\n\n@app.get(\"/api/scores\")\ndef my_scores():\n    user, err = require_user()\n    if err:\n        return err\n    conn = db()\n    rows = conn.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.player_id \"\n        \"WHERE s.player_id = ? ORDER BY s.achieved_at DESC, s.id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_dict(r) for r in rows],\n            \"best_score\": best_visible(conn, user[\"id\"]),\n        }\n    )\n\n\n@app.get(\"/api/admin/scores\")\ndef admin_scores():\n    _, err = require_admin()\n    if err:\n        return err\n    page, err = int_param(\"page\", 1)\n    if err:\n        return err\n    page_size, err = int_param(\"page_size\", 20)\n    if err:\n        return err\n    page_size = min(page_size, 100)\n    conn = db()\n    total = conn.execute(\"SELECT COUNT(*) FROM scores\").fetchone()[0]\n    rows = conn.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.player_id \"\n        \"ORDER BY s.achieved_at DESC, s.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\ndef toggle_score(score_id: int):\n    _, err = require_admin()\n    if err:\n        return err\n    conn = db()\n    cur = conn.execute(\n        \"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,)\n    )\n    if cur.rowcount == 0:\n        return error(404, \"score not found\")\n    row = conn.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.player_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    return jsonify(score_dict(row))\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.code or 500, exc.name)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef unexpected(exc: Exception):\n    app.logger.exception(\"unhandled error\")\n    return error(500, \"internal server error\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(404, \"Not Found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF\ncd frontend && npm install tailwindcss@4 @tailwindcss/vite@4 typescript @types/react @types/react-dom --save-exact 2>&1 | tail -5; cat package.json"},"output":"\nadded 40 packages, and audited 47 packages in 41s\n\nfound 0 vulnerabilities\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"4.3.5\",\n    \"@types/react\": \"19.3.0\",\n    \"@types/react-dom\": \"19.3.0\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"4.3.5\",\n    \"typescript\": \"7.0.2\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","metadata":{"output":"\nadded 40 packages, and audited 47 packages in 41s\n\nfound 0 vulnerabilities\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"4.3.5\",\n    \"@types/react\": \"19.3.0\",\n    \"@types/react-dom\": \"19.3.0\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"4.3.5\",\n    \"typescript\": \"7.0.2\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Game leaderboard: Flask JSON API plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"leaderboard.db\"\n\nADMIN_USERNAME = \"admin\"\nTOKEN_TTL = timedelta(days=30)\nTS_FORMAT = \"%Y-%m-%dT%H:%M:%S.%fZ\"\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nPASSWORD_MIN = 6\nPASSWORD_MAX = 128\nMAX_SCORE = 1_000_000_000_000\nPERIODS = (\"all\", \"week\", \"today\")\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\napp.json.sort_keys = False\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef fmt(ts: datetime) -> str:\n    return ts.strftime(TS_FORMAT)\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token_hash TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL REFERENCES users(id),\n                expires_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS scores (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                player_id INTEGER NOT NULL REFERENCES users(id),\n                score INTEGER NOT NULL,\n                achieved_at TEXT NOT NULL,\n                is_hidden INTEGER NOT NULL DEFAULT 0\n            );\n            CREATE INDEX IF NOT EXISTS idx_scores_player ON scores(player_id);\n            CREATE INDEX IF NOT EXISTS idx_scores_achieved ON scores(achieved_at);\n            \"\"\"\n        )\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(status: int, message: str):\n    return jsonify({\"error\": message}), status\n\n\ndef admin_password() -> str:\n    return os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\n\ndef bearer_token() -> str | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) == 2 and parts[0].lower() == \"bearer\" and parts[1].strip():\n        return parts[1].strip()\n    return None\n\n\ndef current_user():\n    if \"user\" in g:\n        return g.user\n    g.user = None\n    token = bearer_token()\n    if token:\n        token_hash = hashlib.sha256(token.encode()).hexdigest()\n        row = db().execute(\n            \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n            \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n            (token_hash,),\n        ).fetchone()\n        if row and row[\"expires_at\"] > fmt(now()):\n            is_admin = row[\"username\"] == ADMIN_USERNAME\n            if not is_admin or admin_password():\n                g.user = {\n                    \"id\": row[\"id\"],\n                    \"username\": row[\"username\"],\n                    \"is_admin\": is_admin,\n                }\n    return g.user\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (fmt(now()),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hashlib.sha256(token.encode()).hexdigest(), user_id, fmt(now() + TOKEN_TTL)),\n    )\n    return token\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef credentials(data):\n    if data is None:\n        return None, None\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return None, None\n    return username, password\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = credentials(json_body())\n    if username is None:\n        return error(400, \"username and password are required strings\")\n    if not USERNAME_RE.match(username):\n        return error(\n            400, \"username must be 3-32 characters: letters, digits, '_', '.', '-'\"\n        )\n    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:\n        return error(\n            400, f\"password must be {PASSWORD_MIN}-{PASSWORD_MAX} characters long\"\n        )\n    if username.lower() == ADMIN_USERNAME:\n        return error(409, \"username is already taken\")\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), fmt(now())),\n        )\n    except sqlite3.IntegrityError:\n        return error(409, \"username is already taken\")\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = credentials(json_body())\n    if username is None:\n        return error(400, \"username and password are required strings\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if username.lower() == ADMIN_USERNAME:\n        expected = admin_password()\n        ok = bool(expected) and hmac.compare_digest(\n            password.encode(), expected.encode()\n        )\n        if not ok:\n            return error(401, \"invalid username or password\")\n        if row is None:\n            try:\n                conn.execute(\n                    \"INSERT INTO users (username, password_hash, created_at) \"\n                    \"VALUES (?, NULL, ?)\",\n                    (ADMIN_USERNAME, fmt(now())),\n                )\n            except sqlite3.IntegrityError:\n                pass\n            row = conn.execute(\n                \"SELECT id, username FROM users WHERE username = ?\", (ADMIN_USERNAME,)\n            ).fetchone()\n        return jsonify({\"token\": issue_token(row[\"id\"])})\n    stored = row[\"password_hash\"] if row else None\n    ok = check_password_hash(stored or DUMMY_HASH, password)\n    if row is None or not stored or not ok:\n        return error(401, \"invalid username or password\")\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\ndef require_user():\n    user = current_user()\n    if user is None:\n        return None, error(401, \"authentication required\")\n    return user, None\n\n\ndef require_admin():\n    user, err = require_user()\n    if err:\n        return None, err\n    if not user[\"is_admin\"]:\n        return None, error(403, \"admin only\")\n    return user, None\n\n\ndef score_dict(row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"score\": row[\"score\"],\n        \"achieved_at\": row[\"achieved_at\"],\n        \"is_hidden\": bool(row[\"is_hidden\"]),\n        \"player\": row[\"username\"],\n    }\n\n\ndef int_param(name: str, default: int):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, error(400, f\"{name} must be an integer\")\n    if value < 1:\n        return None, error(400, f\"{name} must be at least 1\")\n    return value, None\n\n\ndef period_start(period: str) -> str | None:\n    current = now()\n    if period == \"today\":\n        return fmt(current.replace(hour=0, minute=0, second=0, microsecond=0))\n    if period == \"week\":\n        return fmt(current - timedelta(days=7))\n    return None\n\n\ndef like_escape(text: str) -> str:\n    return text.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\n@app.get(\"/api/leaderboard\")\ndef leaderboard():\n    period = request.args.get(\"period\", \"all\") or \"all\"\n    if period not in PERIODS:\n        return error(400, \"period must be one of: all, week, today\")\n    limit, err = int_param(\"limit\", 50)\n    if err:\n        return err\n    limit = min(limit, 100)\n    player = request.args.get(\"player\", \"\").strip()\n    since = period_start(period)\n\n    query = \"\"\"\n        WITH best AS (\n            SELECT s.id, s.player_id, s.score, s.achieved_at,\n                   ROW_NUMBER() OVER (\n                       PARTITION BY s.player_id\n                       ORDER BY s.score DESC, s.achieved_at ASC, s.id ASC\n                   ) AS rn\n            FROM scores s\n            WHERE s.is_hidden = 0 AND (? IS NULL OR s.achieved_at >= ?)\n        ),\n        ranked AS (\n            SELECT b.id, u.username, b.score, b.achieved_at,\n                   RANK() OVER (ORDER BY b.score DESC) AS rank\n            FROM best b JOIN users u ON u.id = b.player_id\n            WHERE b.rn = 1\n        )\n        SELECT {cols} FROM ranked\n        WHERE (? = '' OR username LIKE ? ESCAPE '\\\\')\n    \"\"\"\n    params = [since, since, player, f\"%{like_escape(player)}%\"]\n    conn = db()\n    total = conn.execute(query.format(cols=\"COUNT(*)\"), params).fetchone()[0]\n    rows = conn.execute(\n        query.format(cols=\"rank, username, score, achieved_at\")\n        + \" ORDER BY score DESC, achieved_at ASC, id ASC LIMIT ?\",\n        params + [limit],\n    ).fetchall()\n    items = [\n        {\n            \"rank\": r[\"rank\"],\n            \"player\": r[\"username\"],\n            \"score\": r[\"score\"],\n            \"achieved_at\": r[\"achieved_at\"],\n        }\n        for r in rows\n    ]\n    return jsonify({\"items\": items, \"total\": total})\n\n\ndef best_visible(conn, user_id: int):\n    return conn.execute(\n        \"SELECT MAX(score) FROM scores WHERE player_id = ? AND is_hidden = 0\",\n        (user_id,),\n    ).fetchone()[0]\n\n\n@app.post(\"/api/scores\")\ndef submit_score():\n    user, err = require_user()\n    if err:\n        return err\n    data = json_body()\n    value = data.get(\"score\") if data else None\n    if isinstance(value, float) and value.is_integer():\n        value = int(value)\n    if not isinstance(value, int) or isinstance(value, bool):\n        return error(400, \"score must be an integer\")\n    if not 0 <= value <= MAX_SCORE:\n        return error(400, f\"score must be between 0 and {MAX_SCORE}\")\n\n    conn = db()\n    conn.execute(\"BEGIN IMMEDIATE\")\n    try:\n        previous = best_visible(conn, user[\"id\"])\n        achieved_at = fmt(now())\n        cur = conn.execute(\n            \"INSERT INTO scores (player_id, score, achieved_at) VALUES (?, ?, ?)\",\n            (user[\"id\"], value, achieved_at),\n        )\n        best = best_visible(conn, user[\"id\"])\n        rank = 1 + conn.execute(\n            \"SELECT COUNT(*) FROM (SELECT MAX(score) AS m FROM scores \"\n            \"WHERE is_hidden = 0 GROUP BY player_id) WHERE m > ?\",\n            (best,),\n        ).fetchone()[0]\n        conn.execute(\"COMMIT\")\n    except Exception:\n        conn.execute(\"ROLLBACK\")\n        raise\n    body = {\n        \"id\": cur.lastrowid,\n        \"score\": value,\n        \"achieved_at\": achieved_at,\n        \"is_hidden\": False,\n        \"player\": user[\"username\"],\n        \"rank\": rank,\n        \"personal_best\": previous is None or value > previous,\n    }\n    return jsonify(body), 201\n\n\n@app.get(\"/api/scores\")\ndef my_scores():\n    user, err = require_user()\n    if err:\n        return err\n    conn = db()\n    rows = conn.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.player_id \"\n        \"WHERE s.player_id = ? ORDER BY s.achieved_at DESC, s.id DESC\",\n        (user[\"id\"],),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_dict(r) for r in rows],\n            \"best_score\": best_visible(conn, user[\"id\"]),\n        }\n    )\n\n\n@app.get(\"/api/admin/scores\")\ndef admin_scores():\n    _, err = require_admin()\n    if err:\n        return err\n    page, err = int_param(\"page\", 1)\n    if err:\n        return err\n    page_size, err = int_param(\"page_size\", 20)\n    if err:\n        return err\n    page_size = min(page_size, 100)\n    conn = db()\n    total = conn.execute(\"SELECT COUNT(*) FROM scores\").fetchone()[0]\n    rows = conn.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.player_id \"\n        \"ORDER BY s.achieved_at DESC, s.id DESC LIMIT ? OFFSET ?\",\n        (page_size, (page - 1) * page_size),\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [score_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/admin/scores/<int:score_id>/toggle\")\ndef toggle_score(score_id: int):\n    _, err = require_admin()\n    if err:\n        return err\n    conn = db()\n    cur = conn.execute(\n        \"UPDATE scores SET is_hidden = 1 - is_hidden WHERE id = ?\", (score_id,)\n    )\n    if cur.rowcount == 0:\n        return error(404, \"score not found\")\n    row = conn.execute(\n        \"SELECT s.id, s.score, s.achieved_at, s.is_hidden, u.username \"\n        \"FROM scores s JOIN users u ON u.id = s.player_id WHERE s.id = ?\",\n        (score_id,),\n    ).fetchone()\n    return jsonify(score_dict(row))\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api/\") or request.path == \"/api\":\n        return error(exc.code or 500, exc.name)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef unexpected(exc: Exception):\n    app.logger.exception(\"unhandled error\")\n    return error(500, \"internal server error\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(404, \"Not Found\")\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\n\n\ninit_db()\nEOF\ncd frontend && npm install tailwindcss@4 @tailwindcss/vite@4 typescript @types/react @types/react-dom --save-exact 2>&1 | tail -5; cat package.json","time":{"start":1794250605099,"end":1794250645970}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1ab82100011q3YWoooO58dr0","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1aa9feb001Ly5d0nrbXgInWc"}}
