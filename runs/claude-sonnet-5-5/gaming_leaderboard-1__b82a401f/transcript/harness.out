{"type":"tool_use","timestamp":1794250743174,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_01BdU9VFyqNQvRBtsk8TEpqm","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts","content":"export type Score = {\n  id: number;\n  score: number;\n  achieved_at: string;\n  is_hidden: boolean;\n  player: string;\n};\n\nexport type SubmittedScore = Score & { rank: number; personal_best: boolean };\n\nexport type LeaderboardItem = {\n  rank: number;\n  player: string;\n  score: number;\n  achieved_at: string;\n};\n\nexport type Period = \"all\" | \"week\" | \"today\";\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nlet token: string | null = localStorage.getItem(\"token\");\nlet onUnauthorized: () => void = () => {};\n\nexport function setToken(value: string | null) {\n  token = value;\n  if (value) localStorage.setItem(\"token\", value);\n  else localStorage.removeItem(\"token\");\n}\n\nexport function getToken() {\n  return token;\n}\n\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nexport async function api<T>(\n  path: string,\n  options: { method?: string; body?: unknown } = {},\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method: options.method ?? \"GET\",\n      headers,\n      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n    });\n  } catch {\n    throw new ApiError(0, \"Network error, please try again\");\n  }\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) onUnauthorized();\n    const message =\n      data && typeof data === \"object\" && \"error\" in data\n        ? String((data as { error: unknown }).error)\n        : `Request failed (${res.status})`;\n    throw new ApiError(res.status, message);\n  }\n  return data as T;\n}\n\nexport function formatDate(iso: string): string {\n  const d = new Date(iso);\n  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString();\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794250742985,"end":1794250743068}},"id":"prt_1c1ad9cc1001s5L3BARGNEApPf","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
{"type":"tool_use","timestamp":1794250743174,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_01MmTnZRgyWaby1jcoJrVSc3","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/components/AuthForms.tsx","content":"import { useState } from \"react\";\nimport { api, ApiError } from \"../api\";\n\nconst input =\n  \"w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nconst button =\n  \"rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\n\nexport default function AuthForms({\n  onSignedIn,\n}: {\n  onSignedIn: (username: string, token: string) => void;\n}) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setNotice(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api(\"/auth/register\", { method: \"POST\", body: { username, password } });\n        setMode(\"login\");\n        setNotice(\"Account created. Sign in to continue.\");\n        setPassword(\"\");\n      } else {\n        const res = await api<{ token: string }>(\"/auth/login\", {\n          method: \"POST\",\n          body: { username, password },\n        });\n        onSignedIn(username, res.token);\n      }\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <section className=\"rounded-lg bg-white p-5 shadow\">\n      <div className=\"mb-4 flex gap-2\" role=\"tablist\">\n        {([\"login\", \"register\"] as const).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            role=\"tab\"\n            aria-selected={mode === m}\n            onClick={() => {\n              setMode(m);\n              setError(null);\n              setNotice(null);\n            }}\n            className={`rounded px-3 py-1 text-sm font-medium ${\n              mode === m ? \"bg-indigo-100 text-indigo-700\" : \"text-slate-500 hover:bg-slate-100\"\n            }`}\n          >\n            {m === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        ))}\n      </div>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <div>\n          <label htmlFor=\"username\" className=\"mb-1 block text-sm text-slate-600\">\n            Username\n          </label>\n          <input\n            id=\"username\"\n            name=\"username\"\n            className={input}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n        </div>\n        <div>\n          <label htmlFor=\"password\" className=\"mb-1 block text-sm text-slate-600\">\n            Password\n          </label>\n          <input\n            id=\"password\"\n            name=\"password\"\n            type=\"password\"\n            className={input}\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n            required\n          />\n        </div>\n        {error && (\n          <p role=\"alert\" className=\"text-sm text-red-600\">\n            {error}\n          </p>\n        )}\n        {notice && <p className=\"text-sm text-green-700\">{notice}</p>}\n        <button type=\"submit\" className={button} disabled={busy}>\n          {mode === \"login\" ? \"Sign in\" : \"Register\"}\n        </button>\n      </form>\n    </section>\n  );\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AuthForms.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AuthForms.tsx","time":{"start":1794250742995,"end":1794250743074}},"id":"prt_1c1ad9ccd001eITBLCTCMFiV3z","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
{"type":"tool_use","timestamp":1794250743175,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_01NvcnVo1HK1mgSz2EhZW4XJ","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/components/Leaderboard.tsx","content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatDate, LeaderboardItem, Period } from \"../api\";\n\nconst tabs: { id: Period; label: string }[] = [\n  { id: \"all\", label: \"All time\" },\n  { id: \"week\", label: \"This week\" },\n  { id: \"today\", label: \"Today\" },\n];\n\nconst medal = [\"bg-amber-100\", \"bg-slate-100\", \"bg-orange-100\"];\n\nexport default function Leaderboard({\n  username,\n  refreshKey,\n}: {\n  username: string | null;\n  refreshKey: number;\n}) {\n  const [period, setPeriod] = useState<Period>(\"all\");\n  const [search, setSearch] = useState(\"\");\n  const [query, setQuery] = useState(\"\");\n  const [items, setItems] = useState<LeaderboardItem[]>([]);\n  const [total, setTotal] = useState(0);\n  const [error, setError] = useState<string | null>(null);\n  const [loading, setLoading] = useState(false);\n  const [tick, setTick] = useState(0);\n\n  useEffect(() => {\n    const t = setTimeout(() => setQuery(search.trim()), 250);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams({ period, limit: \"50\" });\n      if (query) params.set(\"player\", query);\n      const res = await api<{ items: LeaderboardItem[]; total: number }>(\n        `/leaderboard?${params}`,\n      );\n      setItems(res.items);\n      setTotal(res.total);\n      setError(null);\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Could not load leaderboard\");\n    } finally {\n      setLoading(false);\n    }\n  }, [period, query]);\n\n  useEffect(() => {\n    load();\n  }, [load, refreshKey, tick]);\n\n  return (\n    <section className=\"rounded-lg bg-white p-5 shadow\">\n      <div className=\"mb-4 flex flex-wrap items-center justify-between gap-3\">\n        <h2 className=\"text-lg font-semibold\">Leaderboard</h2>\n        <button\n          type=\"button\"\n          onClick={() => setTick((t) => t + 1)}\n          className=\"rounded border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50\"\n        >\n          Refresh\n        </button>\n      </div>\n      <div className=\"mb-3 flex flex-wrap items-center gap-3\">\n        <div className=\"flex gap-1\" role=\"tablist\">\n          {tabs.map((t) => (\n            <button\n              key={t.id}\n              type=\"button\"\n              role=\"tab\"\n              aria-selected={period === t.id}\n              onClick={() => setPeriod(t.id)}\n              className={`rounded px-3 py-1 text-sm font-medium ${\n                period === t.id\n                  ? \"bg-indigo-600 text-white\"\n                  : \"bg-slate-100 text-slate-600 hover:bg-slate-200\"\n              }`}\n            >\n              {t.label}\n            </button>\n          ))}\n        </div>\n        <input\n          type=\"search\"\n          aria-label=\"Search players\"\n          placeholder=\"Search players\"\n          value={search}\n          onChange={(e) => setSearch(e.target.value)}\n          className=\"min-w-0 flex-1 rounded border border-slate-300 px-3 py-1 text-sm focus:border-indigo-500 focus:outline-none\"\n        />\n      </div>\n      {error && (\n        <p role=\"alert\" className=\"mb-2 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      <table className=\"w-full text-left text-sm\">\n        <thead>\n          <tr className=\"border-b border-slate-200 text-slate-500\">\n            <th className=\"py-2 pr-2\">Rank</th>\n            <th className=\"py-2 pr-2\">Player</th>\n            <th className=\"py-2 pr-2 text-right\">Score</th>\n            <th className=\"py-2 pl-2\">Date</th>\n          </tr>\n        </thead>\n        <tbody>\n          {items.map((it) => {\n            const me = username !== null && it.player.toLowerCase() === username.toLowerCase();\n            const top = it.rank <= 3;\n            return (\n              <tr\n                key={it.player}\n                data-top={top ? \"true\" : undefined}\n                data-me={me ? \"true\" : undefined}\n                className={`border-b border-slate-100 ${\n                  me ? \"bg-indigo-100 font-semibold\" : top ? medal[it.rank - 1] : \"\"\n                }`}\n              >\n                <td className=\"py-2 pr-2\">\n                  {top ? <span aria-label={`Top ${it.rank}`}>🏆 {it.rank}</span> : it.rank}\n                </td>\n                <td className=\"py-2 pr-2\">\n                  {it.player}\n                  {me && <span className=\"ml-2 text-xs text-indigo-700\">(you)</span>}\n                </td>\n                <td className=\"py-2 pr-2 text-right tabular-nums\">{it.score}</td>\n                <td className=\"py-2 pl-2 text-slate-500\">{formatDate(it.achieved_at)}</td>\n              </tr>\n            );\n          })}\n          {items.length === 0 && !loading && (\n            <tr>\n              <td colSpan={4} className=\"py-6 text-center text-slate-400\">\n                No scores yet.\n              </td>\n            </tr>\n          )}\n        </tbody>\n      </table>\n      <p className=\"mt-2 text-xs text-slate-400\">\n        {total} player{total === 1 ? \"\" : \"s\"}\n      </p>\n    </section>\n  );\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/Leaderboard.tsx","exists":false,"truncated":false},"title":"frontend/src/components/Leaderboard.tsx","time":{"start":1794250743004,"end":1794250743081}},"id":"prt_1c1ad9cd6001zSUr0yXVb0ZBW7","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
{"type":"tool_use","timestamp":1794250743175,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_01LV6EGQJs1cenw8sC8FP14h","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/components/ScorePanel.tsx","content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatDate, Score, SubmittedScore } from \"../api\";\n\nexport default function ScorePanel({\n  refreshKey,\n  onSubmitted,\n}: {\n  refreshKey: number;\n  onSubmitted: () => void;\n}) {\n  const [value, setValue] = useState(\"\");\n  const [result, setResult] = useState<SubmittedScore | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n  const [items, setItems] = useState<Score[]>([]);\n  const [best, setBest] = useState<number | null>(null);\n\n  const load = useCallback(async () => {\n    try {\n      const res = await api<{ items: Score[]; best_score: number | null }>(\"/scores\");\n      setItems(res.items);\n      setBest(res.best_score);\n    } catch {\n      setItems([]);\n    }\n  }, []);\n\n  useEffect(() => {\n    load();\n  }, [load, refreshKey]);\n\n  async function submit(e: React.FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setResult(null);\n    if (!/^\\d+$/.test(value.trim())) {\n      setError(\"Enter a whole number of 0 or more\");\n      return;\n    }\n    setBusy(true);\n    try {\n      const res = await api<SubmittedScore>(\"/scores\", {\n        method: \"POST\",\n        body: { score: Number(value.trim()) },\n      });\n      setResult(res);\n      setValue(\"\");\n      onSubmitted();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <section className=\"space-y-4 rounded-lg bg-white p-5 shadow\">\n      <h2 className=\"text-lg font-semibold\">Submit a score</h2>\n      <form onSubmit={submit} className=\"flex gap-2\">\n        <input\n          aria-label=\"Score\"\n          name=\"score\"\n          inputMode=\"numeric\"\n          placeholder=\"Score\"\n          value={value}\n          onChange={(e) => setValue(e.target.value)}\n          className=\"min-w-0 flex-1 rounded border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none\"\n        />\n        <button\n          type=\"submit\"\n          disabled={busy}\n          className=\"rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\"\n        >\n          Submit\n        </button>\n      </form>\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      {result && (\n        <div role=\"status\" className=\"rounded bg-green-50 p-3 text-sm text-green-800\">\n          <p>\n            Score {result.score} submitted. Your rank: <strong>#{result.rank}</strong>\n          </p>\n          {result.personal_best && <p className=\"font-semibold\">New personal best!</p>}\n        </div>\n      )}\n      <div>\n        <h3 className=\"mb-2 text-sm font-semibold text-slate-600\">\n          Your best score: <span className=\"text-slate-900\">{best ?? \"–\"}</span>\n        </h3>\n        <ul className=\"divide-y divide-slate-100 text-sm\">\n          {items.slice(0, 10).map((s) => (\n            <li key={s.id} className=\"flex justify-between py-1.5\">\n              <span className=\"tabular-nums\">\n                {s.score}\n                {s.is_hidden && (\n                  <span className=\"ml-2 rounded bg-slate-200 px-1.5 text-xs text-slate-600\">\n                    hidden\n                  </span>\n                )}\n              </span>\n              <span className=\"text-slate-500\">{formatDate(s.achieved_at)}</span>\n            </li>\n          ))}\n          {items.length === 0 && <li className=\"py-2 text-slate-400\">No submissions yet.</li>}\n        </ul>\n      </div>\n    </section>\n  );\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/ScorePanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/ScorePanel.tsx","time":{"start":1794250743017,"end":1794250743087}},"id":"prt_1c1ad9ce0001dr0GM52TWLOPzk","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
{"type":"tool_use","timestamp":1794250743175,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_01W6MY9wtHBL12RF8F9dx82C","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/components/AdminPanel.tsx","content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatDate, Score } from \"../api\";\n\ntype Page = { items: Score[]; total: number; page: number; page_size: number };\n\nexport default function AdminPanel({\n  refreshKey,\n  onChanged,\n}: {\n  refreshKey: number;\n  onChanged: () => void;\n}) {\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  const load = useCallback(async () => {\n    try {\n      setData(await api<Page>(`/admin/scores?page=${page}&page_size=20`));\n      setError(null);\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Could not load scores\");\n    }\n  }, [page]);\n\n  useEffect(() => {\n    load();\n  }, [load, refreshKey]);\n\n  async function toggle(id: number) {\n    try {\n      await api(`/admin/scores/${id}/toggle`, { method: \"POST\" });\n      await load();\n      onChanged();\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Could not update score\");\n    }\n  }\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <section className=\"rounded-lg bg-white p-5 shadow\">\n      <h2 className=\"mb-3 text-lg font-semibold\">Admin: all scores</h2>\n      {error && (\n        <p role=\"alert\" className=\"mb-2 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr className=\"border-b border-slate-200 text-slate-500\">\n              <th className=\"py-2 pr-2\">Player</th>\n              <th className=\"py-2 pr-2 text-right\">Score</th>\n              <th className=\"px-2 py-2\">Date</th>\n              <th className=\"py-2 pl-2\" />\n            </tr>\n          </thead>\n          <tbody>\n            {data?.items.map((s) => (\n              <tr\n                key={s.id}\n                className={`border-b border-slate-100 ${s.is_hidden ? \"text-slate-400\" : \"\"}`}\n              >\n                <td className=\"py-2 pr-2\">{s.player}</td>\n                <td className=\"py-2 pr-2 text-right tabular-nums\">{s.score}</td>\n                <td className=\"px-2 py-2\">{formatDate(s.achieved_at)}</td>\n                <td className=\"py-2 pl-2 text-right\">\n                  <button\n                    type=\"button\"\n                    onClick={() => toggle(s.id)}\n                    className=\"rounded border border-slate-300 px-2 py-0.5 text-xs hover:bg-slate-50\"\n                  >\n                    {s.is_hidden ? \"Show\" : \"Hide\"}\n                  </button>\n                </td>\n              </tr>\n            ))}\n            {data && data.items.length === 0 && (\n              <tr>\n                <td colSpan={4} className=\"py-6 text-center text-slate-400\">\n                  No scores yet.\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n      <div className=\"mt-3 flex items-center justify-between text-sm\">\n        <button\n          type=\"button\"\n          disabled={page <= 1}\n          onClick={() => setPage((p) => p - 1)}\n          className=\"rounded border border-slate-300 px-3 py-1 disabled:opacity-40\"\n        >\n          Previous\n        </button>\n        <span className=\"text-slate-500\">\n          Page {page} of {pages}\n        </span>\n        <button\n          type=\"button\"\n          disabled={page >= pages}\n          onClick={() => setPage((p) => p + 1)}\n          className=\"rounded border border-slate-300 px-3 py-1 disabled:opacity-40\"\n        >\n          Next\n        </button>\n      </div>\n    </section>\n  );\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/components/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/components/AdminPanel.tsx","time":{"start":1794250743038,"end":1794250743093}},"id":"prt_1c1ad9ced001yydmnji90NGeSj","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
{"type":"tool_use","timestamp":1794250743175,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_015WUJziJ3i5eQTeiGbMGF8X","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/main.tsx","content":"import { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/main.tsx","exists":true,"truncated":false},"title":"frontend/src/main.tsx","time":{"start":1794250742973,"end":1794250743139}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1ad9cb20018BuV0uxFVcIKYR","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
{"type":"tool_use","timestamp":1794250743175,"sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","part":{"type":"tool","tool":"write","callID":"toolu_01DDYvL6sGwGXuwxWsKXCuJB","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/App.tsx","content":"import { useCallback, useEffect, useState } from \"react\";\nimport { getToken, setToken, setUnauthorizedHandler } from \"./api\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport AuthForms from \"./components/AuthForms\";\nimport Leaderboard from \"./components/Leaderboard\";\nimport ScorePanel from \"./components/ScorePanel\";\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(() =>\n    getToken() ? localStorage.getItem(\"username\") : null,\n  );\n  const [refreshKey, setRefreshKey] = useState(0);\n\n  const signOut = useCallback(() => {\n    setToken(null);\n    localStorage.removeItem(\"username\");\n    setUsername(null);\n  }, []);\n\n  useEffect(() => {\n    setUnauthorizedHandler(signOut);\n  }, [signOut]);\n\n  const bump = useCallback(() => setRefreshKey((k) => k + 1), []);\n  const isAdmin = username?.toLowerCase() === \"admin\";\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"bg-indigo-700 text-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between px-4 py-4\">\n          <h1 className=\"text-xl font-bold\">Game Leaderboard</h1>\n          {username && (\n            <div className=\"flex items-center gap-3 text-sm\">\n              <span>\n                Signed in as <strong data-testid=\"current-user\">{username}</strong>\n              </span>\n              <button\n                type=\"button\"\n                onClick={signOut}\n                className=\"rounded bg-white/20 px-3 py-1 hover:bg-white/30\"\n              >\n                Sign out\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n      <main className=\"mx-auto grid max-w-5xl gap-6 px-4 py-6 md:grid-cols-[1fr_20rem]\">\n        <div className=\"space-y-6\">\n          <Leaderboard username={username} refreshKey={refreshKey} />\n          {isAdmin && <AdminPanel refreshKey={refreshKey} onChanged={bump} />}\n        </div>\n        <div className=\"space-y-6\">\n          {username ? (\n            <ScorePanel refreshKey={refreshKey} onSubmitted={bump} />\n          ) : (\n            <AuthForms\n              onSignedIn={(name, token) => {\n                setToken(token);\n                localStorage.setItem(\"username\", name);\n                setUsername(name);\n              }}\n            />\n          )}\n        </div>\n      </main>\n    </div>\n  );\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794250743046,"end":1794250743146}},"id":"prt_1c1ad9d01001GnhfafZvNs8TLn","sessionID":"ses_e3e557db8ffelgfQ3xHuqI1WxJ","messageID":"msg_1c1ad04dc001p1IwQeK1ujh5bF"}}
