{"type":"tool_use","timestamp":1794253054109,"sessionID":"ses_e3e32c086ffeQnBdaaTrMwh7xD","part":{"type":"tool","tool":"bash","callID":"toolu_01M9bY4LEHs9b42BH6rgCGFu","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/\"build\": \"vite build\"/\"build\": \"tsc --noEmit \\&\\& vite build\"/' package.json\nsed -i 's|<title>App</title>|<title>Billing console</title>|; s|<body>|<body class=\"bg-slate-50\">|' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Status = \"trial\" | \"active\" | \"past_due\" | \"cancelled\";\nexport const STATUSES: Status[] = [\"trial\", \"active\", \"past_due\", \"cancelled\"];\n\nexport interface Subscription {\n  id: number;\n  customer_name: string;\n  plan: string;\n  monthly_amount: number;\n  renewal_date: string;\n  status: Status;\n  failed_payment_count: number;\n  created_at: string;\n}\n\nexport interface Invoice {\n  id: number;\n  subscription_id: number;\n  amount_due: number;\n  due_date: string;\n  status: \"open\" | \"paid\";\n  paid_at: string | null;\n}\n\nexport interface Page {\n  items: Subscription[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Stats {\n  mrr: number;\n  counts: Record<Status, number>;\n}\n\nconst TOKEN_KEY = \"billing_token\";\nconst USER_KEY = \"billing_user\";\n\nexport const session = {\n  token: () => localStorage.getItem(TOKEN_KEY),\n  user: () => localStorage.getItem(USER_KEY),\n  set(token: string, user: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, user);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nexport async function api<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = session.token();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const res = await fetch(`/api${path}`, {\n    method,\n    headers,\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const msg = (data as { error?: string } | null)?.error ?? `Request failed (${res.status})`;\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) onUnauthorized();\n    throw new ApiError(res.status, msg);\n  }\n  return data as T;\n}\n\nexport const money = (n: number) =>\n  n.toLocaleString(undefined, { style: \"currency\", currency: \"USD\" });\n\nexport const statusLabel = (s: string) => s.replace(\"_\", \" \");\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\nimport type { Status } from \"./api\";\nimport { statusLabel } from \"./api\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"rounded bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"rounded border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-50\";\n\nconst badgeColors: Record<Status, string> = {\n  trial: \"bg-sky-100 text-sky-800\",\n  active: \"bg-emerald-100 text-emerald-800\",\n  past_due: \"bg-amber-100 text-amber-800\",\n  cancelled: \"bg-slate-200 text-slate-700\",\n};\n\nexport function Badge({ status }: { status: Status | string }) {\n  const cls = badgeColors[status as Status] ?? \"bg-slate-100 text-slate-700\";\n  return (\n    <span className={`inline-block rounded-full px-2 py-0.5 text-xs font-medium capitalize ${cls}`}>\n      {statusLabel(status)}\n    </span>\n  );\n}\n\nexport function Field({ label, children }: { label: string; children: ReactNode }) {\n  return (\n    <label className=\"block text-sm font-medium text-slate-700\">\n      <span className=\"mb-1 block\">{label}</span>\n      {children}\n    </label>\n  );\n}\n\nexport function ErrorMsg({ message }: { message: string | null }) {\n  if (!message) return null;\n  return (\n    <p role=\"alert\" className=\"rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </p>\n  );\n}\n\nexport function Card({ children, title }: { children: ReactNode; title?: string }) {\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-5 shadow-sm\">\n      {title && <h2 className=\"mb-3 text-lg font-semibold text-slate-900\">{title}</h2>}\n      {children}\n    </section>\n  );\n}\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, session } from \"./api\";\nimport { btnCls, Card, ErrorMsg, Field, inputCls } from \"./ui\";\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: (user: string) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    try {\n      const name = username.trim();\n      if (mode === \"register\") {\n        await api(\"POST\", \"/auth/register\", { username: name, password });\n      }\n      const res = await api<{ token: string }>(\"POST\", \"/auth/login\", { username: name, password });\n      session.set(res.token, name);\n      onSignedIn(name);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-sm\">\n      <Card title={mode === \"login\" ? \"Sign in\" : \"Create account\"}>\n        <form onSubmit={submit} className=\"space-y-4\">\n          <Field label=\"Username\">\n            <input\n              className={inputCls}\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              autoComplete=\"username\"\n              required\n            />\n          </Field>\n          <Field label=\"Password\">\n            <input\n              className={inputCls}\n              type=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n              required\n            />\n          </Field>\n          <ErrorMsg message={error} />\n          <button className={`${btnCls} w-full`} disabled={busy} type=\"submit\">\n            {mode === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        </form>\n        <button\n          type=\"button\"\n          className=\"mt-4 text-sm text-indigo-600 hover:underline\"\n          onClick={() => {\n            setMode(mode === \"login\" ? \"register\" : \"login\");\n            setError(null);\n          }}\n        >\n          {mode === \"login\" ? \"Need an account? Register\" : \"Have an account? Sign in\"}\n        </button>\n      </Card>\n    </div>\n  );\n}\nEOF\ncat > src/PublicPage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, money, STATUSES, statusLabel } from \"./api\";\nimport type { Stats } from \"./api\";\nimport { Card, ErrorMsg } from \"./ui\";\n\nexport default function PublicPage() {\n  const [stats, setStats] = useState<Stats | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    api<Stats>(\"GET\", \"/public/stats\")\n      .then(setStats)\n      .catch((e: Error) => setError(e.message));\n  }, []);\n\n  return (\n    <div className=\"space-y-4\">\n      <h1 className=\"text-2xl font-semibold text-slate-900\">Billing summary</h1>\n      <ErrorMsg message={error} />\n      {stats && (\n        <>\n          <Card>\n            <p className=\"text-sm text-slate-500\">Monthly recurring revenue</p>\n            <p className=\"text-4xl font-bold text-slate-900\" data-testid=\"mrr\">\n              {money(stats.mrr)}\n            </p>\n          </Card>\n          <div className=\"grid grid-cols-2 gap-4 md:grid-cols-4\">\n            {STATUSES.map((s) => (\n              <Card key={s}>\n                <p className=\"text-sm capitalize text-slate-500\">{statusLabel(s)}</p>\n                <p className=\"text-2xl font-semibold text-slate-900\">{stats.counts[s] ?? 0}</p>\n              </Card>\n            ))}\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/SubscriptionList.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, money, STATUSES, statusLabel } from \"./api\";\nimport type { Page, Status } from \"./api\";\nimport { Badge, btnCls, btnSecondaryCls, Card, ErrorMsg, Field, inputCls } from \"./ui\";\n\nconst PAGE_SIZE = 10;\n\nfunction NewSubscription({ onCreated }: { onCreated: () => void }) {\n  const [name, setName] = useState(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [amount, setAmount] = useState(\"\");\n  const [renewal, setRenewal] = useState(\"\");\n  const [status, setStatus] = useState<Status>(\"trial\");\n  const [error, setError] = useState<string | null>(null);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    try {\n      await api(\"POST\", \"/subscriptions\", {\n        customer_name: name,\n        plan,\n        monthly_amount: Number(amount),\n        renewal_date: renewal,\n        status,\n      });\n      setName(\"\");\n      setPlan(\"\");\n      setAmount(\"\");\n      setRenewal(\"\");\n      setStatus(\"trial\");\n      onCreated();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed\");\n    }\n  }\n\n  return (\n    <Card title=\"New subscription\">\n      <form onSubmit={submit} className=\"grid gap-3 md:grid-cols-6\">\n        <div className=\"md:col-span-2\">\n          <Field label=\"Customer\">\n            <input className={inputCls} value={name} onChange={(e) => setName(e.target.value)} required />\n          </Field>\n        </div>\n        <Field label=\"Plan\">\n          <input className={inputCls} value={plan} onChange={(e) => setPlan(e.target.value)} required />\n        </Field>\n        <Field label=\"Monthly amount\">\n          <input\n            className={inputCls}\n            type=\"number\"\n            min=\"0\"\n            step=\"0.01\"\n            value={amount}\n            onChange={(e) => setAmount(e.target.value)}\n            required\n          />\n        </Field>\n        <Field label=\"Renewal date\">\n          <input\n            className={inputCls}\n            type=\"date\"\n            value={renewal}\n            onChange={(e) => setRenewal(e.target.value)}\n            required\n          />\n        </Field>\n        <Field label=\"Status\">\n          <select className={inputCls} value={status} onChange={(e) => setStatus(e.target.value as Status)}>\n            {STATUSES.map((s) => (\n              <option key={s} value={s}>\n                {statusLabel(s)}\n              </option>\n            ))}\n          </select>\n        </Field>\n        <div className=\"md:col-span-6 space-y-2\">\n          <ErrorMsg message={error} />\n          <button className={btnCls} type=\"submit\">\n            Create subscription\n          </button>\n        </div>\n      </form>\n    </Card>\n  );\n}\n\nexport default function SubscriptionList({ onOpen }: { onOpen: (id: number) => void }) {\n  const [status, setStatus] = useState<string>(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [reload, setReload] = useState(0);\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(search.trim());\n      setPage(1);\n    }, 250);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  const [planQ, setPlanQ] = useState(\"\");\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setPlanQ(plan.trim());\n      setPage(1);\n    }, 250);\n    return () => clearTimeout(t);\n  }, [plan]);\n\n  useEffect(() => {\n    let cancelled = false;\n    const params = new URLSearchParams({ page: String(page), page_size: String(PAGE_SIZE) });\n    if (status) params.set(\"status\", status);\n    if (planQ) params.set(\"plan\", planQ);\n    if (q) params.set(\"q\", q);\n    api<Page>(\"GET\", `/subscriptions?${params}`)\n      .then((d) => {\n        if (cancelled) return;\n        setData(d);\n        setError(null);\n      })\n      .catch((e: Error) => !cancelled && setError(e.message));\n    return () => {\n      cancelled = true;\n    };\n  }, [status, planQ, q, page, reload]);\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n  const tabs: [string, string][] = [[\"\", \"All\"], ...STATUSES.map((s): [string, string] => [s, statusLabel(s)])];\n\n  return (\n    <div className=\"space-y-4\">\n      <h1 className=\"text-2xl font-semibold text-slate-900\">Subscriptions</h1>\n      <NewSubscription onCreated={() => (page === 1 ? setReload((n) => n + 1) : setPage(1))} />\n      <Card>\n        <div className=\"mb-4 flex flex-wrap gap-2\" role=\"tablist\">\n          {tabs.map(([value, label]) => (\n            <button\n              key={value}\n              role=\"tab\"\n              aria-selected={status === value}\n              onClick={() => {\n                setStatus(value);\n                setPage(1);\n              }}\n              className={`rounded-full px-3 py-1 text-sm capitalize ${\n                status === value ? \"bg-indigo-600 text-white\" : \"bg-slate-100 text-slate-700 hover:bg-slate-200\"\n              }`}\n            >\n              {label}\n            </button>\n          ))}\n        </div>\n        <div className=\"mb-4 grid gap-3 md:grid-cols-2\">\n          <input\n            className={inputCls}\n            placeholder=\"Search customer\"\n            aria-label=\"Search customer\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n          />\n          <input\n            className={inputCls}\n            placeholder=\"Filter by plan\"\n            aria-label=\"Plan filter\"\n            value={plan}\n            onChange={(e) => setPlan(e.target.value)}\n          />\n        </div>\n        <ErrorMsg message={error} />\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 text-slate-500\">\n              <tr>\n                <th className=\"py-2 pr-4\">Customer</th>\n                <th className=\"py-2 pr-4\">Plan</th>\n                <th className=\"py-2 pr-4\">Monthly</th>\n                <th className=\"py-2 pr-4\">Renewal</th>\n                <th className=\"py-2 pr-4\">Status</th>\n                <th className=\"py-2 pr-4\">Failed payments</th>\n              </tr>\n            </thead>\n            <tbody>\n              {data?.items.map((s) => (\n                <tr key={s.id} className=\"border-b border-slate-100 hover:bg-slate-50\">\n                  <td className=\"py-2 pr-4\">\n                    <button className=\"text-indigo-600 hover:underline\" onClick={() => onOpen(s.id)}>\n                      {s.customer_name}\n                    </button>\n                  </td>\n                  <td className=\"py-2 pr-4\">{s.plan}</td>\n                  <td className=\"py-2 pr-4\">{money(s.monthly_amount)}</td>\n                  <td className=\"py-2 pr-4\">{s.renewal_date}</td>\n                  <td className=\"py-2 pr-4\">\n                    <Badge status={s.status} />\n                  </td>\n                  <td className=\"py-2 pr-4\">{s.failed_payment_count}</td>\n                </tr>\n              ))}\n              {data && data.items.length === 0 && (\n                <tr>\n                  <td colSpan={6} className=\"py-6 text-center text-slate-500\">\n                    No subscriptions found\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n        <div className=\"mt-4 flex items-center justify-between text-sm text-slate-600\">\n          <span>\n            {data?.total ?? 0} total · page {page} of {pages}\n          </span>\n          <div className=\"flex gap-2\">\n            <button className={btnSecondaryCls} disabled={page <= 1} onClick={() => setPage(page - 1)}>\n              Previous\n            </button>\n            <button className={btnSecondaryCls} disabled={page >= pages} onClick={() => setPage(page + 1)}>\n              Next\n            </button>\n          </div>\n        </div>\n      </Card>\n    </div>\n  );\n}\nEOF\ncat > src/SubscriptionDetail.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, money, STATUSES, statusLabel } from \"./api\";\nimport type { Invoice, Status, Subscription } from \"./api\";\nimport { Badge, btnCls, btnSecondaryCls, Card, ErrorMsg, Field, inputCls } from \"./ui\";\n\nexport default function SubscriptionDetail({ id, onBack }: { id: number; onBack: () => void }) {\n  const [sub, setSub] = useState<Subscription | null>(null);\n  const [invoices, setInvoices] = useState<Invoice[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n\n  const [name, setName] = useState(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [amount, setAmount] = useState(\"\");\n  const [renewal, setRenewal] = useState(\"\");\n  const [status, setStatus] = useState<Status>(\"trial\");\n\n  const [invAmount, setInvAmount] = useState(\"\");\n  const [invDue, setInvDue] = useState(\"\");\n\n  const fill = (s: Subscription) => {\n    setSub(s);\n    setName(s.customer_name);\n    setPlan(s.plan);\n    setAmount(String(s.monthly_amount));\n    setRenewal(s.renewal_date);\n    setStatus(s.status);\n  };\n\n  const loadInvoices = useCallback(async () => {\n    const res = await api<{ items: Invoice[] }>(\"GET\", `/subscriptions/${id}/invoices`);\n    setInvoices(res.items);\n  }, [id]);\n\n  useEffect(() => {\n    api<Subscription>(\"GET\", `/subscriptions/${id}`)\n      .then(fill)\n      .catch((e: Error) => setError(e.message));\n    loadInvoices().catch((e: Error) => setError(e.message));\n  }, [id, loadInvoices]);\n\n  async function run(action: () => Promise<void>, message?: string) {\n    setError(null);\n    setNotice(null);\n    try {\n      await action();\n      if (message) setNotice(message);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed\");\n    }\n  }\n\n  const save = (e: FormEvent) => {\n    e.preventDefault();\n    return run(async () => {\n      fill(\n        await api<Subscription>(\"PATCH\", `/subscriptions/${id}`, {\n          customer_name: name,\n          plan,\n          monthly_amount: Number(amount),\n          renewal_date: renewal,\n          status,\n        }),\n      );\n    }, \"Saved\");\n  };\n\n  const issue = (e: FormEvent) => {\n    e.preventDefault();\n    return run(async () => {\n      const body: Record<string, unknown> = {};\n      if (invAmount) body.amount_due = Number(invAmount);\n      if (invDue) body.due_date = invDue;\n      await api(\"POST\", `/subscriptions/${id}/invoices`, body);\n      setInvAmount(\"\");\n      setInvDue(\"\");\n      await loadInvoices();\n    }, \"Invoice issued\");\n  };\n\n  const collect = (outcome: \"failed\" | \"succeeded\") =>\n    run(async () => {\n      fill(await api<Subscription>(\"POST\", `/subscriptions/${id}/collections`, { outcome }));\n      await loadInvoices();\n    }, `Recorded ${outcome} collection run`);\n\n  return (\n    <div className=\"space-y-4\">\n      <button className=\"text-sm text-indigo-600 hover:underline\" onClick={onBack}>\n        &larr; All subscriptions\n      </button>\n      <ErrorMsg message={error} />\n      {notice && <p className=\"rounded bg-emerald-50 px-3 py-2 text-sm text-emerald-700\">{notice}</p>}\n      {sub && (\n        <>\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-semibold text-slate-900\">{sub.customer_name}</h1>\n            <Badge status={sub.status} />\n            <span className=\"text-sm text-slate-500\">Failed payments: {sub.failed_payment_count}</span>\n          </div>\n          <Card title=\"Details\">\n            <form onSubmit={save} className=\"grid gap-3 md:grid-cols-2\">\n              <Field label=\"Customer\">\n                <input className={inputCls} value={name} onChange={(e) => setName(e.target.value)} required />\n              </Field>\n              <Field label=\"Plan\">\n                <input className={inputCls} value={plan} onChange={(e) => setPlan(e.target.value)} required />\n              </Field>\n              <Field label=\"Monthly amount\">\n                <input\n                  className={inputCls}\n                  type=\"number\"\n                  min=\"0\"\n                  step=\"0.01\"\n                  value={amount}\n                  onChange={(e) => setAmount(e.target.value)}\n                  required\n                />\n              </Field>\n              <Field label=\"Renewal date\">\n                <input\n                  className={inputCls}\n                  type=\"date\"\n                  value={renewal}\n                  onChange={(e) => setRenewal(e.target.value)}\n                  required\n                />\n              </Field>\n              <Field label=\"Status\">\n                <select\n                  className={inputCls}\n                  value={status}\n                  onChange={(e) => setStatus(e.target.value as Status)}\n                >\n                  {STATUSES.map((s) => (\n                    <option key={s} value={s}>\n                      {statusLabel(s)}\n                    </option>\n                  ))}\n                </select>\n              </Field>\n              <div className=\"flex items-end\">\n                <button className={btnCls} type=\"submit\">\n                  Save changes\n                </button>\n              </div>\n            </form>\n          </Card>\n          <Card title=\"Collections\">\n            <div className=\"flex gap-2\">\n              <button className={btnSecondaryCls} onClick={() => collect(\"failed\")}>\n                Record failed collection\n              </button>\n              <button className={btnCls} onClick={() => collect(\"succeeded\")}>\n                Record successful collection\n              </button>\n            </div>\n          </Card>\n          <Card title=\"Issue invoice\">\n            <form onSubmit={issue} className=\"grid gap-3 md:grid-cols-3\">\n              <Field label={`Amount due (default ${money(sub.monthly_amount)})`}>\n                <input\n                  className={inputCls}\n                  type=\"number\"\n                  min=\"0.01\"\n                  step=\"0.01\"\n                  value={invAmount}\n                  onChange={(e) => setInvAmount(e.target.value)}\n                />\n              </Field>\n              <Field label=\"Due date (default today)\">\n                <input\n                  className={inputCls}\n                  type=\"date\"\n                  value={invDue}\n                  onChange={(e) => setInvDue(e.target.value)}\n                />\n              </Field>\n              <div className=\"flex items-end\">\n                <button className={btnCls} type=\"submit\">\n                  Issue invoice\n                </button>\n              </div>\n            </form>\n          </Card>\n          <Card title=\"Invoice history\">\n            <table className=\"w-full text-left text-sm\">\n              <thead className=\"border-b border-slate-200 text-slate-500\">\n                <tr>\n                  <th className=\"py-2 pr-4\">#</th>\n                  <th className=\"py-2 pr-4\">Amount</th>\n                  <th className=\"py-2 pr-4\">Due</th>\n                  <th className=\"py-2 pr-4\">Status</th>\n                  <th className=\"py-2 pr-4\">Paid at</th>\n                </tr>\n              </thead>\n              <tbody>\n                {invoices.map((i) => (\n                  <tr key={i.id} className=\"border-b border-slate-100\">\n                    <td className=\"py-2 pr-4\">{i.id}</td>\n                    <td className=\"py-2 pr-4\">{money(i.amount_due)}</td>\n                    <td className=\"py-2 pr-4\">{i.due_date}</td>\n                    <td className=\"py-2 pr-4 capitalize\">{i.status}</td>\n                    <td className=\"py-2 pr-4\">{i.paid_at ?? \"-\"}</td>\n                  </tr>\n                ))}\n                {invoices.length === 0 && (\n                  <tr>\n                    <td colSpan={5} className=\"py-4 text-center text-slate-500\">\n                      No invoices yet\n                    </td>\n                  </tr>\n                )}\n              </tbody>\n            </table>\n          </Card>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, session, setUnauthorizedHandler } from \"./api\";\nimport AuthForms from \"./AuthForms\";\nimport PublicPage from \"./PublicPage\";\nimport SubscriptionDetail from \"./SubscriptionDetail\";\nimport SubscriptionList from \"./SubscriptionList\";\n\nfunction parseHash(): string {\n  return window.location.hash.replace(/^#/, \"\") || \"/\";\n}\n\nexport default function App() {\n  const [user, setUser] = useState<string | null>(session.user() && session.token() ? session.user() : null);\n  const [route, setRoute] = useState(parseHash());\n\n  useEffect(() => {\n    const onHash = () => setRoute(parseHash());\n    window.addEventListener(\"hashchange\", onHash);\n    return () => window.removeEventListener(\"hashchange\", onHash);\n  }, []);\n\n  const signOut = useCallback(() => {\n    session.clear();\n    setUser(null);\n    window.location.hash = \"#/\";\n  }, []);\n\n  useEffect(() => {\n    setUnauthorizedHandler(signOut);\n  }, [signOut]);\n\n  async function logout() {\n    try {\n      await api(\"POST\", \"/auth/logout\");\n    } catch {\n      // token already invalid\n    }\n    signOut();\n  }\n\n  const go = (path: string) => {\n    window.location.hash = `#${path}`;\n  };\n\n  const detail = /^\\/subscriptions\\/(\\d+)$/.exec(route);\n  let page;\n  if (route === \"/login\") {\n    page = user ? <SubscriptionList onOpen={(id) => go(`/subscriptions/${id}`)} /> : (\n      <AuthForms\n        onSignedIn={(u) => {\n          setUser(u);\n          go(\"/subscriptions\");\n        }}\n      />\n    );\n  } else if (route.startsWith(\"/subscriptions\")) {\n    if (!user) page = (\n      <AuthForms\n        onSignedIn={(u) => {\n          setUser(u);\n        }}\n      />\n    );\n    else if (detail) page = <SubscriptionDetail key={detail[1]} id={Number(detail[1])} onBack={() => go(\"/subscriptions\")} />;\n    else page = <SubscriptionList onOpen={(id) => go(`/subscriptions/${id}`)} />;\n  } else {\n    page = <PublicPage />;\n  }\n\n  const link = \"text-sm font-medium text-slate-700 hover:text-indigo-600\";\n  return (\n    <div className=\"min-h-screen text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between px-4 py-3\">\n          <nav className=\"flex items-center gap-4\">\n            <span className=\"font-bold text-indigo-700\">Billing console</span>\n            <a className={link} href=\"#/\">\n              Summary\n            </a>\n            {user && (\n              <a className={link} href=\"#/subscriptions\">\n                Subscriptions\n              </a>\n            )}\n          </nav>\n          <div className=\"flex items-center gap-3 text-sm\">\n            {user ? (\n              <>\n                <span data-testid=\"current-user\">{user}</span>\n                <button\n                  className=\"rounded border border-slate-300 px-3 py-1 hover:bg-slate-100\"\n                  onClick={logout}\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <a className={link} href=\"#/login\">\n                Sign in / Register\n              </a>\n            )}\n          </div>\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">{page}</main>\n    </div>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20"},"output":"\n> build\n> tsc --noEmit && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 22 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.41 kB │ gzip:  0.28 kB\ndist/assets/index-h1Ak8VLO.css   14.19 kB │ gzip:  3.64 kB\ndist/assets/index-CCPLJgoB.js   237.25 kB │ gzip: 72.68 kB\n\n✓ built in 388ms\n","metadata":{"output":"\n> build\n> tsc --noEmit && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 22 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.41 kB │ gzip:  0.28 kB\ndist/assets/index-h1Ak8VLO.css   14.19 kB │ gzip:  3.64 kB\ndist/assets/index-CCPLJgoB.js   237.25 kB │ gzip: 72.68 kB\n\n✓ built in 388ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/\"build\": \"vite build\"/\"build\": \"tsc --noEmit \\&\\& vite build\"/' package.json\nsed -i 's|<title>App</title>|<title>Billing console</title>|; s|<body>|<body class=\"bg-slate-50\">|' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Status = \"trial\" | \"active\" | \"past_due\" | \"cancelled\";\nexport const STATUSES: Status[] = [\"trial\", \"active\", \"past_due\", \"cancelled\"];\n\nexport interface Subscription {\n  id: number;\n  customer_name: string;\n  plan: string;\n  monthly_amount: number;\n  renewal_date: string;\n  status: Status;\n  failed_payment_count: number;\n  created_at: string;\n}\n\nexport interface Invoice {\n  id: number;\n  subscription_id: number;\n  amount_due: number;\n  due_date: string;\n  status: \"open\" | \"paid\";\n  paid_at: string | null;\n}\n\nexport interface Page {\n  items: Subscription[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Stats {\n  mrr: number;\n  counts: Record<Status, number>;\n}\n\nconst TOKEN_KEY = \"billing_token\";\nconst USER_KEY = \"billing_user\";\n\nexport const session = {\n  token: () => localStorage.getItem(TOKEN_KEY),\n  user: () => localStorage.getItem(USER_KEY),\n  set(token: string, user: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, user);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nexport async function api<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = session.token();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const res = await fetch(`/api${path}`, {\n    method,\n    headers,\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const msg = (data as { error?: string } | null)?.error ?? `Request failed (${res.status})`;\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) onUnauthorized();\n    throw new ApiError(res.status, msg);\n  }\n  return data as T;\n}\n\nexport const money = (n: number) =>\n  n.toLocaleString(undefined, { style: \"currency\", currency: \"USD\" });\n\nexport const statusLabel = (s: string) => s.replace(\"_\", \" \");\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\nimport type { Status } from \"./api\";\nimport { statusLabel } from \"./api\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"rounded bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"rounded border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-50\";\n\nconst badgeColors: Record<Status, string> = {\n  trial: \"bg-sky-100 text-sky-800\",\n  active: \"bg-emerald-100 text-emerald-800\",\n  past_due: \"bg-amber-100 text-amber-800\",\n  cancelled: \"bg-slate-200 text-slate-700\",\n};\n\nexport function Badge({ status }: { status: Status | string }) {\n  const cls = badgeColors[status as Status] ?? \"bg-slate-100 text-slate-700\";\n  return (\n    <span className={`inline-block rounded-full px-2 py-0.5 text-xs font-medium capitalize ${cls}`}>\n      {statusLabel(status)}\n    </span>\n  );\n}\n\nexport function Field({ label, children }: { label: string; children: ReactNode }) {\n  return (\n    <label className=\"block text-sm font-medium text-slate-700\">\n      <span className=\"mb-1 block\">{label}</span>\n      {children}\n    </label>\n  );\n}\n\nexport function ErrorMsg({ message }: { message: string | null }) {\n  if (!message) return null;\n  return (\n    <p role=\"alert\" className=\"rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </p>\n  );\n}\n\nexport function Card({ children, title }: { children: ReactNode; title?: string }) {\n  return (\n    <section className=\"rounded-lg border border-slate-200 bg-white p-5 shadow-sm\">\n      {title && <h2 className=\"mb-3 text-lg font-semibold text-slate-900\">{title}</h2>}\n      {children}\n    </section>\n  );\n}\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, session } from \"./api\";\nimport { btnCls, Card, ErrorMsg, Field, inputCls } from \"./ui\";\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: (user: string) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    try {\n      const name = username.trim();\n      if (mode === \"register\") {\n        await api(\"POST\", \"/auth/register\", { username: name, password });\n      }\n      const res = await api<{ token: string }>(\"POST\", \"/auth/login\", { username: name, password });\n      session.set(res.token, name);\n      onSignedIn(name);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-sm\">\n      <Card title={mode === \"login\" ? \"Sign in\" : \"Create account\"}>\n        <form onSubmit={submit} className=\"space-y-4\">\n          <Field label=\"Username\">\n            <input\n              className={inputCls}\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              autoComplete=\"username\"\n              required\n            />\n          </Field>\n          <Field label=\"Password\">\n            <input\n              className={inputCls}\n              type=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n              required\n            />\n          </Field>\n          <ErrorMsg message={error} />\n          <button className={`${btnCls} w-full`} disabled={busy} type=\"submit\">\n            {mode === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        </form>\n        <button\n          type=\"button\"\n          className=\"mt-4 text-sm text-indigo-600 hover:underline\"\n          onClick={() => {\n            setMode(mode === \"login\" ? \"register\" : \"login\");\n            setError(null);\n          }}\n        >\n          {mode === \"login\" ? \"Need an account? Register\" : \"Have an account? Sign in\"}\n        </button>\n      </Card>\n    </div>\n  );\n}\nEOF\ncat > src/PublicPage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, money, STATUSES, statusLabel } from \"./api\";\nimport type { Stats } from \"./api\";\nimport { Card, ErrorMsg } from \"./ui\";\n\nexport default function PublicPage() {\n  const [stats, setStats] = useState<Stats | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    api<Stats>(\"GET\", \"/public/stats\")\n      .then(setStats)\n      .catch((e: Error) => setError(e.message));\n  }, []);\n\n  return (\n    <div className=\"space-y-4\">\n      <h1 className=\"text-2xl font-semibold text-slate-900\">Billing summary</h1>\n      <ErrorMsg message={error} />\n      {stats && (\n        <>\n          <Card>\n            <p className=\"text-sm text-slate-500\">Monthly recurring revenue</p>\n            <p className=\"text-4xl font-bold text-slate-900\" data-testid=\"mrr\">\n              {money(stats.mrr)}\n            </p>\n          </Card>\n          <div className=\"grid grid-cols-2 gap-4 md:grid-cols-4\">\n            {STATUSES.map((s) => (\n              <Card key={s}>\n                <p className=\"text-sm capitalize text-slate-500\">{statusLabel(s)}</p>\n                <p className=\"text-2xl font-semibold text-slate-900\">{stats.counts[s] ?? 0}</p>\n              </Card>\n            ))}\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/SubscriptionList.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, money, STATUSES, statusLabel } from \"./api\";\nimport type { Page, Status } from \"./api\";\nimport { Badge, btnCls, btnSecondaryCls, Card, ErrorMsg, Field, inputCls } from \"./ui\";\n\nconst PAGE_SIZE = 10;\n\nfunction NewSubscription({ onCreated }: { onCreated: () => void }) {\n  const [name, setName] = useState(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [amount, setAmount] = useState(\"\");\n  const [renewal, setRenewal] = useState(\"\");\n  const [status, setStatus] = useState<Status>(\"trial\");\n  const [error, setError] = useState<string | null>(null);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    try {\n      await api(\"POST\", \"/subscriptions\", {\n        customer_name: name,\n        plan,\n        monthly_amount: Number(amount),\n        renewal_date: renewal,\n        status,\n      });\n      setName(\"\");\n      setPlan(\"\");\n      setAmount(\"\");\n      setRenewal(\"\");\n      setStatus(\"trial\");\n      onCreated();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed\");\n    }\n  }\n\n  return (\n    <Card title=\"New subscription\">\n      <form onSubmit={submit} className=\"grid gap-3 md:grid-cols-6\">\n        <div className=\"md:col-span-2\">\n          <Field label=\"Customer\">\n            <input className={inputCls} value={name} onChange={(e) => setName(e.target.value)} required />\n          </Field>\n        </div>\n        <Field label=\"Plan\">\n          <input className={inputCls} value={plan} onChange={(e) => setPlan(e.target.value)} required />\n        </Field>\n        <Field label=\"Monthly amount\">\n          <input\n            className={inputCls}\n            type=\"number\"\n            min=\"0\"\n            step=\"0.01\"\n            value={amount}\n            onChange={(e) => setAmount(e.target.value)}\n            required\n          />\n        </Field>\n        <Field label=\"Renewal date\">\n          <input\n            className={inputCls}\n            type=\"date\"\n            value={renewal}\n            onChange={(e) => setRenewal(e.target.value)}\n            required\n          />\n        </Field>\n        <Field label=\"Status\">\n          <select className={inputCls} value={status} onChange={(e) => setStatus(e.target.value as Status)}>\n            {STATUSES.map((s) => (\n              <option key={s} value={s}>\n                {statusLabel(s)}\n              </option>\n            ))}\n          </select>\n        </Field>\n        <div className=\"md:col-span-6 space-y-2\">\n          <ErrorMsg message={error} />\n          <button className={btnCls} type=\"submit\">\n            Create subscription\n          </button>\n        </div>\n      </form>\n    </Card>\n  );\n}\n\nexport default function SubscriptionList({ onOpen }: { onOpen: (id: number) => void }) {\n  const [status, setStatus] = useState<string>(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [search, setSearch] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [reload, setReload] = useState(0);\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(search.trim());\n      setPage(1);\n    }, 250);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  const [planQ, setPlanQ] = useState(\"\");\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setPlanQ(plan.trim());\n      setPage(1);\n    }, 250);\n    return () => clearTimeout(t);\n  }, [plan]);\n\n  useEffect(() => {\n    let cancelled = false;\n    const params = new URLSearchParams({ page: String(page), page_size: String(PAGE_SIZE) });\n    if (status) params.set(\"status\", status);\n    if (planQ) params.set(\"plan\", planQ);\n    if (q) params.set(\"q\", q);\n    api<Page>(\"GET\", `/subscriptions?${params}`)\n      .then((d) => {\n        if (cancelled) return;\n        setData(d);\n        setError(null);\n      })\n      .catch((e: Error) => !cancelled && setError(e.message));\n    return () => {\n      cancelled = true;\n    };\n  }, [status, planQ, q, page, reload]);\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n  const tabs: [string, string][] = [[\"\", \"All\"], ...STATUSES.map((s): [string, string] => [s, statusLabel(s)])];\n\n  return (\n    <div className=\"space-y-4\">\n      <h1 className=\"text-2xl font-semibold text-slate-900\">Subscriptions</h1>\n      <NewSubscription onCreated={() => (page === 1 ? setReload((n) => n + 1) : setPage(1))} />\n      <Card>\n        <div className=\"mb-4 flex flex-wrap gap-2\" role=\"tablist\">\n          {tabs.map(([value, label]) => (\n            <button\n              key={value}\n              role=\"tab\"\n              aria-selected={status === value}\n              onClick={() => {\n                setStatus(value);\n                setPage(1);\n              }}\n              className={`rounded-full px-3 py-1 text-sm capitalize ${\n                status === value ? \"bg-indigo-600 text-white\" : \"bg-slate-100 text-slate-700 hover:bg-slate-200\"\n              }`}\n            >\n              {label}\n            </button>\n          ))}\n        </div>\n        <div className=\"mb-4 grid gap-3 md:grid-cols-2\">\n          <input\n            className={inputCls}\n            placeholder=\"Search customer\"\n            aria-label=\"Search customer\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n          />\n          <input\n            className={inputCls}\n            placeholder=\"Filter by plan\"\n            aria-label=\"Plan filter\"\n            value={plan}\n            onChange={(e) => setPlan(e.target.value)}\n          />\n        </div>\n        <ErrorMsg message={error} />\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 text-slate-500\">\n              <tr>\n                <th className=\"py-2 pr-4\">Customer</th>\n                <th className=\"py-2 pr-4\">Plan</th>\n                <th className=\"py-2 pr-4\">Monthly</th>\n                <th className=\"py-2 pr-4\">Renewal</th>\n                <th className=\"py-2 pr-4\">Status</th>\n                <th className=\"py-2 pr-4\">Failed payments</th>\n              </tr>\n            </thead>\n            <tbody>\n              {data?.items.map((s) => (\n                <tr key={s.id} className=\"border-b border-slate-100 hover:bg-slate-50\">\n                  <td className=\"py-2 pr-4\">\n                    <button className=\"text-indigo-600 hover:underline\" onClick={() => onOpen(s.id)}>\n                      {s.customer_name}\n                    </button>\n                  </td>\n                  <td className=\"py-2 pr-4\">{s.plan}</td>\n                  <td className=\"py-2 pr-4\">{money(s.monthly_amount)}</td>\n                  <td className=\"py-2 pr-4\">{s.renewal_date}</td>\n                  <td className=\"py-2 pr-4\">\n                    <Badge status={s.status} />\n                  </td>\n                  <td className=\"py-2 pr-4\">{s.failed_payment_count}</td>\n                </tr>\n              ))}\n              {data && data.items.length === 0 && (\n                <tr>\n                  <td colSpan={6} className=\"py-6 text-center text-slate-500\">\n                    No subscriptions found\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n        <div className=\"mt-4 flex items-center justify-between text-sm text-slate-600\">\n          <span>\n            {data?.total ?? 0} total · page {page} of {pages}\n          </span>\n          <div className=\"flex gap-2\">\n            <button className={btnSecondaryCls} disabled={page <= 1} onClick={() => setPage(page - 1)}>\n              Previous\n            </button>\n            <button className={btnSecondaryCls} disabled={page >= pages} onClick={() => setPage(page + 1)}>\n              Next\n            </button>\n          </div>\n        </div>\n      </Card>\n    </div>\n  );\n}\nEOF\ncat > src/SubscriptionDetail.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport { api, money, STATUSES, statusLabel } from \"./api\";\nimport type { Invoice, Status, Subscription } from \"./api\";\nimport { Badge, btnCls, btnSecondaryCls, Card, ErrorMsg, Field, inputCls } from \"./ui\";\n\nexport default function SubscriptionDetail({ id, onBack }: { id: number; onBack: () => void }) {\n  const [sub, setSub] = useState<Subscription | null>(null);\n  const [invoices, setInvoices] = useState<Invoice[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n\n  const [name, setName] = useState(\"\");\n  const [plan, setPlan] = useState(\"\");\n  const [amount, setAmount] = useState(\"\");\n  const [renewal, setRenewal] = useState(\"\");\n  const [status, setStatus] = useState<Status>(\"trial\");\n\n  const [invAmount, setInvAmount] = useState(\"\");\n  const [invDue, setInvDue] = useState(\"\");\n\n  const fill = (s: Subscription) => {\n    setSub(s);\n    setName(s.customer_name);\n    setPlan(s.plan);\n    setAmount(String(s.monthly_amount));\n    setRenewal(s.renewal_date);\n    setStatus(s.status);\n  };\n\n  const loadInvoices = useCallback(async () => {\n    const res = await api<{ items: Invoice[] }>(\"GET\", `/subscriptions/${id}/invoices`);\n    setInvoices(res.items);\n  }, [id]);\n\n  useEffect(() => {\n    api<Subscription>(\"GET\", `/subscriptions/${id}`)\n      .then(fill)\n      .catch((e: Error) => setError(e.message));\n    loadInvoices().catch((e: Error) => setError(e.message));\n  }, [id, loadInvoices]);\n\n  async function run(action: () => Promise<void>, message?: string) {\n    setError(null);\n    setNotice(null);\n    try {\n      await action();\n      if (message) setNotice(message);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed\");\n    }\n  }\n\n  const save = (e: FormEvent) => {\n    e.preventDefault();\n    return run(async () => {\n      fill(\n        await api<Subscription>(\"PATCH\", `/subscriptions/${id}`, {\n          customer_name: name,\n          plan,\n          monthly_amount: Number(amount),\n          renewal_date: renewal,\n          status,\n        }),\n      );\n    }, \"Saved\");\n  };\n\n  const issue = (e: FormEvent) => {\n    e.preventDefault();\n    return run(async () => {\n      const body: Record<string, unknown> = {};\n      if (invAmount) body.amount_due = Number(invAmount);\n      if (invDue) body.due_date = invDue;\n      await api(\"POST\", `/subscriptions/${id}/invoices`, body);\n      setInvAmount(\"\");\n      setInvDue(\"\");\n      await loadInvoices();\n    }, \"Invoice issued\");\n  };\n\n  const collect = (outcome: \"failed\" | \"succeeded\") =>\n    run(async () => {\n      fill(await api<Subscription>(\"POST\", `/subscriptions/${id}/collections`, { outcome }));\n      await loadInvoices();\n    }, `Recorded ${outcome} collection run`);\n\n  return (\n    <div className=\"space-y-4\">\n      <button className=\"text-sm text-indigo-600 hover:underline\" onClick={onBack}>\n        &larr; All subscriptions\n      </button>\n      <ErrorMsg message={error} />\n      {notice && <p className=\"rounded bg-emerald-50 px-3 py-2 text-sm text-emerald-700\">{notice}</p>}\n      {sub && (\n        <>\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-semibold text-slate-900\">{sub.customer_name}</h1>\n            <Badge status={sub.status} />\n            <span className=\"text-sm text-slate-500\">Failed payments: {sub.failed_payment_count}</span>\n          </div>\n          <Card title=\"Details\">\n            <form onSubmit={save} className=\"grid gap-3 md:grid-cols-2\">\n              <Field label=\"Customer\">\n                <input className={inputCls} value={name} onChange={(e) => setName(e.target.value)} required />\n              </Field>\n              <Field label=\"Plan\">\n                <input className={inputCls} value={plan} onChange={(e) => setPlan(e.target.value)} required />\n              </Field>\n              <Field label=\"Monthly amount\">\n                <input\n                  className={inputCls}\n                  type=\"number\"\n                  min=\"0\"\n                  step=\"0.01\"\n                  value={amount}\n                  onChange={(e) => setAmount(e.target.value)}\n                  required\n                />\n              </Field>\n              <Field label=\"Renewal date\">\n                <input\n                  className={inputCls}\n                  type=\"date\"\n                  value={renewal}\n                  onChange={(e) => setRenewal(e.target.value)}\n                  required\n                />\n              </Field>\n              <Field label=\"Status\">\n                <select\n                  className={inputCls}\n                  value={status}\n                  onChange={(e) => setStatus(e.target.value as Status)}\n                >\n                  {STATUSES.map((s) => (\n                    <option key={s} value={s}>\n                      {statusLabel(s)}\n                    </option>\n                  ))}\n                </select>\n              </Field>\n              <div className=\"flex items-end\">\n                <button className={btnCls} type=\"submit\">\n                  Save changes\n                </button>\n              </div>\n            </form>\n          </Card>\n          <Card title=\"Collections\">\n            <div className=\"flex gap-2\">\n              <button className={btnSecondaryCls} onClick={() => collect(\"failed\")}>\n                Record failed collection\n              </button>\n              <button className={btnCls} onClick={() => collect(\"succeeded\")}>\n                Record successful collection\n              </button>\n            </div>\n          </Card>\n          <Card title=\"Issue invoice\">\n            <form onSubmit={issue} className=\"grid gap-3 md:grid-cols-3\">\n              <Field label={`Amount due (default ${money(sub.monthly_amount)})`}>\n                <input\n                  className={inputCls}\n                  type=\"number\"\n                  min=\"0.01\"\n                  step=\"0.01\"\n                  value={invAmount}\n                  onChange={(e) => setInvAmount(e.target.value)}\n                />\n              </Field>\n              <Field label=\"Due date (default today)\">\n                <input\n                  className={inputCls}\n                  type=\"date\"\n                  value={invDue}\n                  onChange={(e) => setInvDue(e.target.value)}\n                />\n              </Field>\n              <div className=\"flex items-end\">\n                <button className={btnCls} type=\"submit\">\n                  Issue invoice\n                </button>\n              </div>\n            </form>\n          </Card>\n          <Card title=\"Invoice history\">\n            <table className=\"w-full text-left text-sm\">\n              <thead className=\"border-b border-slate-200 text-slate-500\">\n                <tr>\n                  <th className=\"py-2 pr-4\">#</th>\n                  <th className=\"py-2 pr-4\">Amount</th>\n                  <th className=\"py-2 pr-4\">Due</th>\n                  <th className=\"py-2 pr-4\">Status</th>\n                  <th className=\"py-2 pr-4\">Paid at</th>\n                </tr>\n              </thead>\n              <tbody>\n                {invoices.map((i) => (\n                  <tr key={i.id} className=\"border-b border-slate-100\">\n                    <td className=\"py-2 pr-4\">{i.id}</td>\n                    <td className=\"py-2 pr-4\">{money(i.amount_due)}</td>\n                    <td className=\"py-2 pr-4\">{i.due_date}</td>\n                    <td className=\"py-2 pr-4 capitalize\">{i.status}</td>\n                    <td className=\"py-2 pr-4\">{i.paid_at ?? \"-\"}</td>\n                  </tr>\n                ))}\n                {invoices.length === 0 && (\n                  <tr>\n                    <td colSpan={5} className=\"py-4 text-center text-slate-500\">\n                      No invoices yet\n                    </td>\n                  </tr>\n                )}\n              </tbody>\n            </table>\n          </Card>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, session, setUnauthorizedHandler } from \"./api\";\nimport AuthForms from \"./AuthForms\";\nimport PublicPage from \"./PublicPage\";\nimport SubscriptionDetail from \"./SubscriptionDetail\";\nimport SubscriptionList from \"./SubscriptionList\";\n\nfunction parseHash(): string {\n  return window.location.hash.replace(/^#/, \"\") || \"/\";\n}\n\nexport default function App() {\n  const [user, setUser] = useState<string | null>(session.user() && session.token() ? session.user() : null);\n  const [route, setRoute] = useState(parseHash());\n\n  useEffect(() => {\n    const onHash = () => setRoute(parseHash());\n    window.addEventListener(\"hashchange\", onHash);\n    return () => window.removeEventListener(\"hashchange\", onHash);\n  }, []);\n\n  const signOut = useCallback(() => {\n    session.clear();\n    setUser(null);\n    window.location.hash = \"#/\";\n  }, []);\n\n  useEffect(() => {\n    setUnauthorizedHandler(signOut);\n  }, [signOut]);\n\n  async function logout() {\n    try {\n      await api(\"POST\", \"/auth/logout\");\n    } catch {\n      // token already invalid\n    }\n    signOut();\n  }\n\n  const go = (path: string) => {\n    window.location.hash = `#${path}`;\n  };\n\n  const detail = /^\\/subscriptions\\/(\\d+)$/.exec(route);\n  let page;\n  if (route === \"/login\") {\n    page = user ? <SubscriptionList onOpen={(id) => go(`/subscriptions/${id}`)} /> : (\n      <AuthForms\n        onSignedIn={(u) => {\n          setUser(u);\n          go(\"/subscriptions\");\n        }}\n      />\n    );\n  } else if (route.startsWith(\"/subscriptions\")) {\n    if (!user) page = (\n      <AuthForms\n        onSignedIn={(u) => {\n          setUser(u);\n        }}\n      />\n    );\n    else if (detail) page = <SubscriptionDetail key={detail[1]} id={Number(detail[1])} onBack={() => go(\"/subscriptions\")} />;\n    else page = <SubscriptionList onOpen={(id) => go(`/subscriptions/${id}`)} />;\n  } else {\n    page = <PublicPage />;\n  }\n\n  const link = \"text-sm font-medium text-slate-700 hover:text-indigo-600\";\n  return (\n    <div className=\"min-h-screen text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between px-4 py-3\">\n          <nav className=\"flex items-center gap-4\">\n            <span className=\"font-bold text-indigo-700\">Billing console</span>\n            <a className={link} href=\"#/\">\n              Summary\n            </a>\n            {user && (\n              <a className={link} href=\"#/subscriptions\">\n                Subscriptions\n              </a>\n            )}\n          </nav>\n          <div className=\"flex items-center gap-3 text-sm\">\n            {user ? (\n              <>\n                <span data-testid=\"current-user\">{user}</span>\n                <button\n                  className=\"rounded border border-slate-300 px-3 py-1 hover:bg-slate-100\"\n                  onClick={logout}\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <a className={link} href=\"#/login\">\n                Sign in / Register\n              </a>\n            )}\n          </div>\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">{page}</main>\n    </div>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20","time":{"start":1794253052474,"end":1794253054087}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1d0da280012dYM6clK5733m