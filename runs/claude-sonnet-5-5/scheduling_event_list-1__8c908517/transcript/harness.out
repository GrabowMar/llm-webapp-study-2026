{"type":"tool_use","timestamp":1794254195882,"sessionID":"ses_e3e1fa429ffeKdBPR0VbYYeFeh","part":{"type":"tool","tool":"bash","callID":"toolu_01X8Fi4RfhTxDA3aCJgDDhe4","state":{"status":"completed","input":{"command":"cd /workspace && cat > .gitignore <<'EOF'\nnode_modules/\nfrontend/dist/\n__pycache__/\ndata/*\n!data/.gitkeep\nEOF\ncat > backend/app.py <<'EOF'\n\"\"\"Event calendar: Flask JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import UTC, date, datetime, timedelta\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"calendar.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_USERNAME = 64\nMIN_PASSWORD = 6\nMAX_PASSWORD = 256\nMAX_TITLE = 200\nMAX_LOCATION = 200\nMAX_DESCRIPTION = 5000\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS events (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    description TEXT,\n    location TEXT,\n    start_time TEXT NOT NULL,\n    end_time TEXT,\n    created_at TEXT NOT NULL,\n    created_by TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS events_start ON events(start_time);\n\"\"\"\n\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str, errors: dict | None = None):\n        self.status = status\n        self.message = message\n        self.errors = errors\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(e: ApiError):\n    body = {\"error\": e.message}\n    if e.errors:\n        body[\"errors\"] = e.errors\n    return jsonify(body), e.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(e: HTTPException):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": e.description or e.name}), e.code\n    return e\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(e: Exception):\n    app.logger.exception(\"unhandled error\")\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\n# ---------- time helpers ----------\n\nMIN_DT = datetime(1, 1, 2, tzinfo=UTC)\nMAX_DT = datetime(9999, 12, 30, tzinfo=UTC)\n\n\ndef parse_dt(value) -> datetime:\n    if not isinstance(value, str) or not value.strip():\n        raise ValueError(\"must be an ISO 8601 date-time string\")\n    text = value.strip()\n    if text[-1] in \"zZ\":\n        text = text[:-1] + \"+00:00\"\n    try:\n        dt = datetime.fromisoformat(text)\n    except ValueError:\n        raise ValueError(\"must be an ISO 8601 date-time, e.g. 2025-01-31T14:30:00Z\") from None\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=UTC)\n    try:\n        dt = dt.astimezone(UTC)\n    except (OverflowError, ValueError):\n        raise ValueError(\"is out of range\") from None\n    if not (MIN_DT <= dt <= MAX_DT):\n        raise ValueError(\"is out of range\")\n    return dt\n\n\ndef to_db(dt: datetime) -> str:\n    return f\"{dt.year:04d}-{dt.month:02d}-{dt.day:02d}T{dt:%H:%M:%S}.{dt.microsecond:06d}Z\"\n\n\ndef to_api(stored: str | None) -> str | None:\n    if stored is None:\n        return None\n    head, frac = stored[:-1].split(\".\")\n    frac = frac.rstrip(\"0\")\n    return f\"{head}.{frac}Z\" if frac else f\"{head}Z\"\n\n\ndef now_utc() -> datetime:\n    return datetime.now(UTC)\n\n\n# ---------- auth ----------\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] <= to_db(now_utc()):\n        return None\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            raise ApiError(401, \"Authentication required\")\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef credentials() -> tuple[str, str]:\n    data = json_body()\n    username, password = data.get(\"username\"), data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return username, password\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = credentials()\n    username = username.strip()\n    errors = {}\n    if len(username) > MAX_USERNAME:\n        errors[\"username\"] = f\"Username must be at most {MAX_USERNAME} characters\"\n    if len(password) < MIN_PASSWORD:\n        errors[\"password\"] = f\"Password must be at least {MIN_PASSWORD} characters\"\n    elif len(password) > MAX_PASSWORD:\n        errors[\"password\"] = f\"Password must be at most {MAX_PASSWORD} characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), to_db(now_utc())),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(\n            409, \"Username already taken\", {\"username\": \"Username already taken\"}\n        ) from None\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = credentials()\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        raise ApiError(401, \"Invalid username or password\")\n    if not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    now = now_utc()\n    conn.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (to_db(now),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), row[\"id\"], to_db(now + TOKEN_TTL)),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return jsonify({\"username\": g.user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    token = request.headers[\"Authorization\"].split(None, 1)[1].strip()\n    db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(token),))\n    db().commit()\n    return \"\", 204\n\n\n# ---------- events ----------\n\n\ndef event_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": to_api(row[\"start_time\"]),\n        \"end_time\": to_api(row[\"end_time\"]),\n        \"created_at\": to_api(row[\"created_at\"]),\n        \"created_by\": row[\"created_by\"],\n    }\n\n\ndef optional_text(data: dict, field: str, label: str, limit: int, errors: dict):\n    value = data.get(field)\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        errors[field] = f\"{label} must be a string\"\n        return None\n    if len(value) > limit:\n        errors[field] = f\"{label} must be at most {limit} characters\"\n        return None\n    value = value.strip()\n    return value or None\n\n\ndef validate_event(data: dict) -> dict:\n    errors: dict[str, str] = {}\n\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n        title = None\n    elif len(title.strip()) > MAX_TITLE:\n        errors[\"title\"] = f\"Title must be at most {MAX_TITLE} characters\"\n        title = None\n    else:\n        title = title.strip()\n\n    description = optional_text(data, \"description\", \"Description\", MAX_DESCRIPTION, errors)\n    location = optional_text(data, \"location\", \"Location\", MAX_LOCATION, errors)\n\n    start = end = None\n    if data.get(\"start_time\") is None:\n        errors[\"start_time\"] = \"Start time is required\"\n    else:\n        try:\n            start = parse_dt(data[\"start_time\"])\n        except ValueError as e:\n            errors[\"start_time\"] = f\"Start time {e}\"\n    if data.get(\"end_time\") is not None:\n        try:\n            end = parse_dt(data[\"end_time\"])\n        except ValueError as e:\n            errors[\"end_time\"] = f\"End time {e}\"\n    if start and end and end < start:\n        errors[\"end_time\"] = \"End time must not be before start time\"\n\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return {\n        \"title\": title,\n        \"description\": description,\n        \"location\": location,\n        \"start_time\": to_db(start),\n        \"end_time\": to_db(end) if end else None,\n    }\n\n\nDATE_ONLY = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\n\ndef parse_range_param(name: str, upper: bool) -> str | None:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return None\n    try:\n        dt = parse_dt(raw)\n        if DATE_ONLY.match(raw.strip()) and upper:\n            dt = dt + timedelta(days=1) - timedelta(microseconds=1)\n    except (ValueError, OverflowError):\n        raise ApiError(\n            400, \"Validation failed\", {name: f\"{name} must be an ISO 8601 date or date-time\"}\n        ) from None\n    return to_db(dt)\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    lo = parse_range_param(\"start_date\", upper=False)\n    hi = parse_range_param(\"end_date\", upper=True)\n    if lo and hi and hi < lo:\n        raise ApiError(400, \"Validation failed\", {\"end_date\": \"end_date must not be before start_date\"})\n    where, params = [], []\n    if lo:\n        where.append(\"COALESCE(end_time, start_time) >= ?\")\n        params.append(lo)\n    if hi:\n        where.append(\"start_time <= ?\")\n        params.append(hi)\n    sql = \"SELECT * FROM events\"\n    if where:\n        sql += \" WHERE \" + \" AND \".join(where)\n    sql += \" ORDER BY start_time, id\"\n    rows = db().execute(sql, params).fetchall()\n    items = [event_json(r) for r in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\ndef get_event_row(event_id: int) -> sqlite3.Row:\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        raise ApiError(404, \"Event not found\")\n    return row\n\n\n@app.post(\"/api/events\")\n@login_required\ndef create_event():\n    fields = validate_event(json_body())\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO events (title, description, location, start_time, end_time, created_at, created_by) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            to_db(now_utc()),\n            g.user[\"username\"],\n        ),\n    )\n    conn.commit()\n    return jsonify(event_json(get_event_row(cur.lastrowid))), 201\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id: int):\n    return jsonify(event_json(get_event_row(event_id)))\n\n\n@app.put(\"/api/events/<int:event_id>\")\n@login_required\ndef update_event(event_id: int):\n    get_event_row(event_id)\n    fields = validate_event(json_body())\n    conn = db()\n    conn.execute(\n        \"UPDATE events SET title = ?, description = ?, location = ?, start_time = ?, end_time = ? \"\n        \"WHERE id = ?\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            event_id,\n        ),\n    )\n    conn.commit()\n    return jsonify(event_json(get_event_row(event_id)))\n\n\n@app.delete(\"/api/events/<int:event_id>\")\n@login_required\ndef delete_event(event_id: int):\n    get_event_row(event_id)\n    db().execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    db().commit()\n    return \"\", 204\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n# ---------- frontend ----------\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        raise ApiError(404, \"Not found\")\n    if (DIST / path).is_file():\n        resp = send_from_directory(DIST, path)\n    else:\n        resp = send_from_directory(DIST, \"index.html\")\n    if resp.mimetype == \"text/html\":\n        resp.headers[\"Cache-Control\"] = \"no-cache\"\n    return resp\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cd /workspace && cat > .gitignore <<'EOF'\nnode_modules/\nfrontend/dist/\n__pycache__/\ndata/*\n!data/.gitkeep\nEOF\ncat > backend/app.py <<'EOF'\n\"\"\"Event calendar: Flask JSON API under /api plus the built frontend.\"\"\"\n\nimport hashlib\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import UTC, date, datetime, timedelta\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"calendar.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_USERNAME = 64\nMIN_PASSWORD = 6\nMAX_PASSWORD = 256\nMAX_TITLE = 200\nMAX_LOCATION = 200\nMAX_DESCRIPTION = 5000\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS events (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    title TEXT NOT NULL,\n    description TEXT,\n    location TEXT,\n    start_time TEXT NOT NULL,\n    end_time TEXT,\n    created_at TEXT NOT NULL,\n    created_by TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS events_start ON events(start_time);\n\"\"\"\n\nDUMMY_HASH = generate_password_hash(\"dummy-password\")\n\n\ndef connect() -> sqlite3.Connection:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\nclass ApiError(Exception):\n    def __init__(self, status: int, message: str, errors: dict | None = None):\n        self.status = status\n        self.message = message\n        self.errors = errors\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(e: ApiError):\n    body = {\"error\": e.message}\n    if e.errors:\n        body[\"errors\"] = e.errors\n    return jsonify(body), e.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(e: HTTPException):\n    if request.path.startswith(\"/api\"):\n        return jsonify({\"error\": e.description or e.name}), e.code\n    return e\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(e: Exception):\n    app.logger.exception(\"unhandled error\")\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\n# ---------- time helpers ----------\n\nMIN_DT = datetime(1, 1, 2, tzinfo=UTC)\nMAX_DT = datetime(9999, 12, 30, tzinfo=UTC)\n\n\ndef parse_dt(value) -> datetime:\n    if not isinstance(value, str) or not value.strip():\n        raise ValueError(\"must be an ISO 8601 date-time string\")\n    text = value.strip()\n    if text[-1] in \"zZ\":\n        text = text[:-1] + \"+00:00\"\n    try:\n        dt = datetime.fromisoformat(text)\n    except ValueError:\n        raise ValueError(\"must be an ISO 8601 date-time, e.g. 2025-01-31T14:30:00Z\") from None\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=UTC)\n    try:\n        dt = dt.astimezone(UTC)\n    except (OverflowError, ValueError):\n        raise ValueError(\"is out of range\") from None\n    if not (MIN_DT <= dt <= MAX_DT):\n        raise ValueError(\"is out of range\")\n    return dt\n\n\ndef to_db(dt: datetime) -> str:\n    return f\"{dt.year:04d}-{dt.month:02d}-{dt.day:02d}T{dt:%H:%M:%S}.{dt.microsecond:06d}Z\"\n\n\ndef to_api(stored: str | None) -> str | None:\n    if stored is None:\n        return None\n    head, frac = stored[:-1].split(\".\")\n    frac = frac.rstrip(\"0\")\n    return f\"{head}.{frac}Z\" if frac else f\"{head}Z\"\n\n\ndef now_utc() -> datetime:\n    return datetime.now(UTC)\n\n\n# ---------- auth ----------\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    token = parts[1].strip()\n    if not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] <= to_db(now_utc()):\n        return None\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            raise ApiError(401, \"Authentication required\")\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef credentials() -> tuple[str, str]:\n    data = json_body()\n    username, password = data.get(\"username\"), data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return username, password\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password = credentials()\n    username = username.strip()\n    errors = {}\n    if len(username) > MAX_USERNAME:\n        errors[\"username\"] = f\"Username must be at most {MAX_USERNAME} characters\"\n    if len(password) < MIN_PASSWORD:\n        errors[\"password\"] = f\"Password must be at least {MIN_PASSWORD} characters\"\n    elif len(password) > MAX_PASSWORD:\n        errors[\"password\"] = f\"Password must be at most {MAX_PASSWORD} characters\"\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), to_db(now_utc())),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(\n            409, \"Username already taken\", {\"username\": \"Username already taken\"}\n        ) from None\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password = credentials()\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        raise ApiError(401, \"Invalid username or password\")\n    if not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    now = now_utc()\n    conn.execute(\"DELETE FROM tokens WHERE expires_at <= ?\", (to_db(now),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), row[\"id\"], to_db(now + TOKEN_TTL)),\n    )\n    conn.commit()\n    return jsonify({\"token\": token, \"username\": row[\"username\"]})\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return jsonify({\"username\": g.user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    token = request.headers[\"Authorization\"].split(None, 1)[1].strip()\n    db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(token),))\n    db().commit()\n    return \"\", 204\n\n\n# ---------- events ----------\n\n\ndef event_json(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"location\": row[\"location\"],\n        \"start_time\": to_api(row[\"start_time\"]),\n        \"end_time\": to_api(row[\"end_time\"]),\n        \"created_at\": to_api(row[\"created_at\"]),\n        \"created_by\": row[\"created_by\"],\n    }\n\n\ndef optional_text(data: dict, field: str, label: str, limit: int, errors: dict):\n    value = data.get(field)\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        errors[field] = f\"{label} must be a string\"\n        return None\n    if len(value) > limit:\n        errors[field] = f\"{label} must be at most {limit} characters\"\n        return None\n    value = value.strip()\n    return value or None\n\n\ndef validate_event(data: dict) -> dict:\n    errors: dict[str, str] = {}\n\n    title = data.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        errors[\"title\"] = \"Title is required\"\n        title = None\n    elif len(title.strip()) > MAX_TITLE:\n        errors[\"title\"] = f\"Title must be at most {MAX_TITLE} characters\"\n        title = None\n    else:\n        title = title.strip()\n\n    description = optional_text(data, \"description\", \"Description\", MAX_DESCRIPTION, errors)\n    location = optional_text(data, \"location\", \"Location\", MAX_LOCATION, errors)\n\n    start = end = None\n    if data.get(\"start_time\") is None:\n        errors[\"start_time\"] = \"Start time is required\"\n    else:\n        try:\n            start = parse_dt(data[\"start_time\"])\n        except ValueError as e:\n            errors[\"start_time\"] = f\"Start time {e}\"\n    if data.get(\"end_time\") is not None:\n        try:\n            end = parse_dt(data[\"end_time\"])\n        except ValueError as e:\n            errors[\"end_time\"] = f\"End time {e}\"\n    if start and end and end < start:\n        errors[\"end_time\"] = \"End time must not be before start time\"\n\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return {\n        \"title\": title,\n        \"description\": description,\n        \"location\": location,\n        \"start_time\": to_db(start),\n        \"end_time\": to_db(end) if end else None,\n    }\n\n\nDATE_ONLY = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\n\ndef parse_range_param(name: str, upper: bool) -> str | None:\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return None\n    try:\n        dt = parse_dt(raw)\n        if DATE_ONLY.match(raw.strip()) and upper:\n            dt = dt + timedelta(days=1) - timedelta(microseconds=1)\n    except (ValueError, OverflowError):\n        raise ApiError(\n            400, \"Validation failed\", {name: f\"{name} must be an ISO 8601 date or date-time\"}\n        ) from None\n    return to_db(dt)\n\n\n@app.get(\"/api/events\")\ndef list_events():\n    lo = parse_range_param(\"start_date\", upper=False)\n    hi = parse_range_param(\"end_date\", upper=True)\n    if lo and hi and hi < lo:\n        raise ApiError(400, \"Validation failed\", {\"end_date\": \"end_date must not be before start_date\"})\n    where, params = [], []\n    if lo:\n        where.append(\"COALESCE(end_time, start_time) >= ?\")\n        params.append(lo)\n    if hi:\n        where.append(\"start_time <= ?\")\n        params.append(hi)\n    sql = \"SELECT * FROM events\"\n    if where:\n        sql += \" WHERE \" + \" AND \".join(where)\n    sql += \" ORDER BY start_time, id\"\n    rows = db().execute(sql, params).fetchall()\n    items = [event_json(r) for r in rows]\n    return jsonify({\"items\": items, \"total\": len(items)})\n\n\ndef get_event_row(event_id: int) -> sqlite3.Row:\n    row = db().execute(\"SELECT * FROM events WHERE id = ?\", (event_id,)).fetchone()\n    if row is None:\n        raise ApiError(404, \"Event not found\")\n    return row\n\n\n@app.post(\"/api/events\")\n@login_required\ndef create_event():\n    fields = validate_event(json_body())\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO events (title, description, location, start_time, end_time, created_at, created_by) \"\n        \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            to_db(now_utc()),\n            g.user[\"username\"],\n        ),\n    )\n    conn.commit()\n    return jsonify(event_json(get_event_row(cur.lastrowid))), 201\n\n\n@app.get(\"/api/events/<int:event_id>\")\ndef get_event(event_id: int):\n    return jsonify(event_json(get_event_row(event_id)))\n\n\n@app.put(\"/api/events/<int:event_id>\")\n@login_required\ndef update_event(event_id: int):\n    get_event_row(event_id)\n    fields = validate_event(json_body())\n    conn = db()\n    conn.execute(\n        \"UPDATE events SET title = ?, description = ?, location = ?, start_time = ?, end_time = ? \"\n        \"WHERE id = ?\",\n        (\n            fields[\"title\"],\n            fields[\"description\"],\n            fields[\"location\"],\n            fields[\"start_time\"],\n            fields[\"end_time\"],\n            event_id,\n        ),\n    )\n    conn.commit()\n    return jsonify(event_json(get_event_row(event_id)))\n\n\n@app.delete(\"/api/events/<int:event_id>\")\n@login_required\ndef delete_event(event_id: int):\n    get_event_row(event_id)\n    db().execute(\"DELETE FROM events WHERE id = ?\", (event_id,))\n    db().commit()\n    return \"\", 204\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n# ---------- frontend ----------\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        raise ApiError(404, \"Not found\")\n    if (DIST / path).is_file():\n        resp = send_from_directory(DIST, path)\n    else:\n        resp = send_from_directory(DIST, \"index.html\")\n    if resp.mimetype == \"text/html\":\n        resp.headers[\"Cache-Control\"] = \"no-cache\"\n    return resp\n\n\ninit_db()\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=int(os.environ.get(\"PORT\", \"8000\")))\nEOF","time":{"start":1794254195844,"end":1794254195859}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1e24c7a0019G3FRVk2iJmZyO","sessionID":"ses_e3e1fa429ffeKdBPR0VbYYeFeh","messageID":"msg_1c1e182a7001SDW501wZKId7xi"}}
