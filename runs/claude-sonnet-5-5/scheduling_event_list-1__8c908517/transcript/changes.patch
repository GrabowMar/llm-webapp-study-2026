@@ -0,0 +1,114 @@
+import { useState, type FormEvent } from "react";
+import * as api from "./api";
+import { fromLocalInput, toLocalInput } from "./dates";
+import type { CalEvent } from "./types";
+import { Button, Field, Modal, inputClass } from "./ui";
+
+export default function EventForm({
+  event,
+  defaultStart,
+  onClose,
+  onSaved,
+}: {
+  event: CalEvent | null;
+  defaultStart: Date;
+  onClose: () => void;
+  onSaved: () => void;
+}) {
+  const [title, setTitle] = useState(event?.title ?? "");
+  const [description, setDescription] = useState(event?.description ?? "");
+  const [location, setLocation] = useState(event?.location ?? "");
+  const [start, setStart] = useState(toLocalInput(event?.start_time ?? defaultStart.toISOString()));
+  const [end, setEnd] = useState(toLocalInput(event?.end_time));
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const [message, setMessage] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    setErrors({});
+    setMessage("");
+    setBusy(true);
+    const payload = {
+      title,
+      description: description || null,
+      location: location || null,
+      start_time: start ? (fromLocalInput(start) ?? start) : "",
+      end_time: end ? (fromLocalInput(end) ?? end) : null,
+    };
+    try {
+      if (event) await api.updateEvent(event.id, payload);
+      else await api.createEvent(payload);
+      onSaved();
+    } catch (err) {
+      if (err instanceof api.ApiError) {
+        setErrors(err.fieldErrors);
+        if (Object.keys(err.fieldErrors).length === 0) setMessage(err.message);
+      } else setMessage("Something went wrong");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <Modal title={event ? "Edit event" : "New event"} onClose={onClose}>
+      <form onSubmit={submit} noValidate>
+        <Field label="Title" error={errors.title}>
+          <input
+            className={inputClass}
+            name="title"
+            autoFocus
+            value={title}
+            onChange={(e) => setTitle(e.target.value)}
+          />
+        </Field>
+        <Field label="Start" error={errors.start_time}>
+          <input
+            className={inputClass}
+            name="start_time"
+            type="datetime-local"
+            value={start}
+            onChange={(e) => setStart(e.target.value)}
+          />
+        </Field>
+        <Field label="End (optional)" error={errors.end_time}>
+          <input
+            className={inputClass}
+            name="end_time"
+            type="datetime-local"
+            value={end}
+            onChange={(e) => setEnd(e.target.value)}
+          />
+        </Field>
+        <Field label="Location (optional)" error={errors.location}>
+          <input
+            className={inputClass}
+            name="location"
+            value={location}
+            onChange={(e) => setLocation(e.target.value)}
+          />
+        </Field>
+        <Field label="Description (optional)" error={errors.description}>
+          <textarea
+            className={inputClass}
+            name="description"
+            rows={3}
+            value={description}
+            onChange={(e) => setDescription(e.target.value)}
+          />
+        </Field>
+        {message && (
+          <p role="alert" className="mb-3 text-sm text-red-600">
+            {message}
+          </p>
+        )}
+        <div className="flex justify-end gap-2">
+          <Button onClick={onClose}>Cancel</Button>
+          <Button type="submit" variant="primary" disabled={busy}>
+            Save
+          </Button>
+        </div>
+      </form>
+    </Modal>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..2a99a3b
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,72 @@
+import type { CalEvent, EventInput } from "./types";
+
+export class ApiError extends Error {
+  status: number;
+  fieldErrors: Record<string, string>;
+  constructor(status: number, message: string, fieldErrors: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.fieldErrors = fieldErrors;
+  }
+}
+
+let token: string | null = null;
+let onUnauthorized: () => void = () => {};
+
+export function setToken(t: string | null) {
+  token = t;
+}
+
+export function setUnauthorizedHandler(fn: () => void) {
+  onUnauthorized = fn;
+}
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  let res: Response;
+  try {
+    res = await fetch(`/api${path}`, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError(0, "Network error, please try again");
+  }
+  if (res.status === 204) return undefined as T;
+  let data: { error?: string; errors?: Record<string, string> } | null = null;
+  try {
+    data = await res.json();
+  } catch {
+    data = null;
+  }
+  if (!res.ok) {
+    if (res.status === 401 && token) onUnauthorized();
+    throw new ApiError(res.status, data?.error ?? `Request failed (${res.status})`, data?.errors ?? {});
+  }
+  return data as T;
+}
+
+export const register = (username: string, password: string) =>
+  request<{ id: number; username: string }>("POST", "/auth/register", { username, password });
+
+export const login = (username: string, password: string) =>
+  request<{ token: string; username: string }>("POST", "/auth/login", { username, password });
+
+export const logout = () => request<void>("POST", "/auth/logout");
+
+export const me = () => request<{ username: string }>("GET", "/auth/me");
+
+export const listEvents = (startIso: string, endIso: string) =>
+  request<{ items: CalEvent[]; total: number }>(
+    "GET",
+    `/events?start_date=${encodeURIComponent(startIso)}&end_date=${encodeURIComponent(endIso)}`,
+  );
+
+export const createEvent = (e: EventInput) => request<CalEvent>("POST", "/events", e);
+
+export const updateEvent = (id: number, e: EventInput) => request<CalEvent>("PUT", `/events/${id}`, e);
+
+export const deleteEvent = (id: number) => request<void>("DELETE", `/events/${id}`);
diff --git a/frontend/src/dates.ts b/frontend/src/dates.ts
new file mode 100644
index 0000000..22692de
--- /dev/null
+++ b/frontend/src/dates.ts
@@ -0,0 +1,83 @@
+import type { CalEvent, ViewMode } from "./types";
+
+export const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
+export const addDays = (d: Date, n: number) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
+export const startOfWeek = (d: Date) => addDays(startOfDay(d), -d.getDay());
+export const startOfMonth = (d: Date) => new Date(d.getFullYear(), d.getMonth(), 1);
+
+export const sameDay = (a: Date, b: Date) =>
+  a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
+
+export function shift(d: Date, view: ViewMode, dir: 1 | -1): Date {
+  if (view === "month") return new Date(d.getFullYear(), d.getMonth() + dir, 1);
+  return addDays(d, dir * (view === "week" ? 7 : 1));
+}
+
+export function range(d: Date, view: ViewMode): { start: Date; end: Date } {
+  if (view === "day") {
+    const s = startOfDay(d);
+    return { start: s, end: addDays(s, 1) };
+  }
+  if (view === "week") {
+    const s = startOfWeek(d);
+    return { start: s, end: addDays(s, 7) };
+  }
+  const s = startOfWeek(startOfMonth(d));
+  const last = new Date(d.getFullYear(), d.getMonth() + 1, 0);
+  const e = addDays(startOfWeek(last), 7);
+  return { start: s, end: e };
+}
+
+export function daysIn(start: Date, end: Date): Date[] {
+  const out: Date[] = [];
+  for (let d = start; d < end; d = addDays(d, 1)) out.push(d);
+  return out;
+}
+
+export function eventsOn(events: CalEvent[], day: Date): CalEvent[] {
+  const s = day.getTime();
+  const e = addDays(day, 1).getTime();
+  return events.filter((ev) => {
+    const st = new Date(ev.start_time).getTime();
+    const en = ev.end_time ? new Date(ev.end_time).getTime() : st;
+    return st < e && (en > s || (en === st && st >= s));
+  });
+}
+
+export const fmtTime = (iso: string) =>
+  new Date(iso).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
+
+export const fmtDateTime = (iso: string) =>
+  new Date(iso).toLocaleString([], {
+    weekday: "short",
+    year: "numeric",
+    month: "short",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+  });
+
+export function title(d: Date, view: ViewMode): string {
+  if (view === "month") return d.toLocaleDateString([], { month: "long", year: "numeric" });
+  if (view === "day")
+    return d.toLocaleDateString([], { weekday: "long", month: "long", day: "numeric", year: "numeric" });
+  const { start } = range(d, "week");
+  const end = addDays(start, 6);
+  const a = start.toLocaleDateString([], { month: "short", day: "numeric" });
+  const b = end.toLocaleDateString([], { month: "short", day: "numeric", year: "numeric" });
+  return `${a} – ${b}`;
+}
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const d = new Date(iso);
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+export function fromLocalInput(v: string): string | null {
+  if (!v) return null;
+  const d = new Date(v);
+  return Number.isNaN(d.getTime()) ? null : d.toISOString();
+}
