{"type":"tool_use","timestamp":1794253002183,"sessionID":"ses_e3e322bb8ffesEO3Q1Hn3a7zSY","part":{"type":"tool","tool":"bash","callID":"toolu_01CpBHApunx4c3eLWZ9Vt3PS","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Customer directory: Flask API plus the built React frontend.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom itsdangerous import BadData, URLSafeTimedSerializer\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or ROOT / \"data\")\nDB_PATH = DATA_DIR / \"directory.db\"\nTOKEN_MAX_AGE = 7 * 24 * 3600\nKINDS = (\"call\", \"email\", \"meeting\")\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\nDUMMY_HASH = generate_password_hash(\"not-a-real-password\")\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\n\ndef load_secret() -> str:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    path = DATA_DIR / \"secret.key\"\n    try:\n        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n    except FileExistsError:\n        return path.read_text().strip()\n    with os.fdopen(fd, \"w\") as fh:\n        fh.write(secrets.token_hex(32))\n    return path.read_text().strip()\n\n\nserializer = URLSafeTimedSerializer(load_secret(), salt=\"auth-token\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS customers (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            name TEXT NOT NULL,\n            email TEXT NOT NULL UNIQUE COLLATE NOCASE,\n            phone TEXT,\n            company TEXT,\n            notes TEXT,\n            created_at TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_customers_name ON customers (name COLLATE NOCASE);\n        CREATE TABLE IF NOT EXISTS interactions (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            customer_id INTEGER NOT NULL REFERENCES customers (id) ON DELETE CASCADE,\n            kind TEXT NOT NULL,\n            summary TEXT NOT NULL,\n            occurred_at TEXT NOT NULL,\n            user_id INTEGER NOT NULL REFERENCES users (id)\n        );\n        CREATE INDEX IF NOT EXISTS idx_interactions_customer\n            ON interactions (customer_id, occurred_at);\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef fmt_time(dt: datetime) -> str:\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef now() -> str:\n    return fmt_time(datetime.now(timezone.utc))\n\n\ndef error(message: str, status: int, errors: dict | None = None):\n    body: dict = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http(exc: HTTPException):\n    if request.path.startswith(\"/api/\"):\n        return error(exc.description or exc.name, exc.code or 500)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(exc: Exception):\n    app.logger.exception(\"Unhandled error\")\n    return error(\"Internal server error\", 500)\n\n\ndef json_object():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    try:\n        user_id = serializer.loads(token.strip(), max_age=TOKEN_MAX_AGE)\n    except BadData:\n        return None\n    if not isinstance(user_id, int):\n        return None\n    return db().execute(\n        \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n    ).fetchone()\n\n\n@app.before_request\ndef require_auth():\n    path = request.path\n    if not path.startswith(\"/api/\") or request.method == \"OPTIONS\":\n        return None\n    if path in (\"/api/health\", \"/api/auth/register\", \"/api/auth/login\"):\n        return None\n    user = current_user()\n    if user is None:\n        resp, status = error(\"Authentication required\", 401)\n        resp.headers[\"WWW-Authenticate\"] = \"Bearer\"\n        return resp, status\n    g.user = user\n    return None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\ndef credentials():\n    data = json_object()\n    if data is None:\n        return None, None, error(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = credentials()\n    if err:\n        return err\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    elif len(username.strip()) > 64:\n        errors[\"username\"] = \"Username must be at most 64 characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters\"\n    elif len(password) > 256:\n        errors[\"password\"] = \"Password must be at most 256 characters\"\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    username = username.strip()\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\n            \"Validation failed\", 409, {\"username\": \"This username is already taken\"}\n        )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = credentials()\n    if err:\n        return err\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Invalid username or password\", 401)\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    stored = row[\"password_hash\"] if row else DUMMY_HASH\n    ok = check_password_hash(stored, password)\n    if not row or not ok:\n        return error(\"Invalid username or password\", 401)\n    return jsonify({\"token\": serializer.dumps(row[\"id\"])})\n\n\nCUSTOMER_SELECT = \"\"\"\n    SELECT c.id, c.name, c.email, c.phone, c.company, c.notes, c.created_at,\n           (SELECT COUNT(*) FROM interactions i WHERE i.customer_id = c.id)\n               AS interaction_count,\n           (SELECT MAX(i.occurred_at) FROM interactions i WHERE i.customer_id = c.id)\n               AS last_contacted_at\n    FROM customers c\n\"\"\"\n\n\ndef customer_dict(row: sqlite3.Row) -> dict:\n    return {k: row[k] for k in row.keys()}\n\n\ndef fetch_customer(customer_id: int):\n    return db().execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (customer_id,)).fetchone()\n\n\ndef clean_text(data, field, label, max_len, required=False):\n    value = data.get(field)\n    if value is None:\n        return (None, f\"{label} is required\") if required else (None, None)\n    if not isinstance(value, str):\n        return None, f\"{label} must be a string\"\n    value = value.strip()\n    if not value:\n        return (None, f\"{label} is required\") if required else (None, None)\n    if len(value) > max_len:\n        return None, f\"{label} must be at most {max_len} characters\"\n    return value, None\n\n\ndef validate_customer(data):\n    errors = {}\n    values = {}\n    for field, label, max_len, required in (\n        (\"name\", \"Name\", 200, True),\n        (\"email\", \"Email\", 254, True),\n        (\"phone\", \"Phone\", 50, False),\n        (\"company\", \"Company\", 200, False),\n        (\"notes\", \"Notes\", 5000, False),\n    ):\n        value, msg = clean_text(data, field, label, max_len, required)\n        if msg:\n            errors[field] = msg\n        values[field] = value\n    if \"email\" not in errors and not EMAIL_RE.match(values[\"email\"]):\n        errors[\"email\"] = \"Email is not a valid email address\"\n    if \"email\" not in errors:\n        values[\"email\"] = values[\"email\"].lower()\n    return values, errors\n\n\nDUPLICATE = {\"email\": \"A customer with this email already exists\"}\n\n\ndef email_taken(email: str, exclude_id: int | None = None) -> bool:\n    row = db().execute(\n        \"SELECT id FROM customers WHERE email = ? COLLATE NOCASE AND id IS NOT ?\",\n        (email, exclude_id),\n    ).fetchone()\n    return row is not None\n\n\ndef like_escape(text: str) -> str:\n    return text.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\ndef int_param(name: str, default: int):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        return int(raw), None\n    except ValueError:\n        return default, f\"{name} must be an integer\"\n\n\n@app.get(\"/api/customers\")\ndef list_customers():\n    errors = {}\n    page, msg = int_param(\"page\", 1)\n    if msg:\n        errors[\"page\"] = msg\n    page_size, msg = int_param(\"page_size\", 20)\n    if msg:\n        errors[\"page_size\"] = msg\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    page = max(page, 1)\n    page_size = min(max(page_size, 1), 100)\n\n    where, params = [], []\n    q = (request.args.get(\"q\") or \"\").strip()\n    if q:\n        pattern = f\"%{like_escape(q)}%\"\n        where.append(\n            \"(c.name LIKE ? ESCAPE '\\\\' OR c.email LIKE ? ESCAPE '\\\\' \"\n            \"OR c.company LIKE ? ESCAPE '\\\\' OR c.phone LIKE ? ESCAPE '\\\\')\"\n        )\n        params += [pattern] * 4\n    company = (request.args.get(\"company\") or \"\").strip()\n    if company:\n        where.append(\"c.company = ? COLLATE NOCASE\")\n        params.append(company)\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    total = db().execute(\n        \"SELECT COUNT(*) FROM customers c\" + clause, params\n    ).fetchone()[0]\n    rows = db().execute(\n        CUSTOMER_SELECT\n        + clause\n        + \" ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [customer_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/companies\")\ndef list_companies():\n    rows = db().execute(\n        \"SELECT DISTINCT company FROM customers WHERE company IS NOT NULL \"\n        \"ORDER BY company COLLATE NOCASE\"\n    ).fetchall()\n    return jsonify({\"items\": [r[\"company\"] for r in rows]})\n\n\n@app.post(\"/api/customers\")\ndef create_customer():\n    data = json_object()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    values, errors = validate_customer(data)\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    if email_taken(values[\"email\"]):\n        return error(\"Validation failed\", 409, DUPLICATE)\n    try:\n        cur = db().execute(\n            \"INSERT INTO customers (name, email, phone, company, notes, created_at) \"\n            \"VALUES (:name, :email, :phone, :company, :notes, :created_at)\",\n            {**values, \"created_at\": now()},\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Validation failed\", 409, DUPLICATE)\n    return jsonify(customer_dict(fetch_customer(cur.lastrowid))), 201\n\n\n@app.get(\"/api/customers/<int:customer_id>\")\ndef get_customer(customer_id: int):\n    row = fetch_customer(customer_id)\n    if row is None:\n        return error(\"Customer not found\", 404)\n    return jsonify(customer_dict(row))\n\n\n@app.put(\"/api/customers/<int:customer_id>\")\ndef update_customer(customer_id: int):\n    if fetch_customer(customer_id) is None:\n        return error(\"Customer not found\", 404)\n    data = json_object()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    values, errors = validate_customer(data)\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    if email_taken(values[\"email\"], customer_id):\n        return error(\"Validation failed\", 409, DUPLICATE)\n    try:\n        db().execute(\n            \"UPDATE customers SET name = :name, email = :email, phone = :phone, \"\n            \"company = :company, notes = :notes WHERE id = :id\",\n            {**values, \"id\": customer_id},\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Validation failed\", 409, DUPLICATE)\n    return jsonify(customer_dict(fetch_customer(customer_id)))\n\n\n@app.delete(\"/api/customers/<int:customer_id>\")\ndef delete_customer(customer_id: int):\n    cur = db().execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n    db().commit()\n    if cur.rowcount == 0:\n        return error(\"Customer not found\", 404)\n    return \"\", 204\n\n\nINTERACTION_SELECT = \"\"\"\n    SELECT i.id, i.customer_id, i.kind, i.summary, i.occurred_at,\n           u.username AS logged_by\n    FROM interactions i JOIN users u ON u.id = i.user_id\n\"\"\"\n\n\ndef parse_time(value):\n    if not isinstance(value, str) or not value.strip():\n        return None\n    text = value.strip()\n    if text.endswith((\"Z\", \"z\")):\n        text = text[:-1] + \"+00:00\"\n    try:\n        dt = datetime.fromisoformat(text)\n    except ValueError:\n        return None\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return fmt_time(dt)\n\n\n@app.get(\"/api/customers/<int:customer_id>/interactions\")\ndef list_interactions(customer_id: int):\n    if fetch_customer(customer_id) is None:\n        return error(\"Customer not found\", 404)\n    rows = db().execute(\n        INTERACTION_SELECT\n        + \" WHERE i.customer_id = ? ORDER BY i.occurred_at DESC, i.id DESC\",\n        (customer_id,),\n    ).fetchall()\n    return jsonify({\"items\": [dict(r) for r in rows]})\n\n\n@app.post(\"/api/customers/<int:customer_id>/interactions\")\ndef create_interaction(customer_id: int):\n    if fetch_customer(customer_id) is None:\n        return error(\"Customer not found\", 404)\n    data = json_object()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    errors = {}\n    kind = data.get(\"kind\")\n    if not isinstance(kind, str) or kind.strip().lower() not in KINDS:\n        errors[\"kind\"] = \"Kind must be one of: \" + \", \".join(KINDS)\n    summary, msg = clean_text(data, \"summary\", \"Summary\", 2000, True)\n    if msg:\n        errors[\"summary\"] = msg\n    occurred_at = now()\n    if data.get(\"occurred_at\") not in (None, \"\"):\n        occurred_at = parse_time(data[\"occurred_at\"])\n        if occurred_at is None:\n            errors[\"occurred_at\"] = \"Date must be an ISO 8601 date/time\"\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    try:\n        cur = db().execute(\n            \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, user_id) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (customer_id, kind.strip().lower(), summary, occurred_at, g.user[\"id\"]),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Customer not found\", 404)\n    row = db().execute(INTERACTION_SELECT + \" WHERE i.id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(dict(row)), 201\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(_path: str):\n    return error(\"Not found\", 404)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = (DIST / path).resolve()\n    if target.is_file() and DIST.resolve() in target.parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\npython3 -m venv /tmp/venv && /tmp/venv/bin/pip install -q -r backend/requirements.txt -c backend/requirements.lock 2>&1 | tail -2"},"output":"ERROR: Hashes are required in --require-hashes mode, but they are missing from some requirements. Here is a list of those requirements along with the hashes their downloaded archives actually had. Add lines like these to your requirements files to prevent tampering. (If you did not enable --require-hashes manually, note that it turns on automatically when any package has a hash.)\n    flask==3.1.3 --hash=sha256:f4bcbefc124291925f1a26446da31a5178f9483862233b23c0c96a20701f670c\n","metadata":{"output":"ERROR: Hashes are required in --require-hashes mode, but they are missing from some requirements. Here is a list of those requirements along with the hashes their downloaded archives actually had. Add lines like these to your requirements files to prevent tampering. (If you did not enable --require-hashes manually, note that it turns on automatically when any package has a hash.)\n    flask==3.1.3 --hash=sha256:f4bcbefc124291925f1a26446da31a5178f9483862233b23c0c96a20701f670c\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Customer directory: Flask API plus the built React frontend.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom itsdangerous import BadData, URLSafeTimedSerializer\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\") or ROOT / \"data\")\nDB_PATH = DATA_DIR / \"directory.db\"\nTOKEN_MAX_AGE = 7 * 24 * 3600\nKINDS = (\"call\", \"email\", \"meeting\")\nEMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")\nDUMMY_HASH = generate_password_hash(\"not-a-real-password\")\n\napp = Flask(__name__, static_folder=None)\napp.json.sort_keys = False\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\n\n\ndef load_secret() -> str:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    path = DATA_DIR / \"secret.key\"\n    try:\n        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n    except FileExistsError:\n        return path.read_text().strip()\n    with os.fdopen(fd, \"w\") as fh:\n        fh.write(secrets.token_hex(32))\n    return path.read_text().strip()\n\n\nserializer = URLSafeTimedSerializer(load_secret(), salt=\"auth-token\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    conn = connect()\n    conn.execute(\"PRAGMA journal_mode = WAL\")\n    conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n            password_hash TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS customers (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            name TEXT NOT NULL,\n            email TEXT NOT NULL UNIQUE COLLATE NOCASE,\n            phone TEXT,\n            company TEXT,\n            notes TEXT,\n            created_at TEXT NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_customers_name ON customers (name COLLATE NOCASE);\n        CREATE TABLE IF NOT EXISTS interactions (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            customer_id INTEGER NOT NULL REFERENCES customers (id) ON DELETE CASCADE,\n            kind TEXT NOT NULL,\n            summary TEXT NOT NULL,\n            occurred_at TEXT NOT NULL,\n            user_id INTEGER NOT NULL REFERENCES users (id)\n        );\n        CREATE INDEX IF NOT EXISTS idx_interactions_customer\n            ON interactions (customer_id, occurred_at);\n        \"\"\"\n    )\n    conn.commit()\n    conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef fmt_time(dt: datetime) -> str:\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef now() -> str:\n    return fmt_time(datetime.now(timezone.utc))\n\n\ndef error(message: str, status: int, errors: dict | None = None):\n    body: dict = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    return jsonify(body), status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http(exc: HTTPException):\n    if request.path.startswith(\"/api/\"):\n        return error(exc.description or exc.name, exc.code or 500)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(exc: Exception):\n    app.logger.exception(\"Unhandled error\")\n    return error(\"Internal server error\", 500)\n\n\ndef json_object():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    if scheme.lower() != \"bearer\" or not token.strip():\n        return None\n    try:\n        user_id = serializer.loads(token.strip(), max_age=TOKEN_MAX_AGE)\n    except BadData:\n        return None\n    if not isinstance(user_id, int):\n        return None\n    return db().execute(\n        \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n    ).fetchone()\n\n\n@app.before_request\ndef require_auth():\n    path = request.path\n    if not path.startswith(\"/api/\") or request.method == \"OPTIONS\":\n        return None\n    if path in (\"/api/health\", \"/api/auth/register\", \"/api/auth/login\"):\n        return None\n    user = current_user()\n    if user is None:\n        resp, status = error(\"Authentication required\", 401)\n        resp.headers[\"WWW-Authenticate\"] = \"Bearer\"\n        return resp, status\n    g.user = user\n    return None\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\ndef credentials():\n    data = json_object()\n    if data is None:\n        return None, None, error(\"Request body must be a JSON object\", 400)\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = credentials()\n    if err:\n        return err\n    errors = {}\n    if not isinstance(username, str) or not username.strip():\n        errors[\"username\"] = \"Username is required\"\n    elif len(username.strip()) > 64:\n        errors[\"username\"] = \"Username must be at most 64 characters\"\n    if not isinstance(password, str) or not password:\n        errors[\"password\"] = \"Password is required\"\n    elif len(password) < 6:\n        errors[\"password\"] = \"Password must be at least 6 characters\"\n    elif len(password) > 256:\n        errors[\"password\"] = \"Password must be at most 256 characters\"\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    username = username.strip()\n    try:\n        db().execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now()),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\n            \"Validation failed\", 409, {\"username\": \"This username is already taken\"}\n        )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = credentials()\n    if err:\n        return err\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(\"Invalid username or password\", 401)\n    row = db().execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    stored = row[\"password_hash\"] if row else DUMMY_HASH\n    ok = check_password_hash(stored, password)\n    if not row or not ok:\n        return error(\"Invalid username or password\", 401)\n    return jsonify({\"token\": serializer.dumps(row[\"id\"])})\n\n\nCUSTOMER_SELECT = \"\"\"\n    SELECT c.id, c.name, c.email, c.phone, c.company, c.notes, c.created_at,\n           (SELECT COUNT(*) FROM interactions i WHERE i.customer_id = c.id)\n               AS interaction_count,\n           (SELECT MAX(i.occurred_at) FROM interactions i WHERE i.customer_id = c.id)\n               AS last_contacted_at\n    FROM customers c\n\"\"\"\n\n\ndef customer_dict(row: sqlite3.Row) -> dict:\n    return {k: row[k] for k in row.keys()}\n\n\ndef fetch_customer(customer_id: int):\n    return db().execute(CUSTOMER_SELECT + \" WHERE c.id = ?\", (customer_id,)).fetchone()\n\n\ndef clean_text(data, field, label, max_len, required=False):\n    value = data.get(field)\n    if value is None:\n        return (None, f\"{label} is required\") if required else (None, None)\n    if not isinstance(value, str):\n        return None, f\"{label} must be a string\"\n    value = value.strip()\n    if not value:\n        return (None, f\"{label} is required\") if required else (None, None)\n    if len(value) > max_len:\n        return None, f\"{label} must be at most {max_len} characters\"\n    return value, None\n\n\ndef validate_customer(data):\n    errors = {}\n    values = {}\n    for field, label, max_len, required in (\n        (\"name\", \"Name\", 200, True),\n        (\"email\", \"Email\", 254, True),\n        (\"phone\", \"Phone\", 50, False),\n        (\"company\", \"Company\", 200, False),\n        (\"notes\", \"Notes\", 5000, False),\n    ):\n        value, msg = clean_text(data, field, label, max_len, required)\n        if msg:\n            errors[field] = msg\n        values[field] = value\n    if \"email\" not in errors and not EMAIL_RE.match(values[\"email\"]):\n        errors[\"email\"] = \"Email is not a valid email address\"\n    if \"email\" not in errors:\n        values[\"email\"] = values[\"email\"].lower()\n    return values, errors\n\n\nDUPLICATE = {\"email\": \"A customer with this email already exists\"}\n\n\ndef email_taken(email: str, exclude_id: int | None = None) -> bool:\n    row = db().execute(\n        \"SELECT id FROM customers WHERE email = ? COLLATE NOCASE AND id IS NOT ?\",\n        (email, exclude_id),\n    ).fetchone()\n    return row is not None\n\n\ndef like_escape(text: str) -> str:\n    return text.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\ndef int_param(name: str, default: int):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        return int(raw), None\n    except ValueError:\n        return default, f\"{name} must be an integer\"\n\n\n@app.get(\"/api/customers\")\ndef list_customers():\n    errors = {}\n    page, msg = int_param(\"page\", 1)\n    if msg:\n        errors[\"page\"] = msg\n    page_size, msg = int_param(\"page_size\", 20)\n    if msg:\n        errors[\"page_size\"] = msg\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    page = max(page, 1)\n    page_size = min(max(page_size, 1), 100)\n\n    where, params = [], []\n    q = (request.args.get(\"q\") or \"\").strip()\n    if q:\n        pattern = f\"%{like_escape(q)}%\"\n        where.append(\n            \"(c.name LIKE ? ESCAPE '\\\\' OR c.email LIKE ? ESCAPE '\\\\' \"\n            \"OR c.company LIKE ? ESCAPE '\\\\' OR c.phone LIKE ? ESCAPE '\\\\')\"\n        )\n        params += [pattern] * 4\n    company = (request.args.get(\"company\") or \"\").strip()\n    if company:\n        where.append(\"c.company = ? COLLATE NOCASE\")\n        params.append(company)\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    total = db().execute(\n        \"SELECT COUNT(*) FROM customers c\" + clause, params\n    ).fetchone()[0]\n    rows = db().execute(\n        CUSTOMER_SELECT\n        + clause\n        + \" ORDER BY c.name COLLATE NOCASE, c.id LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [customer_dict(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.get(\"/api/companies\")\ndef list_companies():\n    rows = db().execute(\n        \"SELECT DISTINCT company FROM customers WHERE company IS NOT NULL \"\n        \"ORDER BY company COLLATE NOCASE\"\n    ).fetchall()\n    return jsonify({\"items\": [r[\"company\"] for r in rows]})\n\n\n@app.post(\"/api/customers\")\ndef create_customer():\n    data = json_object()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    values, errors = validate_customer(data)\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    if email_taken(values[\"email\"]):\n        return error(\"Validation failed\", 409, DUPLICATE)\n    try:\n        cur = db().execute(\n            \"INSERT INTO customers (name, email, phone, company, notes, created_at) \"\n            \"VALUES (:name, :email, :phone, :company, :notes, :created_at)\",\n            {**values, \"created_at\": now()},\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Validation failed\", 409, DUPLICATE)\n    return jsonify(customer_dict(fetch_customer(cur.lastrowid))), 201\n\n\n@app.get(\"/api/customers/<int:customer_id>\")\ndef get_customer(customer_id: int):\n    row = fetch_customer(customer_id)\n    if row is None:\n        return error(\"Customer not found\", 404)\n    return jsonify(customer_dict(row))\n\n\n@app.put(\"/api/customers/<int:customer_id>\")\ndef update_customer(customer_id: int):\n    if fetch_customer(customer_id) is None:\n        return error(\"Customer not found\", 404)\n    data = json_object()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    values, errors = validate_customer(data)\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    if email_taken(values[\"email\"], customer_id):\n        return error(\"Validation failed\", 409, DUPLICATE)\n    try:\n        db().execute(\n            \"UPDATE customers SET name = :name, email = :email, phone = :phone, \"\n            \"company = :company, notes = :notes WHERE id = :id\",\n            {**values, \"id\": customer_id},\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Validation failed\", 409, DUPLICATE)\n    return jsonify(customer_dict(fetch_customer(customer_id)))\n\n\n@app.delete(\"/api/customers/<int:customer_id>\")\ndef delete_customer(customer_id: int):\n    cur = db().execute(\"DELETE FROM customers WHERE id = ?\", (customer_id,))\n    db().commit()\n    if cur.rowcount == 0:\n        return error(\"Customer not found\", 404)\n    return \"\", 204\n\n\nINTERACTION_SELECT = \"\"\"\n    SELECT i.id, i.customer_id, i.kind, i.summary, i.occurred_at,\n           u.username AS logged_by\n    FROM interactions i JOIN users u ON u.id = i.user_id\n\"\"\"\n\n\ndef parse_time(value):\n    if not isinstance(value, str) or not value.strip():\n        return None\n    text = value.strip()\n    if text.endswith((\"Z\", \"z\")):\n        text = text[:-1] + \"+00:00\"\n    try:\n        dt = datetime.fromisoformat(text)\n    except ValueError:\n        return None\n    if dt.tzinfo is None:\n        dt = dt.replace(tzinfo=timezone.utc)\n    return fmt_time(dt)\n\n\n@app.get(\"/api/customers/<int:customer_id>/interactions\")\ndef list_interactions(customer_id: int):\n    if fetch_customer(customer_id) is None:\n        return error(\"Customer not found\", 404)\n    rows = db().execute(\n        INTERACTION_SELECT\n        + \" WHERE i.customer_id = ? ORDER BY i.occurred_at DESC, i.id DESC\",\n        (customer_id,),\n    ).fetchall()\n    return jsonify({\"items\": [dict(r) for r in rows]})\n\n\n@app.post(\"/api/customers/<int:customer_id>/interactions\")\ndef create_interaction(customer_id: int):\n    if fetch_customer(customer_id) is None:\n        return error(\"Customer not found\", 404)\n    data = json_object()\n    if data is None:\n        return error(\"Request body must be a JSON object\", 400)\n    errors = {}\n    kind = data.get(\"kind\")\n    if not isinstance(kind, str) or kind.strip().lower() not in KINDS:\n        errors[\"kind\"] = \"Kind must be one of: \" + \", \".join(KINDS)\n    summary, msg = clean_text(data, \"summary\", \"Summary\", 2000, True)\n    if msg:\n        errors[\"summary\"] = msg\n    occurred_at = now()\n    if data.get(\"occurred_at\") not in (None, \"\"):\n        occurred_at = parse_time(data[\"occurred_at\"])\n        if occurred_at is None:\n            errors[\"occurred_at\"] = \"Date must be an ISO 8601 date/time\"\n    if errors:\n        return error(\"Validation failed\", 422, errors)\n    try:\n        cur = db().execute(\n            \"INSERT INTO interactions (customer_id, kind, summary, occurred_at, user_id) \"\n            \"VALUES (?, ?, ?, ?, ?)\",\n            (customer_id, kind.strip().lower(), summary, occurred_at, g.user[\"id\"]),\n        )\n        db().commit()\n    except sqlite3.IntegrityError:\n        return error(\"Customer not found\", 404)\n    row = db().execute(INTERACTION_SELECT + \" WHERE i.id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(dict(row)), 201\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(_path: str):\n    return error(\"Not found\", 404)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = (DIST / path).resolve()\n    if target.is_file() and DIST.resolve() in target.parents:\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\npython3 -m venv /tmp/venv && /tmp/venv/bin/pip install -q -r backend/requirements.txt -c backend/requirements.lock 2>&1 | tail -2","time":{"start":1794252998920,"end":1794253002162}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1d008fd001i4wuDBC48fwc1y","sessionID":"ses_e3e322bb8ffesEO3Q1Hn3a7zSY","messageID":"msg_1c1cf4494001AzHzYUcEYxSNvm"}}
