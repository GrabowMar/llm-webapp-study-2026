+ADMIN_USERNAME = "admin"
+MAX_FAILURES = 5
+LOCK_SECONDS = 15 * 60
+RATE_LIMIT = 20
+RATE_WINDOW = 60
+TOKEN_TTL = 7 * 24 * 3600
+USERNAME_MAX = 64
+PASSWORD_MAX = 256
