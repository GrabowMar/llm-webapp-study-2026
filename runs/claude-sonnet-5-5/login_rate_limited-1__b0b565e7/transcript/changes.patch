+
+def init_db() -> None:
+    conn = connect()
+    try:
+        conn.executescript(SCHEMA)
+        conn.execute("BEGIN IMMEDIATE")
+        password = os.environ.get("ADMIN_PASSWORD") or ""
+        row = conn.execute(
+            "SELECT id, password_hash FROM users WHERE username = ?",
