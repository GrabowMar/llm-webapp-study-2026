+@app.get("/api/me")
+@require_auth()
+def me():
+    u = g.user
+    last = u["last_login_at"]
+    return {
+        "id": u["id"],
+        "username": u["username"],
+        "last_login_at": iso(last) if last is not None else None,
+        "is_admin": u["username"] == ADMIN_USERNAME,
+    }
+
