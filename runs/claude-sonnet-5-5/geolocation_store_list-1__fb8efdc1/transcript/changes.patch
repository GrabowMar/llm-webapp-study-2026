+import { useState } from "react";
+import { ApiError, login, setToken } from "./api";
+
+export default function SignIn({ onSignedIn }: { onSignedIn: () => void }) {
+  const [username, setUsername] = useState("admin");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState("");
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setError("");
+    try {
+      const { token } = await login(username, password);
+      setToken(token);
+      setPassword("");
+      onSignedIn();
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : "Could not reach the server");
+    }
+  }
+
+  return (
+    <form onSubmit={submit} className="flex flex-wrap items-end gap-2 text-sm">
+      <label>
+        Username
+        <input className="ml-1 w-28 rounded border border-slate-300 px-2 py-1" value={username}
+          onChange={(e) => setUsername(e.target.value)} />
+      </label>
+      <label>
+        Password
+        <input className="ml-1 w-28 rounded border border-slate-300 px-2 py-1" type="password" value={password}
+          onChange={(e) => setPassword(e.target.value)} />
+      </label>
+      <button className="rounded bg-slate-800 px-3 py-1 text-white">Sign in</button>
+      {error && <span className="text-red-600" role="alert">{error}</span>}
+    </form>
+  );
+}
diff --git a/frontend/src/StoreForm.tsx b/frontend/src/StoreForm.tsx
new file mode 100644
index 0000000..fc27665
--- /dev/null
+++ b/frontend/src/StoreForm.tsx
@@ -0,0 +1,88 @@
+import { useState } from "react";
+import { ApiError, createStore, updateStore, type Store } from "./api";
+
+interface Props {
+  store: Store | null;
+  onSaved: () => void;
+  onCancel: () => void;
+  onAuthLost: () => void;
+}
+
+const input = "mt-1 w-full rounded border border-slate-300 px-2 py-1";
+
+export default function StoreForm({ store, onSaved, onCancel, onAuthLost }: Props) {
+  const [values, setValues] = useState({
+    name: store?.name ?? "",
+    address: store?.address ?? "",
+    phone: store?.phone ?? "",
+    latitude: store ? String(store.latitude) : "",
+    longitude: store ? String(store.longitude) : "",
+  });
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const [message, setMessage] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  const set = (k: keyof typeof values) => (e: React.ChangeEvent<HTMLInputElement>) =>
+    setValues({ ...values, [k]: e.target.value });
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setErrors({});
+    setMessage("");
+    try {
+      if (store) await updateStore(store.id, values);
+      else await createStore(values);
+      onSaved();
+    } catch (err) {
+      if (err instanceof ApiError) {
+        if (err.status === 401 || err.status === 403) onAuthLost();
+        setErrors(err.details);
+        setMessage(err.message);
+      } else {
+        setMessage("Could not reach the server");
+      }
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const field = (k: keyof typeof values, label: string, type = "text") => (
+    <label className="block text-sm">
+      {label}
+      <input
+        className={input}
+        type={type}
+        step={type === "number" ? "any" : undefined}
+        value={values[k]}
+        onChange={set(k)}
+        aria-invalid={errors[k] ? true : undefined}
+      />
+      {errors[k] && <span className="text-red-600" role="alert">{errors[k]}</span>}
+    </label>
+  );
+
+  return (
+    <form onSubmit={submit} className="space-y-3 rounded border border-slate-300 bg-white p-4">
+      <h3 className="font-semibold">{store ? `Edit ${store.name}` : "Add a store"}</h3>
+      {field("name", "Name")}
+      {field("address", "Address")}
+      {field("phone", "Phone")}
+      <div className="grid grid-cols-2 gap-3">
+        {field("latitude", "Latitude", "number")}
+        {field("longitude", "Longitude", "number")}
+      </div>
+      {message && Object.keys(errors).length === 0 && (
+        <p className="text-sm text-red-600" role="alert">{message}</p>
+      )}
+      <div className="flex gap-2">
+        <button disabled={busy} className="rounded bg-indigo-600 px-3 py-1 text-white disabled:opacity-50">
+          {store ? "Save" : "Add"}
+        </button>
+        <button type="button" onClick={onCancel} className="rounded border border-slate-300 px-3 py-1">
+          Cancel
+        </button>
+      </div>
+    </form>
+  );
+}
diff --git a/frontend/src/StorePlot.tsx b/frontend/src/StorePlot.tsx
new file mode 100644
index 0000000..cda3d30
--- /dev/null
+++ b/frontend/src/StorePlot.tsx
@@ -0,0 +1,69 @@
+import type { Store } from "./api";
+
+interface Props {
+  stores: Store[];
+  me: { lat: number; lng: number } | null;
+}
+
+const W = 600;
+const H = 360;
+const PAD = 36;
+
+export default function StorePlot({ stores, me }: Props) {
+  const points = [
+    ...stores.map((s) => ({ lat: s.latitude, lng: s.longitude })),
+    ...(me ? [{ lat: me.lat, lng: me.lng }] : []),
+  ];
+  if (points.length === 0) {
+    return <p className="text-sm text-slate-500">Nothing to plot.</p>;
+  }
+  const lats = points.map((p) => p.lat);
+  const lngs = points.map((p) => p.lng);
+  const minLat = Math.min(...lats);
+  const maxLat = Math.max(...lats);
+  const minLng = Math.min(...lngs);
+  const maxLng = Math.max(...lngs);
+  const spanLat = Math.max(maxLat - minLat, 1e-6);
+  const spanLng = Math.max(maxLng - minLng, 1e-6);
+  const x = (lng: number) =>
+    points.length === 1 || maxLng === minLng ? W / 2 : PAD + ((lng - minLng) / spanLng) * (W - 2 * PAD);
+  const y = (lat: number) =>
+    points.length === 1 || maxLat === minLat ? H / 2 : H - PAD - ((lat - minLat) / spanLat) * (H - 2 * PAD);
+
+  return (
+    <svg
+      viewBox={`0 0 ${W} ${H}`}
+      role="img"
+      aria-label="Plot of store locations by latitude and longitude"
+      className="w-full rounded border border-slate-300 bg-slate-50"
+    >
+      <rect x={PAD / 2} y={PAD / 2} width={W - PAD} height={H - PAD} className="fill-none stroke-slate-200" />
+      <text x={W - 8} y={H - 8} textAnchor="end" className="fill-slate-400 text-[10px]">
+        longitude →
+      </text>
+      <text x={8} y={14} className="fill-slate-400 text-[10px]">
+        ↑ latitude
+      </text>
+      {stores.map((s) => (
+        <g key={s.id}>
+          <circle cx={x(s.longitude)} cy={y(s.latitude)} r={6} className="fill-indigo-600 stroke-white">
+            <title>{`${s.name} (${s.latitude}, ${s.longitude})`}</title>
+          </circle>
+          <text x={x(s.longitude) + 9} y={y(s.latitude) + 4} className="fill-slate-700 text-[10px]">
+            {s.name}
+          </text>
+        </g>
+      ))}
+      {me && (
+        <g>
+          <rect x={x(me.lng) - 6} y={y(me.lat) - 6} width={12} height={12} className="fill-rose-600 stroke-white">
+            <title>You are here</title>
+          </rect>
+          <text x={x(me.lng) + 9} y={y(me.lat) + 4} className="fill-rose-700 text-[10px] font-semibold">
+            You
+          </text>
+        </g>
+      )}
+    </svg>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..00fa48c
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,89 @@
+export interface Store {
+  id: number;
+  name: string;
+  address: string;
+  phone: string | null;
+  latitude: number;
+  longitude: number;
+  distance_km: number | null;
+}
+
+export interface StoreInput {
+  name: string;
+  address: string;
+  phone?: string;
+  latitude: number | string;
+  longitude: number | string;
+}
+
+export class ApiError extends Error {
+  status: number;
+  details: Record<string, string>;
+  constructor(status: number, message: string, details: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.details = details;
+  }
+}
+
+const TOKEN_KEY = "store-finder-token";
+
+export const getToken = () => localStorage.getItem(TOKEN_KEY);
+export const setToken = (t: string | null) =>
+  t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY);
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  const token = getToken();
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  const res = await fetch(path, {
+    method,
+    headers,
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  if (res.status === 204) return undefined as T;
+  let data: { error?: string; details?: Record<string, string> } = {};
+  try {
+    data = await res.json();
+  } catch {
+    // non-JSON response
+  }
+  if (!res.ok) throw new ApiError(res.status, data.error ?? `Request failed (${res.status})`, data.details);
+  return data as T;
+}
+
+export interface Query {
+  q?: string;
+  lat?: number;
+  lng?: number;
+  radius?: number;
+}
+
+export function listStores(query: Query): Promise<{ items: Store[] }> {
+  const p = new URLSearchParams();
+  if (query.q) p.set("q", query.q);
+  if (query.lat !== undefined && query.lng !== undefined) {
+    p.set("lat", String(query.lat));
+    p.set("lng", String(query.lng));
+    if (query.radius !== undefined) p.set("radius", String(query.radius));
+  }
+  const qs = p.toString();
+  return request("GET", `/api/stores${qs ? `?${qs}` : ""}`);
+}
+
+export const login = (username: string, password: string) =>
+  request<{ token: string }>("POST", "/api/auth/login", { username, password });
+
+const toPayload = (s: StoreInput) => ({
+  name: s.name,
+  address: s.address,
+  ...(s.phone ? { phone: s.phone } : {}),
+  latitude: s.latitude === "" ? null : Number(s.latitude),
+  longitude: s.longitude === "" ? null : Number(s.longitude),
+});
+
+export const createStore = (s: StoreInput) => request<Store>("POST", "/api/admin/stores", toPayload(s));
+export const updateStore = (id: number, s: StoreInput) =>
+  request<Store>("PUT", `/api/admin/stores/${id}`, toPayload(s));
+export const deleteStore = (id: number) => request<void>("DELETE", `/api/admin/stores/${id}`);
