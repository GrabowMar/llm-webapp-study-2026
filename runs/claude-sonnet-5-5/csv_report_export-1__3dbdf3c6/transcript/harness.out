{"type":"tool_use","timestamp":1794254410463,"sessionID":"ses_e3e1c2557ffeQ9yoqlm6QjP9wD","part":{"type":"tool","tool":"bash","callID":"toolu_01MhE4JtCh65jgi2SZu26bwV","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Timesheet API and frontend server.\"\"\"\n\nimport csv\nimport hashlib\nimport io\nimport math\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import date as date_cls\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash, safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"timesheet.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_HOURS = 24\nMAX_PROJECT = 100\nMAX_DESCRIPTION = 2000\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.\\-]{3,50}$\")\nMIN_PASSWORD = 8\nMAX_PASSWORD = 128\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS entries (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    project TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    hours REAL NOT NULL,\n    date TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_entries_user_date ON entries(user_id, date);\nCREATE INDEX IF NOT EXISTS idx_entries_user_project ON entries(user_id, project);\n\"\"\"\n\n\ndef connect():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db():\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\nclass ApiError(Exception):\n    def __init__(self, status, message, errors=None):\n        self.status = status\n        self.message = message\n        self.errors = errors or {}\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err):\n    body = {\"error\": err.message}\n    if err.errors:\n        body[\"errors\"] = err.errors\n    return jsonify(body), err.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": err.description or err.name}), err.code\n    return err\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(err):\n    app.logger.exception(\"unhandled error\")\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        raise ApiError(401, \"Authentication required\")\n    token = parts[1].strip()\n    row = db().execute(\n        \"SELECT users.id, users.username, tokens.expires_at FROM tokens \"\n        \"JOIN users ON users.id = tokens.user_id WHERE tokens.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        raise ApiError(401, \"Authentication required\")\n    g.token_hash = hash_token(token)\n    return row\n\n\ndef require_user(fn):\n    from functools import wraps\n\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        g.user = current_user()\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        errors[\"username\"] = (\n            \"Username must be 3-50 characters: letters, digits, '.', '_' or '-'\"\n        )\n    if (\n        not isinstance(password, str)\n        or len(password) < MIN_PASSWORD\n        or len(password) > MAX_PASSWORD\n    ):\n        errors[\"password\"] = (\n            f\"Password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters long\"\n        )\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    username = username.strip()\n    conn = db()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(\n            409, \"Username is already taken\", {\"username\": \"Username is already taken\"}\n        )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"Username and password are required\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        raise ApiError(401, \"Invalid username or password\")\n    if not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    expires = (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (now_iso(),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), row[\"id\"], expires),\n    )\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\n@require_user\ndef me():\n    return jsonify({\"username\": g.user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@require_user\ndef logout():\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n    conn.commit()\n    return \"\", 204\n\n\ndef parse_date(value, field):\n    if not isinstance(value, str) or not re.fullmatch(r\"\\d{4}-\\d{2}-\\d{2}\", value):\n        raise ValueError(f\"{field} must be a date in YYYY-MM-DD format\")\n    try:\n        return date_cls.fromisoformat(value).isoformat()\n    except ValueError:\n        raise ValueError(f\"{field} must be a valid date\")\n\n\ndef clean_fields(data, partial):\n    errors = {}\n    out = {}\n\n    if \"project\" in data or not partial:\n        value = data.get(\"project\")\n        if not isinstance(value, str) or not value.strip():\n            errors[\"project\"] = \"Project is required\"\n        elif len(value.strip()) > MAX_PROJECT:\n            errors[\"project\"] = f\"Project must be at most {MAX_PROJECT} characters\"\n        else:\n            out[\"project\"] = value.strip()\n\n    if \"description\" in data or not partial:\n        value = data.get(\"description\", \"\")\n        if value is None and not partial:\n            value = \"\"\n        if not isinstance(value, str):\n            errors[\"description\"] = \"Description must be text\"\n        elif len(value) > MAX_DESCRIPTION:\n            errors[\"description\"] = (\n                f\"Description must be at most {MAX_DESCRIPTION} characters\"\n            )\n        else:\n            out[\"description\"] = value.strip()\n\n    if \"hours\" in data or not partial:\n        value = data.get(\"hours\")\n        if (\n            isinstance(value, bool)\n            or not isinstance(value, (int, float))\n            or not math.isfinite(value)\n        ):\n            errors[\"hours\"] = \"Hours must be a number\"\n        elif value <= 0:\n            errors[\"hours\"] = \"Hours must be greater than 0\"\n        elif value > MAX_HOURS:\n            errors[\"hours\"] = f\"Hours must be at most {MAX_HOURS}\"\n        else:\n            out[\"hours\"] = round(float(value), 4)\n            if out[\"hours\"] <= 0:\n                errors[\"hours\"] = \"Hours must be greater than 0\"\n\n    if \"date\" in data or not partial:\n        value = data.get(\"date\")\n        if value is None and not partial:\n            out[\"date\"] = date_cls.today().isoformat()\n        else:\n            try:\n                out[\"date\"] = parse_date(value, \"Date\")\n            except ValueError as exc:\n                errors[\"date\"] = str(exc)\n\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return out\n\n\ndef entry_json(row):\n    return {\n        \"id\": row[\"id\"],\n        \"project\": row[\"project\"],\n        \"description\": row[\"description\"],\n        \"hours\": row[\"hours\"],\n        \"date\": row[\"date\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef filters(allow_project=True):\n    where = [\"user_id = ?\"]\n    params = [g.user[\"id\"]]\n    errors = {}\n    start = request.args.get(\"start_date\")\n    end = request.args.get(\"end_date\")\n    parsed = {}\n    for name, raw in ((\"start_date\", start), (\"end_date\", end)):\n        if raw is None or raw == \"\":\n            continue\n        try:\n            parsed[name] = parse_date(raw, name)\n        except ValueError as exc:\n            errors[name] = str(exc)\n    if (\n        not errors\n        and \"start_date\" in parsed\n        and \"end_date\" in parsed\n        and parsed[\"start_date\"] > parsed[\"end_date\"]\n    ):\n        errors[\"start_date\"] = \"start_date must not be after end_date\"\n    if errors:\n        raise ApiError(400, \"Invalid filters\", errors)\n    if \"start_date\" in parsed:\n        where.append(\"date >= ?\")\n        params.append(parsed[\"start_date\"])\n    if \"end_date\" in parsed:\n        where.append(\"date <= ?\")\n        params.append(parsed[\"end_date\"])\n    project = request.args.get(\"project\")\n    if allow_project and project is not None and project.strip() != \"\":\n        where.append(\"project = ?\")\n        params.append(project.strip())\n    return \" AND \".join(where), params\n\n\ndef int_arg(name, default, minimum, maximum=None):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    if not re.fullmatch(r\"\\d{1,9}\", raw.strip()):\n        raise ApiError(400, f\"{name} must be a positive integer\", {name: \"Invalid\"})\n    value = int(raw)\n    if value < minimum or (maximum is not None and value > maximum):\n        limit = f\"between {minimum} and {maximum}\" if maximum else f\"at least {minimum}\"\n        raise ApiError(400, f\"{name} must be {limit}\", {name: \"Out of range\"})\n    return value\n\n\ndef get_own_entry(entry_id):\n    row = db().execute(\n        \"SELECT * FROM entries WHERE id = ? AND user_id = ?\",\n        (entry_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"Entry not found\")\n    return row\n\n\n@app.get(\"/api/entries\")\n@require_user\ndef list_entries():\n    where, params = filters()\n    page = int_arg(\"page\", 1, 1)\n    page_size = int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM entries WHERE {where}\", params\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM entries WHERE {where} ORDER BY date DESC, id DESC \"\n        \"LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [entry_json(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/entries\")\n@require_user\ndef create_entry():\n    fields = clean_fields(json_body(), partial=False)\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO entries (user_id, project, description, hours, date, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            g.user[\"id\"],\n            fields[\"project\"],\n            fields[\"description\"],\n            fields[\"hours\"],\n            fields[\"date\"],\n            now_iso(),\n        ),\n    )\n    conn.commit()\n    return jsonify(entry_json(get_own_entry(cur.lastrowid))), 201\n\n\n@app.patch(\"/api/entries/<int:entry_id>\")\n@require_user\ndef update_entry(entry_id):\n    get_own_entry(entry_id)\n    fields = clean_fields(json_body(), partial=True)\n    if fields:\n        conn = db()\n        assignments = \", \".join(f\"{name} = ?\" for name in fields)\n        conn.execute(\n            f\"UPDATE entries SET {assignments} WHERE id = ? AND user_id = ?\",\n            list(fields.values()) + [entry_id, g.user[\"id\"]],\n        )\n        conn.commit()\n    return jsonify(entry_json(get_own_entry(entry_id)))\n\n\n@app.delete(\"/api/entries/<int:entry_id>\")\n@require_user\ndef delete_entry(entry_id):\n    get_own_entry(entry_id)\n    conn = db()\n    conn.execute(\n        \"DELETE FROM entries WHERE id = ? AND user_id = ?\", (entry_id, g.user[\"id\"])\n    )\n    conn.commit()\n    return \"\", 204\n\n\ndef summary_rows(where, params):\n    rows = db().execute(\n        f\"SELECT project, SUM(hours) AS hours FROM entries WHERE {where} \"\n        \"GROUP BY project ORDER BY project\",\n        params,\n    ).fetchall()\n    return [(r[\"project\"], round(r[\"hours\"], 4)) for r in rows]\n\n\n@app.get(\"/api/summary\")\n@require_user\ndef summary():\n    where, params = filters()\n    rows = summary_rows(where, params)\n    return jsonify(\n        {\n            \"items\": [{\"project\": p, \"hours\": h} for p, h in rows],\n            \"total_hours\": round(sum(h for _, h in rows), 4),\n        }\n    )\n\n\n@app.get(\"/api/projects\")\n@require_user\ndef projects():\n    rows = db().execute(\n        \"SELECT project, MAX(date) AS last_date FROM entries WHERE user_id = ? \"\n        \"GROUP BY project ORDER BY last_date DESC, project LIMIT 200\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [r[\"project\"] for r in rows]})\n\n\nCSV_TRIGGERS = (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\", \"\\n\")\n\n\ndef csv_text(value):\n    value = str(value)\n    if value.startswith(CSV_TRIGGERS):\n        return \"'\" + value\n    return value\n\n\ndef csv_hours(value):\n    text = f\"{round(value, 4):.4f}\".rstrip(\"0\").rstrip(\".\")\n    return text or \"0\"\n\n\ndef csv_response(header, rows, filename):\n    buf = io.StringIO()\n    writer = csv.writer(buf, lineterminator=\"\\r\\n\")\n    writer.writerow(header)\n    writer.writerows(rows)\n    resp = Response(buf.getvalue().encode(\"utf-8\"), mimetype=\"text/csv\")\n    resp.headers[\"Content-Type\"] = \"text/csv; charset=utf-8\"\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{filename}\"'\n    resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\n@app.get(\"/api/exports/entries.csv\")\n@require_user\ndef export_entries():\n    where, params = filters()\n    rows = db().execute(\n        f\"SELECT date, project, description, hours FROM entries WHERE {where} \"\n        \"ORDER BY date ASC, id ASC\",\n        params,\n    ).fetchall()\n    return csv_response(\n        [\"date\", \"project\", \"description\", \"hours\"],\n        (\n            [\n                r[\"date\"],\n                csv_text(r[\"project\"]),\n                csv_text(r[\"description\"]),\n                csv_hours(r[\"hours\"]),\n            ]\n            for r in rows\n        ),\n        \"entries.csv\",\n    )\n\n\n@app.get(\"/api/exports/summary.csv\")\n@require_user\ndef export_summary():\n    where, params = filters(allow_project=False)\n    rows = summary_rows(where, params)\n    return csv_response(\n        [\"project\", \"hours\"],\n        ([csv_text(p), csv_hours(h)] for p, h in rows),\n        \"summary.csv\",\n    )\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(_path):\n    raise ApiError(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = safe_join(str(DIST), path)\n    if target is not None and Path(target).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\ncd frontend && npm i -E tailwindcss@4.3.5 @tailwindcss/vite@4.3.5 2>&1 | tail -3; npm i -E -D typescript @types/react @types/react-dom 2>&1 | tail -3; cat package.json"},"output":"added 35 packages, and audited 42 packages in 35s\n\nfound 0 vulnerabilities\nadded 5 packages, and audited 47 packages in 6s\n\nfound 0 vulnerabilities\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"4.3.5\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"4.3.5\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"19.3.0\",\n    \"@types/react-dom\": \"19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"typescript\": \"7.0.2\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","metadata":{"output":"added 35 packages, and audited 42 packages in 35s\n\nfound 0 vulnerabilities\nadded 5 packages, and audited 47 packages in 6s\n\nfound 0 vulnerabilities\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"@tailwindcss/vite\": \"4.3.5\",\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\",\n    \"tailwindcss\": \"4.3.5\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"19.3.0\",\n    \"@types/react-dom\": \"19.3.0\",\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"typescript\": \"7.0.2\",\n    \"vite\": \"8.3.5\"\n  }\n}\n","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Timesheet API and frontend server.\"\"\"\n\nimport csv\nimport hashlib\nimport io\nimport math\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import date as date_cls\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, Response, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash, safe_join\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"timesheet.db\"\n\nTOKEN_TTL = timedelta(days=30)\nMAX_HOURS = 24\nMAX_PROJECT = 100\nMAX_DESCRIPTION = 2000\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.\\-]{3,50}$\")\nMIN_PASSWORD = 8\nMAX_PASSWORD = 128\nDEFAULT_PAGE_SIZE = 20\nMAX_PAGE_SIZE = 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS entries (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    project TEXT NOT NULL,\n    description TEXT NOT NULL DEFAULT '',\n    hours REAL NOT NULL,\n    date TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_entries_user_date ON entries(user_id, date);\nCREATE INDEX IF NOT EXISTS idx_entries_user_project ON entries(user_id, project);\n\"\"\"\n\n\ndef connect():\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db():\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db():\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso():\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\nclass ApiError(Exception):\n    def __init__(self, status, message, errors=None):\n        self.status = status\n        self.message = message\n        self.errors = errors or {}\n\n\n@app.errorhandler(ApiError)\ndef handle_api_error(err):\n    body = {\"error\": err.message}\n    if err.errors:\n        body[\"errors\"] = err.errors\n    return jsonify(body), err.status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(err):\n    if request.path.startswith(\"/api/\"):\n        return jsonify({\"error\": err.description or err.name}), err.code\n    return err\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(err):\n    app.logger.exception(\"unhandled error\")\n    return jsonify({\"error\": \"Internal server error\"}), 500\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        raise ApiError(400, \"Request body must be a JSON object\")\n    return data\n\n\ndef hash_token(token):\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        raise ApiError(401, \"Authentication required\")\n    token = parts[1].strip()\n    row = db().execute(\n        \"SELECT users.id, users.username, tokens.expires_at FROM tokens \"\n        \"JOIN users ON users.id = tokens.user_id WHERE tokens.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < now_iso():\n        raise ApiError(401, \"Authentication required\")\n    g.token_hash = hash_token(token)\n    return row\n\n\ndef require_user(fn):\n    from functools import wraps\n\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        g.user = current_user()\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        errors[\"username\"] = (\n            \"Username must be 3-50 characters: letters, digits, '.', '_' or '-'\"\n        )\n    if (\n        not isinstance(password, str)\n        or len(password) < MIN_PASSWORD\n        or len(password) > MAX_PASSWORD\n    ):\n        errors[\"password\"] = (\n            f\"Password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters long\"\n        )\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    username = username.strip()\n    conn = db()\n    try:\n        conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        raise ApiError(\n            409, \"Username is already taken\", {\"username\": \"Username is already taken\"}\n        )\n    return jsonify({\"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        raise ApiError(400, \"Username and password are required\")\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, password_hash FROM users WHERE username = ?\", (username.strip(),)\n    ).fetchone()\n    if row is None:\n        check_password_hash(DUMMY_HASH, password)\n        raise ApiError(401, \"Invalid username or password\")\n    if not check_password_hash(row[\"password_hash\"], password):\n        raise ApiError(401, \"Invalid username or password\")\n    token = secrets.token_urlsafe(32)\n    expires = (datetime.now(timezone.utc) + TOKEN_TTL).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (now_iso(),))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n        (hash_token(token), row[\"id\"], expires),\n    )\n    conn.commit()\n    return jsonify({\"token\": token})\n\n\n@app.get(\"/api/auth/me\")\n@require_user\ndef me():\n    return jsonify({\"username\": g.user[\"username\"]})\n\n\n@app.post(\"/api/auth/logout\")\n@require_user\ndef logout():\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (g.token_hash,))\n    conn.commit()\n    return \"\", 204\n\n\ndef parse_date(value, field):\n    if not isinstance(value, str) or not re.fullmatch(r\"\\d{4}-\\d{2}-\\d{2}\", value):\n        raise ValueError(f\"{field} must be a date in YYYY-MM-DD format\")\n    try:\n        return date_cls.fromisoformat(value).isoformat()\n    except ValueError:\n        raise ValueError(f\"{field} must be a valid date\")\n\n\ndef clean_fields(data, partial):\n    errors = {}\n    out = {}\n\n    if \"project\" in data or not partial:\n        value = data.get(\"project\")\n        if not isinstance(value, str) or not value.strip():\n            errors[\"project\"] = \"Project is required\"\n        elif len(value.strip()) > MAX_PROJECT:\n            errors[\"project\"] = f\"Project must be at most {MAX_PROJECT} characters\"\n        else:\n            out[\"project\"] = value.strip()\n\n    if \"description\" in data or not partial:\n        value = data.get(\"description\", \"\")\n        if value is None and not partial:\n            value = \"\"\n        if not isinstance(value, str):\n            errors[\"description\"] = \"Description must be text\"\n        elif len(value) > MAX_DESCRIPTION:\n            errors[\"description\"] = (\n                f\"Description must be at most {MAX_DESCRIPTION} characters\"\n            )\n        else:\n            out[\"description\"] = value.strip()\n\n    if \"hours\" in data or not partial:\n        value = data.get(\"hours\")\n        if (\n            isinstance(value, bool)\n            or not isinstance(value, (int, float))\n            or not math.isfinite(value)\n        ):\n            errors[\"hours\"] = \"Hours must be a number\"\n        elif value <= 0:\n            errors[\"hours\"] = \"Hours must be greater than 0\"\n        elif value > MAX_HOURS:\n            errors[\"hours\"] = f\"Hours must be at most {MAX_HOURS}\"\n        else:\n            out[\"hours\"] = round(float(value), 4)\n            if out[\"hours\"] <= 0:\n                errors[\"hours\"] = \"Hours must be greater than 0\"\n\n    if \"date\" in data or not partial:\n        value = data.get(\"date\")\n        if value is None and not partial:\n            out[\"date\"] = date_cls.today().isoformat()\n        else:\n            try:\n                out[\"date\"] = parse_date(value, \"Date\")\n            except ValueError as exc:\n                errors[\"date\"] = str(exc)\n\n    if errors:\n        raise ApiError(400, \"Validation failed\", errors)\n    return out\n\n\ndef entry_json(row):\n    return {\n        \"id\": row[\"id\"],\n        \"project\": row[\"project\"],\n        \"description\": row[\"description\"],\n        \"hours\": row[\"hours\"],\n        \"date\": row[\"date\"],\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef filters(allow_project=True):\n    where = [\"user_id = ?\"]\n    params = [g.user[\"id\"]]\n    errors = {}\n    start = request.args.get(\"start_date\")\n    end = request.args.get(\"end_date\")\n    parsed = {}\n    for name, raw in ((\"start_date\", start), (\"end_date\", end)):\n        if raw is None or raw == \"\":\n            continue\n        try:\n            parsed[name] = parse_date(raw, name)\n        except ValueError as exc:\n            errors[name] = str(exc)\n    if (\n        not errors\n        and \"start_date\" in parsed\n        and \"end_date\" in parsed\n        and parsed[\"start_date\"] > parsed[\"end_date\"]\n    ):\n        errors[\"start_date\"] = \"start_date must not be after end_date\"\n    if errors:\n        raise ApiError(400, \"Invalid filters\", errors)\n    if \"start_date\" in parsed:\n        where.append(\"date >= ?\")\n        params.append(parsed[\"start_date\"])\n    if \"end_date\" in parsed:\n        where.append(\"date <= ?\")\n        params.append(parsed[\"end_date\"])\n    project = request.args.get(\"project\")\n    if allow_project and project is not None and project.strip() != \"\":\n        where.append(\"project = ?\")\n        params.append(project.strip())\n    return \" AND \".join(where), params\n\n\ndef int_arg(name, default, minimum, maximum=None):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default\n    if not re.fullmatch(r\"\\d{1,9}\", raw.strip()):\n        raise ApiError(400, f\"{name} must be a positive integer\", {name: \"Invalid\"})\n    value = int(raw)\n    if value < minimum or (maximum is not None and value > maximum):\n        limit = f\"between {minimum} and {maximum}\" if maximum else f\"at least {minimum}\"\n        raise ApiError(400, f\"{name} must be {limit}\", {name: \"Out of range\"})\n    return value\n\n\ndef get_own_entry(entry_id):\n    row = db().execute(\n        \"SELECT * FROM entries WHERE id = ? AND user_id = ?\",\n        (entry_id, g.user[\"id\"]),\n    ).fetchone()\n    if row is None:\n        raise ApiError(404, \"Entry not found\")\n    return row\n\n\n@app.get(\"/api/entries\")\n@require_user\ndef list_entries():\n    where, params = filters()\n    page = int_arg(\"page\", 1, 1)\n    page_size = int_arg(\"page_size\", DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        f\"SELECT COUNT(*) FROM entries WHERE {where}\", params\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM entries WHERE {where} ORDER BY date DESC, id DESC \"\n        \"LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [entry_json(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n        }\n    )\n\n\n@app.post(\"/api/entries\")\n@require_user\ndef create_entry():\n    fields = clean_fields(json_body(), partial=False)\n    conn = db()\n    cur = conn.execute(\n        \"INSERT INTO entries (user_id, project, description, hours, date, created_at) \"\n        \"VALUES (?, ?, ?, ?, ?, ?)\",\n        (\n            g.user[\"id\"],\n            fields[\"project\"],\n            fields[\"description\"],\n            fields[\"hours\"],\n            fields[\"date\"],\n            now_iso(),\n        ),\n    )\n    conn.commit()\n    return jsonify(entry_json(get_own_entry(cur.lastrowid))), 201\n\n\n@app.patch(\"/api/entries/<int:entry_id>\")\n@require_user\ndef update_entry(entry_id):\n    get_own_entry(entry_id)\n    fields = clean_fields(json_body(), partial=True)\n    if fields:\n        conn = db()\n        assignments = \", \".join(f\"{name} = ?\" for name in fields)\n        conn.execute(\n            f\"UPDATE entries SET {assignments} WHERE id = ? AND user_id = ?\",\n            list(fields.values()) + [entry_id, g.user[\"id\"]],\n        )\n        conn.commit()\n    return jsonify(entry_json(get_own_entry(entry_id)))\n\n\n@app.delete(\"/api/entries/<int:entry_id>\")\n@require_user\ndef delete_entry(entry_id):\n    get_own_entry(entry_id)\n    conn = db()\n    conn.execute(\n        \"DELETE FROM entries WHERE id = ? AND user_id = ?\", (entry_id, g.user[\"id\"])\n    )\n    conn.commit()\n    return \"\", 204\n\n\ndef summary_rows(where, params):\n    rows = db().execute(\n        f\"SELECT project, SUM(hours) AS hours FROM entries WHERE {where} \"\n        \"GROUP BY project ORDER BY project\",\n        params,\n    ).fetchall()\n    return [(r[\"project\"], round(r[\"hours\"], 4)) for r in rows]\n\n\n@app.get(\"/api/summary\")\n@require_user\ndef summary():\n    where, params = filters()\n    rows = summary_rows(where, params)\n    return jsonify(\n        {\n            \"items\": [{\"project\": p, \"hours\": h} for p, h in rows],\n            \"total_hours\": round(sum(h for _, h in rows), 4),\n        }\n    )\n\n\n@app.get(\"/api/projects\")\n@require_user\ndef projects():\n    rows = db().execute(\n        \"SELECT project, MAX(date) AS last_date FROM entries WHERE user_id = ? \"\n        \"GROUP BY project ORDER BY last_date DESC, project LIMIT 200\",\n        (g.user[\"id\"],),\n    ).fetchall()\n    return jsonify({\"items\": [r[\"project\"] for r in rows]})\n\n\nCSV_TRIGGERS = (\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\", \"\\n\")\n\n\ndef csv_text(value):\n    value = str(value)\n    if value.startswith(CSV_TRIGGERS):\n        return \"'\" + value\n    return value\n\n\ndef csv_hours(value):\n    text = f\"{round(value, 4):.4f}\".rstrip(\"0\").rstrip(\".\")\n    return text or \"0\"\n\n\ndef csv_response(header, rows, filename):\n    buf = io.StringIO()\n    writer = csv.writer(buf, lineterminator=\"\\r\\n\")\n    writer.writerow(header)\n    writer.writerows(rows)\n    resp = Response(buf.getvalue().encode(\"utf-8\"), mimetype=\"text/csv\")\n    resp.headers[\"Content-Type\"] = \"text/csv; charset=utf-8\"\n    resp.headers[\"Content-Disposition\"] = f'attachment; filename=\"{filename}\"'\n    resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\n@app.get(\"/api/exports/entries.csv\")\n@require_user\ndef export_entries():\n    where, params = filters()\n    rows = db().execute(\n        f\"SELECT date, project, description, hours FROM entries WHERE {where} \"\n        \"ORDER BY date ASC, id ASC\",\n        params,\n    ).fetchall()\n    return csv_response(\n        [\"date\", \"project\", \"description\", \"hours\"],\n        (\n            [\n                r[\"date\"],\n                csv_text(r[\"project\"]),\n                csv_text(r[\"description\"]),\n                csv_hours(r[\"hours\"]),\n            ]\n            for r in rows\n        ),\n        \"entries.csv\",\n    )\n\n\n@app.get(\"/api/exports/summary.csv\")\n@require_user\ndef export_summary():\n    where, params = filters(allow_project=False)\n    rows = summary_rows(where, params)\n    return csv_response(\n        [\"project\", \"hours\"],\n        ([csv_text(p), csv_hours(h)] for p, h in rows),\n        \"summary.csv\",\n    )\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.route(\"/api/<path:_path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(_path):\n    raise ApiError(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    target = safe_join(str(DIST), path)\n    if target is not None and Path(target).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF\ncd frontend && npm i -E tailwindcss@4.3.5 @tailwindcss/vite@4.3.5 2>&1 | tail -3; npm i -E -D typescript @types/react @types/react-dom 2>&1 | tail -3; cat package.json","time":{"start":1794254369391,"end":1794254410383}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1e4f253001bGhY1LY8cEMKHN","sessionID":"ses_e3e1c2557ffeQ9yoqlm6QjP9wD","messageID":"msg_1c1e4075e001AZC3uCXVWBmyHF"}}
