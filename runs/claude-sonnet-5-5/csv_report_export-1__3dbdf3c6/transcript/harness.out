{"type":"tool_use","timestamp":1794254462617,"sessionID":"ses_e3e1c2557ffeQ9yoqlm6QjP9wD","part":{"type":"tool","tool":"bash","callID":"toolu_01U11V2MuS7Rzcg7EZX2U5S7","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/<title>App/<title>Timesheet/' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Entry = {\n  id: number;\n  project: string;\n  description: string;\n  hours: number;\n  date: string;\n  created_at: string;\n};\n\nexport type EntryPage = {\n  items: Entry[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type Summary = {\n  items: { project: string; hours: number }[];\n  total_hours: number;\n};\n\nexport type Filters = { start_date: string; end_date: string; project: string };\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"timesheet_token\";\nconst USER_KEY = \"timesheet_username\";\n\nexport const session = {\n  get token() {\n    return localStorage.getItem(TOKEN_KEY);\n  },\n  get username() {\n    return localStorage.getItem(USER_KEY);\n  },\n  set(token: string, username: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, username);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nasync function send(path: string, init: RequestInit = {}, auth = true): Promise<Response> {\n  const headers = new Headers(init.headers);\n  if (init.body) headers.set(\"Content-Type\", \"application/json\");\n  if (auth && session.token) headers.set(\"Authorization\", `Bearer ${session.token}`);\n  const res = await fetch(path, { ...init, headers });\n  if (!res.ok) {\n    let message = res.statusText || \"Request failed\";\n    let errors: Record<string, string> = {};\n    try {\n      const body = await res.json();\n      if (body.error) message = body.error;\n      if (body.errors) errors = body.errors;\n    } catch {\n      /* ignore non-JSON bodies */\n    }\n    if (res.status === 401 && auth && session.token) onUnauthorized();\n    throw new ApiError(res.status, message, errors);\n  }\n  return res;\n}\n\nasync function json<T>(path: string, init?: RequestInit, auth = true): Promise<T> {\n  const res = await send(path, init, auth);\n  if (res.status === 204) return undefined as T;\n  return res.json();\n}\n\nfunction query(params: Record<string, string | number | undefined>): string {\n  const q = new URLSearchParams();\n  for (const [k, v] of Object.entries(params)) {\n    if (v !== undefined && v !== \"\") q.set(k, String(v));\n  }\n  const s = q.toString();\n  return s ? `?${s}` : \"\";\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    json<{ username: string }>(\n      \"/api/auth/register\",\n      { method: \"POST\", body: JSON.stringify({ username, password }) },\n      false,\n    ),\n  login: (username: string, password: string) =>\n    json<{ token: string }>(\n      \"/api/auth/login\",\n      { method: \"POST\", body: JSON.stringify({ username, password }) },\n      false,\n    ),\n  logout: () => json<void>(\"/api/auth/logout\", { method: \"POST\" }),\n  entries: (f: Filters, page: number, pageSize: number) =>\n    json<EntryPage>(`/api/entries${query({ ...f, page, page_size: pageSize })}`),\n  summary: (f: Filters) => json<Summary>(`/api/summary${query({ ...f })}`),\n  projects: () => json<{ items: string[] }>(\"/api/projects\"),\n  create: (body: Partial<Entry>) =>\n    json<Entry>(\"/api/entries\", { method: \"POST\", body: JSON.stringify(body) }),\n  update: (id: number, body: Partial<Entry>) =>\n    json<Entry>(`/api/entries/${id}`, { method: \"PATCH\", body: JSON.stringify(body) }),\n  remove: (id: number) => json<void>(`/api/entries/${id}`, { method: \"DELETE\" }),\n  download: async (path: string, params: Record<string, string>, filename: string) => {\n    const res = await send(`${path}${query(params)}`);\n    const url = URL.createObjectURL(await res.blob());\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = filename;\n    document.body.appendChild(a);\n    a.click();\n    a.remove();\n    setTimeout(() => URL.revokeObjectURL(url), 1000);\n  },\n};\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { FormEvent, useState } from \"react\";\nimport { api, ApiError, session } from \"./api\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"rounded bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"rounded border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50\";\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: (username: string) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setErrors({});\n    setMessage(\"\");\n    try {\n      const name = username.trim();\n      if (mode === \"register\") {\n        await api.register(name, password);\n      }\n      const { token } = await api.login(name, password);\n      session.set(token, name);\n      onSignedIn(name);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.errors);\n        setMessage(Object.keys(err.errors).length ? \"\" : err.message);\n      } else {\n        setMessage(\"Network error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto mt-16 max-w-sm rounded-lg bg-white p-6 shadow\">\n      <h1 className=\"mb-4 text-xl font-semibold text-slate-800\">Timesheet</h1>\n      <div className=\"mb-4 flex gap-2 text-sm\">\n        {([\"login\", \"register\"] as const).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            onClick={() => {\n              setMode(m);\n              setErrors({});\n              setMessage(\"\");\n            }}\n            className={`rounded px-3 py-1 ${mode === m ? \"bg-indigo-100 font-medium text-indigo-700\" : \"text-slate-600 hover:bg-slate-100\"}`}\n          >\n            {m === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        ))}\n      </div>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <label className=\"block text-sm\">\n          <span className=\"mb-1 block text-slate-600\">Username</span>\n          <input\n            className={inputCls}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n          {errors.username && <span className=\"text-xs text-red-600\">{errors.username}</span>}\n        </label>\n        <label className=\"block text-sm\">\n          <span className=\"mb-1 block text-slate-600\">Password</span>\n          <input\n            className={inputCls}\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n            required\n          />\n          {errors.password && <span className=\"text-xs text-red-600\">{errors.password}</span>}\n        </label>\n        {message && <p className=\"text-sm text-red-600\">{message}</p>}\n        <button className={`${btnCls} w-full`} disabled={busy}>\n          {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n        </button>\n      </form>\n    </div>\n  );\n}\nEOF\ncat > src/EntryForm.tsx <<'EOF'\nimport { FormEvent, useState } from \"react\";\nimport { api, ApiError } from \"./api\";\nimport { btnCls, inputCls } from \"./AuthForms\";\n\nexport function today() {\n  const d = new Date();\n  const p = (n: number) => String(n).padStart(2, \"0\");\n  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n}\n\nexport default function EntryForm({\n  projects,\n  onCreated,\n}: {\n  projects: string[];\n  onCreated: () => void;\n}) {\n  const [project, setProject] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [hours, setHours] = useState(\"\");\n  const [date, setDate] = useState(today());\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setErrors({});\n    setMessage(\"\");\n    const h = hours.trim() === \"\" ? NaN : Number(hours.replace(\",\", \".\"));\n    setBusy(true);\n    try {\n      await api.create({\n        project,\n        description,\n        hours: Number.isNaN(h) ? (hours as unknown as number) : h,\n        date,\n      });\n      setDescription(\"\");\n      setHours(\"\");\n      onCreated();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.errors);\n        setMessage(Object.keys(err.errors).length ? \"\" : err.message);\n      } else {\n        setMessage(\"Network error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const err = (k: string) => errors[k] && <span className=\"text-xs text-red-600\">{errors[k]}</span>;\n\n  return (\n    <form onSubmit={submit} className=\"rounded-lg bg-white p-4 shadow\">\n      <h2 className=\"mb-3 font-semibold text-slate-800\">Log time</h2>\n      <div className=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-12\">\n        <label className=\"block text-sm lg:col-span-3\">\n          <span className=\"mb-1 block text-slate-600\">Project</span>\n          <input\n            className={inputCls}\n            list=\"project-suggestions\"\n            value={project}\n            onChange={(e) => setProject(e.target.value)}\n          />\n          <datalist id=\"project-suggestions\">\n            {projects.map((p) => (\n              <option key={p} value={p} />\n            ))}\n          </datalist>\n          {err(\"project\")}\n        </label>\n        <label className=\"block text-sm lg:col-span-4\">\n          <span className=\"mb-1 block text-slate-600\">Description</span>\n          <input\n            className={inputCls}\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n          />\n          {err(\"description\")}\n        </label>\n        <label className=\"block text-sm lg:col-span-2\">\n          <span className=\"mb-1 block text-slate-600\">Hours</span>\n          <input\n            className={inputCls}\n            inputMode=\"decimal\"\n            value={hours}\n            onChange={(e) => setHours(e.target.value)}\n          />\n          {err(\"hours\")}\n        </label>\n        <label className=\"block text-sm lg:col-span-2\">\n          <span className=\"mb-1 block text-slate-600\">Date</span>\n          <input\n            className={inputCls}\n            type=\"date\"\n            value={date}\n            onChange={(e) => setDate(e.target.value)}\n          />\n          {err(\"date\")}\n        </label>\n        <div className=\"flex items-end lg:col-span-1\">\n          <button className={`${btnCls} w-full`} disabled={busy}>\n            Add\n          </button>\n        </div>\n      </div>\n      {message && <p className=\"mt-2 text-sm text-red-600\">{message}</p>}\n    </form>\n  );\n}\nEOF\ncat > src/EntryRow.tsx <<'EOF'\nimport { useState } from \"react\";\nimport { api, ApiError, Entry } from \"./api\";\nimport { btnCls, btnSecondaryCls, inputCls } from \"./AuthForms\";\n\nexport default function EntryRow({\n  entry,\n  onChanged,\n}: {\n  entry: Entry;\n  onChanged: () => void;\n}) {\n  const [editing, setEditing] = useState(false);\n  const [confirming, setConfirming] = useState(false);\n  const [project, setProject] = useState(entry.project);\n  const [description, setDescription] = useState(entry.description);\n  const [hours, setHours] = useState(String(entry.hours));\n  const [date, setDate] = useState(entry.date);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  function startEdit() {\n    setProject(entry.project);\n    setDescription(entry.description);\n    setHours(String(entry.hours));\n    setDate(entry.date);\n    setErrors({});\n    setMessage(\"\");\n    setEditing(true);\n  }\n\n  function fail(err: unknown) {\n    if (err instanceof ApiError) {\n      setErrors(err.errors);\n      setMessage(Object.keys(err.errors).length ? \"\" : err.message);\n    } else {\n      setMessage(\"Network error\");\n    }\n  }\n\n  async function save() {\n    setBusy(true);\n    setErrors({});\n    setMessage(\"\");\n    const h = Number(hours.replace(\",\", \".\"));\n    try {\n      await api.update(entry.id, {\n        project,\n        description,\n        hours: hours.trim() === \"\" || Number.isNaN(h) ? (hours as unknown as number) : h,\n        date,\n      });\n      setEditing(false);\n      onChanged();\n    } catch (err) {\n      fail(err);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function remove() {\n    setBusy(true);\n    try {\n      await api.remove(entry.id);\n      onChanged();\n    } catch (err) {\n      fail(err);\n      setConfirming(false);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const err = (k: string) => errors[k] && <div className=\"text-xs text-red-600\">{errors[k]}</div>;\n\n  if (editing) {\n    return (\n      <tr className=\"bg-indigo-50 align-top\">\n        <td className=\"p-2\">\n          <input className={inputCls} type=\"date\" value={date} onChange={(e) => setDate(e.target.value)} />\n          {err(\"date\")}\n        </td>\n        <td className=\"p-2\">\n          <input className={inputCls} value={project} onChange={(e) => setProject(e.target.value)} />\n          {err(\"project\")}\n        </td>\n        <td className=\"p-2\">\n          <input className={inputCls} value={description} onChange={(e) => setDescription(e.target.value)} />\n          {err(\"description\")}\n        </td>\n        <td className=\"p-2\">\n          <input className={inputCls} inputMode=\"decimal\" value={hours} onChange={(e) => setHours(e.target.value)} />\n          {err(\"hours\")}\n        </td>\n        <td className=\"p-2 text-right whitespace-nowrap\">\n          <button className={btnCls} onClick={save} disabled={busy}>\n            Save\n          </button>{\" \"}\n          <button className={btnSecondaryCls} onClick={() => setEditing(false)} disabled={busy}>\n            Cancel\n          </button>\n          {message && <div className=\"text-xs text-red-600\">{message}</div>}\n        </td>\n      </tr>\n    );\n  }\n\n  return (\n    <tr className=\"align-top hover:bg-slate-50\">\n      <td className=\"p-2 whitespace-nowrap\">{entry.date}</td>\n      <td className=\"p-2\">{entry.project}</td>\n      <td className=\"p-2 break-words text-slate-600\">{entry.description}</td>\n      <td className=\"p-2 text-right tabular-nums\">{entry.hours}</td>\n      <td className=\"p-2 text-right whitespace-nowrap\">\n        {confirming ? (\n          <>\n            <span className=\"mr-2 text-sm text-slate-600\">Delete this entry?</span>\n            <button\n              className=\"rounded bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50\"\n              onClick={remove}\n              disabled={busy}\n            >\n              Delete\n            </button>{\" \"}\n            <button className={btnSecondaryCls} onClick={() => setConfirming(false)}>\n              Cancel\n            </button>\n          </>\n        ) : (\n          <>\n            <button className={btnSecondaryCls} onClick={startEdit}>\n              Edit\n            </button>{\" \"}\n            <button className={btnSecondaryCls} onClick={() => setConfirming(true)}>\n              Delete\n            </button>\n          </>\n        )}\n        {message && <div className=\"text-xs text-red-600\">{message}</div>}\n      </td>\n    </tr>\n  );\n}\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, EntryPage, Filters, session, setUnauthorizedHandler, Summary } from \"./api\";\nimport AuthForms, { btnSecondaryCls, inputCls } from \"./AuthForms\";\nimport EntryForm from \"./EntryForm\";\nimport EntryRow from \"./EntryRow\";\n\nconst PAGE_SIZE = 20;\nconst emptyFilters: Filters = { start_date: \"\", end_date: \"\", project: \"\" };\n\nfunction Timesheet({ username, onSignOut }: { username: string; onSignOut: () => void }) {\n  const [filters, setFilters] = useState<Filters>(emptyFilters);\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<EntryPage | null>(null);\n  const [summary, setSummary] = useState<Summary | null>(null);\n  const [projects, setProjects] = useState<string[]>([]);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n\n  const load = useCallback(async () => {\n    try {\n      const [entries, sum, proj] = await Promise.all([\n        api.entries(filters, page, PAGE_SIZE),\n        api.summary(filters),\n        api.projects(),\n      ]);\n      const lastPage = Math.max(1, Math.ceil(entries.total / PAGE_SIZE));\n      if (page > lastPage) {\n        setPage(lastPage);\n        return;\n      }\n      setData(entries);\n      setSummary(sum);\n      setProjects(proj.items);\n      setError(\"\");\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Network error\");\n    } finally {\n      setLoading(false);\n    }\n  }, [filters, page]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  function changeFilter(key: keyof Filters, value: string) {\n    setFilters((f) => ({ ...f, [key]: value }));\n    setPage(1);\n  }\n\n  async function download(path: string, params: Record<string, string>, name: string) {\n    try {\n      await api.download(path, params, name);\n      setError(\"\");\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Download failed\");\n    }\n  }\n\n  async function signOut() {\n    try {\n      await api.logout();\n    } catch {\n      /* token may already be invalid */\n    }\n    onSignOut();\n  }\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"mx-auto max-w-5xl space-y-4 p-4\">\n      <header className=\"flex items-center justify-between\">\n        <h1 className=\"text-xl font-semibold text-slate-800\">Timesheet</h1>\n        <div className=\"flex items-center gap-3 text-sm\">\n          <span className=\"text-slate-600\">\n            Signed in as <strong data-testid=\"username\">{username}</strong>\n          </span>\n          <button className={btnSecondaryCls} onClick={signOut}>\n            Sign out\n          </button>\n        </div>\n      </header>\n\n      <EntryForm projects={projects} onCreated={load} />\n\n      <section className=\"rounded-lg bg-white p-4 shadow\">\n        <div className=\"mb-3 flex flex-wrap items-end gap-3\">\n          <label className=\"text-sm\">\n            <span className=\"mb-1 block text-slate-600\">From</span>\n            <input\n              className={inputCls}\n              type=\"date\"\n              value={filters.start_date}\n              onChange={(e) => changeFilter(\"start_date\", e.target.value)}\n            />\n          </label>\n          <label className=\"text-sm\">\n            <span className=\"mb-1 block text-slate-600\">To</span>\n            <input\n              className={inputCls}\n              type=\"date\"\n              value={filters.end_date}\n              onChange={(e) => changeFilter(\"end_date\", e.target.value)}\n            />\n          </label>\n          <label className=\"text-sm\">\n            <span className=\"mb-1 block text-slate-600\">Project</span>\n            <select\n              className={inputCls}\n              value={filters.project}\n              onChange={(e) => changeFilter(\"project\", e.target.value)}\n            >\n              <option value=\"\">All projects</option>\n              {filters.project && !projects.includes(filters.project) && (\n                <option value={filters.project}>{filters.project}</option>\n              )}\n              {projects.map((p) => (\n                <option key={p} value={p}>\n                  {p}\n                </option>\n              ))}\n            </select>\n          </label>\n          <button\n            className={btnSecondaryCls}\n            onClick={() => {\n              setFilters(emptyFilters);\n              setPage(1);\n            }}\n          >\n            Clear\n          </button>\n          <div className=\"ml-auto flex gap-2\">\n            <button\n              className={btnSecondaryCls}\n              onClick={() => download(\"/api/exports/entries.csv\", { ...filters }, \"entries.csv\")}\n            >\n              Export CSV\n            </button>\n            <button\n              className={btnSecondaryCls}\n              onClick={() =>\n                download(\n                  \"/api/exports/summary.csv\",\n                  { start_date: filters.start_date, end_date: filters.end_date },\n                  \"summary.csv\",\n                )\n              }\n            >\n              Export totals\n            </button>\n          </div>\n        </div>\n\n        {error && <p className=\"mb-2 text-sm text-red-600\">{error}</p>}\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 text-slate-500\">\n              <tr>\n                <th className=\"p-2\">Date</th>\n                <th className=\"p-2\">Project</th>\n                <th className=\"p-2\">Description</th>\n                <th className=\"p-2 text-right\">Hours</th>\n                <th className=\"p-2\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {data?.items.map((entry) => (\n                <EntryRow key={entry.id} entry={entry} onChanged={load} />\n              ))}\n              {data && data.items.length === 0 && (\n                <tr>\n                  <td colSpan={5} className=\"p-4 text-center text-slate-500\">\n                    {loading ? \"Loading...\" : \"No entries\"}\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        <div className=\"mt-3 flex items-center justify-between text-sm text-slate-600\">\n          <span>{data ? `${data.total} entries` : \"\"}</span>\n          <div className=\"flex items-center gap-2\">\n            <button\n              className={btnSecondaryCls}\n              disabled={page <= 1}\n              onClick={() => setPage((p) => p - 1)}\n            >\n              Previous\n            </button>\n            <span>\n              Page {page} of {totalPages}\n            </span>\n            <button\n              className={btnSecondaryCls}\n              disabled={page >= totalPages}\n              onClick={() => setPage((p) => p + 1)}\n            >\n              Next\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section className=\"rounded-lg bg-white p-4 shadow\">\n        <h2 className=\"mb-2 font-semibold text-slate-800\">Totals per project</h2>\n        {summary && summary.items.length > 0 ? (\n          <table className=\"w-full text-sm\">\n            <tbody className=\"divide-y divide-slate-100\">\n              {summary.items.map((s) => (\n                <tr key={s.project}>\n                  <td className=\"p-2\">{s.project}</td>\n                  <td className=\"p-2 text-right tabular-nums\">{s.hours}</td>\n                </tr>\n              ))}\n              <tr className=\"font-semibold\">\n                <td className=\"p-2\">Total</td>\n                <td className=\"p-2 text-right tabular-nums\">{summary.total_hours}</td>\n              </tr>\n            </tbody>\n          </table>\n        ) : (\n          <p className=\"text-sm text-slate-500\">No hours logged for this period.</p>\n        )}\n      </section>\n    </div>\n  );\n}\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(session.token ? session.username : null);\n\n  useEffect(() => {\n    setUnauthorizedHandler(() => {\n      session.clear();\n      setUsername(null);\n    });\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      {username ? (\n        <Timesheet\n          username={username}\n          onSignOut={() => {\n            session.clear();\n            setUsername(null);\n          }}\n        />\n      ) : (\n        <AuthForms onSignedIn={setUsername} />\n      )}\n    </div>\n  );\n}\nEOF\nnpx tsc --noEmit && npm run build 2>&1 | tail -8"},"output":"✓ 20 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-DDG0O2e3.css   12.73 kB │ gzip:  3.38 kB\ndist/assets/index-BXRPat6B.js   234.09 kB │ gzip: 72.26 kB\n\n✓ built in 316ms\n","metadata":{"output":"✓ 20 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-DDG0O2e3.css   12.73 kB │ gzip:  3.38 kB\ndist/assets/index-BXRPat6B.js   234.09 kB │ gzip: 72.26 kB\n\n✓ built in 316ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/<title>App/<title>Timesheet/' index.html\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/api.ts <<'EOF'\nexport type Entry = {\n  id: number;\n  project: string;\n  description: string;\n  hours: number;\n  date: string;\n  created_at: string;\n};\n\nexport type EntryPage = {\n  items: Entry[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type Summary = {\n  items: { project: string; hours: number }[];\n  total_hours: number;\n};\n\nexport type Filters = { start_date: string; end_date: string; project: string };\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"timesheet_token\";\nconst USER_KEY = \"timesheet_username\";\n\nexport const session = {\n  get token() {\n    return localStorage.getItem(TOKEN_KEY);\n  },\n  get username() {\n    return localStorage.getItem(USER_KEY);\n  },\n  set(token: string, username: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, username);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nasync function send(path: string, init: RequestInit = {}, auth = true): Promise<Response> {\n  const headers = new Headers(init.headers);\n  if (init.body) headers.set(\"Content-Type\", \"application/json\");\n  if (auth && session.token) headers.set(\"Authorization\", `Bearer ${session.token}`);\n  const res = await fetch(path, { ...init, headers });\n  if (!res.ok) {\n    let message = res.statusText || \"Request failed\";\n    let errors: Record<string, string> = {};\n    try {\n      const body = await res.json();\n      if (body.error) message = body.error;\n      if (body.errors) errors = body.errors;\n    } catch {\n      /* ignore non-JSON bodies */\n    }\n    if (res.status === 401 && auth && session.token) onUnauthorized();\n    throw new ApiError(res.status, message, errors);\n  }\n  return res;\n}\n\nasync function json<T>(path: string, init?: RequestInit, auth = true): Promise<T> {\n  const res = await send(path, init, auth);\n  if (res.status === 204) return undefined as T;\n  return res.json();\n}\n\nfunction query(params: Record<string, string | number | undefined>): string {\n  const q = new URLSearchParams();\n  for (const [k, v] of Object.entries(params)) {\n    if (v !== undefined && v !== \"\") q.set(k, String(v));\n  }\n  const s = q.toString();\n  return s ? `?${s}` : \"\";\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    json<{ username: string }>(\n      \"/api/auth/register\",\n      { method: \"POST\", body: JSON.stringify({ username, password }) },\n      false,\n    ),\n  login: (username: string, password: string) =>\n    json<{ token: string }>(\n      \"/api/auth/login\",\n      { method: \"POST\", body: JSON.stringify({ username, password }) },\n      false,\n    ),\n  logout: () => json<void>(\"/api/auth/logout\", { method: \"POST\" }),\n  entries: (f: Filters, page: number, pageSize: number) =>\n    json<EntryPage>(`/api/entries${query({ ...f, page, page_size: pageSize })}`),\n  summary: (f: Filters) => json<Summary>(`/api/summary${query({ ...f })}`),\n  projects: () => json<{ items: string[] }>(\"/api/projects\"),\n  create: (body: Partial<Entry>) =>\n    json<Entry>(\"/api/entries\", { method: \"POST\", body: JSON.stringify(body) }),\n  update: (id: number, body: Partial<Entry>) =>\n    json<Entry>(`/api/entries/${id}`, { method: \"PATCH\", body: JSON.stringify(body) }),\n  remove: (id: number) => json<void>(`/api/entries/${id}`, { method: \"DELETE\" }),\n  download: async (path: string, params: Record<string, string>, filename: string) => {\n    const res = await send(`${path}${query(params)}`);\n    const url = URL.createObjectURL(await res.blob());\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = filename;\n    document.body.appendChild(a);\n    a.click();\n    a.remove();\n    setTimeout(() => URL.revokeObjectURL(url), 1000);\n  },\n};\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { FormEvent, useState } from \"react\";\nimport { api, ApiError, session } from \"./api\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"rounded bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"rounded border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50\";\n\nexport default function AuthForms({ onSignedIn }: { onSignedIn: (username: string) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setErrors({});\n    setMessage(\"\");\n    try {\n      const name = username.trim();\n      if (mode === \"register\") {\n        await api.register(name, password);\n      }\n      const { token } = await api.login(name, password);\n      session.set(token, name);\n      onSignedIn(name);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.errors);\n        setMessage(Object.keys(err.errors).length ? \"\" : err.message);\n      } else {\n        setMessage(\"Network error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto mt-16 max-w-sm rounded-lg bg-white p-6 shadow\">\n      <h1 className=\"mb-4 text-xl font-semibold text-slate-800\">Timesheet</h1>\n      <div className=\"mb-4 flex gap-2 text-sm\">\n        {([\"login\", \"register\"] as const).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            onClick={() => {\n              setMode(m);\n              setErrors({});\n              setMessage(\"\");\n            }}\n            className={`rounded px-3 py-1 ${mode === m ? \"bg-indigo-100 font-medium text-indigo-700\" : \"text-slate-600 hover:bg-slate-100\"}`}\n          >\n            {m === \"login\" ? \"Sign in\" : \"Register\"}\n          </button>\n        ))}\n      </div>\n      <form onSubmit={submit} className=\"space-y-3\">\n        <label className=\"block text-sm\">\n          <span className=\"mb-1 block text-slate-600\">Username</span>\n          <input\n            className={inputCls}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n          {errors.username && <span className=\"text-xs text-red-600\">{errors.username}</span>}\n        </label>\n        <label className=\"block text-sm\">\n          <span className=\"mb-1 block text-slate-600\">Password</span>\n          <input\n            className={inputCls}\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n            required\n          />\n          {errors.password && <span className=\"text-xs text-red-600\">{errors.password}</span>}\n        </label>\n        {message && <p className=\"text-sm text-red-600\">{message}</p>}\n        <button className={`${btnCls} w-full`} disabled={busy}>\n          {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n        </button>\n      </form>\n    </div>\n  );\n}\nEOF\ncat > src/EntryForm.tsx <<'EOF'\nimport { FormEvent, useState } from \"react\";\nimport { api, ApiError } from \"./api\";\nimport { btnCls, inputCls } from \"./AuthForms\";\n\nexport function today() {\n  const d = new Date();\n  const p = (n: number) => String(n).padStart(2, \"0\");\n  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;\n}\n\nexport default function EntryForm({\n  projects,\n  onCreated,\n}: {\n  projects: string[];\n  onCreated: () => void;\n}) {\n  const [project, setProject] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [hours, setHours] = useState(\"\");\n  const [date, setDate] = useState(today());\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setErrors({});\n    setMessage(\"\");\n    const h = hours.trim() === \"\" ? NaN : Number(hours.replace(\",\", \".\"));\n    setBusy(true);\n    try {\n      await api.create({\n        project,\n        description,\n        hours: Number.isNaN(h) ? (hours as unknown as number) : h,\n        date,\n      });\n      setDescription(\"\");\n      setHours(\"\");\n      onCreated();\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setErrors(err.errors);\n        setMessage(Object.keys(err.errors).length ? \"\" : err.message);\n      } else {\n        setMessage(\"Network error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const err = (k: string) => errors[k] && <span className=\"text-xs text-red-600\">{errors[k]}</span>;\n\n  return (\n    <form onSubmit={submit} className=\"rounded-lg bg-white p-4 shadow\">\n      <h2 className=\"mb-3 font-semibold text-slate-800\">Log time</h2>\n      <div className=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-12\">\n        <label className=\"block text-sm lg:col-span-3\">\n          <span className=\"mb-1 block text-slate-600\">Project</span>\n          <input\n            className={inputCls}\n            list=\"project-suggestions\"\n            value={project}\n            onChange={(e) => setProject(e.target.value)}\n          />\n          <datalist id=\"project-suggestions\">\n            {projects.map((p) => (\n              <option key={p} value={p} />\n            ))}\n          </datalist>\n          {err(\"project\")}\n        </label>\n        <label className=\"block text-sm lg:col-span-4\">\n          <span className=\"mb-1 block text-slate-600\">Description</span>\n          <input\n            className={inputCls}\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n          />\n          {err(\"description\")}\n        </label>\n        <label className=\"block text-sm lg:col-span-2\">\n          <span className=\"mb-1 block text-slate-600\">Hours</span>\n          <input\n            className={inputCls}\n            inputMode=\"decimal\"\n            value={hours}\n            onChange={(e) => setHours(e.target.value)}\n          />\n          {err(\"hours\")}\n        </label>\n        <label className=\"block text-sm lg:col-span-2\">\n          <span className=\"mb-1 block text-slate-600\">Date</span>\n          <input\n            className={inputCls}\n            type=\"date\"\n            value={date}\n            onChange={(e) => setDate(e.target.value)}\n          />\n          {err(\"date\")}\n        </label>\n        <div className=\"flex items-end lg:col-span-1\">\n          <button className={`${btnCls} w-full`} disabled={busy}>\n            Add\n          </button>\n        </div>\n      </div>\n      {message && <p className=\"mt-2 text-sm text-red-600\">{message}</p>}\n    </form>\n  );\n}\nEOF\ncat > src/EntryRow.tsx <<'EOF'\nimport { useState } from \"react\";\nimport { api, ApiError, Entry } from \"./api\";\nimport { btnCls, btnSecondaryCls, inputCls } from \"./AuthForms\";\n\nexport default function EntryRow({\n  entry,\n  onChanged,\n}: {\n  entry: Entry;\n  onChanged: () => void;\n}) {\n  const [editing, setEditing] = useState(false);\n  const [confirming, setConfirming] = useState(false);\n  const [project, setProject] = useState(entry.project);\n  const [description, setDescription] = useState(entry.description);\n  const [hours, setHours] = useState(String(entry.hours));\n  const [date, setDate] = useState(entry.date);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [message, setMessage] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  function startEdit() {\n    setProject(entry.project);\n    setDescription(entry.description);\n    setHours(String(entry.hours));\n    setDate(entry.date);\n    setErrors({});\n    setMessage(\"\");\n    setEditing(true);\n  }\n\n  function fail(err: unknown) {\n    if (err instanceof ApiError) {\n      setErrors(err.errors);\n      setMessage(Object.keys(err.errors).length ? \"\" : err.message);\n    } else {\n      setMessage(\"Network error\");\n    }\n  }\n\n  async function save() {\n    setBusy(true);\n    setErrors({});\n    setMessage(\"\");\n    const h = Number(hours.replace(\",\", \".\"));\n    try {\n      await api.update(entry.id, {\n        project,\n        description,\n        hours: hours.trim() === \"\" || Number.isNaN(h) ? (hours as unknown as number) : h,\n        date,\n      });\n      setEditing(false);\n      onChanged();\n    } catch (err) {\n      fail(err);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function remove() {\n    setBusy(true);\n    try {\n      await api.remove(entry.id);\n      onChanged();\n    } catch (err) {\n      fail(err);\n      setConfirming(false);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const err = (k: string) => errors[k] && <div className=\"text-xs text-red-600\">{errors[k]}</div>;\n\n  if (editing) {\n    return (\n      <tr className=\"bg-indigo-50 align-top\">\n        <td className=\"p-2\">\n          <input className={inputCls} type=\"date\" value={date} onChange={(e) => setDate(e.target.value)} />\n          {err(\"date\")}\n        </td>\n        <td className=\"p-2\">\n          <input className={inputCls} value={project} onChange={(e) => setProject(e.target.value)} />\n          {err(\"project\")}\n        </td>\n        <td className=\"p-2\">\n          <input className={inputCls} value={description} onChange={(e) => setDescription(e.target.value)} />\n          {err(\"description\")}\n        </td>\n        <td className=\"p-2\">\n          <input className={inputCls} inputMode=\"decimal\" value={hours} onChange={(e) => setHours(e.target.value)} />\n          {err(\"hours\")}\n        </td>\n        <td className=\"p-2 text-right whitespace-nowrap\">\n          <button className={btnCls} onClick={save} disabled={busy}>\n            Save\n          </button>{\" \"}\n          <button className={btnSecondaryCls} onClick={() => setEditing(false)} disabled={busy}>\n            Cancel\n          </button>\n          {message && <div className=\"text-xs text-red-600\">{message}</div>}\n        </td>\n      </tr>\n    );\n  }\n\n  return (\n    <tr className=\"align-top hover:bg-slate-50\">\n      <td className=\"p-2 whitespace-nowrap\">{entry.date}</td>\n      <td className=\"p-2\">{entry.project}</td>\n      <td className=\"p-2 break-words text-slate-600\">{entry.description}</td>\n      <td className=\"p-2 text-right tabular-nums\">{entry.hours}</td>\n      <td className=\"p-2 text-right whitespace-nowrap\">\n        {confirming ? (\n          <>\n            <span className=\"mr-2 text-sm text-slate-600\">Delete this entry?</span>\n            <button\n              className=\"rounded bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50\"\n              onClick={remove}\n              disabled={busy}\n            >\n              Delete\n            </button>{\" \"}\n            <button className={btnSecondaryCls} onClick={() => setConfirming(false)}>\n              Cancel\n            </button>\n          </>\n        ) : (\n          <>\n            <button className={btnSecondaryCls} onClick={startEdit}>\n              Edit\n            </button>{\" \"}\n            <button className={btnSecondaryCls} onClick={() => setConfirming(true)}>\n              Delete\n            </button>\n          </>\n        )}\n        {message && <div className=\"text-xs text-red-600\">{message}</div>}\n      </td>\n    </tr>\n  );\n}\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, EntryPage, Filters, session, setUnauthorizedHandler, Summary } from \"./api\";\nimport AuthForms, { btnSecondaryCls, inputCls } from \"./AuthForms\";\nimport EntryForm from \"./EntryForm\";\nimport EntryRow from \"./EntryRow\";\n\nconst PAGE_SIZE = 20;\nconst emptyFilters: Filters = { start_date: \"\", end_date: \"\", project: \"\" };\n\nfunction Timesheet({ username, onSignOut }: { username: string; onSignOut: () => void }) {\n  const [filters, setFilters] = useState<Filters>(emptyFilters);\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<EntryPage | null>(null);\n  const [summary, setSummary] = useState<Summary | null>(null);\n  const [projects, setProjects] = useState<string[]>([]);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n\n  const load = useCallback(async () => {\n    try {\n      const [entries, sum, proj] = await Promise.all([\n        api.entries(filters, page, PAGE_SIZE),\n        api.summary(filters),\n        api.projects(),\n      ]);\n      const lastPage = Math.max(1, Math.ceil(entries.total / PAGE_SIZE));\n      if (page > lastPage) {\n        setPage(lastPage);\n        return;\n      }\n      setData(entries);\n      setSummary(sum);\n      setProjects(proj.items);\n      setError(\"\");\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Network error\");\n    } finally {\n      setLoading(false);\n    }\n  }, [filters, page]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  function changeFilter(key: keyof Filters, value: string) {\n    setFilters((f) => ({ ...f, [key]: value }));\n    setPage(1);\n  }\n\n  async function download(path: string, params: Record<string, string>, name: string) {\n    try {\n      await api.download(path, params, name);\n      setError(\"\");\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Download failed\");\n    }\n  }\n\n  async function signOut() {\n    try {\n      await api.logout();\n    } catch {\n      /* token may already be invalid */\n    }\n    onSignOut();\n  }\n\n  const totalPages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"mx-auto max-w-5xl space-y-4 p-4\">\n      <header className=\"flex items-center justify-between\">\n        <h1 className=\"text-xl font-semibold text-slate-800\">Timesheet</h1>\n        <div className=\"flex items-center gap-3 text-sm\">\n          <span className=\"text-slate-600\">\n            Signed in as <strong data-testid=\"username\">{username}</strong>\n          </span>\n          <button className={btnSecondaryCls} onClick={signOut}>\n            Sign out\n          </button>\n        </div>\n      </header>\n\n      <EntryForm projects={projects} onCreated={load} />\n\n      <section className=\"rounded-lg bg-white p-4 shadow\">\n        <div className=\"mb-3 flex flex-wrap items-end gap-3\">\n          <label className=\"text-sm\">\n            <span className=\"mb-1 block text-slate-600\">From</span>\n            <input\n              className={inputCls}\n              type=\"date\"\n              value={filters.start_date}\n              onChange={(e) => changeFilter(\"start_date\", e.target.value)}\n            />\n          </label>\n          <label className=\"text-sm\">\n            <span className=\"mb-1 block text-slate-600\">To</span>\n            <input\n              className={inputCls}\n              type=\"date\"\n              value={filters.end_date}\n              onChange={(e) => changeFilter(\"end_date\", e.target.value)}\n            />\n          </label>\n          <label className=\"text-sm\">\n            <span className=\"mb-1 block text-slate-600\">Project</span>\n            <select\n              className={inputCls}\n              value={filters.project}\n              onChange={(e) => changeFilter(\"project\", e.target.value)}\n            >\n              <option value=\"\">All projects</option>\n              {filters.project && !projects.includes(filters.project) && (\n                <option value={filters.project}>{filters.project}</option>\n              )}\n              {projects.map((p) => (\n                <option key={p} value={p}>\n                  {p}\n                </option>\n              ))}\n            </select>\n          </label>\n          <button\n            className={btnSecondaryCls}\n            onClick={() => {\n              setFilters(emptyFilters);\n              setPage(1);\n            }}\n          >\n            Clear\n          </button>\n          <div className=\"ml-auto flex gap-2\">\n            <button\n              className={btnSecondaryCls}\n              onClick={() => download(\"/api/exports/entries.csv\", { ...filters }, \"entries.csv\")}\n            >\n              Export CSV\n            </button>\n            <button\n              className={btnSecondaryCls}\n              onClick={() =>\n                download(\n                  \"/api/exports/summary.csv\",\n                  { start_date: filters.start_date, end_date: filters.end_date },\n                  \"summary.csv\",\n                )\n              }\n            >\n              Export totals\n            </button>\n          </div>\n        </div>\n\n        {error && <p className=\"mb-2 text-sm text-red-600\">{error}</p>}\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 text-slate-500\">\n              <tr>\n                <th className=\"p-2\">Date</th>\n                <th className=\"p-2\">Project</th>\n                <th className=\"p-2\">Description</th>\n                <th className=\"p-2 text-right\">Hours</th>\n                <th className=\"p-2\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {data?.items.map((entry) => (\n                <EntryRow key={entry.id} entry={entry} onChanged={load} />\n              ))}\n              {data && data.items.length === 0 && (\n                <tr>\n                  <td colSpan={5} className=\"p-4 text-center text-slate-500\">\n                    {loading ? \"Loading...\" : \"No entries\"}\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        <div className=\"mt-3 flex items-center justify-between text-sm text-slate-600\">\n          <span>{data ? `${data.total} entries` : \"\"}</span>\n          <div className=\"flex items-center gap-2\">\n            <button\n              className={btnSecondaryCls}\n              disabled={page <= 1}\n              onClick={() => setPage((p) => p - 1)}\n            >\n              Previous\n            </button>\n            <span>\n              Page {page} of {totalPages}\n            </span>\n            <button\n              className={btnSecondaryCls}\n              disabled={page >= totalPages}\n              onClick={() => setPage((p) => p + 1)}\n            >\n              Next\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <section className=\"rounded-lg bg-white p-4 shadow\">\n        <h2 className=\"mb-2 font-semibold text-slate-800\">Totals per project</h2>\n        {summary && summary.items.length > 0 ? (\n          <table className=\"w-full text-sm\">\n            <tbody className=\"divide-y divide-slate-100\">\n              {summary.items.map((s) => (\n                <tr key={s.project}>\n                  <td className=\"p-2\">{s.project}</td>\n                  <td className=\"p-2 text-right tabular-nums\">{s.hours}</td>\n                </tr>\n              ))}\n              <tr className=\"font-semibold\">\n                <td className=\"p-2\">Total</td>\n                <td className=\"p-2 text-right tabular-nums\">{summary.total_hours}</td>\n              </tr>\n            </tbody>\n          </table>\n        ) : (\n          <p className=\"text-sm text-slate-500\">No hours logged for this period.</p>\n        )}\n      </section>\n    </div>\n  );\n}\n\nexport default function App() {\n  const [username, setUsername] = useState<string | null>(session.token ? session.username : null);\n\n  useEffect(() => {\n    setUnauthorizedHandler(() => {\n      session.clear();\n      setUsername(null);\n    });\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      {username ? (\n        <Timesheet\n          username={username}\n          onSignOut={() => {\n            session.clear();\n            setUsername(null);\n          }}\n        />\n      ) : (\n        <AuthForms onSignedIn={setUsername} />\n      )}\n    </div>\n  );\n}\nEOF\nnpx tsc --noEmit && npm run build 2>&1 | tail -8","time":{"start":1794254460634,"end":1794254462585}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1e656d0001wEbGjt7CF52L7N","sessionID":"ses_e3e1c2557ffeQ9yoqlm6QjP9wD","messageID":"msg_1c1e592a1001l0K2dCklI39p9o"}}
