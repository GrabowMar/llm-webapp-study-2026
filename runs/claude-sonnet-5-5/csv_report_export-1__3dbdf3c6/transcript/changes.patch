+import { useState } from "react";
+import { api, ApiError, Entry } from "./api";
+import { btnCls, btnSecondaryCls, inputCls } from "./AuthForms";
+
+export default function EntryRow({
+  entry,
+  onChanged,
+}: {
+  entry: Entry;
+  onChanged: () => void;
+}) {
+  const [editing, setEditing] = useState(false);
+  const [confirming, setConfirming] = useState(false);
+  const [project, setProject] = useState(entry.project);
+  const [description, setDescription] = useState(entry.description);
+  const [hours, setHours] = useState(String(entry.hours));
+  const [date, setDate] = useState(entry.date);
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const [message, setMessage] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  function startEdit() {
+    setProject(entry.project);
+    setDescription(entry.description);
+    setHours(String(entry.hours));
+    setDate(entry.date);
+    setErrors({});
+    setMessage("");
+    setEditing(true);
+  }
+
+  function fail(err: unknown) {
+    if (err instanceof ApiError) {
+      setErrors(err.errors);
+      setMessage(Object.keys(err.errors).length ? "" : err.message);
+    } else {
+      setMessage("Network error");
+    }
+  }
+
+  async function save() {
+    setBusy(true);
+    setErrors({});
+    setMessage("");
+    const h = Number(hours.replace(",", "."));
+    try {
+      await api.update(entry.id, {
+        project,
+        description,
+        hours: hours.trim() === "" || Number.isNaN(h) ? (hours as unknown as number) : h,
+        date,
+      });
+      setEditing(false);
+      onChanged();
+    } catch (err) {
+      fail(err);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function remove() {
+    setBusy(true);
+    try {
+      await api.remove(entry.id);
+      onChanged();
+    } catch (err) {
+      fail(err);
+      setConfirming(false);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const err = (k: string) => errors[k] && <div className="text-xs text-red-600">{errors[k]}</div>;
+
+  if (editing) {
+    return (
+      <tr className="bg-indigo-50 align-top">
+        <td className="p-2">
+          <input className={inputCls} type="date" value={date} onChange={(e) => setDate(e.target.value)} />
+          {err("date")}
+        </td>
+        <td className="p-2">
+          <input className={inputCls} value={project} onChange={(e) => setProject(e.target.value)} />
+          {err("project")}
+        </td>
+        <td className="p-2">
+          <input className={inputCls} value={description} onChange={(e) => setDescription(e.target.value)} />
+          {err("description")}
+        </td>
+        <td className="p-2">
+          <input className={inputCls} inputMode="decimal" value={hours} onChange={(e) => setHours(e.target.value)} />
+          {err("hours")}
+        </td>
+        <td className="p-2 text-right whitespace-nowrap">
+          <button className={btnCls} onClick={save} disabled={busy}>
+            Save
+          </button>{" "}
+          <button className={btnSecondaryCls} onClick={() => setEditing(false)} disabled={busy}>
+            Cancel
+          </button>
+          {message && <div className="text-xs text-red-600">{message}</div>}
+        </td>
+      </tr>
+    );
+  }
+
+  return (
+    <tr className="align-top hover:bg-slate-50">
+      <td className="p-2 whitespace-nowrap">{entry.date}</td>
+      <td className="p-2">{entry.project}</td>
+      <td className="p-2 break-words text-slate-600">{entry.description}</td>
+      <td className="p-2 text-right tabular-nums">{entry.hours}</td>
+      <td className="p-2 text-right whitespace-nowrap">
+        {confirming ? (
+          <>
+            <span className="mr-2 text-sm text-slate-600">Delete this entry?</span>
+            <button
+              className="rounded bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50"
+              onClick={remove}
+              disabled={busy}
+            >
+              Delete
+            </button>{" "}
+            <button className={btnSecondaryCls} onClick={() => setConfirming(false)}>
+              Cancel
+            </button>
+          </>
+        ) : (
+          <>
+            <button className={btnSecondaryCls} onClick={startEdit}>
+              Edit
+            </button>{" "}
+            <button className={btnSecondaryCls} onClick={() => setConfirming(true)}>
+              Delete
+            </button>
+          </>
+        )}
+        {message && <div className="text-xs text-red-600">{message}</div>}
+      </td>
+    </tr>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..637a47f
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,129 @@
+export type Entry = {
+  id: number;
+  project: string;
+  description: string;
+  hours: number;
+  date: string;
+  created_at: string;
+};
+
+export type EntryPage = {
+  items: Entry[];
+  total: number;
+  page: number;
+  page_size: number;
+};
+
+export type Summary = {
+  items: { project: string; hours: number }[];
+  total_hours: number;
+};
+
+export type Filters = { start_date: string; end_date: string; project: string };
+
+export class ApiError extends Error {
+  status: number;
+  errors: Record<string, string>;
+  constructor(status: number, message: string, errors: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.errors = errors;
+  }
+}
+
+const TOKEN_KEY = "timesheet_token";
+const USER_KEY = "timesheet_username";
+
+export const session = {
+  get token() {
+    return localStorage.getItem(TOKEN_KEY);
+  },
+  get username() {
+    return localStorage.getItem(USER_KEY);
+  },
+  set(token: string, username: string) {
+    localStorage.setItem(TOKEN_KEY, token);
+    localStorage.setItem(USER_KEY, username);
+  },
+  clear() {
+    localStorage.removeItem(TOKEN_KEY);
+    localStorage.removeItem(USER_KEY);
+  },
+};
+
+let onUnauthorized: () => void = () => {};
+export function setUnauthorizedHandler(fn: () => void) {
+  onUnauthorized = fn;
+}
+
+async function send(path: string, init: RequestInit = {}, auth = true): Promise<Response> {
+  const headers = new Headers(init.headers);
+  if (init.body) headers.set("Content-Type", "application/json");
+  if (auth && session.token) headers.set("Authorization", `Bearer ${session.token}`);
+  const res = await fetch(path, { ...init, headers });
+  if (!res.ok) {
+    let message = res.statusText || "Request failed";
+    let errors: Record<string, string> = {};
+    try {
+      const body = await res.json();
+      if (body.error) message = body.error;
+      if (body.errors) errors = body.errors;
+    } catch {
+      /* ignore non-JSON bodies */
+    }
+    if (res.status === 401 && auth && session.token) onUnauthorized();
+    throw new ApiError(res.status, message, errors);
+  }
+  return res;
+}
+
+async function json<T>(path: string, init?: RequestInit, auth = true): Promise<T> {
+  const res = await send(path, init, auth);
+  if (res.status === 204) return undefined as T;
+  return res.json();
+}
+
+function query(params: Record<string, string | number | undefined>): string {
+  const q = new URLSearchParams();
+  for (const [k, v] of Object.entries(params)) {
+    if (v !== undefined && v !== "") q.set(k, String(v));
+  }
+  const s = q.toString();
+  return s ? `?${s}` : "";
+}
+
+export const api = {
+  register: (username: string, password: string) =>
+    json<{ username: string }>(
+      "/api/auth/register",
+      { method: "POST", body: JSON.stringify({ username, password }) },
+      false,
+    ),
+  login: (username: string, password: string) =>
+    json<{ token: string }>(
+      "/api/auth/login",
+      { method: "POST", body: JSON.stringify({ username, password }) },
+      false,
+    ),
+  logout: () => json<void>("/api/auth/logout", { method: "POST" }),
+  entries: (f: Filters, page: number, pageSize: number) =>
+    json<EntryPage>(`/api/entries${query({ ...f, page, page_size: pageSize })}`),
+  summary: (f: Filters) => json<Summary>(`/api/summary${query({ ...f })}`),
+  projects: () => json<{ items: string[] }>("/api/projects"),
+  create: (body: Partial<Entry>) =>
+    json<Entry>("/api/entries", { method: "POST", body: JSON.stringify(body) }),
+  update: (id: number, body: Partial<Entry>) =>
+    json<Entry>(`/api/entries/${id}`, { method: "PATCH", body: JSON.stringify(body) }),
+  remove: (id: number) => json<void>(`/api/entries/${id}`, { method: "DELETE" }),
+  download: async (path: string, params: Record<string, string>, filename: string) => {
+    const res = await send(`${path}${query(params)}`);
+    const url = URL.createObjectURL(await res.blob());
+    const a = document.createElement("a");
+    a.href = url;
+    a.download = filename;
+    document.body.appendChild(a);
+    a.click();
+    a.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  },
+};
