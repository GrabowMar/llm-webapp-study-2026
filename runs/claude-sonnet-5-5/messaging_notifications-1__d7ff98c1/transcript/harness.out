{"type":"tool_use","timestamp":1794251429100,"sessionID":"ses_e3e48d175ffegADhIhHaBmRV1b","part":{"type":"tool","tool":"bash","callID":"toolu_011qnZ67DTL6LVVHbA8joxWr","state":{"status":"completed","input":{"command":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Notification center: Flask API plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"notifications.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\nTOKEN_TTL = timedelta(days=7)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.@+-]{3,64}$\")\nPASSWORD_MIN, PASSWORD_MAX = 8, 128\nMESSAGE_MAX = 1000\nTYPE_MAX = 32\nDEFAULT_PAGE_SIZE, MAX_PAGE_SIZE = 20, 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS notifications (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    message TEXT NOT NULL,\n    type TEXT NOT NULL,\n    read INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_notifications_user\n    ON notifications (user_id, id DESC);\n\"\"\"\n\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt: datetime) -> str:\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%S.%f\")[:-3] + \"Z\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (iso(now()),))\n        if ADMIN_PASSWORD:\n            conn.execute(\n                \"INSERT OR IGNORE INTO users (username, password_hash) VALUES (?, NULL)\",\n                (ADMIN_USERNAME,),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(status: int, message: str):\n    return jsonify({\"error\": message}), status\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if exc.code == 413:\n        return error(413, \"request too large\")\n    return error(exc.code or 500, exc.name.lower())\n\n\n@app.after_request\ndef headers(resp):\n    resp.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n    if request.path.startswith(\"/api/\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef body() -> dict | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    token = token.strip()\n    if scheme.lower() != \"bearer\" or not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < iso(now()):\n        return None\n    if row[\"username\"].lower() == ADMIN_USERNAME and not ADMIN_PASSWORD:\n        return None\n    return row\n\n\ndef is_admin(user: sqlite3.Row) -> bool:\n    return bool(ADMIN_PASSWORD) and user[\"username\"] == ADMIN_USERNAME\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(401, \"authentication required\")\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef credentials():\n    data = body()\n    if data is None:\n        return None, None, error(400, \"JSON object body required\")\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return None, None, error(400, \"username and password must be strings\")\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = credentials()\n    if err:\n        return err\n    if not USERNAME_RE.fullmatch(username):\n        return error(400, \"username must be 3-64 characters: letters, digits, _ . @ + -\")\n    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:\n        return error(400, f\"password must be {PASSWORD_MIN}-{PASSWORD_MAX} characters\")\n    if username.lower() == ADMIN_USERNAME:\n        return error(409, \"username already taken\")\n    try:\n        with db():\n            db().execute(\n                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                (username, generate_password_hash(password)),\n            )\n    except sqlite3.IntegrityError:\n        return error(409, \"username already taken\")\n    return jsonify({\"username\": username}), 201\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    with db():\n        db().execute(\n            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (hash_token(token), user_id, iso(now() + TOKEN_TTL)),\n        )\n    return token\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = credentials()\n    if err:\n        return err\n    bad = error(401, \"invalid username or password\")\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if username.lower() == ADMIN_USERNAME:\n        if not ADMIN_PASSWORD or row is None:\n            return bad\n        ok = hmac.compare_digest(password.encode(), ADMIN_PASSWORD.encode())\n        return jsonify({\"token\": issue_token(row[\"id\"])}) if ok else bad\n    if row is None or not row[\"password_hash\"]:\n        check_password_hash(DUMMY_HASH, password)\n        return bad\n    if not check_password_hash(row[\"password_hash\"], password):\n        return bad\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    header = request.headers[\"Authorization\"].partition(\" \")[2].strip()\n    with db():\n        db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(header),))\n    return \"\", 204\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return jsonify({\"username\": g.user[\"username\"], \"is_admin\": is_admin(g.user)})\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef parse_notification(data: dict | None, default_type: str):\n    if data is None:\n        return None, error(400, \"JSON object body required\")\n    message = data.get(\"message\")\n    if not isinstance(message, str) or not message.strip():\n        return None, error(400, \"message must be a non-empty string\")\n    if len(message) > MESSAGE_MAX:\n        return None, error(400, f\"message must be at most {MESSAGE_MAX} characters\")\n    ntype = data.get(\"type\", default_type)\n    if ntype is None:\n        ntype = default_type\n    if not isinstance(ntype, str) or not ntype.strip() or len(ntype) > TYPE_MAX:\n        return None, error(400, f\"type must be a non-empty string of at most {TYPE_MAX} characters\")\n    return (message, ntype.strip()), None\n\n\ndef parse_int_param(name: str, default: int, maximum: int | None = None):\n    raw = request.args.get(name)\n    if raw is None:\n        return default, None\n    if not re.fullmatch(r\"[0-9]{1,9}\", raw) or int(raw) < 1:\n        return None, error(400, f\"{name} must be a positive integer\")\n    value = int(raw)\n    if maximum is not None and value > maximum:\n        return None, error(400, f\"{name} must be at most {maximum}\")\n    return value, None\n\n\n@app.get(\"/api/notifications\")\n@login_required\ndef list_notifications():\n    page, err = parse_int_param(\"page\", 1)\n    if err:\n        return err\n    page_size, err = parse_int_param(\"page_size\", DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)\n    if err:\n        return err\n    where, params = [\"user_id = ?\"], [g.user[\"id\"]]\n    read = request.args.get(\"read\")\n    if read is not None:\n        if read.lower() not in (\"true\", \"false\"):\n            return error(400, \"read must be true or false\")\n        where.append(\"read = ?\")\n        params.append(1 if read.lower() == \"true\" else 0)\n    ntype = request.args.get(\"type\")\n    if ntype:\n        where.append(\"type = ?\")\n        params.append(ntype)\n    clause = \" AND \".join(where)\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM notifications WHERE {clause}\", params).fetchone()[0]\n    unread = conn.execute(\n        \"SELECT COUNT(*) FROM notifications WHERE user_id = ? AND read = 0\",\n        (g.user[\"id\"],),\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM notifications WHERE {clause} ORDER BY id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@login_required\ndef create_notification():\n    parsed, err = parse_notification(body(), \"info\")\n    if err:\n        return err\n    message, ntype = parsed\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n            \"VALUES (?, ?, ?, 0, ?)\",\n            (g.user[\"id\"], message, ntype, iso(now())),\n        )\n    row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@login_required\ndef read_all():\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\",\n            (g.user[\"id\"],),\n        )\n    return jsonify({\"updated\": cur.rowcount})\n\n\ndef own_notification(nid: int):\n    return db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (nid, g.user[\"id\"]),\n    ).fetchone()\n\n\n@app.get(\"/api/notifications/<int:nid>\")\n@login_required\ndef get_notification(nid: int):\n    row = own_notification(nid)\n    if row is None:\n        return error(404, \"notification not found\")\n    return jsonify(serialize(row))\n\n\n@app.patch(\"/api/notifications/<int:nid>\")\n@login_required\ndef update_notification(nid: int):\n    data = body()\n    if data is None or not isinstance(data.get(\"read\"), bool):\n        return error(400, \"read must be true or false\")\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"UPDATE notifications SET read = ? WHERE id = ? AND user_id = ?\",\n            (1 if data[\"read\"] else 0, nid, g.user[\"id\"]),\n        )\n    if cur.rowcount == 0:\n        return error(404, \"notification not found\")\n    return jsonify(serialize(own_notification(nid)))\n\n\n@app.delete(\"/api/notifications/<int:nid>\")\n@login_required\ndef delete_notification(nid: int):\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"DELETE FROM notifications WHERE id = ? AND user_id = ?\",\n            (nid, g.user[\"id\"]),\n        )\n    if cur.rowcount == 0:\n        return error(404, \"notification not found\")\n    return \"\", 204\n\n\n@app.post(\"/api/admin/broadcast\")\n@login_required\ndef broadcast():\n    if not is_admin(g.user):\n        return error(403, \"admin only\")\n    parsed, err = parse_notification(body(), \"announcement\")\n    if err:\n        return err\n    message, ntype = parsed\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n            \"SELECT id, ?, ?, 0, ? FROM users ORDER BY id\",\n            (message, ntype, iso(now())),\n        )\n    return jsonify({\"delivered\": cur.rowcount})\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(404, \"not found\")\n    target = (DIST / path).resolve()\n    if target.is_relative_to(DIST.resolve()) and target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cd /workspace && cat > backend/app.py <<'EOF'\n\"\"\"Notification center: Flask API plus the built frontend.\"\"\"\n\nimport hashlib\nimport hmac\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\"))\nDB_PATH = DATA_DIR / \"notifications.db\"\n\nADMIN_USERNAME = \"admin\"\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"\")\n\nTOKEN_TTL = timedelta(days=7)\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.@+-]{3,64}$\")\nPASSWORD_MIN, PASSWORD_MAX = 8, 128\nMESSAGE_MAX = 1000\nTYPE_MAX = 32\nDEFAULT_PAGE_SIZE, MAX_PAGE_SIZE = 20, 100\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 64 * 1024\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    expires_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS notifications (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    message TEXT NOT NULL,\n    type TEXT NOT NULL,\n    read INTEGER NOT NULL DEFAULT 0,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_notifications_user\n    ON notifications (user_id, id DESC);\n\"\"\"\n\nDUMMY_HASH = generate_password_hash(\"dummy-password-for-timing\")\n\n\ndef now() -> datetime:\n    return datetime.now(timezone.utc)\n\n\ndef iso(dt: datetime) -> str:\n    return dt.strftime(\"%Y-%m-%dT%H:%M:%S.%f\")[:-3] + \"Z\"\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.execute(\"DELETE FROM tokens WHERE expires_at < ?\", (iso(now()),))\n        if ADMIN_PASSWORD:\n            conn.execute(\n                \"INSERT OR IGNORE INTO users (username, password_hash) VALUES (?, NULL)\",\n                (ADMIN_USERNAME,),\n            )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(status: int, message: str):\n    return jsonify({\"error\": message}), status\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if exc.code == 413:\n        return error(413, \"request too large\")\n    return error(exc.code or 500, exc.name.lower())\n\n\n@app.after_request\ndef headers(resp):\n    resp.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n    if request.path.startswith(\"/api/\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef body() -> dict | None:\n    data = request.get_json(silent=True)\n    return data if isinstance(data, dict) else None\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user() -> sqlite3.Row | None:\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    token = token.strip()\n    if scheme.lower() != \"bearer\" or not token:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t \"\n        \"JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] < iso(now()):\n        return None\n    if row[\"username\"].lower() == ADMIN_USERNAME and not ADMIN_PASSWORD:\n        return None\n    return row\n\n\ndef is_admin(user: sqlite3.Row) -> bool:\n    return bool(ADMIN_PASSWORD) and user[\"username\"] == ADMIN_USERNAME\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(401, \"authentication required\")\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\ndef credentials():\n    data = body()\n    if data is None:\n        return None, None, error(400, \"JSON object body required\")\n    username, password = data.get(\"username\"), data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return None, None, error(400, \"username and password must be strings\")\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = credentials()\n    if err:\n        return err\n    if not USERNAME_RE.fullmatch(username):\n        return error(400, \"username must be 3-64 characters: letters, digits, _ . @ + -\")\n    if not PASSWORD_MIN <= len(password) <= PASSWORD_MAX:\n        return error(400, f\"password must be {PASSWORD_MIN}-{PASSWORD_MAX} characters\")\n    if username.lower() == ADMIN_USERNAME:\n        return error(409, \"username already taken\")\n    try:\n        with db():\n            db().execute(\n                \"INSERT INTO users (username, password_hash) VALUES (?, ?)\",\n                (username, generate_password_hash(password)),\n            )\n    except sqlite3.IntegrityError:\n        return error(409, \"username already taken\")\n    return jsonify({\"username\": username}), 201\n\n\ndef issue_token(user_id: int) -> str:\n    token = secrets.token_urlsafe(32)\n    with db():\n        db().execute(\n            \"INSERT INTO tokens (token_hash, user_id, expires_at) VALUES (?, ?, ?)\",\n            (hash_token(token), user_id, iso(now() + TOKEN_TTL)),\n        )\n    return token\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = credentials()\n    if err:\n        return err\n    bad = error(401, \"invalid username or password\")\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username,),\n    ).fetchone()\n    if username.lower() == ADMIN_USERNAME:\n        if not ADMIN_PASSWORD or row is None:\n            return bad\n        ok = hmac.compare_digest(password.encode(), ADMIN_PASSWORD.encode())\n        return jsonify({\"token\": issue_token(row[\"id\"])}) if ok else bad\n    if row is None or not row[\"password_hash\"]:\n        check_password_hash(DUMMY_HASH, password)\n        return bad\n    if not check_password_hash(row[\"password_hash\"], password):\n        return bad\n    return jsonify({\"token\": issue_token(row[\"id\"])})\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    header = request.headers[\"Authorization\"].partition(\" \")[2].strip()\n    with db():\n        db().execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(header),))\n    return \"\", 204\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return jsonify({\"username\": g.user[\"username\"], \"is_admin\": is_admin(g.user)})\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"message\": row[\"message\"],\n        \"type\": row[\"type\"],\n        \"read\": bool(row[\"read\"]),\n        \"created_at\": row[\"created_at\"],\n    }\n\n\ndef parse_notification(data: dict | None, default_type: str):\n    if data is None:\n        return None, error(400, \"JSON object body required\")\n    message = data.get(\"message\")\n    if not isinstance(message, str) or not message.strip():\n        return None, error(400, \"message must be a non-empty string\")\n    if len(message) > MESSAGE_MAX:\n        return None, error(400, f\"message must be at most {MESSAGE_MAX} characters\")\n    ntype = data.get(\"type\", default_type)\n    if ntype is None:\n        ntype = default_type\n    if not isinstance(ntype, str) or not ntype.strip() or len(ntype) > TYPE_MAX:\n        return None, error(400, f\"type must be a non-empty string of at most {TYPE_MAX} characters\")\n    return (message, ntype.strip()), None\n\n\ndef parse_int_param(name: str, default: int, maximum: int | None = None):\n    raw = request.args.get(name)\n    if raw is None:\n        return default, None\n    if not re.fullmatch(r\"[0-9]{1,9}\", raw) or int(raw) < 1:\n        return None, error(400, f\"{name} must be a positive integer\")\n    value = int(raw)\n    if maximum is not None and value > maximum:\n        return None, error(400, f\"{name} must be at most {maximum}\")\n    return value, None\n\n\n@app.get(\"/api/notifications\")\n@login_required\ndef list_notifications():\n    page, err = parse_int_param(\"page\", 1)\n    if err:\n        return err\n    page_size, err = parse_int_param(\"page_size\", DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)\n    if err:\n        return err\n    where, params = [\"user_id = ?\"], [g.user[\"id\"]]\n    read = request.args.get(\"read\")\n    if read is not None:\n        if read.lower() not in (\"true\", \"false\"):\n            return error(400, \"read must be true or false\")\n        where.append(\"read = ?\")\n        params.append(1 if read.lower() == \"true\" else 0)\n    ntype = request.args.get(\"type\")\n    if ntype:\n        where.append(\"type = ?\")\n        params.append(ntype)\n    clause = \" AND \".join(where)\n    conn = db()\n    total = conn.execute(f\"SELECT COUNT(*) FROM notifications WHERE {clause}\", params).fetchone()[0]\n    unread = conn.execute(\n        \"SELECT COUNT(*) FROM notifications WHERE user_id = ? AND read = 0\",\n        (g.user[\"id\"],),\n    ).fetchone()[0]\n    rows = conn.execute(\n        f\"SELECT * FROM notifications WHERE {clause} ORDER BY id DESC LIMIT ? OFFSET ?\",\n        [*params, page_size, (page - 1) * page_size],\n    ).fetchall()\n    return jsonify(\n        {\n            \"items\": [serialize(r) for r in rows],\n            \"total\": total,\n            \"page\": page,\n            \"page_size\": page_size,\n            \"unread_count\": unread,\n        }\n    )\n\n\n@app.post(\"/api/notifications\")\n@login_required\ndef create_notification():\n    parsed, err = parse_notification(body(), \"info\")\n    if err:\n        return err\n    message, ntype = parsed\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n            \"VALUES (?, ?, ?, 0, ?)\",\n            (g.user[\"id\"], message, ntype, iso(now())),\n        )\n    row = conn.execute(\"SELECT * FROM notifications WHERE id = ?\", (cur.lastrowid,)).fetchone()\n    return jsonify(serialize(row)), 201\n\n\n@app.post(\"/api/notifications/read-all\")\n@login_required\ndef read_all():\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"UPDATE notifications SET read = 1 WHERE user_id = ? AND read = 0\",\n            (g.user[\"id\"],),\n        )\n    return jsonify({\"updated\": cur.rowcount})\n\n\ndef own_notification(nid: int):\n    return db().execute(\n        \"SELECT * FROM notifications WHERE id = ? AND user_id = ?\",\n        (nid, g.user[\"id\"]),\n    ).fetchone()\n\n\n@app.get(\"/api/notifications/<int:nid>\")\n@login_required\ndef get_notification(nid: int):\n    row = own_notification(nid)\n    if row is None:\n        return error(404, \"notification not found\")\n    return jsonify(serialize(row))\n\n\n@app.patch(\"/api/notifications/<int:nid>\")\n@login_required\ndef update_notification(nid: int):\n    data = body()\n    if data is None or not isinstance(data.get(\"read\"), bool):\n        return error(400, \"read must be true or false\")\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"UPDATE notifications SET read = ? WHERE id = ? AND user_id = ?\",\n            (1 if data[\"read\"] else 0, nid, g.user[\"id\"]),\n        )\n    if cur.rowcount == 0:\n        return error(404, \"notification not found\")\n    return jsonify(serialize(own_notification(nid)))\n\n\n@app.delete(\"/api/notifications/<int:nid>\")\n@login_required\ndef delete_notification(nid: int):\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"DELETE FROM notifications WHERE id = ? AND user_id = ?\",\n            (nid, g.user[\"id\"]),\n        )\n    if cur.rowcount == 0:\n        return error(404, \"notification not found\")\n    return \"\", 204\n\n\n@app.post(\"/api/admin/broadcast\")\n@login_required\ndef broadcast():\n    if not is_admin(g.user):\n        return error(403, \"admin only\")\n    parsed, err = parse_notification(body(), \"announcement\")\n    if err:\n        return err\n    message, ntype = parsed\n    conn = db()\n    with conn:\n        cur = conn.execute(\n            \"INSERT INTO notifications (user_id, message, type, read, created_at) \"\n            \"SELECT id, ?, ?, 0, ? FROM users ORDER BY id\",\n            (message, ntype, iso(now())),\n        )\n    return jsonify({\"delivered\": cur.rowcount})\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if path == \"api\" or path.startswith(\"api/\"):\n        return error(404, \"not found\")\n    target = (DIST / path).resolve()\n    if target.is_relative_to(DIST.resolve()) and target.is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF","time":{"start":1794251428851,"end":1794251428929}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1b813c5001RRDliUgShvoM4J","sessionID":"ses_e3e48d175ffegADhIhHaBmRV1b","messageID":"msg_1c1b74e37001FDuFVXyGfs8rsC"}}
