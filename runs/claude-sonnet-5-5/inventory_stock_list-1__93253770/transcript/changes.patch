+        elif flag not in ("0", "false", "no", "off"):
+            msg = "low_stock must be true or false"
+            return error(400, msg, {"low_stock": msg})
+    clause = (" WHERE " + " AND ".join(where)) if where else ""
+
+    conn = db()
