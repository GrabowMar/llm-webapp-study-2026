{"type":"tool_use","timestamp":1794254647148,"sessionID":"ses_e3e1ac285ffe1RfNJ2BpEWGcBY","part":{"type":"tool","tool":"bash","callID":"toolu_011P2pX8MAtP7EXHB1qFAXah","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/<title>App<\\/title>/<title>Inventory<\\/title>/' index.html\nsed -i 's#\"build\": \"vite build\"#\"build\": \"tsc \\&\\& vite build\"#' package.json\nmkdir -p src\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/api.ts <<'EOF'\nexport type Item = {\n  id: number;\n  name: string;\n  sku: string;\n  location: string;\n  quantity: number;\n  reorder_level: number;\n  low_stock: boolean;\n};\n\nexport type Movement = {\n  id: number;\n  item_id: number;\n  delta: number;\n  reason: string;\n  quantity_after: number;\n  created_at: string;\n  username: string | null;\n};\n\nexport type ItemPage = {\n  items: Item[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type ItemInput = {\n  name: string;\n  sku: string;\n  location: string;\n  reorder_level: number | string;\n  quantity?: number | string;\n};\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string>) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"inventory.token\";\nconst USER_KEY = \"inventory.username\";\n\nexport const session = {\n  get token() {\n    return localStorage.getItem(TOKEN_KEY);\n  },\n  get username() {\n    return localStorage.getItem(USER_KEY);\n  },\n  set(token: string, username: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, username);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = session.token;\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server\", {});\n  }\n  if (res.status === 204) return undefined as T;\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) onUnauthorized();\n    const fields: Record<string, string> =\n      data && typeof data.errors === \"object\" && data.errors ? data.errors : {};\n    throw new ApiError(res.status, (data && data.error) || `Request failed (${res.status})`, fields);\n  }\n  return data as T;\n}\n\nfunction toNumber(v: number | string | undefined): number | string | undefined {\n  if (typeof v === \"string\") {\n    const t = v.trim();\n    return /^-?\\d+$/.test(t) ? Number(t) : t === \"\" ? undefined : t;\n  }\n  return v;\n}\n\nfunction itemPayload(input: ItemInput) {\n  return {\n    name: input.name,\n    sku: input.sku,\n    location: input.location,\n    reorder_level: toNumber(input.reorder_level),\n    ...(input.quantity !== undefined ? { quantity: toNumber(input.quantity) } : {}),\n  };\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string }>(\"POST\", \"/auth/login\", { username, password }),\n  listItems: (params: Record<string, string>) => {\n    const qs = new URLSearchParams();\n    for (const [k, v] of Object.entries(params)) if (v) qs.set(k, v);\n    return request<ItemPage>(\"GET\", `/items?${qs.toString()}`);\n  },\n  locations: () => request<{ items: string[] }>(\"GET\", \"/locations\"),\n  getItem: (id: string | number) => request<Item>(\"GET\", `/items/${id}`),\n  createItem: (input: ItemInput) => request<Item>(\"POST\", \"/items\", itemPayload(input)),\n  updateItem: (id: number, input: ItemInput) =>\n    request<Item>(\"PUT\", `/items/${id}`, itemPayload(input)),\n  deleteItem: (id: number) => request<void>(\"DELETE\", `/items/${id}`),\n  movements: (id: string | number) =>\n    request<{ items: Movement[] }>(\"GET\", `/items/${id}/movements`),\n  addMovement: (id: number, delta: number, reason: string) =>\n    request<Movement>(\"POST\", `/items/${id}/movements`, { delta, reason }),\n};\nEOF\ncat > src/auth.tsx <<'EOF'\nimport { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from \"react\";\nimport { api, session, setUnauthorizedHandler } from \"./api\";\n\ntype AuthState = {\n  username: string | null;\n  login: (u: string, p: string) => Promise<void>;\n  register: (u: string, p: string) => Promise<void>;\n  logout: () => void;\n};\n\nconst Ctx = createContext<AuthState>(null!);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [username, setUsername] = useState<string | null>(\n    session.token ? session.username : null,\n  );\n\n  const logout = useCallback(() => {\n    session.clear();\n    setUsername(null);\n  }, []);\n\n  useEffect(() => setUnauthorizedHandler(logout), [logout]);\n\n  const login = useCallback(async (u: string, p: string) => {\n    const res = await api.login(u, p);\n    session.set(res.token, res.username ?? u);\n    setUsername(res.username ?? u);\n  }, []);\n\n  const register = useCallback(\n    async (u: string, p: string) => {\n      await api.register(u, p);\n      await login(u, p);\n    },\n    [login],\n  );\n\n  return <Ctx.Provider value={{ username, login, register, logout }}>{children}</Ctx.Provider>;\n}\n\nexport const useAuth = () => useContext(Ctx);\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"inline-flex items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"inline-flex items-center justify-center rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 disabled:opacity-50\";\nexport const btnDangerCls =\n  \"inline-flex items-center justify-center rounded bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700 disabled:opacity-50\";\n\nexport function Field({\n  label,\n  error,\n  children,\n  htmlFor,\n}: {\n  label: string;\n  error?: string;\n  children: ReactNode;\n  htmlFor: string;\n}) {\n  return (\n    <div>\n      <label htmlFor={htmlFor} className=\"mb-1 block text-sm font-medium text-slate-700\">\n        {label}\n      </label>\n      {children}\n      {error && (\n        <p role=\"alert\" className=\"mt-1 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n    </div>\n  );\n}\n\nexport function ErrorBanner({ message }: { message: string }) {\n  if (!message) return null;\n  return (\n    <div role=\"alert\" className=\"rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </div>\n  );\n}\n\nexport function LowStockBadge() {\n  return (\n    <span className=\"rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800\">\n      Low stock\n    </span>\n  );\n}\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\nEOF\ncat > src/App.tsx <<'EOF'\nimport { Link, Navigate, Route, Routes } from \"react-router-dom\";\nimport { useAuth } from \"./auth\";\nimport { btnSecondaryCls } from \"./ui\";\nimport AuthPage from \"./pages/AuthPage\";\nimport ItemForm from \"./pages/ItemForm\";\nimport ItemPage from \"./pages/ItemPage\";\nimport Inventory from \"./pages/Inventory\";\nimport type { ReactNode } from \"react\";\n\nfunction RequireAuth({ children }: { children: ReactNode }) {\n  const { username } = useAuth();\n  return username ? <>{children}</> : <Navigate to=\"/login\" replace />;\n}\n\nexport default function App() {\n  const { username, logout } = useAuth();\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between px-4 py-3\">\n          <Link to=\"/\" className=\"text-lg font-semibold text-indigo-700\">\n            Inventory\n          </Link>\n          <nav className=\"flex items-center gap-3 text-sm\">\n            {username ? (\n              <>\n                <span>\n                  Signed in as <strong data-testid=\"username\">{username}</strong>\n                </span>\n                <button type=\"button\" className={btnSecondaryCls} onClick={logout}>\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n                  Sign in\n                </Link>\n                <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n                  Register\n                </Link>\n              </>\n            )}\n          </nav>\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">\n        <Routes>\n          <Route path=\"/\" element={<Inventory />} />\n          <Route path=\"/login\" element={<AuthPage mode=\"login\" />} />\n          <Route path=\"/register\" element={<AuthPage mode=\"register\" />} />\n          <Route path=\"/items/new\" element={<RequireAuth><ItemForm /></RequireAuth>} />\n          <Route path=\"/items/:id\" element={<ItemPage />} />\n          <Route path=\"/items/:id/edit\" element={<RequireAuth><ItemForm /></RequireAuth>} />\n          <Route path=\"*\" element={<p>Page not found.</p>} />\n        </Routes>\n      </main>\n    </div>\n  );\n}\nEOF\nmkdir -p src/pages\ncat > src/pages/AuthPage.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { Link, Navigate, useNavigate } from \"react-router-dom\";\nimport { ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { btnCls, ErrorBanner, Field, inputCls } from \"../ui\";\n\nexport default function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const { username: current, login, register } = useAuth();\n  const navigate = useNavigate();\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  if (current) return <Navigate to=\"/\" replace />;\n\n  const isLogin = mode === \"login\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    try {\n      if (isLogin) await login(username, password);\n      else await register(username, password);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else setError(\"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-sm space-y-4 rounded bg-white p-6 shadow\">\n      <h1 className=\"text-xl font-semibold\">{isLogin ? \"Sign in\" : \"Create account\"}</h1>\n      <ErrorBanner message={error} />\n      <Field label=\"Username\" htmlFor=\"username\" error={isLogin ? undefined : fields.username}>\n        <input\n          id=\"username\"\n          className={inputCls}\n          value={username}\n          autoComplete=\"username\"\n          onChange={(e) => setUsername(e.target.value)}\n        />\n      </Field>\n      <Field label=\"Password\" htmlFor=\"password\" error={isLogin ? undefined : fields.password}>\n        <input\n          id=\"password\"\n          type=\"password\"\n          className={inputCls}\n          value={password}\n          autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n          onChange={(e) => setPassword(e.target.value)}\n        />\n      </Field>\n      <button type=\"submit\" className={btnCls + \" w-full\"} disabled={busy}>\n        {isLogin ? \"Sign in\" : \"Register\"}\n      </button>\n      <p className=\"text-sm text-slate-600\">\n        {isLogin ? (\n          <>\n            No account?{\" \"}\n            <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n              Register\n            </Link>\n          </>\n        ) : (\n          <>\n            Already registered?{\" \"}\n            <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n              Sign in\n            </Link>\n          </>\n        )}\n      </p>\n    </form>\n  );\n}\nEOF\ncat > src/pages/Inventory.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { api, type ItemPage } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { btnCls, btnSecondaryCls, ErrorBanner, inputCls, LowStockBadge } from \"../ui\";\n\nconst PAGE_SIZE = 10;\n\nexport default function Inventory() {\n  const { username } = useAuth();\n  const [params, setParams] = useSearchParams();\n  const q = params.get(\"q\") ?? \"\";\n  const location = params.get(\"location\") ?? \"\";\n  const low = params.get(\"low_stock\") === \"true\";\n  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n\n  const [search, setSearch] = useState(q);\n  const [data, setData] = useState<ItemPage | null>(null);\n  const [locations, setLocations] = useState<string[]>([]);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n\n  function update(changes: Record<string, string>) {\n    const next = new URLSearchParams(params);\n    for (const [k, v] of Object.entries(changes)) {\n      if (v) next.set(k, v);\n      else next.delete(k);\n    }\n    setParams(next, { replace: true });\n  }\n\n  useEffect(() => {\n    if (search === q) return;\n    const t = setTimeout(() => update({ q: search.trim(), page: \"\" }), 300);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  useEffect(() => {\n    api.locations().then((r) => setLocations(r.items)).catch(() => {});\n  }, []);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    api\n      .listItems({\n        q,\n        location,\n        low_stock: low ? \"true\" : \"\",\n        page: String(page),\n        page_size: String(PAGE_SIZE),\n      })\n      .then((r) => {\n        if (cancelled) return;\n        setData(r);\n        setError(\"\");\n      })\n      .catch((e) => !cancelled && setError(e.message))\n      .finally(() => !cancelled && setLoading(false));\n    return () => {\n      cancelled = true;\n    };\n  }, [q, location, low, page]);\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h1 className=\"text-2xl font-semibold\">Inventory</h1>\n        {username && (\n          <Link to=\"/items/new\" className={btnCls}>\n            Add item\n          </Link>\n        )}\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-3 rounded bg-white p-3 shadow-sm\">\n        <input\n          aria-label=\"Search\"\n          placeholder=\"Search name or SKU\"\n          className={inputCls + \" max-w-xs\"}\n          value={search}\n          onChange={(e) => setSearch(e.target.value)}\n        />\n        <select\n          aria-label=\"Location\"\n          className={inputCls + \" max-w-[12rem]\"}\n          value={location}\n          onChange={(e) => update({ location: e.target.value, page: \"\" })}\n        >\n          <option value=\"\">All locations</option>\n          {location && !locations.includes(location) && <option value={location}>{location}</option>}\n          {locations.map((l) => (\n            <option key={l} value={l}>\n              {l}\n            </option>\n          ))}\n        </select>\n        <label className=\"flex cursor-pointer items-center gap-2 text-sm\">\n          <input\n            type=\"checkbox\"\n            role=\"switch\"\n            aria-label=\"Low stock only\"\n            className=\"h-4 w-4 accent-indigo-600\"\n            checked={low}\n            onChange={(e) => update({ low_stock: e.target.checked ? \"true\" : \"\", page: \"\" })}\n          />\n          Low stock only\n        </label>\n      </div>\n\n      <ErrorBanner message={error} />\n\n      <div className=\"overflow-x-auto rounded bg-white shadow-sm\">\n        <table className=\"w-full text-left text-sm\">\n          <thead className=\"border-b border-slate-200 bg-slate-100 text-xs uppercase text-slate-600\">\n            <tr>\n              <th className=\"px-4 py-2\">Name</th>\n              <th className=\"px-4 py-2\">SKU</th>\n              <th className=\"px-4 py-2\">Location</th>\n              <th className=\"px-4 py-2 text-right\">Quantity</th>\n              <th className=\"px-4 py-2 text-right\">Reorder level</th>\n            </tr>\n          </thead>\n          <tbody>\n            {data?.items.map((it) => (\n              <tr\n                key={it.id}\n                data-low-stock={it.low_stock}\n                className={\n                  \"border-b border-slate-100 \" +\n                  (it.low_stock ? \"bg-red-50 text-red-900 hover:bg-red-100\" : \"hover:bg-slate-50\")\n                }\n              >\n                <td className=\"px-4 py-2 font-medium\">\n                  <Link to={`/items/${it.id}`} className=\"text-indigo-700 hover:underline\">\n                    {it.name}\n                  </Link>{\" \"}\n                  {it.low_stock && <LowStockBadge />}\n                </td>\n                <td className=\"px-4 py-2\">{it.sku}</td>\n                <td className=\"px-4 py-2\">{it.location}</td>\n                <td className=\"px-4 py-2 text-right tabular-nums\">{it.quantity}</td>\n                <td className=\"px-4 py-2 text-right tabular-nums\">{it.reorder_level}</td>\n              </tr>\n            ))}\n            {data && data.items.length === 0 && (\n              <tr>\n                <td colSpan={5} className=\"px-4 py-6 text-center text-slate-500\">\n                  No items found.\n                </td>\n              </tr>\n            )}\n            {!data && loading && (\n              <tr>\n                <td colSpan={5} className=\"px-4 py-6 text-center text-slate-500\">\n                  Loading...\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      {data && (\n        <div className=\"flex items-center justify-between text-sm\">\n          <span>\n            {data.total} item{data.total === 1 ? \"\" : \"s\"} - page {data.page} of {pages}\n          </span>\n          <div className=\"flex gap-2\">\n            <button\n              type=\"button\"\n              className={btnSecondaryCls}\n              disabled={page <= 1}\n              onClick={() => update({ page: page - 1 > 1 ? String(page - 1) : \"\" })}\n            >\n              Previous\n            </button>\n            <button\n              type=\"button\"\n              className={btnSecondaryCls}\n              disabled={page >= pages}\n              onClick={() => update({ page: String(page + 1) })}\n            >\n              Next\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/pages/ItemForm.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { btnCls, btnSecondaryCls, ErrorBanner, Field, inputCls } from \"../ui\";\n\nexport default function ItemForm() {\n  const { id } = useParams();\n  const editing = id !== undefined;\n  const navigate = useNavigate();\n  const [form, setForm] = useState({\n    name: \"\",\n    sku: \"\",\n    location: \"\",\n    reorder_level: \"0\",\n    quantity: \"0\",\n  });\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const [loaded, setLoaded] = useState(!editing);\n\n  useEffect(() => {\n    if (!editing) return;\n    api\n      .getItem(id)\n      .then((it) => {\n        setForm({\n          name: it.name,\n          sku: it.sku,\n          location: it.location,\n          reorder_level: String(it.reorder_level),\n          quantity: String(it.quantity),\n        });\n        setLoaded(true);\n      })\n      .catch((e) => setError(e.message));\n  }, [id, editing]);\n\n  const set = (k: keyof typeof form) => (e: { target: { value: string } }) =>\n    setForm((f) => ({ ...f, [k]: e.target.value }));\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    try {\n      if (editing) {\n        const it = await api.updateItem(Number(id), form);\n        navigate(`/items/${it.id}`);\n      } else {\n        const it = await api.createItem(form);\n        navigate(`/items/${it.id}`);\n      }\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else setError(\"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-lg space-y-4 rounded bg-white p-6 shadow\">\n      <h1 className=\"text-xl font-semibold\">{editing ? \"Edit item\" : \"Add item\"}</h1>\n      <ErrorBanner message={error} />\n      <Field label=\"Name\" htmlFor=\"name\" error={fields.name}>\n        <input id=\"name\" className={inputCls} value={form.name} onChange={set(\"name\")} />\n      </Field>\n      <Field label=\"SKU\" htmlFor=\"sku\" error={fields.sku}>\n        <input id=\"sku\" className={inputCls} value={form.sku} onChange={set(\"sku\")} />\n      </Field>\n      <Field label=\"Location\" htmlFor=\"location\" error={fields.location}>\n        <input id=\"location\" className={inputCls} value={form.location} onChange={set(\"location\")} />\n      </Field>\n      {!editing && (\n        <Field label=\"Opening quantity\" htmlFor=\"quantity\" error={fields.quantity}>\n          <input\n            id=\"quantity\"\n            inputMode=\"numeric\"\n            className={inputCls}\n            value={form.quantity}\n            onChange={set(\"quantity\")}\n          />\n        </Field>\n      )}\n      <Field label=\"Reorder level\" htmlFor=\"reorder_level\" error={fields.reorder_level}>\n        <input\n          id=\"reorder_level\"\n          inputMode=\"numeric\"\n          className={inputCls}\n          value={form.reorder_level}\n          onChange={set(\"reorder_level\")}\n        />\n      </Field>\n      <div className=\"flex gap-2\">\n        <button type=\"submit\" className={btnCls} disabled={busy || !loaded}>\n          {editing ? \"Save changes\" : \"Add item\"}\n        </button>\n        <Link to={editing ? `/items/${id}` : \"/\"} className={btnSecondaryCls}>\n          Cancel\n        </Link>\n      </div>\n    </form>\n  );\n}\nEOF\ncat > src/pages/ItemPage.tsx <<'EOF'\nimport { useCallback, useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError, type Item, type Movement } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport {\n  btnCls,\n  btnDangerCls,\n  btnSecondaryCls,\n  ErrorBanner,\n  Field,\n  inputCls,\n  LowStockBadge,\n} from \"../ui\";\n\nfunction MovementForm({\n  kind,\n  itemId,\n  onDone,\n}: {\n  kind: \"receive\" | \"take\";\n  itemId: number;\n  onDone: () => void;\n}) {\n  const label = kind === \"receive\" ? \"Receive\" : \"Take out\";\n  const [amount, setAmount] = useState(\"\");\n  const [reason, setReason] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const id = `${kind}-amount`;\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    if (!/^\\d+$/.test(amount.trim()) || Number(amount) < 1) {\n      setError(\"Enter a whole number greater than 0\");\n      return;\n    }\n    const n = Number(amount);\n    setBusy(true);\n    try {\n      await api.addMovement(itemId, kind === \"receive\" ? n : -n, reason);\n      setAmount(\"\");\n      setReason(\"\");\n      onDone();\n    } catch (err) {\n      setError(\n        err instanceof ApiError ? err.fields.delta || err.fields.reason || err.message : \"Something went wrong\",\n      );\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form\n      onSubmit={submit}\n      aria-label={label}\n      className=\"space-y-3 rounded bg-white p-4 shadow-sm\"\n    >\n      <h2 className=\"font-semibold\">{label}</h2>\n      <Field label=\"Quantity\" htmlFor={id} error={error}>\n        <input\n          id={id}\n          inputMode=\"numeric\"\n          className={inputCls}\n          value={amount}\n          onChange={(e) => setAmount(e.target.value)}\n        />\n      </Field>\n      <Field label=\"Reason\" htmlFor={`${kind}-reason`}>\n        <input\n          id={`${kind}-reason`}\n          className={inputCls}\n          value={reason}\n          onChange={(e) => setReason(e.target.value)}\n        />\n      </Field>\n      <button type=\"submit\" className={kind === \"receive\" ? btnCls : btnSecondaryCls} disabled={busy}>\n        {label}\n      </button>\n    </form>\n  );\n}\n\nexport default function ItemPage() {\n  const { id } = useParams();\n  const { username } = useAuth();\n  const navigate = useNavigate();\n  const [item, setItem] = useState<Item | null>(null);\n  const [moves, setMoves] = useState<Movement[]>([]);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(async () => {\n    try {\n      const [it, mv] = await Promise.all([api.getItem(id!), api.movements(id!)]);\n      setItem(it);\n      setMoves(mv.items);\n      setError(\"\");\n    } catch (e) {\n      setError(e instanceof Error ? e.message : \"Something went wrong\");\n    }\n  }, [id]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function remove() {\n    if (!item) return;\n    setBusy(true);\n    try {\n      await api.deleteItem(item.id);\n      navigate(\"/\");\n    } catch (e) {\n      setError(e instanceof Error ? e.message : \"Something went wrong\");\n      setConfirming(false);\n      setBusy(false);\n    }\n  }\n\n  if (!item) {\n    return error ? (\n      <div className=\"space-y-3\">\n        <ErrorBanner message={error} />\n        <Link to=\"/\" className=\"text-indigo-700 hover:underline\">\n          Back to inventory\n        </Link>\n      </div>\n    ) : (\n      <p>Loading...</p>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <Link to=\"/\" className=\"text-sm text-indigo-700 hover:underline\">\n        &larr; Back to inventory\n      </Link>\n      <ErrorBanner message={error} />\n      <div className=\"flex flex-wrap items-start justify-between gap-4 rounded bg-white p-4 shadow-sm\">\n        <div>\n          <h1 className=\"text-2xl font-semibold\">\n            {item.name} {item.low_stock && <LowStockBadge />}\n          </h1>\n          <dl className=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm\">\n            <dt className=\"text-slate-500\">SKU</dt>\n            <dd>{item.sku}</dd>\n            <dt className=\"text-slate-500\">Location</dt>\n            <dd>{item.location || \"-\"}</dd>\n            <dt className=\"text-slate-500\">Quantity</dt>\n            <dd data-testid=\"quantity\" className=\"font-semibold\">\n              {item.quantity}\n            </dd>\n            <dt className=\"text-slate-500\">Reorder level</dt>\n            <dd>{item.reorder_level}</dd>\n          </dl>\n        </div>\n        {username && (\n          <div className=\"flex items-center gap-2\">\n            {confirming ? (\n              <>\n                <span className=\"text-sm\">Delete this item and its history?</span>\n                <button type=\"button\" className={btnDangerCls} onClick={remove} disabled={busy}>\n                  Confirm delete\n                </button>\n                <button type=\"button\" className={btnSecondaryCls} onClick={() => setConfirming(false)}>\n                  Cancel\n                </button>\n              </>\n            ) : (\n              <>\n                <Link to={`/items/${item.id}/edit`} className={btnSecondaryCls}>\n                  Edit\n                </Link>\n                <button type=\"button\" className={btnDangerCls} onClick={() => setConfirming(true)}>\n                  Delete\n                </button>\n              </>\n            )}\n          </div>\n        )}\n      </div>\n\n      {username ? (\n        <div className=\"grid gap-4 sm:grid-cols-2\">\n          <MovementForm kind=\"receive\" itemId={item.id} onDone={load} />\n          <MovementForm kind=\"take\" itemId={item.id} onDone={load} />\n        </div>\n      ) : (\n        <p className=\"text-sm text-slate-600\">\n          <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n            Sign in\n          </Link>{\" \"}\n          to receive or take out stock.\n        </p>\n      )}\n\n      <section>\n        <h2 className=\"mb-2 text-lg font-semibold\">Movement history</h2>\n        <div className=\"overflow-x-auto rounded bg-white shadow-sm\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 bg-slate-100 text-xs uppercase text-slate-600\">\n              <tr>\n                <th className=\"px-4 py-2\">When</th>\n                <th className=\"px-4 py-2 text-right\">Change</th>\n                <th className=\"px-4 py-2 text-right\">Quantity after</th>\n                <th className=\"px-4 py-2\">Reason</th>\n                <th className=\"px-4 py-2\">User</th>\n              </tr>\n            </thead>\n            <tbody>\n              {moves.map((m) => (\n                <tr key={m.id} className=\"border-b border-slate-100\">\n                  <td className=\"px-4 py-2\">{new Date(m.created_at).toLocaleString()}</td>\n                  <td\n                    className={\n                      \"px-4 py-2 text-right tabular-nums \" +\n                      (m.delta > 0 ? \"text-green-700\" : \"text-red-700\")\n                    }\n                  >\n                    {m.delta > 0 ? `+${m.delta}` : m.delta}\n                  </td>\n                  <td className=\"px-4 py-2 text-right tabular-nums\">{m.quantity_after}</td>\n                  <td className=\"px-4 py-2\">{m.reason}</td>\n                  <td className=\"px-4 py-2\">{m.username ?? \"-\"}</td>\n                </tr>\n              ))}\n              {moves.length === 0 && (\n                <tr>\n                  <td colSpan={5} className=\"px-4 py-6 text-center text-slate-500\">\n                    No movements yet.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </section>\n    </div>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20"},"output":"\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 30 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-u7jnQTBs.css   13.46 kB │ gzip:  3.54 kB\ndist/assets/index-CVn7K-zF.js   278.47 kB │ gzip: 86.93 kB\n\n✓ built in 482ms\n","metadata":{"output":"\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 30 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.26 kB\ndist/assets/index-u7jnQTBs.css   13.46 kB │ gzip:  3.54 kB\ndist/assets/index-CVn7K-zF.js   278.47 kB │ gzip: 86.93 kB\n\n✓ built in 482ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's/<title>App<\\/title>/<title>Inventory<\\/title>/' index.html\nsed -i 's#\"build\": \"vite build\"#\"build\": \"tsc \\&\\& vite build\"#' package.json\nmkdir -p src\ncat > src/index.css <<'EOF'\n@import \"tailwindcss\";\nEOF\ncat > src/api.ts <<'EOF'\nexport type Item = {\n  id: number;\n  name: string;\n  sku: string;\n  location: string;\n  quantity: number;\n  reorder_level: number;\n  low_stock: boolean;\n};\n\nexport type Movement = {\n  id: number;\n  item_id: number;\n  delta: number;\n  reason: string;\n  quantity_after: number;\n  created_at: string;\n  username: string | null;\n};\n\nexport type ItemPage = {\n  items: Item[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type ItemInput = {\n  name: string;\n  sku: string;\n  location: string;\n  reorder_level: number | string;\n  quantity?: number | string;\n};\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string>) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"inventory.token\";\nconst USER_KEY = \"inventory.username\";\n\nexport const session = {\n  get token() {\n    return localStorage.getItem(TOKEN_KEY);\n  },\n  get username() {\n    return localStorage.getItem(USER_KEY);\n  },\n  set(token: string, username: string) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, username);\n  },\n  clear() {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  },\n};\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = session.token;\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server\", {});\n  }\n  if (res.status === 204) return undefined as T;\n  let data: any = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) onUnauthorized();\n    const fields: Record<string, string> =\n      data && typeof data.errors === \"object\" && data.errors ? data.errors : {};\n    throw new ApiError(res.status, (data && data.error) || `Request failed (${res.status})`, fields);\n  }\n  return data as T;\n}\n\nfunction toNumber(v: number | string | undefined): number | string | undefined {\n  if (typeof v === \"string\") {\n    const t = v.trim();\n    return /^-?\\d+$/.test(t) ? Number(t) : t === \"\" ? undefined : t;\n  }\n  return v;\n}\n\nfunction itemPayload(input: ItemInput) {\n  return {\n    name: input.name,\n    sku: input.sku,\n    location: input.location,\n    reorder_level: toNumber(input.reorder_level),\n    ...(input.quantity !== undefined ? { quantity: toNumber(input.quantity) } : {}),\n  };\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string }>(\"POST\", \"/auth/login\", { username, password }),\n  listItems: (params: Record<string, string>) => {\n    const qs = new URLSearchParams();\n    for (const [k, v] of Object.entries(params)) if (v) qs.set(k, v);\n    return request<ItemPage>(\"GET\", `/items?${qs.toString()}`);\n  },\n  locations: () => request<{ items: string[] }>(\"GET\", \"/locations\"),\n  getItem: (id: string | number) => request<Item>(\"GET\", `/items/${id}`),\n  createItem: (input: ItemInput) => request<Item>(\"POST\", \"/items\", itemPayload(input)),\n  updateItem: (id: number, input: ItemInput) =>\n    request<Item>(\"PUT\", `/items/${id}`, itemPayload(input)),\n  deleteItem: (id: number) => request<void>(\"DELETE\", `/items/${id}`),\n  movements: (id: string | number) =>\n    request<{ items: Movement[] }>(\"GET\", `/items/${id}/movements`),\n  addMovement: (id: number, delta: number, reason: string) =>\n    request<Movement>(\"POST\", `/items/${id}/movements`, { delta, reason }),\n};\nEOF\ncat > src/auth.tsx <<'EOF'\nimport { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from \"react\";\nimport { api, session, setUnauthorizedHandler } from \"./api\";\n\ntype AuthState = {\n  username: string | null;\n  login: (u: string, p: string) => Promise<void>;\n  register: (u: string, p: string) => Promise<void>;\n  logout: () => void;\n};\n\nconst Ctx = createContext<AuthState>(null!);\n\nexport function AuthProvider({ children }: { children: ReactNode }) {\n  const [username, setUsername] = useState<string | null>(\n    session.token ? session.username : null,\n  );\n\n  const logout = useCallback(() => {\n    session.clear();\n    setUsername(null);\n  }, []);\n\n  useEffect(() => setUnauthorizedHandler(logout), [logout]);\n\n  const login = useCallback(async (u: string, p: string) => {\n    const res = await api.login(u, p);\n    session.set(res.token, res.username ?? u);\n    setUsername(res.username ?? u);\n  }, []);\n\n  const register = useCallback(\n    async (u: string, p: string) => {\n      await api.register(u, p);\n      await login(u, p);\n    },\n    [login],\n  );\n\n  return <Ctx.Provider value={{ username, login, register, logout }}>{children}</Ctx.Provider>;\n}\n\nexport const useAuth = () => useContext(Ctx);\nEOF\ncat > src/ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\n\nexport const inputCls =\n  \"w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"inline-flex items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"inline-flex items-center justify-center rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 disabled:opacity-50\";\nexport const btnDangerCls =\n  \"inline-flex items-center justify-center rounded bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700 disabled:opacity-50\";\n\nexport function Field({\n  label,\n  error,\n  children,\n  htmlFor,\n}: {\n  label: string;\n  error?: string;\n  children: ReactNode;\n  htmlFor: string;\n}) {\n  return (\n    <div>\n      <label htmlFor={htmlFor} className=\"mb-1 block text-sm font-medium text-slate-700\">\n        {label}\n      </label>\n      {children}\n      {error && (\n        <p role=\"alert\" className=\"mt-1 text-sm text-red-600\">\n          {error}\n        </p>\n      )}\n    </div>\n  );\n}\n\nexport function ErrorBanner({ message }: { message: string }) {\n  if (!message) return null;\n  return (\n    <div role=\"alert\" className=\"rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {message}\n    </div>\n  );\n}\n\nexport function LowStockBadge() {\n  return (\n    <span className=\"rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800\">\n      Low stock\n    </span>\n  );\n}\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport App from \"./App\";\nimport { AuthProvider } from \"./auth\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(\n  <BrowserRouter>\n    <AuthProvider>\n      <App />\n    </AuthProvider>\n  </BrowserRouter>,\n);\nEOF\ncat > src/App.tsx <<'EOF'\nimport { Link, Navigate, Route, Routes } from \"react-router-dom\";\nimport { useAuth } from \"./auth\";\nimport { btnSecondaryCls } from \"./ui\";\nimport AuthPage from \"./pages/AuthPage\";\nimport ItemForm from \"./pages/ItemForm\";\nimport ItemPage from \"./pages/ItemPage\";\nimport Inventory from \"./pages/Inventory\";\nimport type { ReactNode } from \"react\";\n\nfunction RequireAuth({ children }: { children: ReactNode }) {\n  const { username } = useAuth();\n  return username ? <>{children}</> : <Navigate to=\"/login\" replace />;\n}\n\nexport default function App() {\n  const { username, logout } = useAuth();\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <div className=\"mx-auto flex max-w-5xl items-center justify-between px-4 py-3\">\n          <Link to=\"/\" className=\"text-lg font-semibold text-indigo-700\">\n            Inventory\n          </Link>\n          <nav className=\"flex items-center gap-3 text-sm\">\n            {username ? (\n              <>\n                <span>\n                  Signed in as <strong data-testid=\"username\">{username}</strong>\n                </span>\n                <button type=\"button\" className={btnSecondaryCls} onClick={logout}>\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n                  Sign in\n                </Link>\n                <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n                  Register\n                </Link>\n              </>\n            )}\n          </nav>\n        </div>\n      </header>\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">\n        <Routes>\n          <Route path=\"/\" element={<Inventory />} />\n          <Route path=\"/login\" element={<AuthPage mode=\"login\" />} />\n          <Route path=\"/register\" element={<AuthPage mode=\"register\" />} />\n          <Route path=\"/items/new\" element={<RequireAuth><ItemForm /></RequireAuth>} />\n          <Route path=\"/items/:id\" element={<ItemPage />} />\n          <Route path=\"/items/:id/edit\" element={<RequireAuth><ItemForm /></RequireAuth>} />\n          <Route path=\"*\" element={<p>Page not found.</p>} />\n        </Routes>\n      </main>\n    </div>\n  );\n}\nEOF\nmkdir -p src/pages\ncat > src/pages/AuthPage.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { Link, Navigate, useNavigate } from \"react-router-dom\";\nimport { ApiError } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { btnCls, ErrorBanner, Field, inputCls } from \"../ui\";\n\nexport default function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const { username: current, login, register } = useAuth();\n  const navigate = useNavigate();\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  if (current) return <Navigate to=\"/\" replace />;\n\n  const isLogin = mode === \"login\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    try {\n      if (isLogin) await login(username, password);\n      else await register(username, password);\n      navigate(\"/\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else setError(\"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-sm space-y-4 rounded bg-white p-6 shadow\">\n      <h1 className=\"text-xl font-semibold\">{isLogin ? \"Sign in\" : \"Create account\"}</h1>\n      <ErrorBanner message={error} />\n      <Field label=\"Username\" htmlFor=\"username\" error={isLogin ? undefined : fields.username}>\n        <input\n          id=\"username\"\n          className={inputCls}\n          value={username}\n          autoComplete=\"username\"\n          onChange={(e) => setUsername(e.target.value)}\n        />\n      </Field>\n      <Field label=\"Password\" htmlFor=\"password\" error={isLogin ? undefined : fields.password}>\n        <input\n          id=\"password\"\n          type=\"password\"\n          className={inputCls}\n          value={password}\n          autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n          onChange={(e) => setPassword(e.target.value)}\n        />\n      </Field>\n      <button type=\"submit\" className={btnCls + \" w-full\"} disabled={busy}>\n        {isLogin ? \"Sign in\" : \"Register\"}\n      </button>\n      <p className=\"text-sm text-slate-600\">\n        {isLogin ? (\n          <>\n            No account?{\" \"}\n            <Link to=\"/register\" className=\"text-indigo-700 hover:underline\">\n              Register\n            </Link>\n          </>\n        ) : (\n          <>\n            Already registered?{\" \"}\n            <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n              Sign in\n            </Link>\n          </>\n        )}\n      </p>\n    </form>\n  );\n}\nEOF\ncat > src/pages/Inventory.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { Link, useSearchParams } from \"react-router-dom\";\nimport { api, type ItemPage } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport { btnCls, btnSecondaryCls, ErrorBanner, inputCls, LowStockBadge } from \"../ui\";\n\nconst PAGE_SIZE = 10;\n\nexport default function Inventory() {\n  const { username } = useAuth();\n  const [params, setParams] = useSearchParams();\n  const q = params.get(\"q\") ?? \"\";\n  const location = params.get(\"location\") ?? \"\";\n  const low = params.get(\"low_stock\") === \"true\";\n  const page = Math.max(1, Number(params.get(\"page\")) || 1);\n\n  const [search, setSearch] = useState(q);\n  const [data, setData] = useState<ItemPage | null>(null);\n  const [locations, setLocations] = useState<string[]>([]);\n  const [error, setError] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n\n  function update(changes: Record<string, string>) {\n    const next = new URLSearchParams(params);\n    for (const [k, v] of Object.entries(changes)) {\n      if (v) next.set(k, v);\n      else next.delete(k);\n    }\n    setParams(next, { replace: true });\n  }\n\n  useEffect(() => {\n    if (search === q) return;\n    const t = setTimeout(() => update({ q: search.trim(), page: \"\" }), 300);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  useEffect(() => {\n    api.locations().then((r) => setLocations(r.items)).catch(() => {});\n  }, []);\n\n  useEffect(() => {\n    let cancelled = false;\n    setLoading(true);\n    api\n      .listItems({\n        q,\n        location,\n        low_stock: low ? \"true\" : \"\",\n        page: String(page),\n        page_size: String(PAGE_SIZE),\n      })\n      .then((r) => {\n        if (cancelled) return;\n        setData(r);\n        setError(\"\");\n      })\n      .catch((e) => !cancelled && setError(e.message))\n      .finally(() => !cancelled && setLoading(false));\n    return () => {\n      cancelled = true;\n    };\n  }, [q, location, low, page]);\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h1 className=\"text-2xl font-semibold\">Inventory</h1>\n        {username && (\n          <Link to=\"/items/new\" className={btnCls}>\n            Add item\n          </Link>\n        )}\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-3 rounded bg-white p-3 shadow-sm\">\n        <input\n          aria-label=\"Search\"\n          placeholder=\"Search name or SKU\"\n          className={inputCls + \" max-w-xs\"}\n          value={search}\n          onChange={(e) => setSearch(e.target.value)}\n        />\n        <select\n          aria-label=\"Location\"\n          className={inputCls + \" max-w-[12rem]\"}\n          value={location}\n          onChange={(e) => update({ location: e.target.value, page: \"\" })}\n        >\n          <option value=\"\">All locations</option>\n          {location && !locations.includes(location) && <option value={location}>{location}</option>}\n          {locations.map((l) => (\n            <option key={l} value={l}>\n              {l}\n            </option>\n          ))}\n        </select>\n        <label className=\"flex cursor-pointer items-center gap-2 text-sm\">\n          <input\n            type=\"checkbox\"\n            role=\"switch\"\n            aria-label=\"Low stock only\"\n            className=\"h-4 w-4 accent-indigo-600\"\n            checked={low}\n            onChange={(e) => update({ low_stock: e.target.checked ? \"true\" : \"\", page: \"\" })}\n          />\n          Low stock only\n        </label>\n      </div>\n\n      <ErrorBanner message={error} />\n\n      <div className=\"overflow-x-auto rounded bg-white shadow-sm\">\n        <table className=\"w-full text-left text-sm\">\n          <thead className=\"border-b border-slate-200 bg-slate-100 text-xs uppercase text-slate-600\">\n            <tr>\n              <th className=\"px-4 py-2\">Name</th>\n              <th className=\"px-4 py-2\">SKU</th>\n              <th className=\"px-4 py-2\">Location</th>\n              <th className=\"px-4 py-2 text-right\">Quantity</th>\n              <th className=\"px-4 py-2 text-right\">Reorder level</th>\n            </tr>\n          </thead>\n          <tbody>\n            {data?.items.map((it) => (\n              <tr\n                key={it.id}\n                data-low-stock={it.low_stock}\n                className={\n                  \"border-b border-slate-100 \" +\n                  (it.low_stock ? \"bg-red-50 text-red-900 hover:bg-red-100\" : \"hover:bg-slate-50\")\n                }\n              >\n                <td className=\"px-4 py-2 font-medium\">\n                  <Link to={`/items/${it.id}`} className=\"text-indigo-700 hover:underline\">\n                    {it.name}\n                  </Link>{\" \"}\n                  {it.low_stock && <LowStockBadge />}\n                </td>\n                <td className=\"px-4 py-2\">{it.sku}</td>\n                <td className=\"px-4 py-2\">{it.location}</td>\n                <td className=\"px-4 py-2 text-right tabular-nums\">{it.quantity}</td>\n                <td className=\"px-4 py-2 text-right tabular-nums\">{it.reorder_level}</td>\n              </tr>\n            ))}\n            {data && data.items.length === 0 && (\n              <tr>\n                <td colSpan={5} className=\"px-4 py-6 text-center text-slate-500\">\n                  No items found.\n                </td>\n              </tr>\n            )}\n            {!data && loading && (\n              <tr>\n                <td colSpan={5} className=\"px-4 py-6 text-center text-slate-500\">\n                  Loading...\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      {data && (\n        <div className=\"flex items-center justify-between text-sm\">\n          <span>\n            {data.total} item{data.total === 1 ? \"\" : \"s\"} - page {data.page} of {pages}\n          </span>\n          <div className=\"flex gap-2\">\n            <button\n              type=\"button\"\n              className={btnSecondaryCls}\n              disabled={page <= 1}\n              onClick={() => update({ page: page - 1 > 1 ? String(page - 1) : \"\" })}\n            >\n              Previous\n            </button>\n            <button\n              type=\"button\"\n              className={btnSecondaryCls}\n              disabled={page >= pages}\n              onClick={() => update({ page: String(page + 1) })}\n            >\n              Next\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\nEOF\ncat > src/pages/ItemForm.tsx <<'EOF'\nimport { useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError } from \"../api\";\nimport { btnCls, btnSecondaryCls, ErrorBanner, Field, inputCls } from \"../ui\";\n\nexport default function ItemForm() {\n  const { id } = useParams();\n  const editing = id !== undefined;\n  const navigate = useNavigate();\n  const [form, setForm] = useState({\n    name: \"\",\n    sku: \"\",\n    location: \"\",\n    reorder_level: \"0\",\n    quantity: \"0\",\n  });\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const [loaded, setLoaded] = useState(!editing);\n\n  useEffect(() => {\n    if (!editing) return;\n    api\n      .getItem(id)\n      .then((it) => {\n        setForm({\n          name: it.name,\n          sku: it.sku,\n          location: it.location,\n          reorder_level: String(it.reorder_level),\n          quantity: String(it.quantity),\n        });\n        setLoaded(true);\n      })\n      .catch((e) => setError(e.message));\n  }, [id, editing]);\n\n  const set = (k: keyof typeof form) => (e: { target: { value: string } }) =>\n    setForm((f) => ({ ...f, [k]: e.target.value }));\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setFields({});\n    try {\n      if (editing) {\n        const it = await api.updateItem(Number(id), form);\n        navigate(`/items/${it.id}`);\n      } else {\n        const it = await api.createItem(form);\n        navigate(`/items/${it.id}`);\n      }\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setFields(err.fields);\n        setError(Object.keys(err.fields).length ? \"\" : err.message);\n      } else setError(\"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form onSubmit={submit} className=\"mx-auto max-w-lg space-y-4 rounded bg-white p-6 shadow\">\n      <h1 className=\"text-xl font-semibold\">{editing ? \"Edit item\" : \"Add item\"}</h1>\n      <ErrorBanner message={error} />\n      <Field label=\"Name\" htmlFor=\"name\" error={fields.name}>\n        <input id=\"name\" className={inputCls} value={form.name} onChange={set(\"name\")} />\n      </Field>\n      <Field label=\"SKU\" htmlFor=\"sku\" error={fields.sku}>\n        <input id=\"sku\" className={inputCls} value={form.sku} onChange={set(\"sku\")} />\n      </Field>\n      <Field label=\"Location\" htmlFor=\"location\" error={fields.location}>\n        <input id=\"location\" className={inputCls} value={form.location} onChange={set(\"location\")} />\n      </Field>\n      {!editing && (\n        <Field label=\"Opening quantity\" htmlFor=\"quantity\" error={fields.quantity}>\n          <input\n            id=\"quantity\"\n            inputMode=\"numeric\"\n            className={inputCls}\n            value={form.quantity}\n            onChange={set(\"quantity\")}\n          />\n        </Field>\n      )}\n      <Field label=\"Reorder level\" htmlFor=\"reorder_level\" error={fields.reorder_level}>\n        <input\n          id=\"reorder_level\"\n          inputMode=\"numeric\"\n          className={inputCls}\n          value={form.reorder_level}\n          onChange={set(\"reorder_level\")}\n        />\n      </Field>\n      <div className=\"flex gap-2\">\n        <button type=\"submit\" className={btnCls} disabled={busy || !loaded}>\n          {editing ? \"Save changes\" : \"Add item\"}\n        </button>\n        <Link to={editing ? `/items/${id}` : \"/\"} className={btnSecondaryCls}>\n          Cancel\n        </Link>\n      </div>\n    </form>\n  );\n}\nEOF\ncat > src/pages/ItemPage.tsx <<'EOF'\nimport { useCallback, useEffect, useState, type FormEvent } from \"react\";\nimport { Link, useNavigate, useParams } from \"react-router-dom\";\nimport { api, ApiError, type Item, type Movement } from \"../api\";\nimport { useAuth } from \"../auth\";\nimport {\n  btnCls,\n  btnDangerCls,\n  btnSecondaryCls,\n  ErrorBanner,\n  Field,\n  inputCls,\n  LowStockBadge,\n} from \"../ui\";\n\nfunction MovementForm({\n  kind,\n  itemId,\n  onDone,\n}: {\n  kind: \"receive\" | \"take\";\n  itemId: number;\n  onDone: () => void;\n}) {\n  const label = kind === \"receive\" ? \"Receive\" : \"Take out\";\n  const [amount, setAmount] = useState(\"\");\n  const [reason, setReason] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const id = `${kind}-amount`;\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(\"\");\n    if (!/^\\d+$/.test(amount.trim()) || Number(amount) < 1) {\n      setError(\"Enter a whole number greater than 0\");\n      return;\n    }\n    const n = Number(amount);\n    setBusy(true);\n    try {\n      await api.addMovement(itemId, kind === \"receive\" ? n : -n, reason);\n      setAmount(\"\");\n      setReason(\"\");\n      onDone();\n    } catch (err) {\n      setError(\n        err instanceof ApiError ? err.fields.delta || err.fields.reason || err.message : \"Something went wrong\",\n      );\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <form\n      onSubmit={submit}\n      aria-label={label}\n      className=\"space-y-3 rounded bg-white p-4 shadow-sm\"\n    >\n      <h2 className=\"font-semibold\">{label}</h2>\n      <Field label=\"Quantity\" htmlFor={id} error={error}>\n        <input\n          id={id}\n          inputMode=\"numeric\"\n          className={inputCls}\n          value={amount}\n          onChange={(e) => setAmount(e.target.value)}\n        />\n      </Field>\n      <Field label=\"Reason\" htmlFor={`${kind}-reason`}>\n        <input\n          id={`${kind}-reason`}\n          className={inputCls}\n          value={reason}\n          onChange={(e) => setReason(e.target.value)}\n        />\n      </Field>\n      <button type=\"submit\" className={kind === \"receive\" ? btnCls : btnSecondaryCls} disabled={busy}>\n        {label}\n      </button>\n    </form>\n  );\n}\n\nexport default function ItemPage() {\n  const { id } = useParams();\n  const { username } = useAuth();\n  const navigate = useNavigate();\n  const [item, setItem] = useState<Item | null>(null);\n  const [moves, setMoves] = useState<Movement[]>([]);\n  const [error, setError] = useState(\"\");\n  const [confirming, setConfirming] = useState(false);\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(async () => {\n    try {\n      const [it, mv] = await Promise.all([api.getItem(id!), api.movements(id!)]);\n      setItem(it);\n      setMoves(mv.items);\n      setError(\"\");\n    } catch (e) {\n      setError(e instanceof Error ? e.message : \"Something went wrong\");\n    }\n  }, [id]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  async function remove() {\n    if (!item) return;\n    setBusy(true);\n    try {\n      await api.deleteItem(item.id);\n      navigate(\"/\");\n    } catch (e) {\n      setError(e instanceof Error ? e.message : \"Something went wrong\");\n      setConfirming(false);\n      setBusy(false);\n    }\n  }\n\n  if (!item) {\n    return error ? (\n      <div className=\"space-y-3\">\n        <ErrorBanner message={error} />\n        <Link to=\"/\" className=\"text-indigo-700 hover:underline\">\n          Back to inventory\n        </Link>\n      </div>\n    ) : (\n      <p>Loading...</p>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <Link to=\"/\" className=\"text-sm text-indigo-700 hover:underline\">\n        &larr; Back to inventory\n      </Link>\n      <ErrorBanner message={error} />\n      <div className=\"flex flex-wrap items-start justify-between gap-4 rounded bg-white p-4 shadow-sm\">\n        <div>\n          <h1 className=\"text-2xl font-semibold\">\n            {item.name} {item.low_stock && <LowStockBadge />}\n          </h1>\n          <dl className=\"mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm\">\n            <dt className=\"text-slate-500\">SKU</dt>\n            <dd>{item.sku}</dd>\n            <dt className=\"text-slate-500\">Location</dt>\n            <dd>{item.location || \"-\"}</dd>\n            <dt className=\"text-slate-500\">Quantity</dt>\n            <dd data-testid=\"quantity\" className=\"font-semibold\">\n              {item.quantity}\n            </dd>\n            <dt className=\"text-slate-500\">Reorder level</dt>\n            <dd>{item.reorder_level}</dd>\n          </dl>\n        </div>\n        {username && (\n          <div className=\"flex items-center gap-2\">\n            {confirming ? (\n              <>\n                <span className=\"text-sm\">Delete this item and its history?</span>\n                <button type=\"button\" className={btnDangerCls} onClick={remove} disabled={busy}>\n                  Confirm delete\n                </button>\n                <button type=\"button\" className={btnSecondaryCls} onClick={() => setConfirming(false)}>\n                  Cancel\n                </button>\n              </>\n            ) : (\n              <>\n                <Link to={`/items/${item.id}/edit`} className={btnSecondaryCls}>\n                  Edit\n                </Link>\n                <button type=\"button\" className={btnDangerCls} onClick={() => setConfirming(true)}>\n                  Delete\n                </button>\n              </>\n            )}\n          </div>\n        )}\n      </div>\n\n      {username ? (\n        <div className=\"grid gap-4 sm:grid-cols-2\">\n          <MovementForm kind=\"receive\" itemId={item.id} onDone={load} />\n          <MovementForm kind=\"take\" itemId={item.id} onDone={load} />\n        </div>\n      ) : (\n        <p className=\"text-sm text-slate-600\">\n          <Link to=\"/login\" className=\"text-indigo-700 hover:underline\">\n            Sign in\n          </Link>{\" \"}\n          to receive or take out stock.\n        </p>\n      )}\n\n      <section>\n        <h2 className=\"mb-2 text-lg font-semibold\">Movement history</h2>\n        <div className=\"overflow-x-auto rounded bg-white shadow-sm\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"border-b border-slate-200 bg-slate-100 text-xs uppercase text-slate-600\">\n              <tr>\n                <th className=\"px-4 py-2\">When</th>\n                <th className=\"px-4 py-2 text-right\">Change</th>\n                <th className=\"px-4 py-2 text-right\">Quantity after</th>\n                <th className=\"px-4 py-2\">Reason</th>\n                <th className=\"px-4 py-2\">User</th>\n              </tr>\n            </thead>\n            <tbody>\n              {moves.map((m) => (\n                <tr key={m.id} className=\"border-b border-slate-100\">\n                  <td className=\"px-4 py-2\">{new Date(m.created_at).toLocaleString()}</td>\n                  <td\n                    className={\n                      \"px-4 py-2 text-right tabular-nums \" +\n                      (m.delta > 0 ? \"text-green-700\" : \"text-red-700\")\n                    }\n                  >\n                    {m.delta > 0 ? `+${m.delta}` : m.delta}\n                  </td>\n                  <td className=\"px-4 py-2 text-right tabular-nums\">{m.quantity_after}</td>\n                  <td className=\"px-4 py-2\">{m.reason}</td>\n                  <td className=\"px-4 py-2\">{m.username ?? \"-\"}</td>\n                </tr>\n              ))}\n              {moves.length === 0 && (\n                <tr>\n                  <td colSpan={5} className=\"px-4 py-6 text-center text-slate-500\">\n                    No movements yet.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </section>\n    </div>\n  );\n}\nEOF\nnpm run build 2>&1 | tail -20","time":{"start":1794254645420,"end":1794254647130}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1e9289e001DP8HdRvpxJOIzv","sessionID":"ses_e3e1ac285ffe1RfNJ2BpEWGcBY","messageID":"msg_1c1e83603001qzl62gd7pR4U19"}}
