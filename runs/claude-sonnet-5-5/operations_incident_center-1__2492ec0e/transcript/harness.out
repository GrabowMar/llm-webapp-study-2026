{"type":"tool_use","timestamp":1794250187731,"sessionID":"ses_e3e5df250ffe14cmjvCAJXq0o1","part":{"type":"tool","tool":"bash","callID":"toolu_01TB2Yqh8yniv7N4xuAyWwr8","state":{"status":"completed","input":{"command":"cd /workspace/frontend/src && cat > api.ts <<'EOF'\nexport const SEVERITIES = [\"sev1\", \"sev2\", \"sev3\", \"sev4\"] as const;\nexport const STATUSES = [\"investigating\", \"identified\", \"monitoring\", \"resolved\"] as const;\nexport type Severity = (typeof SEVERITIES)[number];\nexport type Status = (typeof STATUSES)[number];\n\nexport interface Incident {\n  id: number;\n  title: string;\n  service: string;\n  severity: Severity;\n  status: Status;\n  commander: string | null;\n  impact_summary: string | null;\n  opened_at: string;\n  resolved_at: string | null;\n  reopen_count: number;\n  opened_by: string;\n  sla_due_at: string;\n  sla_breached: boolean;\n}\n\nexport interface TimelineEvent {\n  id: number;\n  type: string;\n  message: string;\n  created_at: string;\n  author: string;\n}\n\nexport interface IncidentPage {\n  items: Incident[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface PublicStats {\n  open_total: number;\n  open_by_severity: Record<Severity, number>;\n  sla_breached_open: number;\n  resolved_last_30_days: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"incident-center-token\";\nconst USER_KEY = \"incident-center-user\";\nconst listeners = new Set<() => void>();\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUser(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setSession(token: string | null, user: string | null) {\n  if (token && user) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, user);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  }\n  listeners.forEach((l) => l());\n}\n\nexport function subscribeSession(listener: () => void) {\n  listeners.add(listener);\n  return () => {\n    listeners.delete(listener);\n  };\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error, please try again\");\n  }\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const d = (data ?? {}) as { error?: string; fields?: Record<string, string> };\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) setSession(null, null);\n    throw new ApiError(res.status, d.error ?? `Request failed (${res.status})`, d.fields ?? {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"POST\", \"/auth/login\", { username, password }),\n  stats: () => request<PublicStats>(\"GET\", \"/public/stats\"),\n  incidents: (params: URLSearchParams) =>\n    request<IncidentPage>(\"GET\", `/incidents?${params.toString()}`),\n  incident: (id: number) => request<Incident>(\"GET\", `/incidents/${id}`),\n  createIncident: (body: Record<string, unknown>) =>\n    request<Incident>(\"POST\", \"/incidents\", body),\n  updateIncident: (id: number, body: Record<string, unknown>) =>\n    request<Incident>(\"PATCH\", `/incidents/${id}`, body),\n  timeline: (id: number) =>\n    request<{ items: TimelineEvent[] }>(\"GET\", `/incidents/${id}/timeline`),\n  postEvent: (id: number, message: string) =>\n    request<TimelineEvent>(\"POST\", `/incidents/${id}/timeline`, { message }),\n};\nEOF\ncat > router.tsx <<'EOF'\nimport { useEffect, useState, type MouseEvent, type ReactNode } from \"react\";\n\nexport function navigate(to: string, replace = false) {\n  if (replace) window.history.replaceState(null, \"\", to);\n  else window.history.pushState(null, \"\", to);\n  window.dispatchEvent(new PopStateEvent(\"popstate\"));\n}\n\nexport function usePath(): string {\n  const [path, setPath] = useState(window.location.pathname);\n  useEffect(() => {\n    const onChange = () => setPath(window.location.pathname);\n    window.addEventListener(\"popstate\", onChange);\n    return () => window.removeEventListener(\"popstate\", onChange);\n  }, []);\n  return path;\n}\n\nexport function Link({\n  to,\n  className,\n  children,\n}: {\n  to: string;\n  className?: string;\n  children: ReactNode;\n}) {\n  const onClick = (e: MouseEvent<HTMLAnchorElement>) => {\n    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;\n    e.preventDefault();\n    navigate(to);\n  };\n  return (\n    <a href={to} onClick={onClick} className={className}>\n      {children}\n    </a>\n  );\n}\nEOF\ncat > ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\nimport type { Severity, Status } from \"./api\";\n\nexport const inputCls =\n  \"w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\";\n\nconst SEV_COLORS: Record<Severity, string> = {\n  sev1: \"bg-red-100 text-red-800 ring-red-600/20\",\n  sev2: \"bg-orange-100 text-orange-800 ring-orange-600/20\",\n  sev3: \"bg-amber-100 text-amber-800 ring-amber-600/20\",\n  sev4: \"bg-sky-100 text-sky-800 ring-sky-600/20\",\n};\n\nconst STATUS_COLORS: Record<Status, string> = {\n  investigating: \"bg-rose-50 text-rose-700 ring-rose-600/20\",\n  identified: \"bg-violet-50 text-violet-700 ring-violet-600/20\",\n  monitoring: \"bg-blue-50 text-blue-700 ring-blue-600/20\",\n  resolved: \"bg-emerald-50 text-emerald-700 ring-emerald-600/20\",\n};\n\nconst badge = \"inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset\";\n\nexport function SeverityBadge({ severity }: { severity: Severity }) {\n  return <span className={`${badge} ${SEV_COLORS[severity]}`}>{severity.toUpperCase()}</span>;\n}\n\nexport function StatusBadge({ status }: { status: Status }) {\n  return <span className={`${badge} ${STATUS_COLORS[status]}`}>{status}</span>;\n}\n\nexport function BreachedFlag() {\n  return (\n    <span className={`${badge} bg-red-600 text-white ring-red-700`} title=\"Past resolution target\">\n      SLA breached\n    </span>\n  );\n}\n\nexport function ErrorBox({ children }: { children: ReactNode }) {\n  return (\n    <div role=\"alert\" className=\"rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {children}\n    </div>\n  );\n}\n\nexport function Field({\n  label,\n  error,\n  children,\n}: {\n  label: string;\n  error?: string;\n  children: ReactNode;\n}) {\n  return (\n    <label className=\"block space-y-1\">\n      <span className=\"text-sm font-medium text-slate-700\">{label}</span>\n      {children}\n      {error && <span className=\"block text-sm text-red-600\">{error}</span>}\n    </label>\n  );\n}\n\nexport function formatTime(iso: string | null): string {\n  if (!iso) return \"-\";\n  const d = new Date(iso);\n  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString();\n}\nEOF\ncat > AuthPages.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, ApiError, setSession } from \"./api\";\nimport { navigate } from \"./router\";\nimport { btnCls, ErrorBox, Field, inputCls } from \"./ui\";\n\nexport function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n  const isLogin = mode === \"login\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFields({});\n    try {\n      if (!isLogin) await api.register(username, password);\n      const { token } = await api.login(username, password);\n      setSession(token, username.trim());\n      navigate(\"/incidents\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else {\n        setError(\"Unexpected error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-sm\">\n      <h1 className=\"mb-4 text-2xl font-semibold\">{isLogin ? \"Sign in\" : \"Create account\"}</h1>\n      <form onSubmit={submit} className=\"space-y-4 rounded-lg bg-white p-5 shadow\">\n        {error && <ErrorBox>{error}</ErrorBox>}\n        <Field label=\"Username\" error={fields.username}>\n          <input\n            className={inputCls}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n        </Field>\n        <Field label=\"Password\" error={fields.password}>\n          <input\n            className={inputCls}\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n            required\n          />\n        </Field>\n        <button className={`${btnCls} w-full`} disabled={busy}>\n          {isLogin ? \"Sign in\" : \"Register\"}\n        </button>\n      </form>\n    </div>\n  );\n}\nEOF\ncat > PublicPage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, SEVERITIES, type PublicStats } from \"./api\";\nimport { ErrorBox } from \"./ui\";\n\nfunction Stat({ label, value, tone = \"\" }: { label: string; value: number; tone?: string }) {\n  return (\n    <div className=\"rounded-lg bg-white p-4 shadow\">\n      <div className=\"text-sm text-slate-500\">{label}</div>\n      <div className={`mt-1 text-3xl font-semibold ${tone}`}>{value}</div>\n    </div>\n  );\n}\n\nexport function PublicPage() {\n  const [stats, setStats] = useState<PublicStats | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    let alive = true;\n    api\n      .stats()\n      .then((s) => alive && setStats(s))\n      .catch((e: Error) => alive && setError(e.message));\n    return () => {\n      alive = false;\n    };\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <h1 className=\"text-2xl font-semibold\">Service status</h1>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {!stats && !error && <p className=\"text-slate-500\">Loading...</p>}\n      {stats && (\n        <>\n          <div className=\"grid grid-cols-2 gap-4 md:grid-cols-4\">\n            <Stat label=\"Open incidents\" value={stats.open_total} />\n            <Stat\n              label=\"Past resolution target\"\n              value={stats.sla_breached_open}\n              tone={stats.sla_breached_open > 0 ? \"text-red-600\" : \"\"}\n            />\n            <Stat label=\"Resolved in last 30 days\" value={stats.resolved_last_30_days} />\n          </div>\n          <div>\n            <h2 className=\"mb-2 text-lg font-medium\">Open by severity</h2>\n            <div className=\"grid grid-cols-2 gap-4 md:grid-cols-4\">\n              {SEVERITIES.map((s) => (\n                <Stat key={s} label={s.toUpperCase()} value={stats.open_by_severity[s]} />\n              ))}\n            </div>\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > IncidentList.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, SEVERITIES, STATUSES, type IncidentPage } from \"./api\";\nimport { Link } from \"./router\";\nimport {\n  BreachedFlag,\n  btnCls,\n  btnSecondaryCls,\n  ErrorBox,\n  formatTime,\n  inputCls,\n  SeverityBadge,\n  StatusBadge,\n} from \"./ui\";\n\nexport function IncidentList() {\n  const [severity, setSeverity] = useState(\"\");\n  const [status, setStatus] = useState(\"\");\n  const [openOnly, setOpenOnly] = useState(false);\n  const [search, setSearch] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<IncidentPage | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const pageSize = 20;\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(search.trim());\n      setPage(1);\n    }, 300);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  useEffect(() => {\n    let alive = true;\n    const params = new URLSearchParams({ page: String(page), page_size: String(pageSize) });\n    if (severity) params.set(\"severity\", severity);\n    if (status) params.set(\"status\", status);\n    if (openOnly) params.set(\"open\", \"true\");\n    if (q) params.set(\"q\", q);\n    api\n      .incidents(params)\n      .then((d) => {\n        if (!alive) return;\n        setData(d);\n        setError(null);\n      })\n      .catch((e: Error) => alive && setError(e.message));\n    return () => {\n      alive = false;\n    };\n  }, [severity, status, openOnly, q, page]);\n\n  const lastPage = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h1 className=\"text-2xl font-semibold\">Incidents</h1>\n        <Link to=\"/incidents/new\" className={btnCls}>\n          Open incident\n        </Link>\n      </div>\n      <div className=\"flex flex-wrap items-center gap-3 rounded-lg bg-white p-3 shadow\">\n        <input\n          className={`${inputCls} max-w-xs`}\n          placeholder=\"Search...\"\n          aria-label=\"Search\"\n          value={search}\n          onChange={(e) => setSearch(e.target.value)}\n        />\n        <select\n          className={`${inputCls} w-auto`}\n          aria-label=\"Severity\"\n          value={severity}\n          onChange={(e) => {\n            setSeverity(e.target.value);\n            setPage(1);\n          }}\n        >\n          <option value=\"\">All severities</option>\n          {SEVERITIES.map((s) => (\n            <option key={s} value={s}>\n              {s.toUpperCase()}\n            </option>\n          ))}\n        </select>\n        <select\n          className={`${inputCls} w-auto`}\n          aria-label=\"Status\"\n          value={status}\n          onChange={(e) => {\n            setStatus(e.target.value);\n            setPage(1);\n          }}\n        >\n          <option value=\"\">All statuses</option>\n          {STATUSES.map((s) => (\n            <option key={s} value={s}>\n              {s}\n            </option>\n          ))}\n        </select>\n        <label className=\"flex items-center gap-2 text-sm\">\n          <input\n            type=\"checkbox\"\n            role=\"switch\"\n            checked={openOnly}\n            onChange={(e) => {\n              setOpenOnly(e.target.checked);\n              setPage(1);\n            }}\n          />\n          Open only\n        </label>\n      </div>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {!data && !error && <p className=\"text-slate-500\">Loading...</p>}\n      {data && (\n        <>\n          <div className=\"overflow-x-auto rounded-lg bg-white shadow\">\n            <table className=\"min-w-full divide-y divide-slate-200 text-sm\">\n              <thead className=\"bg-slate-50 text-left text-slate-500\">\n                <tr>\n                  <th className=\"px-3 py-2\">Incident</th>\n                  <th className=\"px-3 py-2\">Service</th>\n                  <th className=\"px-3 py-2\">Severity</th>\n                  <th className=\"px-3 py-2\">Status</th>\n                  <th className=\"px-3 py-2\">Opened</th>\n                  <th className=\"px-3 py-2\">Target</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {data.items.map((i) => (\n                  <tr key={i.id} className={i.sla_breached ? \"bg-red-50\" : \"\"}>\n                    <td className=\"px-3 py-2\">\n                      <Link to={`/incidents/${i.id}`} className=\"font-medium text-indigo-600 hover:underline\">\n                        #{i.id} {i.title}\n                      </Link>\n                    </td>\n                    <td className=\"px-3 py-2\">{i.service}</td>\n                    <td className=\"px-3 py-2\">\n                      <SeverityBadge severity={i.severity} />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <StatusBadge status={i.status} />\n                    </td>\n                    <td className=\"px-3 py-2 whitespace-nowrap\">{formatTime(i.opened_at)}</td>\n                    <td className=\"px-3 py-2 whitespace-nowrap\">\n                      {formatTime(i.sla_due_at)} {i.sla_breached && <BreachedFlag />}\n                    </td>\n                  </tr>\n                ))}\n                {data.items.length === 0 && (\n                  <tr>\n                    <td colSpan={6} className=\"px-3 py-6 text-center text-slate-500\">\n                      No incidents found.\n                    </td>\n                  </tr>\n                )}\n              </tbody>\n            </table>\n          </div>\n          <div className=\"flex items-center justify-between text-sm text-slate-600\">\n            <span>\n              {data.total} incident{data.total === 1 ? \"\" : \"s\"} - page {data.page} of {lastPage}\n            </span>\n            <div className=\"flex gap-2\">\n              <button className={btnSecondaryCls} disabled={page <= 1} onClick={() => setPage(page - 1)}>\n                Previous\n              </button>\n              <button className={btnSecondaryCls} disabled={page >= lastPage} onClick={() => setPage(page + 1)}>\n                Next\n              </button>\n            </div>\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > NewIncident.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, ApiError, SEVERITIES } from \"./api\";\nimport { navigate } from \"./router\";\nimport { btnCls, ErrorBox, Field, inputCls } from \"./ui\";\n\nexport function NewIncident() {\n  const [form, setForm] = useState({\n    title: \"\",\n    service: \"\",\n    severity: \"sev3\",\n    commander: \"\",\n    impact_summary: \"\",\n  });\n  const [error, setError] = useState<string | null>(null);\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  const set = (k: keyof typeof form) => (e: { target: { value: string } }) =>\n    setForm({ ...form, [k]: e.target.value });\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFields({});\n    try {\n      const created = await api.createIncident(form);\n      navigate(`/incidents/${created.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else {\n        setError(\"Unexpected error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-xl\">\n      <h1 className=\"mb-4 text-2xl font-semibold\">Open incident</h1>\n      <form onSubmit={submit} className=\"space-y-4 rounded-lg bg-white p-5 shadow\">\n        {error && <ErrorBox>{error}</ErrorBox>}\n        <Field label=\"Title\" error={fields.title}>\n          <input className={inputCls} value={form.title} onChange={set(\"title\")} />\n        </Field>\n        <Field label=\"Service\" error={fields.service}>\n          <input className={inputCls} value={form.service} onChange={set(\"service\")} />\n        </Field>\n        <Field label=\"Severity\" error={fields.severity}>\n          <select className={inputCls} value={form.severity} onChange={set(\"severity\")}>\n            {SEVERITIES.map((s) => (\n              <option key={s} value={s}>\n                {s.toUpperCase()}\n              </option>\n            ))}\n          </select>\n        </Field>\n        <Field label=\"Commander\" error={fields.commander}>\n          <input className={inputCls} value={form.commander} onChange={set(\"commander\")} />\n        </Field>\n        <Field label=\"Impact summary\" error={fields.impact_summary}>\n          <textarea\n            className={inputCls}\n            rows={3}\n            value={form.impact_summary}\n            onChange={set(\"impact_summary\")}\n          />\n        </Field>\n        <button className={btnCls} disabled={busy}>\n          Open incident\n        </button>\n      </form>\n    </div>\n  );\n}\nEOF\ncat > IncidentPage.tsx <<'EOF'\nimport { useCallback, useEffect, useState, type FormEvent } from \"react\";\nimport { api, ApiError, STATUSES, type Incident, type Status, type TimelineEvent } from \"./api\";\nimport {\n  BreachedFlag,\n  btnCls,\n  btnSecondaryCls,\n  ErrorBox,\n  formatTime,\n  inputCls,\n  SeverityBadge,\n  StatusBadge,\n} from \"./ui\";\n\nfunction Item({ label, children }: { label: string; children: React.ReactNode }) {\n  return (\n    <div>\n      <dt className=\"text-xs uppercase tracking-wide text-slate-500\">{label}</dt>\n      <dd className=\"mt-0.5 text-sm\">{children}</dd>\n    </div>\n  );\n}\n\nexport function IncidentPage({ id }: { id: number }) {\n  const [incident, setIncident] = useState<Incident | null>(null);\n  const [events, setEvents] = useState<TimelineEvent[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [actionError, setActionError] = useState<string | null>(null);\n  const [message, setMessage] = useState(\"\");\n  const [msgError, setMsgError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(async () => {\n    try {\n      const [i, t] = await Promise.all([api.incident(id), api.timeline(id)]);\n      setIncident(i);\n      setEvents(t.items);\n      setError(null);\n    } catch (e) {\n      setError((e as Error).message);\n    }\n  }, [id]);\n\n  useEffect(() => {\n    setIncident(null);\n    setEvents([]);\n    load();\n  }, [load]);\n\n  async function changeStatus(status: Status) {\n    setBusy(true);\n    setActionError(null);\n    try {\n      await api.updateIncident(id, { status });\n      await load();\n    } catch (e) {\n      setActionError((e as Error).message);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function post(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setMsgError(null);\n    try {\n      await api.postEvent(id, message);\n      setMessage(\"\");\n      await load();\n    } catch (err) {\n      setMsgError(err instanceof ApiError ? (err.fields.message ?? err.message) : \"Unexpected error\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  if (error) return <ErrorBox>{error}</ErrorBox>;\n  if (!incident) return <p className=\"text-slate-500\">Loading...</p>;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <h1 className=\"text-2xl font-semibold\">\n          #{incident.id} {incident.title}\n        </h1>\n        <SeverityBadge severity={incident.severity} />\n        <StatusBadge status={incident.status} />\n        {incident.sla_breached && <BreachedFlag />}\n      </div>\n\n      <section className=\"rounded-lg bg-white p-5 shadow\">\n        <dl className=\"grid grid-cols-2 gap-4 md:grid-cols-3\">\n          <Item label=\"Service\">{incident.service}</Item>\n          <Item label=\"Commander\">{incident.commander ?? \"-\"}</Item>\n          <Item label=\"Opened by\">{incident.opened_by}</Item>\n          <Item label=\"Opened at\">{formatTime(incident.opened_at)}</Item>\n          <Item label=\"Resolution target\">{formatTime(incident.sla_due_at)}</Item>\n          <Item label=\"Resolved at\">{formatTime(incident.resolved_at)}</Item>\n          <Item label=\"Reopened\">{incident.reopen_count} times</Item>\n          <div className=\"col-span-2 md:col-span-3\">\n            <Item label=\"Impact summary\">{incident.impact_summary ?? \"-\"}</Item>\n          </div>\n        </dl>\n      </section>\n\n      <section className=\"space-y-2\">\n        <h2 className=\"text-lg font-medium\">Status</h2>\n        {actionError && <ErrorBox>{actionError}</ErrorBox>}\n        <div className=\"flex flex-wrap gap-2\">\n          {STATUSES.map((s) => (\n            <button\n              key={s}\n              className={s === incident.status ? btnCls : btnSecondaryCls}\n              disabled={busy || s === incident.status}\n              onClick={() => changeStatus(s)}\n            >\n              {s}\n            </button>\n          ))}\n        </div>\n      </section>\n\n      <section className=\"space-y-3\">\n        <h2 className=\"text-lg font-medium\">Timeline</h2>\n        <ol className=\"space-y-2\">\n          {events.map((ev) => (\n            <li key={ev.id} className=\"rounded-lg bg-white p-3 shadow\">\n              <div className=\"flex flex-wrap items-center gap-2 text-xs text-slate-500\">\n                <span className=\"rounded bg-slate-100 px-1.5 py-0.5 font-medium\">{ev.type}</span>\n                <span>{ev.author}</span>\n                <span>{formatTime(ev.created_at)}</span>\n              </div>\n              <p className=\"mt-1 whitespace-pre-wrap text-sm\">{ev.message}</p>\n            </li>\n          ))}\n          {events.length === 0 && <li className=\"text-sm text-slate-500\">No events yet.</li>}\n        </ol>\n        <form onSubmit={post} className=\"space-y-2 rounded-lg bg-white p-4 shadow\">\n          {msgError && <ErrorBox>{msgError}</ErrorBox>}\n          <textarea\n            className={inputCls}\n            rows={3}\n            placeholder=\"Post an update...\"\n            aria-label=\"Event message\"\n            value={message}\n            onChange={(e) => setMessage(e.target.value)}\n          />\n          <button className={btnCls} disabled={busy}>\n            Post event\n          </button>\n        </form>\n      </section>\n    </div>\n  );\n}\nEOF\ncat > App.tsx <<'EOF'\nimport { useEffect, useSyncExternalStore } from \"react\";\nimport { getToken, getUser, setSession, subscribeSession } from \"./api\";\nimport { AuthPage } from \"./AuthPages\";\nimport { IncidentList } from \"./IncidentList\";\nimport { IncidentPage } from \"./IncidentPage\";\nimport { NewIncident } from \"./NewIncident\";\nimport { PublicPage } from \"./PublicPage\";\nimport { Link, navigate, usePath } from \"./router\";\nimport { btnSecondaryCls } from \"./ui\";\n\nfunction useSession() {\n  const token = useSyncExternalStore(subscribeSession, getToken);\n  const user = useSyncExternalStore(subscribeSession, getUser);\n  return { token, user };\n}\n\nconst navLink = \"text-sm font-medium text-slate-600 hover:text-slate-900\";\n\nexport default function App() {\n  const path = usePath();\n  const { token, user } = useSession();\n\n  const isProtected = path.startsWith(\"/incidents\");\n  const isAuthPage = path === \"/login\" || path === \"/register\";\n\n  useEffect(() => {\n    if (isProtected && !token) navigate(\"/login\", true);\n    else if (isAuthPage && token) navigate(\"/incidents\", true);\n  }, [isProtected, isAuthPage, token]);\n\n  let page;\n  const match = path.match(/^\\/incidents\\/(\\d+)\\/?$/);\n  if (isProtected && !token) page = null;\n  else if (path === \"/login\") page = <AuthPage mode=\"login\" />;\n  else if (path === \"/register\") page = <AuthPage mode=\"register\" />;\n  else if (path.replace(/\\/$/, \"\") === \"/incidents\") page = <IncidentList />;\n  else if (path.replace(/\\/$/, \"\") === \"/incidents/new\") page = <NewIncident />;\n  else if (match) page = <IncidentPage key={match[1]} id={Number(match[1])} />;\n  else if (path === \"/\") page = <PublicPage />;\n  else page = <p className=\"text-slate-600\">Page not found.</p>;\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <nav className=\"mx-auto flex max-w-5xl items-center gap-5 px-4 py-3\">\n          <Link to=\"/\" className=\"text-lg font-semibold text-indigo-700\">\n            Incident center\n          </Link>\n          <Link to=\"/\" className={navLink}>\n            Status\n          </Link>\n          {token && (\n            <Link to=\"/incidents\" className={navLink}>\n              Incidents\n            </Link>\n          )}\n          <div className=\"ml-auto flex items-center gap-3\">\n            {token ? (\n              <>\n                <span className=\"text-sm text-slate-600\">\n                  Signed in as <strong data-testid=\"username\">{user}</strong>\n                </span>\n                <button\n                  className={btnSecondaryCls}\n                  onClick={() => {\n                    setSession(null, null);\n                    navigate(\"/\");\n                  }}\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/login\" className={navLink}>\n                  Sign in\n                </Link>\n                <Link to=\"/register\" className={navLink}>\n                  Register\n                </Link>\n              </>\n            )}\n          </div>\n        </nav>\n      </header>\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">{page}</main>\n    </div>\n  );\n}\nEOF\ncd .. && npm run build 2>&1 | tail -20","workdir":"/workspace/frontend"},"output":"\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 24 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.27 kB\ndist/assets/index-BbA19Egg.css   17.44 kB │ gzip:  4.18 kB\ndist/assets/index-CyZTd2g5.js   237.16 kB │ gzip: 73.20 kB\n\n✓ built in 382ms\n","metadata":{"output":"\n> build\n> tsc && vite build\n\nvite v8.3.5 building client environment for production...\ntransforming...\n✓ 24 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.39 kB │ gzip:  0.27 kB\ndist/assets/index-BbA19Egg.css   17.44 kB │ gzip:  4.18 kB\ndist/assets/index-CyZTd2g5.js   237.16 kB │ gzip: 73.20 kB\n\n✓ built in 382ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend/src && cat > api.ts <<'EOF'\nexport const SEVERITIES = [\"sev1\", \"sev2\", \"sev3\", \"sev4\"] as const;\nexport const STATUSES = [\"investigating\", \"identified\", \"monitoring\", \"resolved\"] as const;\nexport type Severity = (typeof SEVERITIES)[number];\nexport type Status = (typeof STATUSES)[number];\n\nexport interface Incident {\n  id: number;\n  title: string;\n  service: string;\n  severity: Severity;\n  status: Status;\n  commander: string | null;\n  impact_summary: string | null;\n  opened_at: string;\n  resolved_at: string | null;\n  reopen_count: number;\n  opened_by: string;\n  sla_due_at: string;\n  sla_breached: boolean;\n}\n\nexport interface TimelineEvent {\n  id: number;\n  type: string;\n  message: string;\n  created_at: string;\n  author: string;\n}\n\nexport interface IncidentPage {\n  items: Incident[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface PublicStats {\n  open_total: number;\n  open_by_severity: Record<Severity, number>;\n  sla_breached_open: number;\n  resolved_last_30_days: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  fields: Record<string, string>;\n  constructor(status: number, message: string, fields: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.fields = fields;\n  }\n}\n\nconst TOKEN_KEY = \"incident-center-token\";\nconst USER_KEY = \"incident-center-user\";\nconst listeners = new Set<() => void>();\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getUser(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function setSession(token: string | null, user: string | null) {\n  if (token && user) {\n    localStorage.setItem(TOKEN_KEY, token);\n    localStorage.setItem(USER_KEY, user);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USER_KEY);\n  }\n  listeners.forEach((l) => l());\n}\n\nexport function subscribeSession(listener: () => void) {\n  listeners.add(listener);\n  return () => {\n    listeners.delete(listener);\n  };\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error, please try again\");\n  }\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const d = (data ?? {}) as { error?: string; fields?: Record<string, string> };\n    if (res.status === 401 && token && !path.startsWith(\"/auth/\")) setSession(null, null);\n    throw new ApiError(res.status, d.error ?? `Request failed (${res.status})`, d.fields ?? {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string }>(\"POST\", \"/auth/login\", { username, password }),\n  stats: () => request<PublicStats>(\"GET\", \"/public/stats\"),\n  incidents: (params: URLSearchParams) =>\n    request<IncidentPage>(\"GET\", `/incidents?${params.toString()}`),\n  incident: (id: number) => request<Incident>(\"GET\", `/incidents/${id}`),\n  createIncident: (body: Record<string, unknown>) =>\n    request<Incident>(\"POST\", \"/incidents\", body),\n  updateIncident: (id: number, body: Record<string, unknown>) =>\n    request<Incident>(\"PATCH\", `/incidents/${id}`, body),\n  timeline: (id: number) =>\n    request<{ items: TimelineEvent[] }>(\"GET\", `/incidents/${id}/timeline`),\n  postEvent: (id: number, message: string) =>\n    request<TimelineEvent>(\"POST\", `/incidents/${id}/timeline`, { message }),\n};\nEOF\ncat > router.tsx <<'EOF'\nimport { useEffect, useState, type MouseEvent, type ReactNode } from \"react\";\n\nexport function navigate(to: string, replace = false) {\n  if (replace) window.history.replaceState(null, \"\", to);\n  else window.history.pushState(null, \"\", to);\n  window.dispatchEvent(new PopStateEvent(\"popstate\"));\n}\n\nexport function usePath(): string {\n  const [path, setPath] = useState(window.location.pathname);\n  useEffect(() => {\n    const onChange = () => setPath(window.location.pathname);\n    window.addEventListener(\"popstate\", onChange);\n    return () => window.removeEventListener(\"popstate\", onChange);\n  }, []);\n  return path;\n}\n\nexport function Link({\n  to,\n  className,\n  children,\n}: {\n  to: string;\n  className?: string;\n  children: ReactNode;\n}) {\n  const onClick = (e: MouseEvent<HTMLAnchorElement>) => {\n    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;\n    e.preventDefault();\n    navigate(to);\n  };\n  return (\n    <a href={to} onClick={onClick} className={className}>\n      {children}\n    </a>\n  );\n}\nEOF\ncat > ui.tsx <<'EOF'\nimport type { ReactNode } from \"react\";\nimport type { Severity, Status } from \"./api\";\n\nexport const inputCls =\n  \"w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\nexport const btnCls =\n  \"inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-50\";\nexport const btnSecondaryCls =\n  \"inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\";\n\nconst SEV_COLORS: Record<Severity, string> = {\n  sev1: \"bg-red-100 text-red-800 ring-red-600/20\",\n  sev2: \"bg-orange-100 text-orange-800 ring-orange-600/20\",\n  sev3: \"bg-amber-100 text-amber-800 ring-amber-600/20\",\n  sev4: \"bg-sky-100 text-sky-800 ring-sky-600/20\",\n};\n\nconst STATUS_COLORS: Record<Status, string> = {\n  investigating: \"bg-rose-50 text-rose-700 ring-rose-600/20\",\n  identified: \"bg-violet-50 text-violet-700 ring-violet-600/20\",\n  monitoring: \"bg-blue-50 text-blue-700 ring-blue-600/20\",\n  resolved: \"bg-emerald-50 text-emerald-700 ring-emerald-600/20\",\n};\n\nconst badge = \"inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset\";\n\nexport function SeverityBadge({ severity }: { severity: Severity }) {\n  return <span className={`${badge} ${SEV_COLORS[severity]}`}>{severity.toUpperCase()}</span>;\n}\n\nexport function StatusBadge({ status }: { status: Status }) {\n  return <span className={`${badge} ${STATUS_COLORS[status]}`}>{status}</span>;\n}\n\nexport function BreachedFlag() {\n  return (\n    <span className={`${badge} bg-red-600 text-white ring-red-700`} title=\"Past resolution target\">\n      SLA breached\n    </span>\n  );\n}\n\nexport function ErrorBox({ children }: { children: ReactNode }) {\n  return (\n    <div role=\"alert\" className=\"rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700\">\n      {children}\n    </div>\n  );\n}\n\nexport function Field({\n  label,\n  error,\n  children,\n}: {\n  label: string;\n  error?: string;\n  children: ReactNode;\n}) {\n  return (\n    <label className=\"block space-y-1\">\n      <span className=\"text-sm font-medium text-slate-700\">{label}</span>\n      {children}\n      {error && <span className=\"block text-sm text-red-600\">{error}</span>}\n    </label>\n  );\n}\n\nexport function formatTime(iso: string | null): string {\n  if (!iso) return \"-\";\n  const d = new Date(iso);\n  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString();\n}\nEOF\ncat > AuthPages.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, ApiError, setSession } from \"./api\";\nimport { navigate } from \"./router\";\nimport { btnCls, ErrorBox, Field, inputCls } from \"./ui\";\n\nexport function AuthPage({ mode }: { mode: \"login\" | \"register\" }) {\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n  const isLogin = mode === \"login\";\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFields({});\n    try {\n      if (!isLogin) await api.register(username, password);\n      const { token } = await api.login(username, password);\n      setSession(token, username.trim());\n      navigate(\"/incidents\");\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else {\n        setError(\"Unexpected error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-sm\">\n      <h1 className=\"mb-4 text-2xl font-semibold\">{isLogin ? \"Sign in\" : \"Create account\"}</h1>\n      <form onSubmit={submit} className=\"space-y-4 rounded-lg bg-white p-5 shadow\">\n        {error && <ErrorBox>{error}</ErrorBox>}\n        <Field label=\"Username\" error={fields.username}>\n          <input\n            className={inputCls}\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            autoComplete=\"username\"\n            required\n          />\n        </Field>\n        <Field label=\"Password\" error={fields.password}>\n          <input\n            className={inputCls}\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            autoComplete={isLogin ? \"current-password\" : \"new-password\"}\n            required\n          />\n        </Field>\n        <button className={`${btnCls} w-full`} disabled={busy}>\n          {isLogin ? \"Sign in\" : \"Register\"}\n        </button>\n      </form>\n    </div>\n  );\n}\nEOF\ncat > PublicPage.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, SEVERITIES, type PublicStats } from \"./api\";\nimport { ErrorBox } from \"./ui\";\n\nfunction Stat({ label, value, tone = \"\" }: { label: string; value: number; tone?: string }) {\n  return (\n    <div className=\"rounded-lg bg-white p-4 shadow\">\n      <div className=\"text-sm text-slate-500\">{label}</div>\n      <div className={`mt-1 text-3xl font-semibold ${tone}`}>{value}</div>\n    </div>\n  );\n}\n\nexport function PublicPage() {\n  const [stats, setStats] = useState<PublicStats | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    let alive = true;\n    api\n      .stats()\n      .then((s) => alive && setStats(s))\n      .catch((e: Error) => alive && setError(e.message));\n    return () => {\n      alive = false;\n    };\n  }, []);\n\n  return (\n    <div className=\"space-y-6\">\n      <h1 className=\"text-2xl font-semibold\">Service status</h1>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {!stats && !error && <p className=\"text-slate-500\">Loading...</p>}\n      {stats && (\n        <>\n          <div className=\"grid grid-cols-2 gap-4 md:grid-cols-4\">\n            <Stat label=\"Open incidents\" value={stats.open_total} />\n            <Stat\n              label=\"Past resolution target\"\n              value={stats.sla_breached_open}\n              tone={stats.sla_breached_open > 0 ? \"text-red-600\" : \"\"}\n            />\n            <Stat label=\"Resolved in last 30 days\" value={stats.resolved_last_30_days} />\n          </div>\n          <div>\n            <h2 className=\"mb-2 text-lg font-medium\">Open by severity</h2>\n            <div className=\"grid grid-cols-2 gap-4 md:grid-cols-4\">\n              {SEVERITIES.map((s) => (\n                <Stat key={s} label={s.toUpperCase()} value={stats.open_by_severity[s]} />\n              ))}\n            </div>\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > IncidentList.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, SEVERITIES, STATUSES, type IncidentPage } from \"./api\";\nimport { Link } from \"./router\";\nimport {\n  BreachedFlag,\n  btnCls,\n  btnSecondaryCls,\n  ErrorBox,\n  formatTime,\n  inputCls,\n  SeverityBadge,\n  StatusBadge,\n} from \"./ui\";\n\nexport function IncidentList() {\n  const [severity, setSeverity] = useState(\"\");\n  const [status, setStatus] = useState(\"\");\n  const [openOnly, setOpenOnly] = useState(false);\n  const [search, setSearch] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<IncidentPage | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const pageSize = 20;\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(search.trim());\n      setPage(1);\n    }, 300);\n    return () => clearTimeout(t);\n  }, [search]);\n\n  useEffect(() => {\n    let alive = true;\n    const params = new URLSearchParams({ page: String(page), page_size: String(pageSize) });\n    if (severity) params.set(\"severity\", severity);\n    if (status) params.set(\"status\", status);\n    if (openOnly) params.set(\"open\", \"true\");\n    if (q) params.set(\"q\", q);\n    api\n      .incidents(params)\n      .then((d) => {\n        if (!alive) return;\n        setData(d);\n        setError(null);\n      })\n      .catch((e: Error) => alive && setError(e.message));\n    return () => {\n      alive = false;\n    };\n  }, [severity, status, openOnly, q, page]);\n\n  const lastPage = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h1 className=\"text-2xl font-semibold\">Incidents</h1>\n        <Link to=\"/incidents/new\" className={btnCls}>\n          Open incident\n        </Link>\n      </div>\n      <div className=\"flex flex-wrap items-center gap-3 rounded-lg bg-white p-3 shadow\">\n        <input\n          className={`${inputCls} max-w-xs`}\n          placeholder=\"Search...\"\n          aria-label=\"Search\"\n          value={search}\n          onChange={(e) => setSearch(e.target.value)}\n        />\n        <select\n          className={`${inputCls} w-auto`}\n          aria-label=\"Severity\"\n          value={severity}\n          onChange={(e) => {\n            setSeverity(e.target.value);\n            setPage(1);\n          }}\n        >\n          <option value=\"\">All severities</option>\n          {SEVERITIES.map((s) => (\n            <option key={s} value={s}>\n              {s.toUpperCase()}\n            </option>\n          ))}\n        </select>\n        <select\n          className={`${inputCls} w-auto`}\n          aria-label=\"Status\"\n          value={status}\n          onChange={(e) => {\n            setStatus(e.target.value);\n            setPage(1);\n          }}\n        >\n          <option value=\"\">All statuses</option>\n          {STATUSES.map((s) => (\n            <option key={s} value={s}>\n              {s}\n            </option>\n          ))}\n        </select>\n        <label className=\"flex items-center gap-2 text-sm\">\n          <input\n            type=\"checkbox\"\n            role=\"switch\"\n            checked={openOnly}\n            onChange={(e) => {\n              setOpenOnly(e.target.checked);\n              setPage(1);\n            }}\n          />\n          Open only\n        </label>\n      </div>\n      {error && <ErrorBox>{error}</ErrorBox>}\n      {!data && !error && <p className=\"text-slate-500\">Loading...</p>}\n      {data && (\n        <>\n          <div className=\"overflow-x-auto rounded-lg bg-white shadow\">\n            <table className=\"min-w-full divide-y divide-slate-200 text-sm\">\n              <thead className=\"bg-slate-50 text-left text-slate-500\">\n                <tr>\n                  <th className=\"px-3 py-2\">Incident</th>\n                  <th className=\"px-3 py-2\">Service</th>\n                  <th className=\"px-3 py-2\">Severity</th>\n                  <th className=\"px-3 py-2\">Status</th>\n                  <th className=\"px-3 py-2\">Opened</th>\n                  <th className=\"px-3 py-2\">Target</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {data.items.map((i) => (\n                  <tr key={i.id} className={i.sla_breached ? \"bg-red-50\" : \"\"}>\n                    <td className=\"px-3 py-2\">\n                      <Link to={`/incidents/${i.id}`} className=\"font-medium text-indigo-600 hover:underline\">\n                        #{i.id} {i.title}\n                      </Link>\n                    </td>\n                    <td className=\"px-3 py-2\">{i.service}</td>\n                    <td className=\"px-3 py-2\">\n                      <SeverityBadge severity={i.severity} />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <StatusBadge status={i.status} />\n                    </td>\n                    <td className=\"px-3 py-2 whitespace-nowrap\">{formatTime(i.opened_at)}</td>\n                    <td className=\"px-3 py-2 whitespace-nowrap\">\n                      {formatTime(i.sla_due_at)} {i.sla_breached && <BreachedFlag />}\n                    </td>\n                  </tr>\n                ))}\n                {data.items.length === 0 && (\n                  <tr>\n                    <td colSpan={6} className=\"px-3 py-6 text-center text-slate-500\">\n                      No incidents found.\n                    </td>\n                  </tr>\n                )}\n              </tbody>\n            </table>\n          </div>\n          <div className=\"flex items-center justify-between text-sm text-slate-600\">\n            <span>\n              {data.total} incident{data.total === 1 ? \"\" : \"s\"} - page {data.page} of {lastPage}\n            </span>\n            <div className=\"flex gap-2\">\n              <button className={btnSecondaryCls} disabled={page <= 1} onClick={() => setPage(page - 1)}>\n                Previous\n              </button>\n              <button className={btnSecondaryCls} disabled={page >= lastPage} onClick={() => setPage(page + 1)}>\n                Next\n              </button>\n            </div>\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\nEOF\ncat > NewIncident.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, ApiError, SEVERITIES } from \"./api\";\nimport { navigate } from \"./router\";\nimport { btnCls, ErrorBox, Field, inputCls } from \"./ui\";\n\nexport function NewIncident() {\n  const [form, setForm] = useState({\n    title: \"\",\n    service: \"\",\n    severity: \"sev3\",\n    commander: \"\",\n    impact_summary: \"\",\n  });\n  const [error, setError] = useState<string | null>(null);\n  const [fields, setFields] = useState<Record<string, string>>({});\n  const [busy, setBusy] = useState(false);\n\n  const set = (k: keyof typeof form) => (e: { target: { value: string } }) =>\n    setForm({ ...form, [k]: e.target.value });\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setError(null);\n    setFields({});\n    try {\n      const created = await api.createIncident(form);\n      navigate(`/incidents/${created.id}`);\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        setFields(err.fields);\n      } else {\n        setError(\"Unexpected error\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  return (\n    <div className=\"mx-auto max-w-xl\">\n      <h1 className=\"mb-4 text-2xl font-semibold\">Open incident</h1>\n      <form onSubmit={submit} className=\"space-y-4 rounded-lg bg-white p-5 shadow\">\n        {error && <ErrorBox>{error}</ErrorBox>}\n        <Field label=\"Title\" error={fields.title}>\n          <input className={inputCls} value={form.title} onChange={set(\"title\")} />\n        </Field>\n        <Field label=\"Service\" error={fields.service}>\n          <input className={inputCls} value={form.service} onChange={set(\"service\")} />\n        </Field>\n        <Field label=\"Severity\" error={fields.severity}>\n          <select className={inputCls} value={form.severity} onChange={set(\"severity\")}>\n            {SEVERITIES.map((s) => (\n              <option key={s} value={s}>\n                {s.toUpperCase()}\n              </option>\n            ))}\n          </select>\n        </Field>\n        <Field label=\"Commander\" error={fields.commander}>\n          <input className={inputCls} value={form.commander} onChange={set(\"commander\")} />\n        </Field>\n        <Field label=\"Impact summary\" error={fields.impact_summary}>\n          <textarea\n            className={inputCls}\n            rows={3}\n            value={form.impact_summary}\n            onChange={set(\"impact_summary\")}\n          />\n        </Field>\n        <button className={btnCls} disabled={busy}>\n          Open incident\n        </button>\n      </form>\n    </div>\n  );\n}\nEOF\ncat > IncidentPage.tsx <<'EOF'\nimport { useCallback, useEffect, useState, type FormEvent } from \"react\";\nimport { api, ApiError, STATUSES, type Incident, type Status, type TimelineEvent } from \"./api\";\nimport {\n  BreachedFlag,\n  btnCls,\n  btnSecondaryCls,\n  ErrorBox,\n  formatTime,\n  inputCls,\n  SeverityBadge,\n  StatusBadge,\n} from \"./ui\";\n\nfunction Item({ label, children }: { label: string; children: React.ReactNode }) {\n  return (\n    <div>\n      <dt className=\"text-xs uppercase tracking-wide text-slate-500\">{label}</dt>\n      <dd className=\"mt-0.5 text-sm\">{children}</dd>\n    </div>\n  );\n}\n\nexport function IncidentPage({ id }: { id: number }) {\n  const [incident, setIncident] = useState<Incident | null>(null);\n  const [events, setEvents] = useState<TimelineEvent[]>([]);\n  const [error, setError] = useState<string | null>(null);\n  const [actionError, setActionError] = useState<string | null>(null);\n  const [message, setMessage] = useState(\"\");\n  const [msgError, setMsgError] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const load = useCallback(async () => {\n    try {\n      const [i, t] = await Promise.all([api.incident(id), api.timeline(id)]);\n      setIncident(i);\n      setEvents(t.items);\n      setError(null);\n    } catch (e) {\n      setError((e as Error).message);\n    }\n  }, [id]);\n\n  useEffect(() => {\n    setIncident(null);\n    setEvents([]);\n    load();\n  }, [load]);\n\n  async function changeStatus(status: Status) {\n    setBusy(true);\n    setActionError(null);\n    try {\n      await api.updateIncident(id, { status });\n      await load();\n    } catch (e) {\n      setActionError((e as Error).message);\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function post(e: FormEvent) {\n    e.preventDefault();\n    setBusy(true);\n    setMsgError(null);\n    try {\n      await api.postEvent(id, message);\n      setMessage(\"\");\n      await load();\n    } catch (err) {\n      setMsgError(err instanceof ApiError ? (err.fields.message ?? err.message) : \"Unexpected error\");\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  if (error) return <ErrorBox>{error}</ErrorBox>;\n  if (!incident) return <p className=\"text-slate-500\">Loading...</p>;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <h1 className=\"text-2xl font-semibold\">\n          #{incident.id} {incident.title}\n        </h1>\n        <SeverityBadge severity={incident.severity} />\n        <StatusBadge status={incident.status} />\n        {incident.sla_breached && <BreachedFlag />}\n      </div>\n\n      <section className=\"rounded-lg bg-white p-5 shadow\">\n        <dl className=\"grid grid-cols-2 gap-4 md:grid-cols-3\">\n          <Item label=\"Service\">{incident.service}</Item>\n          <Item label=\"Commander\">{incident.commander ?? \"-\"}</Item>\n          <Item label=\"Opened by\">{incident.opened_by}</Item>\n          <Item label=\"Opened at\">{formatTime(incident.opened_at)}</Item>\n          <Item label=\"Resolution target\">{formatTime(incident.sla_due_at)}</Item>\n          <Item label=\"Resolved at\">{formatTime(incident.resolved_at)}</Item>\n          <Item label=\"Reopened\">{incident.reopen_count} times</Item>\n          <div className=\"col-span-2 md:col-span-3\">\n            <Item label=\"Impact summary\">{incident.impact_summary ?? \"-\"}</Item>\n          </div>\n        </dl>\n      </section>\n\n      <section className=\"space-y-2\">\n        <h2 className=\"text-lg font-medium\">Status</h2>\n        {actionError && <ErrorBox>{actionError}</ErrorBox>}\n        <div className=\"flex flex-wrap gap-2\">\n          {STATUSES.map((s) => (\n            <button\n              key={s}\n              className={s === incident.status ? btnCls : btnSecondaryCls}\n              disabled={busy || s === incident.status}\n              onClick={() => changeStatus(s)}\n            >\n              {s}\n            </button>\n          ))}\n        </div>\n      </section>\n\n      <section className=\"space-y-3\">\n        <h2 className=\"text-lg font-medium\">Timeline</h2>\n        <ol className=\"space-y-2\">\n          {events.map((ev) => (\n            <li key={ev.id} className=\"rounded-lg bg-white p-3 shadow\">\n              <div className=\"flex flex-wrap items-center gap-2 text-xs text-slate-500\">\n                <span className=\"rounded bg-slate-100 px-1.5 py-0.5 font-medium\">{ev.type}</span>\n                <span>{ev.author}</span>\n                <span>{formatTime(ev.created_at)}</span>\n              </div>\n              <p className=\"mt-1 whitespace-pre-wrap text-sm\">{ev.message}</p>\n            </li>\n          ))}\n          {events.length === 0 && <li className=\"text-sm text-slate-500\">No events yet.</li>}\n        </ol>\n        <form onSubmit={post} className=\"space-y-2 rounded-lg bg-white p-4 shadow\">\n          {msgError && <ErrorBox>{msgError}</ErrorBox>}\n          <textarea\n            className={inputCls}\n            rows={3}\n            placeholder=\"Post an update...\"\n            aria-label=\"Event message\"\n            value={message}\n            onChange={(e) => setMessage(e.target.value)}\n          />\n          <button className={btnCls} disabled={busy}>\n            Post event\n          </button>\n        </form>\n      </section>\n    </div>\n  );\n}\nEOF\ncat > App.tsx <<'EOF'\nimport { useEffect, useSyncExternalStore } from \"react\";\nimport { getToken, getUser, setSession, subscribeSession } from \"./api\";\nimport { AuthPage } from \"./AuthPages\";\nimport { IncidentList } from \"./IncidentList\";\nimport { IncidentPage } from \"./IncidentPage\";\nimport { NewIncident } from \"./NewIncident\";\nimport { PublicPage } from \"./PublicPage\";\nimport { Link, navigate, usePath } from \"./router\";\nimport { btnSecondaryCls } from \"./ui\";\n\nfunction useSession() {\n  const token = useSyncExternalStore(subscribeSession, getToken);\n  const user = useSyncExternalStore(subscribeSession, getUser);\n  return { token, user };\n}\n\nconst navLink = \"text-sm font-medium text-slate-600 hover:text-slate-900\";\n\nexport default function App() {\n  const path = usePath();\n  const { token, user } = useSession();\n\n  const isProtected = path.startsWith(\"/incidents\");\n  const isAuthPage = path === \"/login\" || path === \"/register\";\n\n  useEffect(() => {\n    if (isProtected && !token) navigate(\"/login\", true);\n    else if (isAuthPage && token) navigate(\"/incidents\", true);\n  }, [isProtected, isAuthPage, token]);\n\n  let page;\n  const match = path.match(/^\\/incidents\\/(\\d+)\\/?$/);\n  if (isProtected && !token) page = null;\n  else if (path === \"/login\") page = <AuthPage mode=\"login\" />;\n  else if (path === \"/register\") page = <AuthPage mode=\"register\" />;\n  else if (path.replace(/\\/$/, \"\") === \"/incidents\") page = <IncidentList />;\n  else if (path.replace(/\\/$/, \"\") === \"/incidents/new\") page = <NewIncident />;\n  else if (match) page = <IncidentPage key={match[1]} id={Number(match[1])} />;\n  else if (path === \"/\") page = <PublicPage />;\n  else page = <p className=\"text-slate-600\">Page not found.</p>;\n\n  return (\n    <div className=\"min-h-screen bg-slate-100 text-slate-900\">\n      <header className=\"border-b border-slate-200 bg-white\">\n        <nav className=\"mx-auto flex max-w-5xl items-center gap-5 px-4 py-3\">\n          <Link to=\"/\" className=\"text-lg font-semibold text-indigo-700\">\n            Incident center\n          </Link>\n          <Link to=\"/\" className={navLink}>\n            Status\n          </Link>\n          {token && (\n            <Link to=\"/incidents\" className={navLink}>\n              Incidents\n            </Link>\n          )}\n          <div className=\"ml-auto flex items-center gap-3\">\n            {token ? (\n              <>\n                <span className=\"text-sm text-slate-600\">\n                  Signed in as <strong data-testid=\"username\">{user}</strong>\n                </span>\n                <button\n                  className={btnSecondaryCls}\n                  onClick={() => {\n                    setSession(null, null);\n                    navigate(\"/\");\n                  }}\n                >\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <>\n                <Link to=\"/login\" className={navLink}>\n                  Sign in\n                </Link>\n                <Link to=\"/register\" className={navLink}>\n                  Register\n                </Link>\n              </>\n            )}\n          </div>\n        </nav>\n      </header>\n      <main className=\"mx-auto max-w-5xl px-4 py-6\">{page}</main>\n    </div>\n  );\n}\nEOF\ncd .. && npm run build 2>&1 | tail -20","time":{"start":1794250186023,"end":1794250187694}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1a51d1c001KtB1M9CE2ovB8Q","sessionID":"ses_e3e5df250ffe14cmjvCAJXq0o1","messageID":"msg_1c1a44376001N629tcHY9CBc2d"}}
