{"type":"step_start","timestamp":1794251886747,"sessionID":"ses_e3e440ebdffe3zs16pPnbKPW5e","part":{"id":"prt_1c1bf1076001A3NrDLLzNiBPut","messageID":"msg_1c1be435f001ggSKAbDKp4aHu6","sessionID":"ses_e3e440ebdffe3zs16pPnbKPW5e","type":"step-start"}}
{"type":"tool_use","timestamp":1794251888877,"sessionID":"ses_e3e440ebdffe3zs16pPnbKPW5e","part":{"type":"tool","tool":"bash","callID":"toolu_01Kwg9gceUeFdG9ELPSb4spP","state":{"status":"completed","input":{"command":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's|\"build\": \"vite build\"|\"build\": \"vite build\",\\n    \"typecheck\": \"tsc --noEmit\"|' package.json\nsed -i 's|<title>App</title>|<title>Shop</title>|' index.html\necho '@import \"tailwindcss\";' > src/index.css\ncat > src/api.ts <<'EOF'\nexport type Product = {\n  id: number;\n  name: string;\n  description: string;\n  price: number;\n  stock: number;\n  is_active: boolean;\n};\n\nexport type CartItem = {\n  id: number;\n  product_id: number;\n  quantity: number;\n  name: string;\n  unit_price: number;\n  line_total: number;\n};\n\nexport type Cart = { items: CartItem[]; subtotal: number };\n\nexport type Page = {\n  items: Product[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type Session = { token: string; username: string; is_admin: boolean };\n\nconst KEY = \"shop.session\";\n\nexport function loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(KEY);\n    return raw ? (JSON.parse(raw) as Session) : null;\n  } catch {\n    return null;\n  }\n}\n\nexport function saveSession(s: Session | null) {\n  if (s) localStorage.setItem(KEY, JSON.stringify(s));\n  else localStorage.removeItem(KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nexport async function api<T>(\n  method: string,\n  path: string,\n  body?: unknown,\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = loadSession()?.token;\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: { error?: string } | null = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    if (res.status === 401 && token) onUnauthorized();\n    throw new ApiError(res.status, data?.error ?? `Request failed (${res.status})`);\n  }\n  return data as T;\n}\n\nexport const money = (n: number) =>\n  new Intl.NumberFormat(undefined, { style: \"currency\", currency: \"USD\" }).format(n);\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  loadSession,\n  saveSession,\n  setUnauthorizedHandler,\n  type Cart,\n  type Page,\n  type Session,\n} from \"./api\";\nimport AuthForms from \"./AuthForms\";\nimport CartPanel from \"./CartPanel\";\nimport ProductGrid from \"./ProductGrid\";\nimport AdminPanel from \"./AdminPanel\";\n\nconst btn =\n  \"rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\";\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n  const [cart, setCart] = useState<Cart>({ items: [], subtotal: 0 });\n  const [cartOpen, setCartOpen] = useState(false);\n  const [authOpen, setAuthOpen] = useState(false);\n  const [view, setView] = useState<\"shop\" | \"admin\">(\"shop\");\n  const [notice, setNotice] = useState(\"\");\n  const [reload, setReload] = useState(0);\n\n  const updateSession = useCallback((s: Session | null) => {\n    saveSession(s);\n    setSession(s);\n    if (!s) {\n      setCart({ items: [], subtotal: 0 });\n      setCartOpen(false);\n      setView(\"shop\");\n    }\n  }, []);\n\n  useEffect(() => {\n    setUnauthorizedHandler(() => updateSession(null));\n  }, [updateSession]);\n\n  const refreshCart = useCallback(async () => {\n    if (!loadSession()) return;\n    try {\n      setCart(await api<Cart>(\"GET\", \"/cart\"));\n    } catch {\n      /* handled by 401 handler */\n    }\n  }, []);\n\n  useEffect(() => {\n    if (session) void refreshCart();\n  }, [session, refreshCart]);\n\n  const signOut = async () => {\n    try {\n      await api(\"POST\", \"/auth/logout\");\n    } catch {\n      /* ignore */\n    }\n    updateSession(null);\n  };\n\n  const addToCart = async (productId: number) => {\n    if (!session) {\n      setAuthOpen(true);\n      setNotice(\"Sign in to add items to your cart.\");\n      return;\n    }\n    try {\n      await api(\"POST\", \"/cart\", { product_id: productId, quantity: 1 });\n      setNotice(\"\");\n      await refreshCart();\n    } catch (e) {\n      setNotice(e instanceof ApiError ? e.message : \"Something went wrong\");\n    }\n  };\n\n  const count = cart.items.reduce((n, i) => n + i.quantity, 0);\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"sticky top-0 z-10 border-b bg-white\">\n        <div className=\"mx-auto flex max-w-6xl items-center gap-3 px-4 py-3\">\n          <button\n            className=\"text-xl font-bold\"\n            onClick={() => setView(\"shop\")}\n          >\n            Shop\n          </button>\n          {session?.is_admin && (\n            <button\n              className={`rounded px-2 py-1 text-sm ${view === \"admin\" ? \"bg-slate-200\" : \"hover:bg-slate-100\"}`}\n              onClick={() => setView(view === \"admin\" ? \"shop\" : \"admin\")}\n            >\n              Admin\n            </button>\n          )}\n          <div className=\"ml-auto flex items-center gap-3\">\n            {session ? (\n              <>\n                <span className=\"text-sm\" data-testid=\"username\">\n                  {session.username}\n                </span>\n                <button className={btn} onClick={signOut}>\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <button className={btn} onClick={() => setAuthOpen((o) => !o)}>\n                Sign in\n              </button>\n            )}\n            <button\n              className=\"relative rounded border px-3 py-1.5 text-sm font-medium hover:bg-slate-100\"\n              onClick={() => {\n                if (session) setCartOpen((o) => !o);\n                else {\n                  setAuthOpen(true);\n                  setNotice(\"Sign in to see your cart.\");\n                }\n              }}\n              aria-label=\"Cart\"\n            >\n              Cart\n              <span\n                data-testid=\"cart-badge\"\n                className=\"ml-2 inline-block min-w-5 rounded-full bg-amber-500 px-1.5 text-center text-xs font-bold text-white\"\n              >\n                {count}\n              </span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-6\">\n        {notice && (\n          <p role=\"alert\" className=\"mb-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {notice}\n          </p>\n        )}\n        {!session && authOpen && (\n          <AuthForms\n            onSession={(s) => {\n              updateSession(s);\n              setAuthOpen(false);\n              setNotice(\"\");\n            }}\n          />\n        )}\n        {view === \"admin\" && session?.is_admin ? (\n          <AdminPanel onChanged={() => { setReload((n) => n + 1); void refreshCart(); }} />\n        ) : (\n          <ProductGrid reload={reload} onAdd={addToCart} />\n        )}\n      </main>\n\n      {cartOpen && session && (\n        <CartPanel\n          cart={cart}\n          onClose={() => setCartOpen(false)}\n          onChanged={refreshCart}\n        />\n      )}\n    </div>\n  );\n}\n\nexport type { Page };\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, ApiError, type Session } from \"./api\";\n\nconst input = \"w-full rounded border border-slate-300 px-2 py-1.5 text-sm\";\nconst btn =\n  \"rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\";\n\nexport default function AuthForms({ onSession }: { onSession: (s: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [info, setInfo] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setInfo(\"\");\n    try {\n      if (mode === \"register\") {\n        await api(\"POST\", \"/auth/register\", { username, password });\n      }\n      const res = await api<Session & { token: string }>(\"POST\", \"/auth/login\", {\n        username,\n        password,\n      });\n      onSession({ token: res.token, username: res.username ?? username, is_admin: !!res.is_admin });\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"mb-6 max-w-sm space-y-3 rounded-lg border bg-white p-4 shadow-sm\"\n    >\n      <h2 className=\"text-lg font-semibold\">\n        {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n      </h2>\n      <label className=\"block text-sm\">\n        Username\n        <input\n          className={input}\n          name=\"username\"\n          autoComplete=\"username\"\n          value={username}\n          onChange={(e) => setUsername(e.target.value)}\n          required\n        />\n      </label>\n      <label className=\"block text-sm\">\n        Password\n        <input\n          className={input}\n          name=\"password\"\n          type=\"password\"\n          autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          required\n        />\n      </label>\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n      {info && <p className=\"text-sm text-green-700\">{info}</p>}\n      <div className=\"flex items-center gap-3\">\n        <button className={btn} disabled={busy} type=\"submit\">\n          {mode === \"login\" ? \"Sign in\" : \"Register\"}\n        </button>\n        <button\n          type=\"button\"\n          className=\"text-sm text-slate-600 underline\"\n          onClick={() => {\n            setMode(mode === \"login\" ? \"register\" : \"login\");\n            setError(\"\");\n          }}\n        >\n          {mode === \"login\" ? \"Need an account? Register\" : \"Have an account? Sign in\"}\n        </button>\n      </div>\n    </form>\n  );\n}\nEOF\ncat > src/ProductGrid.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, ApiError, money, type Page } from \"./api\";\n\nexport default function ProductGrid({\n  reload,\n  onAdd,\n}: {\n  reload: number;\n  onAdd: (id: number) => void;\n}) {\n  const [input, setInput] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(input.trim());\n      setPage(1);\n    }, 250);\n    return () => clearTimeout(t);\n  }, [input]);\n\n  useEffect(() => {\n    let stale = false;\n    const params = new URLSearchParams({ page: String(page), page_size: \"8\" });\n    if (q) params.set(\"q\", q);\n    api<Page>(\"GET\", `/products?${params}`)\n      .then((d) => {\n        if (!stale) {\n          setData(d);\n          setError(\"\");\n        }\n      })\n      .catch((e) => {\n        if (!stale) setError(e instanceof ApiError ? e.message : \"Failed to load\");\n      });\n    return () => {\n      stale = true;\n    };\n  }, [q, page, reload]);\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <section>\n      <input\n        type=\"search\"\n        placeholder=\"Search products\"\n        aria-label=\"Search products\"\n        className=\"mb-4 w-full max-w-sm rounded border border-slate-300 px-3 py-2 text-sm\"\n        value={input}\n        onChange={(e) => setInput(e.target.value)}\n      />\n      {error && <p role=\"alert\" className=\"text-sm text-red-700\">{error}</p>}\n      {data && data.items.length === 0 && (\n        <p className=\"text-slate-600\">No products found.</p>\n      )}\n      <ul className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n        {data?.items.map((p) => (\n          <li\n            key={p.id}\n            data-testid=\"product\"\n            className=\"flex flex-col overflow-hidden rounded-lg border bg-white shadow-sm\"\n          >\n            <div className=\"relative flex h-32 items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300 text-4xl font-bold text-slate-400\">\n              {p.name.charAt(0).toUpperCase()}\n              {p.stock <= 0 && (\n                <span className=\"absolute right-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-semibold text-white\">\n                  Out of stock\n                </span>\n              )}\n            </div>\n            <div className=\"flex flex-1 flex-col gap-1 p-3\">\n              <h3 className=\"font-semibold\">{p.name}</h3>\n              <p className=\"line-clamp-2 text-sm text-slate-600\">{p.description}</p>\n              <p className=\"mt-auto pt-2 font-medium\">{money(p.price)}</p>\n              <button\n                className=\"mt-2 rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\"\n                disabled={p.stock <= 0}\n                onClick={() => onAdd(p.id)}\n              >\n                Add to cart\n              </button>\n            </div>\n          </li>\n        ))}\n      </ul>\n      <nav className=\"mt-6 flex items-center justify-center gap-3 text-sm\">\n        <button\n          className=\"rounded border px-3 py-1 disabled:opacity-40\"\n          disabled={page <= 1}\n          onClick={() => setPage(page - 1)}\n        >\n          Previous\n        </button>\n        <span>\n          Page {page} of {pages}\n        </span>\n        <button\n          className=\"rounded border px-3 py-1 disabled:opacity-40\"\n          disabled={page >= pages}\n          onClick={() => setPage(page + 1)}\n        >\n          Next\n        </button>\n      </nav>\n    </section>\n  );\n}\nEOF\ncat > src/CartPanel.tsx <<'EOF'\nimport { useState } from \"react\";\nimport { api, ApiError, money, type Cart } from \"./api\";\n\nexport default function CartPanel({\n  cart,\n  onClose,\n  onChanged,\n}: {\n  cart: Cart;\n  onClose: () => void;\n  onChanged: () => Promise<void>;\n}) {\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const run = async (fn: () => Promise<unknown>) => {\n    setBusy(true);\n    setError(\"\");\n    try {\n      await fn();\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Something went wrong\");\n    }\n    await onChanged();\n    setBusy(false);\n  };\n\n  const setQty = (id: number, quantity: number) =>\n    run(() => api(\"PATCH\", `/cart/${id}`, { quantity }));\n  const remove = (id: number) => run(() => api(\"DELETE\", `/cart/${id}`));\n\n  return (\n    <aside\n      aria-label=\"Cart panel\"\n      className=\"fixed inset-y-0 right-0 z-20 flex w-full max-w-md flex-col border-l bg-white shadow-xl\"\n    >\n      <div className=\"flex items-center justify-between border-b px-4 py-3\">\n        <h2 className=\"text-lg font-semibold\">Your cart</h2>\n        <button className=\"rounded px-2 py-1 hover:bg-slate-100\" onClick={onClose}>\n          Close\n        </button>\n      </div>\n      <div className=\"flex-1 overflow-y-auto px-4 py-2\">\n        {error && (\n          <p role=\"alert\" className=\"my-2 rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {error}\n          </p>\n        )}\n        {cart.items.length === 0 && <p className=\"py-4 text-slate-600\">Your cart is empty.</p>}\n        <ul className=\"divide-y\">\n          {cart.items.map((i) => (\n            <li key={i.id} data-testid=\"cart-item\" className=\"flex items-center gap-3 py-3\">\n              <div className=\"min-w-0 flex-1\">\n                <p className=\"truncate font-medium\">{i.name}</p>\n                <p className=\"text-sm text-slate-600\">{money(i.unit_price)} each</p>\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <button\n                  aria-label={`Decrease quantity of ${i.name}`}\n                  className=\"h-7 w-7 rounded border disabled:opacity-40\"\n                  disabled={busy || i.quantity <= 1}\n                  onClick={() => setQty(i.id, i.quantity - 1)}\n                >\n                  -\n                </button>\n                <span className=\"w-8 text-center\" data-testid=\"quantity\">{i.quantity}</span>\n                <button\n                  aria-label={`Increase quantity of ${i.name}`}\n                  className=\"h-7 w-7 rounded border disabled:opacity-40\"\n                  disabled={busy}\n                  onClick={() => setQty(i.id, i.quantity + 1)}\n                >\n                  +\n                </button>\n              </div>\n              <p className=\"w-20 text-right font-medium\">{money(i.line_total)}</p>\n              <button\n                aria-label={`Remove ${i.name}`}\n                className=\"rounded px-2 py-1 text-sm text-red-700 hover:bg-red-50\"\n                disabled={busy}\n                onClick={() => remove(i.id)}\n              >\n                Remove\n              </button>\n            </li>\n          ))}\n        </ul>\n      </div>\n      <div className=\"flex items-center justify-between border-t px-4 py-3 text-lg font-semibold\">\n        <span>Subtotal</span>\n        <span data-testid=\"subtotal\">{money(cart.subtotal)}</span>\n      </div>\n    </aside>\n  );\n}\nEOF\ncat > src/AdminPanel.tsx <<'EOF'\nimport { useCallback, useEffect, useState, type FormEvent } from \"react\";\nimport { api, ApiError, type Page, type Product } from \"./api\";\n\nconst input = \"rounded border border-slate-300 px-2 py-1 text-sm\";\nconst btn =\n  \"rounded bg-slate-800 px-3 py-1 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\";\n\nfunction Row({ p, onSaved }: { p: Product; onSaved: () => void }) {\n  const [price, setPrice] = useState(String(p.price));\n  const [stock, setStock] = useState(String(p.stock));\n  const [active, setActive] = useState(p.is_active);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    setPrice(String(p.price));\n    setStock(String(p.stock));\n    setActive(p.is_active);\n  }, [p]);\n\n  const save = async () => {\n    setError(\"\");\n    const priceNum = Number(price);\n    const stockNum = Number(stock);\n    if (price.trim() === \"\" || stock.trim() === \"\") {\n      setError(\"Price and stock are required\");\n      return;\n    }\n    try {\n      await api(\"PATCH\", `/admin/products/${p.id}`, {\n        price: priceNum,\n        stock: stockNum,\n        is_active: active,\n      });\n      onSaved();\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Something went wrong\");\n    }\n  };\n\n  return (\n    <tr className=\"border-t align-top\">\n      <td className=\"py-2 pr-2\">{p.name}</td>\n      <td className=\"pr-2\">\n        <input\n          aria-label={`Price of ${p.name}`}\n          className={`${input} w-24`}\n          inputMode=\"decimal\"\n          value={price}\n          onChange={(e) => setPrice(e.target.value)}\n        />\n      </td>\n      <td className=\"pr-2\">\n        <input\n          aria-label={`Stock of ${p.name}`}\n          className={`${input} w-20`}\n          inputMode=\"numeric\"\n          value={stock}\n          onChange={(e) => setStock(e.target.value)}\n        />\n      </td>\n      <td className=\"pr-2\">\n        <input\n          type=\"checkbox\"\n          aria-label={`Active ${p.name}`}\n          checked={active}\n          onChange={(e) => setActive(e.target.checked)}\n        />\n      </td>\n      <td>\n        <button className={btn} onClick={save}>\n          Save\n        </button>\n        {error && <p role=\"alert\" className=\"mt-1 text-xs text-red-700\">{error}</p>}\n      </td>\n    </tr>\n  );\n}\n\nexport default function AdminPanel({ onChanged }: { onChanged: () => void }) {\n  const [items, setItems] = useState<Product[]>([]);\n  const [page, setPage] = useState(1);\n  const [total, setTotal] = useState(0);\n  const [error, setError] = useState(\"\");\n  const [name, setName] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [price, setPrice] = useState(\"\");\n  const [stock, setStock] = useState(\"0\");\n  const [formError, setFormError] = useState(\"\");\n  const size = 10;\n\n  const load = useCallback(async () => {\n    try {\n      const d = await api<Page>(\"GET\", `/admin/products?page=${page}&page_size=${size}`);\n      setItems(d.items);\n      setTotal(d.total);\n      setError(\"\");\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Failed to load\");\n    }\n  }, [page]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const create = async (e: FormEvent) => {\n    e.preventDefault();\n    setFormError(\"\");\n    try {\n      await api(\"POST\", \"/admin/products\", {\n        name,\n        description,\n        price: Number(price),\n        stock: Number(stock),\n      });\n      setName(\"\");\n      setDescription(\"\");\n      setPrice(\"\");\n      setStock(\"0\");\n      await load();\n      onChanged();\n    } catch (err) {\n      setFormError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    }\n  };\n\n  const pages = Math.max(1, Math.ceil(total / size));\n\n  return (\n    <section className=\"space-y-6\">\n      <form onSubmit={create} className=\"space-y-3 rounded-lg border bg-white p-4 shadow-sm\">\n        <h2 className=\"text-lg font-semibold\">Add product</h2>\n        <div className=\"flex flex-wrap gap-3\">\n          <input\n            className={`${input} w-48`}\n            placeholder=\"Name\"\n            aria-label=\"Name\"\n            value={name}\n            onChange={(e) => setName(e.target.value)}\n            required\n          />\n          <input\n            className={`${input} w-64`}\n            placeholder=\"Description\"\n            aria-label=\"Description\"\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n          />\n          <input\n            className={`${input} w-28`}\n            placeholder=\"Price\"\n            aria-label=\"Price\"\n            inputMode=\"decimal\"\n            value={price}\n            onChange={(e) => setPrice(e.target.value)}\n            required\n          />\n          <input\n            className={`${input} w-24`}\n            placeholder=\"Stock\"\n            aria-label=\"Stock\"\n            inputMode=\"numeric\"\n            value={stock}\n            onChange={(e) => setStock(e.target.value)}\n            required\n          />\n          <button className={btn} type=\"submit\">\n            Add\n          </button>\n        </div>\n        {formError && <p role=\"alert\" className=\"text-sm text-red-700\">{formError}</p>}\n      </form>\n\n      <div className=\"overflow-x-auto rounded-lg border bg-white p-4 shadow-sm\">\n        <h2 className=\"mb-2 text-lg font-semibold\">Products</h2>\n        {error && <p role=\"alert\" className=\"text-sm text-red-700\">{error}</p>}\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr>\n              <th className=\"pb-2\">Name</th>\n              <th>Price</th>\n              <th>Stock</th>\n              <th>Active</th>\n              <th />\n            </tr>\n          </thead>\n          <tbody>\n            {items.map((p) => (\n              <Row\n                key={p.id}\n                p={p}\n                onSaved={() => {\n                  void load();\n                  onChanged();\n                }}\n              />\n            ))}\n          </tbody>\n        </table>\n        <div className=\"mt-4 flex items-center gap-3 text-sm\">\n          <button className=\"rounded border px-3 py-1 disabled:opacity-40\" disabled={page <= 1} onClick={() => setPage(page - 1)}>\n            Previous\n          </button>\n          <span>Page {page} of {pages}</span>\n          <button className=\"rounded border px-3 py-1 disabled:opacity-40\" disabled={page >= pages} onClick={() => setPage(page + 1)}>\n            Next\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}\nEOF\nnpm run typecheck 2>&1 | tail -20; npm run build 2>&1 | tail -8","workdir":"/workspace/frontend"},"output":"\n> typecheck\n> tsc --noEmit\n\n✓ 21 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.38 kB │ gzip:  0.26 kB\ndist/assets/index-Cw0AiA4D.css   15.20 kB │ gzip:  3.78 kB\ndist/assets/index-D1_sB8pR.js   233.92 kB │ gzip: 72.43 kB\n\n✓ built in 499ms\n","metadata":{"output":"\n> typecheck\n> tsc --noEmit\n\n✓ 21 modules transformed.\nrendering chunks...\ncomputing gzip size...\ndist/index.html                   0.38 kB │ gzip:  0.26 kB\ndist/assets/index-Cw0AiA4D.css   15.20 kB │ gzip:  3.78 kB\ndist/assets/index-D1_sB8pR.js   233.92 kB │ gzip: 72.43 kB\n\n✓ built in 499ms\n","exit":0,"truncated":false},"title":"cd /workspace/frontend && cat > vite.config.ts <<'EOF'\nimport tailwindcss from \"@tailwindcss/vite\";\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react(), tailwindcss()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nEOF\ncat > tsconfig.json <<'EOF'\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src\"]\n}\nEOF\nsed -i 's|\"build\": \"vite build\"|\"build\": \"vite build\",\\n    \"typecheck\": \"tsc --noEmit\"|' package.json\nsed -i 's|<title>App</title>|<title>Shop</title>|' index.html\necho '@import \"tailwindcss\";' > src/index.css\ncat > src/api.ts <<'EOF'\nexport type Product = {\n  id: number;\n  name: string;\n  description: string;\n  price: number;\n  stock: number;\n  is_active: boolean;\n};\n\nexport type CartItem = {\n  id: number;\n  product_id: number;\n  quantity: number;\n  name: string;\n  unit_price: number;\n  line_total: number;\n};\n\nexport type Cart = { items: CartItem[]; subtotal: number };\n\nexport type Page = {\n  items: Product[];\n  total: number;\n  page: number;\n  page_size: number;\n};\n\nexport type Session = { token: string; username: string; is_admin: boolean };\n\nconst KEY = \"shop.session\";\n\nexport function loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(KEY);\n    return raw ? (JSON.parse(raw) as Session) : null;\n  } catch {\n    return null;\n  }\n}\n\nexport function saveSession(s: Session | null) {\n  if (s) localStorage.setItem(KEY, JSON.stringify(s));\n  else localStorage.removeItem(KEY);\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nlet onUnauthorized: () => void = () => {};\nexport function setUnauthorizedHandler(fn: () => void) {\n  onUnauthorized = fn;\n}\n\nexport async function api<T>(\n  method: string,\n  path: string,\n  body?: unknown,\n): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = loadSession()?.token;\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: { error?: string } | null = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    if (res.status === 401 && token) onUnauthorized();\n    throw new ApiError(res.status, data?.error ?? `Request failed (${res.status})`);\n  }\n  return data as T;\n}\n\nexport const money = (n: number) =>\n  new Intl.NumberFormat(undefined, { style: \"currency\", currency: \"USD\" }).format(n);\nEOF\ncat > src/main.tsx <<'EOF'\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\nimport \"./index.css\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\nEOF\ncat > src/App.tsx <<'EOF'\nimport { useCallback, useEffect, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  loadSession,\n  saveSession,\n  setUnauthorizedHandler,\n  type Cart,\n  type Page,\n  type Session,\n} from \"./api\";\nimport AuthForms from \"./AuthForms\";\nimport CartPanel from \"./CartPanel\";\nimport ProductGrid from \"./ProductGrid\";\nimport AdminPanel from \"./AdminPanel\";\n\nconst btn =\n  \"rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\";\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(loadSession);\n  const [cart, setCart] = useState<Cart>({ items: [], subtotal: 0 });\n  const [cartOpen, setCartOpen] = useState(false);\n  const [authOpen, setAuthOpen] = useState(false);\n  const [view, setView] = useState<\"shop\" | \"admin\">(\"shop\");\n  const [notice, setNotice] = useState(\"\");\n  const [reload, setReload] = useState(0);\n\n  const updateSession = useCallback((s: Session | null) => {\n    saveSession(s);\n    setSession(s);\n    if (!s) {\n      setCart({ items: [], subtotal: 0 });\n      setCartOpen(false);\n      setView(\"shop\");\n    }\n  }, []);\n\n  useEffect(() => {\n    setUnauthorizedHandler(() => updateSession(null));\n  }, [updateSession]);\n\n  const refreshCart = useCallback(async () => {\n    if (!loadSession()) return;\n    try {\n      setCart(await api<Cart>(\"GET\", \"/cart\"));\n    } catch {\n      /* handled by 401 handler */\n    }\n  }, []);\n\n  useEffect(() => {\n    if (session) void refreshCart();\n  }, [session, refreshCart]);\n\n  const signOut = async () => {\n    try {\n      await api(\"POST\", \"/auth/logout\");\n    } catch {\n      /* ignore */\n    }\n    updateSession(null);\n  };\n\n  const addToCart = async (productId: number) => {\n    if (!session) {\n      setAuthOpen(true);\n      setNotice(\"Sign in to add items to your cart.\");\n      return;\n    }\n    try {\n      await api(\"POST\", \"/cart\", { product_id: productId, quantity: 1 });\n      setNotice(\"\");\n      await refreshCart();\n    } catch (e) {\n      setNotice(e instanceof ApiError ? e.message : \"Something went wrong\");\n    }\n  };\n\n  const count = cart.items.reduce((n, i) => n + i.quantity, 0);\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900\">\n      <header className=\"sticky top-0 z-10 border-b bg-white\">\n        <div className=\"mx-auto flex max-w-6xl items-center gap-3 px-4 py-3\">\n          <button\n            className=\"text-xl font-bold\"\n            onClick={() => setView(\"shop\")}\n          >\n            Shop\n          </button>\n          {session?.is_admin && (\n            <button\n              className={`rounded px-2 py-1 text-sm ${view === \"admin\" ? \"bg-slate-200\" : \"hover:bg-slate-100\"}`}\n              onClick={() => setView(view === \"admin\" ? \"shop\" : \"admin\")}\n            >\n              Admin\n            </button>\n          )}\n          <div className=\"ml-auto flex items-center gap-3\">\n            {session ? (\n              <>\n                <span className=\"text-sm\" data-testid=\"username\">\n                  {session.username}\n                </span>\n                <button className={btn} onClick={signOut}>\n                  Sign out\n                </button>\n              </>\n            ) : (\n              <button className={btn} onClick={() => setAuthOpen((o) => !o)}>\n                Sign in\n              </button>\n            )}\n            <button\n              className=\"relative rounded border px-3 py-1.5 text-sm font-medium hover:bg-slate-100\"\n              onClick={() => {\n                if (session) setCartOpen((o) => !o);\n                else {\n                  setAuthOpen(true);\n                  setNotice(\"Sign in to see your cart.\");\n                }\n              }}\n              aria-label=\"Cart\"\n            >\n              Cart\n              <span\n                data-testid=\"cart-badge\"\n                className=\"ml-2 inline-block min-w-5 rounded-full bg-amber-500 px-1.5 text-center text-xs font-bold text-white\"\n              >\n                {count}\n              </span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto max-w-6xl px-4 py-6\">\n        {notice && (\n          <p role=\"alert\" className=\"mb-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {notice}\n          </p>\n        )}\n        {!session && authOpen && (\n          <AuthForms\n            onSession={(s) => {\n              updateSession(s);\n              setAuthOpen(false);\n              setNotice(\"\");\n            }}\n          />\n        )}\n        {view === \"admin\" && session?.is_admin ? (\n          <AdminPanel onChanged={() => { setReload((n) => n + 1); void refreshCart(); }} />\n        ) : (\n          <ProductGrid reload={reload} onAdd={addToCart} />\n        )}\n      </main>\n\n      {cartOpen && session && (\n        <CartPanel\n          cart={cart}\n          onClose={() => setCartOpen(false)}\n          onChanged={refreshCart}\n        />\n      )}\n    </div>\n  );\n}\n\nexport type { Page };\nEOF\ncat > src/AuthForms.tsx <<'EOF'\nimport { useState, type FormEvent } from \"react\";\nimport { api, ApiError, type Session } from \"./api\";\n\nconst input = \"w-full rounded border border-slate-300 px-2 py-1.5 text-sm\";\nconst btn =\n  \"rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\";\n\nexport default function AuthForms({ onSession }: { onSession: (s: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [info, setInfo] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const submit = async (e: FormEvent) => {\n    e.preventDefault();\n    setBusy(true);\n    setError(\"\");\n    setInfo(\"\");\n    try {\n      if (mode === \"register\") {\n        await api(\"POST\", \"/auth/register\", { username, password });\n      }\n      const res = await api<Session & { token: string }>(\"POST\", \"/auth/login\", {\n        username,\n        password,\n      });\n      onSession({ token: res.token, username: res.username ?? username, is_admin: !!res.is_admin });\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  return (\n    <form\n      onSubmit={submit}\n      className=\"mb-6 max-w-sm space-y-3 rounded-lg border bg-white p-4 shadow-sm\"\n    >\n      <h2 className=\"text-lg font-semibold\">\n        {mode === \"login\" ? \"Sign in\" : \"Create account\"}\n      </h2>\n      <label className=\"block text-sm\">\n        Username\n        <input\n          className={input}\n          name=\"username\"\n          autoComplete=\"username\"\n          value={username}\n          onChange={(e) => setUsername(e.target.value)}\n          required\n        />\n      </label>\n      <label className=\"block text-sm\">\n        Password\n        <input\n          className={input}\n          name=\"password\"\n          type=\"password\"\n          autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          required\n        />\n      </label>\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-red-700\">\n          {error}\n        </p>\n      )}\n      {info && <p className=\"text-sm text-green-700\">{info}</p>}\n      <div className=\"flex items-center gap-3\">\n        <button className={btn} disabled={busy} type=\"submit\">\n          {mode === \"login\" ? \"Sign in\" : \"Register\"}\n        </button>\n        <button\n          type=\"button\"\n          className=\"text-sm text-slate-600 underline\"\n          onClick={() => {\n            setMode(mode === \"login\" ? \"register\" : \"login\");\n            setError(\"\");\n          }}\n        >\n          {mode === \"login\" ? \"Need an account? Register\" : \"Have an account? Sign in\"}\n        </button>\n      </div>\n    </form>\n  );\n}\nEOF\ncat > src/ProductGrid.tsx <<'EOF'\nimport { useEffect, useState } from \"react\";\nimport { api, ApiError, money, type Page } from \"./api\";\n\nexport default function ProductGrid({\n  reload,\n  onAdd,\n}: {\n  reload: number;\n  onAdd: (id: number) => void;\n}) {\n  const [input, setInput] = useState(\"\");\n  const [q, setQ] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState<Page | null>(null);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    const t = setTimeout(() => {\n      setQ(input.trim());\n      setPage(1);\n    }, 250);\n    return () => clearTimeout(t);\n  }, [input]);\n\n  useEffect(() => {\n    let stale = false;\n    const params = new URLSearchParams({ page: String(page), page_size: \"8\" });\n    if (q) params.set(\"q\", q);\n    api<Page>(\"GET\", `/products?${params}`)\n      .then((d) => {\n        if (!stale) {\n          setData(d);\n          setError(\"\");\n        }\n      })\n      .catch((e) => {\n        if (!stale) setError(e instanceof ApiError ? e.message : \"Failed to load\");\n      });\n    return () => {\n      stale = true;\n    };\n  }, [q, page, reload]);\n\n  const pages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;\n\n  return (\n    <section>\n      <input\n        type=\"search\"\n        placeholder=\"Search products\"\n        aria-label=\"Search products\"\n        className=\"mb-4 w-full max-w-sm rounded border border-slate-300 px-3 py-2 text-sm\"\n        value={input}\n        onChange={(e) => setInput(e.target.value)}\n      />\n      {error && <p role=\"alert\" className=\"text-sm text-red-700\">{error}</p>}\n      {data && data.items.length === 0 && (\n        <p className=\"text-slate-600\">No products found.</p>\n      )}\n      <ul className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n        {data?.items.map((p) => (\n          <li\n            key={p.id}\n            data-testid=\"product\"\n            className=\"flex flex-col overflow-hidden rounded-lg border bg-white shadow-sm\"\n          >\n            <div className=\"relative flex h-32 items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300 text-4xl font-bold text-slate-400\">\n              {p.name.charAt(0).toUpperCase()}\n              {p.stock <= 0 && (\n                <span className=\"absolute right-2 top-2 rounded bg-red-600 px-2 py-0.5 text-xs font-semibold text-white\">\n                  Out of stock\n                </span>\n              )}\n            </div>\n            <div className=\"flex flex-1 flex-col gap-1 p-3\">\n              <h3 className=\"font-semibold\">{p.name}</h3>\n              <p className=\"line-clamp-2 text-sm text-slate-600\">{p.description}</p>\n              <p className=\"mt-auto pt-2 font-medium\">{money(p.price)}</p>\n              <button\n                className=\"mt-2 rounded bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\"\n                disabled={p.stock <= 0}\n                onClick={() => onAdd(p.id)}\n              >\n                Add to cart\n              </button>\n            </div>\n          </li>\n        ))}\n      </ul>\n      <nav className=\"mt-6 flex items-center justify-center gap-3 text-sm\">\n        <button\n          className=\"rounded border px-3 py-1 disabled:opacity-40\"\n          disabled={page <= 1}\n          onClick={() => setPage(page - 1)}\n        >\n          Previous\n        </button>\n        <span>\n          Page {page} of {pages}\n        </span>\n        <button\n          className=\"rounded border px-3 py-1 disabled:opacity-40\"\n          disabled={page >= pages}\n          onClick={() => setPage(page + 1)}\n        >\n          Next\n        </button>\n      </nav>\n    </section>\n  );\n}\nEOF\ncat > src/CartPanel.tsx <<'EOF'\nimport { useState } from \"react\";\nimport { api, ApiError, money, type Cart } from \"./api\";\n\nexport default function CartPanel({\n  cart,\n  onClose,\n  onChanged,\n}: {\n  cart: Cart;\n  onClose: () => void;\n  onChanged: () => Promise<void>;\n}) {\n  const [error, setError] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n\n  const run = async (fn: () => Promise<unknown>) => {\n    setBusy(true);\n    setError(\"\");\n    try {\n      await fn();\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Something went wrong\");\n    }\n    await onChanged();\n    setBusy(false);\n  };\n\n  const setQty = (id: number, quantity: number) =>\n    run(() => api(\"PATCH\", `/cart/${id}`, { quantity }));\n  const remove = (id: number) => run(() => api(\"DELETE\", `/cart/${id}`));\n\n  return (\n    <aside\n      aria-label=\"Cart panel\"\n      className=\"fixed inset-y-0 right-0 z-20 flex w-full max-w-md flex-col border-l bg-white shadow-xl\"\n    >\n      <div className=\"flex items-center justify-between border-b px-4 py-3\">\n        <h2 className=\"text-lg font-semibold\">Your cart</h2>\n        <button className=\"rounded px-2 py-1 hover:bg-slate-100\" onClick={onClose}>\n          Close\n        </button>\n      </div>\n      <div className=\"flex-1 overflow-y-auto px-4 py-2\">\n        {error && (\n          <p role=\"alert\" className=\"my-2 rounded bg-red-50 px-3 py-2 text-sm text-red-700\">\n            {error}\n          </p>\n        )}\n        {cart.items.length === 0 && <p className=\"py-4 text-slate-600\">Your cart is empty.</p>}\n        <ul className=\"divide-y\">\n          {cart.items.map((i) => (\n            <li key={i.id} data-testid=\"cart-item\" className=\"flex items-center gap-3 py-3\">\n              <div className=\"min-w-0 flex-1\">\n                <p className=\"truncate font-medium\">{i.name}</p>\n                <p className=\"text-sm text-slate-600\">{money(i.unit_price)} each</p>\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <button\n                  aria-label={`Decrease quantity of ${i.name}`}\n                  className=\"h-7 w-7 rounded border disabled:opacity-40\"\n                  disabled={busy || i.quantity <= 1}\n                  onClick={() => setQty(i.id, i.quantity - 1)}\n                >\n                  -\n                </button>\n                <span className=\"w-8 text-center\" data-testid=\"quantity\">{i.quantity}</span>\n                <button\n                  aria-label={`Increase quantity of ${i.name}`}\n                  className=\"h-7 w-7 rounded border disabled:opacity-40\"\n                  disabled={busy}\n                  onClick={() => setQty(i.id, i.quantity + 1)}\n                >\n                  +\n                </button>\n              </div>\n              <p className=\"w-20 text-right font-medium\">{money(i.line_total)}</p>\n              <button\n                aria-label={`Remove ${i.name}`}\n                className=\"rounded px-2 py-1 text-sm text-red-700 hover:bg-red-50\"\n                disabled={busy}\n                onClick={() => remove(i.id)}\n              >\n                Remove\n              </button>\n            </li>\n          ))}\n        </ul>\n      </div>\n      <div className=\"flex items-center justify-between border-t px-4 py-3 text-lg font-semibold\">\n        <span>Subtotal</span>\n        <span data-testid=\"subtotal\">{money(cart.subtotal)}</span>\n      </div>\n    </aside>\n  );\n}\nEOF\ncat > src/AdminPanel.tsx <<'EOF'\nimport { useCallback, useEffect, useState, type FormEvent } from \"react\";\nimport { api, ApiError, type Page, type Product } from \"./api\";\n\nconst input = \"rounded border border-slate-300 px-2 py-1 text-sm\";\nconst btn =\n  \"rounded bg-slate-800 px-3 py-1 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-50\";\n\nfunction Row({ p, onSaved }: { p: Product; onSaved: () => void }) {\n  const [price, setPrice] = useState(String(p.price));\n  const [stock, setStock] = useState(String(p.stock));\n  const [active, setActive] = useState(p.is_active);\n  const [error, setError] = useState(\"\");\n\n  useEffect(() => {\n    setPrice(String(p.price));\n    setStock(String(p.stock));\n    setActive(p.is_active);\n  }, [p]);\n\n  const save = async () => {\n    setError(\"\");\n    const priceNum = Number(price);\n    const stockNum = Number(stock);\n    if (price.trim() === \"\" || stock.trim() === \"\") {\n      setError(\"Price and stock are required\");\n      return;\n    }\n    try {\n      await api(\"PATCH\", `/admin/products/${p.id}`, {\n        price: priceNum,\n        stock: stockNum,\n        is_active: active,\n      });\n      onSaved();\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Something went wrong\");\n    }\n  };\n\n  return (\n    <tr className=\"border-t align-top\">\n      <td className=\"py-2 pr-2\">{p.name}</td>\n      <td className=\"pr-2\">\n        <input\n          aria-label={`Price of ${p.name}`}\n          className={`${input} w-24`}\n          inputMode=\"decimal\"\n          value={price}\n          onChange={(e) => setPrice(e.target.value)}\n        />\n      </td>\n      <td className=\"pr-2\">\n        <input\n          aria-label={`Stock of ${p.name}`}\n          className={`${input} w-20`}\n          inputMode=\"numeric\"\n          value={stock}\n          onChange={(e) => setStock(e.target.value)}\n        />\n      </td>\n      <td className=\"pr-2\">\n        <input\n          type=\"checkbox\"\n          aria-label={`Active ${p.name}`}\n          checked={active}\n          onChange={(e) => setActive(e.target.checked)}\n        />\n      </td>\n      <td>\n        <button className={btn} onClick={save}>\n          Save\n        </button>\n        {error && <p role=\"alert\" className=\"mt-1 text-xs text-red-700\">{error}</p>}\n      </td>\n    </tr>\n  );\n}\n\nexport default function AdminPanel({ onChanged }: { onChanged: () => void }) {\n  const [items, setItems] = useState<Product[]>([]);\n  const [page, setPage] = useState(1);\n  const [total, setTotal] = useState(0);\n  const [error, setError] = useState(\"\");\n  const [name, setName] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [price, setPrice] = useState(\"\");\n  const [stock, setStock] = useState(\"0\");\n  const [formError, setFormError] = useState(\"\");\n  const size = 10;\n\n  const load = useCallback(async () => {\n    try {\n      const d = await api<Page>(\"GET\", `/admin/products?page=${page}&page_size=${size}`);\n      setItems(d.items);\n      setTotal(d.total);\n      setError(\"\");\n    } catch (e) {\n      setError(e instanceof ApiError ? e.message : \"Failed to load\");\n    }\n  }, [page]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const create = async (e: FormEvent) => {\n    e.preventDefault();\n    setFormError(\"\");\n    try {\n      await api(\"POST\", \"/admin/products\", {\n        name,\n        description,\n        price: Number(price),\n        stock: Number(stock),\n      });\n      setName(\"\");\n      setDescription(\"\");\n      setPrice(\"\");\n      setStock(\"0\");\n      await load();\n      onChanged();\n    } catch (err) {\n      setFormError(err instanceof ApiError ? err.message : \"Something went wrong\");\n    }\n  };\n\n  const pages = Math.max(1, Math.ceil(total / size));\n\n  return (\n    <section className=\"space-y-6\">\n      <form onSubmit={create} className=\"space-y-3 rounded-lg border bg-white p-4 shadow-sm\">\n        <h2 className=\"text-lg font-semibold\">Add product</h2>\n        <div className=\"flex flex-wrap gap-3\">\n          <input\n            className={`${input} w-48`}\n            placeholder=\"Name\"\n            aria-label=\"Name\"\n            value={name}\n            onChange={(e) => setName(e.target.value)}\n            required\n          />\n          <input\n            className={`${input} w-64`}\n            placeholder=\"Description\"\n            aria-label=\"Description\"\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n          />\n          <input\n            className={`${input} w-28`}\n            placeholder=\"Price\"\n            aria-label=\"Price\"\n            inputMode=\"decimal\"\n            value={price}\n            onChange={(e) => setPrice(e.target.value)}\n            required\n          />\n          <input\n            className={`${input} w-24`}\n            placeholder=\"Stock\"\n            aria-label=\"Stock\"\n            inputMode=\"numeric\"\n            value={stock}\n            onChange={(e) => setStock(e.target.value)}\n            required\n          />\n          <button className={btn} type=\"submit\">\n            Add\n          </button>\n        </div>\n        {formError && <p role=\"alert\" className=\"text-sm text-red-700\">{formError}</p>}\n      </form>\n\n      <div className=\"overflow-x-auto rounded-lg border bg-white p-4 shadow-sm\">\n        <h2 className=\"mb-2 text-lg font-semibold\">Products</h2>\n        {error && <p role=\"alert\" className=\"text-sm text-red-700\">{error}</p>}\n        <table className=\"w-full text-left text-sm\">\n          <thead>\n            <tr>\n              <th className=\"pb-2\">Name</th>\n              <th>Price</th>\n              <th>Stock</th>\n              <th>Active</th>\n              <th />\n            </tr>\n          </thead>\n          <tbody>\n            {items.map((p) => (\n              <Row\n                key={p.id}\n                p={p}\n                onSaved={() => {\n                  void load();\n                  onChanged();\n                }}\n              />\n            ))}\n          </tbody>\n        </table>\n        <div className=\"mt-4 flex items-center gap-3 text-sm\">\n          <button className=\"rounded border px-3 py-1 disabled:opacity-40\" disabled={page <= 1} onClick={() => setPage(page - 1)}>\n            Previous\n          </button>\n          <span>Page {page} of {pages}</span>\n          <button className=\"rounded border px-3 py-1 disabled:opacity-40\" disabled={page >= pages} onClick={() => setPage(page + 1)}>\n            Next\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}\nEOF\nnpm run typecheck 2>&1 | tail -20; npm run build 2>&1 | tail -8","time":{"start":1794251886732,"end":1794251888839}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1bf107b001VTOzJVo13TnVmo","sessionID":"ses_e3e440ebdffe3zs16pPnbKPW5e","messageID":"msg_1c1be435f001ggSKAbDKp4aHu6"}}
