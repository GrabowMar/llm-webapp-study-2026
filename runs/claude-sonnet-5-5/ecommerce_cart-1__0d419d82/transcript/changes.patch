+        raise ApiError(401, "Invalid username or password")
+    if not check_password_hash(row["password_hash"], password):
+        raise ApiError(401, "Invalid username or password")
+    token = issue_token(conn, row["id"])
+    return jsonify(token=token, username=row["username"], is_admin=False)
