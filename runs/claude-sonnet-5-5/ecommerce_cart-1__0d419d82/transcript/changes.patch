+    description = parse_text(data.get("description", ""), "description", 2000, False)
+    price = parse_price(data["price"])
+    stock = parse_int(data.get("stock", 0), "stock", 0, MAX_STOCK)
+    active = parse_bool(data.get("is_active", True), "is_active")
+    conn = db()
