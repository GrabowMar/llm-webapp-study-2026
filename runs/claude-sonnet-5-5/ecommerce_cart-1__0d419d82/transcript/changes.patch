+    if active_only:
+        sql += " AND p.is_active = 1"
+    row = db().execute(sql, (item_id, user["id"])).fetchone()
+    if row is None:
+        raise ApiError(404, "Cart item not found")
+    return row
+
+
+@app.patch("/api/cart/<int:item_id>")
