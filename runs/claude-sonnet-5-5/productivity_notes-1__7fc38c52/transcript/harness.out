{"type":"tool_use","timestamp":1794253646420,"sessionID":"ses_e3e27e7a7ffejmOdEJ70WaOTRm","part":{"type":"tool","tool":"bash","callID":"toolu_018pQwNoC8zo9k55W4AAPsd5","state":{"status":"completed","input":{"command":"cd /workspace/backend && cat > app.py <<'EOF'\n\"\"\"Flask entry point: tagged notes API and frontend host.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom itsdangerous import BadSignature, URLSafeTimedSerializer\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", Path.cwd() / \"data\"))\nDB_PATH = DATA_DIR / \"notes.db\"\nSECRET_PATH = DATA_DIR / \"secret.key\"\n\nTOKEN_MAX_AGE = 7 * 24 * 3600\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nTAG_RE = re.compile(r\"^[a-z0-9][a-z0-9_-]*$\")\nMAX_TITLE = 200\nMAX_CONTENT = 20000\nMAX_TAGS = 10\nMAX_TAG_LEN = 30\nMIN_PASSWORD = 8\nMAX_PASSWORD = 128\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 20\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\napp.json.sort_keys = False\n\n\ndef load_secret() -> str:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    try:\n        fd = os.open(SECRET_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n    except FileExistsError:\n        pass\n    else:\n        with os.fdopen(fd, \"w\") as f:\n            f.write(secrets.token_hex(32))\n    for _ in range(50):\n        value = SECRET_PATH.read_text().strip()\n        if value:\n            return value\n        import time\n\n        time.sleep(0.05)\n    raise RuntimeError(\"secret key unavailable\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS notes (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                title TEXT NOT NULL,\n                content TEXT NOT NULL,\n                pinned INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS notes_order\n                ON notes (pinned DESC, updated_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS notes_user ON notes (user_id);\n            CREATE TABLE IF NOT EXISTS note_tags (\n                note_id INTEGER NOT NULL REFERENCES notes(id) ON DELETE CASCADE,\n                tag TEXT NOT NULL,\n                position INTEGER NOT NULL,\n                PRIMARY KEY (note_id, tag)\n            );\n            CREATE INDEX IF NOT EXISTS note_tags_tag ON note_tags (tag);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\nserializer = URLSafeTimedSerializer(load_secret(), salt=\"auth-token\")\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef next_after(previous: str) -> str:\n    current = now_iso()\n    if current > previous:\n        return current\n    prev = datetime.strptime(previous, \"%Y-%m-%dT%H:%M:%S.%fZ\")\n    return (prev + timedelta(microseconds=1)).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef error(status: int, message: str, errors: dict | None = None):\n    body = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    resp = jsonify(body)\n    resp.status_code = status\n    return resp\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api\"):\n        return error(exc.code or 500, exc.description or exc.name)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef unexpected(exc: Exception):\n    app.logger.exception(\"unhandled error\", exc_info=exc)\n    return error(500, \"Internal server error\")\n\n\n@app.after_request\ndef headers(resp):\n    resp.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n    if request.path.startswith(\"/api\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    try:\n        user_id = serializer.loads(parts[1].strip(), max_age=TOKEN_MAX_AGE)\n    except BadSignature:\n        return None\n    if not isinstance(user_id, int):\n        return None\n    return db().execute(\n        \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n    ).fetchone()\n\n\nUNAUTHORIZED = \"Authentication required\"\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        errors[\"username\"] = (\n            \"Username must be 3-32 characters: letters, digits, '_', '.' or '-'\"\n        )\n    if not isinstance(password, str) or not (\n        MIN_PASSWORD <= len(password) <= MAX_PASSWORD\n    ):\n        errors[\"password\"] = (\n            f\"Password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters\"\n        )\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    username = username.strip()\n    try:\n        with db() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) \"\n                \"VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        return error(\n            409, \"Username is already taken\", {\"username\": \"Username is already taken\"}\n        )\n    user = db().execute(\n        \"SELECT id, username FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    resp = jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n    resp.status_code = 201\n    return resp\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"Username and password are required\")\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"Invalid username or password\")\n    return jsonify(\n        {\"token\": serializer.dumps(row[\"id\"]), \"username\": row[\"username\"]}\n    )\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    return {\"id\": user[\"id\"], \"username\": user[\"username\"]}\n\n\ndef normalize_tags(value):\n    if not isinstance(value, list):\n        return None, \"Tags must be a list of strings\"\n    tags = []\n    for item in value:\n        if not isinstance(item, str):\n            return None, \"Tags must be a list of strings\"\n        tag = item.strip().lower()\n        if not tag:\n            return None, \"Tags must not be empty\"\n        if len(tag) > MAX_TAG_LEN:\n            return None, f\"Each tag must be at most {MAX_TAG_LEN} characters\"\n        if not TAG_RE.match(tag):\n            return None, (\n                \"Tags may contain only letters, digits, '-' and '_' \"\n                \"and must start with a letter or digit\"\n            )\n        if tag not in tags:\n            tags.append(tag)\n    if len(tags) > MAX_TAGS:\n        return None, f\"A note can have at most {MAX_TAGS} tags\"\n    return tags, None\n\n\ndef validate_note(data: dict, partial: bool):\n    errors = {}\n    out = {}\n    if \"title\" in data or not partial:\n        title = data.get(\"title\")\n        if not isinstance(title, str) or not title.strip():\n            errors[\"title\"] = \"Title is required\"\n        elif len(title.strip()) > MAX_TITLE:\n            errors[\"title\"] = f\"Title must be at most {MAX_TITLE} characters\"\n        else:\n            out[\"title\"] = title.strip()\n    if \"content\" in data or not partial:\n        content = data.get(\"content\", \"\")\n        if not isinstance(content, str):\n            errors[\"content\"] = \"Content must be a string\"\n        elif len(content) > MAX_CONTENT:\n            errors[\"content\"] = f\"Content must be at most {MAX_CONTENT} characters\"\n        else:\n            out[\"content\"] = content\n    if \"tags\" in data or not partial:\n        tags, msg = normalize_tags(data.get(\"tags\", []))\n        if msg:\n            errors[\"tags\"] = msg\n        else:\n            out[\"tags\"] = tags\n    if \"pinned\" in data or not partial:\n        pinned = data.get(\"pinned\", False)\n        if not isinstance(pinned, bool):\n            errors[\"pinned\"] = \"Pinned must be true or false\"\n        else:\n            out[\"pinned\"] = pinned\n    return out, errors\n\n\nNOTE_SELECT = (\n    \"SELECT n.id, n.title, n.content, n.pinned, n.created_at, n.updated_at, \"\n    \"u.username AS author FROM notes n JOIN users u ON u.id = n.user_id\"\n)\n\n\ndef serialize(rows):\n    rows = list(rows)\n    tags: dict[int, list[str]] = {r[\"id\"]: [] for r in rows}\n    if rows:\n        marks = \",\".join(\"?\" for _ in rows)\n        for t in db().execute(\n            f\"SELECT note_id, tag FROM note_tags WHERE note_id IN ({marks}) \"\n            \"ORDER BY position\",\n            [r[\"id\"] for r in rows],\n        ):\n            tags[t[\"note_id\"]].append(t[\"tag\"])\n    return [\n        {\n            \"id\": r[\"id\"],\n            \"title\": r[\"title\"],\n            \"content\": r[\"content\"],\n            \"tags\": tags[r[\"id\"]],\n            \"pinned\": bool(r[\"pinned\"]),\n            \"created_at\": r[\"created_at\"],\n            \"updated_at\": r[\"updated_at\"],\n            \"author\": r[\"author\"],\n        }\n        for r in rows\n    ]\n\n\ndef fetch_note(note_id: int):\n    return db().execute(NOTE_SELECT + \" WHERE n.id = ?\", (note_id,)).fetchone()\n\n\ndef write_tags(conn, note_id: int, tags: list[str]):\n    conn.execute(\"DELETE FROM note_tags WHERE note_id = ?\", (note_id,))\n    conn.executemany(\n        \"INSERT INTO note_tags (note_id, tag, position) VALUES (?, ?, ?)\",\n        [(note_id, tag, i) for i, tag in enumerate(tags)],\n    )\n\n\ndef escape_like(value: str) -> str:\n    return value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\ndef int_param(name: str, default: int, maximum: int | None = None):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, f\"{name} must be an integer\"\n    if value < 1:\n        return None, f\"{name} must be at least 1\"\n    if maximum is not None and value > maximum:\n        return None, f\"{name} must be at most {maximum}\"\n    return value, None\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    errors = {}\n    page, msg = int_param(\"page\", 1)\n    if msg:\n        errors[\"page\"] = msg\n    page_size, msg = int_param(\"page_size\", DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)\n    if msg:\n        errors[\"page_size\"] = msg\n    if errors:\n        return error(400, \"Invalid query parameters\", errors)\n\n    where = []\n    params: list = []\n    tag = request.args.get(\"tag\", \"\").strip().lower()\n    if tag:\n        where.append(\"EXISTS (SELECT 1 FROM note_tags t WHERE t.note_id = n.id AND t.tag = ?)\")\n        params.append(tag)\n    author = request.args.get(\"author\", \"\").strip()\n    if author:\n        where.append(\"u.username = ?\")\n        params.append(author)\n    q = request.args.get(\"q\", \"\").strip()\n    if q:\n        like = f\"%{escape_like(q)}%\"\n        where.append(\n            \"(n.title LIKE ? ESCAPE '\\\\' OR n.content LIKE ? ESCAPE '\\\\')\"\n        )\n        params += [like, like]\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    total = db().execute(\n        \"SELECT COUNT(*) FROM notes n JOIN users u ON u.id = n.user_id\" + clause,\n        params,\n    ).fetchone()[0]\n    rows = db().execute(\n        NOTE_SELECT\n        + clause\n        + \" ORDER BY n.pinned DESC, n.updated_at DESC, n.id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return {\n        \"items\": serialize(rows),\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    values, errors = validate_note(data, partial=False)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    stamp = now_iso()\n    with db() as conn:\n        cur = conn.execute(\n            \"INSERT INTO notes (user_id, title, content, pinned, created_at, updated_at) \"\n            \"VALUES (?, ?, ?, ?, ?, ?)\",\n            (\n                user[\"id\"],\n                values[\"title\"],\n                values[\"content\"],\n                int(values[\"pinned\"]),\n                stamp,\n                stamp,\n            ),\n        )\n        write_tags(conn, cur.lastrowid, values[\"tags\"])\n    resp = jsonify(serialize([fetch_note(cur.lastrowid)])[0])\n    resp.status_code = 201\n    return resp\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    row = fetch_note(note_id)\n    if row is None:\n        return error(404, \"Note not found\")\n    return serialize([row])[0]\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\ndef update_note(note_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    row = fetch_note(note_id)\n    if row is None:\n        return error(404, \"Note not found\")\n    if row[\"author\"] != db().execute(\n        \"SELECT username FROM users WHERE id = ?\", (user[\"id\"],)\n    ).fetchone()[\"username\"]:\n        return error(403, \"Only the author may change this note\")\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    values, errors = validate_note(data, partial=True)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    with db() as conn:\n        owner = conn.execute(\n            \"SELECT user_id, updated_at FROM notes WHERE id = ?\", (note_id,)\n        ).fetchone()\n        if owner is None:\n            return error(404, \"Note not found\")\n        if owner[\"user_id\"] != user[\"id\"]:\n            return error(403, \"Only the author may change this note\")\n        sets = [\"updated_at = ?\"]\n        params: list = [next_after(owner[\"updated_at\"])]\n        for field in (\"title\", \"content\"):\n            if field in values:\n                sets.append(f\"{field} = ?\")\n                params.append(values[field])\n        if \"pinned\" in values:\n            sets.append(\"pinned = ?\")\n            params.append(int(values[\"pinned\"]))\n        params.append(note_id)\n        conn.execute(f\"UPDATE notes SET {', '.join(sets)} WHERE id = ?\", params)\n        if \"tags\" in values:\n            write_tags(conn, note_id, values[\"tags\"])\n    return serialize([fetch_note(note_id)])[0]\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\ndef delete_note(note_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    row = db().execute(\n        \"SELECT user_id FROM notes WHERE id = ?\", (note_id,)\n    ).fetchone()\n    if row is None:\n        return error(404, \"Note not found\")\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(403, \"Only the author may delete this note\")\n    with db() as conn:\n        conn.execute(\n            \"DELETE FROM notes WHERE id = ? AND user_id = ?\", (note_id, user[\"id\"])\n        )\n    return \"\", 204\n\n\n@app.get(\"/api/tags\")\ndef list_tags():\n    rows = db().execute(\n        \"SELECT tag, COUNT(*) AS count FROM note_tags \"\n        \"GROUP BY tag ORDER BY count DESC, tag ASC\"\n    ).fetchall()\n    return {\"items\": [{\"tag\": r[\"tag\"], \"count\": r[\"count\"]} for r in rows]}\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    return error(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF"},"output":"(no output)","metadata":{"output":"(no output)","exit":0,"truncated":false},"title":"cd /workspace/backend && cat > app.py <<'EOF'\n\"\"\"Flask entry point: tagged notes API and frontend host.\"\"\"\n\nimport os\nimport re\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom itsdangerous import BadSignature, URLSafeTimedSerializer\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nROOT = Path(__file__).resolve().parent.parent\nDIST = ROOT / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", Path.cwd() / \"data\"))\nDB_PATH = DATA_DIR / \"notes.db\"\nSECRET_PATH = DATA_DIR / \"secret.key\"\n\nTOKEN_MAX_AGE = 7 * 24 * 3600\nUSERNAME_RE = re.compile(r\"^[A-Za-z0-9_.-]{3,32}$\")\nTAG_RE = re.compile(r\"^[a-z0-9][a-z0-9_-]*$\")\nMAX_TITLE = 200\nMAX_CONTENT = 20000\nMAX_TAGS = 10\nMAX_TAG_LEN = 30\nMIN_PASSWORD = 8\nMAX_PASSWORD = 128\nMAX_PAGE_SIZE = 100\nDEFAULT_PAGE_SIZE = 20\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\napp.json.sort_keys = False\n\n\ndef load_secret() -> str:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    try:\n        fd = os.open(SECRET_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n    except FileExistsError:\n        pass\n    else:\n        with os.fdopen(fd, \"w\") as f:\n            f.write(secrets.token_hex(32))\n    for _ in range(50):\n        value = SECRET_PATH.read_text().strip()\n        if value:\n            return value\n        import time\n\n        time.sleep(0.05)\n    raise RuntimeError(\"secret key unavailable\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=15)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(\n            \"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n                password_hash TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS notes (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n                title TEXT NOT NULL,\n                content TEXT NOT NULL,\n                pinned INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            );\n            CREATE INDEX IF NOT EXISTS notes_order\n                ON notes (pinned DESC, updated_at DESC, id DESC);\n            CREATE INDEX IF NOT EXISTS notes_user ON notes (user_id);\n            CREATE TABLE IF NOT EXISTS note_tags (\n                note_id INTEGER NOT NULL REFERENCES notes(id) ON DELETE CASCADE,\n                tag TEXT NOT NULL,\n                position INTEGER NOT NULL,\n                PRIMARY KEY (note_id, tag)\n            );\n            CREATE INDEX IF NOT EXISTS note_tags_tag ON note_tags (tag);\n            \"\"\"\n        )\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\nserializer = URLSafeTimedSerializer(load_secret(), salt=\"auth-token\")\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc):\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef next_after(previous: str) -> str:\n    current = now_iso()\n    if current > previous:\n        return current\n    prev = datetime.strptime(previous, \"%Y-%m-%dT%H:%M:%S.%fZ\")\n    return (prev + timedelta(microseconds=1)).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef error(status: int, message: str, errors: dict | None = None):\n    body = {\"error\": message}\n    if errors:\n        body[\"errors\"] = errors\n    resp = jsonify(body)\n    resp.status_code = status\n    return resp\n\n\n@app.errorhandler(HTTPException)\ndef http_error(exc: HTTPException):\n    if request.path.startswith(\"/api\"):\n        return error(exc.code or 500, exc.description or exc.name)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef unexpected(exc: Exception):\n    app.logger.exception(\"unhandled error\", exc_info=exc)\n    return error(500, \"Internal server error\")\n\n\n@app.after_request\ndef headers(resp):\n    resp.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n    if request.path.startswith(\"/api\"):\n        resp.headers[\"Cache-Control\"] = \"no-store\"\n    return resp\n\n\ndef json_body():\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return None\n    return data\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    parts = header.split(None, 1)\n    if len(parts) != 2 or parts[0].lower() != \"bearer\":\n        return None\n    try:\n        user_id = serializer.loads(parts[1].strip(), max_age=TOKEN_MAX_AGE)\n    except BadSignature:\n        return None\n    if not isinstance(user_id, int):\n        return None\n    return db().execute(\n        \"SELECT id, username FROM users WHERE id = ?\", (user_id,)\n    ).fetchone()\n\n\nUNAUTHORIZED = \"Authentication required\"\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    errors = {}\n    if not isinstance(username, str) or not USERNAME_RE.match(username.strip()):\n        errors[\"username\"] = (\n            \"Username must be 3-32 characters: letters, digits, '_', '.' or '-'\"\n        )\n    if not isinstance(password, str) or not (\n        MIN_PASSWORD <= len(password) <= MAX_PASSWORD\n    ):\n        errors[\"password\"] = (\n            f\"Password must be {MIN_PASSWORD}-{MAX_PASSWORD} characters\"\n        )\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    username = username.strip()\n    try:\n        with db() as conn:\n            conn.execute(\n                \"INSERT INTO users (username, password_hash, created_at) \"\n                \"VALUES (?, ?, ?)\",\n                (username, generate_password_hash(password), now_iso()),\n            )\n    except sqlite3.IntegrityError:\n        return error(\n            409, \"Username is already taken\", {\"username\": \"Username is already taken\"}\n        )\n    user = db().execute(\n        \"SELECT id, username FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    resp = jsonify({\"id\": user[\"id\"], \"username\": user[\"username\"]})\n    resp.status_code = 201\n    return resp\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return error(400, \"Username and password are required\")\n    row = db().execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\",\n        (username.strip(),),\n    ).fetchone()\n    if row is None or not check_password_hash(row[\"password_hash\"], password):\n        return error(401, \"Invalid username or password\")\n    return jsonify(\n        {\"token\": serializer.dumps(row[\"id\"]), \"username\": row[\"username\"]}\n    )\n\n\n@app.get(\"/api/auth/me\")\ndef me():\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    return {\"id\": user[\"id\"], \"username\": user[\"username\"]}\n\n\ndef normalize_tags(value):\n    if not isinstance(value, list):\n        return None, \"Tags must be a list of strings\"\n    tags = []\n    for item in value:\n        if not isinstance(item, str):\n            return None, \"Tags must be a list of strings\"\n        tag = item.strip().lower()\n        if not tag:\n            return None, \"Tags must not be empty\"\n        if len(tag) > MAX_TAG_LEN:\n            return None, f\"Each tag must be at most {MAX_TAG_LEN} characters\"\n        if not TAG_RE.match(tag):\n            return None, (\n                \"Tags may contain only letters, digits, '-' and '_' \"\n                \"and must start with a letter or digit\"\n            )\n        if tag not in tags:\n            tags.append(tag)\n    if len(tags) > MAX_TAGS:\n        return None, f\"A note can have at most {MAX_TAGS} tags\"\n    return tags, None\n\n\ndef validate_note(data: dict, partial: bool):\n    errors = {}\n    out = {}\n    if \"title\" in data or not partial:\n        title = data.get(\"title\")\n        if not isinstance(title, str) or not title.strip():\n            errors[\"title\"] = \"Title is required\"\n        elif len(title.strip()) > MAX_TITLE:\n            errors[\"title\"] = f\"Title must be at most {MAX_TITLE} characters\"\n        else:\n            out[\"title\"] = title.strip()\n    if \"content\" in data or not partial:\n        content = data.get(\"content\", \"\")\n        if not isinstance(content, str):\n            errors[\"content\"] = \"Content must be a string\"\n        elif len(content) > MAX_CONTENT:\n            errors[\"content\"] = f\"Content must be at most {MAX_CONTENT} characters\"\n        else:\n            out[\"content\"] = content\n    if \"tags\" in data or not partial:\n        tags, msg = normalize_tags(data.get(\"tags\", []))\n        if msg:\n            errors[\"tags\"] = msg\n        else:\n            out[\"tags\"] = tags\n    if \"pinned\" in data or not partial:\n        pinned = data.get(\"pinned\", False)\n        if not isinstance(pinned, bool):\n            errors[\"pinned\"] = \"Pinned must be true or false\"\n        else:\n            out[\"pinned\"] = pinned\n    return out, errors\n\n\nNOTE_SELECT = (\n    \"SELECT n.id, n.title, n.content, n.pinned, n.created_at, n.updated_at, \"\n    \"u.username AS author FROM notes n JOIN users u ON u.id = n.user_id\"\n)\n\n\ndef serialize(rows):\n    rows = list(rows)\n    tags: dict[int, list[str]] = {r[\"id\"]: [] for r in rows}\n    if rows:\n        marks = \",\".join(\"?\" for _ in rows)\n        for t in db().execute(\n            f\"SELECT note_id, tag FROM note_tags WHERE note_id IN ({marks}) \"\n            \"ORDER BY position\",\n            [r[\"id\"] for r in rows],\n        ):\n            tags[t[\"note_id\"]].append(t[\"tag\"])\n    return [\n        {\n            \"id\": r[\"id\"],\n            \"title\": r[\"title\"],\n            \"content\": r[\"content\"],\n            \"tags\": tags[r[\"id\"]],\n            \"pinned\": bool(r[\"pinned\"]),\n            \"created_at\": r[\"created_at\"],\n            \"updated_at\": r[\"updated_at\"],\n            \"author\": r[\"author\"],\n        }\n        for r in rows\n    ]\n\n\ndef fetch_note(note_id: int):\n    return db().execute(NOTE_SELECT + \" WHERE n.id = ?\", (note_id,)).fetchone()\n\n\ndef write_tags(conn, note_id: int, tags: list[str]):\n    conn.execute(\"DELETE FROM note_tags WHERE note_id = ?\", (note_id,))\n    conn.executemany(\n        \"INSERT INTO note_tags (note_id, tag, position) VALUES (?, ?, ?)\",\n        [(note_id, tag, i) for i, tag in enumerate(tags)],\n    )\n\n\ndef escape_like(value: str) -> str:\n    return value.replace(\"\\\\\", \"\\\\\\\\\").replace(\"%\", \"\\\\%\").replace(\"_\", \"\\\\_\")\n\n\ndef int_param(name: str, default: int, maximum: int | None = None):\n    raw = request.args.get(name)\n    if raw is None or raw == \"\":\n        return default, None\n    try:\n        value = int(raw)\n    except ValueError:\n        return None, f\"{name} must be an integer\"\n    if value < 1:\n        return None, f\"{name} must be at least 1\"\n    if maximum is not None and value > maximum:\n        return None, f\"{name} must be at most {maximum}\"\n    return value, None\n\n\n@app.get(\"/api/notes\")\ndef list_notes():\n    errors = {}\n    page, msg = int_param(\"page\", 1)\n    if msg:\n        errors[\"page\"] = msg\n    page_size, msg = int_param(\"page_size\", DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)\n    if msg:\n        errors[\"page_size\"] = msg\n    if errors:\n        return error(400, \"Invalid query parameters\", errors)\n\n    where = []\n    params: list = []\n    tag = request.args.get(\"tag\", \"\").strip().lower()\n    if tag:\n        where.append(\"EXISTS (SELECT 1 FROM note_tags t WHERE t.note_id = n.id AND t.tag = ?)\")\n        params.append(tag)\n    author = request.args.get(\"author\", \"\").strip()\n    if author:\n        where.append(\"u.username = ?\")\n        params.append(author)\n    q = request.args.get(\"q\", \"\").strip()\n    if q:\n        like = f\"%{escape_like(q)}%\"\n        where.append(\n            \"(n.title LIKE ? ESCAPE '\\\\' OR n.content LIKE ? ESCAPE '\\\\')\"\n        )\n        params += [like, like]\n    clause = (\" WHERE \" + \" AND \".join(where)) if where else \"\"\n\n    total = db().execute(\n        \"SELECT COUNT(*) FROM notes n JOIN users u ON u.id = n.user_id\" + clause,\n        params,\n    ).fetchone()[0]\n    rows = db().execute(\n        NOTE_SELECT\n        + clause\n        + \" ORDER BY n.pinned DESC, n.updated_at DESC, n.id DESC LIMIT ? OFFSET ?\",\n        params + [page_size, (page - 1) * page_size],\n    ).fetchall()\n    return {\n        \"items\": serialize(rows),\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n\n@app.post(\"/api/notes\")\ndef create_note():\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    values, errors = validate_note(data, partial=False)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    stamp = now_iso()\n    with db() as conn:\n        cur = conn.execute(\n            \"INSERT INTO notes (user_id, title, content, pinned, created_at, updated_at) \"\n            \"VALUES (?, ?, ?, ?, ?, ?)\",\n            (\n                user[\"id\"],\n                values[\"title\"],\n                values[\"content\"],\n                int(values[\"pinned\"]),\n                stamp,\n                stamp,\n            ),\n        )\n        write_tags(conn, cur.lastrowid, values[\"tags\"])\n    resp = jsonify(serialize([fetch_note(cur.lastrowid)])[0])\n    resp.status_code = 201\n    return resp\n\n\n@app.get(\"/api/notes/<int:note_id>\")\ndef get_note(note_id: int):\n    row = fetch_note(note_id)\n    if row is None:\n        return error(404, \"Note not found\")\n    return serialize([row])[0]\n\n\n@app.patch(\"/api/notes/<int:note_id>\")\ndef update_note(note_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    row = fetch_note(note_id)\n    if row is None:\n        return error(404, \"Note not found\")\n    if row[\"author\"] != db().execute(\n        \"SELECT username FROM users WHERE id = ?\", (user[\"id\"],)\n    ).fetchone()[\"username\"]:\n        return error(403, \"Only the author may change this note\")\n    data = json_body()\n    if data is None:\n        return error(400, \"Request body must be a JSON object\")\n    values, errors = validate_note(data, partial=True)\n    if errors:\n        return error(400, \"Validation failed\", errors)\n    with db() as conn:\n        owner = conn.execute(\n            \"SELECT user_id, updated_at FROM notes WHERE id = ?\", (note_id,)\n        ).fetchone()\n        if owner is None:\n            return error(404, \"Note not found\")\n        if owner[\"user_id\"] != user[\"id\"]:\n            return error(403, \"Only the author may change this note\")\n        sets = [\"updated_at = ?\"]\n        params: list = [next_after(owner[\"updated_at\"])]\n        for field in (\"title\", \"content\"):\n            if field in values:\n                sets.append(f\"{field} = ?\")\n                params.append(values[field])\n        if \"pinned\" in values:\n            sets.append(\"pinned = ?\")\n            params.append(int(values[\"pinned\"]))\n        params.append(note_id)\n        conn.execute(f\"UPDATE notes SET {', '.join(sets)} WHERE id = ?\", params)\n        if \"tags\" in values:\n            write_tags(conn, note_id, values[\"tags\"])\n    return serialize([fetch_note(note_id)])[0]\n\n\n@app.delete(\"/api/notes/<int:note_id>\")\ndef delete_note(note_id: int):\n    user = current_user()\n    if user is None:\n        return error(401, UNAUTHORIZED)\n    row = db().execute(\n        \"SELECT user_id FROM notes WHERE id = ?\", (note_id,)\n    ).fetchone()\n    if row is None:\n        return error(404, \"Note not found\")\n    if row[\"user_id\"] != user[\"id\"]:\n        return error(403, \"Only the author may delete this note\")\n    with db() as conn:\n        conn.execute(\n            \"DELETE FROM notes WHERE id = ? AND user_id = ?\", (note_id, user[\"id\"])\n        )\n    return \"\", 204\n\n\n@app.get(\"/api/tags\")\ndef list_tags():\n    rows = db().execute(\n        \"SELECT tag, COUNT(*) AS count FROM note_tags \"\n        \"GROUP BY tag ORDER BY count DESC, tag ASC\"\n    ).fetchall()\n    return {\"items\": [{\"tag\": r[\"tag\"], \"count\": r[\"count\"]} for r in rows]}\n\n\n@app.route(\"/api\", defaults={\"path\": \"\"})\n@app.route(\"/api/<path:path>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(path: str):\n    return error(404, \"Not found\")\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    return send_from_directory(DIST, \"index.html\")\nEOF","time":{"start":1794253646381,"end":1794253646399}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1d9ea1e001SftIuzGaQyi8dK","sessionID":"ses_e3e27e7a7ffejmOdEJ70WaOTRm","messageID":"msg_1c1d92f37001mk5BTqbfEO0T4R"}}
