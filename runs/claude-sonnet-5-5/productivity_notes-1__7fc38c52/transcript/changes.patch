+def next_after(previous: str) -> str:
+    current = now_iso()
+    if current > previous:
+        return current
+    prev = datetime.strptime(previous, "%Y-%m-%dT%H:%M:%S.%fZ")
+    return (prev + timedelta(microseconds=1)).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
