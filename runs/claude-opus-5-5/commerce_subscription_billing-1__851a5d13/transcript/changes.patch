+import { useEffect, useState } from "react";
+import type { PublicStats } from "../api";
+import { STATUSES, STATUS_LABELS, api, errorMessage, formatMoney } from "../api";
+import { Alert, StatusBadge } from "../ui";
+
+export default function PublicPage() {
+  const [stats, setStats] = useState<PublicStats | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    api<PublicStats>("/public/stats")
+      .then(setStats)
+      .catch((e) => setError(errorMessage(e)));
+  }, []);
+
+  return (
+    <div className="space-y-6">
+      <div>
+        <h1 className="text-2xl font-bold text-slate-900">Public summary</h1>
+        <p className="text-sm text-slate-500">Monthly recurring revenue counts active and past-due subscriptions.</p>
+      </div>
+      {error && <Alert>{error}</Alert>}
+      {stats && (
+        <>
+          <div className="rounded-lg bg-indigo-600 p-6 text-white shadow-sm">
+            <div className="text-sm font-medium uppercase tracking-wide text-indigo-100">MRR</div>
+            <div className="mt-1 text-4xl font-bold" data-testid="mrr">
+              {formatMoney(stats.mrr)}
+            </div>
+          </div>
+          <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
+            {STATUSES.map((s) => (
+              <div key={s} className="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
+                <StatusBadge status={s} />
+                <div className="mt-3 text-3xl font-semibold text-slate-900">{stats.counts[s] ?? 0}</div>
+                <div className="text-sm text-slate-500">{STATUS_LABELS[s]} subscriptions</div>
+              </div>
+            ))}
+          </div>
+        </>
+      )}
+      {!stats && !error && <p className="text-sm text-slate-500">Loading…</p>}
+    </div>
+  );
+}
diff --git a/frontend/src/pages/SubscriptionPage.tsx b/frontend/src/pages/SubscriptionPage.tsx
new file mode 100644
index 0000000..9a5a83d
--- /dev/null
+++ b/frontend/src/pages/SubscriptionPage.tsx
@@ -0,0 +1,289 @@
+import { useCallback, useEffect, useState } from "react";
+import type { Invoice, Status, Subscription } from "../api";
+import { STATUSES, STATUS_LABELS, api, errorMessage, formatDateTime, formatMoney } from "../api";
+import { Alert, Button, Card, Field, Input, InvoiceBadge, Link, Select, StatusBadge } from "../ui";
+
+export default function SubscriptionPage({ id }: { id: number }) {
+  const [sub, setSub] = useState<Subscription | null>(null);
+  const [invoices, setInvoices] = useState<Invoice[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const load = useCallback(async () => {
+    try {
+      const [s, inv] = await Promise.all([
+        api<Subscription>(`/subscriptions/${id}`),
+        api<{ items: Invoice[] }>(`/subscriptions/${id}/invoices`),
+      ]);
+      setSub(s);
+      setInvoices(inv.items);
+      setError(null);
+    } catch (e) {
+      setError(errorMessage(e));
+    }
+  }, [id]);
+
+  useEffect(() => {
+    setSub(null);
+    load();
+  }, [load]);
+
+  async function collect(outcome: "failed" | "succeeded") {
+    setBusy(true);
+    setError(null);
+    setNotice(null);
+    try {
+      await api(`/subscriptions/${id}/collections`, { method: "POST", body: { outcome } });
+      setNotice(outcome === "succeeded" ? "Successful collection recorded." : "Failed collection recorded.");
+      await load();
+    } catch (e) {
+      setError(errorMessage(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const openInvoices = invoices.filter((i) => i.status === "open");
+  const openTotal = openInvoices.reduce((sum, i) => sum + Math.round(i.amount_due * 100), 0) / 100;
+
+  return (
+    <div className="space-y-5">
+      <Link href="/subscriptions" className="text-sm font-medium text-indigo-600 hover:underline">
+        ← Back to subscriptions
+      </Link>
+      {error && <Alert>{error}</Alert>}
+      {notice && <Alert kind="success">{notice}</Alert>}
+      {!sub && !error && <p className="text-sm text-slate-500">Loading…</p>}
+      {sub && (
+        <>
+          <div className="flex flex-wrap items-center gap-3">
+            <h1 className="text-2xl font-bold text-slate-900">{sub.customer_name}</h1>
+            <StatusBadge status={sub.status} />
+          </div>
+          <dl className="grid grid-cols-2 gap-4 md:grid-cols-4">
+            <Stat label="Plan" value={sub.plan} />
+            <Stat label="Monthly amount" value={formatMoney(sub.monthly_amount)} />
+            <Stat label="Renewal date" value={sub.renewal_date} />
+            <Stat label="Failed payments" value={String(sub.failed_payment_count)} />
+          </dl>
+
+          <div className="grid gap-5 lg:grid-cols-2">
+            <EditForm
+              sub={sub}
+              onSaved={(s) => {
+                setSub(s);
+                setNotice("Subscription saved.");
+                setError(null);
+              }}
+            />
+            <div className="space-y-5">
+              <IssueInvoice
+                sub={sub}
+                onIssued={async () => {
+                  setNotice("Invoice issued.");
+                  setError(null);
+                  await load();
+                }}
+              />
+              <Card title="Collection run">
+                <p className="mb-4 text-sm text-slate-600">
+                  {openInvoices.length} open invoice{openInvoices.length === 1 ? "" : "s"} totalling {formatMoney(openTotal)}.
+                </p>
+                <div className="flex flex-wrap gap-2">
+                  <Button variant="danger" disabled={busy || openInvoices.length === 0} onClick={() => collect("failed")}>
+                    Record failed collection
+                  </Button>
+                  <Button variant="success" disabled={busy || openInvoices.length === 0} onClick={() => collect("succeeded")}>
+                    Record successful collection
+                  </Button>
+                </div>
+              </Card>
+            </div>
+          </div>
+
+          <Card title="Invoice history">
+            <div className="overflow-x-auto">
+              <table className="min-w-full divide-y divide-slate-200 text-sm">
+                <thead className="text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
+                  <tr>
+                    <th className="py-2 pr-4">#</th>
+                    <th className="py-2 pr-4 text-right">Amount due</th>
+                    <th className="py-2 pr-4">Due date</th>
+                    <th className="py-2 pr-4">Status</th>
+                    <th className="py-2 pr-4">Paid at</th>
+                  </tr>
+                </thead>
+                <tbody className="divide-y divide-slate-100">
+                  {invoices.map((inv) => (
+                    <tr key={inv.id}>
+                      <td className="py-2 pr-4 text-slate-500">{inv.id}</td>
+                      <td className="py-2 pr-4 text-right tabular-nums">{formatMoney(inv.amount_due)}</td>
+                      <td className="py-2 pr-4">{inv.due_date}</td>
+                      <td className="py-2 pr-4">
+                        <InvoiceBadge status={inv.status} />
+                      </td>
+                      <td className="py-2 pr-4">{formatDateTime(inv.paid_at)}</td>
+                    </tr>
+                  ))}
+                  {invoices.length === 0 && (
+                    <tr>
+                      <td colSpan={5} className="py-6 text-center text-slate-500">
+                        No invoices yet.
+                      </td>
+                    </tr>
+                  )}
+                </tbody>
+              </table>
+            </div>
+          </Card>
+        </>
+      )}
+    </div>
+  );
+}
+
+function Stat({ label, value }: { label: string; value: string }) {
+  return (
+    <div className="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
+      <dt className="text-xs font-medium uppercase tracking-wide text-slate-500">{label}</dt>
+      <dd className="mt-1 text-lg font-semibold text-slate-900">{value}</dd>
+    </div>
+  );
+}
+
+function EditForm({ sub, onSaved }: { sub: Subscription; onSaved: (s: Subscription) => void }) {
+  const initial = () => ({
+    customer_name: sub.customer_name,
+    plan: sub.plan,
+    monthly_amount: String(sub.monthly_amount),
+    renewal_date: sub.renewal_date,
+    status: sub.status,
+  });
+  const [form, setForm] = useState(initial);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    setForm(initial());
+  }, [sub]);
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    const changes: Record<string, unknown> = {};
+    if (form.customer_name !== sub.customer_name) changes.customer_name = form.customer_name;
+    if (form.plan !== sub.plan) changes.plan = form.plan;
+    if (Number(form.monthly_amount) !== sub.monthly_amount) changes.monthly_amount = Number(form.monthly_amount);
+    if (form.renewal_date !== sub.renewal_date) changes.renewal_date = form.renewal_date;
+    if (form.status !== sub.status) changes.status = form.status;
+    if (Object.keys(changes).length === 0) {
+      setError("Nothing to save.");
+      return;
+    }
+    setBusy(true);
+    setError(null);
+    try {
+      const s = await api<Subscription>(`/subscriptions/${sub.id}`, { method: "PATCH", body: changes });
+      onSaved(s);
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <Card title="Edit subscription">
+      <form onSubmit={submit} className="space-y-4">
+        {error && <Alert>{error}</Alert>}
+        <Field label="Customer name">
+          <Input required maxLength={200} value={form.customer_name} onChange={(e) => setForm({ ...form, customer_name: e.target.value })} />
+        </Field>
+        <div className="grid gap-4 sm:grid-cols-2">
+          <Field label="Plan">
+            <Input required maxLength={100} value={form.plan} onChange={(e) => setForm({ ...form, plan: e.target.value })} />
+          </Field>
+          <Field label="Monthly amount">
+            <Input
+              required
+              type="number"
+              min="0"
+              step="0.01"
+              value={form.monthly_amount}
+              onChange={(e) => setForm({ ...form, monthly_amount: e.target.value })}
+            />
+          </Field>
+          <Field label="Renewal date">
+            <Input required type="date" value={form.renewal_date} onChange={(e) => setForm({ ...form, renewal_date: e.target.value })} />
+          </Field>
+          <Field label="Status">
+            <Select value={form.status} onChange={(e) => setForm({ ...form, status: e.target.value as Status })}>
+              {STATUSES.map((s) => (
+                <option key={s} value={s}>
+                  {STATUS_LABELS[s]}
+                </option>
+              ))}
+            </Select>
+          </Field>
+        </div>
+        <div className="flex gap-2">
+          <Button type="submit" disabled={busy}>
+            {busy ? "Saving…" : "Save changes"}
+          </Button>
+          <Button type="button" variant="secondary" onClick={() => setForm(initial())}>
+            Reset
+          </Button>
+        </div>
+      </form>
+    </Card>
+  );
+}
+
+function IssueInvoice({ sub, onIssued }: { sub: Subscription; onIssued: () => Promise<void> }) {
+  const [amount, setAmount] = useState(String(sub.monthly_amount));
+  const [dueDate, setDueDate] = useState(sub.renewal_date);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    setAmount(String(sub.monthly_amount));
+    setDueDate(sub.renewal_date);
+  }, [sub.id, sub.monthly_amount, sub.renewal_date]);
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      await api(`/subscriptions/${sub.id}/invoices`, {
+        method: "POST",
+        body: { amount_due: Number(amount), due_date: dueDate },
+      });
+      await onIssued();
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <Card title="Issue invoice">
+      <form onSubmit={submit} className="space-y-4">
+        {error && <Alert>{error}</Alert>}
+        <div className="grid gap-4 sm:grid-cols-2">
+          <Field label="Amount due">
+            <Input required type="number" min="0.01" step="0.01" value={amount} onChange={(e) => setAmount(e.target.value)} />
+          </Field>
+          <Field label="Due date">
+            <Input required type="date" value={dueDate} onChange={(e) => setDueDate(e.target.value)} />
+          </Field>
+        </div>
+        <Button type="submit" disabled={busy || sub.status === "cancelled"}>
+          {busy ? "Issuing…" : "Issue invoice"}
+        </Button>
+        {sub.status === "cancelled" && <p className="text-xs text-slate-500">Cancelled subscriptions cannot be invoiced.</p>}
+      </form>
+    </Card>
+  );
+}
diff --git a/frontend/src/pages/SubscriptionsPage.tsx b/frontend/src/pages/SubscriptionsPage.tsx
new file mode 100644
index 0000000..3264fcb
--- /dev/null
+++ b/frontend/src/pages/SubscriptionsPage.tsx
@@ -0,0 +1,280 @@
+import { useEffect, useState } from "react";
+import type { Page, Status, Subscription } from "../api";
+import { STATUSES, STATUS_LABELS, api, errorMessage, formatMoney } from "../api";
+import { navigate } from "../router";
+import { Alert, Button, Card, Field, Input, Link, Select, StatusBadge } from "../ui";
+
+const PAGE_SIZE = 10;
+
+function readParams(search: string) {
+  const p = new URLSearchParams(search);
+  const page = Math.max(1, parseInt(p.get("page") ?? "1", 10) || 1);
+  return { status: p.get("status") ?? "", plan: p.get("plan") ?? "", q: p.get("q") ?? "", page };
+}
+
+export default function SubscriptionsPage({ search }: { search: string }) {
+  const params = readParams(search);
+  const [data, setData] = useState<Page<Subscription> | null>(null);
+  const [plans, setPlans] = useState<string[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [query, setQuery] = useState(params.q);
+  const [showCreate, setShowCreate] = useState(false);
+  const [reload, setReload] = useState(0);
+
+  function update(next: Partial<ReturnType<typeof readParams>>) {
+    const merged = { ...params, page: 1, ...next };
+    const p = new URLSearchParams();
+    if (merged.status) p.set("status", merged.status);
+    if (merged.plan) p.set("plan", merged.plan);
+    if (merged.q) p.set("q", merged.q);
+    if (merged.page > 1) p.set("page", String(merged.page));
+    const qs = p.toString();
+    navigate(`/subscriptions${qs ? `?${qs}` : ""}`, true);
+  }
+
+  useEffect(() => {
+    setQuery(params.q);
+  }, [params.q]);
+
+  useEffect(() => {
+    const p = new URLSearchParams({ page: String(params.page), page_size: String(PAGE_SIZE) });
+    if (params.status) p.set("status", params.status);
+    if (params.plan) p.set("plan", params.plan);
+    if (params.q) p.set("q", params.q);
+    let cancelled = false;
+    setLoading(true);
+    api<Page<Subscription>>(`/subscriptions?${p}`)
+      .then((d) => {
+        if (!cancelled) {
+          setData(d);
+          setError(null);
+        }
+      })
+      .catch((e) => !cancelled && setError(errorMessage(e)))
+      .finally(() => !cancelled && setLoading(false));
+    return () => {
+      cancelled = true;
+    };
+  }, [params.page, params.status, params.plan, params.q, reload]);
+
+  useEffect(() => {
+    api<{ items: string[] }>("/plans")
+      .then((d) => setPlans(d.items))
+      .catch(() => {});
+  }, [reload]);
+
+  useEffect(() => {
+    const t = setTimeout(() => {
+      if (query.trim() !== params.q) update({ q: query.trim() });
+    }, 300);
+    return () => clearTimeout(t);
+  }, [query]);
+
+  const totalPages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;
+  const tabs: { key: string; label: string }[] = [{ key: "", label: "All" }, ...STATUSES.map((s) => ({ key: s, label: STATUS_LABELS[s] }))];
+
+  return (
+    <div className="space-y-5">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <h1 className="text-2xl font-bold text-slate-900">Subscriptions</h1>
+        <Button onClick={() => setShowCreate((v) => !v)}>{showCreate ? "Close" : "New subscription"}</Button>
+      </div>
+
+      {showCreate && (
+        <CreateSubscription
+          onCreated={(s) => {
+            setShowCreate(false);
+            navigate(`/subscriptions/${s.id}`);
+          }}
+        />
+      )}
+
+      <nav className="flex flex-wrap gap-1 border-b border-slate-200" aria-label="Status">
+        {tabs.map((t) => {
+          const active = params.status === t.key;
+          return (
+            <button
+              key={t.key || "all"}
+              role="tab"
+              aria-selected={active}
+              onClick={() => update({ status: t.key })}
+              className={`-mb-px border-b-2 px-4 py-2 text-sm font-medium ${
+                active ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
+              }`}
+            >
+              {t.label}
+            </button>
+          );
+        })}
+      </nav>
+
+      <div className="flex flex-wrap items-end gap-3">
+        <div className="w-full sm:w-64">
+          <Field label="Search customer">
+            <Input type="search" placeholder="Customer name…" value={query} onChange={(e) => setQuery(e.target.value)} />
+          </Field>
+        </div>
+        <div className="w-full sm:w-48">
+          <Field label="Plan">
+            <Select value={params.plan} onChange={(e) => update({ plan: e.target.value })}>
+              <option value="">All plans</option>
+              {plans.map((p) => (
+                <option key={p} value={p}>
+                  {p}
+                </option>
+              ))}
+              {params.plan && !plans.includes(params.plan) && <option value={params.plan}>{params.plan}</option>}
+            </Select>
+          </Field>
+        </div>
+        <Button variant="secondary" onClick={() => setReload((r) => r + 1)}>
+          Refresh
+        </Button>
+      </div>
+
+      {error && <Alert>{error}</Alert>}
+
+      <div className="overflow-x-auto rounded-lg bg-white shadow-sm ring-1 ring-slate-200">
+        <table className="min-w-full divide-y divide-slate-200 text-sm">
+          <thead className="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
+            <tr>
+              <th className="px-4 py-3">Customer</th>
+              <th className="px-4 py-3">Plan</th>
+              <th className="px-4 py-3 text-right">Monthly</th>
+              <th className="px-4 py-3">Renewal</th>
+              <th className="px-4 py-3">Status</th>
+              <th className="px-4 py-3 text-right">Failed payments</th>
+            </tr>
+          </thead>
+          <tbody className="divide-y divide-slate-100">
+            {data?.items.map((s) => (
+              <tr key={s.id} className="cursor-pointer hover:bg-slate-50" onClick={() => navigate(`/subscriptions/${s.id}`)}>
+                <td className="px-4 py-3 font-medium text-slate-900">
+                  <Link href={`/subscriptions/${s.id}`} className="hover:text-indigo-600" onClick={(e) => e.stopPropagation()}>
+                    {s.customer_name}
+                  </Link>
+                </td>
+                <td className="px-4 py-3 text-slate-700">{s.plan}</td>
+                <td className="px-4 py-3 text-right tabular-nums text-slate-700">{formatMoney(s.monthly_amount)}</td>
+                <td className="px-4 py-3 text-slate-700">{s.renewal_date}</td>
+                <td className="px-4 py-3">
+                  <StatusBadge status={s.status} />
+                </td>
+                <td className="px-4 py-3 text-right tabular-nums text-slate-700">{s.failed_payment_count}</td>
+              </tr>
+            ))}
+            {data && data.items.length === 0 && (
+              <tr>
+                <td colSpan={6} className="px-4 py-8 text-center text-slate-500">
+                  No subscriptions found.
+                </td>
+              </tr>
+            )}
+            {!data && (
+              <tr>
+                <td colSpan={6} className="px-4 py-8 text-center text-slate-500">
+                  {loading ? "Loading…" : ""}
+                </td>
+              </tr>
+            )}
+          </tbody>
+        </table>
+      </div>
+
+      {data && (
+        <div className="flex items-center justify-between text-sm text-slate-600">
+          <span>
+            {data.total} subscription{data.total === 1 ? "" : "s"} · page {data.page} of {totalPages}
+          </span>
+          <div className="flex gap-2">
+            <Button variant="secondary" disabled={params.page <= 1} onClick={() => update({ page: params.page - 1 })}>
+              Previous
+            </Button>
+            <Button variant="secondary" disabled={params.page >= totalPages} onClick={() => update({ page: params.page + 1 })}>
+              Next
+            </Button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function CreateSubscription({ onCreated }: { onCreated: (s: Subscription) => void }) {
+  const [form, setForm] = useState({
+    customer_name: "",
+    plan: "",
+    monthly_amount: "",
+    renewal_date: "",
+    status: "active" as Status,
+  });
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      const body: Record<string, unknown> = {
+        customer_name: form.customer_name,
+        plan: form.plan,
+        monthly_amount: Number(form.monthly_amount),
+        status: form.status,
+      };
+      if (form.renewal_date) body.renewal_date = form.renewal_date;
+      const s = await api<Subscription>("/subscriptions", { method: "POST", body });
+      onCreated(s);
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <Card title="New subscription">
+      <form onSubmit={submit} className="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
+        {error && (
+          <div className="sm:col-span-2 lg:col-span-5">
+            <Alert>{error}</Alert>
+          </div>
+        )}
+        <Field label="Customer name">
+          <Input required maxLength={200} value={form.customer_name} onChange={(e) => setForm({ ...form, customer_name: e.target.value })} />
+        </Field>
+        <Field label="Plan">
+          <Input required maxLength={100} value={form.plan} onChange={(e) => setForm({ ...form, plan: e.target.value })} />
+        </Field>
+        <Field label="Monthly amount">
+          <Input
+            required
+            type="number"
+            min="0"
+            step="0.01"
+            value={form.monthly_amount}
+            onChange={(e) => setForm({ ...form, monthly_amount: e.target.value })}
+          />
+        </Field>
+        <Field label="Renewal date">
+          <Input type="date" value={form.renewal_date} onChange={(e) => setForm({ ...form, renewal_date: e.target.value })} />
+        </Field>
+        <Field label="Status">
+          <Select value={form.status} onChange={(e) => setForm({ ...form, status: e.target.value as Status })}>
+            {STATUSES.map((s) => (
+              <option key={s} value={s}>
+                {STATUS_LABELS[s]}
+              </option>
+            ))}
+          </Select>
+        </Field>
+        <div className="sm:col-span-2 lg:col-span-5">
+          <Button type="submit" disabled={busy}>
+            {busy ? "Creating…" : "Create subscription"}
+          </Button>
+        </div>
+      </form>
+    </Card>
+  );
+}
diff --git a/frontend/src/router.ts b/frontend/src/router.ts
