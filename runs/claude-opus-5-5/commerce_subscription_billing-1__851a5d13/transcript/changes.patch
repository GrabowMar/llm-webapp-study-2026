+def get_subscription_row(conn: sqlite3.Connection, sub_id: int) -> sqlite3.Row:
+    row = conn.execute("SELECT * FROM subscriptions WHERE id = ?", (sub_id,)).fetchone()
+    if row is None:
+        raise ApiError(404, "Subscription not found")
+    return row
