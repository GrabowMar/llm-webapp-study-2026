n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n<pre><code class=\"language-py\">x\n</code></pre>\n\n","metadata":{"output":"{'a', 'article', 'details', 'ins', 'dd', 'q', 'thead', 'samp', 'dl', 'wbr', 'nav', 'tbody', 'rt', 'ruby', 'strike', 'header', 'small', 'figure', 'strong', 'p', 'i', 'figcaption', 'sup', 'caption', 'hgroup', 'h5', 'img', 'data', 'cite', 'h2', 'dfn', 'area', 'time', 'h3', 'div', 'rp', 'kbd', 'acronym', 'tr', 'abbr', 'sub', 'col', 'mark', 'hr', 'map', 'td', 'bdi', 'dt', 'tt', 'b', 'var', 'li', 'u', 'ul', 'del', 'footer', 'h6', 's', 'th', 'summary', 'center', 'ol', 'bdo', 'em', 'colgroup', 'blockquote', 'aside', 'span', 'pre', 'h4', 'br', 'table', 'h1', 'code', 'rtc'}\n{'img': {'src', 'alt', 'width', 'height', 'align'}, 'thead': {'align', 'charoff', 'char'}, 'tr': {'align', 'charoff', 'char'}, 'del': {'datetime', 'cite'}, 'table': {'align', 'summary', 'charoff', 'char'}, 'blockquote': {'cite'}, 'q': {'cite'}, 'ins': {'datetime', 'cite'}, 'tfoot': {'align', 'charoff', 'char'}, 'bdo': {'dir'}, 'tbody': {'align', 'charoff', 'char'}, 'a': {'href', 'hreflang'}, 'hr': {'align', 'size', 'width'}, 'td': {'rowspan', 'charoff', 'colspan', 'char', 'headers', 'align'}, 'ol': {'start'}, 'colgroup': {'align', 'span', 'charoff', 'char'}, 'col': {'align', 'span', 'charoff', 'char'}, 'th': {'rowspan', 'charoff', 'colspan', 'headers', 'char', 'scope', 'align'}}\n<h1>hi</h1>\n<p>&lt;script&gt;x&lt;/script&gt; [a](javascript:alert(1)) <s>s</s></p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n<pre><code class=\"language-py\">x\n</code></pre>\n\n","exit":0,"truncated":false},"title":".venv/bin/python -c \"\nimport nh3; print(nh3.ALLOWED_TAGS); print(nh3.ALLOWED_ATTRIBUTES)\nfrom markdown_it import MarkdownIt\nmd=MarkdownIt('commonmark',{'html':False}).enable(['table','strikethrough'])\nprint(md.render('# hi\\n\\n<script>x</script> [a](javascript:alert(1)) ~~s~~\\n\\n|a|b|\\n|-|-|\\n|1|2|\\n\\n\\`\\`\\`py\\nx\\n\\`\\`\\`'))\n\"","time":{"start":1794250608908,"end":1794250609067}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1ab9103001R0rgw3A3t1G3h9","sessionID":"ses_e3e565f43ffeFYniwGyz6OhCbl","messageID":"msg_1c1ab29a1001hbzdPgBp0Fqe5C"}}
