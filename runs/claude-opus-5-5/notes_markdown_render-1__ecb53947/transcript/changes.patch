diff --git a/frontend/src/App.tsx b/frontend/src/App.tsx
index fee9f48..f4cd0c1 100644
--- a/frontend/src/App.tsx
+++ b/frontend/src/App.tsx
@@ -1,3 +1,58 @@
+import { useCallback, useEffect, useState } from "react";
+import { api, clearSession, getSession, onUnauthorized, saveSession } from "./api";
+import AuthForm from "./components/AuthForm";
+import NotesApp from "./components/NotesApp";
+import PublicNotePage from "./components/PublicNotePage";
+import { navigate, usePath } from "./router";
+
 export default function App() {
-  return <h1>App</h1>;
+  const path = usePath();
+  const [session, setSession] = useState(getSession);
+
+  const signOut = useCallback((callServer = true) => {
+    if (callServer) void api.logout();
+    clearSession();
+    setSession(null);
+    navigate("/login", true);
+  }, []);
+
+  useEffect(() => {
+    onUnauthorized(() => signOut(false));
+    return () => onUnauthorized(null);
+  }, [signOut]);
+
+  const publicMatch = path.match(/^\/p\/(\d+)\/?$/);
+  const noteMatch = path.match(/^\/notes\/(\d+)\/?$/);
+  const isAuthPage = path === "/login" || path === "/register";
+  const isPublic = publicMatch !== null;
+
+  useEffect(() => {
+    if (isPublic) return;
+    document.title = "Markdown Notes";
+    if (!session && !isAuthPage) navigate("/login", true);
+    else if (session && isAuthPage) navigate("/", true);
+  }, [session, isAuthPage, isPublic]);
+
+  if (publicMatch) return <PublicNotePage id={Number(publicMatch[1])} />;
+
+  if (!session) {
+    return (
+      <AuthForm
+        mode={path === "/register" ? "register" : "login"}
+        onSignedIn={(token, username) => {
+          saveSession(token, username);
+          setSession({ token, username });
+          navigate("/", true);
+        }}
+      />
+    );
+  }
+
+  return (
+    <NotesApp
+      username={session.username}
+      selectedId={noteMatch ? Number(noteMatch[1]) : null}
+      onSignOut={() => signOut()}
+    />
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..91508d0
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,118 @@
+export type NoteSummary = {
+  id: number;
+  title: string;
+  published: boolean;
+  updated_at: string;
+};
+
+export type Note = NoteSummary & {
+  body: string;
+  author: string;
+};
+
+export type PublicNote = {
+  id: number;
+  title: string;
+  author: string;
+  updated_at: string;
+};
+
+export class ApiError extends Error {
+  status: number;
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+const TOKEN_KEY = "notes.token";
+const USER_KEY = "notes.username";
+
+export function getSession(): { token: string; username: string } | null {
+  const token = localStorage.getItem(TOKEN_KEY);
+  const username = localStorage.getItem(USER_KEY);
+  return token && username ? { token, username } : null;
+}
+
+export function saveSession(token: string, username: string) {
+  localStorage.setItem(TOKEN_KEY, token);
+  localStorage.setItem(USER_KEY, username);
+}
+
+export function clearSession() {
+  localStorage.removeItem(TOKEN_KEY);
+  localStorage.removeItem(USER_KEY);
+}
+
+let unauthorizedHandler: (() => void) | null = null;
+export function onUnauthorized(handler: (() => void) | null) {
+  unauthorizedHandler = handler;
+}
+
+async function request(
+  method: string,
+  path: string,
+  body?: unknown,
+  opts: { auth?: boolean; signal?: AbortSignal } = {},
+): Promise<Response> {
+  const headers: Record<string, string> = {};
+  const auth = opts.auth ?? true;
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  const session = getSession();
+  if (auth && session) headers["Authorization"] = `Bearer ${session.token}`;
+  const res = await fetch(`/api${path}`, {
+    method,
+    headers,
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal: opts.signal,
+  });
+  if (!res.ok) {
+    let message = res.statusText || `Request failed (${res.status})`;
+    try {
+      const data = await res.json();
+      if (data && typeof data.error === "string") message = data.error;
+    } catch {
+      /* ignore */
+    }
+    if (res.status === 401 && auth && session && unauthorizedHandler) unauthorizedHandler();
+    throw new ApiError(res.status, message);
+  }
+  return res;
+}
+
+async function json<T>(p: Promise<Response>): Promise<T> {
+  return (await p).json() as Promise<T>;
+}
+
+export const api = {
+  register: (username: string, password: string) =>
+    request("POST", "/auth/register", { username, password }, { auth: false }),
+  login: (username: string, password: string) =>
+    json<{ token: string; username?: string }>(
+      request("POST", "/auth/login", { username, password }, { auth: false }),
+    ),
+  logout: () => request("POST", "/auth/logout").catch(() => undefined),
+  listNotes: () => json<{ items: NoteSummary[] }>(request("GET", "/notes")),
+  createNote: (data: Partial<Pick<Note, "title" | "body" | "published">>) =>
+    json<Note>(request("POST", "/notes", data)),
+  getNote: (id: number) => json<Note>(request("GET", `/notes/${id}`)),
+  updateNote: (id: number, data: Partial<Pick<Note, "title" | "body" | "published">>) =>
+    json<Note>(request("PATCH", `/notes/${id}`, data)),
+  deleteNote: (id: number) => request("DELETE", `/notes/${id}`),
+  noteHtml: async (id: number, signal?: AbortSignal) =>
+    (await request("GET", `/notes/${id}/html`, undefined, { signal })).text(),
+  publicNote: (id: number) =>
+    json<PublicNote>(request("GET", `/public/notes/${id}`, undefined, { auth: false })),
+  publicNoteHtml: async (id: number) =>
+    (await request("GET", `/public/notes/${id}/html`, undefined, { auth: false })).text(),
+};
+
+export function publicUrl(id: number) {
+  return `${window.location.origin}/p/${id}`;
+}
+
+export function formatDate(iso: string) {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return iso;
+  return d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
+}
diff --git a/frontend/src/components/AuthForm.tsx b/frontend/src/components/AuthForm.tsx
new file mode 100644
index 0000000..d45e67b
--- /dev/null
+++ b/frontend/src/components/AuthForm.tsx
@@ -0,0 +1,104 @@
+import { useState, type FormEvent } from "react";
+import { api, ApiError } from "../api";
+import { navigate } from "../router";
+
+type Props = {
+  mode: "login" | "register";
+  onSignedIn: (token: string, username: string) => void;
+};
+
+export default function AuthForm({ mode, onSignedIn }: Props) {
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const isRegister = mode === "register";
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    setError(null);
+    if (!username.trim() || !password) {
+      setError("Username and password are required.");
+      return;
+    }
+    setBusy(true);
+    try {
+      if (isRegister) await api.register(username.trim(), password);
+      const res = await api.login(username.trim(), password);
+      onSignedIn(res.token, res.username ?? username.trim());
+    } catch (err) {
+      if (err instanceof ApiError) {
+        if (err.status === 409) setError("That username is already taken.");
+        else if (err.status === 401) setError("Invalid username or password.");
+        else setError(err.message);
+      } else setError("Could not reach the server.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="flex min-h-screen items-center justify-center bg-slate-50 px-4">
+      <div className="w-full max-w-sm">
+        <h1 className="mb-6 text-center text-2xl font-semibold text-slate-800">Markdown Notes</h1>
+        <form
+          onSubmit={submit}
+          className="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
+          aria-label={isRegister ? "Registration form" : "Sign-in form"}
+        >
+          <h2 className="text-lg font-medium text-slate-700">
+            {isRegister ? "Create an account" : "Sign in"}
+          </h2>
+          <label className="block">
+            <span className="mb-1 block text-sm font-medium text-slate-600">Username</span>
+            <input
+              name="username"
+              autoComplete="username"
+              autoFocus
+              value={username}
+              onChange={(e) => setUsername(e.target.value)}
+              className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
+            />
+          </label>
+          <label className="block">
+            <span className="mb-1 block text-sm font-medium text-slate-600">Password</span>
+            <input
+              name="password"
+              type="password"
+              autoComplete={isRegister ? "new-password" : "current-password"}
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
+            />
+          </label>
+          {error && (
+            <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+              {error}
+            </p>
+          )}
+          <button
+            type="submit"
+            disabled={busy}
+            className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+          >
+            {busy ? "Please wait…" : isRegister ? "Register" : "Sign in"}
+          </button>
+          <p className="text-center text-sm text-slate-500">
+            {isRegister ? "Already have an account? " : "No account yet? "}
+            <a
+              href={isRegister ? "/login" : "/register"}
+              onClick={(e) => {
+                e.preventDefault();
+                setError(null);
+                navigate(isRegister ? "/login" : "/register");
+              }}
+              className="font-medium text-indigo-600 hover:underline"
+            >
+              {isRegister ? "Sign in" : "Register"}
+            </a>
+          </p>
+        </form>
+      </div>
+    </div>
+  );
+}
