+
+def login_required(view):
+    @wraps(view)
+    def wrapper(*args, **kwargs):
+        user = current_user()
+        if user is None:
+            return error(401, "authentication required")
+        g.user = user
+        return view(*args, **kwargs)
+
+    return wrapper
