+TOKEN_TTL = timedelta(days=7)
+DEFAULT_PAGE_SIZE = 10
+MAX_PAGE_SIZE = 100
+DEFAULT_RECENT_LIMIT = 5
+MAX_RECENT_LIMIT = 100
