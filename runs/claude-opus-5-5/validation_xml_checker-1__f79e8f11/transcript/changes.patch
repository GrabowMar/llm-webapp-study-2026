+    setToken(newToken);
+    setUsername(name);
+  };
+
+  const handleSignOut = async () => {
+    if (token) await api.logout(token).catch(() => undefined);
+    signOutLocal();
+  };
+
+  const handleAuthError = useCallback(
+    (err: unknown) => {
+      if (err instanceof ApiError && err.status === 401) signOutLocal();
+    },
+    [signOutLocal],
