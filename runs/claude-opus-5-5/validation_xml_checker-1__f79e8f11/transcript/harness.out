300\"\n           }`}\n","filediff":{"file":"/workspace/frontend/src/components/Checker.tsx","patch":"Index: /workspace/frontend/src/components/Checker.tsx\n===================================================================\n--- /workspace/frontend/src/components/Checker.tsx\n+++ /workspace/frontend/src/components/Checker.tsx\n@@ -201,14 +201,14 @@\n \n <div className=\"flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-3 py-2\">\n   <div className=\"flex items-center gap-2\">\n     {token ? (\n-      <label className=\"flex cursor-pointer items-center gap-2 text-sm text-slate-700\">\n+      <div className=\"flex items-center gap-2 text-sm text-slate-700\">\n         <button\n           type=\"button\"\n           role=\"switch\"\n           aria-checked={save}\n-          aria-label=\"Save\"\n+          aria-labelledby=\"save-switch-label\"\n           onClick={() => setSave((s) => !s)}\n           className={`relative inline-flex h-5 w-9 items-center rounded-full transition-colors ${\n             save ? \"bg-blue-600\" : \"bg-slate-300\"\n           }`}\n","additions":2,"deletions":2},"truncated":false},"title":"frontend/src/components/Checker.tsx","time":{"start":1794250138848,"end":1794250138895}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1a464d5001b1OBOXRxFNVZ0I","sessionID":"ses_e3e623d17ffeUdo6wWXu4BtdnB","messageID":"msg_1c1a406dc001Gs3yS6RbBqpExM"}}
