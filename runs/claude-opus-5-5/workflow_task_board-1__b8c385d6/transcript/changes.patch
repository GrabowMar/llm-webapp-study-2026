+@app.post("/api/auth/logout")
+@login_required
+def logout():
+    token = request.headers.get("Authorization", "").partition(" ")[2].strip()
+    conn = db()
+    conn.execute("DELETE FROM tokens WHERE token_hash = ?", (hash_token(token),))
+    return "", 204
+
