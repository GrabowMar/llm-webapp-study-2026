{"type":"tool_use","timestamp":1794252641931,"sessionID":"ses_e3e3c21aeffe6lrXgrH6Q0fOV8","part":{"type":"tool","tool":"write","callID":"toolu_01Vc9semxfzkYZPxFniaEoas","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts","content":"export type Status = \"todo\" | \"in_progress\" | \"done\";\nexport type Priority = \"low\" | \"medium\" | \"high\";\n\nexport interface Task {\n  id: number;\n  title: string;\n  description: string;\n  status: Status;\n  priority: Priority;\n  position: number;\n  updated_at: string;\n}\n\nexport interface TaskList {\n  items: Task[];\n  total: number;\n  counts: Record<Status, number>;\n}\n\nexport interface TaskInput {\n  title?: string;\n  description?: string;\n  status?: Status;\n  priority?: Priority;\n  position?: number;\n}\n\nexport const STATUSES: { key: Status; label: string }[] = [\n  { key: \"todo\", label: \"To Do\" },\n  { key: \"in_progress\", label: \"In Progress\" },\n  { key: \"done\", label: \"Done\" },\n];\n\nexport const PRIORITIES: { key: Priority; label: string }[] = [\n  { key: \"low\", label: \"Low\" },\n  { key: \"medium\", label: \"Medium\" },\n  { key: \"high\", label: \"High\" },\n];\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"kanban.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = { Accept: \"application/json\" };\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const token = getToken();\n  if (token) headers.Authorization = `Bearer ${token}`;\n  let res: Response;\n  try {\n    res = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error. Please check your connection.\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const d = (data ?? {}) as { error?: string; errors?: Record<string, string> };\n    throw new ApiError(res.status, d.error ?? `Request failed (${res.status}).`, d.errors ?? {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string; token: string }>(\"POST\", \"/auth/register\", {\n      username,\n      password,\n    }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string }>(\"POST\", \"/auth/login\", { username, password }),\n  me: () => request<{ id: number; username: string }>(\"GET\", \"/auth/me\"),\n  logout: () => request<void>(\"POST\", \"/auth/logout\"),\n  listTasks: (priority?: Priority | \"\") =>\n    request<TaskList>(\"GET\", `/tasks${priority ? `?priority=${encodeURIComponent(priority)}` : \"\"}`),\n  createTask: (input: TaskInput) => request<Task>(\"POST\", \"/tasks\", input),\n  updateTask: (id: number, input: TaskInput) => request<Task>(\"PATCH\", `/tasks/${id}`, input),\n  deleteTask: (id: number) => request<void>(\"DELETE\", `/tasks/${id}`),\n};\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794252641902,"end":1794252641910}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1ca9668001X2fVP9C6WiUqbb","sessionID":"ses_e3e3c21aeffe6lrXgrH6Q0fOV8","messageID":"msg_1c1ca5242001j9yLdKmYTjM5xA"}}
