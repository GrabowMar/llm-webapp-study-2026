+import AuthPage from "./AuthPage";
+import { AuthProvider, useAuth } from "./auth";
+import Dashboard from "./Dashboard";
+import { Link, navigate, usePath } from "./router";
+import SensorPage from "./SensorPage";
+import { Button } from "./ui";
+
+function Header() {
+  const { username, logout } = useAuth();
+  return (
+    <header className="border-b border-slate-200 bg-white">
+      <div className="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
+        <Link to="/" className="flex items-center gap-2 text-lg font-bold text-slate-900">
+          <span className="inline-block h-3 w-3 rounded-full bg-emerald-500" />
+          Sensor Dashboard
+        </Link>
+        <nav className="flex items-center gap-3 text-sm">
+          {username ? (
+            <>
+              <span className="text-slate-600">
+                Signed in as <span className="font-semibold text-slate-900">{username}</span>
+              </span>
+              <Button
+                variant="secondary"
+                onClick={async () => {
+                  await logout();
+                  navigate("/");
+                }}
+              >
+                Sign out
+              </Button>
+            </>
+          ) : (
+            <>
+              <Link to="/login" className="font-medium text-slate-700 hover:text-indigo-600">
+                Sign in
+              </Link>
+              <Link
+                to="/register"
+                className="rounded-md bg-indigo-600 px-3 py-2 font-semibold text-white shadow-sm hover:bg-indigo-500"
+              >
+                Register
+              </Link>
+            </>
+          )}
+        </nav>
+      </div>
+    </header>
+  );
+}
+
+function Routes() {
+  const path = usePath();
+  const sensorMatch = path.match(/^\/sensors\/(\d+)\/?$/);
+  if (path === "/login") return <AuthPage mode="login" />;
+  if (path === "/register") return <AuthPage mode="register" />;
+  if (sensorMatch) return <SensorPage key={sensorMatch[1]} id={Number(sensorMatch[1])} />;
+  return <Dashboard />;
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  return (
+    <AuthProvider>
+      <div className="min-h-screen bg-slate-50 text-slate-900">
+        <Header />
+        <main className="mx-auto max-w-6xl px-4 py-8">
+          <Routes />
+        </main>
+      </div>
+    </AuthProvider>
+  );
 }
diff --git a/frontend/src/AuthPage.tsx b/frontend/src/AuthPage.tsx
new file mode 100644
index 0000000..5aeecd2
--- /dev/null
+++ b/frontend/src/AuthPage.tsx
@@ -0,0 +1,97 @@
+import { useState, type FormEvent } from "react";
+import { useAuth } from "./auth";
+import { navigate, Link } from "./router";
+import { Button, Card, ErrorMessage, Field, errorText } from "./ui";
+
+export default function AuthPage({ mode }: { mode: "login" | "register" }) {
+  const { login, register } = useAuth();
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [confirm, setConfirm] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const isRegister = mode === "register";
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    if (!username.trim() || !password) {
+      setError("Username and password are required");
+      return;
+    }
+    if (isRegister && password !== confirm) {
+      setError("Passwords do not match");
+      return;
+    }
+    setBusy(true);
+    try {
+      if (isRegister) await register(username.trim(), password);
+      else await login(username.trim(), password);
+      navigate("/");
+    } catch (err) {
+      setError(errorText(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="mx-auto max-w-sm">
+      <Card>
+        <h1 className="mb-4 text-xl font-semibold text-slate-900">{isRegister ? "Create an account" : "Sign in"}</h1>
+        <form onSubmit={submit} className="space-y-4">
+          <Field
+            label="Username"
+            name="username"
+            autoComplete="username"
+            value={username}
+            onChange={(e) => setUsername(e.target.value)}
+            required
+            autoFocus
+          />
+          <Field
+            label="Password"
+            name="password"
+            type="password"
+            autoComplete={isRegister ? "new-password" : "current-password"}
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            required
+          />
+          {isRegister && (
+            <Field
+              label="Confirm password"
+              name="confirm"
+              type="password"
+              autoComplete="new-password"
+              value={confirm}
+              onChange={(e) => setConfirm(e.target.value)}
+              required
+            />
+          )}
+          <ErrorMessage message={error} />
+          <Button type="submit" disabled={busy} className="w-full">
+            {busy ? "Please wait…" : isRegister ? "Register" : "Sign in"}
+          </Button>
+        </form>
+        <p className="mt-4 text-center text-sm text-slate-600">
+          {isRegister ? (
+            <>
+              Already have an account?{" "}
+              <Link to="/login" className="font-medium text-indigo-600 hover:text-indigo-500">
+                Sign in
+              </Link>
+            </>
+          ) : (
+            <>
+              No account yet?{" "}
+              <Link to="/register" className="font-medium text-indigo-600 hover:text-indigo-500">
+                Register
+              </Link>
+            </>
+          )}
+        </p>
+      </Card>
+    </div>
+  );
+}
diff --git a/frontend/src/Dashboard.tsx b/frontend/src/Dashboard.tsx
new file mode 100644
index 0000000..81794e5
--- /dev/null
+++ b/frontend/src/Dashboard.tsx
@@ -0,0 +1,119 @@
+import { useCallback, useState } from "react";
+import { api, type Sensor } from "./api";
+import { useAuth } from "./auth";
+import { DeleteSensorButton } from "./DeleteSensorButton";
+import { NewSensorForm, ReadingForm } from "./forms";
+import { formatValue, timeAgo, useNow, usePolling } from "./hooks";
+import { Link, navigate } from "./router";
+import { Card, ErrorMessage, errorText } from "./ui";
+
+export const REFRESH_MS = 10_000;
+
+function SensorCard({ sensor, now, canDelete, onDeleted }: { sensor: Sensor; now: number; canDelete: boolean; onDeleted: () => void }) {
+  return (
+    <Card className="flex flex-col transition hover:shadow-md hover:ring-indigo-200">
+      <div className="flex items-start justify-between gap-2">
+        <div className="min-w-0">
+          <Link to={`/sensors/${sensor.id}`} className="block truncate text-base font-semibold text-slate-900 hover:text-indigo-600">
+            {sensor.name}
+          </Link>
+          <p className="truncate text-sm text-slate-500">{sensor.location || "No location"}</p>
+        </div>
+        <span className="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{sensor.owner}</span>
+      </div>
+      <div className="mt-4 flex items-baseline gap-1">
+        <span className={`text-4xl font-bold tabular-nums ${sensor.last_value === null ? "text-slate-300" : "text-slate-900"}`}>
+          {formatValue(sensor.last_value)}
+        </span>
+        {sensor.unit && <span className="text-lg text-slate-500">{sensor.unit}</span>}
+      </div>
+      <p className="mt-1 text-xs text-slate-500" title={sensor.last_updated ?? undefined}>
+        {sensor.last_updated ? `Updated ${timeAgo(sensor.last_updated, now)}` : "No readings yet"}
+      </p>
+      <div className="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
+        <Link to={`/sensors/${sensor.id}`} className="text-sm font-medium text-indigo-600 hover:text-indigo-500">
+          View history →
+        </Link>
+        {canDelete && <DeleteSensorButton sensor={sensor} onDeleted={onDeleted} compact />}
+      </div>
+    </Card>
+  );
+}
+
+export default function Dashboard() {
+  const { username } = useAuth();
+  const now = useNow(1000);
+  const [sensors, setSensors] = useState<Sensor[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [lastRefresh, setLastRefresh] = useState<number | null>(null);
+
+  const load = useCallback(() => {
+    api
+      .listSensors()
+      .then((res) => {
+        setSensors(res.items);
+        setError(null);
+        setLastRefresh(Date.now());
+      })
+      .catch((err) => setError(errorText(err)));
+  }, []);
+
+  usePolling(load, REFRESH_MS);
+
+  const mine = (sensors ?? []).filter((s) => s.owner === username);
+
+  return (
+    <div className="space-y-6">
+      <div className="flex flex-wrap items-end justify-between gap-2">
+        <div>
+          <h1 className="text-2xl font-bold text-slate-900">Sensors</h1>
+          <p className="text-sm text-slate-500">
+            Live values, refreshed every 10 seconds
+            {lastRefresh && ` · last refresh ${timeAgo(new Date(lastRefresh).toISOString(), now)}`}
+          </p>
+        </div>
+      </div>
+
+      <ErrorMessage message={error} />
+
+      {username && (
+        <div className="grid gap-4 md:grid-cols-2">
+          <Card>
+            <NewSensorForm
+              onCreated={(s) => {
+                load();
+                navigate(`/sensors/${s.id}`);
+              }}
+            />
+          </Card>
+          <Card>
+            <ReadingForm sensors={mine} onPosted={load} />
+          </Card>
+        </div>
+      )}
+
+      {sensors === null ? (
+        <p className="text-sm text-slate-500">Loading sensors…</p>
+      ) : sensors.length === 0 ? (
+        <Card className="text-center text-sm text-slate-500">
+          No sensors registered yet.
+          {!username && (
+            <>
+              {" "}
+              <Link to="/register" className="font-medium text-indigo-600">
+                Create an account
+              </Link>{" "}
+              to add one.
+            </>
+          )}
+        </Card>
+      ) : (
+        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
+          {sensors.map((s) => (
+            <SensorCard key={s.id} sensor={s} now={now} canDelete={s.owner === username} onDeleted={load} />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/DeleteSensorButton.tsx b/frontend/src/DeleteSensorButton.tsx
new file mode 100644
index 0000000..30bbc54
--- /dev/null
+++ b/frontend/src/DeleteSensorButton.tsx
@@ -0,0 +1,77 @@
+import { useEffect, useRef, useState } from "react";
+import { api, type Sensor } from "./api";
+import { Button, ErrorMessage, errorText } from "./ui";
+
+export function DeleteSensorButton({
+  sensor,
+  onDeleted,
+  compact = false,
+}: {
+  sensor: Sensor;
+  onDeleted: () => void;
+  compact?: boolean;
+}) {
+  const [open, setOpen] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const d = dialogRef.current;
+    if (!d) return;
+    if (open && !d.open) d.showModal();
+    if (!open && d.open) d.close();
+  }, [open]);
+
+  const confirm = async () => {
+    setBusy(true);
+    setError(null);
+    try {
+      await api.deleteSensor(sensor.id);
+      setOpen(false);
+      onDeleted();
+    } catch (err) {
+      setError(errorText(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <>
+      {compact ? (
+        <button type="button" onClick={() => setOpen(true)} className="text-sm font-medium text-red-600 hover:text-red-500">
+          Delete
+        </button>
+      ) : (
+        <Button type="button" variant="danger" onClick={() => setOpen(true)}>
+          Delete sensor
+        </Button>
+      )}
+      <dialog
+        ref={dialogRef}
+        onClose={() => setOpen(false)}
+        className="m-auto w-full max-w-md rounded-xl p-0 shadow-xl backdrop:bg-slate-900/50"
+      >
+        <div className="p-6">
+          <h2 className="text-lg font-semibold text-slate-900">Delete sensor?</h2>
+          <p className="mt-2 text-sm text-slate-600">
+            This permanently deletes <span className="font-semibold">{sensor.name}</span> and all of its readings. This
+            cannot be undone.
+          </p>
+          <div className="mt-3">
+            <ErrorMessage message={error} />
+          </div>
+          <div className="mt-6 flex justify-end gap-2">
+            <Button type="button" variant="secondary" onClick={() => setOpen(false)} disabled={busy}>
+              Cancel
+            </Button>
+            <Button type="button" variant="danger" onClick={confirm} disabled={busy}>
+              {busy ? "Deleting…" : "Delete"}
+            </Button>
+          </div>
+        </div>
+      </dialog>
+    </>
+  );
+}
diff --git a/frontend/src/LineChart.tsx b/frontend/src/LineChart.tsx
new file mode 100644
index 0000000..d40e2fb
--- /dev/null
+++ b/frontend/src/LineChart.tsx
@@ -0,0 +1,165 @@
+import { useMemo, useRef, useState, type MouseEvent } from "react";
+import type { Reading } from "./api";
+import { formatDateTime, formatValue } from "./hooks";
+
+const W = 720;
+const H = 280;
+const PAD = { top: 16, right: 20, bottom: 36, left: 56 };
+
+function niceTicks(min: number, max: number, count = 5): number[] {
+  if (min === max) {
+    const d = Math.abs(min) * 0.1 || 1;
+    min -= d;
+    max += d;
+  }
+  const raw = (max - min) / count;
+  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
+  const norm = raw / mag;
+  const step = (norm >= 5 ? 10 : norm >= 2 ? 5 : norm >= 1 ? 2 : 1) * mag;
+  const start = Math.floor(min / step) * step;
+  const end = Math.ceil(max / step) * step;
+  const ticks: number[] = [];
+  for (let v = start; v <= end + step / 2; v += step) ticks.push(Number(v.toPrecision(12)));
+  return ticks;
+}
+
+function formatTime(t: number, spanMs: number): string {
+  const d = new Date(t);
+  if (spanMs > 2 * 24 * 3600 * 1000) return d.toLocaleDateString([], { month: "short", day: "numeric" });
+  if (spanMs > 3600 * 1000) return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
+  return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
+}
+
+export default function LineChart({ readings, unit }: { readings: Reading[]; unit: string }) {
+  const svgRef = useRef<SVGSVGElement>(null);
+  const [hover, setHover] = useState<number | null>(null);
+
+  const points = useMemo(
+    () =>
+      readings
+        .map((r) => ({ t: Date.parse(r.recorded_at), v: r.value, r }))
+        .filter((p) => !Number.isNaN(p.t))
+        .sort((a, b) => a.t - b.t || a.r.id - b.r.id),
+    [readings],
+  );
+
+  if (points.length === 0) {
+    return (
+      <div className="flex h-48 items-center justify-center rounded-lg border border-dashed border-slate-300 text-sm text-slate-500">
+        No readings yet
+      </div>
+    );
+  }
+
+  const values = points.map((p) => p.v);
+  const yTicks = niceTicks(Math.min(...values), Math.max(...values));
+  const yMin = yTicks[0];
+  const yMax = yTicks[yTicks.length - 1];
+  let tMin = points[0].t;
+  let tMax = points[points.length - 1].t;
+  if (tMin === tMax) {
+    tMin -= 30000;
+    tMax += 30000;
+  }
+  const iw = W - PAD.left - PAD.right;
+  const ih = H - PAD.top - PAD.bottom;
+  const x = (t: number) => PAD.left + ((t - tMin) / (tMax - tMin)) * iw;
+  const y = (v: number) => PAD.top + ih - ((v - yMin) / (yMax - yMin || 1)) * ih;
+
+  const path = points.map((p, i) => `${i ? "L" : "M"}${x(p.t).toFixed(1)},${y(p.v).toFixed(1)}`).join(" ");
+  const area = `${path} L${x(points[points.length - 1].t).toFixed(1)},${PAD.top + ih} L${x(points[0].t).toFixed(1)},${PAD.top + ih} Z`;
+  const xTickCount = Math.min(6, points.length > 1 ? 6 : 1);
+  const xTicks = Array.from({ length: xTickCount }, (_, i) =>
+    xTickCount === 1 ? (tMin + tMax) / 2 : tMin + ((tMax - tMin) * i) / (xTickCount - 1),
+  );
+
+  const onMove = (e: MouseEvent<SVGSVGElement>) => {
+    const svg = svgRef.current;
+    if (!svg) return;
+    const rect = svg.getBoundingClientRect();
+    const px = ((e.clientX - rect.left) / rect.width) * W;
+    let best = 0;
+    let bestD = Infinity;
+    points.forEach((p, i) => {
+      const d = Math.abs(x(p.t) - px);
+      if (d < bestD) {
+        bestD = d;
+        best = i;
+      }
+    });
+    setHover(best);
+  };
+
+  const hp = hover !== null ? points[hover] : null;
+
+  return (
+    <div className="relative">
+      <svg
+        ref={svgRef}
+        viewBox={`0 0 ${W} ${H}`}
+        className="h-auto w-full select-none"
+        onMouseMove={onMove}
+        onMouseLeave={() => setHover(null)}
+        role="img"
+        aria-label="Line chart of recent readings"
+      >
+        <defs>
+          <linearGradient id="area-fill" x1="0" x2="0" y1="0" y2="1">
+            <stop offset="0%" stopColor="rgb(79 70 229)" stopOpacity="0.25" />
+            <stop offset="100%" stopColor="rgb(79 70 229)" stopOpacity="0" />
+          </linearGradient>
+        </defs>
+        {yTicks.map((v) => (
+          <g key={v}>
+            <line x1={PAD.left} x2={W - PAD.right} y1={y(v)} y2={y(v)} className="stroke-slate-200" />
+            <text x={PAD.left - 8} y={y(v)} textAnchor="end" dominantBaseline="middle" className="fill-slate-500 text-[11px]">
+              {formatValue(v)}
+            </text>
+          </g>
+        ))}
+        {xTicks.map((t, i) => (
+          <text
+            key={i}
+            x={x(t)}
+            y={H - PAD.bottom + 18}
+            textAnchor={xTickCount === 1 ? "middle" : i === 0 ? "start" : i === xTickCount - 1 ? "end" : "middle"}
+            className="fill-slate-500 text-[11px]"
+          >
+            {formatTime(t, tMax - tMin)}
+          </text>
+        ))}
+        {unit && (
+          <text x={PAD.left} y={PAD.top - 4} className="fill-slate-400 text-[10px]">
+            {unit}
+          </text>
+        )}
+        <path d={area} fill="url(#area-fill)" />
+        <path d={path} fill="none" className="stroke-indigo-600" strokeWidth={2} strokeLinejoin="round" />
+        {points.length <= 60 &&
+          points.map((p) => (
+            <circle key={p.r.id} cx={x(p.t)} cy={y(p.v)} r={3} className="fill-white stroke-indigo-600" strokeWidth={1.5} />
+          ))}
+        {hp && (
+          <g>
+            <line x1={x(hp.t)} x2={x(hp.t)} y1={PAD.top} y2={PAD.top + ih} className="stroke-slate-400" strokeDasharray="4 3" />
+            <circle cx={x(hp.t)} cy={y(hp.v)} r={5} className="fill-indigo-600 stroke-white" strokeWidth={2} />
+          </g>
+        )}
+      </svg>
+      {hp && (
+        <div
+          className="pointer-events-none absolute top-2 rounded-md bg-slate-900 px-2 py-1 text-xs text-white shadow"
+          style={{
+            left: `${(x(hp.t) / W) * 100}%`,
+            transform: x(hp.t) > W / 2 ? "translateX(calc(-100% - 8px))" : "translateX(8px)",
+          }}
+        >
+          <div className="font-semibold">
+            {formatValue(hp.v)} {unit}
+          </div>
+          <div className="text-slate-300">{formatDateTime(hp.r.recorded_at)}</div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/SensorPage.tsx b/frontend/src/SensorPage.tsx
