{"type":"tool_use","timestamp":1794256176706,"sessionID":"ses_e3e029769ffeisrMdx9MsUggdV","part":{"type":"tool","tool":"write","callID":"toolu_013MrJwyiqjRTukDLwf6oP2d","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts","content":"export interface Link {\n  id: number;\n  original_url: string;\n  short_code: string;\n  click_count: number;\n  created_at: string;\n  short_url: string;\n  owner: string;\n  is_active: boolean;\n}\n\nexport interface Page<T> {\n  items: T[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface User {\n  username: string;\n  is_admin: boolean;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  constructor(status: number, message: string) {\n    super(message);\n    this.status = status;\n  }\n}\n\nconst TOKEN_KEY = \"shortener.token\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function setToken(token: string | null) {\n  if (token) localStorage.setItem(TOKEN_KEY, token);\n  else localStorage.removeItem(TOKEN_KEY);\n}\n\nlet onUnauthorized: (() => void) | null = null;\n\nexport function setUnauthorizedHandler(fn: (() => void) | null) {\n  onUnauthorized = fn;\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = { Accept: \"application/json\" };\n  const token = getToken();\n  if (token) headers.Authorization = `Bearer ${token}`;\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  let res: Response;\n  try {\n    res = await fetch(path, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Network error, please try again\");\n  }\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const message =\n      data && typeof data === \"object\" && \"error\" in data && typeof data.error === \"string\"\n        ? data.error\n        : `Request failed (${res.status})`;\n    if (res.status === 401 && token && onUnauthorized) onUnauthorized();\n    throw new ApiError(res.status, message);\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/api/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<{ token: string; username: string; is_admin: boolean }>(\"POST\", \"/api/auth/login\", {\n      username,\n      password,\n    }),\n  logout: () => request<void>(\"POST\", \"/api/auth/logout\"),\n  me: () => request<User>(\"GET\", \"/api/auth/me\"),\n  createLink: (original_url: string) => request<Link>(\"POST\", \"/api/links\", { original_url }),\n  listLinks: (page: number, pageSize: number) =>\n    request<Page<Link>>(\"GET\", `/api/links?page=${page}&page_size=${pageSize}`),\n  deleteLink: (id: number) => request<void>(\"DELETE\", `/api/links/${id}`),\n  adminLinks: (page: number, pageSize: number) =>\n    request<Page<Link>>(\"GET\", `/api/admin/links?page=${page}&page_size=${pageSize}`),\n  toggleLink: (id: number) => request<Link>(\"POST\", `/api/admin/links/${id}/toggle`),\n};\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794256176680,"end":1794256176688}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c2008623001exdBiTdpU4Y20Z","sessionID":"ses_e3e029769ffeisrMdx9MsUggdV","messageID":"msg_1c2005c480019iYtBGM7aP7gVI"}}
