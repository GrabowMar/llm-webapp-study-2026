+def get_link(link_id: int, include_inactive: bool = False):
+    sql = LINK_SELECT + " WHERE l.id = ?"
+    if not include_inactive:
+        sql += " AND l.is_active = 1"
+    return db().execute(sql, (link_id,)).fetchone()
+
