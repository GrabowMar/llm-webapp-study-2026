+import { useCallback, useEffect, useState } from "react";
+import AuthForm from "./AuthForm";
+import TodoList from "./TodoList";
+import { api, loadSession, onUnauthorized, saveSession, type Session } from "./api";
+
 export default function App() {
-  return <h1>App</h1>;
+  const [session, setSession] = useState<Session | null>(() => loadSession());
+
+  const signOut = useCallback(() => {
+    saveSession(null);
+    setSession(null);
+  }, []);
+
+  useEffect(() => {
+    onUnauthorized(signOut);
+    return () => onUnauthorized(null);
+  }, [signOut]);
+
+  function handleSignedIn(next: Session) {
+    saveSession(next);
+    setSession(next);
+  }
+
+  async function handleSignOut() {
+    await api.logout().catch(() => undefined);
+    signOut();
+  }
+
+  return (
+    <div className="min-h-screen bg-slate-50 text-slate-900">
+      {session ? (
+        <>
+          <header className="border-b border-slate-200 bg-white">
+            <div className="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
+              <h1 className="text-lg font-semibold">Todos</h1>
+              <div className="flex items-center gap-3">
+                <span className="text-sm text-slate-600">
+                  Signed in as <strong data-testid="current-user" className="font-semibold text-slate-900">{session.username}</strong>
+                </span>
+                <button
+                  type="button"
+                  onClick={handleSignOut}
+                  className="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
+                >
+                  Sign out
+                </button>
+              </div>
+            </div>
+          </header>
+          <main className="mx-auto max-w-3xl px-4 py-6">
+            <TodoList key={session.token} />
+          </main>
+        </>
+      ) : (
+        <main className="px-4">
+          <AuthForm onSignedIn={handleSignedIn} />
+        </main>
+      )}
+    </div>
+  );
 }
diff --git a/frontend/src/AuthForm.tsx b/frontend/src/AuthForm.tsx
new file mode 100644
index 0000000..744f433
--- /dev/null
+++ b/frontend/src/AuthForm.tsx
@@ -0,0 +1,106 @@
+import { useState, type FormEvent } from "react";
+import { ApiError, api, type Session } from "./api";
+
+interface Props {
+  onSignedIn: (session: Session) => void;
+}
+
+export default function AuthForm({ onSignedIn }: Props) {
+  const [mode, setMode] = useState<"login" | "register">("login");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});
+  const [busy, setBusy] = useState(false);
+
+  function switchMode(next: "login" | "register") {
+    setMode(next);
+    setError(null);
+    setFieldErrors({});
+  }
+
+  async function handleSubmit(event: FormEvent) {
+    event.preventDefault();
+    setBusy(true);
+    setError(null);
+    setFieldErrors({});
+    try {
+      if (mode === "register") {
+        await api.register(username, password);
+      }
+      const result = await api.login(username, password);
+      onSignedIn({ token: result.token, username: username.trim() });
+    } catch (err) {
+      if (err instanceof ApiError) {
+        setFieldErrors(err.errors);
+        if (Object.keys(err.errors).length === 0) setError(err.message);
+      } else {
+        setError("Something went wrong.");
+      }
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const tabClass = (active: boolean) =>
+    `flex-1 rounded-md px-3 py-2 text-sm font-medium transition ${
+      active ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700"
+    }`;
+
+  return (
+    <div className="mx-auto mt-16 w-full max-w-sm rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+      <h1 className="mb-6 text-center text-2xl font-semibold text-slate-900">Todos</h1>
+      <div className="mb-6 flex gap-1 rounded-lg bg-slate-100 p-1" role="tablist">
+        <button type="button" role="tab" aria-selected={mode === "login"} className={tabClass(mode === "login")} onClick={() => switchMode("login")}>
+          Sign in
+        </button>
+        <button type="button" role="tab" aria-selected={mode === "register"} className={tabClass(mode === "register")} onClick={() => switchMode("register")}>
+          Register
+        </button>
+      </div>
+      <form onSubmit={handleSubmit} className="space-y-4" noValidate>
+        <div>
+          <label htmlFor="username" className="mb-1 block text-sm font-medium text-slate-700">
+            Username
+          </label>
+          <input
+            id="username"
+            name="username"
+            autoComplete="username"
+            value={username}
+            onChange={(e) => setUsername(e.target.value)}
+            className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
+          />
+          {fieldErrors.username && <p className="mt-1 text-sm text-red-600">{fieldErrors.username}</p>}
+        </div>
+        <div>
+          <label htmlFor="password" className="mb-1 block text-sm font-medium text-slate-700">
+            Password
+          </label>
+          <input
+            id="password"
+            name="password"
+            type="password"
+            autoComplete={mode === "login" ? "current-password" : "new-password"}
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
+          />
+          {fieldErrors.password && <p className="mt-1 text-sm text-red-600">{fieldErrors.password}</p>}
+        </div>
+        {error && (
+          <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+            {error}
+          </p>
+        )}
+        <button
+          type="submit"
+          disabled={busy}
+          className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+        >
+          {busy ? "Please wait…" : mode === "login" ? "Sign in" : "Create account"}
+        </button>
+      </form>
+    </div>
+  );
+}
diff --git a/frontend/src/TodoForm.tsx b/frontend/src/TodoForm.tsx
new file mode 100644
index 0000000..69fcdb0
--- /dev/null
+++ b/frontend/src/TodoForm.tsx
@@ -0,0 +1,168 @@
+import { useState, type FormEvent } from "react";
+import { ApiError, PRIORITIES, type FieldErrors, type Priority, type Todo, type TodoInput } from "./api";
+
+interface Props {
+  initial?: Todo;
+  submitLabel: string;
+  onSubmit: (input: TodoInput) => Promise<void>;
+  onCancel?: () => void;
+  resetOnSuccess?: boolean;
+}
+
+const inputClass =
+  "w-full rounded-md border px-3 py-2 text-sm focus:ring-2 focus:outline-none";
+
+function fieldClass(hasError: boolean) {
+  return `${inputClass} ${
+    hasError
+      ? "border-red-400 focus:border-red-500 focus:ring-red-200"
+      : "border-slate-300 focus:border-indigo-500 focus:ring-indigo-200"
+  }`;
+}
+
+export default function TodoForm({ initial, submitLabel, onSubmit, onCancel, resetOnSuccess }: Props) {
+  const [title, setTitle] = useState(initial?.title ?? "");
+  const [description, setDescription] = useState(initial?.description ?? "");
+  const [priority, setPriority] = useState<Priority>(initial?.priority ?? "medium");
+  const [dueDate, setDueDate] = useState(initial?.due_date ?? "");
+  const [errors, setErrors] = useState<FieldErrors>({});
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const idPrefix = initial ? `edit-${initial.id}` : "new";
+
+  function buildInput(): TodoInput {
+    const values: TodoInput = {
+      title,
+      description: description === "" ? null : description,
+      priority,
+      due_date: dueDate === "" ? null : dueDate,
+    };
+    if (!initial) return values;
+    const changed: TodoInput = {};
+    if (values.title !== initial.title) changed.title = values.title;
+    if (values.description !== initial.description) changed.description = values.description;
+    if (values.priority !== initial.priority) changed.priority = values.priority;
+    if (values.due_date !== initial.due_date) changed.due_date = values.due_date;
+    return changed;
+  }
+
+  async function handleSubmit(event: FormEvent) {
+    event.preventDefault();
+    setBusy(true);
+    setErrors({});
+    setError(null);
+    try {
+      await onSubmit(buildInput());
+      if (resetOnSuccess) {
+        setTitle("");
+        setDescription("");
+        setPriority("medium");
+        setDueDate("");
+      }
+    } catch (err) {
+      if (err instanceof ApiError) {
+        setErrors(err.errors);
+        if (Object.keys(err.errors).length === 0) setError(err.message);
+      } else {
+        setError("Something went wrong.");
+      }
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form onSubmit={handleSubmit} noValidate className="space-y-3" aria-label={initial ? "Edit todo" : "Add todo"}>
+      <div>
+        <label htmlFor={`${idPrefix}-title`} className="sr-only">
+          Title
+        </label>
+        <input
+          id={`${idPrefix}-title`}
+          name="title"
+          placeholder="What needs to be done?"
+          value={title}
+          onChange={(e) => setTitle(e.target.value)}
+          className={fieldClass(!!errors.title)}
+          aria-invalid={!!errors.title}
+        />
+        {errors.title && <p className="mt-1 text-sm text-red-600">{errors.title}</p>}
+      </div>
+      <div>
+        <label htmlFor={`${idPrefix}-description`} className="sr-only">
+          Description
+        </label>
+        <textarea
+          id={`${idPrefix}-description`}
+          name="description"
+          placeholder="Description (optional)"
+          rows={2}
+          value={description}
+          onChange={(e) => setDescription(e.target.value)}
+          className={fieldClass(!!errors.description)}
+          aria-invalid={!!errors.description}
+        />
+        {errors.description && <p className="mt-1 text-sm text-red-600">{errors.description}</p>}
+      </div>
+      <div className="flex flex-wrap items-start gap-3">
+        <div>
+          <label htmlFor={`${idPrefix}-priority`} className="mb-1 block text-xs font-medium text-slate-500">
+            Priority
+          </label>
+          <select
+            id={`${idPrefix}-priority`}
+            name="priority"
+            value={priority}
+            onChange={(e) => setPriority(e.target.value as Priority)}
+            className={fieldClass(!!errors.priority)}
+          >
+            {PRIORITIES.map((p) => (
+              <option key={p} value={p}>
+                {p[0].toUpperCase() + p.slice(1)}
+              </option>
+            ))}
+          </select>
+          {errors.priority && <p className="mt-1 text-sm text-red-600">{errors.priority}</p>}
+        </div>
+        <div>
+          <label htmlFor={`${idPrefix}-due`} className="mb-1 block text-xs font-medium text-slate-500">
+            Due date
+          </label>
+          <input
+            id={`${idPrefix}-due`}
+            name="due_date"
+            type="date"
+            value={dueDate}
+            onChange={(e) => setDueDate(e.target.value)}
+            className={fieldClass(!!errors.due_date)}
+            aria-invalid={!!errors.due_date}
+          />
+          {errors.due_date && <p className="mt-1 text-sm text-red-600">{errors.due_date}</p>}
+        </div>
+        <div className="ml-auto flex gap-2 self-end">
+          {onCancel && (
+            <button
+              type="button"
+              onClick={onCancel}
+              className="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
+            >
+              Cancel
+            </button>
+          )}
+          <button
+            type="submit"
+            disabled={busy}
+            className="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+          >
+            {busy ? "Saving…" : submitLabel}
+          </button>
+        </div>
+      </div>
+      {error && (
+        <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+          {error}
+        </p>
+      )}
+    </form>
+  );
+}
diff --git a/frontend/src/TodoItem.tsx b/frontend/src/TodoItem.tsx
new file mode 100644
index 0000000..0ef24e7
--- /dev/null
+++ b/frontend/src/TodoItem.tsx
@@ -0,0 +1,126 @@
+import { useState } from "react";
+import TodoForm from "./TodoForm";
+import type { Priority, Todo, TodoInput } from "./api";
+
+interface Props {
+  todo: Todo;
+  today: string;
+  onToggle: (todo: Todo, completed: boolean) => Promise<void>;
+  onUpdate: (todo: Todo, input: TodoInput) => Promise<void>;
+  onDelete: (todo: Todo) => Promise<void>;
+}
+
+const priorityStyles: Record<Priority, string> = {
+  high: "bg-red-100 text-red-700 ring-red-200",
+  medium: "bg-amber-100 text-amber-800 ring-amber-200",
+  low: "bg-slate-100 text-slate-600 ring-slate-200",
+};
+
+function formatDate(value: string) {
+  const [y, m, d] = value.split("-").map(Number);
+  return new Date(y, m - 1, d).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
+}
+
+export default function TodoItem({ todo, today, onToggle, onUpdate, onDelete }: Props) {
+  const [editing, setEditing] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const overdue = !todo.completed && todo.due_date !== null && todo.due_date < today;
+
+  async function run(action: () => Promise<void>) {
+    setBusy(true);
+    setError(null);
+    try {
+      await action();
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Something went wrong.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  function handleDelete() {
+    if (!window.confirm(`Delete "${todo.title}"? This cannot be undone.`)) return;
+    void run(() => onDelete(todo));
+  }
+
+  if (editing) {
+    return (
+      <li className="border-b border-slate-100 bg-slate-50 px-4 py-4 last:border-b-0">
+        <TodoForm
+          initial={todo}
+          submitLabel="Save"
+          onCancel={() => setEditing(false)}
+          onSubmit={async (input) => {
+            await onUpdate(todo, input);
+            setEditing(false);
+          }}
+        />
+      </li>
+    );
+  }
+
+  return (
+    <li
+      data-testid="todo-item"
+      data-overdue={overdue || undefined}
+      className={`group flex items-start gap-3 border-b border-slate-100 px-4 py-3 last:border-b-0 ${
+        overdue ? "border-l-4 border-l-red-500 bg-red-50" : ""
+      }`}
+    >
+      <input
+        type="checkbox"
+        checked={todo.completed}
+        disabled={busy}
+        onChange={(e) => {
+          const checked = e.target.checked;
+          void run(() => onToggle(todo, checked));
+        }}
+        aria-label={`Mark "${todo.title}" as ${todo.completed ? "open" : "completed"}`}
+        className="mt-1 h-4 w-4 cursor-pointer rounded border-slate-300 accent-indigo-600"
+      />
+      <div className="min-w-0 flex-1">
+        <p className={`break-words text-sm font-medium ${todo.completed ? "text-slate-400 line-through" : "text-slate-900"}`}>
+          {todo.title}
+        </p>
+        {todo.description && (
+          <p className="mt-0.5 whitespace-pre-wrap break-words text-sm text-slate-500">{todo.description}</p>
+        )}
+        <div className="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
+          <span className={`rounded-full px-2 py-0.5 font-medium capitalize ring-1 ring-inset ${priorityStyles[todo.priority]}`}>
+            {todo.priority}
+          </span>
+          {todo.due_date && (
+            <span className={overdue ? "font-semibold text-red-600" : "text-slate-500"}>
+              {overdue ? "Overdue · " : "Due "}
+              <time dateTime={todo.due_date}>{formatDate(todo.due_date)}</time>
+            </span>
+          )}
+        </div>
+        {error && (
+          <p role="alert" className="mt-1 text-sm text-red-600">
+            {error}
+          </p>
+        )}
+      </div>
+      <div className="flex shrink-0 gap-1">
+        <button
+          type="button"
+          onClick={() => setEditing(true)}
+          disabled={busy}
+          className="rounded px-2 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100"
+        >
+          Edit
+        </button>
+        <button
+          type="button"
+          onClick={handleDelete}
+          disabled={busy}
+          className="rounded px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
+        >
+          Delete
+        </button>
+      </div>
+    </li>
+  );
+}
diff --git a/frontend/src/TodoList.tsx b/frontend/src/TodoList.tsx
new file mode 100644
index 0000000..91d2fee
--- /dev/null
+++ b/frontend/src/TodoList.tsx
@@ -0,0 +1,216 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import TodoForm from "./TodoForm";
+import TodoItem from "./TodoItem";
+import { api, PRIORITIES, type Priority, type Todo, type TodoInput } from "./api";
+
+const PAGE_SIZE = 10;
+
+type Tab = "all" | "open" | "completed";
+
+const TABS: { id: Tab; label: string }[] = [
+  { id: "all", label: "All" },
+  { id: "open", label: "Open" },
+  { id: "completed", label: "Completed" },
+];
+
+function localToday() {
+  const now = new Date();
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
+}
+
+function completedParam(tab: Tab) {
+  return tab === "all" ? undefined : tab === "completed";
+}
+
+export default function TodoList() {
+  const [tab, setTab] = useState<Tab>("all");
+  const [priority, setPriority] = useState<Priority | "">("");
+  const [items, setItems] = useState<Todo[]>([]);
+  const [pagesLoaded, setPagesLoaded] = useState(0);
+  const [total, setTotal] = useState(0);
+  const [remaining, setRemaining] = useState(0);
+  const [loading, setLoading] = useState(true);
+  const [loadingMore, setLoadingMore] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const requestId = useRef(0);
+
+  const fetchPages = useCallback(
+    async (pages: number) => {
+      const id = ++requestId.current;
+      const params = { completed: completedParam(tab), priority: priority || undefined, page_size: PAGE_SIZE };
+      const results = await Promise.all(
+        Array.from({ length: Math.max(pages, 1) }, (_, i) => api.listTodos({ ...params, page: i + 1 })),
+      );
+      if (id !== requestId.current) return;
+      const seen = new Set<number>();
+      const merged: Todo[] = [];
+      for (const result of results) {
+        for (const todo of result.items) {
+          if (!seen.has(todo.id)) {
+            seen.add(todo.id);
+            merged.push(todo);
+          }
+        }
+      }
+      const last = results[results.length - 1];
+      setItems(merged);
+      setTotal(last.total);
+      setRemaining(last.remaining);
+      setPagesLoaded(Math.max(pages, 1));
+      setError(null);
+    },
+    [tab, priority],
+  );
+
+  useEffect(() => {
+    setLoading(true);
+    fetchPages(1)
+      .catch((err: Error) => setError(err.message))
+      .finally(() => setLoading(false));
+  }, [fetchPages]);
+
+  const refresh = useCallback(() => fetchPages(pagesLoaded).catch((err: Error) => setError(err.message)), [fetchPages, pagesLoaded]);
+
+  async function loadMore() {
+    setLoadingMore(true);
+    const id = ++requestId.current;
+    try {
+      const result = await api.listTodos({
+        completed: completedParam(tab),
+        priority: priority || undefined,
+        page: pagesLoaded + 1,
+        page_size: PAGE_SIZE,
+      });
+      if (id !== requestId.current) return;
+      setItems((prev) => {
+        const ids = new Set(prev.map((t) => t.id));
+        return [...prev, ...result.items.filter((t) => !ids.has(t.id))];
+      });
+      setTotal(result.total);
+      setRemaining(result.remaining);
+      setPagesLoaded(pagesLoaded + 1);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Could not load more todos.");
+    } finally {
+      setLoadingMore(false);
+    }
+  }
+
+  async function handleCreate(input: TodoInput) {
+    await api.createTodo(input);
+    await refresh();
+  }
+
+  async function handleToggle(todo: Todo, completed: boolean) {
+    setItems((prev) => prev.map((t) => (t.id === todo.id ? { ...t, completed } : t)));
+    try {
+      await api.updateTodo(todo.id, { completed });
+    } finally {
+      await refresh();
+    }
+  }
+
+  async function handleUpdate(todo: Todo, input: TodoInput) {
+    if (Object.keys(input).length > 0) await api.updateTodo(todo.id, input);
+    await refresh();
+  }
+
+  async function handleDelete(todo: Todo) {
+    await api.deleteTodo(todo.id);
+    await refresh();
+  }
+
+  const today = localToday();
+  const hasMore = items.length < total;
+
+  return (
+    <div className="space-y-6">
+      <section className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
+        <h2 className="mb-3 text-sm font-semibold text-slate-700">Add a todo</h2>
+        <TodoForm submitLabel="Add" onSubmit={handleCreate} resetOnSuccess />
+      </section>
+
+      <section className="rounded-xl border border-slate-200 bg-white shadow-sm">
+        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
+          <div className="flex gap-1 rounded-lg bg-slate-100 p-1" role="tablist" aria-label="Filter by status">
+            {TABS.map((t) => (
+              <button
+                key={t.id}
+                type="button"
+                role="tab"
+                aria-selected={tab === t.id}
+                onClick={() => setTab(t.id)}
+                className={`rounded-md px-3 py-1.5 text-sm font-medium transition ${
+                  tab === t.id ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700"
+                }`}
+              >
+                {t.label}
+              </button>
+            ))}
+          </div>
+          <div className="flex items-center gap-3">
+            <label htmlFor="priority-filter" className="text-sm text-slate-500">
+              Priority
+            </label>
+            <select
+              id="priority-filter"
+              value={priority}
+              onChange={(e) => setPriority(e.target.value as Priority | "")}
+              className="rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
+            >
+              <option value="">All priorities</option>
+              {PRIORITIES.map((p) => (
+                <option key={p} value={p}>
+                  {p[0].toUpperCase() + p.slice(1)}
+                </option>
+              ))}
+            </select>
+          </div>
+        </div>
+
+        <p className="border-b border-slate-100 px-4 py-2 text-sm text-slate-600" data-testid="remaining-count">
+          <span className="font-semibold text-slate-900">{remaining}</span> open {remaining === 1 ? "todo" : "todos"}
+        </p>
+
+        {error && (
+          <p role="alert" className="mx-4 my-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+            {error}
+          </p>
+        )}
+
+        {loading ? (
+          <p className="px-4 py-8 text-center text-sm text-slate-500">Loading…</p>
+        ) : items.length === 0 ? (
+          <p className="px-4 py-8 text-center text-sm text-slate-500">No todos here.</p>
+        ) : (
+          <ul>
+            {items.map((todo) => (
+              <TodoItem
+                key={todo.id}
+                todo={todo}
+                today={today}
+                onToggle={handleToggle}
+                onUpdate={handleUpdate}
+                onDelete={handleDelete}
+              />
+            ))}
+          </ul>
+        )}
+
+        {!loading && hasMore && (
+          <div className="border-t border-slate-100 p-3 text-center">
+            <button
+              type="button"
+              onClick={loadMore}
+              disabled={loadingMore}
+              className="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-60"
+            >
+              {loadingMore ? "Loading…" : "Load more"}
+            </button>
+          </div>
+        )}
+      </section>
+    </div>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..b0629d3
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,120 @@
+export type Priority = "low" | "medium" | "high";
+
+export const PRIORITIES: Priority[] = ["low", "medium", "high"];
+
+export interface Todo {
+  id: number;
+  title: string;
+  description: string | null;
+  priority: Priority;
+  due_date: string | null;
+  completed: boolean;
+  completed_at: string | null;
+  created_at: string;
+}
+
+export interface TodoPage {
+  items: Todo[];
+  total: number;
+  page: number;
+  page_size: number;
+  remaining: number;
+}
+
+export interface TodoInput {
+  title?: string;
+  description?: string | null;
+  priority?: Priority;
+  due_date?: string | null;
+  completed?: boolean;
+}
+
+export type FieldErrors = Record<string, string>;
+
+export class ApiError extends Error {
+  status: number;
+  errors: FieldErrors;
+
+  constructor(status: number, message: string, errors: FieldErrors = {}) {
+    super(message);
+    this.status = status;
+    this.errors = errors;
+  }
+}
+
+const TOKEN_KEY = "todo.token";
+const USERNAME_KEY = "todo.username";
+
+export interface Session {
+  token: string;
+  username: string;
+}
+
+export function loadSession(): Session | null {
+  const token = localStorage.getItem(TOKEN_KEY);
+  const username = localStorage.getItem(USERNAME_KEY);
+  return token && username ? { token, username } : null;
+}
+
+export function saveSession(session: Session | null) {
+  if (session) {
+    localStorage.setItem(TOKEN_KEY, session.token);
+    localStorage.setItem(USERNAME_KEY, session.username);
+  } else {
+    localStorage.removeItem(TOKEN_KEY);
+    localStorage.removeItem(USERNAME_KEY);
+  }
+}
+
+let unauthorizedHandler: (() => void) | null = null;
+
+export function onUnauthorized(handler: (() => void) | null) {
+  unauthorizedHandler = handler;
+}
+
+async function request<T>(method: string, path: string, body?: unknown, auth = true): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  const session = loadSession();
+  if (auth && session) headers["Authorization"] = `Bearer ${session.token}`;
+
+  let response: Response;
+  try {
+    response = await fetch(`/api${path}`, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError(0, "Could not reach the server. Please try again.");
+  }
+
+  if (response.status === 204) return undefined as T;
+  const data = await response.json().catch(() => null);
+  if (!response.ok) {
+    if (response.status === 401 && auth) unauthorizedHandler?.();
+    const message = (data && typeof data.error === "string" && data.error) || `Request failed (${response.status}).`;
+    throw new ApiError(response.status, message, (data && data.errors) || {});
+  }
+  return data as T;
+}
+
+export const api = {
+  register: (username: string, password: string) =>
+    request<{ id: number; username: string }>("POST", "/auth/register", { username, password }, false),
+  login: (username: string, password: string) =>
+    request<{ token: string }>("POST", "/auth/login", { username, password }, false),
+  logout: () => request<void>("POST", "/auth/logout"),
+  me: () => request<{ id: number; username: string }>("GET", "/auth/me"),
+  listTodos: (params: { completed?: boolean; priority?: Priority; page: number; page_size: number }) => {
+    const query = new URLSearchParams();
+    if (params.completed !== undefined) query.set("completed", String(params.completed));
+    if (params.priority) query.set("priority", params.priority);
+    query.set("page", String(params.page));
+    query.set("page_size", String(params.page_size));
+    return request<TodoPage>("GET", `/todos?${query}`);
+  },
+  createTodo: (input: TodoInput) => request<Todo>("POST", "/todos", input),
+  updateTodo: (id: number, input: TodoInput) => request<Todo>("PATCH", `/todos/${id}`, input),
+  deleteTodo: (id: number) => request<void>("DELETE", `/todos/${id}`),
+};
