{"type":"tool_use","timestamp":1794253492661,"sessionID":"ses_e3e2c8327ffeEdHEddppyRWgly","part":{"type":"tool","tool":"write","callID":"toolu_01Fk4k3v5ZBoFaTDxWzSaGLN","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts","content":"export type Priority = \"low\" | \"medium\" | \"high\";\n\nexport const PRIORITIES: Priority[] = [\"low\", \"medium\", \"high\"];\n\nexport interface Todo {\n  id: number;\n  title: string;\n  description: string | null;\n  priority: Priority;\n  due_date: string | null;\n  completed: boolean;\n  completed_at: string | null;\n  created_at: string;\n}\n\nexport interface TodoPage {\n  items: Todo[];\n  total: number;\n  page: number;\n  page_size: number;\n  remaining: number;\n}\n\nexport interface TodoInput {\n  title?: string;\n  description?: string | null;\n  priority?: Priority;\n  due_date?: string | null;\n  completed?: boolean;\n}\n\nexport type FieldErrors = Record<string, string>;\n\nexport class ApiError extends Error {\n  status: number;\n  errors: FieldErrors;\n\n  constructor(status: number, message: string, errors: FieldErrors = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"todo.token\";\nconst USERNAME_KEY = \"todo.username\";\n\nexport interface Session {\n  token: string;\n  username: string;\n}\n\nexport function loadSession(): Session | null {\n  const token = localStorage.getItem(TOKEN_KEY);\n  const username = localStorage.getItem(USERNAME_KEY);\n  return token && username ? { token, username } : null;\n}\n\nexport function saveSession(session: Session | null) {\n  if (session) {\n    localStorage.setItem(TOKEN_KEY, session.token);\n    localStorage.setItem(USERNAME_KEY, session.username);\n  } else {\n    localStorage.removeItem(TOKEN_KEY);\n    localStorage.removeItem(USERNAME_KEY);\n  }\n}\n\nlet unauthorizedHandler: (() => void) | null = null;\n\nexport function onUnauthorized(handler: (() => void) | null) {\n  unauthorizedHandler = handler;\n}\n\nasync function request<T>(method: string, path: string, body?: unknown, auth = true): Promise<T> {\n  const headers: Record<string, string> = {};\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const session = loadSession();\n  if (auth && session) headers[\"Authorization\"] = `Bearer ${session.token}`;\n\n  let response: Response;\n  try {\n    response = await fetch(`/api${path}`, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server. Please try again.\");\n  }\n\n  if (response.status === 204) return undefined as T;\n  const data = await response.json().catch(() => null);\n  if (!response.ok) {\n    if (response.status === 401 && auth) unauthorizedHandler?.();\n    const message = (data && typeof data.error === \"string\" && data.error) || `Request failed (${response.status}).`;\n    throw new ApiError(response.status, message, (data && data.errors) || {});\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/auth/register\", { username, password }, false),\n  login: (username: string, password: string) =>\n    request<{ token: string; user?: { username: string } }>(\"POST\", \"/auth/login\", { username, password }, false),\n  logout: () => request<void>(\"POST\", \"/auth/logout\"),\n  me: () => request<{ id: number; username: string }>(\"GET\", \"/auth/me\"),\n  listTodos: (params: { completed?: boolean; priority?: Priority; page: number; page_size: number }) => {\n    const query = new URLSearchParams();\n    if (params.completed !== undefined) query.set(\"completed\", String(params.completed));\n    if (params.priority) query.set(\"priority\", params.priority);\n    query.set(\"page\", String(params.page));\n    query.set(\"page_size\", String(params.page_size));\n    return request<TodoPage>(\"GET\", `/todos?${query}`);\n  },\n  createTodo: (input: TodoInput) => request<Todo>(\"POST\", \"/todos\", input),\n  updateTodo: (id: number, input: TodoInput) => request<Todo>(\"PATCH\", `/todos/${id}`, input),\n  deleteTodo: (id: number) => request<void>(\"DELETE\", `/todos/${id}`),\n};\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794253492635,"end":1794253492643}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1d79195001nlLh8eIvMSewG7","sessionID":"ses_e3e2c8327ffeEdHEddppyRWgly","messageID":"msg_1c1d74c30001TiFJ83jo0rYmE7"}}
