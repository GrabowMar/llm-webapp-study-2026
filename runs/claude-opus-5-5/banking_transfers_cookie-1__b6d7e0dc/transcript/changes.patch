@@ -1,3 +1,105 @@
+import { useCallback, useEffect, useState } from "react";
+import { api, ApiError, formatMoney, getToken, onUnauthorized, setToken, type Account } from "./api";
+import AuthForm from "./AuthForm";
+import History from "./History";
+import TransferForm from "./TransferForm";
+
 export default function App() {
-  return <h1>App</h1>;
+  const [signedIn, setSignedIn] = useState<boolean>(() => getToken() !== null);
+  const [account, setAccount] = useState<Account | null>(null);
+  const [accountError, setAccountError] = useState<string | null>(null);
+  const [historyVersion, setHistoryVersion] = useState(0);
+
+  const signOutLocally = useCallback(() => {
+    setToken(null);
+    setAccount(null);
+    setSignedIn(false);
+  }, []);
+
+  useEffect(() => {
+    onUnauthorized(signOutLocally);
+    return () => onUnauthorized(null);
+  }, [signOutLocally]);
+
+  const loadAccount = useCallback(async () => {
+    try {
+      setAccount(await api.account());
+      setAccountError(null);
+    } catch (err) {
+      if (!(err instanceof ApiError && err.status === 401)) {
+        setAccountError(err instanceof Error ? err.message : "Could not load account.");
+      }
+    }
+  }, []);
+
+  useEffect(() => {
+    if (signedIn) void loadAccount();
+  }, [signedIn, loadAccount]);
+
+  const handleSignedIn = (token: string) => {
+    setToken(token);
+    setSignedIn(true);
+    setHistoryVersion((v) => v + 1);
+  };
+
+  const handleSignOut = async () => {
+    try {
+      await api.logout();
+    } catch {
+      /* the local session is cleared regardless */
+    }
+    signOutLocally();
+  };
+
+  const handleTransferred = () => {
+    void loadAccount();
+    setHistoryVersion((v) => v + 1);
+  };
+
+  if (!signedIn) {
+    return (
+      <div className="min-h-screen bg-slate-100 text-slate-900">
+        <AuthForm onSignedIn={handleSignedIn} />
+      </div>
+    );
+  }
+
+  return (
+    <div className="min-h-screen bg-slate-100 text-slate-900">
+      <header className="bg-indigo-700 text-white shadow">
+        <div className="mx-auto max-w-5xl px-4 py-6">
+          <div className="flex items-center justify-between gap-4">
+            <span className="text-lg font-semibold tracking-tight">Bank</span>
+            <div className="flex items-center gap-3 text-sm">
+              <span>
+                Signed in as{" "}
+                <strong className="font-semibold" data-testid="username">
+                  {account?.username ?? "…"}
+                </strong>
+              </span>
+              <button
+                type="button"
+                onClick={handleSignOut}
+                className="rounded-md bg-white/10 px-3 py-1.5 font-medium hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/60"
+              >
+                Sign out
+              </button>
+            </div>
+          </div>
+          <div className="mt-6">
+            <p className="text-sm uppercase tracking-wide text-indigo-200">Available balance</p>
+            <p className="mt-1 text-5xl font-bold tabular-nums" data-testid="balance">
+              {account ? formatMoney(account.balance) : "—"}
+            </p>
+            {accountError && <p className="mt-2 text-sm text-red-200">{accountError}</p>}
+          </div>
+        </div>
+      </header>
+
+      <main className="mx-auto grid max-w-5xl gap-6 px-4 py-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
+        <TransferForm balance={account?.balance ?? null} onTransferred={handleTransferred} />
+        <History version={historyVersion} />
+      </main>
+    </div>
+  );
 }
diff --git a/frontend/src/AuthForm.tsx b/frontend/src/AuthForm.tsx
new file mode 100644
index 0000000..54430b4
--- /dev/null
+++ b/frontend/src/AuthForm.tsx
@@ -0,0 +1,118 @@
+import { useState, type FormEvent } from "react";
+import { api } from "./api";
+
+type Mode = "login" | "register";
+
+export default function AuthForm({ onSignedIn }: { onSignedIn: (token: string) => void }) {
+  const [mode, setMode] = useState<Mode>("login");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const switchMode = (next: Mode) => {
+    setMode(next);
+    setError(null);
+  };
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setBusy(true);
+    try {
+      if (mode === "register") {
+        await api.register(username, password);
+      }
+      const { token } = await api.login(username, password);
+      onSignedIn(token);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Something went wrong.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const tabClass = (active: boolean) =>
+    `flex-1 rounded-md px-3 py-2 text-sm font-medium transition ${
+      active ? "bg-white text-indigo-700 shadow" : "text-slate-600 hover:text-slate-900"
+    }`;
+
+  return (
+    <div className="flex min-h-screen items-center justify-center px-4">
+      <div className="w-full max-w-sm">
+        <h1 className="mb-6 text-center text-3xl font-bold tracking-tight text-indigo-700">Bank</h1>
+        <div className="rounded-xl bg-white p-6 shadow-lg">
+          <div className="mb-6 flex gap-1 rounded-lg bg-slate-100 p-1" role="tablist">
+            <button
+              type="button"
+              role="tab"
+              aria-selected={mode === "login"}
+              className={tabClass(mode === "login")}
+              onClick={() => switchMode("login")}
+            >
+              Sign in
+            </button>
+            <button
+              type="button"
+              role="tab"
+              aria-selected={mode === "register"}
+              className={tabClass(mode === "register")}
+              onClick={() => switchMode("register")}
+            >
+              Register
+            </button>
+          </div>
+
+          <form onSubmit={submit} className="space-y-4">
+            <div>
+              <label htmlFor="username" className="block text-sm font-medium text-slate-700">
+                Username
+              </label>
+              <input
+                id="username"
+                name="username"
+                autoComplete="username"
+                required
+                value={username}
+                onChange={(e) => setUsername(e.target.value)}
+                className="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
+              />
+            </div>
+            <div>
+              <label htmlFor="password" className="block text-sm font-medium text-slate-700">
+                Password
+              </label>
+              <input
+                id="password"
+                name="password"
+                type="password"
+                autoComplete={mode === "login" ? "current-password" : "new-password"}
+                required
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                className="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
+              />
+            </div>
+
+            {error && (
+              <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+                {error}
+              </p>
+            )}
+
+            <button
+              type="submit"
+              disabled={busy}
+              className="w-full rounded-md bg-indigo-600 px-4 py-2 font-semibold text-white shadow hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300 disabled:opacity-60"
+            >
+              {busy ? "Please wait…" : mode === "login" ? "Sign in" : "Create account"}
+            </button>
+            {mode === "register" && (
+              <p className="text-center text-xs text-slate-500">New accounts start with 1,000.00.</p>
+            )}
+          </form>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/History.tsx b/frontend/src/History.tsx
new file mode 100644
index 0000000..c147555
--- /dev/null
+++ b/frontend/src/History.tsx
@@ -0,0 +1,121 @@
+import { useEffect, useState } from "react";
+import { api, formatDate, formatMoney, type TransferPage } from "./api";
+
+const PAGE_SIZE = 10;
+
+export default function History({ version }: { version: number }) {
+  const [page, setPage] = useState(1);
+  const [data, setData] = useState<TransferPage | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => {
+    setPage(1);
+  }, [version]);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    api
+      .listTransfers(page, PAGE_SIZE)
+      .then((result) => {
+        if (cancelled) return;
+        setData(result);
+        setError(null);
+      })
+      .catch((err: unknown) => {
+        if (!cancelled) setError(err instanceof Error ? err.message : "Could not load history.");
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [page, version]);
+
+  const totalPages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;
+
+  return (
+    <section className="rounded-xl bg-white p-6 shadow">
+      <div className="flex items-baseline justify-between">
+        <h2 className="text-lg font-semibold">Transaction history</h2>
+        {data && <span className="text-sm text-slate-500">{data.total} total</span>}
+      </div>
+
+      {error && (
+        <p role="alert" className="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+          {error}
+        </p>
+      )}
+
+      {data && data.items.length === 0 && !loading && (
+        <p className="mt-6 text-center text-sm text-slate-500">No transactions yet.</p>
+      )}
+
+      {data && data.items.length > 0 && (
+        <ul className={`mt-4 divide-y divide-slate-100 ${loading ? "opacity-60" : ""}`}>
+          {data.items.map((t) => {
+            const incoming = t.direction === "in";
+            const other = incoming ? t.from_username : t.to_username;
+            return (
+              <li key={t.id} className="flex items-start justify-between gap-4 py-3">
+                <div className="flex min-w-0 items-start gap-3">
+                  <span
+                    className={`mt-0.5 inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-xs font-semibold ${
+                      incoming ? "bg-green-100 text-green-800" : "bg-rose-100 text-rose-800"
+                    }`}
+                  >
+                    {incoming ? "IN" : "OUT"}
+                  </span>
+                  <div className="min-w-0">
+                    <p className="truncate text-sm font-medium">
+                      {incoming ? "From " : "To "}
+                      {other}
+                    </p>
+                    {t.memo && <p className="break-words text-sm text-slate-600">{t.memo}</p>}
+                    <p className="text-xs text-slate-400">
+                      <time dateTime={t.created_at}>{formatDate(t.created_at)}</time>
+                    </p>
+                  </div>
+                </div>
+                <span
+                  className={`shrink-0 font-semibold tabular-nums ${
+                    incoming ? "text-green-700" : "text-rose-700"
+                  }`}
+                >
+                  {incoming ? "+" : "−"}
+                  {formatMoney(t.amount)}
+                </span>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+
+      {data && data.total > 0 && (
+        <nav className="mt-4 flex items-center justify-between border-t border-slate-100 pt-4 text-sm">
+          <button
+            type="button"
+            onClick={() => setPage((p) => Math.max(1, p - 1))}
+            disabled={page <= 1 || loading}
+            className="rounded-md border border-slate-300 px-3 py-1.5 font-medium hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
+          >
+            Previous
+          </button>
+          <span className="text-slate-600">
+            Page {page} of {totalPages}
+          </span>
+          <button
+            type="button"
+            onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
+            disabled={page >= totalPages || loading}
+            className="rounded-md border border-slate-300 px-3 py-1.5 font-medium hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
+          >
+            Next
+          </button>
+        </nav>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/src/TransferForm.tsx b/frontend/src/TransferForm.tsx
new file mode 100644
index 0000000..3d497d7
--- /dev/null
+++ b/frontend/src/TransferForm.tsx
@@ -0,0 +1,182 @@
+import { useState, type FormEvent } from "react";
+import { api, formatMoney, type Transfer } from "./api";
+
+type Draft = { to: string; amount: number; memo: string };
+
+const inputClass =
+  "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200";
+
+export default function TransferForm({
+  balance,
+  onTransferred,
+}: {
+  balance: number | null;
+  onTransferred: () => void;
+}) {
+  const [to, setTo] = useState("");
+  const [amount, setAmount] = useState("");
+  const [memo, setMemo] = useState("");
+  const [draft, setDraft] = useState<Draft | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<Transfer | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const review = (e: FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setSuccess(null);
+    const recipient = to.trim();
+    if (!recipient) {
+      setError("Please enter a recipient.");
+      return;
+    }
+    if (!/^\d+(\.\d{1,2})?$/.test(amount.trim())) {
+      setError("Enter an amount like 25 or 25.50.");
+      return;
+    }
+    const value = Number(amount.trim());
+    if (!(value > 0)) {
+      setError("Amount must be greater than zero.");
+      return;
+    }
+    setDraft({ to: recipient, amount: value, memo: memo.trim() });
+  };
+
+  const confirm = async () => {
+    if (!draft) return;
+    setBusy(true);
+    setError(null);
+    try {
+      const transfer = await api.createTransfer(draft.to, draft.amount, draft.memo);
+      setSuccess(transfer);
+      setDraft(null);
+      setTo("");
+      setAmount("");
+      setMemo("");
+      onTransferred();
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Transfer failed.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const cancel = () => {
+    setDraft(null);
+    setError(null);
+  };
+
+  return (
+    <section className="h-fit rounded-xl bg-white p-6 shadow">
+      <h2 className="text-lg font-semibold">Send money</h2>
+
+      {draft ? (
+        <div className="mt-4 space-y-4" data-testid="confirm-transfer">
+          <p className="text-sm text-slate-600">Please review and confirm this transfer.</p>
+          <dl className="divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm">
+            <div className="flex justify-between gap-4 px-4 py-2">
+              <dt className="text-slate-500">Recipient</dt>
+              <dd className="break-all font-medium">{draft.to}</dd>
+            </div>
+            <div className="flex justify-between gap-4 px-4 py-2">
+              <dt className="text-slate-500">Amount</dt>
+              <dd className="font-semibold tabular-nums">{formatMoney(draft.amount)}</dd>
+            </div>
+            <div className="flex justify-between gap-4 px-4 py-2">
+              <dt className="text-slate-500">Memo</dt>
+              <dd className="break-all">{draft.memo || <span className="text-slate-400">—</span>}</dd>
+            </div>
+            {balance !== null && (
+              <div className="flex justify-between gap-4 px-4 py-2">
+                <dt className="text-slate-500">Current balance</dt>
+                <dd className="tabular-nums">{formatMoney(balance)}</dd>
+              </div>
+            )}
+          </dl>
+          {error && (
+            <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+              {error}
+            </p>
+          )}
+          <div className="flex gap-3">
+            <button
+              type="button"
+              onClick={cancel}
+              disabled={busy}
+              className="flex-1 rounded-md border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-60"
+            >
+              {error ? "Back" : "Cancel"}
+            </button>
+            <button
+              type="button"
+              onClick={confirm}
+              disabled={busy}
+              className="flex-1 rounded-md bg-indigo-600 px-4 py-2 font-semibold text-white shadow hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300 disabled:opacity-60"
+            >
+              {busy ? "Sending…" : "Confirm"}
+            </button>
+          </div>
+        </div>
+      ) : (
+        <form onSubmit={review} className="mt-4 space-y-4" noValidate>
+          <div>
+            <label htmlFor="to_username" className="block text-sm font-medium text-slate-700">
+              Recipient username
+            </label>
+            <input
+              id="to_username"
+              name="to_username"
+              autoComplete="off"
+              value={to}
+              onChange={(e) => setTo(e.target.value)}
+              className={inputClass}
+            />
+          </div>
+          <div>
+            <label htmlFor="amount" className="block text-sm font-medium text-slate-700">
+              Amount
+            </label>
+            <input
+              id="amount"
+              name="amount"
+              inputMode="decimal"
+              placeholder="0.00"
+              value={amount}
+              onChange={(e) => setAmount(e.target.value)}
+              className={`${inputClass} tabular-nums`}
+            />
+          </div>
+          <div>
+            <label htmlFor="memo" className="block text-sm font-medium text-slate-700">
+              Memo <span className="font-normal text-slate-400">(optional)</span>
+            </label>
+            <input
+              id="memo"
+              name="memo"
+              maxLength={200}
+              value={memo}
+              onChange={(e) => setMemo(e.target.value)}
+              className={inputClass}
+            />
+          </div>
+          {error && (
+            <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+              {error}
+            </p>
+          )}
+          {success && (
+            <p role="status" className="rounded-md bg-green-50 px-3 py-2 text-sm text-green-700">
+              Sent {formatMoney(success.amount)} to {success.to_username}.
+            </p>
+          )}
+          <button
+            type="submit"
+            className="w-full rounded-md bg-indigo-600 px-4 py-2 font-semibold text-white shadow hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300"
+          >
+            Review transfer
+          </button>
+        </form>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..115004c
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,126 @@
+export type Transfer = {
+  id: number;
+  from_username: string;
+  to_username: string;
+  amount: number;
+  memo: string;
+  created_at: string;
+  direction: "in" | "out";
+};
+
+export type TransferPage = {
+  items: Transfer[];
+  total: number;
+  page: number;
+  page_size: number;
+};
+
+export type Account = {
+  username: string;
+  balance: number;
+};
+
+export class ApiError extends Error {
+  status: number;
+
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+const TOKEN_KEY = "bank.token";
+
+let token: string | null = sessionStorage.getItem(TOKEN_KEY);
+let csrfToken: string | null = null;
+let unauthorizedHandler: (() => void) | null = null;
+
+export function getToken(): string | null {
+  return token;
+}
+
+export function setToken(value: string | null): void {
+  token = value;
+  csrfToken = null;
+  if (value) sessionStorage.setItem(TOKEN_KEY, value);
+  else sessionStorage.removeItem(TOKEN_KEY);
+}
+
+export function onUnauthorized(handler: (() => void) | null): void {
+  unauthorizedHandler = handler;
+}
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  const headers: Record<string, string> = { Accept: "application/json" };
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  if (token && method !== "GET") {
+    if (!csrfToken && path !== "/api/auth/csrf") {
+      csrfToken = (await request<{ csrf_token: string }>("GET", "/api/auth/csrf")).csrf_token;
+    }
+    if (csrfToken) headers["X-CSRF-Token"] = csrfToken;
+  }
+
+  let res: Response;
+  try {
+    res = await fetch(path, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+      credentials: "same-origin",
+    });
+  } catch {
+    throw new ApiError(0, "Could not reach the server. Please try again.");
+  }
+
+  let data: unknown = null;
+  const text = await res.text();
+  if (text) {
+    try {
+      data = JSON.parse(text);
+    } catch {
+      data = null;
+    }
+  }
+
+  if (!res.ok) {
+    const message =
+      data && typeof data === "object" && "error" in data && typeof data.error === "string"
+        ? data.error
+        : `Request failed (${res.status}).`;
+    if (res.status === 401 && token && unauthorizedHandler) unauthorizedHandler();
+    throw new ApiError(res.status, message);
+  }
+  return data as T;
+}
+
+export const api = {
+  register: (username: string, password: string) =>
+    request<{ username: string }>("POST", "/api/auth/register", { username, password }),
+  login: (username: string, password: string) =>
+    request<{ token: string }>("POST", "/api/auth/login", { username, password }),
+  logout: () => request<{ status: string }>("POST", "/api/auth/logout"),
+  account: () => request<Account>("GET", "/api/account"),
+  createTransfer: (to_username: string, amount: number, memo: string) =>
+    request<Transfer>("POST", "/api/transfers", { to_username, amount, memo }),
+  listTransfers: (page: number, pageSize: number) =>
+    request<TransferPage>(
+      "GET",
+      `/api/transfers?page=${encodeURIComponent(page)}&page_size=${encodeURIComponent(pageSize)}`,
+    ),
+};
+
+const money = new Intl.NumberFormat(undefined, {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+
+export function formatMoney(value: number): string {
+  return money.format(value);
+}
+
+export function formatDate(iso: string): string {
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return iso;
+  return d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
+}
