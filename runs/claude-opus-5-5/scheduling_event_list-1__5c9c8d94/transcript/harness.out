art_time\":\"bad\",\"end_time\":\"2026-11-08T11:00:00Z\"}'\ncurl -s -w ' %{http_code}\\n' -X POST $B/events -H \"Authorization: Bearer $T\" -H 'Content-Type: application/json' -d '{\"title\":\"C\",\"start_time\":\"2026-11-08T12:00:00Z\",\"end_time\":\"2026-11-08T11:00:00Z\"}'\ncurl -s -w ' %{http_code}\\n' \"$B/events\"\ncurl -s -w ' %{http_code}\\n' \"$B/events?start_date=2026-11-09&end_date=2026-11-09\"\ncurl -s -w ' %{http_code}\\n' \"$B/events?start_date=2026-11-08&end_date=2026-11-08\"\ncurl -s -w ' %{http_code}\\n' -X PUT $B/events/1 -H \"Authorization: Bearer $T\" -H 'Content-Type: application/json' -d '{\"title\":\"A2\",\"start_time\":\"2026-11-09T10:00:00\",\"end_time\":\"2026-11-09T12:00:00\"}'\ncurl -s -w ' %{http_code}\\n' -X DELETE $B/events/1 -H \"Authorization: Bearer $T\"\ncurl -s -w ' %{http_code}\\n' $B/events/1\ncurl -s -w ' %{http_code}\\n' $B/events/1 -X DELETE -H \"Authorization: Bearer bad\"\n"},"error":"The user has specified a rule which prevents you from using this specific tool call. Here are some of the relevant rules [{\"permission\":\"*\",\"action\":\"allow\",\"pattern\":\"*\"},{\"permission\":\"external_directory\",\"pattern\":\"*\",\"action\":\"ask\"},{\"permission\":\"external_directory\",\"pattern\":\"/run/home/.local/share/opencode/tool-output/*\",\"action\":\"allow\"},{\"permission\":\"external_directory\",\"pattern\":\"/tmp/opencode/*\",\"action\":\"allow\"},{\"permission\":\"external_directory\",\"action\":\"deny\",\"pattern\":\"*\"},{\"permission\":\"external_directory\",\"pattern\":\"/run/home/.local/share/opencode/tool-output/*\",\"action\":\"allow\"}]","time":{"start":1794254239810,"end":1794254239817}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1e2f838001OAUE2pr27WGa80","sessionID":"ses_e3e20d33dffe6FARsEDuJiDETu","messageID":"msg_1c1e2b558001V7TYBUOmLV5hB8"}}
