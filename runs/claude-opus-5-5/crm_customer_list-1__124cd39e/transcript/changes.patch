+def validate_customer(data):
+    errors = {}
+    values = {}
+    labels = {"name": "Name", "email": "Email", "phone": "Phone", "company": "Company", "notes": "Notes"}
+    for field, limit in FIELD_LIMITS.items():
+        raw = data.get(field)
