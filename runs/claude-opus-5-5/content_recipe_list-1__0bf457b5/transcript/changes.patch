+import { useAuth } from "./auth";
+import AuthPage from "./pages/AuthPage";
+import RecipeDetail from "./pages/RecipeDetail";
+import RecipeForm from "./pages/RecipeForm";
+import RecipeList from "./pages/RecipeList";
+import { Link, navigate, useLocation } from "./router";
+import { primaryButton, secondaryButton } from "./ui";
+
+function Route({ pathname, search }: { pathname: string; search: string }) {
+  if (pathname === "/") return <RecipeList search={search} />;
+  if (pathname === "/login") return <AuthPage key="login" mode="login" />;
+  if (pathname === "/register") return <AuthPage key="register" mode="register" />;
+  if (pathname === "/recipes/new") return <RecipeForm key="new" />;
+  let m = pathname.match(/^\/recipes\/(\d+)\/edit\/?$/);
+  if (m) return <RecipeForm key={`edit-${m[1]}`} id={Number(m[1])} />;
+  m = pathname.match(/^\/recipes\/(\d+)\/?$/);
+  if (m) return <RecipeDetail id={Number(m[1])} />;
+  return (
+    <div className="py-16 text-center">
+      <h1 className="mb-2 text-2xl font-semibold text-stone-900">Page not found</h1>
+      <Link to="/" className="text-amber-700 hover:underline">
+        Back to recipes
+      </Link>
+    </div>
+  );
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  const { pathname, search } = useLocation();
+  const { username, logout } = useAuth();
+
+  return (
+    <div className="min-h-screen bg-stone-50 text-stone-900">
+      <header className="border-b border-stone-200 bg-white">
+        <div className="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4">
+          <Link to="/" className="text-xl font-bold text-amber-700">
+            Recipe Book
+          </Link>
+          <nav className="flex flex-wrap items-center gap-3">
+            {username ? (
+              <>
+                <Link to="/recipes/new" className={primaryButton}>
+                  Add recipe
+                </Link>
+                <span className="text-sm text-stone-600">
+                  Signed in as <strong className="text-stone-900">{username}</strong>
+                </span>
+                <button
+                  type="button"
+                  className={secondaryButton}
+                  onClick={async () => {
+                    await logout();
+                    navigate("/");
+                  }}
+                >
+                  Sign out
+                </button>
+              </>
+            ) : (
+              <>
+                <Link to="/login" className={secondaryButton}>
+                  Sign in
+                </Link>
+                <Link to="/register" className={primaryButton}>
+                  Register
+                </Link>
+              </>
+            )}
+          </nav>
+        </div>
+      </header>
+      <main className="mx-auto max-w-5xl px-4 py-8">
+        <Route pathname={pathname} search={search} />
+      </main>
+    </div>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..d30580a
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,122 @@
+export type RecipeSummary = {
+  id: number;
+  title: string;
+  category: string;
+  prep_minutes: number;
+  author: string;
+};
+
+export type Recipe = RecipeSummary & {
+  ingredients: string[];
+  instructions: string;
+  servings: number;
+  created_at: string;
+};
+
+export type RecipeInput = {
+  title: string;
+  ingredients: string[];
+  instructions: string;
+  category: string;
+  prep_minutes: number | null;
+  servings: number | null;
+};
+
+export type Page<T> = {
+  items: T[];
+  total: number;
+  page: number;
+  page_size: number;
+};
+
+export class ApiError extends Error {
+  status: number;
+  fieldErrors: Record<string, string>;
+
+  constructor(status: number, message: string, fieldErrors: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.fieldErrors = fieldErrors;
+  }
+}
+
+const TOKEN_KEY = "recipe-book-token";
+const USER_KEY = "recipe-book-user";
+
+export function loadSession(): { token: string; username: string } | null {
+  const token = localStorage.getItem(TOKEN_KEY);
+  const username = localStorage.getItem(USER_KEY);
+  return token && username ? { token, username } : null;
+}
+
+export function saveSession(token: string, username: string) {
+  localStorage.setItem(TOKEN_KEY, token);
+  localStorage.setItem(USER_KEY, username);
+}
+
+export function clearSession() {
+  localStorage.removeItem(TOKEN_KEY);
+  localStorage.removeItem(USER_KEY);
+}
+
+let unauthorizedHandler: (() => void) | null = null;
+
+export function onUnauthorized(handler: (() => void) | null) {
+  unauthorizedHandler = handler;
+}
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  const headers: Record<string, string> = { Accept: "application/json" };
+  const token = localStorage.getItem(TOKEN_KEY);
+  if (token) headers.Authorization = `Bearer ${token}`;
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  let res: Response;
+  try {
+    res = await fetch(`/api${path}`, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError(0, "Could not reach the server. Please try again.");
+  }
+  if (res.status === 204) return undefined as T;
+  let data: unknown = null;
+  try {
+    data = await res.json();
+  } catch {
+    data = null;
+  }
+  if (!res.ok) {
+    const obj = (data && typeof data === "object" ? data : {}) as {
+      error?: string;
+      errors?: Record<string, string>;
+    };
+    if (res.status === 401 && token && path !== "/auth/login") unauthorizedHandler?.();
+    throw new ApiError(res.status, obj.error || `Request failed (${res.status}).`, obj.errors || {});
+  }
+  return data as T;
+}
+
+export const api = {
+  register: (username: string, password: string) =>
+    request<{ id: number; username: string }>("POST", "/auth/register", { username, password }),
+  login: (username: string, password: string) =>
+    request<{ token: string; username: string }>("POST", "/auth/login", { username, password }),
+  logout: () => request<void>("POST", "/auth/logout"),
+  me: () => request<{ id: number; username: string }>("GET", "/auth/me"),
+  categories: () => request<{ items: string[] }>("GET", "/categories"),
+  listRecipes: (params: { category?: string; q?: string; page?: number; page_size?: number }) => {
+    const qs = new URLSearchParams();
+    if (params.category) qs.set("category", params.category);
+    if (params.q) qs.set("q", params.q);
+    if (params.page) qs.set("page", String(params.page));
+    if (params.page_size) qs.set("page_size", String(params.page_size));
+    const s = qs.toString();
+    return request<Page<RecipeSummary>>("GET", `/recipes${s ? `?${s}` : ""}`);
+  },
+  getRecipe: (id: number) => request<Recipe>("GET", `/recipes/${id}`),
+  createRecipe: (input: RecipeInput) => request<Recipe>("POST", "/recipes", input),
+  updateRecipe: (id: number, input: RecipeInput) => request<Recipe>("PUT", `/recipes/${id}`, input),
+  deleteRecipe: (id: number) => request<void>("DELETE", `/recipes/${id}`),
+};
diff --git a/frontend/src/auth.tsx b/frontend/src/auth.tsx
new file mode 100644
index 0000000..2ff7d8b
--- /dev/null
+++ b/frontend/src/auth.tsx
@@ -0,0 +1,49 @@
+import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
+import { api, clearSession, loadSession, onUnauthorized, saveSession } from "./api";
+
+type AuthState = {
+  username: string | null;
+  login: (username: string, password: string) => Promise<void>;
+  logout: () => Promise<void>;
+};
+
+const AuthContext = createContext<AuthState | null>(null);
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [username, setUsername] = useState<string | null>(() => loadSession()?.username ?? null);
+
+  useEffect(() => {
+    onUnauthorized(() => {
+      clearSession();
+      setUsername(null);
+    });
+    if (loadSession()) {
+      api
+        .me()
+        .then((u) => setUsername(u.username))
+        .catch(() => {});
+    }
+    return () => onUnauthorized(null);
+  }, []);
+
+  const login = useCallback(async (name: string, password: string) => {
+    const res = await api.login(name, password);
+    saveSession(res.token, res.username ?? name);
+    setUsername(res.username ?? name);
+  }, []);
+
+  const logout = useCallback(async () => {
+    await api.logout().catch(() => {});
+    clearSession();
+    setUsername(null);
+  }, []);
+
+  const value = useMemo(() => ({ username, login, logout }), [username, login, logout]);
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth() {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error("useAuth must be used inside AuthProvider");
+  return ctx;
+}
