+import { ErrorBanner, Field, inputClass, primaryButton } from "../ui";
+
+export default function AuthPage({ mode }: { mode: "login" | "register" }) {
+  const { login } = useAuth();
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});
+  const [busy, setBusy] = useState(false);
+  const isLogin = mode === "login";
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    setFieldErrors({});
+    try {
+      if (!isLogin) await api.register(username, password);
+      await login(username, password);
+      navigate("/");
+    } catch (err) {
+      if (err instanceof ApiError) {
+        setFieldErrors(err.fieldErrors);
+        setError(Object.keys(err.fieldErrors).length ? null : err.message);
+      } else {
+        setError("Something went wrong.");
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="mx-auto max-w-sm">
+      <div className="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
+        <h1 className="mb-6 text-2xl font-semibold text-stone-900">
+          {isLogin ? "Sign in" : "Create an account"}
+        </h1>
+        <form onSubmit={submit} className="space-y-4" noValidate>
+          <ErrorBanner message={error} />
+          <Field label="Username" htmlFor="username" error={fieldErrors.username}>
+            <input
+              id="username"
+              name="username"
+              autoComplete="username"
+              className={inputClass}
+              value={username}
+              onChange={(e) => setUsername(e.target.value)}
+              required
+            />
+          </Field>
+          <Field label="Password" htmlFor="password" error={fieldErrors.password}>
+            <input
+              id="password"
+              name="password"
+              type="password"
+              autoComplete={isLogin ? "current-password" : "new-password"}
+              className={inputClass}
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              required
+            />
+          </Field>
+          <button type="submit" className={`${primaryButton} w-full`} disabled={busy}>
+            {busy ? "Please wait…" : isLogin ? "Sign in" : "Register"}
+          </button>
+        </form>
+        <p className="mt-4 text-center text-sm text-stone-600">
+          {isLogin ? (
+            <>
+              No account yet?{" "}
+              <Link to="/register" className="font-medium text-amber-700 hover:underline">
+                Register
+              </Link>
+            </>
+          ) : (
+            <>
+              Already have an account?{" "}
+              <Link to="/login" className="font-medium text-amber-700 hover:underline">
+                Sign in
+              </Link>
+            </>
+          )}
+        </p>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/pages/RecipeDetail.tsx b/frontend/src/pages/RecipeDetail.tsx
new file mode 100644
index 0000000..f883086
--- /dev/null
+++ b/frontend/src/pages/RecipeDetail.tsx
@@ -0,0 +1,142 @@
+import { useEffect, useState } from "react";
+import { ApiError, api, type Recipe } from "../api";
+import { useAuth } from "../auth";
+import { Link, navigate } from "../router";
+import { Badge, ErrorBanner, Spinner, dangerButton, formatMinutes, secondaryButton } from "../ui";
+
+export default function RecipeDetail({ id }: { id: number }) {
+  const { username } = useAuth();
+  const [recipe, setRecipe] = useState<Recipe | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [confirming, setConfirming] = useState(false);
+  const [deleting, setDeleting] = useState(false);
+
+  useEffect(() => {
+    let cancelled = false;
+    setRecipe(null);
+    setError(null);
+    api
+      .getRecipe(id)
+      .then((r) => !cancelled && setRecipe(r))
+      .catch((err) => {
+        if (!cancelled) setError(err instanceof ApiError ? err.message : "Could not load recipe.");
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [id]);
+
+  const remove = async () => {
+    setDeleting(true);
+    setError(null);
+    try {
+      await api.deleteRecipe(id);
+      navigate("/");
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : "Could not delete recipe.");
+      setDeleting(false);
+      setConfirming(false);
+    }
+  };
+
+  if (error && !recipe) {
+    return (
+      <div className="space-y-4">
+        <ErrorBanner message={error} />
+        <Link to="/" className="text-sm font-medium text-amber-700 hover:underline">
+          ← Back to recipes
+        </Link>
+      </div>
+    );
+  }
+  if (!recipe) return <Spinner />;
+
+  const isAuthor = username !== null && username.toLowerCase() === recipe.author.toLowerCase();
+
+  return (
+    <article className="space-y-6">
+      <Link to="/" className="text-sm font-medium text-amber-700 hover:underline">
+        ← Back to recipes
+      </Link>
+      <ErrorBanner message={error} />
+      <header className="space-y-3 rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
+        <Badge>{recipe.category}</Badge>
+        <h1 className="text-3xl font-bold text-stone-900">{recipe.title}</h1>
+        <dl className="flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-600">
+          <div>
+            <dt className="inline font-medium">Prep time: </dt>
+            <dd className="inline">{formatMinutes(recipe.prep_minutes)}</dd>
+          </div>
+          <div>
+            <dt className="inline font-medium">Servings: </dt>
+            <dd className="inline">{recipe.servings}</dd>
+          </div>
+          <div>
+            <dt className="inline font-medium">Author: </dt>
+            <dd className="inline">{recipe.author}</dd>
+          </div>
+          <div>
+            <dt className="inline font-medium">Added: </dt>
+            <dd className="inline">{new Date(recipe.created_at).toLocaleDateString()}</dd>
+          </div>
+        </dl>
+        {isAuthor && (
+          <div className="flex flex-wrap gap-2 pt-2">
+            <Link to={`/recipes/${recipe.id}/edit`} className={secondaryButton}>
+              Edit
+            </Link>
+            <button type="button" className={dangerButton} onClick={() => setConfirming(true)}>
+              Delete
+            </button>
+          </div>
+        )}
+      </header>
+
+      <div className="grid gap-6 md:grid-cols-3">
+        <section className="rounded-xl border border-stone-200 bg-white p-6 shadow-sm md:col-span-1">
+          <h2 className="mb-3 text-lg font-semibold text-stone-900">Ingredients</h2>
+          <ul className="list-disc space-y-1 pl-5 text-stone-700">
+            {recipe.ingredients.map((ing, i) => (
+              <li key={i}>{ing}</li>
+            ))}
+          </ul>
+        </section>
+        <section className="rounded-xl border border-stone-200 bg-white p-6 shadow-sm md:col-span-2">
+          <h2 className="mb-3 text-lg font-semibold text-stone-900">Instructions</h2>
+          <p className="whitespace-pre-line leading-relaxed text-stone-700">{recipe.instructions}</p>
+        </section>
+      </div>
+
+      {confirming && (
+        <div
+          className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="confirm-title"
+        >
+          <div className="w-full max-w-sm rounded-xl bg-white p-6 shadow-xl">
+            <h2 id="confirm-title" className="mb-2 text-lg font-semibold text-stone-900">
+              Delete recipe?
+            </h2>
+            <p className="mb-6 text-sm text-stone-600">
+              “{recipe.title}” will be permanently deleted. This cannot be undone.
+            </p>
+            <div className="flex justify-end gap-2">
+              <button
+                type="button"
+                className={secondaryButton}
+                onClick={() => setConfirming(false)}
+                disabled={deleting}
+              >
+                Cancel
+              </button>
+              <button type="button" className={dangerButton} onClick={remove} disabled={deleting}>
+                {deleting ? "Deleting…" : "Delete"}
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+    </article>
+  );
+}
diff --git a/frontend/src/pages/RecipeForm.tsx b/frontend/src/pages/RecipeForm.tsx
new file mode 100644
index 0000000..dd9e3c0
--- /dev/null
+++ b/frontend/src/pages/RecipeForm.tsx
@@ -0,0 +1,274 @@
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import { ApiError, api, type RecipeInput } from "../api";
+import { useAuth } from "../auth";
+import { Link, navigate } from "../router";
+import {
+  ErrorBanner,
+  Field,
+  Spinner,
+  inputClass,
+  primaryButton,
+  secondaryButton,
+} from "../ui";
+
+type Row = { key: number; text: string };
+
+function toNumber(value: string): number | null {
+  const trimmed = value.trim();
+  if (trimmed === "") return null;
+  const n = Number(trimmed);
+  return Number.isFinite(n) ? n : null;
+}
+
+export default function RecipeForm({ id }: { id?: number }) {
+  const { username } = useAuth();
+  const editing = id !== undefined;
+  const nextKey = useRef(1);
+  const newRow = (text = ""): Row => ({ key: nextKey.current++, text });
+
+  const [title, setTitle] = useState("");
+  const [category, setCategory] = useState("");
+  const [prep, setPrep] = useState("");
+  const [servings, setServings] = useState("");
+  const [instructions, setInstructions] = useState("");
+  const [rows, setRows] = useState<Row[]>(() => [newRow()]);
+  const [categories, setCategories] = useState<string[]>([]);
+  const [loading, setLoading] = useState(editing);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});
+
+  useEffect(() => {
+    api
+      .categories()
+      .then((r) => setCategories(r.items))
+      .catch(() => {});
+  }, []);
+
+  useEffect(() => {
+    if (id === undefined) return;
+    let cancelled = false;
+    setLoading(true);
+    api
+      .getRecipe(id)
+      .then((r) => {
+        if (cancelled) return;
+        setTitle(r.title);
+        setCategory(r.category);
+        setPrep(String(r.prep_minutes));
+        setServings(String(r.servings));
+        setInstructions(r.instructions);
+        setRows(r.ingredients.length ? r.ingredients.map((t) => newRow(t)) : [newRow()]);
+        if (username && r.author.toLowerCase() !== username.toLowerCase()) {
+          setError("Only the author can edit this recipe.");
+        }
+      })
+      .catch((err) => {
+        if (!cancelled) setError(err instanceof ApiError ? err.message : "Could not load recipe.");
+      })
+      .finally(() => !cancelled && setLoading(false));
+    return () => {
+      cancelled = true;
+    };
+  }, [id]);
+
+  const updateRow = (key: number, text: string) =>
+    setRows((rs) => rs.map((r) => (r.key === key ? { ...r, text } : r)));
+  const removeRow = (key: number) =>
+    setRows((rs) => (rs.length > 1 ? rs.filter((r) => r.key !== key) : [newRow()]));
+  const moveRow = (index: number, delta: number) =>
+    setRows((rs) => {
+      const target = index + delta;
+      if (target < 0 || target >= rs.length) return rs;
+      const copy = [...rs];
+      [copy[index], copy[target]] = [copy[target], copy[index]];
+      return copy;
+    });
+  const addRow = () => setRows((rs) => [...rs, newRow()]);
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    setSaving(true);
+    setError(null);
+    setFieldErrors({});
+    const input: RecipeInput = {
+      title,
+      category,
+      instructions,
+      prep_minutes: toNumber(prep),
+      servings: toNumber(servings),
+      ingredients: rows.map((r) => r.text).filter((t) => t.trim() !== ""),
+    };
+    try {
+      const saved = id !== undefined ? await api.updateRecipe(id, input) : await api.createRecipe(input);
+      navigate(`/recipes/${saved.id}`);
+    } catch (err) {
+      if (err instanceof ApiError) {
+        setFieldErrors(err.fieldErrors);
+        setError(
+          err.status === 401
+            ? "Your session has expired. Please sign in again."
+            : Object.keys(err.fieldErrors).length
+              ? "Please fix the highlighted fields."
+              : err.message,
+        );
+      } else {
+        setError("Something went wrong.");
+      }
+      setSaving(false);
+    }
+  };
+
+  if (!username) {
+    return (
+      <div className="mx-auto max-w-md rounded-xl border border-stone-200 bg-white p-6 text-center shadow-sm">
+        <p className="mb-4 text-stone-700">You need to sign in to {editing ? "edit" : "add"} recipes.</p>
+        <Link to="/login" className={primaryButton}>
+          Sign in
+        </Link>
+      </div>
+    );
+  }
+
+  if (loading) return <Spinner />;
+
+  const errClass = (name: string) => (fieldErrors[name] ? " border-red-400" : "");
+
+  return (
+    <div className="mx-auto max-w-2xl">
+      <h1 className="mb-6 text-2xl font-semibold text-stone-900">
+        {editing ? "Edit recipe" : "Add a recipe"}
+      </h1>
+      <form
+        onSubmit={submit}
+        noValidate
+        className="space-y-5 rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
+      >
+        <ErrorBanner message={error} />
+
+        <Field label="Title" htmlFor="title" error={fieldErrors.title}>
+          <input
+            id="title"
+            className={inputClass + errClass("title")}
+            value={title}
+            onChange={(e) => setTitle(e.target.value)}
+          />
+        </Field>
+
+        <div className="grid gap-4 sm:grid-cols-3">
+          <Field label="Category" htmlFor="category" error={fieldErrors.category}>
+            <input
+              id="category"
+              list="category-options"
+              className={inputClass + errClass("category")}
+              value={category}
+              onChange={(e) => setCategory(e.target.value)}
+              placeholder="e.g. Dessert"
+            />
+            <datalist id="category-options">
+              {categories.map((c) => (
+                <option key={c} value={c} />
+              ))}
+            </datalist>
+          </Field>
+          <Field label="Prep time (minutes)" htmlFor="prep" error={fieldErrors.prep_minutes}>
+            <input
+              id="prep"
+              type="number"
+              min={0}
+              step={1}
+              inputMode="numeric"
+              className={inputClass + errClass("prep_minutes")}
+              value={prep}
+              onChange={(e) => setPrep(e.target.value)}
+            />
+          </Field>
+          <Field label="Servings" htmlFor="servings" error={fieldErrors.servings}>
+            <input
+              id="servings"
+              type="number"
+              min={1}
+              step={1}
+              inputMode="numeric"
+              className={inputClass + errClass("servings")}
+              value={servings}
+              onChange={(e) => setServings(e.target.value)}
+            />
+          </Field>
+        </div>
+
+        <fieldset className="space-y-2">
+          <legend className="mb-1 block text-sm font-medium text-stone-700">Ingredients</legend>
+          <ol className="space-y-2">
+            {rows.map((row, i) => (
+              <li key={row.key} className="flex items-center gap-2">
+                <span className="w-6 text-right text-sm text-stone-400">{i + 1}.</span>
+                <input
+                  aria-label={`Ingredient ${i + 1}`}
+                  className={inputClass + errClass("ingredients")}
+                  value={row.text}
+                  onChange={(e) => updateRow(row.key, e.target.value)}
+                  placeholder="e.g. 200 g flour"
+                />
+                <button
+                  type="button"
+                  className="rounded-md px-2 py-1 text-stone-500 hover:bg-stone-100 disabled:opacity-30"
+                  onClick={() => moveRow(i, -1)}
+                  disabled={i === 0}
+                  aria-label={`Move ingredient ${i + 1} up`}
+                >
+                  ↑
+                </button>
+                <button
+                  type="button"
+                  className="rounded-md px-2 py-1 text-stone-500 hover:bg-stone-100 disabled:opacity-30"
+                  onClick={() => moveRow(i, 1)}
+                  disabled={i === rows.length - 1}
+                  aria-label={`Move ingredient ${i + 1} down`}
+                >
+                  ↓
+                </button>
+                <button
+                  type="button"
+                  className="rounded-md px-2 py-1 text-sm text-red-600 hover:bg-red-50"
+                  onClick={() => removeRow(row.key)}
+                  aria-label={`Remove ingredient ${i + 1}`}
+                >
+                  Remove
+                </button>
+              </li>
+            ))}
+          </ol>
+          <button type="button" className={secondaryButton} onClick={addRow}>
+            + Add ingredient
+          </button>
+          {fieldErrors.ingredients && (
+            <p className="text-sm text-red-600" role="alert">
+              {fieldErrors.ingredients}
+            </p>
+          )}
+        </fieldset>
+
+        <Field label="Instructions" htmlFor="instructions" error={fieldErrors.instructions}>
+          <textarea
+            id="instructions"
+            rows={8}
+            className={inputClass + errClass("instructions")}
+            value={instructions}
+            onChange={(e) => setInstructions(e.target.value)}
+            placeholder="One step per line"
+          />
+        </Field>
+
+        <div className="flex justify-end gap-2">
+          <Link to={editing ? `/recipes/${id}` : "/"} className={secondaryButton}>
+            Cancel
+          </Link>
+          <button type="submit" className={primaryButton} disabled={saving}>
+            {saving ? "Saving…" : editing ? "Save changes" : "Add recipe"}
+          </button>
+        </div>
+      </form>
+    </div>
+  );
+}
diff --git a/frontend/src/pages/RecipeList.tsx b/frontend/src/pages/RecipeList.tsx
new file mode 100644
index 0000000..65c9c5f
--- /dev/null
+++ b/frontend/src/pages/RecipeList.tsx
@@ -0,0 +1,170 @@
+import { useEffect, useState } from "react";
+import { ApiError, api, type Page, type RecipeSummary } from "../api";
+import { Link, navigate } from "../router";
+import { Badge, ErrorBanner, Spinner, formatMinutes, inputClass, secondaryButton } from "../ui";
+
+const PAGE_SIZE = 9;
+
+function buildUrl(params: { category: string; q: string; page: number }) {
+  const qs = new URLSearchParams();
+  if (params.category) qs.set("category", params.category);
+  if (params.q) qs.set("q", params.q);
+  if (params.page > 1) qs.set("page", String(params.page));
+  const s = qs.toString();
+  return s ? `/?${s}` : "/";
+}
+
+export default function RecipeList({ search }: { search: string }) {
+  const params = new URLSearchParams(search);
+  const category = params.get("category") ?? "";
+  const q = params.get("q") ?? "";
+  const page = Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1);
+
+  const [data, setData] = useState<Page<RecipeSummary> | null>(null);
+  const [categories, setCategories] = useState<string[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [query, setQuery] = useState(q);
+
+  useEffect(() => {
+    setQuery(q);
+  }, [q]);
+
+  useEffect(() => {
+    api
+      .categories()
+      .then((r) => setCategories(r.items))
+      .catch(() => {});
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    setError(null);
+    api
+      .listRecipes({ category, q, page, page_size: PAGE_SIZE })
+      .then((r) => {
+        if (!cancelled) setData(r);
+      })
+      .catch((err) => {
+        if (!cancelled) setError(err instanceof ApiError ? err.message : "Could not load recipes.");
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [category, q, page]);
+
+  useEffect(() => {
+    if (query.trim() === q) return;
+    const t = window.setTimeout(() => {
+      navigate(buildUrl({ category, q: query.trim(), page: 1 }), true);
+    }, 300);
+    return () => window.clearTimeout(t);
+  }, [query, q, category]);
+
+  const totalPages = data ? Math.max(1, Math.ceil(data.total / data.page_size)) : 1;
+  const allCategories =
+    category && !categories.some((c) => c.toLowerCase() === category.toLowerCase())
+      ? [...categories, category]
+      : categories;
+
+  return (
+    <div className="space-y-6">
+      <div className="flex flex-col gap-3 sm:flex-row sm:items-end">
+        <div className="flex-1">
+          <label htmlFor="search" className="mb-1 block text-sm font-medium text-stone-700">
+            Search by title
+          </label>
+          <input
+            id="search"
+            type="search"
+            placeholder="e.g. pancakes"
+            className={inputClass}
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+          />
+        </div>
+        <div className="sm:w-56">
+          <label htmlFor="category" className="mb-1 block text-sm font-medium text-stone-700">
+            Category
+          </label>
+          <select
+            id="category"
+            className={inputClass}
+            value={category}
+            onChange={(e) => navigate(buildUrl({ category: e.target.value, q, page: 1 }))}
+          >
+            <option value="">All categories</option>
+            {allCategories.map((c) => (
+              <option key={c} value={c}>
+                {c}
+              </option>
+            ))}
+          </select>
+        </div>
+      </div>
+
+      <ErrorBanner message={error} />
+
+      {loading && !data ? (
+        <Spinner />
+      ) : data && data.items.length === 0 ? (
+        <div className="rounded-xl border border-dashed border-stone-300 bg-white py-16 text-center text-stone-500">
+          No recipes found.
+        </div>
+      ) : (
+        data && (
+          <ul
+            className={`grid gap-4 sm:grid-cols-2 lg:grid-cols-3 ${loading ? "opacity-60" : ""}`}
+          >
+            {data.items.map((r) => (
+              <li key={r.id}>
+                <Link
+                  to={`/recipes/${r.id}`}
+                  className="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md"
+                >
+                  <div className="mb-3">
+                    <Badge>{r.category}</Badge>
+                  </div>
+                  <h2 className="mb-4 text-lg font-semibold text-stone-900">{r.title}</h2>
+                  <div className="mt-auto flex items-center justify-between text-sm text-stone-500">
+                    <span>Prep: {formatMinutes(r.prep_minutes)}</span>
+                    <span>by {r.author}</span>
+                  </div>
+                </Link>
+              </li>
+            ))}
+          </ul>
+        )
+      )}
+
+      {data && data.total > 0 && (
+        <nav className="flex items-center justify-between" aria-label="Pagination">
+          <button
+            type="button"
+            className={secondaryButton}
+            disabled={page <= 1}
+            onClick={() => navigate(buildUrl({ category, q, page: page - 1 }))}
+          >
+            ← Previous
+          </button>
+          <span className="text-sm text-stone-600">
+            Page {Math.min(page, totalPages)} of {totalPages} · {data.total} recipe
+            {data.total === 1 ? "" : "s"}
+          </span>
+          <button
+            type="button"
+            className={secondaryButton}
+            disabled={page >= totalPages}
+            onClick={() => navigate(buildUrl({ category, q, page: page + 1 }))}
+          >
+            Next →
+          </button>
+        </nav>
+      )}
+    </div>
+  );
+}
