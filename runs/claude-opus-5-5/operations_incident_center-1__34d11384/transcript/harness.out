{"type":"tool_use","timestamp":1794250330259,"sessionID":"ses_e3e5fd042ffen1hV7W4wnRPsxo","part":{"type":"tool","tool":"write","callID":"toolu_01BsB7CRfJsp9FqY9L4uFh5c","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts","content":"export type Severity = \"sev1\" | \"sev2\" | \"sev3\" | \"sev4\";\nexport type Status = \"investigating\" | \"identified\" | \"monitoring\" | \"resolved\";\n\nexport const SEVERITIES: Severity[] = [\"sev1\", \"sev2\", \"sev3\", \"sev4\"];\nexport const STATUSES: Status[] = [\"investigating\", \"identified\", \"monitoring\", \"resolved\"];\nexport const EVENT_TYPES = [\"note\", \"update\", \"action\", \"communication\"] as const;\n\nexport interface Incident {\n  id: number;\n  title: string;\n  service: string;\n  severity: Severity;\n  status: Status;\n  commander: string | null;\n  impact_summary: string | null;\n  opened_at: string;\n  resolved_at: string | null;\n  reopen_count: number;\n  opened_by: string;\n  sla_due_at: string;\n  sla_breached: boolean;\n}\n\nexport interface TimelineEvent {\n  id: number;\n  type: string;\n  message: string;\n  created_at: string;\n  author: string;\n}\n\nexport interface Page<T> {\n  items: T[];\n  total: number;\n  page: number;\n  page_size: number;\n}\n\nexport interface Stats {\n  open_total: number;\n  open_by_severity: Record<Severity, number>;\n  sla_breached_open: number;\n  resolved_last_30_days: number;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  errors: Record<string, string>;\n  constructor(status: number, message: string, errors: Record<string, string> = {}) {\n    super(message);\n    this.status = status;\n    this.errors = errors;\n  }\n}\n\nconst TOKEN_KEY = \"incident-center.token\";\nconst USER_KEY = \"incident-center.username\";\n\nexport function getToken(): string | null {\n  return localStorage.getItem(TOKEN_KEY);\n}\n\nexport function getStoredUsername(): string | null {\n  return localStorage.getItem(USER_KEY);\n}\n\nexport function storeSession(token: string, username: string) {\n  localStorage.setItem(TOKEN_KEY, token);\n  localStorage.setItem(USER_KEY, username);\n}\n\nexport function clearSession() {\n  localStorage.removeItem(TOKEN_KEY);\n  localStorage.removeItem(USER_KEY);\n}\n\nlet unauthorizedHandler: (() => void) | null = null;\nexport function onUnauthorized(handler: (() => void) | null) {\n  unauthorizedHandler = handler;\n}\n\nexport async function api<T>(path: string, options: { method?: string; body?: unknown } = {}): Promise<T> {\n  const headers: Record<string, string> = {};\n  const token = getToken();\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  if (options.body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  const res = await fetch(`/api${path}`, {\n    method: options.method ?? \"GET\",\n    headers,\n    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,\n  });\n  if (res.status === 204) return undefined as T;\n  let data: unknown = null;\n  try {\n    data = await res.json();\n  } catch {\n    data = null;\n  }\n  if (!res.ok) {\n    const body = (data ?? {}) as { error?: string; errors?: Record<string, string> };\n    if (res.status === 401 && token && !path.startsWith(\"/auth/login\")) unauthorizedHandler?.();\n    throw new ApiError(res.status, body.error ?? `Request failed (${res.status})`, body.errors ?? {});\n  }\n  return data as T;\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794250330192,"end":1794250330228}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1a7504b001j5DlY3aeBWDeNt","sessionID":"ses_e3e5fd042ffen1hV7W4wnRPsxo","messageID":"msg_1c1a6f55d001PvN8qUlv8BgRbI"}}
{"type":"tool_use","timestamp":1794250330259,"sessionID":"ses_e3e5fd042ffen1hV7W4wnRPsxo","part":{"type":"tool","tool":"write","callID":"toolu_01NKtyA8ULYsMj7iT1AtmDHU","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/router.ts","content":"import { useEffect, useState } from \"react\";\n\nexport function navigate(to: string) {\n  if (to === window.location.pathname + window.location.search) return;\n  window.history.pushState(null, \"\", to);\n  window.dispatchEvent(new PopStateEvent(\"popstate\"));\n  window.scrollTo(0, 0);\n}\n\nexport function useLocation() {\n  const [loc, setLoc] = useState(() => ({\n    pathname: window.location.pathname,\n    search: window.location.search,\n  }));\n  useEffect(() => {\n    const update = () => setLoc({ pathname: window.location.pathname, search: window.location.search });\n    window.addEventListener(\"popstate\", update);\n    return () => window.removeEventListener(\"popstate\", update);\n  }, []);\n  return loc;\n}\n\nexport function replaceSearch(params: URLSearchParams) {\n  const qs = params.toString();\n  const url = window.location.pathname + (qs ? `?${qs}` : \"\");\n  window.history.replaceState(null, \"\", url);\n  window.dispatchEvent(new PopStateEvent(\"popstate\"));\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/router.ts","exists":false,"truncated":false},"title":"frontend/src/router.ts","time":{"start":1794250330213,"end":1794250330233}},"id":"prt_1c1a7505e001jp9yRUVn5dL8cz","sessionID":"ses_e3e5fd042ffen1hV7W4wnRPsxo","messageID":"msg_1c1a6f55d001PvN8qUlv8BgRbI"}}
{"type":"tool_use","timestamp":1794250330259,"sessionID":"ses_e3e5fd042ffen1hV7W4wnRPsxo","part":{"type":"tool","tool":"write","callID":"toolu_01VGWThDGVGAk7oQDk8Gfmqr","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/ui.tsx","content":"import type { AnchorHTMLAttributes, ReactNode } from \"react\";\nimport type { Severity, Status } from \"./api\";\nimport { navigate } from \"./router\";\n\nexport function Link({ href, children, ...rest }: AnchorHTMLAttributes<HTMLAnchorElement> & { href: string }) {\n  return (\n    <a\n      href={href}\n      {...rest}\n      onClick={(e) => {\n        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;\n        e.preventDefault();\n        navigate(href);\n      }}\n    >\n      {children}\n    </a>\n  );\n}\n\nconst severityStyles: Record<Severity, string> = {\n  sev1: \"bg-red-100 text-red-800 ring-red-300\",\n  sev2: \"bg-orange-100 text-orange-800 ring-orange-300\",\n  sev3: \"bg-yellow-100 text-yellow-800 ring-yellow-300\",\n  sev4: \"bg-sky-100 text-sky-800 ring-sky-300\",\n};\n\nexport function SeverityBadge({ severity }: { severity: Severity }) {\n  return (\n    <span\n      className={`inline-flex items-center rounded px-2 py-0.5 text-xs font-semibold uppercase ring-1 ring-inset ${severityStyles[severity]}`}\n    >\n      {severity}\n    </span>\n  );\n}\n\nconst statusStyles: Record<Status, string> = {\n  investigating: \"bg-red-50 text-red-700\",\n  identified: \"bg-amber-50 text-amber-700\",\n  monitoring: \"bg-blue-50 text-blue-700\",\n  resolved: \"bg-green-50 text-green-700\",\n};\n\nexport function StatusBadge({ status }: { status: Status }) {\n  return (\n    <span className={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium capitalize ${statusStyles[status]}`}>\n      {status}\n    </span>\n  );\n}\n\nexport function BreachedFlag() {\n  return (\n    <span\n      className=\"inline-flex items-center gap-1 rounded bg-red-600 px-2 py-0.5 text-xs font-bold text-white\"\n      title=\"Resolution target missed\"\n    >\n      SLA breached\n    </span>\n  );\n}\n\nexport function Card({ children, className = \"\" }: { children: ReactNode; className?: string }) {\n  return <div className={`rounded-lg border border-slate-200 bg-white p-5 shadow-sm ${className}`}>{children}</div>;\n}\n\nexport function ErrorBanner({ message }: { message: string | null }) {\n  if (!message) return null;\n  return (\n    <div role=\"alert\" className=\"rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700\">\n      {message}\n    </div>\n  );\n}\n\nexport function FieldError({ message }: { message?: string }) {\n  if (!message) return null;\n  return <p className=\"mt-1 text-sm text-red-600\">{message}</p>;\n}\n\nexport const inputClass =\n  \"block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500\";\n\nexport const buttonClass =\n  \"inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50\";\n\nexport const secondaryButtonClass =\n  \"inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50\";\n\nexport function formatDate(value: string | null): string {\n  if (!value) return \"—\";\n  return new Date(value).toLocaleString();\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/ui.tsx","exists":false,"truncated":false},"title":"frontend/src/ui.tsx","time":{"start":1794250330220,"end":1794250330238}},"id":"prt_1c1a750680012pI2gg3jhCPYyl","sessionID":"ses_e3e5fd042ffen1hV7W4wnRPsxo","messageID":"msg_1c1a6f55d001PvN8qUlv8BgRbI"}}
