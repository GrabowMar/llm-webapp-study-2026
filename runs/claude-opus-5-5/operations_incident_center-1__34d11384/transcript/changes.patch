+++ b/frontend/src/App.tsx
@@ -1,3 +1,114 @@
+import { useEffect, useState, type ReactNode } from "react";
+import { api, clearSession, getStoredUsername, getToken, onUnauthorized } from "./api";
+import AuthPage from "./pages/AuthPage";
+import IncidentListPage from "./pages/IncidentListPage";
+import IncidentPage from "./pages/IncidentPage";
+import NewIncidentPage from "./pages/NewIncidentPage";
+import PublicPage from "./pages/PublicPage";
+import { navigate, useLocation } from "./router";
+import { Link } from "./ui";
+
+function Redirect({ to }: { to: string }) {
+  useEffect(() => navigate(to), [to]);
+  return null;
+}
+
 export default function App() {
-  return <h1>App</h1>;
+  const { pathname } = useLocation();
+  const [username, setUsername] = useState<string | null>(() => (getToken() ? getStoredUsername() ?? "" : null));
+
+  useEffect(() => {
+    onUnauthorized(() => {
+      clearSession();
+      setUsername(null);
+      navigate("/login");
+    });
+    if (getToken()) {
+      api<{ username: string }>("/auth/me")
+        .then((u) => setUsername(u.username))
+        .catch(() => undefined);
+    }
+    return () => onUnauthorized(null);
+  }, []);
+
+  async function signOut() {
+    await api("/auth/logout", { method: "POST" }).catch(() => undefined);
+    clearSession();
+    setUsername(null);
+    navigate("/");
+  }
+
+  const signedIn = username !== null;
+  let page: ReactNode;
+  const detail = pathname.match(/^\/incidents\/(\d+)\/?$/);
+  if (pathname === "/" || pathname === "/status") page = <PublicPage />;
+  else if (pathname === "/login") page = signedIn ? <Redirect to="/incidents" /> : <AuthPage mode="login" onSignedIn={setUsername} />;
+  else if (pathname === "/register")
+    page = signedIn ? <Redirect to="/incidents" /> : <AuthPage mode="register" onSignedIn={setUsername} />;
+  else if (!signedIn && pathname.startsWith("/incidents")) page = <Redirect to="/login" />;
+  else if (pathname === "/incidents" || pathname === "/incidents/") page = <IncidentListPage />;
+  else if (pathname === "/incidents/new") page = <NewIncidentPage />;
+  else if (detail) page = <IncidentPage id={Number(detail[1])} />;
+  else
+    page = (
+      <div className="text-center text-slate-600">
+        <p>Page not found.</p>
+        <Link href="/" className="text-indigo-600 hover:underline">
+          Go home
+        </Link>
+      </div>
+    );
+
+  const navClass = (active: boolean) =>
+    `rounded-md px-3 py-1.5 text-sm font-medium ${active ? "bg-slate-800 text-white" : "text-slate-300 hover:bg-slate-800 hover:text-white"}`;
+
+  return (
+    <div className="min-h-screen bg-slate-100 text-slate-900">
+      <header className="bg-slate-900">
+        <div className="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
+          <div className="flex items-center gap-4">
+            <Link href="/" className="text-lg font-bold text-white">
+              Incident Center
+            </Link>
+            <nav className="flex gap-1">
+              <Link href="/" className={navClass(pathname === "/")}>
+                Status
+              </Link>
+              {signedIn && (
+                <Link href="/incidents" className={navClass(pathname.startsWith("/incidents"))}>
+                  Incidents
+                </Link>
+              )}
+            </nav>
+          </div>
+          <div className="flex items-center gap-3">
+            {signedIn ? (
+              <>
+                <span className="text-sm text-slate-300">
+                  Signed in as <strong className="text-white" data-testid="current-user">{username}</strong>
+                </span>
+                <button
+                  type="button"
+                  onClick={signOut}
+                  className="rounded-md border border-slate-600 px-3 py-1.5 text-sm font-medium text-slate-200 hover:bg-slate-800"
+                >
+                  Sign out
+                </button>
+              </>
+            ) : (
+              <>
+                <Link href="/login" className={navClass(pathname === "/login")}>
+                  Sign in
+                </Link>
+                <Link href="/register" className={navClass(pathname === "/register")}>
+                  Register
+                </Link>
+              </>
+            )}
+          </div>
+        </div>
+      </header>
+      <main className="mx-auto max-w-6xl px-4 py-8">{page}</main>
+    </div>
+  );
 }
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..cfdce0e
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,105 @@
+export type Severity = "sev1" | "sev2" | "sev3" | "sev4";
+export type Status = "investigating" | "identified" | "monitoring" | "resolved";
+
+export const SEVERITIES: Severity[] = ["sev1", "sev2", "sev3", "sev4"];
+export const STATUSES: Status[] = ["investigating", "identified", "monitoring", "resolved"];
+export const EVENT_TYPES = ["note", "update", "action", "communication"] as const;
+
+export interface Incident {
+  id: number;
+  title: string;
+  service: string;
+  severity: Severity;
+  status: Status;
+  commander: string | null;
+  impact_summary: string | null;
+  opened_at: string;
+  resolved_at: string | null;
+  reopen_count: number;
+  opened_by: string;
+  sla_due_at: string;
+  sla_breached: boolean;
+}
+
+export interface TimelineEvent {
+  id: number;
+  type: string;
+  message: string;
+  created_at: string;
+  author: string;
+}
+
+export interface Page<T> {
+  items: T[];
+  total: number;
+  page: number;
+  page_size: number;
+}
+
+export interface Stats {
+  open_total: number;
+  open_by_severity: Record<Severity, number>;
+  sla_breached_open: number;
+  resolved_last_30_days: number;
+}
+
+export class ApiError extends Error {
+  status: number;
+  errors: Record<string, string>;
+  constructor(status: number, message: string, errors: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.errors = errors;
+  }
+}
+
+const TOKEN_KEY = "incident-center.token";
+const USER_KEY = "incident-center.username";
+
+export function getToken(): string | null {
+  return localStorage.getItem(TOKEN_KEY);
+}
+
+export function getStoredUsername(): string | null {
+  return localStorage.getItem(USER_KEY);
+}
+
+export function storeSession(token: string, username: string) {
+  localStorage.setItem(TOKEN_KEY, token);
+  localStorage.setItem(USER_KEY, username);
+}
+
+export function clearSession() {
+  localStorage.removeItem(TOKEN_KEY);
+  localStorage.removeItem(USER_KEY);
+}
+
+let unauthorizedHandler: (() => void) | null = null;
+export function onUnauthorized(handler: (() => void) | null) {
+  unauthorizedHandler = handler;
+}
+
+export async function api<T>(path: string, options: { method?: string; body?: unknown } = {}): Promise<T> {
+  const headers: Record<string, string> = {};
+  const token = getToken();
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  if (options.body !== undefined) headers["Content-Type"] = "application/json";
+  const res = await fetch(`/api${path}`, {
+    method: options.method ?? "GET",
+    headers,
+    body: options.body !== undefined ? JSON.stringify(options.body) : undefined,
+  });
+  if (res.status === 204) return undefined as T;
+  let data: unknown = null;
+  try {
+    data = await res.json();
+  } catch {
+    data = null;
+  }
+  if (!res.ok) {
+    const body = (data ?? {}) as { error?: string; errors?: Record<string, string> };
+    if (res.status === 401 && token && !path.startsWith("/auth/login")) unauthorizedHandler?.();
+    throw new ApiError(res.status, body.error ?? `Request failed (${res.status})`, body.errors ?? {});
+  }
+  return data as T;
+}
