+++ b/frontend/src/PlayerBar.tsx
@@ -0,0 +1,277 @@
+import { useEffect, useRef, useState } from "react";
+import { formatTime, type Track } from "./api";
+
+interface Props {
+  track: Track | null;
+  playRequest: number;
+  hasPrev: boolean;
+  hasNext: boolean;
+  onPrev: () => void;
+  onNext: () => void;
+  onStarted: (track: Track) => void;
+}
+
+const VOLUME_KEY = "audio-library.volume";
+
+function initialVolume(): number {
+  const stored = Number(localStorage.getItem(VOLUME_KEY));
+  return localStorage.getItem(VOLUME_KEY) !== null && Number.isFinite(stored)
+    ? Math.min(1, Math.max(0, stored))
+    : 0.8;
+}
+
+const iconButton =
+  "inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-200 hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-40";
+
+export default function PlayerBar({ track, playRequest, hasPrev, hasNext, onPrev, onNext, onStarted }: Props) {
+  const audioRef = useRef<HTMLAudioElement>(null);
+  const trackId = track?.id ?? null;
+  const trackUrl = track?.url ?? null;
+  const startedRef = useRef(false);
+  const [playing, setPlaying] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const [currentTime, setCurrentTime] = useState(0);
+  const [duration, setDuration] = useState(0);
+  const [volume, setVolume] = useState(initialVolume);
+  const [muted, setMuted] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [seeking, setSeeking] = useState<number | null>(null);
+
+  const trackRef = useRef(track);
+  const onStartedRef = useRef(onStarted);
+  const onNextRef = useRef(onNext);
+  const hasNextRef = useRef(hasNext);
+  useEffect(() => {
+    trackRef.current = track;
+    onStartedRef.current = onStarted;
+    onNextRef.current = onNext;
+    hasNextRef.current = hasNext;
+  });
+
+  useEffect(() => {
+    const audio = audioRef.current;
+    if (!audio) return;
+    audio.volume = volume;
+    audio.muted = muted;
+    localStorage.setItem(VOLUME_KEY, String(volume));
+  }, [volume, muted]);
+
+  useEffect(() => {
+    const audio = audioRef.current;
+    if (!audio) return;
+    const track = trackRef.current;
+    startedRef.current = false;
+    setError(null);
+    setCurrentTime(0);
+    setSeeking(null);
+    if (!track) {
+      audio.pause();
+      audio.removeAttribute("src");
+      audio.load();
+      setDuration(0);
+      return;
+    }
+    setDuration(track.duration ?? 0);
+    if (audio.getAttribute("src") !== track.url) {
+      audio.src = track.url;
+    } else {
+      audio.currentTime = 0;
+    }
+    setLoading(true);
+    audio.play().catch((err: unknown) => {
+      setLoading(false);
+      if (err instanceof DOMException && err.name === "AbortError") return;
+      if (err instanceof DOMException && err.name === "NotAllowedError") {
+        setError(null);
+        return;
+      }
+      setError("This track could not be played.");
+    });
+  }, [trackId, trackUrl, playRequest]);
+
+  useEffect(() => {
+    const audio = audioRef.current;
+    if (!audio) return;
+    const onPlaying = () => {
+      setPlaying(true);
+      setLoading(false);
+      setError(null);
+      const current = trackRef.current;
+      if (!startedRef.current && current) {
+        startedRef.current = true;
+        onStartedRef.current(current);
+      }
+    };
+    const onPause = () => setPlaying(false);
+    const onWaiting = () => setLoading(true);
+    const onTime = () => setCurrentTime(audio.currentTime);
+    const onMeta = () => {
+      if (Number.isFinite(audio.duration) && audio.duration > 0) setDuration(audio.duration);
+    };
+    const onEnded = () => {
+      setPlaying(false);
+      startedRef.current = false;
+      if (hasNextRef.current) onNextRef.current();
+    };
+    const onError = () => {
+      if (!audio.getAttribute("src")) return;
+      setPlaying(false);
+      setLoading(false);
+      setError("This track could not be loaded. The audio address may be unavailable.");
+    };
+    audio.addEventListener("playing", onPlaying);
+    audio.addEventListener("pause", onPause);
+    audio.addEventListener("waiting", onWaiting);
+    audio.addEventListener("timeupdate", onTime);
+    audio.addEventListener("loadedmetadata", onMeta);
+    audio.addEventListener("durationchange", onMeta);
+    audio.addEventListener("ended", onEnded);
+    audio.addEventListener("error", onError);
+    return () => {
+      audio.removeEventListener("playing", onPlaying);
+      audio.removeEventListener("pause", onPause);
+      audio.removeEventListener("waiting", onWaiting);
+      audio.removeEventListener("timeupdate", onTime);
+      audio.removeEventListener("loadedmetadata", onMeta);
+      audio.removeEventListener("durationchange", onMeta);
+      audio.removeEventListener("ended", onEnded);
+      audio.removeEventListener("error", onError);
+    };
+  }, []);
+
+  const togglePlay = () => {
+    const audio = audioRef.current;
+    if (!audio || !track) return;
+    if (audio.paused) {
+      setError(null);
+      audio.play().catch((err: unknown) => {
+        if (err instanceof DOMException && err.name === "AbortError") return;
+        setError("This track could not be played.");
+      });
+    } else {
+      audio.pause();
+    }
+  };
+
+  const commitSeek = (value: number) => {
+    const audio = audioRef.current;
+    if (audio && Number.isFinite(value)) {
+      audio.currentTime = value;
+      setCurrentTime(value);
+    }
+    setSeeking(null);
+  };
+
+  const shownTime = seeking ?? currentTime;
+  const max = duration > 0 ? duration : 0;
+
+  return (
+    <footer className="fixed inset-x-0 bottom-0 z-20 border-t border-slate-700 bg-slate-900/95 backdrop-blur">
+      <audio ref={audioRef} preload="metadata" />
+      <div className="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-3 md:flex-row md:items-center md:gap-6">
+        <div className="min-w-0 md:w-64" aria-live="polite">
+          {track ? (
+            <>
+              <p className="truncate text-sm font-semibold text-slate-100" data-testid="player-title">
+                {track.title}
+              </p>
+              <p className="truncate text-xs text-slate-400" data-testid="player-artist">
+                {track.artist || "Unknown artist"}
+              </p>
+            </>
+          ) : (
+            <p className="text-sm text-slate-500">Nothing playing</p>
+          )}
+          {error && <p className="truncate text-xs text-rose-400" role="alert">{error}</p>}
+        </div>
+
+        <div className="flex flex-1 flex-col gap-1">
+          <div className="flex items-center justify-center gap-2">
+            <button type="button" className={iconButton} onClick={onPrev} disabled={!track || !hasPrev} aria-label="Previous track" title="Previous">
+              <svg viewBox="0 0 24 24" className="h-5 w-5" fill="currentColor" aria-hidden="true">
+                <path d="M6 6h2v12H6zM9.5 12 18 18V6z" />
+              </svg>
+            </button>
+            <button
+              type="button"
+              onClick={togglePlay}
+              disabled={!track}
+              aria-label={playing ? "Pause" : "Play"}
+              title={playing ? "Pause" : "Play"}
+              className="inline-flex h-11 w-11 items-center justify-center rounded-full bg-indigo-500 text-white hover:bg-indigo-400 disabled:cursor-not-allowed disabled:opacity-40"
+            >
+              {playing ? (
+                <svg viewBox="0 0 24 24" className="h-5 w-5" fill="currentColor" aria-hidden="true">
+                  <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
+                </svg>
+              ) : loading && track ? (
+                <span className="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent" aria-hidden="true" />
+              ) : (
+                <svg viewBox="0 0 24 24" className="h-5 w-5" fill="currentColor" aria-hidden="true">
+                  <path d="M8 5v14l11-7z" />
+                </svg>
+              )}
+            </button>
+            <button type="button" className={iconButton} onClick={onNext} disabled={!track || !hasNext} aria-label="Next track" title="Next">
+              <svg viewBox="0 0 24 24" className="h-5 w-5" fill="currentColor" aria-hidden="true">
+                <path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z" />
+              </svg>
+            </button>
+          </div>
+          <div className="flex items-center gap-2 text-xs tabular-nums text-slate-400">
+            <span className="w-12 text-right">{formatTime(shownTime)}</span>
+            <input
+              type="range"
+              aria-label="Seek"
+              min={0}
+              max={max || 1}
+              step={0.1}
+              value={Math.min(shownTime, max || 1)}
+              disabled={!track || max === 0}
+              onChange={(e) => setSeeking(Number(e.target.value))}
+              onMouseUp={(e) => commitSeek(Number((e.target as HTMLInputElement).value))}
+              onTouchEnd={(e) => commitSeek(Number((e.target as HTMLInputElement).value))}
+              onKeyUp={(e) => commitSeek(Number((e.target as HTMLInputElement).value))}
+              onBlur={() => seeking !== null && commitSeek(seeking)}
+              className="h-1 flex-1 cursor-pointer accent-indigo-500 disabled:cursor-not-allowed"
+            />
+            <span className="w-12">{formatTime(max || track?.duration)}</span>
+          </div>
+        </div>
+
+        <div className="flex items-center justify-center gap-2 md:w-44">
+          <button
+            type="button"
+            className={iconButton}
+            onClick={() => setMuted((m) => !m)}
+            aria-label={muted || volume === 0 ? "Unmute" : "Mute"}
+            title={muted ? "Unmute" : "Mute"}
+          >
+            {muted || volume === 0 ? (
+              <svg viewBox="0 0 24 24" className="h-5 w-5" fill="currentColor" aria-hidden="true">
+                <path d="M3 9v6h4l5 5V4L7 9zm13.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z" />
+              </svg>
+            ) : (
+              <svg viewBox="0 0 24 24" className="h-5 w-5" fill="currentColor" aria-hidden="true">
+                <path d="M3 9v6h4l5 5V4L7 9zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05A4.5 4.5 0 0 0 16.5 12zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06A9 9 0 0 0 14 3.23z" />
+              </svg>
+            )}
+          </button>
+          <input
+            type="range"
+            aria-label="Volume"
+            min={0}
+            max={1}
+            step={0.01}
+            value={muted ? 0 : volume}
+            onChange={(e) => {
+              setVolume(Number(e.target.value));
+              setMuted(false);
+            }}
+            className="h-1 w-28 cursor-pointer accent-indigo-500"
+          />
+        </div>
+      </div>
+    </footer>
+  );
+}
diff --git a/frontend/src/TrackList.tsx b/frontend/src/TrackList.tsx
new file mode 100644
index 0000000..f152de6
--- /dev/null
+++ b/frontend/src/TrackList.tsx
@@ -0,0 +1,92 @@
+import { formatTime, type Track } from "./api";
+
+interface Props {
+  tracks: Track[];
+  loading: boolean;
+  emptyMessage: string;
+  currentTrackId: number | null;
+  username: string | null;
+  onPlay: (index: number) => void;
+  onDelete: (track: Track) => void;
+}
+
+export default function TrackList({ tracks, loading, emptyMessage, currentTrackId, username, onPlay, onDelete }: Props) {
+  if (loading) {
+    return <p className="rounded-xl border border-slate-800 p-8 text-center text-sm text-slate-400">Loading tracks…</p>;
+  }
+  if (tracks.length === 0) {
+    return <p className="rounded-xl border border-slate-800 p-8 text-center text-sm text-slate-400">{emptyMessage}</p>;
+  }
+  return (
+    <div className="overflow-x-auto rounded-xl border border-slate-800">
+      <table className="w-full text-left text-sm">
+        <thead className="bg-slate-900 text-xs uppercase tracking-wide text-slate-400">
+          <tr>
+            <th scope="col" className="w-12 px-3 py-2">
+              <span className="sr-only">Play</span>
+            </th>
+            <th scope="col" className="px-3 py-2">Title</th>
+            <th scope="col" className="px-3 py-2">Artist</th>
+            <th scope="col" className="px-3 py-2 text-right">Duration</th>
+            <th scope="col" className="px-3 py-2 text-right">Plays</th>
+            <th scope="col" className="hidden px-3 py-2 md:table-cell">Added by</th>
+            <th scope="col" className="w-20 px-3 py-2">
+              <span className="sr-only">Actions</span>
+            </th>
+          </tr>
+        </thead>
+        <tbody className="divide-y divide-slate-800">
+          {tracks.map((track, index) => {
+            const isCurrent = track.id === currentTrackId;
+            const isOwn = username !== null && track.added_by.toLowerCase() === username.toLowerCase();
+            return (
+              <tr
+                key={track.id}
+                className={`${isCurrent ? "bg-indigo-500/10" : "hover:bg-slate-900"} cursor-pointer`}
+                onDoubleClick={() => onPlay(index)}
+              >
+                <td className="px-3 py-2">
+                  <button
+                    type="button"
+                    onClick={() => onPlay(index)}
+                    aria-label={`Play ${track.title}`}
+                    title="Play"
+                    className={`inline-flex h-8 w-8 items-center justify-center rounded-full ${
+                      isCurrent ? "bg-indigo-500 text-white" : "text-slate-300 hover:bg-slate-700"
+                    }`}
+                  >
+                    <svg viewBox="0 0 24 24" className="h-4 w-4" fill="currentColor" aria-hidden="true">
+                      <path d="M8 5v14l11-7z" />
+                    </svg>
+                  </button>
+                </td>
+                <td className={`max-w-xs truncate px-3 py-2 font-medium ${isCurrent ? "text-indigo-300" : "text-slate-100"}`}>
+                  {track.title}
+                </td>
+                <td className="max-w-[12rem] truncate px-3 py-2 text-slate-300">{track.artist || "—"}</td>
+                <td className="px-3 py-2 text-right tabular-nums text-slate-400">{formatTime(track.duration)}</td>
+                <td className="px-3 py-2 text-right tabular-nums text-slate-400">{track.play_count}</td>
+                <td className="hidden max-w-[10rem] truncate px-3 py-2 text-slate-500 md:table-cell">{track.added_by}</td>
+                <td className="px-3 py-2 text-right">
+                  {isOwn && (
+                    <button
+                      type="button"
+                      onClick={(e) => {
+                        e.stopPropagation();
+                        onDelete(track);
+                      }}
+                      className="rounded-md px-2 py-1 text-xs text-rose-400 hover:bg-rose-500/10"
+                      aria-label={`Delete ${track.title}`}
+                    >
+                      Delete
+                    </button>
+                  )}
+                </td>
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+    </div>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..a1848ab
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,110 @@
+export interface Track {
+  id: number;
+  title: string;
+  artist: string;
+  url: string;
+  duration: number | null;
+  play_count: number;
+  created_at: string;
+  added_by: string;
+}
+
+export interface TrackPage {
+  items: Track[];
+  total: number;
+  page: number;
+  page_size: number;
+}
+
+export interface NewTrack {
+  title: string;
+  artist: string;
+  url: string;
+  duration: string | null;
+}
+
+export class ApiError extends Error {
+  status: number;
+  errors: Record<string, string>;
+
+  constructor(status: number, message: string, errors: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.errors = errors;
+  }
+}
+
+let authToken: string | null = null;
+let onUnauthorized: (() => void) | null = null;
+
+export function setAuthToken(token: string | null) {
+  authToken = token;
+}
+
+export function setUnauthorizedHandler(handler: (() => void) | null) {
+  onUnauthorized = handler;
+}
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  const headers: Record<string, string> = { Accept: "application/json" };
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  const sentToken = authToken;
+  if (sentToken) headers.Authorization = `Bearer ${sentToken}`;
+
+  let res: Response;
+  try {
+    res = await fetch(`/api${path}`, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError(0, "Network error: could not reach the server");
+  }
+
+  if (res.status === 204) return undefined as T;
+
+  let data: unknown = null;
+  try {
+    data = await res.json();
+  } catch {
+    data = null;
+  }
+
+  if (!res.ok) {
+    const obj = (data ?? {}) as { error?: string; errors?: Record<string, string> };
+    if (res.status === 401 && sentToken && onUnauthorized) onUnauthorized();
+    throw new ApiError(res.status, obj.error || `Request failed (${res.status})`, obj.errors ?? {});
+  }
+  return data as T;
+}
+
+export const api = {
+  register: (username: string, password: string) =>
+    request<{ id: number; username: string }>("POST", "/auth/register", { username, password }),
+  login: (username: string, password: string) =>
+    request<{ token: string; user: { id: number; username: string } }>("POST", "/auth/login", {
+      username,
+      password,
+    }),
+  logout: () => request<void>("POST", "/auth/logout"),
+  me: () => request<{ id: number; username: string }>("GET", "/auth/me"),
+  listTracks: (q: string, page: number, pageSize: number) => {
+    const params = new URLSearchParams({ page: String(page), page_size: String(pageSize) });
+    if (q.trim()) params.set("q", q.trim());
+    return request<TrackPage>("GET", `/tracks?${params}`);
+  },
+  addTrack: (track: NewTrack) => request<Track>("POST", "/tracks", track),
+  deleteTrack: (id: number) => request<void>("DELETE", `/tracks/${id}`),
+  recordPlay: (id: number) => request<Track>("POST", `/tracks/${id}/plays`),
+};
+
+export function formatTime(seconds: number | null | undefined): string {
+  if (seconds == null || !Number.isFinite(seconds) || seconds < 0) return "–:––";
+  const total = Math.floor(seconds);
+  const h = Math.floor(total / 3600);
+  const m = Math.floor((total % 3600) / 60);
+  const s = total % 60;
+  const ss = String(s).padStart(2, "0");
+  return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
+}
