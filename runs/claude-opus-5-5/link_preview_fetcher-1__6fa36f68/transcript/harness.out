{"type":"tool_use","timestamp":1794252109271,"sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","part":{"type":"tool","tool":"write","callID":"toolu_01QC5dGrm4XMppfBGfVjKmc6","state":{"status":"completed","input":{"filePath":"/workspace/backend/fetcher.py","content":"\"\"\"Fetching web pages and extracting link previews from them.\"\"\"\n\nfrom __future__ import annotations\n\nimport gzip\nimport ipaddress\nimport os\nimport re\nimport socket\nimport ssl\nimport unicodedata\nimport zlib\nfrom dataclasses import dataclass\nfrom html.parser import HTMLParser\nfrom http.client import HTTPConnection, HTTPException, HTTPSConnection\nfrom urllib.parse import urljoin, urlsplit, urlunsplit\n\nTIMEOUT = float(os.environ.get(\"FETCH_TIMEOUT\", \"10\"))\nMAX_BYTES = int(os.environ.get(\"FETCH_MAX_BYTES\", str(2 * 1024 * 1024)))\nMAX_REDIRECTS = 5\nMAX_URL_LENGTH = 2048\nMAX_TITLE = 300\nMAX_DESCRIPTION = 1000\nUSER_AGENT = \"Mozilla/5.0 (compatible; LinkPreviewBot/1.0)\"\nBLOCK_PRIVATE = os.environ.get(\"FETCH_BLOCK_PRIVATE\", \"\").lower() in (\"1\", \"true\", \"yes\")\n\n\nclass FetchError(Exception):\n    pass\n\n\nclass InvalidURL(ValueError):\n    pass\n\n\n@dataclass\nclass PageResult:\n    final_url: str\n    status_code: int\n    title: str | None\n    description: str | None\n    image_url: str | None\n\n\ndef normalize_url(raw: object) -> str:\n    if not isinstance(raw, str):\n        raise InvalidURL(\"url must be a string\")\n    url = raw.strip()\n    if not url:\n        raise InvalidURL(\"url is required\")\n    if len(url) > MAX_URL_LENGTH:\n        raise InvalidURL(\"url is too long\")\n    if any(ch.isspace() or ord(ch) < 32 or ord(ch) == 127 for ch in url):\n        raise InvalidURL(\"url must not contain whitespace or control characters\")\n    try:\n        parts = urlsplit(url)\n        port = parts.port\n    except ValueError as exc:\n        raise InvalidURL(\"url is not valid\") from exc\n    if parts.scheme.lower() not in (\"http\", \"https\"):\n        raise InvalidURL(\"url must start with http:// or https://\")\n    if not parts.hostname:\n        raise InvalidURL(\"url must include a host\")\n    if port == 0:\n        raise InvalidURL(\"url port is not valid\")\n    return url\n\n\ndef _ip_allowed(ip: ipaddress.IPv4Address | ipaddress.IPv6Address) -> bool:\n    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped:\n        ip = ip.ipv4_mapped\n    if ip.is_link_local or ip.is_multicast or ip.is_unspecified or ip.is_reserved:\n        return False\n    if BLOCK_PRIVATE and (ip.is_private or ip.is_loopback or not ip.is_global):\n        return False\n    return True\n\n\ndef _resolve(host: str, port: int) -> list[str]:\n    try:\n        infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)\n    except (socket.gaierror, UnicodeError) as exc:\n        raise FetchError(f\"could not resolve host {host}\") from exc\n    addresses: list[str] = []\n    for info in infos:\n        addr = info[4][0]\n        ip = ipaddress.ip_address(addr.split(\"%\", 1)[0])\n        if not _ip_allowed(ip):\n            raise FetchError(\"this address is not allowed\")\n        if addr not in addresses:\n            addresses.append(addr)\n    if not addresses:\n        raise FetchError(f\"could not resolve host {host}\")\n    return addresses\n\n\ndef _connect(addresses: list[str], port: int) -> socket.socket:\n    last: OSError | None = None\n    for addr in addresses:\n        try:\n            return socket.create_connection((addr, port), timeout=TIMEOUT)\n        except OSError as exc:\n            last = exc\n    raise FetchError(f\"could not connect: {last}\")\n\n\nclass _PinnedHTTPConnection(HTTPConnection):\n    def __init__(self, host: str, port: int, addresses: list[str]):\n        super().__init__(host, port, timeout=TIMEOUT)\n        self._addresses = addresses\n\n    def connect(self) -> None:\n        self.sock = _connect(self._addresses, self.port)\n\n\nclass _PinnedHTTPSConnection(HTTPSConnection):\n    def __init__(self, host: str, port: int, addresses: list[str]):\n        context = ssl.create_default_context()\n        super().__init__(host, port, timeout=TIMEOUT, context=context)\n        self._addresses = addresses\n        self._ctx = context\n\n    def connect(self) -> None:\n        sock = _connect(self._addresses, self.port)\n        self.sock = self._ctx.wrap_socket(sock, server_hostname=self.host)\n\n\ndef _read_limited(resp) -> bytes:\n    chunks: list[bytes] = []\n    total = 0\n    while total < MAX_BYTES:\n        chunk = resp.read(min(65536, MAX_BYTES - total))\n        if not chunk:\n            break\n        chunks.append(chunk)\n        total += len(chunk)\n    return b\"\".join(chunks)\n\n\ndef _decompress(body: bytes, encoding: str) -> bytes:\n    encoding = encoding.strip().lower()\n    try:\n        if encoding in (\"gzip\", \"x-gzip\"):\n            d = zlib.decompressobj(16 + zlib.MAX_WBITS)\n            return d.decompress(body, MAX_BYTES)\n        if encoding == \"deflate\":\n            try:\n                return zlib.decompressobj().decompress(body, MAX_BYTES)\n            except zlib.error:\n                return zlib.decompressobj(-zlib.MAX_WBITS).decompress(body, MAX_BYTES)\n    except (zlib.error, gzip.BadGzipFile):\n        return b\"\"\n    return body\n\n\ndef _request(url: str) -> tuple[int, dict[str, str], bytes]:\n    parts = urlsplit(url)\n    scheme = parts.scheme.lower()\n    host = parts.hostname or \"\"\n    port = parts.port or (443 if scheme == \"https\" else 80)\n    addresses = _resolve(host, port)\n    conn_cls = _PinnedHTTPSConnection if scheme == \"https\" else _PinnedHTTPConnection\n    conn = conn_cls(host, port, addresses)\n    path = parts.path or \"/\"\n    if parts.query:\n        path += \"?\" + parts.query\n    host_header = host if \":\" not in host else f\"[{host}]\"\n    if parts.port:\n        host_header += f\":{parts.port}\"\n    try:\n        conn.putrequest(\"GET\", path, skip_host=True, skip_accept_encoding=True)\n        conn.putheader(\"Host\", host_header)\n        conn.putheader(\"User-Agent\", USER_AGENT)\n        conn.putheader(\"Accept\", \"text/html,application/xhtml+xml;q=0.9,*/*;q=0.5\")\n        conn.putheader(\"Accept-Encoding\", \"gzip, deflate\")\n        conn.putheader(\"Accept-Language\", \"en;q=0.9, *;q=0.5\")\n        conn.endheaders()\n        resp = conn.getresponse()\n        headers = {k.lower(): v for k, v in resp.getheaders()}\n        status = resp.status\n        if 300 <= status < 400 and \"location\" in headers:\n            body = b\"\"\n        else:\n            body = _read_limited(resp)\n        if headers.get(\"content-encoding\"):\n            body = _decompress(body, headers[\"content-encoding\"])\n        return status, headers, body\n    except FetchError:\n        raise\n    except ssl.SSLError as exc:\n        raise FetchError(f\"TLS error: {exc.reason or exc}\") from exc\n    except (OSError, HTTPException, ValueError) as exc:\n        raise FetchError(f\"request failed: {exc}\") from exc\n    finally:\n        conn.close()\n\n\n_META_CHARSET = re.compile(rb\"\"\"<meta[^>]+charset\\s*=\\s*[\"']?\\s*([A-Za-z0-9_\\-:.]+)\"\"\", re.I)\n\n\ndef _decode(body: bytes, content_type: str) -> str:\n    candidates: list[str] = []\n    m = re.search(r\"charset\\s*=\\s*[\\\"']?([A-Za-z0-9_\\-:.]+)\", content_type, re.I)\n    if m:\n        candidates.append(m.group(1))\n    if body.startswith(b\"\\xef\\xbb\\xbf\"):\n        candidates.insert(0, \"utf-8-sig\")\n    m2 = _META_CHARSET.search(body[:4096])\n    if m2:\n        candidates.append(m2.group(1).decode(\"ascii\", \"ignore\"))\n    candidates.append(\"utf-8\")\n    for enc in candidates:\n        try:\n            return body.decode(enc, errors=\"replace\")\n        except LookupError:\n            continue\n    return body.decode(\"utf-8\", errors=\"replace\")\n\n\nclass _PreviewParser(HTMLParser):\n    def __init__(self) -> None:\n        super().__init__(convert_charrefs=True)\n        self.title_parts: list[str] | None = None\n        self.title: str | None = None\n        self.meta: dict[str, str] = {}\n        self.base_href: str | None = None\n        self._svg_depth = 0\n\n    def handle_starttag(self, tag: str, attrs) -> None:\n        attrs_d = {k.lower(): (v or \"\") for k, v in attrs if k}\n        if tag == \"svg\":\n            self._svg_depth += 1\n        elif tag == \"title\" and self.title is None and self._svg_depth == 0:\n            self.title_parts = []\n        elif tag == \"meta\":\n            key = (attrs_d.get(\"property\") or attrs_d.get(\"name\") or \"\").strip().lower()\n            if key and \"content\" in attrs_d and key not in self.meta:\n                self.meta[key] = attrs_d[\"content\"]\n        elif tag == \"base\" and self.base_href is None and attrs_d.get(\"href\"):\n            self.base_href = attrs_d[\"href\"].strip()\n\n    def handle_startendtag(self, tag: str, attrs) -> None:\n        if tag == \"svg\":\n            return\n        self.handle_starttag(tag, attrs)\n\n    def handle_endtag(self, tag: str) -> None:\n        if tag == \"svg\" and self._svg_depth:\n            self._svg_depth -= 1\n        elif tag == \"title\" and self.title_parts is not None:\n            self.title = \"\".join(self.title_parts)\n            self.title_parts = None\n\n    def handle_data(self, data: str) -> None:\n        if self.title_parts is not None:\n            self.title_parts.append(data)\n\n    def finish(self) -> None:\n        if self.title_parts is not None and self.title is None:\n            self.title = \"\".join(self.title_parts)\n            self.title_parts = None\n\n\ndef clean_text(value: str | None, limit: int) -> str | None:\n    if value is None:\n        return None\n    value = \"\".join(\n        \" \" if unicodedata.category(ch) in (\"Cc\", \"Zl\", \"Zp\") else ch\n        for ch in value\n        if unicodedata.category(ch) not in (\"Cf\", \"Cs\", \"Co\") or ch == \"\\u200d\"\n    )\n    value = re.sub(r\"\\s+\", \" \", value).strip()\n    if not value:\n        return None\n    if len(value) > limit:\n        value = value[: limit - 1].rstrip() + \"\\u2026\"\n    return value\n\n\ndef _clean_image(value: str | None, base: str) -> str | None:\n    if not value:\n        return None\n    value = value.strip()\n    if not value or any(ord(ch) < 32 for ch in value):\n        return None\n    try:\n        absolute = urljoin(base, value)\n        parts = urlsplit(absolute)\n    except ValueError:\n        return None\n    if parts.scheme.lower() not in (\"http\", \"https\") or not parts.hostname:\n        return None\n    absolute = urlunsplit(parts._replace(fragment=parts.fragment))\n    if len(absolute) > MAX_URL_LENGTH:\n        return None\n    return absolute\n\n\ndef parse_html(html: str, base_url: str) -> tuple[str | None, str | None, str | None]:\n    parser = _PreviewParser()\n    try:\n        parser.feed(html)\n        parser.close()\n    except Exception:\n        pass\n    parser.finish()\n    meta = parser.meta\n    title = clean_text(meta.get(\"og:title\"), MAX_TITLE) or clean_text(parser.title, MAX_TITLE)\n    description = clean_text(meta.get(\"og:description\"), MAX_DESCRIPTION) or clean_text(\n        meta.get(\"description\"), MAX_DESCRIPTION\n    )\n    base = base_url\n    if parser.base_href:\n        candidate = _clean_image(parser.base_href, base_url)\n        if candidate:\n            base = candidate\n    image = None\n    for key in (\"og:image\", \"og:image:url\", \"og:image:secure_url\"):\n        image = _clean_image(meta.get(key), base)\n        if image:\n            break\n    return title, description, image\n\n\ndef fetch_preview(url: str) -> PageResult:\n    current = normalize_url(url)\n    for _ in range(MAX_REDIRECTS + 1):\n        status, headers, body = _request(current)\n        location = headers.get(\"location\")\n        if status in (301, 302, 303, 307, 308) and location:\n            try:\n                nxt = urljoin(current, location.strip())\n                current = normalize_url(nxt)\n            except (InvalidURL, ValueError) as exc:\n                raise FetchError(\"redirected to an invalid url\") from exc\n            continue\n        content_type = headers.get(\"content-type\", \"\")\n        title = description = image = None\n        mime = content_type.split(\";\", 1)[0].strip().lower()\n        if body and (not mime or \"html\" in mime or mime == \"text/plain\" and b\"<\" in body[:1024]):\n            title, description, image = parse_html(_decode(body, content_type), current)\n        return PageResult(current, status, title, description, image)\n    raise FetchError(\"too many redirects\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/fetcher.py","exists":false,"truncated":false},"title":"backend/fetcher.py","time":{"start":1794252109234,"end":1794252109249}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1c275ab001q7OckylTKkZQDs","sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","messageID":"msg_1c1c14a10001dKOgoIiQp7PmcM"}}
{"type":"step_finish","timestamp":1794252109271,"sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","part":{"id":"prt_1c1c275c4001bcypL4vb004B6a","reason":"tool-calls","messageID":"msg_1c1c14a10001dKOgoIiQp7PmcM","sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","type":"step-finish","tokens":{"total":32275,"input":2,"output":8824,"reasoning":0,"cache":{"write":167,"read":23282}},"cost":0}}
{"type":"step_start","timestamp":1794252165329,"sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","part":{"id":"prt_1c1c350bd001Op2rUwaOW6QnDF","messageID":"msg_1c1c275cd001sL2LjCZJ9rPg0p","sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","type":"step-start"}}
{"type":"tool_use","timestamp":1794252165405,"sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","part":{"type":"tool","tool":"write","callID":"toolu_01SwGx5GR9ZaQmpVdV99dQec","state":{"status":"completed","input":{"content":"\"\"\"Flask entry point.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport secrets\nimport sqlite3\nfrom datetime import datetime, timedelta, timezone\nfrom functools import wraps\nfrom pathlib import Path\n\nfrom flask import Flask, g, jsonify, request, send_from_directory\nfrom werkzeug.exceptions import HTTPException\nfrom werkzeug.security import check_password_hash, generate_password_hash\n\nfrom fetcher import FetchError, InvalidURL, fetch_preview, normalize_url\n\nDIST = Path(__file__).resolve().parent.parent / \"frontend\" / \"dist\"\nDATA_DIR = Path(os.environ.get(\"DATA_DIR\", \"data\")).resolve()\nDB_PATH = DATA_DIR / \"app.db\"\nTOKEN_TTL = timedelta(days=30)\nDEFAULT_PAGE_SIZE = 10\nMAX_PAGE_SIZE = 100\nUSERNAME_MAX = 64\nPASSWORD_MIN = 6\nPASSWORD_MAX = 256\n\napp = Flask(__name__, static_folder=None)\napp.config[\"MAX_CONTENT_LENGTH\"] = 1024 * 1024\napp.json.sort_keys = False\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT NOT NULL UNIQUE COLLATE NOCASE,\n    password_hash TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS tokens (\n    token_hash TEXT PRIMARY KEY,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    created_at TEXT NOT NULL,\n    expires_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_tokens_user ON tokens(user_id);\nCREATE TABLE IF NOT EXISTS previews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n    url TEXT NOT NULL,\n    final_url TEXT,\n    status_code INTEGER,\n    title TEXT,\n    description TEXT,\n    image_url TEXT,\n    fetched_at TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_previews_user ON previews(user_id, created_at DESC, id DESC);\n\"\"\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef connect() -> sqlite3.Connection:\n    conn = sqlite3.connect(DB_PATH, timeout=30)\n    conn.row_factory = sqlite3.Row\n    conn.execute(\"PRAGMA foreign_keys = ON\")\n    conn.execute(\"PRAGMA busy_timeout = 30000\")\n    return conn\n\n\ndef init_db() -> None:\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\n    conn = connect()\n    try:\n        conn.execute(\"PRAGMA journal_mode = WAL\")\n        conn.executescript(SCHEMA)\n        conn.commit()\n    finally:\n        conn.close()\n\n\ninit_db()\n\n\ndef db() -> sqlite3.Connection:\n    if \"db\" not in g:\n        g.db = connect()\n    return g.db\n\n\n@app.teardown_appcontext\ndef close_db(_exc) -> None:\n    conn = g.pop(\"db\", None)\n    if conn is not None:\n        conn.close()\n\n\ndef error(message: str, status: int):\n    return jsonify({\"error\": message}), status\n\n\n@app.errorhandler(HTTPException)\ndef handle_http_error(exc: HTTPException):\n    if request.path.startswith(\"/api\"):\n        return error(exc.description or exc.name, exc.code or 500)\n    return exc\n\n\n@app.errorhandler(Exception)\ndef handle_unexpected(exc: Exception):\n    if isinstance(exc, HTTPException):\n        return handle_http_error(exc)\n    app.logger.exception(\"unhandled error\")\n    return error(\"internal server error\", 500)\n\n\n@app.after_request\ndef security_headers(resp):\n    resp.headers.setdefault(\"X-Content-Type-Options\", \"nosniff\")\n    resp.headers.setdefault(\"Referrer-Policy\", \"no-referrer\")\n    resp.headers.setdefault(\"X-Frame-Options\", \"DENY\")\n    if request.path.startswith(\"/api\"):\n        resp.headers.setdefault(\"Cache-Control\", \"no-store\")\n    return resp\n\n\ndef json_body() -> dict:\n    data = request.get_json(silent=True)\n    if not isinstance(data, dict):\n        return {}\n    return data\n\n\ndef hash_token(token: str) -> str:\n    return hashlib.sha256(token.encode()).hexdigest()\n\n\ndef current_user():\n    header = request.headers.get(\"Authorization\", \"\")\n    scheme, _, token = header.partition(\" \")\n    token = token.strip()\n    if scheme.lower() != \"bearer\" or not token or len(token) > 256:\n        return None\n    row = db().execute(\n        \"SELECT u.id, u.username, t.expires_at FROM tokens t JOIN users u ON u.id = t.user_id \"\n        \"WHERE t.token_hash = ?\",\n        (hash_token(token),),\n    ).fetchone()\n    if row is None or row[\"expires_at\"] <= now_iso():\n        return None\n    return row\n\n\ndef login_required(fn):\n    @wraps(fn)\n    def wrapper(*args, **kwargs):\n        user = current_user()\n        if user is None:\n            return error(\"authentication required\", 401)\n        g.user = user\n        return fn(*args, **kwargs)\n\n    return wrapper\n\n\n@app.get(\"/api/health\")\ndef health():\n    return {\"status\": \"ok\"}\n\n\ndef validate_credentials(data: dict):\n    username = data.get(\"username\")\n    password = data.get(\"password\")\n    if not isinstance(username, str) or not isinstance(password, str):\n        return None, None, \"username and password are required\"\n    username = username.strip()\n    if not username:\n        return None, None, \"username is required\"\n    if len(username) > USERNAME_MAX:\n        return None, None, f\"username must be at most {USERNAME_MAX} characters\"\n    if any(ch.isspace() or not ch.isprintable() for ch in username):\n        return None, None, \"username must not contain spaces or control characters\"\n    if not password:\n        return None, None, \"password is required\"\n    return username, password, None\n\n\n@app.post(\"/api/auth/register\")\ndef register():\n    username, password, err = validate_credentials(json_body())\n    if err:\n        return error(err, 400)\n    if len(password) < PASSWORD_MIN:\n        return error(f\"password must be at least {PASSWORD_MIN} characters\", 400)\n    if len(password) > PASSWORD_MAX:\n        return error(f\"password must be at most {PASSWORD_MAX} characters\", 400)\n    conn = db()\n    try:\n        cur = conn.execute(\n            \"INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)\",\n            (username, generate_password_hash(password), now_iso()),\n        )\n        conn.commit()\n    except sqlite3.IntegrityError:\n        return error(\"username is already taken\", 409)\n    return jsonify({\"id\": cur.lastrowid, \"username\": username}), 201\n\n\n@app.post(\"/api/auth/login\")\ndef login():\n    username, password, err = validate_credentials(json_body())\n    if err:\n        return error(err, 400)\n    conn = db()\n    row = conn.execute(\n        \"SELECT id, username, password_hash FROM users WHERE username = ?\", (username,)\n    ).fetchone()\n    if row is None or len(password) > PASSWORD_MAX or not check_password_hash(row[\"password_hash\"], password):\n        return error(\"invalid username or password\", 401)\n    token = secrets.token_urlsafe(32)\n    now = datetime.now(timezone.utc)\n    conn.execute(\"DELETE FROM tokens WHERE user_id = ? AND expires_at <= ?\", (row[\"id\"], now_iso()))\n    conn.execute(\n        \"INSERT INTO tokens (token_hash, user_id, created_at, expires_at) VALUES (?, ?, ?, ?)\",\n        (\n            hash_token(token),\n            row[\"id\"],\n            now_iso(),\n            (now + TOKEN_TTL).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\"),\n        ),\n    )\n    conn.commit()\n    return {\"token\": token, \"username\": row[\"username\"]}\n\n\n@app.post(\"/api/auth/logout\")\n@login_required\ndef logout():\n    _, _, token = request.headers.get(\"Authorization\", \"\").partition(\" \")\n    conn = db()\n    conn.execute(\"DELETE FROM tokens WHERE token_hash = ?\", (hash_token(token.strip()),))\n    conn.commit()\n    return \"\", 204\n\n\n@app.get(\"/api/auth/me\")\n@login_required\ndef me():\n    return {\"id\": g.user[\"id\"], \"username\": g.user[\"username\"]}\n\n\ndef serialize(row: sqlite3.Row) -> dict:\n    return {\n        \"id\": row[\"id\"],\n        \"url\": row[\"url\"],\n        \"final_url\": row[\"final_url\"],\n        \"status_code\": row[\"status_code\"],\n        \"title\": row[\"title\"],\n        \"description\": row[\"description\"],\n        \"image_url\": row[\"image_url\"],\n        \"fetched_at\": row[\"fetched_at\"],\n    }\n\n\ndef get_owned(preview_id: int):\n    return db().execute(\n        \"SELECT * FROM previews WHERE id = ? AND user_id = ?\", (preview_id, g.user[\"id\"])\n    ).fetchone()\n\n\ndef parse_positive_int(name: str, default: int):\n    raw = request.args.get(name)\n    if raw is None or raw.strip() == \"\":\n        return default, None\n    try:\n        value = int(raw.strip())\n    except ValueError:\n        return None, f\"{name} must be a positive integer\"\n    if value < 1:\n        return None, f\"{name} must be a positive integer\"\n    return value, None\n\n\n@app.get(\"/api/previews\")\n@login_required\ndef list_previews():\n    page, err = parse_positive_int(\"page\", 1)\n    if err:\n        return error(err, 400)\n    page_size, err = parse_positive_int(\"page_size\", DEFAULT_PAGE_SIZE)\n    if err:\n        return error(err, 400)\n    page_size = min(page_size, MAX_PAGE_SIZE)\n    conn = db()\n    total = conn.execute(\n        \"SELECT COUNT(*) FROM previews WHERE user_id = ?\", (g.user[\"id\"],)\n    ).fetchone()[0]\n    offset = (page - 1) * page_size\n    rows = conn.execute(\n        \"SELECT * FROM previews WHERE user_id = ? ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?\",\n        (g.user[\"id\"], page_size, offset),\n    ).fetchall() if offset < total else []\n    return {\n        \"items\": [serialize(r) for r in rows],\n        \"total\": total,\n        \"page\": page,\n        \"page_size\": page_size,\n    }\n\n\n@app.post(\"/api/previews\")\n@login_required\ndef create_preview():\n    data = json_body()\n    try:\n        url = normalize_url(data.get(\"url\"))\n    except InvalidURL as exc:\n        return error(str(exc), 400)\n    try:\n        result = fetch_preview(url)\n    except InvalidURL as exc:\n        return error(str(exc), 400)\n    except FetchError as exc:\n        return error(f\"could not fetch the page: {exc}\", 502)\n    conn = db()\n    ts = now_iso()\n    cur = conn.execute(\n        \"INSERT INTO previews (user_id, url, final_url, status_code, title, description, image_url, \"\n        \"fetched_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\",\n        (\n            g.user[\"id\"],\n            url,\n            result.final_url,\n            result.status_code,\n            result.title,\n            result.description,\n            result.image_url,\n            ts,\n            ts,\n        ),\n    )\n    conn.commit()\n    return jsonify(serialize(get_owned(cur.lastrowid))), 201\n\n\n@app.get(\"/api/previews/<int:preview_id>\")\n@login_required\ndef get_preview(preview_id: int):\n    row = get_owned(preview_id)\n    if row is None:\n        return error(\"preview not found\", 404)\n    return serialize(row)\n\n\n@app.post(\"/api/previews/<int:preview_id>/refresh\")\n@login_required\ndef refresh_preview(preview_id: int):\n    row = get_owned(preview_id)\n    if row is None:\n        return error(\"preview not found\", 404)\n    try:\n        result = fetch_preview(row[\"url\"])\n    except (FetchError, InvalidURL) as exc:\n        return error(f\"could not fetch the page: {exc}\", 502)\n    conn = db()\n    cur = conn.execute(\n        \"UPDATE previews SET final_url = ?, status_code = ?, title = ?, description = ?, \"\n        \"image_url = ?, fetched_at = ? WHERE id = ? AND user_id = ?\",\n        (\n            result.final_url,\n            result.status_code,\n            result.title,\n            result.description,\n            result.image_url,\n            now_iso(),\n            preview_id,\n            g.user[\"id\"],\n        ),\n    )\n    conn.commit()\n    if cur.rowcount == 0:\n        return error(\"preview not found\", 404)\n    return serialize(get_owned(preview_id))\n\n\n@app.delete(\"/api/previews/<int:preview_id>\")\n@login_required\ndef delete_preview(preview_id: int):\n    conn = db()\n    cur = conn.execute(\n        \"DELETE FROM previews WHERE id = ? AND user_id = ?\", (preview_id, g.user[\"id\"])\n    )\n    conn.commit()\n    if cur.rowcount == 0:\n        return error(\"preview not found\", 404)\n    return \"\", 204\n\n\n@app.route(\"/api\", strict_slashes=False, methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\n@app.route(\"/api/<path:_rest>\", methods=[\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"])\ndef api_not_found(_rest: str = \"\"):\n    return error(\"not found\", 404)\n\n\n@app.get(\"/\")\n@app.get(\"/<path:path>\")\ndef frontend(path: str = \"index.html\"):\n    if (DIST / path).is_file():\n        return send_from_directory(DIST, path)\n    if not (DIST / \"index.html\").is_file():\n        return \"Frontend not built\", 404\n    return send_from_directory(DIST, \"index.html\")\n","filePath":"/workspace/backend/app.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/backend/app.py","exists":true,"truncated":false},"title":"backend/app.py","time":{"start":1794252165322,"end":1794252165343}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1c350c2001eBMbF5342atmG5","sessionID":"ses_e3e442804ffekqMsdddtZUAFLC","messageID":"msg_1c1c275cd001sL2LjCZJ9rPg0p"}}
