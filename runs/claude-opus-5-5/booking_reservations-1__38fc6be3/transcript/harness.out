{"type":"tool_use","timestamp":1794255663527,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_0135QTE8CVabrULGHGakdUmo","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/api.ts","content":"export interface Reservation {\n  id: number;\n  name: string;\n  email: string;\n  date: string;\n  time: string;\n  party_size: number;\n  notes: string | null;\n  created_at: string;\n  username?: string;\n}\n\nexport interface ReservationInput {\n  name: string;\n  email: string;\n  date: string;\n  time: string;\n  party_size: number;\n  notes?: string;\n}\n\nexport interface Slot {\n  time: string;\n  booked: number;\n  remaining: number;\n}\n\nexport interface Session {\n  token: string;\n  username: string;\n  is_admin: boolean;\n}\n\nexport class ApiError extends Error {\n  status: number;\n  details?: Record<string, unknown>;\n\n  constructor(status: number, message: string, details?: Record<string, unknown>) {\n    super(message);\n    this.status = status;\n    this.details = details;\n  }\n}\n\nlet authToken: string | null = null;\nlet onUnauthorized: (() => void) | null = null;\n\nexport function setAuthToken(token: string | null) {\n  authToken = token;\n}\n\nexport function setUnauthorizedHandler(handler: (() => void) | null) {\n  onUnauthorized = handler;\n}\n\nasync function request<T>(method: string, path: string, body?: unknown): Promise<T> {\n  const headers: Record<string, string> = { Accept: \"application/json\" };\n  if (body !== undefined) headers[\"Content-Type\"] = \"application/json\";\n  if (authToken) headers.Authorization = `Bearer ${authToken}`;\n  let res: Response;\n  try {\n    res = await fetch(path, {\n      method,\n      headers,\n      body: body === undefined ? undefined : JSON.stringify(body),\n    });\n  } catch {\n    throw new ApiError(0, \"Could not reach the server. Check your connection and try again.\");\n  }\n  const text = await res.text();\n  let data: unknown = null;\n  if (text) {\n    try {\n      data = JSON.parse(text);\n    } catch {\n      data = null;\n    }\n  }\n  if (!res.ok) {\n    const obj = (data ?? {}) as { error?: string; details?: Record<string, unknown> };\n    if (res.status === 401 && authToken && onUnauthorized) onUnauthorized();\n    throw new ApiError(res.status, obj.error || `Request failed (${res.status})`, obj.details);\n  }\n  return data as T;\n}\n\nexport const api = {\n  register: (username: string, password: string) =>\n    request<{ id: number; username: string }>(\"POST\", \"/api/auth/register\", { username, password }),\n  login: (username: string, password: string) =>\n    request<Session>(\"POST\", \"/api/auth/login\", { username, password }),\n  logout: () => request<void>(\"POST\", \"/api/auth/logout\"),\n  me: () => request<{ id: number; username: string; is_admin: boolean }>(\"GET\", \"/api/auth/me\"),\n  availability: (date: string) =>\n    request<{ items: Slot[] }>(\"GET\", `/api/availability?date=${encodeURIComponent(date)}`),\n  myReservations: () => request<{ items: Reservation[]; total: number }>(\"GET\", \"/api/reservations\"),\n  createReservation: (input: ReservationInput) =>\n    request<Reservation>(\"POST\", \"/api/reservations\", input),\n  updateReservation: (id: number, input: ReservationInput) =>\n    request<Reservation>(\"PUT\", `/api/reservations/${id}`, input),\n  deleteReservation: (id: number) => request<void>(\"DELETE\", `/api/reservations/${id}`),\n  adminReservations: (date: string, page: number, pageSize: number) =>\n    request<{ items: Reservation[]; total: number; page: number; page_size: number }>(\n      \"GET\",\n      `/api/admin/reservations?date=${encodeURIComponent(date)}&page=${page}&page_size=${pageSize}`,\n    ),\n};\n\nexport const SLOT_CAPACITY = 20;\n\nexport function todayISO(): string {\n  const d = new Date();\n  const pad = (n: number) => String(n).padStart(2, \"0\");\n  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\n}\n\nexport function formatDate(iso: string): string {\n  const [y, m, d] = iso.split(\"-\").map(Number);\n  if (!y || !m || !d) return iso;\n  return new Date(y, m - 1, d).toLocaleDateString(undefined, {\n    weekday: \"long\",\n    year: \"numeric\",\n    month: \"long\",\n    day: \"numeric\",\n  });\n}\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/api.ts","exists":false,"truncated":false},"title":"frontend/src/api.ts","time":{"start":1794255663502,"end":1794255663509}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f8b1880011DUpL8GiPVF6BS","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f87250001bAWMaSCTqZLzQ2"}}
{"type":"step_finish","timestamp":1794255663527,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f8b198001DcNJkvpsjlB4Px","reason":"tool-calls","messageID":"msg_1c1f87250001bAWMaSCTqZLzQ2","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-finish","tokens":{"total":38357,"input":2,"output":1970,"reasoning":0,"cache":{"write":639,"read":35746}},"cost":0}}
{"type":"step_start","timestamp":1794255694214,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f92945001JNwu8lfACrx7Gh","messageID":"msg_1c1f8b1a100105rr15MZ2aJBQ0","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-start"}}
{"type":"tool_use","timestamp":1794255694215,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_01FZd49BWbYEW5KpbAastqRL","state":{"status":"completed","input":{"content":"import type { ReactNode } from \"react\";\n\nexport function Card({ title, actions, children }: { title: string; actions?: ReactNode; children: ReactNode }) {\n  return (\n    <section className=\"rounded-xl border border-stone-200 bg-white p-5 shadow-sm\">\n      <div className=\"mb-4 flex flex-wrap items-center justify-between gap-2\">\n        <h2 className=\"text-lg font-semibold text-stone-800\">{title}</h2>\n        {actions}\n      </div>\n      {children}\n    </section>\n  );\n}\n\nexport function Alert({ kind, children }: { kind: \"error\" | \"success\" | \"info\"; children: ReactNode }) {\n  const styles = {\n    error: \"border-red-200 bg-red-50 text-red-800\",\n    success: \"border-emerald-200 bg-emerald-50 text-emerald-800\",\n    info: \"border-sky-200 bg-sky-50 text-sky-800\",\n  }[kind];\n  return (\n    <div role={kind === \"error\" ? \"alert\" : \"status\"} className={`rounded-md border px-3 py-2 text-sm ${styles}`}>\n      {children}\n    </div>\n  );\n}\n\nexport function Field({ label, htmlFor, children, hint }: { label: string; htmlFor: string; children: ReactNode; hint?: string }) {\n  return (\n    <div className=\"flex flex-col gap-1\">\n      <label htmlFor={htmlFor} className=\"text-sm font-medium text-stone-700\">\n        {label}\n      </label>\n      {children}\n      {hint && <p className=\"text-xs text-stone-500\">{hint}</p>}\n    </div>\n  );\n}\n\nexport const inputClass =\n  \"w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200 disabled:bg-stone-100\";\n\nexport const primaryButton =\n  \"inline-flex items-center justify-center rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-300 disabled:cursor-not-allowed disabled:opacity-60\";\n\nexport const secondaryButton =\n  \"inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-stone-200 disabled:cursor-not-allowed disabled:opacity-60\";\n\nexport const dangerButton =\n  \"inline-flex items-center justify-center rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-200 disabled:cursor-not-allowed disabled:opacity-60\";\n","filePath":"/workspace/frontend/src/ui.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/ui.tsx","exists":false,"truncated":false},"title":"frontend/src/ui.tsx","time":{"start":1794255694159,"end":1794255694187}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f92948001OVxllI8C41a5ER","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f8b1a100105rr15MZ2aJBQ0"}}
{"type":"tool_use","timestamp":1794255694215,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_018vAhvTNSEHnJfnmPbgHqkJ","state":{"status":"completed","input":{"content":"import { useState, type FormEvent } from \"react\";\nimport { api, ApiError, type Session } from \"./api\";\nimport { Alert, Card, Field, inputClass, primaryButton } from \"./ui\";\n\nexport function AuthPanel({ onSignedIn }: { onSignedIn: (session: Session) => void }) {\n  const [mode, setMode] = useState<\"login\" | \"register\">(\"login\");\n  const [username, setUsername] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [error, setError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setNotice(null);\n    setBusy(true);\n    try {\n      if (mode === \"register\") {\n        await api.register(username.trim(), password);\n      }\n      const session = await api.login(username.trim(), password);\n      onSignedIn(session);\n    } catch (err) {\n      setError(err instanceof ApiError ? err.message : \"Something went wrong\");\n      if (mode === \"register\" && err instanceof ApiError && err.status === 401) {\n        setNotice(\"Account created. Please sign in.\");\n        setMode(\"login\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const tab = (m: \"login\" | \"register\", label: string) => (\n    <button\n      type=\"button\"\n      role=\"tab\"\n      aria-selected={mode === m}\n      onClick={() => {\n        setMode(m);\n        setError(null);\n        setNotice(null);\n      }}\n      className={`flex-1 rounded-md px-3 py-1.5 text-sm font-medium ${\n        mode === m ? \"bg-white text-stone-900 shadow-sm\" : \"text-stone-600 hover:text-stone-900\"\n      }`}\n    >\n      {label}\n    </button>\n  );\n\n  return (\n    <Card title={mode === \"login\" ? \"Sign in\" : \"Create an account\"}>\n      <div role=\"tablist\" className=\"mb-4 flex gap-1 rounded-lg bg-stone-100 p-1\">\n        {tab(\"login\", \"Sign in\")}\n        {tab(\"register\", \"Register\")}\n      </div>\n      <form onSubmit={submit} className=\"flex flex-col gap-3\" noValidate>\n        <Field label=\"Username\" htmlFor=\"auth-username\">\n          <input\n            id=\"auth-username\"\n            name=\"username\"\n            className={inputClass}\n            autoComplete=\"username\"\n            value={username}\n            onChange={(e) => setUsername(e.target.value)}\n            required\n          />\n        </Field>\n        <Field\n          label=\"Password\"\n          htmlFor=\"auth-password\"\n          hint={mode === \"register\" ? \"At least 8 characters.\" : undefined}\n        >\n          <input\n            id=\"auth-password\"\n            name=\"password\"\n            type=\"password\"\n            className={inputClass}\n            autoComplete={mode === \"login\" ? \"current-password\" : \"new-password\"}\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            required\n          />\n        </Field>\n        {notice && <Alert kind=\"info\">{notice}</Alert>}\n        {error && <Alert kind=\"error\">{error}</Alert>}\n        <button type=\"submit\" className={primaryButton} disabled={busy || !username.trim() || !password}>\n          {busy ? \"Please wait…\" : mode === \"login\" ? \"Sign in\" : \"Create account\"}\n        </button>\n      </form>\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/AuthPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AuthPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/AuthPanel.tsx","time":{"start":1794255694167,"end":1794255694192}},"id":"prt_1c1f92952001Ib4w20iixeoKA0","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f8b1a100105rr15MZ2aJBQ0"}}
{"type":"tool_use","timestamp":1794255694215,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_01HCWsCAQqynH1ncMrDKJVgd","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatDate, SLOT_CAPACITY, type Slot } from \"./api\";\nimport { Alert, Card, inputClass, secondaryButton } from \"./ui\";\n\nexport function AvailabilityPanel({\n  date,\n  onDateChange,\n  refreshKey,\n  onPickTime,\n}: {\n  date: string;\n  onDateChange: (date: string) => void;\n  refreshKey: number;\n  onPickTime?: (time: string) => void;\n}) {\n  const [slots, setSlots] = useState<Slot[]>([]);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const load = useCallback(async () => {\n    if (!date) return;\n    setLoading(true);\n    setError(null);\n    try {\n      const res = await api.availability(date);\n      setSlots(res.items);\n    } catch (err) {\n      setSlots([]);\n      setError(err instanceof ApiError ? err.message : \"Could not load availability\");\n    } finally {\n      setLoading(false);\n    }\n  }, [date]);\n\n  useEffect(() => {\n    void load();\n  }, [load, refreshKey]);\n\n  return (\n    <Card\n      title=\"Availability\"\n      actions={\n        <button type=\"button\" className={secondaryButton} onClick={() => void load()} disabled={loading}>\n          Refresh\n        </button>\n      }\n    >\n      <div className=\"mb-4 flex flex-col gap-1\">\n        <label htmlFor=\"day-picker\" className=\"text-sm font-medium text-stone-700\">\n          Day\n        </label>\n        <input\n          id=\"day-picker\"\n          type=\"date\"\n          className={inputClass}\n          value={date}\n          onChange={(e) => e.target.value && onDateChange(e.target.value)}\n        />\n        <p className=\"text-xs text-stone-500\">\n          {formatDate(date)} · every time slot seats up to {SLOT_CAPACITY} guests.\n        </p>\n      </div>\n      {error && <Alert kind=\"error\">{error}</Alert>}\n      {!error && loading && slots.length === 0 && <p className=\"text-sm text-stone-500\">Loading…</p>}\n      {!error && !loading && slots.length === 0 && (\n        <p className=\"text-sm text-stone-500\">No bookings yet for this day — every slot has {SLOT_CAPACITY} seats free.</p>\n      )}\n      {slots.length > 0 && (\n        <ul className=\"flex flex-col gap-2\" aria-label=\"Booked slots\">\n          {slots.map((s) => {\n            const pct = Math.min(100, Math.round((s.booked / SLOT_CAPACITY) * 100));\n            const full = s.remaining <= 0;\n            const content = (\n              <>\n                <div className=\"flex items-baseline justify-between text-sm\">\n                  <span className=\"font-mono font-semibold text-stone-800\">{s.time}</span>\n                  <span className={full ? \"font-medium text-red-700\" : \"text-stone-600\"}>\n                    {full ? \"Full\" : `${s.remaining} seat${s.remaining === 1 ? \"\" : \"s\"} left`}\n                    <span className=\"ml-1 text-stone-400\">({s.booked} booked)</span>\n                  </span>\n                </div>\n                <div className=\"mt-1 h-2 overflow-hidden rounded-full bg-stone-100\">\n                  <div\n                    className={`h-full rounded-full ${full ? \"bg-red-500\" : pct >= 75 ? \"bg-amber-500\" : \"bg-emerald-500\"}`}\n                    style={{ width: `${pct}%` }}\n                  />\n                </div>\n              </>\n            );\n            return (\n              <li key={s.time}>\n                {onPickTime && !full ? (\n                  <button\n                    type=\"button\"\n                    onClick={() => onPickTime(s.time)}\n                    className=\"block w-full rounded-md p-2 text-left hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-amber-200\"\n                    title=\"Use this time in the booking form\"\n                  >\n                    {content}\n                  </button>\n                ) : (\n                  <div className=\"p-2\">{content}</div>\n                )}\n              </li>\n            );\n          })}\n        </ul>\n      )}\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/AvailabilityPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AvailabilityPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/AvailabilityPanel.tsx","time":{"start":1794255694175,"end":1794255694197}},"id":"prt_1c1f9295a001JONM9Qybb3PrYm","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f8b1a100105rr15MZ2aJBQ0"}}
{"type":"step_finish","timestamp":1794255694215,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f92977001F7bNJiMSTYx9GU","reason":"tool-calls","messageID":"msg_1c1f8b1a100105rr15MZ2aJBQ0","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-finish","tokens":{"total":42129,"input":2,"output":4126,"reasoning":0,"cache":{"write":1616,"read":36385}},"cost":0}}
{"type":"step_start","timestamp":1794255709635,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f965b7001EsVo2mhGUQxAGP","messageID":"msg_1c1f92981001JqMufIDQ09vVjN","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-start"}}
{"type":"tool_use","timestamp":1794255709655,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_01446BrHRGT9ZntJHKqR1AMC","state":{"status":"completed","input":{"content":"import { useEffect, useState, type FormEvent } from \"react\";\nimport { ApiError, type Reservation, type ReservationInput } from \"./api\";\nimport { Alert, Field, inputClass, primaryButton, secondaryButton } from \"./ui\";\n\nexport interface FormValues {\n  name: string;\n  email: string;\n  date: string;\n  time: string;\n  party_size: string;\n  notes: string;\n}\n\nexport function emptyForm(date: string, time = \"\"): FormValues {\n  return { name: \"\", email: \"\", date, time, party_size: \"2\", notes: \"\" };\n}\n\nexport function fromReservation(r: Reservation): FormValues {\n  return {\n    name: r.name,\n    email: r.email,\n    date: r.date,\n    time: r.time,\n    party_size: String(r.party_size),\n    notes: r.notes ?? \"\",\n  };\n}\n\nexport function ReservationForm({\n  idPrefix,\n  initial,\n  submitLabel,\n  onSubmit,\n  onCancel,\n  resetOnSuccess,\n  successMessage,\n}: {\n  idPrefix: string;\n  initial: FormValues;\n  submitLabel: string;\n  onSubmit: (input: ReservationInput) => Promise<void>;\n  onCancel?: () => void;\n  resetOnSuccess?: (values: FormValues) => FormValues;\n  successMessage?: string;\n}) {\n  const [values, setValues] = useState<FormValues>(initial);\n  const [error, setError] = useState<string | null>(null);\n  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});\n  const [success, setSuccess] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  useEffect(() => {\n    setValues((v) => ({ ...v, date: initial.date, time: initial.time || v.time }));\n  }, [initial.date, initial.time]);\n\n  const set = (key: keyof FormValues) => (e: { target: { value: string } }) => {\n    setValues((v) => ({ ...v, [key]: e.target.value }));\n    setSuccess(null);\n  };\n\n  async function submit(e: FormEvent) {\n    e.preventDefault();\n    setError(null);\n    setSuccess(null);\n    setFieldErrors({});\n    const size = Number(values.party_size);\n    const input: ReservationInput = {\n      name: values.name.trim(),\n      email: values.email.trim(),\n      date: values.date,\n      time: values.time,\n      party_size: Number.isFinite(size) && values.party_size.trim() !== \"\" ? size : (values.party_size as unknown as number),\n    };\n    if (values.notes.trim()) input.notes = values.notes.trim();\n    setBusy(true);\n    try {\n      await onSubmit(input);\n      if (successMessage) setSuccess(successMessage);\n      if (resetOnSuccess) setValues(resetOnSuccess(values));\n    } catch (err) {\n      if (err instanceof ApiError) {\n        setError(err.message);\n        if (err.details) {\n          const fe: Record<string, string> = {};\n          for (const [k, v] of Object.entries(err.details)) if (typeof v === \"string\") fe[k] = v;\n          setFieldErrors(fe);\n        }\n      } else {\n        setError(\"Something went wrong\");\n      }\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  const id = (k: string) => `${idPrefix}-${k}`;\n  const cls = (k: string) => `${inputClass} ${fieldErrors[k] ? \"border-red-400\" : \"\"}`;\n\n  return (\n    <form onSubmit={submit} className=\"flex flex-col gap-3\" noValidate>\n      <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-2\">\n        <Field label=\"Name\" htmlFor={id(\"name\")}>\n          <input id={id(\"name\")} className={cls(\"name\")} value={values.name} onChange={set(\"name\")} autoComplete=\"name\" required maxLength={100} />\n        </Field>\n        <Field label=\"Email\" htmlFor={id(\"email\")}>\n          <input id={id(\"email\")} type=\"email\" className={cls(\"email\")} value={values.email} onChange={set(\"email\")} autoComplete=\"email\" required />\n        </Field>\n        <Field label=\"Date\" htmlFor={id(\"date\")}>\n          <input id={id(\"date\")} type=\"date\" className={cls(\"date\")} value={values.date} onChange={set(\"date\")} required />\n        </Field>\n        <Field label=\"Time\" htmlFor={id(\"time\")}>\n          <input id={id(\"time\")} type=\"time\" className={cls(\"time\")} value={values.time} onChange={set(\"time\")} required />\n        </Field>\n        <Field label=\"Party size\" htmlFor={id(\"party_size\")}>\n          <input\n            id={id(\"party_size\")}\n            type=\"number\"\n            min={1}\n            max={20}\n            step={1}\n            className={cls(\"party_size\")}\n            value={values.party_size}\n            onChange={set(\"party_size\")}\n            required\n          />\n        </Field>\n        <Field label=\"Notes (optional)\" htmlFor={id(\"notes\")}>\n          <input id={id(\"notes\")} className={cls(\"notes\")} value={values.notes} onChange={set(\"notes\")} maxLength={1000} placeholder=\"Allergies, high chair, …\" />\n        </Field>\n      </div>\n      {error && <Alert kind=\"error\">{error}</Alert>}\n      {success && <Alert kind=\"success\">{success}</Alert>}\n      <div className=\"flex gap-2\">\n        <button type=\"submit\" className={primaryButton} disabled={busy}>\n          {busy ? \"Saving…\" : submitLabel}\n        </button>\n        {onCancel && (\n          <button type=\"button\" className={secondaryButton} onClick={onCancel} disabled={busy}>\n            Cancel\n          </button>\n        )}\n      </div>\n    </form>\n  );\n}\n","filePath":"/workspace/frontend/src/ReservationForm.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/ReservationForm.tsx","exists":false,"truncated":false},"title":"frontend/src/ReservationForm.tsx","time":{"start":1794255709631,"end":1794255709638}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f965b9001guGOxQQEM9aivr","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f92981001JqMufIDQ09vVjN"}}
{"type":"step_finish","timestamp":1794255709655,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f965c9001Wkov2moIDDfwKa","reason":"tool-calls","messageID":"msg_1c1f92981001JqMufIDQ09vVjN","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-finish","tokens":{"total":44090,"input":2,"output":2081,"reasoning":0,"cache":{"write":4006,"read":38001}},"cost":0}}
{"type":"step_start","timestamp":1794255738787,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f9d764001vl2az9RRLuEoXJ","messageID":"msg_1c1f965d2001Wrnh99or3nepr0","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-start"}}
{"type":"tool_use","timestamp":1794255738787,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_01KqR26j5wswzWZunEbFoWqT","state":{"status":"completed","input":{"content":"import { useState } from \"react\";\nimport { api, formatDate, type Reservation } from \"./api\";\nimport { fromReservation, ReservationForm } from \"./ReservationForm\";\nimport { Alert, Card, dangerButton, secondaryButton } from \"./ui\";\n\nexport function MyReservations({\n  reservations,\n  loading,\n  error,\n  onChanged,\n}: {\n  reservations: Reservation[];\n  loading: boolean;\n  error: string | null;\n  onChanged: (message?: string) => void;\n}) {\n  const [editingId, setEditingId] = useState<number | null>(null);\n  const [actionError, setActionError] = useState<string | null>(null);\n  const [notice, setNotice] = useState<string | null>(null);\n  const [busyId, setBusyId] = useState<number | null>(null);\n\n  const groups = new Map<string, Reservation[]>();\n  for (const r of reservations) {\n    const list = groups.get(r.date) ?? [];\n    list.push(r);\n    groups.set(r.date, list);\n  }\n\n  async function cancel(r: Reservation) {\n    const ok = window.confirm(\n      `Cancel the reservation for ${r.name} (${r.party_size} guest${r.party_size === 1 ? \"\" : \"s\"}) on ${formatDate(r.date)} at ${r.time}?`,\n    );\n    if (!ok) return;\n    setActionError(null);\n    setNotice(null);\n    setBusyId(r.id);\n    try {\n      await api.deleteReservation(r.id);\n      if (editingId === r.id) setEditingId(null);\n      setNotice(\"Reservation cancelled.\");\n      onChanged();\n    } catch (err) {\n      setActionError(err instanceof Error ? err.message : \"Could not cancel the reservation\");\n      onChanged();\n    } finally {\n      setBusyId(null);\n    }\n  }\n\n  return (\n    <Card title=\"My reservations\">\n      {error && <Alert kind=\"error\">{error}</Alert>}\n      {actionError && <div className=\"mb-3\"><Alert kind=\"error\">{actionError}</Alert></div>}\n      {notice && <div className=\"mb-3\"><Alert kind=\"success\">{notice}</Alert></div>}\n      {!error && loading && reservations.length === 0 && <p className=\"text-sm text-stone-500\">Loading…</p>}\n      {!error && !loading && reservations.length === 0 && (\n        <p className=\"text-sm text-stone-500\">You have no reservations yet.</p>\n      )}\n      <div className=\"flex flex-col gap-5\">\n        {[...groups.entries()].map(([date, items]) => (\n          <div key={date}>\n            <h3 className=\"mb-2 border-b border-stone-200 pb-1 text-sm font-semibold uppercase tracking-wide text-stone-500\">\n              {formatDate(date)}\n            </h3>\n            <ul className=\"flex flex-col gap-2\">\n              {items.map((r) => (\n                <li key={r.id} className=\"rounded-lg border border-stone-200 p-3\">\n                  {editingId === r.id ? (\n                    <ReservationForm\n                      idPrefix={`edit-${r.id}`}\n                      initial={fromReservation(r)}\n                      submitLabel=\"Save changes\"\n                      onCancel={() => setEditingId(null)}\n                      onSubmit={async (input) => {\n                        await api.updateReservation(r.id, input);\n                        setEditingId(null);\n                        setNotice(\"Reservation updated.\");\n                        onChanged();\n                      }}\n                    />\n                  ) : (\n                    <div className=\"flex flex-wrap items-start justify-between gap-3\">\n                      <div className=\"text-sm\">\n                        <div className=\"flex items-baseline gap-2\">\n                          <span className=\"font-mono text-base font-semibold text-stone-900\">{r.time}</span>\n                          <span className=\"font-medium text-stone-800\">{r.name}</span>\n                          <span className=\"rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800\">\n                            {r.party_size} guest{r.party_size === 1 ? \"\" : \"s\"}\n                          </span>\n                        </div>\n                        <div className=\"text-stone-500\">{r.email}</div>\n                        {r.notes && <div className=\"mt-1 text-stone-600 italic\">“{r.notes}”</div>}\n                      </div>\n                      <div className=\"flex gap-2\">\n                        <button\n                          type=\"button\"\n                          className={secondaryButton}\n                          onClick={() => {\n                            setEditingId(r.id);\n                            setNotice(null);\n                            setActionError(null);\n                          }}\n                          disabled={busyId === r.id}\n                        >\n                          Edit\n                        </button>\n                        <button type=\"button\" className={dangerButton} onClick={() => void cancel(r)} disabled={busyId === r.id}>\n                          {busyId === r.id ? \"Cancelling…\" : \"Cancel\"}\n                        </button>\n                      </div>\n                    </div>\n                  )}\n                </li>\n              ))}\n            </ul>\n          </div>\n        ))}\n      </div>\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/MyReservations.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/MyReservations.tsx","exists":false,"truncated":false},"title":"frontend/src/MyReservations.tsx","time":{"start":1794255738740,"end":1794255738758}},"id":"prt_1c1f9d76f001yFgXgztUUgdMpf","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f965d2001Wrnh99or3nepr0"}}
{"type":"tool_use","timestamp":1794255738788,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_013H1Ukfuap4ZhF1RmR51mwC","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport { api, ApiError, formatDate, type Reservation } from \"./api\";\nimport { Alert, Card, secondaryButton } from \"./ui\";\n\nconst PAGE_SIZE = 100;\n\nexport function AdminPanel({ date, refreshKey }: { date: string; refreshKey: number }) {\n  const [items, setItems] = useState<Reservation[]>([]);\n  const [total, setTotal] = useState(0);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const all: Reservation[] = [];\n      let page = 1;\n      let count = 0;\n      for (;;) {\n        const res = await api.adminReservations(date, page, PAGE_SIZE);\n        all.push(...res.items);\n        count = res.total;\n        if (res.items.length < PAGE_SIZE || all.length >= res.total) break;\n        page += 1;\n      }\n      setItems(all);\n      setTotal(count);\n    } catch (err) {\n      setItems([]);\n      setTotal(0);\n      setError(err instanceof ApiError ? err.message : \"Could not load reservations\");\n    } finally {\n      setLoading(false);\n    }\n  }, [date]);\n\n  useEffect(() => {\n    void load();\n  }, [load, refreshKey]);\n\n  const guests = items.reduce((sum, r) => sum + r.party_size, 0);\n\n  return (\n    <Card\n      title={`All reservations · ${formatDate(date)}`}\n      actions={\n        <button type=\"button\" className={secondaryButton} onClick={() => void load()} disabled={loading}>\n          Refresh\n        </button>\n      }\n    >\n      <div className=\"mb-3 flex flex-wrap gap-4 text-sm\">\n        <div className=\"rounded-lg bg-stone-100 px-3 py-2\">\n          <span className=\"text-stone-500\">Reservations</span>{\" \"}\n          <span className=\"font-semibold text-stone-900\" data-testid=\"admin-total\">{total}</span>\n        </div>\n        <div className=\"rounded-lg bg-amber-100 px-3 py-2\">\n          <span className=\"text-amber-800\">Total guests</span>{\" \"}\n          <span className=\"font-semibold text-amber-900\" data-testid=\"admin-guests\">{guests}</span>\n        </div>\n      </div>\n      {error && <Alert kind=\"error\">{error}</Alert>}\n      {!error && !loading && items.length === 0 && <p className=\"text-sm text-stone-500\">No reservations on this day.</p>}\n      {items.length > 0 && (\n        <div className=\"overflow-x-auto\">\n          <table className=\"min-w-full text-left text-sm\">\n            <thead className=\"border-b border-stone-200 text-xs uppercase tracking-wide text-stone-500\">\n              <tr>\n                <th className=\"py-2 pr-3\">Time</th>\n                <th className=\"py-2 pr-3\">Name</th>\n                <th className=\"py-2 pr-3\">Email</th>\n                <th className=\"py-2 pr-3 text-right\">Guests</th>\n                <th className=\"py-2 pr-3\">User</th>\n                <th className=\"py-2\">Notes</th>\n              </tr>\n            </thead>\n            <tbody>\n              {items.map((r) => (\n                <tr key={r.id} className=\"border-b border-stone-100 last:border-0\">\n                  <td className=\"py-2 pr-3 font-mono\">{r.time}</td>\n                  <td className=\"py-2 pr-3\">{r.name}</td>\n                  <td className=\"py-2 pr-3 text-stone-600\">{r.email}</td>\n                  <td className=\"py-2 pr-3 text-right font-medium\">{r.party_size}</td>\n                  <td className=\"py-2 pr-3 text-stone-600\">{r.username ?? \"—\"}</td>\n                  <td className=\"py-2 text-stone-600\">{r.notes ?? \"\"}</td>\n                </tr>\n              ))}\n            </tbody>\n            <tfoot>\n              <tr className=\"border-t border-stone-300 font-semibold\">\n                <td className=\"py-2 pr-3\" colSpan={3}>\n                  Total\n                </td>\n                <td className=\"py-2 pr-3 text-right\">{guests}</td>\n                <td colSpan={2} />\n              </tr>\n            </tfoot>\n          </table>\n        </div>\n      )}\n    </Card>\n  );\n}\n","filePath":"/workspace/frontend/src/AdminPanel.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/AdminPanel.tsx","exists":false,"truncated":false},"title":"frontend/src/AdminPanel.tsx","time":{"start":1794255738751,"end":1794255738763}},"id":"prt_1c1f9d77a001DdgmMeVVs60w3t","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f965d2001Wrnh99or3nepr0"}}
{"type":"tool_use","timestamp":1794255738788,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"edit","callID":"toolu_01PZ9zQkV7YyecgvXzNTrVag","state":{"status":"completed","input":{"filePath":"/workspace/frontend/src/ReservationForm.tsx","oldString":"    const size = Number(values.party_size);\n    const input: ReservationInput = {\n      name: values.name.trim(),\n      email: values.email.trim(),\n      date: values.date,\n      time: values.time,\n      party_size: Number.isFinite(size) && values.party_size.trim() !== \"\" ? size : (values.party_size as unknown as number),\n    };","newString":"    const sizeText = values.party_size.trim();\n    const input = {\n      name: values.name.trim(),\n      email: values.email.trim(),\n      date: values.date || null,\n      time: values.time || null,\n      party_size: sizeText === \"\" ? null : Number(sizeText),\n    } as unknown as ReservationInput;"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /workspace/frontend/src/ReservationForm.tsx\n===================================================================\n--- /workspace/frontend/src/ReservationForm.tsx\n+++ /workspace/frontend/src/ReservationForm.tsx\n@@ -62,16 +62,16 @@\n e.preventDefault();\n setError(null);\n setSuccess(null);\n setFieldErrors({});\n-const size = Number(values.party_size);\n-const input: ReservationInput = {\n+const sizeText = values.party_size.trim();\n+const input = {\n   name: values.name.trim(),\n   email: values.email.trim(),\n-  date: values.date,\n-  time: values.time,\n-  party_size: Number.isFinite(size) && values.party_size.trim() !== \"\" ? size : (values.party_size as unknown as number),\n-};\n+  date: values.date || null,\n+  time: values.time || null,\n+  party_size: sizeText === \"\" ? null : Number(sizeText),\n+} as unknown as ReservationInput;\n if (values.notes.trim()) input.notes = values.notes.trim();\n setBusy(true);\n try {\n   await onSubmit(input);\n","filediff":{"file":"/workspace/frontend/src/ReservationForm.tsx","patch":"Index: /workspace/frontend/src/ReservationForm.tsx\n===================================================================\n--- /workspace/frontend/src/ReservationForm.tsx\n+++ /workspace/frontend/src/ReservationForm.tsx\n@@ -62,16 +62,16 @@\n e.preventDefault();\n setError(null);\n setSuccess(null);\n setFieldErrors({});\n-const size = Number(values.party_size);\n-const input: ReservationInput = {\n+const sizeText = values.party_size.trim();\n+const input = {\n   name: values.name.trim(),\n   email: values.email.trim(),\n-  date: values.date,\n-  time: values.time,\n-  party_size: Number.isFinite(size) && values.party_size.trim() !== \"\" ? size : (values.party_size as unknown as number),\n-};\n+  date: values.date || null,\n+  time: values.time || null,\n+  party_size: sizeText === \"\" ? null : Number(sizeText),\n+} as unknown as ReservationInput;\n if (values.notes.trim()) input.notes = values.notes.trim();\n setBusy(true);\n try {\n   await onSubmit(input);\n","additions":6,"deletions":6},"truncated":false},"title":"frontend/src/ReservationForm.tsx","time":{"start":1794255738732,"end":1794255738770}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1f9d76700198hwQcKRpL5H1V","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f965d2001Wrnh99or3nepr0"}}
{"type":"step_finish","timestamp":1794255738788,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1f9d7940015N95uSDN49RkEz","reason":"tool-calls","messageID":"msg_1c1f965d2001Wrnh99or3nepr0","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-finish","tokens":{"total":47942,"input":2,"output":3882,"reasoning":0,"cache":{"write":2051,"read":42007}},"cost":0}}
{"type":"step_start","timestamp":1794255757163,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"id":"prt_1c1fa1f5d0010vrAzrksXCURrH","messageID":"msg_1c1f9d79e001DZBoRgSguZPI2P","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","type":"step-start"}}
{"type":"tool_use","timestamp":1794255757192,"sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","part":{"type":"tool","tool":"write","callID":"toolu_01TmWjRN5ua8bwPTfc6xajgi","state":{"status":"completed","input":{"content":"import { useCallback, useEffect, useState } from \"react\";\nimport {\n  api,\n  ApiError,\n  setAuthToken,\n  setUnauthorizedHandler,\n  todayISO,\n  type Reservation,\n  type Session,\n} from \"./api\";\nimport { AdminPanel } from \"./AdminPanel\";\nimport { AuthPanel } from \"./AuthPanel\";\nimport { AvailabilityPanel } from \"./AvailabilityPanel\";\nimport { MyReservations } from \"./MyReservations\";\nimport { emptyForm, ReservationForm } from \"./ReservationForm\";\nimport { Card, secondaryButton } from \"./ui\";\n\nconst STORAGE_KEY = \"table-reservations.session\";\n\nfunction loadSession(): Session | null {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    const s = JSON.parse(raw) as Session;\n    return s && typeof s.token === \"string\" && typeof s.username === \"string\" ? s : null;\n  } catch {\n    return null;\n  }\n}\n\nexport default function App() {\n  const [session, setSession] = useState<Session | null>(() => {\n    const s = loadSession();\n    setAuthToken(s?.token ?? null);\n    return s;\n  });\n  const [date, setDate] = useState(todayISO());\n  const [pickedTime, setPickedTime] = useState(\"\");\n  const [refreshKey, setRefreshKey] = useState(0);\n  const [reservations, setReservations] = useState<Reservation[]>([]);\n  const [resLoading, setResLoading] = useState(false);\n  const [resError, setResError] = useState<string | null>(null);\n\n  const signOutLocal = useCallback(() => {\n    localStorage.removeItem(STORAGE_KEY);\n    setAuthToken(null);\n    setSession(null);\n    setReservations([]);\n  }, []);\n\n  useEffect(() => {\n    setUnauthorizedHandler(signOutLocal);\n    return () => setUnauthorizedHandler(null);\n  }, [signOutLocal]);\n\n  useEffect(() => {\n    if (!session) return;\n    api\n      .me()\n      .then((me) => {\n        if (me.username !== session.username || me.is_admin !== session.is_admin) {\n          const next = { ...session, username: me.username, is_admin: me.is_admin };\n          localStorage.setItem(STORAGE_KEY, JSON.stringify(next));\n          setSession(next);\n        }\n      })\n      .catch(() => undefined);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [session?.token]);\n\n  const loadReservations = useCallback(async () => {\n    if (!session) return;\n    setResLoading(true);\n    setResError(null);\n    try {\n      const res = await api.myReservations();\n      setReservations(res.items);\n    } catch (err) {\n      if (!(err instanceof ApiError && err.status === 401)) {\n        setResError(err instanceof ApiError ? err.message : \"Could not load your reservations\");\n      }\n    } finally {\n      setResLoading(false);\n    }\n  }, [session]);\n\n  useEffect(() => {\n    void loadReservations();\n  }, [loadReservations, refreshKey]);\n\n  const refresh = () => setRefreshKey((k) => k + 1);\n\n  function signedIn(s: Session) {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(s));\n    setAuthToken(s.token);\n    setSession(s);\n  }\n\n  async function signOut() {\n    try {\n      await api.logout();\n    } catch {\n      /* ignore */\n    }\n    signOutLocal();\n  }\n\n  return (\n    <div className=\"min-h-screen bg-stone-50 text-stone-900\">\n      <header className=\"border-b border-stone-200 bg-white\">\n        <div className=\"mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4\">\n          <h1 className=\"text-xl font-bold tracking-tight text-stone-900\">\n            <span className=\"text-amber-600\">●</span> Table reservations\n          </h1>\n          {session && (\n            <div className=\"flex items-center gap-3 text-sm\">\n              <span className=\"text-stone-600\">\n                Signed in as <strong className=\"text-stone-900\" data-testid=\"current-user\">{session.username}</strong>\n                {session.is_admin && (\n                  <span className=\"ml-2 rounded-full bg-stone-800 px-2 py-0.5 text-xs font-medium text-white\">admin</span>\n                )}\n              </span>\n              <button type=\"button\" className={secondaryButton} onClick={() => void signOut()}>\n                Sign out\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n\n      <main className=\"mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 py-6 lg:grid-cols-3\">\n        <div className=\"flex flex-col gap-6 lg:col-span-1\">\n          <AvailabilityPanel\n            date={date}\n            onDateChange={(d) => {\n              setDate(d);\n              setPickedTime(\"\");\n            }}\n            refreshKey={refreshKey}\n            onPickTime={session ? setPickedTime : undefined}\n          />\n          {!session && <AuthPanel onSignedIn={signedIn} />}\n        </div>\n\n        <div className=\"flex flex-col gap-6 lg:col-span-2\">\n          {session ? (\n            <>\n              <Card title=\"Book a table\">\n                <ReservationForm\n                  idPrefix=\"book\"\n                  initial={emptyForm(date, pickedTime)}\n                  submitLabel=\"Book table\"\n                  successMessage=\"Your table is booked.\"\n                  resetOnSuccess={(v) => ({ ...emptyForm(v.date, v.time), name: v.name, email: v.email })}\n                  onSubmit={async (input) => {\n                    try {\n                      await api.createReservation(input);\n                      if (input.date && input.date !== date) setDate(input.date);\n                    } finally {\n                      refresh();\n                    }\n                  }}\n                />\n              </Card>\n              <MyReservations\n                reservations={reservations}\n                loading={resLoading}\n                error={resError}\n                onChanged={refresh}\n              />\n              {session.is_admin && <AdminPanel date={date} refreshKey={refreshKey} />}\n            </>\n          ) : (\n            <Card title=\"Welcome\">\n              <p className=\"text-sm text-stone-600\">\n                Pick a day to see how full each time slot is. Sign in or create an account to book, change or cancel\n                your reservations.\n              </p>\n            </Card>\n          )}\n        </div>\n      </main>\n    </div>\n  );\n}\n","filePath":"/workspace/frontend/src/App.tsx"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/frontend/src/App.tsx","exists":true,"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794255757158,"end":1794255757170}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c1fa1f60001optDYNaqtcp9Xv","sessionID":"ses_e3e0b2786ffein4CQhbx5fjWsf","messageID":"msg_1c1f9d79e001DZBoRgSguZPI2P"}}
