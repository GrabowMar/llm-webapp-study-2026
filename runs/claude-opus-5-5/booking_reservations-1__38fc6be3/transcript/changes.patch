+def admin_required(fn):
+    @wraps(fn)
+    def wrapper(*args, **kwargs):
+        user = current_user()
+        if user is None:
+            raise ApiError(401, "Authentication required")
+        if not user["is_admin"]:
+            raise ApiError(403, "Admin access required")
+        return fn(*args, **kwargs)
+
+    return wrapper
