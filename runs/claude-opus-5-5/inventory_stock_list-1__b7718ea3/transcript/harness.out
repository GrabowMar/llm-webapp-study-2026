--hash=sha256:fdb4ca07ab75ffadab4a8b135ad59cdbb3156b99310f3d565370da74a15d6bd3\n    # via\n    #   flask\n    #   jinja2\n    #   werkzeug\nwerkzeug==3.1.9 \\\n    --hash=sha256:55ca7c70a75689be937aa27f8ff4b018f06ff4838fc73045560bf0f5a1291060 \\\n    --hash=sha256:6392e50c78460ba618e5b21f08a71f59c99ce99cdc6cf6e3dd7e6ccca8754fab\n    # via flask\n{\n  \"name\": \"app-frontend\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\"\n  },\n  \"dependencies\": {\n    \"react\": \"19.3.1\",\n    \"react-dom\": \"19.3.1\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"6.2.1\",\n    \"vite\": \"8.3.5\"\n  }\n}\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>App</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\nimport react from \"@vitejs/plugin-react\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [react()],\n  server: { proxy: { \"/api\": \"http://localhost:8000\" } },\n});\nexport default function App() {\n  return <h1>App</h1>;\n}\nimport { createRoot } from \"react-dom/client\";\nimport App from \"./App\";\n\ncreateRoot(document.getElementById(\"root\")!).render(<App />);\n**/node_modules\n**/.venv\n**/venv\n**/__pycache__\n**/*.pyc\n**/.git\nfrontend/dist\ndata/*.db\ndata/*.sqlite\ndata/*.sqlite3\n/usr/bin/python3\n/usr/local/bin/node\n/usr/local/bin/npm\nPython 3.13.5\nv24.22.1\n","exit":0,"truncated":false},"title":"cd /workspace && cat backend/app.py backend/requirements.txt backend/requirements.lock frontend/package.json frontend/index.html frontend/vite.config.ts frontend/src/*.tsx .dockerignore; which python3 node npm; python3 --version; node --version","time":{"start":1794254519665,"end":1794254519721}},"metadata":{"openrouter":{