+                    type="button"
+                    onClick={() => void copy("encoded")}
+                    className="rounded px-2 py-0.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
+                  >
+                    {copied === "encoded" ? "Copied!" : "Copy"}
