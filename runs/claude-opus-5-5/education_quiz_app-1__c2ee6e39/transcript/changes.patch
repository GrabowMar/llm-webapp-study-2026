new file mode 100644
index 0000000..feb552c
--- /dev/null
+++ b/frontend/src/components/Quiz.tsx
@@ -0,0 +1,159 @@
+import { useState } from "react";
+import { ApiError, OPTIONS, api, optionText, type Attempt, type Option, type QuizQuestion } from "../api";
+
+interface Props {
+  onFinished: (attempt: Attempt) => void;
+}
+
+export default function Quiz({ onFinished }: Props) {
+  const [count, setCount] = useState(5);
+  const [questions, setQuestions] = useState<QuizQuestion[] | null>(null);
+  const [index, setIndex] = useState(0);
+  const [answers, setAnswers] = useState<Record<number, Option>>({});
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  async function start() {
+    setBusy(true);
+    setError(null);
+    try {
+      const res = await api.quiz(count);
+      if (res.items.length === 0) {
+        setError("There are no questions available right now.");
+        return;
+      }
+      setQuestions(res.items);
+      setIndex(0);
+      setAnswers({});
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : "Could not load the quiz");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function submit() {
+    if (!questions) return;
+    setBusy(true);
+    setError(null);
+    try {
+      const result = await api.submit(
+        questions.map((q) => ({ question_id: q.id, selected: answers[q.id] })),
+      );
+      onFinished(result);
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : "Could not submit your answers");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const primary =
+    "rounded-md bg-indigo-600 px-5 py-2 font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50";
+
+  if (!questions) {
+    return (
+      <div className="mx-auto max-w-xl rounded-xl bg-white p-6 text-center shadow">
+        <h2 className="text-2xl font-semibold">Ready for a quiz?</h2>
+        <p className="mt-2 text-slate-600">Answer a few random general-knowledge questions.</p>
+        <div className="mt-6 flex items-center justify-center gap-3">
+          <label htmlFor="count" className="text-sm font-medium text-slate-700">
+            Questions
+          </label>
+          <select
+            id="count"
+            value={count}
+            onChange={(e) => setCount(Number(e.target.value))}
+            className="rounded-md border border-slate-300 px-3 py-2"
+          >
+            {[3, 5, 10, 15, 20].map((n) => (
+              <option key={n} value={n}>
+                {n}
+              </option>
+            ))}
+          </select>
+          <button type="button" className={primary} onClick={start} disabled={busy}>
+            {busy ? "Loading…" : "Start quiz"}
+          </button>
+        </div>
+        {error && <p className="mt-4 text-sm text-red-600">{error}</p>}
+      </div>
+    );
+  }
+
+  const q = questions[index];
+  const isLast = index === questions.length - 1;
+  const selected = answers[q.id];
+
+  return (
+    <div className="mx-auto max-w-xl rounded-xl bg-white p-6 shadow">
+      <div className="mb-2 flex items-center justify-between text-sm text-slate-500">
+        <span>
+          Question {index + 1} of {questions.length}
+        </span>
+        <button
+          type="button"
+          className="text-slate-500 hover:text-slate-700 hover:underline"
+          onClick={() => setQuestions(null)}
+        >
+          Quit
+        </button>
+      </div>
+      <div className="mb-4 h-2 w-full overflow-hidden rounded-full bg-slate-200">
+        <div
+          className="h-full bg-indigo-500 transition-all"
+          style={{ width: `${((index + 1) / questions.length) * 100}%` }}
+        />
+      </div>
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          if (!selected) return;
+          if (isLast) submit();
+          else setIndex(index + 1);
+        }}
+      >
+        <fieldset>
+          <legend className="mb-4 text-lg font-semibold">{q.text}</legend>
+          <div className="space-y-2">
+            {OPTIONS.map((opt) => (
+              <label
+                key={opt}
+                className={`flex cursor-pointer items-center gap-3 rounded-lg border px-4 py-3 transition ${
+                  selected === opt
+                    ? "border-indigo-500 bg-indigo-50"
+                    : "border-slate-200 hover:bg-slate-50"
+                }`}
+              >
+                <input
+                  type="radio"
+                  name={`question-${q.id}`}
+                  value={opt}
+                  checked={selected === opt}
+                  onChange={() => setAnswers({ ...answers, [q.id]: opt })}
+                  className="h-4 w-4 accent-indigo-600"
+                />
+                <span className="font-medium text-slate-500">{opt}.</span>
+                <span>{optionText(q, opt)}</span>
+              </label>
+            ))}
+          </div>
+        </fieldset>
+        {error && <p className="mt-4 text-sm text-red-600">{error}</p>}
+        <div className="mt-6 flex justify-between">
+          <button
+            type="button"
+            className="rounded-md px-4 py-2 text-slate-600 hover:bg-slate-100 disabled:invisible"
+            disabled={index === 0}
+            onClick={() => setIndex(index - 1)}
+          >
+            Back
+          </button>
+          <button type="submit" className={primary} disabled={!selected || busy}>
+            {isLast ? (busy ? "Submitting…" : "Submit") : "Next"}
+          </button>
+        </div>
+      </form>
+    </div>
+  );
+}
diff --git a/frontend/src/components/Result.tsx b/frontend/src/components/Result.tsx
new file mode 100644
index 0000000..b326ad4
--- /dev/null
+++ b/frontend/src/components/Result.tsx
@@ -0,0 +1,107 @@
+import { OPTIONS, optionText, type Attempt } from "../api";
+
+interface Props {
+  attempt: Attempt;
+  signedIn: boolean;
+  onSignIn?: () => void;
+  onAgain?: () => void;
+  onBack?: () => void;
+}
+
+export function formatDate(iso: string) {
+  const d = new Date(iso);
+  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString();
+}
+
+export default function Result({ attempt, signedIn, onSignIn, onAgain, onBack }: Props) {
+  return (
+    <div className="mx-auto max-w-2xl space-y-4">
+      <div className="rounded-xl bg-white p-6 text-center shadow">
+        {onBack && (
+          <div className="mb-2 text-left">
+            <button
+              type="button"
+              className="text-sm text-indigo-600 hover:underline"
+              onClick={onBack}
+            >
+              ← Back to my attempts
+            </button>
+          </div>
+        )}
+        <p className="text-sm uppercase tracking-wide text-slate-500">Score</p>
+        <p className="text-5xl font-bold text-indigo-600">{attempt.score}%</p>
+        <p className="mt-2 text-slate-700">
+          {attempt.correct} of {attempt.total_questions} correct
+        </p>
+        {attempt.submitted_at && (
+          <p className="mt-1 text-sm text-slate-500">{formatDate(attempt.submitted_at)}</p>
+        )}
+        {!signedIn && (
+          <div className="mt-4 rounded-md bg-amber-50 px-4 py-3 text-amber-800">
+            <button type="button" className="font-medium underline" onClick={onSignIn}>
+              Sign in to save your results
+            </button>
+          </div>
+        )}
+        {signedIn && attempt.saved && (
+          <p className="mt-3 text-sm text-green-700">Your result has been saved.</p>
+        )}
+        {onAgain && (
+          <button
+            type="button"
+            className="mt-4 rounded-md bg-indigo-600 px-5 py-2 font-medium text-white hover:bg-indigo-700"
+            onClick={onAgain}
+          >
+            Take another quiz
+          </button>
+        )}
+      </div>
+      <ol className="space-y-3">
+        {attempt.answers.map((a, i) => (
+          <li
+            key={`${a.question_id}-${i}`}
+            className={`rounded-xl border-l-4 bg-white p-5 shadow ${
+              a.is_correct ? "border-green-500" : "border-red-500"
+            }`}
+          >
+            <div className="mb-3 flex items-start justify-between gap-3">
+              <p className="font-semibold">
+                {i + 1}. {a.text}
+              </p>
+              <span
+                className={`shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${
+                  a.is_correct ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"
+                }`}
+              >
+                {a.is_correct ? "Correct" : "Wrong"}
+              </span>
+            </div>
+            <ul className="space-y-1">
+              {OPTIONS.map((opt) => {
+                const isCorrect = opt === a.correct_option;
+                const isChosen = opt === a.selected;
+                let cls = "border-slate-200 text-slate-700";
+                if (isCorrect) cls = "border-green-400 bg-green-50 text-green-900";
+                else if (isChosen) cls = "border-red-400 bg-red-50 text-red-900";
+                return (
+                  <li
+                    key={opt}
+                    className={`flex items-center justify-between rounded-md border px-3 py-2 text-sm ${cls}`}
+                  >
+                    <span>
+                      <span className="font-medium">{opt}.</span> {optionText(a, opt)}
+                    </span>
+                    <span className="flex gap-2 text-xs font-medium">
+                      {isChosen && <span>Your answer</span>}
+                      {isCorrect && <span>✓ Correct answer</span>}
+                    </span>
+                  </li>
+                );
+              })}
+            </ul>
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
