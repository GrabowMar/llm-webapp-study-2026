23,9 +323,22 @@\n function linkify(text: string) {\n   const parts = text.split(/(https?:\\/\\/\\S+)/g);\n   return parts.map((p, i) =>\n     /^https?:\\/\\//.test(p) ? (\n-      <a key={i} href={p} className=\"break-all text-indigo-600 hover:underline\">{p}</a>\n+      <a\n+        key={i}\n+        href={p}\n+        className=\"break-all text-indigo-600 hover:underline\"\n+        onClick={(e) => {\n+          const url = new URL(p);\n+          if (url.pathname === \"/reset\" && !e.metaKey && !e.ctrlKey) {\n+            e.preventDefault();\n+            navigate(url.pathname + url.search);\n+          }\n+        }}\n+      >\n+        {p}\n+      </a>\n     ) : (\n       <span key={i}>{p}</span>\n     ),\n   );\n","additions":14,"deletions":1},"truncated":false},"title":"frontend/src/App.tsx","time":{"start":1794249787867,"end":1794249787887}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1c19f09d6001cUIb0TlvQveLh8","sessionID":"ses_e3e66b004ffejO2X33yTSgemSf","messageID":"msg_1c19edeb90014Sb1E8x0gc8x3Z"}}
