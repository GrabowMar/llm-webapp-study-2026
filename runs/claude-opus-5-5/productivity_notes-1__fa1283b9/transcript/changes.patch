+@app.errorhandler(ApiError)
+def handle_api_error(err: ApiError):
+    body = {"error": err.message}
+    if err.errors:
+        body["errors"] = err.errors
+    resp = jsonify(body)
+    resp.status_code = err.status
+    if err.status == 401:
+        resp.headers["WWW-Authenticate"] = "Bearer"
+    return resp
+
