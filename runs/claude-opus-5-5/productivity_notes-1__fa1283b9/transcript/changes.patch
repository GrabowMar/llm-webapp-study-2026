+    token = token.strip()
+    if scheme.lower() == "bearer" and token:
+        row = db().execute(
+            "SELECT u.id, u.username FROM sessions s JOIN users u ON u.id = s.user_id "
+            "WHERE s.token_hash = ?",
+            (hash_token(token),),
+        ).fetchone()
+        if row:
+            g.user = {"id": row["id"], "username": row["username"]}
+    return g.user
+
